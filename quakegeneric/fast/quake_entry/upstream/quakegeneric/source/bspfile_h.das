// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608

struct lump_t {
    fileofs, filelen : int
}

struct dmodel_t {
    mins, maxs, origin : float[3]
    headnode : int[4]
    visleafs, firstface, numfaces : int
}

struct dheader_t {
    version : int
    lumps : lump_t[15]
}

struct dmiptexlump_t {
    nummiptex : int
    dataofs : int[4]
}

struct miptex_s {
    name : uint8[16]
    width, height : uint
    offsets : uint[4]
}

struct dvertex_t {
    point : float[3]
}

struct dplane_t {
    normal : float[3]
    dist : float
    _c_type : int
}

struct dnode_t {
    planenum : int
    children : int16[2]
    mins, maxs : int16[3]
    firstface, numfaces : uint16
}

struct dclipnode_t {
    planenum : int
    children : int16[2]
}

struct texinfo_s {
    vecs : float[2][4]
    miptex, flags : int
}

struct dedge_t {
    v : uint16[2]
}

struct dface_t {
    planenum, side : int16
    firstedge : int
    numedges, texinfo : int16
    styles : uint8[4]
    lightofs : int
}

struct dleaf_t {
    contents, visofs : int
    mins, maxs : int16[3]
    firstmarksurface, nummarksurfaces : uint16
    ambient_level : uint8[4]
}

include bspfile_h.layout.das.inc

