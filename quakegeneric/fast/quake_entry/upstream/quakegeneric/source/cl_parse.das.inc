}

// =====================
// CL_ParseServerMessage
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseServerMessage {
    var cmd : int
    var i : int
    // if recording demos, copy the message out
    if (cl_shownet.value == 1.0f) {
        Con_Printf`va(cstr("%i "), (net_message.cursize,))
    } elif (cl_shownet.value == 2.0f) {
        Con_Printf`va(cstr("------------------\n"), VaNone())
    }
    // unless the server says otherwise
    cl.onground = qboolean._c_false
    // parse the message
    MSG_BeginReading()
    while (1 != 0) {
        if (int(msg_badread) != 0) {
            Host_Error`va(cstr("CL_ParseServerMessage: Bad server message"), VaNone())
        }
        cmd = MSG_ReadByte()
        if (cmd == -1) {
            if (cl_shownet.value == 2.0f) {
                Con_Printf`va(cstr("%3i:%s\n"), (msg_readcount - 1, cstr("END OF MESSAGE")))
            }
            // end of message
            return
        }
        // if the high bit of the command byte is set, it is a fast update
        if ((cmd & 128) != 0) {
            if (cl_shownet.value == 2.0f) {
                Con_Printf`va(cstr("%3i:%s\n"), (msg_readcount - 1, cstr("fast update")))
            }
            CL_ParseUpdate(cmd & 127)
            continue
        }
        if (cl_shownet.value == 2.0f) {
            Con_Printf`va(cstr("%3i:%s\n"), (msg_readcount - 1, svc_strings[cmd]))
        }
        // other commands
        c_switch(cmd) {
            case(_) {
                Host_Error`va(cstr("CL_ParseServerMessage: Illegible server message\n"), VaNone())
                break
            }
            case(1) {
                // Con_Printf ("svc_nop\n");
                break
            }
            case(7) {
                cl.mtime[1] = cl.mtime[0]
                cl.mtime[0] = double(MSG_ReadFloat())
                break
            }
            case(15) {
                i = MSG_ReadShort()
                CL_ParseClientdata(i)
                break
            }
            case(4) {
                i = MSG_ReadLong()
                if (i != PROTOCOL_VERSION) {
                    Host_Error`va(cstr("CL_ParseServerMessage: Server is protocol %i instead of %i\n"), (i, PROTOCOL_VERSION))
                }
                break
            }
            case(2) {
                Host_EndGame`va(cstr("Server disconnected\n"), VaNone())
            }
            case(8) {
                Con_Printf`va(cstr("%s"), (MSG_ReadString(),))
                break
            }
            case(26) {
                SCR_CenterPrint(MSG_ReadString())
                break
            }
            case(9) {
                Cbuf_AddText(MSG_ReadString())
                break
            }
            case(19) {
                V_ParseDamage()
                break
            }
            case(11) {
                CL_ParseServerInfo()
                // leave intermission full screen
                vid.recalc_refdef = int(qboolean._c_true)
                break
            }
            case(10) {
                i = 0
                while (i < 3) {
                    cl.viewangles[i] = MSG_ReadAngle()
                    i++
                }
                break
            }
            case(5) {
                cl.viewentity = MSG_ReadShort()
                break
            }
            case(12) {
                i = MSG_ReadByte()
                if (i >= MAX_LIGHTSTYLES) {
                    Sys_Error`va(cstr("svc_lightstyle > MAX_LIGHTSTYLES"), VaNone())
                }
                Q_strcpy(addr(cl_lightstyle[i].map[0]), MSG_ReadString())
                cl_lightstyle[i].length = Q_strlen(addr(cl_lightstyle[i].map[0]))
                break
            }
            case(6) {
                CL_ParseStartSoundPacket()
                break
            }
            case(16) {
                i = MSG_ReadShort()
                S_StopSound(i >> 3, i & 7)
                break
            }
            case(13) {
                Sbar_Changed()
                i = MSG_ReadByte()
                if (i >= cl.maxclients) {
                    Host_Error`va(cstr("CL_ParseServerMessage: svc_updatename > MAX_SCOREBOARD"), VaNone())
                }
                crt::strcpy(addr(cl.scores[i].name[0]), MSG_ReadString())
                break
            }
            case(14) {
                Sbar_Changed()
                i = MSG_ReadByte()
                if (i >= cl.maxclients) {
                    Host_Error`va(cstr("CL_ParseServerMessage: svc_updatefrags > MAX_SCOREBOARD"), VaNone())
                }
                cl.scores[i].frags = MSG_ReadShort()
                break
            }
            case(17) {
                Sbar_Changed()
                i = MSG_ReadByte()
                if (i >= cl.maxclients) {
                    Host_Error`va(cstr("CL_ParseServerMessage: svc_updatecolors > MAX_SCOREBOARD"), VaNone())
                }
                cl.scores[i].colors = MSG_ReadByte()
                CL_NewTranslation(i)
                break
            }
            case(18) {
                R_ParseParticleEffect()
                break
            }
            case(22) {
                i = MSG_ReadShort()
                // must use CL_EntityNum() to force cl.num_entities up
                CL_ParseBaseline(CL_EntityNum(i))
                break
            }
            case(20) {
                CL_ParseStatic()
                break
            }
            case(23) {
                CL_ParseTEnt()
                break
            }
            case(24) {
                cl.paused = enum_from_int(type<qboolean>, MSG_ReadByte())
                if (int(cl.paused) != 0) {
                    CDAudio_Pause()
                } else {
                    CDAudio_Resume()
                }
                break
            }
            case(25) {
                i = MSG_ReadByte()
                if (i <= cls.signon) {
                    Host_Error`va(cstr("Received signon %i when at %i"), (i, cls.signon))
                }
                cls.signon = i
                CL_SignonReply()
                break
            }
            case(27) {
                cl.stats[STAT_MONSTERS]++
                break
            }
            case(28) {
                cl.stats[STAT_SECRETS]++
                break
            }
            case(3) {
                i = MSG_ReadByte()
                if (i < 0 || i >= MAX_CL_STATS) {
                    Sys_Error`va(cstr("svc_updatestat: %i is invalid"), (i,))
                }
                cl.stats[i] = MSG_ReadLong()
                break
            }
            case(29) {
                CL_ParseStaticSound()
                break
            }
            case(32) {
                cl.cdtrack = MSG_ReadByte()
                cl.looptrack = MSG_ReadByte()
                if ((uint(cls.demoplayback) != 0 || uint(cls.demorecording) != 0) && (cls.forcetrack != -1)) {
                    CDAudio_Play(uint8(cls.forcetrack), qboolean._c_true)
                } else {
                    CDAudio_Play(uint8(cl.cdtrack), qboolean._c_true)
                }
                break
            }
            case(30) {
                cl.intermission = 1
                cl.completed_time = int(cl.time)
                // go to full screen
                vid.recalc_refdef = int(qboolean._c_true)
                break
            }
            case(31) {
                cl.intermission = 2
                cl.completed_time = int(cl.time)
                // go to full screen
                vid.recalc_refdef = int(qboolean._c_true)
                SCR_CenterPrint(MSG_ReadString())
                break
            }
            case(34) {
                cl.intermission = 3
                cl.completed_time = int(cl.time)
                // go to full screen
                vid.recalc_refdef = int(qboolean._c_true)
                SCR_CenterPrint(MSG_ReadString())
                break
            }
            case(33) {
                Cmd_ExecuteString(cstr("help"), cmd_source_t.src_command)
                break
            }
        }
    }
}

