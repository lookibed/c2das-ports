// generated by c2das - regenerate, never edit
var svc_strings : uint8? [35] = fixed_array<uint8?>(cstr("svc_bad"), cstr("svc_nop"), cstr("svc_disconnect"), cstr("svc_updatestat"), cstr("svc_version"),
        cstr("svc_setview"), cstr("svc_sound"), cstr("svc_time"), cstr("svc_print"), cstr("svc_stufftext"), cstr("svc_setangle"), cstr("svc_serverinfo"),
        cstr("svc_lightstyle"), cstr("svc_updatename"), cstr("svc_updatefrags"), cstr("svc_clientdata"), cstr("svc_stopsound"), cstr("svc_updatecolors"),
        cstr("svc_particle"), cstr("svc_damage"), cstr("svc_spawnstatic"), cstr("OBSOLETE svc_spawnbinary"), cstr("svc_spawnbaseline"), cstr("svc_temp_entity"),
        cstr("svc_setpause"), cstr("svc_signonnum"), cstr("svc_centerprint"), cstr("svc_killedmonster"), cstr("svc_foundsecret"), cstr("svc_spawnstaticsound"),
        cstr("svc_intermission"), cstr("svc_finale"), cstr("svc_cdtrack"), cstr("svc_sellscreen"), cstr("svc_cutscene"))
var private CL_KeepaliveMessage_lastmsg : float
var bitcounts : int[16]

// ===============
// CL_EntityNum
// This error checks and tracks the total number of entities
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_EntityNum(num : int) : entity_s? {
    if (num >= cl.num_entities) {
        if (num >= MAX_EDICTS) {
            Host_Error`va(cstr("CL_EntityNum: %i is an invalid number"), (num,))
        }
        while (cl.num_entities <= num) {
            cl_entities[cl.num_entities].colormap = vid.colormap
            cl.num_entities++
        }
    }
    return addr(cl_entities[0]) + end_index(num, 600)
}

// ==================
// CL_ParseStartSoundPacket
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseStartSoundPacket {
    var pos : float[3]
    var channel : int
    var ent : int
    var sound_num : int
    var volume : int
    var field_mask : int
    var attenuation : float
    field_mask = MSG_ReadByte()
    if ((field_mask & SND_VOLUME) != 0) {
        volume = MSG_ReadByte()
    } else {
        volume = DEFAULT_SOUND_PACKET_VOLUME
    }
    if ((field_mask & SND_ATTENUATION) != 0) {
        attenuation = float(double(MSG_ReadByte()) / 64.0lf)
    } else {
        attenuation = float(DEFAULT_SOUND_PACKET_ATTENUATION)
    }
    channel = MSG_ReadShort()
    sound_num = MSG_ReadByte()
    ent = channel >> 3
    channel &= 7
    if (ent > MAX_EDICTS) {
        Host_Error`va(cstr("CL_ParseStartSoundPacket: ent = %i"), (ent,))
    }
    for (i in range(3)) {
        pos[i] = MSG_ReadCoord()
    }
    S_StartSound(ent, channel, cl.sound_precache[sound_num], addr(pos[0]), float(double(volume) / 255.0lf), attenuation)
}

// ==================
// CL_KeepaliveMessage
// When the client is taking a long time to load stuff, send keepalive messages
// so the server doesn't disconnect.
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_KeepaliveMessage {
    var time : float
    var ret : int
    var old : sizebuf_s
    var olddata : uint8[8192]
    if (int(sv.active) != 0) {
        // no need if server is local
        return
    }
    if (int(cls.demoplayback) != 0) {
        return
    }
    // read messages from server, should just be nops
    old = net_message
    crt::memcpy(reinterpret<void?>(addr(olddata[0])), reinterpret<void?>(net_message.data), uint64(net_message.cursize))
    c_do_while(ret != 0) {
        ret = CL_GetMessage()
        c_switch(ret) {
            case(_) {
                Host_Error`va(cstr("CL_KeepaliveMessage: CL_GetMessage failed"), VaNone())
            }
            case(0) {
                // nothing waiting
                break
            }
            case(1) {
                Host_Error`va(cstr("CL_KeepaliveMessage: received a message"), VaNone())
                break
            }
            case(2) {
                if (MSG_ReadByte() != svc_nop) {
                    Host_Error`va(cstr("CL_KeepaliveMessage: datagram wasn't a nop"), VaNone())
                }
                break
            }
        }
    }
    net_message = old
    crt::memcpy(reinterpret<void?>(net_message.data), reinterpret<void?>(addr(olddata[0])), uint64(net_message.cursize))
    // check time
    time = float(Sys_FloatTime())
    if (time - CL_KeepaliveMessage_lastmsg < 5.0f) {
        return
    }
    CL_KeepaliveMessage_lastmsg = time
    // write out a nop
    Con_Printf`va(cstr("--> client to server keepalive\n"), VaNone())
    MSG_WriteByte(addr(cls.message), clc_nop)
    NET_SendMessage(cls.netcon, addr(cls.message))
    SZ_Clear(addr(cls.message))
}

// ==================
// CL_ParseServerInfo
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseServerInfo {
    var str : uint8?
    var i : int
    var nummodels : int
    var numsounds : int
    var model_precache : uint8[256][64]
    var sound_precache : uint8[256][64]
    Con_DPrintf`va(cstr("Serverinfo packet received.\n"), VaNone())
    // wipe the client_state_t struct
    CL_ClearState()
    // parse protocol version number
    i = MSG_ReadLong()
    if (i != PROTOCOL_VERSION) {
        Con_Printf`va(cstr("Server returned version %i, not %i"), (i, PROTOCOL_VERSION))
        return
    }
    // parse maxclients
    cl.maxclients = MSG_ReadByte()
    if (cl.maxclients < 1 || cl.maxclients > MAX_SCOREBOARD) {
        Con_Printf`va(cstr("Bad maxclients (%u) from server\n"), (cl.maxclients,))
        return
    }
    cl.scores = reinterpret<scoreboard_t?>(Hunk_AllocName(int(uint64(cl.maxclients) * uint64(typeinfo sizeof(type<scoreboard_t>))), cstr("scores")))
    // parse gametype
    cl.gametype = MSG_ReadByte()
    // parse signon message
    str = MSG_ReadString()
    crt::strncpy(addr(cl.levelname[0]), str, uint64(typeinfo sizeof(type<uint8[40]>)) - 1ul)
    // seperate the printfs so the server message can have a color
    Con_Printf`va(cstr("\n\n\x1d\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1f\n\n"),
            VaNone())
    Con_Printf`va(cstr("%c%s\n"), (2, str))
    // first we go through and touch all of the precache data that still
    // happens to be in the cache, so precaching something else doesn't
    // needlessly purge it
    // precache models
    crt::memset(reinterpret<void?>(addr(cl.model_precache[0])), 0, uint64(typeinfo sizeof(type<model_s? [256]>)))
    nummodels = 1
    while (true) {
        str = MSG_ReadString()
        if (str[0] == 0) {
            break
        }
        if (nummodels == MAX_MODELS) {
            Con_Printf`va(cstr("Server sent too many model precaches\n"), VaNone())
            return
        }
        crt::strcpy(addr(model_precache[nummodels][0]), str)
        Mod_TouchModel(str)
        nummodels++
    }
    // precache sounds
    crt::memset(reinterpret<void?>(addr(cl.sound_precache[0])), 0, uint64(typeinfo sizeof(type<sfx_s? [256]>)))
    numsounds = 1
    while (true) {
        str = MSG_ReadString()
        if (str[0] == 0) {
            break
        }
        if (numsounds == MAX_SOUNDS) {
            Con_Printf`va(cstr("Server sent too many sound precaches\n"), VaNone())
            return
        }
        crt::strcpy(addr(sound_precache[numsounds][0]), str)
        S_TouchSound(str)
        numsounds++
    }
    // now we try to load everything else until a cache allocation fails
    for (i1 in range(1, nummodels)) {
        cl.model_precache[i1] = Mod_ForName(addr(model_precache[i1][0]), qboolean._c_false)
        if (cl.model_precache[i1] == null) {
            Con_Printf`va(cstr("Model %s not found\n"), (addr(model_precache[i1][0]),))
            return
        }
        CL_KeepaliveMessage()
    }
    S_BeginPrecaching()
    for (i1 in range(1, numsounds)) {
        cl.sound_precache[i1] = S_PrecacheSound(addr(sound_precache[i1][0]))
        CL_KeepaliveMessage()
    }
    S_EndPrecaching()
    // local state
    cl.worldmodel = cl.model_precache[1]
    cl_entities[0].model = cl.worldmodel
    R_NewMap()
    // make sure nothing is hurt
    Hunk_Check()
    // noclip is turned off at start
    noclip_anglehack = qboolean._c_false
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseUpdate(var bits : int) {
    var i : int
    var model : model_s?
    var modnum : int
    var forcelink : qboolean
    var ent : entity_s?
    var num : int
    var skin : int
    if (cls.signon == SIGNONS - 1) {
        // first update is the final signon stage
        cls.signon = SIGNONS
        CL_SignonReply()
    }
    if ((bits & U_MOREBITS) != 0) {
        i = MSG_ReadByte()
        bits |= i << 8
    }
    if ((bits & U_LONGENTITY) != 0) {
        num = MSG_ReadShort()
    } else {
        num = MSG_ReadByte()
    }
    ent = CL_EntityNum(num)
    for (i1 in range(16)) {
        if ((bits & (1 << i1)) != 0) {
            bitcounts[i1]++
        }
    }
    if (ent.msgtime != cl.mtime[1]) {
        // no previous frame to lerp from
        forcelink = qboolean._c_true
    } else {
        forcelink = qboolean._c_false
    }
    ent.msgtime = cl.mtime[0]
    if ((bits & U_MODEL) != 0) {
        modnum = MSG_ReadByte()
        if (modnum >= MAX_MODELS) {
            Host_Error`va(cstr("CL_ParseModel: bad modnum"), VaNone())
        }
    } else {
        modnum = ent.baseline.modelindex
    }
    model = cl.model_precache[modnum]
    if (intptr(model) != intptr(ent.model)) {
        ent.model = model
        // automatic animation (torches, etc) can be either all together
        // or randomized
        if (model != null) {
            if (model.synctype == synctype_t.ST_RAND) {
                ent.syncbase = float(crt::rand() & 32767) / 32767.0f
            } else {
                ent.syncbase = float(0.0lf)
            }
        } else {
            // hack to make null model players work
            forcelink = qboolean._c_true
        }
    }
    if ((bits & U_FRAME) != 0) {
        ent.frame = MSG_ReadByte()
    } else {
        ent.frame = ent.baseline.frame
    }
    if ((bits & U_COLORMAP) != 0) {
        i = MSG_ReadByte()
    } else {
        i = ent.baseline.colormap
    }
    if (i == 0) {
        ent.colormap = vid.colormap
    } else {
        if (i > cl.maxclients) {
            Sys_Error`va(cstr("i >= cl.maxclients"), VaNone())
        }
        ent.colormap = addr(cl.scores[i - 1].translations[0])
    }
    if ((bits & U_SKIN) != 0) {
        ent.skinnum = MSG_ReadByte()
    } else {
        ent.skinnum = ent.baseline.skin
    }
    if ((bits & U_EFFECTS) != 0) {
        ent.effects = MSG_ReadByte()
    } else {
        ent.effects = ent.baseline.effects
    }
    // shift the known values for interpolation
    ent.msg_origins[1][0] = ent.msg_origins[0][0]
    ent.msg_origins[1][1] = ent.msg_origins[0][1]
    ent.msg_origins[1][2] = ent.msg_origins[0][2]
    ent.msg_angles[1][0] = ent.msg_angles[0][0]
    ent.msg_angles[1][1] = ent.msg_angles[0][1]
    ent.msg_angles[1][2] = ent.msg_angles[0][2]
    if ((bits & U_ORIGIN1) != 0) {
        ent.msg_origins[0][0] = MSG_ReadCoord()
    } else {
        ent.msg_origins[0][0] = ent.baseline.origin[0]
    }
    if ((bits & U_ANGLE1) != 0) {
        ent.msg_angles[0][0] = MSG_ReadAngle()
    } else {
        ent.msg_angles[0][0] = ent.baseline.angles[0]
    }
    if ((bits & U_ORIGIN2) != 0) {
        ent.msg_origins[0][1] = MSG_ReadCoord()
    } else {
        ent.msg_origins[0][1] = ent.baseline.origin[1]
    }
    if ((bits & U_ANGLE2) != 0) {
        ent.msg_angles[0][1] = MSG_ReadAngle()
    } else {
        ent.msg_angles[0][1] = ent.baseline.angles[1]
    }
    if ((bits & U_ORIGIN3) != 0) {
        ent.msg_origins[0][2] = MSG_ReadCoord()
    } else {
        ent.msg_origins[0][2] = ent.baseline.origin[2]
    }
    if ((bits & U_ANGLE3) != 0) {
        ent.msg_angles[0][2] = MSG_ReadAngle()
    } else {
        ent.msg_angles[0][2] = ent.baseline.angles[2]
    }
    if ((bits & U_NOLERP) != 0) {
        ent.forcelink = qboolean._c_true
    }
    if (int(forcelink) != 0) {
        // didn't have an update last message
        ent.msg_origins[1][0] = ent.msg_origins[0][0]
        ent.msg_origins[1][1] = ent.msg_origins[0][1]
        ent.msg_origins[1][2] = ent.msg_origins[0][2]
        ent.origin[0] = ent.msg_origins[0][0]
        ent.origin[1] = ent.msg_origins[0][1]
        ent.origin[2] = ent.msg_origins[0][2]
        ent.msg_angles[1][0] = ent.msg_angles[0][0]
        ent.msg_angles[1][1] = ent.msg_angles[0][1]
        ent.msg_angles[1][2] = ent.msg_angles[0][2]
        ent.angles[0] = ent.msg_angles[0][0]
        ent.angles[1] = ent.msg_angles[0][1]
        ent.angles[2] = ent.msg_angles[0][2]
        ent.forcelink = qboolean._c_true
    }
}

// ==================
// CL_ParseBaseline
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def CL_ParseBaseline(var ent : entity_s?) {
    ent.baseline.modelindex = MSG_ReadByte()
    ent.baseline.frame = MSG_ReadByte()
    ent.baseline.colormap = MSG_ReadByte()
    ent.baseline.skin = MSG_ReadByte()
    for (i in range(3)) {
        ent.baseline.origin[i] = MSG_ReadCoord()
        ent.baseline.angles[i] = MSG_ReadAngle()
    }
}

// ==================
// CL_ParseClientdata
// Server information pertaining to this client only
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def CL_ParseClientdata(bits : int) {
    var i : int
    var j : int
    if ((bits & SU_VIEWHEIGHT) != 0) {
        cl.viewheight = float(MSG_ReadChar())
    } else {
        cl.viewheight = float(DEFAULT_VIEWHEIGHT)
    }
    if ((bits & SU_IDEALPITCH) != 0) {
        cl.idealpitch = float(MSG_ReadChar())
    } else {
        cl.idealpitch = 0.0f
    }
    cl.mvelocity[1][0] = cl.mvelocity[0][0]
    cl.mvelocity[1][1] = cl.mvelocity[0][1]
    cl.mvelocity[1][2] = cl.mvelocity[0][2]
    for (i1 in range(3)) {
        if ((bits & (SU_PUNCH1 << i1)) != 0) {
            cl.punchangle[i1] = float(MSG_ReadChar())
        } else {
            cl.punchangle[i1] = 0.0f
        }
        if ((bits & (SU_VELOCITY1 << i1)) != 0) {
            cl.mvelocity[0][i1] = float(MSG_ReadChar() * 16)
        } else {
            cl.mvelocity[0][i1] = 0.0f
        }
    }
    // [always sent] if (bits & SU_ITEMS)
    i = MSG_ReadLong()
    if (cl.items != i) {
        // set flash times
        Sbar_Changed()
        for (j1 in range(32)) {
            if ((i & (1 << j1)) != 0 && (cl.items & (1 << j1)) == 0) {
                cl.item_gettime[j1] = float(cl.time)
            }
        }
        cl.items = i
    }
    cl.onground = enum_from_int(type<qboolean>, int_of((bits & SU_ONGROUND) != 0))
    cl.inwater = enum_from_int(type<qboolean>, int_of((bits & SU_INWATER) != 0))
    if ((bits & SU_WEAPONFRAME) != 0) {
        cl.stats[STAT_WEAPONFRAME] = MSG_ReadByte()
    } else {
        cl.stats[STAT_WEAPONFRAME] = 0
    }
    if ((bits & SU_ARMOR) != 0) {
        i = MSG_ReadByte()
    } else {
        i = 0
    }
    if (cl.stats[STAT_ARMOR] != i) {
        cl.stats[STAT_ARMOR] = i
        Sbar_Changed()
    }
    if ((bits & SU_WEAPON) != 0) {
        i = MSG_ReadByte()
    } else {
        i = 0
    }
    if (cl.stats[STAT_WEAPON] != i) {
        cl.stats[STAT_WEAPON] = i
        Sbar_Changed()
    }
    i = MSG_ReadShort()
    if (cl.stats[STAT_HEALTH] != i) {
        cl.stats[STAT_HEALTH] = i
        Sbar_Changed()
    }
    i = MSG_ReadByte()
    if (cl.stats[STAT_AMMO] != i) {
        cl.stats[STAT_AMMO] = i
        Sbar_Changed()
    }
    for (i1 in range(4)) {
        j = MSG_ReadByte()
        if (cl.stats[STAT_SHELLS + i1] != j) {
            cl.stats[STAT_SHELLS + i1] = j
            Sbar_Changed()
        }
    }
    i = MSG_ReadByte()
    if (int(standard_quake) != 0) {
        if (cl.stats[STAT_ACTIVEWEAPON] != i) {
            cl.stats[STAT_ACTIVEWEAPON] = i
            Sbar_Changed()
        }
    } else {
        if (cl.stats[STAT_ACTIVEWEAPON] != (1 << i)) {
            cl.stats[STAT_ACTIVEWEAPON] = 1 << i
            Sbar_Changed()
        }
    }
}

// =====================
// CL_NewTranslation
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_NewTranslation(slot : int) {
    var i : int
    var top : int
    var bottom : int
    var dest : uint8?
    var source : uint8?
    if (slot > cl.maxclients) {
        Sys_Error`va(cstr("CL_NewTranslation: slot > cl.maxclients"), VaNone())
    }
    dest = addr(cl.scores[slot].translations[0])
    source = vid.colormap
    crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(vid.colormap), uint64(typeinfo sizeof(type<uint8[16384]>)))
    top = cl.scores[slot].colors & 240
    bottom = (cl.scores[slot].colors & 15) << 4
    i = 0
    while (i < VID_GRADES) {
        // the artists made some backwards ranges. sigh.
        if (top < 128) {
            crt::memcpy(reinterpret<void?>(dest + TOP_RANGE), reinterpret<void?>(source + top), 16ul)
        } else {
            for (j in range(16)) {
                dest[TOP_RANGE + j] = source[top + 15 - j]
            }
        }
        if (bottom < 128) {
            crt::memcpy(reinterpret<void?>(dest + BOTTOM_RANGE), reinterpret<void?>(source + bottom), 16ul)
        } else {
            for (j in range(16)) {
                dest[BOTTOM_RANGE + j] = source[bottom + 15 - j]
            }
        }
        i++
        dest += 256
        source += 256
    }
}

// =====================
// CL_ParseStatic
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseStatic {
    var ent : entity_s?
    var i : int
    i = cl.num_statics
    if (i >= MAX_STATIC_ENTITIES) {
        Host_Error`va(cstr("Too many static entities"), VaNone())
    }
    ent = addr(cl_static_entities[0]) + end_index(i, 128)
    cl.num_statics++
    CL_ParseBaseline(ent)
    // copy it to the current state
    ent.model = cl.model_precache[ent.baseline.modelindex]
    ent.frame = ent.baseline.frame
    ent.colormap = vid.colormap
    ent.skinnum = ent.baseline.skin
    ent.effects = ent.baseline.effects
    ent.origin[0] = ent.baseline.origin[0]
    ent.origin[1] = ent.baseline.origin[1]
    ent.origin[2] = ent.baseline.origin[2]
    ent.angles[0] = ent.baseline.angles[0]
    ent.angles[1] = ent.baseline.angles[1]
    ent.angles[2] = ent.baseline.angles[2]
    R_AddEfrags(ent)
}

// ===================
// CL_ParseStaticSound
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseStaticSound {
    var org : float[3]
    var sound_num : int
    var vol : int
    var atten : int
    for (i in range(3)) {
        org[i] = MSG_ReadCoord()
    }
