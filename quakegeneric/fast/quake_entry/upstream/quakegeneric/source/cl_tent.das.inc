// generated by c2das - regenerate, never edit
var cl_temp_entities : entity_s[64]
var cl_beams : beam_t[24]
var num_temp_entities : int
var cl_sfx_wizhit : sfx_s?
var cl_sfx_knighthit : sfx_s?
var cl_sfx_tink1 : sfx_s?
var cl_sfx_ric1 : sfx_s?
var cl_sfx_ric2 : sfx_s?
var cl_sfx_ric3 : sfx_s?
var cl_sfx_r_exp3 : sfx_s?

// =================
// CL_ParseTEnt
// =================
[unsafe_deref, hint(unsafe_range_check)]
def CL_InitTEnts {
    cl_sfx_wizhit = S_PrecacheSound(cstr("wizard/hit.wav"))
    cl_sfx_knighthit = S_PrecacheSound(cstr("hknight/hit.wav"))
    cl_sfx_tink1 = S_PrecacheSound(cstr("weapons/tink1.wav"))
    cl_sfx_ric1 = S_PrecacheSound(cstr("weapons/ric1.wav"))
    cl_sfx_ric2 = S_PrecacheSound(cstr("weapons/ric2.wav"))
    cl_sfx_ric3 = S_PrecacheSound(cstr("weapons/ric3.wav"))
    cl_sfx_r_exp3 = S_PrecacheSound(cstr("weapons/r_exp3.wav"))
}

// =================
// CL_ParseBeam
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseBeam(var m : model_s?) {
    var ent : int
    var start : float[3]
    var end : float[3]
    var b : beam_t?
    var i : int
    ent = MSG_ReadShort()
    start[0] = MSG_ReadCoord()
    start[1] = MSG_ReadCoord()
    start[2] = MSG_ReadCoord()
    end[0] = MSG_ReadCoord()
    end[1] = MSG_ReadCoord()
    end[2] = MSG_ReadCoord()
    // override any beam with the same entity
    i = 0
    b = addr(cl_beams[0])
    while (i < MAX_BEAMS) {
        if (b.entity == ent) {
            b.entity = ent
            b.model = m
            b.endtime = float(cl.time + 0.2lf)
            b.start[0] = start[0]
            b.start[1] = start[1]
            b.start[2] = start[2]
            b.end[0] = end[0]
            b.end[1] = end[1]
            b.end[2] = end[2]
            return
        }
        i++
        b++
    }
    // find a free beam
    i = 0
    b = addr(cl_beams[0])
    while (i < MAX_BEAMS) {
        if (b.model == null || double(b.endtime) < cl.time) {
            b.entity = ent
            b.model = m
            b.endtime = float(cl.time + 0.2lf)
            b.start[0] = start[0]
            b.start[1] = start[1]
            b.start[2] = start[2]
            b.end[0] = end[0]
            b.end[1] = end[1]
            b.end[2] = end[2]
            return
        }
        i++
        b++
    }
    Con_Printf`va(cstr("beam list overflow!\n"), VaNone())
}

// =================
// CL_ParseTEnt
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ParseTEnt {
    var _c_type : int
    var pos : float[3]
    var dl : dlight_t?
    var rnd : int
    var colorStart : int
    var colorLength : int
    _c_type = MSG_ReadByte()
    c_switch(_c_type) {
        case(7) {
            // spike hitting wall
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_RunParticleEffect(addr(pos[0]), addr(vec3_origin[0]), 20, 30)
            S_StartSound(-1, 0, cl_sfx_wizhit, addr(pos[0]), 1.0f, 1.0f)
            break
        }
        case(8) {
            // spike hitting wall
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_RunParticleEffect(addr(pos[0]), addr(vec3_origin[0]), 226, 20)
            S_StartSound(-1, 0, cl_sfx_knighthit, addr(pos[0]), 1.0f, 1.0f)
            break
        }
        case(0) {
            // spike hitting wall
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_RunParticleEffect(addr(pos[0]), addr(vec3_origin[0]), 0, 10)
            if (crt::rand() % 5 != 0) {
                S_StartSound(-1, 0, cl_sfx_tink1, addr(pos[0]), 1.0f, 1.0f)
            } else {
                rnd = crt::rand() & 3
                if (rnd == 1) {
                    S_StartSound(-1, 0, cl_sfx_ric1, addr(pos[0]), 1.0f, 1.0f)
                } elif (rnd == 2) {
                    S_StartSound(-1, 0, cl_sfx_ric2, addr(pos[0]), 1.0f, 1.0f)
                } else {
                    S_StartSound(-1, 0, cl_sfx_ric3, addr(pos[0]), 1.0f, 1.0f)
                }
            }
            break
        }
        case(1) {
            // super spike hitting wall
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_RunParticleEffect(addr(pos[0]), addr(vec3_origin[0]), 0, 20)
            if (crt::rand() % 5 != 0) {
                S_StartSound(-1, 0, cl_sfx_tink1, addr(pos[0]), 1.0f, 1.0f)
            } else {
                rnd = crt::rand() & 3
                if (rnd == 1) {
                    S_StartSound(-1, 0, cl_sfx_ric1, addr(pos[0]), 1.0f, 1.0f)
                } elif (rnd == 2) {
                    S_StartSound(-1, 0, cl_sfx_ric2, addr(pos[0]), 1.0f, 1.0f)
                } else {
                    S_StartSound(-1, 0, cl_sfx_ric3, addr(pos[0]), 1.0f, 1.0f)
                }
            }
            break
        }
        case(2) {
            // bullet hitting wall
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_RunParticleEffect(addr(pos[0]), addr(vec3_origin[0]), 0, 20)
            break
        }
        case(3) {
            // rocket explosion
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_ParticleExplosion(addr(pos[0]))
            dl = CL_AllocDlight(0)
            dl.origin[0] = pos[0]
            dl.origin[1] = pos[1]
            dl.origin[2] = pos[2]
            dl.radius = 350.0f
            dl.die = float(cl.time + 0.5lf)
            dl.decay = 300.0f
            S_StartSound(-1, 0, cl_sfx_r_exp3, addr(pos[0]), 1.0f, 1.0f)
            break
        }
        case(4) {
            // tarbaby explosion
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_BlobExplosion(addr(pos[0]))
            S_StartSound(-1, 0, cl_sfx_r_exp3, addr(pos[0]), 1.0f, 1.0f)
            break
        }
        case(5) {
            // lightning bolts
            CL_ParseBeam(Mod_ForName(cstr("progs/bolt.mdl"), qboolean._c_true))
            break
        }
        case(6) {
            // lightning bolts
            CL_ParseBeam(Mod_ForName(cstr("progs/bolt2.mdl"), qboolean._c_true))
            break
        }
        case(9) {
            // lightning bolts
            CL_ParseBeam(Mod_ForName(cstr("progs/bolt3.mdl"), qboolean._c_true))
            break
        }
        case(13) {
            // PGM 01/21/97
            // grappling hook beam
            CL_ParseBeam(Mod_ForName(cstr("progs/beam.mdl"), qboolean._c_true))
            break
        }
        case(10) {
            // PGM 01/21/97
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_LavaSplash(addr(pos[0]))
            break
        }
        case(11) {
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            R_TeleportSplash(addr(pos[0]))
            break
        }
        case(12) {
            // color mapped explosion
            pos[0] = MSG_ReadCoord()
            pos[1] = MSG_ReadCoord()
            pos[2] = MSG_ReadCoord()
            colorStart = MSG_ReadByte()
            colorLength = MSG_ReadByte()
            R_ParticleExplosion2(addr(pos[0]), colorStart, colorLength)
            dl = CL_AllocDlight(0)
            dl.origin[0] = pos[0]
            dl.origin[1] = pos[1]
            dl.origin[2] = pos[2]
            dl.radius = 350.0f
            dl.die = float(cl.time + 0.5lf)
            dl.decay = 300.0f
            S_StartSound(-1, 0, cl_sfx_r_exp3, addr(pos[0]), 1.0f, 1.0f)
            break
        }
        case(_) {
            Sys_Error`va(cstr("CL_ParseTEnt: bad type"), VaNone())
        }
    }
}

// =================
// CL_NewTempEntity
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_NewTempEntity : entity_s? {
    var ent : entity_s?
    if (cl_numvisedicts == MAX_VISEDICTS) {
        return null
    }
    if (num_temp_entities == MAX_TEMP_ENTITIES) {
        return null
    }
    ent = addr(cl_temp_entities[0]) + end_index(num_temp_entities, 64)
    crt::memset(reinterpret<void?>(ent), 0, uint64(typeinfo sizeof(type<entity_s>)))
    num_temp_entities++
    cl_visedicts[cl_numvisedicts] = ent
    cl_numvisedicts++
    ent.colormap = vid.colormap
    return ent
}

// =================
// CL_UpdateTEnts
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_UpdateTEnts {
    var i : int
    var j : int
    var b : beam_t?
    var dist : float[3]
    var org : float[3]
    var d : float
    var ent : entity_s?
    var yaw : float
    var pitch : float
    var forward : float
    num_temp_entities = 0
    // update lightning
    {
        i = 0
        b = addr(cl_beams[0])
        var _f = false
        while (true) {
            if (_f) {
                i++
                b++
            }
            _f = true
            if (!(i < MAX_BEAMS)) {
                break
            }
            if (b.model == null || double(b.endtime) < cl.time) {
                continue
            }
            // if coming from the player, update the start position
            if (b.entity == cl.viewentity) {
                b.start[0] = cl_entities[cl.viewentity].origin[0]
                b.start[1] = cl_entities[cl.viewentity].origin[1]
                b.start[2] = cl_entities[cl.viewentity].origin[2]
            }
            // calculate pitch and yaw
            dist[0] = b.end[0] - b.start[0]
            dist[1] = b.end[1] - b.start[1]
            dist[2] = b.end[2] - b.start[2]
            if (dist[1] == 0.0f && dist[0] == 0.0f) {
                yaw = 0.0f
                if (dist[2] > 0.0f) {
                    pitch = 90.0f
                } else {
                    pitch = 270.0f
                }
            } else {
                yaw = float(int(math::atan2(double(dist[1]), double(dist[0])) * 180.0lf / 3.141592653589793lf))
                if (yaw < 0.0f) {
                    yaw += 360.0f
                }
                forward = float(math::sqrt(double(dist[0] * dist[0] + dist[1] * dist[1])))
                pitch = float(int(math::atan2(double(dist[2]), double(forward)) * 180.0lf / 3.141592653589793lf))
                if (pitch < 0.0f) {
                    pitch += 360.0f
                }
            }
            // add new entities for the lightning
            org[0] = b.start[0]
            org[1] = b.start[1]
            org[2] = b.start[2]
            d = VectorNormalize(addr(dist[0]))
            while (d > 0.0f) {
                ent = CL_NewTempEntity()
                if (ent == null) {
                    return
                }
                ent.origin[0] = org[0]
                ent.origin[1] = org[1]
                ent.origin[2] = org[2]
                ent.model = b.model
                ent.angles[0] = pitch
                ent.angles[1] = yaw
                ent.angles[2] = float(crt::rand() % 360)
                j = 0
                while (j < 3) {
                    org[j] += dist[j] * 30.0f
                    j++
                }
                d -= 30.0f
            }
        }
    }
}

