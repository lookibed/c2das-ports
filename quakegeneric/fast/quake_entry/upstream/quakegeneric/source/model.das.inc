    loadmodel.vertexes = out
    loadmodel.numvertexes = count
    i = 0
    while (i < count) {
        out.position[0] = invoke(LittleFloat, _c_in.point[0])
        out.position[1] = invoke(LittleFloat, _c_in.point[1])
        out.position[2] = invoke(LittleFloat, _c_in.point[2])
        i++
        _c_in++
        out++
    }
}

