// =================
// Mod_LoadAliasModel
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadAliasModel(var mod : model_s?; var buffer : void?) {
    var i : int
    var pmodel : mdl_t?
    var pinmodel : mdl_t?
    var pstverts : stvert_t?
    var pinstverts : stvert_t?
    var pheader : aliashdr_t?
    var ptri : mtriangle_s?
    var pintriangles : dtriangle_s?
    var version : int
    var numframes : int
    var numskins : int
    var size : int
    var pframetype : daliasframetype_t?
    var pskintype : daliasskintype_t?
    var pskindesc : maliasskindesc_t?
    var skinsize : int
    var start : int
    var end : int
    var total : int
    start = Hunk_LowMark()
    pinmodel = reinterpret<mdl_t?>(buffer)
    version = invoke(LittleLong, pinmodel.version)
    if (version != ALIAS_VERSION) {
        Sys_Error`va(cstr("%s has wrong version number (%i should be %i)"), (addr(mod.name[0]), version, ALIAS_VERSION))
    }
    // allocate space for a working header, plus all the data except the frames,
    // skin and group info
    size = int(uint64(typeinfo sizeof(type<aliashdr_t>)) + uint64(invoke(LittleLong, pinmodel.numframes) - 1) *
            uint64(typeinfo sizeof(type<maliasframedesc_t>)) + uint64(typeinfo sizeof(type<mdl_t>)) + uint64(invoke(LittleLong, pinmodel.numverts)) *
            uint64(typeinfo sizeof(type<stvert_t>)) + uint64(invoke(LittleLong, pinmodel.numtris)) * uint64(typeinfo sizeof(type<mtriangle_s>)))
    pheader = reinterpret<aliashdr_t?>(Hunk_AllocName(size, addr(loadname[0])))
    pmodel = reinterpret<mdl_t?>(reinterpret<uint8?>(addr(pheader[1])) + uint64(invoke(LittleLong, pinmodel.numframes) - 1) *
            uint64(typeinfo sizeof(type<maliasframedesc_t>)))
    // mod->cache.data = pheader;
    mod.flags = invoke(LittleLong, pinmodel.flags)
    // endian-adjust and copy the data, starting with the alias model header
    pmodel.boundingradius = invoke(LittleFloat, pinmodel.boundingradius)
    pmodel.numskins = invoke(LittleLong, pinmodel.numskins)
    pmodel.skinwidth = invoke(LittleLong, pinmodel.skinwidth)
    pmodel.skinheight = invoke(LittleLong, pinmodel.skinheight)
    if (pmodel.skinheight > MAX_LBM_HEIGHT) {
        Sys_Error`va(cstr("model %s has a skin taller than %d"), (addr(mod.name[0]), MAX_LBM_HEIGHT))
    }
    pmodel.numverts = invoke(LittleLong, pinmodel.numverts)
    if (pmodel.numverts <= 0) {
        Sys_Error`va(cstr("model %s has no vertices"), (addr(mod.name[0]),))
    }
    if (pmodel.numverts > MAXALIASVERTS) {
        Sys_Error`va(cstr("model %s has too many vertices"), (addr(mod.name[0]),))
    }
    pmodel.numtris = invoke(LittleLong, pinmodel.numtris)
    if (pmodel.numtris <= 0) {
        Sys_Error`va(cstr("model %s has no triangles"), (addr(mod.name[0]),))
    }
    pmodel.numframes = invoke(LittleLong, pinmodel.numframes)
    pmodel.size = float(double(invoke(LittleFloat, pinmodel.size)) * ALIAS_BASE_SIZE_RATIO)
    mod.synctype = enum_from_int(type<synctype_t>, invoke(LittleLong, int(pinmodel.synctype)))
    mod.numframes = pmodel.numframes
    for (i1 in range(3)) {
        pmodel.scale[i1] = invoke(LittleFloat, pinmodel.scale[i1])
        pmodel.scale_origin[i1] = invoke(LittleFloat, pinmodel.scale_origin[i1])
        pmodel.eyeposition[i1] = invoke(LittleFloat, pinmodel.eyeposition[i1])
    }
    numskins = pmodel.numskins
    numframes = pmodel.numframes
    if ((pmodel.skinwidth & 3) != 0) {
        Sys_Error`va(cstr("Mod_LoadAliasModel: skinwidth not multiple of 4"), VaNone())
    }
    pheader.model = int(int64(reinterpret<uint8?>(pmodel) - reinterpret<uint8?>(pheader)))
    // load the skins
    skinsize = pmodel.skinheight * pmodel.skinwidth
    if (numskins < 1) {
        Sys_Error`va(cstr("Mod_LoadAliasModel: Invalid # of skins: %d\n"), (numskins,))
    }
    pskintype = reinterpret<daliasskintype_t?>(addr(pinmodel[1]))
    pskindesc = reinterpret<maliasskindesc_t?>(Hunk_AllocName(int(uint64(numskins) * uint64(typeinfo sizeof(type<maliasskindesc_t>))), addr(loadname[0])))
    pheader.skindesc = int(int64(reinterpret<uint8?>(pskindesc) - reinterpret<uint8?>(pheader)))
    for (i1 in range(numskins)) {
        var skintype : aliasskintype_t
        skintype = enum_from_int(type<aliasskintype_t>, invoke(LittleLong, int(pskintype._c_type)))
        pskindesc[i1]._c_type = skintype
        if (skintype == aliasskintype_t.ALIAS_SKIN_SINGLE) {
            pskintype = reinterpret<daliasskintype_t?>(Mod_LoadAliasSkin(reinterpret<void?>(pskintype + 1), addr(pskindesc[i1].skin), skinsize, pheader))
        } else {
            pskintype = reinterpret<daliasskintype_t?>(Mod_LoadAliasSkinGroup(reinterpret<void?>(pskintype + 1), addr(pskindesc[i1].skin), skinsize, pheader))
        }
    }
    // set base s and t vertices
    pstverts = reinterpret<stvert_t?>(addr(pmodel[1]))
    pinstverts = reinterpret<stvert_t?>(pskintype)
    pheader.stverts = int(int64(reinterpret<uint8?>(pstverts) - reinterpret<uint8?>(pheader)))
    i = 0
    while (i < pmodel.numverts) {
        pstverts[i].onseam = invoke(LittleLong, pinstverts[i].onseam)
        // put s and t in 16.16 format
        pstverts[i].s = invoke(LittleLong, pinstverts[i].s) << 16
        pstverts[i].t = invoke(LittleLong, pinstverts[i].t) << 16
        i++
    }
    // set up the triangles
    ptri = reinterpret<mtriangle_s?>(addr(pstverts[pmodel.numverts]))
    pintriangles = reinterpret<dtriangle_s?>(addr(pinstverts[pmodel.numverts]))
    pheader.triangles = int(int64(reinterpret<uint8?>(ptri) - reinterpret<uint8?>(pheader)))
    i = 0
    while (i < pmodel.numtris) {
        ptri[i].facesfront = invoke(LittleLong, pintriangles[i].facesfront)
        for (j in range(3)) {
            ptri[i].vertindex[j] = invoke(LittleLong, pintriangles[i].vertindex[j])
        }
        i++
    }
    // load the frames
    if (numframes < 1) {
        Sys_Error`va(cstr("Mod_LoadAliasModel: Invalid # of frames: %d\n"), (numframes,))
    }
    pframetype = reinterpret<daliasframetype_t?>(addr(pintriangles[pmodel.numtris]))
    for (i1 in range(numframes)) {
        var frametype : aliasframetype_t
        frametype = enum_from_int(type<aliasframetype_t>, invoke(LittleLong, int(pframetype._c_type)))
        addr(pheader.frames[0])[i1]._c_type = frametype
        if (frametype == aliasframetype_t.ALIAS_SINGLE) {
            pframetype = reinterpret<daliasframetype_t?>(Mod_LoadAliasFrame(reinterpret<void?>(pframetype + 1), addr(addr(pheader.frames[0])[i1].frame),
                    pmodel.numverts, addr(addr(pheader.frames[0])[i1].bboxmin), addr(addr(pheader.frames[0])[i1].bboxmax), pheader,
                    addr(addr(pheader.frames[0])[i1].name[0])))
        } else {
            pframetype = reinterpret<daliasframetype_t?>(Mod_LoadAliasGroup(reinterpret<void?>(pframetype + 1), addr(addr(pheader.frames[0])[i1].frame),
                    pmodel.numverts, addr(addr(pheader.frames[0])[i1].bboxmin), addr(addr(pheader.frames[0])[i1].bboxmax), pheader,
                    addr(addr(pheader.frames[0])[i1].name[0])))
        }
    }
    mod._c_type = modtype_t.mod_alias
    // FIXME: do this right
    mod.mins[2] = -16.0f
    mod.mins[1] = mod.mins[2]
    mod.mins[0] = mod.mins[1]
    mod.maxs[2] = 16.0f
    mod.maxs[1] = mod.maxs[2]
    mod.maxs[0] = mod.maxs[1]
    // move the complete, relocatable alias model to the cache
    end = Hunk_LowMark()
    total = end - start
    Cache_Alloc(addr(mod.cache), total, addr(loadname[0]))
    if (mod.cache.data == null) {
        return
    }
    crt::memcpy(mod.cache.data, reinterpret<void?>(pheader), uint64(total))
    Hunk_FreeToLowMark(start)
}

// =================
// Mod_LoadSpriteFrame
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadSpriteFrame(var pin : void?; var ppframe : mspriteframe_s ??) : void? {
    var pinframe : dspriteframe_t?
    var pspriteframe : mspriteframe_s?
    var i : int
    var width : int
    var height : int
    var size : int
    var origin : int[2]
    var ppixout : uint16?
    var ppixin : uint8?
    pinframe = reinterpret<dspriteframe_t?>(pin)
    width = invoke(LittleLong, pinframe.width)
    height = invoke(LittleLong, pinframe.height)
    size = width * height
    pspriteframe = reinterpret<mspriteframe_s?>(Hunk_AllocName(int(uint64(typeinfo sizeof(type<mspriteframe_s>)) + uint64(size)), addr(loadname[0])))
    Q_memset(reinterpret<void?>(pspriteframe), 0, int(uint64(typeinfo sizeof(type<mspriteframe_s>)) + uint64(size)))
    *ppframe = pspriteframe
    pspriteframe.width = width
    pspriteframe.height = height
    origin[0] = invoke(LittleLong, pinframe.origin[0])
    origin[1] = invoke(LittleLong, pinframe.origin[1])
    pspriteframe.up = float(origin[1])
    pspriteframe.down = float(origin[1] - height)
    pspriteframe.left = float(origin[0])
    pspriteframe.right = float(width + origin[0])
    Q_memcpy(reinterpret<void?>(addr(addr(pspriteframe.pixels[0])[0])), reinterpret<void?>(reinterpret<uint8?>(pinframe + 1)), size)
    return reinterpret<void?>(reinterpret<uint8?>(pinframe) + uint64(typeinfo sizeof(type<dspriteframe_t>)) + size)
}

// =================
// Mod_LoadSpriteGroup
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadSpriteGroup(var pin : void?; var ppframe : mspriteframe_s ??) : void? {
    var pingroup : dspritegroup_t?
    var pspritegroup : mspritegroup_t?
    var numframes : int
    var pin_intervals : dspriteinterval_t?
    var poutintervals : float?
    var ptemp : void?
    pingroup = reinterpret<dspritegroup_t?>(pin)
    numframes = invoke(LittleLong, pingroup.numframes)
    pspritegroup = reinterpret<mspritegroup_t?>(Hunk_AllocName(int(uint64(typeinfo sizeof(type<mspritegroup_t>)) + uint64(numframes - 1) *
                uint64(typeinfo sizeof(type<mspriteframe_s?>))),
            addr(loadname[0])))
    pspritegroup.numframes = numframes
    *ppframe = reinterpret<mspriteframe_s?>(pspritegroup)
    pin_intervals = reinterpret<dspriteinterval_t?>(pingroup + 1)
    poutintervals = reinterpret<float?>(Hunk_AllocName(int(uint64(numframes) * uint64(typeinfo sizeof(type<float>))), addr(loadname[0])))
    pspritegroup.intervals = poutintervals
    for (i in range(numframes)) {
        *poutintervals = invoke(LittleFloat, pin_intervals.interval)
        if (double(*poutintervals) <= 0.0lf) {
            Sys_Error`va(cstr("Mod_LoadSpriteGroup: interval<=0"), VaNone())
        }
        poutintervals++
        pin_intervals++
    }
    ptemp = reinterpret<void?>(pin_intervals)
    for (i in range(numframes)) {
        ptemp = Mod_LoadSpriteFrame(ptemp, addr(addr(pspritegroup.frames[0])[i]))
    }
    return ptemp
}

// =================
// Mod_LoadSpriteModel
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadSpriteModel(var mod : model_s?; var buffer : void?) {
    var version : int
    var pin : dsprite_t?
    var psprite : msprite_t?
    var numframes : int
    var size : int
    var pframetype : dspriteframetype_t?
    pin = reinterpret<dsprite_t?>(buffer)
    version = invoke(LittleLong, pin.version)
    if (version != SPRITE_VERSION) {
        Sys_Error`va(cstr("%s has wrong version number (%i should be %i)"), (addr(mod.name[0]), version, SPRITE_VERSION))
    }
    numframes = invoke(LittleLong, pin.numframes)
    size = int(uint64(typeinfo sizeof(type<msprite_t>)) + uint64(numframes - 1) * uint64(typeinfo sizeof(type<mspriteframedesc_t[1]>)))
    psprite = reinterpret<msprite_t?>(Hunk_AllocName(size, addr(loadname[0])))
    mod.cache.data = reinterpret<void?>(psprite)
    psprite._c_type = invoke(LittleLong, pin._c_type)
    psprite.maxwidth = invoke(LittleLong, pin.width)
    psprite.maxheight = invoke(LittleLong, pin.height)
    psprite.beamlength = invoke(LittleFloat, pin.beamlength)
    mod.synctype = enum_from_int(type<synctype_t>, invoke(LittleLong, int(pin.synctype)))
    psprite.numframes = numframes
    mod.mins[1] = float(-psprite.maxwidth / 2)
    mod.mins[0] = mod.mins[1]
    mod.maxs[1] = float(psprite.maxwidth / 2)
    mod.maxs[0] = mod.maxs[1]
    mod.mins[2] = float(-psprite.maxheight / 2)
    mod.maxs[2] = float(psprite.maxheight / 2)
    // load the frames
    if (numframes < 1) {
        Sys_Error`va(cstr("Mod_LoadSpriteModel: Invalid # of frames: %d\n"), (numframes,))
    }
    mod.numframes = numframes
    mod.flags = 0
    pframetype = reinterpret<dspriteframetype_t?>(pin + 1)
    for (i in range(numframes)) {
        var frametype : spriteframetype_t
        frametype = enum_from_int(type<spriteframetype_t>, invoke(LittleLong, int(pframetype._c_type)))
        addr(psprite.frames[0])[i]._c_type = frametype
        if (frametype == spriteframetype_t.SPR_SINGLE) {
            pframetype = reinterpret<dspriteframetype_t?>(Mod_LoadSpriteFrame(reinterpret<void?>(pframetype + 1), addr(addr(psprite.frames[0])[i].frameptr)))
        } else {
            pframetype = reinterpret<dspriteframetype_t?>(Mod_LoadSpriteGroup(reinterpret<void?>(pframetype + 1), addr(addr(psprite.frames[0])[i].frameptr)))
        }
    }
    mod._c_type = modtype_t.mod_sprite
}

// ================
// Mod_Print
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_Print {
    var i : int
    var mod : model_s?
    Con_Printf`va(cstr("Cached models:\n"), VaNone())
    i = 0
    mod = addr(mod_known[0])
    while (i < mod_numknown) {
        Con_Printf`va(cstr("%8p : %s"), (mod.cache.data, addr(mod.name[0])))
        if ((uint(mod.needload) & uint(NL_UNREFERENCED)) != 0) {
            Con_Printf`va(cstr(" (!R)"), VaNone())
        }
        if ((uint(mod.needload) & uint(NL_NEEDS_LOADED)) != 0) {
            Con_Printf`va(cstr(" (!P)"), VaNone())
        }
        Con_Printf`va(cstr("\n"), VaNone())
        i++
        mod++
    }
}

