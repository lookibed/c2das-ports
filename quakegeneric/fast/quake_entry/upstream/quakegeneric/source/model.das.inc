// =================
// Mod_LoadTexinfo
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadTexinfo(var l : lump_t?) {
    var _c_in : texinfo_s?
    var out : mtexinfo_t?
    var i : int
    var count : int
    var miptex : int
    var len1 : float
    var len2 : float
    _c_in = reinterpret<texinfo_s?>(reinterpret<void?>(mod_base + l.fileofs))
    if (uint64(l.filelen) % uint64(typeinfo sizeof(type<texinfo_s>)) != 0) {
        Sys_Error`va(cstr("MOD_LoadBmodel: funny lump size in %s"), (addr(loadmodel.name[0]),))
    }
    count = int(uint64(l.filelen) / uint64(typeinfo sizeof(type<texinfo_s>)))
    out = reinterpret<mtexinfo_t?>(Hunk_AllocName(int(uint64(count) * uint64(typeinfo sizeof(type<mtexinfo_t>))), addr(loadname[0])))
    loadmodel.texinfo = out
    loadmodel.numtexinfo = count
    i = 0
    while (i < count) {
        for (j in range(8)) {
            addr(out.vecs[0][0])[j] = invoke(LittleFloat, addr(_c_in.vecs[0][0])[j])
        }
        len1 = Length(addr(out.vecs[0][0]))
        len2 = Length(addr(out.vecs[1][0]))
        len1 = (len1 + len2) / 2.0f
        if (double(len1) < 0.32lf) {
            out.mipadjust = 4.0f
        } elif (double(len1) < 0.49lf) {
            out.mipadjust = 3.0f
        } elif (double(len1) < 0.99lf) {
            out.mipadjust = 2.0f
        } else {
            out.mipadjust = 1.0f
        }
        // don't crash
        miptex = invoke(LittleLong, _c_in.miptex)
        out.flags = invoke(LittleLong, _c_in.flags)
        if (loadmodel.textures == null) {
            // checkerboard texture
            out.texture = r_notexture_mip
            out.flags = 0
        } else {
            if (miptex >= loadmodel.numtextures) {
                Sys_Error`va(cstr("miptex >= loadmodel->numtextures"), VaNone())
            }
            out.texture = loadmodel.textures[miptex]
            if (out.texture == null) {
                // texture not found
                out.texture = r_notexture_mip
                out.flags = 0
            }
        }
        i++
        _c_in++
        out++
    }
}

// ================
// CalcSurfaceExtents
// Fills in s->texturemins[] and s->extents[]
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CalcSurfaceExtents(var s : msurface_s?) {
    var mins : float[2]
    var maxs : float[2]
    var val : float
    var e : int
    var v : mvertex_t?
    var tex : mtexinfo_t?
    var bmins : int[2]
    var bmaxs : int[2]
    mins[1] = 999999.0f
    mins[0] = mins[1]
    maxs[1] = -99999.0f
    maxs[0] = maxs[1]
    tex = s.texinfo
    for (i in range(s.numedges)) {
        e = loadmodel.surfedges[s.firstedge + i]
        if (e >= 0) {
            v = addr(loadmodel.vertexes[int(loadmodel.edges[e].v[0])])
        } else {
            v = addr(loadmodel.vertexes[int(loadmodel.edges[-e].v[1])])
        }
        for (j in range(2)) {
            val = v.position[0] * addr(tex.vecs[j][0])[0] + v.position[1] * addr(tex.vecs[j][0])[1] + v.position[2] * addr(tex.vecs[j][0])[2] + addr(tex.vecs[j][0])[3]
            if (val < mins[j]) {
                mins[j] = val
            }
            if (val > maxs[j]) {
                maxs[j] = val
            }
        }
    }
    for (i in range(2)) {
        bmins[i] = int(math::floor(double(mins[i] / 16.0f)))
        bmaxs[i] = int(math::ceil(double(maxs[i] / 16.0f)))
        s.texturemins[i] = int16(bmins[i] * 16)
        s.extents[i] = int16((bmaxs[i] - bmins[i]) * 16)
        if ((tex.flags & TEX_SPECIAL) == 0 && int(s.extents[i]) > 256) {
            Sys_Error`va(cstr("Bad surface extents"), VaNone())
        }
    }
}

// =================
// Mod_LoadFaces
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadFaces(var l : lump_t?) {
    var _c_in : dface_t?
    var out : msurface_s?
    var i : int
    var count : int
    var surfnum : int
    var planenum : int
    var side : int
    _c_in = reinterpret<dface_t?>(reinterpret<void?>(mod_base + l.fileofs))
    if (uint64(l.filelen) % uint64(typeinfo sizeof(type<dface_t>)) != 0) {
        Sys_Error`va(cstr("MOD_LoadBmodel: funny lump size in %s"), (addr(loadmodel.name[0]),))
    }
    count = int(uint64(l.filelen) / uint64(typeinfo sizeof(type<dface_t>)))
    out = reinterpret<msurface_s?>(Hunk_AllocName(int(uint64(count) * uint64(typeinfo sizeof(type<msurface_s>))), addr(loadname[0])))
    loadmodel.surfaces = out
    loadmodel.numsurfaces = count
    surfnum = 0
    while (surfnum < count) {
        {
            out.firstedge = invoke(LittleLong, _c_in.firstedge)
            out.numedges = int(invoke(LittleShort, _c_in.numedges))
            out.flags = 0
            planenum = int(invoke(LittleShort, _c_in.planenum))
            side = int(invoke(LittleShort, _c_in.side))
            if (side != 0) {
                out.flags |= SURF_PLANEBACK
            }
            out.plane = loadmodel.planes + planenum
            out.texinfo = loadmodel.texinfo + int(invoke(LittleShort, _c_in.texinfo))
            CalcSurfaceExtents(out)
            // lighting info
            for (i1 in range(MAXLIGHTMAPS)) {
                out.styles[i1] = _c_in.styles[i1]
            }
            i = invoke(LittleLong, _c_in.lightofs)
            if (i == -1) {
                out.samples = null
            } else {
                out.samples = loadmodel.lightdata + i
            }
            // set the drawing flags flag
            // sky
            if (Q_strncmp(addr(out.texinfo.texture.name[0]), cstr("sky"), 3) == 0) {
                out.flags |= SURF_DRAWSKY | SURF_DRAWTILED
                continue
            }
            // turbulent
            if (Q_strncmp(addr(out.texinfo.texture.name[0]), cstr("*"), 1) == 0) {
                out.flags |= SURF_DRAWTURB | SURF_DRAWTILED
                i = 0
                while (i < 2) {
                    out.extents[i] = int16(16384)
                    out.texturemins[i] = int16(-8192)
                    i++
                }
                continue
            }
        } finally {
            surfnum++
            _c_in++
            out++
        }
    }
}

// =================
// Mod_SetParent
// =================
[unsafe_deref, hint(unsafe_range_check)]
def Mod_SetParent(var node : mnode_s?; var parent : mnode_s?) {
    node.parent = parent
    if (node.contents < 0) {
        return
    }
    Mod_SetParent(node.children[0], node)
    Mod_SetParent(node.children[1], node)
}

// =================
// Mod_LoadNodes
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadNodes(var l : lump_t?) {
    var i : int
    var count : int
    var p : int
    var _c_in : dnode_t?
    var out : mnode_s?
    _c_in = reinterpret<dnode_t?>(reinterpret<void?>(mod_base + l.fileofs))
    if (uint64(l.filelen) % uint64(typeinfo sizeof(type<dnode_t>)) != 0) {
        Sys_Error`va(cstr("MOD_LoadBmodel: funny lump size in %s"), (addr(loadmodel.name[0]),))
    }
    count = int(uint64(l.filelen) / uint64(typeinfo sizeof(type<dnode_t>)))
    out = reinterpret<mnode_s?>(Hunk_AllocName(int(uint64(count) * uint64(typeinfo sizeof(type<mnode_s>))), addr(loadname[0])))
    loadmodel.nodes = out
    loadmodel.numnodes = count
    i = 0
    while (i < count) {
        for (j in range(3)) {
            out.minmaxs[j] = invoke(LittleShort, _c_in.mins[j])
            out.minmaxs[3 + j] = invoke(LittleShort, _c_in.maxs[j])
        }
        p = invoke(LittleLong, _c_in.planenum)
        out.plane = loadmodel.planes + p
        out.firstsurface = uint16(invoke(LittleShort, int16(_c_in.firstface)))
        out.numsurfaces = uint16(invoke(LittleShort, int16(_c_in.numfaces)))
        for (j in range(2)) {
            p = int(invoke(LittleShort, _c_in.children[j]))
            if (p >= 0) {
                out.children[j] = loadmodel.nodes + p
            } else {
                out.children[j] = reinterpret<mnode_s?>(loadmodel.leafs + (-1 - p))
            }
        }
        i++
        _c_in++
        out++
    }
    // sets nodes and leafs
    Mod_SetParent(loadmodel.nodes, null)
}

