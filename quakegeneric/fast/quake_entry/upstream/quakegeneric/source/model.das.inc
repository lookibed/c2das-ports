    loadmodel.clipnodes = out
    loadmodel.numclipnodes = count
    hull = addr(loadmodel.hulls[1])
    hull.clipnodes = out
    hull.firstclipnode = 0
    hull.lastclipnode = count - 1
    hull.planes = loadmodel.planes
    hull.clip_mins[0] = -16.0f
    hull.clip_mins[1] = -16.0f
    hull.clip_mins[2] = -24.0f
    hull.clip_maxs[0] = 16.0f
    hull.clip_maxs[1] = 16.0f
    hull.clip_maxs[2] = 32.0f
    hull = addr(loadmodel.hulls[2])
    hull.clipnodes = out
    hull.firstclipnode = 0
    hull.lastclipnode = count - 1
    hull.planes = loadmodel.planes
    hull.clip_mins[0] = -32.0f
    hull.clip_mins[1] = -32.0f
    hull.clip_mins[2] = -24.0f
    hull.clip_maxs[0] = 32.0f
    hull.clip_maxs[1] = 32.0f
    hull.clip_maxs[2] = 64.0f
    i = 0
    while (i < count) {
        out.planenum = invoke(LittleLong, _c_in.planenum)
        out.children[0] = invoke(LittleShort, _c_in.children[0])
        out.children[1] = invoke(LittleShort, _c_in.children[1])
        i++
        out++
        _c_in++
    }
}

// =================
// Mod_MakeHull0
// Deplicate the drawing hull structure as a clipping hull
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_MakeHull0 {
    var _c_in : mnode_s?
    var child : mnode_s?
    var out : dclipnode_t?
    var i : int
    var count : int
    var hull : hull_t?
    hull = addr(loadmodel.hulls[0])
    _c_in = loadmodel.nodes
    count = loadmodel.numnodes
    out = reinterpret<dclipnode_t?>(Hunk_AllocName(int(uint64(count) * uint64(typeinfo sizeof(type<dclipnode_t>))), addr(loadname[0])))
    hull.clipnodes = out
    hull.firstclipnode = 0
    hull.lastclipnode = count - 1
    hull.planes = loadmodel.planes
    i = 0
    while (i < count) {
        out.planenum = int(int64(_c_in.plane - loadmodel.planes))
        for (j in range(2)) {
            child = _c_in.children[j]
            if (child.contents < 0) {
                out.children[j] = int16(child.contents)
            } else {
                out.children[j] = int16(int64(child - loadmodel.nodes))
            }
        }
        i++
        out++
        _c_in++
    }
}

