// generated by c2das - regenerate, never edit
var loadmodel : model_s?
var loadname : uint8[32]
var mod_novis : uint8[1024]
var mod_known : model_s[256]
var mod_numknown : int
var private Mod_DecompressVis_decompressed : uint8[1024]
var mod_base : uint8?

// ===============
// Mod_Init
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_Init {
    crt::memset(reinterpret<void?>(addr(mod_novis[0])), 255, uint64(typeinfo sizeof(type<uint8[1024]>)))
}

// ===============
// Mod_Extradata
// Caches the data if needed
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_Extradata(var mod : model_s?) : void? {
    var r : void?
    r = Cache_Check(addr(mod.cache))
    if (r != null) {
        return r
    }
    Mod_LoadModel(mod, qboolean._c_true)
    if (mod.cache.data == null) {
        Sys_Error`va(cstr("Mod_Extradata: caching failed"), VaNone())
    }
    return mod.cache.data
}

// ===============
// Mod_PointInLeaf
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_PointInLeaf(var p : float?; var model : model_s?) : mleaf_s? {
    var node : mnode_s?
    var d : float
    var plane : mplane_s?
    if (model == null || model.nodes == null) {
        Sys_Error`va(cstr("Mod_PointInLeaf: bad model"), VaNone())
    }
    node = model.nodes
    while (1 != 0) {
        if (node.contents < 0) {
            return reinterpret<mleaf_s?>(node)
        }
        plane = node.plane
        d = p[0] * plane.normal[0] + p[1] * plane.normal[1] + p[2] * plane.normal[2] - plane.dist
        if (d > 0.0f) {
            node = node.children[0]
        } else {
            node = node.children[1]
        }
    }
    // never reached
    return null
}

// ===================
// Mod_DecompressVis
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_DecompressVis(var _c_in : uint8?; var model : model_s?) : uint8? {
    var c : int
    var out : uint8?
    var row : int
    row = (model.numleafs + 7) >> 3
    out = addr(Mod_DecompressVis_decompressed[0])
    if (_c_in == null) {
        // no vis info, so make all visible
        while (row != 0) {
            var _t0 = out
            out++
            *_t0 = 255u8
            row--
        }
        return addr(Mod_DecompressVis_decompressed[0])
    }
    c_do_while(int64(out - addr(Mod_DecompressVis_decompressed[0])) < int64(row)) {
        if (*_c_in != 0) {
            var _t1 = out
            out++
            var _t2 = _c_in
            _c_in++
            *_t1 = *_t2
            continue
        }
        c = int(_c_in[1])
        _c_in += 2
        while (c != 0) {
            var _t3 = out
            out++
            *_t3 = 0u8
            c--
        }
    }
    return addr(Mod_DecompressVis_decompressed[0])
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LeafPVS(var leaf : mleaf_s?; var model : model_s?) : uint8? {
    if (leaf == model.leafs) {
        return addr(mod_novis[0])
    }
    return Mod_DecompressVis(leaf.compressed_vis, model)
}

// ===================
// Mod_ClearAll
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_ClearAll {
    var i : int
    var mod : model_s?
    i = 0
    mod = addr(mod_known[0])
    while (i < mod_numknown) {
        mod.needload = enum_from_int(type<qboolean>, NL_UNREFERENCED)
        // FIX FOR CACHE_ALLOC ERRORS:
        if (mod._c_type == modtype_t.mod_sprite) {
            mod.cache.data = null
        }
        i++
        mod++
    }
}

// ==================
// Mod_FindName
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_FindName(var name : uint8?) : model_s? {
    var i : int
    var mod : model_s?
    var avail : model_s? = null
    if (name[0] == 0) {
        Sys_Error`va(cstr("Mod_ForName: NULL name"), VaNone())
    }
    // search the currently loaded models
    i = 0
    mod = addr(mod_known[0])
    while (i < mod_numknown) {
        if (crt::strcmp(addr(mod.name[0]), name) == 0) {
            break
        }
        if (uint(mod.needload) == uint(NL_UNREFERENCED)) {
            if (avail == null || mod._c_type != modtype_t.mod_alias) {
                avail = mod
            }
        }
        i++
        mod++
    }
    if (i == mod_numknown) {
        if (mod_numknown == MAX_MOD_KNOWN) {
            if (avail != null) {
                mod = avail
                if (mod._c_type == modtype_t.mod_alias) {
                    if (Cache_Check(addr(mod.cache)) != null) {
                        Cache_Free(addr(mod.cache))
                    }
                }
            } else {
                Sys_Error`va(cstr("mod_numknown == MAX_MOD_KNOWN"), VaNone())
            }
        } else {
            mod_numknown++
        }
        crt::strcpy(addr(mod.name[0]), name)
        mod.needload = qboolean._c_true
    }
    return mod
}

// ==================
// Mod_TouchModel
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_TouchModel(var name : uint8?) {
    var mod : model_s?
    mod = Mod_FindName(name)
    if (uint(mod.needload) == uint(NL_PRESENT)) {
        if (mod._c_type == modtype_t.mod_alias) {
            Cache_Check(addr(mod.cache))
        }
    }
}

// ==================
// Mod_LoadModel
// Loads a model into the cache
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadModel(var mod : model_s?; crash : qboolean) : model_s? {
    var buf : uint?
    // avoid dirtying the cache heap
    var stackbuf : uint8[1024]
    if (mod._c_type == modtype_t.mod_alias) {
        if (Cache_Check(addr(mod.cache)) != null) {
            mod.needload = qboolean._c_false
            return mod
        }
    } else {
        if (uint(mod.needload) == uint(NL_PRESENT)) {
            return mod
        }
    }
    // because the world is so huge, load it one piece at a time
    // load the file
    buf = reinterpret<uint?>(COM_LoadStackFile(addr(mod.name[0]), reinterpret<void?>(addr(stackbuf[0])), typeinfo sizeof(type<uint8[1024]>)))
    if (buf == null) {
        if (int(crash) != 0) {
            Sys_Error`va(cstr("Mod_NumForName: %s not found"), (addr(mod.name[0]),))
        }
        return null
    }
    // allocate a new model
    COM_FileBase(addr(mod.name[0]), addr(loadname[0]), 32ul)
    loadmodel = mod
    // fill it in
    // call the apropriate loader
    mod.needload = qboolean._c_false
    c_switch(invoke(LittleLong, int(*buf))) {
        case(1330660425) {
            Mod_LoadAliasModel(mod, reinterpret<void?>(buf))
            break
        }
        case(1347634249) {
            Mod_LoadSpriteModel(mod, reinterpret<void?>(buf))
            break
        }
        case(_) {
            Mod_LoadBrushModel(mod, reinterpret<void?>(buf))
            break
        }
    }
    return mod
}

// ==================
// Mod_ForName
// Loads in a model for the given name
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def Mod_ForName(var name : uint8?; crash : qboolean) : model_s? {
    var mod : model_s?
    mod = Mod_FindName(name)
    return Mod_LoadModel(mod, crash)
}

// =================
// Mod_LoadTextures
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadTextures(var l : lump_t?) {
    var i : int
    var j : int
    var pixels : int
    var num : int
    var max : int
    var altmax : int
    var mt : miptex_s?
    var tx : texture_s?
    var tx2 : texture_s?
    var anims : texture_s? [10]
    var altanims : texture_s? [10]
    var m : dmiptexlump_t?
    if (l.filelen == 0) {
        loadmodel.textures = null
        return
    }
    m = reinterpret<dmiptexlump_t?>(mod_base + l.fileofs)
    m.nummiptex = invoke(LittleLong, m.nummiptex)
    loadmodel.numtextures = m.nummiptex
    loadmodel.textures = reinterpret<texture_s ??>(Hunk_AllocName(int(uint64(m.nummiptex) * uint64(typeinfo sizeof(type<texture_s?>))), addr(loadname[0])))
    i = 0
    while (i < m.nummiptex) {
        {
            addr(m.dataofs[0])[i] = invoke(LittleLong, addr(m.dataofs[0])[i])
            if (addr(m.dataofs[0])[i] == -1) {
                continue
            }
            mt = reinterpret<miptex_s?>(reinterpret<uint8?>(m) + addr(m.dataofs[0])[i])
            mt.width = uint(invoke(LittleLong, int(mt.width)))
            mt.height = uint(invoke(LittleLong, int(mt.height)))
            for (j1 in range(MIPLEVELS)) {
                mt.offsets[j1] = uint(invoke(LittleLong, int(mt.offsets[j1])))
            }
            if ((mt.width & 15u) != 0 || (mt.height & 15u) != 0) {
                Sys_Error`va(cstr("Texture %s is not 16 aligned"), (addr(mt.name[0]),))
            }
            pixels = int(mt.width * mt.height / 64u * 85u)
            tx = reinterpret<texture_s?>(Hunk_AllocName(int(uint64(typeinfo sizeof(type<texture_s>)) + uint64(pixels)), addr(loadname[0])))
            loadmodel.textures[i] = tx
            crt::memcpy(reinterpret<void?>(addr(tx.name[0])), reinterpret<void?>(addr(mt.name[0])), uint64(typeinfo sizeof(type<uint8[16]>)))
            tx.width = mt.width
            tx.height = mt.height
            j = 0
            while (j < MIPLEVELS) {
                tx.offsets[j] = uint(uint64(mt.offsets[j]) + uint64(typeinfo sizeof(type<texture_s>)) - uint64(typeinfo sizeof(type<miptex_s>)))
                j++
            }
            // the pixels immediately follow the structures
            crt::memcpy(reinterpret<void?>(tx + 1), reinterpret<void?>(mt + 1), uint64(pixels))
            if (Q_strncmp(addr(mt.name[0]), cstr("sky"), 3) == 0) {
                R_InitSky(tx)
            }
        } finally {
            i++
        }
    }
    // sequence the animations
    i = 0
    while (i < m.nummiptex) {
        {
            tx = loadmodel.textures[i]
            if (tx == null || tx.name[0] != '+') {
                continue
            }
            if (tx.anim_next != null) {
                // allready sequenced
                continue
            }
            // find the number of frames in the animation
            crt::memset(reinterpret<void?>(addr(anims[0])), 0, uint64(typeinfo sizeof(type<texture_s? [10]>)))
            crt::memset(reinterpret<void?>(addr(altanims[0])), 0, uint64(typeinfo sizeof(type<texture_s? [10]>)))
            max = int(tx.name[1])
            altmax = 0
            if (max >= 'a' && max <= 'z') {
                max -= 'a' - 'A'
            }
            if (max >= '0' && max <= '9') {
                max -= '0'
                altmax = 0
                anims[max] = tx
                max++
            } elif (max >= 'A' && max <= 'J') {
                altmax = max - 'A'
                max = 0
                altanims[altmax] = tx
                altmax++
            } else {
                Sys_Error`va(cstr("Bad animating texture %s"), (addr(tx.name[0]),))
            }
            j = i + 1
            while (j < m.nummiptex) {
                {
                    tx2 = loadmodel.textures[j]
                    if (tx2 == null || tx2.name[0] != '+') {
                        continue
                    }
                    if (crt::strcmp(addr(tx2.name[0]) + 2, addr(tx.name[0]) + 2) != 0) {
                        continue
                    }
                    num = int(tx2.name[1])
                    if (num >= 'a' && num <= 'z') {
                        num -= 'a' - 'A'
                    }
                    if (num >= '0' && num <= '9') {
                        num -= '0'
                        anims[num] = tx2
                        if (num + 1 > max) {
                            max = num + 1
                        }
                    } elif (num >= 'A' && num <= 'J') {
                        num -= 'A'
                        altanims[num] = tx2
                        if (num + 1 > altmax) {
                            altmax = num + 1
                        }
                    } else {
                        Sys_Error`va(cstr("Bad animating texture %s"), (addr(tx.name[0]),))
                    }
                } finally {
                    j++
                }
            }
            // link them all together
            for (j1 in range(max)) {
                tx2 = anims[j1]
                if (tx2 == null) {
                    Sys_Error`va(cstr("Missing frame %i of %s"), (j1, addr(tx.name[0])))
                }
                tx2.anim_total = max * ANIM_CYCLE
                tx2.anim_min = j1 * ANIM_CYCLE
                tx2.anim_max = (j1 + 1) * ANIM_CYCLE
                tx2.anim_next = anims[(j1 + 1) % max]
                if (altmax != 0) {
                    tx2.alternate_anims = altanims[0]
                }
            }
            j = 0
            while (j < altmax) {
                tx2 = altanims[j]
                if (tx2 == null) {
                    Sys_Error`va(cstr("Missing frame %i of %s"), (j, addr(tx.name[0])))
                }
                tx2.anim_total = altmax * ANIM_CYCLE
                tx2.anim_min = j * ANIM_CYCLE
                tx2.anim_max = (j + 1) * ANIM_CYCLE
                tx2.anim_next = altanims[(j + 1) % altmax]
                if (max != 0) {
                    tx2.alternate_anims = anims[0]
                }
                j++
            }
        } finally {
            i++
        }
    }
}

