// =================
// Mod_LoadPlanes
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadPlanes(var l : lump_t?) {
    var i : int
    var out : mplane_s?
    var _c_in : dplane_t?
    var count : int
    var bits : int
    _c_in = reinterpret<dplane_t?>(reinterpret<void?>(mod_base + l.fileofs))
    if (uint64(l.filelen) % uint64(typeinfo sizeof(type<dplane_t>)) != 0) {
        Sys_Error`va(cstr("MOD_LoadBmodel: funny lump size in %s"), (addr(loadmodel.name[0]),))
    }
    count = int(uint64(l.filelen) / uint64(typeinfo sizeof(type<dplane_t>)))
    out = reinterpret<mplane_s?>(Hunk_AllocName(int(uint64(count * 2) * uint64(typeinfo sizeof(type<mplane_s>))), addr(loadname[0])))
    loadmodel.planes = out
    loadmodel.numplanes = count
    i = 0
    while (i < count) {
        bits = 0
        for (j in range(3)) {
            out.normal[j] = invoke(LittleFloat, _c_in.normal[j])
            if (out.normal[j] < 0.0f) {
                bits |= 1 << j
            }
        }
        out.dist = invoke(LittleFloat, _c_in.dist)
        out._c_type = uint8(invoke(LittleLong, _c_in._c_type))
        out.signbits = uint8(bits)
        i++
        _c_in++
        out++
    }
}

// =================
// RadiusFromBounds
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def RadiusFromBounds(var mins : float?; var maxs : float?) : float {
    var corner : float[3]
    for (i in range(3)) {
        corner[i] = float(math::abs(double(mins[i])) > math::abs(double(maxs[i])) ? math::abs(double(mins[i])) : math::abs(double(maxs[i])))
    }
    return Length(addr(corner[0]))
}

// =================
// Mod_LoadBrushModel
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadBrushModel(var mod : model_s?; var buffer : void?) {
    var i : int
    var header : dheader_t?
    var bm : dmodel_t?
    loadmodel._c_type = modtype_t.mod_brush
    header = reinterpret<dheader_t?>(buffer)
    i = invoke(LittleLong, header.version)
    if (i != BSPVERSION) {
        Sys_Error`va(cstr("Mod_LoadBrushModel: %s has wrong version number (%i should be %i)"), (addr(mod.name[0]), i, BSPVERSION))
    }
    // swap all the lumps
    mod_base = reinterpret<uint8?>(header)
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<dheader_t>)) / 4ul) {
        reinterpret<int?>(header)[i] = invoke(LittleLong, reinterpret<int?>(header)[i])
        i++
    }
    // load into heap
    Mod_LoadVertexes(addr(header.lumps[LUMP_VERTEXES]))
    Mod_LoadEdges(addr(header.lumps[LUMP_EDGES]))
    Mod_LoadSurfedges(addr(header.lumps[LUMP_SURFEDGES]))
    Mod_LoadTextures(addr(header.lumps[LUMP_TEXTURES]))
    Mod_LoadLighting(addr(header.lumps[LUMP_LIGHTING]))
    Mod_LoadPlanes(addr(header.lumps[LUMP_PLANES]))
    Mod_LoadTexinfo(addr(header.lumps[LUMP_TEXINFO]))
    Mod_LoadFaces(addr(header.lumps[LUMP_FACES]))
    Mod_LoadMarksurfaces(addr(header.lumps[LUMP_MARKSURFACES]))
    Mod_LoadVisibility(addr(header.lumps[LUMP_VISIBILITY]))
    Mod_LoadLeafs(addr(header.lumps[LUMP_LEAFS]))
    Mod_LoadNodes(addr(header.lumps[LUMP_NODES]))
    Mod_LoadClipnodes(addr(header.lumps[LUMP_CLIPNODES]))
    Mod_LoadEntities(addr(header.lumps[LUMP_ENTITIES]))
    Mod_LoadSubmodels(addr(header.lumps[LUMP_MODELS]))
    Mod_MakeHull0()
    // regular and alternate animation
    mod.numframes = 2
    mod.flags = 0
    // set up the submodels (FIXME: this is confusing)
    i = 0
    while (i < mod.numsubmodels) {
        bm = addr(mod.submodels[i])
        mod.hulls[0].firstclipnode = bm.headnode[0]
        for (j in range(1, MAX_MAP_HULLS)) {
            mod.hulls[j].firstclipnode = bm.headnode[j]
            mod.hulls[j].lastclipnode = mod.numclipnodes - 1
        }
        mod.firstmodelsurface = bm.firstface
        mod.nummodelsurfaces = bm.numfaces
        mod.maxs[0] = bm.maxs[0]
        mod.maxs[1] = bm.maxs[1]
        mod.maxs[2] = bm.maxs[2]
        mod.mins[0] = bm.mins[0]
        mod.mins[1] = bm.mins[1]
        mod.mins[2] = bm.mins[2]
        mod.radius = RadiusFromBounds(addr(mod.mins[0]), addr(mod.maxs[0]))
        mod.numleafs = bm.visleafs
        if (i < mod.numsubmodels - 1) {
            // duplicate the basic information
            var name : uint8[10]
            sprintf(addr(name[0]), cstr("*%i"), i + 1)
            loadmodel = Mod_FindName(addr(name[0]))
            *loadmodel = *mod
            crt::strcpy(addr(loadmodel.name[0]), addr(name[0]))
            mod = loadmodel
        }
        i++
    }
}

// =================
// Mod_LoadAliasFrame
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadAliasFrame(var pin : void?; var pframeindex : int?; numv : int; var pbboxmin : trivertx_t?; var pbboxmax : trivertx_t?; var pheader : aliashdr_t?;
                       var name : uint8?) : void? {
    var pframe : trivertx_t?
    var pinframe : trivertx_t?
    var pdaliasframe : daliasframe_t?
    pdaliasframe = reinterpret<daliasframe_t?>(pin)
    crt::strcpy(name, addr(pdaliasframe.name[0]))
    for (i in range(3)) {
        // these are byte values, so we don't have to worry about
        // endianness
        pbboxmin.v[i] = pdaliasframe.bboxmin.v[i]
        pbboxmax.v[i] = pdaliasframe.bboxmax.v[i]
    }
    pinframe = reinterpret<trivertx_t?>(pdaliasframe + 1)
    pframe = reinterpret<trivertx_t?>(Hunk_AllocName(int(uint64(numv) * uint64(typeinfo sizeof(type<trivertx_t>))), addr(loadname[0])))
    *pframeindex = int(int64(reinterpret<uint8?>(pframe) - reinterpret<uint8?>(pheader)))
    for (j in range(numv)) {
        // these are all byte values, so no need to deal with endianness
        pframe[j].lightnormalindex = pinframe[j].lightnormalindex
        for (k in range(3)) {
            pframe[j].v[k] = pinframe[j].v[k]
        }
    }
    pinframe += numv
    return reinterpret<void?>(pinframe)
}

// =================
// Mod_LoadAliasGroup
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Mod_LoadAliasGroup(var pin : void?; var pframeindex : int?; numv : int; var pbboxmin : trivertx_t?; var pbboxmax : trivertx_t?; var pheader : aliashdr_t?;
                       var name : uint8?) : void? {
    var pingroup : daliasgroup_t?
    var paliasgroup : maliasgroup_t?
    var numframes : int
    var pin_intervals : daliasinterval_t?
    var poutintervals : float?
    var ptemp : void?
    pingroup = reinterpret<daliasgroup_t?>(pin)
    numframes = invoke(LittleLong, pingroup.numframes)
    paliasgroup = reinterpret<maliasgroup_t?>(Hunk_AllocName(int(uint64(typeinfo sizeof(type<maliasgroup_t>)) + uint64(numframes - 1) *
                uint64(typeinfo sizeof(type<maliasgroupframedesc_t>))),
            addr(loadname[0])))
    paliasgroup.numframes = numframes
    for (i in range(3)) {
        // these are byte values, so we don't have to worry about endianness
        pbboxmin.v[i] = pingroup.bboxmin.v[i]
        pbboxmax.v[i] = pingroup.bboxmax.v[i]
    }
    *pframeindex = int(int64(reinterpret<uint8?>(paliasgroup) - reinterpret<uint8?>(pheader)))
    pin_intervals = reinterpret<daliasinterval_t?>(pingroup + 1)
    poutintervals = reinterpret<float?>(Hunk_AllocName(int(uint64(numframes) * uint64(typeinfo sizeof(type<float>))), addr(loadname[0])))
    paliasgroup.intervals = int(int64(reinterpret<uint8?>(poutintervals) - reinterpret<uint8?>(pheader)))
    for (i in range(numframes)) {
        *poutintervals = invoke(LittleFloat, pin_intervals.interval)
        if (double(*poutintervals) <= 0.0lf) {
            Sys_Error`va(cstr("Mod_LoadAliasGroup: interval<=0"), VaNone())
        }
        poutintervals++
        pin_intervals++
    }
    ptemp = reinterpret<void?>(pin_intervals)
    for (i in range(numframes)) {
        ptemp = Mod_LoadAliasFrame(ptemp, addr(addr(paliasgroup.frames[0])[i].frame), numv, addr(addr(paliasgroup.frames[0])[i].bboxmin),
                addr(addr(paliasgroup.frames[0])[i].bboxmax), pheader, name)
    }
    return ptemp
}

