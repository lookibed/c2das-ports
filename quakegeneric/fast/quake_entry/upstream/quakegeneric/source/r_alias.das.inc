// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasCheckBBox : qboolean {
    var flags : int
    var frame : int
    var numv : int
    var pahdr : aliashdr_t?
    var zi : float
    var basepts : float[8][3]
    var v0 : float
    var v1 : float
    var frac : float
    var pv0 : finalvert_s?
    var pv1 : finalvert_s?
    var viewpts : finalvert_s[16]
    var pa0 : auxvert_t?
    var pa1 : auxvert_t?
    var viewaux : auxvert_t[16]
    var pframedesc : maliasframedesc_t?
    var zclipped : qboolean
    var zfullyclipped : qboolean
    var anyclip : uint
    var allclip : uint
    var minz : int
    // expand, rotate, and translate points into worldspace
    currententity.trivial_accept = 0
    pmodel = currententity.model
    pahdr = reinterpret<aliashdr_t?>(Mod_Extradata(pmodel))
    pmdl = reinterpret<mdl_t?>(reinterpret<uint8?>(pahdr) + pahdr.model)
    R_AliasSetUpTransform(0)
    // construct the base bounding box for this frame
    frame = currententity.frame
    // TODO: don't repeat this check when drawing?
    if ((frame >= pmdl.numframes) || (frame < 0)) {
        Con_DPrintf`va(cstr("No such frame %d %s\n"), (frame, addr(pmodel.name[0])))
        frame = 0
    }
    pframedesc = addr(addr(pahdr.frames[0])[frame])
    // x worldspace coordinates
    basepts[3][0] = float(pframedesc.bboxmin.v[0])
    basepts[2][0] = basepts[3][0]
    basepts[1][0] = basepts[2][0]
    basepts[0][0] = basepts[1][0]
    basepts[7][0] = float(pframedesc.bboxmax.v[0])
    basepts[6][0] = basepts[7][0]
    basepts[5][0] = basepts[6][0]
    basepts[4][0] = basepts[5][0]
    // y worldspace coordinates
    basepts[6][1] = float(pframedesc.bboxmin.v[1])
    basepts[5][1] = basepts[6][1]
    basepts[3][1] = basepts[5][1]
    basepts[0][1] = basepts[3][1]
    basepts[7][1] = float(pframedesc.bboxmax.v[1])
    basepts[4][1] = basepts[7][1]
    basepts[2][1] = basepts[4][1]
    basepts[1][1] = basepts[2][1]
    // z worldspace coordinates
    basepts[5][2] = float(pframedesc.bboxmin.v[2])
    basepts[4][2] = basepts[5][2]
    basepts[1][2] = basepts[4][2]
    basepts[0][2] = basepts[1][2]
    basepts[7][2] = float(pframedesc.bboxmax.v[2])
    basepts[6][2] = basepts[7][2]
    basepts[3][2] = basepts[6][2]
    basepts[2][2] = basepts[3][2]
    zclipped = qboolean._c_false
    zfullyclipped = qboolean._c_true
    minz = 9999
    for (i in range(8)) {
        R_AliasTransformVector(addr(basepts[i][0]), addr(viewaux[i].fv[0]))
        if (viewaux[i].fv[2] < float(ALIAS_Z_CLIP_PLANE)) {
            // we must clip points that are closer than the near clip plane
            viewpts[i].flags = ALIAS_Z_CLIP
            zclipped = qboolean._c_true
        } else {
            if (viewaux[i].fv[2] < float(minz)) {
                minz = int(viewaux[i].fv[2])
            }
            viewpts[i].flags = 0
            zfullyclipped = qboolean._c_false
        }
    }
    if (int(zfullyclipped) != 0) {
        // everything was near-z-clipped
        return qboolean._c_false
    }
    numv = 8
    if (int(zclipped) != 0) {
        // organize points by edges, use edges to get new points (possible trivial
        // reject)
        for (i in range(12)) {
            // edge endpoints
            pv0 = addr(viewpts[0]) + end_index(aedges[i].index0, 16)
            pv1 = addr(viewpts[0]) + end_index(aedges[i].index1, 16)
            pa0 = addr(viewaux[0]) + end_index(aedges[i].index0, 16)
            pa1 = addr(viewaux[0]) + end_index(aedges[i].index1, 16)
            // if one end is clipped and the other isn't, make a new point
            if ((pv0.flags ^ pv1.flags) != 0) {
                frac = (float(ALIAS_Z_CLIP_PLANE) - pa0.fv[2]) / (pa1.fv[2] - pa0.fv[2])
                viewaux[numv].fv[0] = pa0.fv[0] + (pa1.fv[0] - pa0.fv[0]) * frac
                viewaux[numv].fv[1] = pa0.fv[1] + (pa1.fv[1] - pa0.fv[1]) * frac
                viewaux[numv].fv[2] = float(ALIAS_Z_CLIP_PLANE)
                viewpts[numv].flags = 0
                numv++
            }
        }
    }
    // project the vertices that remain after clipping
    anyclip = 0u
    allclip = uint(ALIAS_XY_CLIP_MASK)
    // TODO: probably should do this loop in ASM, especially if we use floats
    for (i in range(numv)) {
        // we don't need to bother with vertices that were z-clipped
        if ((viewpts[i].flags & ALIAS_Z_CLIP) != 0) {
            continue
        }
        zi = float(1.0lf / double(viewaux[i].fv[2]))
        // FIXME: do with chop mode in ASM, or convert to float
        v0 = (viewaux[i].fv[0] * xscale * zi) + xcenter
        v1 = (viewaux[i].fv[1] * yscale * zi) + ycenter
        flags = 0
        if (v0 < r_refdef.fvrectx) {
            flags |= ALIAS_LEFT_CLIP
        }
        if (v1 < r_refdef.fvrecty) {
            flags |= ALIAS_TOP_CLIP
        }
        if (v0 > r_refdef.fvrectright) {
            flags |= ALIAS_RIGHT_CLIP
        }
        if (v1 > r_refdef.fvrectbottom) {
            flags |= ALIAS_BOTTOM_CLIP
        }
        anyclip |= uint(flags)
        allclip &= uint(flags)
    }
    if (allclip != 0) {
        // trivial reject off one side
        return qboolean._c_false
    }
    currententity.trivial_accept = int_of(anyclip == 0) & int_of(int(zclipped) == 0)
    if (currententity.trivial_accept != 0) {
        if (float(minz) > (r_aliastransition + (pmdl.size * r_resfudge))) {
            currententity.trivial_accept |= 2
        }
    }
    return qboolean._c_true
}

// ================
// R_AliasTransformVector
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasTransformVector(var _c_in : float?; var out : float?) {
    out[0] = _c_in[0] * aliastransform[0][0] + _c_in[1] * aliastransform[0][1] + _c_in[2] * aliastransform[0][2] + aliastransform[0][3]
    out[1] = _c_in[0] * aliastransform[1][0] + _c_in[1] * aliastransform[1][1] + _c_in[2] * aliastransform[1][2] + aliastransform[1][3]
    out[2] = _c_in[0] * aliastransform[2][0] + _c_in[1] * aliastransform[2][1] + _c_in[2] * aliastransform[2][2] + aliastransform[2][3]
}

