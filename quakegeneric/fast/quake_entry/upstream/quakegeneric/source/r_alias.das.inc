    pstverts = reinterpret<stvert_t?>(reinterpret<uint8?>(paliashdr) + paliashdr.stverts)
    r_anumverts = pmdl.numverts
    fv = pfinalverts
    av = pauxverts
    i = 0
    while (i < r_anumverts) {
        R_AliasTransformFinalVert(fv, av, r_apverts, pstverts)
        if (av.fv[2] < float(ALIAS_Z_CLIP_PLANE)) {
            fv.flags |= ALIAS_Z_CLIP
        } else {
            R_AliasProjectFinalVert(fv, av)
            if (fv.v[0] < r_refdef.aliasvrect.x) {
                fv.flags |= ALIAS_LEFT_CLIP
            }
            if (fv.v[1] < r_refdef.aliasvrect.y) {
                fv.flags |= ALIAS_TOP_CLIP
            }
            if (fv.v[0] > r_refdef.aliasvrectright) {
                fv.flags |= ALIAS_RIGHT_CLIP
            }
            if (fv.v[1] > r_refdef.aliasvrectbottom) {
                fv.flags |= ALIAS_BOTTOM_CLIP
            }
        }
        i++
        fv++
        av++
        r_apverts++
        pstverts++
    }
    // clip and draw all triangles
    r_affinetridesc.numtriangles = 1
    ptri = reinterpret<mtriangle_s?>(reinterpret<uint8?>(paliashdr) + paliashdr.triangles)
    i = 0
    while (i < pmdl.numtris) {
        {
            pfv[0] = addr(pfinalverts[ptri.vertindex[0]])
            pfv[1] = addr(pfinalverts[ptri.vertindex[1]])
            pfv[2] = addr(pfinalverts[ptri.vertindex[2]])
            if ((pfv[0].flags & pfv[1].flags & pfv[2].flags & (ALIAS_XY_CLIP_MASK | ALIAS_Z_CLIP)) != 0) {
                // completely clipped
                continue
            }
            if (((pfv[0].flags | pfv[1].flags | pfv[2].flags) & (ALIAS_XY_CLIP_MASK | ALIAS_Z_CLIP)) == 0) {
                // totally unclipped
                r_affinetridesc.pfinalverts = pfinalverts
                r_affinetridesc.ptriangles = ptri
                D_PolysetDraw()
            } else {
                // partially clipped
                R_AliasClipTriangle(ptri)
            }
        } finally {
            i++
            ptri++
        }
    }
}

// ================
// R_AliasSetUpTransform
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasSetUpTransform(trivial_accept : int) {
    var rotationmatrix : float[3][4]
    var t2matrix : float[3][4]
    var angles : float[3]
    // TODO: should really be stored with the entity instead of being reconstructed
    // TODO: should use a look-up table
    // TODO: could cache lazily, stored in the entity
    angles[ROLL] = currententity.angles[ROLL]
    angles[PITCH] = -currententity.angles[PITCH]
    angles[YAW] = currententity.angles[YAW]
    AngleVectors(addr(angles[0]), addr(alias_forward[0]), addr(alias_right[0]), addr(alias_up[0]))
    R_AliasSetUpTransform_tmatrix[0][0] = pmdl.scale[0]
    R_AliasSetUpTransform_tmatrix[1][1] = pmdl.scale[1]
    R_AliasSetUpTransform_tmatrix[2][2] = pmdl.scale[2]
    R_AliasSetUpTransform_tmatrix[0][3] = pmdl.scale_origin[0]
    R_AliasSetUpTransform_tmatrix[1][3] = pmdl.scale_origin[1]
    R_AliasSetUpTransform_tmatrix[2][3] = pmdl.scale_origin[2]
    // TODO: can do this with simple matrix rearrangement
    for (i in range(3)) {
        t2matrix[i][0] = alias_forward[i]
        t2matrix[i][1] = -alias_right[i]
        t2matrix[i][2] = alias_up[i]
    }
    t2matrix[0][3] = -modelorg[0]
    t2matrix[1][3] = -modelorg[1]
    t2matrix[2][3] = -modelorg[2]
    // FIXME: can do more efficiently than full concatenation
    R_ConcatTransforms(addr(t2matrix[0]), addr(R_AliasSetUpTransform_tmatrix[0]), addr(rotationmatrix[0]))
    // TODO: should be global, set when vright, etc., set
    R_AliasSetUpTransform_viewmatrix[0][0] = vright[0]
    R_AliasSetUpTransform_viewmatrix[0][1] = vright[1]
    R_AliasSetUpTransform_viewmatrix[0][2] = vright[2]
    R_AliasSetUpTransform_viewmatrix[1][0] = vup[0]
    R_AliasSetUpTransform_viewmatrix[1][1] = vup[1]
    R_AliasSetUpTransform_viewmatrix[1][2] = vup[2]
    VectorInverse(addr(R_AliasSetUpTransform_viewmatrix[1][0]))
    R_AliasSetUpTransform_viewmatrix[2][0] = vpn[0]
    R_AliasSetUpTransform_viewmatrix[2][1] = vpn[1]
    R_AliasSetUpTransform_viewmatrix[2][2] = vpn[2]
    // viewmatrix[0][3] = 0;
    // viewmatrix[1][3] = 0;
    // viewmatrix[2][3] = 0;
    R_ConcatTransforms(addr(R_AliasSetUpTransform_viewmatrix[0]), addr(rotationmatrix[0]), addr(aliastransform[0]))
    // do the scaling up of x and y to screen coordinates as part of the transform
    // for the unclipped case (it would mess up clipping in the clipped case).
    // Also scale down z, so 1/z is scaled 31 bits for free, and scale down x and y
    // correspondingly so the projected x and y come out right
    // FIXME: make this work for clipped case too?
    if (trivial_accept != 0) {
        for (i in range(4)) {
            aliastransform[0][i] = float(double(aliastransform[0][i]) * (double(aliasxscale) * (1.0lf / double(32768.0f * 65536.0f))))
            aliastransform[1][i] = float(double(aliastransform[1][i]) * (double(aliasyscale) * (1.0lf / double(32768.0f * 65536.0f))))
            aliastransform[2][i] = float(double(aliastransform[2][i]) * (1.0lf / double(32768.0f * 65536.0f)))
        }
    }
}

// ================
// R_AliasTransformFinalVert
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasTransformFinalVert(var fv : finalvert_s?; var av : auxvert_t?; var pverts : trivertx_t?; var pstverts : stvert_t?) {
    var temp : int
    var lightcos : float
    var plightnormal : float?
    av.fv[0] = float(int(pverts.v[0])) * aliastransform[0][0] + float(int(pverts.v[1])) * aliastransform[0][1] + float(int(pverts.v[2])) * aliastransform[0][2] + aliastransform[0][3]
    av.fv[1] = float(int(pverts.v[0])) * aliastransform[1][0] + float(int(pverts.v[1])) * aliastransform[1][1] + float(int(pverts.v[2])) * aliastransform[1][2] + aliastransform[1][3]
    av.fv[2] = float(int(pverts.v[0])) * aliastransform[2][0] + float(int(pverts.v[1])) * aliastransform[2][1] + float(int(pverts.v[2])) * aliastransform[2][2] + aliastransform[2][3]
    fv.v[2] = pstverts.s
    fv.v[3] = pstverts.t
    fv.flags = pstverts.onseam
    // lighting
    plightnormal = addr(r_avertexnormals[int(pverts.lightnormalindex)][0])
    lightcos = plightnormal[0] * r_plightvec[0] + plightnormal[1] * r_plightvec[1] + plightnormal[2] * r_plightvec[2]
    temp = r_ambientlight
    if (lightcos < 0.0f) {
        temp += int(r_shadelight * lightcos)
        // clamp; because we limited the minimum ambient and shading light, we
        // don't have to clamp low light, just bright
        if (temp < 0) {
            temp = 0
        }
    }
    fv.v[4] = temp
}

// ================
// R_AliasTransformAndProjectFinalVerts
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasTransformAndProjectFinalVerts(var fv : finalvert_s?; var pstverts : stvert_t?) {
    var i : int
    var temp : int
    var lightcos : float
    var plightnormal : float?
    var zi : float
    var pverts : trivertx_t?
    pverts = r_apverts
    i = 0
    while (i < r_anumverts) {
        // transform and project
        zi = float(1.0lf /
                double(float(int(pverts.v[0])) * aliastransform[2][0] + float(int(pverts.v[1])) * aliastransform[2][1] + float(int(pverts.v[2])) *
                    aliastransform[2][2] + aliastransform[2][3]))
        // x, y, and z are scaled down by 1/2**31 in the transform, so 1/z is
        // scaled up by 1/2**31, and the scaling cancels out for x and y in the
        // projection
        fv.v[5] = int(zi)
        fv.v[0] = int(((float(int(pverts.v[0])) * aliastransform[0][0] + float(int(pverts.v[1])) * aliastransform[0][1] + float(int(pverts.v[2])) *
                        aliastransform[0][2] + aliastransform[0][3]) *
                    zi) +
                aliasxcenter)
        fv.v[1] = int(((float(int(pverts.v[0])) * aliastransform[1][0] + float(int(pverts.v[1])) * aliastransform[1][1] + float(int(pverts.v[2])) *
                        aliastransform[1][2] + aliastransform[1][3]) *
                    zi) +
                aliasycenter)
        fv.v[2] = pstverts.s
        fv.v[3] = pstverts.t
        fv.flags = pstverts.onseam
        // lighting
        plightnormal = addr(r_avertexnormals[int(pverts.lightnormalindex)][0])
        lightcos = plightnormal[0] * r_plightvec[0] + plightnormal[1] * r_plightvec[1] + plightnormal[2] * r_plightvec[2]
        temp = r_ambientlight
        if (lightcos < 0.0f) {
            temp += int(r_shadelight * lightcos)
            // clamp; because we limited the minimum ambient and shading light, we
            // don't have to clamp low light, just bright
            if (temp < 0) {
                temp = 0
            }
        }
        fv.v[4] = temp
        i++
        fv++
        pverts++
        pstverts++
    }
}

// ================
// R_AliasProjectFinalVert
// ================
[unsafe_deref, hint(unsafe_range_check)]
def R_AliasProjectFinalVert(var fv : finalvert_s?; var av : auxvert_t?) {
    var zi : float
    // project points
    zi = float(1.0lf / double(av.fv[2]))
    fv.v[5] = int(zi * ziscale)
    fv.v[0] = int((av.fv[0] * aliasxscale * zi) + aliasxcenter)
    fv.v[1] = int((av.fv[1] * aliasyscale * zi) + aliasycenter)
}

// ================
// R_AliasPrepareUnclippedPoints
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasPrepareUnclippedPoints {
    var pstverts : stvert_t?
    var fv : finalvert_s?
    pstverts = reinterpret<stvert_t?>(reinterpret<uint8?>(paliashdr) + paliashdr.stverts)
    r_anumverts = pmdl.numverts
    // FIXME: just use pfinalverts directly?
    fv = pfinalverts
    R_AliasTransformAndProjectFinalVerts(fv, pstverts)
    if (r_affinetridesc.drawtype != 0) {
        D_PolysetDrawFinalVerts(fv, r_anumverts)
    }
    r_affinetridesc.pfinalverts = pfinalverts
    r_affinetridesc.ptriangles = reinterpret<mtriangle_s?>(reinterpret<uint8?>(paliashdr) + paliashdr.triangles)
    r_affinetridesc.numtriangles = pmdl.numtris
    D_PolysetDraw()
}

// ===============
// R_AliasSetupSkin
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasSetupSkin {
    var skinnum : int
    var i : int
    var numskins : int
    var paliasskingroup : maliasskingroup_t?
    var pskinintervals : float?
    var fullskininterval : float
    var skintargettime : float
    var skintime : float
    skinnum = currententity.skinnum
    if ((skinnum >= pmdl.numskins) || (skinnum < 0)) {
        Con_DPrintf`va(cstr("R_AliasSetupSkin: no such skin # %d\n"), (skinnum,))
        skinnum = 0
    }
    pskindesc = reinterpret<maliasskindesc_t?>(reinterpret<uint8?>(paliashdr) + paliashdr.skindesc) + skinnum
    a_skinwidth = pmdl.skinwidth
    if (pskindesc._c_type == aliasskintype_t.ALIAS_SKIN_GROUP) {
        paliasskingroup = reinterpret<maliasskingroup_t?>(reinterpret<uint8?>(paliashdr) + pskindesc.skin)
        pskinintervals = reinterpret<float?>(reinterpret<uint8?>(paliashdr) + paliasskingroup.intervals)
        numskins = paliasskingroup.numskins
        fullskininterval = pskinintervals[numskins - 1]
        skintime = float(cl.time + double(currententity.syncbase))
        // when loading in Mod_LoadAliasSkinGroup, we guaranteed all interval
        // values are positive, so we don't have to worry about division by 0
        skintargettime = skintime - float(int(skintime / fullskininterval)) * fullskininterval
        i = 0
        while (i < (numskins - 1)) {
            if (pskinintervals[i] > skintargettime) {
                break
            }
            i++
        }
        pskindesc = addr(addr(paliasskingroup.skindescs[0])[i])
    }
    r_affinetridesc.pskindesc = pskindesc
    r_affinetridesc.pskin = reinterpret<void?>(reinterpret<uint8?>(paliashdr) + pskindesc.skin)
    r_affinetridesc.skinwidth = a_skinwidth
    r_affinetridesc.seamfixupX16 = (a_skinwidth >> 1) << 16
    r_affinetridesc.skinheight = pmdl.skinheight
}

// ================
// R_AliasSetupLighting
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasSetupLighting(var plighting : alight_t?) {
    // guarantee that no vertex will ever be lit below LIGHT_MIN, so we don't have
    // to clamp off the bottom
    r_ambientlight = plighting.ambientlight
    if (r_ambientlight < LIGHT_MIN) {
        r_ambientlight = LIGHT_MIN
    }
    r_ambientlight = (255 - r_ambientlight) << VID_CBITS
    if (r_ambientlight < LIGHT_MIN) {
        r_ambientlight = LIGHT_MIN
    }
    r_shadelight = float(plighting.shadelight)
    if (r_shadelight < 0.0f) {
        r_shadelight = 0.0f
    }
    r_shadelight *= float(VID_GRADES)
    // rotate the lighting vector into the model's frame of reference
    r_plightvec[0] = plighting.plightvec[0] * alias_forward[0] + plighting.plightvec[1] * alias_forward[1] + plighting.plightvec[2] * alias_forward[2]
    r_plightvec[1] = -(plighting.plightvec[0] * alias_right[0] + plighting.plightvec[1] * alias_right[1] + plighting.plightvec[2] * alias_right[2])
    r_plightvec[2] = plighting.plightvec[0] * alias_up[0] + plighting.plightvec[1] * alias_up[1] + plighting.plightvec[2] * alias_up[2]
}

// =================
// R_AliasSetupFrame
// set r_apverts
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasSetupFrame {
    var frame : int
    var i : int
    var numframes : int
    var paliasgroup : maliasgroup_t?
    var pintervals : float?
    var fullinterval : float
    var targettime : float
    var time : float
    frame = currententity.frame
    if ((frame >= pmdl.numframes) || (frame < 0)) {
        Con_DPrintf`va(cstr("R_AliasSetupFrame: no such frame %d\n"), (frame,))
        frame = 0
    }
    if (addr(paliashdr.frames[0])[frame]._c_type == aliasframetype_t.ALIAS_SINGLE) {
        r_apverts = reinterpret<trivertx_t?>(reinterpret<uint8?>(paliashdr) + addr(paliashdr.frames[0])[frame].frame)
        return
    }
    paliasgroup = reinterpret<maliasgroup_t?>(reinterpret<uint8?>(paliashdr) + addr(paliashdr.frames[0])[frame].frame)
    pintervals = reinterpret<float?>(reinterpret<uint8?>(paliashdr) + paliasgroup.intervals)
    numframes = paliasgroup.numframes
    fullinterval = pintervals[numframes - 1]
    time = float(cl.time + double(currententity.syncbase))
    // when loading in Mod_LoadAliasGroup, we guaranteed all interval values
    // are positive, so we don't have to worry about division by 0
    targettime = time - float(int(time / fullinterval)) * fullinterval
    i = 0
    while (i < (numframes - 1)) {
        if (pintervals[i] > targettime) {
            break
        }
        i++
    }
    r_apverts = reinterpret<trivertx_t?>(reinterpret<uint8?>(paliashdr) + addr(paliasgroup.frames[0])[i].frame)
}

// ================
// R_AliasDrawModel
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AliasDrawModel(var plighting : alight_t?) {
    var finalverts : finalvert_s[2001]
    var auxverts : auxvert_t[2000]
    r_amodels_drawn++
    // cache align
    pfinalverts = reinterpret<finalvert_s?>(uint64((int64(intptr(addr(finalverts[0]))) + int64(CACHE_SIZE) - 1l) & int64(~(CACHE_SIZE - 1))))
    pauxverts = addr(auxverts[0])
    paliashdr = reinterpret<aliashdr_t?>(Mod_Extradata(currententity.model))
    pmdl = reinterpret<mdl_t?>(reinterpret<uint8?>(paliashdr) + paliashdr.model)
    R_AliasSetupSkin()
    R_AliasSetUpTransform(currententity.trivial_accept)
    R_AliasSetupLighting(plighting)
    R_AliasSetupFrame()
    if (currententity.colormap == null) {
        Sys_Error`va(cstr("R_AliasDrawModel: !currententity->colormap"), VaNone())
    }
    r_affinetridesc.drawtype = int_of((currententity.trivial_accept == 3) && uint(r_recursiveaffinetriangles) != 0)
    if (r_affinetridesc.drawtype != 0) {
        // FIXME: precalc...
        D_PolysetUpdateTables()
    }
    acolormap = reinterpret<void?>(currententity.colormap)
    if (currententity != addr(cl.viewent)) {
        ziscale = 32768.0f * 65536.0f
    } else {
        ziscale = float(double(32768.0f * 65536.0f) * 3.0lf)
    }
    if (currententity.trivial_accept != 0) {
        R_AliasPrepareUnclippedPoints()
    } else {
        R_AliasPreparePoints()
    }
}

