// generated by c2das - regenerate, never edit
var private R_CheckVariables_oldbright : float
var private R_TimeGraph_timex : int
var private R_TimeGraph_r_timings : uint8[100]

// ===============
// R_CheckVariables
// ===============
[unsafe_deref, hint(unsafe_range_check)]
def R_CheckVariables {
    if (r_fullbright.value != R_CheckVariables_oldbright) {
        R_CheckVariables_oldbright = r_fullbright.value
        // so all lighting changes
        D_FlushCaches()
    }
}

