[c_function, unsafe_deref, hint(unsafe_range_check)]
def WarpPalette {
    var newpalette : uint8[768]
    var basecolor : int[3]
    basecolor[0] = 130
    basecolor[1] = 80
    basecolor[2] = 50
    // pull the colors halfway to bright brown
    for (i in range(256)) {
        for (j in range(3)) {
            newpalette[i * 3 + j] = uint8((int(host_basepal[i * 3 + j]) + basecolor[j]) / 2)
        }
    }
    VID_ShiftPalette(addr(newpalette[0]))
}

// ===================
// R_TransformFrustum
// ===================
[unsafe_deref, hint(unsafe_range_check)]
def R_TransformFrustum {
    var v : float[3]
    var v2 : float[3]
    for (i in range(4)) {
        v[0] = screenedge[i].normal[2]
        v[1] = -screenedge[i].normal[0]
        v[2] = screenedge[i].normal[1]
        v2[0] = v[1] * vright[0] + v[2] * vup[0] + v[0] * vpn[0]
        v2[1] = v[1] * vright[1] + v[2] * vup[1] + v[0] * vpn[1]
        v2[2] = v[1] * vright[2] + v[2] * vup[2] + v[0] * vpn[2]
        view_clipplanes[i].normal[0] = v2[0]
        view_clipplanes[i].normal[1] = v2[1]
        view_clipplanes[i].normal[2] = v2[2]
        view_clipplanes[i].dist = modelorg[0] * v2[0] + modelorg[1] * v2[1] + modelorg[2] * v2[2]
    }
}

// ================
// TransformVector
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def TransformVector(var _c_in : float?; var out : float?) {
    out[0] = _c_in[0] * vright[0] + _c_in[1] * vright[1] + _c_in[2] * vright[2]
    out[1] = _c_in[0] * vup[0] + _c_in[1] * vup[1] + _c_in[2] * vup[2]
    out[2] = _c_in[0] * vpn[0] + _c_in[1] * vpn[1] + _c_in[2] * vpn[2]
}

// ================
// R_TransformPlane
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_TransformPlane(var p : mplane_s?; var normal : float?; var dist : float?) {
    var d : float
    d = r_origin[0] * p.normal[0] + r_origin[1] * p.normal[1] + r_origin[2] * p.normal[2]
    *dist = p.dist - d
    // TODO: when we have rotating entities, this will need to use the view matrix
    TransformVector(addr(p.normal[0]), normal)
}

// ===============
// R_SetUpFrustumIndexes
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_SetUpFrustumIndexes {
    var pindex : int?
    pindex = addr(r_frustum_indexes[0])
    for (i in range(4)) {
        for (j in range(3)) {
            if (view_clipplanes[i].normal[j] < 0.0f) {
                pindex[j] = j
                pindex[j + 3] = j + 3
            } else {
                pindex[j] = j + 3
                pindex[j + 3] = j
            }
        }
        // FIXME: do just once at start
        pfrustum_indexes[i] = pindex
        pindex += 6
    }
}

// ===============
// R_SetupFrame
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_SetupFrame {
    var edgecount : int
    var vrect : vrect_s
    var w : float
    var h : float
    // don't allow cheats in multiplayer
    if (cl.maxclients > 1) {
        Cvar_Set(cstr("r_draworder"), cstr("0"))
        Cvar_Set(cstr("r_fullbright"), cstr("0"))
        Cvar_Set(cstr("r_ambient"), cstr("0"))
        Cvar_Set(cstr("r_drawflat"), cstr("0"))
    }
    if (r_numsurfs.value != 0.0f) {
        if (int64(surface_p - surfaces) > int64(r_maxsurfsseen)) {
            r_maxsurfsseen = int(int64(surface_p - surfaces))
        }
        Con_Printf`va(cstr("Used %d of %d surfs; %d max\n"), (int64(surface_p - surfaces), int64(surf_max - surfaces), r_maxsurfsseen))
    }
    if (r_numedges.value != 0.0f) {
        edgecount = int(int64(edge_p - r_edges))
        if (edgecount > r_maxedgesseen) {
            r_maxedgesseen = edgecount
        }
        Con_Printf`va(cstr("Used %d of %d edges; %d max\n"), (edgecount, r_numallocatededges, r_maxedgesseen))
    }
    r_refdef.ambientlight = int(r_ambient.value)
    if (r_refdef.ambientlight < 0) {
        r_refdef.ambientlight = 0
    }
    if (int(sv.active) == 0) {
        // don't let cheaters look behind walls
        r_draworder.value = 0.0f
    }
    R_CheckVariables()
    R_AnimateLight()
    r_framecount++
    numbtofpolys = 0
    // debugging
    // build the transformation matrix for the given view angles
    modelorg[0] = r_refdef.vieworg[0]
    modelorg[1] = r_refdef.vieworg[1]
    modelorg[2] = r_refdef.vieworg[2]
    r_origin[0] = r_refdef.vieworg[0]
    r_origin[1] = r_refdef.vieworg[1]
    r_origin[2] = r_refdef.vieworg[2]
    AngleVectors(addr(r_refdef.viewangles[0]), addr(vpn[0]), addr(vright[0]), addr(vup[0]))
    // current viewleaf
    r_oldviewleaf = r_viewleaf
    r_viewleaf = Mod_PointInLeaf(addr(r_origin[0]), cl.worldmodel)
    r_dowarpold = r_dowarp
    r_dowarp = enum_from_int(type<qboolean>, int_of(r_waterwarp.value != 0.0f && (r_viewleaf.contents <= CONTENTS_WATER)))
    if ((r_dowarp != r_dowarpold) || uint(r_viewchanged) != 0 || lcd_x.value != 0.0f) {
        if (int(r_dowarp) != 0) {
            if ((vid.width <= uint(vid.maxwarpwidth)) && (vid.height <= uint(vid.maxwarpheight))) {
                vrect.x = 0
                vrect.y = 0
                vrect.width = int(vid.width)
                vrect.height = int(vid.height)
                R_ViewChanged(addr(vrect), sb_lines, vid.aspect)
            } else {
                w = float(vid.width)
                h = float(vid.height)
                if (w > float(vid.maxwarpwidth)) {
                    h *= float(vid.maxwarpwidth) / w
                    w = float(vid.maxwarpwidth)
                }
                if (h > float(vid.maxwarpheight)) {
                    h = float(vid.maxwarpheight)
                    w *= float(vid.maxwarpheight) / h
                }
                vrect.x = 0
                vrect.y = 0
                vrect.width = int(w)
                vrect.height = int(h)
                R_ViewChanged(addr(vrect), int(float(sb_lines) * (h / float(vid.height))), vid.aspect * (h / w) * (float(vid.width) / float(vid.height)))
            }
        } else {
            vrect.x = 0
            vrect.y = 0
            vrect.width = int(vid.width)
            vrect.height = int(vid.height)
            R_ViewChanged(addr(vrect), sb_lines, vid.aspect)
        }
        r_viewchanged = qboolean._c_false
    }
    // start off with just the four screen edge clip planes
    R_TransformFrustum()
    // save base values
    base_vpn[0] = vpn[0]
    base_vpn[1] = vpn[1]
    base_vpn[2] = vpn[2]
    base_vright[0] = vright[0]
    base_vright[1] = vright[1]
    base_vright[2] = vright[2]
    base_vup[0] = vup[0]
    base_vup[1] = vup[1]
    base_vup[2] = vup[2]
    base_modelorg[0] = modelorg[0]
    base_modelorg[1] = modelorg[1]
    base_modelorg[2] = modelorg[2]
    R_SetSkyFrame()
    R_SetUpFrustumIndexes()
    r_cache_thrash = qboolean._c_false
    // clear frame counts
    c_faceclip = 0
    d_spanpixcount = 0
    r_polycount = 0
    r_drawnpolycount = 0
    r_wholepolycount = 0
    r_amodels_drawn = 0
    r_outofsurfaces = 0
    r_outofedges = 0
    D_SetupFrame()
}

