// ====================
// R_TimeRefresh_f
// For program optimization
// ====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_TimeRefresh_f {
    var start : float
    var stop : float
    var time : float
    var startangle : int
    var vr : vrect_s
    startangle = int(r_refdef.viewangles[1])
    start = float(Sys_FloatTime())
    for (i in range(128)) {
        r_refdef.viewangles[1] = float(double(i) / 128.0lf * 360.0lf)
        R_RenderView()
        vr.x = r_refdef.vrect.x
        vr.y = r_refdef.vrect.y
        vr.width = r_refdef.vrect.width
        vr.height = r_refdef.vrect.height
        vr.pnext = null
        VID_Update(addr(vr))
    }
    stop = float(Sys_FloatTime())
    time = stop - start
    Con_Printf`va(cstr("%f seconds (%f fps)\n"), (double(time), double(128.0f / time)))
    r_refdef.viewangles[1] = float(startangle)
}

// ================
// R_LineGraph
// Only called by R_DisplayTime
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_LineGraph(var x : int; var y : int; var h : int) {
    var i : int
    var dest : uint8?
    var s : int
    // FIXME: should be disabled on no-buffer adapters, or should be in the driver
    x += r_refdef.vrect.x
    y += r_refdef.vrect.y
    dest = vid.buffer + vid.rowbytes * uint(y) + x
    s = int(r_graphheight.value)
    if (h > s) {
        h = s
    }
    i = 0
    while (i < h) {
        dest[0] = 255u8
        *(dest - vid.rowbytes) = 48u8
        i++
        dest -= vid.rowbytes * 2u
    }
    while (i < s) {
        dest[0] = 48u8
        *(dest - vid.rowbytes) = 48u8
        i++
        dest -= vid.rowbytes * 2u
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def R_TimeGraph {
    var a : int
    var r_time2 : float
    var x : int
    r_time2 = float(Sys_FloatTime())
    a = int(double(r_time2 - r_time1) / 0.01lf)
    // a = fabs(mouse_y * 0.05);
    // a = (int)((r_refdef.vieworg[2] + 1024)/1)%(int)r_graphheight.value;
    // a = fabs(velocity[0])/20;
    // a = ((int)fabs(origin[0])/8)%20;
    // a = (cl.idealpitch + 30)/5;
    R_TimeGraph_r_timings[R_TimeGraph_timex] = uint8(a)
    a = R_TimeGraph_timex
    if (r_refdef.vrect.width <= MAX_TIMINGS) {
        x = r_refdef.vrect.width - 1
    } else {
        x = r_refdef.vrect.width - (r_refdef.vrect.width - MAX_TIMINGS) / 2
    }
    c_do_while(a != R_TimeGraph_timex) {
        R_LineGraph(x, r_refdef.vrect.height - 2, int(R_TimeGraph_r_timings[a]))
        if (x == 0) {
            // screen too small to hold entire thing
            break
        }
        x--
        a--
        if (a == -1) {
            a = MAX_TIMINGS - 1
        }
    }
    R_TimeGraph_timex = (R_TimeGraph_timex + 1) % MAX_TIMINGS
}

