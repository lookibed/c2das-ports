// ==============
// R_DrawCulledPolys
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawCulledPolys {
    var s : surf_s?
    var pface : msurface_s?
    currententity = addr(cl_entities[0])
    if (int(r_worldpolysbacktofront) != 0) {
        s = surface_p - 1
        while (intptr(s) > intptr(addr(surfaces[1]))) {
            {
                if (s.spans == null) {
                    continue
                }
                if ((s.flags & SURF_DRAWBACKGROUND) == 0) {
                    pface = reinterpret<msurface_s?>(s.data)
                    R_RenderPoly(pface, 15)
                }
            } finally {
                s--
            }
        }
    } else {
        s = addr(surfaces[1])
        while (intptr(s) < intptr(surface_p)) {
            {
                if (s.spans == null) {
                    continue
                }
                if ((s.flags & SURF_DRAWBACKGROUND) == 0) {
                    pface = reinterpret<msurface_s?>(s.data)
                    R_RenderPoly(pface, 15)
                }
            } finally {
                s++
            }
        }
    }
}

// ==============
// R_BeginEdgeFrame
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_BeginEdgeFrame {
    edge_p = r_edges
    edge_max = addr(r_edges[r_numallocatededges])
    // background is surface 1,
    surface_p = addr(surfaces[2])
    // surface 0 is a dummy
    // no background spans yet
    surfaces[1].spans = null
    surfaces[1].flags = SURF_DRAWBACKGROUND
    // put the background behind everything in the world
    if (r_draworder.value != 0.0f) {
        pdrawfunc = @@R_GenerateSpansBackward
        surfaces[1].key = 0
        r_currentkey = 1
    } else {
        pdrawfunc = @@R_GenerateSpans
        surfaces[1].key = 2147483647
        r_currentkey = 0
    }
    // FIXME: set with memset
    for (v in range(r_refdef.vrect.y, r_refdef.vrectbottom)) {
        removeedges[v] = null
        newedges[v] = removeedges[v]
    }
}

// ==============
// R_InsertNewEdges
// Adds the edges in the linked list edgestoadd, adding them to the edges in the
// linked list edgelist. edgestoadd is assumed to be sorted on u, and non-empty (this is actually newedges[v]). edgelist is assumed to be sorted on u, with a
// sentinel at the end (actually, this is the active edge table starting at
// edge_head.next).
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InsertNewEdges(var edgestoadd : edge_s?; var edgelist : edge_s?) {
    var next_edge : edge_s?
    while (true) {
        next_edge = edgestoadd.next
        label 1:  // edgesearch
        if (edgelist.u >= edgestoadd.u) {
            goto label 2
        }
        edgelist = edgelist.next
        if (edgelist.u >= edgestoadd.u) {
            goto label 2
        }
        edgelist = edgelist.next
        if (edgelist.u >= edgestoadd.u) {
            goto label 2
        }
        edgelist = edgelist.next
        if (edgelist.u >= edgestoadd.u) {
            goto label 2
        }
        edgelist = edgelist.next
        goto label 1
        label 2:  // addedge
        // insert edgestoadd before edgelist
        edgestoadd.next = edgelist
        edgestoadd.prev = edgelist.prev
        edgelist.prev.next = edgestoadd
        edgelist.prev = edgestoadd
        edgestoadd = next_edge
        if (!(edgestoadd != null)) {
            break
        }
    }
}

// ==============
// R_RemoveEdges
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_RemoveEdges(var pedge : edge_s?) {
    while (true) {
        pedge.next.prev = pedge.prev
        pedge.prev.next = pedge.next
        pedge = pedge.nextremove
        if (!(pedge != null)) {
            break
        }
    }
}

// ==============
// R_StepActiveU
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_StepActiveU(var pedge : edge_s?) {
    var pnext_edge : edge_s?
    var pwedge : edge_s?
    while (1 != 0) {
        label 1:  // nextedge
        pedge.u += pedge.u_step
        if (pedge.u < pedge.prev.u) {
            goto label 2
        }
        pedge = pedge.next
        pedge.u += pedge.u_step
        if (pedge.u < pedge.prev.u) {
            goto label 2
        }
        pedge = pedge.next
        pedge.u += pedge.u_step
        if (pedge.u < pedge.prev.u) {
            goto label 2
        }
        pedge = pedge.next
        pedge.u += pedge.u_step
        if (pedge.u < pedge.prev.u) {
            goto label 2
        }
        pedge = pedge.next
        goto label 1
        label 2:  // pushback
        if (intptr(pedge) == intptr(addr(edge_aftertail))) {
            return
        }
        // push it back to keep it sorted
        pnext_edge = pedge.next
        // pull the edge out of the edge list
        pedge.next.prev = pedge.prev
        pedge.prev.next = pedge.next
        // find out where the edge goes in the edge list
        pwedge = pedge.prev.prev
        while (pwedge.u > pedge.u) {
            pwedge = pwedge.prev
        }
        // put the edge back into the edge list
        pedge.next = pwedge.next
        pedge.prev = pwedge
        pedge.next.prev = pedge
        pwedge.next = pedge
        pedge = pnext_edge
        if (intptr(pedge) == intptr(addr(edge_tail))) {
            return
        }
    }
}

// ==============
// R_CleanupSpan
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_CleanupSpan {
    var surf : surf_s?
    var iu : int
    var span : espan_s?
    // now that we've reached the right edge of the screen, we're done with any
    // unfinished surfaces, so emit a span for whatever's on top
    surf = surfaces[1].next
    iu = edge_tail_u_shift20
    if (iu > surf.last_u) {
        var _t0 = span_p
        span_p++
        span = _t0
        span.u = surf.last_u
        span.count = iu - span.u
        span.v = current_iv
        span.pnext = surf.spans
        surf.spans = span
    }
    // reset spanstate for all surfaces in the surface stack
    c_do_while(intptr(surf) != intptr(addr(surfaces[1]))) {
        surf.spanstate = 0
        surf = surf.next
    }
}

// ==============
// R_LeadingEdgeBackwards
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_LeadingEdgeBackwards(var edge : edge_s?) {
    var span : espan_s?
    var surf : surf_s?
    var surf2 : surf_s?
    var iu : int
    // it's adding a new surface in, so find the correct place
    surf = addr(surfaces[int(edge.surfs[1])])
    // don't start a span if this is an inverted span, with the end
    // edge preceding the start edge (that is, we've already seen the
    // end edge)
    surf.spanstate++
    if (surf.spanstate == 1) {
        surf2 = surfaces[1].next
        if (surf.key > surf2.key) {
            goto label 2
        }
        // if it's two surfaces on the same plane, the one that's already
        // active is in front, so keep going unless it's a bmodel
        if (uint(surf.insubmodel) != 0 && (surf.key == surf2.key)) {
            // must be two bmodels in the same leaf; don't care, because they'll
            // never be farthest anyway
            goto label 2
        }
        label 1:  // continue_search
        c_do_while(surf.key < surf2.key) {
            surf2 = surf2.next
        }
        if (surf.key == surf2.key) {
            // if it's two surfaces on the same plane, the one that's already
            // active is in front, so keep going unless it's a bmodel
            if (int(surf.insubmodel) == 0) {
                goto label 1
            }
        }
        // must be two bmodels in the same leaf; don't care which is really
        // in front, because they'll never be farthest anyway
        goto label 3
        label 2:  // newtop
        // emit a span (obscures current top)
        iu = edge.u >> 20
        if (iu > surf2.last_u) {
            var _t0 = span_p
            span_p++
            span = _t0
            span.u = surf2.last_u
            span.count = iu - span.u
            span.v = current_iv
            span.pnext = surf2.spans
            surf2.spans = span
        }
        // set last_u on the new span
        surf.last_u = iu
        label 3:  // gotposition
        // insert before surf2
        surf.next = surf2
        surf.prev = surf2.prev
        surf2.prev.next = surf
        surf2.prev = surf
    }
}

// ==============
// R_TrailingEdge
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_TrailingEdge(var surf : surf_s?; var edge : edge_s?) {
    var span : espan_s?
    var iu : int
    // don't generate a span if this is an inverted span, with the end
    // edge preceding the start edge (that is, we haven't seen the
    // start edge yet)
    surf.spanstate--
    if (surf.spanstate == 0) {
        if (int(surf.insubmodel) != 0) {
            r_bmodelactive--
        }
        if (intptr(surf) == intptr(surfaces[1].next)) {
            // emit a span (current top going away)
            iu = edge.u >> 20
            if (iu > surf.last_u) {
                var _t0 = span_p
                span_p++
                span = _t0
                span.u = surf.last_u
                span.count = iu - span.u
                span.v = current_iv
                span.pnext = surf.spans
                surf.spans = span
            }
            // set last_u on the surface below
            surf.next.last_u = iu
        }
        surf.prev.next = surf.next
        surf.next.prev = surf.prev
    }
}

// ==============
// R_LeadingEdge
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_LeadingEdge(var edge : edge_s?) {
    var span : espan_s?
    var surf : surf_s?
    var surf2 : surf_s?
    var iu : int
    var fu : double
    var newzi : double
    var testzi : double
    var newzitop : double
    var newzibottom : double
    if (edge.surfs[1] != 0) {
        // it's adding a new surface in, so find the correct place
        surf = addr(surfaces[int(edge.surfs[1])])
        // don't start a span if this is an inverted span, with the end
        // edge preceding the start edge (that is, we've already seen the
        // end edge)
        surf.spanstate++
        if (surf.spanstate == 1) {
            if (int(surf.insubmodel) != 0) {
                r_bmodelactive++
            }
            surf2 = surfaces[1].next
            if (surf.key < surf2.key) {
                goto label 2
            }
            // if it's two surfaces on the same plane, the one that's already
            // active is in front, so keep going unless it's a bmodel
            if (uint(surf.insubmodel) != 0 && (surf.key == surf2.key)) {
                // must be two bmodels in the same leaf; sort on 1/z
                fu = double(float(edge.u - 1048575)) * (1.0lf / 1048576.0lf)
                newzi = double(surf.d_ziorigin + fv * surf.d_zistepv) + fu * double(surf.d_zistepu)
                newzibottom = newzi * 0.99lf
                testzi = double(surf2.d_ziorigin + fv * surf2.d_zistepv) + fu * double(surf2.d_zistepu)
                if (newzibottom >= testzi) {
                    goto label 2
                }
                newzitop = newzi * 1.01lf
                if (newzitop >= testzi) {
                    if (surf.d_zistepu >= surf2.d_zistepu) {
                        goto label 2
                    }
                }
            }
            label 1:  // continue_search
            c_do_while(surf.key > surf2.key) {
                surf2 = surf2.next
            }
            if (surf.key == surf2.key) {
                // if it's two surfaces on the same plane, the one that's already
                // active is in front, so keep going unless it's a bmodel
                if (int(surf.insubmodel) == 0) {
                    goto label 1
                }
                // must be two bmodels in the same leaf; sort on 1/z
                fu = double(float(edge.u - 1048575)) * (1.0lf / 1048576.0lf)
                newzi = double(surf.d_ziorigin + fv * surf.d_zistepv) + fu * double(surf.d_zistepu)
                newzibottom = newzi * 0.99lf
                testzi = double(surf2.d_ziorigin + fv * surf2.d_zistepv) + fu * double(surf2.d_zistepu)
                if (newzibottom >= testzi) {
                    goto label 3
                }
                newzitop = newzi * 1.01lf
                if (newzitop >= testzi) {
                    if (surf.d_zistepu >= surf2.d_zistepu) {
                        goto label 3
                    }
                }
                goto label 1
            }
            goto label 3
            label 2:  // newtop
            // emit a span (obscures current top)
            iu = edge.u >> 20
            if (iu > surf2.last_u) {
                var _t0 = span_p
                span_p++
                span = _t0
                span.u = surf2.last_u
                span.count = iu - span.u
                span.v = current_iv
                span.pnext = surf2.spans
                surf2.spans = span
            }
            // set last_u on the new span
            surf.last_u = iu
            label 3:  // gotposition
            // insert before surf2
            surf.next = surf2
            surf.prev = surf2.prev
            surf2.prev.next = surf
            surf2.prev = surf
        }
    }
}

// ==============
// R_GenerateSpans
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GenerateSpans {
    var edge : edge_s?
    var surf : surf_s?
    r_bmodelactive = 0
    // clear active surfaces to just the background surface
    surfaces[1].prev = addr(surfaces[1])
    surfaces[1].next = surfaces[1].prev
    surfaces[1].last_u = edge_head_u_shift20
    // generate spans
    edge = edge_head.next
    while (intptr(edge) != intptr(addr(edge_tail))) {
        {
            if (edge.surfs[0] != 0) {
                // it has a left surface, so a surface is going away for this span
                surf = addr(surfaces[int(edge.surfs[0])])
                R_TrailingEdge(surf, edge)
                if (edge.surfs[1] == 0) {
                    continue
                }
            }
            R_LeadingEdge(edge)
        } finally {
            edge = edge.next
        }
    }
    R_CleanupSpan()
}

// ==============
// R_GenerateSpansBackward
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GenerateSpansBackward {
    var edge : edge_s?
    r_bmodelactive = 0
    // clear active surfaces to just the background surface
    surfaces[1].prev = addr(surfaces[1])
    surfaces[1].next = surfaces[1].prev
    surfaces[1].last_u = edge_head_u_shift20
    // generate spans
    edge = edge_head.next
    while (intptr(edge) != intptr(addr(edge_tail))) {
        if (edge.surfs[0] != 0) {
            R_TrailingEdge(addr(surfaces[int(edge.surfs[0])]), edge)
        }
        if (edge.surfs[1] != 0) {
            R_LeadingEdgeBackwards(edge)
        }
        edge = edge.next
    }
    R_CleanupSpan()
}

// ==============
// R_ScanEdges
// Input:
// newedges[] array
// this has links to edges, which have links to surfaces
// Output:
// Each surface has a linked list of its visible spans
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ScanEdges {
    var iv : int
    var bottom : int
    var basespans : uint8[72032]
    var basespan_p : espan_s?
    var s : surf_s?
    basespan_p = reinterpret<espan_s?>(uint64(int64(intptr(addr(basespans[0]) + CACHE_SIZE + -(1))) & int64(~(CACHE_SIZE - 1))))
    max_span_p = addr(basespan_p[MAXSPANS - r_refdef.vrect.width])
    span_p = basespan_p
    // clear active edges to just the background edges around the whole screen
    // FIXME: most of this only needs to be set up once
    edge_head.u = r_refdef.vrect.x << 20
    edge_head_u_shift20 = edge_head.u >> 20
    edge_head.u_step = 0
    edge_head.prev = null
    edge_head.next = addr(edge_tail)
    edge_head.surfs[0] = uint16(0)
    edge_head.surfs[1] = uint16(1)
    edge_tail.u = (r_refdef.vrectright << 20) + 1048575
    edge_tail_u_shift20 = edge_tail.u >> 20
    edge_tail.u_step = 0
    edge_tail.prev = addr(edge_head)
    edge_tail.next = addr(edge_aftertail)
    edge_tail.surfs[0] = uint16(1)
    edge_tail.surfs[1] = uint16(0)
    // force a move
    edge_aftertail.u = -1
    edge_aftertail.u_step = 0
    edge_aftertail.next = addr(edge_sentinel)
    edge_aftertail.prev = addr(edge_tail)
    // FIXME: do we need this now that we clamp x in r_draw.c?
    // make sure nothing sorts past this
    edge_sentinel.u = 2000 << 24
    edge_sentinel.prev = addr(edge_aftertail)
    // process all scan lines
    bottom = r_refdef.vrectbottom - 1
    iv = r_refdef.vrect.y
    while (iv < bottom) {
        current_iv = iv
        fv = float(iv)
        // mark that the head (background start) span is pre-included
        surfaces[1].spanstate = 1
        if (newedges[iv] != null) {
            R_InsertNewEdges(newedges[iv], edge_head.next)
        }
        invoke(pdrawfunc)
        // flush the span list if we can't be sure we have enough spans left for
        // the next scan
        if (intptr(span_p) >= intptr(max_span_p)) {
            // don't let sound get messed up if going slow
            S_ExtraUpdate()
            if (int(r_drawculledpolys) != 0) {
                R_DrawCulledPolys()
            } else {
                D_DrawSurfaces()
            }
            // clear the surface span pointers
            s = addr(surfaces[1])
            while (intptr(s) < intptr(surface_p)) {
                s.spans = null
                s++
            }
            span_p = basespan_p
        }
        if (removeedges[iv] != null) {
            R_RemoveEdges(removeedges[iv])
        }
        if (intptr(edge_head.next) != intptr(addr(edge_tail))) {
            R_StepActiveU(edge_head.next)
        }
        iv++
    }
    // do the last scan (no need to step or sort or remove on the last scan)
    current_iv = iv
    fv = float(iv)
    // mark that the head (background start) span is pre-included
    surfaces[1].spanstate = 1
    if (newedges[iv] != null) {
        R_InsertNewEdges(newedges[iv], edge_head.next)
    }
    invoke(pdrawfunc)
    // draw whatever's left in the span list
    if (int(r_drawculledpolys) != 0) {
        R_DrawCulledPolys()
    } else {
        D_DrawSurfaces()
    }
}

