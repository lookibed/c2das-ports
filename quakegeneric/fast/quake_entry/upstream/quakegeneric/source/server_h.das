// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require client_h
require common_h
require d_local_h_cluster
require net_h
require progs_h

enum server_state_t {
    ss_loading
    ss_active
}

struct server_static_t {
    maxclients, maxclientslimit : int
    clients : client_s?
    serverflags : int
    changelevel_issued : qboolean
}

struct server_t {
    active, paused, loadgame : qboolean
    time : double
    lastcheck : int
    lastchecktime : double
    name, modelname : uint8[64]
    worldmodel : model_s?
    model_precache : uint8? [256]
    models : model_s? [256]
    sound_precache : uint8? [256]
    lightstyles : uint8? [64]
    num_edicts, max_edicts : int
    edicts : edict_s?
    state : server_state_t
    datagram : sizebuf_s
    datagram_buf : uint8[1024]
    reliable_datagram : sizebuf_s
    reliable_datagram_buf : uint8[1024]
    signon : sizebuf_s
    signon_buf : uint8[8192]
}

struct client_s {
    active, spawned, dropasap, privileged, sendsignon : qboolean
    last_message : double
    netconnection : qsocket_s?
    cmd : usercmd_t
    wishdir : float[3]
    message : sizebuf_s
    msgbuf : uint8[8000]
    edict : edict_s?
    name : uint8[32]
    colors : int
    ping_times : float[16]
    num_pings : int
    spawn_parms : float[16]
    old_frags : int
}

include server_h.layout.das.inc

