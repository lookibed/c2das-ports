// ==================
// Host_ServerFrame
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def Host_ServerFrame {
    // run the world state
    pr_global_struct.frametime = float(host_frametime)
    // set the time and clear the general datagram
    SV_ClearDatagram()
    // check for new clients
    SV_CheckForNewClients()
    // read client messages
    SV_RunClients()
    // move things around and think
    // always pause in single player if in console or menus
    if (int(sv.paused) == 0 && (svs.maxclients > 1 || key_dest == keydest_t.key_game)) {
        SV_Physics()
    }
    // send all messages to the clients
    SV_SendClientMessages()
}

// ==================
// Host_Frame
// Runs all active servers
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def _Host_Frame(time : float) {
    var pass1 : int
    var pass2 : int
    var pass3 : int
    var _sj_returned = false
    var _sj_run = true
    var _sj_val = 0
    while (_sj_run) {
        _sj_run = false
        try {
            _sj_returned = invoke($() : bool {
                if (_sj_val != 0) {
                    // something bad happened, or the server disconnected
                    return true
                }
                // keep the random time dependent
                crt::rand()
                // decide the simulation time
                if (int(Host_FilterTime(time)) == 0) {
                    // don't run too fast, or packets will flood out
                    return true
                }
                // get new key events
                Sys_SendKeyEvents()
                // allow mice or other external controllers to add commands
                IN_Commands()
                // process console commands
                Cbuf_Execute()
                NET_Poll()
                // if running the server locally, make intentions now
                if (int(sv.active) != 0) {
                    CL_SendCmd()
                }
                // -------------------
                // server operations
                // -------------------
                // check for commands typed to the host
                Host_GetConsoleCommands()
                if (int(sv.active) != 0) {
                    Host_ServerFrame()
                }
                // -------------------
                // client operations
                // -------------------
                // if running the server remotely, send intentions now after
                // the incoming messages have been read
                if (int(sv.active) == 0) {
                    CL_SendCmd()
                }
                host_time += host_frametime
                // fetch results from server
                if (cls.state == cactive_t.ca_connected) {
                    CL_ReadFromServer()
                }
                // update video
                if (host_speeds.value != 0.0f) {
                    _Host_Frame_time1 = Sys_FloatTime()
                }
                SCR_UpdateScreen()
                if (host_speeds.value != 0.0f) {
                    _Host_Frame_time2 = Sys_FloatTime()
                }
                // update audio
                if (cls.signon == SIGNONS) {
                    S_Update(addr(r_origin[0]), addr(vpn[0]), addr(vright[0]), addr(vup[0]))
                    CL_DecayLights()
                } else {
                    S_Update(addr(vec3_origin[0]), addr(vec3_origin[0]), addr(vec3_origin[0]), addr(vec3_origin[0]))
                }
                CDAudio_Update()
                if (host_speeds.value != 0.0f) {
                    pass1 = int((_Host_Frame_time1 - _Host_Frame_time3) * 1000.0lf)
                    _Host_Frame_time3 = Sys_FloatTime()
                    pass2 = int((_Host_Frame_time2 - _Host_Frame_time1) * 1000.0lf)
                    pass3 = int((_Host_Frame_time3 - _Host_Frame_time2) * 1000.0lf)
                    Con_Printf`va(cstr("%3i tot %3i server %3i gfx %3i snd\n"), (pass1 + pass2 + pass3, pass1, pass2, pass3))
                }
                host_framecount++
                return false
            })
        } recover {
            if (c_jmp_target != addr(host_abortserver)) {
                c_jmp_rethrow()
            }
            c_jmp_target = null
            _sj_val = host_abortserver.val
            _sj_run = true
        }
    }
    if (_sj_returned) {
        return
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Host_Frame(time : float) {
    var time1 : double
    var time2 : double
    var c : int
    var m : int
    if (serverprofile.value == 0.0f) {
        _Host_Frame(time)
        return
    }
    time1 = Sys_FloatTime()
    _Host_Frame(time)
    time2 = Sys_FloatTime()
    Host_Frame_timetotal += time2 - time1
    Host_Frame_timecount++
    if (Host_Frame_timecount < 1000) {
        return
    }
    m = int(Host_Frame_timetotal * 1000.0lf / double(Host_Frame_timecount))
    Host_Frame_timecount = 0
    Host_Frame_timetotal = 0.0lf
    c = 0
    for (i in range(svs.maxclients)) {
        if (int(svs.clients[i].active) != 0) {
            c++
        }
    }
    Con_Printf`va(cstr("serverprofile: %2i clients %2i msec\n"), (c, m))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Host_InitVCR(var parms : quakeparms_t?) {
    var i : int
    var len : int
    var n : int
    var p : uint8?
    if (COM_CheckParm(cstr("-playback")) != 0) {
        if (com_argc != 2) {
            Sys_Error`va(cstr("No other parameters allowed with -playback\n"), VaNone())
        }
        Sys_FileOpenRead(cstr("quake.vcr"), addr(vcrFile))
        if (vcrFile == -1) {
            Sys_Error`va(cstr("playback file not found\n"), VaNone())
        }
        Sys_FileRead(vcrFile, reinterpret<void?>(addr(i)), typeinfo sizeof(type<int>))
        if (i != VCR_SIGNATURE) {
            Sys_Error`va(cstr("Invalid signature in vcr file\n"), VaNone())
        }
        Sys_FileRead(vcrFile, reinterpret<void?>(addr(com_argc)), typeinfo sizeof(type<int>))
        com_argv = reinterpret<uint8 ??>(crt::malloc(uint64(com_argc) * uint64(typeinfo sizeof(type<uint8?>))))
        com_argv[0] = parms.argv[0]
        i = 0
        while (i < com_argc) {
            Sys_FileRead(vcrFile, reinterpret<void?>(addr(len)), typeinfo sizeof(type<int>))
            p = reinterpret<uint8?>(crt::malloc(uint64(len)))
            Sys_FileRead(vcrFile, reinterpret<void?>(p), len)
            com_argv[i + 1] = p
            i++
        }
        // add one for arg[0]
        com_argc++
        parms.argc = com_argc
        parms.argv = com_argv
    }
    n = COM_CheckParm(cstr("-record"))
    if (n != 0) {
        vcrFile = Sys_FileOpenWrite(cstr("quake.vcr"))
        i = VCR_SIGNATURE
        Sys_FileWrite(vcrFile, reinterpret<void?>(addr(i)), typeinfo sizeof(type<int>))
        i = com_argc - 1
        Sys_FileWrite(vcrFile, reinterpret<void?>(addr(i)), typeinfo sizeof(type<int>))
        i = 1
        while (i < com_argc) {
            {
                if (i == n) {
                    len = 10
                    Sys_FileWrite(vcrFile, reinterpret<void?>(addr(len)), typeinfo sizeof(type<int>))
                    Sys_FileWrite(vcrFile, reinterpret<void?>(cstr("-playback")), len)
                    continue
                }
                len = Q_strlen(com_argv[i]) + 1
                Sys_FileWrite(vcrFile, reinterpret<void?>(addr(len)), typeinfo sizeof(type<int>))
                Sys_FileWrite(vcrFile, reinterpret<void?>(com_argv[i]), len)
            } finally {
                i++
            }
        }
    }
}

