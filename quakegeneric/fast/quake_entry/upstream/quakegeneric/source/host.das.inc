// ================
// Host_FindMaxClients
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Host_FindMaxClients {
    var i : int
    svs.maxclients = 1
    i = COM_CheckParm(cstr("-dedicated"))
    if (i != 0) {
        cls.state = cactive_t.ca_dedicated
        if (i != (com_argc - 1)) {
            svs.maxclients = Q_atoi(com_argv[i + 1])
        } else {
            svs.maxclients = 8
        }
    } else {
        cls.state = cactive_t.ca_disconnected
    }
    i = COM_CheckParm(cstr("-listen"))
    if (i != 0) {
        if (cls.state == cactive_t.ca_dedicated) {
            Sys_Error`va(cstr("Only one of -dedicated or -listen can be specified"), VaNone())
        }
        if (i != (com_argc - 1)) {
            svs.maxclients = Q_atoi(com_argv[i + 1])
        } else {
            svs.maxclients = 8
        }
    }
    if (svs.maxclients < 1) {
        svs.maxclients = 8
    } elif (svs.maxclients > MAX_SCOREBOARD) {
        svs.maxclients = MAX_SCOREBOARD
    }
    svs.maxclientslimit = svs.maxclients
    if (svs.maxclientslimit < 4) {
        svs.maxclientslimit = 4
    }
    svs.clients = reinterpret<client_s?>(Hunk_AllocName(int(uint64(svs.maxclientslimit) * uint64(typeinfo sizeof(type<client_s>))), cstr("clients")))
    if (svs.maxclients > 1) {
        Cvar_SetValue(cstr("deathmatch"), float(1.0lf))
    } else {
        Cvar_SetValue(cstr("deathmatch"), float(0.0lf))
    }
}

