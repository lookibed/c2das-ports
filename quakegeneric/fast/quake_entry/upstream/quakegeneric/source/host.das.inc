// =====================
// SV_DropClient
// Called when the player is getting totally kicked off the host
// if (crash = true), don't bother sending signofs
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_DropClient(crash : qboolean) {
    var saveSelf : int
    var i : int
    var client : client_s?
    if (int(crash) == 0) {
        // send any final messages (don't check for errors)
        if (int(NET_CanSendMessage(host_client.netconnection)) != 0) {
            MSG_WriteByte(addr(host_client.message), svc_disconnect)
            NET_SendMessage(host_client.netconnection, addr(host_client.message))
        }
        if (host_client.edict != null && uint(host_client.spawned) != 0) {
            // call the prog function for removing a client
            // this will set the body to a dead frame, among other things
            saveSelf = pr_global_struct.self
            pr_global_struct.self = int(EDICT_TO_PROG(host_client.edict))
            PR_ExecuteProgram(pr_global_struct.ClientDisconnect)
            pr_global_struct.self = saveSelf
        }
        Sys_Printf`va(cstr("Client %s removed\n"), (addr(host_client.name[0]),))
    }
    // break the net connection
    NET_Close(host_client.netconnection)
    host_client.netconnection = null
    // free the client (the body stays around)
    host_client.active = qboolean._c_false
    host_client.name[0] = 0u8
    host_client.old_frags = -999999
    net_activeconnections--
    // send notification to all clients
    i = 0
    client = svs.clients
    while (i < svs.maxclients) {
        {
            if (int(client.active) == 0) {
                continue
            }
            MSG_WriteByte(addr(client.message), svc_updatename)
            MSG_WriteByte(addr(client.message), int(int64(host_client - svs.clients)))
            MSG_WriteString(addr(client.message), addr(c2das_empty[0]))
            MSG_WriteByte(addr(client.message), svc_updatefrags)
            MSG_WriteByte(addr(client.message), int(int64(host_client - svs.clients)))
            MSG_WriteShort(addr(client.message), 0)
            MSG_WriteByte(addr(client.message), svc_updatecolors)
            MSG_WriteByte(addr(client.message), int(int64(host_client - svs.clients)))
            MSG_WriteByte(addr(client.message), 0)
        } finally {
            i++
            client++
        }
    }
}

// ==================
// Host_ShutdownServer
// This only happens at the end of a game, not between levels
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Host_ShutdownServer(crash : qboolean) {
    var i : int
    var count : int
    var buf : sizebuf_s
    var message : uint8[4]
    var start : double
    if (int(sv.active) == 0) {
        return
    }
    sv.active = qboolean._c_false
    // stop all client sounds immediately
    if (cls.state == cactive_t.ca_connected) {
        CL_Disconnect()
    }
    // flush any pending messages - like the score!!!
    start = Sys_FloatTime()
    c_do_while(count != 0) {
        count = 0
        i = 0
        host_client = svs.clients
        while (i < svs.maxclients) {
            if (uint(host_client.active) != 0 && host_client.message.cursize != 0) {
                if (int(NET_CanSendMessage(host_client.netconnection)) != 0) {
                    NET_SendMessage(host_client.netconnection, addr(host_client.message))
                    SZ_Clear(addr(host_client.message))
                } else {
                    NET_GetMessage(host_client.netconnection)
                    count++
                }
            }
            i++
            host_client++
        }
        if ((Sys_FloatTime() - start) > 3.0lf) {
            break
        }
    }
    // make sure all the clients know we're disconnecting
    buf.data = reinterpret<uint8?>(addr(message[0]))
    buf.maxsize = 4
    buf.cursize = 0
    MSG_WriteByte(addr(buf), svc_disconnect)
    count = NET_SendToAll(addr(buf), 5)
    if (count != 0) {
        Con_Printf`va(cstr("Host_ShutdownServer: NET_SendToAll failed for %u clients\n"), (count,))
    }
    i = 0
    host_client = svs.clients
    while (i < svs.maxclients) {
        if (int(host_client.active) != 0) {
            SV_DropClient(crash)
        }
        i++
        host_client++
    }
    // clear structures
    crt::memset(reinterpret<void?>(addr(sv)), 0, uint64(typeinfo sizeof(type<server_t>)))
    crt::memset(reinterpret<void?>(svs.clients), 0, uint64(svs.maxclientslimit) * uint64(typeinfo sizeof(type<client_s>)))
}

