// ===================
// Host_FilterTime
// Returns false if the time is too short to run a frame
// ===================
[unsafe_deref, hint(unsafe_range_check)]
def Host_FilterTime(time : float) : qboolean {
    realtime += double(time)
    if (int(cls.timedemo) == 0 && realtime - oldrealtime < 1.0lf / 72.0lf) {
        // framerate is too high
        return qboolean._c_false
    }
    host_frametime = realtime - oldrealtime
    oldrealtime = realtime
    if (host_framerate.value > 0.0f) {
        host_frametime = double(host_framerate.value)
    } else {
        // don't allow really long or short frames
        if (host_frametime > 0.1lf) {
            host_frametime = 0.1lf
        }
        if (host_frametime < 0.001lf) {
            host_frametime = 0.001lf
        }
    }
    return qboolean._c_true
}

