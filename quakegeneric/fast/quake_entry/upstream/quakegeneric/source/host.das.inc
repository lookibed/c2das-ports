[c_function, unsafe_deref, hint(unsafe_range_check)]
def Host_Init(var parms : quakeparms_t?) {
    if (int(standard_quake) != 0) {
        minimum_memory = MINIMUM_MEMORY
    } else {
        minimum_memory = MINIMUM_MEMORY_LEVELPAK
    }
    if (COM_CheckParm(cstr("-minmemory")) != 0) {
        parms.memsize = minimum_memory
    }
    host_parms = *parms
    if (parms.memsize < minimum_memory) {
        Sys_Error`va(cstr("Only %4.1f megs of memory available, can't execute game"), (double(float(parms.memsize) / 1048576.0f),))
    }
    com_argc = parms.argc
    com_argv = parms.argv
    Memory_Init(parms.membase, parms.memsize)
    Cbuf_Init()
    Cmd_Init()
    V_Init()
    Chase_Init()
    Host_InitVCR(parms)
    COM_Init(parms.basedir)
    Host_InitLocal()
    W_LoadWadFile(cstr("gfx.wad"))
    Key_Init()
    Con_Init()
    M_Init()
    PR_Init()
    Mod_Init()
    NET_Init()
    SV_Init()
    Con_Printf`va(cstr("Exe: 22:02:29 Nov 26 2026\n"), VaNone())
    Con_Printf`va(cstr("%4.1f megabyte heap\n"), (double(parms.memsize) / (1024.0lf * 1024.0lf),))
    // needed even for dedicated servers
    R_InitTextures()
    if (cls.state != cactive_t.ca_dedicated) {
        host_basepal = COM_LoadHunkFile(cstr("gfx/palette.lmp"))
        if (host_basepal == null) {
            Sys_Error`va(cstr("Couldn't load gfx/palette.lmp"), VaNone())
        }
        host_colormap = COM_LoadHunkFile(cstr("gfx/colormap.lmp"))
        if (host_colormap == null) {
            Sys_Error`va(cstr("Couldn't load gfx/colormap.lmp"), VaNone())
        }
        IN_Init()
        VID_Init(host_basepal)
        Draw_Init()
        SCR_Init()
        R_Init()
        S_Init()
        CDAudio_Init()
        Sbar_Init()
        CL_Init()
    }
    Cbuf_InsertText(cstr("exec quake.rc\n"))
    Hunk_AllocName(0, cstr("-HOST_HUNKLEVEL-"))
    host_hunklevel = Hunk_LowMark()
    host_initialized = qboolean._c_true
    Sys_Printf`va(cstr("========Quake Initialized=========\n"), VaNone())
}

// ===============
// Host_Shutdown
// FIXME: this is a callback from Sys_Quit and Sys_Error. It would be better
// to run quit through here before the final handoff to the sys code.
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Host_Shutdown {
    if (int(Host_Shutdown_isdown) != 0) {
        fprintf(crt::c_stderr(), cstr("recursive shutdown\n"))
        return
    }
    Host_Shutdown_isdown = qboolean._c_true
    // keep Con_Printf from trying to update the screen
    scr_disabled_for_loading = qboolean._c_true
    Host_WriteConfiguration()
    CDAudio_Shutdown()
    NET_Shutdown()
    S_Shutdown()
    IN_Shutdown()
    if (cls.state != cactive_t.ca_dedicated) {
        VID_Shutdown()
    }
}

