    pr_stack[pr_depth].f = pr_xfunction
    pr_depth++
    if (pr_depth >= MAX_STACK_DEPTH) {
        PR_RunError`va(cstr("stack overflow"), VaNone())
    }
    // save off any locals that the new function steps on
    c = f.locals
    if (localstack_used + c > LOCALSTACK_SIZE) {
        PR_RunError`va(cstr("PR_ExecuteProgram: locals stack overflow\n"), VaNone())
    }
    for (i1 in range(c)) {
        localstack[localstack_used + i1] = reinterpret<int?>(pr_globals)[f.parm_start + i1]
    }
    localstack_used += c
