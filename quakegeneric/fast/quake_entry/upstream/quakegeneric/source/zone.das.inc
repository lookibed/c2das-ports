// ============
// Cache_Init
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_Init {
    cache_head.prev = addr(cache_head)
    cache_head.next = cache_head.prev
    cache_head.lru_prev = addr(cache_head)
    cache_head.lru_next = cache_head.lru_prev
    Cmd_AddCommand(cstr("flush"), @@Cache_Flush)
}

// ==============
// Cache_Free
// Frees the memory and removes it from the LRU list
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_Free(var c : cache_user_s?) {
    var cs : cache_system_s?
    if (c.data == null) {
        Sys_Error`va(cstr("Cache_Free: not allocated"), VaNone())
    }
    cs = reinterpret<cache_system_s?>(c.data) + -(1)
    cs.prev.next = cs.next
    cs.next.prev = cs.prev
    cs.prev = null
    cs.next = cs.prev
    c.data = null
    Cache_UnlinkLRU(cs)
}

// ==============
// Cache_Check
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_Check(var c : cache_user_s?) : void? {
    var cs : cache_system_s?
    if (c.data == null) {
        return null
    }
    cs = reinterpret<cache_system_s?>(c.data) + -(1)
    // move to head of LRU
    Cache_UnlinkLRU(cs)
    Cache_MakeLRU(cs)
    return c.data
}

// ==============
// Cache_Alloc
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_Alloc(var c : cache_user_s?; var size : int; var name : uint8?) : void? {
    var cs : cache_system_s?
    if (c.data != null) {
        Sys_Error`va(cstr("Cache_Alloc: allready allocated"), VaNone())
    }
    if (size <= 0) {
        Sys_Error`va(cstr("Cache_Alloc: size %i"), (size,))
    }
    size = int((uint64(size) + uint64(typeinfo sizeof(type<cache_system_s>)) + 15ul) & uint64(~15))
    // find memory for it
    while (1 != 0) {
        cs = Cache_TryAlloc(size, qboolean._c_false)
        if (cs != null) {
            crt::strncpy(addr(cs.name[0]), name, uint64(typeinfo sizeof(type<uint8[16]>)) - 1ul)
            c.data = reinterpret<void?>(cs + 1)
            cs.user = c
            break
        }
        // free the least recently used cahedat
        if (intptr(cache_head.lru_prev) == intptr(addr(cache_head))) {
            Sys_Error`va(cstr("Cache_Alloc: out of memory"), VaNone())
        }
        // not enough memory at all
        Cache_Free(cache_head.lru_prev.user)
    }
    return Cache_Check(c)
}

// ========================
// Memory_Init
// ========================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Memory_Init(var buf : void?; size : int) {
    var p : int
    var zonesize : int = DYNAMIC_SIZE
    hunk_base = reinterpret<uint8?>(buf)
    hunk_size = size
    hunk_low_used = 0
    hunk_high_used = 0
    Cache_Init()
    p = COM_CheckParm(cstr("-zone"))
    if (p != 0) {
        if (p < com_argc - 1) {
            zonesize = Q_atoi(com_argv[p + 1]) * 1024
        } else {
            Sys_Error`va(cstr("Memory_Init: you must specify a size in KB after -zone"), VaNone())
        }
    }
    mainzone = reinterpret<memzone_t?>(Hunk_AllocName(zonesize, cstr("zone")))
    Z_ClearZone(mainzone, zonesize)
}

