// generated by c2das - regenerate, never edit
struct memblock_s {
    size, tag, id : int
    next, prev : memblock_s?
    pad : int
}

struct memzone_t {
    size : int
    blocklist : memblock_s
    rover : memblock_s?
}

struct hunk_t {
    sentinal, size : int
    name : uint8[8]
}

struct cache_system_s {
    size : int
    user : cache_user_s?
    name : uint8[16]
    prev, next, lru_prev, lru_next : cache_system_s?
}

var mainzone : memzone_t?
var hunk_base : uint8?
var hunk_size : int
var hunk_low_used : int
var hunk_high_used : int
var hunk_tempactive : qboolean
var hunk_tempmark : int
var cache_head : cache_system_s

// ========================
// Z_ClearZone
// ========================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_ClearZone(var zone : memzone_t?; size : int) {
    var _c_block : memblock_s?
    // set the entire zone to one free block
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(zone) + uint64(typeinfo sizeof(type<memzone_t>)))
    zone.blocklist.prev = _c_block
    zone.blocklist.next = zone.blocklist.prev
    // in use block
    zone.blocklist.tag = 1
    zone.blocklist.id = 0
    zone.blocklist.size = 0
    zone.rover = _c_block
    _c_block.next = addr(zone.blocklist)
    _c_block.prev = _c_block.next
    // free block
    _c_block.tag = 0
    _c_block.id = ZONEID
    _c_block.size = int(uint64(size) - uint64(typeinfo sizeof(type<memzone_t>)))
}

// ========================
// Z_Free
// ========================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_Free(var ptr : void?) {
    var _c_block : memblock_s?
    var other : memblock_s?
    if (ptr == null) {
        Sys_Error`va(cstr("Z_Free: NULL pointer"), VaNone())
    }
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(ptr) + -int64(uint64(typeinfo sizeof(type<memblock_s>))))
    if (_c_block.id != ZONEID) {
        Sys_Error`va(cstr("Z_Free: freed a pointer without ZONEID"), VaNone())
    }
    if (_c_block.tag == 0) {
        Sys_Error`va(cstr("Z_Free: freed a freed pointer"), VaNone())
    }
    // mark as free
    _c_block.tag = 0
    other = _c_block.prev
    if (other.tag == 0) {
        // merge with previous free block
        other.size += _c_block.size
        other.next = _c_block.next
        other.next.prev = other
        if (intptr(_c_block) == intptr(mainzone.rover)) {
            mainzone.rover = other
        }
        _c_block = other
    }
    other = _c_block.next
    if (other.tag == 0) {
        // merge the next free block onto the end
        _c_block.size += other.size
        _c_block.next = other.next
        _c_block.next.prev = _c_block
        if (intptr(other) == intptr(mainzone.rover)) {
            mainzone.rover = _c_block
        }
    }
}

// ========================
// Z_Malloc
// ========================
[unsafe_deref, hint(unsafe_range_check)]
def Z_Malloc(size : int) : void? {
    var buf : void?
    // DEBUG
    Z_CheckHeap()
    buf = Z_TagMalloc(size, 1)
    if (buf == null) {
        Sys_Error`va(cstr("Z_Malloc: failed on allocation of %i bytes"), (size,))
    }
    Q_memset(buf, 0, size)
    return buf
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_TagMalloc(var size : int; tag : int) : void? {
    var extra : int
    var start : memblock_s?
    var rover : memblock_s?
    var _c_new : memblock_s?
    var base : memblock_s?
    if (tag == 0) {
        Sys_Error`va(cstr("Z_TagMalloc: tried to use a 0 tag"), VaNone())
    }
    // scan through the block list looking for the first free block
    // of sufficient size
    // account for size of block header
    size = int(uint64(size) + uint64(typeinfo sizeof(type<memblock_s>)))
    // space for memory trash tester
    size += 4
    // align to 8-byte boundary
    size = (size + 7) & ~7
    rover = mainzone.rover
    base = rover
    start = base.prev
    c_do_while(base.tag != 0 || base.size < size) {
        // scaned all the way around the list
        if (intptr(rover) == intptr(start)) {
            return null
        }
        if (rover.tag != 0) {
            rover = rover.next
            base = rover
        } else {
            rover = rover.next
        }
    }
    // found a block big enough
    extra = base.size - size
    if (extra > MINFRAGMENT) {
        // there will be a free fragment after the allocated block
        _c_new = reinterpret<memblock_s?>(reinterpret<uint8?>(base) + size)
        _c_new.size = extra
        // free block
        _c_new.tag = 0
        _c_new.prev = base
        _c_new.id = ZONEID
        _c_new.next = base.next
        _c_new.next.prev = _c_new
        base.next = _c_new
        base.size = size
    }
    // no longer a free block
    base.tag = tag
    // next allocation will start looking here
    mainzone.rover = base.next
    base.id = ZONEID
    // marker for memory trash testing
    *reinterpret<int?>(reinterpret<uint8?>(base) + base.size + -(4)) = ZONEID
    return reinterpret<void?>(reinterpret<uint8?>(base) + uint64(typeinfo sizeof(type<memblock_s>)))
}

// ========================
// Z_Print
// ========================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_Print(var zone : memzone_t?) {
    var _c_block : memblock_s?
    Con_Printf`va(cstr("zone size: %i  location: %p\n"), (mainzone.size, mainzone))
    _c_block = zone.blocklist.next
    while (true) {
        Con_Printf`va(cstr("block:%p    size:%7i    tag:%3i\n"), (_c_block, _c_block.size, _c_block.tag))
        if (intptr(_c_block.next) == intptr(addr(zone.blocklist))) {
            // all blocks have been hit
            break
        }
        if (intptr(reinterpret<uint8?>(_c_block) + _c_block.size) != intptr(reinterpret<uint8?>(_c_block.next))) {
            Con_Printf`va(cstr("ERROR: block size does not touch the next block\n"), VaNone())
        }
        if (intptr(_c_block.next.prev) != intptr(_c_block)) {
            Con_Printf`va(cstr("ERROR: next block doesn't have proper back link\n"), VaNone())
        }
        if (_c_block.tag == 0 && _c_block.next.tag == 0) {
            Con_Printf`va(cstr("ERROR: two consecutive free blocks\n"), VaNone())
        }
        _c_block = _c_block.next
    }
}

// ========================
// Z_CheckHeap
// ========================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_CheckHeap {
    var _c_block : memblock_s?
    _c_block = mainzone.blocklist.next
    while (true) {
        if (intptr(_c_block.next) == intptr(addr(mainzone.blocklist))) {
            // all blocks have been hit
            break
        }
        if (intptr(reinterpret<uint8?>(_c_block) + _c_block.size) != intptr(reinterpret<uint8?>(_c_block.next))) {
            Sys_Error`va(cstr("Z_CheckHeap: block size does not touch the next block\n"), VaNone())
        }
        if (intptr(_c_block.next.prev) != intptr(_c_block)) {
            Sys_Error`va(cstr("Z_CheckHeap: next block doesn't have proper back link\n"), VaNone())
        }
        if (_c_block.tag == 0 && _c_block.next.tag == 0) {
            Sys_Error`va(cstr("Z_CheckHeap: two consecutive free blocks\n"), VaNone())
        }
        _c_block = _c_block.next
    }
}

// ==============
// Hunk_Check
// Run consistancy and sentinal trahing checks
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Hunk_Check {
    var h : hunk_t?
    h = reinterpret<hunk_t?>(hunk_base)
    while (intptr(reinterpret<uint8?>(h)) != intptr(hunk_base + hunk_low_used)) {
        if (h.sentinal != HUNK_SENTINAL) {
            Sys_Error`va(cstr("Hunk_Check: trahsed sentinal"), VaNone())
        }
        if (h.size < 16 || int64(reinterpret<uint8?>(h) + h.size - hunk_base) > int64(hunk_size)) {
            Sys_Error`va(cstr("Hunk_Check: bad size"), VaNone())
        }
        h = reinterpret<hunk_t?>(reinterpret<uint8?>(h) + h.size)
    }
}

// ==============
// Hunk_Print
// If "all" is specified, every single allocation is printed.
// Otherwise, allocations with the same name will be totaled up before printing.
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Hunk_Print(all : qboolean) {
    var h : hunk_t?
    var next : hunk_t?
    var endlow : hunk_t?
    var starthigh : hunk_t?
    var endhigh : hunk_t?
    var count : int
    var sum : int
    var totalblocks : int
    var name : uint8[9]
    name[8] = 0u8
    count = 0
    sum = 0
    totalblocks = 0
    h = reinterpret<hunk_t?>(hunk_base)
    endlow = reinterpret<hunk_t?>(hunk_base + hunk_low_used)
    starthigh = reinterpret<hunk_t?>(hunk_base + hunk_size + -(hunk_high_used))
    endhigh = reinterpret<hunk_t?>(hunk_base + hunk_size)
    Con_Printf`va(cstr("          :%8i total hunk size\n"), (hunk_size,))
    Con_Printf`va(cstr("-------------------------\n"), VaNone())
    while (1 != 0) {
        // skip to the high hunk if done with low hunk
        if (intptr(h) == intptr(endlow)) {
            Con_Printf`va(cstr("-------------------------\n"), VaNone())
            Con_Printf`va(cstr("          :%8i REMAINING\n"), (hunk_size - hunk_low_used - hunk_high_used,))
            Con_Printf`va(cstr("-------------------------\n"), VaNone())
            h = starthigh
        }
        // if totally done, break
        if (intptr(h) == intptr(endhigh)) {
            break
        }
        // run consistancy checks
        if (h.sentinal != HUNK_SENTINAL) {
            Sys_Error`va(cstr("Hunk_Check: trahsed sentinal"), VaNone())
        }
        if (h.size < 16 || int64(reinterpret<uint8?>(h) + h.size - hunk_base) > int64(hunk_size)) {
            Sys_Error`va(cstr("Hunk_Check: bad size"), VaNone())
        }
        next = reinterpret<hunk_t?>(reinterpret<uint8?>(h) + h.size)
        count++
        totalblocks++
        sum += h.size
        // print the single block
        crt::memcpy(reinterpret<void?>(addr(name[0])), reinterpret<void?>(addr(h.name[0])), 8ul)
        if (int(all) != 0) {
            Con_Printf`va(cstr("%8p :%8i %8s\n"), (h, h.size, addr(name[0])))
        }
        // print the total
        if (intptr(next) == intptr(endlow) || intptr(next) == intptr(endhigh) || crt::strncmp(addr(h.name[0]), addr(next.name[0]), 8ul) != 0) {
            if (int(all) == 0) {
                Con_Printf`va(cstr("          :%8i %8s (TOTAL)\n"), (sum, addr(name[0])))
            }
            count = 0
            sum = 0
        }
        h = next
    }
    Con_Printf`va(cstr("-------------------------\n"), VaNone())
    Con_Printf`va(cstr("%8i total blocks\n"), (totalblocks,))
}

// ===================
// Hunk_AllocName
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Hunk_AllocName(var size : int; var name : uint8?) : void? {
    var h : hunk_t?
    if (size < 0) {
        Sys_Error`va(cstr("Hunk_Alloc: bad size: %i"), (size,))
    }
    size = int(uint64(typeinfo sizeof(type<hunk_t>)) + uint64((size + 15) & ~15))
    if (hunk_size - hunk_low_used - hunk_high_used < size) {
        Sys_Error`va(cstr("Hunk_Alloc: failed on %i bytes"), (size,))
    }
    h = reinterpret<hunk_t?>(hunk_base + hunk_low_used)
    hunk_low_used += size
    Cache_FreeLow(hunk_low_used)
    crt::memset(reinterpret<void?>(h), 0, uint64(size))
    h.size = size
    h.sentinal = HUNK_SENTINAL
    Q_strncpy(addr(h.name[0]), name, 8)
    return reinterpret<void?>(h + 1)
}

// ===================
// Hunk_Alloc
// ===================
[unsafe_deref, hint(unsafe_range_check)]
def Hunk_Alloc(size : int) : void? {
    return Hunk_AllocName(size, cstr("unknown"))
}

[unsafe_deref, hint(unsafe_range_check)]
def Hunk_LowMark : int {
    return hunk_low_used
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Hunk_FreeToLowMark(mark : int) {
    if (mark < 0 || mark > hunk_low_used) {
        Sys_Error`va(cstr("Hunk_FreeToLowMark: bad mark %i"), (mark,))
    }
    crt::memset(reinterpret<void?>(hunk_base + mark), 0, uint64(hunk_low_used - mark))
    hunk_low_used = mark
}

[unsafe_deref, hint(unsafe_range_check)]
def Hunk_HighMark : int {
    if (int(hunk_tempactive) != 0) {
        hunk_tempactive = qboolean._c_false
        Hunk_FreeToHighMark(hunk_tempmark)
    }
    return hunk_high_used
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Hunk_FreeToHighMark(mark : int) {
    if (int(hunk_tempactive) != 0) {
        hunk_tempactive = qboolean._c_false
        Hunk_FreeToHighMark(hunk_tempmark)
    }
    if (mark < 0 || mark > hunk_high_used) {
        Sys_Error`va(cstr("Hunk_FreeToHighMark: bad mark %i"), (mark,))
    }
    crt::memset(reinterpret<void?>(hunk_base + hunk_size + -(hunk_high_used)), 0, uint64(hunk_high_used - mark))
    hunk_high_used = mark
}

// ===================
// Hunk_HighAllocName
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Hunk_HighAllocName(var size : int; var name : uint8?) : void? {
    var h : hunk_t?
    if (size < 0) {
        Sys_Error`va(cstr("Hunk_HighAllocName: bad size: %i"), (size,))
    }
    if (int(hunk_tempactive) != 0) {
        Hunk_FreeToHighMark(hunk_tempmark)
        hunk_tempactive = qboolean._c_false
    }
    size = int(uint64(typeinfo sizeof(type<hunk_t>)) + uint64((size + 15) & ~15))
    if (hunk_size - hunk_low_used - hunk_high_used < size) {
        Con_Printf`va(cstr("Hunk_HighAlloc: failed on %i bytes\n"), (size,))
        return null
    }
    hunk_high_used += size
    Cache_FreeHigh(hunk_high_used)
    h = reinterpret<hunk_t?>(hunk_base + hunk_size + -(hunk_high_used))
    crt::memset(reinterpret<void?>(h), 0, uint64(size))
    h.size = size
    h.sentinal = HUNK_SENTINAL
    Q_strncpy(addr(h.name[0]), name, 8)
    return reinterpret<void?>(h + 1)
}

// =================
// Hunk_TempAlloc
// Return space from the top of the hunk
// =================
[unsafe_deref, hint(unsafe_range_check)]
def Hunk_TempAlloc(var size : int) : void? {
    var buf : void?
    size = (size + 15) & ~15
    if (int(hunk_tempactive) != 0) {
        Hunk_FreeToHighMark(hunk_tempmark)
        hunk_tempactive = qboolean._c_false
    }
    hunk_tempmark = Hunk_HighMark()
    buf = Hunk_HighAllocName(size, cstr("temp"))
    hunk_tempactive = qboolean._c_true
    return buf
}

// ===========
// Cache_Move
// ===========
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_Move(var c : cache_system_s?) {
    var _c_new : cache_system_s?
    // we are clearing up space at the bottom, so only allocate it late
    _c_new = Cache_TryAlloc(c.size, qboolean._c_true)
    if (_c_new != null) {
        // Con_Printf ("cache_move ok\n");
        Q_memcpy(reinterpret<void?>(_c_new + 1), reinterpret<void?>(c + 1), int(uint64(c.size) - uint64(typeinfo sizeof(type<cache_system_s>))))
        _c_new.user = c.user
        Q_memcpy(reinterpret<void?>(addr(_c_new.name[0])), reinterpret<void?>(addr(c.name[0])), typeinfo sizeof(type<uint8[16]>))
        Cache_Free(c.user)
        _c_new.user.data = reinterpret<void?>(_c_new + 1)
    } else {
        // Con_Printf ("cache_move failed\n");
        // tough luck...
        Cache_Free(c.user)
    }
}

// ============
// Cache_FreeLow
// Throw things out until the hunk can be expanded to the given point
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_FreeLow(new_low_hunk : int) {
    var c : cache_system_s?
    while (1 != 0) {
        c = cache_head.next
        if (intptr(c) == intptr(addr(cache_head))) {
            // nothing in cache at all
            return
        }
        if (intptr(reinterpret<uint8?>(c)) >= intptr(hunk_base + new_low_hunk)) {
            // there is space to grow the hunk
            return
        }
        // reclaim the space
        Cache_Move(c)
    }
}

// ============
// Cache_FreeHigh
// Throw things out until the hunk can be expanded to the given point
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_FreeHigh(new_high_hunk : int) {
    var c : cache_system_s?
    var prev : cache_system_s?
    prev = null
    while (1 != 0) {
        c = cache_head.prev
        if (intptr(c) == intptr(addr(cache_head))) {
            // nothing in cache at all
            return
        }
        if (intptr(reinterpret<uint8?>(c) + c.size) <= intptr(hunk_base + hunk_size + -(new_high_hunk))) {
            // there is space to grow the hunk
            return
        }
        if (intptr(c) == intptr(prev)) {
            // didn't move out of the way
            Cache_Free(c.user)
        } else {
            // try to move it
            Cache_Move(c)
            prev = c
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def Cache_UnlinkLRU(var cs : cache_system_s?) {
    if (cs.lru_next == null || cs.lru_prev == null) {
        Sys_Error`va(cstr("Cache_UnlinkLRU: NULL link"), VaNone())
    }
    cs.lru_next.lru_prev = cs.lru_prev
    cs.lru_prev.lru_next = cs.lru_next
    cs.lru_next = null
    cs.lru_prev = cs.lru_next
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_MakeLRU(var cs : cache_system_s?) {
    if (cs.lru_next != null || cs.lru_prev != null) {
        Sys_Error`va(cstr("Cache_MakeLRU: active link"), VaNone())
    }
    cache_head.lru_next.lru_prev = cs
    cs.lru_next = cache_head.lru_next
    cs.lru_prev = addr(cache_head)
    cache_head.lru_next = cs
}

// ============
// Cache_TryAlloc
// Looks for a free block of memory between the high and low hunk marks
// Size should already include the header and padding
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_TryAlloc(size : int; nobottom : qboolean) : cache_system_s? {
    var cs : cache_system_s?
    var _c_new : cache_system_s?
    // is the cache completely empty?
    if (int(nobottom) == 0 && intptr(cache_head.prev) == intptr(addr(cache_head))) {
        if (hunk_size - hunk_high_used - hunk_low_used < size) {
            Sys_Error`va(cstr("Cache_TryAlloc: %i is greater then free hunk"), (size,))
        }
        _c_new = reinterpret<cache_system_s?>(hunk_base + hunk_low_used)
        crt::memset(reinterpret<void?>(_c_new), 0, uint64(typeinfo sizeof(type<cache_system_s>)))
        _c_new.size = size
        cache_head.next = _c_new
        cache_head.prev = cache_head.next
        _c_new.next = addr(cache_head)
        _c_new.prev = _c_new.next
        Cache_MakeLRU(_c_new)
        return _c_new
    }
    // search from the bottom up for space
    _c_new = reinterpret<cache_system_s?>(hunk_base + hunk_low_used)
    cs = cache_head.next
    c_do_while(intptr(cs) != intptr(addr(cache_head))) {
        if (int(nobottom) == 0 || intptr(cs) != intptr(cache_head.next)) {
            if (int64(reinterpret<uint8?>(cs) - reinterpret<uint8?>(_c_new)) >= int64(size)) {
                // found space
                crt::memset(reinterpret<void?>(_c_new), 0, uint64(typeinfo sizeof(type<cache_system_s>)))
                _c_new.size = size
                _c_new.next = cs
                _c_new.prev = cs.prev
                cs.prev.next = _c_new
                cs.prev = _c_new
                Cache_MakeLRU(_c_new)
                return _c_new
            }
        }
        // continue looking
        _c_new = reinterpret<cache_system_s?>(reinterpret<uint8?>(cs) + cs.size)
        cs = cs.next
    }
    // try to allocate one at the very end
    if (int64(hunk_base + hunk_size + -(hunk_high_used) - reinterpret<uint8?>(_c_new)) >= int64(size)) {
        crt::memset(reinterpret<void?>(_c_new), 0, uint64(typeinfo sizeof(type<cache_system_s>)))
        _c_new.size = size
        _c_new.next = addr(cache_head)
        _c_new.prev = cache_head.prev
        cache_head.prev.next = _c_new
        cache_head.prev = _c_new
        Cache_MakeLRU(_c_new)
        return _c_new
    }
    // couldn't allocate
    return null
}

// ============
// Cache_Flush
// Throw everything out, so new data will be demand cached
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_Flush {
    while (intptr(cache_head.next) != intptr(addr(cache_head))) {
        // reclaim the space
        Cache_Free(cache_head.next.user)
    }
}

// ============
// Cache_Print
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cache_Print {
    var cd : cache_system_s?
    cd = cache_head.next
    while (intptr(cd) != intptr(addr(cache_head))) {
        Con_Printf`va(cstr("%8i : %s\n"), (cd.size, addr(cd.name[0])))
        cd = cd.next
    }
}

