// generated by c2das - regenerate, never edit
struct cmdalias_s {
    next : cmdalias_s?
    name : uint8[32]
    value : uint8?
}

struct cmd_function_s {
    next : cmd_function_s?
    name : uint8?
    _c_function : function<() : void>
}

var cmd_source : cmd_source_t
var cmd_alias : cmdalias_s?
var trashtest : int
var trashspot : int?
var cmd_wait : qboolean
var cmd_text : sizebuf_s
var private cmd_argc : int
var private cmd_argv : uint8? [80]
var private cmd_null_string : uint8? = unsafe(addr(c2das_empty[0]))
var private cmd_args : uint8? = null
var private cmd_functions : cmd_function_s?

// ============
// Cmd_Wait_f
// Causes execution of the remainder of the command buffer to be delayed until
// next frame. This allows commands like:
// bind g "impulse 5 ; +attack ; wait ; -attack ; impulse 2"
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_Wait_f {
    cmd_wait = qboolean._c_true
}

// ============
// Cbuf_Init
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cbuf_Init {
    // space for commands and script files
    SZ_Alloc(addr(cmd_text), 8192)
}

// ============
// Cbuf_AddText
// Adds command text at the end of the buffer
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cbuf_AddText(var text : uint8?) {
    var l : int
    l = Q_strlen(text)
    if (cmd_text.cursize + l >= cmd_text.maxsize) {
        Con_Printf`va(cstr("Cbuf_AddText: overflow\n"), VaNone())
        return
    }
    SZ_Write(addr(cmd_text), reinterpret<void?>(text), Q_strlen(text))
}

// ============
// Cbuf_InsertText
// Adds command text immediately after the current command
// Adds a \n to the text
// FIXME: actually change the command buffer to do less copying
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cbuf_InsertText(var text : uint8?) {
    var temp : uint8?
    var templen : int
    // copy off any commands still remaining in the exec buffer
    templen = cmd_text.cursize
    if (templen != 0) {
        temp = reinterpret<uint8?>(Z_Malloc(templen))
        Q_memcpy(reinterpret<void?>(temp), reinterpret<void?>(cmd_text.data), templen)
        SZ_Clear(addr(cmd_text))
    } else {
        // shut up compiler
        temp = null
    }
    // add the entire text of the file
    Cbuf_AddText(text)
    // add the copied off data
    if (templen != 0) {
        SZ_Write(addr(cmd_text), reinterpret<void?>(temp), templen)
        Z_Free(reinterpret<void?>(temp))
    }
}

// ============
// Cbuf_Execute
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cbuf_Execute {
    var i : int
    var text : uint8?
    var line : uint8[1024]
    var quotes : int
    while (cmd_text.cursize != 0) {
        // find a \n or ; line break
        text = reinterpret<uint8?>(cmd_text.data)
        quotes = 0
        i = 0
        while (i < cmd_text.cursize) {
            if (text[i] == '"') {
                quotes++
            }
            if ((quotes & 1) == 0 && text[i] == ';') {
                // don't break if inside a quoted string
                break
            }
            if (text[i] == '\n') {
                break
            }
            i++
        }
        crt::memcpy(reinterpret<void?>(addr(line[0])), reinterpret<void?>(text), uint64(i))
        line[i] = 0u8
        // delete the text from the command buffer and move remaining commands down
        // this is necessary because commands (exec, alias) can insert data at the
        // beginning of the text buffer
        if (i == cmd_text.cursize) {
            cmd_text.cursize = 0
        } else {
            i++
            cmd_text.cursize -= i
            Q_memcpy(reinterpret<void?>(text), reinterpret<void?>(text + i), cmd_text.cursize)
        }
        // execute the command line
        Cmd_ExecuteString(addr(line[0]), cmd_source_t.src_command)
        if (int(cmd_wait) != 0) {
            // skip out while text still remains in buffer, leaving it
            // for next frame
            cmd_wait = qboolean._c_false
            break
        }
    }
}

// ===============
// Cmd_StuffCmds_f
// Adds command line parameters as script statements
// Commands lead with a +, and continue until a - or another +
// quake +prog jctest.qp +cmd amlev1
// quake -nosound +cmd amlev1
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cmd_StuffCmds_f {
    var i : int
    var j : int
    var s : int
    var text : uint8?
    var build : uint8?
    var c : uint8
    if (Cmd_Argc() != 1) {
        Con_Printf`va(cstr("stuffcmds : execute command line parameters\n"), VaNone())
        return
    }
    // build the combined string to parse from
    s = 0
    for (i1 in range(1, com_argc)) {
        if (com_argv[i1] == null) {
            // NEXTSTEP nulls out -NXHost
            continue
        }
        s += Q_strlen(com_argv[i1]) + 1
    }
    if (s == 0) {
        return
    }
    text = reinterpret<uint8?>(Z_Malloc(s + 1))
    text[0] = 0u8
    i = 1
    while (i < com_argc) {
        {
            if (com_argv[i] == null) {
                // NEXTSTEP nulls out -NXHost
                continue
            }
            Q_strcat(text, com_argv[i])
            if (i != com_argc - 1) {
                Q_strcat(text, cstr(" "))
            }
        } finally {
            i++
        }
    }
    // pull out the commands
    build = reinterpret<uint8?>(Z_Malloc(s + 1))
    build[0] = 0u8
    i = 0
    while (i < s - 1) {
        if (text[i] == '+') {
            i++
            j = i
            while ((text[j] != '+') && (text[j] != '-') && (text[j] != 0)) {
                j++
            }
            c = text[j]
            text[j] = 0u8
            Q_strcat(build, text + i)
            Q_strcat(build, cstr("\n"))
            text[j] = c
            i = j - 1
        }
        i++
    }
    if (build[0] != 0) {
        Cbuf_InsertText(build)
    }
    Z_Free(reinterpret<void?>(text))
    Z_Free(reinterpret<void?>(build))
}

// ===============
// Cmd_Exec_f
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cmd_Exec_f {
    var f : uint8?
    var mark : int
    if (Cmd_Argc() != 2) {
        Con_Printf`va(cstr("exec <filename> : execute a script file\n"), VaNone())
        return
    }
    mark = Hunk_LowMark()
    f = reinterpret<uint8?>(COM_LoadHunkFile(Cmd_Argv(1)))
    if (f == null) {
        Con_Printf`va(cstr("couldn't exec %s\n"), (Cmd_Argv(1),))
        return
    }
    Con_Printf`va(cstr("execing %s\n"), (Cmd_Argv(1),))
    Cbuf_InsertText(f)
    Hunk_FreeToLowMark(mark)
}

// ===============
// Cmd_Echo_f
// Just prints the rest of the line to the console
// ===============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_Echo_f {
    var i : int
    i = 1
    while (i < Cmd_Argc()) {
        Con_Printf`va(cstr("%s "), (Cmd_Argv(i),))
        i++
    }
    Con_Printf`va(cstr("\n"), VaNone())
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def CopyString(var _c_in : uint8?) : uint8? {
    var out : uint8?
    out = reinterpret<uint8?>(Z_Malloc(int(crt::strlen(_c_in) + 1ul)))
    crt::strcpy(out, _c_in)
    return out
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cmd_Alias_f {
    var a : cmdalias_s?
    var cmd : uint8[1024]
    var c : int
    var s : uint8?
    if (Cmd_Argc() == 1) {
        Con_Printf`va(cstr("Current alias commands:\n"), VaNone())
        a = cmd_alias
        while (a != null) {
            Con_Printf`va(cstr("%s : %s\n"), (addr(a.name[0]), a.value))
            a = a.next
        }
        return
    }
    s = Cmd_Argv(1)
    if (crt::strlen(s) >= uint64(MAX_ALIAS_NAME)) {
        Con_Printf`va(cstr("Alias name is too long\n"), VaNone())
        return
    }
    // if the alias allready exists, reuse it
    a = cmd_alias
    while (a != null) {
        if (crt::strcmp(s, addr(a.name[0])) == 0) {
            Z_Free(reinterpret<void?>(a.value))
            break
        }
        a = a.next
    }
    if (a == null) {
        a = reinterpret<cmdalias_s?>(Z_Malloc(typeinfo sizeof(type<cmdalias_s>)))
        a.next = cmd_alias
        cmd_alias = a
    }
    crt::strcpy(addr(a.name[0]), s)
    // copy the rest of the command line
    // start out with a null string
    cmd[0] = 0u8
    c = Cmd_Argc()
    for (i in range(2, c)) {
        crt::strcat(addr(cmd[0]), Cmd_Argv(i))
        if (i != c) {
            crt::strcat(addr(cmd[0]), cstr(" "))
        }
    }
    crt::strcat(addr(cmd[0]), cstr("\n"))
    a.value = CopyString(addr(cmd[0]))
}

// ============
// Cmd_Init
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_Init {
    // register our commands
    Cmd_AddCommand(cstr("stuffcmds"), @@Cmd_StuffCmds_f)
    Cmd_AddCommand(cstr("exec"), @@Cmd_Exec_f)
    Cmd_AddCommand(cstr("echo"), @@Cmd_Echo_f)
    Cmd_AddCommand(cstr("alias"), @@Cmd_Alias_f)
    Cmd_AddCommand(cstr("cmd"), @@Cmd_ForwardToServer)
    Cmd_AddCommand(cstr("wait"), @@Cmd_Wait_f)
}

// ============
// Cmd_Argc
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_Argc : int {
    return cmd_argc
}

// ============
// Cmd_Argv
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_Argv(arg : int) : uint8? {
    if (uint(arg) >= uint(cmd_argc)) {
        return cmd_null_string
    }
    return cmd_argv[arg]
}

// ============
// Cmd_Args
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_Args : uint8? {
    return cmd_args
}

// ============
// Cmd_TokenizeString
// Parses the given string into command line tokens.
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cmd_TokenizeString(var text : uint8?) {
    // clear the args from the last string
    for (i in range(cmd_argc)) {
        Z_Free(reinterpret<void?>(cmd_argv[i]))
    }
    cmd_argc = 0
    cmd_args = null
    while (1 != 0) {
        // skip whitespace up to a /n
        while (*text != 0 && int(*text) <= ' ' && *text != '\n') {
            text++
        }
        if (*text == '\n') {
            // a newline seperates commands in the buffer
            text++
            break
        }
        if (*text == 0) {
            return
        }
        if (cmd_argc == 1) {
            cmd_args = text
        }
        text = COM_Parse(text)
        if (text == null) {
            return
        }
        if (cmd_argc < MAX_ARGS) {
            cmd_argv[cmd_argc] = reinterpret<uint8?>(Z_Malloc(Q_strlen(addr(com_token[0])) + 1))
            Q_strcpy(cmd_argv[cmd_argc], addr(com_token[0]))
            cmd_argc++
        }
    }
}

// ============
// Cmd_AddCommand
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cmd_AddCommand(var cmd_name : uint8?; _c_function : function<() : void>) {
    var cmd : cmd_function_s?
    // because hunk allocation would get stomped
    if (int(host_initialized) != 0) {
        Sys_Error`va(cstr("Cmd_AddCommand after host_initialized"), VaNone())
    }
    // fail if the command is a variable name
    if (Cvar_VariableString(cmd_name)[0] != 0) {
        Con_Printf`va(cstr("Cmd_AddCommand: %s already defined as a var\n"), (cmd_name,))
        return
    }
    // fail if the command already exists
    cmd = cmd_functions
    while (cmd != null) {
        if (Q_strcmp(cmd_name, cmd.name) == 0) {
            Con_Printf`va(cstr("Cmd_AddCommand: %s already defined\n"), (cmd_name,))
            return
        }
        cmd = cmd.next
    }
    cmd = reinterpret<cmd_function_s?>(Hunk_Alloc(typeinfo sizeof(type<cmd_function_s>)))
    cmd.name = cmd_name
    cmd._c_function = _c_function
    cmd.next = cmd_functions
    cmd_functions = cmd
}

// ============
// Cmd_Exists
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_Exists(var cmd_name : uint8?) : qboolean {
    var cmd : cmd_function_s?
    cmd = cmd_functions
    while (cmd != null) {
        if (Q_strcmp(cmd_name, cmd.name) == 0) {
            return qboolean._c_true
        }
        cmd = cmd.next
    }
    return qboolean._c_false
}

// ============
// Cmd_CompleteCommand
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cmd_CompleteCommand(var partial : uint8?) : uint8? {
    var cmd : cmd_function_s?
    var len : int
    len = Q_strlen(partial)
    if (len == 0) {
        return null
    }
    // check functions
    cmd = cmd_functions
    while (cmd != null) {
        if (Q_strncmp(partial, cmd.name, len) == 0) {
            return cmd.name
        }
        cmd = cmd.next
    }
    return null
}

// ============
// Cmd_ExecuteString
// A complete command line has been parsed, so try to execute it
// FIXME: lookupnoadd the token to speed search?
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cmd_ExecuteString(var text : uint8?; src : cmd_source_t) {
    var cmd : cmd_function_s?
    var a : cmdalias_s?
    cmd_source = src
    Cmd_TokenizeString(text)
    // execute the command line
    if (Cmd_Argc() == 0) {
        // no tokens
        return
    }
    // check functions
    cmd = cmd_functions
    while (cmd != null) {
        if (Q_strcasecmp(cmd_argv[0], cmd.name) == 0) {
            invoke(cmd._c_function)
            return
        }
        cmd = cmd.next
    }
    // check alias
    a = cmd_alias
    while (a != null) {
        if (Q_strcasecmp(cmd_argv[0], addr(a.name[0])) == 0) {
            Cbuf_InsertText(a.value)
            return
        }
        a = a.next
    }
    // check cvars
    if (int(Cvar_Command()) == 0) {
        Con_Printf`va(cstr("Unknown command \"%s\"\n"), (Cmd_Argv(0),))
    }
}

// ===================
// Cmd_ForwardToServer
// Sends the entire command line over to the server
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cmd_ForwardToServer {
    if (cls.state != cactive_t.ca_connected) {
        Con_Printf`va(cstr("Can't \"%s\", not connected\n"), (Cmd_Argv(0),))
        return
    }
    if (int(cls.demoplayback) != 0) {
        // not really connected
        return
    }
    MSG_WriteByte(addr(cls.message), clc_stringcmd)
    if (Q_strcasecmp(Cmd_Argv(0), cstr("cmd")) != 0) {
        SZ_Print(addr(cls.message), Cmd_Argv(0))
        SZ_Print(addr(cls.message), cstr(" "))
    }
    if (Cmd_Argc() > 1) {
        SZ_Print(addr(cls.message), Cmd_Args())
    } else {
        SZ_Print(addr(cls.message), cstr("\n"))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def Cmd_CheckParm(var parm : uint8?) : int {
    var i : int
    if (parm == null) {
        Sys_Error`va(cstr("Cmd_CheckParm: NULL"), VaNone())
    }
    i = 1
    while (i < Cmd_Argc()) {
        if (Q_strcasecmp(parm, Cmd_Argv(i)) == 0) {
            return i
        }
        i++
    }
    return 0
}

