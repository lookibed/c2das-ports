// =============
// SV_movestep
// Called by monster program code.
// The move will be adjusted for slopes and stairs, but if the move isn't
// possible, no move is done, false is returned, and
// pr_global_struct->trace_normal is set to the normal of the blocking wall
// =============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_movestep(var ent : edict_s?; var move : float?; relink : qboolean) : qboolean {
    var dz : float
    var oldorg : float[3]
    var neworg : float[3]
    var end : float[3]
    var trace : trace_t
    var enemy : edict_s?
    // try the move
    oldorg[0] = ent.v.origin[0]
    oldorg[1] = ent.v.origin[1]
    oldorg[2] = ent.v.origin[2]
    neworg[0] = ent.v.origin[0] + move[0]
    neworg[1] = ent.v.origin[1] + move[1]
    neworg[2] = ent.v.origin[2] + move[2]
    // flying monsters don't step up
    if ((int(ent.v.flags) & (FL_SWIM | FL_FLY)) != 0) {
        // try one move with vertical motion, then one without
        for (i in range(2)) {
            neworg[0] = ent.v.origin[0] + move[0]
            neworg[1] = ent.v.origin[1] + move[1]
            neworg[2] = ent.v.origin[2] + move[2]
            enemy = PROG_TO_EDICT(ent.v.enemy)
            if (i == 0 && intptr(enemy) != intptr(sv.edicts)) {
                dz = ent.v.origin[2] - PROG_TO_EDICT(ent.v.enemy).v.origin[2]
                if (dz > 40.0f) {
                    neworg[2] -= 8.0f
                }
                if (dz < 30.0f) {
                    neworg[2] += 8.0f
                }
            }
            trace = SV_Move(addr(ent.v.origin[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(neworg[0]), int(qboolean._c_false), ent)
            if (trace.fraction == 1.0f) {
                if ((int(ent.v.flags) & FL_SWIM) != 0 && SV_PointContents(addr(trace.endpos[0])) == CONTENTS_EMPTY) {
                    // swim monster left water
                    return qboolean._c_false
                }
                ent.v.origin[0] = trace.endpos[0]
                ent.v.origin[1] = trace.endpos[1]
                ent.v.origin[2] = trace.endpos[2]
                if (int(relink) != 0) {
                    SV_LinkEdict(ent, qboolean._c_true)
                }
                return qboolean._c_true
            }
            if (intptr(enemy) == intptr(sv.edicts)) {
                break
            }
        }
        return qboolean._c_false
    }
    // push down from a step height above the wished position
    neworg[2] += float(STEPSIZE)
    VectorCopy(neworg, end)
    end[2] -= float(STEPSIZE * 2)
    trace = SV_Move(addr(neworg[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(end[0]), int(qboolean._c_false), ent)
    if (int(trace.allsolid) != 0) {
        return qboolean._c_false
    }
    if (int(trace.startsolid) != 0) {
        neworg[2] -= float(STEPSIZE)
        trace = SV_Move(addr(neworg[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(end[0]), int(qboolean._c_false), ent)
        if (uint(trace.allsolid) != 0 || uint(trace.startsolid) != 0) {
            return qboolean._c_false
        }
    }
    if (trace.fraction == 1.0f) {
        // if monster had the ground pulled out, go ahead and fall
        if ((int(ent.v.flags) & FL_PARTIALGROUND) != 0) {
            ent.v.origin[0] += move[0]
            ent.v.origin[1] += move[1]
            ent.v.origin[2] += move[2]
            if (int(relink) != 0) {
                SV_LinkEdict(ent, qboolean._c_true)
            }
            ent.v.flags = float(int(ent.v.flags) & ~FL_ONGROUND)
            // Con_Printf ("fall down\n");
            return qboolean._c_true
        }
        // walked off an edge
        return qboolean._c_false
    }
    // check point traces down for dangling corners
    ent.v.origin[0] = trace.endpos[0]
    ent.v.origin[1] = trace.endpos[1]
    ent.v.origin[2] = trace.endpos[2]
    if (int(SV_CheckBottom(ent)) == 0) {
        if ((int(ent.v.flags) & FL_PARTIALGROUND) != 0) {
            // entity had floor mostly pulled out from underneath it
            // and is trying to correct
            if (int(relink) != 0) {
                SV_LinkEdict(ent, qboolean._c_true)
            }
            return qboolean._c_true
        }
        ent.v.origin[0] = oldorg[0]
        ent.v.origin[1] = oldorg[1]
        ent.v.origin[2] = oldorg[2]
        return qboolean._c_false
    }
    if ((int(ent.v.flags) & FL_PARTIALGROUND) != 0) {
        // Con_Printf ("back on ground\n");
        ent.v.flags = float(int(ent.v.flags) & ~FL_PARTIALGROUND)
    }
    ent.v.groundentity = int(EDICT_TO_PROG(trace.ent))
    // the move is ok
    if (int(relink) != 0) {
        SV_LinkEdict(ent, qboolean._c_true)
    }
    return qboolean._c_true
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_StepDirection(var ent : edict_s?; var yaw : float; dist : float) : qboolean {
    var move : float[3]
    var oldorigin : float[3]
    var delta : float
    ent.v.ideal_yaw = yaw
    PF_changeyaw()
    yaw = float(double(yaw) * 3.141592653589793lf * 2.0lf / 360.0lf)
    move[0] = float(math::cos(double(yaw)) * double(dist))
    move[1] = float(math::sin(double(yaw)) * double(dist))
    move[2] = 0.0f
    oldorigin[0] = ent.v.origin[0]
    oldorigin[1] = ent.v.origin[1]
    oldorigin[2] = ent.v.origin[2]
    if (int(SV_movestep(ent, addr(move[0]), qboolean._c_false)) != 0) {
        delta = ent.v.angles[YAW] - ent.v.ideal_yaw
        if (delta > 45.0f && delta < 315.0f) {
            // not turned far enough, so don't take the step
            ent.v.origin[0] = oldorigin[0]
            ent.v.origin[1] = oldorigin[1]
            ent.v.origin[2] = oldorigin[2]
        }
        SV_LinkEdict(ent, qboolean._c_true)
        return qboolean._c_true
    }
    SV_LinkEdict(ent, qboolean._c_true)
    return qboolean._c_false
}

// ======================
// SV_FixCheckBottom
// ======================
[unsafe_deref, hint(unsafe_range_check)]
def SV_FixCheckBottom(var ent : edict_s?) {
    // Con_Printf ("SV_FixCheckBottom\n");
    ent.v.flags = float(int(ent.v.flags) | FL_PARTIALGROUND)
}

// ================
// SV_NewChaseDir
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_NewChaseDir(var actor : edict_s?; var enemy : edict_s?; dist : float) {
    var deltax : float
    var deltay : float
    var d : float[3]
    var tdir : float
    var olddir : float
    var turnaround : float
    olddir = anglemod(float(int(actor.v.ideal_yaw / 45.0f) * 45))
    turnaround = anglemod(olddir - 180.0f)
    deltax = enemy.v.origin[0] - actor.v.origin[0]
    deltay = enemy.v.origin[1] - actor.v.origin[1]
    if (deltax > 10.0f) {
        d[1] = 0.0f
    } elif (deltax < -10.0f) {
        d[1] = 180.0f
    } else {
        d[1] = float(DI_NODIR)
    }
    if (deltay < -10.0f) {
        d[2] = 270.0f
    } elif (deltay > 10.0f) {
        d[2] = 90.0f
    } else {
        d[2] = float(DI_NODIR)
    }
    // try direct route
    if (d[1] != float(DI_NODIR) && d[2] != float(DI_NODIR)) {
        if (d[1] == 0.0f) {
            tdir = float(d[2] == 90.0f ? 45 : 315)
        } else {
            tdir = float(d[2] == 90.0f ? 135 : 215)
        }
        if (tdir != turnaround && uint(SV_StepDirection(actor, tdir, dist)) != 0) {
            return
        }
    }
    // try other directions
    if (((crt::rand() & 3) & 1) != 0 || crt::abs(int(deltay)) > crt::abs(int(deltax))) {
        tdir = d[1]
        d[1] = d[2]
        d[2] = tdir
    }
    if (d[1] != float(DI_NODIR) && d[1] != turnaround && uint(SV_StepDirection(actor, d[1], dist)) != 0) {
        return
    }
    if (d[2] != float(DI_NODIR) && d[2] != turnaround && uint(SV_StepDirection(actor, d[2], dist)) != 0) {
        return
    }
    // there is no direct path to the player, so pick another direction
    if (olddir != float(DI_NODIR) && uint(SV_StepDirection(actor, olddir, dist)) != 0) {
        return
    }
    // randomly determine direction of search
    if ((crt::rand() & 1) != 0) {
        tdir = 0.0f
        while (tdir <= 315.0f) {
            if (tdir != turnaround && uint(SV_StepDirection(actor, tdir, dist)) != 0) {
                return
            }
            tdir += 45.0f
        }
    } else {
        tdir = 315.0f
        while (tdir >= 0.0f) {
            if (tdir != turnaround && uint(SV_StepDirection(actor, tdir, dist)) != 0) {
                return
            }
            tdir -= 45.0f
        }
    }
    if (turnaround != float(DI_NODIR) && uint(SV_StepDirection(actor, turnaround, dist)) != 0) {
        return
    }
    // can't move
    actor.v.ideal_yaw = olddir
    // if a bridge was pulled out from underneath a monster, it may not have
    // a valid standing position at all
    if (int(SV_CheckBottom(actor)) == 0) {
        SV_FixCheckBottom(actor)
    }
}

// ======================
// SV_CloseEnough
// ======================
[unsafe_deref, hint(unsafe_range_check)]
def SV_CloseEnough(var ent : edict_s?; var goal : edict_s?; dist : float) : qboolean {
    for (i in range(3)) {
        if (goal.v.absmin[i] > ent.v.absmax[i] + dist) {
            return qboolean._c_false
        }
        if (goal.v.absmax[i] < ent.v.absmin[i] - dist) {
            return qboolean._c_false
        }
    }
    return qboolean._c_true
}

// ======================
// SV_MoveToGoal
// ======================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_MoveToGoal {
    var ent : edict_s?
    var goal : edict_s?
    var dist : float
    ent = PROG_TO_EDICT(pr_global_struct.self)
    goal = PROG_TO_EDICT(ent.v.goalentity)
    dist = pr_globals[OFS_PARM0]
    if ((int(ent.v.flags) & (FL_ONGROUND | FL_FLY | FL_SWIM)) == 0) {
        pr_globals[OFS_RETURN] = 0.0f
        return
    }
    // if the next step hits the enemy, return immediately
    if (intptr(PROG_TO_EDICT(ent.v.enemy)) != intptr(sv.edicts) && uint(SV_CloseEnough(ent, goal, dist)) != 0) {
        return
    }
    // bump around...
    if ((crt::rand() & 3) == 1 || int(SV_StepDirection(ent, ent.v.ideal_yaw, dist)) == 0) {
        SV_NewChaseDir(ent, goal, dist)
    }
}

