// ==============
// SCR_CenterPrint
// Called for important messages that should stay in the center of the screen
// for a few moments
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SCR_CenterPrint(var str : uint8?) {
    crt::strncpy(addr(scr_centerstring[0]), str, uint64(typeinfo sizeof(type<uint8[1024]>)) - 1ul)
    scr_centertime_off = scr_centertime.value
    scr_centertime_start = float(cl.time)
    // count the number of lines for centering
    scr_center_lines = 1
    while (*str != 0) {
        if (*str == '\n') {
            scr_center_lines++
        }
        str++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def SCR_EraseCenterString {
    var y : int
    let _t0 = scr_erase_center
    scr_erase_center++
    if (_t0 > vid.numpages) {
        scr_erase_lines = 0
        return
    }
    if (scr_center_lines <= 4) {
        y = int(double(vid.height) * 0.35lf)
    } else {
        y = 48
    }
    scr_copytop = 1
    Draw_TileClear(0, y, int(vid.width), 8 * scr_erase_lines)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SCR_DrawCenterString {
    var start : uint8?
    var l : int
    var j : int
    var x : int
    var y : int
    var remaining : int
    // the finale prints the characters one at a time
    if (cl.intermission != 0) {
        remaining = int(double(scr_printspeed.value) * (cl.time - double(scr_centertime_start)))
    } else {
        remaining = 9999
    }
    scr_erase_center = 0
    start = addr(scr_centerstring[0])
    if (scr_center_lines <= 4) {
        y = int(double(vid.height) * 0.35lf)
    } else {
        y = 48
    }
    c_do_while(1 != 0) {
        // scan the width of the line
        l = 0
        while (l < 40) {
            if (start[l] == '\n' || start[l] == 0) {
                break
            }
            l++
        }
        x = int((vid.width - uint(l * 8)) / 2u)
        j = 0
        while (j < l) {
            Draw_Character(x, y, int(start[j]))
            let _t0 = remaining
            remaining--
            if (_t0 == 0) {
                return
            }
            j++
            x += 8
        }
        y += 8
        while (*start != 0 && *start != '\n') {
            start++
        }
        if (*start == 0) {
            break
        }
        // skip the \n
        start++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def SCR_CheckDrawCenterString {
    scr_copytop = 1
    if (scr_center_lines > scr_erase_lines) {
        scr_erase_lines = scr_center_lines
    }
    scr_centertime_off = float(double(scr_centertime_off) - host_frametime)
    if (scr_centertime_off <= 0.0f && cl.intermission == 0) {
        return
    }
    if (key_dest != keydest_t.key_game) {
        return
    }
    SCR_DrawCenterString()
}

// ====================
// CalcFov
// ====================
[unsafe_deref, hint(unsafe_range_check)]
def CalcFov(fov_x : float; width : float; height : float) : float {
    var a : float
    var x : float
    if (fov_x < 1.0f || fov_x > 179.0f) {
        Sys_Error`va(cstr("Bad fov: %f"), (double(fov_x),))
    }
    x = float(double(width) / math::tan(double(fov_x / 360.0f) * 3.141592653589793lf))
    a = float(math::atan(double(height / x)))
    a = float(double(a * 360.0f) / 3.141592653589793lf)
    return a
}

// =================
// SCR_CalcRefdef
// Must be called whenever vid changes
// Internal use only
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private SCR_CalcRefdef {
    var vrect : vrect_s
    var size : float
    // force a background redraw
    scr_fullupdate = 0
    vid.recalc_refdef = 0
    // force the status bar to redraw
    Sbar_Changed()
    // ========================================
    // bound viewsize
    if (scr_viewsize.value < 30.0f) {
        Cvar_Set(cstr("viewsize"), cstr("30"))
    }
    if (scr_viewsize.value > 120.0f) {
        Cvar_Set(cstr("viewsize"), cstr("120"))
    }
    // bound field of view
    if (scr_fov.value < 10.0f) {
        Cvar_Set(cstr("fov"), cstr("10"))
    }
    if (scr_fov.value > 170.0f) {
        Cvar_Set(cstr("fov"), cstr("170"))
    }
    r_refdef.fov_x = scr_fov.value
    r_refdef.fov_y = CalcFov(r_refdef.fov_x, float(r_refdef.vrect.width), float(r_refdef.vrect.height))
    // intermission is always full screen
    if (cl.intermission != 0) {
        size = 120.0f
    } else {
        size = scr_viewsize.value
    }
    if (size >= 120.0f) {
        // no status bar at all
        sb_lines = 0
    } elif (size >= 110.0f) {
        // no inventory
        sb_lines = 24
    } else {
        sb_lines = 24 + 16 + 8
    }
    // these calculations mirror those in R_Init() for r_refdef, but take no
    // account of water warping
    vrect.x = 0
    vrect.y = 0
    vrect.width = int(vid.width)
    vrect.height = int(vid.height)
    R_SetVrect(addr(vrect), addr(scr_vrect), sb_lines)
    // guard against going from one mode to another that's less than half the
    // vertical resolution
    if (scr_con_current > float(vid.height)) {
        scr_con_current = float(vid.height)
    }
    // notify the refresh of the change
    R_ViewChanged(addr(vrect), sb_lines, vid.aspect)
}

