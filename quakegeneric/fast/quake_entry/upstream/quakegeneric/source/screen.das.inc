// ==================
// SCR_SetUpToDrawConsole
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def SCR_SetUpToDrawConsole {
    Con_CheckResize()
    if (int(scr_drawloading) != 0) {
        // never a console with loading plaque
        return
    }
    // decide on the height of the console
    con_forcedup = enum_from_int(type<qboolean>, int_of(cl.worldmodel == null || cls.signon != SIGNONS))
    if (int(con_forcedup) != 0) {
        // full screen
        scr_conlines = float(vid.height)
        scr_con_current = scr_conlines
    } elif (key_dest == keydest_t.key_console) {
        // half screen
        scr_conlines = float(vid.height / 2u)
    } else {
        // none visible
        scr_conlines = 0.0f
    }
    if (scr_conlines < scr_con_current) {
        scr_con_current = float(double(scr_con_current) - double(scr_conspeed.value) * host_frametime)
        if (scr_conlines > scr_con_current) {
            scr_con_current = scr_conlines
        }
    } elif (scr_conlines > scr_con_current) {
        scr_con_current = float(double(scr_con_current) + double(scr_conspeed.value) * host_frametime)
        if (scr_conlines < scr_con_current) {
            scr_con_current = scr_conlines
        }
    }
    let _t0 = clearconsole
    clearconsole++
    if (_t0 < vid.numpages) {
        scr_copytop = 1
        Draw_TileClear(0, int(scr_con_current), int(vid.width), int(vid.height - uint(int(scr_con_current))))
        Sbar_Changed()
    } else {
        let _t2 = clearnotify
        clearnotify++
        if (_t2 < vid.numpages) {
            scr_copytop = 1
            Draw_TileClear(0, 0, int(vid.width), con_notifylines)
        } else {
            con_notifylines = 0
        }
    }
}

// ==================
// SCR_DrawConsole
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def SCR_DrawConsole {
    if (scr_con_current != 0.0f) {
        scr_copyeverything = 1
        Con_DrawConsole(int(scr_con_current), qboolean._c_true)
        clearconsole = 0
    } else {
        if (key_dest == keydest_t.key_game || key_dest == keydest_t.key_message) {
            // only draw notify in game
            Con_DrawNotify()
        }
    }
}

// ==============
// WritePCXfile
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def WritePCXfile(var filename : uint8?; var data : uint8?; width : int; height : int; rowbytes : int; var palette : uint8?) {
    var length : int
    var pcx : pcx_t?
    var pack : uint8?
    pcx = reinterpret<pcx_t?>(Hunk_TempAlloc(width * height * 2 + 1000))
    if (pcx == null) {
        Con_Printf`va(cstr("SCR_ScreenShot_f: not enough memory\n"), VaNone())
        return
    }
    // PCX id
    pcx.manufacturer = 10u8
    // 256 color
    pcx.version = 5u8
    // uncompressed
    pcx.encoding = 1u8
    // 256 color
    pcx.bits_per_pixel = 8u8
    pcx.xmin = uint16(0)
    pcx.ymin = uint16(0)
    pcx.xmax = uint16(invoke(LittleShort, int16(width - 1)))
    pcx.ymax = uint16(invoke(LittleShort, int16(height - 1)))
    pcx.hres = uint16(invoke(LittleShort, int16(width)))
    pcx.vres = uint16(invoke(LittleShort, int16(height)))
    Q_memset(reinterpret<void?>(addr(pcx.palette[0])), 0, typeinfo sizeof(type<uint8[48]>))
    // chunky image
    pcx.color_planes = 1u8
    pcx.bytes_per_line = uint16(invoke(LittleShort, int16(width)))
    // not a grey scale
    pcx.palette_type = uint16(invoke(LittleShort, int16(2)))
    Q_memset(reinterpret<void?>(addr(pcx.filler[0])), 0, typeinfo sizeof(type<uint8[58]>))
    // pack the image
    pack = addr(pcx.data)
    for (i in range(height)) {
        for (j in range(width)) {
            if ((int(*data) & 192) != 192) {
                var _t0 = pack
                pack++
                var _t1 = data
                data++
                *_t0 = *_t1
            } else {
                var _t2 = pack
                pack++
                *_t2 = 193u8
                var _t3 = pack
                pack++
                var _t4 = data
                data++
                *_t3 = *_t4
            }
        }
        data += rowbytes - width
    }
    // write the palette
    // palette ID byte
    var _t5 = pack
    pack++
    *_t5 = 12u8
    for (i in range(768)) {
        var _t6 = pack
        pack++
        var _t7 = palette
        palette++
        *_t6 = *_t7
    }
    // write output file
    length = int(int64(pack - reinterpret<uint8?>(pcx)))
    COM_WriteFile(filename, reinterpret<void?>(pcx), length)
}

// ==================
// SCR_ScreenShot_f
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SCR_ScreenShot_f {
    var i : int
    var pcxname : uint8[80]
    var checkname : uint8[128]
    // find a file name to save it to
    crt::strcpy(addr(pcxname[0]), cstr("quake00.pcx"))
    i = 0
    while (i <= 99) {
        pcxname[5] = uint8(i / 10 + '0')
        pcxname[6] = uint8(i % 10 + '0')
        sprintf(addr(checkname[0]), cstr("%s/%s"), addr(com_gamedir[0]), addr(pcxname[0]))
        if (Sys_FileTime(addr(checkname[0])) == -1) {
            // file doesn't exist
            break
        }
        i++
    }
    if (i == 100) {
        Con_Printf`va(cstr("SCR_ScreenShot_f: Couldn't create a PCX file\n"), VaNone())
        return
    }
    // save the pcx file
    // enable direct drawing of console to back
    D_EnableBackBufferAccess()
    // buffer
    WritePCXfile(addr(pcxname[0]), vid.buffer, int(vid.width), int(vid.height), int(vid.rowbytes), host_basepal)
    // for adapters that can't stay mapped in
    D_DisableBackBufferAccess()
    // for linear writes all the time
    Con_Printf`va(cstr("Wrote %s\n"), (addr(pcxname[0]),))
}

// ===============
// SCR_BeginLoadingPlaque
// ================
[unsafe_deref, hint(unsafe_range_check)]
def SCR_BeginLoadingPlaque {
    S_StopAllSounds(qboolean._c_true)
    if (cls.state != cactive_t.ca_connected) {
        return
    }
    if (cls.signon != SIGNONS) {
        return
    }
    // redraw with no console and the loading plaque
    Con_ClearNotify()
    scr_centertime_off = 0.0f
    scr_con_current = 0.0f
    scr_drawloading = qboolean._c_true
    scr_fullupdate = 0
    Sbar_Changed()
    SCR_UpdateScreen()
    scr_drawloading = qboolean._c_false
    scr_disabled_for_loading = qboolean._c_true
    scr_disabled_time = float(realtime)
    scr_fullupdate = 0
}

