        while (l < 40) {
            if (start[l] == '\n' || start[l] == 0) {
                break
            }
            l++
        }
        x = int((vid.width - uint(l * 8)) / 2u)
        j = 0
        while (j < l) {
            Draw_Character(x, y, int(start[j]))
            j++
            x += 8
        }
        y += 8
        while (*start != 0 && *start != '\n') {
            start++
        }
        if (*start == 0) {
            break
        }
        // skip the \n
        start++
    }
}

// ==================
// SCR_ModalMessage
// Displays a text string in the center of the screen and waits for a Y or N
// keypress.
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def SCR_ModalMessage(var text : uint8?) : int {
    if (cls.state == cactive_t.ca_dedicated) {
        return int(qboolean._c_true)
    }
    scr_notifystring = text
    // draw a fresh screen
    scr_fullupdate = 0
    scr_drawdialog = qboolean._c_true
    SCR_UpdateScreen()
    scr_drawdialog = qboolean._c_false
    // so dma doesn't loop current sound
    S_ClearBuffer()
    c_do_while(key_lastpress != 'y' && key_lastpress != 'n' && key_lastpress != K_ESCAPE) {
        // wait for a key down and up
        key_count = -1
        Sys_SendKeyEvents()
    }
    scr_fullupdate = 0
    SCR_UpdateScreen()
    return int_of(key_lastpress == 'y')
}

// ===============
// SCR_BringDownConsole
// Brings the console down and fades the palettes back to normal
// ================
[unsafe_deref, hint(unsafe_range_check)]
def SCR_BringDownConsole {
    var i : int
    scr_centertime_off = 0.0f
    i = 0
    while (i < 20 && scr_conlines != scr_con_current) {
        SCR_UpdateScreen()
        i++
    }
    // no area contents palette on next frame
    cl.cshifts[0].percent = 0
    VID_SetPalette(host_basepal)
}

// ==================
// SCR_UpdateScreen
// This is called every frame, and can also be called explicitly to flush
// text to the screen.
// WARNING: be very careful calling this from elsewhere, because the refresh
// needs almost the entire 256k of stack space!
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SCR_UpdateScreen {
    var vrect : vrect_s
    if (uint(scr_skipupdate) != 0 || uint(block_drawing) != 0) {
        return
    }
    scr_copytop = 0
    scr_copyeverything = 0
    if (int(scr_disabled_for_loading) != 0) {
        if (realtime - double(scr_disabled_time) > 60.0lf) {
            scr_disabled_for_loading = qboolean._c_false
            Con_Printf`va(cstr("load failed.\n"), VaNone())
        } else {
            return
        }
    }
    if (cls.state == cactive_t.ca_dedicated) {
        // stdout only
        return
    }
    if (int(scr_initialized) == 0 || int(con_initialized) == 0) {
        // not initialized yet
        return
    }
    if (scr_viewsize.value != SCR_UpdateScreen_oldscr_viewsize) {
        SCR_UpdateScreen_oldscr_viewsize = scr_viewsize.value
        vid.recalc_refdef = 1
    }
    // check for vid changes
    if (oldfov != scr_fov.value) {
        oldfov = scr_fov.value
        vid.recalc_refdef = int(qboolean._c_true)
    }
    if (SCR_UpdateScreen_oldlcd_x != lcd_x.value) {
        SCR_UpdateScreen_oldlcd_x = lcd_x.value
        vid.recalc_refdef = int(qboolean._c_true)
    }
    if (oldscreensize != scr_viewsize.value) {
        oldscreensize = scr_viewsize.value
        vid.recalc_refdef = int(qboolean._c_true)
    }
    if (vid.recalc_refdef != 0) {
        // something changed, so reorder the screen
        SCR_CalcRefdef()
    }
    // do 3D refresh drawing, and then update the screen
    // of all overlay stuff if drawing directly
    D_EnableBackBufferAccess()
    let _t0 = scr_fullupdate
    scr_fullupdate++
    if (_t0 < vid.numpages) {
        // clear the entire screen
        scr_copyeverything = 1
        Draw_TileClear(0, 0, int(vid.width), int(vid.height))
        Sbar_Changed()
    }
    pconupdate = null
    SCR_SetUpToDrawConsole()
    SCR_EraseCenterString()
    // for adapters that can't stay mapped in
    D_DisableBackBufferAccess()
    // for linear writes all the time
    V_RenderView()
    // of all overlay stuff if drawing directly
    D_EnableBackBufferAccess()
    if (int(scr_drawdialog) != 0) {
        Sbar_Draw()
        Draw_FadeScreen()
        SCR_DrawNotifyString()
        scr_copyeverything = int(qboolean._c_true)
    } elif (int(scr_drawloading) != 0) {
        SCR_DrawLoading()
        Sbar_Draw()
    } elif (cl.intermission == 1 && key_dest == keydest_t.key_game) {
        Sbar_IntermissionOverlay()
    } elif (cl.intermission == 2 && key_dest == keydest_t.key_game) {
        Sbar_FinaleOverlay()
        SCR_CheckDrawCenterString()
    } elif (cl.intermission == 3 && key_dest == keydest_t.key_game) {
        SCR_CheckDrawCenterString()
    } else {
        SCR_DrawRam()
        SCR_DrawNet()
        SCR_DrawTurtle()
        SCR_DrawPause()
        SCR_CheckDrawCenterString()
        Sbar_Draw()
        SCR_DrawConsole()
        M_Draw()
    }
    // for adapters that can't stay mapped in
    D_DisableBackBufferAccess()
    // for linear writes all the time
    if (pconupdate != null) {
        D_UpdateRects(pconupdate)
    }
    V_UpdatePalette()
    // update one of three areas
    if (scr_copyeverything != 0) {
        vrect.x = 0
        vrect.y = 0
        vrect.width = int(vid.width)
        vrect.height = int(vid.height)
        vrect.pnext = null
        VID_Update(addr(vrect))
    } elif (scr_copytop != 0) {
        vrect.x = 0
        vrect.y = 0
        vrect.width = int(vid.width)
        vrect.height = int(vid.height - uint(sb_lines))
        vrect.pnext = null
        VID_Update(addr(vrect))
    } else {
        vrect.x = scr_vrect.x
        vrect.y = scr_vrect.y
        vrect.width = scr_vrect.width
        vrect.height = scr_vrect.height
        vrect.pnext = null
        VID_Update(addr(vrect))
    }
}

// ==================
// SCR_UpdateWholeScreen
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def SCR_UpdateWholeScreen {
    scr_fullupdate = 0
    SCR_UpdateScreen()
}

