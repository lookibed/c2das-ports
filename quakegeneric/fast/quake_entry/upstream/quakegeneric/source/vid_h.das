// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608

struct vrect_s {
    x, y, width, height : int
    pnext : vrect_s?
}

struct viddef_t {
    buffer, colormap : uint8?
    colormap16 : uint16?
    fullbright : int
    rowbytes, width, height : uint
    aspect : float
    numpages, recalc_refdef : int
    conbuffer : uint8?
    conrowbytes : int
    conwidth, conheight : uint
    maxwarpwidth, maxwarpheight : int
    direct : uint8?
}

include vid_h.layout.das.inc

