// generated by c2das - regenerate, never edit
var r_spritedesc : spritedesc_t
var private clip_current : int
var private clip_verts : float[2][20][5]
var private sprite_width : int
var private r_sprite_sprite_height : int

// ================
// R_RotateSprite
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_RotateSprite(beamlength : float) {
    var vec : float[3]
    if (double(beamlength) == 0.0lf) {
        return
    }
    VectorScale(addr(r_spritedesc.vpn[0]), -beamlength, addr(vec[0]))
    r_entorigin[0] += vec[0]
    r_entorigin[1] += vec[1]
    r_entorigin[2] += vec[2]
    modelorg[0] -= vec[0]
    modelorg[1] -= vec[1]
    modelorg[2] -= vec[2]
}

// =============
// R_ClipSpriteFace
// Clips the winding at clip_verts[clip_current] and changes clip_current
// Throws out the back side
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClipSpriteFace(nump : int; var pclipplane : clipplane_s?) : int {
    var i : int
    var outcount : int
    var dists : float[21]
    var frac : float
    var clipdist : float
    var pclipnormal : float?
    var _c_in : float?
    var instep : float?
    var outstep : float?
    var vert2 : float?
    clipdist = pclipplane.dist
    pclipnormal = addr(pclipplane.normal[0])
    // calc dists
    if (clip_current != 0) {
        _c_in = addr(clip_verts[1][0][0])
        outstep = addr(clip_verts[0][0][0])
        clip_current = 0
    } else {
        _c_in = addr(clip_verts[0][0][0])
        outstep = addr(clip_verts[1][0][0])
        clip_current = 1
    }
    instep = _c_in
    i = 0
    while (i < nump) {
        dists[i] = DotProduct(instep, pclipnormal) - clipdist
        i++
        instep += uint64(typeinfo sizeof(type<float[5]>)) / uint64(typeinfo sizeof(type<float>))
    }
    // handle wraparound case
    dists[nump] = dists[0]
    Q_memcpy(reinterpret<void?>(instep), reinterpret<void?>(_c_in), typeinfo sizeof(type<float[5]>))
    // clip the winding
    instep = _c_in
    outcount = 0
    i = 0
    while (i < nump) {
        {
            if (dists[i] >= 0.0f) {
                Q_memcpy(reinterpret<void?>(outstep), reinterpret<void?>(instep), typeinfo sizeof(type<float[5]>))
                outstep += uint64(typeinfo sizeof(type<float[5]>)) / uint64(typeinfo sizeof(type<float>))
                outcount++
            }
            if (dists[i] == 0.0f || dists[i + 1] == 0.0f) {
                continue
            }
            if (int_of(dists[i] > 0.0f) == int_of(dists[i + 1] > 0.0f)) {
                continue
            }
            // split it into a new vertex
            frac = dists[i] / (dists[i] - dists[i + 1])
            vert2 = instep + uint64(typeinfo sizeof(type<float[5]>)) / uint64(typeinfo sizeof(type<float>))
            outstep[0] = instep[0] + frac * (vert2[0] - instep[0])
            outstep[1] = instep[1] + frac * (vert2[1] - instep[1])
            outstep[2] = instep[2] + frac * (vert2[2] - instep[2])
            outstep[3] = instep[3] + frac * (vert2[3] - instep[3])
            outstep[4] = instep[4] + frac * (vert2[4] - instep[4])
            outstep += uint64(typeinfo sizeof(type<float[5]>)) / uint64(typeinfo sizeof(type<float>))
            outcount++
        } finally {
            i++
            instep += uint64(typeinfo sizeof(type<float[5]>)) / uint64(typeinfo sizeof(type<float>))
        }
    }
    return outcount
}

// ================
// R_SetupAndDrawSprite
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_SetupAndDrawSprite {
    var nump : int
    var dot : float
    var scale : float
    var pv : float?
    var pverts : float[5]?
    var left : float[3]
    var up : float[3]
    var right : float[3]
    var down : float[3]
    var transformed : float[3]
    var local : float[3]
    var outverts : emitpoint_t[21]
    var pout : emitpoint_t?
    dot = r_spritedesc.vpn[0] * modelorg[0] + r_spritedesc.vpn[1] * modelorg[1] + r_spritedesc.vpn[2] * modelorg[2]
    // backface cull
    if (dot >= 0.0f) {
        return
    }
    // build the sprite poster in worldspace
    VectorScale(addr(r_spritedesc.vright[0]), r_spritedesc.pspriteframe.right, addr(right[0]))
    VectorScale(addr(r_spritedesc.vup[0]), r_spritedesc.pspriteframe.up, addr(up[0]))
    VectorScale(addr(r_spritedesc.vright[0]), r_spritedesc.pspriteframe.left, addr(left[0]))
    VectorScale(addr(r_spritedesc.vup[0]), r_spritedesc.pspriteframe.down, addr(down[0]))
    pverts = addr(clip_verts[0][0])
    pverts[0][0] = r_entorigin[0] + up[0] + left[0]
    pverts[0][1] = r_entorigin[1] + up[1] + left[1]
    pverts[0][2] = r_entorigin[2] + up[2] + left[2]
    pverts[0][3] = 0.0f
    pverts[0][4] = 0.0f
    pverts[1][0] = r_entorigin[0] + up[0] + right[0]
    pverts[1][1] = r_entorigin[1] + up[1] + right[1]
    pverts[1][2] = r_entorigin[2] + up[2] + right[2]
    pverts[1][3] = float(sprite_width)
    pverts[1][4] = 0.0f
    pverts[2][0] = r_entorigin[0] + down[0] + right[0]
    pverts[2][1] = r_entorigin[1] + down[1] + right[1]
    pverts[2][2] = r_entorigin[2] + down[2] + right[2]
    pverts[2][3] = float(sprite_width)
    pverts[2][4] = float(r_sprite_sprite_height)
    pverts[3][0] = r_entorigin[0] + down[0] + left[0]
    pverts[3][1] = r_entorigin[1] + down[1] + left[1]
    pverts[3][2] = r_entorigin[2] + down[2] + left[2]
    pverts[3][3] = 0.0f
    pverts[3][4] = float(r_sprite_sprite_height)
    // clip to the frustum in worldspace
    nump = 4
    clip_current = 0
    for (i in range(4)) {
        nump = R_ClipSpriteFace(nump, addr(view_clipplanes[0]) + end_index(i, 4))
        if (nump < 3) {
            return
        }
        if (nump >= MAXWORKINGVERTS) {
            Sys_Error`va(cstr("R_SetupAndDrawSprite: too many points"), VaNone())
        }
    }
    // transform vertices into viewspace and project
    pv = addr(clip_verts[clip_current][0][0])
    r_spritedesc.nearzi = -999999.0f
    for (i in range(nump)) {
        local[0] = pv[0] - r_origin[0]
        local[1] = pv[1] - r_origin[1]
        local[2] = pv[2] - r_origin[2]
        TransformVector(addr(local[0]), addr(transformed[0]))
        if (double(transformed[2]) < NEAR_CLIP) {
            transformed[2] = float(NEAR_CLIP)
        }
        pout = addr(outverts[0]) + end_index(i, 21)
        pout.zi = float(1.0lf / double(transformed[2]))
        if (pout.zi > r_spritedesc.nearzi) {
            r_spritedesc.nearzi = pout.zi
        }
        pout.s = pv[3]
        pout.t = pv[4]
        scale = xscale * pout.zi
        pout.u = xcenter + scale * transformed[0]
        scale = yscale * pout.zi
        pout.v = ycenter - scale * transformed[1]
        pv += uint64(typeinfo sizeof(type<float[5]>)) / uint64(typeinfo sizeof(type<float>))
    }
    // draw it
    r_spritedesc.nump = nump
    r_spritedesc.pverts = addr(outverts[0])
    D_DrawSprite()
}

// ================
// R_GetSpriteframe
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GetSpriteframe(var psprite : msprite_t?) : mspriteframe_s? {
    var pspritegroup : mspritegroup_t?
    var pspriteframe : mspriteframe_s?
    var i : int
    var numframes : int
    var frame : int
    var pintervals : float?
    var fullinterval : float
    var targettime : float
    var time : float
    frame = currententity.frame
    if ((frame >= psprite.numframes) || (frame < 0)) {
        Con_Printf`va(cstr("R_DrawSprite: no such frame %d\n"), (frame,))
        frame = 0
    }
    if (addr(psprite.frames[0])[frame]._c_type == spriteframetype_t.SPR_SINGLE) {
        pspriteframe = addr(psprite.frames[0])[frame].frameptr
    } else {
        pspritegroup = reinterpret<mspritegroup_t?>(addr(psprite.frames[0])[frame].frameptr)
        pintervals = pspritegroup.intervals
        numframes = pspritegroup.numframes
        fullinterval = pintervals[numframes - 1]
        time = float(cl.time + double(currententity.syncbase))
        // when loading in Mod_LoadSpriteGroup, we guaranteed all interval values
        // are positive, so we don't have to worry about division by 0
        targettime = time - float(int(time / fullinterval)) * fullinterval
        i = 0
        while (i < (numframes - 1)) {
            if (pintervals[i] > targettime) {
                break
            }
            i++
        }
        pspriteframe = addr(pspritegroup.frames[0])[i]
    }
    return pspriteframe
}

// ================
// R_DrawSprite
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawSprite {
    var psprite : msprite_t?
    var tvec : float[3]
    var dot : float
    var angle : float
    var sr : float
    var cr : float
    psprite = reinterpret<msprite_t?>(currententity.model.cache.data)
    r_spritedesc.pspriteframe = R_GetSpriteframe(psprite)
    sprite_width = r_spritedesc.pspriteframe.width
    r_sprite_sprite_height = r_spritedesc.pspriteframe.height
    // TODO: make this caller-selectable
    if (psprite._c_type == SPR_FACING_UPRIGHT) {
        // generate the sprite's axes, with vup straight up in worldspace, and
        // r_spritedesc.vright perpendicular to modelorg.
        // This will not work if the view direction is very close to straight up or
        // down, because the cross product will be between two nearly parallel
        // vectors and starts to approach an undefined state, so we don't draw if
        // the two vectors are less than 1 degree apart
        tvec[0] = -modelorg[0]
        tvec[1] = -modelorg[1]
        tvec[2] = -modelorg[2]
        VectorNormalize(addr(tvec[0]))
        // same as DotProduct (tvec, r_spritedesc.vup) because
        dot = tvec[2]
        // r_spritedesc.vup is 0, 0, 1
        // cos(1 degree) = 0.999848
        if ((double(dot) > 0.999848lf) || (double(dot) < -0.999848lf)) {
            return
        }
        r_spritedesc.vup[0] = 0.0f
        r_spritedesc.vup[1] = 0.0f
        r_spritedesc.vup[2] = 1.0f
        r_spritedesc.vright[0] = tvec[1]
        // CrossProduct(r_spritedesc.vup, -modelorg,
        r_spritedesc.vright[1] = -tvec[0]
        // r_spritedesc.vright)
        r_spritedesc.vright[2] = 0.0f
        VectorNormalize(addr(r_spritedesc.vright[0]))
        r_spritedesc.vpn[0] = -r_spritedesc.vright[1]
        r_spritedesc.vpn[1] = r_spritedesc.vright[0]
        r_spritedesc.vpn[2] = 0.0f
    } elif (psprite._c_type == SPR_VP_PARALLEL) {
        // CrossProduct (r_spritedesc.vright, r_spritedesc.vup,
        // r_spritedesc.vpn)
        // generate the sprite's axes, completely parallel to the viewplane. There
        // are no problem situations, because the sprite is always in the same
        // position relative to the viewer
        for (i in range(3)) {
            r_spritedesc.vup[i] = vup[i]
            r_spritedesc.vright[i] = vright[i]
            r_spritedesc.vpn[i] = vpn[i]
        }
    } elif (psprite._c_type == SPR_VP_PARALLEL_UPRIGHT) {
        // generate the sprite's axes, with vup straight up in worldspace, and
        // r_spritedesc.vright parallel to the viewplane.
        // This will not work if the view direction is very close to straight up or
        // down, because the cross product will be between two nearly parallel
        // vectors and starts to approach an undefined state, so we don't draw if
        // the two vectors are less than 1 degree apart
        // same as DotProduct (vpn, r_spritedesc.vup) because
        dot = vpn[2]
        // r_spritedesc.vup is 0, 0, 1
        // cos(1 degree) = 0.999848
        if ((double(dot) > 0.999848lf) || (double(dot) < -0.999848lf)) {
            return
        }
        r_spritedesc.vup[0] = 0.0f
        r_spritedesc.vup[1] = 0.0f
        r_spritedesc.vup[2] = 1.0f
        r_spritedesc.vright[0] = vpn[1]
        // CrossProduct (r_spritedesc.vup, vpn,
        // r_spritedesc.vright)
        r_spritedesc.vright[1] = -vpn[0]
        r_spritedesc.vright[2] = 0.0f
        VectorNormalize(addr(r_spritedesc.vright[0]))
        r_spritedesc.vpn[0] = -r_spritedesc.vright[1]
        r_spritedesc.vpn[1] = r_spritedesc.vright[0]
        r_spritedesc.vpn[2] = 0.0f
    } elif (psprite._c_type == SPR_ORIENTED) {
        // CrossProduct (r_spritedesc.vright, r_spritedesc.vup,
        // r_spritedesc.vpn)
        // generate the sprite's axes, according to the sprite's world orientation
        AngleVectors(addr(currententity.angles[0]), addr(r_spritedesc.vpn[0]), addr(r_spritedesc.vright[0]), addr(r_spritedesc.vup[0]))
    } elif (psprite._c_type == SPR_VP_PARALLEL_ORIENTED) {
        // generate the sprite's axes, parallel to the viewplane, but rotated in
        // that plane around the center according to the sprite entity's roll
        // angle. So vpn stays the same, but vright and vup rotate
        angle = float(double(currententity.angles[ROLL]) * (3.141592653589793lf * 2.0lf / 360.0lf))
        sr = float(math::sin(double(angle)))
        cr = float(math::cos(double(angle)))
        for (i in range(3)) {
            r_spritedesc.vpn[i] = vpn[i]
            r_spritedesc.vright[i] = vright[i] * cr + vup[i] * sr
            r_spritedesc.vup[i] = vright[i] * -sr + vup[i] * cr
        }
    } else {
        Sys_Error`va(cstr("R_DrawSprite: Bad sprite type %d"), (psprite._c_type,))
    }
    R_RotateSprite(psprite.beamlength)
    R_SetupAndDrawSprite()
}

