// ===============
// R_TextureAnimation
// Returns the proper texture for a given time and base texture
// ===============
[unsafe_deref, hint(unsafe_range_check)]
def R_TextureAnimation(var base : texture_s?) : texture_s? {
    var reletive : int
    var count : int
    if (currententity.frame != 0) {
        if (base.alternate_anims != null) {
            base = base.alternate_anims
        }
    }
    if (base.anim_total == 0) {
        return base
    }
    reletive = int(cl.time * 10.0lf) % base.anim_total
    count = 0
    while (base.anim_min > reletive || base.anim_max <= reletive) {
        base = base.anim_next
        if (base == null) {
            Sys_Error`va(cstr("R_TextureAnimation: broken cycle"), VaNone())
        }
        count++
        if (count > 100) {
            Sys_Error`va(cstr("R_TextureAnimation: infinite cycle"), VaNone())
        }
    }
    return base
}

