// ================
// R_GenTurbTile
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GenTurbTile(var pbasetex : uint8?; var pdest : void?) {
    var turb : int?
    var s : int
    var t : int
    var pd : uint8?
    turb = addr(sintable[0]) + (int(cl.time * double(SPEED)) & (CYCLE - 1))
    pd = reinterpret<uint8?>(pdest)
    for (i in range(TILE_SIZE)) {
        for (j in range(TILE_SIZE)) {
            s = (((j << 16) + turb[i & (CYCLE - 1)]) >> 16) & 63
            t = (((i << 16) + turb[j & (CYCLE - 1)]) >> 16) & 63
            var _t0 = pd
            pd++
            *_t0 = (pbasetex + (t << 6))[s]
        }
    }
}

// ================
// R_GenTile
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GenTile(var psurf : msurface_s?; var pdest : void?) {
    if ((psurf.flags & SURF_DRAWTURB) != 0) {
        R_GenTurbTile(reinterpret<uint8?>(psurf.texinfo.texture) + psurf.texinfo.texture.offsets[0], pdest)
    } elif ((psurf.flags & SURF_DRAWSKY) != 0) {
        R_GenSkyTile(pdest)
    } else {
        Sys_Error`va(cstr("Unknown tile type"), VaNone())
    }
}

