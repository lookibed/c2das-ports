    lightmap = surf.samples
    if (r_fullbright.value != 0.0f || cl.worldmodel.lightdata == null) {
        for (i in range(size)) {
            blocklights[i] = 0u
        }
        return
    }
    // clear to ambient
    for (i in range(size)) {
        blocklights[i] = uint(r_refdef.ambientlight << 8)
    }
    // add all the lightmaps
    if (lightmap != null) {
        maps = 0
        while (maps < MAXLIGHTMAPS && surf.styles[maps] != 255) {
            // 8.8 fraction
            scale = uint(r_drawsurf.lightadj[maps])
            for (i in range(size)) {
                blocklights[i] += uint(lightmap[i]) * scale
            }
            // skip to next lightmap
            lightmap += size
            maps++
        }
    }
    // add all the dynamic lights
    if (surf.dlightframe == r_framecount) {
        R_AddDynamicLights()
    }
    // bound, invert, and shift
    for (i in range(size)) {
        t = (255 * 256 - int(blocklights[i])) >> (8 - VID_CBITS)
        if (t < (1 << 6)) {
            t = 1 << 6
        }
        blocklights[i] = uint(t)
    }
