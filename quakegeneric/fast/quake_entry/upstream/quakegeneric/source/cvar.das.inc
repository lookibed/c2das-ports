// generated by c2das - regenerate, never edit
var cvar_vars : cvar_s?
var cvar_null_string : uint8? = unsafe(addr(c2das_empty[0]))

// ============
// Cvar_FindVar
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cvar_FindVar(var var_name : uint8?) : cvar_s? {
    var _c_var : cvar_s?
    _c_var = cvar_vars
    while (_c_var != null) {
        if (Q_strcmp(var_name, _c_var.name) == 0) {
            return _c_var
        }
        _c_var = _c_var.next
    }
    return null
}

// ============
// Cvar_VariableValue
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cvar_VariableValue(var var_name : uint8?) : float {
    var _c_var : cvar_s?
    _c_var = Cvar_FindVar(var_name)
    if (_c_var == null) {
        return 0.0f
    }
    return Q_atof(_c_var._c_string)
}

// ============
// Cvar_VariableString
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cvar_VariableString(var var_name : uint8?) : uint8? {
    var _c_var : cvar_s?
    _c_var = Cvar_FindVar(var_name)
    if (_c_var == null) {
        return cvar_null_string
    }
    return _c_var._c_string
}

// ============
// Cvar_CompleteVariable
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cvar_CompleteVariable(var partial : uint8?) : uint8? {
    var cvar : cvar_s?
    var len : int
    len = Q_strlen(partial)
    if (len == 0) {
        return null
    }
    // check functions
    cvar = cvar_vars
    while (cvar != null) {
        if (Q_strncmp(partial, cvar.name, len) == 0) {
            return cvar.name
        }
        cvar = cvar.next
    }
    return null
}

// ============
// Cvar_Set
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cvar_Set(var var_name : uint8?; var value : uint8?) {
    var _c_var : cvar_s?
    var changed : qboolean
    _c_var = Cvar_FindVar(var_name)
    if (_c_var == null) {
        // there is an error in C code if this happens
        Con_Printf`va(cstr("Cvar_Set: variable %s not found\n"), (var_name,))
        return
    }
    changed = enum_from_int(type<qboolean>, Q_strcmp(_c_var._c_string, value))
    // free the old value string
    Z_Free(reinterpret<void?>(_c_var._c_string))
    _c_var._c_string = reinterpret<uint8?>(Z_Malloc(Q_strlen(value) + 1))
    Q_strcpy(_c_var._c_string, value)
    _c_var.value = Q_atof(_c_var._c_string)
    if (uint(_c_var.server) != 0 && uint(changed) != 0) {
        if (int(sv.active) != 0) {
            SV_BroadcastPrintf`va(cstr("\"%s\" changed to \"%s\"\n"), (_c_var.name, _c_var._c_string))
        }
    }
}

// ============
// Cvar_SetValue
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cvar_SetValue(var var_name : uint8?; value : float) {
    var val : uint8[32]
    sprintf(addr(val[0]), cstr("%f"), double(value))
    Cvar_Set(var_name, addr(val[0]))
}

// ============
// Cvar_RegisterVariable
// Adds a freestanding variable to the variable list.
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cvar_RegisterVariable(var variable : cvar_s?) {
    var oldstr : uint8?
    // first check to see if it has allready been defined
    if (Cvar_FindVar(variable.name) != null) {
        Con_Printf`va(cstr("Can't register variable %s, allready defined\n"), (variable.name,))
        return
    }
    // check for overlap with a command
    if (int(Cmd_Exists(variable.name)) != 0) {
        Con_Printf`va(cstr("Cvar_RegisterVariable: %s is a command\n"), (variable.name,))
        return
    }
    // copy the value off, because future sets will Z_Free it
    oldstr = variable._c_string
    variable._c_string = reinterpret<uint8?>(Z_Malloc(Q_strlen(variable._c_string) + 1))
    Q_strcpy(variable._c_string, oldstr)
    variable.value = Q_atof(variable._c_string)
    // link the variable in
    variable.next = cvar_vars
    cvar_vars = variable
}

// ============
// Cvar_Command
// Handles variable inspection and changing from the console
// ============
[unsafe_deref, hint(unsafe_range_check)]
def Cvar_Command : qboolean {
    var v : cvar_s?
    // check variables
    v = Cvar_FindVar(Cmd_Argv(0))
    if (v == null) {
        return qboolean._c_false
    }
    // perform a variable print or set
    if (Cmd_Argc() == 1) {
        Con_Printf`va(cstr("\"%s\" is \"%s\"\n"), (v.name, v._c_string))
        return qboolean._c_true
    }
    Cvar_Set(v.name, Cmd_Argv(1))
    return qboolean._c_true
}

// ============
// Cvar_WriteVariables
// Writes lines containing "set variable value" for all variables
// with the archive flag set to true.
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Cvar_WriteVariables(var f : _IO_FILE?) {
    var _c_var : cvar_s?
    _c_var = cvar_vars
    while (_c_var != null) {
        if (int(_c_var.archive) != 0) {
            fprintf(reinterpret<void?>(f), cstr("%s \"%s\"\n"), _c_var.name, _c_var._c_string)
        }
        _c_var = _c_var.next
    }
}

