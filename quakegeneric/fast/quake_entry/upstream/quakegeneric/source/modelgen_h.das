// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608

enum synctype_t {
    ST_SYNC
    ST_RAND
}

enum aliasframetype_t {
    ALIAS_SINGLE
    ALIAS_GROUP
}

enum aliasskintype_t {
    ALIAS_SKIN_SINGLE
    ALIAS_SKIN_GROUP
}

struct mdl_t {
    ident, version : int
    scale, scale_origin : float[3]
    boundingradius : float
    eyeposition : float[3]
    numskins, skinwidth, skinheight, numverts, numtris, numframes : int
    synctype : synctype_t
    flags : int
    size : float
}

struct stvert_t {
    onseam, s, t : int
}

struct dtriangle_s {
    facesfront : int
    vertindex : int[3]
}

struct trivertx_t {
    v : uint8[3]
    lightnormalindex : uint8
}

struct daliasframe_t {
    bboxmin, bboxmax : trivertx_t
    name : uint8[16]
}

struct daliasgroup_t {
    numframes : int
    bboxmin, bboxmax : trivertx_t
}

struct daliasskingroup_t {
    numskins : int
}

struct daliasinterval_t {
    interval : float
}

struct daliasskininterval_t {
    interval : float
}

struct daliasframetype_t {
    _c_type : aliasframetype_t
}

struct daliasskintype_t {
    _c_type : aliasskintype_t
}

include modelgen_h.layout.das.inc

