// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require d_local_h_cluster

enum ptype_t {
    pt_static
    pt_grav
    pt_slowgrav
    pt_fire
    pt_explode
    pt_explode2
    pt_blob
    pt_blob2
}

struct emitpoint_t {
    u, v, s, t, zi : float
}

struct particle_s {
    org : float[3]
    color : float
    next : particle_s?
    vel : float[3]
    ramp, die : float
    _c_type : ptype_t
}

struct polyvert_s {
    u, v, zi, s, t : float
}

struct polydesc_s {
    numverts : int
    nearzi : float
    pcurrentface : msurface_s?
    pverts : polyvert_s?
}

struct finalvert_s {
    v : int[6]
    flags : int
    reserved : float
}

struct affinetridesc_t {
    pskin : void?
    pskindesc : maliasskindesc_t?
    skinwidth, skinheight : int
    ptriangles : mtriangle_s?
    pfinalverts : finalvert_s?
    numtriangles, drawtype, seamfixupX16 : int
}

struct screenpart_t {
    u, v, zi, color : float
}

struct spritedesc_t {
    nump : int
    pverts : emitpoint_t?
    pspriteframe : mspriteframe_s?
    vup, vright, vpn : float[3]
    nearzi : float
}

struct zpointdesc_t {
    u, v : int
    zi : float
    color : int
}

struct drawsurf_t {
    surfdat : uint8?
    rowbytes : int
    surf : msurface_s?
    lightadj : int[4]
    texture : texture_s?
    surfmip, surfwidth, surfheight : int
}

include d_iface_h.layout.das.inc

