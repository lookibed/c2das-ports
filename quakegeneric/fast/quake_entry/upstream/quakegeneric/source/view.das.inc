[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_CalcRoll(var angles : float?; var velocity : float?) : float {
    var sign : float
    var side : float
    var value : float
    AngleVectors(angles, addr(forward[0]), addr(right[0]), addr(up[0]))
    side = velocity[0] * right[0] + velocity[1] * right[1] + velocity[2] * right[2]
    sign = float(side < 0.0f ? -1 : 1)
    side = float(math::abs(double(side)))
    value = cl_rollangle.value
    // if (cl.inwater)
    // value *= 6;
    if (side < cl_rollspeed.value) {
        side = side * value / cl_rollspeed.value
    } else {
        side = value
    }
    return side * sign
}

// ===============
// V_CalcBob
// ===============
[unsafe_deref, hint(unsafe_range_check)]
def V_CalcBob : float {
    var bob : float
    var cycle : float
    cycle = float(cl.time - double(float(int(cl.time / double(cl_bobcycle.value))) * cl_bobcycle.value))
    cycle /= cl_bobcycle.value
    if (cycle < cl_bobup.value) {
        cycle = float(3.141592653589793lf * double(cycle) / double(cl_bobup.value))
    } else {
        cycle = float(3.141592653589793lf + 3.141592653589793lf * double(cycle - cl_bobup.value) / (1.0lf - double(cl_bobup.value)))
    }
    // bob is proportional to velocity in the xy plane
    // (don't count Z, or jumping messes it up)
    bob = float(math::sqrt(double(cl.velocity[0] * cl.velocity[0] + cl.velocity[1] * cl.velocity[1])) * double(cl_bob.value))
    // Con_Printf ("speed: %5.1f\n", Length(cl.velocity));
    bob = float(double(bob) * 0.3lf + double(bob) * 0.7lf * math::sin(double(cycle)))
    if (bob > 4.0f) {
        bob = 4.0f
    } elif (bob < -7.0f) {
        bob = -7.0f
    }
    return bob
}

[unsafe_deref, hint(unsafe_range_check)]
def V_StartPitchDrift {
    if (cl.laststop == cl.time) {
        // something else is keeping it from drifting
        return
    }
    if (uint(cl.nodrift) != 0 || cl.pitchvel == 0.0f) {
        cl.pitchvel = v_centerspeed.value
        cl.nodrift = qboolean._c_false
        cl.driftmove = 0.0f
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def V_StopPitchDrift {
    cl.laststop = cl.time
    cl.nodrift = qboolean._c_true
    cl.pitchvel = 0.0f
}

// ===============
// V_DriftPitch
// Moves the client pitch angle towards cl.idealpitch sent by the server.
// If the user is adjusting pitch manually, either with lookup/lookdown,
// mlook and mouse, or klook and keyboard, pitch drifting is constantly stopped.
// Drifting is enabled when the center view key is hit, mlook is released and
// lookspring is non 0, or when
// ===============
[unsafe_deref, hint(unsafe_range_check)]
def V_DriftPitch {
    var delta : float
    var move : float
    if (uint(noclip_anglehack) != 0 || int(cl.onground) == 0 || uint(cls.demoplayback) != 0) {
        cl.driftmove = 0.0f
        cl.pitchvel = 0.0f
        return
    }
    // don't count small mouse motion
    if (int(cl.nodrift) != 0) {
        if (math::abs(double(cl.cmd.forwardmove)) < double(cl_forwardspeed.value)) {
            cl.driftmove = 0.0f
        } else {
            cl.driftmove = float(double(cl.driftmove) + host_frametime)
        }
        if (cl.driftmove > v_centermove.value) {
            V_StartPitchDrift()
        }
        return
    }
    delta = cl.idealpitch - cl.viewangles[PITCH]
    if (delta == 0.0f) {
        cl.pitchvel = 0.0f
        return
    }
    move = float(host_frametime * double(cl.pitchvel))
    cl.pitchvel = float(double(cl.pitchvel) + host_frametime * double(v_centerspeed.value))
    // Con_Printf ("move: %f (%f)\n", move, host_frametime);
    if (delta > 0.0f) {
        if (move > delta) {
            cl.pitchvel = 0.0f
            move = delta
        }
        cl.viewangles[PITCH] += move
    } elif (delta < 0.0f) {
        if (move > -delta) {
            cl.pitchvel = 0.0f
            move = -delta
        }
        cl.viewangles[PITCH] -= move
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def BuildGammaTable(g : float) {
    var inf : int
    if (double(g) == 1.0lf) {
        for (i in range(256)) {
            gammatable[i] = uint8(i)
        }
        return
    }
    for (i in range(256)) {
        inf = int(255.0lf * math::pow((double(i) + 0.5lf) / 255.5lf, double(g)) + 0.5lf)
        if (inf < 0) {
            inf = 0
        }
        if (inf > 255) {
            inf = 255
        }
        gammatable[i] = uint8(inf)
    }
}

// =================
// V_CheckGamma
// =================
[unsafe_deref, hint(unsafe_range_check)]
def V_CheckGamma : qboolean {
    if (v_gamma.value == V_CheckGamma_oldgammavalue) {
        return qboolean._c_false
    }
    V_CheckGamma_oldgammavalue = v_gamma.value
    BuildGammaTable(v_gamma.value)
    // force a surface cache flush
    vid.recalc_refdef = 1
    return qboolean._c_true
}

// ===============
// V_ParseDamage
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_ParseDamage {
    var armor : int
    var blood : int
    var from : float[3]
    var forward : float[3]
    var right : float[3]
    var up : float[3]
    var ent : entity_s?
    var side : float
    var count : float
    armor = MSG_ReadByte()
    blood = MSG_ReadByte()
    for (i in range(3)) {
        from[i] = MSG_ReadCoord()
    }
    count = float(double(blood) * 0.5lf + double(armor) * 0.5lf)
    if (count < 10.0f) {
        count = 10.0f
    }
    // but sbar face into pain frame
    cl.faceanimtime = float(cl.time + 0.2lf)
    cl.cshifts[CSHIFT_DAMAGE].percent = int(float(cl.cshifts[CSHIFT_DAMAGE].percent) + 3.0f * count)
    if (cl.cshifts[CSHIFT_DAMAGE].percent < 0) {
        cl.cshifts[CSHIFT_DAMAGE].percent = 0
    }
    if (cl.cshifts[CSHIFT_DAMAGE].percent > 150) {
        cl.cshifts[CSHIFT_DAMAGE].percent = 150
    }
    if (armor > blood) {
        cl.cshifts[CSHIFT_DAMAGE].destcolor[0] = 200
        cl.cshifts[CSHIFT_DAMAGE].destcolor[1] = 100
        cl.cshifts[CSHIFT_DAMAGE].destcolor[2] = 100
    } elif (armor != 0) {
        cl.cshifts[CSHIFT_DAMAGE].destcolor[0] = 220
        cl.cshifts[CSHIFT_DAMAGE].destcolor[1] = 50
        cl.cshifts[CSHIFT_DAMAGE].destcolor[2] = 50
    } else {
        cl.cshifts[CSHIFT_DAMAGE].destcolor[0] = 255
        cl.cshifts[CSHIFT_DAMAGE].destcolor[1] = 0
        cl.cshifts[CSHIFT_DAMAGE].destcolor[2] = 0
    }
    // calculate view angle kicks
    ent = addr(cl_entities[0]) + end_index(cl.viewentity, 600)
    from[0] -= ent.origin[0]
    from[1] -= ent.origin[1]
    from[2] -= ent.origin[2]
    VectorNormalize(addr(from[0]))
    AngleVectors(addr(ent.angles[0]), addr(forward[0]), addr(right[0]), addr(up[0]))
    side = DotProduct(from, right)
    v_dmg_roll = count * side * v_kickroll.value
    side = DotProduct(from, forward)
    v_dmg_pitch = count * side * v_kickpitch.value
    v_dmg_time = v_kicktime.value
}

