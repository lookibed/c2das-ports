// =============
// V_CalcPowerupCshift
// =============
[unsafe_deref, hint(unsafe_range_check)]
def V_CalcPowerupCshift {
    if ((cl.items & IT_QUAD) != 0) {
        cl.cshifts[CSHIFT_POWERUP].destcolor[0] = 0
        cl.cshifts[CSHIFT_POWERUP].destcolor[1] = 0
        cl.cshifts[CSHIFT_POWERUP].destcolor[2] = 255
        cl.cshifts[CSHIFT_POWERUP].percent = 30
    } elif ((cl.items & IT_SUIT) != 0) {
        cl.cshifts[CSHIFT_POWERUP].destcolor[0] = 0
        cl.cshifts[CSHIFT_POWERUP].destcolor[1] = 255
        cl.cshifts[CSHIFT_POWERUP].destcolor[2] = 0
        cl.cshifts[CSHIFT_POWERUP].percent = 20
    } elif ((cl.items & IT_INVISIBILITY) != 0) {
        cl.cshifts[CSHIFT_POWERUP].destcolor[0] = 100
        cl.cshifts[CSHIFT_POWERUP].destcolor[1] = 100
        cl.cshifts[CSHIFT_POWERUP].destcolor[2] = 100
        cl.cshifts[CSHIFT_POWERUP].percent = 100
    } elif ((cl.items & IT_INVULNERABILITY) != 0) {
        cl.cshifts[CSHIFT_POWERUP].destcolor[0] = 255
        cl.cshifts[CSHIFT_POWERUP].destcolor[1] = 255
        cl.cshifts[CSHIFT_POWERUP].destcolor[2] = 0
        cl.cshifts[CSHIFT_POWERUP].percent = 30
    } else {
        cl.cshifts[CSHIFT_POWERUP].percent = 0
    }
}

// =============
// V_UpdatePalette
// =============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_UpdatePalette {
    var _c_new : qboolean
    var basepal : uint8?
    var newpal : uint8?
    var pal : uint8[768]
    var r : int
    var g : int
    var b : int
    var force : qboolean
    V_CalcPowerupCshift()
    _c_new = qboolean._c_false
    for (i in range(NUM_CSHIFTS)) {
        if (cl.cshifts[i].percent != cl.prev_cshifts[i].percent) {
            _c_new = qboolean._c_true
            cl.prev_cshifts[i].percent = cl.cshifts[i].percent
        }
        for (j in range(3)) {
            if (cl.cshifts[i].destcolor[j] != cl.prev_cshifts[i].destcolor[j]) {
                _c_new = qboolean._c_true
                cl.prev_cshifts[i].destcolor[j] = cl.cshifts[i].destcolor[j]
            }
        }
    }
    // drop the damage value
    cl.cshifts[CSHIFT_DAMAGE].percent = int(double(cl.cshifts[CSHIFT_DAMAGE].percent) - host_frametime * 150.0lf)
    if (cl.cshifts[CSHIFT_DAMAGE].percent <= 0) {
        cl.cshifts[CSHIFT_DAMAGE].percent = 0
    }
    // drop the bonus value
    cl.cshifts[CSHIFT_BONUS].percent = int(double(cl.cshifts[CSHIFT_BONUS].percent) - host_frametime * 100.0lf)
    if (cl.cshifts[CSHIFT_BONUS].percent <= 0) {
        cl.cshifts[CSHIFT_BONUS].percent = 0
    }
    force = V_CheckGamma()
    if (int(_c_new) == 0 && int(force) == 0) {
        return
    }
    basepal = host_basepal
    newpal = addr(pal[0])
    for (i in range(256)) {
        r = int(basepal[0])
        g = int(basepal[1])
        b = int(basepal[2])
        basepal += 3
        for (j in range(NUM_CSHIFTS)) {
            r += (cl.cshifts[j].percent * (cl.cshifts[j].destcolor[0] - r)) >> 8
            g += (cl.cshifts[j].percent * (cl.cshifts[j].destcolor[1] - g)) >> 8
            b += (cl.cshifts[j].percent * (cl.cshifts[j].destcolor[2] - b)) >> 8
        }
        newpal[0] = gammatable[r]
        newpal[1] = gammatable[g]
        newpal[2] = gammatable[b]
        newpal += 3
    }
    VID_ShiftPalette(addr(pal[0]))
}

[unsafe_deref, hint(unsafe_range_check)]
def angledelta(var a : float) : float {
    a = anglemod(a)
    if (a > 180.0f) {
        a -= 360.0f
    }
    return a
}

// ==================
// CalcGunAngle
// ==================
[unsafe_deref, hint(unsafe_range_check)]
def CalcGunAngle {
    var yaw : float
    var pitch : float
    var move : float
    yaw = r_refdef.viewangles[YAW]
    pitch = -r_refdef.viewangles[PITCH]
    yaw = float(double(angledelta(yaw - r_refdef.viewangles[YAW])) * 0.4lf)
    if (yaw > 10.0f) {
        yaw = 10.0f
    }
    if (yaw < -10.0f) {
        yaw = -10.0f
    }
    pitch = float(double(angledelta(-pitch - r_refdef.viewangles[PITCH])) * 0.4lf)
    if (pitch > 10.0f) {
        pitch = 10.0f
    }
    if (pitch < -10.0f) {
        pitch = -10.0f
    }
    move = float(host_frametime * 20.0lf)
    if (yaw > CalcGunAngle_oldyaw) {
        if (CalcGunAngle_oldyaw + move < yaw) {
            yaw = CalcGunAngle_oldyaw + move
        }
    } else {
        if (CalcGunAngle_oldyaw - move > yaw) {
            yaw = CalcGunAngle_oldyaw - move
        }
    }
    if (pitch > CalcGunAngle_oldpitch) {
        if (CalcGunAngle_oldpitch + move < pitch) {
            pitch = CalcGunAngle_oldpitch + move
        }
    } else {
        if (CalcGunAngle_oldpitch - move > pitch) {
            pitch = CalcGunAngle_oldpitch - move
        }
    }
    CalcGunAngle_oldyaw = yaw
    CalcGunAngle_oldpitch = pitch
    cl.viewent.angles[YAW] = r_refdef.viewangles[YAW] + yaw
    cl.viewent.angles[PITCH] = -(r_refdef.viewangles[PITCH] + pitch)
    cl.viewent.angles[ROLL] = float(double(cl.viewent.angles[ROLL]) - double(v_idlescale.value) * math::sin(cl.time * double(v_iroll_cycle.value)) *
            double(v_iroll_level.value))
    cl.viewent.angles[PITCH] = float(double(cl.viewent.angles[PITCH]) - double(v_idlescale.value) * math::sin(cl.time * double(v_ipitch_cycle.value)) *
            double(v_ipitch_level.value))
    cl.viewent.angles[YAW] = float(double(cl.viewent.angles[YAW]) - double(v_idlescale.value) * math::sin(cl.time * double(v_iyaw_cycle.value)) *
            double(v_iyaw_level.value))
}

// ==============
// V_BoundOffsets
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_BoundOffsets {
    var ent : entity_s?
    ent = addr(cl_entities[0]) + end_index(cl.viewentity, 600)
    // absolutely bound refresh reletive to entity clipping hull
    // so the view can never be inside a solid wall
    if (r_refdef.vieworg[0] < ent.origin[0] - 14.0f) {
        r_refdef.vieworg[0] = ent.origin[0] - 14.0f
    } elif (r_refdef.vieworg[0] > ent.origin[0] + 14.0f) {
        r_refdef.vieworg[0] = ent.origin[0] + 14.0f
    }
    if (r_refdef.vieworg[1] < ent.origin[1] - 14.0f) {
        r_refdef.vieworg[1] = ent.origin[1] - 14.0f
    } elif (r_refdef.vieworg[1] > ent.origin[1] + 14.0f) {
        r_refdef.vieworg[1] = ent.origin[1] + 14.0f
    }
    if (r_refdef.vieworg[2] < ent.origin[2] - 22.0f) {
        r_refdef.vieworg[2] = ent.origin[2] - 22.0f
    } elif (r_refdef.vieworg[2] > ent.origin[2] + 30.0f) {
        r_refdef.vieworg[2] = ent.origin[2] + 30.0f
    }
}

// ==============
// V_AddIdle
// Idle swaying
// ==============
[unsafe_deref, hint(unsafe_range_check)]
def V_AddIdle {
    r_refdef.viewangles[ROLL] = float(double(r_refdef.viewangles[ROLL]) + double(v_idlescale.value) * math::sin(cl.time * double(v_iroll_cycle.value)) *
            double(v_iroll_level.value))
    r_refdef.viewangles[PITCH] = float(double(r_refdef.viewangles[PITCH]) + double(v_idlescale.value) * math::sin(cl.time * double(v_ipitch_cycle.value)) *
            double(v_ipitch_level.value))
    r_refdef.viewangles[YAW] = float(double(r_refdef.viewangles[YAW]) + double(v_idlescale.value) * math::sin(cl.time * double(v_iyaw_cycle.value)) *
            double(v_iyaw_level.value))
}

// ==============
// V_CalcViewRoll
// Roll is induced by movement and damage
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_CalcViewRoll {
    var side : float
    side = V_CalcRoll(addr(cl_entities[cl.viewentity].angles[0]), addr(cl.velocity[0]))
    r_refdef.viewangles[ROLL] += side
    if (v_dmg_time > 0.0f) {
        r_refdef.viewangles[ROLL] += v_dmg_time / v_kicktime.value * v_dmg_roll
        r_refdef.viewangles[PITCH] += v_dmg_time / v_kicktime.value * v_dmg_pitch
        v_dmg_time = float(double(v_dmg_time) - host_frametime)
    }
    if (cl.stats[STAT_HEALTH] <= 0) {
        // dead view angle
        r_refdef.viewangles[ROLL] = 80.0f
        return
    }
}

// ==================
// V_CalcIntermissionRefdef
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_CalcIntermissionRefdef {
    var ent : entity_s?
    var view : entity_s?
    var old : float
    // ent is the player model (visible when out of body)
    ent = addr(cl_entities[0]) + end_index(cl.viewentity, 600)
    // view is the weapon model (only visible from inside body)
    view = addr(cl.viewent)
    r_refdef.vieworg[0] = ent.origin[0]
    r_refdef.vieworg[1] = ent.origin[1]
    r_refdef.vieworg[2] = ent.origin[2]
    r_refdef.viewangles[0] = ent.angles[0]
    r_refdef.viewangles[1] = ent.angles[1]
    r_refdef.viewangles[2] = ent.angles[2]
    view.model = null
    // allways idle in intermission
    old = v_idlescale.value
    v_idlescale.value = 1.0f
    V_AddIdle()
    v_idlescale.value = old
}

// ==================
// V_CalcRefdef
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_CalcRefdef {
    var ent : entity_s?
    var view : entity_s?
    var forward : float[3]
    var right : float[3]
    var up : float[3]
    var angles : float[3]
    var bob : float
    V_DriftPitch()
    // ent is the player model (visible when out of body)
    ent = addr(cl_entities[0]) + end_index(cl.viewentity, 600)
    // view is the weapon model (only visible from inside body)
    view = addr(cl.viewent)
    // transform the view offset by the model's matrix to get the offset from
    // model origin for the view
    // the model should face
    ent.angles[YAW] = cl.viewangles[YAW]
    // the view dir
    // the model should face
    ent.angles[PITCH] = -cl.viewangles[PITCH]
    // the view dir
    bob = V_CalcBob()
    // refresh position
    r_refdef.vieworg[0] = ent.origin[0]
    r_refdef.vieworg[1] = ent.origin[1]
    r_refdef.vieworg[2] = ent.origin[2]
    r_refdef.vieworg[2] += cl.viewheight + bob
    // never let it sit exactly on a node line, because a water plane can
    // dissapear when viewed with the eye exactly on it.
    // the server protocol only specifies to 1/16 pixel, so add 1/32 in each axis
    r_refdef.vieworg[0] = float(double(r_refdef.vieworg[0]) + 1.0lf / 32.0lf)
    r_refdef.vieworg[1] = float(double(r_refdef.vieworg[1]) + 1.0lf / 32.0lf)
    r_refdef.vieworg[2] = float(double(r_refdef.vieworg[2]) + 1.0lf / 32.0lf)
    r_refdef.viewangles[0] = cl.viewangles[0]
    r_refdef.viewangles[1] = cl.viewangles[1]
    r_refdef.viewangles[2] = cl.viewangles[2]
    V_CalcViewRoll()
    V_AddIdle()
    // offsets
    // because entity pitches are
    angles[PITCH] = -ent.angles[PITCH]
    // actually backward
    angles[YAW] = ent.angles[YAW]
    angles[ROLL] = ent.angles[ROLL]
    AngleVectors(addr(angles[0]), addr(forward[0]), addr(right[0]), addr(up[0]))
    for (i in range(3)) {
        r_refdef.vieworg[i] += scr_ofsx.value * forward[i] + scr_ofsy.value * right[i] + scr_ofsz.value * up[i]
    }
    V_BoundOffsets()
    // set up gun position
    view.angles[0] = cl.viewangles[0]
    view.angles[1] = cl.viewangles[1]
    view.angles[2] = cl.viewangles[2]
    CalcGunAngle()
    view.origin[0] = ent.origin[0]
    view.origin[1] = ent.origin[1]
    view.origin[2] = ent.origin[2]
    view.origin[2] += cl.viewheight
    for (i in range(3)) {
        view.origin[i] = float(double(view.origin[i]) + double(forward[i] * bob) * 0.4lf)
    }
    // view->origin[i] += right[i]*bob*0.4;
    // view->origin[i] += up[i]*bob*0.8;
    view.origin[2] += bob
    // fudge position around to keep amount of weapon visible
    // roughly equal with different FOV
    if (scr_viewsize.value == 110.0f) {
        view.origin[2] += 1.0f
    } elif (scr_viewsize.value == 100.0f) {
        view.origin[2] += 2.0f
    } elif (scr_viewsize.value == 90.0f) {
        view.origin[2] += 1.0f
    } elif (scr_viewsize.value == 80.0f) {
        view.origin[2] = float(double(view.origin[2]) + 0.5lf)
    }
    view.model = cl.model_precache[cl.stats[STAT_WEAPON]]
    view.frame = cl.stats[STAT_WEAPONFRAME]
    view.colormap = vid.colormap
    // set up the refresh position
    r_refdef.viewangles[0] += cl.punchangle[0]
    r_refdef.viewangles[1] += cl.punchangle[1]
    r_refdef.viewangles[2] += cl.punchangle[2]
    // smooth out stair step ups
    if (uint(cl.onground) != 0 && ent.origin[2] - V_CalcRefdef_oldz > 0.0f) {
        var steptime : float
        steptime = float(cl.time - cl.oldtime)
        if (steptime < 0.0f) {
            // FIXME I_Error ("steptime < 0");
            steptime = 0.0f
        }
        V_CalcRefdef_oldz += steptime * 80.0f
        if (V_CalcRefdef_oldz > ent.origin[2]) {
            V_CalcRefdef_oldz = ent.origin[2]
        }
        if (ent.origin[2] - V_CalcRefdef_oldz > 12.0f) {
            V_CalcRefdef_oldz = ent.origin[2] - 12.0f
        }
        r_refdef.vieworg[2] += V_CalcRefdef_oldz - ent.origin[2]
        view.origin[2] += V_CalcRefdef_oldz - ent.origin[2]
    } else {
        V_CalcRefdef_oldz = ent.origin[2]
    }
    if (chase_active.value != 0.0f) {
        Chase_Update()
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_RenderView {
    if (int(con_forcedup) != 0) {
        return
    }
    // don't allow cheats in multiplayer
    if (cl.maxclients > 1) {
        Cvar_Set(cstr("scr_ofsx"), cstr("0"))
        Cvar_Set(cstr("scr_ofsy"), cstr("0"))
        Cvar_Set(cstr("scr_ofsz"), cstr("0"))
    }
    if (cl.intermission != 0) {
        // intermission / finale rendering
        V_CalcIntermissionRefdef()
    } else {
        // && (sv.maxclients > 1 || key_dest == key_game)
        if (int(cl.paused) == 0) {
            V_CalcRefdef()
        }
    }
    R_PushDlights()
    if (lcd_x.value != 0.0f) {
        // render two interleaved views
        vid.rowbytes <<= 1u
        vid.aspect = float(double(vid.aspect) * 0.5lf)
        r_refdef.viewangles[YAW] -= lcd_yaw.value
        for (i in range(3)) {
            r_refdef.vieworg[i] -= right[i] * lcd_x.value
        }
        R_RenderView()
        vid.buffer += vid.rowbytes >> 1u
        R_PushDlights()
        r_refdef.viewangles[YAW] += lcd_yaw.value * 2.0f
        for (i in range(3)) {
            r_refdef.vieworg[i] += 2.0f * right[i] * lcd_x.value
        }
        R_RenderView()
        vid.buffer -= vid.rowbytes >> 1u
        r_refdef.vrect.height <<= 1
        vid.rowbytes >>= 1u
        vid.aspect *= 2.0f
    } else {
        R_RenderView()
    }
    if (crosshair.value != 0.0f) {
        Draw_Character(int(float(scr_vrect.x + scr_vrect.width / 2) + cl_crossx.value), int(float(scr_vrect.y + scr_vrect.height / 2) + cl_crossy.value), '+')
    }
}

