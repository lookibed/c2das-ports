var sv_accelerate : cvar_s = cvar_s(name = cstr("sv_accelerate"), _c_string = cstr("10"))

// ===============
// SV_SetIdealPitch
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_SetIdealPitch {
    var angleval : float
    var sinval : float
    var cosval : float
    var tr : trace_t
    var top : float[3]
    var bottom : float[3]
    var z : float[6]
    var i : int
    var step : int
    var dir : int
    var steps : int
    if ((int(sv_player.v.flags) & FL_ONGROUND) == 0) {
        return
    }
    angleval = float(double(sv_player.v.angles[YAW]) * 3.141592653589793lf * 2.0lf / 360.0lf)
    sinval = float(math::sin(double(angleval)))
    cosval = float(math::cos(double(angleval)))
    i = 0
    while (i < MAX_FORWARD) {
        top[0] = sv_player.v.origin[0] + cosval * float(i + 3) * 12.0f
        top[1] = sv_player.v.origin[1] + sinval * float(i + 3) * 12.0f
        top[2] = sv_player.v.origin[2] + sv_player.v.view_ofs[2]
        bottom[0] = top[0]
        bottom[1] = top[1]
        bottom[2] = top[2] - 160.0f
        tr = SV_Move(addr(top[0]), addr(vec3_origin[0]), addr(vec3_origin[0]), addr(bottom[0]), 1, sv_player)
        if (int(tr.allsolid) != 0) {
            // looking at a wall, leave ideal the way is was
            return
        }
        if (tr.fraction == 1.0f) {
            // near a dropoff
            return
        }
        z[i] = top[2] + tr.fraction * (bottom[2] - top[2])
        i++
    }
    dir = 0
    steps = 0
    for (j in range(1, i)) {
        step = int(z[j] - z[j - 1])
        if (double(step) > -ON_EPSILON && double(step) < ON_EPSILON) {
            continue
        }
        if (dir != 0 && (double(step - dir) > ON_EPSILON || double(step - dir) < -ON_EPSILON)) {
            // mixed changes
            return
        }
        steps++
        dir = step
    }
    if (dir == 0) {
        sv_player.v.idealpitch = 0.0f
        return
    }
    if (steps < 2) {
        return
    }
    sv_player.v.idealpitch = float(-dir) * sv_idealpitchscale.value
}

// ==================
// SV_UserFriction
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_UserFriction {
    var vel : float?
    var speed : float
    var newspeed : float
    var control : float
    var start : float[3]
    var stop : float[3]
    var friction : float
    var trace : trace_t
    vel = velocity
    speed = float(math::sqrt(double(vel[0] * vel[0] + vel[1] * vel[1])))
    if (speed == 0.0f) {
        return
    }
    // if the leading edge is over a dropoff, increase friction
    stop[0] = origin[0] + vel[0] / speed * 16.0f
    start[0] = stop[0]
    stop[1] = origin[1] + vel[1] / speed * 16.0f
    start[1] = stop[1]
    start[2] = origin[2] + sv_player.v.mins[2]
    stop[2] = start[2] - 34.0f
    trace = SV_Move(addr(start[0]), addr(vec3_origin[0]), addr(vec3_origin[0]), addr(stop[0]), int(qboolean._c_true), sv_player)
    if (double(trace.fraction) == 1.0lf) {
        friction = sv_friction.value * sv_edgefriction.value
    } else {
        friction = sv_friction.value
    }
    // apply friction
    control = speed < sv_stopspeed.value ? sv_stopspeed.value : speed
    newspeed = float(double(speed) - host_frametime * double(control) * double(friction))
    if (newspeed < 0.0f) {
        newspeed = 0.0f
    }
    newspeed /= speed
    vel[0] *= newspeed
    vel[1] *= newspeed
    vel[2] *= newspeed
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_Accelerate {
    var addspeed : float
    var accelspeed : float
    var currentspeed : float
    currentspeed = velocity[0] * wishdir[0] + velocity[1] * wishdir[1] + velocity[2] * wishdir[2]
    addspeed = wishspeed - currentspeed
    if (addspeed <= 0.0f) {
        return
    }
    accelspeed = float(double(sv_accelerate.value) * host_frametime * double(wishspeed))
    if (accelspeed > addspeed) {
        accelspeed = addspeed
    }
    for (i in range(3)) {
        velocity[i] += accelspeed * wishdir[i]
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_AirAccelerate(var wishveloc : float?) {
    var addspeed : float
    var wishspd : float
    var accelspeed : float
    var currentspeed : float
    wishspd = VectorNormalize(wishveloc)
    if (wishspd > 30.0f) {
        wishspd = 30.0f
    }
    currentspeed = velocity[0] * wishveloc[0] + velocity[1] * wishveloc[1] + velocity[2] * wishveloc[2]
    addspeed = wishspd - currentspeed
    if (addspeed <= 0.0f) {
        return
    }
    // accelspeed = sv_accelerate.value * host_frametime;
    accelspeed = float(double(sv_accelerate.value * wishspeed) * host_frametime)
    if (accelspeed > addspeed) {
        accelspeed = addspeed
    }
    for (i in range(3)) {
        velocity[i] += accelspeed * wishveloc[i]
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def DropPunchAngle {
    var len : float
    len = VectorNormalize(addr(sv_player.v.punchangle[0]))
    len = float(double(len) - 10.0lf * host_frametime)
    if (len < 0.0f) {
        len = 0.0f
    }
    VectorScale(addr(sv_player.v.punchangle[0]), len, addr(sv_player.v.punchangle[0]))
}

// ===================
// SV_WaterMove
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_WaterMove {
    var wishvel : float[3]
    var speed : float
    var newspeed : float
    var wishspeed : float
    var addspeed : float
    var accelspeed : float
    // user intentions
    AngleVectors(addr(sv_player.v.v_angle[0]), addr(sv_user_forward[0]), addr(sv_user_right[0]), addr(sv_user_up[0]))
    for (i in range(3)) {
        wishvel[i] = sv_user_forward[i] * cmd.forwardmove + sv_user_right[i] * cmd.sidemove
    }
    if (cmd.forwardmove == 0.0f && cmd.sidemove == 0.0f && cmd.upmove == 0.0f) {
        // drift towards bottom
        wishvel[2] -= 60.0f
    } else {
        wishvel[2] += cmd.upmove
    }
    wishspeed = Length(addr(wishvel[0]))
    if (wishspeed > sv_maxspeed.value) {
        VectorScale(addr(wishvel[0]), sv_maxspeed.value / wishspeed, addr(wishvel[0]))
        wishspeed = sv_maxspeed.value
    }
    wishspeed = float(double(wishspeed) * 0.7lf)
    // water friction
    speed = Length(velocity)
    if (speed != 0.0f) {
        newspeed = float(double(speed) - host_frametime * double(speed) * double(sv_friction.value))
        if (newspeed < 0.0f) {
            newspeed = 0.0f
        }
        VectorScale(velocity, newspeed / speed, velocity)
    } else {
        newspeed = 0.0f
    }
    // water acceleration
    if (wishspeed == 0.0f) {
        return
    }
    addspeed = wishspeed - newspeed
    if (addspeed <= 0.0f) {
        return
    }
    VectorNormalize(addr(wishvel[0]))
    accelspeed = float(double(sv_accelerate.value * wishspeed) * host_frametime)
    if (accelspeed > addspeed) {
        accelspeed = addspeed
    }
    for (i in range(3)) {
        velocity[i] += accelspeed * wishvel[i]
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def SV_WaterJump {
    if (sv.time > double(sv_player.v.teleport_time) || sv_player.v.waterlevel == 0.0f) {
        sv_player.v.flags = float(int(sv_player.v.flags) & ~FL_WATERJUMP)
        sv_player.v.teleport_time = 0.0f
    }
    sv_player.v.velocity[0] = sv_player.v.movedir[0]
    sv_player.v.velocity[1] = sv_player.v.movedir[1]
}

// ===================
// SV_AirMove
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_AirMove {
    var wishvel : float[3]
    var fmove : float
    var smove : float
    AngleVectors(addr(sv_player.v.angles[0]), addr(sv_user_forward[0]), addr(sv_user_right[0]), addr(sv_user_up[0]))
    fmove = cmd.forwardmove
    smove = cmd.sidemove
    // hack to not let you back into teleporter
    if (sv.time < double(sv_player.v.teleport_time) && fmove < 0.0f) {
        fmove = 0.0f
    }
    for (i in range(3)) {
        wishvel[i] = sv_user_forward[i] * fmove + sv_user_right[i] * smove
    }
    if (int(sv_player.v.movetype) != MOVETYPE_WALK) {
        wishvel[2] = cmd.upmove
    } else {
        wishvel[2] = 0.0f
    }
    wishdir[0] = wishvel[0]
    wishdir[1] = wishvel[1]
    wishdir[2] = wishvel[2]
    wishspeed = VectorNormalize(addr(wishdir[0]))
    if (wishspeed > sv_maxspeed.value) {
        VectorScale(addr(wishvel[0]), sv_maxspeed.value / wishspeed, addr(wishvel[0]))
        wishspeed = sv_maxspeed.value
    }
    if (sv_player.v.movetype == float(MOVETYPE_NOCLIP)) {
        // noclip
        velocity[0] = wishvel[0]
        velocity[1] = wishvel[1]
        velocity[2] = wishvel[2]
    } elif (int(onground) != 0) {
        SV_UserFriction()
        SV_Accelerate()
    } else {
        // not on ground, so little effect on velocity
        SV_AirAccelerate(addr(wishvel[0]))
    }
}

// ===================
// SV_ClientThink
// the move fields specify an intended velocity in pix/sec
// the angle fields specify an exact angular motion in degrees
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_ClientThink {
    var v_angle : float[3]
    if (sv_player.v.movetype == float(MOVETYPE_NONE)) {
        return
    }
    onground = enum_from_int(type<qboolean>, int(sv_player.v.flags) & FL_ONGROUND)
    origin = addr(sv_player.v.origin[0])
    velocity = addr(sv_player.v.velocity[0])
    DropPunchAngle()
    // if dead, behave differently
    if (sv_player.v.health <= 0.0f) {
        return
    }
    // angles
    // show 1/3 the pitch angle and all the roll angle
    cmd = host_client.cmd
    angles = addr(sv_player.v.angles[0])
    v_angle[0] = sv_player.v.v_angle[0] + sv_player.v.punchangle[0]
    v_angle[1] = sv_player.v.v_angle[1] + sv_player.v.punchangle[1]
    v_angle[2] = sv_player.v.v_angle[2] + sv_player.v.punchangle[2]
    angles[ROLL] = V_CalcRoll(addr(sv_player.v.angles[0]), addr(sv_player.v.velocity[0])) * 4.0f
    if (sv_player.v.fixangle == 0.0f) {
        angles[PITCH] = -v_angle[PITCH] / 3.0f
        angles[YAW] = v_angle[YAW]
    }
    if ((int(sv_player.v.flags) & FL_WATERJUMP) != 0) {
        SV_WaterJump()
        return
    }
    // walk
    if ((sv_player.v.waterlevel >= 2.0f) && (sv_player.v.movetype != float(MOVETYPE_NOCLIP))) {
        SV_WaterMove()
        return
    }
    SV_AirMove()
}

// ===================
// SV_ReadClientMove
// ===================
[unsafe_deref, hint(unsafe_range_check)]
def SV_ReadClientMove(var move : usercmd_t?) {
    var i : int
    var angle : float[3]
    var bits : int
    // read ping time
    host_client.ping_times[host_client.num_pings % NUM_PING_TIMES] = float(sv.time - double(MSG_ReadFloat()))
    host_client.num_pings++
    // read current angles
    for (i1 in range(3)) {
        angle[i1] = MSG_ReadAngle()
    }
    host_client.edict.v.v_angle[0] = angle[0]
    host_client.edict.v.v_angle[1] = angle[1]
    host_client.edict.v.v_angle[2] = angle[2]
    // read movement
    move.forwardmove = float(MSG_ReadShort())
    move.sidemove = float(MSG_ReadShort())
    move.upmove = float(MSG_ReadShort())
    // read buttons
    bits = MSG_ReadByte()
    host_client.edict.v.button0 = float(bits & 1)
    host_client.edict.v.button2 = float((bits & 2) >> 1)
    i = MSG_ReadByte()
    if (i != 0) {
        host_client.edict.v.impulse = float(i)
    }
}

// ===================
// SV_ReadClientMessage
// Returns false if the client should be killed
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_ReadClientMessage : qboolean {
    var ret : int
    var cmd : int
    var s : uint8?
    c_do_while(ret == 1) {
        label 1:  // nextmsg
        ret = NET_GetMessage(host_client.netconnection)
        if (ret == -1) {
            Sys_Printf`va(cstr("SV_ReadClientMessage: NET_GetMessage failed\n"), VaNone())
            return qboolean._c_false
        }
        if (ret == 0) {
            return qboolean._c_true
        }
        MSG_BeginReading()
        while (1 != 0) {
            if (int(host_client.active) == 0) {
                // a command caused an error
                return qboolean._c_false
            }
            if (int(msg_badread) != 0) {
                Sys_Printf`va(cstr("SV_ReadClientMessage: badread\n"), VaNone())
                return qboolean._c_false
            }
            cmd = MSG_ReadChar()
            c_switch(cmd) {
                case(-1) {
                    // end of message
                    goto label 1
                }
                case(_) {
                    Sys_Printf`va(cstr("SV_ReadClientMessage: unknown command char\n"), VaNone())
                    return qboolean._c_false
                }
                case(1) {
                    // Sys_Printf ("clc_nop\n");
                    break
                }
                case(4) {
                    s = MSG_ReadString()
                    if (int(host_client.privileged) != 0) {
                        ret = 2
                    } else {
                        ret = 0
                    }
                    if (Q_strncasecmp(s, cstr("status"), 6) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("god"), 3) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("notarget"), 8) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("fly"), 3) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("name"), 4) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("noclip"), 6) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("say"), 3) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("say_team"), 8) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("tell"), 4) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("color"), 5) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("kill"), 4) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("pause"), 5) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("spawn"), 5) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("begin"), 5) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("prespawn"), 8) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("kick"), 4) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("ping"), 4) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("give"), 4) == 0) {
                        ret = 1
                    } elif (Q_strncasecmp(s, cstr("ban"), 3) == 0) {
                        ret = 1
                    }
                    if (ret == 2) {
                        Cbuf_InsertText(s)
                    } elif (ret == 1) {
                        Cmd_ExecuteString(s, cmd_source_t.src_client)
                    } else {
                        Con_DPrintf`va(cstr("%s tried to %s\n"), (addr(host_client.name[0]), s))
                    }
                    break
                }
                case(2) {
                    // Sys_Printf ("SV_ReadClientMessage: client disconnected\n");
                    return qboolean._c_false
                }
                case(3) {
                    SV_ReadClientMove(addr(host_client.cmd))
                    break
                }
            }
        }
    }
    return qboolean._c_true
}

// ==================
// SV_RunClients
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_RunClients {
    var i : int
    i = 0
    host_client = svs.clients
    while (i < svs.maxclients) {
        {
            if (int(host_client.active) == 0) {
                continue
            }
            sv_player = host_client.edict
            if (int(SV_ReadClientMessage()) == 0) {
                // client misbehaved...
                SV_DropClient(qboolean._c_false)
                continue
            }
            if (int(host_client.spawned) == 0) {
                // clear client movement until a new packet is received
                crt::memset(reinterpret<void?>(addr(host_client.cmd)), 0, uint64(typeinfo sizeof(type<usercmd_t>)))
                continue
            }
            // always pause in single player if in console or menus
            if (int(sv.paused) == 0 && (svs.maxclients > 1 || key_dest == keydest_t.key_game)) {
                SV_ClientThink()
            }
        } finally {
            i++
            host_client++
        }
    }
}

