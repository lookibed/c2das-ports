// ===============
// R_InitParticles
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitParticles {
    var i : int
    i = COM_CheckParm(cstr("-particles"))
    if (i != 0) {
        r_numparticles = Q_atoi(com_argv[i + 1])
        if (r_numparticles < ABSOLUTE_MIN_PARTICLES) {
            r_numparticles = ABSOLUTE_MIN_PARTICLES
        }
    } else {
        r_numparticles = MAX_PARTICLES
    }
    particles = reinterpret<particle_s?>(Hunk_AllocName(int(uint64(r_numparticles) * uint64(typeinfo sizeof(type<particle_s>))), cstr("particles")))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_EntityParticles(var ent : entity_s?) {
    var count : int
    var p : particle_s?
    var angle : float
    var sr : float
    var sp : float
    var sy : float
    var cr : float
    var cp : float
    var cy : float
    var forward : float[3]
    var dist : float
    dist = 64.0f
    count = 50
    if (avelocities[0][0] == 0.0f) {
        for (i in range(NUMVERTEXNORMALS * 3)) {
            avelocities[0][i] = float(double(crt::rand() & 255) * 0.01lf)
        }
    }
    for (i in range(NUMVERTEXNORMALS)) {
        angle = float(cl.time * double(avelocities[i][0]))
        sy = float(math::sin(double(angle)))
        cy = float(math::cos(double(angle)))
        angle = float(cl.time * double(avelocities[i][1]))
        sp = float(math::sin(double(angle)))
        cp = float(math::cos(double(angle)))
        angle = float(cl.time * double(avelocities[i][2]))
        sr = float(math::sin(double(angle)))
        cr = float(math::cos(double(angle)))
        forward[0] = cp * cy
        forward[1] = cp * sy
        forward[2] = -sp
        if (free_particles == null) {
            return
        }
        p = free_particles
        free_particles = p.next
        p.next = active_particles
        active_particles = p
        p.die = float(cl.time + 0.01lf)
        p.color = 111.0f
        p._c_type = ptype_t.pt_explode
        p.org[0] = ent.origin[0] + r_avertexnormals[i][0] * dist + forward[0] * beamlength
        p.org[1] = ent.origin[1] + r_avertexnormals[i][1] * dist + forward[1] * beamlength
        p.org[2] = ent.origin[2] + r_avertexnormals[i][2] * dist + forward[2] * beamlength
    }
}

// ===============
// R_ClearParticles
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClearParticles {
    free_particles = addr(particles[0])
    active_particles = null
    for (i in range(r_numparticles)) {
        particles[i].next = addr(particles[i + 1])
    }
    particles[r_numparticles - 1].next = null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ReadPointFile_f {
    var f : _IO_FILE?
    var org : float[3]
    var r : int
    var c : int
    var p : particle_s?
    var name : uint8[128]
    sprintf(addr(name[0]), cstr("maps/%s.pts"), addr(sv.name[0]))
    COM_FOpenFile(addr(name[0]), addr(f))
    if (f == null) {
        Con_Printf`va(cstr("couldn't open %s\n"), (addr(name[0]),))
        return
    }
    Con_Printf`va(cstr("Reading %s...\n"), (addr(name[0]),))
    c = 0
    while (true) {
        r = fscanf(reinterpret<void?>(f), cstr("%f %f %f\n"), addr(org[0]), addr(org[1]), addr(org[2]))
        if (r != 3) {
            break
        }
        c++
        if (free_particles == null) {
            Con_Printf`va(cstr("Not enough free particles\n"), VaNone())
            break
        }
        p = free_particles
        free_particles = p.next
        p.next = active_particles
        active_particles = p
        p.die = 99999.0f
        p.color = float((-c) & 15)
        p._c_type = ptype_t.pt_static
        p.vel[0] = vec3_origin[0]
        p.vel[1] = vec3_origin[1]
        p.vel[2] = vec3_origin[2]
        p.org[0] = org[0]
        p.org[1] = org[1]
        p.org[2] = org[2]
    }
    crt::fclose(reinterpret<void?>(f))
    Con_Printf`va(cstr("%i points read\n"), (c,))
}

// ===============
// R_ParseParticleEffect
// Parse an effect out of the server message
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ParseParticleEffect {
    var org : float[3]
    var dir : float[3]
    var count : int
    var msgcount : int
    var color : int
    for (i in range(3)) {
        org[i] = MSG_ReadCoord()
    }
    for (i in range(3)) {
        dir[i] = float(double(MSG_ReadChar()) * (1.0lf / 16.0lf))
    }
    msgcount = MSG_ReadByte()
    color = MSG_ReadByte()
    if (msgcount == 255) {
        count = 1024
    } else {
        count = msgcount
    }
    R_RunParticleEffect(addr(org[0]), addr(dir[0]), color, count)
}

