[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_RocketTrail(var start : float?; var end : float?; var _c_type : int) {
    var vec : float[3]
    var len : float
    var j : int
    var p : particle_s?
    var dec : int
    VectorSubtract(end, start, vec)
    len = VectorNormalize(addr(vec[0]))
    if (_c_type < 128) {
        dec = 3
    } else {
        dec = 1
        _c_type -= 128
    }
    while (len > 0.0f) {
        len -= float(dec)
        if (free_particles == null) {
            return
        }
        p = free_particles
        free_particles = p.next
        p.next = active_particles
        active_particles = p
        p.vel[0] = vec3_origin[0]
        p.vel[1] = vec3_origin[1]
        p.vel[2] = vec3_origin[2]
        p.die = float(cl.time + 2.0lf)
        c_switch(_c_type) {
            case(0) {
                // rocket trail
                p.ramp = float(crt::rand() & 3)
                p.color = float(ramp3[int(p.ramp)])
                p._c_type = ptype_t.pt_fire
                j = 0
                while (j < 3) {
                    p.org[j] = start[j] + float((crt::rand() % 6) - 3)
                    j++
                }
                break
            }
            case(1) {
                // smoke smoke
                p.ramp = float((crt::rand() & 3) + 2)
                p.color = float(ramp3[int(p.ramp)])
                p._c_type = ptype_t.pt_fire
                j = 0
                while (j < 3) {
                    p.org[j] = start[j] + float((crt::rand() % 6) - 3)
                    j++
                }
                break
            }
            case(2) {
                // blood
                p._c_type = ptype_t.pt_grav
                p.color = float(67 + (crt::rand() & 3))
                j = 0
                while (j < 3) {
                    p.org[j] = start[j] + float((crt::rand() % 6) - 3)
                    j++
                }
                break
            }
            case(3, 5) {
                // tracer
                p.die = float(cl.time + 0.5lf)
                p._c_type = ptype_t.pt_static
                if (_c_type == 3) {
                    p.color = float(52 + ((R_RocketTrail_tracercount & 4) << 1))
                } else {
                    p.color = float(230 + ((R_RocketTrail_tracercount & 4) << 1))
                }
                R_RocketTrail_tracercount++
                p.org[0] = start[0]
                p.org[1] = start[1]
                p.org[2] = start[2]
                if ((R_RocketTrail_tracercount & 1) != 0) {
                    p.vel[0] = 30.0f * vec[1]
                    p.vel[1] = 30.0f * -vec[0]
                } else {
                    p.vel[0] = 30.0f * -vec[1]
                    p.vel[1] = 30.0f * vec[0]
                }
                break
            }
            case(4) {
                // slight blood
                p._c_type = ptype_t.pt_grav
                p.color = float(67 + (crt::rand() & 3))
                j = 0
                while (j < 3) {
                    p.org[j] = start[j] + float((crt::rand() % 6) - 3)
                    j++
                }
                len -= 3.0f
                break
            }
            case(6) {
                // voor trail
                p.color = float(9 * 16 + 8 + (crt::rand() & 3))
                p._c_type = ptype_t.pt_static
                p.die = float(cl.time + 0.3lf)
                j = 0
                while (j < 3) {
                    p.org[j] = start[j] + float((crt::rand() & 15) - 8)
                    j++
                }
                break
            }
        }
        start[0] += vec[0]
        start[1] += vec[1]
        start[2] += vec[2]
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawParticles {
    var p : particle_s?
    var kill : particle_s?
    var grav : float
    var i : int
    var time2 : float
    var time3 : float
    var time1 : float
    var dvel : float
    var frametime : float
    D_StartParticles()
    VectorScale(addr(vright[0]), xscaleshrink, addr(r_pright[0]))
    VectorScale(addr(vup[0]), yscaleshrink, addr(r_pup[0]))
    r_ppn[0] = vpn[0]
    r_ppn[1] = vpn[1]
    r_ppn[2] = vpn[2]
    frametime = float(cl.time - cl.oldtime)
    time3 = frametime * 15.0f
    // 15;
    time2 = frametime * 10.0f
    time1 = frametime * 5.0f
    grav = float(double(frametime * sv_gravity.value) * 0.05lf)
    dvel = 4.0f * frametime
    while (true) {
        kill = active_particles
        if (kill != null && double(kill.die) < cl.time) {
            active_particles = kill.next
            kill.next = free_particles
            free_particles = kill
            continue
        }
        break
    }
    p = active_particles
    while (p != null) {
        while (true) {
            kill = p.next
            if (kill != null && double(kill.die) < cl.time) {
                p.next = kill.next
                kill.next = free_particles
                free_particles = kill
                continue
            }
            break
        }
        D_DrawParticle(p)
        p.org[0] += p.vel[0] * frametime
        p.org[1] += p.vel[1] * frametime
        p.org[2] += p.vel[2] * frametime
        c_switch(p._c_type) {
            case(ptype_t.pt_static) {
                break
            }
            case(ptype_t.pt_fire) {
                p.ramp += time1
                if (p.ramp >= 6.0f) {
                    p.die = -1.0f
                } else {
                    p.color = float(ramp3[int(p.ramp)])
                }
                p.vel[2] += grav
                break
            }
            case(ptype_t.pt_explode) {
                p.ramp += time2
                if (p.ramp >= 8.0f) {
                    p.die = -1.0f
                } else {
                    p.color = float(ramp1[int(p.ramp)])
                }
                i = 0
                while (i < 3) {
                    p.vel[i] += p.vel[i] * dvel
                    i++
                }
                p.vel[2] -= grav
                break
            }
            case(ptype_t.pt_explode2) {
                p.ramp += time3
                if (p.ramp >= 8.0f) {
                    p.die = -1.0f
                } else {
                    p.color = float(ramp2[int(p.ramp)])
                }
                i = 0
                while (i < 3) {
                    p.vel[i] -= p.vel[i] * frametime
                    i++
                }
                p.vel[2] -= grav
                break
            }
            case(ptype_t.pt_blob) {
                i = 0
                while (i < 3) {
                    p.vel[i] += p.vel[i] * dvel
                    i++
                }
                p.vel[2] -= grav
                break
            }
            case(ptype_t.pt_blob2) {
                i = 0
                while (i < 2) {
                    p.vel[i] -= p.vel[i] * dvel
                    i++
                }
                p.vel[2] -= grav
                break
            }
            case(ptype_t.pt_grav, ptype_t.pt_slowgrav) {
                p.vel[2] -= grav
                break
            }
        }
        p = p.next
    }
    D_EndParticles()
}

