var ramp3 : int[8] = fixed_array(109, 107, 6, 5, 4, 3, 0, 0)
var active_particles : particle_s?
var free_particles : particle_s?
var particles : particle_s?
var r_numparticles : int
var avelocities : float[162][3]
var beamlength : float = 16.0f
var avelocity : float[3] = fixed_array(23.0f, 7.0f, 3.0f)
