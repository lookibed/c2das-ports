def R_RunParticleEffect(var org : float?; var dir : float?; color : int; count : int) {
    var p : particle_s?
    for (i in range(count)) {
        if (free_particles == null) {
            return
        }
        p = free_particles
        free_particles = p.next
        p.next = active_particles
        active_particles = p
        if (count == 1024) {
            // rocket explosion
            p.die = float(cl.time + 5.0lf)
            p.color = float(ramp1[0])
            p.ramp = float(crt::rand() & 3)
            if ((i & 1) != 0) {
                p._c_type = ptype_t.pt_explode
                for (j in range(3)) {
                    p.org[j] = org[j] + float((crt::rand() % 32) - 16)
                    p.vel[j] = float((crt::rand() % 512) - 256)
                }
            } else {
                p._c_type = ptype_t.pt_explode2
                for (j in range(3)) {
                    p.org[j] = org[j] + float((crt::rand() % 32) - 16)
                    p.vel[j] = float((crt::rand() % 512) - 256)
                }
            }
        } else {
            p.die = float(cl.time + 0.1lf * double(crt::rand() % 5))
            p.color = float((color & ~7) + (crt::rand() & 7))
            p._c_type = ptype_t.pt_slowgrav
            for (j in range(3)) {
                p.org[j] = org[j] + float((crt::rand() & 15) - 8)
                // + (rand()%300)-150;
                p.vel[j] = dir[j] * 15.0f
            }
        }
    }
}

