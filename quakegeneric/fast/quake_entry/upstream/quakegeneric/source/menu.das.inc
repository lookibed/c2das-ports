[unsafe_deref, hint(unsafe_range_check)]
def M_AdjustSliders(dir : int) {
    S_LocalSound(cstr("misc/menu3.wav"))
    c_switch(options_cursor) {
        case(3) {
            // screen size
            scr_viewsize.value += float(dir * 10)
            if (scr_viewsize.value < 30.0f) {
                scr_viewsize.value = 30.0f
            }
            if (scr_viewsize.value > 120.0f) {
                scr_viewsize.value = 120.0f
            }
            Cvar_SetValue(cstr("viewsize"), scr_viewsize.value)
            break
        }
        case(4) {
            // gamma
            v_gamma.value = float(double(v_gamma.value) - double(dir) * 0.05lf)
            if (double(v_gamma.value) < 0.5lf) {
                v_gamma.value = float(0.5lf)
            }
            if (v_gamma.value > 1.0f) {
                v_gamma.value = 1.0f
            }
            Cvar_SetValue(cstr("gamma"), v_gamma.value)
            break
        }
        case(5) {
            // mouse speed
            sensitivity.value = float(double(sensitivity.value) + double(dir) * 0.5lf)
            if (sensitivity.value < 1.0f) {
                sensitivity.value = 1.0f
            }
            if (sensitivity.value > 11.0f) {
                sensitivity.value = 11.0f
            }
            Cvar_SetValue(cstr("sensitivity"), sensitivity.value)
            break
        }
        case(6) {
            // music volume
            bgmvolume.value = float(double(bgmvolume.value) + double(dir) * 0.1lf)
            if (bgmvolume.value < 0.0f) {
                bgmvolume.value = 0.0f
            }
            if (bgmvolume.value > 1.0f) {
                bgmvolume.value = 1.0f
            }
            Cvar_SetValue(cstr("bgmvolume"), bgmvolume.value)
            break
        }
        case(7) {
            // sfx volume
            volume.value = float(double(volume.value) + double(dir) * 0.1lf)
            if (volume.value < 0.0f) {
                volume.value = 0.0f
            }
            if (volume.value > 1.0f) {
                volume.value = 1.0f
            }
            Cvar_SetValue(cstr("volume"), volume.value)
            break
        }
        case(8) {
            // allways run
            if (cl_forwardspeed.value > 200.0f) {
                Cvar_SetValue(cstr("cl_forwardspeed"), 200.0f)
                Cvar_SetValue(cstr("cl_backspeed"), 200.0f)
            } else {
                Cvar_SetValue(cstr("cl_forwardspeed"), 400.0f)
                Cvar_SetValue(cstr("cl_backspeed"), 400.0f)
            }
            break
        }
        case(9) {
            // invert mouse
            Cvar_SetValue(cstr("m_pitch"), -m_pitch.value)
            break
        }
        case(10) {
            // lookspring
            Cvar_SetValue(cstr("lookspring"), float(int_of(lookspring.value == 0.0f)))
            break
        }
        case(11) {
            // lookstrafe
            Cvar_SetValue(cstr("lookstrafe"), float(int_of(lookstrafe.value == 0.0f)))
            break
        }
    }
}

