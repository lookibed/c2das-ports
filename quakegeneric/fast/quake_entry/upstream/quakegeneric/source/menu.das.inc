    }
    serialConfig_comport = n + 1
    // map baudrate to index
    n = 0
    while (n < 6) {
        if (serialConfig_baudrate[n] == baudrate) {
            break
        }
        n++
    }
    if (n == 6) {
        n = 5
    }
    serialConfig_baud = n
    m_return_onerror = qboolean._c_false
    m_return_reason[0] = 0u8
}

