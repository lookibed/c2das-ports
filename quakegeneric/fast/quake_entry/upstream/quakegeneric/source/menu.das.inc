[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_LanConfig_Key(key : int) {
    var l : int
    c_switch(key) {
        case(27) {
            M_Menu_Net_f()
            break
        }
        case(128) {
            S_LocalSound(cstr("misc/menu1.wav"))
            lanConfig_cursor--
            if (lanConfig_cursor < 0) {
                lanConfig_cursor = NUM_LANCONFIG_CMDS - 1
            }
            break
        }
        case(129) {
            S_LocalSound(cstr("misc/menu1.wav"))
            lanConfig_cursor++
            if (lanConfig_cursor >= NUM_LANCONFIG_CMDS) {
                lanConfig_cursor = 0
            }
            break
        }
        case(13) {
            if (lanConfig_cursor == 0) {
                break
            }
            m_entersound = qboolean._c_true
            M_ConfigureNetSubsystem()
            if (lanConfig_cursor == 1) {
                if (m_multiplayer_cursor == 1) {
                    M_Menu_GameOptions_f()
                    break
                }
                M_Menu_Search_f()
                break
            }
            if (lanConfig_cursor == 2) {
                m_return_state = int(m_state)
                m_return_onerror = qboolean._c_true
                key_dest = keydest_t.key_game
                m_state = anon_968.m_none
                Cbuf_AddText(va`va(cstr("connect \"%s\"\n"), (addr(lanConfig_joinname[0]),)))
                break
            }
            break
        }
        case(127) {
            if (lanConfig_cursor == 0) {
                if (crt::strlen(addr(lanConfig_portname[0])) != 0) {
                    lanConfig_portname[crt::strlen(addr(lanConfig_portname[0])) - 1ul] = 0u8
                }
            }
            if (lanConfig_cursor == 2) {
                if (crt::strlen(addr(lanConfig_joinname[0])) != 0) {
                    lanConfig_joinname[crt::strlen(addr(lanConfig_joinname[0])) - 1ul] = 0u8
                }
            }
            break
        }
        case(_) {
            if (key < 32 || key > 127) {
                break
            }
            if (lanConfig_cursor == 2) {
                l = int(crt::strlen(addr(lanConfig_joinname[0])))
                if (l < 21) {
                    lanConfig_joinname[l + 1] = 0u8
                    lanConfig_joinname[l] = uint8(key)
                }
            }
            if (key < '0' || key > '9') {
                break
            }
            if (lanConfig_cursor == 0) {
                l = int(crt::strlen(addr(lanConfig_portname[0])))
                if (l < 5) {
                    lanConfig_portname[l + 1] = 0u8
                    lanConfig_portname[l] = uint8(key)
                }
            }
        }
    }
    if (m_multiplayer_cursor == 1 && lanConfig_cursor == 2) {
        if (key == K_UPARROW) {
            lanConfig_cursor = 1
        } else {
            lanConfig_cursor = 0
        }
    }
    l = Q_atoi(addr(lanConfig_portname[0]))
    if (l > 65535) {
        l = lanConfig_port
    } else {
        lanConfig_port = l
    }
    sprintf(addr(lanConfig_portname[0]), cstr("%u"), lanConfig_port)
}

