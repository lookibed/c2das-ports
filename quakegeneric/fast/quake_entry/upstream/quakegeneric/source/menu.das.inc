[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_SerialConfig_Key(key : int) {
    var l : int
    var _cond = key
    var _goto = 0
    while (true) {
        label 2:  // re-dispatch
        var _flag = false
        if (_cond == 27) {
            M_Menu_Net_f()
            break
        }
        if (_cond == 128) {
            S_LocalSound(cstr("misc/menu1.wav"))
            serialConfig_cursor--
            if (serialConfig_cursor < 0) {
                serialConfig_cursor = NUM_SERIALCONFIG_CMDS - 1
            }
            break
        }
        if (_cond == 129) {
            S_LocalSound(cstr("misc/menu1.wav"))
            serialConfig_cursor++
            if (serialConfig_cursor >= NUM_SERIALCONFIG_CMDS) {
                serialConfig_cursor = 0
            }
            break
        }
        if (_cond == 130) {
            if (serialConfig_cursor > 2) {
                break
            }
            S_LocalSound(cstr("misc/menu3.wav"))
            if (serialConfig_cursor == 0) {
                serialConfig_comport--
                if (serialConfig_comport == 0) {
                    serialConfig_comport = 4
                }
                serialConfig_irq = ISA_IRQs[serialConfig_comport - 1]
            }
            if (serialConfig_cursor == 1) {
                serialConfig_irq--
                if (serialConfig_irq == 6) {
                    serialConfig_irq = 5
                }
                if (serialConfig_irq == 1) {
                    serialConfig_irq = 7
                }
            }
            if (serialConfig_cursor == 2) {
                serialConfig_baud--
                if (serialConfig_baud < 0) {
                    serialConfig_baud = 5
                }
            }
            break
        }
        _flag ||= _cond == 131
        if (_flag) {
            if (serialConfig_cursor > 2) {
                break
            }
        }
        _flag ||= _goto == 1  // forward
        if (_flag) {
            _goto = 0
            S_LocalSound(cstr("misc/menu3.wav"))
            if (serialConfig_cursor == 0) {
                serialConfig_comport++
                if (serialConfig_comport > 4) {
                    serialConfig_comport = 1
                }
                serialConfig_irq = ISA_IRQs[serialConfig_comport - 1]
            }
            if (serialConfig_cursor == 1) {
                serialConfig_irq++
                if (serialConfig_irq == 6) {
                    serialConfig_irq = 7
                }
                if (serialConfig_irq == 8) {
                    serialConfig_irq = 2
                }
            }
            if (serialConfig_cursor == 2) {
                serialConfig_baud++
                if (serialConfig_baud > 5) {
                    serialConfig_baud = 0
                }
            }
            break
        }
        if (_cond == 13) {
            if (serialConfig_cursor < 3) {
                _goto = 1
                _cond = 12
                goto label 2
            }
            m_entersound = qboolean._c_true
            if (serialConfig_cursor == 3) {
                invoke(SetComPortConfig, 0, ISA_uarts[serialConfig_comport - 1], serialConfig_irq, serialConfig_baudrate[serialConfig_baud],
                        enum_from_int(type<qboolean>, int_of(m_net_cursor == 0)))
                M_Menu_ModemConfig_f()
                break
            }
            if (serialConfig_cursor == 4) {
                serialConfig_cursor = 5
                break
            }
            // serialConfig_cursor == 5 (OK/CONNECT)
            invoke(SetComPortConfig, 0, ISA_uarts[serialConfig_comport - 1], serialConfig_irq, serialConfig_baudrate[serialConfig_baud],
                    enum_from_int(type<qboolean>, int_of(m_net_cursor == 0)))
            M_ConfigureNetSubsystem()
            if (m_multiplayer_cursor == 1) {
                M_Menu_GameOptions_f()
                break
            }
            m_return_state = int(m_state)
            m_return_onerror = qboolean._c_true
            key_dest = keydest_t.key_game
            m_state = anon_968.m_none
            if (m_net_cursor == 0) {
                Cbuf_AddText(va`va(cstr("connect \"%s\"\n"), (addr(serialConfig_phone[0]),)))
            } else {
                Cbuf_AddText(cstr("connect\n"))
            }
            break
        }
        if (_cond == 127) {
            if (serialConfig_cursor == 4) {
                if (crt::strlen(addr(serialConfig_phone[0])) != 0) {
                    serialConfig_phone[crt::strlen(addr(serialConfig_phone[0])) - 1ul] = 0u8
                }
            }
            break
        }
        if (_goto == 0 && !(_cond == 27 || _cond == 128 || _cond == 129 || _cond == 130 || _cond == 131 || _cond == 13 || _cond == 127)) {
            if (key < 32 || key > 127) {
                break
            }
            if (serialConfig_cursor == 4) {
                l = int(crt::strlen(addr(serialConfig_phone[0])))
                if (l < 15) {
                    serialConfig_phone[l + 1] = 0u8
                    serialConfig_phone[l] = uint8(key)
                }
            }
        }
        break
    }
    if (m_net_cursor == 1 && (serialConfig_cursor == 3 || serialConfig_cursor == 4)) {
        if (key == K_UPARROW) {
            serialConfig_cursor = 2
        } else {
            serialConfig_cursor = 5
        }
    }
    if (m_net_cursor == 0 && m_multiplayer_cursor == 1 && serialConfig_cursor == 4) {
        if (key == K_UPARROW) {
            serialConfig_cursor = 3
        } else {
            serialConfig_cursor = 5
        }
    }
}

