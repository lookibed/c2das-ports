[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Setup_Key(k : int) {
    var l : int
    var _cond = k
    var _goto = 0
    while (true) {
        label 2:  // re-dispatch
        var _flag = false
        if (_cond == 27) {
            M_Menu_MultiPlayer_f()
            break
        }
        if (_cond == 128) {
            S_LocalSound(cstr("misc/menu1.wav"))
            setup_cursor--
            if (setup_cursor < 0) {
                setup_cursor = NUM_SETUP_CMDS - 1
            }
            break
        }
        if (_cond == 129) {
            S_LocalSound(cstr("misc/menu1.wav"))
            setup_cursor++
            if (setup_cursor >= NUM_SETUP_CMDS) {
                setup_cursor = 0
            }
            break
        }
        if (_cond == 130) {
            if (setup_cursor < 2) {
                return
            }
            S_LocalSound(cstr("misc/menu3.wav"))
            if (setup_cursor == 2) {
                setup_top -= 1
            }
            if (setup_cursor == 3) {
                setup_bottom -= 1
            }
            break
        }
        _flag ||= _cond == 131
        if (_flag) {
            if (setup_cursor < 2) {
                return
            }
        }
        _flag ||= _goto == 1  // forward
        if (_flag) {
            _goto = 0
            S_LocalSound(cstr("misc/menu3.wav"))
            if (setup_cursor == 2) {
                setup_top += 1
            }
            if (setup_cursor == 3) {
                setup_bottom += 1
            }
            break
        }
        if (_cond == 13) {
            if (setup_cursor == 0 || setup_cursor == 1) {
                return
            }
            if (setup_cursor == 2 || setup_cursor == 3) {
                _goto = 1
                _cond = 12
                goto label 2
            }
            // setup_cursor == 4 (OK)
            if (Q_strcmp(cl_name._c_string, addr(setup_myname[0])) != 0) {
                Cbuf_AddText(va`va(cstr("name \"%s\"\n"), (addr(setup_myname[0]),)))
            }
            if (Q_strcmp(hostname._c_string, addr(setup_hostname[0])) != 0) {
                Cvar_Set(cstr("hostname"), addr(setup_hostname[0]))
            }
            if (setup_top != setup_oldtop || setup_bottom != setup_oldbottom) {
                Cbuf_AddText(va`va(cstr("color %i %i\n"), (setup_top, setup_bottom)))
            }
            m_entersound = qboolean._c_true
            M_Menu_MultiPlayer_f()
            break
        }
        if (_cond == 127) {
            if (setup_cursor == 0) {
                if (crt::strlen(addr(setup_hostname[0])) != 0) {
                    setup_hostname[crt::strlen(addr(setup_hostname[0])) - 1ul] = 0u8
                }
            }
            if (setup_cursor == 1) {
                if (crt::strlen(addr(setup_myname[0])) != 0) {
                    setup_myname[crt::strlen(addr(setup_myname[0])) - 1ul] = 0u8
                }
            }
            break
        }
        if (_goto == 0 && !(_cond == 27 || _cond == 128 || _cond == 129 || _cond == 130 || _cond == 131 || _cond == 13 || _cond == 127)) {
            if (k < 32 || k > 127) {
                break
            }
            if (setup_cursor == 0) {
                l = int(crt::strlen(addr(setup_hostname[0])))
                if (l < 15) {
                    setup_hostname[l + 1] = 0u8
                    setup_hostname[l] = uint8(k)
                }
            }
            if (setup_cursor == 1) {
                l = int(crt::strlen(addr(setup_myname[0])))
                if (l < 15) {
                    setup_myname[l + 1] = 0u8
                    setup_myname[l] = uint8(k)
                }
            }
        }
        break
    }
    if (setup_top > 13) {
        setup_top = 0
    }
    if (setup_top < 0) {
        setup_top = 13
    }
    if (setup_bottom > 13) {
        setup_bottom = 0
    }
    if (setup_bottom < 0) {
        setup_bottom = 13
    }
}

