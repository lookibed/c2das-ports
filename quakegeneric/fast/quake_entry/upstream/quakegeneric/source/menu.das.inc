[unsafe_deref, hint(unsafe_range_check)]
def M_SinglePlayer_Key(key : int) {
    c_switch(key) {
        case(27) {
            M_Menu_Main_f()
            break
        }
        case(129) {
            S_LocalSound(cstr("misc/menu1.wav"))
            m_singleplayer_cursor++
            if (m_singleplayer_cursor >= SINGLEPLAYER_ITEMS) {
                m_singleplayer_cursor = 0
            }
            break
        }
        case(128) {
            S_LocalSound(cstr("misc/menu1.wav"))
            m_singleplayer_cursor--
            if (m_singleplayer_cursor < 0) {
                m_singleplayer_cursor = SINGLEPLAYER_ITEMS - 1
            }
            break
        }
        case(13) {
            m_entersound = qboolean._c_true
            c_switch(m_singleplayer_cursor) {
                case(0) {
                    if (int(sv.active) != 0) {
                        if (SCR_ModalMessage(cstr("Are you sure you want to\nstart a new game?\n")) == 0) {
                            break
                        }
                    }
                    key_dest = keydest_t.key_game
                    if (int(sv.active) != 0) {
                        Cbuf_AddText(cstr("disconnect\n"))
                    }
                    Cbuf_AddText(cstr("maxplayers 1\n"))
                    Cbuf_AddText(cstr("map start\n"))
                    break
                }
                case(1) {
                    M_Menu_Load_f()
                    break
                }
                case(2) {
                    M_Menu_Save_f()
                    break
                }
            }
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_ScanSaves {
    var j : int
    var name : uint8[128]
    var f : _IO_FILE?
    var version : int
    for (i in range(MAX_SAVEGAMES)) {
        crt::strcpy(addr(m_filenames[i][0]), cstr("--- UNUSED SLOT ---"))
        loadable[i] = int(qboolean._c_false)
        sprintf(addr(name[0]), cstr("%s/s%i.sav"), addr(com_gamedir[0]), i)
        f = reinterpret<_IO_FILE?>(crt::fopen(addr(name[0]), cstr("r")))
        if (f == null) {
            continue
        }
        fscanf(reinterpret<void?>(f), cstr("%i\n"), addr(version))
        fscanf(reinterpret<void?>(f), cstr("%79s\n"), addr(name[0]))
        crt::strncpy(addr(m_filenames[i][0]), addr(name[0]), uint64(typeinfo sizeof(type<uint8[40]>)) - 1ul)
        // change _ back to space
        j = 0
        while (j < SAVEGAME_COMMENT_LENGTH) {
            if (m_filenames[i][j] == '_') {
                m_filenames[i][j] = uint8(' ')
            }
            j++
        }
        loadable[i] = int(qboolean._c_true)
        crt::fclose(reinterpret<void?>(f))
    }
}

