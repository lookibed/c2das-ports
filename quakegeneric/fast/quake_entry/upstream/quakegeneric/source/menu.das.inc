[unsafe_deref, hint(unsafe_range_check)]
def M_ToggleMenu_f {
    m_entersound = qboolean._c_true
    if (key_dest == keydest_t.key_menu) {
        if (m_state != anon_968.m_main) {
            M_Menu_Main_f()
            return
        }
        key_dest = keydest_t.key_game
        m_state = anon_968.m_none
        return
    }
    if (key_dest == keydest_t.key_console) {
        Con_ToggleConsole_f()
    } else {
        M_Menu_Main_f()
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def M_Menu_Main_f {
    if (key_dest != keydest_t.key_menu) {
        m_save_demonum = cls.demonum
        cls.demonum = -1
    }
    key_dest = keydest_t.key_menu
    m_state = anon_968.m_main
    m_entersound = qboolean._c_true
}

[unsafe_deref, hint(unsafe_range_check)]
def M_Main_Draw {
    var f : int
    var p : qpic_t?
    M_DrawTransPic(16, 4, Draw_CachePic(cstr("gfx/qplaque.lmp")))
    p = Draw_CachePic(cstr("gfx/ttl_main.lmp"))
    M_DrawPic((320 - p.width) / 2, 4, p)
    M_DrawTransPic(72, 32, Draw_CachePic(cstr("gfx/mainmenu.lmp")))
    f = int(host_time * 10.0lf) % 6
    M_DrawTransPic(54, 32 + m_main_cursor * 20, Draw_CachePic(va`va(cstr("gfx/menudot%i.lmp"), (f + 1,))))
}

[unsafe_deref, hint(unsafe_range_check)]
def M_Main_Key(key : int) {
    c_switch(key) {
        case(27) {
            key_dest = keydest_t.key_game
            m_state = anon_968.m_none
            cls.demonum = m_save_demonum
            if (cls.demonum != -1 && int(cls.demoplayback) == 0 && cls.state != cactive_t.ca_connected) {
                CL_NextDemo()
            }
            break
        }
        case(129) {
            S_LocalSound(cstr("misc/menu1.wav"))
            m_main_cursor++
            if (m_main_cursor >= MAIN_ITEMS) {
                m_main_cursor = 0
            }
            break
        }
        case(128) {
            S_LocalSound(cstr("misc/menu1.wav"))
            m_main_cursor--
            if (m_main_cursor < 0) {
                m_main_cursor = MAIN_ITEMS - 1
            }
            break
        }
        case(13) {
            m_entersound = qboolean._c_true
            c_switch(m_main_cursor) {
                case(0) {
                    M_Menu_SinglePlayer_f()
                    break
                }
                case(1) {
                    M_Menu_MultiPlayer_f()
                    break
                }
                case(2) {
                    M_Menu_Options_f()
                    break
                }
                case(3) {
                    M_Menu_Help_f()
                    break
                }
                case(4) {
                    M_Menu_Quit_f()
                    break
                }
            }
        }
    }
}

