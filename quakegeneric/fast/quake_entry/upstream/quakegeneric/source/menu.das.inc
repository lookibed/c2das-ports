    Draw_TransPicTranslate(int(uint(x) + ((vid.width - 320u) >> 1u)), y, pic, addr(translationTable[0]))
}

[unsafe_deref, hint(unsafe_range_check)]
def M_DrawTextBox(x : int; y : int; var width : int; lines : int) {
    var p : qpic_t?
    var cx : int
    var cy : int
    // draw left side
    cx = x
    cy = y
    p = Draw_CachePic(cstr("gfx/box_tl.lmp"))
    M_DrawTransPic(cx, cy, p)
    p = Draw_CachePic(cstr("gfx/box_ml.lmp"))
    for (n in range(lines)) {
        cy += 8
        M_DrawTransPic(cx, cy, p)
    }
    p = Draw_CachePic(cstr("gfx/box_bl.lmp"))
    M_DrawTransPic(cx, cy + 8, p)
    // draw middle
    cx += 8
    while (width > 0) {
        cy = y
        p = Draw_CachePic(cstr("gfx/box_tm.lmp"))
        M_DrawTransPic(cx, cy, p)
        p = Draw_CachePic(cstr("gfx/box_mm.lmp"))
        for (n in range(lines)) {
            cy += 8
            if (n == 1) {
                p = Draw_CachePic(cstr("gfx/box_mm2.lmp"))
            }
            M_DrawTransPic(cx, cy, p)
        }
        p = Draw_CachePic(cstr("gfx/box_bm.lmp"))
        M_DrawTransPic(cx, cy + 8, p)
        width -= 2
        cx += 16
    }
    // draw right side
    cy = y
    p = Draw_CachePic(cstr("gfx/box_tr.lmp"))
    M_DrawTransPic(cx, cy, p)
    p = Draw_CachePic(cstr("gfx/box_mr.lmp"))
    for (n in range(lines)) {
        cy += 8
        M_DrawTransPic(cx, cy, p)
    }
    p = Draw_CachePic(cstr("gfx/box_br.lmp"))
    M_DrawTransPic(cx, cy + 8, p)
}

