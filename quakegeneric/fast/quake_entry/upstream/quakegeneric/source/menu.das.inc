[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_FindKeysForCommand(var command : uint8?; var twokeys : int?) {
    var count : int
    var l : int
    var b : uint8?
    twokeys[1] = -1
    twokeys[0] = twokeys[1]
    l = int(crt::strlen(command))
    count = 0
    for (j in range(256)) {
        b = keybindings[j]
        if (b == null) {
            continue
        }
        if (crt::strncmp(b, command, uint64(l)) == 0) {
            twokeys[count] = j
            count++
            if (count == 2) {
                break
            }
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_UnbindCommand(var command : uint8?) {
    var l : int
    var b : uint8?
    l = int(crt::strlen(command))
    for (j in range(256)) {
        b = keybindings[j]
        if (b == null) {
            continue
        }
        if (crt::strncmp(b, command, uint64(l)) == 0) {
            Key_SetBinding(j, addr(c2das_empty[0]))
        }
    }
}

