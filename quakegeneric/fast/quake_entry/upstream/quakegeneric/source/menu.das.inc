[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Keys_Key(k : int) {
    var cmd : uint8[80]
    var keys : int[2]
    if (bind_grab != 0) {
        // defining a key
        S_LocalSound(cstr("misc/menu1.wav"))
        if (k == K_ESCAPE) {
            bind_grab = int(qboolean._c_false)
        } elif (k != '`') {
            sprintf(addr(cmd[0]), cstr("bind \"%s\" \"%s\"\n"), Key_KeynumToString(k), bindnames[keys_cursor][0])
            Cbuf_InsertText(addr(cmd[0]))
        }
        bind_grab = int(qboolean._c_false)
        return
    }
    c_switch(k) {
        case(27) {
            M_Menu_Options_f()
            break
        }
        case(130, 128) {
            S_LocalSound(cstr("misc/menu1.wav"))
            keys_cursor--
            if (keys_cursor < 0) {
                keys_cursor = int(NUMCOMMANDS - 1ul)
            }
            break
        }
        case(129, 131) {
            S_LocalSound(cstr("misc/menu1.wav"))
            keys_cursor++
            if (uint64(keys_cursor) >= NUMCOMMANDS) {
                keys_cursor = 0
            }
            break
        }
        case(13) {
            // go into bind mode
            M_FindKeysForCommand(bindnames[keys_cursor][0], addr(keys[0]))
            S_LocalSound(cstr("misc/menu2.wav"))
            if (keys[1] != -1) {
                M_UnbindCommand(bindnames[keys_cursor][0])
            }
            bind_grab = int(qboolean._c_true)
            break
        }
        case(127, 148) {
            // delete bindings
            // delete bindings
            S_LocalSound(cstr("misc/menu2.wav"))
            M_UnbindCommand(bindnames[keys_cursor][0])
            break
        }
    }
}

