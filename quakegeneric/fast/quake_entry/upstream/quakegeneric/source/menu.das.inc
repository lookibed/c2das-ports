[unsafe_deref, hint(unsafe_range_check)]
def M_NetStart_Change(dir : int) {
    var count : int
    c_switch(gameoptions_cursor) {
        case(1) {
            maxplayers += dir
            if (maxplayers > svs.maxclientslimit) {
                maxplayers = svs.maxclientslimit
                m_serverInfoMessage = qboolean._c_true
                m_serverInfoMessageTime = realtime
            }
            if (maxplayers < 2) {
                maxplayers = 2
            }
            break
        }
        case(2) {
            Cvar_SetValue(cstr("coop"), float(coop.value != 0.0f ? 0 : 1))
            break
        }
        case(3) {
            if (int(rogue) != 0) {
                count = 6
            } else {
                count = 2
            }
            Cvar_SetValue(cstr("teamplay"), teamplay.value + float(dir))
            if (teamplay.value > float(count)) {
                Cvar_SetValue(cstr("teamplay"), 0.0f)
            } elif (teamplay.value < 0.0f) {
                Cvar_SetValue(cstr("teamplay"), float(count))
            }
            break
        }
        case(4) {
            Cvar_SetValue(cstr("skill"), skill.value + float(dir))
            if (skill.value > 3.0f) {
                Cvar_SetValue(cstr("skill"), 0.0f)
            }
            if (skill.value < 0.0f) {
                Cvar_SetValue(cstr("skill"), 3.0f)
            }
            break
        }
        case(5) {
            Cvar_SetValue(cstr("fraglimit"), fraglimit.value + float(dir * 10))
            if (fraglimit.value > 100.0f) {
                Cvar_SetValue(cstr("fraglimit"), 0.0f)
            }
            if (fraglimit.value < 0.0f) {
                Cvar_SetValue(cstr("fraglimit"), 100.0f)
            }
            break
        }
        case(6) {
            Cvar_SetValue(cstr("timelimit"), timelimit.value + float(dir * 5))
            if (timelimit.value > 60.0f) {
                Cvar_SetValue(cstr("timelimit"), 0.0f)
            }
            if (timelimit.value < 0.0f) {
                Cvar_SetValue(cstr("timelimit"), 60.0f)
            }
            break
        }
        case(7) {
            startepisode += dir
            // MED 01/06/97 added hipnotic count
            if (int(hipnotic) != 0) {
                count = 6
            } elif (int(rogue) != 0) {
                // PGM 01/07/97 added rogue count
                // PGM 03/02/97 added 1 for dmatch episode
                count = 4
            } elif (registered.value != 0.0f) {
                count = 7
            } else {
                count = 2
            }
            if (startepisode < 0) {
                startepisode = count - 1
            }
            if (startepisode >= count) {
                startepisode = 0
            }
            startlevel = 0
            break
        }
        case(8) {
            startlevel += dir
            // MED 01/06/97 added hipnotic episodes
            if (int(hipnotic) != 0) {
                count = hipnoticepisodes[startepisode].levels
            } elif (int(rogue) != 0) {
                // PGM 01/06/97 added hipnotic episodes
                count = rogueepisodes[startepisode].levels
            } else {
                count = episodes[startepisode].levels
            }
            if (startlevel < 0) {
                startlevel = count - 1
            }
            if (startlevel >= count) {
                startlevel = 0
            }
            break
        }
    }
}

