// generated by c2das - regenerate, never edit
struct moveclip_t {
    boxmins, boxmaxs : float[3]
    mins, maxs : float?
    mins2, maxs2 : float[3]
    start, end : float?
    trace : trace_t
    _c_type : int
    passedict : edict_s?
}

struct areanode_s {
    axis : int
    dist : float
    children : areanode_s? [2]
    trigger_edicts, solid_edicts : link_s
}

var private box_hull : hull_t
var private box_clipnodes : dclipnode_t[6]
var private box_planes : mplane_s[6]
var private sv_areanodes : areanode_s[32]
var private sv_numareanodes : int

// ===================
// SV_InitBoxHull
// Set up the planes and clipnodes so that the six floats of a bounding box
// can just be stored out and get a proper hull_t structure.
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_InitBoxHull {
    var side : int
    box_hull.clipnodes = addr(box_clipnodes[0])
    box_hull.planes = addr(box_planes[0])
    box_hull.firstclipnode = 0
    box_hull.lastclipnode = 5
    for (i in range(6)) {
        box_clipnodes[i].planenum = i
        side = i & 1
        box_clipnodes[i].children[side] = int16(CONTENTS_EMPTY)
        if (i != 5) {
            box_clipnodes[i].children[side ^ 1] = int16(i + 1)
        } else {
            box_clipnodes[i].children[side ^ 1] = int16(CONTENTS_SOLID)
        }
        box_planes[i]._c_type = uint8(i >> 1)
        box_planes[i].normal[i >> 1] = 1.0f
    }
}

// ===================
// SV_HullForBox
// To keep everything totally uniform, bounding boxes are turned into small
// BSP trees instead of being compared directly.
// ===================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_HullForBox(var mins : float?; var maxs : float?) : hull_t? {
    box_planes[0].dist = maxs[0]
    box_planes[1].dist = mins[0]
    box_planes[2].dist = maxs[1]
    box_planes[3].dist = mins[1]
    box_planes[4].dist = maxs[2]
    box_planes[5].dist = mins[2]
    return addr(box_hull)
}

// ================
// SV_HullForEntity
// Returns a hull that can be used for testing or clipping an object of mins/maxs
// size.
// Offset is filled in to contain the adjustment that must be added to the
// testing object's origin to get a point to use with the returned hull.
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_HullForEntity(var ent : edict_s?; var mins : float?; var maxs : float?; var offset : float?) : hull_t? {
    var model : model_s?
    var size : float[3]
    var hullmins : float[3]
    var hullmaxs : float[3]
    var hull : hull_t?
    // decide which clipping hull to use, based on the size
    if (ent.v.solid == float(SOLID_BSP)) {
        // explicit hulls in the BSP model
        if (ent.v.movetype != float(MOVETYPE_PUSH)) {
            Sys_Error`va(cstr("SOLID_BSP without MOVETYPE_PUSH"), VaNone())
        }
        model = sv.models[int(ent.v.modelindex)]
        if (model == null || model._c_type != modtype_t.mod_brush) {
            Sys_Error`va(cstr("MOVETYPE_PUSH with a non bsp model"), VaNone())
        }
        VectorSubtract(maxs, mins, size)
        if (size[0] < 3.0f) {
            hull = addr(model.hulls[0])
        } elif (size[0] <= 32.0f) {
            hull = addr(model.hulls[1])
        } else {
            hull = addr(model.hulls[2])
        }
        // calculate an offset value to center the origin
        offset[0] = hull.clip_mins[0] - mins[0]
        offset[1] = hull.clip_mins[1] - mins[1]
        offset[2] = hull.clip_mins[2] - mins[2]
        offset[0] += ent.v.origin[0]
        offset[1] += ent.v.origin[1]
        offset[2] += ent.v.origin[2]
    } else {
        // create a temp hull from bounding box sizes
        hullmins[0] = ent.v.mins[0] - maxs[0]
        hullmins[1] = ent.v.mins[1] - maxs[1]
        hullmins[2] = ent.v.mins[2] - maxs[2]
        hullmaxs[0] = ent.v.maxs[0] - mins[0]
        hullmaxs[1] = ent.v.maxs[1] - mins[1]
        hullmaxs[2] = ent.v.maxs[2] - mins[2]
        hull = SV_HullForBox(addr(hullmins[0]), addr(hullmaxs[0]))
        offset[0] = ent.v.origin[0]
        offset[1] = ent.v.origin[1]
        offset[2] = ent.v.origin[2]
    }
    return hull
}

// ===============
// SV_CreateAreaNode
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_CreateAreaNode(depth : int; var mins : float?; var maxs : float?) : areanode_s? {
    var anode : areanode_s?
    var size : float[3]
    var mins1 : float[3]
    var maxs1 : float[3]
    var mins2 : float[3]
    var maxs2 : float[3]
    anode = addr(sv_areanodes[0]) + end_index(sv_numareanodes, 32)
    sv_numareanodes++
    ClearLink(addr(anode.trigger_edicts))
    ClearLink(addr(anode.solid_edicts))
    if (depth == AREA_DEPTH) {
        anode.axis = -1
        anode.children[1] = null
        anode.children[0] = anode.children[1]
        return anode
    }
    VectorSubtract(maxs, mins, size)
    if (size[0] > size[1]) {
        anode.axis = 0
    } else {
        anode.axis = 1
    }
    anode.dist = float(0.5lf * double(maxs[anode.axis] + mins[anode.axis]))
    VectorCopy(mins, mins1)
    VectorCopy(mins, mins2)
    VectorCopy(maxs, maxs1)
    VectorCopy(maxs, maxs2)
    mins2[anode.axis] = anode.dist
    maxs1[anode.axis] = mins2[anode.axis]
    anode.children[0] = SV_CreateAreaNode(depth + 1, addr(mins2[0]), addr(maxs2[0]))
    anode.children[1] = SV_CreateAreaNode(depth + 1, addr(mins1[0]), addr(maxs1[0]))
    return anode
}

// ===============
// SV_ClearWorld
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_ClearWorld {
    SV_InitBoxHull()
    crt::memset(reinterpret<void?>(addr(sv_areanodes[0])), 0, uint64(typeinfo sizeof(type<areanode_s[32]>)))
    sv_numareanodes = 0
    SV_CreateAreaNode(0, addr(sv.worldmodel.mins[0]), addr(sv.worldmodel.maxs[0]))
}

// ===============
// SV_UnlinkEdict
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_UnlinkEdict(var ent : edict_s?) {
    if (ent.area.prev == null) {
        // not linked in anywhere
        return
    }
    RemoveLink(addr(ent.area))
    ent.area.next = null
    ent.area.prev = ent.area.next
}

// ====================
// SV_TouchLinks
// ====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_TouchLinks(var ent : edict_s?; var node : areanode_s?) {
    var l : link_s?
    var next : link_s?
    var touch : edict_s?
    var old_self : int
    var old_other : int
    // touch linked edicts
    l = node.trigger_edicts.next
    while (intptr(l) != intptr(addr(node.trigger_edicts))) {
        {
            next = l.next
            touch = EDICT_FROM_AREA(l)
            if (intptr(touch) == intptr(ent)) {
                continue
            }
            if (touch.v.touch == 0 || touch.v.solid != float(SOLID_TRIGGER)) {
                continue
            }
            if (ent.v.absmin[0] > touch.v.absmax[0] || ent.v.absmin[1] > touch.v.absmax[1] || ent.v.absmin[2] > touch.v.absmax[2] ||
                    ent.v.absmax[0] < touch.v.absmin[0] || ent.v.absmax[1] < touch.v.absmin[1] || ent.v.absmax[2] < touch.v.absmin[2]) {
                continue
            }
            old_self = pr_global_struct.self
            old_other = pr_global_struct.other
            pr_global_struct.self = int(EDICT_TO_PROG(touch))
            pr_global_struct.other = int(EDICT_TO_PROG(ent))
            pr_global_struct.time = float(sv.time)
            PR_ExecuteProgram(touch.v.touch)
            pr_global_struct.self = old_self
            pr_global_struct.other = old_other
        } finally {
            l = next
        }
    }
    // recurse down both sides
    if (node.axis == -1) {
        return
    }
    if (ent.v.absmax[node.axis] > node.dist) {
        SV_TouchLinks(ent, node.children[0])
    }
    if (ent.v.absmin[node.axis] < node.dist) {
        SV_TouchLinks(ent, node.children[1])
    }
}

// ===============
// SV_FindTouchedLeafs
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_FindTouchedLeafs(var ent : edict_s?; var node : mnode_s?) {
    var splitplane : mplane_s?
    var leaf : mleaf_s?
    var sides : int
    var leafnum : int
    if (node.contents == CONTENTS_SOLID) {
        return
    }
    // add an efrag if the node is a leaf
    if (node.contents < 0) {
        if (ent.num_leafs == MAX_ENT_LEAFS) {
            return
        }
        leaf = reinterpret<mleaf_s?>(node)
        leafnum = int(int64(leaf - sv.worldmodel.leafs) - 1l)
        ent.leafnums[ent.num_leafs] = int16(leafnum)
        ent.num_leafs++
        return
    }
    // NODE_MIXED
    splitplane = node.plane
    sides = int(splitplane._c_type) < 3 ? (splitplane.dist <= ent.v.absmin[int(splitplane._c_type)] ? 1 :
                (splitplane.dist >= ent.v.absmax[int(splitplane._c_type)] ? 2 : 3)) : BoxOnPlaneSide(addr(ent.v.absmin[0]),
            addr(ent.v.absmax[0]), splitplane)
    // recurse down the contacted sides
    if ((sides & 1) != 0) {
        SV_FindTouchedLeafs(ent, node.children[0])
    }
    if ((sides & 2) != 0) {
        SV_FindTouchedLeafs(ent, node.children[1])
    }
}

// ===============
// SV_LinkEdict
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_LinkEdict(var ent : edict_s?; touch_triggers : qboolean) {
    var node : areanode_s?
    if (ent.area.prev != null) {
        // unlink from old position
        SV_UnlinkEdict(ent)
    }
    if (intptr(ent) == intptr(sv.edicts)) {
        // don't add the world
        return
    }
    if (int(ent.free) != 0) {
        return
    }
    // set the abs box
    ent.v.absmin[0] = ent.v.origin[0] + ent.v.mins[0]
    ent.v.absmin[1] = ent.v.origin[1] + ent.v.mins[1]
    ent.v.absmin[2] = ent.v.origin[2] + ent.v.mins[2]
    ent.v.absmax[0] = ent.v.origin[0] + ent.v.maxs[0]
    ent.v.absmax[1] = ent.v.origin[1] + ent.v.maxs[1]
    ent.v.absmax[2] = ent.v.origin[2] + ent.v.maxs[2]
    // to make items easier to pick up and allow them to be grabbed off
    // of shelves, the abs sizes are expanded
    if ((int(ent.v.flags) & FL_ITEM) != 0) {
        ent.v.absmin[0] -= 15.0f
        ent.v.absmin[1] -= 15.0f
        ent.v.absmax[0] += 15.0f
        ent.v.absmax[1] += 15.0f
    } else {
        // because movement is clipped an epsilon away from an actual edge,
        // we must fully check even when bounding boxes don't quite touch
        ent.v.absmin[0] -= 1.0f
        ent.v.absmin[1] -= 1.0f
        ent.v.absmin[2] -= 1.0f
        ent.v.absmax[0] += 1.0f
        ent.v.absmax[1] += 1.0f
        ent.v.absmax[2] += 1.0f
    }
    // link to PVS leafs
    ent.num_leafs = 0
    if (ent.v.modelindex != 0.0f) {
        SV_FindTouchedLeafs(ent, sv.worldmodel.nodes)
    }
    if (ent.v.solid == float(SOLID_NOT)) {
        return
    }
    // find the first node that the ent's box crosses
    node = addr(sv_areanodes[0])
    while (1 != 0) {
        if (node.axis == -1) {
            break
        }
        if (ent.v.absmin[node.axis] > node.dist) {
            node = node.children[0]
        } elif (ent.v.absmax[node.axis] < node.dist) {
            node = node.children[1]
        } else {
            // crosses the node
            break
        }
    }
    // link it in
    if (ent.v.solid == float(SOLID_TRIGGER)) {
        InsertLinkBefore(addr(ent.area), addr(node.trigger_edicts))
    } else {
        InsertLinkBefore(addr(ent.area), addr(node.solid_edicts))
    }
    // if touch_triggers, touch all entities at this node and decend for more
    if (int(touch_triggers) != 0) {
        SV_TouchLinks(ent, addr(sv_areanodes[0]))
    }
}

// ==================
// SV_HullPointContents
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_HullPointContents(var hull : hull_t?; var num : int; var p : float?) : int {
    var d : float
    var node : dclipnode_t?
    var plane : mplane_s?
    while (num >= 0) {
        if (num < hull.firstclipnode || num > hull.lastclipnode) {
            Sys_Error`va(cstr("SV_HullPointContents: bad node number"), VaNone())
        }
        node = hull.clipnodes + num
        plane = hull.planes + node.planenum
        if (int(plane._c_type) < 3) {
            d = p[int(plane._c_type)] - plane.dist
        } else {
            d = plane.normal[0] * p[0] + plane.normal[1] * p[1] + plane.normal[2] * p[2] - plane.dist
        }
        if (d < 0.0f) {
            num = int(node.children[1])
        } else {
            num = int(node.children[0])
        }
    }
    return num
}

// ==================
// SV_PointContents
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_PointContents(var p : float?) : int {
    var cont : int
    cont = SV_HullPointContents(addr(sv.worldmodel.hulls[0]), 0, p)
    if (cont <= CONTENTS_CURRENT_0 && cont >= CONTENTS_CURRENT_DOWN) {
        cont = CONTENTS_WATER
    }
    return cont
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_TruePointContents(var p : float?) : int {
    return SV_HullPointContents(addr(sv.worldmodel.hulls[0]), 0, p)
}

// ============
// SV_TestEntityPosition
// This could be a lot more efficient...
// ============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_TestEntityPosition(var ent : edict_s?) : edict_s? {
    var trace : trace_t
    trace = SV_Move(addr(ent.v.origin[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(ent.v.origin[0]), 0, ent)
    if (int(trace.startsolid) != 0) {
        return sv.edicts
    }
    return null
}

// ==================
// SV_RecursiveHullCheck
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_RecursiveHullCheck(var hull : hull_t?; num : int; p1f : float; p2f : float; var p1 : float?; var p2 : float?; var trace : trace_t?) : qboolean {
    var node : dclipnode_t?
    var plane : mplane_s?
    var t1 : float
    var t2 : float
    var frac : float
    var mid : float[3]
    var side : int
    var midf : float
    // check for empty
    if (num < 0) {
        if (num != CONTENTS_SOLID) {
            trace.allsolid = qboolean._c_false
            if (num == CONTENTS_EMPTY) {
                trace.inopen = qboolean._c_true
            } else {
                trace.inwater = qboolean._c_true
            }
        } else {
            trace.startsolid = qboolean._c_true
        }
        // empty
        return qboolean._c_true
    }
    if (num < hull.firstclipnode || num > hull.lastclipnode) {
        Sys_Error`va(cstr("SV_RecursiveHullCheck: bad node number"), VaNone())
    }
    // find the point distances
    node = hull.clipnodes + num
    plane = hull.planes + node.planenum
    if (int(plane._c_type) < 3) {
        t1 = p1[int(plane._c_type)] - plane.dist
        t2 = p2[int(plane._c_type)] - plane.dist
    } else {
        t1 = plane.normal[0] * p1[0] + plane.normal[1] * p1[1] + plane.normal[2] * p1[2] - plane.dist
        t2 = plane.normal[0] * p2[0] + plane.normal[1] * p2[1] + plane.normal[2] * p2[2] - plane.dist
    }
    if (t1 >= 0.0f && t2 >= 0.0f) {
        return SV_RecursiveHullCheck(hull, int(node.children[0]), p1f, p2f, p1, p2, trace)
    }
    if (t1 < 0.0f && t2 < 0.0f) {
        return SV_RecursiveHullCheck(hull, int(node.children[1]), p1f, p2f, p1, p2, trace)
    }
    // put the crosspoint DIST_EPSILON pixels on the near side
    if (t1 < 0.0f) {
        frac = float((double(t1) + DIST_EPSILON) / double(t1 - t2))
    } else {
        frac = float((double(t1) - DIST_EPSILON) / double(t1 - t2))
    }
    if (frac < 0.0f) {
        frac = 0.0f
    }
    if (frac > 1.0f) {
        frac = 1.0f
    }
    midf = p1f + (p2f - p1f) * frac
    for (i in range(3)) {
        mid[i] = p1[i] + frac * (p2[i] - p1[i])
    }
    side = int_of(t1 < 0.0f)
    // move up to the node
    if (int(SV_RecursiveHullCheck(hull, int(node.children[side]), p1f, midf, p1, addr(mid[0]), trace)) == 0) {
        return qboolean._c_false
    }
    if (SV_HullPointContents(hull, int(node.children[side ^ 1]), addr(mid[0])) != CONTENTS_SOLID) {
        // go past the node
        return SV_RecursiveHullCheck(hull, int(node.children[side ^ 1]), midf, p2f, addr(mid[0]), p2, trace)
    }
    if (int(trace.allsolid) != 0) {
        // never got out of the solid area
        return qboolean._c_false
    }
    // ==================
    // the other side of the node is solid, this is the impact point
    // ==================
    if (side == 0) {
        trace.plane.normal[0] = plane.normal[0]
        trace.plane.normal[1] = plane.normal[1]
        trace.plane.normal[2] = plane.normal[2]
        trace.plane.dist = plane.dist
    } else {
        trace.plane.normal[0] = vec3_origin[0] - plane.normal[0]
        trace.plane.normal[1] = vec3_origin[1] - plane.normal[1]
        trace.plane.normal[2] = vec3_origin[2] - plane.normal[2]
        trace.plane.dist = -plane.dist
    }
    while (SV_HullPointContents(hull, hull.firstclipnode, addr(mid[0])) == CONTENTS_SOLID) {
        // shouldn't really happen, but does occasionally
        frac = float(double(frac) - 0.1lf)
        if (frac < 0.0f) {
            trace.fraction = midf
            trace.endpos[0] = mid[0]
            trace.endpos[1] = mid[1]
            trace.endpos[2] = mid[2]
            Con_DPrintf`va(cstr("backup past 0\n"), VaNone())
            return qboolean._c_false
        }
        midf = p1f + (p2f - p1f) * frac
        for (i in range(3)) {
            mid[i] = p1[i] + frac * (p2[i] - p1[i])
        }
    }
    trace.fraction = midf
    trace.endpos[0] = mid[0]
    trace.endpos[1] = mid[1]
    trace.endpos[2] = mid[2]
    return qboolean._c_false
}

// ==================
// SV_ClipMoveToEntity
// Handles selection or creation of a clipping hull, and offseting (and
// eventually rotation) of the end points
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_ClipMoveToEntity(var ent : edict_s?; var start : float?; var mins : float?; var maxs : float?; var end : float?) : trace_t {
    var trace : trace_t
    var offset : float[3]
    var start_l : float[3]
    var end_l : float[3]
    var hull : hull_t?
    // fill in a default trace
    crt::memset(reinterpret<void?>(addr(trace)), 0, uint64(typeinfo sizeof(type<trace_t>)))
    trace.fraction = 1.0f
    trace.allsolid = qboolean._c_true
    trace.endpos[0] = end[0]
    trace.endpos[1] = end[1]
    trace.endpos[2] = end[2]
    // get the clipping hull
    hull = SV_HullForEntity(ent, mins, maxs, addr(offset[0]))
    VectorSubtract(start, offset, start_l)
    VectorSubtract(end, offset, end_l)
    // trace a line through the apropriate clipping hull
    SV_RecursiveHullCheck(hull, hull.firstclipnode, 0.0f, 1.0f, addr(start_l[0]), addr(end_l[0]), addr(trace))
    // fix trace up by the offset
    if (trace.fraction != 1.0f) {
        trace.endpos[0] += offset[0]
        trace.endpos[1] += offset[1]
        trace.endpos[2] += offset[2]
    }
    // did we clip the move?
    if (trace.fraction < 1.0f || uint(trace.startsolid) != 0) {
        trace.ent = ent
    }
    return trace
}

// ====================
// SV_ClipToLinks
// Mins and maxs enclose the entire area swept by the move
// ====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_ClipToLinks(var node : areanode_s?; var clip : moveclip_t?) {
    var l : link_s?
    var next : link_s?
    var touch : edict_s?
    var trace : trace_t
    // touch linked edicts
    {
        l = node.solid_edicts.next
        var _f = false
        while (true) {
            if (_f) {
                l = next
            }
            _f = true
            if (!(intptr(l) != intptr(addr(node.solid_edicts)))) {
                break
            }
            next = l.next
            touch = EDICT_FROM_AREA(l)
            if (touch.v.solid == float(SOLID_NOT)) {
                continue
            }
            if (intptr(touch) == intptr(clip.passedict)) {
                continue
            }
            if (touch.v.solid == float(SOLID_TRIGGER)) {
                Sys_Error`va(cstr("Trigger in clipping list"), VaNone())
            }
            if (clip._c_type == MOVE_NOMONSTERS && touch.v.solid != float(SOLID_BSP)) {
                continue
            }
            if (clip.boxmins[0] > touch.v.absmax[0] || clip.boxmins[1] > touch.v.absmax[1] || clip.boxmins[2] > touch.v.absmax[2] ||
                    clip.boxmaxs[0] < touch.v.absmin[0] || clip.boxmaxs[1] < touch.v.absmin[1] || clip.boxmaxs[2] < touch.v.absmin[2]) {
                continue
            }
            if (clip.passedict != null && clip.passedict.v.size[0] != 0.0f && touch.v.size[0] == 0.0f) {
                // points never interact
                continue
            }
            // might intersect, so do an exact clip
            if (int(clip.trace.allsolid) != 0) {
                return
            }
            if (clip.passedict != null) {
                if (intptr(PROG_TO_EDICT(touch.v.owner)) == intptr(clip.passedict)) {
                    // don't clip against own missiles
                    continue
                }
                if (intptr(PROG_TO_EDICT(clip.passedict.v.owner)) == intptr(touch)) {
                    // don't clip against owner
                    continue
                }
            }
            if ((int(touch.v.flags) & FL_MONSTER) != 0) {
                trace = SV_ClipMoveToEntity(touch, clip.start, addr(clip.mins2[0]), addr(clip.maxs2[0]), clip.end)
            } else {
                trace = SV_ClipMoveToEntity(touch, clip.start, clip.mins, clip.maxs, clip.end)
            }
            if (uint(trace.allsolid) != 0 || uint(trace.startsolid) != 0 || trace.fraction < clip.trace.fraction) {
                trace.ent = touch
                if (int(clip.trace.startsolid) != 0) {
                    clip.trace = trace
                    clip.trace.startsolid = qboolean._c_true
                } else {
                    clip.trace = trace
                }
            } elif (int(trace.startsolid) != 0) {
                clip.trace.startsolid = qboolean._c_true
            }
        }
    }
    // recurse down both sides
    if (node.axis == -1) {
        return
    }
    if (clip.boxmaxs[node.axis] > node.dist) {
        SV_ClipToLinks(node.children[0], clip)
    }
    if (clip.boxmins[node.axis] < node.dist) {
        SV_ClipToLinks(node.children[1], clip)
    }
}

// ==================
// SV_MoveBounds
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_MoveBounds(var start : float?; var mins : float?; var maxs : float?; var end : float?; var boxmins : float?; var boxmaxs : float?) {
    // debug to test against everything
    for (i in range(3)) {
        if (end[i] > start[i]) {
            boxmins[i] = start[i] + mins[i] - 1.0f
            boxmaxs[i] = end[i] + maxs[i] + 1.0f
        } else {
            boxmins[i] = end[i] + mins[i] - 1.0f
            boxmaxs[i] = start[i] + maxs[i] + 1.0f
        }
    }
}

// ==================
// SV_Move
// ==================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SV_Move(var start : float?; var mins : float?; var maxs : float?; var end : float?; _c_type : int; var passedict : edict_s?) : trace_t {
    var clip : moveclip_t
    crt::memset(reinterpret<void?>(addr(clip)), 0, uint64(typeinfo sizeof(type<moveclip_t>)))
    // clip to world
    clip.trace = SV_ClipMoveToEntity(sv.edicts, start, mins, maxs, end)
    clip.start = start
    clip.end = end
    clip.mins = mins
    clip.maxs = maxs
    clip._c_type = _c_type
    clip.passedict = passedict
    if (_c_type == MOVE_MISSILE) {
        for (i in range(3)) {
            clip.mins2[i] = -15.0f
            clip.maxs2[i] = 15.0f
        }
    } else {
        clip.mins2[0] = mins[0]
        clip.mins2[1] = mins[1]
        clip.mins2[2] = mins[2]
        clip.maxs2[0] = maxs[0]
        clip.maxs2[1] = maxs[1]
        clip.maxs2[2] = maxs[2]
    }
    // create the bounding box of the entire move
    SV_MoveBounds(start, addr(clip.mins2[0]), addr(clip.maxs2[0]), end, addr(clip.boxmins[0]), addr(clip.boxmaxs[0]))
    // clip to entities
    SV_ClipToLinks(addr(sv_areanodes[0]), addr(clip))
    return clip.trace
}

