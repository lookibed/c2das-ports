// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require modelgen_h

enum spriteframetype_t {
    SPR_SINGLE
    SPR_GROUP
}

struct dsprite_t {
    ident, version, _c_type : int
    boundingradius : float
    width, height, numframes : int
    beamlength : float
    synctype : synctype_t
}

struct dspriteframe_t {
    origin : int[2]
    width, height : int
}

struct dspritegroup_t {
    numframes : int
}

struct dspriteinterval_t {
    interval : float
}

struct dspriteframetype_t {
    _c_type : spriteframetype_t
}

include spritegn_h.layout.das.inc

