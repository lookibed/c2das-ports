    Cvar_RegisterVariable(addr(cl_anglespeedkey))
    Cvar_RegisterVariable(addr(cl_shownet))
    Cvar_RegisterVariable(addr(cl_nolerp))
    Cvar_RegisterVariable(addr(lookspring))
    Cvar_RegisterVariable(addr(lookstrafe))
    Cvar_RegisterVariable(addr(sensitivity))
    Cvar_RegisterVariable(addr(m_pitch))
    Cvar_RegisterVariable(addr(m_yaw))
