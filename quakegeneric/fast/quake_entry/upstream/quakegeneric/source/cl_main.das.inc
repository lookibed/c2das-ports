// =====================
// CL_ClearState
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_ClearState {
    var i : int
    if (int(sv.active) == 0) {
        Host_ClearMemory()
    }
    // wipe the entire cl structure
    crt::memset(reinterpret<void?>(addr(cl)), 0, uint64(typeinfo sizeof(type<client_state_t>)))
    SZ_Clear(addr(cls.message))
    // clear other arrays
    crt::memset(reinterpret<void?>(addr(cl_efrags[0])), 0, uint64(typeinfo sizeof(type<efrag_s[640]>)))
    crt::memset(reinterpret<void?>(addr(cl_entities[0])), 0, uint64(typeinfo sizeof(type<entity_s[600]>)))
    crt::memset(reinterpret<void?>(addr(cl_dlights[0])), 0, uint64(typeinfo sizeof(type<dlight_t[32]>)))
    crt::memset(reinterpret<void?>(addr(cl_lightstyle[0])), 0, uint64(typeinfo sizeof(type<lightstyle_t[64]>)))
    crt::memset(reinterpret<void?>(addr(cl_temp_entities[0])), 0, uint64(typeinfo sizeof(type<entity_s[64]>)))
    crt::memset(reinterpret<void?>(addr(cl_beams[0])), 0, uint64(typeinfo sizeof(type<beam_t[24]>)))
    // allocate the efrags and chain together into a free list
    cl.free_efrags = addr(cl_efrags[0])
    i = 0
    while (i < MAX_EFRAGS - 1) {
        cl.free_efrags[i].entnext = addr(cl.free_efrags[i + 1])
        i++
    }
    cl.free_efrags[i].entnext = null
}

// =====================
// CL_Disconnect
// Sends a disconnect message to the server
// This is also called on Host_Error, so it shouldn't cause any errors
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_Disconnect {
    // stop sounds (especially looping!)
    S_StopAllSounds(qboolean._c_true)
    // bring the console down and fade the colors back to normal
    // SCR_BringDownConsole ();
    // if running a local server, shut it down
    if (int(cls.demoplayback) != 0) {
        CL_StopPlayback()
    } elif (cls.state == cactive_t.ca_connected) {
        if (int(cls.demorecording) != 0) {
            CL_Stop_f()
        }
        Con_DPrintf`va(cstr("Sending clc_disconnect\n"), VaNone())
        SZ_Clear(addr(cls.message))
        MSG_WriteByte(addr(cls.message), clc_disconnect)
        NET_SendUnreliableMessage(cls.netcon, addr(cls.message))
        SZ_Clear(addr(cls.message))
        NET_Close(cls.netcon)
        cls.state = cactive_t.ca_disconnected
        if (int(sv.active) != 0) {
            Host_ShutdownServer(qboolean._c_false)
        }
    }
    cls.timedemo = qboolean._c_false
    cls.demoplayback = cls.timedemo
    cls.signon = 0
}

[unsafe_deref, hint(unsafe_range_check)]
def CL_Disconnect_f {
    CL_Disconnect()
    if (int(sv.active) != 0) {
        Host_ShutdownServer(qboolean._c_false)
    }
}

// =====================
// CL_EstablishConnection
// Host should be either "local" or a net address to be passed on
// =====================
[unsafe_deref, hint(unsafe_range_check)]
def CL_EstablishConnection(var host : uint8?) {
    if (cls.state == cactive_t.ca_dedicated) {
        return
    }
    if (int(cls.demoplayback) != 0) {
        return
    }
    CL_Disconnect()
    cls.netcon = NET_Connect(host)
    if (cls.netcon == null) {
        Host_Error`va(cstr("CL_Connect: connect failed\n"), VaNone())
    }
    Con_DPrintf`va(cstr("CL_EstablishConnection: connected to %s\n"), (host,))
    // not in the demo loop now
    cls.demonum = -1
    cls.state = cactive_t.ca_connected
    // need all the signon messages before playing
    cls.signon = 0
}

// =====================
// CL_SignonReply
// An svc_signonnum has been received, perform a client side setup
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_SignonReply {
    var str : uint8[8192]
    Con_DPrintf`va(cstr("CL_SignonReply: %i\n"), (cls.signon,))
    c_switch(cls.signon) {
        case(1) {
            MSG_WriteByte(addr(cls.message), clc_stringcmd)
            MSG_WriteString(addr(cls.message), cstr("prespawn"))
            break
        }
        case(2) {
            MSG_WriteByte(addr(cls.message), clc_stringcmd)
            MSG_WriteString(addr(cls.message), va`va(cstr("name \"%s\"\n"), (cl_name._c_string,)))
            MSG_WriteByte(addr(cls.message), clc_stringcmd)
            MSG_WriteString(addr(cls.message), va`va(cstr("color %i %i\n"), (int(cl_color.value) >> 4, int(cl_color.value) & 15)))
            MSG_WriteByte(addr(cls.message), clc_stringcmd)
            sprintf(addr(str[0]), cstr("spawn %s"), addr(cls.spawnparms[0]))
            MSG_WriteString(addr(cls.message), addr(str[0]))
            break
        }
        case(3) {
            MSG_WriteByte(addr(cls.message), clc_stringcmd)
            MSG_WriteString(addr(cls.message), cstr("begin"))
            // print remaining memory
            Cache_Report()
            break
        }
        case(4) {
            // allow normal screen updates
            SCR_EndLoadingPlaque()
            break
        }
    }
}

// =====================
// CL_NextDemo
// Called to play the next demo in the demo loop
// =====================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_NextDemo {
    var str : uint8[1024]
    if (cls.demonum == -1) {
        // don't play demos
        return
    }
    SCR_BeginLoadingPlaque()
    if (cls.demos[cls.demonum][0] == 0 || cls.demonum == MAX_DEMOS) {
        cls.demonum = 0
        if (cls.demos[cls.demonum][0] == 0) {
            Con_Printf`va(cstr("No demos listed with startdemos\n"), VaNone())
            cls.demonum = -1
            return
        }
    }
    sprintf(addr(str[0]), cstr("playdemo %s\n"), addr(cls.demos[cls.demonum][0]))
    Cbuf_InsertText(addr(str[0]))
    cls.demonum++
}

// ==============
// CL_PrintEntities_f
// ==============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_PrintEntities_f {
    var ent : entity_s?
    var i : int
    i = 0
    ent = addr(cl_entities[0])
    while (i < cl.num_entities) {
        {
            Con_Printf`va(cstr("%3i:"), (i,))
            if (ent.model == null) {
                Con_Printf`va(cstr("EMPTY\n"), VaNone())
                continue
            }
            Con_Printf`va(cstr("%s:%2i  (%5.1f,%5.1f,%5.1f) [%5.1f %5.1f %5.1f]\n"),
                    (addr(ent.model.name[0]), ent.frame, double(ent.origin[0]), double(ent.origin[1]), double(ent.origin[2]), double(ent.angles[0]),
                        double(ent.angles[1]), double(ent.angles[2])))
        } finally {
            i++
            ent++
        }
    }
}

