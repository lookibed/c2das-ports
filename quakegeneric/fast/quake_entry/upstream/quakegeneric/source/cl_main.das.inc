// ===============
// CL_AllocDlight
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_AllocDlight(key : int) : dlight_t? {
    var i : int
    var dl : dlight_t?
    // first look for an exact key match
    if (key != 0) {
        dl = addr(cl_dlights[0])
        i = 0
        while (i < MAX_DLIGHTS) {
            if (dl.key == key) {
                crt::memset(reinterpret<void?>(dl), 0, uint64(typeinfo sizeof(type<dlight_t>)))
                dl.key = key
                return dl
            }
            i++
            dl++
        }
    }
    // then look for anything else
    dl = addr(cl_dlights[0])
    i = 0
    while (i < MAX_DLIGHTS) {
        if (double(dl.die) < cl.time) {
            crt::memset(reinterpret<void?>(dl), 0, uint64(typeinfo sizeof(type<dlight_t>)))
            dl.key = key
            return dl
        }
        i++
        dl++
    }
    dl = addr(cl_dlights[0])
    crt::memset(reinterpret<void?>(dl), 0, uint64(typeinfo sizeof(type<dlight_t>)))
    dl.key = key
    return dl
}

// ===============
// CL_DecayLights
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_DecayLights {
    var i : int
    var dl : dlight_t?
    var time : float
    time = float(cl.time - cl.oldtime)
    dl = addr(cl_dlights[0])
    i = 0
    while (i < MAX_DLIGHTS) {
        {
            if (double(dl.die) < cl.time || dl.radius == 0.0f) {
                continue
            }
            dl.radius -= time * dl.decay
            if (dl.radius < 0.0f) {
                dl.radius = 0.0f
            }
        } finally {
            i++
            dl++
        }
    }
}

// ===============
// CL_LerpPoint
// Determines the fraction between the last two messages that the objects
// should be put at.
// ===============
[unsafe_deref, hint(unsafe_range_check)]
def CL_LerpPoint : float {
    var f : float
    var frac : float
    f = float(cl.mtime[0] - cl.mtime[1])
    if (f == 0.0f || cl_nolerp.value != 0.0f || uint(cls.timedemo) != 0 || uint(sv.active) != 0) {
        cl.time = cl.mtime[0]
        return 1.0f
    }
    if (double(f) > 0.1lf) {
        // dropped packet, or start of demo
        cl.mtime[1] = cl.mtime[0] - 0.1lf
        f = float(0.1lf)
    }
    frac = float((cl.time - cl.mtime[1]) / double(f))
    // Con_Printf ("frac: %f\n",frac);
    if (frac < 0.0f) {
        if (double(frac) < -0.01lf) {
            SetPal(1)
            cl.time = cl.mtime[1]
        }
        // Con_Printf ("low frac\n");
        frac = 0.0f
    } elif (frac > 1.0f) {
        if (double(frac) > 1.01lf) {
            SetPal(2)
            cl.time = cl.mtime[0]
        }
        // Con_Printf ("high frac\n");
        frac = 1.0f
    } else {
        SetPal(0)
    }
    return frac
}

// ===============
// CL_RelinkEntities
// ===============
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_RelinkEntities {
    var ent : entity_s?
    var i : int
    var j : int
    var frac : float
    var f : float
    var d : float
    var delta : float[3]
    var bobjrotate : float
    var oldorg : float[3]
    var dl : dlight_t?
    // determine partial update time
    frac = CL_LerpPoint()
    cl_numvisedicts = 0
    // interpolate player info
    i = 0
    while (i < 3) {
        cl.velocity[i] = cl.mvelocity[1][i] + frac * (cl.mvelocity[0][i] - cl.mvelocity[1][i])
        i++
    }
    if (int(cls.demoplayback) != 0) {
        // interpolate the angles
        for (j1 in range(3)) {
            d = cl.mviewangles[0][j1] - cl.mviewangles[1][j1]
            if (d > 180.0f) {
                d -= 360.0f
            } elif (d < -180.0f) {
                d += 360.0f
            }
            cl.viewangles[j1] = cl.mviewangles[1][j1] + frac * d
        }
    }
    bobjrotate = anglemod(float(100.0lf * cl.time))
    // start on the entity after the world
    i = 1
    ent = addr(cl_entities[0]) + 1
    while (i < cl.num_entities) {
        {
            if (ent.model == null) {
                // empty slot
                if (int(ent.forcelink) != 0) {
                    // just became empty
                    R_RemoveEfrags(ent)
                }
                continue
            }
            // if the object wasn't included in the last packet, remove it
            if (ent.msgtime != cl.mtime[0]) {
                ent.model = null
                continue
            }
            oldorg[0] = ent.origin[0]
            oldorg[1] = ent.origin[1]
            oldorg[2] = ent.origin[2]
            if (int(ent.forcelink) != 0) {
                // the entity was not updated in the last message
                // so move to the final spot
                ent.origin[0] = ent.msg_origins[0][0]
                ent.origin[1] = ent.msg_origins[0][1]
                ent.origin[2] = ent.msg_origins[0][2]
                ent.angles[0] = ent.msg_angles[0][0]
                ent.angles[1] = ent.msg_angles[0][1]
                ent.angles[2] = ent.msg_angles[0][2]
            } else {
                // if the delta is large, assume a teleport and don't lerp
                f = frac
                for (j1 in range(3)) {
                    delta[j1] = ent.msg_origins[0][j1] - ent.msg_origins[1][j1]
                    if (delta[j1] > 100.0f || delta[j1] < -100.0f) {
                        // assume a teleportation, not a motion
                        f = 1.0f
                    }
                }
                // interpolate the origin and angles
                j = 0
                while (j < 3) {
                    ent.origin[j] = ent.msg_origins[1][j] + f * delta[j]
                    d = ent.msg_angles[0][j] - ent.msg_angles[1][j]
                    if (d > 180.0f) {
                        d -= 360.0f
                    } elif (d < -180.0f) {
                        d += 360.0f
                    }
                    ent.angles[j] = ent.msg_angles[1][j] + f * d
                    j++
                }
            }
            // rotate binary objects locally
            if ((ent.model.flags & EF_ROTATE) != 0) {
                ent.angles[1] = bobjrotate
            }
            if ((ent.effects & EF_BRIGHTFIELD) != 0) {
                R_EntityParticles(ent)
            }
            if ((ent.effects & EF_MUZZLEFLASH) != 0) {
                var fv : float[3]
                var rv : float[3]
                var uv : float[3]
                dl = CL_AllocDlight(i)
                dl.origin[0] = ent.origin[0]
                dl.origin[1] = ent.origin[1]
                dl.origin[2] = ent.origin[2]
                dl.origin[2] += 16.0f
                AngleVectors(addr(ent.angles[0]), addr(fv[0]), addr(rv[0]), addr(uv[0]))
                VectorMA(addr(dl.origin[0]), 18.0f, addr(fv[0]), addr(dl.origin[0]))
                dl.radius = float(200 + (crt::rand() & 31))
                dl.minlight = 32.0f
                dl.die = float(cl.time + 0.1lf)
            }
            if ((ent.effects & EF_BRIGHTLIGHT) != 0) {
                dl = CL_AllocDlight(i)
                dl.origin[0] = ent.origin[0]
                dl.origin[1] = ent.origin[1]
                dl.origin[2] = ent.origin[2]
                dl.origin[2] += 16.0f
                dl.radius = float(400 + (crt::rand() & 31))
                dl.die = float(cl.time + 0.001lf)
            }
            if ((ent.effects & EF_DIMLIGHT) != 0) {
                dl = CL_AllocDlight(i)
                dl.origin[0] = ent.origin[0]
                dl.origin[1] = ent.origin[1]
                dl.origin[2] = ent.origin[2]
                dl.radius = float(200 + (crt::rand() & 31))
                dl.die = float(cl.time + 0.001lf)
            }
            if ((ent.model.flags & EF_GIB) != 0) {
                R_RocketTrail(addr(oldorg[0]), addr(ent.origin[0]), 2)
            } elif ((ent.model.flags & EF_ZOMGIB) != 0) {
                R_RocketTrail(addr(oldorg[0]), addr(ent.origin[0]), 4)
            } elif ((ent.model.flags & EF_TRACER) != 0) {
                R_RocketTrail(addr(oldorg[0]), addr(ent.origin[0]), 3)
            } elif ((ent.model.flags & EF_TRACER2) != 0) {
                R_RocketTrail(addr(oldorg[0]), addr(ent.origin[0]), 5)
            } elif ((ent.model.flags & EF_ROCKET) != 0) {
                R_RocketTrail(addr(oldorg[0]), addr(ent.origin[0]), 0)
                dl = CL_AllocDlight(i)
                dl.origin[0] = ent.origin[0]
                dl.origin[1] = ent.origin[1]
                dl.origin[2] = ent.origin[2]
                dl.radius = 200.0f
                dl.die = float(cl.time + 0.01lf)
            } elif ((ent.model.flags & EF_GRENADE) != 0) {
                R_RocketTrail(addr(oldorg[0]), addr(ent.origin[0]), 1)
            } elif ((ent.model.flags & EF_TRACER3) != 0) {
                R_RocketTrail(addr(oldorg[0]), addr(ent.origin[0]), 6)
            }
            ent.forcelink = qboolean._c_false
            if (i == cl.viewentity && chase_active.value == 0.0f) {
                continue
            }
            if (cl_numvisedicts < MAX_VISEDICTS) {
                cl_visedicts[cl_numvisedicts] = ent
                cl_numvisedicts++
            }
        } finally {
            i++
            ent++
        }
    }
}

// ===============
// CL_ReadFromServer
// Read all incoming data from the server
// ===============
[unsafe_deref, hint(unsafe_range_check)]
def CL_ReadFromServer : int {
    var ret : int
    cl.oldtime = cl.time
    cl.time += host_frametime
    c_do_while(ret != 0 && cls.state == cactive_t.ca_connected) {
        ret = CL_GetMessage()
        if (ret == -1) {
            Host_Error`va(cstr("CL_ReadFromServer: lost server connection"), VaNone())
        }
        if (ret == 0) {
            break
        }
        cl.last_received_message = float(realtime)
        CL_ParseServerMessage()
    }
    if (cl_shownet.value != 0.0f) {
        Con_Printf`va(cstr("\n"), VaNone())
    }
    CL_RelinkEntities()
    CL_UpdateTEnts()
    // bring the links up to date
    return 0
}

// =================
// CL_SendCmd
// =================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def CL_SendCmd {
    var cmd : usercmd_t
    if (cls.state != cactive_t.ca_connected) {
        return
    }
    if (cls.signon == SIGNONS) {
        // get basic movement from keyboard
        CL_BaseMove(addr(cmd))
        // allow mice or other external controllers to add to the move
        IN_Move(addr(cmd))
        // send the unreliable message
        CL_SendMove(addr(cmd))
    }
    if (int(cls.demoplayback) != 0) {
        SZ_Clear(addr(cls.message))
        return
    }
    // send the reliable message
    if (cls.message.cursize == 0) {
        // no message at all
        return
    }
    if (int(NET_CanSendMessage(cls.netcon)) == 0) {
        Con_DPrintf`va(cstr("CL_WriteToServer: can't send\n"), VaNone())
        return
    }
    if (NET_SendMessage(cls.netcon, addr(cls.message)) == -1) {
        Host_Error`va(cstr("CL_WriteToServer: lost server connection"), VaNone())
    }
    SZ_Clear(addr(cls.message))
}

