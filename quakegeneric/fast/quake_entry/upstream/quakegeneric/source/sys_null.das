[c_function, unsafe_deref, hint(unsafe_range_check), variadic]
def Sys_Error(var error : uint8?; va : va_args) {
    var argptr : CVaCursor
    fprintf(crt::c_stderr(), cstr("Sys_Error: "))
    argptr = va_begin(va)
    c_vfprintf(crt::c_stderr(), error, va_rest(argptr))
    fprintf(crt::c_stderr(), cstr("\n"))
    c_exit(1)
}

[c_function, unsafe_deref, hint(unsafe_range_check), variadic]
def Sys_Printf(var fmt : uint8?; va : va_args) {
    var argptr : CVaCursor
    argptr = va_begin(va)
    c_vfprintf(crt::c_stderr(), fmt, va_rest(argptr))
}

[unsafe_deref, hint(unsafe_range_check)]
def Sys_Quit {
    c_exit(0)
}

[unsafe_deref, hint(unsafe_range_check)]
def Sys_FloatTime : double {
    Sys_FloatTime_t += 0.1lf
    return Sys_FloatTime_t
}

