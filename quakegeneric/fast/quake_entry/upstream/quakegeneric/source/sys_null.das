// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require ../../../c_types.das
require c_runtime/c_exit
require c_runtime/c_function
require c_runtime/cstr
require c_runtime/printf
require c_runtime/variadic
require common_h
require crt

[init]
def private c2das_dialect {
    c_long_bits = 64
}

var isDedicated : qboolean
var sys_handles : _IO_FILE? [10]
var private Sys_FloatTime_t : double

let private MAX_HANDLES = 10

[unsafe_deref, hint(unsafe_range_check)]
def findhandle : int {
    for (i in range(1, MAX_HANDLES)) {
        if (sys_handles[i] == null) {
            return i
        }
    }
    Sys_Error`va(cstr("out of handles"), VaNone())
    return -1
}

// ================
// filelength
// ================
[c_function, unsafe_deref, hint(unsafe_range_check)]
def filelength(var f : _IO_FILE?) : int {
    var pos : int
    var end : int
    pos = int(crt::ftell(reinterpret<void?>(f)))
    crt::fseek(reinterpret<void?>(f), 0l, 2)
    end = int(crt::ftell(reinterpret<void?>(f)))
    crt::fseek(reinterpret<void?>(f), int64(pos), 0)
    return end
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Sys_FileOpenRead(var path : uint8?; var hndl : int?) : int {
    var f : _IO_FILE?
    var i : int
    i = findhandle()
    f = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("rb")))
    if (f == null) {
        *hndl = -1
        return -1
    }
    sys_handles[i] = f
    *hndl = i
    return filelength(f)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Sys_FileOpenWrite(var path : uint8?) : int {
    var f : _IO_FILE?
    var i : int
    i = findhandle()
    f = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("wb")))
    if (f == null) {
        Sys_Error`va(cstr("Error opening %s: %s"), (path, crt::strerror(*crt::c_errno_location())))
    }
    sys_handles[i] = f
    return i
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Sys_FileClose(handle : int) {
    crt::fclose(reinterpret<void?>(sys_handles[handle]))
    sys_handles[handle] = null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Sys_FileSeek(handle : int; position : int) {
    crt::fseek(reinterpret<void?>(sys_handles[handle]), int64(position), 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Sys_FileRead(handle : int; var dest : void?; count : int) : int {
    return int(crt::fread(dest, 1ul, uint64(count), reinterpret<void?>(sys_handles[handle])))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Sys_FileWrite(handle : int; var data : void?; count : int) : int {
    return int(crt::fwrite(data, 1ul, uint64(count), reinterpret<void?>(sys_handles[handle])))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Sys_FileTime(var path : uint8?) : int {
    var f : _IO_FILE?
    f = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("rb")))
    if (f != null) {
        crt::fclose(reinterpret<void?>(f))
        return 1
    }
    return -1
}

[unsafe_deref, hint(unsafe_range_check)]
def Sys_mkdir(var path : uint8?) {
