// generated by c2das - regenerate, never edit
var qg_frame_count : int = 0
var qg_frame_hash : int[4096]
var qg_frame_seconds : double = 1.0lf / 64.0lf
var qg_palette : uint8[768]

// 32-bit FNV-1a over the frame's pixels, one 24-bit RGB word per pixel.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private qg_hash_frame(var pixels : uint8?) : uint {
    var hash : uint = 2166136261u
    for (i in range(QUAKEGENERIC_RES_X * QUAKEGENERIC_RES_Y)) {
        var c : uint8? = addr(qg_palette[0]) + end_index(int(pixels[i]) * 3, 768)
        let rgb : uint = (uint(c[0]) << 16u) | (uint(c[1]) << 8u) | uint(c[2])
        hash = (hash ^ rgb) * 16777619u
    }
    return hash
}

[unsafe_deref, hint(unsafe_range_check)]
def QG_Init {
}

[unsafe_deref, hint(unsafe_range_check)]
def QG_Quit {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def QG_DrawFrame(var pixels : void?) {
    // Frames that show any of the console are not recorded. The console
    // scrolls up over the first frames of the demo, and its startup log
    // holds the base directory's path ("Added packfile <dir>/id1/pak0.pak")
    // and the engine's build time (`host.c` prints `__DATE__`/`__TIME__`),
    // so those frames differ between two builds or two directories.
    if (scr_con_current != 0f) {
        return
    }
    if (qg_frame_count < QG_MAX_FRAMES) {
        qg_frame_hash[qg_frame_count] = int(qg_hash_frame(reinterpret<uint8?>(pixels)))
    }
    qg_frame_count += 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def QG_SetPalette(var palette : uint8?) {
    for (i in range(768)) {
        qg_palette[i] = palette[i]
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def QG_GetKey(var down : int?; var key : int?) : int {
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def QG_GetMouseMove(var x : int?; var y : int?) {
    *x = 0
    *y = 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def QG_GetJoyAxes(var axes : float?) {
    for (i in range(QUAKEGENERIC_JOY_MAX_AXES)) {
        axes[i] = 0f
    }
}

