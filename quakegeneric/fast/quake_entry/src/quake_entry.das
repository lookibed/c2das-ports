// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
options strict_aliasing = false
require ../c_types.das
require ../upstream/quakegeneric/source/chase_cluster.das
require ../upstream/quakegeneric/source/quakegeneric.das
require c_runtime/c_args
require c_runtime/c_exit
require c_runtime/c_function
require c_runtime/cstr
require c_runtime/printf
require crt

[init]
def private c2das_dialect {
    c_long_bits = 64
}

var private quake_argv : uint8? [6]

let private FRAME_LIMIT = 100
let private TICK_LIMIT = 2000

[c_function, unsafe_deref, hint(unsafe_range_check)]
def c_main(argc : int; var argv : uint8 ??) : int {
    var ticks : int = 0
    crt::setvbuf(crt::c_stdout(), null, 2, 0ul)
    if (argc < 2) {
        printf(cstr("load=0\n"))
        return 2
    }
    quake_argv[0] = cstr("quake")
    quake_argv[1] = cstr("-basedir")
    quake_argv[2] = argv[argc - 1]
    quake_argv[3] = cstr("+timedemo")
    quake_argv[4] = cstr("demo1")
    quake_argv[5] = null
    QG_Create(5, addr(quake_argv[0]))
    while (qg_frame_count < FRAME_LIMIT && ticks < TICK_LIMIT) {
        QG_Tick(qg_frame_seconds)
        ticks += 1
    }
    if (qg_frame_count < FRAME_LIMIT) {
        printf(cstr("frames=%d ticks=%d\n"), qg_frame_count, ticks)
        return 1
    }
    for (i in range(FRAME_LIMIT)) {
        printf(cstr("frame[%d]=%d\n"), i, qg_frame_hash[i])
    }
    printf(cstr("frames=%d\n"), FRAME_LIMIT)
    return 0
}

[export]
def main : int {
    c_runtime_init("quake_entry")
    return c_main(c_argc(), c_argv())
}
