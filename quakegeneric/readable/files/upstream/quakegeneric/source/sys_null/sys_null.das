struct plane_t {
    normal : float[3]
    dist : float
}

struct trace_t {
    allsolid, startsolid, inopen, inwater : qboolean
    fraction : float
    endpos : float[3]
    plane : plane_t
    ent : edict_s?
}

struct quakeparms_t {
    basedir, cachedir : uint8?
    argc : int
    argv : uint8 ??
    membase : void?
    memsize : int
}

