    static_assert(typeinfo offsetof < v > (type<zpointdesc_t>) == 4, "zpointdesc_t.v: clang puts it at 4")
    static_assert(typeinfo offsetof < zi > (type<zpointdesc_t>) == 8, "zpointdesc_t.zi: clang puts it at 8")
    static_assert(typeinfo offsetof < color > (type<zpointdesc_t>) == 12, "zpointdesc_t.color: clang puts it at 12")
    static_assert(typeinfo sizeof(type<drawsurf_t>) == 64 && typeinfo alignof(type<drawsurf_t>) == 8, "drawsurf_t: clang lays it out as size 64, align 8")
    static_assert(typeinfo offsetof < surfdat > (type<drawsurf_t>) == 0, "drawsurf_t.surfdat: clang puts it at 0")
    static_assert(typeinfo offsetof < rowbytes > (type<drawsurf_t>) == 8, "drawsurf_t.rowbytes: clang puts it at 8")
    static_assert(typeinfo offsetof < surf > (type<drawsurf_t>) == 16, "drawsurf_t.surf: clang puts it at 16")
    static_assert(typeinfo offsetof < lightadj > (type<drawsurf_t>) == 24, "drawsurf_t.lightadj: clang puts it at 24")
    static_assert(typeinfo offsetof < texture > (type<drawsurf_t>) == 40, "drawsurf_t.texture: clang puts it at 40")
    static_assert(typeinfo offsetof < surfmip > (type<drawsurf_t>) == 48, "drawsurf_t.surfmip: clang puts it at 48")
    static_assert(typeinfo offsetof < surfwidth > (type<drawsurf_t>) == 52, "drawsurf_t.surfwidth: clang puts it at 52")
    static_assert(typeinfo offsetof < surfheight > (type<drawsurf_t>) == 56, "drawsurf_t.surfheight: clang puts it at 56")
    static_assert(typeinfo sizeof(type<plane_t>) == 16 && typeinfo alignof(type<plane_t>) == 4, "plane_t: clang lays it out as size 16, align 4")
    static_assert(typeinfo offsetof < normal > (type<plane_t>) == 0, "plane_t.normal: clang puts it at 0")
    static_assert(typeinfo offsetof < dist > (type<plane_t>) == 12, "plane_t.dist: clang puts it at 12")
    static_assert(typeinfo sizeof(type<trace_t>) == 56 && typeinfo alignof(type<trace_t>) == 8, "trace_t: clang lays it out as size 56, align 8")
    static_assert(typeinfo offsetof < allsolid > (type<trace_t>) == 0, "trace_t.allsolid: clang puts it at 0")
    static_assert(typeinfo offsetof < startsolid > (type<trace_t>) == 4, "trace_t.startsolid: clang puts it at 4")
    static_assert(typeinfo offsetof < inopen > (type<trace_t>) == 8, "trace_t.inopen: clang puts it at 8")
    static_assert(typeinfo offsetof < inwater > (type<trace_t>) == 12, "trace_t.inwater: clang puts it at 12")
    static_assert(typeinfo offsetof < fraction > (type<trace_t>) == 16, "trace_t.fraction: clang puts it at 16")
    static_assert(typeinfo offsetof < endpos > (type<trace_t>) == 20, "trace_t.endpos: clang puts it at 20")
    static_assert(typeinfo offsetof < plane > (type<trace_t>) == 32, "trace_t.plane: clang puts it at 32")
    static_assert(typeinfo offsetof < ent > (type<trace_t>) == 48, "trace_t.ent: clang puts it at 48")
    static_assert(typeinfo sizeof(type<quakeparms_t>) == 48 && typeinfo alignof(type<quakeparms_t>) == 8, "quakeparms_t: clang lays it out as size 48, align 8")
    static_assert(typeinfo offsetof < basedir > (type<quakeparms_t>) == 0, "quakeparms_t.basedir: clang puts it at 0")
    static_assert(typeinfo offsetof < cachedir > (type<quakeparms_t>) == 8, "quakeparms_t.cachedir: clang puts it at 8")
    static_assert(typeinfo offsetof < argc > (type<quakeparms_t>) == 16, "quakeparms_t.argc: clang puts it at 16")
    static_assert(typeinfo offsetof < argv > (type<quakeparms_t>) == 24, "quakeparms_t.argv: clang puts it at 24")
    static_assert(typeinfo offsetof < membase > (type<quakeparms_t>) == 32, "quakeparms_t.membase: clang puts it at 32")
    static_assert(typeinfo offsetof < memsize > (type<quakeparms_t>) == 40, "quakeparms_t.memsize: clang puts it at 40")
}

var isDedicated : qboolean
var sys_handles : _IO_FILE? [10]
var private Sys_FloatTime_t : double

let private MAX_HANDLES = 10

def findhandle : int {
    for (i in range(1, MAX_HANDLES)) {
        if (sys_handles[i] == null) {
            return i
        }
    }
    Sys_Error`va(cstr("out of handles"), VaNone())
    return -1
}

// ================
// filelength
// ================
[c_function]
def filelength(var f : _IO_FILE?) : int {
    var pos : int
    var end : int
    pos = int(crt::ftell(reinterpret<void?>(f)))
    crt::fseek(reinterpret<void?>(f), 0l, 2)
    end = int(crt::ftell(reinterpret<void?>(f)))
    crt::fseek(reinterpret<void?>(f), int64(pos), 0)
    return end
}

[c_function]
def Sys_FileOpenRead(var path : uint8?; var hndl : int?) : int {
    var f : _IO_FILE?
    var i : int
    i = findhandle()
    f = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("rb")))
    if (f == null) {
        *hndl = -1
        return -1
    }
    sys_handles[i] = f
    *hndl = i
    return filelength(f)
}

[c_function]
def Sys_FileOpenWrite(var path : uint8?) : int {
    var f : _IO_FILE?
    var i : int
    i = findhandle()
    f = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("wb")))
    if (f == null) {
        Sys_Error`va(cstr("Error opening %s: %s"), (path, crt::strerror(*crt::c_errno_location())))
    }
    sys_handles[i] = f
    return i
}

[c_function]
def Sys_FileClose(handle : int) {
    crt::fclose(reinterpret<void?>(sys_handles[handle]))
    sys_handles[handle] = null
}

[c_function]
def Sys_FileSeek(handle : int; position : int) {
    crt::fseek(reinterpret<void?>(sys_handles[handle]), int64(position), 0)
}

[c_function]
def Sys_FileRead(handle : int; var dest : void?; count : int) : int {
    return int(crt::fread(dest, 1ul, uint64(count), reinterpret<void?>(sys_handles[handle])))
}

[c_function]
def Sys_FileWrite(handle : int; var data : void?; count : int) : int {
    return int(crt::fwrite(data, 1ul, uint64(count), reinterpret<void?>(sys_handles[handle])))
}

[c_function]
def Sys_FileTime(var path : uint8?) : int {
    var f : _IO_FILE?
    f = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("rb")))
    if (f != null) {
        crt::fclose(reinterpret<void?>(f))
        return 1
    }
    return -1
}

def Sys_mkdir(var path : uint8?) {
}

def Sys_MakeCodeWriteable(startaddr : uint64; length : uint64) {
}

[c_function, variadic]
def Sys_Error(var error : uint8?; va : va_args) {
    var argptr : CVaCursor
    fprintf(crt::c_stderr(), cstr("Sys_Error: "))
    argptr = va_begin(va)
    c_vfprintf(crt::c_stderr(), error, va_rest(argptr))
    fprintf(crt::c_stderr(), cstr("\n"))
    c_exit(1)
}

[c_function, variadic]
def Sys_Printf(var fmt : uint8?; va : va_args) {
    var argptr : CVaCursor
    argptr = va_begin(va)
    c_vfprintf(crt::c_stderr(), fmt, va_rest(argptr))
}

def Sys_Quit {
    c_exit(0)
}

def Sys_FloatTime : double {
    Sys_FloatTime_t += 0.1lf
    return Sys_FloatTime_t
}

def Sys_ConsoleInput : uint8? {
    return null
}

def Sys_Sleep {
}

def Sys_SendKeyEvents {
}

def Sys_HighFPPrecision {
}

def Sys_LowFPPrecision {
}

