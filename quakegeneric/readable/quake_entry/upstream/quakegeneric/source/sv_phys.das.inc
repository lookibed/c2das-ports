// generated by c2das - regenerate, never edit
var sv_friction : cvar_s = cvar_s(name = cstr("sv_friction"), _c_string = cstr("4"), archive = qboolean._c_false, server = qboolean._c_true)
var sv_stopspeed : cvar_s = cvar_s(name = cstr("sv_stopspeed"), _c_string = cstr("100"))
var sv_gravity : cvar_s = cvar_s(name = cstr("sv_gravity"), _c_string = cstr("800"), archive = qboolean._c_false, server = qboolean._c_true)
var sv_maxvelocity : cvar_s = cvar_s(name = cstr("sv_maxvelocity"), _c_string = cstr("2000"))
var sv_nostep : cvar_s = cvar_s(name = cstr("sv_nostep"), _c_string = cstr("0"))

// ================
// SV_CheckAllEnts
// ================
def SV_CheckAllEnts {
    var e : int
    var check : edict_s?
    // see if any solid entities are inside the final position
    check = NEXT_EDICT(sv.edicts)
    e = 1
    while (e < sv.num_edicts) {
        {
            if (int(check.free) != 0) {
                continue
            }
            if (check.v.movetype == float(MOVETYPE_PUSH) || check.v.movetype == float(MOVETYPE_NONE) || check.v.movetype == float(MOVETYPE_NOCLIP)) {
                continue
            }
            if (SV_TestEntityPosition(check) != null) {
                Con_Printf`va(cstr("entity in invalid position\n"), VaNone())
            }
        } finally {
            e++
            check = NEXT_EDICT(check)
        }
    }
}

// ================
// SV_CheckVelocity
// ================
[c_function]
def SV_CheckVelocity(var ent : edict_s?) {
    // bound velocity
    for (i in range(3)) {
        if ((*reinterpret<int?>(addr(ent.v.velocity[0]) + end_index(i, 3)) & nanmask) == nanmask) {
            Con_Printf`va(cstr("Got a NaN velocity on %s\n"), (pr_strings + ent.v.classname,))
            ent.v.velocity[i] = 0.0f
        }
        if ((*reinterpret<int?>(addr(ent.v.origin[0]) + end_index(i, 3)) & nanmask) == nanmask) {
            Con_Printf`va(cstr("Got a NaN origin on %s\n"), (pr_strings + ent.v.classname,))
            ent.v.origin[i] = 0.0f
        }
        if (ent.v.velocity[i] > sv_maxvelocity.value) {
            ent.v.velocity[i] = sv_maxvelocity.value
        } elif (ent.v.velocity[i] < -sv_maxvelocity.value) {
            ent.v.velocity[i] = -sv_maxvelocity.value
        }
    }
}

// =============
// SV_RunThink
// Runs thinking code if time. There is some play in the exact time the think
// function will be called, because it is called before any movement is done
// in a frame. Not used for pushmove objects, because they must be exact.
// Returns false if the entity removed itself.
// =============
def SV_RunThink(var ent : edict_s?) : qboolean {
    var thinktime : float
    thinktime = ent.v.nextthink
    if (thinktime <= 0.0f || double(thinktime) > sv.time + host_frametime) {
        return qboolean._c_true
    }
    if (double(thinktime) < sv.time) {
        // don't let things stay in the past.
        thinktime = float(sv.time)
    }
    // it is possible to start that way
    // by a trigger with a local time.
    ent.v.nextthink = 0.0f
    pr_global_struct.time = thinktime
    pr_global_struct.self = int(EDICT_TO_PROG(ent))
    pr_global_struct.other = int(EDICT_TO_PROG(sv.edicts))
    PR_ExecuteProgram(ent.v.think)
    return enum_from_int(type<qboolean>, int_of(int(ent.free) == 0))
}

// ==================
// SV_Impact
// Two entities have touched, so run their touch functions
// ==================
def SV_Impact(var e1 : edict_s?; var e2 : edict_s?) {
    var old_self : int
    var old_other : int
    old_self = pr_global_struct.self
    old_other = pr_global_struct.other
    pr_global_struct.time = float(sv.time)
    if (e1.v.touch != 0 && e1.v.solid != float(SOLID_NOT)) {
        pr_global_struct.self = int(EDICT_TO_PROG(e1))
        pr_global_struct.other = int(EDICT_TO_PROG(e2))
        PR_ExecuteProgram(e1.v.touch)
    }
    if (e2.v.touch != 0 && e2.v.solid != float(SOLID_NOT)) {
        pr_global_struct.self = int(EDICT_TO_PROG(e2))
        pr_global_struct.other = int(EDICT_TO_PROG(e1))
        PR_ExecuteProgram(e2.v.touch)
    }
    pr_global_struct.self = old_self
    pr_global_struct.other = old_other
}

[c_function]
def ClipVelocity(var _c_in : float?; var normal : float?; var out : float?; overbounce : float) : int {
    var backoff : float
    var change : float
    var blocked : int
    blocked = 0
    if (normal[2] > 0.0f) {
        // floor
        blocked |= 1
    }
    if (normal[2] == 0.0f) {
        // step
        blocked |= 2
    }
    backoff = DotProduct(_c_in, normal) * overbounce
    for (i in range(3)) {
        change = normal[i] * backoff
        out[i] = _c_in[i] - change
        if (double(out[i]) > -STOP_EPSILON && double(out[i]) < STOP_EPSILON) {
            out[i] = 0.0f
        }
    }
    return blocked
}

// ============
// SV_FlyMove
// The basic solid body movement clip that slides along multiple planes
// Returns the clipflags if the velocity was modified (hit something solid)
// 1 = floor
// 2 = wall / step
// 4 = dead stop
// If steptrace is not NULL, the trace of any vertical wall hit will be stored
// ============
[c_function]
def SV_FlyMove(var ent : edict_s?; time : float; var steptrace : trace_t?) : int {
    var numbumps : int
    var dir : float[3]
    var d : float
    var numplanes : int
    var planes : float[5][3]
    var primal_velocity : float[3]
    var original_velocity : float[3]
    var new_velocity : float[3]
    var i : int
    var j : int
    var trace : trace_t
    var end : float[3]
    var time_left : float
    var blocked : int
    numbumps = 4
    blocked = 0
    original_velocity[0] = ent.v.velocity[0]
    original_velocity[1] = ent.v.velocity[1]
    original_velocity[2] = ent.v.velocity[2]
    primal_velocity[0] = ent.v.velocity[0]
    primal_velocity[1] = ent.v.velocity[1]
    primal_velocity[2] = ent.v.velocity[2]
    numplanes = 0
    time_left = time
    for (bumpcount in range(numbumps)) {
        if (ent.v.velocity[0] == 0.0f && ent.v.velocity[1] == 0.0f && ent.v.velocity[2] == 0.0f) {
            break
        }
        i = 0
        while (i < 3) {
            end[i] = ent.v.origin[i] + time_left * ent.v.velocity[i]
            i++
        }
        trace = SV_Move(addr(ent.v.origin[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(end[0]), int(qboolean._c_false), ent)
        if (int(trace.allsolid) != 0) {
            // entity is trapped in another solid
            ent.v.velocity[0] = vec3_origin[0]
            ent.v.velocity[1] = vec3_origin[1]
            ent.v.velocity[2] = vec3_origin[2]
            return 3
        }
        if (trace.fraction > 0.0f) {
            // actually covered some distance
            ent.v.origin[0] = trace.endpos[0]
            ent.v.origin[1] = trace.endpos[1]
            ent.v.origin[2] = trace.endpos[2]
            original_velocity[0] = ent.v.velocity[0]
            original_velocity[1] = ent.v.velocity[1]
            original_velocity[2] = ent.v.velocity[2]
            numplanes = 0
        }
        if (trace.fraction == 1.0f) {
            // moved the entire distance
            break
        }
        if (trace.ent == null) {
            Sys_Error`va(cstr("SV_FlyMove: !trace.ent"), VaNone())
        }
        if (double(trace.plane.normal[2]) > 0.7lf) {
            // floor
            blocked |= 1
            if (trace.ent.v.solid == float(SOLID_BSP)) {
                ent.v.flags = float(int(ent.v.flags) | FL_ONGROUND)
                ent.v.groundentity = int(EDICT_TO_PROG(trace.ent))
            }
        }
        if (trace.plane.normal[2] == 0.0f) {
            // step
            blocked |= 2
            if (steptrace != null) {
                // save for player extrafriction
                *steptrace = trace
            }
        }
        // run the impact function
        SV_Impact(ent, trace.ent)
        if (int(ent.free) != 0) {
            // removed by the impact function
            break
        }
        time_left -= time_left * trace.fraction
        // cliped to another plane
        if (numplanes >= MAX_CLIP_PLANES) {
            // this shouldn't really happen
            ent.v.velocity[0] = vec3_origin[0]
            ent.v.velocity[1] = vec3_origin[1]
            ent.v.velocity[2] = vec3_origin[2]
            return 3
        }
        planes[numplanes][0] = trace.plane.normal[0]
        planes[numplanes][1] = trace.plane.normal[1]
        planes[numplanes][2] = trace.plane.normal[2]
        numplanes++
        // modify original_velocity so it parallels all of the clip planes
        i = 0
        while (i < numplanes) {
            ClipVelocity(addr(original_velocity[0]), addr(planes[i][0]), addr(new_velocity[0]), 1.0f)
            j = 0
            while (j < numplanes) {
                if (j != i) {
                    if (new_velocity[0] * planes[j][0] + new_velocity[1] * planes[j][1] + new_velocity[2] * planes[j][2] < 0.0f) {
                        // not ok
                        break
                    }
                }
                j++
            }
            if (j == numplanes) {
                break
            }
            i++
        }
        if (i != numplanes) {
            // go along this plane
            ent.v.velocity[0] = new_velocity[0]
            ent.v.velocity[1] = new_velocity[1]
            ent.v.velocity[2] = new_velocity[2]
        } else {
            // go along the crease
            if (numplanes != 2) {
                // Con_Printf ("clip velocity, numplanes == %i\n",numplanes);
                ent.v.velocity[0] = vec3_origin[0]
                ent.v.velocity[1] = vec3_origin[1]
                ent.v.velocity[2] = vec3_origin[2]
                return 7
            }
            CrossProduct(addr(planes[0][0]), addr(planes[1][0]), addr(dir[0]))
            d = dir[0] * ent.v.velocity[0] + dir[1] * ent.v.velocity[1] + dir[2] * ent.v.velocity[2]
            VectorScale(addr(dir[0]), d, addr(ent.v.velocity[0]))
        }
        // if original velocity is against the original velocity, stop dead
        // to avoid tiny occilations in sloping corners
        if (ent.v.velocity[0] * primal_velocity[0] + ent.v.velocity[1] * primal_velocity[1] + ent.v.velocity[2] * primal_velocity[2] <= 0.0f) {
            ent.v.velocity[0] = vec3_origin[0]
            ent.v.velocity[1] = vec3_origin[1]
            ent.v.velocity[2] = vec3_origin[2]
            return blocked
        }
    }
    return blocked
}

// ============
// SV_AddGravity
// ============
def SV_AddGravity(var ent : edict_s?) {
    var ent_gravity : float
    var val : eval_s?
    val = GetEdictFieldValue(ent, cstr("gravity"))
    if (val != null && val._float != 0.0f) {
        ent_gravity = val._float
    } else {
        ent_gravity = float(1.0lf)
    }
    ent.v.velocity[2] = float(double(ent.v.velocity[2]) - double(ent_gravity * sv_gravity.value) * host_frametime)
}

// ============
// SV_PushEntity
// Does not change the entities velocity at all
// ============
[c_function]
def SV_PushEntity(var ent : edict_s?; var push : float?) : trace_t {
    var trace : trace_t
    var end : float[3]
    end[0] = ent.v.origin[0] + push[0]
    end[1] = ent.v.origin[1] + push[1]
    end[2] = ent.v.origin[2] + push[2]
    if (ent.v.movetype == float(MOVETYPE_FLYMISSILE)) {
        trace = SV_Move(addr(ent.v.origin[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(end[0]), MOVE_MISSILE, ent)
    } elif (ent.v.solid == float(SOLID_TRIGGER) || ent.v.solid == float(SOLID_NOT)) {
        // only clip against bmodels
        trace = SV_Move(addr(ent.v.origin[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(end[0]), MOVE_NOMONSTERS, ent)
    } else {
        trace = SV_Move(addr(ent.v.origin[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(end[0]), MOVE_NORMAL, ent)
    }
    ent.v.origin[0] = trace.endpos[0]
    ent.v.origin[1] = trace.endpos[1]
    ent.v.origin[2] = trace.endpos[2]
    SV_LinkEdict(ent, qboolean._c_true)
    if (trace.ent != null) {
        SV_Impact(ent, trace.ent)
    }
    return trace
}

// ============
// SV_PushMove
// ============
[c_function]
def SV_PushMove(var pusher : edict_s?; movetime : float) {
    var e : int
    var check : edict_s?
    var _c_block : edict_s?
    var mins : float[3]
    var maxs : float[3]
    var move : float[3]
    var entorig : float[3]
    var pushorig : float[3]
    var num_moved : int
    var moved_edict : edict_s? [600]
    var moved_from : float[600][3]
    if (pusher.v.velocity[0] == 0.0f && pusher.v.velocity[1] == 0.0f && pusher.v.velocity[2] == 0.0f) {
        pusher.v.ltime += movetime
        return
    }
    for (i in range(3)) {
        move[i] = pusher.v.velocity[i] * movetime
        mins[i] = pusher.v.absmin[i] + move[i]
        maxs[i] = pusher.v.absmax[i] + move[i]
    }
    pushorig[0] = pusher.v.origin[0]
    pushorig[1] = pusher.v.origin[1]
    pushorig[2] = pusher.v.origin[2]
    // move the pusher to it's final position
    pusher.v.origin[0] += move[0]
    pusher.v.origin[1] += move[1]
    pusher.v.origin[2] += move[2]
    pusher.v.ltime += movetime
    SV_LinkEdict(pusher, qboolean._c_false)
    // see if any solid entities are inside the final position
    num_moved = 0
    check = NEXT_EDICT(sv.edicts)
    {
        e = 1
        var _f = false
        while (true) {
            if (_f) {
                e++
                check = NEXT_EDICT(check)
            }
            _f = true
            if (!(e < sv.num_edicts)) {
                break
            }
            if (int(check.free) != 0) {
                continue
            }
            if (check.v.movetype == float(MOVETYPE_PUSH) || check.v.movetype == float(MOVETYPE_NONE) || check.v.movetype == float(MOVETYPE_NOCLIP)) {
                continue
            }
            // if the entity is standing on the pusher, it will definately be moved
            if (!((int(check.v.flags) & FL_ONGROUND) != 0 && intptr(PROG_TO_EDICT(check.v.groundentity)) == intptr(pusher))) {
                if (check.v.absmin[0] >= maxs[0] || check.v.absmin[1] >= maxs[1] || check.v.absmin[2] >= maxs[2] || check.v.absmax[0] <= mins[0] ||
                        check.v.absmax[1] <= mins[1] || check.v.absmax[2] <= mins[2]) {
                    continue
                }
                // see if the ent's bbox is inside the pusher's final position
                if (SV_TestEntityPosition(check) == null) {
                    continue
                }
            }
            // remove the onground flag for non-players
            if (check.v.movetype != float(MOVETYPE_WALK)) {
                check.v.flags = float(int(check.v.flags) & ~FL_ONGROUND)
            }
            entorig[0] = check.v.origin[0]
            entorig[1] = check.v.origin[1]
            entorig[2] = check.v.origin[2]
            moved_from[num_moved][0] = check.v.origin[0]
            moved_from[num_moved][1] = check.v.origin[1]
            moved_from[num_moved][2] = check.v.origin[2]
            moved_edict[num_moved] = check
            num_moved++
            // try moving the contacted entity
            pusher.v.solid = float(SOLID_NOT)
            SV_PushEntity(check, addr(move[0]))
            pusher.v.solid = float(SOLID_BSP)
            // if it is still inside the pusher, block
            _c_block = SV_TestEntityPosition(check)
            if (_c_block != null) {
                // fail the move
                if (check.v.mins[0] == check.v.maxs[0]) {
                    continue
                }
                if (check.v.solid == float(SOLID_NOT) || check.v.solid == float(SOLID_TRIGGER)) {
                    // corpse
                    check.v.mins[1] = 0.0f
                    check.v.mins[0] = check.v.mins[1]
                    check.v.maxs[0] = check.v.mins[0]
                    check.v.maxs[1] = check.v.mins[1]
                    check.v.maxs[2] = check.v.mins[2]
                    continue
                }
                check.v.origin[0] = entorig[0]
                check.v.origin[1] = entorig[1]
                check.v.origin[2] = entorig[2]
                SV_LinkEdict(check, qboolean._c_true)
                pusher.v.origin[0] = pushorig[0]
                pusher.v.origin[1] = pushorig[1]
                pusher.v.origin[2] = pushorig[2]
                SV_LinkEdict(pusher, qboolean._c_false)
                pusher.v.ltime -= movetime
                // if the pusher has a "blocked" function, call it
                // otherwise, just stay in place until the obstacle is gone
                if (pusher.v.blocked != 0) {
                    pr_global_struct.self = int(EDICT_TO_PROG(pusher))
                    pr_global_struct.other = int(EDICT_TO_PROG(check))
                    PR_ExecuteProgram(pusher.v.blocked)
                }
                // move back any entities we already moved
                for (i in range(num_moved)) {
                    moved_edict[i].v.origin[0] = moved_from[i][0]
                    moved_edict[i].v.origin[1] = moved_from[i][1]
                    moved_edict[i].v.origin[2] = moved_from[i][2]
                    SV_LinkEdict(moved_edict[i], qboolean._c_false)
                }
                return
            }
        }
    }
}

// ================
// SV_Physics_Pusher
// ================
def SV_Physics_Pusher(var ent : edict_s?) {
    var thinktime : float
    var oldltime : float
    var movetime : float
    oldltime = ent.v.ltime
    thinktime = ent.v.nextthink
    if (double(thinktime) < double(ent.v.ltime) + host_frametime) {
        movetime = thinktime - ent.v.ltime
        if (movetime < 0.0f) {
            movetime = 0.0f
        }
    } else {
        movetime = float(host_frametime)
    }
    if (movetime != 0.0f) {
        // advances ent->v.ltime if not blocked
        SV_PushMove(ent, movetime)
    }
    if (thinktime > oldltime && thinktime <= ent.v.ltime) {
        ent.v.nextthink = 0.0f
        pr_global_struct.time = float(sv.time)
        pr_global_struct.self = int(EDICT_TO_PROG(ent))
        pr_global_struct.other = int(EDICT_TO_PROG(sv.edicts))
        PR_ExecuteProgram(ent.v.think)
        if (int(ent.free) != 0) {
            return
        }
    }
}

// =============
// SV_CheckStuck
// This is a big hack to try and fix the rare case of getting stuck in the world
// clipping hull.
// =============
def SV_CheckStuck(var ent : edict_s?) {
    var org : float[3]
    if (SV_TestEntityPosition(ent) == null) {
        ent.v.oldorigin[0] = ent.v.origin[0]
        ent.v.oldorigin[1] = ent.v.origin[1]
        ent.v.oldorigin[2] = ent.v.origin[2]
        return
    }
    org[0] = ent.v.origin[0]
    org[1] = ent.v.origin[1]
    org[2] = ent.v.origin[2]
    ent.v.origin[0] = ent.v.oldorigin[0]
    ent.v.origin[1] = ent.v.oldorigin[1]
    ent.v.origin[2] = ent.v.oldorigin[2]
    if (SV_TestEntityPosition(ent) == null) {
        Con_DPrintf`va(cstr("Unstuck.\n"), VaNone())
        SV_LinkEdict(ent, qboolean._c_true)
        return
    }
    for (z in range(18)) {
        for (i in range(-1, 2)) {
            for (j in range(-1, 2)) {
                ent.v.origin[0] = org[0] + float(i)
                ent.v.origin[1] = org[1] + float(j)
                ent.v.origin[2] = org[2] + float(z)
                if (SV_TestEntityPosition(ent) == null) {
                    Con_DPrintf`va(cstr("Unstuck.\n"), VaNone())
                    SV_LinkEdict(ent, qboolean._c_true)
                    return
                }
            }
        }
    }
    ent.v.origin[0] = org[0]
    ent.v.origin[1] = org[1]
    ent.v.origin[2] = org[2]
    Con_DPrintf`va(cstr("player is stuck.\n"), VaNone())
}

// =============
// SV_CheckWater
// =============
[c_function]
def SV_CheckWater(var ent : edict_s?) : qboolean {
    var point : float[3]
    var cont : int
    point[0] = ent.v.origin[0]
    point[1] = ent.v.origin[1]
    point[2] = ent.v.origin[2] + ent.v.mins[2] + 1.0f
    ent.v.waterlevel = 0.0f
    ent.v.watertype = float(CONTENTS_EMPTY)
    cont = SV_PointContents(addr(point[0]))
    if (cont <= CONTENTS_WATER) {
        ent.v.watertype = float(cont)
        ent.v.waterlevel = 1.0f
        point[2] = float(double(ent.v.origin[2]) + double(ent.v.mins[2] + ent.v.maxs[2]) * 0.5lf)
        cont = SV_PointContents(addr(point[0]))
        if (cont <= CONTENTS_WATER) {
            ent.v.waterlevel = 2.0f
            point[2] = ent.v.origin[2] + ent.v.view_ofs[2]
            cont = SV_PointContents(addr(point[0]))
            if (cont <= CONTENTS_WATER) {
                ent.v.waterlevel = 3.0f
            }
        }
    }
    return enum_from_int(type<qboolean>, int_of(ent.v.waterlevel > 1.0f))
}

// ============
// SV_WallFriction
// ============
[c_function]
def SV_WallFriction(var ent : edict_s?; var trace : trace_t?) {
    var forward : float[3]
    var right : float[3]
    var up : float[3]
    var d : float
    var i : float
    var into : float[3]
    var side : float[3]
    AngleVectors(addr(ent.v.v_angle[0]), addr(forward[0]), addr(right[0]), addr(up[0]))
    d = trace.plane.normal[0] * forward[0] + trace.plane.normal[1] * forward[1] + trace.plane.normal[2] * forward[2]
    d = float(double(d) + 0.5lf)
    if (d >= 0.0f) {
        return
    }
    // cut the tangential velocity
    i = trace.plane.normal[0] * ent.v.velocity[0] + trace.plane.normal[1] * ent.v.velocity[1] + trace.plane.normal[2] * ent.v.velocity[2]
    VectorScale(addr(trace.plane.normal[0]), i, addr(into[0]))
    side[0] = ent.v.velocity[0] - into[0]
    side[1] = ent.v.velocity[1] - into[1]
    side[2] = ent.v.velocity[2] - into[2]
    ent.v.velocity[0] = side[0] * (1.0f + d)
    ent.v.velocity[1] = side[1] * (1.0f + d)
}

// =====================
// SV_TryUnstick
// Player has come to a dead stop, possibly due to the problem with limited
// float precision at some angle joins in the BSP hull.
// Try fixing by pushing one pixel in each direction.
// This is a hack, but in the interest of good gameplay...
// ======================
[c_function]
def SV_TryUnstick(var ent : edict_s?; var oldvel : float?) : int {
    var oldorg : float[3]
    var dir : float[3]
    var clip : int
    var steptrace : trace_t
    oldorg[0] = ent.v.origin[0]
    oldorg[1] = ent.v.origin[1]
    oldorg[2] = ent.v.origin[2]
    dir[0] = vec3_origin[0]
    dir[1] = vec3_origin[1]
    dir[2] = vec3_origin[2]
    for (i in range(8)) {
        // try pushing a little in an axial direction
        c_switch(i) {
            case(0) {
                dir[0] = 2.0f
                dir[1] = 0.0f
                break
            }
            case(1) {
                dir[0] = 0.0f
                dir[1] = 2.0f
                break
            }
            case(2) {
                dir[0] = -2.0f
                dir[1] = 0.0f
                break
            }
            case(3) {
                dir[0] = 0.0f
                dir[1] = -2.0f
                break
            }
            case(4) {
                dir[0] = 2.0f
                dir[1] = 2.0f
                break
            }
            case(5) {
                dir[0] = -2.0f
                dir[1] = 2.0f
                break
            }
            case(6) {
                dir[0] = 2.0f
                dir[1] = -2.0f
                break
            }
            case(7) {
                dir[0] = -2.0f
                dir[1] = -2.0f
                break
            }
        }
        SV_PushEntity(ent, addr(dir[0]))
        // retry the original move
        ent.v.velocity[0] = oldvel[0]
        ent.v.velocity[1] = oldvel[1]
        ent.v.velocity[2] = 0.0f
        clip = SV_FlyMove(ent, float(0.1lf), addr(steptrace))
        if (math::abs(double(oldorg[1] - ent.v.origin[1])) > 4.0lf || math::abs(double(oldorg[0] - ent.v.origin[0])) > 4.0lf) {
            // Con_DPrintf ("unstuck!\n");
            return clip
        }
        // go back to the original pos and try again
        ent.v.origin[0] = oldorg[0]
        ent.v.origin[1] = oldorg[1]
        ent.v.origin[2] = oldorg[2]
    }
    ent.v.velocity[0] = vec3_origin[0]
    ent.v.velocity[1] = vec3_origin[1]
    ent.v.velocity[2] = vec3_origin[2]
    // still not moving
    return 7
}

// =====================
// SV_WalkMove
// Only used by players
// ======================
[c_function]
def SV_WalkMove(var ent : edict_s?) {
    var upmove : float[3]
    var downmove : float[3]
    var oldorg : float[3]
    var oldvel : float[3]
    var nosteporg : float[3]
    var nostepvel : float[3]
    var clip : int
    var oldonground : int
    var steptrace : trace_t
    var downtrace : trace_t
    // do a regular slide move unless it looks like you ran into a step
    oldonground = int(ent.v.flags) & FL_ONGROUND
    ent.v.flags = float(int(ent.v.flags) & ~FL_ONGROUND)
    oldorg[0] = ent.v.origin[0]
    oldorg[1] = ent.v.origin[1]
    oldorg[2] = ent.v.origin[2]
    oldvel[0] = ent.v.velocity[0]
    oldvel[1] = ent.v.velocity[1]
    oldvel[2] = ent.v.velocity[2]
    clip = SV_FlyMove(ent, float(host_frametime), addr(steptrace))
    if ((clip & 2) == 0) {
        // move didn't block on a step
        return
    }
    if (oldonground == 0 && ent.v.waterlevel == 0.0f) {
        // don't stair up while jumping
        return
    }
    if (ent.v.movetype != float(MOVETYPE_WALK)) {
        // gibbed by a trigger
        return
    }
    if (sv_nostep.value != 0.0f) {
        return
    }
    if ((int(sv_player.v.flags) & FL_WATERJUMP) != 0) {
        return
    }
    nosteporg[0] = ent.v.origin[0]
    nosteporg[1] = ent.v.origin[1]
    nosteporg[2] = ent.v.origin[2]
    nostepvel[0] = ent.v.velocity[0]
    nostepvel[1] = ent.v.velocity[1]
    nostepvel[2] = ent.v.velocity[2]
    // try moving up and forward to go up a step
    // back to start pos
    ent.v.origin[0] = oldorg[0]
    ent.v.origin[1] = oldorg[1]
    ent.v.origin[2] = oldorg[2]
    upmove[0] = vec3_origin[0]
    upmove[1] = vec3_origin[1]
    upmove[2] = vec3_origin[2]
    downmove[0] = vec3_origin[0]
    downmove[1] = vec3_origin[1]
    downmove[2] = vec3_origin[2]
    upmove[2] = float(STEPSIZE)
    downmove[2] = float(double(-STEPSIZE) + double(oldvel[2]) * host_frametime)
    // move up
    // FIXME: don't link?
    SV_PushEntity(ent, addr(upmove[0]))
    // move forward
    ent.v.velocity[0] = oldvel[0]
    ent.v.velocity[1] = oldvel[1]
    ent.v.velocity[2] = 0.0f
    clip = SV_FlyMove(ent, float(host_frametime), addr(steptrace))
    // check for stuckness, possibly due to the limited precision of floats
    // in the clipping hulls
    if (clip != 0) {
        if (math::abs(double(oldorg[1] - ent.v.origin[1])) < 0.03125lf && math::abs(double(oldorg[0] - ent.v.origin[0])) < 0.03125lf) {
            // stepping up didn't make any progress
            clip = SV_TryUnstick(ent, addr(oldvel[0]))
        }
    }
    // extra friction based on view angle
    if ((clip & 2) != 0) {
        SV_WallFriction(ent, addr(steptrace))
    }
    // move down
    // FIXME: don't link?
    downtrace = SV_PushEntity(ent, addr(downmove[0]))
    if (double(downtrace.plane.normal[2]) > 0.7lf) {
        if (ent.v.solid == float(SOLID_BSP)) {
            ent.v.flags = float(int(ent.v.flags) | FL_ONGROUND)
            ent.v.groundentity = int(EDICT_TO_PROG(downtrace.ent))
        }
    } else {
        // if the push down didn't end up on good ground, use the move without
        // the step up. This happens near wall / slope combinations, and can
        // cause the player to hop up higher on a slope too steep to climb
        ent.v.origin[0] = nosteporg[0]
        ent.v.origin[1] = nosteporg[1]
        ent.v.origin[2] = nosteporg[2]
        ent.v.velocity[0] = nostepvel[0]
        ent.v.velocity[1] = nostepvel[1]
        ent.v.velocity[2] = nostepvel[2]
    }
}

// ================
// SV_Physics_Client
// Player character actions
// ================
[c_function]
def SV_Physics_Client(var ent : edict_s?; num : int) {
    if (int(svs.clients[num - 1].active) == 0) {
        // unconnected slot
        return
    }
    // call standard client pre-think
    pr_global_struct.time = float(sv.time)
    pr_global_struct.self = int(EDICT_TO_PROG(ent))
    PR_ExecuteProgram(pr_global_struct.PlayerPreThink)
    // do a move
    SV_CheckVelocity(ent)
    // decide which move function to call
    c_switch(int(ent.v.movetype)) {
        case(0) {
            if (int(SV_RunThink(ent)) == 0) {
                return
            }
            break
        }
        case(3) {
            if (int(SV_RunThink(ent)) == 0) {
                return
            }
            if (int(SV_CheckWater(ent)) == 0 && (int(ent.v.flags) & FL_WATERJUMP) == 0) {
                SV_AddGravity(ent)
            }
            SV_CheckStuck(ent)
            SV_WalkMove(ent)
            break
        }
        case(6, 10) {
            SV_Physics_Toss(ent)
            break
        }
        case(5) {
            if (int(SV_RunThink(ent)) == 0) {
                return
            }
            SV_FlyMove(ent, float(host_frametime), null)
            break
        }
        case(8) {
            if (int(SV_RunThink(ent)) == 0) {
                return
            }
            VectorMA(addr(ent.v.origin[0]), float(host_frametime), addr(ent.v.velocity[0]), addr(ent.v.origin[0]))
            break
        }
        case(_) {
            Sys_Error`va(cstr("SV_Physics_client: bad movetype %i"), (int(ent.v.movetype),))
        }
    }
    // call standard player post-think
    SV_LinkEdict(ent, qboolean._c_true)
    pr_global_struct.time = float(sv.time)
    pr_global_struct.self = int(EDICT_TO_PROG(ent))
    PR_ExecuteProgram(pr_global_struct.PlayerPostThink)
}

// =============
// SV_Physics_None
// Non moving objects can only think
// =============
def SV_Physics_None(var ent : edict_s?) {
    // regular thinking
    SV_RunThink(ent)
}

// =============
// SV_Physics_Noclip
// A moving object that doesn't obey physics
// =============
[c_function]
def SV_Physics_Noclip(var ent : edict_s?) {
    // regular thinking
    if (int(SV_RunThink(ent)) == 0) {
        return
    }
    VectorMA(addr(ent.v.angles[0]), float(host_frametime), addr(ent.v.avelocity[0]), addr(ent.v.angles[0]))
    VectorMA(addr(ent.v.origin[0]), float(host_frametime), addr(ent.v.velocity[0]), addr(ent.v.origin[0]))
    SV_LinkEdict(ent, qboolean._c_false)
}

// =============
// SV_CheckWaterTransition
// =============
[c_function]
def SV_CheckWaterTransition(var ent : edict_s?) {
    var cont : int
    cont = SV_PointContents(addr(ent.v.origin[0]))
    if (ent.v.watertype == 0.0f) {
        // just spawned here
        ent.v.watertype = float(cont)
        ent.v.waterlevel = 1.0f
        return
    }
    if (cont <= CONTENTS_WATER) {
        if (ent.v.watertype == float(CONTENTS_EMPTY)) {
            // just crossed into water
            SV_StartSound(ent, 0, cstr("misc/h2ohit1.wav"), 255, 1.0f)
        }
        ent.v.watertype = float(cont)
        ent.v.waterlevel = 1.0f
    } else {
        if (ent.v.watertype != float(CONTENTS_EMPTY)) {
            // just crossed into water
            SV_StartSound(ent, 0, cstr("misc/h2ohit1.wav"), 255, 1.0f)
        }
        ent.v.watertype = float(CONTENTS_EMPTY)
        ent.v.waterlevel = float(cont)
    }
}

// =============
// SV_Physics_Toss
// Toss, bounce, and fly movement. When onground, do nothing.
// =============
[c_function]
def SV_Physics_Toss(var ent : edict_s?) {
    var trace : trace_t
    var move : float[3]
    var backoff : float
    // regular thinking
    if (int(SV_RunThink(ent)) == 0) {
        return
    }
    // if onground, return without moving
    if ((int(ent.v.flags) & FL_ONGROUND) != 0) {
        return
    }
    SV_CheckVelocity(ent)
    // add gravity
    if (ent.v.movetype != float(MOVETYPE_FLY) && ent.v.movetype != float(MOVETYPE_FLYMISSILE)) {
        SV_AddGravity(ent)
    }
    // move angles
    VectorMA(addr(ent.v.angles[0]), float(host_frametime), addr(ent.v.avelocity[0]), addr(ent.v.angles[0]))
    // move origin
    VectorScale(addr(ent.v.velocity[0]), float(host_frametime), addr(move[0]))
    trace = SV_PushEntity(ent, addr(move[0]))
    if (trace.fraction == 1.0f) {
        return
    }
    if (int(ent.free) != 0) {
        return
    }
    if (ent.v.movetype == float(MOVETYPE_BOUNCE)) {
        backoff = float(1.5lf)
    } else {
        backoff = 1.0f
    }
    ClipVelocity(addr(ent.v.velocity[0]), addr(trace.plane.normal[0]), addr(ent.v.velocity[0]), backoff)
    // stop if on ground
    if (double(trace.plane.normal[2]) > 0.7lf) {
        if (ent.v.velocity[2] < 60.0f || ent.v.movetype != float(MOVETYPE_BOUNCE)) {
            ent.v.flags = float(int(ent.v.flags) | FL_ONGROUND)
            ent.v.groundentity = int(EDICT_TO_PROG(trace.ent))
            ent.v.velocity[0] = vec3_origin[0]
            ent.v.velocity[1] = vec3_origin[1]
            ent.v.velocity[2] = vec3_origin[2]
            ent.v.avelocity[0] = vec3_origin[0]
            ent.v.avelocity[1] = vec3_origin[1]
            ent.v.avelocity[2] = vec3_origin[2]
        }
    }
    // check for in water
    SV_CheckWaterTransition(ent)
}

// =============
// SV_Physics_Step
// Monsters freefall when they don't have a ground entity, otherwise
// all movement is done with discrete steps.
// This is also used for objects that have become still on the ground, but
// will fall if the floor is pulled out from under them.
// =============
def SV_Physics_Step(var ent : edict_s?) {
    var hitsound : qboolean
    // freefall if not onground
    if ((int(ent.v.flags) & (FL_ONGROUND | FL_FLY | FL_SWIM)) == 0) {
        if (double(ent.v.velocity[2]) < double(sv_gravity.value) * -0.1lf) {
            hitsound = qboolean._c_true
        } else {
            hitsound = qboolean._c_false
        }
        SV_AddGravity(ent)
        SV_CheckVelocity(ent)
        SV_FlyMove(ent, float(host_frametime), null)
        SV_LinkEdict(ent, qboolean._c_true)
        // just hit ground
        if ((int(ent.v.flags) & FL_ONGROUND) != 0) {
            if (int(hitsound) != 0) {
                SV_StartSound(ent, 0, cstr("demon/dland2.wav"), 255, 1.0f)
            }
        }
    }
    // regular thinking
    SV_RunThink(ent)
    SV_CheckWaterTransition(ent)
}

// ================
// SV_Physics
// ================
def SV_Physics {
    var i : int
    var ent : edict_s?
    // let the progs know that a new frame has started
    pr_global_struct.self = int(EDICT_TO_PROG(sv.edicts))
    pr_global_struct.other = int(EDICT_TO_PROG(sv.edicts))
    pr_global_struct.time = float(sv.time)
    PR_ExecuteProgram(pr_global_struct.StartFrame)
    // SV_CheckAllEnts ();
    // treat each object in turn
    ent = sv.edicts
    i = 0
    while (i < sv.num_edicts) {
        {
            if (int(ent.free) != 0) {
                continue
            }
            if (pr_global_struct.force_retouch != 0.0f) {
                // force retouch even for stationary
                SV_LinkEdict(ent, qboolean._c_true)
            }
            if (i > 0 && i <= svs.maxclients) {
                SV_Physics_Client(ent, i)
            } elif (ent.v.movetype == float(MOVETYPE_PUSH)) {
                SV_Physics_Pusher(ent)
            } elif (ent.v.movetype == float(MOVETYPE_NONE)) {
                SV_Physics_None(ent)
            } elif (ent.v.movetype == float(MOVETYPE_NOCLIP)) {
                SV_Physics_Noclip(ent)
            } elif (ent.v.movetype == float(MOVETYPE_STEP)) {
                SV_Physics_Step(ent)
            } elif (ent.v.movetype == float(MOVETYPE_TOSS) || ent.v.movetype == float(MOVETYPE_BOUNCE) || ent.v.movetype == float(MOVETYPE_FLY) ||
                    ent.v.movetype == float(MOVETYPE_FLYMISSILE)) {
                SV_Physics_Toss(ent)
            } else {
                Sys_Error`va(cstr("SV_Physics: bad movetype %i"), (int(ent.v.movetype),))
            }
        } finally {
            i++
            ent = NEXT_EDICT(ent)
        }
    }
    if (pr_global_struct.force_retouch != 0.0f) {
        pr_global_struct.force_retouch--
    }
    sv.time += host_frametime
}

