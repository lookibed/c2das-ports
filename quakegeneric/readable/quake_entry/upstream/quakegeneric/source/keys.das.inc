// ====================
// Key_Console
// Interactive line editing and console scrollback
// ====================
[c_function]
def Key_Console(key : int) {
    var cmd : uint8?
    if (key == K_ENTER) {
        // skip the >
        Cbuf_AddText(addr(key_lines[edit_line][0]) + 1)
        Cbuf_AddText(cstr("\n"))
        Con_Printf`va(cstr("%s\n"), (addr(key_lines[edit_line][0]),))
        edit_line = (edit_line + 1) & 31
        history_line = edit_line
        key_lines[edit_line][0] = uint8(']')
        key_linepos = 1
        if (cls.state == cactive_t.ca_disconnected) {
            // force an update, because the command
            SCR_UpdateScreen()
        }
        // may take some time
        return
    }
    if (key == K_TAB) {
        // command completion
        cmd = Cmd_CompleteCommand(addr(key_lines[edit_line][0]) + 1)
        if (cmd == null) {
            cmd = Cvar_CompleteVariable(addr(key_lines[edit_line][0]) + 1)
        }
        if (cmd != null) {
            Q_strcpy(addr(key_lines[edit_line][0]) + 1, cmd)
            key_linepos = Q_strlen(cmd) + 1
            key_lines[edit_line][key_linepos] = uint8(' ')
            key_linepos++
            key_lines[edit_line][key_linepos] = 0u8
            return
        }
    }
    if (key == K_BACKSPACE || key == K_LEFTARROW) {
        if (key_linepos > 1) {
            key_linepos--
        }
        return
    }
    if (key == K_UPARROW) {
        c_do_while(history_line != edit_line && key_lines[history_line][1] == 0) {
            history_line = (history_line - 1) & 31
        }
        if (history_line == edit_line) {
            history_line = (edit_line + 1) & 31
        }
        Q_strcpy(addr(key_lines[edit_line][0]), addr(key_lines[history_line][0]))
        key_linepos = Q_strlen(addr(key_lines[edit_line][0]))
        return
    }
    if (key == K_DOWNARROW) {
        if (history_line == edit_line) {
            return
        }
        c_do_while(history_line != edit_line && key_lines[history_line][1] == 0) {
            history_line = (history_line + 1) & 31
        }
        if (history_line == edit_line) {
            key_lines[edit_line][0] = uint8(']')
            key_linepos = 1
        } else {
            Q_strcpy(addr(key_lines[edit_line][0]), addr(key_lines[history_line][0]))
            key_linepos = Q_strlen(addr(key_lines[edit_line][0]))
        }
        return
    }
    if (key == K_PGUP || key == K_MWHEELUP) {
        con_backscroll += 2
        if (uint(con_backscroll) > uint(con_totallines) - (vid.height >> 3u) - 1u) {
            con_backscroll = int(uint(con_totallines) - (vid.height >> 3u) - 1u)
        }
        return
    }
    if (key == K_PGDN || key == K_MWHEELDOWN) {
        con_backscroll -= 2
        if (con_backscroll < 0) {
            con_backscroll = 0
        }
        return
    }
    if (key == K_HOME) {
        con_backscroll = int(uint(con_totallines) - (vid.height >> 3u) - 1u)
        return
    }
    if (key == K_END) {
        con_backscroll = 0
        return
    }
    if (key < 32 || key > 127) {
        // non printable
        return
    }
    if (key_linepos < MAXCMDLINE - 1) {
        key_lines[edit_line][key_linepos] = uint8(key)
        key_linepos++
        key_lines[edit_line][key_linepos] = 0u8
    }
}

[c_function]
def Key_Message(key : int) {
    if (key == K_ENTER) {
        if (int(team_message) != 0) {
            Cbuf_AddText(cstr("say_team \""))
        } else {
            Cbuf_AddText(cstr("say \""))
        }
        Cbuf_AddText(addr(chat_buffer[0]))
        Cbuf_AddText(cstr("\"\n"))
        key_dest = keydest_t.key_game
        Key_Message_chat_bufferlen = 0
        chat_buffer[0] = 0u8
        return
    }
    if (key == K_ESCAPE) {
        key_dest = keydest_t.key_game
        Key_Message_chat_bufferlen = 0
        chat_buffer[0] = 0u8
        return
    }
    if (key < 32 || key > 127) {
        // non printable
        return
    }
    if (key == K_BACKSPACE) {
        if (Key_Message_chat_bufferlen != 0) {
            Key_Message_chat_bufferlen--
            chat_buffer[Key_Message_chat_bufferlen] = 0u8
        }
        return
    }
    if (Key_Message_chat_bufferlen == 31) {
        // all full
        return
    }
    let _t0 = Key_Message_chat_bufferlen
    Key_Message_chat_bufferlen++
    chat_buffer[_t0] = uint8(key)
    chat_buffer[Key_Message_chat_bufferlen] = 0u8
}

// ===================
// Key_StringToKeynum
// Returns a key number to be used to index keybindings[] by looking at
// the given string. Single ascii characters return themselves, while
// the K_* names are matched up.
// ===================
[c_function]
def Key_StringToKeynum(var str : uint8?) : int {
    var kn : keyname_t?
    if (str == null || str[0] == 0) {
        return -1
    }
    if (str[1] == 0) {
        return int(str[0])
    }
    kn = addr(keynames[0])
    while (kn.name != null) {
        if (Q_strcasecmp(str, kn.name) == 0) {
            return kn.keynum
        }
        kn++
    }
    return -1
}

// ===================
// Key_KeynumToString
// Returns a string (either a single ascii char, or a K_* name) for the
// given keynum.
// FIXME: handle quote special (general escape sequence?)
// ===================
[c_function]
def Key_KeynumToString(keynum : int) : uint8? {
    var kn : keyname_t?
    if (keynum == -1) {
        return cstr("<KEY NOT FOUND>")
    }
    if (keynum > 32 && keynum < 127) {
        // printable ascii
        Key_KeynumToString_tinystr[0] = uint8(keynum)
        Key_KeynumToString_tinystr[1] = 0u8
        return addr(Key_KeynumToString_tinystr[0])
    }
    kn = addr(keynames[0])
    while (kn.name != null) {
        if (keynum == kn.keynum) {
            return kn.name
        }
        kn++
    }
    return cstr("<UNKNOWN KEYNUM>")
}

// ===================
// Key_SetBinding
// ===================
[c_function]
def Key_SetBinding(keynum : int; var binding : uint8?) {
    var _c_new : uint8?
    var l : int
    if (keynum == -1) {
        return
    }
    // free old bindings
    if (keybindings[keynum] != null) {
        Z_Free(reinterpret<void?>(keybindings[keynum]))
        keybindings[keynum] = null
    }
    // allocate memory for new binding
    l = Q_strlen(binding)
    _c_new = reinterpret<uint8?>(Z_Malloc(l + 1))
    Q_strcpy(_c_new, binding)
    _c_new[l] = 0u8
    keybindings[keynum] = _c_new
}

// ===================
// Key_Unbind_f
// ===================
[c_function]
def Key_Unbind_f {
    var b : int
    if (Cmd_Argc() != 2) {
        Con_Printf`va(cstr("unbind <key> : remove commands from a key\n"), VaNone())
        return
    }
    b = Key_StringToKeynum(Cmd_Argv(1))
    if (b == -1) {
        Con_Printf`va(cstr("\"%s\" isn't a valid key\n"), (Cmd_Argv(1),))
        return
    }
    Key_SetBinding(b, addr(c2das_empty[0]))
}

[c_function]
def Key_Unbindall_f {
    for (i in range(256)) {
        if (keybindings[i] != null) {
            Key_SetBinding(i, addr(c2das_empty[0]))
        }
    }
}

// ===================
// Key_Bind_f
// ===================
[c_function]
def Key_Bind_f {
    var c : int
    var b : int
    var cmd : uint8[1024]
    c = Cmd_Argc()
    if (c != 2 && c != 3) {
        Con_Printf`va(cstr("bind <key> [command] : attach a command to a key\n"), VaNone())
        return
    }
    b = Key_StringToKeynum(Cmd_Argv(1))
    if (b == -1) {
        Con_Printf`va(cstr("\"%s\" isn't a valid key\n"), (Cmd_Argv(1),))
        return
    }
    if (c == 2) {
        if (keybindings[b] != null) {
            Con_Printf`va(cstr("\"%s\" = \"%s\"\n"), (Cmd_Argv(1), keybindings[b]))
        } else {
            Con_Printf`va(cstr("\"%s\" is not bound\n"), (Cmd_Argv(1),))
        }
        return
    }
    // copy the rest of the command line
    // start out with a null string
    cmd[0] = 0u8
    for (i in range(2, c)) {
        if (i > 2) {
            crt::strcat(addr(cmd[0]), cstr(" "))
        }
        crt::strcat(addr(cmd[0]), Cmd_Argv(i))
    }
    Key_SetBinding(b, addr(cmd[0]))
}

// ============
// Key_WriteBindings
// Writes lines containing "bind key value"
// ============
[c_function]
def Key_WriteBindings(var f : _IO_FILE?) {
    for (i in range(256)) {
        if (keybindings[i] != null) {
            if (*keybindings[i] != 0) {
                fprintf(reinterpret<void?>(f), cstr("bind \"%s\" \"%s\"\n"), Key_KeynumToString(i), keybindings[i])
            }
        }
    }
}

// ===================
// Key_Init
// ===================
def Key_Init {
    for (i in range(32)) {
        key_lines[i][0] = uint8(']')
        key_lines[i][1] = 0u8
    }
    key_linepos = 1
    // init ascii characters in console mode
    for (i in range(32, 128)) {
        consolekeys[i] = qboolean._c_true
    }
    consolekeys[K_ENTER] = qboolean._c_true
    consolekeys[K_TAB] = qboolean._c_true
    consolekeys[K_LEFTARROW] = qboolean._c_true
    consolekeys[K_RIGHTARROW] = qboolean._c_true
    consolekeys[K_UPARROW] = qboolean._c_true
    consolekeys[K_DOWNARROW] = qboolean._c_true
    consolekeys[K_BACKSPACE] = qboolean._c_true
    consolekeys[K_PGUP] = qboolean._c_true
    consolekeys[K_PGDN] = qboolean._c_true
    consolekeys[K_SHIFT] = qboolean._c_true
    consolekeys[K_MWHEELUP] = qboolean._c_true
    consolekeys[K_MWHEELDOWN] = qboolean._c_true
    consolekeys['`'] = qboolean._c_false
    consolekeys['~'] = qboolean._c_false
    for (i in range(256)) {
        keyshift[i] = i
    }
    for (i in range('a', 'z' + 1)) {
        keyshift[i] = i - 'a' + 'A'
    }
    keyshift['1'] = '!'
    keyshift['2'] = '@'
    keyshift['3'] = '#'
    keyshift['4'] = '$'
    keyshift['5'] = '%'
    keyshift['6'] = '^'
    keyshift['7'] = '&'
    keyshift['8'] = '*'
    keyshift['9'] = '('
    keyshift['0'] = ')'
    keyshift['-'] = '_'
    keyshift['='] = '+'
    keyshift[','] = '<'
    keyshift['.'] = '>'
    keyshift['/'] = '?'
    keyshift[';'] = ':'
    keyshift['\''] = '"'
    keyshift['['] = '{'
    keyshift[']'] = '}'
    keyshift['`'] = '~'
    keyshift['\\'] = '|'
    menubound[K_ESCAPE] = qboolean._c_true
    for (i in range(12)) {
        menubound[K_F1 + i] = qboolean._c_true
    }
    // register our functions
    Cmd_AddCommand(cstr("bind"), @@Key_Bind_f)
    Cmd_AddCommand(cstr("unbind"), @@Key_Unbind_f)
    Cmd_AddCommand(cstr("unbindall"), @@Key_Unbindall_f)
}

// ===================
// Key_Event
// Called by the system between frames for both key up and key down events
// Should NOT be called during an interrupt!
// ===================
[c_function]
def Key_Event(var key : int; down : qboolean) {
    var kb : uint8?
    var cmd : uint8[1024]
    keydown[key] = down
    if (int(down) == 0) {
        key_repeats[key] = 0
    }
    key_lastpress = key
    key_count++
    if (key_count <= 0) {
        // just catching keys for Con_NotifyBox
        return
    }
    // update auto-repeat status
    if (int(down) != 0) {
        key_repeats[key]++
        if (key != K_BACKSPACE && key != K_PAUSE && key_repeats[key] > 1) {
            // ignore most autorepeats
            return
        }
        if (key >= 200 && keybindings[key] == null) {
            Con_Printf`va(cstr("%s is unbound, hit F4 to set.\n"), (Key_KeynumToString(key),))
        }
    }
    if (key == K_SHIFT) {
        shift_down = int(down)
    }
    // handle escape specialy, so the user can never unbind it
    if (key == K_ESCAPE) {
        if (int(down) == 0) {
            return
        }
        c_switch(key_dest) {
            case(keydest_t.key_message) {
                Key_Message(key)
                break
            }
            case(keydest_t.key_menu) {
                M_Keydown(key)
                break
            }
            case(keydest_t.key_game, keydest_t.key_console) {
                M_ToggleMenu_f()
                break
            }
            case(_) {
                Sys_Error`va(cstr("Bad key_dest"), VaNone())
            }
        }
        return
    }
    // key up events only generate commands if the game key binding is
    // a button command (leading + sign). These will occur even in console mode,
    // to keep the character from continuing an action started before a console
    // switch. Button commands include the kenum as a parameter, so multiple
    // downs can be matched with ups
    if (int(down) == 0) {
        kb = keybindings[key]
        if (kb != null && kb[0] == '+') {
            sprintf(addr(cmd[0]), cstr("-%s %i\n"), kb + 1, key)
            Cbuf_AddText(addr(cmd[0]))
        }
        if (keyshift[key] != key) {
            kb = keybindings[keyshift[key]]
            if (kb != null && kb[0] == '+') {
                sprintf(addr(cmd[0]), cstr("-%s %i\n"), kb + 1, key)
                Cbuf_AddText(addr(cmd[0]))
            }
        }
        return
    }
    // during demo playback, most keys bring up the main menu
    if (uint(cls.demoplayback) != 0 && uint(down) != 0 && uint(consolekeys[key]) != 0 && key_dest == keydest_t.key_game) {
        M_ToggleMenu_f()
        return
    }
    // if not a consolekey, send to the interpreter no matter what mode is
    if ((key_dest == keydest_t.key_menu && uint(menubound[key]) != 0) || (key_dest == keydest_t.key_console && int(consolekeys[key]) == 0) ||
            (key_dest == keydest_t.key_game && (int(con_forcedup) == 0 || int(consolekeys[key]) == 0))) {
        kb = keybindings[key]
        if (kb != null) {
            if (kb[0] == '+') {
                // button commands add keynum as a parm
                sprintf(addr(cmd[0]), cstr("%s %i\n"), kb, key)
                Cbuf_AddText(addr(cmd[0]))
            } else {
                Cbuf_AddText(kb)
                Cbuf_AddText(cstr("\n"))
            }
        }
        return
    }
    if (int(down) == 0) {
        // other systems only care about key down events
        return
    }
    if (shift_down != 0) {
        key = keyshift[key]
    }
    c_switch(key_dest) {
        case(keydest_t.key_message) {
            Key_Message(key)
            break
        }
        case(keydest_t.key_menu) {
            M_Keydown(key)
            break
        }
        case(keydest_t.key_game, keydest_t.key_console) {
            Key_Console(key)
            break
        }
        case(_) {
            Sys_Error`va(cstr("Bad key_dest"), VaNone())
        }
    }
}

// ===================
// Key_ClearStates
// ===================
def Key_ClearStates {
    for (i in range(256)) {
        keydown[i] = qboolean._c_false
        key_repeats[i] = 0
    }
}

