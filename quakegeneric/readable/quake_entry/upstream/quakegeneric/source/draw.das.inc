// generated by c2das - regenerate, never edit
struct rectdesc_t {
    rect : vrect_s
    width, height : int
    ptexbytes : uint8?
    rowbytes : int
}

struct cachepic_s {
    name : uint8[64]
    cache : cache_user_s
}

var draw_disc : qpic_t?
var private r_rectdesc : rectdesc_t
var draw_chars : uint8?
var draw_backtile : qpic_t?
var menu_cachepics : cachepic_s[128]
var menu_numcachepics : int

[c_function]
def Draw_PicFromWad(var name : uint8?) : qpic_t? {
    return reinterpret<qpic_t?>(W_GetLumpName(name))
}

// ================
// Draw_CachePic
// ================
[c_function]
def Draw_CachePic(var path : uint8?) : qpic_t? {
    var pic : cachepic_s?
    var i : int
    var dat : qpic_t?
    pic = addr(menu_cachepics[0])
    i = 0
    while (i < menu_numcachepics) {
        if (crt::strcmp(path, addr(pic.name[0])) == 0) {
            break
        }
        pic++
        i++
    }
    if (i == menu_numcachepics) {
        if (menu_numcachepics == MAX_CACHED_PICS) {
            Sys_Error`va(cstr("menu_numcachepics == MAX_CACHED_PICS"), VaNone())
        }
        menu_numcachepics++
        crt::strcpy(addr(pic.name[0]), path)
    }
    dat = reinterpret<qpic_t?>(Cache_Check(addr(pic.cache)))
    if (dat != null) {
        return dat
    }
    // load the pic from disk
    COM_LoadCacheFile(path, addr(pic.cache))
    dat = reinterpret<qpic_t?>(pic.cache.data)
    if (dat == null) {
        Sys_Error`va(cstr("Draw_CachePic: failed to load %s"), (path,))
    }
    SwapPic(dat)
    return dat
}

// ===============
// Draw_Init
// ===============
[c_function]
def Draw_Init {
    var i : int
    draw_chars = reinterpret<uint8?>(W_GetLumpName(cstr("conchars")))
    draw_disc = reinterpret<qpic_t?>(W_GetLumpName(cstr("disc")))
    draw_backtile = reinterpret<qpic_t?>(W_GetLumpName(cstr("backtile")))
    r_rectdesc.width = draw_backtile.width
    r_rectdesc.height = draw_backtile.height
    r_rectdesc.ptexbytes = addr(draw_backtile.data[0])
    r_rectdesc.rowbytes = draw_backtile.width
}

// ================
// Draw_Character
// Draws one 8*8 graphics character with 0 being transparent.
// It can be clipped to the top of the screen to allow the console to be
// smoothly scrolled off.
// ================
[c_function]
def Draw_Character(x : int; var y : int; var num : int) {
    var dest : uint8?
    var source : uint8?
    var pusdest : uint16?
    var drawline : int
    var row : int
    var col : int
    num &= 255
    if (y <= -8) {
        // totally off screen
        return
    }
    row = num >> 4
    col = num & 15
    source = draw_chars + (row << 10) + (col << 3)
    if (y < 0) {
        // clipped
        drawline = 8 + y
        source -= 128 * y
        y = 0
    } else {
        drawline = 8
    }
    dest = vid.conbuffer + y * vid.conrowbytes + x
    while (true) {
        let _t0 = drawline
        drawline--
        if (_t0 == 0) {
            break
        }
        if (source[0] != 0) {
            dest[0] = source[0]
        }
        if (source[1] != 0) {
            dest[1] = source[1]
        }
        if (source[2] != 0) {
            dest[2] = source[2]
        }
        if (source[3] != 0) {
            dest[3] = source[3]
        }
        if (source[4] != 0) {
            dest[4] = source[4]
        }
        if (source[5] != 0) {
            dest[5] = source[5]
        }
        if (source[6] != 0) {
            dest[6] = source[6]
        }
        if (source[7] != 0) {
            dest[7] = source[7]
        }
        source += 128
        dest += vid.conrowbytes
    }
}

// ================
// Draw_String
// ================
[c_function]
def Draw_String(var x : int; y : int; var str : uint8?) {
    while (*str != 0) {
        Draw_Character(x, y, int(*str))
        str++
        x += 8
    }
}

// ================
// Draw_DebugChar
// Draws a single character directly to the upper right corner of the screen.
// This is for debugging lockups by drawing different chars in different parts
// of the code.
// ================
[c_function]
def Draw_DebugChar(num : uint8) {
    var dest : uint8?
    var source : uint8?
    var drawline : int
    var row : int
    var col : int
    if (vid.direct == null) {
        // don't have direct FB access, so no debugchars...
        return
    }
    drawline = 8
    row = int(num) >> 4
    col = int(num) & 15
    source = draw_chars + (row << 10) + (col << 3)
    dest = vid.direct + 312
    while (true) {
        let _t0 = drawline
        drawline--
        if (_t0 == 0) {
            break
        }
        dest[0] = source[0]
        dest[1] = source[1]
        dest[2] = source[2]
        dest[3] = source[3]
        dest[4] = source[4]
        dest[5] = source[5]
        dest[6] = source[6]
        dest[7] = source[7]
        source += 128
        dest += 320
    }
}

// =============
// Draw_Pic
// =============
[c_function]
def Draw_Pic(x : int; y : int; var pic : qpic_t?) {
    var dest : uint8?
    var source : uint8?
    var pusdest : uint16?
    var v : int
    var u : int
    if ((x < 0) || (uint(x + pic.width) > vid.width) || (y < 0) || (uint(y + pic.height) > vid.height)) {
        Sys_Error`va(cstr("Draw_Pic: bad coordinates"), VaNone())
    }
    source = addr(pic.data[0])
    dest = vid.buffer + uint(y) * vid.rowbytes + x
    v = 0
    while (v < pic.height) {
        Q_memcpy(reinterpret<void?>(dest), reinterpret<void?>(source), pic.width)
        dest += vid.rowbytes
        source += pic.width
        v++
    }
}

// =============
// Draw_TransPic
// =============
[c_function]
def Draw_TransPic(x : int; y : int; var pic : qpic_t?) {
    var dest : uint8?
    var source : uint8?
    var tbyte : uint8
    var pusdest : uint16?
    var v : int
    var u : int
    if (x < 0 || uint(x + pic.width) > vid.width || y < 0 || uint(y + pic.height) > vid.height) {
        Sys_Error`va(cstr("Draw_TransPic: bad coordinates"), VaNone())
    }
    source = addr(pic.data[0])
    dest = vid.buffer + uint(y) * vid.rowbytes + x
    if ((pic.width & 7) != 0) {
        // general
        v = 0
        while (v < pic.height) {
            u = 0
            while (u < pic.width) {
                tbyte = source[u]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u] = tbyte
                }
                u++
            }
            dest += vid.rowbytes
            source += pic.width
            v++
        }
    } else {
        // unwound
        v = 0
        while (v < pic.height) {
            u = 0
            while (u < pic.width) {
                tbyte = source[u]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u] = tbyte
                }
                tbyte = source[u + 1]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u + 1] = tbyte
                }
                tbyte = source[u + 2]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u + 2] = tbyte
                }
                tbyte = source[u + 3]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u + 3] = tbyte
                }
                tbyte = source[u + 4]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u + 4] = tbyte
                }
                tbyte = source[u + 5]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u + 5] = tbyte
                }
                tbyte = source[u + 6]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u + 6] = tbyte
                }
                tbyte = source[u + 7]
                if (int(tbyte) != TRANSPARENT_COLOR) {
                    dest[u + 7] = tbyte
                }
                u += 8
            }
            dest += vid.rowbytes
            source += pic.width
            v++
        }
    }
}

