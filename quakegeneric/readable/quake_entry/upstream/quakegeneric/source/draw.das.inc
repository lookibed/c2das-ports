[c_function]
def Draw_CharToConback(num : int; var dest : uint8?) {
    var row : int
    var col : int
    var source : uint8?
    var drawline : int
    row = num >> 4
    col = num & 15
    source = draw_chars + (row << 10) + (col << 3)
    drawline = 8
    while (true) {
        let _t0 = drawline
        drawline--
        if (_t0 == 0) {
            break
        }
        for (x in range(8)) {
            if (source[x] != 0) {
                dest[x] = uint8(96 + int(source[x]))
            }
        }
        source += 128
        dest += 320
    }
}

// ================
// Draw_ConsoleBackground
// ================
[c_function]
def Draw_ConsoleBackground(lines : int) {
    var x : int
    var y : int
    var v : int
    var src : uint8?
    var dest : uint8?
    var pusdest : uint16?
    var f : int
    var fstep : int
    var conback : qpic_t?
    var ver : uint8[100]
    conback = Draw_CachePic(cstr("gfx/conback.lmp"))
    // hack the version number directly into the pic
    dest = addr(conback.data[0]) + 320 + -(43) + 320 * 186
    sprintf(addr(ver[0]), cstr("%4.2f"), VERSION)
    x = 0
    while (uint64(x) < crt::strlen(addr(ver[0]))) {
        Draw_CharToConback(int(ver[x]), dest + (x << 3))
        x++
    }
    // draw the pic
    dest = vid.conbuffer
    y = 0
    while (y < lines) {
        v = int((vid.conheight - uint(lines) + uint(y)) * 200u / vid.conheight)
        src = addr(conback.data[0]) + v * 320
        if (vid.conwidth == 320u) {
            crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(src), uint64(vid.conwidth))
        } else {
            f = 0
            fstep = int(uint(320 * 65536) / vid.conwidth)
            x = 0
            while (uint(x) < vid.conwidth) {
                dest[x] = src[f >> 16]
                f += fstep
                dest[x + 1] = src[f >> 16]
                f += fstep
                dest[x + 2] = src[f >> 16]
                f += fstep
                dest[x + 3] = src[f >> 16]
                f += fstep
                x += 4
            }
        }
        y++
        dest += vid.conrowbytes
    }
}

// ==============
// R_DrawRect
// ==============
[c_function]
def R_DrawRect(var prect : vrect_s?; rowbytes : int; var psrc : uint8?; transparent : int) {
    var t : uint8
    var i : int
    var j : int
    var srcdelta : int
    var destdelta : int
    var pdest : uint8?
    pdest = vid.buffer + (uint(prect.y) * vid.rowbytes) + prect.x
    srcdelta = rowbytes - prect.width
    destdelta = int(vid.rowbytes - uint(prect.width))
    if (transparent != 0) {
        i = 0
        while (i < prect.height) {
            j = 0
            while (j < prect.width) {
                t = *psrc
                if (int(t) != TRANSPARENT_COLOR) {
                    *pdest = t
                }
                psrc++
                pdest++
                j++
            }
            psrc += srcdelta
            pdest += destdelta
            i++
        }
    } else {
        i = 0
        while (i < prect.height) {
            crt::memcpy(reinterpret<void?>(pdest), reinterpret<void?>(psrc), uint64(prect.width))
            psrc += rowbytes
            pdest += vid.rowbytes
            i++
        }
    }
}

// =============
// Draw_TileClear
// This repeats a 64*64 tile graphic to fill the screen around a sized down
// refresh window.
// =============
[c_function]
def Draw_TileClear(x : int; y : int; w : int; h : int) {
    var width : int
    var height : int
    var tileoffsetx : int
    var tileoffsety : int
    var psrc : uint8?
    var vr : vrect_s
    r_rectdesc.rect.x = x
    r_rectdesc.rect.y = y
    r_rectdesc.rect.width = w
    r_rectdesc.rect.height = h
    vr.y = r_rectdesc.rect.y
    height = r_rectdesc.rect.height
    tileoffsety = vr.y % r_rectdesc.height
    while (height > 0) {
        vr.x = r_rectdesc.rect.x
        width = r_rectdesc.rect.width
        if (tileoffsety != 0) {
            vr.height = r_rectdesc.height - tileoffsety
        } else {
            vr.height = r_rectdesc.height
        }
        if (vr.height > height) {
            vr.height = height
        }
        tileoffsetx = vr.x % r_rectdesc.width
        while (width > 0) {
            if (tileoffsetx != 0) {
                vr.width = r_rectdesc.width - tileoffsetx
            } else {
                vr.width = r_rectdesc.width
            }
            if (vr.width > width) {
                vr.width = width
            }
            psrc = r_rectdesc.ptexbytes + (tileoffsety * r_rectdesc.rowbytes) + tileoffsetx
            R_DrawRect(addr(vr), r_rectdesc.rowbytes, psrc, 0)
            vr.x += vr.width
            width -= vr.width
            // only the left tile can be left-clipped
            tileoffsetx = 0
        }
        vr.y += vr.height
        height -= vr.height
        // only the top tile can be top-clipped
        tileoffsety = 0
    }
}

// =============
// Draw_Fill
// Fills a box of pixels with a single color
// =============
[c_function]
def Draw_Fill(x : int; y : int; w : int; h : int; c : int) {
    var dest : uint8?
    var pusdest : uint16?
    var uc : uint
    var v : int
    dest = vid.buffer + uint(y) * vid.rowbytes + x
    v = 0
    while (v < h) {
        for (u in range(w)) {
            dest[u] = uint8(c)
        }
        v++
        dest += vid.rowbytes
    }
}

// ================
// Draw_FadeScreen
// ================
[c_function]
def Draw_FadeScreen {
    var x : int
    var y : int
    var pbuf : uint8?
    S_ExtraUpdate()
    y = 0
    while (uint(y) < vid.height) {
        var t : int
        pbuf = vid.buffer + vid.rowbytes * uint(y)
        t = (y & 1) << 1
        x = 0
        while (uint(x) < vid.width) {
            if ((x & 3) != t) {
                pbuf[x] = 0u8
            }
            x++
        }
        y++
    }
    S_ExtraUpdate()
}

