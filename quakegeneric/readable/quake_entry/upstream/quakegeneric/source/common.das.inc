    // (extension should include the .)
    src = path + crt::strlen(path) + -(1)
    while (*src != '/' && intptr(src) != intptr(path)) {
        if (*src == '.') {
            // it has an extension
            return
        }
        src--
    }
    crt::strcat(path, extension)
}

// ==============
// COM_Parse
// Parse a token out of a string
// ==============
[c_function]
def COM_Parse(var data : uint8?) : uint8? {
    var c : int
    var len : int
    len = 0
    com_token[0] = 0u8
    if (data == null) {
        return null
    }
    label 1:  // skipwhite
    // skip whitespace
    while (true) {
        c = int(*data)
        if (!(c <= ' ')) {
            break
        }
        if (c == 0) {
            // end of file;
            return null
        }
        data++
    }
    // skip // comments
    if (c == '/' && data[1] == '/') {
        while (*data != 0 && *data != '\n') {
            data++
        }
        goto label 1
    }
    // handle quoted strings specially
    if (c == '"') {
        data++
        while (1 != 0) {
            var _t0 = data
            data++
            c = int(*_t0)
            if (c == '"' || c == 0) {
                com_token[len] = 0u8
                return data
            }
            com_token[len] = uint8(c)
            len++
        }
    }
    // parse single characters
    if (c == '{' || c == '}' || c == ')' || c == '(' || c == '\'' || c == ':') {
        com_token[len] = uint8(c)
        len++
        com_token[len] = 0u8
        return data + 1
    }
    // parse a regular word
    c_do_while(c > 32) {
        com_token[len] = uint8(c)
        data++
        len++
        c = int(*data)
        if (c == '{' || c == '}' || c == ')' || c == '(' || c == '\'' || c == ':') {
            break
        }
    }
    com_token[len] = 0u8
    return data
}

// ================
// COM_CheckParm
// Returns the position (1 to argc-1) in the program's argument list
// where the given parameter apears, or 0 if not present
// ================
[c_function]
def COM_CheckParm(var parm : uint8?) : int {
    for (i in range(1, com_argc)) {
        if (com_argv[i] == null) {
            // NEXTSTEP sometimes clears appkit vars.
            continue
        }
        if (Q_strcmp(parm, com_argv[i]) == 0) {
            return i
        }
    }
    return 0
}

// ================
// COM_CheckRegistered
// Looks for the pop.txt file and verifies it.
// Sets the "registered" cvar.
// Immediately exits out if an alternate game was attempted to be started without
// being registered.
// ================
[c_function]
def COM_CheckRegistered {
    var h : int
    var check : uint16[128]
    COM_OpenFile(cstr("gfx/pop.lmp"), addr(h))
    static_registered = 0
    if (h == -1) {
        Con_Printf`va(cstr("Playing shareware version.\n"), VaNone())
        if (int(com_modified) != 0) {
            Sys_Error`va(cstr("You must have the registered version to use modified games"), VaNone())
        }
        return
    }
    Sys_FileRead(h, reinterpret<void?>(addr(check[0])), typeinfo sizeof(type<uint16[128]>))
    COM_CloseFile(h)
    for (i in range(128)) {
        if (pop[i] != uint16(invoke(BigShort, int16(check[i])))) {
            Sys_Error`va(cstr("Corrupted data file."), VaNone())
        }
    }
    Cvar_Set(cstr("cmdline"), addr(com_cmdline[0]))
    Cvar_Set(cstr("registered"), cstr("1"))
    static_registered = 1
    Con_Printf`va(cstr("Playing registered version.\n"), VaNone())
}

// ================
// COM_InitArgv
// ================
[c_function]
def COM_InitArgv(argc : int; var argv : uint8 ??) {
    var safe : qboolean
    var i : int
    var j : int
    var n : int
    // reconstitute the command line for the cmdline externally visible cvar
    n = 0
    j = 0
    while ((j < MAX_NUM_ARGVS) && (j < argc)) {
        i = 0
        while ((n < (CMDLINE_LENGTH - 1)) && argv[j][i] != 0) {
            let _t0 = n
            n++
            let _t1 = i
            i++
            com_cmdline[_t0] = argv[j][_t1]
        }
        if (n < (CMDLINE_LENGTH - 1)) {
            let _t2 = n
            n++
            com_cmdline[_t2] = uint8(' ')
        } else {
            break
        }
        j++
    }
    com_cmdline[n] = 0u8
    safe = qboolean._c_false
    com_argc = 0
    while ((com_argc < MAX_NUM_ARGVS) && (com_argc < argc)) {
        largv[com_argc] = argv[com_argc]
        if (Q_strcmp(cstr("-safe"), argv[com_argc]) == 0) {
            safe = qboolean._c_true
        }
        com_argc++
    }
    if (int(safe) != 0) {
        // force all the safe-mode switches. Note that we reserved extra space in
        // case we need to add these, so we don't need an overflow check
        for (i1 in range(NUM_SAFE_ARGVS)) {
            largv[com_argc] = safeargvs[i1]
            com_argc++
        }
    }
    largv[com_argc] = argvdummy
    com_argv = addr(largv[0])
    if (COM_CheckParm(cstr("-rogue")) != 0) {
        rogue = qboolean._c_true
        standard_quake = qboolean._c_false
    }
    if (COM_CheckParm(cstr("-hipnotic")) != 0) {
        hipnotic = qboolean._c_true
        standard_quake = qboolean._c_false
    }
}

// ================
// COM_Init
// ================
[c_function]
def COM_Init(var basedir : uint8?) {
    var swaptest : uint8[2] = fixed_array(1u8, 0u8)
    // set the byte swapping variables in a portable manner
    if (*reinterpret<int16?>(addr(swaptest[0])) == 1) {
        bigendien = qboolean._c_false
        BigShort = @@ShortSwap
        LittleShort = @@ShortNoSwap
        BigLong = @@LongSwap
        LittleLong = @@LongNoSwap
        BigFloat = @@FloatSwap
        LittleFloat = @@FloatNoSwap
    } else {
        bigendien = qboolean._c_true
        BigShort = @@ShortNoSwap
        LittleShort = @@ShortSwap
        BigLong = @@LongNoSwap
        LittleLong = @@LongSwap
        BigFloat = @@FloatNoSwap
        LittleFloat = @@FloatSwap
    }
    Cvar_RegisterVariable(addr(registered))
    Cvar_RegisterVariable(addr(cmdline))
    Cmd_AddCommand(cstr("path"), @@COM_Path_f)
    COM_InitFilesystem()
    COM_CheckRegistered()
}

// ============
// va
// does a varargs printf into a temp buffer, so I don't need to have
// varargs versions of all text functions.
// FIXME: make this buffer size safe someday
// ============
[c_function, variadic]
def va(var format : uint8?; va : va_args) : uint8? {
    var argptr : CVaCursor
    argptr = va_begin(va)
    c_vsprintf(addr(va_string[0]), format, va_rest(argptr))
    return addr(va_string[0])
}

// just for debugging
[c_function]
def memsearch(var start : uint8?; count : int; search : int) : int {
    for (i in range(count)) {
        if (int(start[i]) == search) {
            return i
        }
    }
    return -1
}

// ============
// COM_Path_f
// ============
[c_function]
def COM_Path_f {
    var s : searchpath_s?
    Con_Printf`va(cstr("Current search path:\n"), VaNone())
    s = com_searchpaths
    while (s != null) {
        if (s.pack != null) {
            Con_Printf`va(cstr("%s (%i files)\n"), (addr(s.pack.filename[0]), s.pack.numfiles))
        } else {
            Con_Printf`va(cstr("%s\n"), (addr(s.filename[0]),))
        }
        s = s.next
    }
}

// ============
// COM_WriteFile
// The filename will be prefixed by the current game directory
// ============
[c_function]
def COM_WriteFile(var filename : uint8?; var data : void?; len : int) {
    var handle : int
    var name : uint8[128]
    sprintf(addr(name[0]), cstr("%s/%s"), addr(com_gamedir[0]), filename)
    handle = Sys_FileOpenWrite(addr(name[0]))
    if (handle == -1) {
        Sys_Printf`va(cstr("COM_WriteFile: failed on %s\n"), (addr(name[0]),))
        return
    }
    Sys_Printf`va(cstr("COM_WriteFile: %s\n"), (addr(name[0]),))
    Sys_FileWrite(handle, data, len)
    Sys_FileClose(handle)
}

// ============
// COM_CreatePath
// Only used for CopyFile
// ============
[c_function]
def COM_CreatePath(var path : uint8?) {
    var ofs : uint8?
    ofs = path + 1
    while (*ofs != 0) {
        if (*ofs == '/') {
            // create the directory
            *ofs = 0u8
            Sys_mkdir(path)
            *ofs = uint8('/')
        }
        ofs++
    }
}

// ===========
// COM_CopyFile
// Copies a file over from the net to the local cache, creating any directories
// needed. This is for the convenience of developers using ISDN from home.
// ===========
[c_function]
def COM_CopyFile(var netpath : uint8?; var cachepath : uint8?) {
    var _c_in : int
    var out : int
    var remaining : int
    var count : int
    var buf : uint8[4096]
    remaining = Sys_FileOpenRead(netpath, addr(_c_in))
    // create directories up to the cache file
    COM_CreatePath(cachepath)
    out = Sys_FileOpenWrite(cachepath)
    while (remaining != 0) {
        if (uint64(remaining) < uint64(typeinfo sizeof(type<uint8[4096]>))) {
            count = remaining
        } else {
            count = typeinfo sizeof(type<uint8[4096]>)
        }
        Sys_FileRead(_c_in, reinterpret<void?>(addr(buf[0])), count)
        Sys_FileWrite(out, reinterpret<void?>(addr(buf[0])), count)
        remaining -= count
    }
    Sys_FileClose(_c_in)
    Sys_FileClose(out)
}

// ===========
// COM_FindFile
// Finds the file in the search path.
// Sets com_filesize and one of handle or file
// ===========
[c_function]
def COM_FindFile(var filename : uint8?; var handle : int?; var file : _IO_FILE ??) : int {
    var search : searchpath_s?
    var netpath : uint8[128]
    var cachepath : uint8[128]
    var pak : pack_s?
    var i : int
    var findtime : int
    var cachetime : int
    if (file != null && handle != null) {
        Sys_Error`va(cstr("COM_FindFile: both handle and file set"), VaNone())
    }
    if (file == null && handle == null) {
        Sys_Error`va(cstr("COM_FindFile: neither handle or file set"), VaNone())
    }
    // search through the path, one element at a time
    search = com_searchpaths
    if (int(proghack) != 0) {
        // gross hack to use quake 1 progs with quake 2 maps
        if (crt::strcmp(filename, cstr("progs.dat")) == 0) {
            search = search.next
        }
    }
    {
        var _f = false
        while (true) {
            if (_f) {
                search = search.next
            }
            _f = true
            if (search == null) {
                break
            }
            // is the element a pak file?
            if (search.pack != null) {
                // look through all the pak file elements
                pak = search.pack
                i = 0
                while (i < pak.numfiles) {
                    if (crt::strcmp(addr(pak.files[i].name[0]), filename) == 0) {
                        // found it!
                        Sys_Printf`va(cstr("PackFile: %s : %s\n"), (addr(pak.filename[0]), filename))
                        if (handle != null) {
                            *handle = pak.handle
                            Sys_FileSeek(pak.handle, pak.files[i].filepos)
                        } else {
                            // open a new file on the pakfile
                            *file = reinterpret<_IO_FILE?>(crt::fopen(addr(pak.filename[0]), cstr("rb")))
                            if (*file != null) {
                                crt::fseek(reinterpret<void?>(*file), int64(pak.files[i].filepos), 0)
                            }
                        }
                        com_filesize = pak.files[i].filelen
                        return com_filesize
                    }
                    i++
                }
            } else {
                // check a file in the directory tree
                if (static_registered == 0) {
                    // if not a registered version, don't ever go beyond base
                    if (crt::strchr(filename, '/') != null || crt::strchr(filename, '\\') != null) {
                        continue
                    }
                }
                sprintf(addr(netpath[0]), cstr("%s/%s"), addr(search.filename[0]), filename)
                findtime = Sys_FileTime(addr(netpath[0]))
                if (findtime == -1) {
                    continue
                }
                // see if the file needs to be updated in the cache
                if (com_cachedir[0] == 0) {
                    crt::strcpy(addr(cachepath[0]), addr(netpath[0]))
                } else {
                    sprintf(addr(cachepath[0]), cstr("%s%s"), addr(com_cachedir[0]), addr(netpath[0]))
                    cachetime = Sys_FileTime(addr(cachepath[0]))
                    if (cachetime < findtime) {
                        COM_CopyFile(addr(netpath[0]), addr(cachepath[0]))
                    }
                    crt::strcpy(addr(netpath[0]), addr(cachepath[0]))
                }
                Sys_Printf`va(cstr("FindFile: %s\n"), (addr(netpath[0]),))
                com_filesize = Sys_FileOpenRead(addr(netpath[0]), addr(i))
                if (handle != null) {
                    *handle = i
                } else {
                    Sys_FileClose(i)
                    *file = reinterpret<_IO_FILE?>(crt::fopen(addr(netpath[0]), cstr("rb")))
                }
                return com_filesize
            }
        }
    }
    Sys_Printf`va(cstr("FindFile: can't find %s\n"), (filename,))
    if (handle != null) {
        *handle = -1
    } else {
        *file = null
    }
    com_filesize = -1
    return -1
}

// ===========
// COM_OpenFile
// filename never has a leading slash, but may contain directory walks
// returns a handle and a length
// it may actually be inside a pak file
// ===========
def COM_OpenFile(var filename : uint8?; var handle : int?) : int {
    return COM_FindFile(filename, handle, null)
}

// ===========
// COM_FOpenFile
// If the requested file is inside a packfile, a new FILE * will be opened
// into the file.
// ===========
def COM_FOpenFile(var filename : uint8?; var file : _IO_FILE ??) : int {
    return COM_FindFile(filename, null, file)
}

// ============
// COM_CloseFile
// If it is a pak file handle, don't really close it
// ============
def COM_CloseFile(h : int) {
    var s : searchpath_s?
    s = com_searchpaths
    while (s != null) {
        if (s.pack != null && s.pack.handle == h) {
            return
        }
        s = s.next
    }
    Sys_FileClose(h)
}

[c_function]
def COM_LoadFile(var path : uint8?; usehunk : int) : uint8? {
    var h : int
    var buf : uint8?
    var base : uint8[32]
    var len : int
    // quiet compiler warning
    buf = null
    // look for it in the filesystem or pack files
    len = COM_OpenFile(path, addr(h))
    if (h == -1) {
        return null
    }
    // extract the filename base name for hunk tag
    COM_FileBase(path, addr(base[0]), 32ul)
    if (usehunk == 1) {
        buf = reinterpret<uint8?>(Hunk_AllocName(len + 1, addr(base[0])))
    } elif (usehunk == 2) {
        buf = reinterpret<uint8?>(Hunk_TempAlloc(len + 1))
    } elif (usehunk == 0) {
        buf = reinterpret<uint8?>(Z_Malloc(len + 1))
    } elif (usehunk == 3) {
        buf = reinterpret<uint8?>(Cache_Alloc(loadcache, len + 1, addr(base[0])))
    } elif (usehunk == 4) {
        if (len + 1 > loadsize) {
            buf = reinterpret<uint8?>(Hunk_TempAlloc(len + 1))
        } else {
            buf = loadbuf
        }
    } else {
        Sys_Error`va(cstr("COM_LoadFile: bad usehunk"), VaNone())
    }
    if (buf == null) {
        Sys_Error`va(cstr("COM_LoadFile: not enough space for %s"), (path,))
    }
    buf[len] = 0u8
    Draw_BeginDisc()
    Sys_FileRead(h, reinterpret<void?>(buf), len)
    COM_CloseFile(h)
    Draw_EndDisc()
    return buf
}

def COM_LoadHunkFile(var path : uint8?) : uint8? {
    return COM_LoadFile(path, 1)
}

def COM_LoadTempFile(var path : uint8?) : uint8? {
    return COM_LoadFile(path, 2)
}

def COM_LoadCacheFile(var path : uint8?; var cu : cache_user_s?) {
    loadcache = cu
    COM_LoadFile(path, 3)
}

// uses temp hunk if larger than bufsize
[c_function]
def COM_LoadStackFile(var path : uint8?; var buffer : void?; bufsize : int) : uint8? {
    var buf : uint8?
    loadbuf = reinterpret<uint8?>(buffer)
    loadsize = bufsize
    buf = COM_LoadFile(path, 4)
    return buf
}

// =================
// COM_LoadPackFile
// Takes an explicit (not game tree related) path to a pak file.
// Loads the header and directory, adding the files at the beginning
// of the list so they override previous pack files.
// =================
[c_function]
def COM_LoadPackFile(var packfile : uint8?) : pack_s? {
    var header : dpackheader_t
    var newfiles : packfile_t?
    var numpackfiles : int
    var pack : pack_s?
    var packhandle : int
    var info : dpackfile_t[2048]
    var crc : uint16
    if (Sys_FileOpenRead(packfile, addr(packhandle)) == -1) {
        // Con_Printf ("Couldn't open %s\n", packfile);
        return null
    }
    Sys_FileRead(packhandle, reinterpret<void?>(addr(header)), typeinfo sizeof(type<dpackheader_t>))
    if (header.id[0] != 'P' || header.id[1] != 'A' || header.id[2] != 'C' || header.id[3] != 'K') {
        Sys_Error`va(cstr("%s is not a packfile"), (packfile,))
    }
    header.dirofs = invoke(LittleLong, header.dirofs)
    header.dirlen = invoke(LittleLong, header.dirlen)
    numpackfiles = int(uint64(header.dirlen) / uint64(typeinfo sizeof(type<dpackfile_t>)))
    if (numpackfiles > MAX_FILES_IN_PACK) {
        Sys_Error`va(cstr("%s has %i files"), (packfile, numpackfiles))
    }
    if (numpackfiles != PAK0_COUNT) {
        // not the original file
        com_modified = qboolean._c_true
    }
    newfiles = reinterpret<packfile_t?>(Hunk_AllocName(int(uint64(numpackfiles) * uint64(typeinfo sizeof(type<packfile_t>))), cstr("packfile")))
    Sys_FileSeek(packhandle, header.dirofs)
    Sys_FileRead(packhandle, reinterpret<void?>(addr(info[0])), header.dirlen)
    // crc the directory to check for modifications
    CRC_Init(addr(crc))
    for (i in range(header.dirlen)) {
        CRC_ProcessByte(addr(crc), reinterpret<uint8?>(addr(info[0]))[i])
    }
    if (int(crc) != PAK0_CRC) {
        com_modified = qboolean._c_true
    }
    // parse the directory
    for (i in range(numpackfiles)) {
        crt::strcpy(addr(newfiles[i].name[0]), addr(info[i].name[0]))
        newfiles[i].filepos = invoke(LittleLong, info[i].filepos)
        newfiles[i].filelen = invoke(LittleLong, info[i].filelen)
    }
    pack = reinterpret<pack_s?>(Hunk_Alloc(typeinfo sizeof(type<pack_s>)))
    crt::strcpy(addr(pack.filename[0]), packfile)
    pack.handle = packhandle
    pack.numfiles = numpackfiles
    pack.files = newfiles
    Con_Printf`va(cstr("Added packfile %s (%i files)\n"), (packfile, numpackfiles))
    return pack
}

// ================
// COM_AddGameDirectory
// Sets com_gamedir, adds the directory to the head of the path,
// then loads and adds pak1.pak pak2.pak ...
// ================
[c_function]
def COM_AddGameDirectory(var dir : uint8?) {
    var i : int
    var search : searchpath_s?
    var pak : pack_s?
    var pakfile : uint8[128]
    crt::strcpy(addr(com_gamedir[0]), dir)
    // add the directory to the search path
    search = reinterpret<searchpath_s?>(Hunk_Alloc(typeinfo sizeof(type<searchpath_s>)))
    crt::strcpy(addr(search.filename[0]), dir)
    search.next = com_searchpaths
    com_searchpaths = search
    // add any pak files in the format pak0.pak pak1.pak, ...
    i = 0
    while (true) {
        sprintf(addr(pakfile[0]), cstr("%s/pak%i.pak"), dir, i)
        pak = COM_LoadPackFile(addr(pakfile[0]))
        if (pak == null) {
            break
        }
        search = reinterpret<searchpath_s?>(Hunk_Alloc(typeinfo sizeof(type<searchpath_s>)))
        search.pack = pak
        search.next = com_searchpaths
        com_searchpaths = search
        i++
    }
}

// ================
// COM_InitFilesystem
// ================
[c_function]
def COM_InitFilesystem {
    var i : int
    var j : int
    var basedir : uint8[128]
    var search : searchpath_s?
    // -basedir <path>
    // Overrides the system supplied base directory (under GAMENAME)
    i = COM_CheckParm(cstr("-basedir"))
    if (i != 0 && i < com_argc - 1) {
        crt::strcpy(addr(basedir[0]), com_argv[i + 1])
    } else {
        crt::strcpy(addr(basedir[0]), host_parms.basedir)
    }
    j = int(crt::strlen(addr(basedir[0])))
    if (j > 0) {
        if ((basedir[j - 1] == '\\') || (basedir[j - 1] == '/')) {
            basedir[j - 1] = 0u8
        }
    }
    // -cachedir <path>
    // Overrides the system supplied cache directory (NULL or /qcache)
    // -cachedir - will disable caching.
    i = COM_CheckParm(cstr("-cachedir"))
    if (i != 0 && i < com_argc - 1) {
        if (com_argv[i + 1][0] == '-') {
            com_cachedir[0] = 0u8
        } else {
            crt::strcpy(addr(com_cachedir[0]), com_argv[i + 1])
        }
    } elif (host_parms.cachedir != null) {
        crt::strcpy(addr(com_cachedir[0]), host_parms.cachedir)
    } else {
        com_cachedir[0] = 0u8
    }
    // start up with GAMENAME by default (id1)
    COM_AddGameDirectory(va`va(cstr("%s/id1"), (addr(basedir[0]),)))
    if (COM_CheckParm(cstr("-rogue")) != 0) {
        COM_AddGameDirectory(va`va(cstr("%s/rogue"), (addr(basedir[0]),)))
    }
    if (COM_CheckParm(cstr("-hipnotic")) != 0) {
        COM_AddGameDirectory(va`va(cstr("%s/hipnotic"), (addr(basedir[0]),)))
    }
    // -game <gamedir>
    // Adds basedir/gamedir as an override game
    i = COM_CheckParm(cstr("-game"))
    if (i != 0 && i < com_argc - 1) {
        com_modified = qboolean._c_true
        COM_AddGameDirectory(va`va(cstr("%s/%s"), (addr(basedir[0]), com_argv[i + 1])))
    }
    // -path <dir or packfile> [<dir or packfile>] ...
    // Fully specifies the exact serach path, overriding the generated one
    i = COM_CheckParm(cstr("-path"))
    if (i != 0) {
        com_modified = qboolean._c_true
        com_searchpaths = null
        while (true) {
            i++
            if (!(i < com_argc)) {
                break
            }
            if (com_argv[i] == null || com_argv[i][0] == '+' || com_argv[i][0] == '-') {
                break
            }
            search = reinterpret<searchpath_s?>(Hunk_Alloc(typeinfo sizeof(type<searchpath_s>)))
            if (crt::strcmp(COM_FileExtension(com_argv[i]), cstr("pak")) == 0) {
                search.pack = COM_LoadPackFile(com_argv[i])
                if (search.pack == null) {
                    Sys_Error`va(cstr("Couldn't load packfile: %s"), (com_argv[i],))
                }
            } else {
                crt::strcpy(addr(search.filename[0]), com_argv[i])
            }
            search.next = com_searchpaths
            com_searchpaths = search
        }
    }
    if (COM_CheckParm(cstr("-proghack")) != 0) {
        proghack = qboolean._c_true
    }
}

