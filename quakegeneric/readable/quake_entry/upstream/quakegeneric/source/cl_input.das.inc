// ===============
// CL_KeyState
// Returns 0.25 if a key was pressed and released during the frame,
// 0.5 if it was pressed and held
// 0 if held then released, and
// 1.0 if held for the entire time
// ===============
def CL_KeyState(var key : kbutton_t?) : float {
    var val : float
    var impulsedown : qboolean
    var impulseup : qboolean
    var down : qboolean
    impulsedown = enum_from_int(type<qboolean>, key.state & 2)
    impulseup = enum_from_int(type<qboolean>, key.state & 4)
    down = enum_from_int(type<qboolean>, key.state & 1)
    val = 0.0f
    if (uint(impulsedown) != 0 && int(impulseup) == 0) {
        if (int(down) != 0) {
            // pressed and held this frame
            val = float(0.5lf)
        } else {
            // I_Error ();
            val = 0.0f
        }
    }
    if (uint(impulseup) != 0 && int(impulsedown) == 0) {
        if (int(down) != 0) {
            // I_Error ();
            val = 0.0f
        } else {
            // released this frame
            val = 0.0f
        }
    }
    if (int(impulsedown) == 0 && int(impulseup) == 0) {
        if (int(down) != 0) {
            // held the entire frame
            val = float(1.0lf)
        } else {
            // up the entire frame
            val = 0.0f
        }
    }
    if (uint(impulsedown) != 0 && uint(impulseup) != 0) {
        if (int(down) != 0) {
            // released and re-pressed this frame
            val = float(0.75lf)
        } else {
            // pressed and released this frame
            val = float(0.25lf)
        }
    }
    // clear impulses
    key.state &= 1
    return val
}

// ================
// CL_AdjustAngles
// Moves the local angle positions
// ================
[c_function]
def CL_AdjustAngles {
    var speed : float
    var up : float
    var down : float
    if ((in_speed.state & 1) != 0) {
        speed = float(host_frametime * double(cl_anglespeedkey.value))
    } else {
        speed = float(host_frametime)
    }
    if ((in_strafe.state & 1) == 0) {
        cl.viewangles[YAW] -= speed * cl_yawspeed.value * CL_KeyState(addr(in_right))
        cl.viewangles[YAW] += speed * cl_yawspeed.value * CL_KeyState(addr(in_left))
        cl.viewangles[YAW] = anglemod(cl.viewangles[YAW])
    }
    if ((in_klook.state & 1) != 0) {
        V_StopPitchDrift()
        cl.viewangles[PITCH] -= speed * cl_pitchspeed.value * CL_KeyState(addr(in_forward))
        cl.viewangles[PITCH] += speed * cl_pitchspeed.value * CL_KeyState(addr(in_back))
    }
    up = CL_KeyState(addr(in_lookup))
    down = CL_KeyState(addr(in_lookdown))
    cl.viewangles[PITCH] -= speed * cl_pitchspeed.value * up
    cl.viewangles[PITCH] += speed * cl_pitchspeed.value * down
    if (up != 0.0f || down != 0.0f) {
        V_StopPitchDrift()
    }
    if (cl.viewangles[PITCH] > 80.0f) {
        cl.viewangles[PITCH] = 80.0f
    }
    if (cl.viewangles[PITCH] < -70.0f) {
        cl.viewangles[PITCH] = -70.0f
    }
    if (cl.viewangles[ROLL] > 50.0f) {
        cl.viewangles[ROLL] = 50.0f
    }
    if (cl.viewangles[ROLL] < -50.0f) {
        cl.viewangles[ROLL] = -50.0f
    }
}

// ================
// CL_BaseMove
// Send the intended movement message to the server
// ================
[c_function]
def CL_BaseMove(var cmd : usercmd_t?) {
    if (cls.signon != SIGNONS) {
        return
    }
    CL_AdjustAngles()
    Q_memset(reinterpret<void?>(cmd), 0, typeinfo sizeof(type<usercmd_t>))
    if ((in_strafe.state & 1) != 0) {
        cmd.sidemove += cl_sidespeed.value * CL_KeyState(addr(in_right))
        cmd.sidemove -= cl_sidespeed.value * CL_KeyState(addr(in_left))
    }
    cmd.sidemove += cl_sidespeed.value * CL_KeyState(addr(in_moveright))
    cmd.sidemove -= cl_sidespeed.value * CL_KeyState(addr(in_moveleft))
    cmd.upmove += cl_upspeed.value * CL_KeyState(addr(in_up))
    cmd.upmove -= cl_upspeed.value * CL_KeyState(addr(in_down))
    if ((in_klook.state & 1) == 0) {
        cmd.forwardmove += cl_forwardspeed.value * CL_KeyState(addr(in_forward))
        cmd.forwardmove -= cl_backspeed.value * CL_KeyState(addr(in_back))
    }
    // adjust for speed key
    if ((in_speed.state & 1) != 0) {
        cmd.forwardmove *= cl_movespeedkey.value
        cmd.sidemove *= cl_movespeedkey.value
        cmd.upmove *= cl_movespeedkey.value
    }
}

// ==============
// CL_SendMove
// ==============
[c_function]
def CL_SendMove(var cmd : usercmd_t?) {
    var bits : int
    var buf : sizebuf_s
    var data : uint8[128]
    buf.maxsize = 128
    buf.cursize = 0
    buf.data = addr(data[0])
    cl.cmd = *cmd
    // send the movement message
    MSG_WriteByte(addr(buf), clc_move)
    // so server can get ping times
    MSG_WriteFloat(addr(buf), float(cl.mtime[0]))
    for (i in range(3)) {
        MSG_WriteAngle(addr(buf), cl.viewangles[i])
    }
    MSG_WriteShort(addr(buf), int(cmd.forwardmove))
    MSG_WriteShort(addr(buf), int(cmd.sidemove))
    MSG_WriteShort(addr(buf), int(cmd.upmove))
    // send button bits
    bits = 0
    if ((in_attack.state & 3) != 0) {
        bits |= 1
    }
    in_attack.state &= ~2
    if ((in_jump.state & 3) != 0) {
        bits |= 2
    }
    in_jump.state &= ~2
    MSG_WriteByte(addr(buf), bits)
    MSG_WriteByte(addr(buf), in_impulse)
    in_impulse = 0
    // deliver the message
    if (int(cls.demoplayback) != 0) {
        return
    }
    // allways dump the first two message, because it may contain leftover inputs
    // from the last level
    cl.movemessages++
    if (cl.movemessages <= 2) {
        return
    }
    if (NET_SendUnreliableMessage(cls.netcon, addr(buf)) == -1) {
        Con_Printf`va(cstr("CL_SendMove: lost server connection\n"), VaNone())
        CL_Disconnect()
    }
}

