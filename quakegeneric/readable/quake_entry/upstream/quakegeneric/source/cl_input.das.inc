[c_function]
def KeyDown(var b : kbutton_t?) {
    var k : int
    var c : uint8?
    c = Cmd_Argv(1)
    if (c[0] != 0) {
        k = crt::atoi(c)
    } else {
        // typed manually at the console for continuous down
        k = -1
    }
    if (k == b.down[0] || k == b.down[1]) {
        // repeating key
        return
    }
    if (b.down[0] == 0) {
        b.down[0] = k
    } elif (b.down[1] == 0) {
        b.down[1] = k
    } else {
        Con_Printf`va(cstr("Three keys down for a button!\n"), VaNone())
        return
    }
    if ((b.state & 1) != 0) {
        // still down
        return
    }
    // down + impulse down
    b.state |= 1 + 2
}

[c_function]
def KeyUp(var b : kbutton_t?) {
    var k : int
    var c : uint8?
    c = Cmd_Argv(1)
    if (c[0] != 0) {
        k = crt::atoi(c)
    } else {
        // typed manually at the console, assume for unsticking, so clear all
        b.down[1] = 0
        b.down[0] = b.down[1]
        // impulse up
        b.state = 4
        return
    }
    if (b.down[0] == k) {
        b.down[0] = 0
    } elif (b.down[1] == k) {
        b.down[1] = 0
    } else {
        // key up without coresponding down (menu pass through)
        return
    }
    if (b.down[0] != 0 || b.down[1] != 0) {
        // some other key is still holding it down
        return
    }
    if ((b.state & 1) == 0) {
        // still up (this should not happen)
        return
    }
    // now up
    b.state &= ~1
    // impulse up
    b.state |= 4
}

