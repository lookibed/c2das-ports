    MSG_WriteByte(addr(sv.signon), svc_spawnstatic)
    MSG_WriteByte(addr(sv.signon), SV_ModelIndex(pr_strings + ent.v.model))
    MSG_WriteByte(addr(sv.signon), int(ent.v.frame))
    MSG_WriteByte(addr(sv.signon), int(ent.v.colormap))
