// ===============
// PF_walkmove
// float(float yaw, float dist) walkmove
// ===============
[c_function]
def PF_walkmove {
    var ent : edict_s?
    var yaw : float
    var dist : float
    var move : float[3]
    var oldf : dfunction_t?
    var oldself : int
    ent = PROG_TO_EDICT(pr_global_struct.self)
    yaw = G_FLOAT(OFS_PARM0)
    dist = G_FLOAT(OFS_PARM1)
    if ((int(ent.v.flags) & (FL_ONGROUND | FL_FLY | FL_SWIM)) == 0) {
        pr_globals[OFS_RETURN] = 0.0f
        return
    }
    yaw = float(double(yaw) * 3.141592653589793lf * 2.0lf / 360.0lf)
    move[0] = float(math::cos(double(yaw)) * double(dist))
    move[1] = float(math::sin(double(yaw)) * double(dist))
    move[2] = 0.0f
    // save program state, because SV_movestep may call other progs
    oldf = pr_xfunction
    oldself = pr_global_struct.self
    pr_globals[OFS_RETURN] = float(uint(SV_movestep(ent, addr(move[0]), qboolean._c_true)))
    // restore program state
    pr_xfunction = oldf
    pr_global_struct.self = oldself
}

// ===============
// PF_droptofloor
// void() droptofloor
// ===============
[c_function]
def PF_droptofloor {
    var ent : edict_s?
    var end : float[3]
    var trace : trace_t
    ent = PROG_TO_EDICT(pr_global_struct.self)
    end[0] = ent.v.origin[0]
    end[1] = ent.v.origin[1]
    end[2] = ent.v.origin[2]
    end[2] -= 256.0f
    trace = SV_Move(addr(ent.v.origin[0]), addr(ent.v.mins[0]), addr(ent.v.maxs[0]), addr(end[0]), int(qboolean._c_false), ent)
    if (trace.fraction == 1.0f || uint(trace.allsolid) != 0) {
        pr_globals[OFS_RETURN] = 0.0f
    } else {
        ent.v.origin[0] = trace.endpos[0]
        ent.v.origin[1] = trace.endpos[1]
        ent.v.origin[2] = trace.endpos[2]
        SV_LinkEdict(ent, qboolean._c_false)
        ent.v.flags = float(int(ent.v.flags) | FL_ONGROUND)
        ent.v.groundentity = int(EDICT_TO_PROG(trace.ent))
        pr_globals[OFS_RETURN] = 1.0f
    }
}

