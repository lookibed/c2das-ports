// =================
// PF_ambientsound
// =================
[c_function]
def PF_ambientsound {
    var check : uint8 ??
    var samp : uint8?
    var pos : float?
    var vol : float
    var attenuation : float
    var soundnum : int
    pos = G_VECTOR(OFS_PARM0)
    samp = G_STRING(OFS_PARM1)
    vol = G_FLOAT(OFS_PARM2)
    attenuation = G_FLOAT(OFS_PARM3)
    // check to see if samp was properly precached
    soundnum = 0
    check = addr(sv.sound_precache[0])
    while (*check != null) {
        if (crt::strcmp(*check, samp) == 0) {
            break
        }
        check++
        soundnum++
    }
    if (*check == null) {
        Con_Printf`va(cstr("no precache: %s\n"), (samp,))
        return
    }
    // add an svc_spawnambient command to the level signon packet
    MSG_WriteByte(addr(sv.signon), svc_spawnstaticsound)
    for (i in range(3)) {
        MSG_WriteCoord(addr(sv.signon), pos[i])
    }
    MSG_WriteByte(addr(sv.signon), soundnum)
    MSG_WriteByte(addr(sv.signon), int(vol * 255.0f))
    MSG_WriteByte(addr(sv.signon), int(attenuation * 64.0f))
}

// =================
// PF_sound
// Each entity can have eight independant sound sources, like voice,
// weapon, feet, etc.
// Channel 0 is an auto-allocate channel, the others override anything
// allready running on that entity/channel pair.
// An attenuation of 0 will play full volume everywhere in the level.
// Larger attenuations will drop off.
// =================
[c_function]
def PF_sound {
    var sample : uint8?
    var channel : int
    var entity : edict_s?
    var volume : int
    var attenuation : float
    entity = G_EDICT(OFS_PARM0)
    channel = int(G_FLOAT(OFS_PARM1))
    sample = G_STRING(OFS_PARM2)
    volume = int(G_FLOAT(OFS_PARM3) * 255.0f)
    attenuation = pr_globals[OFS_PARM4]
    if (volume < 0 || volume > 255) {
        Sys_Error`va(cstr("SV_StartSound: volume = %i"), (volume,))
    }
    if (attenuation < 0.0f || attenuation > 4.0f) {
        Sys_Error`va(cstr("SV_StartSound: attenuation = %f"), (double(attenuation),))
    }
    if (channel < 0 || channel > 7) {
        Sys_Error`va(cstr("SV_StartSound: channel = %i"), (channel,))
    }
    SV_StartSound(entity, channel, sample, volume, attenuation)
}

