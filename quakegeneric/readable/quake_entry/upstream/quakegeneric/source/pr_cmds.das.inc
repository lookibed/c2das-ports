[c_function]
def SetMinMaxSize(var e : edict_s?; var min : float?; var max : float?; var rotate : qboolean) {
    var angles : float?
    var rmin : float[3]
    var rmax : float[3]
    var bounds : float[2][3]
    var xvector : float[2]
    var yvector : float[2]
    var a : float
    var base : float[3]
    var transformed : float[3]
    for (i in range(3)) {
        if (min[i] > max[i]) {
            PR_RunError`va(cstr("backwards mins/maxs"), VaNone())
        }
    }
    // FIXME: implement rotation properly again
    rotate = qboolean._c_false
    if (int(rotate) == 0) {
        VectorCopy(min, rmin)
        VectorCopy(max, rmax)
    } else {
        // find min / max for rotations
        angles = addr(e.v.angles[0])
        a = float(double(angles[1] / 180.0f) * 3.141592653589793lf)
        xvector[0] = float(math::cos(double(a)))
        xvector[1] = float(math::sin(double(a)))
        yvector[0] = float(-math::sin(double(a)))
        yvector[1] = float(math::cos(double(a)))
        bounds[0][0] = min[0]
        bounds[0][1] = min[1]
        bounds[0][2] = min[2]
        bounds[1][0] = max[0]
        bounds[1][1] = max[1]
        bounds[1][2] = max[2]
        rmin[2] = 9999.0f
        rmin[1] = rmin[2]
        rmin[0] = rmin[1]
        rmax[2] = -9999.0f
        rmax[1] = rmax[2]
        rmax[0] = rmax[1]
        for (i in range(2)) {
            base[0] = bounds[i][0]
            for (j in range(2)) {
                base[1] = bounds[j][1]
                for (k in range(2)) {
                    base[2] = bounds[k][2]
                    // transform the point
                    transformed[0] = xvector[0] * base[0] + yvector[0] * base[1]
                    transformed[1] = xvector[1] * base[0] + yvector[1] * base[1]
                    transformed[2] = base[2]
                    for (l in range(3)) {
                        if (transformed[l] < rmin[l]) {
                            rmin[l] = transformed[l]
                        }
                        if (transformed[l] > rmax[l]) {
                            rmax[l] = transformed[l]
                        }
                    }
                }
            }
        }
    }
    // set derived values
    e.v.mins[0] = rmin[0]
    e.v.mins[1] = rmin[1]
    e.v.mins[2] = rmin[2]
    e.v.maxs[0] = rmax[0]
    e.v.maxs[1] = rmax[1]
    e.v.maxs[2] = rmax[2]
    e.v.size[0] = max[0] - min[0]
    e.v.size[1] = max[1] - min[1]
    e.v.size[2] = max[2] - min[2]
    SV_LinkEdict(e, qboolean._c_false)
}

