// entity (entity start, .string field, string match) find = #5;
[c_function]
def PF_Find {
    var e : int
    var f : int
    var s : uint8?
    var t : uint8?
    var ed : edict_s?
    e = G_EDICTNUM(OFS_PARM0)
    f = G_INT(OFS_PARM1)
    s = G_STRING(OFS_PARM2)
    if (s == null) {
        PR_RunError`va(cstr("PF_Find: bad search string"), VaNone())
    }
    {
        e++
        var _f = false
        while (true) {
            if (_f) {
                e++
            }
            _f = true
            if (!(e < sv.num_edicts)) {
                break
            }
            ed = EDICT_NUM(e)
            if (int(ed.free) != 0) {
                continue
            }
            t = E_STRING(ed, f)
            if (t == null) {
                continue
            }
            if (crt::strcmp(t, s) == 0) {
                RETURN_EDICT(ed)
                return
            }
        }
    }
    RETURN_EDICT(sv.edicts)
}

