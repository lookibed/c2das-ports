// =================
// PF_vectoyaw
// float vectoyaw(vector)
// =================
[c_function]
def PF_vectoyaw {
    var value1 : float?
    var yaw : float
    value1 = G_VECTOR(OFS_PARM0)
    if (value1[1] == 0.0f && value1[0] == 0.0f) {
        yaw = 0.0f
    } else {
        yaw = float(int(math::atan2(double(value1[1]), double(value1[0])) * 180.0lf / 3.141592653589793lf))
        if (yaw < 0.0f) {
            yaw += 360.0f
        }
    }
    pr_globals[OFS_RETURN] = yaw
}

// =================
// PF_vectoangles
// vector vectoangles(vector)
// =================
[c_function]
def PF_vectoangles {
    var value1 : float?
    var forward : float
    var yaw : float
    var pitch : float
    value1 = G_VECTOR(OFS_PARM0)
    if (value1[1] == 0.0f && value1[0] == 0.0f) {
        yaw = 0.0f
        if (value1[2] > 0.0f) {
            pitch = 90.0f
        } else {
            pitch = 270.0f
        }
    } else {
        yaw = float(int(math::atan2(double(value1[1]), double(value1[0])) * 180.0lf / 3.141592653589793lf))
        if (yaw < 0.0f) {
            yaw += 360.0f
        }
        forward = float(math::sqrt(double(value1[0] * value1[0] + value1[1] * value1[1])))
        pitch = float(int(math::atan2(double(value1[2]), double(forward)) * 180.0lf / 3.141592653589793lf))
        if (pitch < 0.0f) {
            pitch += 360.0f
        }
    }
    pr_globals[OFS_RETURN + 0] = pitch
    pr_globals[OFS_RETURN + 1] = yaw
    pr_globals[OFS_RETURN + 2] = 0.0f
}

