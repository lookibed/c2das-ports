// ===============
[c_function]
def PF_lightstyle {
    var style : int
    var val : uint8?
    var client : client_s?
    var j : int
    style = int(G_FLOAT(OFS_PARM0))
    val = G_STRING(OFS_PARM1)
    // change the string in sv
    sv.lightstyles[style] = val
    // send message to all clients on this server
    if (sv.state != server_state_t.ss_active) {
        return
    }
    j = 0
    client = svs.clients
    while (j < svs.maxclients) {
        if (uint(client.active) != 0 || uint(client.spawned) != 0) {
            MSG_WriteChar(addr(client.message), svc_lightstyle)
            MSG_WriteChar(addr(client.message), style)
            MSG_WriteString(addr(client.message), val)
        }
        j++
        client++
    }
}

