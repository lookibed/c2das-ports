// =================
// PF_findradius
// Returns a chain of entities that have origins within a spherical area
// findradius (origin, radius)
// =================
[c_function]
def PF_findradius {
    var ent : edict_s?
    var chain : edict_s?
    var rad : float
    var org : float?
    var eorg : float[3]
    var i : int
    var j : int
    chain = sv.edicts
    org = G_VECTOR(OFS_PARM0)
    rad = G_FLOAT(OFS_PARM1)
    ent = NEXT_EDICT(sv.edicts)
    i = 1
    while (i < sv.num_edicts) {
        {
            if (int(ent.free) != 0) {
                continue
            }
            if (ent.v.solid == float(SOLID_NOT)) {
                continue
            }
            j = 0
            while (j < 3) {
                eorg[j] = float(double(org[j]) - (double(ent.v.origin[j]) + double(ent.v.mins[j] + ent.v.maxs[j]) * 0.5lf))
                j++
            }
            if (Length(addr(eorg[0])) > rad) {
                continue
            }
            ent.v.chain = int(EDICT_TO_PROG(chain))
            chain = ent
        } finally {
            i++
            ent = NEXT_EDICT(ent)
        }
    }
    RETURN_EDICT(chain)
}

