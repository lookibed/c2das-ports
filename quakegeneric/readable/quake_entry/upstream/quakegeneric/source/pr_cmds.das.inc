[c_function]
def PF_aim {
    var ent : edict_s?
    var check : edict_s?
    var bestent : edict_s?
    var start : float[3]
    var dir : float[3]
    var end : float[3]
    var bestdir : float[3]
    var i : int
    var j : int
    var tr : trace_t
    var dist : float
    var bestdist : float
    var speed : float
    ent = G_EDICT(OFS_PARM0)
    speed = G_FLOAT(OFS_PARM1)
    start[0] = ent.v.origin[0]
    start[1] = ent.v.origin[1]
    start[2] = ent.v.origin[2]
    start[2] += 20.0f
    // try sending a trace straight
    dir[0] = pr_global_struct.v_forward[0]
    dir[1] = pr_global_struct.v_forward[1]
    dir[2] = pr_global_struct.v_forward[2]
    VectorMA(addr(start[0]), 2048.0f, addr(dir[0]), addr(end[0]))
    tr = SV_Move(addr(start[0]), addr(vec3_origin[0]), addr(vec3_origin[0]), addr(end[0]), int(qboolean._c_false), ent)
    if (tr.ent != null && tr.ent.v.takedamage == float(DAMAGE_AIM) && (teamplay.value == 0.0f || ent.v.team <= 0.0f || ent.v.team != tr.ent.v.team)) {
        G_VECTOR(OFS_RETURN)[0] = pr_global_struct.v_forward[0]
        G_VECTOR(OFS_RETURN)[1] = pr_global_struct.v_forward[1]
        G_VECTOR(OFS_RETURN)[2] = pr_global_struct.v_forward[2]
        return
    }
    VectorCopy(dir, bestdir)
    // try all possible entities
    bestdist = sv_aim.value
    bestent = null
    check = NEXT_EDICT(sv.edicts)
    i = 1
    while (i < sv.num_edicts) {
        {
            if (check.v.takedamage != float(DAMAGE_AIM)) {
                continue
            }
            if (intptr(check) == intptr(ent)) {
                continue
            }
            if (teamplay.value != 0.0f && ent.v.team > 0.0f && ent.v.team == check.v.team) {
                // don't aim at teammate
                continue
            }
            j = 0
            while (j < 3) {
                end[j] = float(double(check.v.origin[j]) + 0.5lf * double(check.v.mins[j] + check.v.maxs[j]))
                j++
            }
            VectorSubtract(end, start, dir)
            VectorNormalize(addr(dir[0]))
            dist = dir[0] * pr_global_struct.v_forward[0] + dir[1] * pr_global_struct.v_forward[1] + dir[2] * pr_global_struct.v_forward[2]
            if (dist < bestdist) {
                // to far to turn
                continue
            }
            tr = SV_Move(addr(start[0]), addr(vec3_origin[0]), addr(vec3_origin[0]), addr(end[0]), int(qboolean._c_false), ent)
            if (intptr(tr.ent) == intptr(check)) {
                // can shoot at this one
                bestdist = dist
                bestent = check
            }
        } finally {
            i++
            check = NEXT_EDICT(check)
        }
    }
    if (bestent != null) {
        dir[0] = bestent.v.origin[0] - ent.v.origin[0]
        dir[1] = bestent.v.origin[1] - ent.v.origin[1]
        dir[2] = bestent.v.origin[2] - ent.v.origin[2]
        dist = dir[0] * pr_global_struct.v_forward[0] + dir[1] * pr_global_struct.v_forward[1] + dir[2] * pr_global_struct.v_forward[2]
        VectorScale(addr(pr_global_struct.v_forward[0]), dist, addr(end[0]))
        end[2] = dir[2]
        VectorNormalize(addr(end[0]))
        G_VECTOR(OFS_RETURN)[0] = end[0]
        G_VECTOR(OFS_RETURN)[1] = end[1]
        G_VECTOR(OFS_RETURN)[2] = end[2]
    } else {
        G_VECTOR(OFS_RETURN)[0] = bestdir[0]
        G_VECTOR(OFS_RETURN)[1] = bestdir[1]
        G_VECTOR(OFS_RETURN)[2] = bestdir[2]
    }
}

// ==============
// PF_changeyaw
// This was a major timewaster in progs, so it was converted to C
// ==============
def PF_changeyaw {
    var ent : edict_s?
    var ideal : float
    var current : float
    var move : float
    var speed : float
    ent = PROG_TO_EDICT(pr_global_struct.self)
    current = anglemod(ent.v.angles[1])
    ideal = ent.v.ideal_yaw
    speed = ent.v.yaw_speed
    if (current == ideal) {
        return
    }
    move = ideal - current
    if (ideal > current) {
        if (move >= 180.0f) {
            move -= 360.0f
        }
    } else {
        if (move <= -180.0f) {
            move += 360.0f
        }
    }
    if (move > 0.0f) {
        if (move > speed) {
            move = speed
        }
    } else {
        if (move < -speed) {
            move = -speed
        }
    }
    ent.v.angles[1] = anglemod(current + move)
}

[c_function]
def WriteDest : sizebuf_s? {
    var entnum : int
    var dest : int
    var ent : edict_s?
    dest = int(G_FLOAT(OFS_PARM0))
    c_switch(dest) {
        case(0) {
            return addr(sv.datagram)
        }
        case(1) {
            ent = PROG_TO_EDICT(pr_global_struct.msg_entity)
            entnum = NUM_FOR_EDICT(ent)
            if (entnum < 1 || entnum > svs.maxclients) {
                PR_RunError`va(cstr("WriteDest: not a client"), VaNone())
            }
            return addr(svs.clients[entnum - 1].message)
        }
        case(2) {
            return addr(sv.reliable_datagram)
        }
        case(3) {
            return addr(sv.signon)
        }
        case(_) {
            PR_RunError`va(cstr("WriteDest: bad destination"), VaNone())
            break
        }
    }
    return null
}

