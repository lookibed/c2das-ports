[c_function]
def PF_newcheckclient(var check : int) : int {
    var i : int
    var pvs : uint8?
    var ent : edict_s?
    var leaf : mleaf_s?
    var org : float[3]
    // cycle to the next one
    if (check < 1) {
        check = 1
    }
    if (check > svs.maxclients) {
        check = svs.maxclients
    }
    if (check == svs.maxclients) {
        i = 1
    } else {
        i = check + 1
    }
    {
        var _f = false
        while (true) {
            if (_f) {
                i++
            }
            _f = true
            if (i == svs.maxclients + 1) {
                i = 1
            }
            ent = EDICT_NUM(i)
            if (i == check) {
                // didn't find anything else
                break
            }
            if (int(ent.free) != 0) {
                continue
            }
            if (ent.v.health <= 0.0f) {
                continue
            }
            if ((int(ent.v.flags) & FL_NOTARGET) != 0) {
                continue
            }
            // anything that is a client, or has a client as an enemy
            break
        }
    }
    // get the PVS for the entity
    org[0] = ent.v.origin[0] + ent.v.view_ofs[0]
    org[1] = ent.v.origin[1] + ent.v.view_ofs[1]
    org[2] = ent.v.origin[2] + ent.v.view_ofs[2]
    leaf = Mod_PointInLeaf(addr(org[0]), sv.worldmodel)
    pvs = Mod_LeafPVS(leaf, sv.worldmodel)
    crt::memcpy(reinterpret<void?>(addr(checkpvs[0])), reinterpret<void?>(pvs), uint64((sv.worldmodel.numleafs + 7) >> 3))
    return i
}

[c_function]
def PF_checkclient {
    var ent : edict_s?
    var self : edict_s?
    var leaf : mleaf_s?
    var l : int
    var view : float[3]
    // find a new check if on a new frame
    if (sv.time - sv.lastchecktime >= 0.1lf) {
        sv.lastcheck = PF_newcheckclient(sv.lastcheck)
        sv.lastchecktime = sv.time
    }
    // return check if it might be visible
    ent = EDICT_NUM(sv.lastcheck)
    if (uint(ent.free) != 0 || ent.v.health <= 0.0f) {
        RETURN_EDICT(sv.edicts)
        return
    }
    // if current entity can't possibly see the check entity, return 0
    self = PROG_TO_EDICT(pr_global_struct.self)
    view[0] = self.v.origin[0] + self.v.view_ofs[0]
    view[1] = self.v.origin[1] + self.v.view_ofs[1]
    view[2] = self.v.origin[2] + self.v.view_ofs[2]
    leaf = Mod_PointInLeaf(addr(view[0]), sv.worldmodel)
    l = int(int64(leaf - sv.worldmodel.leafs) - 1l)
    if ((l < 0) || (int(checkpvs[l >> 3]) & (1 << (l & 7))) == 0) {
        c_notvis++
        RETURN_EDICT(sv.edicts)
        return
    }
    // might be able to see it
    c_invis++
    RETURN_EDICT(ent)
}

