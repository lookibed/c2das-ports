var chase_active : cvar_s = cvar_s(name = cstr("chase_active"), _c_string = cstr("0"))
var chase_back : cvar_s = cvar_s(name = cstr("chase_back"), _c_string = cstr("100"))
var chase_up : cvar_s = cvar_s(name = cstr("chase_up"), _c_string = cstr("16"))
var chase_right : cvar_s = cvar_s(name = cstr("chase_right"), _c_string = cstr("0"))
var chase_pos : float[3]
var chase_angles : float[3]
var chase_dest : float[3]
var chase_dest_angles : float[3]

[c_function]
def Chase_Init {
    Cvar_RegisterVariable(addr(chase_back))
    Cvar_RegisterVariable(addr(chase_up))
    Cvar_RegisterVariable(addr(chase_right))
    Cvar_RegisterVariable(addr(chase_active))
}

def Chase_Reset {
}

[c_function]
def TraceLine(var start : float?; var end : float?; var impact : float?) {
    var trace : trace_t
    crt::memset(reinterpret<void?>(addr(trace)), 0, uint64(typeinfo sizeof(type<trace_t>)))
    SV_RecursiveHullCheck(addr(cl.worldmodel.hulls[0]), 0, 0.0f, 1.0f, start, end, addr(trace))
    impact[0] = trace.endpos[0]
    impact[1] = trace.endpos[1]
    impact[2] = trace.endpos[2]
}

[c_function]
def Chase_Update {
    var dist : float
    var forward : float[3]
    var up : float[3]
    var right : float[3]
    var dest : float[3]
    var stop : float[3]
    // if can't see player, reset
    AngleVectors(addr(cl.viewangles[0]), addr(forward[0]), addr(right[0]), addr(up[0]))
    // calc exact destination
    for (i in range(3)) {
        chase_dest[i] = r_refdef.vieworg[i] - forward[i] * chase_back.value - right[i] * chase_right.value
    }
    chase_dest[2] = r_refdef.vieworg[2] + chase_up.value
    // find the spot the player is looking at
    VectorMA(addr(r_refdef.vieworg[0]), 4096.0f, addr(forward[0]), addr(dest[0]))
    TraceLine(addr(r_refdef.vieworg[0]), addr(dest[0]), addr(stop[0]))
    // calculate pitch to look at the same spot from camera
    stop[0] -= r_refdef.vieworg[0]
    stop[1] -= r_refdef.vieworg[1]
    stop[2] -= r_refdef.vieworg[2]
    dist = DotProduct(stop, forward)
    if (dist < 1.0f) {
        dist = 1.0f
    }
    r_refdef.viewangles[PITCH] = float(-math::atan(double(stop[2] / dist)) / 3.141592653589793lf * 180.0lf)
    // move towards destination
    r_refdef.vieworg[0] = chase_dest[0]
    r_refdef.vieworg[1] = chase_dest[1]
    r_refdef.vieworg[2] = chase_dest[2]
}

