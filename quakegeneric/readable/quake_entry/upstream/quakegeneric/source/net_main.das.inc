        net_numdrivers = 1
        net_drivers[0].Init = @@VCR_Init
    }
    if (COM_CheckParm(cstr("-record")) != 0) {
        recording = qboolean._c_true
    }
    i = COM_CheckParm(cstr("-port"))
    if (i == 0) {
        i = COM_CheckParm(cstr("-udpport"))
    }
    if (i == 0) {
        i = COM_CheckParm(cstr("-ipxport"))
    }
    if (i != 0) {
        if (i < com_argc - 1) {
            DEFAULTnet_hostport = Q_atoi(com_argv[i + 1])
        } else {
            Sys_Error`va(cstr("NET_Init: you must specify a number after -port"), VaNone())
        }
    }
    net_hostport = DEFAULTnet_hostport
    if (COM_CheckParm(cstr("-listen")) != 0 || cls.state == cactive_t.ca_dedicated) {
        listening = qboolean._c_true
    }
    net_numsockets = svs.maxclientslimit
    if (cls.state != cactive_t.ca_dedicated) {
        net_numsockets++
    }
    SetNetTime()
    for (i1 in range(net_numsockets)) {
        s = reinterpret<qsocket_s?>(Hunk_AllocName(typeinfo sizeof(type<qsocket_s>), cstr("qsocket")))
        s.next = net_freeSockets
        net_freeSockets = s
        s.disconnected = qboolean._c_true
    }
    // allocate space for network message buffer
    SZ_Alloc(addr(net_message), NET_MAXMESSAGE)
    Cvar_RegisterVariable(addr(net_messagetimeout))
    Cvar_RegisterVariable(addr(hostname))
    Cvar_RegisterVariable(addr(config_com_port))
    Cvar_RegisterVariable(addr(config_com_irq))
    Cvar_RegisterVariable(addr(config_com_baud))
    Cvar_RegisterVariable(addr(config_com_modem))
    Cvar_RegisterVariable(addr(config_modem_dialtype))
    Cvar_RegisterVariable(addr(config_modem_clear))
    Cvar_RegisterVariable(addr(config_modem_init))
    Cvar_RegisterVariable(addr(config_modem_hangup))
    Cmd_AddCommand(cstr("slist"), @@NET_Slist_f)
    Cmd_AddCommand(cstr("listen"), @@NET_Listen_f)
    Cmd_AddCommand(cstr("maxplayers"), @@MaxPlayers_f)
    Cmd_AddCommand(cstr("port"), @@NET_Port_f)
    // initialize all the drivers
    net_driverlevel = 0
    while (net_driverlevel < net_numdrivers) {
        {
            controlSocket = invoke(net_drivers[net_driverlevel].Init)
            if (controlSocket == -1) {
                continue
            }
            net_drivers[net_driverlevel].initialized = qboolean._c_true
            net_drivers[net_driverlevel].controlSock = controlSocket
            if (int(listening) != 0) {
                invoke(net_drivers[net_driverlevel].Listen, qboolean._c_true)
            }
        } finally {
            net_driverlevel++
        }
    }
    if (*addr(my_ipx_address[0]) != 0) {
        Con_DPrintf`va(cstr("IPX address %s\n"), (addr(my_ipx_address[0]),))
    }
    if (*addr(my_tcpip_address[0]) != 0) {
        Con_DPrintf`va(cstr("TCP/IP address %s\n"), (addr(my_tcpip_address[0]),))
    }
}

def NET_Shutdown {
    var sock : qsocket_s?
    SetNetTime()
    sock = net_activeSockets
    while (sock != null) {
        NET_Close(sock)
        sock = sock.next
    }
    // shutdown the drivers
    net_driverlevel = 0
    while (net_driverlevel < net_numdrivers) {
        if (net_drivers[net_driverlevel].initialized == qboolean._c_true) {
            invoke(net_drivers[net_driverlevel].Shutdown)
            net_drivers[net_driverlevel].initialized = qboolean._c_false
        }
        net_driverlevel++
    }
    if (vcrFile != -1) {
        Con_Printf`va(cstr("Closing vcrfile.\n"), VaNone())
        Sys_FileClose(vcrFile)
    }
}

[c_function]
def NET_Poll {
    var pp : _PollProcedure?
    var useModem : qboolean
    if (int(configRestored) == 0) {
        if (int(serialAvailable) != 0) {
            if (double(config_com_modem.value) == 1.0lf) {
                useModem = qboolean._c_true
            } else {
                useModem = qboolean._c_false
            }
            invoke(SetComPortConfig, 0, int(config_com_port.value), int(config_com_irq.value), int(config_com_baud.value), useModem)
            invoke(SetModemConfig, 0, config_modem_dialtype._c_string, config_modem_clear._c_string, config_modem_init._c_string, config_modem_hangup._c_string)
        }
        configRestored = qboolean._c_true
    }
    SetNetTime()
    pp = pollProcedureList
    while (pp != null) {
        if (pp.nextTime > net_time) {
            break
        }
        pollProcedureList = pp.next
        invoke(reinterpret<function<(var a0 : void?) : void>>(pp.procedure), pp.arg)
        pp = pp.next
    }
}

[c_function]
def SchedulePollProcedure(var proc : _PollProcedure?; timeOffset : double) {
    var pp : _PollProcedure?
    var prev : _PollProcedure?
    proc.nextTime = Sys_FloatTime() + timeOffset
    pp = pollProcedureList
    prev = null
    while (pp != null) {
        if (pp.nextTime >= proc.nextTime) {
            break
        }
        prev = pp
        pp = pp.next
    }
    if (prev == null) {
        proc.next = pollProcedureList
        pollProcedureList = proc
        return
    }
    proc.next = pp
    prev.next = proc
}

