[c_function]
def NET_SendToAll(var data : sizebuf_s?; blocktime : int) : int {
    var start : double
    var i : int
    var count : int = 0
    var state1 : qboolean[16]
    var state2 : qboolean[16]
    i = 0
    host_client = svs.clients
    while (i < svs.maxclients) {
        {
            if (host_client.netconnection == null) {
                continue
            }
            if (int(host_client.active) != 0) {
                if (host_client.netconnection.driver == 0) {
                    NET_SendMessage(host_client.netconnection, data)
                    state1[i] = qboolean._c_true
                    state2[i] = qboolean._c_true
                    continue
                }
                count++
                state1[i] = qboolean._c_false
                state2[i] = qboolean._c_false
            } else {
                state1[i] = qboolean._c_true
                state2[i] = qboolean._c_true
            }
        } finally {
            i++
            host_client++
        }
    }
    start = Sys_FloatTime()
    while (count != 0) {
        count = 0
        i = 0
        host_client = svs.clients
        while (i < svs.maxclients) {
            {
                if (int(state1[i]) == 0) {
                    if (int(NET_CanSendMessage(host_client.netconnection)) != 0) {
                        state1[i] = qboolean._c_true
                        NET_SendMessage(host_client.netconnection, data)
                    } else {
                        NET_GetMessage(host_client.netconnection)
                    }
                    count++
                    continue
                }
                if (int(state2[i]) == 0) {
                    if (int(NET_CanSendMessage(host_client.netconnection)) != 0) {
                        state2[i] = qboolean._c_true
                    } else {
                        NET_GetMessage(host_client.netconnection)
                    }
                    count++
                    continue
                }
            } finally {
                i++
                host_client++
            }
        }
        if ((Sys_FloatTime() - start) > double(blocktime)) {
            break
        }
    }
    return count
}

[c_function]
def NET_Init {
    var i : int
    var controlSocket : int
    var s : qsocket_s?
