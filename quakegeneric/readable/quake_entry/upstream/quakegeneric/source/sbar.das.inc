    // scores
    Sbar_SortFrags()
    // draw the text
    l = scoreboardlines
    x = int(80u + ((vid.width - 320u) >> 1u))
    y = 40
    for (i in range(l)) {
        k = fragsort[i]
        s = addr(cl.scores[k])
        if (s.name[0] == 0) {
            continue
        }
        // draw background
        top = s.colors & 240
        bottom = (s.colors & 15) << 4
        top = Sbar_ColorForMap(top)
        bottom = Sbar_ColorForMap(bottom)
        Draw_Fill(x, y, 40, 4, top)
        Draw_Fill(x, y + 4, 40, 4, bottom)
        // draw number
        f = s.frags
        sprintf(addr(num[0]), cstr("%3i"), f)
        Draw_Character(x + 8, y, int(num[0]))
        Draw_Character(x + 16, y, int(num[1]))
        Draw_Character(x + 24, y, int(num[2]))
        if (k == cl.viewentity - 1) {
            Draw_Character(x - 8, y, 12)
        }
        // draw time
        // draw name
        Draw_String(x + 64, y, addr(s.name[0]))
        y += 10
    }
}

// ==================
// Sbar_DeathmatchOverlay
// ==================
[c_function]
def Sbar_MiniDeathmatchOverlay {
    var pic : qpic_t?
    var i : int
    var k : int
    var l : int
    var top : int
    var bottom : int
    var x : int
    var y : int
    var f : int
    var num : uint8[12]
    var s : scoreboard_t?
    var numlines : int
    if (vid.width < 512u || sb_lines == 0) {
        return
    }
    scr_copyeverything = 1
    scr_fullupdate = 0
    // scores
    Sbar_SortFrags()
    // draw the text
    l = scoreboardlines
    y = int(vid.height - uint(sb_lines))
    numlines = sb_lines / 8
    if (numlines < 3) {
        return
    }
    // find us
    i = 0
    while (i < scoreboardlines) {
        if (fragsort[i] == cl.viewentity - 1) {
            break
        }
        i++
    }
    // we're not there
    if (i == scoreboardlines) {
        i = 0
    } else {
        // figure out start
        i -= numlines / 2
    }
    if (i > scoreboardlines - numlines) {
        i = scoreboardlines - numlines
    }
    if (i < 0) {
        i = 0
    }
    x = 324
    while (i < scoreboardlines && uint(y) < vid.height - 8u) {
        {
            k = fragsort[i]
            s = addr(cl.scores[k])
            if (s.name[0] == 0) {
                continue
            }
            // draw background
            top = s.colors & 240
            bottom = (s.colors & 15) << 4
            top = Sbar_ColorForMap(top)
            bottom = Sbar_ColorForMap(bottom)
            Draw_Fill(x, y + 1, 40, 3, top)
            Draw_Fill(x, y + 4, 40, 4, bottom)
            // draw number
            f = s.frags
            sprintf(addr(num[0]), cstr("%3i"), f)
            Draw_Character(x + 8, y, int(num[0]))
            Draw_Character(x + 16, y, int(num[1]))
            Draw_Character(x + 24, y, int(num[2]))
            if (k == cl.viewentity - 1) {
                Draw_Character(x, y, 16)
                Draw_Character(x + 32, y, 17)
            }
            // draw time
            // draw name
            Draw_String(x + 48, y, addr(s.name[0]))
            y += 8
        } finally {
            i++
        }
    }
}

// ==================
// Sbar_IntermissionOverlay
// ==================
def Sbar_IntermissionOverlay {
    var pic : qpic_t?
    var dig : int
    var num : int
    scr_copyeverything = 1
    scr_fullupdate = 0
    if (cl.gametype == GAME_DEATHMATCH) {
        Sbar_DeathmatchOverlay()
        return
    }
    pic = Draw_CachePic(cstr("gfx/complete.lmp"))
    Draw_Pic(64, 24, pic)
    pic = Draw_CachePic(cstr("gfx/inter.lmp"))
    Draw_TransPic(0, 56, pic)
    // time
    dig = cl.completed_time / 60
    Sbar_IntermissionNumber(160, 64, dig, 3, 0)
    num = cl.completed_time - dig * 60
    Draw_TransPic(234, 64, sb_colon)
    Draw_TransPic(246, 64, sb_nums[0][num / 10])
    Draw_TransPic(266, 64, sb_nums[0][num % 10])
    Sbar_IntermissionNumber(160, 104, cl.stats[STAT_SECRETS], 3, 0)
    Draw_TransPic(232, 104, sb_slash)
    Sbar_IntermissionNumber(240, 104, cl.stats[STAT_TOTALSECRETS], 3, 0)
    Sbar_IntermissionNumber(160, 144, cl.stats[STAT_MONSTERS], 3, 0)
    Draw_TransPic(232, 144, sb_slash)
    Sbar_IntermissionNumber(240, 144, cl.stats[STAT_TOTALMONSTERS], 3, 0)
}

