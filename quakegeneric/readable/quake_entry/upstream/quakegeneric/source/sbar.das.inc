// =============
// Sbar_itoa
// =============
[c_function]
def Sbar_itoa(var num : int; var buf : uint8?) : int {
    var str : uint8?
    var pow10 : int
    var dig : int
    str = buf
    if (num < 0) {
        var _t0 = str
        str++
        *_t0 = uint8('-')
        num = -num
    }
    pow10 = 10
    while (num >= pow10) {
        pow10 *= 10
    }
    c_do_while(pow10 != 1) {
        pow10 /= 10
        dig = num / pow10
        var _t1 = str
        str++
        *_t1 = uint8('0' + dig)
        num -= dig * pow10
    }
    *str = 0u8
    return int(int64(str - buf))
}

// =============
// Sbar_DrawNum
// =============
[c_function]
def Sbar_DrawNum(var x : int; y : int; num : int; digits : int; color : int) {
    var str : uint8[12]
    var ptr : uint8?
    var l : int
    var frame : int
    l = Sbar_itoa(num, addr(str[0]))
    ptr = addr(str[0])
    if (l > digits) {
        ptr += l - digits
    }
    if (l < digits) {
        x += (digits - l) * 24
    }
    while (*ptr != 0) {
        if (*ptr == '-') {
            frame = STAT_MINUS
        } else {
            frame = int(*ptr) - '0'
        }
        Sbar_DrawTransPic(x, y, sb_nums[color][frame])
        x += 24
        ptr++
    }
}

// ===============
// Sbar_SortFrags
// ===============
[c_function]
def Sbar_SortFrags {
    var k : int
    // sort by frags
    scoreboardlines = 0
    for (i in range(cl.maxclients)) {
        if (cl.scores[i].name[0] != 0) {
            fragsort[scoreboardlines] = i
            scoreboardlines++
        }
    }
    for (i in range(scoreboardlines)) {
        for (j in range(scoreboardlines - 1 - i)) {
            if (cl.scores[fragsort[j]].frags < cl.scores[fragsort[j + 1]].frags) {
                k = fragsort[j]
                fragsort[j] = fragsort[j + 1]
                fragsort[j + 1] = k
            }
        }
    }
}

def Sbar_ColorForMap(m : int) : int {
    return m < 128 ? m + 8 : m + 8
}

// ===============
// Sbar_UpdateScoreboard
// ===============
[c_function]
def Sbar_UpdateScoreboard {
    var k : int
    var top : int
    var bottom : int
    var s : scoreboard_t?
    Sbar_SortFrags()
    // draw the text
    crt::memset(reinterpret<void?>(addr(scoreboardtext[0])), 0, uint64(typeinfo sizeof(type<uint8[16][20]>)))
    for (i in range(scoreboardlines)) {
        k = fragsort[i]
        s = addr(cl.scores[k])
        sprintf(addr(scoreboardtext[i][1]), cstr("%3i %s"), s.frags, addr(s.name[0]))
        top = s.colors & 240
        bottom = (s.colors & 15) << 4
        scoreboardtop[i] = Sbar_ColorForMap(top)
        scoreboardbottom[i] = Sbar_ColorForMap(bottom)
    }
}

// ===============
// Sbar_SoloScoreboard
// ===============
[c_function]
def Sbar_SoloScoreboard {
    var str : uint8[80]
    var minutes : int
    var seconds : int
    var tens : int
    var units : int
    var l : int
    sprintf(addr(str[0]), cstr("Monsters:%3i /%3i"), cl.stats[STAT_MONSTERS], cl.stats[STAT_TOTALMONSTERS])
    Sbar_DrawString(8, 4, addr(str[0]))
    sprintf(addr(str[0]), cstr("Secrets :%3i /%3i"), cl.stats[STAT_SECRETS], cl.stats[STAT_TOTALSECRETS])
    Sbar_DrawString(8, 12, addr(str[0]))
    // time
    minutes = int(cl.time / 60.0lf)
    seconds = int(cl.time - double(60 * minutes))
    tens = seconds / 10
    units = seconds - 10 * tens
    sprintf(addr(str[0]), cstr("Time :%3i:%i%i"), minutes, tens, units)
    Sbar_DrawString(184, 4, addr(str[0]))
    // draw level name
    l = int(crt::strlen(addr(cl.levelname[0])))
    Sbar_DrawString(232 - l * 4, 12, addr(cl.levelname[0]))
}

// ===============
// Sbar_DrawScoreboard
// ===============
def Sbar_DrawScoreboard {
    Sbar_SoloScoreboard()
    if (cl.gametype == GAME_DEATHMATCH) {
        Sbar_DeathmatchOverlay()
    }
}

// ===============
// Sbar_DrawInventory
// ===============
[c_function]
def Sbar_DrawInventory {
    var num : uint8[6]
    var time : float
    var flashon : int
    if (int(rogue) != 0) {
        if (cl.stats[STAT_ACTIVEWEAPON] >= RIT_LAVA_NAILGUN) {
            Sbar_DrawPic(0, -24, rsb_invbar[0])
        } else {
            Sbar_DrawPic(0, -24, rsb_invbar[1])
        }
    } else {
        Sbar_DrawPic(0, -24, sb_ibar)
    }
    // weapons
    for (i in range(7)) {
        if ((cl.items & (IT_SHOTGUN << i)) != 0) {
            time = cl.item_gettime[i]
            flashon = int((cl.time - double(time)) * 10.0lf)
            if (flashon >= 10) {
                if (cl.stats[STAT_ACTIVEWEAPON] == (IT_SHOTGUN << i)) {
                    flashon = 1
                } else {
                    flashon = 0
                }
            } else {
                flashon = (flashon % 5) + 2
            }
            Sbar_DrawPic(i * 24, -16, sb_weapons[flashon][i])
            if (flashon > 1) {
                // force update to remove flash
                sb_updates = 0
            }
        }
    }
    // MED 01/04/97
    // hipnotic weapons
    if (int(hipnotic) != 0) {
        var grenadeflashing : int = 0
        for (i in range(4)) {
            if ((cl.items & (1 << hipweapons[i])) != 0) {
                time = cl.item_gettime[hipweapons[i]]
                flashon = int((cl.time - double(time)) * 10.0lf)
                if (flashon >= 10) {
                    if (cl.stats[STAT_ACTIVEWEAPON] == (1 << hipweapons[i])) {
                        flashon = 1
                    } else {
                        flashon = 0
                    }
                } else {
                    flashon = (flashon % 5) + 2
                }
                // check grenade launcher
                if (i == 2) {
                    if ((cl.items & HIT_PROXIMITY_GUN) != 0) {
                        if (flashon != 0) {
                            grenadeflashing = 1
                            Sbar_DrawPic(96, -16, hsb_weapons[flashon][2])
                        }
                    }
                } elif (i == 3) {
                    if ((cl.items & (IT_SHOTGUN << 4)) != 0) {
                        if (flashon != 0 && grenadeflashing == 0) {
                            Sbar_DrawPic(96, -16, hsb_weapons[flashon][3])
                        } elif (grenadeflashing == 0) {
                            Sbar_DrawPic(96, -16, hsb_weapons[0][3])
                        }
                    } else {
                        Sbar_DrawPic(96, -16, hsb_weapons[flashon][4])
                    }
                } else {
                    Sbar_DrawPic(176 + (i * 24), -16, hsb_weapons[flashon][i])
                }
                if (flashon > 1) {
                    // force update to remove flash
                    sb_updates = 0
                }
            }
        }
    }
    if (int(rogue) != 0) {
        // check for powered up weapon.
        if (cl.stats[STAT_ACTIVEWEAPON] >= RIT_LAVA_NAILGUN) {
            for (i in range(5)) {
                if (cl.stats[STAT_ACTIVEWEAPON] == (RIT_LAVA_NAILGUN << i)) {
                    Sbar_DrawPic((i + 2) * 24, -16, rsb_weapons[i])
                }
            }
        }
    }
    // ammo counts
    for (i in range(4)) {
        sprintf(addr(num[0]), cstr("%3i"), cl.stats[STAT_SHELLS + i])
        if (num[0] != ' ') {
            Sbar_DrawCharacter((6 * i + 1) * 8 - 2, -24, 18 + int(num[0]) - '0')
        }
        if (num[1] != ' ') {
            Sbar_DrawCharacter((6 * i + 2) * 8 - 2, -24, 18 + int(num[1]) - '0')
        }
        if (num[2] != ' ') {
            Sbar_DrawCharacter((6 * i + 3) * 8 - 2, -24, 18 + int(num[2]) - '0')
        }
    }
    flashon = 0
    // items
    for (i in range(6)) {
        if ((cl.items & (1 << (17 + i))) != 0) {
            time = cl.item_gettime[17 + i]
            if (time != 0.0f && double(time) > cl.time - 2.0lf && flashon != 0) {
                // flash frame
                sb_updates = 0
            } else {
                // MED 01/04/97 changed keys
                if (int(hipnotic) == 0 || (i > 1)) {
                    Sbar_DrawPic(192 + i * 16, -16, sb_items[i])
                }
            }
            if (time != 0.0f && double(time) > cl.time - 2.0lf) {
                sb_updates = 0
            }
        }
    }
    // MED 01/04/97 added hipnotic items
    // hipnotic items
    if (int(hipnotic) != 0) {
        for (i in range(2)) {
            if ((cl.items & (1 << (24 + i))) != 0) {
                time = cl.item_gettime[24 + i]
                if (time != 0.0f && double(time) > cl.time - 2.0lf && flashon != 0) {
                    // flash frame
                    sb_updates = 0
                } else {
                    Sbar_DrawPic(288 + i * 16, -16, hsb_items[i])
                }
                if (time != 0.0f && double(time) > cl.time - 2.0lf) {
                    sb_updates = 0
                }
            }
        }
    }
    if (int(rogue) != 0) {
        // new rogue items
        for (i in range(2)) {
            if ((cl.items & (1 << (29 + i))) != 0) {
                time = cl.item_gettime[29 + i]
                if (time != 0.0f && double(time) > cl.time - 2.0lf && flashon != 0) {
                    // flash frame
                    sb_updates = 0
                } else {
                    Sbar_DrawPic(288 + i * 16, -16, rsb_items[i])
                }
                if (time != 0.0f && double(time) > cl.time - 2.0lf) {
                    sb_updates = 0
                }
            }
        }
    } else {
        // sigils
        for (i in range(4)) {
            if ((cl.items & (1 << (28 + i))) != 0) {
                time = cl.item_gettime[28 + i]
                if (time != 0.0f && double(time) > cl.time - 2.0lf && flashon != 0) {
                    // flash frame
                    sb_updates = 0
                } else {
                    Sbar_DrawPic(320 - 32 + i * 8, -16, sb_sigil[i])
                }
                if (time != 0.0f && double(time) > cl.time - 2.0lf) {
                    sb_updates = 0
                }
            }
        }
    }
}

// ===============
// Sbar_DrawFrags
// ===============
[c_function]
def Sbar_DrawFrags {
    var k : int
    var l : int
    var top : int
    var bottom : int
    var x : int
    var y : int
    var f : int
    var xofs : int
    var num : uint8[12]
    var s : scoreboard_t?
    Sbar_SortFrags()
    // draw the text
    l = scoreboardlines <= 4 ? scoreboardlines : 4
    x = 23
    if (cl.gametype == GAME_DEATHMATCH) {
        xofs = 0
    } else {
        xofs = int((vid.width - 320u) >> 1u)
    }
    y = int(vid.height - uint(SBAR_HEIGHT) - 23u)
    for (i in range(l)) {
        k = fragsort[i]
        s = addr(cl.scores[k])
        if (s.name[0] == 0) {
            continue
        }
        // draw background
        top = s.colors & 240
        bottom = (s.colors & 15) << 4
        top = Sbar_ColorForMap(top)
        bottom = Sbar_ColorForMap(bottom)
        Draw_Fill(xofs + x * 8 + 10, y, 28, 4, top)
        Draw_Fill(xofs + x * 8 + 10, y + 4, 28, 3, bottom)
        // draw number
        f = s.frags
        sprintf(addr(num[0]), cstr("%3i"), f)
        Sbar_DrawCharacter((x + 1) * 8, -24, int(num[0]))
        Sbar_DrawCharacter((x + 2) * 8, -24, int(num[1]))
        Sbar_DrawCharacter((x + 3) * 8, -24, int(num[2]))
        if (k == cl.viewentity - 1) {
            Sbar_DrawCharacter(x * 8 + 2, -24, 16)
            Sbar_DrawCharacter((x + 4) * 8 - 4, -24, 17)
        }
        x += 4
    }
}

// ===============
// Sbar_DrawFace
// ===============
[c_function]
def Sbar_DrawFace {
    var f : int
    var anim : int
    // PGM 01/19/97 - team color drawing
    // PGM 03/02/97 - fixed so color swatch only appears in CTF modes
    if (uint(rogue) != 0 && (cl.maxclients != 1) && (teamplay.value > 3.0f) && (teamplay.value < 7.0f)) {
        var top : int
        var bottom : int
        var xofs : int
        var num : uint8[12]
        var s : scoreboard_t?
        s = addr(cl.scores[cl.viewentity - 1])
        // draw background
        top = s.colors & 240
        bottom = (s.colors & 15) << 4
        top = Sbar_ColorForMap(top)
        bottom = Sbar_ColorForMap(bottom)
        if (cl.gametype == GAME_DEATHMATCH) {
            xofs = 113
        } else {
            xofs = int(((vid.width - 320u) >> 1u) + 113u)
        }
        Sbar_DrawPic(112, 0, rsb_teambord)
        Draw_Fill(xofs, int(vid.height - uint(SBAR_HEIGHT) + 3u), 22, 9, top)
        Draw_Fill(xofs, int(vid.height - uint(SBAR_HEIGHT) + 12u), 22, 9, bottom)
        // draw number
        f = s.frags
        sprintf(addr(num[0]), cstr("%3i"), f)
        if (top == 8) {
            if (num[0] != ' ') {
                Sbar_DrawCharacter(109, 3, 18 + int(num[0]) - '0')
            }
            if (num[1] != ' ') {
                Sbar_DrawCharacter(116, 3, 18 + int(num[1]) - '0')
            }
            if (num[2] != ' ') {
                Sbar_DrawCharacter(123, 3, 18 + int(num[2]) - '0')
            }
        } else {
            Sbar_DrawCharacter(109, 3, int(num[0]))
            Sbar_DrawCharacter(116, 3, int(num[1]))
            Sbar_DrawCharacter(123, 3, int(num[2]))
        }
        return
    }
    // PGM 01/19/97 - team color drawing
    if ((cl.items & (IT_INVISIBILITY | IT_INVULNERABILITY)) == (IT_INVISIBILITY | IT_INVULNERABILITY)) {
        Sbar_DrawPic(112, 0, sb_face_invis_invuln)
        return
    }
    if ((cl.items & IT_QUAD) != 0) {
        Sbar_DrawPic(112, 0, sb_face_quad)
        return
    }
    if ((cl.items & IT_INVISIBILITY) != 0) {
        Sbar_DrawPic(112, 0, sb_face_invis)
        return
    }
    if ((cl.items & IT_INVULNERABILITY) != 0) {
        Sbar_DrawPic(112, 0, sb_face_invuln)
        return
    }
    if (cl.stats[STAT_HEALTH] >= 100) {
        f = 4
    } else {
        f = cl.stats[STAT_HEALTH] / 20
    }
    if (cl.time <= double(cl.faceanimtime)) {
        anim = 1
        // make sure the anim gets drawn over
        sb_updates = 0
    } else {
        anim = 0
    }
    Sbar_DrawPic(112, 0, sb_faces[f][anim])
}

// ===============
// Sbar_Draw
// ===============
def Sbar_Draw {
    if (scr_con_current == float(vid.height)) {
        // console is full screen
        return
    }
    if (sb_updates >= vid.numpages) {
        return
    }
    scr_copyeverything = 1
    sb_updates++
    if (sb_lines != 0 && vid.width > 320u) {
        Draw_TileClear(0, int(vid.height - uint(sb_lines)), int(vid.width), sb_lines)
    }
    if (sb_lines > 24) {
        Sbar_DrawInventory()
        if (cl.maxclients != 1) {
            Sbar_DrawFrags()
        }
    }
    if (uint(sb_showscores) != 0 || cl.stats[STAT_HEALTH] <= 0) {
        Sbar_DrawPic(0, 0, sb_scorebar)
        Sbar_DrawScoreboard()
        sb_updates = 0
    } elif (sb_lines != 0) {
        Sbar_DrawPic(0, 0, sb_sbar)
        // keys (hipnotic only)
        // MED 01/04/97 moved keys here so they would not be overwritten
        if (int(hipnotic) != 0) {
            if ((cl.items & IT_KEY1) != 0) {
                Sbar_DrawPic(209, 3, sb_items[0])
            }
            if ((cl.items & IT_KEY2) != 0) {
                Sbar_DrawPic(209, 12, sb_items[1])
            }
        }
        // armor
        if ((cl.items & IT_INVULNERABILITY) != 0) {
            Sbar_DrawNum(24, 0, 666, 3, 1)
            Sbar_DrawPic(0, 0, draw_disc)
        } else {
            if (int(rogue) != 0) {
                Sbar_DrawNum(24, 0, cl.stats[STAT_ARMOR], 3, int_of(cl.stats[STAT_ARMOR] <= 25))
                if ((cl.items & RIT_ARMOR3) != 0) {
                    Sbar_DrawPic(0, 0, sb_armor[2])
                } elif ((cl.items & RIT_ARMOR2) != 0) {
                    Sbar_DrawPic(0, 0, sb_armor[1])
                } elif ((cl.items & RIT_ARMOR1) != 0) {
                    Sbar_DrawPic(0, 0, sb_armor[0])
                }
            } else {
                Sbar_DrawNum(24, 0, cl.stats[STAT_ARMOR], 3, int_of(cl.stats[STAT_ARMOR] <= 25))
                if ((cl.items & IT_ARMOR3) != 0) {
                    Sbar_DrawPic(0, 0, sb_armor[2])
                } elif ((cl.items & IT_ARMOR2) != 0) {
                    Sbar_DrawPic(0, 0, sb_armor[1])
                } elif ((cl.items & IT_ARMOR1) != 0) {
                    Sbar_DrawPic(0, 0, sb_armor[0])
                }
            }
        }
        // face
        Sbar_DrawFace()
        // health
        Sbar_DrawNum(136, 0, cl.stats[STAT_HEALTH], 3, int_of(cl.stats[STAT_HEALTH] <= 25))
        // ammo icon
        if (int(rogue) != 0) {
            if ((cl.items & RIT_SHELLS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[0])
            } elif ((cl.items & RIT_NAILS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[1])
            } elif ((cl.items & RIT_ROCKETS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[2])
            } elif ((cl.items & RIT_CELLS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[3])
            } elif ((cl.items & RIT_LAVA_NAILS) != 0) {
                Sbar_DrawPic(224, 0, rsb_ammo[0])
            } elif ((cl.items & RIT_PLASMA_AMMO) != 0) {
                Sbar_DrawPic(224, 0, rsb_ammo[1])
            } elif ((cl.items & RIT_MULTI_ROCKETS) != 0) {
                Sbar_DrawPic(224, 0, rsb_ammo[2])
            }
        } else {
            if ((cl.items & IT_SHELLS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[0])
            } elif ((cl.items & IT_NAILS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[1])
            } elif ((cl.items & IT_ROCKETS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[2])
            } elif ((cl.items & IT_CELLS) != 0) {
                Sbar_DrawPic(224, 0, sb_ammo[3])
            }
        }
        Sbar_DrawNum(248, 0, cl.stats[STAT_AMMO], 3, int_of(cl.stats[STAT_AMMO] <= 10))
    }
    if (vid.width > 320u) {
        if (cl.gametype == GAME_DEATHMATCH) {
            Sbar_MiniDeathmatchOverlay()
        }
    }
}

// ==================
// Sbar_IntermissionNumber
// ==================
[c_function]
def Sbar_IntermissionNumber(var x : int; y : int; num : int; digits : int; color : int) {
    var str : uint8[12]
    var ptr : uint8?
    var l : int
    var frame : int
    l = Sbar_itoa(num, addr(str[0]))
    ptr = addr(str[0])
    if (l > digits) {
        ptr += l - digits
    }
    if (l < digits) {
        x += (digits - l) * 24
    }
    while (*ptr != 0) {
        if (*ptr == '-') {
            frame = STAT_MINUS
        } else {
            frame = int(*ptr) - '0'
        }
        Draw_TransPic(x, y, sb_nums[color][frame])
        x += 24
        ptr++
    }
}

// ==================
// Sbar_DeathmatchOverlay
