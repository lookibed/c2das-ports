// ===============
// Sbar_ShowScores
// Tab key down
// ===============
def Sbar_ShowScores {
    if (int(sb_showscores) != 0) {
        return
    }
    sb_showscores = qboolean._c_true
    sb_updates = 0
}

// ===============
// Sbar_DontShowScores
// Tab key up
// ===============
def Sbar_DontShowScores {
    sb_showscores = qboolean._c_false
    sb_updates = 0
}

// ===============
// Sbar_Changed
// ===============
def Sbar_Changed {
    // update next frame
    sb_updates = 0
}

