// generated by c2das - regenerate, never edit
var d_scantable : int[1024]
var d_vrectx : int
var d_vrecty : int
var d_vrectright_particle : int
var d_vrectbottom_particle : int
var d_y_aspect_shift : int
var d_pix_min : int
var d_pix_max : int
var d_pix_shift : int
var zspantable : int16? [1024]

// ================
// D_ViewChanged
// ================
[c_function]
def D_ViewChanged {
    var rowbytes : int
    if (int(r_dowarp) != 0) {
        rowbytes = WARP_WIDTH
    } else {
        rowbytes = int(vid.rowbytes)
    }
    scale_for_mip = xscale
    if (yscale > xscale) {
        scale_for_mip = yscale
    }
    d_zrowbytes = vid.width * 2u
    d_zwidth = vid.width
    d_pix_min = r_refdef.vrect.width / 320
    if (d_pix_min < 1) {
        d_pix_min = 1
    }
    d_pix_max = int(double(float(r_refdef.vrect.width)) / (320.0lf / 4.0lf) + 0.5lf)
    d_pix_shift = 8 - int(double(float(r_refdef.vrect.width)) / 320.0lf + 0.5lf)
    if (d_pix_max < 1) {
        d_pix_max = 1
    }
    if (double(pixelAspect) > 1.4lf) {
        d_y_aspect_shift = 1
    } else {
        d_y_aspect_shift = 0
    }
    d_vrectx = r_refdef.vrect.x
    d_vrecty = r_refdef.vrect.y
    d_vrectright_particle = r_refdef.vrectright - d_pix_max
    d_vrectbottom_particle = r_refdef.vrectbottom - (d_pix_max << d_y_aspect_shift)
    {
        var i : int
        i = 0
        while (uint(i) < vid.height) {
            d_scantable[i] = i * rowbytes
            zspantable[i] = d_pzbuffer + uint(i) * d_zwidth
            i++
        }
    }
}

