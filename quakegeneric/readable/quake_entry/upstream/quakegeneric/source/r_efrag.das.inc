// generated by c2das - regenerate, never edit
var r_emins : float[3]
var r_emaxs : float[3]
var r_pefragtopnode : mnode_s?
var lastlink : efrag_s ??
var r_addent : entity_s?

// ================
// R_RemoveEfrags
// Call when removing an object from the world or moving it to another position
// ================
[c_function]
def R_RemoveEfrags(var ent : entity_s?) {
    var ef : efrag_s?
    var old : efrag_s?
    var walk : efrag_s?
    var prev : efrag_s ??
    ef = ent.efrag
    while (ef != null) {
        prev = addr(ef.leaf.efrags)
        while (1 != 0) {
            walk = *prev
            if (walk == null) {
                break
            }
            if (intptr(walk) == intptr(ef)) {
                // remove this fragment
                *prev = ef.leafnext
                break
            } else {
                prev = addr(walk.leafnext)
            }
        }
        old = ef
        ef = ef.entnext
        // put it on the free list
        old.entnext = cl.free_efrags
        cl.free_efrags = old
    }
    ent.efrag = null
}

// ===================
// R_SplitEntityOnNode
// ===================
[c_function]
def R_SplitEntityOnNode(var node : mnode_s?) {
    var ef : efrag_s?
    var splitplane : mplane_s?
    var leaf : mleaf_s?
    var sides : int
    if (node.contents == CONTENTS_SOLID) {
        return
    }
    // add an efrag if the node is a leaf
    if (node.contents < 0) {
        if (r_pefragtopnode == null) {
            r_pefragtopnode = node
        }
        leaf = reinterpret<mleaf_s?>(node)
        // grab an efrag off the free list
        ef = cl.free_efrags
        if (ef == null) {
            Con_Printf`va(cstr("Too many efrags!\n"), VaNone())
            // no free fragments...
            return
        }
        cl.free_efrags = cl.free_efrags.entnext
        ef.entity = r_addent
        // add the entity link
        *lastlink = ef
        lastlink = addr(ef.entnext)
        ef.entnext = null
        // set the leaf links
        ef.leaf = leaf
        ef.leafnext = leaf.efrags
        leaf.efrags = ef
        return
    }
    // NODE_MIXED
    splitplane = node.plane
    sides = int(splitplane._c_type) < 3 ? (splitplane.dist <= r_emins[int(splitplane._c_type)] ? 1 :
                (splitplane.dist >= r_emaxs[int(splitplane._c_type)] ? 2 : 3)) : BoxOnPlaneSide(addr(r_emins[0]),
            addr(r_emaxs[0]), splitplane)
    if (sides == 3) {
        // split on this plane
        // if this is the first splitter of this bmodel, remember it
        if (r_pefragtopnode == null) {
            r_pefragtopnode = node
        }
    }
    // recurse down the contacted sides
    if ((sides & 1) != 0) {
        R_SplitEntityOnNode(node.children[0])
    }
    if ((sides & 2) != 0) {
        R_SplitEntityOnNode(node.children[1])
    }
}

// ===================
// R_SplitEntityOnNode2
// ===================
[c_function]
def R_SplitEntityOnNode2(var node : mnode_s?) {
    var splitplane : mplane_s?
    var sides : int
    if (node.visframe != r_visframecount) {
        return
    }
    if (node.contents < 0) {
        if (node.contents != CONTENTS_SOLID) {
            // we've reached a non-solid leaf, so it's
            r_pefragtopnode = node
        }
        // visible and not BSP clipped
        return
    }
    splitplane = node.plane
    sides = int(splitplane._c_type) < 3 ? (splitplane.dist <= r_emins[int(splitplane._c_type)] ? 1 :
                (splitplane.dist >= r_emaxs[int(splitplane._c_type)] ? 2 : 3)) : BoxOnPlaneSide(addr(r_emins[0]),
            addr(r_emaxs[0]), splitplane)
    if (sides == 3) {
        // remember first splitter
        r_pefragtopnode = node
        return
    }
    // not split yet; recurse down the contacted side
    if ((sides & 1) != 0) {
        R_SplitEntityOnNode2(node.children[0])
    } else {
        R_SplitEntityOnNode2(node.children[1])
    }
}

// ===========
// R_AddEfrags
// ===========
[c_function]
def R_AddEfrags(var ent : entity_s?) {
    var entmodel : model_s?
    if (ent.model == null) {
        return
    }
    if (intptr(ent) == intptr(addr(cl_entities[0]))) {
        // never add the world
        return
    }
    r_addent = ent
    lastlink = addr(ent.efrag)
    r_pefragtopnode = null
    entmodel = ent.model
    for (i in range(3)) {
        r_emins[i] = ent.origin[i] + entmodel.mins[i]
        r_emaxs[i] = ent.origin[i] + entmodel.maxs[i]
    }
    R_SplitEntityOnNode(cl.worldmodel.nodes)
    ent.topnode = r_pefragtopnode
}

// ================
// R_StoreEfrags
// FIXME: a lot of this goes away with edge-based
// ================
[c_function]
def R_StoreEfrags(var ppefrag : efrag_s ??) {
    var pent : entity_s?
    var clmodel : model_s?
    var pefrag : efrag_s?
    while (true) {
        pefrag = *ppefrag
        if (!(pefrag != null)) {
            break
        }
        pent = pefrag.entity
        clmodel = pent.model
        c_switch(clmodel._c_type) {
            case(modtype_t.mod_alias, modtype_t.mod_brush, modtype_t.mod_sprite) {
                pent = pefrag.entity
                if ((pent.visframe != r_framecount) && (cl_numvisedicts < MAX_VISEDICTS)) {
                    let _t0 = cl_numvisedicts
                    cl_numvisedicts++
                    cl_visedicts[_t0] = pent
                    // mark that we've recorded this entity for this frame
                    pent.visframe = r_framecount
                }
                ppefrag = addr(pefrag.leafnext)
                break
            }
            case(_) {
                Sys_Error`va(cstr("R_StoreEfrags: Bad entity type %d\n"), (uint(clmodel._c_type),))
            }
        }
    }
}

