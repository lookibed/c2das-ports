// ================
// D_PolysetDraw
// ================
[c_function]
def D_PolysetDraw {
    var spans : spanpackage_t[1027]
    // one extra because of cache line pretouching
    a_spans = reinterpret<spanpackage_t?>(uint64((int64(intptr(addr(spans[0]))) + int64(CACHE_SIZE) - 1l) & int64(~(CACHE_SIZE - 1))))
    if (r_affinetridesc.drawtype != 0) {
        D_DrawSubdiv()
    } else {
        D_DrawNonSubdiv()
    }
}

// ================
// D_PolysetDrawFinalVerts
// ================
[c_function]
def D_PolysetDrawFinalVerts(var fv : finalvert_s?; numverts : int) {
    var i : int
    var z : int
    var zbuf : int16?
    i = 0
    while (i < numverts) {
        // valid triangle coordinates for filling can include the bottom and
        // right clip edges, due to the fill rule; these shouldn't be drawn
        if ((fv.v[0] < r_refdef.vrectright) && (fv.v[1] < r_refdef.vrectbottom)) {
            z = fv.v[5] >> 16
            zbuf = zspantable[fv.v[1]] + fv.v[0]
            if (z >= int(*zbuf)) {
                var pix : int
                *zbuf = int16(z)
                pix = int(skintable[fv.v[3] >> 16][fv.v[2] >> 16])
                pix = int(reinterpret<uint8?>(acolormap)[pix + (fv.v[4] & 65280)])
                d_viewbuffer[d_scantable[fv.v[1]] + fv.v[0]] = uint8(pix)
            }
        }
        i++
        fv++
    }
}

// ================
// D_DrawSubdiv
// ================
[c_function]
def D_DrawSubdiv {
    var ptri : mtriangle_s?
    var pfv : finalvert_s?
    var index0 : finalvert_s?
    var index1 : finalvert_s?
    var index2 : finalvert_s?
    var lnumtriangles : int
    pfv = r_affinetridesc.pfinalverts
    ptri = r_affinetridesc.ptriangles
    lnumtriangles = r_affinetridesc.numtriangles
    for (i in range(lnumtriangles)) {
        index0 = pfv + ptri[i].vertindex[0]
        index1 = pfv + ptri[i].vertindex[1]
        index2 = pfv + ptri[i].vertindex[2]
        if (((index0.v[1] - index1.v[1]) * (index0.v[0] - index2.v[0]) - (index0.v[0] - index1.v[0]) * (index0.v[1] - index2.v[1])) >= 0) {
            continue
        }
        d_pcolormap = addr(reinterpret<uint8?>(acolormap)[index0.v[4] & 65280])
        if (ptri[i].facesfront != 0) {
            D_PolysetRecursiveTriangle(addr(index0.v[0]), addr(index1.v[0]), addr(index2.v[0]))
        } else {
            var s0 : int
            var s1 : int
            var s2 : int
            s0 = index0.v[2]
            s1 = index1.v[2]
            s2 = index2.v[2]
            if ((index0.flags & ALIAS_ONSEAM) != 0) {
                index0.v[2] += r_affinetridesc.seamfixupX16
            }
            if ((index1.flags & ALIAS_ONSEAM) != 0) {
                index1.v[2] += r_affinetridesc.seamfixupX16
            }
            if ((index2.flags & ALIAS_ONSEAM) != 0) {
                index2.v[2] += r_affinetridesc.seamfixupX16
            }
            D_PolysetRecursiveTriangle(addr(index0.v[0]), addr(index1.v[0]), addr(index2.v[0]))
            index0.v[2] = s0
            index1.v[2] = s1
            index2.v[2] = s2
        }
    }
}

// ================
// D_DrawNonSubdiv
// ================
[c_function]
def D_DrawNonSubdiv {
    var ptri : mtriangle_s?
    var pfv : finalvert_s?
    var index0 : finalvert_s?
    var index1 : finalvert_s?
    var index2 : finalvert_s?
    var i : int
    var lnumtriangles : int
    pfv = r_affinetridesc.pfinalverts
    ptri = r_affinetridesc.ptriangles
    lnumtriangles = r_affinetridesc.numtriangles
    i = 0
    while (i < lnumtriangles) {
        {
            index0 = pfv + ptri.vertindex[0]
            index1 = pfv + ptri.vertindex[1]
            index2 = pfv + ptri.vertindex[2]
            d_xdenom = (index0.v[1] - index1.v[1]) * (index0.v[0] - index2.v[0]) - (index0.v[0] - index1.v[0]) * (index0.v[1] - index2.v[1])
            if (d_xdenom >= 0) {
                continue
            }
            // u
            r_p0[0] = index0.v[0]
            // v
            r_p0[1] = index0.v[1]
            // s
            r_p0[2] = index0.v[2]
            // t
            r_p0[3] = index0.v[3]
            // light
            r_p0[4] = index0.v[4]
            // iz
            r_p0[5] = index0.v[5]
            r_p1[0] = index1.v[0]
            r_p1[1] = index1.v[1]
            r_p1[2] = index1.v[2]
            r_p1[3] = index1.v[3]
            r_p1[4] = index1.v[4]
            r_p1[5] = index1.v[5]
            r_p2[0] = index2.v[0]
            r_p2[1] = index2.v[1]
            r_p2[2] = index2.v[2]
            r_p2[3] = index2.v[3]
            r_p2[4] = index2.v[4]
            r_p2[5] = index2.v[5]
            if (ptri.facesfront == 0) {
                if ((index0.flags & ALIAS_ONSEAM) != 0) {
                    r_p0[2] += r_affinetridesc.seamfixupX16
                }
                if ((index1.flags & ALIAS_ONSEAM) != 0) {
                    r_p1[2] += r_affinetridesc.seamfixupX16
                }
                if ((index2.flags & ALIAS_ONSEAM) != 0) {
                    r_p2[2] += r_affinetridesc.seamfixupX16
                }
            }
            D_PolysetSetEdgeTable()
            D_RasterizeAliasPolySmooth()
        } finally {
            i++
            ptri++
        }
    }
}

// ================
// D_PolysetRecursiveTriangle
// ================
[c_function]
def D_PolysetRecursiveTriangle(var lp1 : int?; var lp2 : int?; var lp3 : int?) {
    var temp : int?
    var d : int
    var _c_new : int[6]
    var z : int
    var zbuf : int16?
    d = lp2[0] - lp1[0]
    if (d < -1 || d > 1) {
        goto label 3
    }
    d = lp2[1] - lp1[1]
    if (d < -1 || d > 1) {
        goto label 3
    }
    d = lp3[0] - lp2[0]
    if (d < -1 || d > 1) {
        goto label 2
    }
    d = lp3[1] - lp2[1]
    if (d < -1 || d > 1) {
        goto label 2
    }
    d = lp1[0] - lp3[0]
    if (d < -1 || d > 1) {
        goto label 1
    }
    d = lp1[1] - lp3[1]
    if (!(d < -1 || d > 1)) {
        goto label 5
    }
    label 1:  // split3
    temp = lp1
    lp1 = lp3
    lp3 = lp2
    lp2 = temp
    goto label 3
    label 5:  // end if
    // entire tri is filled
    return
    label 2:  // split2
    temp = lp1
    lp1 = lp2
    lp2 = lp3
    lp3 = temp
    label 3:  // split
    // split this edge
    _c_new[0] = (lp1[0] + lp2[0]) >> 1
    _c_new[1] = (lp1[1] + lp2[1]) >> 1
    _c_new[2] = (lp1[2] + lp2[2]) >> 1
    _c_new[3] = (lp1[3] + lp2[3]) >> 1
    _c_new[5] = (lp1[5] + lp2[5]) >> 1
    // draw the point if splitting a leading edge
    if (lp2[1] > lp1[1]) {
        goto label 4
    }
    if ((lp2[1] == lp1[1]) && (lp2[0] < lp1[0])) {
        goto label 4
    }
    z = _c_new[5] >> 16
    zbuf = zspantable[_c_new[1]] + _c_new[0]
    if (z >= int(*zbuf)) {
        var pix : int
        *zbuf = int16(z)
        pix = int(d_pcolormap[int(skintable[_c_new[3] >> 16][_c_new[2] >> 16])])
        d_viewbuffer[d_scantable[_c_new[1]] + _c_new[0]] = uint8(pix)
    }
    label 4:  // nodraw
    // recursively continue
    D_PolysetRecursiveTriangle(lp3, lp1, addr(_c_new[0]))
    D_PolysetRecursiveTriangle(lp3, addr(_c_new[0]), lp2)
}

// ================
// D_PolysetUpdateTables
// ================
[c_function]
def D_PolysetUpdateTables {
    var i : int
    var s : uint8?
    if (r_affinetridesc.skinwidth != skinwidth || r_affinetridesc.pskin != reinterpret<void?>(skinstart)) {
        skinwidth = r_affinetridesc.skinwidth
        skinstart = reinterpret<uint8?>(r_affinetridesc.pskin)
        s = skinstart
        i = 0
        while (i < MAX_LBM_HEIGHT) {
            skintable[i] = s
            i++
            s += skinwidth
        }
    }
}

// ===================
// D_PolysetScanLeftEdge
// ====================
[c_function]
def D_PolysetScanLeftEdge(var height : int) {
    while (true) {
        d_pedgespanpackage.pdest = reinterpret<void?>(d_pdest)
        d_pedgespanpackage.pz = d_pz
        d_pedgespanpackage.count = d_aspancount
        d_pedgespanpackage.ptex = d_ptex
        d_pedgespanpackage.sfrac = d_sfrac
        d_pedgespanpackage.tfrac = d_tfrac
        // FIXME: need to clamp l, s, t, at both ends?
        d_pedgespanpackage.light = d_light
        d_pedgespanpackage.zi = d_zi
        d_pedgespanpackage++
        errorterm += erroradjustup
        if (errorterm >= 0) {
            d_pdest += d_pdestextrastep
            d_pz += d_pzextrastep
            d_aspancount += d_countextrastep
            d_ptex += d_ptexextrastep
            d_sfrac += d_sfracextrastep
            d_ptex += d_sfrac >> 16
            d_sfrac &= 65535
            d_tfrac += d_tfracextrastep
            if ((d_tfrac & 65536) != 0) {
                d_ptex += r_affinetridesc.skinwidth
                d_tfrac &= 65535
            }
            d_light += d_lightextrastep
            d_zi += d_ziextrastep
            errorterm -= erroradjustdown
        } else {
            d_pdest += d_pdestbasestep
            d_pz += d_pzbasestep
            d_aspancount += ubasestep
            d_ptex += d_ptexbasestep
            d_sfrac += d_sfracbasestep
            d_ptex += d_sfrac >> 16
            d_sfrac &= 65535
            d_tfrac += d_tfracbasestep
            if ((d_tfrac & 65536) != 0) {
                d_ptex += r_affinetridesc.skinwidth
                d_tfrac &= 65535
            }
            d_light += d_lightbasestep
            d_zi += d_zibasestep
        }
        height--
        if (height == 0) {
            break
        }
    }
}

// ===================
// D_PolysetSetUpForLineScan
// ====================
[c_function]
def D_PolysetSetUpForLineScan(startvertu : int; startvertv : int; endvertu : int; endvertv : int) {
    var dm : double
    var dn : double
    var tm : int
    var tn : int
    var ptemp : adivtab_t?
    // TODO: implement x86 version
    errorterm = -1
    tm = endvertu - startvertu
    tn = endvertv - startvertv
    if (((tm <= 16) && (tm >= -15)) && ((tn <= 16) && (tn >= -15))) {
        ptemp = addr(adivtab[0]) + end_index(((tm + 15) << 5) + (tn + 15), 1024)
        ubasestep = ptemp.quotient
        erroradjustup = ptemp.remainder
        erroradjustdown = tn
    } else {
        dm = double(tm)
        dn = double(tn)
        FloorDivMod(dm, dn, addr(ubasestep), addr(erroradjustup))
        erroradjustdown = int(dn)
    }
}

// ================
// D_PolysetCalcGradients
// ================
def D_PolysetCalcGradients(skinwidth : int) {
    var xstepdenominv : float
    var ystepdenominv : float
    var t0 : float
    var t1 : float
    var p01_minus_p21 : float
    var p11_minus_p21 : float
    var p00_minus_p20 : float
    var p10_minus_p20 : float
    p00_minus_p20 = float(r_p0[0] - r_p2[0])
    p01_minus_p21 = float(r_p0[1] - r_p2[1])
    p10_minus_p20 = float(r_p1[0] - r_p2[0])
    p11_minus_p21 = float(r_p1[1] - r_p2[1])
    xstepdenominv = float(1.0lf / double(float(d_xdenom)))
    ystepdenominv = -xstepdenominv
    // ceil () for light so positive steps are exaggerated, negative steps
    // diminished, pushing us away from underflow toward overflow. Underflow is
    // very visible, overflow is very unlikely, because of ambient lighting
    t0 = float(r_p0[4] - r_p2[4])
    t1 = float(r_p1[4] - r_p2[4])
    r_lstepx = int(math::ceil(double((t1 * p01_minus_p21 - t0 * p11_minus_p21) * xstepdenominv)))
    r_lstepy = int(math::ceil(double((t1 * p00_minus_p20 - t0 * p10_minus_p20) * ystepdenominv)))
    t0 = float(r_p0[2] - r_p2[2])
    t1 = float(r_p1[2] - r_p2[2])
    r_sstepx = int((t1 * p01_minus_p21 - t0 * p11_minus_p21) * xstepdenominv)
    r_sstepy = int((t1 * p00_minus_p20 - t0 * p10_minus_p20) * ystepdenominv)
    t0 = float(r_p0[3] - r_p2[3])
    t1 = float(r_p1[3] - r_p2[3])
    r_tstepx = int((t1 * p01_minus_p21 - t0 * p11_minus_p21) * xstepdenominv)
    r_tstepy = int((t1 * p00_minus_p20 - t0 * p10_minus_p20) * ystepdenominv)
    t0 = float(r_p0[5] - r_p2[5])
    t1 = float(r_p1[5] - r_p2[5])
    r_zistepx = int((t1 * p01_minus_p21 - t0 * p11_minus_p21) * xstepdenominv)
    r_zistepy = int((t1 * p00_minus_p20 - t0 * p10_minus_p20) * ystepdenominv)
    a_sstepxfrac = r_sstepx & 65535
    a_tstepxfrac = r_tstepx & 65535
    a_ststepxwhole = skinwidth * (r_tstepx >> 16) + (r_sstepx >> 16)
}

// ================
// D_PolysetDrawSpans8
// ================
[c_function]
def D_PolysetDrawSpans8(var pspanpackage : spanpackage_t?) {
    var lcount : int
    var lpdest : uint8?
    var lptex : uint8?
    var lsfrac : int
    var ltfrac : int
    var llight : int
    var lzi : int
    var lpz : int16?
    c_do_while(pspanpackage.count != -999999) {
        lcount = d_aspancount - pspanpackage.count
        errorterm += erroradjustup
        if (errorterm >= 0) {
            d_aspancount += d_countextrastep
            errorterm -= erroradjustdown
        } else {
            d_aspancount += ubasestep
        }
        if (lcount != 0) {
            lpdest = reinterpret<uint8?>(pspanpackage.pdest)
            lptex = pspanpackage.ptex
            lpz = pspanpackage.pz
            lsfrac = pspanpackage.sfrac
            ltfrac = pspanpackage.tfrac
            llight = pspanpackage.light
            lzi = pspanpackage.zi
            while (true) {
                if ((lzi >> 16) >= int(*lpz)) {
                    *lpdest = reinterpret<uint8?>(acolormap)[int(*lptex) + (llight & 65280)]
                    // gel mapping *lpdest = gelmap[*lpdest];
                    *lpz = int16(lzi >> 16)
                }
                lpdest++
                lzi += r_zistepx
                lpz++
                llight += r_lstepx
                lptex += a_ststepxwhole
                lsfrac += a_sstepxfrac
                lptex += lsfrac >> 16
                lsfrac &= 65535
                ltfrac += a_tstepxfrac
                if ((ltfrac & 65536) != 0) {
                    lptex += r_affinetridesc.skinwidth
                    ltfrac &= 65535
                }
                lcount--
                if (lcount == 0) {
                    break
                }
            }
        }
        pspanpackage++
    }
}

// ================
// D_PolysetFillSpans8
// ================
[c_function]
def D_PolysetFillSpans8(var pspanpackage : spanpackage_t?) {
    var color : int
    // FIXME: do z buffering
    let _t0 = d_aflatcolor
    d_aflatcolor++
    color = _t0
    while (1 != 0) {
        var lcount : int
        var lpdest : uint8?
        lcount = pspanpackage.count
        if (lcount == -1) {
            return
        }
        if (lcount != 0) {
            lpdest = reinterpret<uint8?>(pspanpackage.pdest)
            while (true) {
                var _t1 = lpdest
                lpdest++
                *_t1 = uint8(color)
                lcount--
                if (lcount == 0) {
                    break
                }
            }
        }
        pspanpackage++
    }
}

// ================
// D_RasterizeAliasPolySmooth
// ================
[c_function]
def D_RasterizeAliasPolySmooth {
    var initialleftheight : int
    var initialrightheight : int
    var plefttop : int?
    var prighttop : int?
    var pleftbottom : int?
    var prightbottom : int?
    var working_lstepx : int
    var originalcount : int
    plefttop = pedgetable.pleftedgevert0
    prighttop = pedgetable.prightedgevert0
    pleftbottom = pedgetable.pleftedgevert1
    prightbottom = pedgetable.prightedgevert1
    initialleftheight = pleftbottom[1] - plefttop[1]
    initialrightheight = prightbottom[1] - prighttop[1]
    // set the s, t, and light gradients, which are consistent across the triangle
    // because being a triangle, things are affine
    D_PolysetCalcGradients(r_affinetridesc.skinwidth)
    // rasterize the polygon
    // scan out the top (and possibly only) part of the left edge
    d_pedgespanpackage = a_spans
    ystart = plefttop[1]
    d_aspancount = plefttop[0] - prighttop[0]
    d_ptex = reinterpret<uint8?>(r_affinetridesc.pskin) + (plefttop[2] >> 16) + (plefttop[3] >> 16) * r_affinetridesc.skinwidth
    d_sfrac = plefttop[2] & 65535
    d_tfrac = plefttop[3] & 65535
    d_light = plefttop[4]
    d_zi = plefttop[5]
    d_pdest = d_viewbuffer + ystart * screenwidth + plefttop[0]
    d_pz = d_pzbuffer + uint(ystart) * d_zwidth + plefttop[0]
    if (initialleftheight == 1) {
        d_pedgespanpackage.pdest = reinterpret<void?>(d_pdest)
        d_pedgespanpackage.pz = d_pz
        d_pedgespanpackage.count = d_aspancount
        d_pedgespanpackage.ptex = d_ptex
        d_pedgespanpackage.sfrac = d_sfrac
        d_pedgespanpackage.tfrac = d_tfrac
        // FIXME: need to clamp l, s, t, at both ends?
        d_pedgespanpackage.light = d_light
        d_pedgespanpackage.zi = d_zi
        d_pedgespanpackage++
    } else {
        D_PolysetSetUpForLineScan(plefttop[0], plefttop[1], pleftbottom[0], pleftbottom[1])
        d_pzbasestep = int(d_zwidth + uint(ubasestep))
        d_pzextrastep = d_pzbasestep + 1
        d_pdestbasestep = screenwidth + ubasestep
        d_pdestextrastep = d_pdestbasestep + 1
        // TODO: can reuse partial expressions here
        // for negative steps in x along left edge, bias toward overflow rather than
        // underflow (sort of turning the floor () we did in the gradient calcs into
        // ceil (), but plus a little bit)
        if (ubasestep < 0) {
            working_lstepx = r_lstepx - 1
        } else {
            working_lstepx = r_lstepx
        }
        d_countextrastep = ubasestep + 1
        d_ptexbasestep = ((r_sstepy + r_sstepx * ubasestep) >> 16) + ((r_tstepy + r_tstepx * ubasestep) >> 16) * r_affinetridesc.skinwidth
        d_sfracbasestep = (r_sstepy + r_sstepx * ubasestep) & 65535
        d_tfracbasestep = (r_tstepy + r_tstepx * ubasestep) & 65535
        d_lightbasestep = r_lstepy + working_lstepx * ubasestep
        d_zibasestep = r_zistepy + r_zistepx * ubasestep
        d_ptexextrastep = ((r_sstepy + r_sstepx * d_countextrastep) >> 16) + ((r_tstepy + r_tstepx * d_countextrastep) >> 16) * r_affinetridesc.skinwidth
        d_sfracextrastep = (r_sstepy + r_sstepx * d_countextrastep) & 65535
        d_tfracextrastep = (r_tstepy + r_tstepx * d_countextrastep) & 65535
        d_lightextrastep = d_lightbasestep + working_lstepx
        d_ziextrastep = d_zibasestep + r_zistepx
        D_PolysetScanLeftEdge(initialleftheight)
    }
    // scan out the bottom part of the left edge, if it exists
    if (pedgetable.numleftedges == 2) {
        var height : int
        plefttop = pleftbottom
        pleftbottom = pedgetable.pleftedgevert2
        height = pleftbottom[1] - plefttop[1]
        // TODO: make this a function; modularize this function in general
        ystart = plefttop[1]
        d_aspancount = plefttop[0] - prighttop[0]
        d_ptex = reinterpret<uint8?>(r_affinetridesc.pskin) + (plefttop[2] >> 16) + (plefttop[3] >> 16) * r_affinetridesc.skinwidth
        d_sfrac = 0
        d_tfrac = 0
        d_light = plefttop[4]
        d_zi = plefttop[5]
        d_pdest = d_viewbuffer + ystart * screenwidth + plefttop[0]
        d_pz = d_pzbuffer + uint(ystart) * d_zwidth + plefttop[0]
        if (height == 1) {
            d_pedgespanpackage.pdest = reinterpret<void?>(d_pdest)
            d_pedgespanpackage.pz = d_pz
            d_pedgespanpackage.count = d_aspancount
            d_pedgespanpackage.ptex = d_ptex
            d_pedgespanpackage.sfrac = d_sfrac
            d_pedgespanpackage.tfrac = d_tfrac
            // FIXME: need to clamp l, s, t, at both ends?
            d_pedgespanpackage.light = d_light
            d_pedgespanpackage.zi = d_zi
            d_pedgespanpackage++
        } else {
            D_PolysetSetUpForLineScan(plefttop[0], plefttop[1], pleftbottom[0], pleftbottom[1])
            d_pdestbasestep = screenwidth + ubasestep
            d_pdestextrastep = d_pdestbasestep + 1
            d_pzbasestep = int(d_zwidth + uint(ubasestep))
            d_pzextrastep = d_pzbasestep + 1
            if (ubasestep < 0) {
                working_lstepx = r_lstepx - 1
            } else {
                working_lstepx = r_lstepx
            }
            d_countextrastep = ubasestep + 1
            d_ptexbasestep = ((r_sstepy + r_sstepx * ubasestep) >> 16) + ((r_tstepy + r_tstepx * ubasestep) >> 16) * r_affinetridesc.skinwidth
            d_sfracbasestep = (r_sstepy + r_sstepx * ubasestep) & 65535
            d_tfracbasestep = (r_tstepy + r_tstepx * ubasestep) & 65535
            d_lightbasestep = r_lstepy + working_lstepx * ubasestep
            d_zibasestep = r_zistepy + r_zistepx * ubasestep
            d_ptexextrastep = ((r_sstepy + r_sstepx * d_countextrastep) >> 16) + ((r_tstepy + r_tstepx * d_countextrastep) >> 16) * r_affinetridesc.skinwidth
            d_sfracextrastep = (r_sstepy + r_sstepx * d_countextrastep) & 65535
            d_tfracextrastep = (r_tstepy + r_tstepx * d_countextrastep) & 65535
            d_lightextrastep = d_lightbasestep + working_lstepx
            d_ziextrastep = d_zibasestep + r_zistepx
            D_PolysetScanLeftEdge(height)
        }
    }
    // scan out the top (and possibly only) part of the right edge, updating the
    // count field
    d_pedgespanpackage = a_spans
    D_PolysetSetUpForLineScan(prighttop[0], prighttop[1], prightbottom[0], prightbottom[1])
    d_aspancount = 0
    d_countextrastep = ubasestep + 1
    originalcount = a_spans[initialrightheight].count
    // mark end of the spanpackages
    a_spans[initialrightheight].count = -999999
    D_PolysetDrawSpans8(a_spans)
    // scan out the bottom part of the right edge, if it exists
    if (pedgetable.numrightedges == 2) {
        var height : int
        var pstart : spanpackage_t?
        pstart = a_spans + initialrightheight
        pstart.count = originalcount
        d_aspancount = prightbottom[0] - prighttop[0]
        prighttop = prightbottom
        prightbottom = pedgetable.prightedgevert2
        height = prightbottom[1] - prighttop[1]
        D_PolysetSetUpForLineScan(prighttop[0], prighttop[1], prightbottom[0], prightbottom[1])
        d_countextrastep = ubasestep + 1
        a_spans[initialrightheight + height].count = -999999
        // mark end of the spanpackages
        D_PolysetDrawSpans8(pstart)
    }
}

// ================
// D_PolysetSetEdgeTable
// ================
[c_function]
def D_PolysetSetEdgeTable {
    var edgetableindex : int
    // assume the vertices are already in
    edgetableindex = 0
    // top to bottom order
    // determine which edges are right & left, and the order in which
    // to rasterize them
    if (r_p0[1] >= r_p1[1]) {
        if (r_p0[1] == r_p1[1]) {
            if (r_p0[1] < r_p2[1]) {
                pedgetable = addr(edgetables[2])
            } else {
                pedgetable = addr(edgetables[5])
            }
            return
        } else {
            edgetableindex = 1
        }
    }
    if (r_p0[1] == r_p2[1]) {
        if (edgetableindex != 0) {
            pedgetable = addr(edgetables[8])
        } else {
            pedgetable = addr(edgetables[9])
        }
        return
    } elif (r_p1[1] == r_p2[1]) {
        if (edgetableindex != 0) {
            pedgetable = addr(edgetables[10])
        } else {
            pedgetable = addr(edgetables[11])
        }
        return
    }
    if (r_p0[1] > r_p2[1]) {
        edgetableindex += 2
    }
    if (r_p1[1] > r_p2[1]) {
        edgetableindex += 4
    }
    pedgetable = addr(edgetables[0]) + end_index(edgetableindex, 12)
}

