[c_function]
def ProjectPointOnPlane(var dst : float?; var p : float?; var normal : float?) {
    var d : float
    var n : float[3]
    var inv_denom : float
    inv_denom = 1f / DotProduct(normal, normal)
    d = DotProduct(normal, p) * inv_denom
    n[0] = normal[0] * inv_denom
    n[1] = normal[1] * inv_denom
    n[2] = normal[2] * inv_denom
    dst[0] = p[0] - d * n[0]
    dst[1] = p[1] - d * n[1]
    dst[2] = p[2] - d * n[2]
}

// assumes "src" is normalized
[c_function]
def PerpendicularVector(var dst : float?; var src : float?) {
    var pos : int
    var i : int
    var minelem : float = 1f
    var tempvec : float[3]
    // find the smallest magnitude axially aligned vector
    pos = 0
    i = 0
    while (i < 3) {
        if (math::abs(double(src[i])) < double(minelem)) {
            pos = i
            minelem = float(math::abs(double(src[i])))
        }
        i++
    }
    tempvec[2] = 0f
    tempvec[1] = tempvec[2]
    tempvec[0] = tempvec[1]
    tempvec[pos] = 1f
    // project the point onto the plane defined by src
    ProjectPointOnPlane(dst, addr(tempvec[0]), src)
    // normalize the result
    VectorNormalize(dst)
}

[c_function]
def RotatePointAroundVector(var dst : float?; var dir : float?; var point : float?; degrees : float) {
    var m : float[3][3]
