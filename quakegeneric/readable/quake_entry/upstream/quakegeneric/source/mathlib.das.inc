[c_function]
def R_ConcatRotations(var in1 : float[3]?; var in2 : float[3]?; var out : float[3]?) {
    out[0][0] = in1[0][0] * in2[0][0] + in1[0][1] * in2[1][0] + in1[0][2] * in2[2][0]
    out[0][1] = in1[0][0] * in2[0][1] + in1[0][1] * in2[1][1] + in1[0][2] * in2[2][1]
    out[0][2] = in1[0][0] * in2[0][2] + in1[0][1] * in2[1][2] + in1[0][2] * in2[2][2]
    out[1][0] = in1[1][0] * in2[0][0] + in1[1][1] * in2[1][0] + in1[1][2] * in2[2][0]
    out[1][1] = in1[1][0] * in2[0][1] + in1[1][1] * in2[1][1] + in1[1][2] * in2[2][1]
    out[1][2] = in1[1][0] * in2[0][2] + in1[1][1] * in2[1][2] + in1[1][2] * in2[2][2]
    out[2][0] = in1[2][0] * in2[0][0] + in1[2][1] * in2[1][0] + in1[2][2] * in2[2][0]
    out[2][1] = in1[2][0] * in2[0][1] + in1[2][1] * in2[1][1] + in1[2][2] * in2[2][1]
    out[2][2] = in1[2][0] * in2[0][2] + in1[2][1] * in2[1][2] + in1[2][2] * in2[2][2]
}

// ================
// R_ConcatTransforms
// ================
[c_function]
def R_ConcatTransforms(var in1 : float[4]?; var in2 : float[4]?; var out : float[4]?) {
    out[0][0] = in1[0][0] * in2[0][0] + in1[0][1] * in2[1][0] + in1[0][2] * in2[2][0]
    out[0][1] = in1[0][0] * in2[0][1] + in1[0][1] * in2[1][1] + in1[0][2] * in2[2][1]
    out[0][2] = in1[0][0] * in2[0][2] + in1[0][1] * in2[1][2] + in1[0][2] * in2[2][2]
    out[0][3] = in1[0][0] * in2[0][3] + in1[0][1] * in2[1][3] + in1[0][2] * in2[2][3] + in1[0][3]
    out[1][0] = in1[1][0] * in2[0][0] + in1[1][1] * in2[1][0] + in1[1][2] * in2[2][0]
    out[1][1] = in1[1][0] * in2[0][1] + in1[1][1] * in2[1][1] + in1[1][2] * in2[2][1]
    out[1][2] = in1[1][0] * in2[0][2] + in1[1][1] * in2[1][2] + in1[1][2] * in2[2][2]
    out[1][3] = in1[1][0] * in2[0][3] + in1[1][1] * in2[1][3] + in1[1][2] * in2[2][3] + in1[1][3]
    out[2][0] = in1[2][0] * in2[0][0] + in1[2][1] * in2[1][0] + in1[2][2] * in2[2][0]
    out[2][1] = in1[2][0] * in2[0][1] + in1[2][1] * in2[1][1] + in1[2][2] * in2[2][1]
    out[2][2] = in1[2][0] * in2[0][2] + in1[2][1] * in2[1][2] + in1[2][2] * in2[2][2]
    out[2][3] = in1[2][0] * in2[0][3] + in1[2][1] * in2[1][3] + in1[2][2] * in2[2][3] + in1[2][3]
}

[c_function]
def FloorDivMod(numer : double; denom : double; var quotient : int?; var rem : int?) {
    var q : int
    var r : int
    var x : double
    if (denom <= 0.0lf) {
        Sys_Error`va(cstr("FloorDivMod: bad denominator %d\n"), (denom,))
    }
    // if ((floor(numer) != numer) || (floor(denom) != denom))
    // Sys_Error ("FloorDivMod: non-integer numer or denom %f %f\n",
    // numer, denom);
    if (numer >= 0.0lf) {
        x = math::floor(numer / denom)
        q = int(x)
        r = int(math::floor(numer - (x * denom)))
    } else {
        // perform operations with positive values, and fix mod to make floor-based
        x = math::floor(-numer / denom)
        q = -int(x)
        r = int(math::floor(-numer - (x * denom)))
        if (r != 0) {
            q--
            r = int(denom) - r
        }
    }
    *quotient = q
    *rem = r
}

// ===================
// GreatestCommonDivisor
// ====================
def GreatestCommonDivisor(i1 : int; i2 : int) : int {
    if (i1 > i2) {
        if (i2 == 0) {
            return i1
        }
        return GreatestCommonDivisor(i2, i1 % i2)
    } else {
        if (i1 == 0) {
            return i2
        }
        return GreatestCommonDivisor(i1, i2 % i1)
    }
}

def Invert24To16(val : int) : int {
    if (val < 256) {
        return int(4294967295u)
    }
    return int((65536.0lf * 16777216.0lf / double(val)) + 0.5lf)
}

