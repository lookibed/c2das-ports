    m[0][0] = vr[0]
    m[1][0] = vr[1]
    m[2][0] = vr[2]
    m[0][1] = vup[0]
    m[1][1] = vup[1]
    m[2][1] = vup[2]
    m[0][2] = vf[0]
    m[1][2] = vf[1]
    m[2][2] = vf[2]
    crt::memcpy(reinterpret<void?>(addr(im[0])), reinterpret<void?>(addr(m[0])), uint64(typeinfo sizeof(type<float[3][3]>)))
    im[0][1] = m[1][0]
    im[0][2] = m[2][0]
    im[1][0] = m[0][1]
    im[1][2] = m[2][1]
    im[2][0] = m[0][2]
    im[2][1] = m[1][2]
    crt::memset(reinterpret<void?>(addr(zrot[0])), 0, uint64(typeinfo sizeof(type<float[3][3]>)))
    zrot[2][2] = 1f
    zrot[1][1] = zrot[2][2]
    zrot[0][0] = zrot[1][1]
    zrot[0][0] = float(math::cos(DEG2RAD(degrees)))
    zrot[0][1] = float(math::sin(DEG2RAD(degrees)))
    zrot[1][0] = float(-math::sin(DEG2RAD(degrees)))
    zrot[1][1] = float(math::cos(DEG2RAD(degrees)))
    R_ConcatRotations(addr(m[0]), addr(zrot[0]), addr(tmpmat[0]))
    R_ConcatRotations(addr(tmpmat[0]), addr(im[0]), addr(rot[0]))
    for (i in range(3)) {
        dst[i] = rot[i][0] * point[0] + rot[i][1] * point[1] + rot[i][2] * point[2]
    }
}

def anglemod(var a : float) : float {
    a = float((360.0lf / 65536.0lf) * double(int(double(a) * (65536.0lf / 360.0lf)) & 65535))
    return a
}

