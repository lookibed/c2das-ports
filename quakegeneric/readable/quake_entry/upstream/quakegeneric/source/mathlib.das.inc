[c_function]
def CrossProduct(var v1 : float?; var v2 : float?; var cross : float?) {
    cross[0] = v1[1] * v2[2] - v1[2] * v2[1]
    cross[1] = v1[2] * v2[0] - v1[0] * v2[2]
    cross[2] = v1[0] * v2[1] - v1[1] * v2[0]
}

[c_function]
def Length(var v : float?) : float {
    var length : float
    length = 0.0f
    for (i in range(3)) {
        length += v[i] * v[i]
    }
    // FIXME
    length = float(math::sqrt(double(length)))
    return length
}

[c_function]
def VectorNormalize(var v : float?) : float {
    var length : float
    var ilength : float
    length = v[0] * v[0] + v[1] * v[1] + v[2] * v[2]
    // FIXME
    length = float(math::sqrt(double(length)))
    if (length != 0.0f) {
        ilength = 1.0f / length
        v[0] *= ilength
        v[1] *= ilength
        v[2] *= ilength
    }
    return length
}

