// generated by c2das - regenerate, never edit
var wad_numlumps : int
var wad_lumps : lumpinfo_t?
var wad_base : uint8?

// ==================
// W_CleanupName
// Lowercases name and pads with spaces and a terminating 0 to the length of
// lumpinfo_t->name.
// Used so lumpname lookups can proceed rapidly by comparing 4 chars at a time
// Space padding is so names can be printed nicely in tables.
// Can safely be performed in place.
// ==================
[c_function]
def W_CleanupName(var _c_in : uint8?; var out : uint8?) {
    var i : int
    var c : int
    i = 0
    while (i < 16) {
        c = int(_c_in[i])
        if (c == 0) {
            break
        }
        if (c >= 'A' && c <= 'Z') {
            c += 'a' - 'A'
        }
        out[i] = uint8(c)
        i++
    }
    while (i < 16) {
        out[i] = 0u8
        i++
    }
}

// ====================
// W_LoadWadFile
// ====================
[c_function]
def W_LoadWadFile(var filename : uint8?) {
    var lump_p : lumpinfo_t?
    var header : wadinfo_t?
    var i : uint
    var infotableofs : int
    wad_base = COM_LoadHunkFile(filename)
    if (wad_base == null) {
        Sys_Error`va(cstr("W_LoadWadFile: couldn't load %s"), (filename,))
    }
    header = reinterpret<wadinfo_t?>(wad_base)
    if (header.identification[0] != 'W' || header.identification[1] != 'A' || header.identification[2] != 'D' || header.identification[3] != '2') {
        Sys_Error`va(cstr("Wad file %s doesn't have WAD2 id\n"), (filename,))
    }
    wad_numlumps = invoke(LittleLong, header.numlumps)
    infotableofs = invoke(LittleLong, header.infotableofs)
    wad_lumps = reinterpret<lumpinfo_t?>(wad_base + infotableofs)
    i = 0u
    lump_p = wad_lumps
    while (i < uint(wad_numlumps)) {
        lump_p.filepos = invoke(LittleLong, lump_p.filepos)
        lump_p.size = invoke(LittleLong, lump_p.size)
        W_CleanupName(addr(lump_p.name[0]), addr(lump_p.name[0]))
        if (int(lump_p._c_type) == TYP_QPIC) {
            SwapPic(reinterpret<qpic_t?>(wad_base + lump_p.filepos))
        }
        i++
        lump_p++
    }
}

// =============
// W_GetLumpinfo
// =============
[c_function]
def W_GetLumpinfo(var name : uint8?) : lumpinfo_t? {
    var i : int
    var lump_p : lumpinfo_t?
    var clean : uint8[16]
    W_CleanupName(name, addr(clean[0]))
    lump_p = wad_lumps
    i = 0
    while (i < wad_numlumps) {
        if (crt::strcmp(addr(clean[0]), addr(lump_p.name[0])) == 0) {
            return lump_p
        }
        i++
        lump_p++
    }
    Sys_Error`va(cstr("W_GetLumpinfo: %s not found"), (name,))
    return null
}

[c_function]
def W_GetLumpName(var name : uint8?) : void? {
    var lump : lumpinfo_t?
    lump = W_GetLumpinfo(name)
    return reinterpret<void?>(wad_base + lump.filepos)
}

[c_function]
def W_GetLumpNum(num : int) : void? {
    var lump : lumpinfo_t?
    if (num < 0 || num > wad_numlumps) {
        Sys_Error`va(cstr("W_GetLumpNum: bad number: %i"), (num,))
    }
    lump = wad_lumps + num
    return reinterpret<void?>(wad_base + lump.filepos)
}

def SwapPic(var pic : qpic_t?) {
    pic.width = invoke(LittleLong, pic.width)
    pic.height = invoke(LittleLong, pic.height)
}

