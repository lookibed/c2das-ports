[c_function]
def D_DrawParticle(var pparticle : particle_s?) {
    var local : float[3]
    var transformed : float[3]
    var zi : float
    var pdest : uint8?
    var pz : int16?
    var i : int
    var izi : int
    var pix : int
    var count : int
    var u : int
    var v : int
    // transform point
    local[0] = pparticle.org[0] - r_origin[0]
    local[1] = pparticle.org[1] - r_origin[1]
    local[2] = pparticle.org[2] - r_origin[2]
    transformed[0] = local[0] * r_pright[0] + local[1] * r_pright[1] + local[2] * r_pright[2]
    transformed[1] = local[0] * r_pup[0] + local[1] * r_pup[1] + local[2] * r_pup[2]
    transformed[2] = local[0] * r_ppn[0] + local[1] * r_ppn[1] + local[2] * r_ppn[2]
    if (double(transformed[2]) < PARTICLE_Z_CLIP) {
        return
    }
    // project the point
    // FIXME: preadjust xcenter and ycenter
    zi = float(1.0lf / double(transformed[2]))
    u = int(double(xcenter + zi * transformed[0]) + 0.5lf)
    v = int(double(ycenter - zi * transformed[1]) + 0.5lf)
    if ((v > d_vrectbottom_particle) || (u > d_vrectright_particle) || (v < d_vrecty) || (u < d_vrectx)) {
        return
    }
    pz = d_pzbuffer + (d_zwidth * uint(v)) + u
    pdest = d_viewbuffer + d_scantable[v] + u
    izi = int(zi * 32768.0f)
    pix = izi >> d_pix_shift
    if (pix < d_pix_min) {
        pix = d_pix_min
    } elif (pix > d_pix_max) {
        pix = d_pix_max
    }
    c_switch(pix) {
        case(1) {
            count = 1 << d_y_aspect_shift
            while (count != 0) {
                if (int(pz[0]) <= izi) {
                    pz[0] = int16(izi)
                    pdest[0] = uint8(pparticle.color)
                }
                count--
                pz += d_zwidth
                pdest += screenwidth
            }
            break
        }
        case(2) {
            count = 2 << d_y_aspect_shift
            while (count != 0) {
                if (int(pz[0]) <= izi) {
                    pz[0] = int16(izi)
                    pdest[0] = uint8(pparticle.color)
                }
                if (int(pz[1]) <= izi) {
                    pz[1] = int16(izi)
                    pdest[1] = uint8(pparticle.color)
                }
                count--
                pz += d_zwidth
                pdest += screenwidth
            }
            break
        }
        case(3) {
            count = 3 << d_y_aspect_shift
            while (count != 0) {
                if (int(pz[0]) <= izi) {
                    pz[0] = int16(izi)
                    pdest[0] = uint8(pparticle.color)
                }
                if (int(pz[1]) <= izi) {
                    pz[1] = int16(izi)
                    pdest[1] = uint8(pparticle.color)
                }
                if (int(pz[2]) <= izi) {
                    pz[2] = int16(izi)
                    pdest[2] = uint8(pparticle.color)
                }
                count--
                pz += d_zwidth
                pdest += screenwidth
            }
            break
        }
        case(4) {
            count = 4 << d_y_aspect_shift
            while (count != 0) {
                if (int(pz[0]) <= izi) {
                    pz[0] = int16(izi)
                    pdest[0] = uint8(pparticle.color)
                }
                if (int(pz[1]) <= izi) {
                    pz[1] = int16(izi)
                    pdest[1] = uint8(pparticle.color)
                }
                if (int(pz[2]) <= izi) {
                    pz[2] = int16(izi)
                    pdest[2] = uint8(pparticle.color)
                }
                if (int(pz[3]) <= izi) {
                    pz[3] = int16(izi)
                    pdest[3] = uint8(pparticle.color)
                }
                count--
                pz += d_zwidth
                pdest += screenwidth
            }
            break
        }
        case(_) {
            count = pix << d_y_aspect_shift
            while (count != 0) {
                i = 0
                while (i < pix) {
                    if (int(pz[i]) <= izi) {
                        pz[i] = int16(izi)
                        pdest[i] = uint8(pparticle.color)
                    }
                    i++
                }
                count--
                pz += d_zwidth
                pdest += screenwidth
            }
            break
        }
    }
}

