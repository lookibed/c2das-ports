            if (int_of(lastdist > 0.0f) != int_of(dist > 0.0f)) {
                frac = dist / (dist - lastdist)
                verts[newpage][newverts].position[0] = verts[vertpage][i1].position[0] + ((verts[vertpage][lastvert].position[0] -
                            verts[vertpage][i1].position[0]) *
                        frac)
                verts[newpage][newverts].position[1] = verts[vertpage][i1].position[1] + ((verts[vertpage][lastvert].position[1] -
                            verts[vertpage][i1].position[1]) *
                        frac)
                verts[newpage][newverts].position[2] = verts[vertpage][i1].position[2] + ((verts[vertpage][lastvert].position[2] -
                            verts[vertpage][i1].position[2]) *
                        frac)
                newverts++
            }
            if (dist >= 0.0f) {
                verts[newpage][newverts] = verts[vertpage][i1]
                newverts++
                visible = qboolean._c_true
            }
            lastvert = i1
            lastdist = dist
        }
        if (int(visible) == 0 || (newverts < 3)) {
            return
        }
        lnumverts = newverts
        vertpage ^= 1
        pclip = pclip.next
    }
    // transform and project, remembering the z values at the vertices and
    // r_nearzi, and extract the s and t coordinates at the vertices
    pplane = fa.plane
    c_switch(int(pplane._c_type)) {
        case(0, 3) {
            s_axis = 1
            t_axis = 2
            break
        }
        case(1, 4) {
            s_axis = 0
            t_axis = 2
            break
        }
        case(2, 5) {
            s_axis = 0
            t_axis = 1
            break
        }
    }
    r_nearzi = 0.0f
    for (i1 in range(lnumverts)) {
        // transform and project
        local[0] = verts[vertpage][i1].position[0] - modelorg[0]
        local[1] = verts[vertpage][i1].position[1] - modelorg[1]
        local[2] = verts[vertpage][i1].position[2] - modelorg[2]
        TransformVector(addr(local[0]), addr(transformed[0]))
        if (double(transformed[2]) < NEAR_CLIP) {
            transformed[2] = float(NEAR_CLIP)
        }
        lzi = float(1.0lf / double(transformed[2]))
        // for mipmap finding
        if (lzi > r_nearzi) {
            r_nearzi = lzi
        }
        // FIXME: build x/yscale into transform?
        scale = xscale * lzi
        u = xcenter + scale * transformed[0]
        if (u < r_refdef.fvrectx_adj) {
            u = r_refdef.fvrectx_adj
        }
        if (u > r_refdef.fvrectright_adj) {
            u = r_refdef.fvrectright_adj
        }
        scale = yscale * lzi
        v = ycenter - scale * transformed[1]
        if (v < r_refdef.fvrecty_adj) {
            v = r_refdef.fvrecty_adj
        }
        if (v > r_refdef.fvrectbottom_adj) {
            v = r_refdef.fvrectbottom_adj
        }
        pverts[i1].u = u
        pverts[i1].v = v
        pverts[i1].zi = lzi
        pverts[i1].s = verts[vertpage][i1].position[s_axis]
        pverts[i1].t = verts[vertpage][i1].position[t_axis]
    }
    // build the polygon descriptor, including fa, r_nearzi, and u, v, s, t, and z
    // for each vertex
    r_polydesc.numverts = lnumverts
    r_polydesc.nearzi = r_nearzi
    r_polydesc.pcurrentface = fa
    r_polydesc.pverts = addr(pverts[0])
    // draw the polygon
    D_DrawPoly()
}

// ================
// R_ZDrawSubmodelPolys
// ================
[c_function]
def R_ZDrawSubmodelPolys(var pmodel : model_s?) {
    var i : int
    var numsurfaces : int
    var psurf : msurface_s?
    var dot : float
    var pplane : mplane_s?
    psurf = addr(pmodel.surfaces[pmodel.firstmodelsurface])
    numsurfaces = pmodel.nummodelsurfaces
    i = 0
    while (i < numsurfaces) {
        // find which side of the node we are on
        pplane = psurf.plane
        dot = modelorg[0] * pplane.normal[0] + modelorg[1] * pplane.normal[1] + modelorg[2] * pplane.normal[2] - pplane.dist
        // draw the polygon
        if (((psurf.flags & SURF_PLANEBACK) != 0 && (double(dot) < -BACKFACE_EPSILON)) ||
                ((psurf.flags & SURF_PLANEBACK) == 0 && (double(dot) > BACKFACE_EPSILON))) {
            // FIXME: use bounding-box-based frustum clipping info?
            R_RenderPoly(psurf, 15)
        }
        i++
        psurf++
    }
}

