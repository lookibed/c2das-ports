// generated by c2das - regenerate, never edit
enum solidstate_t {
    touchessolid
    drawnode
    nodrawnode
}

var currententity : entity_s?
var modelorg : float[3]
var base_modelorg : float[3]
var r_entorigin : float[3]
var insubmodel : qboolean
var r_worldmodelorg : float[3]
var entity_rotation : float[3][3]
var r_currentbkey : int
var private pbverts : mvertex_t?
var private pbedges : bedge_s?
var private numbverts : int
var private numbedges : int
var private pfrontenter : mvertex_t?
var private pfrontexit : mvertex_t?
var private makeclippededge : qboolean

// ================
// R_EntityRotate
// ================
[c_function]
def R_EntityRotate(var vec : float?) {
    var tvec : float[3]
    VectorCopy(vec, tvec)
    vec[0] = entity_rotation[0][0] * tvec[0] + entity_rotation[0][1] * tvec[1] + entity_rotation[0][2] * tvec[2]
    vec[1] = entity_rotation[1][0] * tvec[0] + entity_rotation[1][1] * tvec[1] + entity_rotation[1][2] * tvec[2]
    vec[2] = entity_rotation[2][0] * tvec[0] + entity_rotation[2][1] * tvec[1] + entity_rotation[2][2] * tvec[2]
}

// ================
// R_RotateBmodel
// ================
[c_function]
def R_RotateBmodel {
    var angle : float
    var s : float
    var c : float
    var temp1 : float[3][3]
    var temp2 : float[3][3]
    var temp3 : float[3][3]
    // TODO: should use a look-up table
    // TODO: should really be stored with the entity instead of being reconstructed
    // TODO: could cache lazily, stored in the entity
    // TODO: share work with R_SetUpAliasTransform
    // yaw
    angle = currententity.angles[YAW]
    angle = float(double(angle) * 3.141592653589793lf * 2.0lf / 360.0lf)
    s = float(math::sin(double(angle)))
    c = float(math::cos(double(angle)))
    temp1[0][0] = c
    temp1[0][1] = s
    temp1[0][2] = 0.0f
    temp1[1][0] = -s
    temp1[1][1] = c
    temp1[1][2] = 0.0f
    temp1[2][0] = 0.0f
    temp1[2][1] = 0.0f
    temp1[2][2] = 1.0f
    // pitch
    angle = currententity.angles[PITCH]
    angle = float(double(angle) * 3.141592653589793lf * 2.0lf / 360.0lf)
    s = float(math::sin(double(angle)))
    c = float(math::cos(double(angle)))
    temp2[0][0] = c
    temp2[0][1] = 0.0f
    temp2[0][2] = -s
    temp2[1][0] = 0.0f
    temp2[1][1] = 1.0f
    temp2[1][2] = 0.0f
    temp2[2][0] = s
    temp2[2][1] = 0.0f
    temp2[2][2] = c
    R_ConcatRotations(addr(temp2[0]), addr(temp1[0]), addr(temp3[0]))
    // roll
    angle = currententity.angles[ROLL]
    angle = float(double(angle) * 3.141592653589793lf * 2.0lf / 360.0lf)
    s = float(math::sin(double(angle)))
    c = float(math::cos(double(angle)))
    temp1[0][0] = 1.0f
    temp1[0][1] = 0.0f
    temp1[0][2] = 0.0f
    temp1[1][0] = 0.0f
    temp1[1][1] = c
    temp1[1][2] = s
    temp1[2][0] = 0.0f
    temp1[2][1] = -s
    temp1[2][2] = c
    R_ConcatRotations(addr(temp1[0]), addr(temp3[0]), addr(entity_rotation[0]))
    // rotate modelorg and the transformation matrix
    R_EntityRotate(addr(modelorg[0]))
    R_EntityRotate(addr(vpn[0]))
    R_EntityRotate(addr(vright[0]))
    R_EntityRotate(addr(vup[0]))
    R_TransformFrustum()
}

// ================
// R_RecursiveClipBPoly
// ================
[c_function]
def R_RecursiveClipBPoly(var pedges : bedge_s?; var pnode : mnode_s?; var psurf : msurface_s?) {
    var psideedges : bedge_s? [2]
    var pnextedge : bedge_s?
    var ptedge : bedge_s?
    var side : int
    var lastside : int
    var dist : float
    var frac : float
    var lastdist : float
    var splitplane : mplane_s?
    var tplane : mplane_s
    var pvert : mvertex_t?
    var plastvert : mvertex_t?
    var ptvert : mvertex_t?
    var pn : mnode_s?
    psideedges[1] = null
    psideedges[0] = psideedges[1]
    makeclippededge = qboolean._c_false
    // transform the BSP plane into model space
    // FIXME: cache these?
    splitplane = pnode.plane
    tplane.dist = splitplane.dist - (r_entorigin[0] * splitplane.normal[0] + r_entorigin[1] * splitplane.normal[1] + r_entorigin[2] * splitplane.normal[2])
    tplane.normal[0] = entity_rotation[0][0] * splitplane.normal[0] + entity_rotation[0][1] * splitplane.normal[1] + entity_rotation[0][2] * splitplane.normal[2]
    tplane.normal[1] = entity_rotation[1][0] * splitplane.normal[0] + entity_rotation[1][1] * splitplane.normal[1] + entity_rotation[1][2] * splitplane.normal[2]
    tplane.normal[2] = entity_rotation[2][0] * splitplane.normal[0] + entity_rotation[2][1] * splitplane.normal[1] + entity_rotation[2][2] * splitplane.normal[2]
    // clip edges to BSP plane
    while (pedges != null) {
        pnextedge = pedges.pnext
        // set the status for the last point as the previous point
        // FIXME: cache this stuff somehow?
        plastvert = pedges.v[0]
        lastdist = plastvert.position[0] * tplane.normal[0] + plastvert.position[1] * tplane.normal[1] + plastvert.position[2] * tplane.normal[2] - tplane.dist
        if (lastdist > 0.0f) {
            lastside = 0
        } else {
            lastside = 1
        }
        pvert = pedges.v[1]
        dist = pvert.position[0] * tplane.normal[0] + pvert.position[1] * tplane.normal[1] + pvert.position[2] * tplane.normal[2] - tplane.dist
        if (dist > 0.0f) {
            side = 0
        } else {
            side = 1
        }
        if (side != lastside) {
            // clipped
            if (numbverts >= MAX_BMODEL_VERTS) {
                return
            }
            // generate the clipped vertex
            frac = lastdist / (lastdist - dist)
            let _t0 = numbverts
            numbverts++
            ptvert = addr(pbverts[_t0])
            ptvert.position[0] = plastvert.position[0] + frac * (pvert.position[0] - plastvert.position[0])
            ptvert.position[1] = plastvert.position[1] + frac * (pvert.position[1] - plastvert.position[1])
            ptvert.position[2] = plastvert.position[2] + frac * (pvert.position[2] - plastvert.position[2])
            // split into two edges, one on each side, and remember entering
            // and exiting points
            // FIXME: share the clip edge by having a winding direction flag?
            if (numbedges >= (MAX_BMODEL_EDGES - 1)) {
                Con_Printf`va(cstr("Out of edges for bmodel\n"), VaNone())
                return
            }
            ptedge = addr(pbedges[numbedges])
            ptedge.pnext = psideedges[lastside]
            psideedges[lastside] = ptedge
            ptedge.v[0] = plastvert
            ptedge.v[1] = ptvert
            ptedge = addr(pbedges[numbedges + 1])
            ptedge.pnext = psideedges[side]
            psideedges[side] = ptedge
            ptedge.v[0] = ptvert
            ptedge.v[1] = pvert
            numbedges += 2
            if (side == 0) {
                // entering for front, exiting for back
                pfrontenter = ptvert
                makeclippededge = qboolean._c_true
            } else {
                pfrontexit = ptvert
                makeclippededge = qboolean._c_true
            }
        } else {
            // add the edge to the appropriate side
            pedges.pnext = psideedges[side]
            psideedges[side] = pedges
        }
        pedges = pnextedge
    }
    // if anything was clipped, reconstitute and add the edges along the clip
    // plane to both sides (but in opposite directions)
    if (int(makeclippededge) != 0) {
        if (numbedges >= (MAX_BMODEL_EDGES - 2)) {
            Con_Printf`va(cstr("Out of edges for bmodel\n"), VaNone())
            return
        }
        ptedge = addr(pbedges[numbedges])
        ptedge.pnext = psideedges[0]
        psideedges[0] = ptedge
        ptedge.v[0] = pfrontexit
        ptedge.v[1] = pfrontenter
        ptedge = addr(pbedges[numbedges + 1])
        ptedge.pnext = psideedges[1]
        psideedges[1] = ptedge
        ptedge.v[0] = pfrontenter
        ptedge.v[1] = pfrontexit
        numbedges += 2
    }
    // draw or recurse further
    for (i in range(2)) {
        if (psideedges[i] != null) {
            // draw if we've reached a non-solid leaf, done if all that's left is a
            // solid leaf, and continue down the tree if it's not a leaf
            pn = pnode.children[i]
            // we're done with this branch if the node or leaf isn't in the PVS
            if (pn.visframe == r_visframecount) {
                if (pn.contents < 0) {
                    if (pn.contents != CONTENTS_SOLID) {
                        r_currentbkey = reinterpret<mleaf_s?>(pn).key
                        R_RenderBmodelFace(psideedges[i], psurf)
                    }
                } else {
                    R_RecursiveClipBPoly(psideedges[i], pnode.children[i], psurf)
                }
            }
        }
    }
}

// ================
// R_DrawSolidClippedSubmodelPolygons
// ================
[c_function]
def R_DrawSolidClippedSubmodelPolygons(var pmodel : model_s?) {
    var i : int
    var j : int
    var lindex : int
    var dot : float
    var psurf : msurface_s?
    var numsurfaces : int
    var pplane : mplane_s?
    var bverts : mvertex_t[500]
    var bedges : bedge_s[1000]
    var pbedge : bedge_s?
    var pedge : medge_t?
    var pedges : medge_t?
    // FIXME: use bounding-box-based frustum clipping info?
    psurf = addr(pmodel.surfaces[pmodel.firstmodelsurface])
    numsurfaces = pmodel.nummodelsurfaces
    pedges = pmodel.edges
    i = 0
    while (i < numsurfaces) {
        // find which side of the node we are on
        pplane = psurf.plane
        dot = modelorg[0] * pplane.normal[0] + modelorg[1] * pplane.normal[1] + modelorg[2] * pplane.normal[2] - pplane.dist
        // draw the polygon
        if (((psurf.flags & SURF_PLANEBACK) != 0 && (double(dot) < -BACKFACE_EPSILON)) ||
                ((psurf.flags & SURF_PLANEBACK) == 0 && (double(dot) > BACKFACE_EPSILON))) {
            // FIXME: use bounding-box-based frustum clipping info?
            // copy the edges to bedges, flipping if necessary so always
            // clockwise winding
            // FIXME: if edges and vertices get caches, these assignments must move
            // outside the loop, and overflow checking must be done here
            pbverts = addr(bverts[0])
            pbedges = addr(bedges[0])
            numbedges = 0
            numbverts = numbedges
            if (psurf.numedges > 0) {
                pbedge = addr(bedges[0]) + end_index(numbedges, 1000)
                numbedges += psurf.numedges
                j = 0
                while (j < psurf.numedges) {
                    lindex = pmodel.surfedges[psurf.firstedge + j]
                    if (lindex > 0) {
                        pedge = addr(pedges[lindex])
                        pbedge[j].v[0] = addr(r_pcurrentvertbase[int(pedge.v[0])])
                        pbedge[j].v[1] = addr(r_pcurrentvertbase[int(pedge.v[1])])
                    } else {
                        lindex = -lindex
                        pedge = addr(pedges[lindex])
                        pbedge[j].v[0] = addr(r_pcurrentvertbase[int(pedge.v[1])])
                        pbedge[j].v[1] = addr(r_pcurrentvertbase[int(pedge.v[0])])
                    }
                    pbedge[j].pnext = addr(pbedge[j + 1])
                    j++
                }
                // mark end of edges
                pbedge[j - 1].pnext = null
                R_RecursiveClipBPoly(pbedge, currententity.topnode, psurf)
            } else {
                Sys_Error`va(cstr("no edges in bmodel"), VaNone())
            }
        }
        i++
        psurf++
    }
}

// ================
// R_DrawSubmodelPolygons
// ================
[c_function]
def R_DrawSubmodelPolygons(var pmodel : model_s?; clipflags : int) {
    var i : int
    var dot : float
    var psurf : msurface_s?
    var numsurfaces : int
    var pplane : mplane_s?
    // FIXME: use bounding-box-based frustum clipping info?
    psurf = addr(pmodel.surfaces[pmodel.firstmodelsurface])
    numsurfaces = pmodel.nummodelsurfaces
    i = 0
    while (i < numsurfaces) {
        // find which side of the node we are on
        pplane = psurf.plane
        dot = modelorg[0] * pplane.normal[0] + modelorg[1] * pplane.normal[1] + modelorg[2] * pplane.normal[2] - pplane.dist
        // draw the polygon
        if (((psurf.flags & SURF_PLANEBACK) != 0 && (double(dot) < -BACKFACE_EPSILON)) ||
                ((psurf.flags & SURF_PLANEBACK) == 0 && (double(dot) > BACKFACE_EPSILON))) {
            r_currentkey = reinterpret<mleaf_s?>(currententity.topnode).key
            // FIXME: use bounding-box-based frustum clipping info?
            R_RenderFace(psurf, clipflags)
        }
        i++
        psurf++
    }
}

// ================
// R_RecursiveWorldNode
// ================
[c_function]
def R_RecursiveWorldNode(var node : mnode_s?; var clipflags : int) {
    var c : int
    var side : int
    var pindex : int?
    var acceptpt : float[3]
    var rejectpt : float[3]
    var plane : mplane_s?
    var surf : msurface_s?
    var mark : msurface_s ??
    var pleaf : mleaf_s?
    var d : double
    var dot : double
    if (node.contents == CONTENTS_SOLID) {
        // solid
        return
    }
    if (node.visframe != r_visframecount) {
        return
    }
    // cull the clipping planes if not trivial accept
    // FIXME: the compiler is doing a lousy job of optimizing here; it could be
    // twice as fast in ASM
    if (clipflags != 0) {
        for (i in range(4)) {
            if ((clipflags & (1 << i)) == 0) {
                // don't need to clip against it
                continue
            }
            // generate accept and reject points
            // FIXME: do with fast look-ups or integer tests based on the sign bit
            // of the floating point values
            pindex = pfrustum_indexes[i]
            rejectpt[0] = float(node.minmaxs[pindex[0]])
            rejectpt[1] = float(node.minmaxs[pindex[1]])
            rejectpt[2] = float(node.minmaxs[pindex[2]])
            d = double(rejectpt[0] * view_clipplanes[i].normal[0] + rejectpt[1] * view_clipplanes[i].normal[1] + rejectpt[2] * view_clipplanes[i].normal[2])
            d -= double(view_clipplanes[i].dist)
            if (d <= 0.0lf) {
                return
            }
            acceptpt[0] = float(node.minmaxs[pindex[3 + 0]])
            acceptpt[1] = float(node.minmaxs[pindex[3 + 1]])
            acceptpt[2] = float(node.minmaxs[pindex[3 + 2]])
            d = double(acceptpt[0] * view_clipplanes[i].normal[0] + acceptpt[1] * view_clipplanes[i].normal[1] + acceptpt[2] * view_clipplanes[i].normal[2])
            d -= double(view_clipplanes[i].dist)
            if (d >= 0.0lf) {
                // node is entirely on screen
                clipflags &= ~(1 << i)
            }
        }
    }
    // if a leaf node, draw stuff
    if (node.contents < 0) {
        pleaf = reinterpret<mleaf_s?>(node)
        mark = pleaf.firstmarksurface
        c = pleaf.nummarksurfaces
        if (c != 0) {
            while (true) {
                (*mark).visframe = r_framecount
                mark++
                c--
                if (c == 0) {
                    break
                }
            }
        }
        // deal with model fragments in this leaf
        if (pleaf.efrags != null) {
            R_StoreEfrags(addr(pleaf.efrags))
        }
        pleaf.key = r_currentkey
        // all bmodels in a leaf share the same key
        r_currentkey++
    } else {
        // node is just a decision point, so go down the apropriate sides
        // find which side of the node we are on
        plane = node.plane
        c_switch(int(plane._c_type)) {
            case(0) {
                dot = double(modelorg[0] - plane.dist)
                break
            }
            case(1) {
                dot = double(modelorg[1] - plane.dist)
                break
            }
            case(2) {
                dot = double(modelorg[2] - plane.dist)
                break
            }
            case(_) {
                dot = double(modelorg[0] * plane.normal[0] + modelorg[1] * plane.normal[1] + modelorg[2] * plane.normal[2] - plane.dist)
                break
            }
        }
        if (dot >= 0.0lf) {
            side = 0
        } else {
            side = 1
        }
        // recurse down the children, front side first
        R_RecursiveWorldNode(node.children[side], clipflags)
        // draw stuff
        c = int(node.numsurfaces)
        if (c != 0) {
            surf = cl.worldmodel.surfaces + int(node.firstsurface)
            if (dot < -BACKFACE_EPSILON) {
                while (true) {
                    if ((surf.flags & SURF_PLANEBACK) != 0 && (surf.visframe == r_framecount)) {
                        if (int(r_drawpolys) != 0) {
                            if (int(r_worldpolysbacktofront) != 0) {
                                if (numbtofpolys < MAX_BTOFPOLYS) {
                                    pbtofpolys[numbtofpolys].clipflags = clipflags
                                    pbtofpolys[numbtofpolys].psurf = surf
                                    numbtofpolys++
                                }
                            } else {
                                R_RenderPoly(surf, clipflags)
                            }
                        } else {
                            R_RenderFace(surf, clipflags)
                        }
                    }
                    surf++
                    c--
                    if (c == 0) {
                        break
                    }
                }
            } elif (dot > BACKFACE_EPSILON) {
                while (true) {
                    if ((surf.flags & SURF_PLANEBACK) == 0 && (surf.visframe == r_framecount)) {
                        if (int(r_drawpolys) != 0) {
                            if (int(r_worldpolysbacktofront) != 0) {
                                if (numbtofpolys < MAX_BTOFPOLYS) {
                                    pbtofpolys[numbtofpolys].clipflags = clipflags
                                    pbtofpolys[numbtofpolys].psurf = surf
                                    numbtofpolys++
                                }
                            } else {
                                R_RenderPoly(surf, clipflags)
                            }
                        } else {
                            R_RenderFace(surf, clipflags)
                        }
                    }
                    surf++
                    c--
                    if (c == 0) {
                        break
                    }
                }
            }
            // all surfaces on the same node share the same sequence number
            r_currentkey++
        }
        // recurse down the back side
        R_RecursiveWorldNode(node.children[int_of(side == 0)], clipflags)
    }
}

// ================
// R_RenderWorld
// ================
[c_function]
def R_RenderWorld {
    var i : int
    var clmodel : model_s?
    var btofpolys : btofpoly_s[5000]
    pbtofpolys = addr(btofpolys[0])
    currententity = addr(cl_entities[0])
    modelorg[0] = r_origin[0]
    modelorg[1] = r_origin[1]
    modelorg[2] = r_origin[2]
    clmodel = currententity.model
    r_pcurrentvertbase = clmodel.vertexes
    R_RecursiveWorldNode(clmodel.nodes, 15)
    // if the driver wants the polygons back to front, play the visible ones back
    // in that order
    if (int(r_worldpolysbacktofront) != 0) {
        i = numbtofpolys - 1
        while (i >= 0) {
            R_RenderPoly(btofpolys[i].psurf, btofpolys[i].clipflags)
            i--
        }
    }
}

