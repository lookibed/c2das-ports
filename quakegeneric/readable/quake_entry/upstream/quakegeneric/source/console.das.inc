// ================
// Con_CheckResize
// If the line width has changed, reformat the buffer.
// ================
[c_function]
def Con_CheckResize {
    var width : int
    var oldwidth : int
    var oldtotallines : int
    var numlines : int
    var numchars : int
    var tbuf : uint8[16384]
    width = int((vid.width >> 3u) - 2u)
    if (width == con_linewidth) {
        return
    }
    // video hasn't been initialized yet
    if (width < 1) {
        width = 38
        con_linewidth = width
        con_totallines = CON_TEXTSIZE / con_linewidth
        Q_memset(reinterpret<void?>(con_text), ' ', CON_TEXTSIZE)
    } else {
        oldwidth = con_linewidth
        con_linewidth = width
        oldtotallines = con_totallines
        con_totallines = CON_TEXTSIZE / con_linewidth
        numlines = oldtotallines
        if (con_totallines < numlines) {
            numlines = con_totallines
        }
        numchars = oldwidth
        if (con_linewidth < numchars) {
            numchars = con_linewidth
        }
        Q_memcpy(reinterpret<void?>(addr(tbuf[0])), reinterpret<void?>(con_text), CON_TEXTSIZE)
        Q_memset(reinterpret<void?>(con_text), ' ', CON_TEXTSIZE)
        for (i in range(numlines)) {
            for (j in range(numchars)) {
                con_text[(con_totallines - 1 - i) * con_linewidth + j] = tbuf[((con_current - i + oldtotallines) % oldtotallines) * oldwidth + j]
            }
        }
        Con_ClearNotify()
    }
    con_backscroll = 0
    con_current = con_totallines - 1
}

// ================
// Con_Init
// ================
[c_function]
def Con_Init {
    var temp : uint8[1001]
    var t2 : uint8? = cstr("/qconsole.log")
    con_debuglog = enum_from_int(type<qboolean>, COM_CheckParm(cstr("-condebug")))
    if (int(con_debuglog) != 0) {
        if (crt::strlen(addr(com_gamedir[0])) < (uint64(MAXGAMEDIRLEN) - crt::strlen(t2))) {
            sprintf(addr(temp[0]), cstr("%s%s"), addr(com_gamedir[0]), t2)
            crt::remove(addr(temp[0]))
        }
    }
    con_text = reinterpret<uint8?>(Hunk_AllocName(CON_TEXTSIZE, cstr("context")))
    Q_memset(reinterpret<void?>(con_text), ' ', CON_TEXTSIZE)
    con_linewidth = -1
    Con_CheckResize()
    Con_Printf`va(cstr("Console initialized.\n"), VaNone())
    // register our commands
    Cvar_RegisterVariable(addr(con_notifytime))
    Cmd_AddCommand(cstr("toggleconsole"), @@Con_ToggleConsole_f)
    Cmd_AddCommand(cstr("messagemode"), @@Con_MessageMode_f)
    Cmd_AddCommand(cstr("messagemode2"), @@Con_MessageMode2_f)
    Cmd_AddCommand(cstr("clear"), @@Con_Clear_f)
    con_initialized = qboolean._c_true
}

// ===============
// Con_Linefeed
// ===============
[c_function]
def Con_Linefeed {
    con_x = 0
    con_current++
    Q_memset(reinterpret<void?>(addr(con_text[(con_current % con_totallines) * con_linewidth])), ' ', con_linewidth)
}

// ================
// Con_Print
// Handles cursor positioning, line wrapping, etc
// All console printing must go through this in order to be logged to disk
// If no console is visible, the notify window will pop up.
// ================
[c_function]
def Con_Print(var txt : uint8?) {
    var y : int
    var c : int
    var l : int
    var mask : int
    con_backscroll = 0
    if (txt[0] == 1) {
        // go to colored text
        mask = 128
        S_LocalSound(cstr("misc/talk.wav"))
        // play talk wav
        txt++
    } elif (txt[0] == 2) {
        // go to colored text
        mask = 128
        txt++
    } else {
        mask = 0
    }
    while (true) {
        c = int(*txt)
        if (c == 0) {
            break
        }
        // count word length
        l = 0
        while (l < con_linewidth) {
            if (int(txt[l]) <= ' ') {
                break
            }
            l++
        }
        // word wrap
        if (l != con_linewidth && (con_x + l > con_linewidth)) {
            con_x = 0
        }
        txt++
        if (Con_Print_cr != 0) {
            con_current--
            Con_Print_cr = int(qboolean._c_false)
        }
        if (con_x == 0) {
            Con_Linefeed()
            // mark time for transparent overlay
            if (con_current >= 0) {
                con_times[con_current % NUM_CON_TIMES] = float(realtime)
            }
        }
        c_switch(c) {
            case('\n') {
                con_x = 0
                break
            }
            case('\r') {
                con_x = 0
                Con_Print_cr = 1
                break
            }
            case(_) {
                // display character and advance
                y = con_current % con_totallines
                con_text[y * con_linewidth + con_x] = uint8(c | mask)
                con_x++
                if (con_x >= con_linewidth) {
                    con_x = 0
                }
                break
            }
        }
    }
}

// ================
// Con_DebugLog
// ================
[c_function, variadic]
def Con_DebugLog(var file : uint8?; var fmt : uint8?; va : va_args) {
    var argptr : CVaCursor
    var fd : _IO_FILE?
    argptr = va_begin(va)
    c_vsprintf(addr(Con_DebugLog_data[0]), fmt, va_rest(argptr))
    fd = reinterpret<_IO_FILE?>(crt::fopen(file, cstr("wa")))
    crt::fwrite(reinterpret<void?>(addr(Con_DebugLog_data[0])), crt::strlen(addr(Con_DebugLog_data[0])), 1ul, reinterpret<void?>(fd))
    crt::fclose(reinterpret<void?>(fd))
}

// FIXME: make a buffer size safe vsprintf?
[c_function, variadic]
def Con_Printf(var fmt : uint8?; va1 : va_args) {
    var argptr : CVaCursor
    var msg : uint8[4096]
    argptr = va_begin(va1)
    c_vsprintf(addr(msg[0]), fmt, va_rest(argptr))
    // also echo to debugging console
    // also echo to debugging console
    Sys_Printf`va(cstr("%s"), (addr(msg[0]),))
    // log all messages to file
    if (int(con_debuglog) != 0) {
        Con_DebugLog`va(va`va(cstr("%s/qconsole.log"), (addr(com_gamedir[0]),)), cstr("%s"), (addr(msg[0]),))
    }
    if (int(con_initialized) == 0) {
        return
    }
    if (cls.state == cactive_t.ca_dedicated) {
        // no graphics mode
        return
    }
    // write it to the scrollable buffer
    Con_Print(addr(msg[0]))
    // update the screen if the console is displayed
    if (cls.signon != SIGNONS && int(scr_disabled_for_loading) == 0) {
        // protect against infinite loop if something in SCR_UpdateScreen calls
        // Con_Printd
        if (int(Con_Printf_inupdate) == 0) {
            Con_Printf_inupdate = qboolean._c_true
            SCR_UpdateScreen()
            Con_Printf_inupdate = qboolean._c_false
        }
    }
}

def Con_Printf__va_list(var a0 : uint8?; a1 : CVaList) {
    Con_Printf`va(a0, a1)
}

// ================
// Con_DPrintf
// A Con_Printf that only shows up if the "developer" cvar is set
// ================
[c_function, variadic]
def Con_DPrintf(var fmt : uint8?; va : va_args) {
    var argptr : CVaCursor
    var msg : uint8[4096]
    if (developer.value == 0.0f) {
        // don't confuse non-developers with techie stuff...
        return
    }
    argptr = va_begin(va)
    c_vsprintf(addr(msg[0]), fmt, va_rest(argptr))
    Con_Printf`va(cstr("%s"), (addr(msg[0]),))
}

// ==================
// Con_SafePrintf
// Okay to call even when the screen can't be updated
// ==================
[c_function, variadic]
def Con_SafePrintf(var fmt : uint8?; va : va_args) {
    var argptr : CVaCursor
    var msg : uint8[1024]
    var temp : int
    argptr = va_begin(va)
    c_vsprintf(addr(msg[0]), fmt, va_rest(argptr))
    temp = int(scr_disabled_for_loading)
    scr_disabled_for_loading = qboolean._c_true
    Con_Printf`va(cstr("%s"), (addr(msg[0]),))
    scr_disabled_for_loading = enum_from_int(type<qboolean>, temp)
}

// ================
// Con_DrawInput
// The input line scrolls horizontally if typing goes beyond the right edge
// ================
[c_function]
def Con_DrawInput {
    var y : int
    var text : uint8?
    if (key_dest != keydest_t.key_console && int(con_forcedup) == 0) {
        // don't draw anything
        return
    }
    text = addr(key_lines[edit_line][0])
    // add the cursor frame
    text[key_linepos] = uint8(10 + (int(realtime * double(con_cursorspeed)) & 1))
    // fill out remainder with spaces
    for (i in range(key_linepos + 1, con_linewidth)) {
        text[i] = uint8(' ')
    }
    // prestep if horizontally scrolling
    if (key_linepos >= con_linewidth) {
        text += 1 + key_linepos - con_linewidth
    }
    // draw it
    y = con_vislines - 16
    for (i in range(con_linewidth)) {
        Draw_Character((i + 1) << 3, con_vislines - 16, int(text[i]))
    }
    // remove cursor
    key_lines[edit_line][key_linepos] = 0u8
}

// ================
// Con_DrawNotify
// Draws the last few lines of output transparently over the game top
// ================
[c_function]
def Con_DrawNotify {
    var x : int
    var v : int
    var text : uint8?
    var i : int
    var time : float
    v = 0
    i = con_current - NUM_CON_TIMES + 1
    while (i <= con_current) {
        {
            if (i < 0) {
                continue
            }
            time = con_times[i % NUM_CON_TIMES]
            if (time == 0.0f) {
                continue
            }
            time = float(realtime - double(time))
            if (time > con_notifytime.value) {
                continue
            }
            text = con_text + (i % con_totallines) * con_linewidth
            clearnotify = 0
            scr_copytop = 1
            x = 0
            while (x < con_linewidth) {
                Draw_Character((x + 1) << 3, v, int(text[x]))
                x++
            }
            v += 8
        } finally {
            i++
        }
    }
    if (key_dest == keydest_t.key_message) {
        clearnotify = 0
        scr_copytop = 1
        x = 0
        Draw_String(8, v, cstr("say:"))
        while (chat_buffer[x] != 0) {
            Draw_Character((x + 5) << 3, v, int(chat_buffer[x]))
            x++
        }
        Draw_Character((x + 5) << 3, v, 10 + (int(realtime * double(con_cursorspeed)) & 1))
        v += 8
    }
    if (v > con_notifylines) {
        con_notifylines = v
    }
}

// ================
// Con_DrawConsole
// Draws the console with the solid background
// The typing input line at the bottom should only be drawn if typing is allowed
// ================
[c_function]
def Con_DrawConsole(lines : int; drawinput : qboolean) {
    var i : int
    var y : int
    var rows : int
    var text : uint8?
    var j : int
    if (lines <= 0) {
        return
    }
    // draw the background
    Draw_ConsoleBackground(lines)
    // draw the text
    con_vislines = lines
    // rows of text to draw
    rows = (lines - 16) >> 3
    // may start slightly negative
    y = lines - 16 - (rows << 3)
    i = con_current - rows + 1
    while (i <= con_current) {
        j = i - con_backscroll
        if (j < 0) {
            j = 0
        }
        text = con_text + (j % con_totallines) * con_linewidth
        for (x in range(con_linewidth)) {
            Draw_Character((x + 1) << 3, y, int(text[x]))
        }
        i++
        y += 8
    }
    // draw the input prompt, user text, and cursor if desired
    if (int(drawinput) != 0) {
        Con_DrawInput()
    }
}

// ==================
// Con_NotifyBox
// ==================
def Con_NotifyBox(var text : uint8?) {
    var t1 : double
    var t2 : double
    // during startup for sound / cd warnings
    Con_Printf`va(cstr("\n\n\x1d\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1f\n"),
            VaNone())
    Con_Printf`va(text, VaNone())
    Con_Printf`va(cstr("Press a key.\n"), VaNone())
    Con_Printf`va(cstr("\x1d\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1e\x1f\n"),
            VaNone())
    // wait for a key down and up
    key_count = -2
    key_dest = keydest_t.key_console
    c_do_while(key_count < 0) {
        t1 = Sys_FloatTime()
        SCR_UpdateScreen()
        Sys_SendKeyEvents()
        t2 = Sys_FloatTime()
        // make the cursor blink
        realtime += t2 - t1
    }
    Con_Printf`va(cstr("\n"), VaNone())
    key_dest = keydest_t.key_game
    // put the cursor back to invisible
    realtime = 0.0lf
}

