// ================
// Con_ToggleConsole_f
// ================
[c_function]
def Con_ToggleConsole_f {
    if (key_dest == keydest_t.key_console) {
        if (cls.state == cactive_t.ca_connected) {
            key_dest = keydest_t.key_game
            // clear any typing
            key_lines[edit_line][1] = 0u8
            key_linepos = 1
        } else {
            M_Menu_Main_f()
        }
    } else {
        key_dest = keydest_t.key_console
    }
    SCR_EndLoadingPlaque()
    crt::memset(reinterpret<void?>(addr(con_times[0])), 0, uint64(typeinfo sizeof(type<float[4]>)))
}

// ================
// Con_Clear_f
// ================
[c_function]
def Con_Clear_f {
    if (con_text != null) {
        Q_memset(reinterpret<void?>(con_text), ' ', CON_TEXTSIZE)
    }
}

// ================
// Con_ClearNotify
// ================
def Con_ClearNotify {
    for (i in range(NUM_CON_TIMES)) {
        con_times[i] = 0.0f
    }
}

