    SZ_Clear(addr(sv.datagram))
}

[c_function]
def SV_AddToFatPVS(var org : float?; var node : mnode_s?) {
    var pvs : uint8?
    var plane : mplane_s?
    var d : float
    while (1 != 0) {
        // if this is a leaf, accumulate the pvs bits
        if (node.contents < 0) {
            if (node.contents != CONTENTS_SOLID) {
                pvs = Mod_LeafPVS(reinterpret<mleaf_s?>(node), sv.worldmodel)
                for (i in range(fatbytes)) {
                    fatpvs[i] = uint8(int(fatpvs[i]) | int(pvs[i]))
                }
            }
            return
        }
        plane = node.plane
        d = org[0] * plane.normal[0] + org[1] * plane.normal[1] + org[2] * plane.normal[2] - plane.dist
        if (d > 8.0f) {
            node = node.children[0]
        } elif (d < -8.0f) {
            node = node.children[1]
        } else {
            // go down both
            SV_AddToFatPVS(org, node.children[0])
            node = node.children[1]
        }
    }
}

// =============
// SV_FatPVS
// Calculates a PVS that is the inclusive or of all leafs within 8 pixels of the
// given point.
// =============
[c_function]
def SV_FatPVS(var org : float?) : uint8? {
    fatbytes = (sv.worldmodel.numleafs + 31) >> 3
    Q_memset(reinterpret<void?>(addr(fatpvs[0])), 0, fatbytes)
    SV_AddToFatPVS(org, sv.worldmodel.nodes)
    return addr(fatpvs[0])
}

// =============
// SV_WriteEntitiesToClient
// =============
[c_function]
def SV_WriteEntitiesToClient(var clent : edict_s?; var msg : sizebuf_s?) {
    var e : int
    var i : int
    var bits : int
    var pvs : uint8?
    var org : float[3]
    var miss : float
    var ent : edict_s?
    // find the client's PVS
    org[0] = clent.v.origin[0] + clent.v.view_ofs[0]
    org[1] = clent.v.origin[1] + clent.v.view_ofs[1]
    org[2] = clent.v.origin[2] + clent.v.view_ofs[2]
    pvs = SV_FatPVS(addr(org[0]))
    // send over all entities (excpet the client) that touch the pvs
    ent = NEXT_EDICT(sv.edicts)
    {
        e = 1
        var _f = false
        while (true) {
            if (_f) {
                e++
                ent = NEXT_EDICT(ent)
            }
            _f = true
            if (!(e < sv.num_edicts)) {
                break
            }
            // ignore if not touching a PV leaf
            // clent is ALLWAYS sent
            if (intptr(ent) != intptr(clent)) {
                // ignore ents without visible models
                if (ent.v.modelindex == 0.0f || pr_strings[ent.v.model] == 0) {
                    continue
                }
                i = 0
                while (i < ent.num_leafs) {
                    if ((int(pvs[int(ent.leafnums[i]) >> 3]) & (1 << (int(ent.leafnums[i]) & 7))) != 0) {
                        break
                    }
                    i++
                }
                if (i == ent.num_leafs) {
                    // not visible
                    continue
                }
            }
            if (msg.maxsize - msg.cursize < 16) {
                Con_Printf`va(cstr("packet overflow\n"), VaNone())
                return
            }
            // send an update
            bits = 0
            i = 0
            while (i < 3) {
                miss = ent.v.origin[i] - ent.baseline.origin[i]
                if (double(miss) < -0.1lf || double(miss) > 0.1lf) {
                    bits |= U_ORIGIN1 << i
                }
                i++
            }
            if (ent.v.angles[0] != ent.baseline.angles[0]) {
                bits |= U_ANGLE1
            }
            if (ent.v.angles[1] != ent.baseline.angles[1]) {
                bits |= U_ANGLE2
            }
            if (ent.v.angles[2] != ent.baseline.angles[2]) {
                bits |= U_ANGLE3
            }
            if (ent.v.movetype == float(MOVETYPE_STEP)) {
                // don't mess up the step animation
                bits |= U_NOLERP
            }
            if (float(ent.baseline.colormap) != ent.v.colormap) {
                bits |= U_COLORMAP
            }
            if (float(ent.baseline.skin) != ent.v.skin) {
                bits |= U_SKIN
            }
            if (float(ent.baseline.frame) != ent.v.frame) {
                bits |= U_FRAME
            }
            if (float(ent.baseline.effects) != ent.v.effects) {
                bits |= U_EFFECTS
            }
            if (float(ent.baseline.modelindex) != ent.v.modelindex) {
                bits |= U_MODEL
            }
            if (e >= 256) {
                bits |= U_LONGENTITY
            }
            if (bits >= 256) {
                bits |= U_MOREBITS
            }
            // write the message
            MSG_WriteByte(msg, bits | U_SIGNAL)
            if ((bits & U_MOREBITS) != 0) {
                MSG_WriteByte(msg, bits >> 8)
            }
            if ((bits & U_LONGENTITY) != 0) {
                MSG_WriteShort(msg, e)
            } else {
                MSG_WriteByte(msg, e)
            }
            if ((bits & U_MODEL) != 0) {
                MSG_WriteByte(msg, int(ent.v.modelindex))
            }
            if ((bits & U_FRAME) != 0) {
                MSG_WriteByte(msg, int(ent.v.frame))
            }
            if ((bits & U_COLORMAP) != 0) {
                MSG_WriteByte(msg, int(ent.v.colormap))
            }
            if ((bits & U_SKIN) != 0) {
                MSG_WriteByte(msg, int(ent.v.skin))
            }
            if ((bits & U_EFFECTS) != 0) {
                MSG_WriteByte(msg, int(ent.v.effects))
            }
            if ((bits & U_ORIGIN1) != 0) {
                MSG_WriteCoord(msg, ent.v.origin[0])
            }
            if ((bits & U_ANGLE1) != 0) {
                MSG_WriteAngle(msg, ent.v.angles[0])
            }
            if ((bits & U_ORIGIN2) != 0) {
                MSG_WriteCoord(msg, ent.v.origin[1])
            }
            if ((bits & U_ANGLE2) != 0) {
                MSG_WriteAngle(msg, ent.v.angles[1])
            }
            if ((bits & U_ORIGIN3) != 0) {
                MSG_WriteCoord(msg, ent.v.origin[2])
            }
            if ((bits & U_ANGLE3) != 0) {
                MSG_WriteAngle(msg, ent.v.angles[2])
            }
        }
    }
}

// =============
// SV_CleanupEnts
// =============
def SV_CleanupEnts {
    var e : int
    var ent : edict_s?
    ent = NEXT_EDICT(sv.edicts)
    e = 1
    while (e < sv.num_edicts) {
        ent.v.effects = float(int(ent.v.effects) & ~EF_MUZZLEFLASH)
        e++
        ent = NEXT_EDICT(ent)
    }
}

// ==================
// SV_WriteClientdataToMessage
// ==================
[c_function]
def SV_WriteClientdataToMessage(var ent : edict_s?; var msg : sizebuf_s?) {
    var bits : int
    var other : edict_s?
    var items : int
    var val : eval_s?
    // send a damage message
    if (ent.v.dmg_take != 0.0f || ent.v.dmg_save != 0.0f) {
        other = PROG_TO_EDICT(ent.v.dmg_inflictor)
        MSG_WriteByte(msg, svc_damage)
        MSG_WriteByte(msg, int(ent.v.dmg_save))
        MSG_WriteByte(msg, int(ent.v.dmg_take))
        for (i in range(3)) {
            MSG_WriteCoord(msg, float(double(other.v.origin[i]) + 0.5lf * double(other.v.mins[i] + other.v.maxs[i])))
        }
        ent.v.dmg_take = 0.0f
        ent.v.dmg_save = 0.0f
    }
    // send the current viewpos offset from the view entity
    // how much to look up / down ideally
    SV_SetIdealPitch()
    // a fixangle might get lost in a dropped packet. Oh well.
    if (ent.v.fixangle != 0.0f) {
        MSG_WriteByte(msg, svc_setangle)
        for (i in range(3)) {
            MSG_WriteAngle(msg, ent.v.angles[i])
        }
        ent.v.fixangle = 0.0f
    }
    bits = 0
    if (ent.v.view_ofs[2] != float(DEFAULT_VIEWHEIGHT)) {
        bits |= SU_VIEWHEIGHT
    }
    if (ent.v.idealpitch != 0.0f) {
        bits |= SU_IDEALPITCH
    }
    // stuff the sigil bits into the high bits of items for sbar, or else
    // mix in items2
    val = GetEdictFieldValue(ent, cstr("items2"))
    if (val != null) {
        items = int(ent.v.items) | (int(val._float) << 23)
    } else {
        items = int(ent.v.items) | (int(pr_global_struct.serverflags) << 28)
    }
    bits |= SU_ITEMS
    if ((int(ent.v.flags) & FL_ONGROUND) != 0) {
        bits |= SU_ONGROUND
    }
    if (ent.v.waterlevel >= 2.0f) {
        bits |= SU_INWATER
    }
    for (i in range(3)) {
        if (ent.v.punchangle[i] != 0.0f) {
            bits |= SU_PUNCH1 << i
        }
        if (ent.v.velocity[i] != 0.0f) {
            bits |= SU_VELOCITY1 << i
        }
    }
    if (ent.v.weaponframe != 0.0f) {
        bits |= SU_WEAPONFRAME
    }
    if (ent.v.armorvalue != 0.0f) {
        bits |= SU_ARMOR
    }
    // if (ent->v.weapon)
    bits |= SU_WEAPON
    // send the data
    MSG_WriteByte(msg, svc_clientdata)
    MSG_WriteShort(msg, bits)
    if ((bits & SU_VIEWHEIGHT) != 0) {
        MSG_WriteChar(msg, int(ent.v.view_ofs[2]))
    }
    if ((bits & SU_IDEALPITCH) != 0) {
        MSG_WriteChar(msg, int(ent.v.idealpitch))
    }
    for (i in range(3)) {
        if ((bits & (SU_PUNCH1 << i)) != 0) {
            MSG_WriteChar(msg, int(ent.v.punchangle[i]))
        }
        if ((bits & (SU_VELOCITY1 << i)) != 0) {
            MSG_WriteChar(msg, int(ent.v.velocity[i] / 16.0f))
        }
    }
    // [always sent] if (bits & SU_ITEMS)
    MSG_WriteLong(msg, items)
    if ((bits & SU_WEAPONFRAME) != 0) {
        MSG_WriteByte(msg, int(ent.v.weaponframe))
    }
    if ((bits & SU_ARMOR) != 0) {
        MSG_WriteByte(msg, int(ent.v.armorvalue))
    }
    if ((bits & SU_WEAPON) != 0) {
        MSG_WriteByte(msg, SV_ModelIndex(pr_strings + ent.v.weaponmodel))
    }
    MSG_WriteShort(msg, int(ent.v.health))
    MSG_WriteByte(msg, int(ent.v.currentammo))
    MSG_WriteByte(msg, int(ent.v.ammo_shells))
    MSG_WriteByte(msg, int(ent.v.ammo_nails))
    MSG_WriteByte(msg, int(ent.v.ammo_rockets))
    MSG_WriteByte(msg, int(ent.v.ammo_cells))
    if (int(standard_quake) != 0) {
        MSG_WriteByte(msg, int(ent.v.weapon))
    } else {
        for (i in range(32)) {
            if ((int(ent.v.weapon) & (1 << i)) != 0) {
                MSG_WriteByte(msg, i)
                break
            }
        }
    }
}

// =======================
// SV_SendClientDatagram
// =======================
[c_function]
def SV_SendClientDatagram(var client : client_s?) : qboolean {
    var buf : uint8[1024]
    var msg : sizebuf_s
    msg.data = addr(buf[0])
    msg.maxsize = typeinfo sizeof(type<uint8[1024]>)
    msg.cursize = 0
    MSG_WriteByte(addr(msg), svc_time)
    MSG_WriteFloat(addr(msg), float(sv.time))
    // add the client specific data to the datagram
    SV_WriteClientdataToMessage(client.edict, addr(msg))
    SV_WriteEntitiesToClient(client.edict, addr(msg))
    // copy the server datagram if there is space
    if (msg.cursize + sv.datagram.cursize < msg.maxsize) {
        SZ_Write(addr(msg), reinterpret<void?>(sv.datagram.data), sv.datagram.cursize)
    }
    // send the datagram
    if (NET_SendUnreliableMessage(client.netconnection, addr(msg)) == -1) {
        // if the message couldn't send, kick off
        SV_DropClient(qboolean._c_true)
        return qboolean._c_false
    }
    return qboolean._c_true
}

// =======================
// SV_UpdateToReliableMessages
// =======================
[c_function]
def SV_UpdateToReliableMessages {
    var i : int
    var j : int
    var client : client_s?
    // check for changes to be sent over the reliable streams
    i = 0
    host_client = svs.clients
    while (i < svs.maxclients) {
        if (float(host_client.old_frags) != host_client.edict.v.frags) {
            j = 0
            client = svs.clients
            while (j < svs.maxclients) {
                {
                    if (int(client.active) == 0) {
                        continue
                    }
                    MSG_WriteByte(addr(client.message), svc_updatefrags)
                    MSG_WriteByte(addr(client.message), i)
                    MSG_WriteShort(addr(client.message), int(host_client.edict.v.frags))
                } finally {
                    j++
                    client++
                }
            }
            host_client.old_frags = int(host_client.edict.v.frags)
        }
        i++
        host_client++
    }
    j = 0
    client = svs.clients
    while (j < svs.maxclients) {
        {
            if (int(client.active) == 0) {
                continue
            }
            SZ_Write(addr(client.message), reinterpret<void?>(sv.reliable_datagram.data), sv.reliable_datagram.cursize)
        } finally {
            j++
            client++
        }
    }
    SZ_Clear(addr(sv.reliable_datagram))
}

// =======================
// SV_SendNop
// Send a nop message without trashing or sending the accumulated client
// message buffer
// =======================
[c_function]
def SV_SendNop(var client : client_s?) {
    var msg : sizebuf_s
    var buf : uint8[4]
    msg.data = addr(buf[0])
    msg.maxsize = typeinfo sizeof(type<uint8[4]>)
    msg.cursize = 0
    MSG_WriteChar(addr(msg), svc_nop)
    if (NET_SendUnreliableMessage(client.netconnection, addr(msg)) == -1) {
        // if the message couldn't send, kick off
        SV_DropClient(qboolean._c_true)
    }
    client.last_message = realtime
}

// =======================
// SV_SendClientMessages
// =======================
[c_function]
def SV_SendClientMessages {
    var i : int
    // update frags, names, etc
    SV_UpdateToReliableMessages()
    // build individual updates
    i = 0
    host_client = svs.clients
    while (i < svs.maxclients) {
        {
            if (int(host_client.active) == 0) {
                continue
            }
            if (int(host_client.spawned) != 0) {
                if (int(SV_SendClientDatagram(host_client)) == 0) {
                    continue
                }
            } else {
                // the player isn't totally in the game yet
                // send small keepalive messages if too much time has passed
                // send a full message when the next signon stage has been requested
                // some other message data (name changes, etc) may accumulate
                // between signon stages
                if (int(host_client.sendsignon) == 0) {
                    if (realtime - host_client.last_message > 5.0lf) {
                        SV_SendNop(host_client)
                    }
                    // don't send out non-signon messages
                    continue
                }
            }
            // check for an overflowed message. Should only happen
            // on a very fucked up connection that backs up a lot, then
            // changes level
            if (int(host_client.message.overflowed) != 0) {
                SV_DropClient(qboolean._c_true)
                host_client.message.overflowed = qboolean._c_false
                continue
            }
            if (host_client.message.cursize != 0 || uint(host_client.dropasap) != 0) {
                if (int(NET_CanSendMessage(host_client.netconnection)) == 0) {
                    // I_Printf ("can't write\n");
                    continue
                }
                if (int(host_client.dropasap) != 0) {
                    // went to another level
                    SV_DropClient(qboolean._c_false)
                } else {
                    if (NET_SendMessage(host_client.netconnection, addr(host_client.message)) == -1) {
                        // if the message couldn't send, kick off
                        SV_DropClient(qboolean._c_true)
                    }
                    SZ_Clear(addr(host_client.message))
                    host_client.last_message = realtime
                    host_client.sendsignon = qboolean._c_false
                }
            }
        } finally {
            i++
            host_client++
        }
    }
    // clear muzzle flashes
    SV_CleanupEnts()
}

// ================
// SV_ModelIndex
// ================
[c_function]
def SV_ModelIndex(var name : uint8?) : int {
    var i : int
    if (name == null || name[0] == 0) {
        return 0
    }
    i = 0
    while (i < MAX_MODELS && sv.model_precache[i] != null) {
        if (crt::strcmp(sv.model_precache[i], name) == 0) {
            return i
        }
        i++
    }
    if (i == MAX_MODELS || sv.model_precache[i] == null) {
        Sys_Error`va(cstr("SV_ModelIndex: model %s not precached"), (name,))
    }
    return i
}

// ================
// SV_CreateBaseline
// ================
[c_function]
def SV_CreateBaseline {
    var i : int
    var svent : edict_s?
    var entnum : int
    entnum = 0
    while (entnum < sv.num_edicts) {
        {
            // get the current server version
            svent = EDICT_NUM(entnum)
            if (int(svent.free) != 0) {
                continue
            }
            if (entnum > svs.maxclients && svent.v.modelindex == 0.0f) {
                continue
            }
            // create entity baseline
            svent.baseline.origin[0] = svent.v.origin[0]
            svent.baseline.origin[1] = svent.v.origin[1]
            svent.baseline.origin[2] = svent.v.origin[2]
            svent.baseline.angles[0] = svent.v.angles[0]
            svent.baseline.angles[1] = svent.v.angles[1]
            svent.baseline.angles[2] = svent.v.angles[2]
            svent.baseline.frame = int(svent.v.frame)
            svent.baseline.skin = int(svent.v.skin)
            if (entnum > 0 && entnum <= svs.maxclients) {
                svent.baseline.colormap = entnum
                svent.baseline.modelindex = SV_ModelIndex(cstr("progs/player.mdl"))
            } else {
                svent.baseline.colormap = 0
                svent.baseline.modelindex = SV_ModelIndex(pr_strings + svent.v.model)
            }
            // add to the message
            MSG_WriteByte(addr(sv.signon), svc_spawnbaseline)
            MSG_WriteShort(addr(sv.signon), entnum)
            MSG_WriteByte(addr(sv.signon), svent.baseline.modelindex)
            MSG_WriteByte(addr(sv.signon), svent.baseline.frame)
            MSG_WriteByte(addr(sv.signon), svent.baseline.colormap)
            MSG_WriteByte(addr(sv.signon), svent.baseline.skin)
            i = 0
            while (i < 3) {
                MSG_WriteCoord(addr(sv.signon), svent.baseline.origin[i])
                MSG_WriteAngle(addr(sv.signon), svent.baseline.angles[i])
                i++
            }
        } finally {
            entnum++
        }
    }
}

// ================
// SV_SendReconnect
// Tell all the clients that the server is changing levels
// ================
[c_function]
def SV_SendReconnect {
    var data : uint8[128]
    var msg : sizebuf_s
    msg.data = reinterpret<uint8?>(addr(data[0]))
    msg.cursize = 0
    msg.maxsize = typeinfo sizeof(type<uint8[128]>)
    MSG_WriteChar(addr(msg), svc_stufftext)
    MSG_WriteString(addr(msg), cstr("reconnect\n"))
    NET_SendToAll(addr(msg), 5)
    if (cls.state != cactive_t.ca_dedicated) {
        Cmd_ExecuteString(cstr("reconnect\n"), cmd_source_t.src_command)
    }
}

// ================
// SV_SaveSpawnparms
// Grabs the current state of each client for saving across the
// transition to another level
// ================
[c_function]
def SV_SaveSpawnparms {
    var i : int
    var j : int
    svs.serverflags = int(pr_global_struct.serverflags)
    i = 0
    host_client = svs.clients
    while (i < svs.maxclients) {
        {
            if (int(host_client.active) == 0) {
                continue
            }
            // call the progs to get default spawn parms for the new client
            pr_global_struct.self = int(EDICT_TO_PROG(host_client.edict))
            PR_ExecuteProgram(pr_global_struct.SetChangeParms)
            j = 0
            while (j < NUM_SPAWN_PARMS) {
                host_client.spawn_parms[j] = addr(pr_global_struct.parm1)[j]
                j++
            }
        } finally {
            i++
            host_client++
        }
    }
}

[c_function]
def SV_SpawnServer(var server : uint8?) {
    var ent : edict_s?
    var i : int
    // let's not have any servers with no name
    if (hostname._c_string[0] == 0) {
        Cvar_Set(cstr("hostname"), cstr("UNNAMED"))
    }
    scr_centertime_off = 0.0f
    Con_DPrintf`va(cstr("SpawnServer: %s\n"), (server,))
    // now safe to issue another
    svs.changelevel_issued = qboolean._c_false
    // tell all connected clients that we are going to a new level
    if (int(sv.active) != 0) {
        SV_SendReconnect()
    }
    // make cvars consistant
    if (coop.value != 0.0f) {
        Cvar_SetValue(cstr("deathmatch"), 0.0f)
    }
    current_skill = int(double(skill.value) + 0.5lf)
    if (current_skill < 0) {
        current_skill = 0
    }
    if (current_skill > 3) {
        current_skill = 3
    }
    Cvar_SetValue(cstr("skill"), float(current_skill))
    // set up the new server
    Host_ClearMemory()
    crt::memset(reinterpret<void?>(addr(sv)), 0, uint64(typeinfo sizeof(type<server_t>)))
    crt::strcpy(addr(sv.name[0]), server)
    // load progs to get entity field count
    PR_LoadProgs()
    // allocate server memory
    sv.max_edicts = MAX_EDICTS
    sv.edicts = reinterpret<edict_s?>(Hunk_AllocName(sv.max_edicts * pr_edict_size, cstr("edicts")))
    sv.datagram.maxsize = typeinfo sizeof(type<uint8[1024]>)
    sv.datagram.cursize = 0
    sv.datagram.data = addr(sv.datagram_buf[0])
    sv.reliable_datagram.maxsize = typeinfo sizeof(type<uint8[1024]>)
    sv.reliable_datagram.cursize = 0
    sv.reliable_datagram.data = addr(sv.reliable_datagram_buf[0])
    sv.signon.maxsize = typeinfo sizeof(type<uint8[8192]>)
    sv.signon.cursize = 0
    sv.signon.data = addr(sv.signon_buf[0])
    // leave slots at start for clients only
    sv.num_edicts = svs.maxclients + 1
    for (i1 in range(svs.maxclients)) {
        ent = EDICT_NUM(i1 + 1)
        svs.clients[i1].edict = ent
    }
    sv.state = server_state_t.ss_loading
    sv.paused = qboolean._c_false
    sv.time = 1.0lf
    crt::strcpy(addr(sv.name[0]), server)
    sprintf(addr(sv.modelname[0]), cstr("maps/%s.bsp"), server)
    sv.worldmodel = Mod_ForName(addr(sv.modelname[0]), qboolean._c_false)
    if (sv.worldmodel == null) {
        Con_Printf`va(cstr("Couldn't spawn server %s\n"), (addr(sv.modelname[0]),))
        sv.active = qboolean._c_false
        return
    }
    sv.models[1] = sv.worldmodel
    // clear world interaction links
    SV_ClearWorld()
    sv.sound_precache[0] = pr_strings
    sv.model_precache[0] = pr_strings
    sv.model_precache[1] = addr(sv.modelname[0])
    i = 1
    while (i < sv.worldmodel.numsubmodels) {
        sv.model_precache[1 + i] = addr(localmodels[i][0])
        sv.models[i + 1] = Mod_ForName(addr(localmodels[i][0]), qboolean._c_false)
        i++
    }
    // load the rest of the entities
    ent = EDICT_NUM(0)
    crt::memset(reinterpret<void?>(addr(ent.v)), 0, uint64(progs.entityfields * 4))
    ent.free = qboolean._c_false
    ent.v.model = int(int64(addr(sv.worldmodel.name[0]) - pr_strings))
    // world model
    ent.v.modelindex = 1.0f
    ent.v.solid = float(SOLID_BSP)
    ent.v.movetype = float(MOVETYPE_PUSH)
    if (coop.value != 0.0f) {
        pr_global_struct.coop = coop.value
    } else {
        pr_global_struct.deathmatch = deathmatch.value
    }
    pr_global_struct.mapname = int(int64(addr(sv.name[0]) - pr_strings))
    // serverflags are for cross level information (sigils)
    pr_global_struct.serverflags = float(svs.serverflags)
    ED_LoadFromFile(sv.worldmodel.entities)
    sv.active = qboolean._c_true
    // all setup is completed, any further precache statements are errors
    sv.state = server_state_t.ss_active
    // run two frames to allow everything to settle
    host_frametime = 0.1lf
    SV_Physics()
    SV_Physics()
    // create a baseline for more efficient communications
    SV_CreateBaseline()
    // send serverinfo to all connected clients
    i = 0
    host_client = svs.clients
    while (i < svs.maxclients) {
        if (int(host_client.active) != 0) {
            SV_SendServerinfo(host_client)
        }
        i++
        host_client++
    }
    Con_DPrintf`va(cstr("Server spawned.\n"), VaNone())
}

