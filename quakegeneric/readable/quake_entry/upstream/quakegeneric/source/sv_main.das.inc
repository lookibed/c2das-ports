// generated by c2das - regenerate, never edit
var svs : server_static_t
var sv : server_t
var localmodels : uint8[256][5]
var fatbytes : int
var fatpvs : uint8[1024]

// ===============
// SV_Init
// ===============
[c_function]
def SV_Init {
    Cvar_RegisterVariable(addr(sv_maxvelocity))
    Cvar_RegisterVariable(addr(sv_gravity))
    Cvar_RegisterVariable(addr(sv_friction))
    Cvar_RegisterVariable(addr(sv_edgefriction))
    Cvar_RegisterVariable(addr(sv_stopspeed))
    Cvar_RegisterVariable(addr(sv_maxspeed))
    Cvar_RegisterVariable(addr(sv_accelerate))
    Cvar_RegisterVariable(addr(sv_idealpitchscale))
    Cvar_RegisterVariable(addr(sv_aim))
    Cvar_RegisterVariable(addr(sv_nostep))
    for (i in range(MAX_MODELS)) {
        sprintf(addr(localmodels[i][0]), cstr("*%i"), i)
    }
}

// ==================
// SV_StartParticle
// Make sure the event gets sent to all clients
// ==================
[c_function]
def SV_StartParticle(var org : float?; var dir : float?; color : int; count : int) {
    var v : int
    if (sv.datagram.cursize > MAX_DATAGRAM - 16) {
        return
    }
    MSG_WriteByte(addr(sv.datagram), svc_particle)
    MSG_WriteCoord(addr(sv.datagram), org[0])
    MSG_WriteCoord(addr(sv.datagram), org[1])
    MSG_WriteCoord(addr(sv.datagram), org[2])
    for (i in range(3)) {
        v = int(dir[i] * 16.0f)
        if (v > 127) {
            v = 127
        } elif (v < -128) {
            v = -128
        }
        MSG_WriteChar(addr(sv.datagram), v)
    }
    MSG_WriteByte(addr(sv.datagram), count)
    MSG_WriteByte(addr(sv.datagram), color)
}

// ==================
// SV_StartSound
// Each entity can have eight independant sound sources, like voice,
// weapon, feet, etc.
// Channel 0 is an auto-allocate channel, the others override anything
// allready running on that entity/channel pair.
// An attenuation of 0 will play full volume everywhere in the level.
// Larger attenuations will drop off. (max 4 attenuation)
// ==================
[c_function]
def SV_StartSound(var entity : edict_s?; var channel : int; var sample : uint8?; volume : int; attenuation : float) {
    var sound_num : int
    var field_mask : int
    var ent : int
    if (volume < 0 || volume > 255) {
        Sys_Error`va(cstr("SV_StartSound: volume = %i"), (volume,))
    }
    if (attenuation < 0.0f || attenuation > 4.0f) {
        Sys_Error`va(cstr("SV_StartSound: attenuation = %f"), (double(attenuation),))
    }
    if (channel < 0 || channel > 7) {
        Sys_Error`va(cstr("SV_StartSound: channel = %i"), (channel,))
    }
    if (sv.datagram.cursize > MAX_DATAGRAM - 16) {
        return
    }
    // find precache number for sound
    sound_num = 1
    while (sound_num < MAX_SOUNDS && sv.sound_precache[sound_num] != null) {
        if (crt::strcmp(sample, sv.sound_precache[sound_num]) == 0) {
            break
        }
        sound_num++
    }
    if (sound_num == MAX_SOUNDS || sv.sound_precache[sound_num] == null) {
        Con_Printf`va(cstr("SV_StartSound: %s not precacheed\n"), (sample,))
        return
    }
    ent = NUM_FOR_EDICT(entity)
    channel = (ent << 3) | channel
    field_mask = 0
    if (volume != DEFAULT_SOUND_PACKET_VOLUME) {
        field_mask |= SND_VOLUME
    }
    if (double(attenuation) != DEFAULT_SOUND_PACKET_ATTENUATION) {
        field_mask |= SND_ATTENUATION
    }
    // directed messages go only to the entity the are targeted on
    MSG_WriteByte(addr(sv.datagram), svc_sound)
    MSG_WriteByte(addr(sv.datagram), field_mask)
    if ((field_mask & SND_VOLUME) != 0) {
        MSG_WriteByte(addr(sv.datagram), volume)
    }
    if ((field_mask & SND_ATTENUATION) != 0) {
        MSG_WriteByte(addr(sv.datagram), int(attenuation * 64.0f))
    }
    MSG_WriteShort(addr(sv.datagram), channel)
    MSG_WriteByte(addr(sv.datagram), sound_num)
    for (i in range(3)) {
        MSG_WriteCoord(addr(sv.datagram), float(double(entity.v.origin[i]) + 0.5lf * double(entity.v.mins[i] + entity.v.maxs[i])))
    }
}

// ================
// SV_SendServerinfo
// Sends the first message from the server to a connected client.
// This will be sent on the initial connection and upon each server load.
// ================
[c_function]
def SV_SendServerinfo(var client : client_s?) {
    var s : uint8 ??
    var message : uint8[2048]
    MSG_WriteByte(addr(client.message), svc_print)
    sprintf(addr(message[0]), cstr("%c\nVERSION %4.2f SERVER (%i CRC)"), 2, VERSION, int(pr_crc))
    MSG_WriteString(addr(client.message), addr(message[0]))
    MSG_WriteByte(addr(client.message), svc_serverinfo)
    MSG_WriteLong(addr(client.message), PROTOCOL_VERSION)
    MSG_WriteByte(addr(client.message), svs.maxclients)
    if (coop.value == 0.0f && deathmatch.value != 0.0f) {
        MSG_WriteByte(addr(client.message), GAME_DEATHMATCH)
    } else {
        MSG_WriteByte(addr(client.message), GAME_COOP)
    }
    sprintf(addr(message[0]), pr_strings + sv.edicts.v.message)
    MSG_WriteString(addr(client.message), addr(message[0]))
    s = addr(sv.model_precache[0]) + 1
    while (*s != null) {
        MSG_WriteString(addr(client.message), *s)
        s++
    }
    MSG_WriteByte(addr(client.message), 0)
    s = addr(sv.sound_precache[0]) + 1
    while (*s != null) {
        MSG_WriteString(addr(client.message), *s)
        s++
    }
    MSG_WriteByte(addr(client.message), 0)
    // send music
    MSG_WriteByte(addr(client.message), svc_cdtrack)
    MSG_WriteByte(addr(client.message), int(sv.edicts.v.sounds))
    MSG_WriteByte(addr(client.message), int(sv.edicts.v.sounds))
    // set view
    MSG_WriteByte(addr(client.message), svc_setview)
    MSG_WriteShort(addr(client.message), NUM_FOR_EDICT(client.edict))
    MSG_WriteByte(addr(client.message), svc_signonnum)
    MSG_WriteByte(addr(client.message), 1)
    client.sendsignon = qboolean._c_true
    // need prespawn, spawn, etc
    client.spawned = qboolean._c_false
}

// ================
// SV_ConnectClient
// Initializes a client_t for a new net connection. This will only be called
// once for a player each game, not once for each level change.
// ================
[c_function]
def SV_ConnectClient(clientnum : int) {
    var ent : edict_s?
    var client : client_s?
    var edictnum : int
    var netconnection : qsocket_s?
    var spawn_parms : float[16]
    client = svs.clients + clientnum
    Con_DPrintf`va(cstr("Client %s connected\n"), (addr(client.netconnection.address[0]),))
    edictnum = clientnum + 1
    ent = EDICT_NUM(edictnum)
    // set up the client_t
    netconnection = client.netconnection
    if (int(sv.loadgame) != 0) {
        crt::memcpy(reinterpret<void?>(addr(spawn_parms[0])), reinterpret<void?>(addr(client.spawn_parms[0])), uint64(typeinfo sizeof(type<float[16]>)))
    }
    crt::memset(reinterpret<void?>(client), 0, uint64(typeinfo sizeof(type<client_s>)))
    client.netconnection = netconnection
    crt::strcpy(addr(client.name[0]), cstr("unconnected"))
    client.active = qboolean._c_true
    client.spawned = qboolean._c_false
    client.edict = ent
    client.message.data = addr(client.msgbuf[0])
    client.message.maxsize = typeinfo sizeof(type<uint8[8000]>)
    // we can catch it
    client.message.allowoverflow = qboolean._c_true
    client.privileged = qboolean._c_false
    if (int(sv.loadgame) != 0) {
        crt::memcpy(reinterpret<void?>(addr(client.spawn_parms[0])), reinterpret<void?>(addr(spawn_parms[0])), uint64(typeinfo sizeof(type<float[16]>)))
    } else {
        // call the progs to get default spawn parms for the new client
        PR_ExecuteProgram(pr_global_struct.SetNewParms)
        for (i in range(NUM_SPAWN_PARMS)) {
            client.spawn_parms[i] = addr(pr_global_struct.parm1)[i]
        }
    }
    SV_SendServerinfo(client)
}

// ===================
// SV_CheckForNewClients
// ===================
[c_function]
def SV_CheckForNewClients {
    var ret : qsocket_s?
    var i : int
    // check for new connections
    while (1 != 0) {
        ret = NET_CheckNewConnections()
        if (ret == null) {
            break
        }
        // init a new client structure
        i = 0
        while (i < svs.maxclients) {
            if (int(svs.clients[i].active) == 0) {
                break
            }
            i++
        }
        if (i == svs.maxclients) {
            Sys_Error`va(cstr("Host_CheckForNewClients: no free clients"), VaNone())
        }
        svs.clients[i].netconnection = ret
        SV_ConnectClient(i)
        net_activeconnections++
    }
}

