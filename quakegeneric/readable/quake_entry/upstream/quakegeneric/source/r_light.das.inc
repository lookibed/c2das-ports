// generated by c2das - regenerate, never edit
var r_dlightframecount : int

// ==================
// R_AnimateLight
// ==================
def R_AnimateLight {
    var i : int
    var k : int
    // light animations
    // 'm' is normal light, 'a' is no light, 'z' is double bright
    i = int(cl.time * 10.0lf)
    for (j in range(MAX_LIGHTSTYLES)) {
        if (cl_lightstyle[j].length == 0) {
            d_lightstylevalue[j] = 256
            continue
        }
        k = i % cl_lightstyle[j].length
        k = int(cl_lightstyle[j].map[k]) - 'a'
        k *= 22
        d_lightstylevalue[j] = k
    }
}

// =============
// R_MarkLights
// =============
[c_function]
def R_MarkLights(var light : dlight_t?; bit : int; var node : mnode_s?) {
    var splitplane : mplane_s?
    var dist : float
    var surf : msurface_s?
    var i : int
    if (node.contents < 0) {
        return
    }
    splitplane = node.plane
    dist = light.origin[0] * splitplane.normal[0] + light.origin[1] * splitplane.normal[1] + light.origin[2] * splitplane.normal[2] - splitplane.dist
    if (dist > light.radius) {
        R_MarkLights(light, bit, node.children[0])
        return
    }
    if (dist < -light.radius) {
        R_MarkLights(light, bit, node.children[1])
        return
    }
    // mark the polygons
    surf = cl.worldmodel.surfaces + int(node.firstsurface)
    i = 0
    while (i < int(node.numsurfaces)) {
        if (surf.dlightframe != r_dlightframecount) {
            surf.dlightbits = 0
            surf.dlightframe = r_dlightframecount
        }
        surf.dlightbits |= bit
        i++
        surf++
    }
    R_MarkLights(light, bit, node.children[0])
    R_MarkLights(light, bit, node.children[1])
}

// =============
// R_PushDlights
// =============
[c_function]
def R_PushDlights {
    var i : int
    var l : dlight_t?
    // because the count hasn't
    r_dlightframecount = r_framecount + 1
    // advanced yet for this frame
    l = addr(cl_dlights[0])
    i = 0
    while (i < MAX_DLIGHTS) {
        {
            if (double(l.die) < cl.time || l.radius == 0.0f) {
                continue
            }
            R_MarkLights(l, 1 << i, cl.worldmodel.nodes)
        } finally {
            i++
            l++
        }
    }
}

[c_function]
def RecursiveLightPoint(var node : mnode_s?; var start : float?; var end : float?) : int {
    var r : int
    var front : float
    var back : float
    var frac : float
    var side : int
    var plane : mplane_s?
    var mid : float[3]
    var surf : msurface_s?
    var s : int
    var t : int
    var ds : int
    var dt : int
    var i : int
    var tex : mtexinfo_t?
    var lightmap : uint8?
    var scale : uint
    var maps : int
    if (node.contents < 0) {
        // didn't hit anything
        return -1
    }
    // calculate mid point
    // FIXME: optimize for axial
    plane = node.plane
    front = start[0] * plane.normal[0] + start[1] * plane.normal[1] + start[2] * plane.normal[2] - plane.dist
    back = end[0] * plane.normal[0] + end[1] * plane.normal[1] + end[2] * plane.normal[2] - plane.dist
    side = int_of(front < 0.0f)
    if (int_of(back < 0.0f) == side) {
        return RecursiveLightPoint(node.children[side], start, end)
    }
    frac = front / (front - back)
    mid[0] = start[0] + (end[0] - start[0]) * frac
    mid[1] = start[1] + (end[1] - start[1]) * frac
    mid[2] = start[2] + (end[2] - start[2]) * frac
    // go down front side
    r = RecursiveLightPoint(node.children[side], start, addr(mid[0]))
    if (r >= 0) {
        // hit something
        return r
    }
    if (int_of(back < 0.0f) == side) {
        // didn't hit anuthing
        return -1
    }
    // check for impact on this node
    surf = cl.worldmodel.surfaces + int(node.firstsurface)
    {
        i = 0
        var _f = false
        while (true) {
            if (_f) {
                i++
                surf++
            }
            _f = true
            if (!(i < int(node.numsurfaces))) {
                break
            }
            if ((surf.flags & SURF_DRAWTILED) != 0) {
                // no lightmaps
                continue
            }
            tex = surf.texinfo
            s = int(mid[0] * addr(tex.vecs[0][0])[0] + mid[1] * addr(tex.vecs[0][0])[1] + mid[2] * addr(tex.vecs[0][0])[2] + addr(tex.vecs[0][0])[3])
            t = int(mid[0] * addr(tex.vecs[1][0])[0] + mid[1] * addr(tex.vecs[1][0])[1] + mid[2] * addr(tex.vecs[1][0])[2] + addr(tex.vecs[1][0])[3])
            if (s < int(surf.texturemins[0]) || t < int(surf.texturemins[1])) {
                continue
            }
            ds = s - int(surf.texturemins[0])
            dt = t - int(surf.texturemins[1])
            if (ds > int(surf.extents[0]) || dt > int(surf.extents[1])) {
                continue
            }
            if (surf.samples == null) {
                return 0
            }
            ds >>= 4
            dt >>= 4
            lightmap = surf.samples
            r = 0
            if (lightmap != null) {
                lightmap += dt * ((int(surf.extents[0]) >> 4) + 1) + ds
                maps = 0
                while (maps < MAXLIGHTMAPS && surf.styles[maps] != 255) {
                    scale = uint(d_lightstylevalue[int(surf.styles[maps])])
                    r = int(uint(r) + uint(*lightmap) * scale)
                    lightmap += ((int(surf.extents[0]) >> 4) + 1) * ((int(surf.extents[1]) >> 4) + 1)
                    maps++
                }
                r >>= 8
            }
            return r
        }
    }
    // go down back side
    return RecursiveLightPoint(node.children[int_of(side == 0)], addr(mid[0]), end)
}

[c_function]
def R_LightPoint(var p : float?) : int {
    var end : float[3]
    var r : int
    if (cl.worldmodel.lightdata == null) {
        return 255
    }
    end[0] = p[0]
    end[1] = p[1]
    end[2] = p[2] - 2048.0f
    r = RecursiveLightPoint(cl.worldmodel.nodes, p, addr(end[0]))
    if (r == -1) {
        r = 0
    }
    if (r < r_refdef.ambientlight) {
        r = r_refdef.ambientlight
    }
    return r
}

