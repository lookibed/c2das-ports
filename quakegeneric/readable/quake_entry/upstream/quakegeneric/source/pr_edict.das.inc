// =================
// ED_ClearEdict
// Sets everything to NULL
// =================
[c_function]
def ED_ClearEdict(var e : edict_s?) {
    crt::memset(reinterpret<void?>(addr(e.v)), 0, uint64(progs.entityfields * 4))
    e.free = qboolean._c_false
}

// =================
// ED_Alloc
// Either finds a free edict, or allocates a new one.
// Try to avoid reusing an entity that was recently freed, because it
// can cause the client to think the entity morphed into something else
// instead of being removed and recreated, which can cause interpolated
// angles and bad trails.
// =================
def ED_Alloc : edict_s? {
    var i : int
    var e : edict_s?
    i = svs.maxclients + 1
    while (i < sv.num_edicts) {
        e = EDICT_NUM(i)
        // the first couple seconds of server time can involve a lot of
        // freeing and allocating, so relax the replacement policy
        if (uint(e.free) != 0 && (e.freetime < 2.0f || sv.time - double(e.freetime) > 0.5lf)) {
            ED_ClearEdict(e)
            return e
        }
        i++
    }
    if (i == MAX_EDICTS) {
        Sys_Error`va(cstr("ED_Alloc: no free edicts"), VaNone())
    }
    sv.num_edicts++
    e = EDICT_NUM(i)
    ED_ClearEdict(e)
    return e
}

// =================
// ED_Free
// Marks the edict as free
// FIXME: walk all entities and NULL out references to this entity
// =================
def ED_Free(var ed : edict_s?) {
    // unlink from world bsp
    SV_UnlinkEdict(ed)
    ed.free = qboolean._c_true
    ed.v.model = 0
    ed.v.takedamage = 0.0f
    ed.v.modelindex = 0.0f
    ed.v.colormap = 0.0f
    ed.v.skin = 0.0f
    ed.v.frame = 0.0f
    ed.v.origin[0] = vec3_origin[0]
    ed.v.origin[1] = vec3_origin[1]
    ed.v.origin[2] = vec3_origin[2]
    ed.v.angles[0] = vec3_origin[0]
    ed.v.angles[1] = vec3_origin[1]
    ed.v.angles[2] = vec3_origin[2]
    ed.v.nextthink = -1.0f
    ed.v.solid = 0.0f
    ed.freetime = float(sv.time)
}

