        int(uint64(typeinfo sizeof(type<void?>)) / 4ul))
var pr_crc : uint16
var nomonsters : cvar_s = cvar_s(name = cstr("nomonsters"), _c_string = cstr("0"))
var gamecfg : cvar_s = cvar_s(name = cstr("gamecfg"), _c_string = cstr("0"))
var scratch1 : cvar_s = cvar_s(name = cstr("scratch1"), _c_string = cstr("0"))
