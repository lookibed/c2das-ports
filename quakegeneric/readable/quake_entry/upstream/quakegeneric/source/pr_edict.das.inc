[c_function]
def GetEdictFieldValue(var ed : edict_s?; var field : uint8?) : eval_s? {
    var _c_def : ddef_t? = null
    var i : int
    i = 0
    while (i < GEFV_CACHESIZE) {
        if (crt::strcmp(field, addr(gefvCache[i].field[0])) == 0) {
            _c_def = gefvCache[i].pcache
            goto label 1
        }
        i++
    }
    _c_def = ED_FindField(field)
    if (crt::strlen(field) < uint64(MAX_FIELD_LEN)) {
        gefvCache[GetEdictFieldValue_rep].pcache = _c_def
        crt::strcpy(addr(gefvCache[GetEdictFieldValue_rep].field[0]), field)
        GetEdictFieldValue_rep ^= 1
    }
    label 1:  // Done
    if (_c_def == null) {
        return null
    }
    return reinterpret<eval_s?>(reinterpret<uint8?>(addr(ed.v)) + int(_c_def.ofs) * 4)
}

// ============
// PR_ValueString
// Returns a string describing *data in a type specific manner
// =============
[c_function]
def PR_ValueString(var _c_type : etype_t; var val : eval_s?) : uint8? {
    var _c_def : ddef_t?
    var f : dfunction_t?
    _c_type = enum_from_int(type<etype_t>, int(uint(_c_type) & uint(~DEF_SAVEGLOBAL)))
    c_switch(_c_type) {
        case(etype_t.ev_string) {
            sprintf(addr(PR_ValueString_line[0]), cstr("%s"), pr_strings + val._c_string)
            break
        }
        case(etype_t.ev_entity) {
            sprintf(addr(PR_ValueString_line[0]), cstr("entity %i"), NUM_FOR_EDICT(PROG_TO_EDICT(val.edict)))
            break
        }
        case(etype_t.ev_function) {
            f = pr_functions + val._c_function
            sprintf(addr(PR_ValueString_line[0]), cstr("%s()"), pr_strings + f.s_name)
            break
        }
        case(etype_t.ev_field) {
            _c_def = ED_FieldAtOfs(val._int)
            sprintf(addr(PR_ValueString_line[0]), cstr(".%s"), pr_strings + _c_def.s_name)
            break
        }
        case(etype_t.ev_void) {
            sprintf(addr(PR_ValueString_line[0]), cstr("void"))
            break
        }
        case(etype_t.ev_float) {
            sprintf(addr(PR_ValueString_line[0]), cstr("%5.1f"), double(val._float))
            break
        }
        case(etype_t.ev_vector) {
            sprintf(addr(PR_ValueString_line[0]), cstr("'%5.1f %5.1f %5.1f'"), double(val.vector[0]), double(val.vector[1]), double(val.vector[2]))
            break
        }
        case(etype_t.ev_pointer) {
            sprintf(addr(PR_ValueString_line[0]), cstr("pointer"))
            break
        }
        case(_) {
            sprintf(addr(PR_ValueString_line[0]), cstr("bad type %i"), uint(_c_type))
            break
        }
    }
    return addr(PR_ValueString_line[0])
}

// ============
