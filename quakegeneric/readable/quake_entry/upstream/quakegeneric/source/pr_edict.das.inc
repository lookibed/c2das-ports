// =============
// ED_Count
// For debugging
// =============
def ED_Count {
    var i : int
    var ent : edict_s?
    var active : int
    var models : int
    var solid : int
    var step : int
    step = 0
    solid = step
    models = solid
    active = models
    i = 0
    while (i < sv.num_edicts) {
        {
            ent = EDICT_NUM(i)
            if (int(ent.free) != 0) {
                continue
            }
            active++
            if (ent.v.solid != 0.0f) {
                solid++
            }
            if (ent.v.model != 0) {
                models++
            }
            if (ent.v.movetype == float(MOVETYPE_STEP)) {
                step++
            }
        } finally {
            i++
        }
    }
    Con_Printf`va(cstr("num_edicts:%3i\n"), (sv.num_edicts,))
    Con_Printf`va(cstr("active    :%3i\n"), (active,))
    Con_Printf`va(cstr("view      :%3i\n"), (models,))
    Con_Printf`va(cstr("touch     :%3i\n"), (solid,))
    Con_Printf`va(cstr("step      :%3i\n"), (step,))
}

// =============
// ED_WriteGlobals
// =============
[c_function]
def ED_WriteGlobals(var f : _IO_FILE?) {
    var _c_def : ddef_t?
    var i : int
    var name : uint8?
    var _c_type : int
    fprintf(reinterpret<void?>(f), cstr("\{\n"))
    i = 0
    while (i < progs.numglobaldefs) {
        {
            _c_def = addr(pr_globaldefs[i])
            _c_type = int(_c_def._c_type)
            if ((int(_c_def._c_type) & DEF_SAVEGLOBAL) == 0) {
                continue
            }
            _c_type &= ~DEF_SAVEGLOBAL
            if (_c_type != int(etype_t.ev_string) && _c_type != int(etype_t.ev_float) && _c_type != int(etype_t.ev_entity)) {
                continue
            }
            name = pr_strings + _c_def.s_name
            fprintf(reinterpret<void?>(f), cstr("\"%s\" "), name)
            fprintf(reinterpret<void?>(f), cstr("\"%s\"\n"),
                    PR_UglyValueString(enum_from_int(type<etype_t>, _c_type), reinterpret<eval_s?>(addr(pr_globals[int(_c_def.ofs)]))))
        } finally {
            i++
        }
    }
    fprintf(reinterpret<void?>(f), cstr("\}\n"))
}

// =============
// ED_ParseGlobals
// =============
[c_function]
def ED_ParseGlobals(var data : uint8?) {
    var keyname : uint8[64]
    var key : ddef_t?
    while (1 != 0) {
        // parse key
        data = COM_Parse(data)
        if (com_token[0] == '}') {
            break
        }
        if (data == null) {
            Sys_Error`va(cstr("ED_ParseEntity: EOF without closing brace"), VaNone())
        }
        crt::strcpy(addr(keyname[0]), addr(com_token[0]))
        // parse value
        data = COM_Parse(data)
        if (data == null) {
            Sys_Error`va(cstr("ED_ParseEntity: EOF without closing brace"), VaNone())
        }
        if (com_token[0] == '}') {
            Sys_Error`va(cstr("ED_ParseEntity: closing brace without data"), VaNone())
        }
        key = ED_FindGlobal(addr(keyname[0]))
        if (key == null) {
            Con_Printf`va(cstr("'%s' is not a global\n"), (addr(keyname[0]),))
            continue
        }
        if (int(ED_ParseEpair(reinterpret<void?>(pr_globals), key, addr(com_token[0]))) == 0) {
            Host_Error`va(cstr("ED_ParseGlobals: parse error"), VaNone())
        }
    }
}

// =============
// ED_NewString
// =============
[c_function]
def ED_NewString(var _c_string : uint8?) : uint8? {
    var _c_new : uint8?
    var new_p : uint8?
    var i : int
    var l : int
    l = int(crt::strlen(_c_string) + 1ul)
    _c_new = reinterpret<uint8?>(Hunk_Alloc(l))
    new_p = _c_new
    i = 0
    while (i < l) {
        if (_c_string[i] == '\\' && i < l - 1) {
            i++
            if (_c_string[i] == 'n') {
                var _t0 = new_p
                new_p++
                *_t0 = uint8('\n')
            } else {
                var _t1 = new_p
                new_p++
                *_t1 = uint8('\\')
            }
        } else {
            var _t2 = new_p
            new_p++
            *_t2 = _c_string[i]
        }
        i++
    }
    return _c_new
}

// =============
// ED_ParseEval
// Can parse either fields or globals
// returns false if error
// =============
[c_function]
def ED_ParseEpair(var base : void?; var key : ddef_t?; var s : uint8?) : qboolean {
    var i : int
    var _c_string : uint8[128]
    var _c_def : ddef_t?
    var v : uint8?
    var w : uint8?
    var d : void?
    var func : dfunction_t?
    d = reinterpret<void?>(reinterpret<int?>(base) + int(key.ofs))
    c_switch(int(key._c_type) & ~DEF_SAVEGLOBAL) {
        case(1) {
            *reinterpret<int?>(d) = int(int64(ED_NewString(s) - pr_strings))
            break
        }
        case(2) {
            *reinterpret<float?>(d) = float(crt::atof(s))
            break
        }
        case(3) {
            crt::strcpy(addr(_c_string[0]), s)
            v = addr(_c_string[0])
            w = addr(_c_string[0])
            i = 0
            while (i < 3) {
                while (*v != 0 && *v != ' ') {
                    v++
                }
                *v = 0u8
                reinterpret<float?>(d)[i] = float(crt::atof(w))
                v = v + 1
                w = v
                i++
            }
            break
        }
        case(4) {
            *reinterpret<int?>(d) = int(EDICT_TO_PROG(EDICT_NUM(crt::atoi(s))))
            break
        }
        case(5) {
            _c_def = ED_FindField(s)
            if (_c_def == null) {
                Con_Printf`va(cstr("Can't find field %s\n"), (s,))
                return qboolean._c_false
            }
            *reinterpret<int?>(d) = G_INT(_c_def.ofs)
            break
        }
        case(6) {
            func = ED_FindFunction(s)
            if (func == null) {
                Con_Printf`va(cstr("Can't find function %s\n"), (s,))
                return qboolean._c_false
            }
            *reinterpret<int?>(d) = int(int64(func - pr_functions))
            break
        }
        case(_) {
            break
        }
    }
    return qboolean._c_true
}

// ====================
// ED_ParseEdict
// Parses an edict out of the given string, returning the new position
// ed should be a properly initialized empty edict.
// Used for initial level load and for savegames.
// ====================
[c_function]
def ED_ParseEdict(var data : uint8?; var ent : edict_s?) : uint8? {
    var key : ddef_t?
    var anglehack : qboolean
    var init : qboolean
    var keyname : uint8[256]
    var n : int
    init = qboolean._c_false
    // clear it
    // hack
    if (intptr(ent) != intptr(sv.edicts)) {
        crt::memset(reinterpret<void?>(addr(ent.v)), 0, uint64(progs.entityfields * 4))
    }
    // go through all the dictionary pairs
    while (1 != 0) {
        // parse key
        data = COM_Parse(data)
        if (com_token[0] == '}') {
            break
        }
        if (data == null) {
            Sys_Error`va(cstr("ED_ParseEntity: EOF without closing brace"), VaNone())
        }
        // anglehack is to allow QuakeEd to write single scalar angles
        // and allow them to be turned into vectors. (FIXME...)
        if (crt::strcmp(addr(com_token[0]), cstr("angle")) == 0) {
            crt::strcpy(addr(com_token[0]), cstr("angles"))
            anglehack = qboolean._c_true
        } else {
            anglehack = qboolean._c_false
        }
        // FIXME: change light to _light to get rid of this hack
        if (crt::strcmp(addr(com_token[0]), cstr("light")) == 0) {
            // hack for single light def
            crt::strcpy(addr(com_token[0]), cstr("light_lev"))
        }
        crt::strcpy(addr(keyname[0]), addr(com_token[0]))
        // another hack to fix heynames with trailing spaces
        n = int(crt::strlen(addr(keyname[0])))
        while (n != 0 && keyname[n - 1] == ' ') {
            keyname[n - 1] = 0u8
            n--
        }
        // parse value
        data = COM_Parse(data)
        if (data == null) {
            Sys_Error`va(cstr("ED_ParseEntity: EOF without closing brace"), VaNone())
        }
        if (com_token[0] == '}') {
            Sys_Error`va(cstr("ED_ParseEntity: closing brace without data"), VaNone())
        }
        init = qboolean._c_true
        // keynames with a leading underscore are used for utility comments,
        // and are immediately discarded by quake
        if (keyname[0] == '_') {
            continue
        }
        key = ED_FindField(addr(keyname[0]))
        if (key == null) {
            Con_Printf`va(cstr("'%s' is not a field\n"), (addr(keyname[0]),))
            continue
        }
        if (int(anglehack) != 0) {
            var temp : uint8[32]
            crt::strcpy(addr(temp[0]), addr(com_token[0]))
            sprintf(addr(com_token[0]), cstr("0 %s 0"), addr(temp[0]))
        }
        if (int(ED_ParseEpair(reinterpret<void?>(addr(ent.v)), key, addr(com_token[0]))) == 0) {
            Host_Error`va(cstr("ED_ParseEdict: parse error"), VaNone())
        }
    }
    if (int(init) == 0) {
        ent.free = qboolean._c_true
    }
    return data
}

// ================
// ED_LoadFromFile
// The entities are directly placed in the array, rather than allocated with
// ED_Alloc, because otherwise an error loading the map would have entity
// number references out of order.
// Creates a server's entity / program execution context by
// parsing textual entity definitions out of an ent file.
// Used for both fresh maps and savegame loads. A fresh map would also need
// to call ED_CallSpawnFunctions () to let the objects initialize themselves.
// ================
[c_function]
def ED_LoadFromFile(var data : uint8?) {
    var ent : edict_s?
    var inhibit : int
    var func : dfunction_t?
    ent = null
    inhibit = 0
    pr_global_struct.time = float(sv.time)
    // parse ents
    while (1 != 0) {
        // parse the opening brace
        data = COM_Parse(data)
        if (data == null) {
            break
        }
        if (com_token[0] != '{') {
            Sys_Error`va(cstr("ED_LoadFromFile: found %s when expecting \{"), (addr(com_token[0]),))
        }
        if (ent == null) {
            ent = EDICT_NUM(0)
        } else {
            ent = ED_Alloc()
        }
        data = ED_ParseEdict(data, ent)
        // remove things from different skill levels or deathmatch
        if (deathmatch.value != 0.0f) {
            if ((int(ent.v.spawnflags) & SPAWNFLAG_NOT_DEATHMATCH) != 0) {
                ED_Free(ent)
                inhibit++
                continue
            }
        } elif ((current_skill == 0 && (int(ent.v.spawnflags) & SPAWNFLAG_NOT_EASY) != 0) ||
                (current_skill == 1 && (int(ent.v.spawnflags) & SPAWNFLAG_NOT_MEDIUM) != 0) ||
                (current_skill >= 2 && (int(ent.v.spawnflags) & SPAWNFLAG_NOT_HARD) != 0)) {
            ED_Free(ent)
            inhibit++
            continue
        }
        // immediately call spawn function
        if (ent.v.classname == 0) {
            Con_Printf`va(cstr("No classname for:\n"), VaNone())
            ED_Print(ent)
            ED_Free(ent)
            continue
        }
        // look for the spawn function
        func = ED_FindFunction(pr_strings + ent.v.classname)
        if (func == null) {
            Con_Printf`va(cstr("No spawn function for:\n"), VaNone())
            ED_Print(ent)
            ED_Free(ent)
            continue
        }
        pr_global_struct.self = int(EDICT_TO_PROG(ent))
        PR_ExecuteProgram(int(int64(func - pr_functions)))
    }
    Con_DPrintf`va(cstr("%i entities inhibited\n"), (inhibit,))
}

// ===============
// PR_LoadProgs
// ===============
[c_function]
def PR_LoadProgs {
    var i : int
    // flush the non-C variable lookup cache
    for (i1 in range(GEFV_CACHESIZE)) {
        gefvCache[i1].field[0] = 0u8
    }
    CRC_Init(addr(pr_crc))
    progs = reinterpret<dprograms_t?>(COM_LoadHunkFile(cstr("progs.dat")))
    if (progs == null) {
        Sys_Error`va(cstr("PR_LoadProgs: couldn't load progs.dat"), VaNone())
    }
    Con_DPrintf`va(cstr("Programs occupy %iK.\n"), (com_filesize / 1024,))
    for (i1 in range(com_filesize)) {
        CRC_ProcessByte(addr(pr_crc), reinterpret<uint8?>(progs)[i1])
    }
    // byte swap the header
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<dprograms_t>)) / 4ul) {
        reinterpret<int?>(progs)[i] = invoke(LittleLong, reinterpret<int?>(progs)[i])
        i++
    }
    if (progs.version != PROG_VERSION) {
        Sys_Error`va(cstr("progs.dat has wrong version number (%i should be %i)"), (progs.version, PROG_VERSION))
    }
    if (progs.crc != PROGHEADER_CRC) {
        Sys_Error`va(cstr("progs.dat system vars have been modified, progdefs.h is out of date"), VaNone())
    }
    pr_functions = reinterpret<dfunction_t?>(reinterpret<uint8?>(progs) + progs.ofs_functions)
    pr_strings = reinterpret<uint8?>(progs) + progs.ofs_strings
    pr_globaldefs = reinterpret<ddef_t?>(reinterpret<uint8?>(progs) + progs.ofs_globaldefs)
    pr_fielddefs = reinterpret<ddef_t?>(reinterpret<uint8?>(progs) + progs.ofs_fielddefs)
    pr_statements = reinterpret<statement_s?>(reinterpret<uint8?>(progs) + progs.ofs_statements)
    pr_global_struct = reinterpret<globalvars_t?>(reinterpret<uint8?>(progs) + progs.ofs_globals)
    pr_globals = reinterpret<float?>(pr_global_struct)
    pr_edict_size = int(uint64(progs.entityfields * 4) + uint64(typeinfo sizeof(type<edict_s>)) - uint64(typeinfo sizeof(type<entvars_t>)))
    // byte swap the lumps
    i = 0
    while (i < progs.numstatements) {
        pr_statements[i].op = uint16(invoke(LittleShort, int16(pr_statements[i].op)))
        pr_statements[i].a = invoke(LittleShort, pr_statements[i].a)
        pr_statements[i].b = invoke(LittleShort, pr_statements[i].b)
        pr_statements[i].c = invoke(LittleShort, pr_statements[i].c)
        i++
    }
    i = 0
    while (i < progs.numfunctions) {
        pr_functions[i].first_statement = invoke(LittleLong, pr_functions[i].first_statement)
        pr_functions[i].parm_start = invoke(LittleLong, pr_functions[i].parm_start)
        pr_functions[i].s_name = invoke(LittleLong, pr_functions[i].s_name)
        pr_functions[i].s_file = invoke(LittleLong, pr_functions[i].s_file)
        pr_functions[i].numparms = invoke(LittleLong, pr_functions[i].numparms)
        pr_functions[i].locals = invoke(LittleLong, pr_functions[i].locals)
        i++
    }
    i = 0
    while (i < progs.numglobaldefs) {
        pr_globaldefs[i]._c_type = uint16(invoke(LittleShort, int16(pr_globaldefs[i]._c_type)))
        pr_globaldefs[i].ofs = uint16(invoke(LittleShort, int16(pr_globaldefs[i].ofs)))
        pr_globaldefs[i].s_name = invoke(LittleLong, pr_globaldefs[i].s_name)
        i++
    }
    i = 0
    while (i < progs.numfielddefs) {
        pr_fielddefs[i]._c_type = uint16(invoke(LittleShort, int16(pr_fielddefs[i]._c_type)))
        if ((int(pr_fielddefs[i]._c_type) & DEF_SAVEGLOBAL) != 0) {
            Sys_Error`va(cstr("PR_LoadProgs: pr_fielddefs[i].type & DEF_SAVEGLOBAL"), VaNone())
        }
        pr_fielddefs[i].ofs = uint16(invoke(LittleShort, int16(pr_fielddefs[i].ofs)))
        pr_fielddefs[i].s_name = invoke(LittleLong, pr_fielddefs[i].s_name)
        i++
    }
    i = 0
    while (i < progs.numglobals) {
        reinterpret<int?>(pr_globals)[i] = invoke(LittleLong, reinterpret<int?>(pr_globals)[i])
        i++
    }
}

