// ============
// PR_GlobalString
// Returns a string with a description and the contents of a global,
// padded to 20 field width
// ============
[c_function]
def PR_GlobalString(ofs : int) : uint8? {
    var s : uint8?
    var i : int
    var _c_def : ddef_t?
    var val : void?
    val = reinterpret<void?>(addr(pr_globals[ofs]))
    _c_def = ED_GlobalAtOfs(ofs)
    if (_c_def == null) {
        sprintf(addr(PR_GlobalString_line[0]), cstr("%i(???)"), ofs)
    } else {
        s = PR_ValueString(enum_from_int(type<etype_t>, int(_c_def._c_type)), reinterpret<eval_s?>(val))
        sprintf(addr(PR_GlobalString_line[0]), cstr("%i(%s)%s"), ofs, pr_strings + _c_def.s_name, s)
    }
    i = int(crt::strlen(addr(PR_GlobalString_line[0])))
    while (i < 20) {
        crt::strcat(addr(PR_GlobalString_line[0]), cstr(" "))
        i++
    }
    crt::strcat(addr(PR_GlobalString_line[0]), cstr(" "))
    return addr(PR_GlobalString_line[0])
}

[c_function]
def PR_GlobalStringNoContents(ofs : int) : uint8? {
    var i : int
    var _c_def : ddef_t?
    _c_def = ED_GlobalAtOfs(ofs)
    if (_c_def == null) {
        sprintf(addr(PR_GlobalStringNoContents_line[0]), cstr("%i(???)"), ofs)
    } else {
        sprintf(addr(PR_GlobalStringNoContents_line[0]), cstr("%i(%s)"), ofs, pr_strings + _c_def.s_name)
    }
    i = int(crt::strlen(addr(PR_GlobalStringNoContents_line[0])))
    while (i < 20) {
        crt::strcat(addr(PR_GlobalStringNoContents_line[0]), cstr(" "))
        i++
    }
    crt::strcat(addr(PR_GlobalStringNoContents_line[0]), cstr(" "))
    return addr(PR_GlobalStringNoContents_line[0])
}

// =============
// ED_Print
// For debugging
// =============
[c_function]
def ED_Print(var ed : edict_s?) {
    var l : int
    var d : ddef_t?
    var v : int?
    var i : int
    var j : int
    var name : uint8?
    var _c_type : int
    if (int(ed.free) != 0) {
        Con_Printf`va(cstr("FREE\n"), VaNone())
        return
    }
    Con_Printf`va(cstr("\nEDICT %i:\n"), (NUM_FOR_EDICT(ed),))
    i = 1
    while (i < progs.numfielddefs) {
        {
            d = addr(pr_fielddefs[i])
            name = pr_strings + d.s_name
            if (name[crt::strlen(name) - 2ul] == '_') {
                // skip _x, _y, _z vars
                continue
            }
            v = reinterpret<int?>(reinterpret<uint8?>(addr(ed.v)) + int(d.ofs) * 4)
            // if the value is still all 0, skip the field
            _c_type = int(d._c_type) & ~DEF_SAVEGLOBAL
            j = 0
            while (j < type_size[_c_type]) {
                if (v[j] != 0) {
                    break
                }
                j++
            }
            if (j == type_size[_c_type]) {
                continue
            }
            Con_Printf`va(cstr("%s"), (name,))
            l = int(crt::strlen(name))
            while (true) {
                let _t0 = l
                l++
                if (!(_t0 < 15)) {
                    break
                }
                Con_Printf`va(cstr(" "), VaNone())
            }
            Con_Printf`va(cstr("%s\n"), (PR_ValueString(enum_from_int(type<etype_t>, int(d._c_type)), reinterpret<eval_s?>(v)),))
        } finally {
            i++
        }
    }
}

// =============
// ED_Write
// For savegames
// =============
[c_function]
def ED_Write(var f : _IO_FILE?; var ed : edict_s?) {
    var d : ddef_t?
    var v : int?
    var i : int
    var j : int
    var name : uint8?
    var _c_type : int
    fprintf(reinterpret<void?>(f), cstr("\{\n"))
    if (int(ed.free) != 0) {
        fprintf(reinterpret<void?>(f), cstr("\}\n"))
        return
    }
    i = 1
    while (i < progs.numfielddefs) {
        {
            d = addr(pr_fielddefs[i])
            name = pr_strings + d.s_name
            if (name[crt::strlen(name) - 2ul] == '_') {
                // skip _x, _y, _z vars
                continue
            }
            v = reinterpret<int?>(reinterpret<uint8?>(addr(ed.v)) + int(d.ofs) * 4)
            // if the value is still all 0, skip the field
            _c_type = int(d._c_type) & ~DEF_SAVEGLOBAL
            j = 0
            while (j < type_size[_c_type]) {
                if (v[j] != 0) {
                    break
                }
                j++
            }
            if (j == type_size[_c_type]) {
                continue
            }
            fprintf(reinterpret<void?>(f), cstr("\"%s\" "), name)
            fprintf(reinterpret<void?>(f), cstr("\"%s\"\n"), PR_UglyValueString(enum_from_int(type<etype_t>, int(d._c_type)), reinterpret<eval_s?>(v)))
        } finally {
            i++
        }
    }
    fprintf(reinterpret<void?>(f), cstr("\}\n"))
}

