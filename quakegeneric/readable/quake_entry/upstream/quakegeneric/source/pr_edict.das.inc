[c_function]
def EDICT_NUM(n : int) : edict_s? {
    if (n < 0 || n >= sv.max_edicts) {
        Sys_Error`va(cstr("EDICT_NUM: bad number %i"), (n,))
    }
    return reinterpret<edict_s?>(reinterpret<uint8?>(sv.edicts) + n * pr_edict_size)
}

[c_function]
def NUM_FOR_EDICT(var e : edict_s?) : int {
    var b : int
    b = int(int64(reinterpret<uint8?>(e) - reinterpret<uint8?>(sv.edicts)))
    b = b / pr_edict_size
    if (b < 0 || b >= sv.num_edicts) {
        Sys_Error`va(cstr("NUM_FOR_EDICT: bad pointer"), VaNone())
    }
    return b
}

