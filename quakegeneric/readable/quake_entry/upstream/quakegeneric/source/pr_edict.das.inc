var scratch4 : cvar_s = cvar_s(name = cstr("scratch4"), _c_string = cstr("0"))
var savedgamecfg : cvar_s = cvar_s(name = cstr("savedgamecfg"), _c_string = cstr("0"), archive = qboolean._c_true)
