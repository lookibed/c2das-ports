// ====================
// CL_WriteDemoMessage
// Dumps the current net message, prefixed by the length and view angles
// ====================
[c_function]
def CL_WriteDemoMessage {
    var len : int
    var f : float
    len = invoke(LittleLong, net_message.cursize)
    crt::fwrite(reinterpret<void?>(addr(len)), 4ul, 1ul, reinterpret<void?>(cls.demofile))
    for (i in range(3)) {
        f = invoke(LittleFloat, cl.viewangles[i])
        crt::fwrite(reinterpret<void?>(addr(f)), 4ul, 1ul, reinterpret<void?>(cls.demofile))
    }
    crt::fwrite(reinterpret<void?>(net_message.data), uint64(net_message.cursize), 1ul, reinterpret<void?>(cls.demofile))
    crt::fflush(reinterpret<void?>(cls.demofile))
}

// ====================
// CL_GetMessage
// Handles recording and playback of demos, on top of NET_ code
// ====================
[c_function]
def CL_GetMessage : int {
    var r : int
    var f : float
    if (int(cls.demoplayback) != 0) {
        // decide if it is time to grab the next message
        // allways grab until fully connected
        if (cls.signon == SIGNONS) {
            if (int(cls.timedemo) != 0) {
                if (host_framecount == cls.td_lastframe) {
                    // allready read this frame's message
                    return 0
                }
                cls.td_lastframe = host_framecount
                // if this is the second frame, grab the real td_starttime
                // so the bogus time on the first frame doesn't count
                if (host_framecount == cls.td_startframe + 1) {
                    cls.td_starttime = float(realtime)
                }
            } elif (cl.time <= cl.mtime[0]) {
                // cl.time > 0 &&
                // don't need another message yet
                return 0
            }
        }
        // get the next message
        crt::fread(reinterpret<void?>(addr(net_message.cursize)), 4ul, 1ul, reinterpret<void?>(cls.demofile))
        cl.mviewangles[1][0] = cl.mviewangles[0][0]
        cl.mviewangles[1][1] = cl.mviewangles[0][1]
        cl.mviewangles[1][2] = cl.mviewangles[0][2]
        for (i in range(3)) {
            r = int(crt::fread(reinterpret<void?>(addr(f)), 4ul, 1ul, reinterpret<void?>(cls.demofile)))
            cl.mviewangles[0][i] = invoke(LittleFloat, f)
        }
        net_message.cursize = invoke(LittleLong, net_message.cursize)
        if (net_message.cursize > MAX_MSGLEN) {
            Sys_Error`va(cstr("Demo message > MAX_MSGLEN"), VaNone())
        }
        r = int(crt::fread(reinterpret<void?>(net_message.data), uint64(net_message.cursize), 1ul, reinterpret<void?>(cls.demofile)))
        if (r != 1) {
            CL_StopPlayback()
            return 0
        }
        return 1
    }
    while (1 != 0) {
        r = NET_GetMessage(cls.netcon)
        if (r != 1 && r != 2) {
            return r
        }
        // discard nop keepalive message
        if (net_message.cursize == 1 && int(net_message.data[0]) == svc_nop) {
            Con_Printf`va(cstr("<-- server to client keepalive\n"), VaNone())
        } else {
            break
        }
    }
    if (int(cls.demorecording) != 0) {
        CL_WriteDemoMessage()
    }
    return r
}

// ====================
// CL_Stop_f
// stop recording a demo
// ====================
[c_function]
def CL_Stop_f {
    if (cmd_source != cmd_source_t.src_command) {
        return
    }
    if (int(cls.demorecording) == 0) {
        Con_Printf`va(cstr("Not recording a demo.\n"), VaNone())
        return
    }
    // write a disconnect message to the demo file
    SZ_Clear(addr(net_message))
    MSG_WriteByte(addr(net_message), svc_disconnect)
    CL_WriteDemoMessage()
    // finish up
    crt::fclose(reinterpret<void?>(cls.demofile))
    cls.demofile = null
    cls.demorecording = qboolean._c_false
    Con_Printf`va(cstr("Completed demo\n"), VaNone())
}

// ====================
// CL_Record_f
// record <demoname> <map> [cd track]
// ====================
[c_function]
def CL_Record_f {
    var c : int
    var name : uint8[128]
    var track : int
    if (cmd_source != cmd_source_t.src_command) {
        return
    }
    c = Cmd_Argc()
    if (c != 2 && c != 3 && c != 4) {
        Con_Printf`va(cstr("record <demoname> [<map> [cd track]]\n"), VaNone())
        return
    }
    if (crt::strstr(Cmd_Argv(1), cstr("..")) != null) {
        Con_Printf`va(cstr("Relative pathnames are not allowed.\n"), VaNone())
        return
    }
    if (c == 2 && cls.state == cactive_t.ca_connected) {
        Con_Printf`va(cstr("Can not record - already connected to server\nClient demo recording must be started before connecting\n"), VaNone())
        return
    }
    // write the forced cd track number, or -1
    if (c == 4) {
        track = crt::atoi(Cmd_Argv(3))
        Con_Printf`va(cstr("Forcing CD track to %i\n"), (cls.forcetrack,))
    } else {
        track = -1
    }
    sprintf(addr(name[0]), cstr("%s/%s"), addr(com_gamedir[0]), Cmd_Argv(1))
    // start the map up
    if (c > 2) {
        Cmd_ExecuteString(va`va(cstr("map %s"), (Cmd_Argv(2),)), cmd_source_t.src_command)
    }
    // open the demo file
    COM_DefaultExtension(addr(name[0]), cstr(".dem"))
    Con_Printf`va(cstr("recording to %s.\n"), (addr(name[0]),))
    cls.demofile = reinterpret<_IO_FILE?>(crt::fopen(addr(name[0]), cstr("wb")))
    if (cls.demofile == null) {
        Con_Printf`va(cstr("ERROR: couldn't open.\n"), VaNone())
        return
    }
    cls.forcetrack = track
    fprintf(reinterpret<void?>(cls.demofile), cstr("%i\n"), cls.forcetrack)
    cls.demorecording = qboolean._c_true
}

// ====================
// CL_PlayDemo_f
// play [demoname]
// ====================
[c_function]
def CL_PlayDemo_f {
    var name : uint8[256]
    var c : int
    var neg : qboolean = qboolean._c_false
    if (cmd_source != cmd_source_t.src_command) {
        return
    }
    if (Cmd_Argc() != 2) {
        Con_Printf`va(cstr("play <demoname> : plays a demo\n"), VaNone())
        return
    }
    // disconnect from server
    CL_Disconnect()
    // open the demo file
    crt::strcpy(addr(name[0]), Cmd_Argv(1))
    COM_DefaultExtension(addr(name[0]), cstr(".dem"))
    Con_Printf`va(cstr("Playing demo from %s.\n"), (addr(name[0]),))
    COM_FOpenFile(addr(name[0]), addr(cls.demofile))
    if (cls.demofile == null) {
        Con_Printf`va(cstr("ERROR: couldn't open.\n"), VaNone())
        // stop demo loop
        cls.demonum = -1
        return
    }
    cls.demoplayback = qboolean._c_true
    cls.state = cactive_t.ca_connected
    cls.forcetrack = 0
    while (true) {
        c = crt::getc(reinterpret<void?>(cls.demofile))
        if (!(c != '\n')) {
            break
        }
        if (c == '-') {
            neg = qboolean._c_true
        } else {
            cls.forcetrack = cls.forcetrack * 10 + (c - '0')
        }
    }
    if (int(neg) != 0) {
        cls.forcetrack = -cls.forcetrack
    }
}

// ====================
// CL_FinishTimeDemo
// ====================
def CL_FinishTimeDemo {
    var frames : int
    var time : float
    cls.timedemo = qboolean._c_false
    // the first frame didn't count
    frames = (host_framecount - cls.td_startframe) - 1
    time = float(realtime - double(cls.td_starttime))
    if (time == 0.0f) {
        time = 1.0f
    }
    Con_Printf`va(cstr("%i frames %5.1f seconds %5.1f fps\n"), (frames, double(time), double(float(frames) / time)))
}

// ====================
// CL_TimeDemo_f
// timedemo [demoname]
// ====================
def CL_TimeDemo_f {
    if (cmd_source != cmd_source_t.src_command) {
        return
    }
    if (Cmd_Argc() != 2) {
        Con_Printf`va(cstr("timedemo <demoname> : gets demo speeds\n"), VaNone())
        return
    }
    CL_PlayDemo_f()
    // cls.td_starttime will be grabbed at the second frame of the demo, so
    // all the loading time doesn't get counted
    cls.timedemo = qboolean._c_true
    cls.td_startframe = host_framecount
    // get a new message this frame
    cls.td_lastframe = -1
}

