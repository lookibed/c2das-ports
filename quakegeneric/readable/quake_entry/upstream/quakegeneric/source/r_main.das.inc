// ===============
// R_NewMap
// ===============
[c_function]
def R_NewMap {
    var i : int
    // clear out efrags in case the level hasn't been reloaded
    // FIXME: is this one short?
    i = 0
    while (i < cl.worldmodel.numleafs) {
        cl.worldmodel.leafs[i].efrags = null
        i++
    }
    r_viewleaf = null
    R_ClearParticles()
    r_cnumsurfs = int(r_maxsurfs.value)
    if (r_cnumsurfs <= MINSURFACES) {
        r_cnumsurfs = MINSURFACES
    }
    if (r_cnumsurfs > NUMSTACKSURFACES) {
        surfaces = reinterpret<surf_s?>(Hunk_AllocName(int(uint64(r_cnumsurfs) * uint64(typeinfo sizeof(type<surf_s>))), cstr("surfaces")))
        surface_p = surfaces
        surf_max = addr(surfaces[r_cnumsurfs])
        r_surfsonstack = qboolean._c_false
        // surface 0 doesn't really exist; it's just a dummy because index 0
        // is used to indicate no edge attached to surface
        surfaces--
        R_SurfacePatch()
    } else {
        r_surfsonstack = qboolean._c_true
    }
    r_maxedgesseen = 0
    r_maxsurfsseen = 0
    r_numallocatededges = int(r_maxedges.value)
    if (r_numallocatededges < NUMSTACKEDGES) {
        r_numallocatededges = NUMSTACKEDGES
    }
    if (r_numallocatededges <= NUMSTACKEDGES) {
        auxedges = null
    } else {
        auxedges = reinterpret<edge_s?>(Hunk_AllocName(int(uint64(r_numallocatededges) * uint64(typeinfo sizeof(type<edge_s>))), cstr("edges")))
    }
    r_dowarpold = qboolean._c_false
    r_viewchanged = qboolean._c_false
}

// ===============
// R_SetVrect
// ===============
def R_SetVrect(var pvrectin : vrect_s?; var pvrect : vrect_s?; var lineadj : int) {
    var h : int
    var size : float
    size = scr_viewsize.value > 100.0f ? 100.0f : scr_viewsize.value
    if (cl.intermission != 0) {
        size = 100.0f
        lineadj = 0
    }
    size /= 100.0f
    h = pvrectin.height - lineadj
    pvrect.width = int(float(pvrectin.width) * size)
    if (pvrect.width < 96) {
        size = float(96.0lf / double(pvrectin.width))
        // min for icons
        pvrect.width = 96
    }
    pvrect.width &= ~7
    pvrect.height = int(float(pvrectin.height) * size)
    if (pvrect.height > pvrectin.height - lineadj) {
        pvrect.height = pvrectin.height - lineadj
    }
    pvrect.height &= ~1
    pvrect.x = (pvrectin.width - pvrect.width) / 2
    pvrect.y = (h - pvrect.height) / 2
    if (lcd_x.value != 0.0f) {
        pvrect.y >>= 1
        pvrect.height >>= 1
    }
}

// ===============
// R_ViewChanged
// Called every time the vid structure or r_refdef changes.
// Guaranteed to be called before the first refresh
// ===============
[c_function]
def R_ViewChanged(var pvrect : vrect_s?; lineadj : int; aspect : float) {
    var res_scale : float
    r_viewchanged = qboolean._c_true
    R_SetVrect(pvrect, addr(r_refdef.vrect), lineadj)
    r_refdef.horizontalFieldOfView = float(2.0lf * math::tan(double(r_refdef.fov_x / 360.0f) * 3.141592653589793lf))
    r_refdef.fvrectx = float(r_refdef.vrect.x)
    r_refdef.fvrectx_adj = float(double(float(r_refdef.vrect.x)) - 0.5lf)
    r_refdef.vrect_x_adj_shift20 = (r_refdef.vrect.x << 20) + (1 << 19) - 1
    r_refdef.fvrecty = float(r_refdef.vrect.y)
    r_refdef.fvrecty_adj = float(double(float(r_refdef.vrect.y)) - 0.5lf)
    r_refdef.vrectright = r_refdef.vrect.x + r_refdef.vrect.width
    r_refdef.vrectright_adj_shift20 = (r_refdef.vrectright << 20) + (1 << 19) - 1
    r_refdef.fvrectright = float(r_refdef.vrectright)
    r_refdef.fvrectright_adj = float(double(float(r_refdef.vrectright)) - 0.5lf)
    r_refdef.vrectrightedge = float(double(float(r_refdef.vrectright)) - 0.99lf)
    r_refdef.vrectbottom = r_refdef.vrect.y + r_refdef.vrect.height
    r_refdef.fvrectbottom = float(r_refdef.vrectbottom)
    r_refdef.fvrectbottom_adj = float(double(float(r_refdef.vrectbottom)) - 0.5lf)
    r_refdef.aliasvrect.x = int(float(r_refdef.vrect.x) * r_aliasuvscale)
    r_refdef.aliasvrect.y = int(float(r_refdef.vrect.y) * r_aliasuvscale)
    r_refdef.aliasvrect.width = int(float(r_refdef.vrect.width) * r_aliasuvscale)
    r_refdef.aliasvrect.height = int(float(r_refdef.vrect.height) * r_aliasuvscale)
    r_refdef.aliasvrectright = r_refdef.aliasvrect.x + r_refdef.aliasvrect.width
    r_refdef.aliasvrectbottom = r_refdef.aliasvrect.y + r_refdef.aliasvrect.height
    pixelAspect = aspect
    xOrigin = r_refdef.xOrigin
    yOrigin = r_refdef.yOrigin
    screenAspect = float(r_refdef.vrect.width) * pixelAspect / float(r_refdef.vrect.height)
    // 320*200 1.0 pixelAspect = 1.6 screenAspect
    // 320*240 1.0 pixelAspect = 1.3333 screenAspect
    // proper 320*200 pixelAspect = 0.8333333
    verticalFieldOfView = r_refdef.horizontalFieldOfView / screenAspect
    // values for perspective projection
    // if math were exact, the values would range from 0.5 to to range+0.5
    // hopefully they wll be in the 0.000001 to range+.999999 and truncate
    // the polygon rasterization will never render in the first row or column
    // but will definately render in the [range] row and column, so adjust the
    // buffer origin to get an exact edge to edge fill
    xcenter = float((double(float(r_refdef.vrect.width)) * XCENTERING) + double(r_refdef.vrect.x) - 0.5lf)
    aliasxcenter = xcenter * r_aliasuvscale
    ycenter = float((double(float(r_refdef.vrect.height)) * YCENTERING) + double(r_refdef.vrect.y) - 0.5lf)
    aliasycenter = ycenter * r_aliasuvscale
    xscale = float(r_refdef.vrect.width) / r_refdef.horizontalFieldOfView
    aliasxscale = xscale * r_aliasuvscale
    xscaleinv = float(1.0lf / double(xscale))
    yscale = xscale * pixelAspect
    aliasyscale = yscale * r_aliasuvscale
    yscaleinv = float(1.0lf / double(yscale))
    xscaleshrink = float(r_refdef.vrect.width - 6) / r_refdef.horizontalFieldOfView
    yscaleshrink = xscaleshrink * pixelAspect
    // left side clip
    screenedge[0].normal[0] = float(-1.0lf / double(xOrigin * r_refdef.horizontalFieldOfView))
    screenedge[0].normal[1] = 0.0f
    screenedge[0].normal[2] = 1.0f
    screenedge[0]._c_type = uint8(PLANE_ANYZ)
    // right side clip
    screenedge[1].normal[0] = float(1.0lf / ((1.0lf - double(xOrigin)) * double(r_refdef.horizontalFieldOfView)))
    screenedge[1].normal[1] = 0.0f
    screenedge[1].normal[2] = 1.0f
    screenedge[1]._c_type = uint8(PLANE_ANYZ)
    // top side clip
    screenedge[2].normal[0] = 0.0f
    screenedge[2].normal[1] = float(-1.0lf / double(yOrigin * verticalFieldOfView))
    screenedge[2].normal[2] = 1.0f
    screenedge[2]._c_type = uint8(PLANE_ANYZ)
    // bottom side clip
    screenedge[3].normal[0] = 0.0f
    screenedge[3].normal[1] = float(1.0lf / ((1.0lf - double(yOrigin)) * double(verticalFieldOfView)))
    screenedge[3].normal[2] = 1.0f
    screenedge[3]._c_type = uint8(PLANE_ANYZ)
    for (i in range(4)) {
        VectorNormalize(addr(screenedge[i].normal[0]))
    }
    res_scale = float(math::sqrt(double(r_refdef.vrect.width * r_refdef.vrect.height) / (320.0lf * 152.0lf)) * (2.0lf / double(r_refdef.horizontalFieldOfView)))
    r_aliastransition = r_aliastransbase.value * res_scale
    r_resfudge = r_aliastransadj.value * res_scale
    if (double(scr_fov.value) <= 90.0lf) {
        r_fov_greater_than_90 = qboolean._c_false
    } else {
        r_fov_greater_than_90 = qboolean._c_true
    }
    D_ViewChanged()
}

// ===============
// R_MarkLeaves
// ===============
[c_function]
def R_MarkLeaves {
    var vis : uint8?
    var node : mnode_s?
    var i : int
    if (r_oldviewleaf == r_viewleaf) {
        return
    }
    r_visframecount++
    r_oldviewleaf = r_viewleaf
    vis = Mod_LeafPVS(r_viewleaf, cl.worldmodel)
    i = 0
    while (i < cl.worldmodel.numleafs) {
        if ((int(vis[i >> 3]) & (1 << (i & 7))) != 0) {
            node = reinterpret<mnode_s?>(addr(cl.worldmodel.leafs[i + 1]))
            c_do_while(node != null) {
                if (node.visframe == r_visframecount) {
                    break
                }
                node.visframe = r_visframecount
                node = node.parent
            }
        }
        i++
    }
}

// =============
// R_DrawEntitiesOnList
// =============
[c_function]
def R_DrawEntitiesOnList {
    var i : int
    var j : int
    var lnum : int
    var lighting : alight_t
    // FIXME: remove and do real lighting
    var lightvec : float[3] = fixed_array(-1.0f, 0.0f, 0.0f)
    var dist : float[3]
    var add : float
    if (r_drawentities.value == 0.0f) {
        return
    }
    i = 0
    while (i < cl_numvisedicts) {
        {
            currententity = cl_visedicts[i]
            if (currententity == addr(cl_entities[0]) + end_index(cl.viewentity, 600)) {
                // don't draw the player
                continue
            }
            c_switch(currententity.model._c_type) {
                case(modtype_t.mod_sprite) {
                    r_entorigin[0] = currententity.origin[0]
                    r_entorigin[1] = currententity.origin[1]
                    r_entorigin[2] = currententity.origin[2]
                    modelorg[0] = r_origin[0] - r_entorigin[0]
                    modelorg[1] = r_origin[1] - r_entorigin[1]
                    modelorg[2] = r_origin[2] - r_entorigin[2]
                    R_DrawSprite()
                    break
                }
                case(modtype_t.mod_alias) {
                    r_entorigin[0] = currententity.origin[0]
                    r_entorigin[1] = currententity.origin[1]
                    r_entorigin[2] = currententity.origin[2]
                    modelorg[0] = r_origin[0] - r_entorigin[0]
                    modelorg[1] = r_origin[1] - r_entorigin[1]
                    modelorg[2] = r_origin[2] - r_entorigin[2]
                    // see if the bounding box lets us trivially reject, also sets
                    // trivial accept status
                    if (int(R_AliasCheckBBox()) != 0) {
                        j = R_LightPoint(addr(currententity.origin[0]))
                        lighting.ambientlight = j
                        lighting.shadelight = j
                        lighting.plightvec = addr(lightvec[0])
                        lnum = 0
                        while (lnum < MAX_DLIGHTS) {
                            if (double(cl_dlights[lnum].die) >= cl.time) {
                                dist[0] = currententity.origin[0] - cl_dlights[lnum].origin[0]
                                dist[1] = currententity.origin[1] - cl_dlights[lnum].origin[1]
                                dist[2] = currententity.origin[2] - cl_dlights[lnum].origin[2]
                                add = cl_dlights[lnum].radius - Length(addr(dist[0]))
                                if (add > 0.0f) {
                                    lighting.ambientlight = int(float(lighting.ambientlight) + add)
                                }
                            }
                            lnum++
                        }
                        // clamp lighting so it doesn't overbright as much
                        if (lighting.ambientlight > 128) {
                            lighting.ambientlight = 128
                        }
                        if (lighting.ambientlight + lighting.shadelight > 192) {
                            lighting.shadelight = 192 - lighting.ambientlight
                        }
                        R_AliasDrawModel(addr(lighting))
                    }
                    break
                }
                case(_) {
                    break
                }
            }
        } finally {
            i++
        }
    }
}

// =============
// R_DrawViewModel
// =============
[c_function]
def R_DrawViewModel {
    // FIXME: remove and do real lighting
    var lightvec : float[3] = fixed_array(-1.0f, 0.0f, 0.0f)
    var j : int
    var dist : float[3]
    var add : float
    var dl : dlight_t?
    if (r_drawviewmodel.value == 0.0f || uint(r_fov_greater_than_90) != 0) {
        return
    }
    if ((cl.items & IT_INVISIBILITY) != 0) {
        return
    }
    if (cl.stats[STAT_HEALTH] <= 0) {
        return
    }
    currententity = addr(cl.viewent)
    if (currententity.model == null) {
        return
    }
    r_entorigin[0] = currententity.origin[0]
    r_entorigin[1] = currententity.origin[1]
    r_entorigin[2] = currententity.origin[2]
    modelorg[0] = r_origin[0] - r_entorigin[0]
    modelorg[1] = r_origin[1] - r_entorigin[1]
    modelorg[2] = r_origin[2] - r_entorigin[2]
    viewlightvec[0] = vup[0]
    viewlightvec[1] = vup[1]
    viewlightvec[2] = vup[2]
    VectorInverse(addr(viewlightvec[0]))
    j = R_LightPoint(addr(currententity.origin[0]))
    if (j < 24) {
        // allways give some light on gun
        j = 24
    }
    r_viewlighting.ambientlight = j
    r_viewlighting.shadelight = j
    // add dynamic lights
    for (lnum in range(MAX_DLIGHTS)) {
        dl = addr(cl_dlights[0]) + end_index(lnum, 32)
        if (dl.radius == 0.0f) {
            continue
        }
        if (dl.radius == 0.0f) {
            continue
        }
        if (double(dl.die) < cl.time) {
            continue
        }
        dist[0] = currententity.origin[0] - dl.origin[0]
        dist[1] = currententity.origin[1] - dl.origin[1]
        dist[2] = currententity.origin[2] - dl.origin[2]
        add = dl.radius - Length(addr(dist[0]))
        if (add > 0.0f) {
            r_viewlighting.ambientlight = int(float(r_viewlighting.ambientlight) + add)
        }
    }
    // clamp lighting so it doesn't overbright as much
    if (r_viewlighting.ambientlight > 128) {
        r_viewlighting.ambientlight = 128
    }
    if (r_viewlighting.ambientlight + r_viewlighting.shadelight > 192) {
        r_viewlighting.shadelight = 192 - r_viewlighting.ambientlight
    }
    r_viewlighting.plightvec = addr(lightvec[0])
    R_AliasDrawModel(addr(r_viewlighting))
}

// =============
// R_BmodelCheckBBox
// =============
[c_function]
def R_BmodelCheckBBox(var clmodel : model_s?; var minmaxs : float?) : int {
    var pindex : int?
    var clipflags : int
    var acceptpt : float[3]
    var rejectpt : float[3]
    var d : double
    clipflags = 0
    if (currententity.angles[0] != 0.0f || currententity.angles[1] != 0.0f || currententity.angles[2] != 0.0f) {
        for (i in range(4)) {
            d = double(currententity.origin[0] * view_clipplanes[i].normal[0] + currententity.origin[1] * view_clipplanes[i].normal[1] +
                    currententity.origin[2] * view_clipplanes[i].normal[2])
            d -= double(view_clipplanes[i].dist)
            if (d <= double(-clmodel.radius)) {
                return BMODEL_FULLY_CLIPPED
            }
            if (d <= double(clmodel.radius)) {
                clipflags |= 1 << i
            }
        }
    } else {
        for (i in range(4)) {
            // generate accept and reject points
            // FIXME: do with fast look-ups or integer tests based on the sign bit
            // of the floating point values
            pindex = pfrustum_indexes[i]
            rejectpt[0] = minmaxs[pindex[0]]
            rejectpt[1] = minmaxs[pindex[1]]
            rejectpt[2] = minmaxs[pindex[2]]
            d = double(rejectpt[0] * view_clipplanes[i].normal[0] + rejectpt[1] * view_clipplanes[i].normal[1] + rejectpt[2] * view_clipplanes[i].normal[2])
            d -= double(view_clipplanes[i].dist)
            if (d <= 0.0lf) {
                return BMODEL_FULLY_CLIPPED
            }
            acceptpt[0] = minmaxs[pindex[3 + 0]]
            acceptpt[1] = minmaxs[pindex[3 + 1]]
            acceptpt[2] = minmaxs[pindex[3 + 2]]
            d = double(acceptpt[0] * view_clipplanes[i].normal[0] + acceptpt[1] * view_clipplanes[i].normal[1] + acceptpt[2] * view_clipplanes[i].normal[2])
            d -= double(view_clipplanes[i].dist)
            if (d <= 0.0lf) {
                clipflags |= 1 << i
            }
        }
    }
    return clipflags
}

// =============
// R_DrawBEntitiesOnList
// =============
[c_function]
def R_DrawBEntitiesOnList {
    var i : int
    var j : int
    var k : int
    var clipflags : int
    var oldorigin : float[3]
    var clmodel : model_s?
    var minmaxs : float[6]
    if (r_drawentities.value == 0.0f) {
        return
    }
    oldorigin[0] = modelorg[0]
    oldorigin[1] = modelorg[1]
    oldorigin[2] = modelorg[2]
    insubmodel = qboolean._c_true
    r_dlightframecount = r_framecount
    i = 0
    while (i < cl_numvisedicts) {
        currententity = cl_visedicts[i]
        c_switch(currententity.model._c_type) {
            case(modtype_t.mod_brush) {
                clmodel = currententity.model
                // see if the bounding box lets us trivially reject, also sets
                // trivial accept status
                j = 0
                while (j < 3) {
                    minmaxs[j] = currententity.origin[j] + clmodel.mins[j]
                    minmaxs[3 + j] = currententity.origin[j] + clmodel.maxs[j]
                    j++
                }
                clipflags = R_BmodelCheckBBox(clmodel, addr(minmaxs[0]))
                if (clipflags != BMODEL_FULLY_CLIPPED) {
                    r_entorigin[0] = currententity.origin[0]
                    r_entorigin[1] = currententity.origin[1]
                    r_entorigin[2] = currententity.origin[2]
                    modelorg[0] = r_origin[0] - r_entorigin[0]
                    modelorg[1] = r_origin[1] - r_entorigin[1]
                    modelorg[2] = r_origin[2] - r_entorigin[2]
                    // FIXME: is this needed?
                    r_worldmodelorg[0] = modelorg[0]
                    r_worldmodelorg[1] = modelorg[1]
                    r_worldmodelorg[2] = modelorg[2]
                    r_pcurrentvertbase = clmodel.vertexes
                    // FIXME: stop transforming twice
                    R_RotateBmodel()
                    // calculate dynamic lighting for bmodel if it's not an
                    // instanced model
                    if (clmodel.firstmodelsurface != 0) {
                        k = 0
                        while (k < MAX_DLIGHTS) {
                            {
                                if ((double(cl_dlights[k].die) < cl.time) || (cl_dlights[k].radius == 0.0f)) {
                                    continue
                                }
                                R_MarkLights(addr(cl_dlights[0]) + end_index(k, 32), 1 << k, clmodel.nodes + clmodel.hulls[0].firstclipnode)
                            } finally {
                                k++
                            }
                        }
                    }
                    // if the driver wants polygons, deliver those. Z-buffering is on
                    // at this point, so no clipping to the world tree is needed, just
                    // frustum clipping
                    if ((uint(r_drawpolys) | uint(r_drawculledpolys)) != 0) {
                        R_ZDrawSubmodelPolys(clmodel)
                    } else {
                        r_pefragtopnode = null
                        j = 0
                        while (j < 3) {
                            r_emins[j] = minmaxs[j]
                            r_emaxs[j] = minmaxs[3 + j]
                            j++
                        }
                        R_SplitEntityOnNode2(cl.worldmodel.nodes)
                        if (r_pefragtopnode != null) {
                            currententity.topnode = r_pefragtopnode
                            if (r_pefragtopnode.contents >= 0) {
                                // not a leaf; has to be clipped to the world BSP
                                r_clipflags = clipflags
                                R_DrawSolidClippedSubmodelPolygons(clmodel)
                            } else {
                                // falls entirely in one leaf, so we just put all the
                                // edges in the edge list and let 1/z sorting handle
                                // drawing order
                                R_DrawSubmodelPolygons(clmodel, clipflags)
                            }
                            currententity.topnode = null
                        }
                    }
                    // put back world rotation and frustum clipping
                    // FIXME: R_RotateBmodel should just work off base_vxx
                    vpn[0] = base_vpn[0]
                    vpn[1] = base_vpn[1]
                    vpn[2] = base_vpn[2]
                    vup[0] = base_vup[0]
                    vup[1] = base_vup[1]
                    vup[2] = base_vup[2]
                    vright[0] = base_vright[0]
                    vright[1] = base_vright[1]
                    vright[2] = base_vright[2]
                    modelorg[0] = base_modelorg[0]
                    modelorg[1] = base_modelorg[1]
                    modelorg[2] = base_modelorg[2]
                    modelorg[0] = oldorigin[0]
                    modelorg[1] = oldorigin[1]
                    modelorg[2] = oldorigin[2]
                    R_TransformFrustum()
                }
                break
            }
            case(_) {
                break
            }
        }
        i++
    }
    insubmodel = qboolean._c_false
}

// ================
// R_EdgeDrawing
// ================
[c_function]
def R_EdgeDrawing {
    var ledges : edge_s[2401]
    var lsurfs : surf_s[801]
    if (auxedges != null) {
        r_edges = auxedges
    } else {
        r_edges = reinterpret<edge_s?>(uint64((int64(intptr(addr(ledges[0]))) + int64(CACHE_SIZE) - 1l) & int64(~(CACHE_SIZE - 1))))
    }
    if (int(r_surfsonstack) != 0) {
        surfaces = reinterpret<surf_s?>(uint64((int64(intptr(addr(lsurfs[0]))) + int64(CACHE_SIZE) - 1l) & int64(~(CACHE_SIZE - 1))))
        surf_max = addr(surfaces[r_cnumsurfs])
        // surface 0 doesn't really exist; it's just a dummy because index 0
        // is used to indicate no edge attached to surface
        surfaces--
        R_SurfacePatch()
    }
    R_BeginEdgeFrame()
    if (r_dspeeds.value != 0.0f) {
        rw_time1 = float(Sys_FloatTime())
    }
    R_RenderWorld()
    if (int(r_drawculledpolys) != 0) {
        R_ScanEdges()
    }
    // only the world can be drawn back to front with no z reads or compares, just
    // z writes, so have the driver turn z compares on now
    D_TurnZOn()
    if (r_dspeeds.value != 0.0f) {
        rw_time2 = float(Sys_FloatTime())
        db_time1 = rw_time2
    }
    R_DrawBEntitiesOnList()
    if (r_dspeeds.value != 0.0f) {
        db_time2 = float(Sys_FloatTime())
        se_time1 = db_time2
    }
    if (r_dspeeds.value == 0.0f) {
        // don't let sound get messed up if going slow
        S_ExtraUpdate()
    }
    if ((uint(r_drawpolys) | uint(r_drawculledpolys)) == 0) {
        R_ScanEdges()
    }
}

// ================
// R_RenderView
// r_refdef must be set before the first call
// ================
[c_function]
def R_RenderView_ {
    var warpbuffer : uint8[64000]
    r_warpbuffer = addr(warpbuffer[0])
    if (r_timegraph.value != 0.0f || r_speeds.value != 0.0f || r_dspeeds.value != 0.0f) {
        r_time1 = float(Sys_FloatTime())
    }
    R_SetupFrame()
    // done here so we know if we're in water
    R_MarkLeaves()
    // make FDIV fast. This reduces timing precision after we've been running for a
    // while, so we don't do it globally. This also sets chop mode, and we do it
    // here so that setup stuff like the refresh area calculations match what's
    // done in screen.c
    Sys_LowFPPrecision()
    if (cl_entities[0].model == null || cl.worldmodel == null) {
        Sys_Error`va(cstr("R_RenderView: NULL worldmodel"), VaNone())
    }
    if (r_dspeeds.value == 0.0f) {
        // don't let sound get messed up if going slow
        S_ExtraUpdate()
    }
    R_EdgeDrawing()
    if (r_dspeeds.value == 0.0f) {
        // don't let sound get messed up if going slow
        S_ExtraUpdate()
    }
    if (r_dspeeds.value != 0.0f) {
        se_time2 = float(Sys_FloatTime())
        de_time1 = se_time2
    }
    R_DrawEntitiesOnList()
    if (r_dspeeds.value != 0.0f) {
        de_time2 = float(Sys_FloatTime())
        dv_time1 = de_time2
    }
    R_DrawViewModel()
    if (r_dspeeds.value != 0.0f) {
        dv_time2 = float(Sys_FloatTime())
        dp_time1 = float(Sys_FloatTime())
    }
    R_DrawParticles()
    if (r_dspeeds.value != 0.0f) {
        dp_time2 = float(Sys_FloatTime())
    }
    if (int(r_dowarp) != 0) {
        D_WarpScreen()
    }
    V_SetContentsColor(r_viewleaf.contents)
    if (r_timegraph.value != 0.0f) {
        R_TimeGraph()
    }
    if (r_aliasstats.value != 0.0f) {
        R_PrintAliasStats()
    }
    if (r_speeds.value != 0.0f) {
        R_PrintTimes()
    }
    if (r_dspeeds.value != 0.0f) {
        R_PrintDSpeeds()
    }
    if (r_reportsurfout.value != 0.0f && r_outofsurfaces != 0) {
        Con_Printf`va(cstr("Short %d surfaces\n"), (r_outofsurfaces,))
    }
    if (r_reportedgeout.value != 0.0f && r_outofedges != 0) {
        Con_Printf`va(cstr("Short roughly %d edges\n"), (r_outofedges * 2 / 3,))
    }
    // back to high floating-point precision
    Sys_HighFPPrecision()
}

[c_function]
def R_RenderView {
    var dummy : int
    var delta : int
    delta = int(int64(reinterpret<uint8?>(addr(dummy)) - r_stack_start))
    if (delta < -10000 || delta > 10000) {
        Sys_Error`va(cstr("R_RenderView: called without enough stack"), VaNone())
    }
    if ((Hunk_LowMark() & 3) != 0) {
        Sys_Error`va(cstr("Hunk is missaligned"), VaNone())
    }
    if ((int64(intptr(addr(dummy))) & 3l) != 0) {
        Sys_Error`va(cstr("Stack is missaligned"), VaNone())
    }
    if ((int64(intptr(addr(r_warpbuffer))) & 3l) != 0) {
        Sys_Error`va(cstr("Globals are missaligned"), VaNone())
    }
    R_RenderView_()
}

// ================
// R_InitTurb
// ================
def R_InitTurb {
    var i : int
    i = 0
    while (i < ((MAXHEIGHT > MAXWIDTH ? MAXHEIGHT : MAXWIDTH) + CYCLE)) {
        sintable[i] = int(double(AMP) + math::sin(double(i) * 3.14159lf * 2.0lf / double(CYCLE)) * 8.0lf * 65536.0lf)
        // AMP2, not 20
        intsintable[i] = int(double(AMP2) + math::sin(double(i) * 3.14159lf * 2.0lf / double(CYCLE)) * double(AMP2))
        i++
    }
}

