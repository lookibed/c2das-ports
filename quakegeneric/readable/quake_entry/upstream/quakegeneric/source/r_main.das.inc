// ==================
// R_InitTextures
// ==================
[c_function]
def R_InitTextures {
    var x : int
    var y : int
    var dest : uint8?
    // create a simple checkerboard texture for the default
    r_notexture_mip = reinterpret<texture_s?>(Hunk_AllocName(int(uint64(typeinfo sizeof(type<texture_s>)) + uint64(16 * 16) + uint64(8 * 8) + uint64(4 * 4) +
                uint64(2 * 2)),
            cstr("notexture")))
    r_notexture_mip.height = 16u
    r_notexture_mip.width = r_notexture_mip.height
    r_notexture_mip.offsets[0] = uint(uint64(typeinfo sizeof(type<texture_s>)))
    r_notexture_mip.offsets[1] = r_notexture_mip.offsets[0] + uint(16 * 16)
    r_notexture_mip.offsets[2] = r_notexture_mip.offsets[1] + uint(8 * 8)
    r_notexture_mip.offsets[3] = r_notexture_mip.offsets[2] + uint(4 * 4)
    for (m in range(4)) {
        dest = reinterpret<uint8?>(r_notexture_mip) + r_notexture_mip.offsets[m]
        y = 0
        while (y < (16 >> m)) {
            x = 0
            while (x < (16 >> m)) {
                if ((int_of(y < (8 >> m)) ^ int_of(x < (8 >> m))) != 0) {
                    var _t0 = dest
                    dest++
                    *_t0 = 0u8
                } else {
                    var _t1 = dest
                    dest++
                    *_t1 = 255u8
                }
                x++
            }
            y++
        }
    }
}

