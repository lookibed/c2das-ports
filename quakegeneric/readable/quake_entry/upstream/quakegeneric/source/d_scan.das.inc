// =============
// D_WarpScreen
// this performs a slight compression of the screen at the same time as
// the sine warp, to keep the edges from wrapping
// =============
[c_function]
def D_WarpScreen {
    var w : int
    var h : int
    var u : int
    var v : int
    var dest : uint8?
    var turb : int?
    var col : int?
    var row : uint8 ??
    var rowptr : uint8? [1030]
    var column : int[1286]
    var wratio : float
    var hratio : float
    w = r_refdef.vrect.width
    h = r_refdef.vrect.height
    wratio = float(w) / float(scr_vrect.width)
    hratio = float(h) / float(scr_vrect.height)
    for (v1 in range(scr_vrect.height + AMP2 * 2)) {
        rowptr[v1] = d_viewbuffer + (r_refdef.vrect.y * screenwidth) + (screenwidth * int(float(v1) * hratio * float(h) / float(h + AMP2 * 2)))
    }
    for (u1 in range(scr_vrect.width + AMP2 * 2)) {
        column[u1] = r_refdef.vrect.x + int(float(u1) * wratio * float(w) / float(w + AMP2 * 2))
    }
    turb = addr(intsintable[0]) + (int(cl.time * double(SPEED)) & (CYCLE - 1))
    dest = vid.buffer + uint(scr_vrect.y) * vid.rowbytes + scr_vrect.x
    v = 0
    while (v < scr_vrect.height) {
        col = addr(column[0]) + end_index(turb[v], 1286)
        row = addr(rowptr[0]) + end_index(v, 1030)
        u = 0
        while (u < scr_vrect.width) {
            dest[u + 0] = row[turb[u + 0]][col[u + 0]]
            dest[u + 1] = row[turb[u + 1]][col[u + 1]]
            dest[u + 2] = row[turb[u + 2]][col[u + 2]]
            dest[u + 3] = row[turb[u + 3]][col[u + 3]]
            u += 4
        }
        v++
        dest += vid.rowbytes
    }
}

