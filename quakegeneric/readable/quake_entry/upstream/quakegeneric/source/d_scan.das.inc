// =============
// D_DrawZSpans
// =============
[c_function]
def D_DrawZSpans(var pspan : espan_s?) {
    var count : int
    var doublecount : int
    var izistep : int
    var izi : int
    var pdest : int16?
    var ltemp : uint
    var zi : double
    var du : float
    var dv : float
    // FIXME: check for clamping/range problems
    // we count on FP exceptions being turned off to avoid range problems
    izistep = int(d_zistepu * 32768.0f * 65536.0f)
    while (true) {
        pdest = d_pzbuffer + (d_zwidth * uint(pspan.v)) + pspan.u
        count = pspan.count
        // calculate the initial 1/z
        du = float(pspan.u)
        dv = float(pspan.v)
        zi = double(d_ziorigin + dv * d_zistepv + du * d_zistepu)
        // we count on FP exceptions being turned off to avoid range problems
        izi = int(zi * 32768.0lf * 65536.0lf)
        if ((int64(intptr(pdest)) & 2l) != 0) {
            var _t0 = pdest
            pdest++
            *_t0 = int16(izi >> 16)
            izi += izistep
            count--
        }
        doublecount = count >> 1
        if (doublecount > 0) {
            while (true) {
                ltemp = uint(izi >> 16)
                izi += izistep
                ltemp |= uint(izi) & 4294901760u
                izi += izistep
                *reinterpret<int?>(pdest) = int(ltemp)
                pdest += 2
                doublecount--
                if (!(doublecount > 0)) {
                    break
                }
            }
        }
        if ((count & 1) != 0) {
            *pdest = int16(izi >> 16)
        }
        pspan = pspan.pnext
        if (!(pspan != null)) {
            break
        }
    }
}

