// ==================
// Host_Status_f
// ==================
[c_function]
def Host_Status_f {
    var client : client_s?
    var seconds : int
    var minutes : int
    var hours : int = 0
    var j : int
    var _c_print : function<(var a0 : uint8?; a1 : CVaList) : void>
    if (cmd_source == cmd_source_t.src_command) {
        if (int(sv.active) == 0) {
            Cmd_ForwardToServer()
            return
        }
        _c_print = @@Con_Printf__va_list
    } else {
        _c_print = @@SV_ClientPrintf__va_list
    }
    invoke(_c_print, cstr("host:    %s\n"), to_cvalist((Cvar_VariableString(cstr("hostname")),)))
    invoke(_c_print, cstr("version: %4.2f\n"), to_cvalist((VERSION,)))
    if (int(tcpipAvailable) != 0) {
        invoke(_c_print, cstr("tcp/ip:  %s\n"), to_cvalist((addr(my_tcpip_address[0]),)))
    }
    if (int(ipxAvailable) != 0) {
        invoke(_c_print, cstr("ipx:     %s\n"), to_cvalist((addr(my_ipx_address[0]),)))
    }
    invoke(_c_print, cstr("map:     %s\n"), to_cvalist((addr(sv.name[0]),)))
    invoke(_c_print, cstr("players: %i active (%i max)\n\n"), to_cvalist((net_activeconnections, svs.maxclients)))
    j = 0
    client = svs.clients
    while (j < svs.maxclients) {
        {
            if (int(client.active) == 0) {
                continue
            }
            seconds = int(net_time - client.netconnection.connecttime)
            minutes = seconds / 60
            if (minutes != 0) {
                seconds -= minutes * 60
                hours = minutes / 60
                if (hours != 0) {
                    minutes -= hours * 60
                }
            } else {
                hours = 0
            }
            invoke(_c_print, cstr("#%-2u %-16.16s  %3i  %2i:%02i:%02i\n"),
                    to_cvalist((j + 1, addr(client.name[0]), int(client.edict.v.frags), hours, minutes, seconds)))
            invoke(_c_print, cstr("   %s\n"), to_cvalist((addr(client.netconnection.address[0]),)))
        } finally {
            j++
            client++
        }
    }
}

