// ===============
// Host_SavegameComment
// Writes a SAVEGAME_COMMENT_LENGTH character comment describing the current
// ===============
[c_function]
def Host_SavegameComment(var text : uint8?) {
    var kills : uint8[20]
    for (i in range(SAVEGAME_COMMENT_LENGTH)) {
        text[i] = uint8(' ')
    }
    crt::memcpy(reinterpret<void?>(text), reinterpret<void?>(addr(cl.levelname[0])), crt::strlen(addr(cl.levelname[0])))
    sprintf(addr(kills[0]), cstr("kills:%3i/%3i"), cl.stats[STAT_MONSTERS], cl.stats[STAT_TOTALMONSTERS])
    crt::memcpy(reinterpret<void?>(text + 22), reinterpret<void?>(addr(kills[0])), crt::strlen(addr(kills[0])))
    // convert space to _ to make stdio happy
    for (i in range(SAVEGAME_COMMENT_LENGTH)) {
        if (text[i] == ' ') {
            text[i] = uint8('_')
        }
    }
    text[SAVEGAME_COMMENT_LENGTH] = uint8('\0')
}

// ===============
// Host_Savegame_f
// ===============
[c_function]
def Host_Savegame_f {
    var name : uint8[256]
    var f : _IO_FILE?
    var i : int
    var comment : uint8[40]
    if (cmd_source != cmd_source_t.src_command) {
        return
    }
    if (int(sv.active) == 0) {
        Con_Printf`va(cstr("Not playing a local game.\n"), VaNone())
        return
    }
    if (cl.intermission != 0) {
        Con_Printf`va(cstr("Can't save in intermission.\n"), VaNone())
        return
    }
    if (svs.maxclients != 1) {
        Con_Printf`va(cstr("Can't save multiplayer games.\n"), VaNone())
        return
    }
    if (Cmd_Argc() != 2) {
        Con_Printf`va(cstr("save <savename> : save a game\n"), VaNone())
        return
    }
    if (crt::strstr(Cmd_Argv(1), cstr("..")) != null) {
        Con_Printf`va(cstr("Relative pathnames are not allowed.\n"), VaNone())
        return
    }
    i = 0
    while (i < svs.maxclients) {
        if (uint(svs.clients[i].active) != 0 && (svs.clients[i].edict.v.health <= 0.0f)) {
            Con_Printf`va(cstr("Can't savegame with a dead player\n"), VaNone())
            return
        }
        i++
    }
    sprintf(addr(name[0]), cstr("%s/%s"), addr(com_gamedir[0]), Cmd_Argv(1))
    COM_DefaultExtension(addr(name[0]), cstr(".sav"))
    Con_Printf`va(cstr("Saving game to %s...\n"), (addr(name[0]),))
    f = reinterpret<_IO_FILE?>(crt::fopen(addr(name[0]), cstr("w")))
    if (f == null) {
        Con_Printf`va(cstr("ERROR: couldn't open.\n"), VaNone())
        return
    }
    fprintf(reinterpret<void?>(f), cstr("%i\n"), SAVEGAME_VERSION)
    Host_SavegameComment(addr(comment[0]))
    fprintf(reinterpret<void?>(f), cstr("%s\n"), addr(comment[0]))
    for (i1 in range(NUM_SPAWN_PARMS)) {
        fprintf(reinterpret<void?>(f), cstr("%f\n"), double(svs.clients.spawn_parms[i1]))
    }
    fprintf(reinterpret<void?>(f), cstr("%d\n"), current_skill)
    fprintf(reinterpret<void?>(f), cstr("%s\n"), addr(sv.name[0]))
    fprintf(reinterpret<void?>(f), cstr("%f\n"), sv.time)
    // write the light styles
    for (i1 in range(MAX_LIGHTSTYLES)) {
        if (sv.lightstyles[i1] != null) {
            fprintf(reinterpret<void?>(f), cstr("%s\n"), sv.lightstyles[i1])
        } else {
            fprintf(reinterpret<void?>(f), cstr("m\n"))
        }
    }
    ED_WriteGlobals(f)
    i = 0
    while (i < sv.num_edicts) {
        ED_Write(f, EDICT_NUM(i))
        crt::fflush(reinterpret<void?>(f))
        i++
    }
    crt::fclose(reinterpret<void?>(f))
    Con_Printf`va(cstr("done.\n"), VaNone())
}

// ===============
// Host_Loadgame_f
// ===============
[c_function]
def Host_Loadgame_f {
    var name : uint8[128]
    var f : _IO_FILE?
    var mapname : uint8[64]
    var time : float
    var tfloat : float
    var str : uint8[32768]
    var start : uint8?
    var i : int
    var r : int
    var ent : edict_s?
    var entnum : int
    var version : int
    var spawn_parms : float[16]
    if (cmd_source != cmd_source_t.src_command) {
        return
    }
    if (Cmd_Argc() != 2) {
        Con_Printf`va(cstr("load <savename> : load a game\n"), VaNone())
        return
    }
    // stop demo loop in case this fails
    cls.demonum = -1
    sprintf(addr(name[0]), cstr("%s/%s"), addr(com_gamedir[0]), Cmd_Argv(1))
    COM_DefaultExtension(addr(name[0]), cstr(".sav"))
    // we can't call SCR_BeginLoadingPlaque, because too much stack space has
    // been used. The menu calls it before stuffing loadgame command
    // SCR_BeginLoadingPlaque ();
    Con_Printf`va(cstr("Loading game from %s...\n"), (addr(name[0]),))
    f = reinterpret<_IO_FILE?>(crt::fopen(addr(name[0]), cstr("r")))
    if (f == null) {
        Con_Printf`va(cstr("ERROR: couldn't open.\n"), VaNone())
        return
    }
    fscanf(reinterpret<void?>(f), cstr("%i\n"), addr(version))
    if (version != SAVEGAME_VERSION) {
        crt::fclose(reinterpret<void?>(f))
        Con_Printf`va(cstr("Savegame is version %i, not %i\n"), (version, SAVEGAME_VERSION))
        return
    }
    fscanf(reinterpret<void?>(f), cstr("%s\n"), addr(str[0]))
    for (i1 in range(NUM_SPAWN_PARMS)) {
        fscanf(reinterpret<void?>(f), cstr("%f\n"), addr(spawn_parms[0]) + end_index(i1, 16))
    }
    // this silliness is so we can load 1.06 save files, which have float skill values
    fscanf(reinterpret<void?>(f), cstr("%f\n"), addr(tfloat))
    current_skill = int(double(tfloat) + 0.1lf)
    Cvar_SetValue(cstr("skill"), float(current_skill))
    fscanf(reinterpret<void?>(f), cstr("%s\n"), addr(mapname[0]))
    fscanf(reinterpret<void?>(f), cstr("%f\n"), addr(time))
    CL_Disconnect_f()
    SV_SpawnServer(addr(mapname[0]))
    if (int(sv.active) == 0) {
        Con_Printf`va(cstr("Couldn't load map\n"), VaNone())
        return
    }
    // pause until all clients connect
    sv.paused = qboolean._c_true
    sv.loadgame = qboolean._c_true
    // load the light styles
    for (i1 in range(MAX_LIGHTSTYLES)) {
        fscanf(reinterpret<void?>(f), cstr("%s\n"), addr(str[0]))
        sv.lightstyles[i1] = reinterpret<uint8?>(Hunk_Alloc(int(crt::strlen(addr(str[0])) + 1ul)))
        crt::strcpy(sv.lightstyles[i1], addr(str[0]))
    }
    // load the edicts out of the savegame file
    // -1 is the globals
    entnum = -1
    while (crt::feof(reinterpret<void?>(f)) == 0) {
        i = 0
        while (uint64(i) < uint64(typeinfo sizeof(type<uint8[32768]>)) - 1ul) {
            r = crt::fgetc(reinterpret<void?>(f))
            if (r == -1 || r == 0) {
                break
            }
            str[i] = uint8(r)
            if (r == '}') {
                i++
                break
            }
            i++
        }
        if (uint64(i) == uint64(typeinfo sizeof(type<uint8[32768]>)) - 1ul) {
            Sys_Error`va(cstr("Loadgame buffer overflow"), VaNone())
        }
        str[i] = 0u8
        start = addr(str[0])
        start = COM_Parse(addr(str[0]))
        if (com_token[0] == 0) {
            // end of file
            break
        }
        if (crt::strcmp(addr(com_token[0]), cstr("\{")) != 0) {
            Sys_Error`va(cstr("First token isn't a brace"), VaNone())
        }
        if (entnum == -1) {
            // parse the global vars
            ED_ParseGlobals(start)
        } else {
            // parse an edict
            ent = EDICT_NUM(entnum)
            crt::memset(reinterpret<void?>(addr(ent.v)), 0, uint64(progs.entityfields * 4))
            ent.free = qboolean._c_false
            ED_ParseEdict(start, ent)
            // link it into the bsp tree
            if (int(ent.free) == 0) {
                SV_LinkEdict(ent, qboolean._c_false)
            }
        }
        entnum++
    }
    sv.num_edicts = entnum
    sv.time = double(time)
    crt::fclose(reinterpret<void?>(f))
    for (i1 in range(NUM_SPAWN_PARMS)) {
        svs.clients.spawn_parms[i1] = spawn_parms[i1]
    }
    if (cls.state != cactive_t.ca_dedicated) {
        CL_EstablishConnection(cstr("local"))
        Host_Reconnect_f()
    }
}

