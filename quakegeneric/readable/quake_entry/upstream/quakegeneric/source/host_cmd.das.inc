// ==================
// Host_Spawn_f
// ==================
[c_function]
def Host_Spawn_f {
    var i : int
    var client : client_s?
    var ent : edict_s?
    if (cmd_source == cmd_source_t.src_command) {
        Con_Printf`va(cstr("spawn is not valid from the console\n"), VaNone())
        return
    }
    if (int(host_client.spawned) != 0) {
        Con_Printf`va(cstr("Spawn not valid -- allready spawned\n"), VaNone())
        return
    }
    // run the entrance script
    if (int(sv.loadgame) != 0) {
        // loaded games are fully inited allready
        // if this is the last client to be connected, unpause
        sv.paused = qboolean._c_false
    } else {
        // set up the edict
        ent = host_client.edict
        crt::memset(reinterpret<void?>(addr(ent.v)), 0, uint64(progs.entityfields * 4))
        ent.v.colormap = float(NUM_FOR_EDICT(ent))
        ent.v.team = float((host_client.colors & 15) + 1)
        ent.v.netname = int(int64(addr(host_client.name[0]) - pr_strings))
        // copy spawn parms out of the client_t
        i = 0
        while (i < NUM_SPAWN_PARMS) {
            addr(pr_global_struct.parm1)[i] = host_client.spawn_parms[i]
            i++
        }
        // call the spawn function
        pr_global_struct.time = float(sv.time)
        pr_global_struct.self = int(EDICT_TO_PROG(sv_player))
        PR_ExecuteProgram(pr_global_struct.ClientConnect)
        if ((Sys_FloatTime() - host_client.netconnection.connecttime) <= sv.time) {
            Sys_Printf`va(cstr("%s entered the game\n"), (addr(host_client.name[0]),))
        }
        PR_ExecuteProgram(pr_global_struct.PutClientInServer)
    }
    // send all current names, colors, and frag counts
    SZ_Clear(addr(host_client.message))
    // send time of update
    MSG_WriteByte(addr(host_client.message), svc_time)
    MSG_WriteFloat(addr(host_client.message), float(sv.time))
    i = 0
    client = svs.clients
    while (i < svs.maxclients) {
        MSG_WriteByte(addr(host_client.message), svc_updatename)
        MSG_WriteByte(addr(host_client.message), i)
        MSG_WriteString(addr(host_client.message), addr(client.name[0]))
        MSG_WriteByte(addr(host_client.message), svc_updatefrags)
        MSG_WriteByte(addr(host_client.message), i)
        MSG_WriteShort(addr(host_client.message), client.old_frags)
        MSG_WriteByte(addr(host_client.message), svc_updatecolors)
        MSG_WriteByte(addr(host_client.message), i)
        MSG_WriteByte(addr(host_client.message), client.colors)
        i++
        client++
    }
    // send all current light styles
    for (i1 in range(MAX_LIGHTSTYLES)) {
        MSG_WriteByte(addr(host_client.message), svc_lightstyle)
        MSG_WriteByte(addr(host_client.message), int(uint8(i1)))
        MSG_WriteString(addr(host_client.message), sv.lightstyles[i1])
    }
    // send some stats
    MSG_WriteByte(addr(host_client.message), svc_updatestat)
    MSG_WriteByte(addr(host_client.message), STAT_TOTALSECRETS)
    MSG_WriteLong(addr(host_client.message), int(pr_global_struct.total_secrets))
    MSG_WriteByte(addr(host_client.message), svc_updatestat)
    MSG_WriteByte(addr(host_client.message), STAT_TOTALMONSTERS)
    MSG_WriteLong(addr(host_client.message), int(pr_global_struct.total_monsters))
    MSG_WriteByte(addr(host_client.message), svc_updatestat)
    MSG_WriteByte(addr(host_client.message), STAT_SECRETS)
    MSG_WriteLong(addr(host_client.message), int(pr_global_struct.found_secrets))
    MSG_WriteByte(addr(host_client.message), svc_updatestat)
    MSG_WriteByte(addr(host_client.message), STAT_MONSTERS)
    MSG_WriteLong(addr(host_client.message), int(pr_global_struct.killed_monsters))
    // send a fixangle
    // Never send a roll angle, because savegames can catch the server
    // in a state where it is expecting the client to correct the angle
    // and it won't happen if the game was just loaded, so you wind up
    // with a permanent head tilt
    ent = EDICT_NUM(int(1l + int64(host_client - svs.clients)))
    MSG_WriteByte(addr(host_client.message), svc_setangle)
    for (i1 in range(2)) {
        MSG_WriteAngle(addr(host_client.message), ent.v.angles[i1])
    }
    MSG_WriteAngle(addr(host_client.message), 0.0f)
    SV_WriteClientdataToMessage(sv_player, addr(host_client.message))
    MSG_WriteByte(addr(host_client.message), svc_signonnum)
    MSG_WriteByte(addr(host_client.message), 3)
    host_client.sendsignon = qboolean._c_true
}

