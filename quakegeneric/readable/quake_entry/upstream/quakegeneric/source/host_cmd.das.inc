[c_function]
def Host_Say(var teamonly : qboolean) {
    var client : client_s?
    var save : client_s?
    var j : int
    var p : uint8?
    var text : uint8[64]
    var fromServer : qboolean = qboolean._c_false
    if (cmd_source == cmd_source_t.src_command) {
        if (cls.state == cactive_t.ca_dedicated) {
            fromServer = qboolean._c_true
            teamonly = qboolean._c_false
        } else {
            Cmd_ForwardToServer()
            return
        }
    }
    if (Cmd_Argc() < 2) {
        return
    }
    save = host_client
    p = Cmd_Args()
    // remove quotes if present
    if (*p == '"') {
        p++
        p[Q_strlen(p) - 1] = 0u8
    }
    // turn on color set 1
    if (int(fromServer) == 0) {
        sprintf(reinterpret<uint8?>(addr(text[0])), cstr("%c%s: "), 1, addr(save.name[0]))
    } else {
        sprintf(reinterpret<uint8?>(addr(text[0])), cstr("%c<%s> "), 1, hostname._c_string)
    }
    // -2 for /n and null terminator
    j = int(uint64(typeinfo sizeof(type<uint8[64]>)) - 2ul - uint64(Q_strlen(reinterpret<uint8?>(addr(text[0])))))
    if (Q_strlen(p) > j) {
        p[j] = 0u8
    }
    crt::strcat(reinterpret<uint8?>(addr(text[0])), p)
    crt::strcat(reinterpret<uint8?>(addr(text[0])), cstr("\n"))
    j = 0
    client = svs.clients
    while (j < svs.maxclients) {
        {
            if (client == null || int(client.active) == 0 || int(client.spawned) == 0) {
                continue
            }
            if (teamplay.value != 0.0f && uint(teamonly) != 0 && client.edict.v.team != save.edict.v.team) {
                continue
            }
            host_client = client
            SV_ClientPrintf`va(cstr("%s"), (addr(text[0]),))
        } finally {
            j++
            client++
        }
    }
    host_client = save
    Sys_Printf`va(cstr("%s"), (addr(text[1]),))
}

def Host_Say_f {
    Host_Say(qboolean._c_false)
}

def Host_Say_Team_f {
