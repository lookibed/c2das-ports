        p[j] = 0u8
    }
    crt::strcat(addr(text[0]), p)
    crt::strcat(addr(text[0]), cstr("\n"))
    save = host_client
    {
        j = 0
        client = svs.clients
        var _f = false
        while (true) {
            if (_f) {
                j++
                client++
            }
            _f = true
            if (!(j < svs.maxclients)) {
                break
            }
            if (int(client.active) == 0 || int(client.spawned) == 0) {
                continue
            }
            if (Q_strcasecmp(addr(client.name[0]), Cmd_Argv(1)) != 0) {
                continue
            }
            host_client = client
            SV_ClientPrintf`va(cstr("%s"), (addr(text[0]),))
            break
        }
    }
    host_client = save
}

// ==================
// Host_Color_f
// ==================
[c_function]
def Host_Color_f {
    var top : int
    var bottom : int
    var playercolor : int
    if (Cmd_Argc() == 1) {
        Con_Printf`va(cstr("\"color\" is \"%i %i\"\n"), (int(cl_color.value) >> 4, int(cl_color.value) & 15))
        Con_Printf`va(cstr("color <0-13> [0-13]\n"), VaNone())
        return
    }
    if (Cmd_Argc() == 2) {
        bottom = crt::atoi(Cmd_Argv(1))
        top = bottom
    } else {
        top = crt::atoi(Cmd_Argv(1))
        bottom = crt::atoi(Cmd_Argv(2))
    }
    top &= 15
    if (top > 13) {
        top = 13
    }
    bottom &= 15
    if (bottom > 13) {
        bottom = 13
    }
    playercolor = top * 16 + bottom
    if (cmd_source == cmd_source_t.src_command) {
        Cvar_SetValue(cstr("_cl_color"), float(playercolor))
        if (cls.state == cactive_t.ca_connected) {
            Cmd_ForwardToServer()
        }
        return
    }
    host_client.colors = playercolor
    host_client.edict.v.team = float(bottom + 1)
    // send notification to all clients
    MSG_WriteByte(addr(sv.reliable_datagram), svc_updatecolors)
    MSG_WriteByte(addr(sv.reliable_datagram), int(int64(host_client - svs.clients)))
    MSG_WriteByte(addr(sv.reliable_datagram), host_client.colors)
}

