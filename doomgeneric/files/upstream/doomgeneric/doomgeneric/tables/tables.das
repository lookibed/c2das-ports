let private SLOPERANGE = 2048

def SlopeDiv(num : uint; den : uint) : int {
    var ans : uint
    if (den < uint(512)) {
        return SLOPERANGE
    } else {
        ans = (num << 3u) / (den >> 8u)
        if (ans <= uint(SLOPERANGE)) {
            return int(ans)
        } else {
            return SLOPERANGE
        }
    }
}

