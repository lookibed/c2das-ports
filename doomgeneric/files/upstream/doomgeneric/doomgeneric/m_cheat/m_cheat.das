// generated by c2das - regenerate, never edit
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_function
require crt

struct cheatseq_t {
    sequence : uint8[25]
    sequence_len : uint64
    parameter_chars : int
    chars_read : uint64
    param_chars_read : int
    parameter_buf : uint8[5]
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<cheatseq_t>) == 72 && typeinfo alignof(type<cheatseq_t>) == 8, "cheatseq_t: clang lays it out as size 72, align 8")
    static_assert(typeinfo offsetof < sequence > (type<cheatseq_t>) == 0, "cheatseq_t.sequence: clang puts it at 0")
    static_assert(typeinfo offsetof < sequence_len > (type<cheatseq_t>) == 32, "cheatseq_t.sequence_len: clang puts it at 32")
    static_assert(typeinfo offsetof < parameter_chars > (type<cheatseq_t>) == 40, "cheatseq_t.parameter_chars: clang puts it at 40")
    static_assert(typeinfo offsetof < chars_read > (type<cheatseq_t>) == 48, "cheatseq_t.chars_read: clang puts it at 48")
    static_assert(typeinfo offsetof < param_chars_read > (type<cheatseq_t>) == 56, "cheatseq_t.param_chars_read: clang puts it at 56")
    static_assert(typeinfo offsetof < parameter_buf > (type<cheatseq_t>) == 60, "cheatseq_t.parameter_buf: clang puts it at 60")
}

// Called in st_stuff module, which handles the input.
// Returns a 1 if the cheat was successful, 0 if failed.
[c_function]
def cht_CheckCheat(var cht : cheatseq_t?; key : uint8) : int {
    // if we make a short sequence on a cheat with parameters, this
    // will not work in vanilla doom. behave the same.
    if (cht.parameter_chars > 0 && crt::strlen(addr(cht.sequence[0])) < cht.sequence_len) {
        return 0
    }
    if (cht.chars_read < crt::strlen(addr(cht.sequence[0]))) {
        // still reading characters from the cheat code
        // and verifying. reset back to the beginning
        // if a key is wrong
        if (int(key) == int(cht.sequence[cht.chars_read])) {
            cht.chars_read++
        } else {
            cht.chars_read = uint64(0)
        }
        cht.param_chars_read = 0
    } elif (cht.param_chars_read < cht.parameter_chars) {
        // we have passed the end of the cheat sequence and are
        // entering parameters now
        cht.parameter_buf[cht.param_chars_read] = key
        cht.param_chars_read++
    }
    if (cht.chars_read >= crt::strlen(addr(cht.sequence[0])) && cht.param_chars_read >= cht.parameter_chars) {
        cht.param_chars_read = 0
        cht.chars_read = uint64(cht.param_chars_read)
        return 1
    }
    // cheat not matched yet
    return 0
}

[c_function]
def cht_GetParam(var cht : cheatseq_t?; var buffer : uint8?) {
    crt::memcpy(reinterpret<void?>(buffer), reinterpret<void?>(addr(cht.parameter_buf[0])), uint64(cht.parameter_chars))
}

