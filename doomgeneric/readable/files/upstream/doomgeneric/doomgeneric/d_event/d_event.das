// generated by c2das - regenerate, never edit
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_bounds
require c_runtime/c_function

enum evtype_t {
    ev_keydown
    ev_keyup
    ev_mouse
    ev_joystick
    ev_quit
}

enum buttoncode_t {
    BT_ATTACK = 1
    BT_USE
    BT_SPECIAL = 128
    BT_SPECIALMASK = 3
    BT_CHANGE
    BT_WEAPONMASK = 56
    BT_WEAPONSHIFT = 3
    BTS_PAUSE = 1
    BTS_SAVEGAME
    BTS_SAVEMASK = 28
    BTS_SAVESHIFT = 2
}

enum buttoncode2_t {
    BT2_LOOKUP = 1
    BT2_LOOKDOWN
    BT2_CENTERVIEW = 4
    BT2_INVUSE = 8
    BT2_INVDROP = 16
    BT2_JUMP = 32
    BT2_HEALTH = 128
}

struct event_t {
    _c_type : evtype_t
    data1, data2, data3, data4 : int
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<event_t>) == 20 && typeinfo alignof(type<event_t>) == 4, "event_t: clang lays it out as size 20, align 4")
    static_assert(typeinfo offsetof < _c_type > (type<event_t>) == 0, "event_t._c_type: clang puts it at 0")
    static_assert(typeinfo offsetof < data1 > (type<event_t>) == 4, "event_t.data1: clang puts it at 4")
    static_assert(typeinfo offsetof < data2 > (type<event_t>) == 8, "event_t.data2: clang puts it at 8")
    static_assert(typeinfo offsetof < data3 > (type<event_t>) == 12, "event_t.data3: clang puts it at 12")
    static_assert(typeinfo offsetof < data4 > (type<event_t>) == 16, "event_t.data4: clang puts it at 16")
}

var private d_event__events : event_t[64]
var private d_event__eventhead : int
var private d_event__eventtail : int

let private MAXEVENTS = 64

// D_PostEvent
// Called by the I/O functions when input is detected
[c_function]
def D_PostEvent(var ev : event_t?) {
    d_event__events[d_event__eventhead] = *ev
    d_event__eventhead = (d_event__eventhead + 1) % MAXEVENTS
}

[c_function]
def D_PopEvent : event_t? {
    var result : event_t?
    // No more events waiting.
    if (d_event__eventtail == d_event__eventhead) {
        return null
    }
    result = addr(d_event__events[0]) + end_index(d_event__eventtail, 64)
    // Advance to the next event in the queue.
    d_event__eventtail = (d_event__eventtail + 1) % MAXEVENTS
    return result
}

