// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_function
require crt

enum evtype_t {
    ev_keydown
    ev_keyup
    ev_mouse
    ev_joystick
    ev_quit
}

enum buttoncode_t {
    BT_ATTACK = 1
    BT_USE
    BT_SPECIAL = 128
    BT_SPECIALMASK = 3
    BT_CHANGE
    BT_WEAPONMASK = 56
    BT_WEAPONSHIFT = 3
    BTS_PAUSE = 1
    BTS_SAVEGAME
    BTS_SAVEMASK = 28
    BTS_SAVESHIFT = 2
}

enum buttoncode2_t {
    BT2_LOOKUP = 1
    BT2_LOOKDOWN
    BT2_CENTERVIEW = 4
    BT2_INVUSE = 8
    BT2_INVDROP = 16
    BT2_JUMP = 32
    BT2_HEALTH = 128
}

struct ticcmd_t {
    forwardmove, sidemove : int8
    angleturn : int16
    chatchar, buttons, consistancy, buttons2 : uint8
    inventory : int
    lookfly, arti : uint8
}

struct event_t {
    _c_type : evtype_t
    data1, data2, data3, data4 : int
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<ticcmd_t>) == 16 && typeinfo alignof(type<ticcmd_t>) == 4, "ticcmd_t: clang lays it out as size 16, align 4")
    static_assert(typeinfo offsetof < forwardmove > (type<ticcmd_t>) == 0, "ticcmd_t.forwardmove: clang puts it at 0")
    static_assert(typeinfo offsetof < sidemove > (type<ticcmd_t>) == 1, "ticcmd_t.sidemove: clang puts it at 1")
    static_assert(typeinfo offsetof < angleturn > (type<ticcmd_t>) == 2, "ticcmd_t.angleturn: clang puts it at 2")
    static_assert(typeinfo offsetof < chatchar > (type<ticcmd_t>) == 4, "ticcmd_t.chatchar: clang puts it at 4")
    static_assert(typeinfo offsetof < buttons > (type<ticcmd_t>) == 5, "ticcmd_t.buttons: clang puts it at 5")
    static_assert(typeinfo offsetof < consistancy > (type<ticcmd_t>) == 6, "ticcmd_t.consistancy: clang puts it at 6")
    static_assert(typeinfo offsetof < buttons2 > (type<ticcmd_t>) == 7, "ticcmd_t.buttons2: clang puts it at 7")
    static_assert(typeinfo offsetof < inventory > (type<ticcmd_t>) == 8, "ticcmd_t.inventory: clang puts it at 8")
    static_assert(typeinfo offsetof < lookfly > (type<ticcmd_t>) == 12, "ticcmd_t.lookfly: clang puts it at 12")
    static_assert(typeinfo offsetof < arti > (type<ticcmd_t>) == 13, "ticcmd_t.arti: clang puts it at 13")
    static_assert(typeinfo sizeof(type<event_t>) == 20 && typeinfo alignof(type<event_t>) == 4, "event_t: clang lays it out as size 20, align 4")
    static_assert(typeinfo offsetof < _c_type > (type<event_t>) == 0, "event_t._c_type: clang puts it at 0")
    static_assert(typeinfo offsetof < data1 > (type<event_t>) == 4, "event_t.data1: clang puts it at 4")
    static_assert(typeinfo offsetof < data2 > (type<event_t>) == 8, "event_t.data2: clang puts it at 8")
    static_assert(typeinfo offsetof < data3 > (type<event_t>) == 12, "event_t.data3: clang puts it at 12")
    static_assert(typeinfo offsetof < data4 > (type<event_t>) == 16, "event_t.data4: clang puts it at 16")
}

let private FRACBITS = 16

[unsafe_deref, hint(unsafe_range_check)]
def FixedMul(a : int; b : int) : int {
    return int((int64(a) * int64(b)) >> int64(FRACBITS))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def FixedDiv(a : int; b : int) : int {
    if ((crt::abs(a) >> 14) >= crt::abs(b)) {
        return (a ^ b) < 0 ? -2147483647 - 1 : 2147483647
    } else {
        var result : int64
        result = (int64(a) << 16l) / int64(b)
        return int(result)
    }
}

