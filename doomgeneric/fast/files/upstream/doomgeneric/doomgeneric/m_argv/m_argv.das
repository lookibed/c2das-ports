var myargc : int
var myargv : uint8 ??

let private DIR_SEPARATOR = '/'

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_CheckParmWithArgs(var check : uint8?; num_args : int) : int {
    for (i in range(1, myargc - num_args)) {
        if (crt::strcasecmp(check, myargv[i]) == 0) {
            return i
        }
    }
    return 0
}

[unsafe_deref, hint(unsafe_range_check)]
def M_ParmExists(var check : uint8?) : uint {
    return uint(int_of(M_CheckParm(check) != 0))
}

[unsafe_deref, hint(unsafe_range_check)]
def M_CheckParm(var check : uint8?) : int {
    return M_CheckParmWithArgs(check, 0)
}

[unsafe_deref, hint(unsafe_range_check)]
def private m_argv__LoadResponseFile(argv_index : int) {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_FindResponseFile {
    for (i in range(1, myargc)) {
        if (myargv[i][0] == '@') {
            m_argv__LoadResponseFile(i)
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_GetExecutableName : uint8? {
    var sep : uint8?
    sep = crt::strrchr(myargv[0], DIR_SEPARATOR)
    if (sep == null) {
        return myargv[0]
    } else {
        return sep + 1
    }
}

