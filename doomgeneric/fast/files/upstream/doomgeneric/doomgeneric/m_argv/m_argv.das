    BT_ATTACK = 1
    BT_USE
    BT_SPECIAL = 128
    BT_SPECIALMASK = 3
    BT_CHANGE
    BT_WEAPONMASK = 56
    BT_WEAPONSHIFT = 3
    BTS_PAUSE = 1
    BTS_SAVEGAME
    BTS_SAVEMASK = 28
    BTS_SAVESHIFT = 2
}

enum buttoncode2_t {
    BT2_LOOKUP = 1
    BT2_LOOKDOWN
    BT2_CENTERVIEW = 4
    BT2_INVUSE = 8
    BT2_INVDROP = 16
    BT2_JUMP = 32
    BT2_HEALTH = 128
}

struct _IO_FILE {}

