    // update chainig vars
    hd.h0 += a
    hd.h1 += b
    hd.h2 += c
    hd.h3 += d
    hd.h4 += e
}

// Update the message digest with the contents
// of INBUF with length INLEN.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_Update(var hd : sha1_context_s?; var inbuf : uint8?; var inlen : uint64) {
    if (hd.count == 64) {
        // flush the buffer
        sha1__Transform(hd, addr(hd.buf[0]))
        hd.count = 0
        hd.nblocks++
    }
    if (inbuf == null) {
        return
    }
    if (hd.count != 0) {
        while (inlen != 0 && hd.count < 64) {
            let _t0 = hd.count
            hd.count++
            var _t1 = inbuf
            inbuf++
            hd.buf[_t0] = *_t1
            inlen--
        }
        SHA1_Update(hd, null, 0ul)
        if (inlen == 0) {
            return
        }
    }
    while (inlen >= 64ul) {
        sha1__Transform(hd, inbuf)
        hd.count = 0
        hd.nblocks++
        inlen -= 64ul
        inbuf += 64
    }
    while (inlen != 0 && hd.count < 64) {
        let _t2 = hd.count
        hd.count++
        var _t3 = inbuf
        inbuf++
        hd.buf[_t2] = *_t3
        inlen--
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_Final(var digest : uint8?; var hd : sha1_context_s?) {
    var t : uint
    var msb : uint
    var lsb : uint
    var p : uint8?
    // flush
    SHA1_Update(hd, null, 0ul)
    t = hd.nblocks
    // multiply by 64 to make a byte count
    lsb = t << 6u
    msb = t >> 26u
    // add the count
    t = lsb
    lsb += uint(hd.count)
    if (lsb < t) {
        msb++
    }
    // multiply by 8 to make a bit count
    t = lsb
    lsb <<= 3u
    msb <<= 3u
    msb |= t >> 29u
    if (hd.count < 56) {
        // enough room
        // pad
        let _t0 = hd.count
        hd.count++
        hd.buf[_t0] = 128u8
        while (hd.count < 56) {
            // pad
            let _t1 = hd.count
            hd.count++
            hd.buf[_t1] = 0u8
        }
    } else {
        // need one extra block
        // pad character
        let _t2 = hd.count
        hd.count++
        hd.buf[_t2] = 128u8
        while (hd.count < 64) {
            let _t3 = hd.count
            hd.count++
            hd.buf[_t3] = 0u8
        }
        // flush
        SHA1_Update(hd, null, 0ul)
        // fill next block with zeroes
        crt::memset(reinterpret<void?>(addr(hd.buf[0])), 0, 56ul)
    }
    // append the 64 bit count
    hd.buf[56] = uint8(msb >> 24u)
    hd.buf[57] = uint8(msb >> 16u)
    hd.buf[58] = uint8(msb >> 8u)
    hd.buf[59] = uint8(msb)
    hd.buf[60] = uint8(lsb >> 24u)
    hd.buf[61] = uint8(lsb >> 16u)
    hd.buf[62] = uint8(lsb >> 8u)
    hd.buf[63] = uint8(lsb)
    sha1__Transform(hd, addr(hd.buf[0]))
    p = addr(hd.buf[0])
    // little endian
    {
        var _t4 = p
        p++
        *_t4 = uint8(hd.h0 >> 24u)
        var _t5 = p
        p++
        *_t5 = uint8(hd.h0 >> 16u)
        var _t6 = p
        p++
        *_t6 = uint8(hd.h0 >> 8u)
        var _t7 = p
        p++
        *_t7 = uint8(hd.h0)
    }
    {
        var _t8 = p
        p++
        *_t8 = uint8(hd.h1 >> 24u)
        var _t9 = p
        p++
        *_t9 = uint8(hd.h1 >> 16u)
        var _t10 = p
        p++
        *_t10 = uint8(hd.h1 >> 8u)
        var _t11 = p
        p++
        *_t11 = uint8(hd.h1)
    }
    {
        var _t12 = p
        p++
        *_t12 = uint8(hd.h2 >> 24u)
        var _t13 = p
        p++
        *_t13 = uint8(hd.h2 >> 16u)
        var _t14 = p
        p++
        *_t14 = uint8(hd.h2 >> 8u)
        var _t15 = p
        p++
        *_t15 = uint8(hd.h2)
    }
    {
        var _t16 = p
        p++
        *_t16 = uint8(hd.h3 >> 24u)
        var _t17 = p
        p++
        *_t17 = uint8(hd.h3 >> 16u)
        var _t18 = p
        p++
        *_t18 = uint8(hd.h3 >> 8u)
        var _t19 = p
        p++
        *_t19 = uint8(hd.h3)
    }
    {
        var _t20 = p
        p++
        *_t20 = uint8(hd.h4 >> 24u)
        var _t21 = p
        p++
        *_t21 = uint8(hd.h4 >> 16u)
        var _t22 = p
        p++
        *_t22 = uint8(hd.h4 >> 8u)
        var _t23 = p
        p++
        *_t23 = uint8(hd.h4)
    }
    crt::memcpy(reinterpret<void?>(digest), reinterpret<void?>(addr(hd.buf[0])), uint64(typeinfo sizeof(type<uint8[20]>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_UpdateInt32(var context : sha1_context_s?; val : uint) {
    var buf : uint8[4]
    buf[0] = uint8((val >> 24u) & 255u)
    buf[1] = uint8((val >> 16u) & 255u)
    buf[2] = uint8((val >> 8u) & 255u)
    buf[3] = uint8(val & 255u)
    SHA1_Update(context, addr(buf[0]), 4ul)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_UpdateString(var context : sha1_context_s?; var str : uint8?) {
    SHA1_Update(context, reinterpret<uint8?>(str), crt::strlen(str) + 1ul)
}

