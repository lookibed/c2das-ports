def private doom_all__WriteSquashedLine1x(var dest : uint8?; var src : uint8?) {
    var x : int
    x = 0
    while (x < SCREENWIDTH) {
        // Draw in blocks of 5
        // 80% pixel 0, 20% pixel 1
        var _t0 = dest
        dest++
        *_t0 = doom_all__stretch_tables[0][int(src[1]) * 256 + int(src[0])]
        // 60% pixel 1, 40% pixel 2
        var _t1 = dest
        dest++
        *_t1 = doom_all__stretch_tables[1][int(src[2]) * 256 + int(src[1])]
        // 40% pixel 2, 60% pixel 3
        var _t2 = dest
        dest++
        *_t2 = doom_all__stretch_tables[1][int(src[2]) * 256 + int(src[3])]
        // 20% pixel 3, 80% pixel 4
        var _t3 = dest
        dest++
        *_t3 = doom_all__stretch_tables[0][int(src[3]) * 256 + int(src[4])]
        x += 5
        src += 5
    }
