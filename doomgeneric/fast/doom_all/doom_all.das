    }
    S_StartSound(reinterpret<void?>(mo), sound)
}

// Move a plane (floor or ceiling) and check for crushing
[unsafe_deref, hint(unsafe_range_check)]
def T_MovePlane(var sector : sector_t?; speed : int; dest : int; crush : uint; floorOrCeiling : int; direction : int) : result_e {
    var flag : uint
    var lastpos : int
    c_switch(floorOrCeiling) {
        case(0) {
            // FLOOR
            c_switch(direction) {
                case(-1) {
                    // DOWN
                    if (sector.floorheight - speed < dest) {
                        lastpos = sector.floorheight
                        sector.floorheight = dest
                        flag = P_ChangeSector(sector, crush)
                        if (flag == 1u) {
                            sector.floorheight = lastpos
                            P_ChangeSector(sector, crush)
                        }
                        // return crushed;
                        return result_e.pastdest
                    } else {
                        lastpos = sector.floorheight
                        sector.floorheight -= speed
                        flag = P_ChangeSector(sector, crush)
                        if (flag == 1u) {
                            sector.floorheight = lastpos
                            P_ChangeSector(sector, crush)
                            return result_e.crushed
                        }
                    }
                    break
                }
                case(1) {
                    // UP
                    if (sector.floorheight + speed > dest) {
                        lastpos = sector.floorheight
                        sector.floorheight = dest
                        flag = P_ChangeSector(sector, crush)
                        if (flag == 1u) {
                            sector.floorheight = lastpos
                            P_ChangeSector(sector, crush)
                        }
                        // return crushed;
                        return result_e.pastdest
                    } else {
                        // COULD GET CRUSHED
                        lastpos = sector.floorheight
                        sector.floorheight += speed
                        flag = P_ChangeSector(sector, crush)
                        if (flag == 1u) {
                            if (crush == 1u) {
                                return result_e.crushed
                            }
                            sector.floorheight = lastpos
                            P_ChangeSector(sector, crush)
                            return result_e.crushed
                        }
                    }
                    break
                }
            }
            break
        }
        case(1) {
            // CEILING
            c_switch(direction) {
                case(-1) {
                    // DOWN
                    if (sector.ceilingheight - speed < dest) {
                        lastpos = sector.ceilingheight
                        sector.ceilingheight = dest
                        flag = P_ChangeSector(sector, crush)
                        if (flag == 1u) {
                            sector.ceilingheight = lastpos
                            P_ChangeSector(sector, crush)
                        }
                        // return crushed;
                        return result_e.pastdest
                    } else {
                        // COULD GET CRUSHED
                        lastpos = sector.ceilingheight
                        sector.ceilingheight -= speed
                        flag = P_ChangeSector(sector, crush)
                        if (flag == 1u) {
                            if (crush == 1u) {
                                return result_e.crushed
                            }
                            sector.ceilingheight = lastpos
                            P_ChangeSector(sector, crush)
                            return result_e.crushed
                        }
                    }
                    break
                }
                case(1) {
                    // UP
                    if (sector.ceilingheight + speed > dest) {
                        lastpos = sector.ceilingheight
                        sector.ceilingheight = dest
                        flag = P_ChangeSector(sector, crush)
                        if (flag == 1u) {
                            sector.ceilingheight = lastpos
                            P_ChangeSector(sector, crush)
                        }
                        // return crushed;
                        return result_e.pastdest
                    } else {
                        lastpos = sector.ceilingheight
                        sector.ceilingheight += speed
                        flag = P_ChangeSector(sector, crush)
                    }
                    // UNUSED
                    break
                }
            }
            break
        }
    }
    return result_e.ok
}

// MOVE A FLOOR TO IT'S DESTINATION (UP OR DOWN)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def T_MoveFloor(var floor : floormove_t?) {
    var res : result_e
    res = T_MovePlane(floor.sector, floor.speed, floor.floordestheight, floor.crush, 0, floor.direction)
    if ((leveltime & 7) == 0) {
        S_StartSound(reinterpret<void?>(addr(floor.sector.soundorg)), int(sfxenum_t.sfx_stnmov))
    }
    if (res == result_e.pastdest) {
        floor.sector.specialdata = null
        if (floor.direction == 1) {
            c_switch(floor._c_type) {
                case(floor_e.donutRaise) {
                    floor.sector.special = int16(floor.newspecial)
                    floor.sector.floorpic = floor.texture
                }
                case(_) {
                    break
                }
            }
        } elif (floor.direction == -1) {
            c_switch(floor._c_type) {
                case(floor_e.lowerAndChange) {
                    floor.sector.special = int16(floor.newspecial)
                    floor.sector.floorpic = floor.texture
                }
                case(_) {
                    break
                }
            }
        }
        P_RemoveThinker(addr(floor.thinker))
        S_StartSound(reinterpret<void?>(addr(floor.sector.soundorg)), int(sfxenum_t.sfx_pstop))
    }
}

// HANDLE FLOOR TYPES
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_DoFloor(var line : line_s?; floortype : floor_e) : int {
    var secnum : int
    var rtn : int
    var i : int
    var sec : sector_t?
    var floor : floormove_t?
    secnum = -1
    rtn = 0
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        // ALREADY MOVING? IF SO, KEEP GOING...
        if (sec.specialdata != null) {
            continue
        }
        // new floor thinker
        rtn = 1
        floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), int(anon_28.PU_LEVSPEC), null))
        P_AddThinker(addr(floor.thinker))
        sec.specialdata = reinterpret<void?>(floor)
        floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
        floor._c_type = floortype
        floor.crush = 0u
        c_switch(floortype) {
            case(floor_e.lowerFloor) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = P_FindHighestFloorSurrounding(sec)
                break
            }
            case(floor_e.lowerFloorToLowest) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = P_FindLowestFloorSurrounding(sec)
                break
            }
            case(floor_e.turboLower) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = FRACUNIT * 4
                floor.floordestheight = P_FindHighestFloorSurrounding(sec)
                if (floor.floordestheight != sec.floorheight) {
                    floor.floordestheight += 8 * FRACUNIT
                }
                break
            }
            case(floor_e.raiseFloorCrush) {
                floor.crush = 1u
            }
            case(floor_e.raiseFloor) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = P_FindLowestCeilingSurrounding(sec)
                if (floor.floordestheight > sec.ceilingheight) {
                    floor.floordestheight = sec.ceilingheight
                }
                floor.floordestheight -= (8 * FRACUNIT) * int_of(floortype == floor_e.raiseFloorCrush)
                break
            }
            case(floor_e.raiseFloorTurbo) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = FRACUNIT * 4
                floor.floordestheight = P_FindNextHighestFloor(sec, sec.floorheight)
                break
            }
            case(floor_e.raiseFloorToNearest) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = P_FindNextHighestFloor(sec, sec.floorheight)
                break
            }
            case(floor_e.raiseFloor24) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = floor.sector.floorheight + 24 * FRACUNIT
                break
            }
            case(floor_e.raiseFloor512) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = floor.sector.floorheight + 512 * FRACUNIT
                break
            }
            case(floor_e.raiseFloor24AndChange) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = floor.sector.floorheight + 24 * FRACUNIT
                sec.floorpic = line.frontsector.floorpic
                sec.special = line.frontsector.special
                break
            }
            case(floor_e.raiseToTexture) {
                {
                    var minsize : int = 2147483647
                    var side : side_t?
                    floor.direction = 1
                    floor.sector = sec
                    floor.speed = FRACUNIT
                    i = 0
                    while (i < sec.linecount) {
                        if (twoSided(secnum, i) != 0) {
                            side = getSide(secnum, i, 0)
                            if (int(side.bottomtexture) >= 0) {
                                if (textureheight[int(side.bottomtexture)] < minsize) {
                                    minsize = textureheight[int(side.bottomtexture)]
                                }
                            }
                            side = getSide(secnum, i, 1)
                            if (int(side.bottomtexture) >= 0) {
                                if (textureheight[int(side.bottomtexture)] < minsize) {
                                    minsize = textureheight[int(side.bottomtexture)]
                                }
                            }
                        }
                        i++
                    }
                    floor.floordestheight = floor.sector.floorheight + minsize
                }
                break
            }
            case(floor_e.lowerAndChange) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = FRACUNIT
                floor.floordestheight = P_FindLowestFloorSurrounding(sec)
                floor.texture = sec.floorpic
                i = 0
                while (i < sec.linecount) {
                    if (twoSided(secnum, i) != 0) {
                        if (int64(getSide(secnum, i, 0).sector - sectors) == int64(secnum)) {
                            sec = getSector(secnum, i, 1)
                            if (sec.floorheight == floor.floordestheight) {
                                floor.texture = sec.floorpic
                                floor.newspecial = int(sec.special)
                                break
                            }
                        } else {
                            sec = getSector(secnum, i, 0)
                            if (sec.floorheight == floor.floordestheight) {
                                floor.texture = sec.floorpic
                                floor.newspecial = int(sec.special)
                                break
                            }
                        }
                    }
                    i++
                }
            }
            case(_) {
                break
            }
        }
    }
    return rtn
}

// BUILD A STAIRCASE!
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_BuildStairs(var line : line_s?; _c_type : stair_e) : int {
    var secnum : int
    var height : int
    var i : int
    var newsecnum : int
    var texture : int
    var ok : int
    var rtn : int
    var sec : sector_t?
    var tsec : sector_t?
    var floor : floormove_t?
    var stairsize : int = 0
    var speed : int = 0
    secnum = -1
    rtn = 0
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        // ALREADY MOVING? IF SO, KEEP GOING...
        if (sec.specialdata != null) {
            continue
        }
        // new floor thinker
        rtn = 1
        floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), int(anon_28.PU_LEVSPEC), null))
        P_AddThinker(addr(floor.thinker))
        sec.specialdata = reinterpret<void?>(floor)
        floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
        floor.direction = 1
        floor.sector = sec
        c_switch(_c_type) {
            case(stair_e.build8) {
                speed = FRACUNIT / 4
                stairsize = 8 * FRACUNIT
                break
            }
            case(stair_e.turbo16) {
                speed = FRACUNIT * 4
                stairsize = 16 * FRACUNIT
                break
            }
        }
        floor.speed = speed
        height = sec.floorheight + stairsize
        floor.floordestheight = height
        texture = int(sec.floorpic)
        // Find next sector to raise
        // 1. Find 2-sided line with same sector side[0]
        // 2. Other side is the next sector to raise
        c_do_while(ok != 0) {
            ok = 0
            {
                i = 0
                var _f = false
                while (true) {
                    if (_f) {
                        i++
                    }
                    _f = true
                    if (!(i < sec.linecount)) {
                        break
                    }
                    if ((int(sec.lines[i].flags) & ML_TWOSIDED) == 0) {
                        continue
                    }
                    tsec = sec.lines[i].frontsector
                    newsecnum = int(int64(tsec - sectors))
                    if (secnum != newsecnum) {
                        continue
                    }
                    tsec = sec.lines[i].backsector
                    newsecnum = int(int64(tsec - sectors))
                    if (int(tsec.floorpic) != texture) {
                        continue
                    }
                    height += stairsize
                    if (tsec.specialdata != null) {
                        continue
                    }
                    sec = tsec
                    secnum = newsecnum
                    floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), int(anon_28.PU_LEVSPEC), null))
                    P_AddThinker(addr(floor.thinker))
                    sec.specialdata = reinterpret<void?>(floor)
                    floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
                    floor.direction = 1
                    floor.sector = sec
                    floor.speed = speed
                    floor.floordestheight = height
                    ok = 1
                    break
                }
            }
        }
    }
    return rtn
}

[unsafe_deref, hint(unsafe_range_check)]
def P_GiveAmmo(var player : player_s?; ammo : ammotype_t; var num : int) : uint {
    var oldammo : int
    if (ammo == ammotype_t.am_noammo) {
        return 0u
    }
    if (uint(ammo) > uint(ammotype_t.NUMAMMO)) {
        I_Error`va(cstr("P_GiveAmmo: bad type %i"), (uint(ammo),))
    }
    if (player.ammo[int(ammo)] == player.maxammo[int(ammo)]) {
        return 0u
    }
    if (num != 0) {
        num *= clipammo[int(ammo)]
    } else {
        num = clipammo[int(ammo)] / 2
    }
    if (gameskill == skill_t.sk_baby || gameskill == skill_t.sk_nightmare) {
        // give double ammo in trainer mode,
        // you'll need in nightmare
        num <<= 1
    }
    oldammo = player.ammo[int(ammo)]
    player.ammo[int(ammo)] += num
    if (player.ammo[int(ammo)] > player.maxammo[int(ammo)]) {
        player.ammo[int(ammo)] = player.maxammo[int(ammo)]
    }
    // If non zero ammo,
    // don't change up weapons,
    // player was lower on purpose.
    if (oldammo != 0) {
        return 1u
    }
    // We were down to zero,
    // so select a new weapon.
    // Preferences are not user selectable.
    c_switch(ammo) {
        case(ammotype_t.am_clip) {
            if (player.readyweapon == weapontype_t.wp_fist) {
                if (player.weaponowned[int(weapontype_t.wp_chaingun)] != 0) {
                    player.pendingweapon = weapontype_t.wp_chaingun
                } else {
                    player.pendingweapon = weapontype_t.wp_pistol
                }
            }
            break
        }
        case(ammotype_t.am_shell) {
            if (player.readyweapon == weapontype_t.wp_fist || player.readyweapon == weapontype_t.wp_pistol) {
                if (player.weaponowned[int(weapontype_t.wp_shotgun)] != 0) {
                    player.pendingweapon = weapontype_t.wp_shotgun
                }
            }
            break
        }
        case(ammotype_t.am_cell) {
            if (player.readyweapon == weapontype_t.wp_fist || player.readyweapon == weapontype_t.wp_pistol) {
                if (player.weaponowned[int(weapontype_t.wp_plasma)] != 0) {
                    player.pendingweapon = weapontype_t.wp_plasma
                }
            }
            break
        }
        case(ammotype_t.am_misl) {
            if (player.readyweapon == weapontype_t.wp_fist) {
                if (player.weaponowned[int(weapontype_t.wp_missile)] != 0) {
                    player.pendingweapon = weapontype_t.wp_missile
                }
            }
        }
        case(_) {
            break
        }
    }
    return 1u
}

// P_GiveWeapon
// The weapon name may have a MF_DROPPED flag ored in.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_GiveWeapon(var player : player_s?; weapon : weapontype_t; dropped : uint) : uint {
    var gaveammo : uint
    var gaveweapon : uint
    if (netgame != 0 && (deathmatch != 2) && dropped == 0) {
        // leave placed weapons forever on net games
        if (player.weaponowned[int(weapon)] != 0) {
            return 0u
        }
        player.bonuscount += BONUSADD
        player.weaponowned[int(weapon)] = 1u
        if (deathmatch != 0) {
            P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 5)
        } else {
            P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 2)
        }
        player.pendingweapon = weapon
        if (player == addr(players[0]) + end_index(consoleplayer, 4)) {
            S_StartSound(null, int(sfxenum_t.sfx_wpnup))
        }
        return 0u
    }
    if (weaponinfo[int(weapon)].ammo != ammotype_t.am_noammo) {
        // give one clip with a dropped weapon,
        // two clips with a found weapon
        if (dropped != 0) {
            gaveammo = P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 1)
        } else {
            gaveammo = P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 2)
        }
    } else {
        gaveammo = 0u
    }
    if (player.weaponowned[int(weapon)] != 0) {
        gaveweapon = 0u
    } else {
        gaveweapon = 1u
        player.weaponowned[int(weapon)] = 1u
        player.pendingweapon = weapon
    }
    return uint(int_of(gaveweapon != 0 || gaveammo != 0))
}

// P_GiveBody
// Returns false if the body isn't needed at all
[unsafe_deref, hint(unsafe_range_check)]
def P_GiveBody(var player : player_s?; num : int) : uint {
    if (player.health >= MAXHEALTH) {
        return 0u
    }
    player.health += num
    if (player.health > MAXHEALTH) {
        player.health = MAXHEALTH
    }
    player.mo.health = player.health
    return 1u
}

// P_GiveArmor
// Returns false if the armor is worse
// than the current armor.
[unsafe_deref, hint(unsafe_range_check)]
def P_GiveArmor(var player : player_s?; armortype : int) : uint {
    var hits : int
    hits = armortype * 100
    if (player.armorpoints >= hits) {
        // don't pick up
        return 0u
    }
    player.armortype = armortype
    player.armorpoints = hits
    return 1u
}

// P_GiveCard
[unsafe_deref, hint(unsafe_range_check)]
def P_GiveCard(var player : player_s?; card : card_t) {
    if (player.cards[int(card)] != 0) {
        return
    }
    player.bonuscount = BONUSADD
    player.cards[int(card)] = 1u
}

// P_GivePower
[unsafe_deref, hint(unsafe_range_check)]
def P_GivePower(var player : player_s?; power : int) : uint {
    // powertype_t
    if (power == int(powertype_t.pw_invulnerability)) {
        player.powers[power] = int(powerduration_t.INVULNTICS)
        return 1u
    }
    if (power == int(powertype_t.pw_invisibility)) {
        player.powers[power] = int(powerduration_t.INVISTICS)
        player.mo.flags |= int(mobjflag_t.MF_SHADOW)
        return 1u
    }
    if (power == int(powertype_t.pw_infrared)) {
        player.powers[power] = int(powerduration_t.INFRATICS)
        return 1u
    }
    if (power == int(powertype_t.pw_ironfeet)) {
        player.powers[power] = int(powerduration_t.IRONTICS)
        return 1u
    }
    if (power == int(powertype_t.pw_strength)) {
        P_GiveBody(player, 100)
        player.powers[power] = 1
        return 1u
    }
    if (player.powers[power] != 0) {
        // already got it
        return 0u
    }
    player.powers[power] = 1
    return 1u
}

// P_TouchSpecialThing
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_TouchSpecialThing(var special : mobj_s?; var toucher : mobj_s?) {
    var player : player_s?
    var i : int
    var delta : int
    var sound : int
    delta = special.z - toucher.z
    if (delta > toucher.height || delta < -8 * FRACUNIT) {
        // out of reach
        return
    }
    sound = int(sfxenum_t.sfx_itemup)
    player = toucher.player
    // Dead thing touching.
    // Can happen with a sliding player corpse.
    if (toucher.health <= 0) {
        return
    }
    // Identify by sprite.
    c_switch(special.sprite) {
        case(spritenum_t.SPR_ARM1) {
            // armor
            if (P_GiveArmor(player, deh_green_armor_class) == 0) {
                return
            }
            player.message = cstr("Picked up the armor.")
            break
        }
        case(spritenum_t.SPR_ARM2) {
            if (P_GiveArmor(player, deh_blue_armor_class) == 0) {
                return
            }
            player.message = cstr("Picked up the MegaArmor!")
            break
        }
        case(spritenum_t.SPR_BON1) {
            // bonus items
            // can go over 100%
            player.health++
            if (player.health > deh_max_health) {
                player.health = deh_max_health
            }
            player.mo.health = player.health
            player.message = cstr("Picked up a health bonus.")
            break
        }
        case(spritenum_t.SPR_BON2) {
            // can go over 100%
            player.armorpoints++
            if (player.armorpoints > deh_max_armor) {
                player.armorpoints = deh_max_armor
            }
            // deh_green_armor_class only applies to the green armor shirt;
            // for the armor helmets, armortype 1 is always used.
            if (player.armortype == 0) {
                player.armortype = 1
            }
            player.message = cstr("Picked up an armor bonus.")
            break
        }
        case(spritenum_t.SPR_SOUL) {
            player.health += deh_soulsphere_health
            if (player.health > deh_max_soulsphere) {
                player.health = deh_max_soulsphere
            }
            player.mo.health = player.health
            player.message = cstr("Supercharge!")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_MEGA) {
            if (gamemode != GameMode_t.commercial) {
                return
            }
            player.health = deh_megasphere_health
            player.mo.health = player.health
            // We always give armor type 2 for the megasphere; dehacked only
            // affects the MegaArmor.
            P_GiveArmor(player, 2)
            player.message = cstr("MegaSphere!")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_BKEY) {
            // cards
            // leave cards for everyone
            if (player.cards[int(card_t.it_bluecard)] == 0) {
                player.message = cstr("Picked up a blue keycard.")
            }
            P_GiveCard(player, card_t.it_bluecard)
            if (netgame == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_YKEY) {
            if (player.cards[int(card_t.it_yellowcard)] == 0) {
                player.message = cstr("Picked up a yellow keycard.")
            }
            P_GiveCard(player, card_t.it_yellowcard)
            if (netgame == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_RKEY) {
            if (player.cards[int(card_t.it_redcard)] == 0) {
                player.message = cstr("Picked up a red keycard.")
            }
            P_GiveCard(player, card_t.it_redcard)
            if (netgame == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_BSKU) {
            if (player.cards[int(card_t.it_blueskull)] == 0) {
                player.message = cstr("Picked up a blue skull key.")
            }
            P_GiveCard(player, card_t.it_blueskull)
            if (netgame == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_YSKU) {
            if (player.cards[int(card_t.it_yellowskull)] == 0) {
                player.message = cstr("Picked up a yellow skull key.")
            }
            P_GiveCard(player, card_t.it_yellowskull)
            if (netgame == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_RSKU) {
            if (player.cards[int(card_t.it_redskull)] == 0) {
                player.message = cstr("Picked up a red skull key.")
            }
            P_GiveCard(player, card_t.it_redskull)
            if (netgame == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_STIM) {
            // medikits, heals
            if (P_GiveBody(player, 10) == 0) {
                return
            }
            player.message = cstr("Picked up a stimpack.")
            break
        }
        case(spritenum_t.SPR_MEDI) {
            if (P_GiveBody(player, 25) == 0) {
                return
            }
            if (player.health < 25) {
                player.message = cstr("Picked up a medikit that you REALLY need!")
            } else {
                player.message = cstr("Picked up a medikit.")
            }
            break
        }
        case(spritenum_t.SPR_PINV) {
            // power ups
            if (P_GivePower(player, int(powertype_t.pw_invulnerability)) == 0) {
                return
            }
            player.message = cstr("Invulnerability!")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_PSTR) {
            if (P_GivePower(player, int(powertype_t.pw_strength)) == 0) {
                return
            }
            player.message = cstr("Berserk!")
            if (player.readyweapon != weapontype_t.wp_fist) {
                player.pendingweapon = weapontype_t.wp_fist
            }
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_PINS) {
            if (P_GivePower(player, int(powertype_t.pw_invisibility)) == 0) {
                return
            }
            player.message = cstr("Partial Invisibility")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_SUIT) {
            if (P_GivePower(player, int(powertype_t.pw_ironfeet)) == 0) {
                return
            }
            player.message = cstr("Radiation Shielding Suit")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_PMAP) {
            if (P_GivePower(player, int(powertype_t.pw_allmap)) == 0) {
                return
            }
            player.message = cstr("Computer Area Map")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_PVIS) {
            if (P_GivePower(player, int(powertype_t.pw_infrared)) == 0) {
                return
            }
            player.message = cstr("Light Amplification Visor")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_CLIP) {
            // ammo
            if ((special.flags & int(mobjflag_t.MF_DROPPED)) != 0) {
                if (P_GiveAmmo(player, ammotype_t.am_clip, 0) == 0) {
                    return
                }
            } else {
                if (P_GiveAmmo(player, ammotype_t.am_clip, 1) == 0) {
                    return
                }
            }
            player.message = cstr("Picked up a clip.")
            break
        }
        case(spritenum_t.SPR_AMMO) {
            if (P_GiveAmmo(player, ammotype_t.am_clip, 5) == 0) {
                return
            }
            player.message = cstr("Picked up a box of bullets.")
            break
        }
        case(spritenum_t.SPR_ROCK) {
            if (P_GiveAmmo(player, ammotype_t.am_misl, 1) == 0) {
                return
            }
            player.message = cstr("Picked up a rocket.")
            break
        }
        case(spritenum_t.SPR_BROK) {
            if (P_GiveAmmo(player, ammotype_t.am_misl, 5) == 0) {
                return
            }
            player.message = cstr("Picked up a box of rockets.")
            break
        }
        case(spritenum_t.SPR_CELL) {
            if (P_GiveAmmo(player, ammotype_t.am_cell, 1) == 0) {
                return
            }
            player.message = cstr("Picked up an energy cell.")
            break
        }
        case(spritenum_t.SPR_CELP) {
            if (P_GiveAmmo(player, ammotype_t.am_cell, 5) == 0) {
                return
            }
            player.message = cstr("Picked up an energy cell pack.")
            break
        }
        case(spritenum_t.SPR_SHEL) {
            if (P_GiveAmmo(player, ammotype_t.am_shell, 1) == 0) {
                return
            }
            player.message = cstr("Picked up 4 shotgun shells.")
            break
        }
        case(spritenum_t.SPR_SBOX) {
            if (P_GiveAmmo(player, ammotype_t.am_shell, 5) == 0) {
                return
            }
            player.message = cstr("Picked up a box of shotgun shells.")
            break
        }
        case(spritenum_t.SPR_BPAK) {
            if (player.backpack == 0) {
                for (i1 in range(int(ammotype_t.NUMAMMO))) {
                    player.maxammo[i1] *= 2
                }
                player.backpack = 1u
            }
            i = 0
            while (i < int(ammotype_t.NUMAMMO)) {
                P_GiveAmmo(player, enum_from_int(type<ammotype_t>, i), 1)
                i++
            }
            player.message = cstr("Picked up a backpack full of ammo!")
            break
        }
        case(spritenum_t.SPR_BFUG) {
            // weapons
            if (P_GiveWeapon(player, weapontype_t.wp_bfg, 0u) == 0) {
                return
            }
            player.message = cstr("You got the BFG9000!  Oh, yes.")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_MGUN) {
            if (P_GiveWeapon(player, weapontype_t.wp_chaingun, uint(int_of((special.flags & int(mobjflag_t.MF_DROPPED)) != 0))) == 0) {
                return
            }
            player.message = cstr("You got the chaingun!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_CSAW) {
            if (P_GiveWeapon(player, weapontype_t.wp_chainsaw, 0u) == 0) {
                return
            }
            player.message = cstr("A chainsaw!  Find some meat!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_LAUN) {
            if (P_GiveWeapon(player, weapontype_t.wp_missile, 0u) == 0) {
                return
            }
            player.message = cstr("You got the rocket launcher!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_PLAS) {
            if (P_GiveWeapon(player, weapontype_t.wp_plasma, 0u) == 0) {
                return
            }
            player.message = cstr("You got the plasma gun!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_SHOT) {
            if (P_GiveWeapon(player, weapontype_t.wp_shotgun, uint(int_of((special.flags & int(mobjflag_t.MF_DROPPED)) != 0))) == 0) {
                return
            }
            player.message = cstr("You got the shotgun!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_SGN2) {
            if (P_GiveWeapon(player, weapontype_t.wp_supershotgun, uint(int_of((special.flags & int(mobjflag_t.MF_DROPPED)) != 0))) == 0) {
                return
            }
            player.message = cstr("You got the super shotgun!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(_) {
            I_Error`va(cstr("P_SpecialThing: Unknown gettable thing"), VaNone())
        }
    }
    if ((special.flags & int(mobjflag_t.MF_COUNTITEM)) != 0) {
        player.itemcount++
    }
    P_RemoveMobj(special)
    player.bonuscount += BONUSADD
    if (player == addr(players[0]) + end_index(consoleplayer, 4)) {
        S_StartSound(null, sound)
    }
}

// KillMobj
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_KillMobj(var source : mobj_s?; var target : mobj_s?) {
    var item : mobjtype_t
    var mo : mobj_s?
    target.flags &= ~(int(mobjflag_t.MF_SHOOTABLE) | int(mobjflag_t.MF_FLOAT) | int(mobjflag_t.MF_SKULLFLY))
    if (target._c_type != mobjtype_t.MT_SKULL) {
        target.flags &= ~int(mobjflag_t.MF_NOGRAVITY)
    }
    target.flags |= int(mobjflag_t.MF_CORPSE) | int(mobjflag_t.MF_DROPOFF)
    target.height >>= 2
    if (source != null && source.player != null) {
        // count for intermission
        if ((target.flags & int(mobjflag_t.MF_COUNTKILL)) != 0) {
            source.player.killcount++
        }
        if (target.player != null) {
            source.player.frags[int64(target.player - addr(players[0]))]++
        }
    } elif (netgame == 0 && (target.flags & int(mobjflag_t.MF_COUNTKILL)) != 0) {
        // count all monster deaths,
        // even those caused by other monsters
        players[0].killcount++
    }
    if (target.player != null) {
        // count environment kills against you
        if (source == null) {
            target.player.frags[int64(target.player - addr(players[0]))]++
        }
        target.flags &= ~int(mobjflag_t.MF_SOLID)
        target.player.playerstate = playerstate_t.PST_DEAD
        P_DropWeapon(target.player)
        if (target.player == addr(players[0]) + end_index(consoleplayer, 4) && automapactive != 0) {
            // don't die in auto map,
            // switch view prior to dying
            AM_Stop()
        }
    }
    if (target.health < -target.info.spawnhealth && target.info.xdeathstate != 0) {
        P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.xdeathstate))
    } else {
        P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.deathstate))
    }
    target.tics -= P_Random() & 3
    if (target.tics < 1) {
        target.tics = 1
    }
    // I_StartSound (&actor->r, actor->info->deathsound);
    // In Chex Quest, monsters don't drop items.
    if (gameversion == GameVersion_t.exe_chex) {
        return
    }
    // Drop stuff.
    // This determines the kind of object spawned
    // during the death frame of a thing.
    c_switch(target._c_type) {
        case(mobjtype_t.MT_WOLFSS, mobjtype_t.MT_POSSESSED) {
            item = mobjtype_t.MT_CLIP
            break
        }
        case(mobjtype_t.MT_SHOTGUY) {
            item = mobjtype_t.MT_SHOTGUN
            break
        }
        case(mobjtype_t.MT_CHAINGUY) {
            item = mobjtype_t.MT_CHAINGUN
            break
        }
        case(_) {
            return
        }
    }
    mo = P_SpawnMobj(target.x, target.y, -2147483647 - 1, item)
    // special versions of items
    mo.flags |= int(mobjflag_t.MF_DROPPED)
}

// P_DamageMobj
// Damages both enemies and players
// "inflictor" is the thing that caused the damage
// creature or missile, can be NULL (slime, etc)
// "source" is the thing to target after taking damage
// creature or NULL
// Source and inflictor are the same for melee attacks.
// Source can be NULL for slime, barrel explosions
// and other environmental stuff.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_DamageMobj(var target : mobj_s?; var inflictor : mobj_s?; var source : mobj_s?; var damage : int) {
    var ang : uint
    var saved : int
    var player : player_s?
    var thrust : int
    var temp : int
    if ((target.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // shouldn't happen...
        return
    }
    if (target.health <= 0) {
        return
    }
    if ((target.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
        target.momz = 0
        target.momy = target.momz
        target.momx = target.momy
    }
    player = target.player
    if (player != null && gameskill == skill_t.sk_baby) {
        // take half damage in trainer mode
        damage >>= 1
    }
    // Some close combat weapons should not
    // inflict thrust and push the victim out of reach,
    // thus kick away unless using the chainsaw.
    if (inflictor != null && (target.flags & int(mobjflag_t.MF_NOCLIP)) == 0 &&
            (source == null || source.player == null || source.player.readyweapon != weapontype_t.wp_chainsaw)) {
        ang = R_PointToAngle2(inflictor.x, inflictor.y, target.x, target.y)
        thrust = damage * (FRACUNIT >> 3) * 100 / target.info.mass
        // make fall forwards sometimes
        if (damage < 40 && damage > target.health && target.z - inflictor.z > 64 * FRACUNIT && (P_Random() & 1) != 0) {
            ang += ANG180
            thrust *= 4
        }
        ang >>= uint(ANGLETOFINESHIFT)
        target.momx += FixedMul(thrust, finecosine[ang])
        target.momy += FixedMul(thrust, finesine[ang])
    }
    // player specific
    if (player != null) {
        // end of game hell hack
        if (target.subsector.sector.special == 11 && damage >= target.health) {
            damage = target.health - 1
        }
        // Below certain threshold,
        // ignore damage in GOD mode, or with INVUL power.
        if (damage < 1000 && ((player.cheats & int(cheat_t.CF_GODMODE)) != 0 || player.powers[int(powertype_t.pw_invulnerability)] != 0)) {
            return
        }
        if (player.armortype != 0) {
            if (player.armortype == 1) {
                saved = damage / 3
            } else {
                saved = damage / 2
            }
            if (player.armorpoints <= saved) {
                // armor is used up
                saved = player.armorpoints
                player.armortype = 0
            }
            player.armorpoints -= saved
            damage -= saved
        }
        // mirror mobj health here for Dave
        player.health -= damage
        if (player.health < 0) {
            player.health = 0
        }
        player.attacker = source
        // add damage after armor / invuln
        player.damagecount += damage
        if (player.damagecount > 100) {
            // teleport stomp does 10k points...
            player.damagecount = 100
        }
        temp = damage < 100 ? damage : 100
        if (player == addr(players[0]) + end_index(consoleplayer, 4)) {
            I_Tactile(40, 10, 40 + temp * 2)
        }
    }
    // do the damage
    target.health -= damage
    if (target.health <= 0) {
        P_KillMobj(source, target)
        return
    }
    if ((P_Random() < target.info.painchance) && (target.flags & int(mobjflag_t.MF_SKULLFLY)) == 0) {
        // fight back!
        target.flags |= int(mobjflag_t.MF_JUSTHIT)
        P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.painstate))
    }
    // we're awake now...
    target.reactiontime = 0
    if ((target.threshold == 0 || target._c_type == mobjtype_t.MT_VILE) && source != null && source != target && source._c_type != mobjtype_t.MT_VILE) {
        // if not intent on another player,
        // chase after this one
        target.target = source
        target.threshold = BASETHRESHOLD
        if (target.state == addr(states[0]) + end_index(target.info.spawnstate, 967) && target.info.seestate != int(statenum_t.S_NULL)) {
            P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.seestate))
        }
    }
}

// T_FireFlicker
[unsafe_deref, hint(unsafe_range_check)]
def T_FireFlicker(var flick : fireflicker_t?) {
    var amount : int
    flick.count--
    if (flick.count != 0) {
        return
    }
    amount = (P_Random() & 3) * 16
    if (int(flick.sector.lightlevel) - amount < flick.minlight) {
        flick.sector.lightlevel = int16(flick.minlight)
    } else {
        flick.sector.lightlevel = int16(flick.maxlight - amount)
    }
    flick.count = 4
}

// P_SpawnFireFlicker
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnFireFlicker(var sector : sector_t?) {
    var flick : fireflicker_t?
    // Note that we are resetting sector attributes.
    // Nothing special about it during gameplay.
    sector.special = int16(0)
    flick = reinterpret<fireflicker_t?>(Z_Malloc(typeinfo sizeof(type<fireflicker_t>), int(anon_28.PU_LEVSPEC), null))
    P_AddThinker(addr(flick.thinker))
    flick.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_FireFlicker)
    flick.sector = sector
    flick.maxlight = int(sector.lightlevel)
    flick.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel)) + 16
    flick.count = 4
}

// T_LightFlash
// Do flashing lights.
[unsafe_deref, hint(unsafe_range_check)]
def T_LightFlash(var flash : lightflash_t?) {
    flash.count--
    if (flash.count != 0) {
        return
    }
    if (int(flash.sector.lightlevel) == flash.maxlight) {
        flash.sector.lightlevel = int16(flash.minlight)
        flash.count = (P_Random() & flash.mintime) + 1
    } else {
        flash.sector.lightlevel = int16(flash.maxlight)
        flash.count = (P_Random() & flash.maxtime) + 1
    }
}

// P_SpawnLightFlash
// After the map has been loaded, scan each sector
// for specials that spawn thinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnLightFlash(var sector : sector_t?) {
    var flash : lightflash_t?
    // nothing special about it during gameplay
    sector.special = int16(0)
    flash = reinterpret<lightflash_t?>(Z_Malloc(typeinfo sizeof(type<lightflash_t>), int(anon_28.PU_LEVSPEC), null))
    P_AddThinker(addr(flash.thinker))
    flash.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_LightFlash)
    flash.sector = sector
    flash.maxlight = int(sector.lightlevel)
    flash.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel))
    flash.maxtime = 64
    flash.mintime = 7
    flash.count = (P_Random() & flash.maxtime) + 1
}

// T_StrobeFlash
[unsafe_deref, hint(unsafe_range_check)]
def T_StrobeFlash(var flash : strobe_t?) {
    flash.count--
    if (flash.count != 0) {
        return
    }
    if (int(flash.sector.lightlevel) == flash.minlight) {
        flash.sector.lightlevel = int16(flash.maxlight)
        flash.count = flash.brighttime
    } else {
        flash.sector.lightlevel = int16(flash.minlight)
        flash.count = flash.darktime
    }
}

// P_SpawnStrobeFlash
// After the map has been loaded, scan each sector
// for specials that spawn thinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnStrobeFlash(var sector : sector_t?; fastOrSlow : int; inSync : int) {
    var flash : strobe_t?
    flash = reinterpret<strobe_t?>(Z_Malloc(typeinfo sizeof(type<strobe_t>), int(anon_28.PU_LEVSPEC), null))
    P_AddThinker(addr(flash.thinker))
    flash.sector = sector
    flash.darktime = fastOrSlow
    flash.brighttime = STROBEBRIGHT
    flash.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_StrobeFlash)
    flash.maxlight = int(sector.lightlevel)
    flash.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel))
    if (flash.minlight == flash.maxlight) {
        flash.minlight = 0
    }
    // nothing special about it during gameplay
    sector.special = int16(0)
    if (inSync == 0) {
        flash.count = (P_Random() & 7) + 1
    } else {
        flash.count = 1
    }
}

// Start strobing lights (usually from a trigger)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_StartLightStrobing(var line : line_s?) {
    var secnum : int
    var sec : sector_t?
    secnum = -1
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        if (sec.specialdata != null) {
            continue
        }
        P_SpawnStrobeFlash(sec, SLOWDARK, 0)
    }
}

// TURN LINE'S TAG LIGHTS OFF
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_TurnTagLightsOff(var line : line_s?) {
    var j : int
    var min : int
    var sector : sector_t?
    var tsec : sector_t?
    var templine : line_s?
    sector = sectors
    j = 0
    while (j < numsectors) {
        if (sector.tag == line.tag) {
            min = int(sector.lightlevel)
            for (i in range(sector.linecount)) {
                templine = sector.lines[i]
                tsec = getNextSector(templine, sector)
                if (tsec == null) {
                    continue
                }
                if (int(tsec.lightlevel) < min) {
                    min = int(tsec.lightlevel)
                }
            }
            sector.lightlevel = int16(min)
        }
        j++
        sector++
    }
}

// TURN LINE'S TAG LIGHTS ON
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_LightTurnOn(var line : line_s?; var bright : int) {
    var i : int
    var sector : sector_t?
    var temp : sector_t?
    var templine : line_s?
    sector = sectors
    i = 0
    while (i < numsectors) {
        if (sector.tag == line.tag) {
            // bright = 0 means to search
            // for highest light level
            // surrounding sector
            if (bright == 0) {
                for (j in range(sector.linecount)) {
                    templine = sector.lines[j]
                    temp = getNextSector(templine, sector)
                    if (temp == null) {
                        continue
                    }
                    if (int(temp.lightlevel) > bright) {
                        bright = int(temp.lightlevel)
                    }
                }
            }
            sector.lightlevel = int16(bright)
        }
        i++
        sector++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def T_Glow(var g : glow_t?) {
    c_switch(g.direction) {
        case(-1) {
            // DOWN
            g.sector.lightlevel = int16(int(g.sector.lightlevel) - GLOWSPEED)
            if (int(g.sector.lightlevel) <= g.minlight) {
                g.sector.lightlevel = int16(int(g.sector.lightlevel) + GLOWSPEED)
                g.direction = 1
            }
            break
        }
        case(1) {
            // UP
            g.sector.lightlevel = int16(int(g.sector.lightlevel) + GLOWSPEED)
            if (int(g.sector.lightlevel) >= g.maxlight) {
                g.sector.lightlevel = int16(int(g.sector.lightlevel) - GLOWSPEED)
                g.direction = -1
            }
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnGlowingLight(var sector : sector_t?) {
    var g : glow_t?
    g = reinterpret<glow_t?>(Z_Malloc(typeinfo sizeof(type<glow_t>), int(anon_28.PU_LEVSPEC), null))
    P_AddThinker(addr(g.thinker))
    g.sector = sector
    g.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel))
    g.maxlight = int(sector.lightlevel)
    g.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_Glow)
    g.direction = -1
    sector.special = int16(0)
}

// PIT_StompThing
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_StompThing(var thing : mobj_s?) : uint {
    var blockdist : int
    if ((thing.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        return 1u
    }
    blockdist = thing.radius + tmthing.radius
    if (crt::abs(thing.x - tmx) >= blockdist || crt::abs(thing.y - tmy) >= blockdist) {
        // didn't hit it
        return 1u
    }
    // don't clip against self
    if (thing == tmthing) {
        return 1u
    }
    // monsters don't stomp things except on boss level
    if (tmthing.player == null && gamemap != 30) {
        return 0u
    }
    P_DamageMobj(thing, tmthing, tmthing, 10000)
    return 1u
}

// P_TeleportMove
[unsafe_deref, hint(unsafe_range_check)]
def P_TeleportMove(var thing : mobj_s?; x : int; y : int) : uint {
    var xl : int
    var xh : int
    var yl : int
    var yh : int
    var bx : int
    var by : int
    var newsubsec : subsector_s?
    // kill anything occupying the position
    tmthing = thing
    tmflags = thing.flags
    tmx = x
    tmy = y
    tmbbox[int(anon_982.BOXTOP)] = y + tmthing.radius
    tmbbox[int(anon_982.BOXBOTTOM)] = y - tmthing.radius
    tmbbox[int(anon_982.BOXRIGHT)] = x + tmthing.radius
    tmbbox[int(anon_982.BOXLEFT)] = x - tmthing.radius
    newsubsec = R_PointInSubsector(x, y)
    ceilingline = null
    // The base floor/ceiling is from the subsector
    // that contains the point.
    // Any contacted lines the step closer together
    // will adjust them.
    tmdropoffz = newsubsec.sector.floorheight
    tmfloorz = tmdropoffz
    tmceilingz = newsubsec.sector.ceilingheight
    validcount++
    numspechit = 0
    // stomp on any things contacted
    xl = (tmbbox[int(anon_982.BOXLEFT)] - bmaporgx - 32 * FRACUNIT) >> MAPBLOCKSHIFT
    xh = (tmbbox[int(anon_982.BOXRIGHT)] - bmaporgx + 32 * FRACUNIT) >> MAPBLOCKSHIFT
    yl = (tmbbox[int(anon_982.BOXBOTTOM)] - bmaporgy - 32 * FRACUNIT) >> MAPBLOCKSHIFT
    yh = (tmbbox[int(anon_982.BOXTOP)] - bmaporgy + 32 * FRACUNIT) >> MAPBLOCKSHIFT
    bx = xl
    while (bx <= xh) {
        by = yl
        while (by <= yh) {
            if (P_BlockThingsIterator(bx, by, @@PIT_StompThing) == 0) {
                return 0u
            }
            by++
        }
        bx++
    }
    // the move is ok,
    // so link the thing into its new position
    P_UnsetThingPosition(thing)
    thing.floorz = tmfloorz
    thing.ceilingz = tmceilingz
    thing.x = x
    thing.y = y
    P_SetThingPosition(thing)
    return 1u
}

// PIT_CheckLine
// Adjusts tmfloorz and tmceilingz as lines are contacted
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_CheckLine(var ld : line_s?) : uint {
    if (tmbbox[int(anon_982.BOXRIGHT)] <= ld.bbox[int(anon_982.BOXLEFT)] || tmbbox[int(anon_982.BOXLEFT)] >= ld.bbox[int(anon_982.BOXRIGHT)] ||
            tmbbox[int(anon_982.BOXTOP)] <= ld.bbox[int(anon_982.BOXBOTTOM)] || tmbbox[int(anon_982.BOXBOTTOM)] >= ld.bbox[int(anon_982.BOXTOP)]) {
        return 1u
    }
    if (P_BoxOnLineSide(addr(tmbbox[0]), ld) != -1) {
        return 1u
    }
    // A line has been hit
    // The moving thing's destination position will cross
    // the given line.
    // If this should not be allowed, return false.
    // If the line is special, keep track of it
    // to process later if the move is proven ok.
    // NOTE: specials are NOT sorted by order,
    // so two special lines that are only 8 pixels apart
    // could be crossed in either order.
    if (ld.backsector == null) {
        // one sided line
        return 0u
    }
    if ((tmthing.flags & int(mobjflag_t.MF_MISSILE)) == 0) {
        if ((int(ld.flags) & ML_BLOCKING) != 0) {
            // explicitly blocking everything
            return 0u
        }
        if (tmthing.player == null && (int(ld.flags) & ML_BLOCKMONSTERS) != 0) {
            // block monsters only
            return 0u
        }
    }
    // set openrange, opentop, openbottom
    P_LineOpening(ld)
    // adjust floor / ceiling heights
    if (opentop < tmceilingz) {
        tmceilingz = opentop
        ceilingline = ld
    }
    if (openbottom > tmfloorz) {
        tmfloorz = openbottom
    }
    if (lowfloor < tmdropoffz) {
        tmdropoffz = lowfloor
    }
    // if contacted a special line, add it to the list
    if (ld.special != 0) {
        spechit[numspechit] = ld
        numspechit++
        // fraggle: spechits overrun emulation code from prboom-plus
        if (numspechit > MAXSPECIALCROSS_ORIGINAL) {
            doom_all__SpechitOverrun(ld)
        }
    }
    return 1u
}

// PIT_CheckThing
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_CheckThing(var thing : mobj_s?) : uint {
    var blockdist : int
    var solid : uint
    var damage : int
    if ((thing.flags & (int(mobjflag_t.MF_SOLID) | int(mobjflag_t.MF_SPECIAL) | int(mobjflag_t.MF_SHOOTABLE))) == 0) {
        return 1u
    }
    blockdist = thing.radius + tmthing.radius
    if (crt::abs(thing.x - tmx) >= blockdist || crt::abs(thing.y - tmy) >= blockdist) {
        // didn't hit it
        return 1u
    }
    // don't clip against self
    if (thing == tmthing) {
        return 1u
    }
    // check for skulls slamming into things
    if ((tmthing.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
        damage = ((P_Random() % 8) + 1) * tmthing.info.damage
        P_DamageMobj(thing, tmthing, tmthing, damage)
        tmthing.flags &= ~int(mobjflag_t.MF_SKULLFLY)
        tmthing.momz = 0
        tmthing.momy = tmthing.momz
        tmthing.momx = tmthing.momy
        P_SetMobjState(tmthing, enum_from_int(type<statenum_t>, tmthing.info.spawnstate))
        // stop moving
        return 0u
    }
    // missiles can hit other things
    if ((tmthing.flags & int(mobjflag_t.MF_MISSILE)) != 0) {
        // see if it went over / under
        if (tmthing.z > thing.z + thing.height) {
            // overhead
            return 1u
        }
        if (tmthing.z + tmthing.height < thing.z) {
            // underneath
            return 1u
        }
        if (tmthing.target != null &&
                (tmthing.target._c_type == thing._c_type || (tmthing.target._c_type == mobjtype_t.MT_KNIGHT && thing._c_type == mobjtype_t.MT_BRUISER) ||
                    (tmthing.target._c_type == mobjtype_t.MT_BRUISER && thing._c_type == mobjtype_t.MT_KNIGHT))) {
            // Don't hit same species as originator.
            if (thing == tmthing.target) {
                return 1u
            }
            // sdh: Add deh_species_infighting here. We can override the
            // "monsters of the same species cant hurt each other" behavior
            // through dehacked patches
            if (thing._c_type != mobjtype_t.MT_PLAYER && deh_species_infighting == 0) {
                // Explode, but do no damage.
                // Let players missile other players.
                return 0u
            }
        }
        if ((thing.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
            // didn't do any damage
            return uint(int_of((thing.flags & int(mobjflag_t.MF_SOLID)) == 0))
        }
        // damage / explode
        damage = ((P_Random() % 8) + 1) * tmthing.info.damage
        P_DamageMobj(thing, tmthing, tmthing.target, damage)
        // don't traverse any more
        return 0u
    }
    // check for special pickup
    if ((thing.flags & int(mobjflag_t.MF_SPECIAL)) != 0) {
        solid = uint(thing.flags & int(mobjflag_t.MF_SOLID))
        if ((tmflags & int(mobjflag_t.MF_PICKUP)) != 0) {
            // can remove thing
            P_TouchSpecialThing(thing, tmthing)
        }
        return uint(int_of(solid == 0))
    }
    return uint(int_of((thing.flags & int(mobjflag_t.MF_SOLID)) == 0))
}

// P_CheckPosition
// This is purely informative, nothing is modified
// (except things picked up).
// in:
// a mobj_t (can be valid or invalid)
// a position to be checked
// (doesn't need to be related to the mobj_t->x,y)
// during:
// special things are touched if MF_PICKUP
// early out on solid lines?
// out:
// newsubsec
// floorz
// ceilingz
// tmdropoffz
// the lowest point contacted
// (monsters won't move to a dropoff)
// speciallines[]
// numspeciallines
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckPosition(var thing : mobj_s?; x : int; y : int) : uint {
    var xl : int
    var xh : int
    var yl : int
    var yh : int
    var bx : int
    var by : int
    var newsubsec : subsector_s?
    tmthing = thing
    tmflags = thing.flags
    tmx = x
    tmy = y
    tmbbox[int(anon_982.BOXTOP)] = y + tmthing.radius
    tmbbox[int(anon_982.BOXBOTTOM)] = y - tmthing.radius
    tmbbox[int(anon_982.BOXRIGHT)] = x + tmthing.radius
    tmbbox[int(anon_982.BOXLEFT)] = x - tmthing.radius
    newsubsec = R_PointInSubsector(x, y)
    ceilingline = null
    // The base floor / ceiling is from the subsector
    // that contains the point.
    // Any contacted lines the step closer together
    // will adjust them.
    tmdropoffz = newsubsec.sector.floorheight
    tmfloorz = tmdropoffz
    tmceilingz = newsubsec.sector.ceilingheight
    validcount++
    numspechit = 0
    if ((tmflags & int(mobjflag_t.MF_NOCLIP)) != 0) {
        return 1u
    }
    // Check things first, possibly picking things up.
    // The bounding box is extended by MAXRADIUS
    // because mobj_ts are grouped into mapblocks
    // based on their origin point, and can overlap
    // into adjacent blocks by up to MAXRADIUS units.
    xl = (tmbbox[int(anon_982.BOXLEFT)] - bmaporgx - 32 * FRACUNIT) >> MAPBLOCKSHIFT
    xh = (tmbbox[int(anon_982.BOXRIGHT)] - bmaporgx + 32 * FRACUNIT) >> MAPBLOCKSHIFT
    yl = (tmbbox[int(anon_982.BOXBOTTOM)] - bmaporgy - 32 * FRACUNIT) >> MAPBLOCKSHIFT
    yh = (tmbbox[int(anon_982.BOXTOP)] - bmaporgy + 32 * FRACUNIT) >> MAPBLOCKSHIFT
    bx = xl
    while (bx <= xh) {
        by = yl
        while (by <= yh) {
            if (P_BlockThingsIterator(bx, by, @@PIT_CheckThing) == 0) {
                return 0u
            }
            by++
        }
        bx++
    }
    // check lines
    xl = (tmbbox[int(anon_982.BOXLEFT)] - bmaporgx) >> MAPBLOCKSHIFT
    xh = (tmbbox[int(anon_982.BOXRIGHT)] - bmaporgx) >> MAPBLOCKSHIFT
    yl = (tmbbox[int(anon_982.BOXBOTTOM)] - bmaporgy) >> MAPBLOCKSHIFT
    yh = (tmbbox[int(anon_982.BOXTOP)] - bmaporgy) >> MAPBLOCKSHIFT
    bx = xl
    while (bx <= xh) {
        by = yl
        while (by <= yh) {
            if (P_BlockLinesIterator(bx, by, @@PIT_CheckLine) == 0) {
                return 0u
            }
            by++
        }
        bx++
    }
    return 1u
}

// P_TryMove
// Attempt to move to a new position,
// crossing special lines unless MF_TELEPORT is set.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_TryMove(var thing : mobj_s?; x : int; y : int) : uint {
    var oldx : int
    var oldy : int
    var side : int
    var oldside : int
    var ld : line_s?
    floatok = 0u
    if (P_CheckPosition(thing, x, y) == 0) {
        // solid wall or thing
        return 0u
    }
    if ((thing.flags & int(mobjflag_t.MF_NOCLIP)) == 0) {
        if (tmceilingz - tmfloorz < thing.height) {
            // doesn't fit
            return 0u
        }
        floatok = 1u
        if ((thing.flags & int(mobjflag_t.MF_TELEPORT)) == 0 && tmceilingz - thing.z < thing.height) {
            // mobj must lower itself to fit
            return 0u
        }
        if ((thing.flags & int(mobjflag_t.MF_TELEPORT)) == 0 && tmfloorz - thing.z > 24 * FRACUNIT) {
            // too big a step up
            return 0u
        }
        if ((thing.flags & (int(mobjflag_t.MF_DROPOFF) | int(mobjflag_t.MF_FLOAT))) == 0 && tmfloorz - tmdropoffz > 24 * FRACUNIT) {
            // don't stand over a dropoff
            return 0u
        }
    }
    // the move is ok,
    // so link the thing into its new position
    P_UnsetThingPosition(thing)
    oldx = thing.x
    oldy = thing.y
    thing.floorz = tmfloorz
    thing.ceilingz = tmceilingz
    thing.x = x
    thing.y = y
    P_SetThingPosition(thing)
    // if any special lines were hit, do the effect
    if ((thing.flags & (int(mobjflag_t.MF_TELEPORT) | int(mobjflag_t.MF_NOCLIP))) == 0) {
        while (true) {
            let _t0 = numspechit
            numspechit--
            if (_t0 == 0) {
                break
            }
            // see if the line was crossed
            ld = spechit[numspechit]
            side = P_PointOnLineSide(thing.x, thing.y, ld)
            oldside = P_PointOnLineSide(oldx, oldy, ld)
            if (side != oldside) {
                if (ld.special != 0) {
                    P_CrossSpecialLine(int(int64(ld - lines)), oldside, thing)
                }
            }
        }
    }
    return 1u
}

// P_ThingHeightClip
// Takes a valid thing and adjusts the thing->floorz,
// thing->ceilingz, and possibly thing->z.
// This is called for all nearby monsters
// whenever a sector changes height.
// If the thing doesn't fit,
// the z will be set to the lowest value
// and false will be returned.
[unsafe_deref, hint(unsafe_range_check)]
def P_ThingHeightClip(var thing : mobj_s?) : uint {
    var onfloor : uint
    onfloor = uint(int_of(thing.z == thing.floorz))
    P_CheckPosition(thing, thing.x, thing.y)
    // what about stranding a monster partially off an edge?
    thing.floorz = tmfloorz
    thing.ceilingz = tmceilingz
    if (onfloor != 0) {
        // walking monsters rise and fall with the floor
        thing.z = thing.floorz
    } else {
        // don't adjust a floating monster unless forced to
        if (thing.z + thing.height > thing.ceilingz) {
            thing.z = thing.ceilingz - thing.height
        }
    }
    if (thing.ceilingz - thing.floorz < thing.height) {
        return 0u
    }
    return 1u
}

// P_HitSlideLine
// Adjusts the xmove / ymove
// so that the next move will slide along the wall.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_HitSlideLine(var ld : line_s?) {
    var side : int
    var lineangle : uint
    var moveangle : uint
    var deltaangle : uint
    var movelen : int
    var newlen : int
    if (ld.slopetype == slopetype_t.ST_HORIZONTAL) {
        tmymove = 0
        return
    }
    if (ld.slopetype == slopetype_t.ST_VERTICAL) {
        tmxmove = 0
        return
    }
    side = P_PointOnLineSide(slidemo.x, slidemo.y, ld)
    lineangle = R_PointToAngle2(0, 0, ld.dx, ld.dy)
    if (side == 1) {
        lineangle += ANG180
    }
    moveangle = R_PointToAngle2(0, 0, tmxmove, tmymove)
    deltaangle = moveangle - lineangle
    if (deltaangle > ANG180) {
        deltaangle += ANG180
    }
    // I_Error ("SlideLine: ang>ANG180");
    lineangle >>= uint(ANGLETOFINESHIFT)
    deltaangle >>= uint(ANGLETOFINESHIFT)
    movelen = P_AproxDistance(tmxmove, tmymove)
    newlen = FixedMul(movelen, finecosine[deltaangle])
    tmxmove = FixedMul(newlen, finecosine[lineangle])
    tmymove = FixedMul(newlen, finesine[lineangle])
}

// PTR_SlideTraverse
[unsafe_deref, hint(unsafe_range_check)]
def PTR_SlideTraverse(var _c_in : intercept_t?) : uint {
    var li : line_s?
    if (_c_in.isaline == 0) {
        I_Error`va(cstr("PTR_SlideTraverse: not a line?"), VaNone())
    }
    li = _c_in.d.line
    if ((int(li.flags) & ML_TWOSIDED) == 0) {
        if (P_PointOnLineSide(slidemo.x, slidemo.y, li) != 0) {
            // don't hit the back side
            return 1u
        }
        goto label 1
    }
    // set openrange, opentop, openbottom
    P_LineOpening(li)
    if (openrange < slidemo.height) {
        // doesn't fit
        goto label 1
    }
    if (opentop - slidemo.z < slidemo.height) {
        // mobj is too high
        goto label 1
    }
    if (openbottom - slidemo.z > 24 * FRACUNIT) {
        // too big a step up
        goto label 1
    }
    // this line doesn't block movement
    return 1u
    label 1:  // isblocking
    // the line does block movement,
    // see if it is closer than best so far
    if (_c_in.frac < bestslidefrac) {
        secondslidefrac = bestslidefrac
        secondslideline = bestslideline
        bestslidefrac = _c_in.frac
        bestslideline = li
    }
    // stop
    return 0u
}

// P_SlideMove
// The momx / momy move is bad, so try to slide
// along a wall.
// Find the first line hit, move flush to it,
// and slide along it
// This is a kludgy mess.
[unsafe_deref, hint(unsafe_range_check)]
def P_SlideMove(var mo : mobj_s?) {
    var leadx : int
    var leady : int
    var trailx : int
    var traily : int
    var newx : int
    var newy : int
    var hitcount : int
    slidemo = mo
    hitcount = 0
    label 1:  // retry
    hitcount++
    if (hitcount == 3) {
        // don't loop forever
        goto label 2
    }
    // trace along the three leading corners
    if (mo.momx > 0) {
        leadx = mo.x + mo.radius
        trailx = mo.x - mo.radius
    } else {
        leadx = mo.x - mo.radius
        trailx = mo.x + mo.radius
    }
    if (mo.momy > 0) {
        leady = mo.y + mo.radius
        traily = mo.y - mo.radius
    } else {
        leady = mo.y - mo.radius
        traily = mo.y + mo.radius
    }
    bestslidefrac = FRACUNIT + 1
    P_PathTraverse(leadx, leady, leadx + mo.momx, leady + mo.momy, PT_ADDLINES, @@PTR_SlideTraverse)
    P_PathTraverse(trailx, leady, trailx + mo.momx, leady + mo.momy, PT_ADDLINES, @@PTR_SlideTraverse)
    P_PathTraverse(leadx, traily, leadx + mo.momx, traily + mo.momy, PT_ADDLINES, @@PTR_SlideTraverse)
    // move up to the wall
    if (!(bestslidefrac == FRACUNIT + 1)) {
        goto label 3
    }
    label 2:  // stairstep
    // the move most have hit the middle, so stairstep
    if (P_TryMove(mo, mo.x, mo.y + mo.momy) == 0) {
        P_TryMove(mo, mo.x + mo.momx, mo.y)
    }
    return
    label 3:  // end if
    // fudge a bit to make sure it doesn't hit
    bestslidefrac -= 2048
    if (bestslidefrac > 0) {
        newx = FixedMul(mo.momx, bestslidefrac)
        newy = FixedMul(mo.momy, bestslidefrac)
        if (P_TryMove(mo, mo.x + newx, mo.y + newy) == 0) {
            goto label 2
        }
    }
    // Now continue along the wall.
    // First calculate remainder.
    bestslidefrac = FRACUNIT - (bestslidefrac + 2048)
    if (bestslidefrac > FRACUNIT) {
        bestslidefrac = FRACUNIT
    }
    if (bestslidefrac <= 0) {
        return
    }
    tmxmove = FixedMul(mo.momx, bestslidefrac)
    tmymove = FixedMul(mo.momy, bestslidefrac)
    // clip the moves
    P_HitSlideLine(bestslideline)
    mo.momx = tmxmove
    mo.momy = tmymove
    if (P_TryMove(mo, mo.x + tmxmove, mo.y + tmymove) == 0) {
        goto label 1
    }
}

// PTR_AimTraverse
// Sets linetaget and aimslope when a target is aimed at.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PTR_AimTraverse(var _c_in : intercept_t?) : uint {
    var li : line_s?
    var th : mobj_s?
    var slope : int
    var thingtopslope : int
    var thingbottomslope : int
    var dist : int
    if (_c_in.isaline != 0) {
        li = _c_in.d.line
        if ((int(li.flags) & ML_TWOSIDED) == 0) {
            // stop
            return 0u
        }
        // Crosses a two sided line.
        // A two sided line will restrict
        // the possible target ranges.
        P_LineOpening(li)
        if (openbottom >= opentop) {
            // stop
            return 0u
        }
        dist = FixedMul(attackrange, _c_in.frac)
        if (li.backsector == null || li.frontsector.floorheight != li.backsector.floorheight) {
            slope = FixedDiv(openbottom - shootz, dist)
            if (slope > bottomslope) {
                bottomslope = slope
            }
        }
        if (li.backsector == null || li.frontsector.ceilingheight != li.backsector.ceilingheight) {
            slope = FixedDiv(opentop - shootz, dist)
            if (slope < topslope) {
                topslope = slope
            }
        }
        if (topslope <= bottomslope) {
            // stop
            return 0u
        }
        // shot continues
        return 1u
    }
    // shoot a thing
    th = _c_in.d.thing
    if (th == shootthing) {
        // can't shoot self
        return 1u
    }
    if ((th.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // corpse or something
        return 1u
    }
    // check angles to see if the thing can be aimed at
    dist = FixedMul(attackrange, _c_in.frac)
    thingtopslope = FixedDiv(th.z + th.height - shootz, dist)
    if (thingtopslope < bottomslope) {
        // shot over the thing
        return 1u
    }
    thingbottomslope = FixedDiv(th.z - shootz, dist)
    if (thingbottomslope > topslope) {
        // shot under the thing
        return 1u
    }
    // this thing can be hit!
    if (thingtopslope > topslope) {
        thingtopslope = topslope
    }
    if (thingbottomslope < bottomslope) {
        thingbottomslope = bottomslope
    }
    aimslope = (thingtopslope + thingbottomslope) / 2
    linetarget = th
    // don't go any farther
    return 0u
}

// PTR_ShootTraverse
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PTR_ShootTraverse(var _c_in : intercept_t?) : uint {
    var x : int
    var y : int
    var z : int
    var frac : int
    var li : line_s?
    var th : mobj_s?
    var slope : int
    var dist : int
    var thingtopslope : int
    var thingbottomslope : int
    if (_c_in.isaline != 0) {
        li = _c_in.d.line
        if (li.special != 0) {
            P_ShootSpecialLine(shootthing, li)
        }
        if ((int(li.flags) & ML_TWOSIDED) == 0) {
            goto label 1
        }
        // crosses a two sided line
        P_LineOpening(li)
        dist = FixedMul(attackrange, _c_in.frac)
        // e6y: emulation of missed back side on two-sided lines.
        // backsector can be NULL when emulating missing back side.
        if (li.backsector == null) {
            slope = FixedDiv(openbottom - shootz, dist)
            if (slope > aimslope) {
                goto label 1
            }
            slope = FixedDiv(opentop - shootz, dist)
            if (slope < aimslope) {
                goto label 1
            }
        } else {
            if (li.frontsector.floorheight != li.backsector.floorheight) {
                slope = FixedDiv(openbottom - shootz, dist)
                if (slope > aimslope) {
                    goto label 1
                }
            }
            if (li.frontsector.ceilingheight != li.backsector.ceilingheight) {
                slope = FixedDiv(opentop - shootz, dist)
                if (slope < aimslope) {
                    goto label 1
                }
            }
        }
        // shot continues
        return 1u
        label 1:  // hitline
        // hit line
        // position a bit closer
        frac = _c_in.frac - FixedDiv(4 * FRACUNIT, attackrange)
        x = trace.x + FixedMul(trace.dx, frac)
        y = trace.y + FixedMul(trace.dy, frac)
        z = shootz + FixedMul(aimslope, FixedMul(frac, attackrange))
        if (int(li.frontsector.ceilingpic) == skyflatnum) {
            // don't shoot the sky!
            if (z > li.frontsector.ceilingheight) {
                return 0u
            }
            // it's a sky hack wall
            if (li.backsector != null && int(li.backsector.ceilingpic) == skyflatnum) {
                return 0u
            }
        }
        // Spawn bullet puffs.
        P_SpawnPuff(x, y, z)
        // don't go any farther
        return 0u
    }
    // shoot a thing
    th = _c_in.d.thing
    if (th == shootthing) {
        // can't shoot self
        return 1u
    }
    if ((th.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // corpse or something
        return 1u
    }
    // check angles to see if the thing can be aimed at
    dist = FixedMul(attackrange, _c_in.frac)
    thingtopslope = FixedDiv(th.z + th.height - shootz, dist)
    if (thingtopslope < aimslope) {
        // shot over the thing
        return 1u
    }
    thingbottomslope = FixedDiv(th.z - shootz, dist)
    if (thingbottomslope > aimslope) {
        // shot under the thing
        return 1u
    }
    // hit thing
    // position a bit closer
    frac = _c_in.frac - FixedDiv(10 * FRACUNIT, attackrange)
    x = trace.x + FixedMul(trace.dx, frac)
    y = trace.y + FixedMul(trace.dy, frac)
    z = shootz + FixedMul(aimslope, FixedMul(frac, attackrange))
    // Spawn bullet puffs or blod spots,
    // depending on target type.
    if ((_c_in.d.thing.flags & int(mobjflag_t.MF_NOBLOOD)) != 0) {
        P_SpawnPuff(x, y, z)
    } else {
        P_SpawnBlood(x, y, z, la_damage)
    }
    if (la_damage != 0) {
        P_DamageMobj(th, shootthing, shootthing, la_damage)
    }
    // don't go any farther
    return 0u
}

// P_AimLineAttack
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_AimLineAttack(var t1 : mobj_s?; var angle : uint; distance : int) : int {
    var x2 : int
    var y2 : int
    t1 = P_SubstNullMobj(t1)
    angle >>= uint(ANGLETOFINESHIFT)
    shootthing = t1
    x2 = t1.x + (distance >> FRACBITS) * finecosine[angle]
    y2 = t1.y + (distance >> FRACBITS) * finesine[angle]
    shootz = t1.z + (t1.height >> 1) + 8 * FRACUNIT
    // can't shoot outside view angles
    topslope = 100 * FRACUNIT / 160
    bottomslope = -100 * FRACUNIT / 160
    attackrange = distance
    linetarget = null
    P_PathTraverse(t1.x, t1.y, x2, y2, PT_ADDLINES | PT_ADDTHINGS, @@PTR_AimTraverse)
    if (linetarget != null) {
        return aimslope
    }
    return 0
}

// P_LineAttack
// If damage == 0, it is just a test trace
// that will leave linetarget set.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LineAttack(var t1 : mobj_s?; var angle : uint; distance : int; slope : int; damage : int) {
    var x2 : int
    var y2 : int
    angle >>= uint(ANGLETOFINESHIFT)
    shootthing = t1
    la_damage = damage
    x2 = t1.x + (distance >> FRACBITS) * finecosine[angle]
    y2 = t1.y + (distance >> FRACBITS) * finesine[angle]
    shootz = t1.z + (t1.height >> 1) + 8 * FRACUNIT
    attackrange = distance
    aimslope = slope
    P_PathTraverse(t1.x, t1.y, x2, y2, PT_ADDLINES | PT_ADDTHINGS, @@PTR_ShootTraverse)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def PTR_UseTraverse(var _c_in : intercept_t?) : uint {
    var side : int
    if (_c_in.d.line.special == 0) {
        P_LineOpening(_c_in.d.line)
        if (openrange <= 0) {
            S_StartSound(reinterpret<void?>(usething), int(sfxenum_t.sfx_noway))
            // can't use through a wall
            return 0u
        }
        // not a special line, but keep checking
        return 1u
    }
    side = 0
    if (P_PointOnLineSide(usething.x, usething.y, _c_in.d.line) == 1) {
        side = 1
    }
    // return false; // don't use back side
    P_UseSpecialLine(usething, _c_in.d.line, side)
    // can't use for than one special line in a row
    return 0u
}

// P_UseLines
// Looks for special lines in front of the player to activate.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UseLines(var player : player_s?) {
    var angle : int
    var x1 : int
    var y1 : int
    var x2 : int
    var y2 : int
    usething = player.mo
    angle = int(player.mo.angle >> uint(ANGLETOFINESHIFT))
    x1 = player.mo.x
    y1 = player.mo.y
    x2 = x1 + (USERANGE >> FRACBITS) * finecosine[angle]
    y2 = y1 + (USERANGE >> FRACBITS) * finesine[angle]
    P_PathTraverse(x1, y1, x2, y2, PT_ADDLINES, @@PTR_UseTraverse)
}

// PIT_RadiusAttack
// "bombsource" is the creature
// that caused the explosion at "bombspot".
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_RadiusAttack(var thing : mobj_s?) : uint {
    var dx : int
    var dy : int
    var dist : int
    if ((thing.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        return 1u
    }
    // Boss spider and cyborg
    // take no damage from concussion.
    if (thing._c_type == mobjtype_t.MT_CYBORG || thing._c_type == mobjtype_t.MT_SPIDER) {
        return 1u
    }
    dx = crt::abs(thing.x - bombspot.x)
    dy = crt::abs(thing.y - bombspot.y)
    dist = dx > dy ? dx : dy
    dist = (dist - thing.radius) >> FRACBITS
    if (dist < 0) {
        dist = 0
    }
    if (dist >= bombdamage) {
        // out of range
        return 1u
    }
    if (P_CheckSight(thing, bombspot) != 0) {
        // must be in direct path
        P_DamageMobj(thing, bombspot, bombsource, bombdamage - dist)
    }
    return 1u
}

// P_RadiusAttack
// Source is the creature that caused the explosion at spot.
[unsafe_deref, hint(unsafe_range_check)]
def P_RadiusAttack(var spot : mobj_s?; var source : mobj_s?; damage : int) {
    var x : int
    var y : int
    var xl : int
    var xh : int
    var yl : int
    var yh : int
    var dist : int
    dist = (damage + 32 * FRACUNIT) << FRACBITS
    yh = (spot.y + dist - bmaporgy) >> MAPBLOCKSHIFT
    yl = (spot.y - dist - bmaporgy) >> MAPBLOCKSHIFT
    xh = (spot.x + dist - bmaporgx) >> MAPBLOCKSHIFT
    xl = (spot.x - dist - bmaporgx) >> MAPBLOCKSHIFT
    bombspot = spot
    bombsource = source
    bombdamage = damage
    y = yl
    while (y <= yh) {
        x = xl
        while (x <= xh) {
            P_BlockThingsIterator(x, y, @@PIT_RadiusAttack)
            x++
        }
        y++
    }
}

// PIT_ChangeSector
[unsafe_deref, hint(unsafe_range_check)]
def PIT_ChangeSector(var thing : mobj_s?) : uint {
    var mo : mobj_s?
    if (P_ThingHeightClip(thing) != 0) {
        // keep checking
        return 1u
    }
    // crunch bodies to giblets
    if (thing.health <= 0) {
        P_SetMobjState(thing, statenum_t.S_GIBS)
        thing.flags &= ~int(mobjflag_t.MF_SOLID)
        thing.height = 0
        thing.radius = 0
        // keep checking
        return 1u
    }
    // crunch dropped items
    if ((thing.flags & int(mobjflag_t.MF_DROPPED)) != 0) {
        P_RemoveMobj(thing)
        // keep checking
        return 1u
    }
    if ((thing.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // assume it is bloody gibs or something
        return 1u
    }
    nofit = 1u
    if (crushchange != 0 && (leveltime & 3) == 0) {
        P_DamageMobj(thing, null, null, 10)
        // spray blood in a random direction
        mo = P_SpawnMobj(thing.x, thing.y, thing.z + thing.height / 2, mobjtype_t.MT_BLOOD)
        mo.momx = (P_Random() - P_Random()) << 12
        mo.momy = (P_Random() - P_Random()) << 12
    }
    // keep checking (crush other things)
    return 1u
}

// P_ChangeSector
[unsafe_deref, hint(unsafe_range_check)]
def P_ChangeSector(var sector : sector_t?; crunch : uint) : uint {
    var x : int
    var y : int
    nofit = 0u
    crushchange = crunch
    // re-check heights for all things near the moving sector
    x = sector.blockbox[int(anon_982.BOXLEFT)]
    while (x <= sector.blockbox[int(anon_982.BOXRIGHT)]) {
        y = sector.blockbox[int(anon_982.BOXBOTTOM)]
        while (y <= sector.blockbox[int(anon_982.BOXTOP)]) {
            P_BlockThingsIterator(x, y, @@PIT_ChangeSector)
            y++
        }
        x++
    }
    return nofit
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SpechitOverrun(var ld : line_s?) {
    var _c_addr : uint
    if (SpechitOverrun_baseaddr == 0u) {
        var p : int
        // This is the first time we have had an overrun. Work out
        // what base address we are going to use.
        // Allow a spechit value to be specified on the command line.
        // !
        // @category compat
        // @arg <n>
        // Use the specified magic value when emulating spechit overruns.
        p = M_CheckParmWithArgs(cstr("-spechit"), 1)
        if (p > 0) {
            M_StrToInt(myargv[p + 1], reinterpret<int?>(addr(SpechitOverrun_baseaddr)))
        } else {
            SpechitOverrun_baseaddr = uint(DEFAULT_SPECHIT_MAGIC)
        }
    }
    // Calculate address used in doom2.exe
    _c_addr = uint(int64(SpechitOverrun_baseaddr) + int64(ld - lines) * 62l)
    c_switch(numspechit) {
        case(9, 10, 11, 12) {
            tmbbox[numspechit - 9] = int(_c_addr)
            break
        }
        case(13) {
            crushchange = _c_addr
            break
        }
        case(14) {
            nofit = _c_addr
            break
        }
        case(_) {
            fprintf(crt::c_stderr(), cstr("SpechitOverrun: Warning: unable to emulatean overrun where numspechit=%i\n"), numspechit)
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_AproxDistance(var dx : int; var dy : int) : int {
    dx = crt::abs(dx)
    dy = crt::abs(dy)
    if (dx < dy) {
        return dx + dy - (dx >> 1)
    }
    return dx + dy - (dy >> 1)
}

// P_PointOnLineSide
// Returns 0 or 1
[unsafe_deref, hint(unsafe_range_check)]
def P_PointOnLineSide(x : int; y : int; var line : line_s?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (line.dx == 0) {
        if (x <= line.v1.x) {
            return int_of(line.dy > 0)
        }
        return int_of(line.dy < 0)
    }
    if (line.dy == 0) {
        if (y <= line.v1.y) {
            return int_of(line.dx < 0)
        }
        return int_of(line.dx > 0)
    }
    dx = x - line.v1.x
    dy = y - line.v1.y
    left = FixedMul(line.dy >> FRACBITS, dx)
    right = FixedMul(dy, line.dx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

// P_BoxOnLineSide
// Considers the line to be infinite
// Returns side 0 or 1, -1 if box crosses the line.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BoxOnLineSide(var tmbox : int?; var ld : line_s?) : int {
    var p1 : int = 0
    var p2 : int = 0
    c_switch(ld.slopetype) {
        case(slopetype_t.ST_HORIZONTAL) {
            p1 = int_of(tmbox[int(anon_982.BOXTOP)] > ld.v1.y)
            p2 = int_of(tmbox[int(anon_982.BOXBOTTOM)] > ld.v1.y)
            if (ld.dx < 0) {
                p1 ^= 1
                p2 ^= 1
            }
            break
        }
        case(slopetype_t.ST_VERTICAL) {
            p1 = int_of(tmbox[int(anon_982.BOXRIGHT)] < ld.v1.x)
            p2 = int_of(tmbox[int(anon_982.BOXLEFT)] < ld.v1.x)
            if (ld.dy < 0) {
                p1 ^= 1
                p2 ^= 1
            }
            break
        }
        case(slopetype_t.ST_POSITIVE) {
            p1 = P_PointOnLineSide(tmbox[int(anon_982.BOXLEFT)], tmbox[int(anon_982.BOXTOP)], ld)
            p2 = P_PointOnLineSide(tmbox[int(anon_982.BOXRIGHT)], tmbox[int(anon_982.BOXBOTTOM)], ld)
            break
        }
        case(slopetype_t.ST_NEGATIVE) {
            p1 = P_PointOnLineSide(tmbox[int(anon_982.BOXRIGHT)], tmbox[int(anon_982.BOXTOP)], ld)
            p2 = P_PointOnLineSide(tmbox[int(anon_982.BOXLEFT)], tmbox[int(anon_982.BOXBOTTOM)], ld)
            break
        }
    }
    if (p1 == p2) {
        return p1
    }
    return -1
}

// P_PointOnDivlineSide
// Returns 0 or 1.
[unsafe_deref, hint(unsafe_range_check)]
def P_PointOnDivlineSide(x : int; y : int; var line : divline_t?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (line.dx == 0) {
        if (x <= line.x) {
            return int_of(line.dy > 0)
        }
        return int_of(line.dy < 0)
    }
    if (line.dy == 0) {
        if (y <= line.y) {
            return int_of(line.dx < 0)
        }
        return int_of(line.dx > 0)
    }
    dx = x - line.x
    dy = y - line.y
    // try to quickly decide by looking at sign bits
    if ((uint(line.dy ^ line.dx ^ dx ^ dy) & 2147483648u) != 0) {
        if ((uint(line.dy ^ dx) & 2147483648u) != 0) {
            // (left is negative)
            return 1
        }
        return 0
    }
    left = FixedMul(line.dy >> 8, dx >> 8)
    right = FixedMul(dy >> 8, line.dx >> 8)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

// P_MakeDivline
[unsafe_deref, hint(unsafe_range_check)]
def P_MakeDivline(var li : line_s?; var dl : divline_t?) {
    dl.x = li.v1.x
    dl.y = li.v1.y
    dl.dx = li.dx
    dl.dy = li.dy
}

// P_InterceptVector
// Returns the fractional intercept point
// along the first divline.
// This is only called by the addthings
// and addlines traversers.
[unsafe_deref, hint(unsafe_range_check)]
def P_InterceptVector(var v2 : divline_t?; var v1 : divline_t?) : int {
    var frac : int
    var num : int
    var den : int
    den = FixedMul(v1.dy >> 8, v2.dx) - FixedMul(v1.dx >> 8, v2.dy)
    if (den == 0) {
        return 0
    }
    // I_Error ("P_InterceptVector: parallel");
    num = FixedMul((v1.x - v2.x) >> 8, v1.dy) + FixedMul((v2.y - v1.y) >> 8, v1.dx)
    frac = FixedDiv(num, den)
    return frac
}

[unsafe_deref, hint(unsafe_range_check)]
def P_LineOpening(var linedef : line_s?) {
    var front : sector_t?
    var back : sector_t?
    if (linedef.sidenum[1] == -1) {
        // single sided line
        openrange = 0
        return
    }
    front = linedef.frontsector
    back = linedef.backsector
    if (front.ceilingheight < back.ceilingheight) {
        opentop = front.ceilingheight
    } else {
        opentop = back.ceilingheight
    }
    if (front.floorheight > back.floorheight) {
        openbottom = front.floorheight
        lowfloor = back.floorheight
    } else {
        openbottom = back.floorheight
        lowfloor = front.floorheight
    }
    openrange = opentop - openbottom
}

// P_UnsetThingPosition
// Unlinks a thing from block map and sectors.
// On each position change, BLOCKMAP and other
// lookups maintaining lists ot things inside
// these structures need to be updated.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UnsetThingPosition(var thing : mobj_s?) {
    var blockx : int
    var blocky : int
    if ((thing.flags & int(mobjflag_t.MF_NOSECTOR)) == 0) {
        // inert things don't need to be in blockmap?
        // unlink from subsector
        if (thing.snext != null) {
            thing.snext.sprev = thing.sprev
        }
        if (thing.sprev != null) {
            thing.sprev.snext = thing.snext
        } else {
            thing.subsector.sector.thinglist = thing.snext
        }
    }
    if ((thing.flags & int(mobjflag_t.MF_NOBLOCKMAP)) == 0) {
        // inert things don't need to be in blockmap
        // unlink from block map
        if (thing.bnext != null) {
            thing.bnext.bprev = thing.bprev
        }
        if (thing.bprev != null) {
            thing.bprev.bnext = thing.bnext
        } else {
            blockx = (thing.x - bmaporgx) >> MAPBLOCKSHIFT
            blocky = (thing.y - bmaporgy) >> MAPBLOCKSHIFT
            if (blockx >= 0 && blockx < bmapwidth && blocky >= 0 && blocky < bmapheight) {
                blocklinks[blocky * bmapwidth + blockx] = thing.bnext
            }
        }
    }
}

// P_SetThingPosition
// Links a thing into both a block and a subsector
// based on it's x y.
// Sets thing->subsector properly
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SetThingPosition(var thing : mobj_s?) {
    var ss : subsector_s?
    var sec : sector_t?
    var blockx : int
    var blocky : int
    var link : mobj_s ??
    // link into subsector
    ss = R_PointInSubsector(thing.x, thing.y)
    thing.subsector = ss
    if ((thing.flags & int(mobjflag_t.MF_NOSECTOR)) == 0) {
        // invisible things don't go into the sector links
        sec = ss.sector
        thing.sprev = null
        thing.snext = sec.thinglist
        if (sec.thinglist != null) {
            sec.thinglist.sprev = thing
        }
        sec.thinglist = thing
    }
    // link into blockmap
    if ((thing.flags & int(mobjflag_t.MF_NOBLOCKMAP)) == 0) {
        // inert things don't need to be in blockmap
        blockx = (thing.x - bmaporgx) >> MAPBLOCKSHIFT
        blocky = (thing.y - bmaporgy) >> MAPBLOCKSHIFT
        if (blockx >= 0 && blockx < bmapwidth && blocky >= 0 && blocky < bmapheight) {
            link = addr(blocklinks[blocky * bmapwidth + blockx])
            thing.bprev = null
            thing.bnext = *link
            if (*link != null) {
                (*link).bprev = thing
            }
            *link = thing
        } else {
            // thing is off the map
            thing.bprev = null
            thing.bnext = thing.bprev
        }
    }
}

// P_BlockLinesIterator
// The validcount flags are used to avoid checking lines
// that are marked in multiple mapblocks,
// so increment validcount before the first call
// to P_BlockLinesIterator, then make one or more calls
// to it.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BlockLinesIterator(x : int; y : int; func : function<(var a0 : line_s?) : uint>) : uint {
    var offset : int
    var list : int16?
    var ld : line_s?
    if (x < 0 || y < 0 || x >= bmapwidth || y >= bmapheight) {
        return 1u
    }
    offset = y * bmapwidth + x
    offset = int(blockmap[offset])
    {
        list = blockmaplump + offset
        var _f = false
        while (true) {
            if (_f) {
                list++
            }
            _f = true
            if (!(*list != -1)) {
                break
            }
            ld = addr(lines[int(*list)])
            if (ld.validcount == validcount) {
                // line has already been checked
                continue
            }
            ld.validcount = validcount
            if (invoke(func, ld) == 0) {
                return 0u
            }
        }
    }
    // everything was checked
    return 1u
}

// P_BlockThingsIterator
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BlockThingsIterator(x : int; y : int; func : function<(var a0 : mobj_s?) : uint>) : uint {
    var mobj : mobj_s?
    if (x < 0 || y < 0 || x >= bmapwidth || y >= bmapheight) {
        return 1u
    }
    mobj = blocklinks[y * bmapwidth + x]
    while (mobj != null) {
        if (invoke(func, mobj) == 0) {
            return 0u
        }
        mobj = mobj.bnext
    }
    return 1u
}

// PIT_AddLineIntercepts.
// Looks for lines in the given block
// that intercept the given trace
// to add to the intercepts list.
// A line is crossed if its endpoints
// are on opposite sides of the trace.
// Returns true if earlyout and a solid line hit.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_AddLineIntercepts(var ld : line_s?) : uint {
    var s1 : int
    var s2 : int
    var frac : int
    var dl : divline_t
    // avoid precision problems with two routines
    if (trace.dx > FRACUNIT * 16 || trace.dy > FRACUNIT * 16 || trace.dx < -FRACUNIT * 16 || trace.dy < -FRACUNIT * 16) {
        s1 = P_PointOnDivlineSide(ld.v1.x, ld.v1.y, addr(trace))
        s2 = P_PointOnDivlineSide(ld.v2.x, ld.v2.y, addr(trace))
    } else {
        s1 = P_PointOnLineSide(trace.x, trace.y, ld)
        s2 = P_PointOnLineSide(trace.x + trace.dx, trace.y + trace.dy, ld)
    }
    if (s1 == s2) {
        // line isn't crossed
        return 1u
    }
    // hit the line
    P_MakeDivline(ld, addr(dl))
    frac = P_InterceptVector(addr(trace), addr(dl))
    if (frac < 0) {
        // behind source
        return 1u
    }
    // try to early out the check
    if (earlyout != 0 && frac < FRACUNIT && ld.backsector == null) {
        // stop checking
        return 0u
    }
    intercept_p.frac = frac
    intercept_p.isaline = 1u
    intercept_p.d.line = ld
    doom_all__InterceptsOverrun(int(int64(intercept_p - addr(intercepts[0]))), intercept_p)
    intercept_p++
    // continue
    return 1u
}

// PIT_AddThingIntercepts
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_AddThingIntercepts(var thing : mobj_s?) : uint {
    var x1 : int
    var y1 : int
    var x2 : int
    var y2 : int
    var s1 : int
    var s2 : int
    var tracepositive : uint
    var dl : divline_t
    var frac : int
    tracepositive = uint(int_of((trace.dx ^ trace.dy) > 0))
    // check a corner to corner crossection for hit
    if (tracepositive != 0) {
        x1 = thing.x - thing.radius
        y1 = thing.y + thing.radius
        x2 = thing.x + thing.radius
        y2 = thing.y - thing.radius
    } else {
        x1 = thing.x - thing.radius
        y1 = thing.y - thing.radius
        x2 = thing.x + thing.radius
        y2 = thing.y + thing.radius
    }
    s1 = P_PointOnDivlineSide(x1, y1, addr(trace))
    s2 = P_PointOnDivlineSide(x2, y2, addr(trace))
    if (s1 == s2) {
        // line isn't crossed
        return 1u
    }
    dl.x = x1
    dl.y = y1
    dl.dx = x2 - x1
    dl.dy = y2 - y1
    frac = P_InterceptVector(addr(trace), addr(dl))
    if (frac < 0) {
        // behind source
        return 1u
    }
    intercept_p.frac = frac
    intercept_p.isaline = 0u
    intercept_p.d.thing = thing
    doom_all__InterceptsOverrun(int(int64(intercept_p - addr(intercepts[0]))), intercept_p)
    intercept_p++
    // keep going
    return 1u
}

// P_TraverseIntercepts
// Returns true if the traverser function returns true
// for all lines.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_TraverseIntercepts(func : function<(var a0 : intercept_t?) : uint>; maxfrac : int) : uint {
    var count : int
    var dist : int
    var scan : intercept_t?
    var _c_in : intercept_t?
    count = int(int64(intercept_p - addr(intercepts[0])))
    // shut up compiler warning
    _c_in = null
    while (true) {
        let _t0 = count
        count--
        if (_t0 == 0) {
            break
        }
        dist = 2147483647
        scan = addr(intercepts[0])
        while (reinterpret<uint64>(scan) < reinterpret<uint64>(intercept_p)) {
            if (scan.frac < dist) {
                dist = scan.frac
                _c_in = scan
            }
            scan++
        }
        if (dist > maxfrac) {
            // checked everything in range
            return 1u
        }
        // UNUSED
        // don't check these yet, there may be others inserted
        if (invoke(func, _c_in) == 0) {
            // don't bother going farther
            return 0u
        }
        _c_in.frac = 2147483647
    }
    // everything was traversed
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__InterceptsMemoryOverrun(location : int; value : int) {
    var i : int
    var offset : int
    var index : int
    var _c_addr : void?
    i = 0
    offset = 0
    // Search down the array until we find the right entry
    while (doom_all__intercepts_overrun[i].len != 0) {
        if (offset + doom_all__intercepts_overrun[i].len > location) {
            _c_addr = doom_all__intercepts_overrun[i]._c_addr
            // Write the value to the memory location.
            // 16-bit and 32-bit values are written differently.
            if (_c_addr != null) {
                if (doom_all__intercepts_overrun[i].int16_array != 0) {
                    index = (location - offset) / 2
                    reinterpret<int16?>(_c_addr)[index] = int16(value & 65535)
                    reinterpret<int16?>(_c_addr)[index + 1] = int16((value >> 16) & 65535)
                } else {
                    index = (location - offset) / 4
                    reinterpret<int?>(_c_addr)[index] = value
                }
            }
            break
        }
        offset += doom_all__intercepts_overrun[i].len
        i++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__InterceptsOverrun(num_intercepts : int; var intercept : intercept_t?) {
    var location : int
    if (num_intercepts <= MAXINTERCEPTS_ORIGINAL) {
        // No overrun
        return
    }
    location = (num_intercepts - MAXINTERCEPTS_ORIGINAL - 1) * 12
    // Overwrite memory that is overwritten in Vanilla Doom, using
    // the values from the intercept structure.
    // Note: the ->d.{thing,line} member should really have its
    // address translated into the correct address value for
    // Vanilla Doom.
    doom_all__InterceptsMemoryOverrun(location, intercept.frac)
    doom_all__InterceptsMemoryOverrun(location + 4, int(intercept.isaline))
    doom_all__InterceptsMemoryOverrun(location + 8, int(intptr(intercept.d.thing)))
}

// P_PathTraverse
// Traces a line from x1,y1 to x2,y2,
// calling the traverser function for each.
// Returns true if the traverser function returns true
// for all lines.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_PathTraverse(var x1 : int; var y1 : int; var x2 : int; var y2 : int; flags : int; trav : function<(var a0 : intercept_t?) : uint>) : uint {
    var xt1 : int
    var yt1 : int
    var xt2 : int
    var yt2 : int
    var xstep : int
    var ystep : int
    var partial : int
    var xintercept : int
    var yintercept : int
    var mapx : int
    var mapy : int
    var mapxstep : int
    var mapystep : int
    earlyout = uint(flags & PT_EARLYOUT)
    validcount++
    intercept_p = addr(intercepts[0])
    if (((x1 - bmaporgx) & (MAPBLOCKSIZE - 1)) == 0) {
        // don't side exactly on a line
        x1 += FRACUNIT
    }
    if (((y1 - bmaporgy) & (MAPBLOCKSIZE - 1)) == 0) {
        // don't side exactly on a line
        y1 += FRACUNIT
    }
    trace.x = x1
    trace.y = y1
    trace.dx = x2 - x1
    trace.dy = y2 - y1
    x1 -= bmaporgx
    y1 -= bmaporgy
    xt1 = x1 >> MAPBLOCKSHIFT
    yt1 = y1 >> MAPBLOCKSHIFT
    x2 -= bmaporgx
    y2 -= bmaporgy
    xt2 = x2 >> MAPBLOCKSHIFT
    yt2 = y2 >> MAPBLOCKSHIFT
    if (xt2 > xt1) {
        mapxstep = 1
        partial = FRACUNIT - ((x1 >> MAPBTOFRAC) & (FRACUNIT - 1))
        ystep = FixedDiv(y2 - y1, crt::abs(x2 - x1))
    } elif (xt2 < xt1) {
        mapxstep = -1
        partial = (x1 >> MAPBTOFRAC) & (FRACUNIT - 1)
        ystep = FixedDiv(y2 - y1, crt::abs(x2 - x1))
    } else {
        mapxstep = 0
        partial = FRACUNIT
        ystep = 256 * FRACUNIT
    }
    yintercept = (y1 >> MAPBTOFRAC) + FixedMul(partial, ystep)
    if (yt2 > yt1) {
        mapystep = 1
        partial = FRACUNIT - ((y1 >> MAPBTOFRAC) & (FRACUNIT - 1))
        xstep = FixedDiv(x2 - x1, crt::abs(y2 - y1))
    } elif (yt2 < yt1) {
        mapystep = -1
        partial = (y1 >> MAPBTOFRAC) & (FRACUNIT - 1)
        xstep = FixedDiv(x2 - x1, crt::abs(y2 - y1))
    } else {
        mapystep = 0
        partial = FRACUNIT
        xstep = 256 * FRACUNIT
    }
    xintercept = (x1 >> MAPBTOFRAC) + FixedMul(partial, xstep)
    // Step through map blocks.
    // Count is present to prevent a round off error
    // from skipping the break.
    mapx = xt1
    mapy = yt1
    for (count in range(64)) {
        if ((flags & PT_ADDLINES) != 0) {
            if (P_BlockLinesIterator(mapx, mapy, @@PIT_AddLineIntercepts) == 0) {
                // early out
                return 0u
            }
        }
        if ((flags & PT_ADDTHINGS) != 0) {
            if (P_BlockThingsIterator(mapx, mapy, @@PIT_AddThingIntercepts) == 0) {
                // early out
                return 0u
            }
        }
        if (mapx == xt2 && mapy == yt2) {
            break
        }
        if ((yintercept >> FRACBITS) == mapy) {
            yintercept += ystep
            mapx += mapxstep
        } elif ((xintercept >> FRACBITS) == mapx) {
            xintercept += xstep
            mapy += mapystep
        }
    }
    // go through the sorted list
    return P_TraverseIntercepts(trav, FRACUNIT)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SetMobjState(var mobj : mobj_s?; var state : statenum_t) : uint {
    var st : state_t?
    c_do_while(mobj.tics == 0) {
        if (state == statenum_t.S_NULL) {
            mobj.state = null
            P_RemoveMobj(mobj)
            return 0u
        }
        st = addr(states[0]) + end_index(int(state), 967)
        mobj.state = st
        mobj.tics = st.tics
        mobj.sprite = st.sprite
        mobj.frame = st.frame
        // Modified handling.
        // Call action functions when the state is set
        if (st.action.acp1 != null) {
            invoke(st.action.acp1, reinterpret<void?>(mobj))
        }
        state = st.nextstate
    }
    return 1u
}

// P_ExplodeMissile
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ExplodeMissile(var mo : mobj_s?) {
    mo.momz = 0
    mo.momy = mo.momz
    mo.momx = mo.momy
    P_SetMobjState(mo, enum_from_int(type<statenum_t>, mobjinfo[int(mo._c_type)].deathstate))
    mo.tics -= P_Random() & 3
    if (mo.tics < 1) {
        mo.tics = 1
    }
    mo.flags &= ~int(mobjflag_t.MF_MISSILE)
    if (mo.info.deathsound != 0) {
        S_StartSound(reinterpret<void?>(mo), mo.info.deathsound)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_XYMovement(var mo : mobj_s?) {
    var ptryx : int
    var ptryy : int
    var player : player_s?
    var xmove : int
    var ymove : int
    if (mo.momx == 0 && mo.momy == 0) {
        if ((mo.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
            // the skull slammed into something
            mo.flags &= ~int(mobjflag_t.MF_SKULLFLY)
            mo.momz = 0
            mo.momy = mo.momz
            mo.momx = mo.momy
            P_SetMobjState(mo, enum_from_int(type<statenum_t>, mo.info.spawnstate))
        }
        return
    }
    player = mo.player
    if (mo.momx > MAXMOVE) {
        mo.momx = MAXMOVE
    } elif (mo.momx < -MAXMOVE) {
        mo.momx = -MAXMOVE
    }
    if (mo.momy > MAXMOVE) {
        mo.momy = MAXMOVE
    } elif (mo.momy < -MAXMOVE) {
        mo.momy = -MAXMOVE
    }
    xmove = mo.momx
    ymove = mo.momy
    c_do_while(xmove != 0 || ymove != 0) {
        if (xmove > MAXMOVE / 2 || ymove > MAXMOVE / 2) {
            ptryx = mo.x + xmove / 2
            ptryy = mo.y + ymove / 2
            xmove >>= 1
            ymove >>= 1
        } else {
            ptryx = mo.x + xmove
            ptryy = mo.y + ymove
            ymove = 0
            xmove = ymove
        }
        if (P_TryMove(mo, ptryx, ptryy) == 0) {
            // blocked move
            if (mo.player != null) {
                // try to slide along it
                P_SlideMove(mo)
            } elif ((mo.flags & int(mobjflag_t.MF_MISSILE)) != 0) {
                // explode a missile
                if (ceilingline != null && ceilingline.backsector != null && int(ceilingline.backsector.ceilingpic) == skyflatnum) {
                    // Hack to prevent missiles exploding
                    // against the sky.
                    // Does not handle sky floors.
                    P_RemoveMobj(mo)
                    return
                }
                P_ExplodeMissile(mo)
            } else {
                mo.momy = 0
                mo.momx = mo.momy
            }
        }
    }
    // slow down
    if (player != null && (player.cheats & int(cheat_t.CF_NOMOMENTUM)) != 0) {
        // debug option for no sliding at all
        mo.momy = 0
        mo.momx = mo.momy
        return
    }
    if ((mo.flags & (int(mobjflag_t.MF_MISSILE) | int(mobjflag_t.MF_SKULLFLY))) != 0) {
        // no friction for missiles ever
        return
    }
    if (mo.z > mo.floorz) {
        // no friction when airborne
        return
    }
    if ((mo.flags & int(mobjflag_t.MF_CORPSE)) != 0) {
        // do not stop sliding
        // if halfway off a step with some momentum
        if (mo.momx > FRACUNIT / 4 || mo.momx < -FRACUNIT / 4 || mo.momy > FRACUNIT / 4 || mo.momy < -FRACUNIT / 4) {
            if (mo.floorz != mo.subsector.sector.floorheight) {
                return
            }
        }
    }
    if (mo.momx > -STOPSPEED && mo.momx < STOPSPEED && mo.momy > -STOPSPEED && mo.momy < STOPSPEED &&
            (player == null || (player.cmd.forwardmove == 0 && player.cmd.sidemove == 0))) {
        // if in a walking frame, stop moving
        if (player != null && uint(int64(player.mo.state - addr(states[0])) - int64(uint(statenum_t.S_PLAY_RUN1))) < 4u) {
            P_SetMobjState(player.mo, statenum_t.S_PLAY)
        }
        mo.momx = 0
        mo.momy = 0
    } else {
        mo.momx = FixedMul(mo.momx, FRICTION)
        mo.momy = FixedMul(mo.momy, FRICTION)
    }
}

// P_ZMovement
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ZMovement(var mo : mobj_s?) {
    var dist : int
    var delta : int
    // check for smooth step up
    if (mo.player != null && mo.z < mo.floorz) {
        mo.player.viewheight -= mo.floorz - mo.z
        mo.player.deltaviewheight = (VIEWHEIGHT - mo.player.viewheight) >> 3
    }
    // adjust height
    mo.z += mo.momz
    if ((mo.flags & int(mobjflag_t.MF_FLOAT)) != 0 && mo.target != null) {
        // float down towards target if too close
        if ((mo.flags & int(mobjflag_t.MF_SKULLFLY)) == 0 && (mo.flags & int(mobjflag_t.MF_INFLOAT)) == 0) {
            dist = P_AproxDistance(mo.x - mo.target.x, mo.y - mo.target.y)
            delta = (mo.target.z + (mo.height >> 1)) - mo.z
            if (delta < 0 && dist < -(delta * 3)) {
                mo.z -= FLOATSPEED
            } elif (delta > 0 && dist < (delta * 3)) {
                mo.z += FLOATSPEED
            }
        }
    }
    // clip movement
    if (mo.z <= mo.floorz) {
        // hit the floor
        // Note (id):
        // somebody left this after the setting momz to 0,
        // kinda useless there.
        // cph - This was the a bug in the linuxdoom-1.10 source which
        // caused it not to sync Doom 2 v1.9 demos. Someone
        // added the above comment and moved up the following code. So
        // demos would desync in close lost soul fights.
        // Note that this only applies to original Doom 1 or Doom2 demos - not
        // Final Doom and Ultimate Doom. So we test demo_compatibility *and
        // gamemission. (Note we assume that Doom1 is always Ult Doom, which
        // seems to hold for most published demos.)
        // fraggle - cph got the logic here slightly wrong. There are three
        // versions of Doom 1.9:
        // The version used in registered doom 1.9 + doom2 - no bounce
        // The version used in ultimate doom - has bounce
        // The version used in final doom - has bounce
        // So we need to check that this is either retail or commercial
        // (but not doom2)
        let correct_lost_soul_bounce : int = int_of(uint(gameversion) >= uint(GameVersion_t.exe_ultimate))
        if (correct_lost_soul_bounce != 0 && (mo.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
            // the skull slammed into something
            mo.momz = -mo.momz
        }
        if (mo.momz < 0) {
            if (mo.player != null && mo.momz < -FRACUNIT * 8) {
                // Squat down.
                // Decrease viewheight for a moment
                // after hitting the ground (hard),
                // and utter appropriate sound.
                mo.player.deltaviewheight = mo.momz >> 3
                S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_oof))
            }
            mo.momz = 0
        }
        mo.z = mo.floorz
        // cph 2001/05/26 -
        // See lost soul bouncing comment above. We need this here for bug
        // compatibility with original Doom2 v1.9 - if a soul is charging and
        // hit by a raising floor this incorrectly reverses its Y momentum.
        if (correct_lost_soul_bounce == 0 && (mo.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
            mo.momz = -mo.momz
        }
        if ((mo.flags & int(mobjflag_t.MF_MISSILE)) != 0 && (mo.flags & int(mobjflag_t.MF_NOCLIP)) == 0) {
            P_ExplodeMissile(mo)
            return
        }
    } elif ((mo.flags & int(mobjflag_t.MF_NOGRAVITY)) == 0) {
        if (mo.momz == 0) {
            mo.momz = -FRACUNIT * 2
        } else {
            mo.momz -= FRACUNIT
        }
    }
    if (mo.z + mo.height > mo.ceilingz) {
        // hit the ceiling
        if (mo.momz > 0) {
            mo.momz = 0
        }
        mo.z = mo.ceilingz - mo.height
        if ((mo.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
            // the skull slammed into something
            mo.momz = -mo.momz
        }
        if ((mo.flags & int(mobjflag_t.MF_MISSILE)) != 0 && (mo.flags & int(mobjflag_t.MF_NOCLIP)) == 0) {
            P_ExplodeMissile(mo)
            return
        }
    }
}

// P_NightmareRespawn
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_NightmareRespawn(var mobj : mobj_s?) {
    var x : int
    var y : int
    var z : int
    var ss : subsector_s?
    var mo : mobj_s?
    var mthing : mapthing_t?
    x = int(mobj.spawnpoint.x) << FRACBITS
    y = int(mobj.spawnpoint.y) << FRACBITS
    // somthing is occupying it's position?
    if (P_CheckPosition(mobj, x, y) == 0) {
        // no respwan
        return
    }
    // spawn a teleport fog at old spot
    // because of removal of the body?
    mo = P_SpawnMobj(mobj.x, mobj.y, mobj.subsector.sector.floorheight, mobjtype_t.MT_TFOG)
    // initiate teleport sound
    S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_telept))
    // spawn a teleport fog at the new spot
    ss = R_PointInSubsector(x, y)
    mo = P_SpawnMobj(x, y, ss.sector.floorheight, mobjtype_t.MT_TFOG)
    S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_telept))
    // spawn the new monster
    mthing = addr(mobj.spawnpoint)
    // spawn it
    if ((mobj.info.flags & int(mobjflag_t.MF_SPAWNCEILING)) != 0) {
        z = 2147483647
    } else {
        z = -2147483647 - 1
    }
    // inherit attributes from deceased one
    mo = P_SpawnMobj(x, y, z, mobj._c_type)
    mo.spawnpoint = mobj.spawnpoint
    mo.angle = uint(ANG45 * (int(mthing.angle) / 45))
    if ((int(mthing._c_options) & MTF_AMBUSH) != 0) {
        mo.flags |= int(mobjflag_t.MF_AMBUSH)
    }
    mo.reactiontime = 18
    // remove the old monster,
    P_RemoveMobj(mobj)
}

// P_MobjThinker
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_MobjThinker(var mobj : mobj_s?) {
    // momentum movement
    if (mobj.momx != 0 || mobj.momy != 0 || (mobj.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
        P_XYMovement(mobj)
        // FIXME: decent NOP/NULL/Nil function pointer please.
        if (mobj.thinker._c_function.acv == reinterpret<function<() : void>>(uint64(-1))) {
            // mobj was removed
            return
        }
    }
    if ((mobj.z != mobj.floorz) || mobj.momz != 0) {
        P_ZMovement(mobj)
        // FIXME: decent NOP/NULL/Nil function pointer please.
        if (mobj.thinker._c_function.acv == reinterpret<function<() : void>>(uint64(-1))) {
            // mobj was removed
            return
        }
    }
    // cycle through states,
    // calling action functions at transitions
    if (mobj.tics != -1) {
        mobj.tics--
        // you can cycle through multiple states in a tic
        if (mobj.tics == 0) {
            if (P_SetMobjState(mobj, mobj.state.nextstate) == 0) {
                // freed itself
                return
            }
        }
    } else {
        // check for nightmare respawn
        if ((mobj.flags & int(mobjflag_t.MF_COUNTKILL)) == 0) {
            return
        }
        if (respawnmonsters == 0) {
            return
        }
        mobj.movecount++
        if (mobj.movecount < 12 * TICRATE) {
            return
        }
        if ((leveltime & 31) != 0) {
            return
        }
        if (P_Random() > 4) {
            return
        }
        P_NightmareRespawn(mobj)
    }
}

// P_SpawnMobj
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnMobj(x : int; y : int; z : int; _c_type : mobjtype_t) : mobj_s? {
    var mobj : mobj_s?
    var st : state_t?
    var info : mobjinfo_t?
    mobj = reinterpret<mobj_s?>(Z_Malloc(typeinfo sizeof(type<mobj_s>), int(anon_28.PU_LEVEL), null))
    crt::memset(reinterpret<void?>(mobj), 0, uint64(typeinfo sizeof(type<mobj_s>)))
    info = addr(mobjinfo[0]) + end_index(int(_c_type), 137)
    mobj._c_type = _c_type
    mobj.info = info
    mobj.x = x
    mobj.y = y
    mobj.radius = info.radius
    mobj.height = info.height
    mobj.flags = info.flags
    mobj.health = info.spawnhealth
    if (gameskill != skill_t.sk_nightmare) {
        mobj.reactiontime = info.reactiontime
    }
    mobj.lastlook = P_Random() % MAXPLAYERS
    // do not set the state with P_SetMobjState,
    // because action routines can not be called yet
    st = addr(states[0]) + end_index(info.spawnstate, 967)
    mobj.state = st
    mobj.tics = st.tics
    mobj.sprite = st.sprite
    mobj.frame = st.frame
    // set subsector and/or block links
    P_SetThingPosition(mobj)
    mobj.floorz = mobj.subsector.sector.floorheight
    mobj.ceilingz = mobj.subsector.sector.ceilingheight
    if (z == -2147483647 - 1) {
        mobj.z = mobj.floorz
    } elif (z == 2147483647) {
        mobj.z = mobj.ceilingz - mobj.info.height
    } else {
        mobj.z = z
    }
    mobj.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)
    P_AddThinker(addr(mobj.thinker))
    return mobj
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RemoveMobj(var mobj : mobj_s?) {
    if ((mobj.flags & int(mobjflag_t.MF_SPECIAL)) != 0 && (mobj.flags & int(mobjflag_t.MF_DROPPED)) == 0 && (mobj._c_type != mobjtype_t.MT_INV) &&
            (mobj._c_type != mobjtype_t.MT_INS)) {
        itemrespawnque[iquehead] = mobj.spawnpoint
        itemrespawntime[iquehead] = leveltime
        iquehead = (iquehead + 1) & (ITEMQUESIZE - 1)
        // lose one off the end?
        if (iquehead == iquetail) {
            iquetail = (iquetail + 1) & (ITEMQUESIZE - 1)
        }
    }
    // unlink from sector and block lists
    P_UnsetThingPosition(mobj)
    // stop any playing sound
    S_StopSound(mobj)
    // free block
    P_RemoveThinker(reinterpret<thinker_s?>(mobj))
}

// P_RespawnSpecials
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RespawnSpecials {
    var x : int
    var y : int
    var z : int
    var ss : subsector_s?
    var mo : mobj_s?
    var mthing : mapthing_t?
    var i : int
    // only respawn items in deathmatch
    if (deathmatch != 2) {
        return
    }
    // nothing left to respawn?
    if (iquehead == iquetail) {
        return
    }
    // wait at least 30 seconds
    if (leveltime - itemrespawntime[iquetail] < 30 * TICRATE) {
        return
    }
    mthing = addr(itemrespawnque[0]) + end_index(iquetail, 128)
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    // spawn a teleport fog at the new spot
    ss = R_PointInSubsector(x, y)
    mo = P_SpawnMobj(x, y, ss.sector.floorheight, mobjtype_t.MT_IFOG)
    S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_itmbk))
    // find which type to spawn
    i = 0
    while (i < int(mobjtype_t.NUMMOBJTYPES)) {
        if (int(mthing._c_type) == mobjinfo[i].doomednum) {
            break
        }
        i++
    }
    // spawn it
    if ((mobjinfo[i].flags & int(mobjflag_t.MF_SPAWNCEILING)) != 0) {
        z = 2147483647
    } else {
        z = -2147483647 - 1
    }
    mo = P_SpawnMobj(x, y, z, enum_from_int(type<mobjtype_t>, i))
    mo.spawnpoint = *mthing
    mo.angle = uint(ANG45 * (int(mthing.angle) / 45))
    // pull it from the que
    iquetail = (iquetail + 1) & (ITEMQUESIZE - 1)
}

// P_SpawnPlayer
// Called when a player is spawned on the level.
// Most of the player structure stays unchanged
// between levels.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnPlayer(var mthing : mapthing_t?) {
    var p : player_s?
    var x : int
    var y : int
    var z : int
    var mobj : mobj_s?
    if (mthing._c_type == 0) {
        return
    }
    // not playing?
    if (playeringame[int(mthing._c_type) - 1] == 0) {
        return
    }
    p = addr(players[0]) + end_index(int(mthing._c_type) - 1, 4)
    if (p.playerstate == playerstate_t.PST_REBORN) {
        G_PlayerReborn(int(mthing._c_type) - 1)
    }
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    z = -2147483647 - 1
    mobj = P_SpawnMobj(x, y, z, mobjtype_t.MT_PLAYER)
    // set color translations for player sprites
    if (int(mthing._c_type) > 1) {
        mobj.flags |= (int(mthing._c_type) - 1) << int(mobjflag_t.MF_TRANSSHIFT)
    }
    mobj.angle = uint(ANG45 * (int(mthing.angle) / 45))
    mobj.player = p
    mobj.health = p.health
    p.mo = mobj
    p.playerstate = playerstate_t.PST_LIVE
    p.refire = 0
    p.message = null
    p.damagecount = 0
    p.bonuscount = 0
    p.extralight = 0
    p.fixedcolormap = 0
    p.viewheight = VIEWHEIGHT
    // setup gun psprite
    P_SetupPsprites(p)
    // give all cards in death match mode
    if (deathmatch != 0) {
        for (i in range(int(card_t.NUMCARDS))) {
            p.cards[i] = 1u
        }
    }
    if (int(mthing._c_type) - 1 == consoleplayer) {
        // wake up the status bar
        ST_Start()
        // wake up the heads up text
        HU_Start()
    }
}

// P_SpawnMapThing
// The fields of the mapthing should
// already be in host byte order.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnMapThing(var mthing : mapthing_t?) {
    var i : int
    var bit : int
    var mobj : mobj_s?
    var x : int
    var y : int
    var z : int
    // count deathmatch start positions
    if (mthing._c_type == 11) {
        if (reinterpret<uint64>(deathmatch_p) < reinterpret<uint64>(addr(deathmatchstarts[0]) + 10)) {
            crt::memcpy(reinterpret<void?>(deathmatch_p), reinterpret<void?>(mthing), uint64(typeinfo sizeof(type<mapthing_t>)))
            deathmatch_p++
        }
        return
    }
    if (int(mthing._c_type) <= 0) {
        // Thing type 0 is actually "player -1 start".
        // For some reason, Vanilla Doom accepts/ignores this.
        return
    }
    // check for players specially
    if (int(mthing._c_type) <= 4) {
        // save spots for respawning in network games
        playerstarts[int(mthing._c_type) - 1] = *mthing
        if (deathmatch == 0) {
            P_SpawnPlayer(mthing)
        }
        return
    }
    // check for apropriate skill level
    if (netgame == 0 && (int(mthing._c_options) & 16) != 0) {
        return
    }
    if (gameskill == skill_t.sk_baby) {
        bit = 1
    } elif (gameskill == skill_t.sk_nightmare) {
        bit = 4
    } else {
        bit = 1 << (int(gameskill) - 1)
    }
    if ((int(mthing._c_options) & bit) == 0) {
        return
    }
    // find which type to spawn
    i = 0
    while (i < int(mobjtype_t.NUMMOBJTYPES)) {
        if (int(mthing._c_type) == mobjinfo[i].doomednum) {
            break
        }
        i++
    }
    if (i == int(mobjtype_t.NUMMOBJTYPES)) {
        I_Error`va(cstr("P_SpawnMapThing: Unknown type %i at (%i, %i)"), (int(mthing._c_type), int(mthing.x), int(mthing.y)))
    }
    // don't spawn keycards and players in deathmatch
    if (deathmatch != 0 && (mobjinfo[i].flags & int(mobjflag_t.MF_NOTDMATCH)) != 0) {
        return
    }
    // don't spawn any monsters if -nomonsters
    if (nomonsters != 0 && (i == int(mobjtype_t.MT_SKULL) || (mobjinfo[i].flags & int(mobjflag_t.MF_COUNTKILL)) != 0)) {
        return
    }
    // spawn it
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    if ((mobjinfo[i].flags & int(mobjflag_t.MF_SPAWNCEILING)) != 0) {
        z = 2147483647
    } else {
        z = -2147483647 - 1
    }
    mobj = P_SpawnMobj(x, y, z, enum_from_int(type<mobjtype_t>, i))
    mobj.spawnpoint = *mthing
    if (mobj.tics > 0) {
        mobj.tics = 1 + (P_Random() % mobj.tics)
    }
    if ((mobj.flags & int(mobjflag_t.MF_COUNTKILL)) != 0) {
        totalkills++
    }
    if ((mobj.flags & int(mobjflag_t.MF_COUNTITEM)) != 0) {
        totalitems++
    }
    mobj.angle = uint(ANG45 * (int(mthing.angle) / 45))
    if ((int(mthing._c_options) & MTF_AMBUSH) != 0) {
        mobj.flags |= int(mobjflag_t.MF_AMBUSH)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def P_SpawnPuff(x : int; y : int; var z : int) {
    var th : mobj_s?
    z += (P_Random() - P_Random()) << 10
    th = P_SpawnMobj(x, y, z, mobjtype_t.MT_PUFF)
    th.momz = FRACUNIT
    th.tics -= P_Random() & 3
    if (th.tics < 1) {
        th.tics = 1
    }
    // don't make punches spark on the wall
    if (attackrange == MELEERANGE) {
        P_SetMobjState(th, statenum_t.S_PUFF3)
    }
}

// P_SpawnBlood
[unsafe_deref, hint(unsafe_range_check)]
def P_SpawnBlood(x : int; y : int; var z : int; damage : int) {
    var th : mobj_s?
    z += (P_Random() - P_Random()) << 10
    th = P_SpawnMobj(x, y, z, mobjtype_t.MT_BLOOD)
    th.momz = FRACUNIT * 2
    th.tics -= P_Random() & 3
    if (th.tics < 1) {
        th.tics = 1
    }
    if (damage <= 12 && damage >= 9) {
        P_SetMobjState(th, statenum_t.S_BLOOD2)
    } elif (damage < 9) {
        P_SetMobjState(th, statenum_t.S_BLOOD3)
    }
}

// P_CheckMissileSpawn
// Moves the missile forward a bit
// and possibly explodes it right there.
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckMissileSpawn(var th : mobj_s?) {
    th.tics -= P_Random() & 3
    if (th.tics < 1) {
        th.tics = 1
    }
    // move a little forward so an angle can
    // be computed if it immediately explodes
    th.x += th.momx >> 1
    th.y += th.momy >> 1
    th.z += th.momz >> 1
    if (P_TryMove(th, th.x, th.y) == 0) {
        P_ExplodeMissile(th)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SubstNullMobj(var mobj : mobj_s?) : mobj_s? {
    if (mobj == null) {
        P_SubstNullMobj_dummy_mobj.x = 0
        P_SubstNullMobj_dummy_mobj.y = 0
        P_SubstNullMobj_dummy_mobj.z = 0
        P_SubstNullMobj_dummy_mobj.flags = 0
        mobj = addr(P_SubstNullMobj_dummy_mobj)
    }
    return mobj
}

// P_SpawnMissile
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnMissile(var source : mobj_s?; var dest : mobj_s?; _c_type : mobjtype_t) : mobj_s? {
    var th : mobj_s?
    var an : uint
    var dist : int
    th = P_SpawnMobj(source.x, source.y, source.z + 4 * 8 * FRACUNIT, _c_type)
    if (th.info.seesound != 0) {
        S_StartSound(reinterpret<void?>(th), th.info.seesound)
    }
    // where it came from
    th.target = source
    an = R_PointToAngle2(source.x, source.y, dest.x, dest.y)
    // fuzzy player
    if ((dest.flags & int(mobjflag_t.MF_SHADOW)) != 0) {
        an += uint((P_Random() - P_Random()) << 20)
    }
    th.angle = an
    an >>= uint(ANGLETOFINESHIFT)
    th.momx = FixedMul(th.info.speed, finecosine[an])
    th.momy = FixedMul(th.info.speed, finesine[an])
    dist = P_AproxDistance(dest.x - source.x, dest.y - source.y)
    dist = dist / th.info.speed
    if (dist < 1) {
        dist = 1
    }
    th.momz = (dest.z - source.z) / dist
    P_CheckMissileSpawn(th)
    return th
}

// P_SpawnPlayerMissile
// Tries to aim at a nearby monster
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnPlayerMissile(var source : mobj_s?; _c_type : mobjtype_t) {
    var th : mobj_s?
    var an : uint
    var x : int
    var y : int
    var z : int
    var slope : int
    // see which target is to be aimed at
    an = source.angle
    slope = P_AimLineAttack(source, an, 16 * 64 * FRACUNIT)
    if (linetarget == null) {
        an += uint(1 << 26)
        slope = P_AimLineAttack(source, an, 16 * 64 * FRACUNIT)
        if (linetarget == null) {
            an -= uint(2 << 26)
            slope = P_AimLineAttack(source, an, 16 * 64 * FRACUNIT)
        }
        if (linetarget == null) {
            an = source.angle
            slope = 0
        }
    }
    x = source.x
    y = source.y
    z = source.z + 4 * 8 * FRACUNIT
    th = P_SpawnMobj(x, y, z, _c_type)
    if (th.info.seesound != 0) {
        S_StartSound(reinterpret<void?>(th), th.info.seesound)
    }
    th.target = source
    th.angle = an
    th.momx = FixedMul(th.info.speed, finecosine[an >> uint(ANGLETOFINESHIFT)])
    th.momy = FixedMul(th.info.speed, finesine[an >> uint(ANGLETOFINESHIFT)])
    th.momz = FixedMul(th.info.speed, slope)
    P_CheckMissileSpawn(th)
}

// Move a plat up and down
[c_function, unsafe_deref, hint(unsafe_range_check)]
def T_PlatRaise(var plat : plat_t?) {
    var res : result_e
    c_switch(plat.status) {
        case(plat_e.up) {
            res = T_MovePlane(plat.sector, plat.speed, plat.high, plat.crush, 0, 1)
            if (plat._c_type == plattype_e.raiseAndChange || plat._c_type == plattype_e.raiseToNearestAndChange) {
                if ((leveltime & 7) == 0) {
                    S_StartSound(reinterpret<void?>(addr(plat.sector.soundorg)), int(sfxenum_t.sfx_stnmov))
                }
            }
            if (res == result_e.crushed && (plat.crush == 0)) {
                plat.count = plat.wait
                plat.status = plat_e.down
                S_StartSound(reinterpret<void?>(addr(plat.sector.soundorg)), int(sfxenum_t.sfx_pstart))
            } else {
                if (res == result_e.pastdest) {
                    plat.count = plat.wait
                    plat.status = plat_e.waiting
                    S_StartSound(reinterpret<void?>(addr(plat.sector.soundorg)), int(sfxenum_t.sfx_pstop))
                    c_switch(plat._c_type) {
                        case(plattype_e.blazeDWUS, plattype_e.downWaitUpStay) {
                            P_RemoveActivePlat(plat)
                            break
                        }
                        case(plattype_e.raiseAndChange, plattype_e.raiseToNearestAndChange) {
                            P_RemoveActivePlat(plat)
                            break
                        }
                        case(_) {
                            break
                        }
                    }
                }
            }
            break
        }
        case(plat_e.down) {
            res = T_MovePlane(plat.sector, plat.speed, plat.low, 0u, 0, -1)
            if (res == result_e.pastdest) {
                plat.count = plat.wait
                plat.status = plat_e.waiting
                S_StartSound(reinterpret<void?>(addr(plat.sector.soundorg)), int(sfxenum_t.sfx_pstop))
            }
            break
        }
        case(plat_e.waiting) {
            plat.count--
            if (plat.count == 0) {
                if (plat.sector.floorheight == plat.low) {
                    plat.status = plat_e.up
                } else {
                    plat.status = plat_e.down
                }
                S_StartSound(reinterpret<void?>(addr(plat.sector.soundorg)), int(sfxenum_t.sfx_pstart))
            }
        }
        case(plat_e.in_stasis) {
            break
        }
    }
}

// Do Platforms
// "amount" is only used for SOME platforms.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_DoPlat(var line : line_s?; _c_type : plattype_e; amount : int) : int {
    var plat : plat_t?
    var secnum : int
    var rtn : int
    var sec : sector_t?
    secnum = -1
    rtn = 0
    // Activate all <type> plats that are in_stasis
    c_switch(_c_type) {
        case(plattype_e.perpetualRaise) {
            P_ActivateInStasis(int(line.tag))
            break
        }
        case(_) {
            break
        }
    }
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        if (sec.specialdata != null) {
            continue
        }
        // Find lowest & highest floors around sector
        rtn = 1
        plat = reinterpret<plat_t?>(Z_Malloc(typeinfo sizeof(type<plat_t>), int(anon_28.PU_LEVSPEC), null))
        P_AddThinker(addr(plat.thinker))
        plat._c_type = _c_type
        plat.sector = sec
        plat.sector.specialdata = reinterpret<void?>(plat)
        plat.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_PlatRaise)
        plat.crush = 0u
        plat.tag = int(line.tag)
        c_switch(_c_type) {
            case(plattype_e.raiseToNearestAndChange) {
                plat.speed = FRACUNIT / 2
                sec.floorpic = sides[int(line.sidenum[0])].sector.floorpic
                plat.high = P_FindNextHighestFloor(sec, sec.floorheight)
                plat.wait = 0
                plat.status = plat_e.up
                // NO MORE DAMAGE, IF APPLICABLE
                sec.special = int16(0)
                S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_stnmov))
                break
            }
            case(plattype_e.raiseAndChange) {
                plat.speed = FRACUNIT / 2
                sec.floorpic = sides[int(line.sidenum[0])].sector.floorpic
                plat.high = sec.floorheight + amount * FRACUNIT
                plat.wait = 0
                plat.status = plat_e.up
                S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_stnmov))
                break
            }
            case(plattype_e.downWaitUpStay) {
                plat.speed = FRACUNIT * 4
                plat.low = P_FindLowestFloorSurrounding(sec)
                if (plat.low > sec.floorheight) {
                    plat.low = sec.floorheight
                }
                plat.high = sec.floorheight
                plat.wait = TICRATE * PLATWAIT
                plat.status = plat_e.down
                S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_pstart))
                break
            }
            case(plattype_e.blazeDWUS) {
                plat.speed = FRACUNIT * 8
                plat.low = P_FindLowestFloorSurrounding(sec)
                if (plat.low > sec.floorheight) {
                    plat.low = sec.floorheight
                }
                plat.high = sec.floorheight
                plat.wait = TICRATE * PLATWAIT
                plat.status = plat_e.down
                S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_pstart))
                break
            }
            case(plattype_e.perpetualRaise) {
                plat.speed = FRACUNIT
                plat.low = P_FindLowestFloorSurrounding(sec)
                if (plat.low > sec.floorheight) {
                    plat.low = sec.floorheight
                }
                plat.high = P_FindHighestFloorSurrounding(sec)
                if (plat.high < sec.floorheight) {
                    plat.high = sec.floorheight
                }
                plat.wait = TICRATE * PLATWAIT
                plat.status = enum_from_int(type<plat_e>, P_Random() & 1)
                S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_pstart))
                break
            }
        }
        P_AddActivePlat(plat)
    }
    return rtn
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ActivateInStasis(tag : int) {
    for (i in range(MAXPLATS)) {
        if (activeplats[i] != null && activeplats[i].tag == tag && activeplats[i].status == plat_e.in_stasis) {
            activeplats[i].status = activeplats[i].oldstatus
            activeplats[i].thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_PlatRaise)
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_StopPlat(var line : line_s?) {
    for (j in range(MAXPLATS)) {
        if (activeplats[j] != null && (activeplats[j].status != plat_e.in_stasis) && (activeplats[j].tag == int(line.tag))) {
            activeplats[j].oldstatus = activeplats[j].status
            activeplats[j].status = plat_e.in_stasis
            activeplats[j].thinker._c_function.acv = reinterpret<function<() : void>>(null)
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_AddActivePlat(var plat : plat_t?) {
    for (i in range(MAXPLATS)) {
        if (activeplats[i] == null) {
            activeplats[i] = plat
            return
        }
    }
    I_Error`va(cstr("P_AddActivePlat: no more plats!"), VaNone())
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RemoveActivePlat(var plat : plat_t?) {
    for (i in range(MAXPLATS)) {
        if (plat == activeplats[i]) {
            activeplats[i].sector.specialdata = null
            P_RemoveThinker(addr(activeplats[i].thinker))
            activeplats[i] = null
            return
        }
    }
    I_Error`va(cstr("P_RemoveActivePlat: can't find plat!"), VaNone())
}

// P_SetPsprite
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SetPsprite(var player : player_s?; position : int; var stnum : statenum_t) {
    var psp : pspdef_t?
    var state : state_t?
    psp = addr(player.psprites[0]) + end_index(position, 2)
    c_do_while(psp.tics == 0) {
        if (int(stnum) == 0) {
            // object removed itself
            psp.state = null
            break
        }
        state = addr(states[0]) + end_index(int(stnum), 967)
        psp.state = state
        // could be 0
        psp.tics = state.tics
        if (state.misc1 != 0) {
            // coordinate set
            psp.sx = state.misc1 << FRACBITS
            psp.sy = state.misc2 << FRACBITS
        }
        // Call action routine.
        // Modified handling.
        if (state.action.acp2 != null) {
            invoke(state.action.acp2, reinterpret<void?>(player), reinterpret<void?>(psp))
            if (psp.state == null) {
                break
            }
        }
        stnum = psp.state.nextstate
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def P_CalcSwing(var player : player_s?) {
    var swing : int
    var angle : int
    // OPTIMIZE: tablify this.
    // A LUT would allow for different modes,
    // and add flexibility.
    swing = player.bob
    angle = (FINEANGLES / 70 * leveltime) & FINEMASK
    swingx = FixedMul(swing, finesine[angle])
    angle = (FINEANGLES / 70 * leveltime + FINEANGLES / 2) & FINEMASK
    swingy = -FixedMul(swingx, finesine[angle])
}

// P_BringUpWeapon
// Starts bringing the pending weapon up
// from the bottom of the screen.
// Uses player
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BringUpWeapon(var player : player_s?) {
    var newstate : statenum_t
    if (player.pendingweapon == weapontype_t.wp_nochange) {
        player.pendingweapon = player.readyweapon
    }
    if (player.pendingweapon == weapontype_t.wp_chainsaw) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawup))
    }
    newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.pendingweapon)].upstate)
    player.pendingweapon = weapontype_t.wp_nochange
    player.psprites[int(psprnum_t.ps_weapon)].sy = 128 * FRACUNIT
    P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
}

// P_CheckAmmo
// Returns true if there is enough ammo to shoot.
// If not, selects the next weapon to use.
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckAmmo(var player : player_s?) : uint {
    var ammo : ammotype_t
    var count : int
    ammo = weaponinfo[int(player.readyweapon)].ammo
    // Minimal amount for one shot varies.
    if (player.readyweapon == weapontype_t.wp_bfg) {
        count = deh_bfg_cells_per_shot
    } elif (player.readyweapon == weapontype_t.wp_supershotgun) {
        // Double barrel.
        count = 2
    } else {
        // Regular.
        count = 1
    }
    // Some do not need ammunition anyway.
    // Return if current ammunition sufficient.
    if (ammo == ammotype_t.am_noammo || player.ammo[int(ammo)] >= count) {
        return 1u
    }
    // Out of ammo, pick a weapon to change to.
    // Preferences are set here.
    c_do_while(player.pendingweapon == weapontype_t.wp_nochange) {
        if (player.weaponowned[int(weapontype_t.wp_plasma)] != 0 && player.ammo[int(ammotype_t.am_cell)] != 0 && (gamemode != GameMode_t.shareware)) {
            player.pendingweapon = weapontype_t.wp_plasma
        } elif (player.weaponowned[int(weapontype_t.wp_supershotgun)] != 0 && player.ammo[int(ammotype_t.am_shell)] > 2 &&
                (gamemode == GameMode_t.commercial)) {
            player.pendingweapon = weapontype_t.wp_supershotgun
        } elif (player.weaponowned[int(weapontype_t.wp_chaingun)] != 0 && player.ammo[int(ammotype_t.am_clip)] != 0) {
            player.pendingweapon = weapontype_t.wp_chaingun
        } elif (player.weaponowned[int(weapontype_t.wp_shotgun)] != 0 && player.ammo[int(ammotype_t.am_shell)] != 0) {
            player.pendingweapon = weapontype_t.wp_shotgun
        } elif (player.ammo[int(ammotype_t.am_clip)] != 0) {
            player.pendingweapon = weapontype_t.wp_pistol
        } elif (player.weaponowned[int(weapontype_t.wp_chainsaw)] != 0) {
            player.pendingweapon = weapontype_t.wp_chainsaw
        } elif (player.weaponowned[int(weapontype_t.wp_missile)] != 0 && player.ammo[int(ammotype_t.am_misl)] != 0) {
            player.pendingweapon = weapontype_t.wp_missile
        } elif (player.weaponowned[int(weapontype_t.wp_bfg)] != 0 && player.ammo[int(ammotype_t.am_cell)] > 40 && (gamemode != GameMode_t.shareware)) {
            player.pendingweapon = weapontype_t.wp_bfg
        } else {
            // If everything fails.
            player.pendingweapon = weapontype_t.wp_fist
        }
    }
    // Now set appropriate weapon overlay.
    P_SetPsprite(player, int(psprnum_t.ps_weapon), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].downstate))
    return 0u
}

// P_FireWeapon.
[unsafe_deref, hint(unsafe_range_check)]
def P_FireWeapon(var player : player_s?) {
    var newstate : statenum_t
    if (P_CheckAmmo(player) == 0) {
        return
    }
    P_SetMobjState(player.mo, statenum_t.S_PLAY_ATK1)
    newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].atkstate)
    P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
    P_NoiseAlert(player.mo, player.mo)
}

// P_DropWeapon
// Player died, so put the weapon away.
[unsafe_deref, hint(unsafe_range_check)]
def P_DropWeapon(var player : player_s?) {
    P_SetPsprite(player, int(psprnum_t.ps_weapon), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].downstate))
}

// A_WeaponReady
// The player can fire the weapon
// or change to another weapon at this time.
// Follows after getting weapon up,
// or after previous attack/fire sequence.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_WeaponReady(var player : player_s?; var psp : pspdef_t?) {
    var newstate : statenum_t
    var angle : int
    // get out of attack state
    if (player.mo.state == addr(states[int(statenum_t.S_PLAY_ATK1)]) || player.mo.state == addr(states[int(statenum_t.S_PLAY_ATK2)])) {
        P_SetMobjState(player.mo, statenum_t.S_PLAY)
    }
    if (player.readyweapon == weapontype_t.wp_chainsaw && psp.state == addr(states[int(statenum_t.S_SAW)])) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawidl))
    }
    // check for change
    // if player is dead, put the weapon away
    if (player.pendingweapon != weapontype_t.wp_nochange || player.health == 0) {
        // change weapon
        // (pending weapon should allready be validated)
        newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].downstate)
        P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
        return
    }
    // check for fire
    // the missile launcher and bfg do not auto fire
    if ((int(player.cmd.buttons) & int(buttoncode_t.BT_ATTACK)) != 0) {
        if (player.attackdown == 0 || (player.readyweapon != weapontype_t.wp_missile && player.readyweapon != weapontype_t.wp_bfg)) {
            player.attackdown = 1
            P_FireWeapon(player)
            return
        }
    } else {
        player.attackdown = 0
    }
    // bob the weapon based on movement speed
    angle = (128 * leveltime) & FINEMASK
    psp.sx = FRACUNIT + FixedMul(player.bob, finecosine[angle])
    angle &= FINEANGLES / 2 - 1
    psp.sy = 32 * FRACUNIT + FixedMul(player.bob, finesine[angle])
}

// A_ReFire
// The player can re-fire the weapon
// without lowering it entirely.
[unsafe_deref, hint(unsafe_range_check)]
def A_ReFire(var player : player_s?; var psp : pspdef_t?) {
    // check for fire
    // (if a weaponchange is pending, let it go through instead)
    if ((int(player.cmd.buttons) & int(buttoncode_t.BT_ATTACK)) != 0 && player.pendingweapon == weapontype_t.wp_nochange && player.health != 0) {
        player.refire++
        P_FireWeapon(player)
    } else {
        player.refire = 0
        P_CheckAmmo(player)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def A_CheckReload(var player : player_s?; var psp : pspdef_t?) {
    P_CheckAmmo(player)
}

// A_Lower
// Lowers current weapon,
// and changes weapon at bottom.
[unsafe_deref, hint(unsafe_range_check)]
def A_Lower(var player : player_s?; var psp : pspdef_t?) {
    psp.sy += FRACUNIT * 6
    // Is already down.
    if (psp.sy < 128 * FRACUNIT) {
        return
    }
    // Player is dead.
    if (player.playerstate == playerstate_t.PST_DEAD) {
        psp.sy = 128 * FRACUNIT
        // don't bring weapon back up
        return
    }
    // The old weapon has been lowered off the screen,
    // so change the weapon and start raising it
    if (player.health == 0) {
        // Player is dead, so keep the weapon off screen.
        P_SetPsprite(player, int(psprnum_t.ps_weapon), statenum_t.S_NULL)
        return
    }
    player.readyweapon = player.pendingweapon
    P_BringUpWeapon(player)
}

// A_Raise
[unsafe_deref, hint(unsafe_range_check)]
def A_Raise(var player : player_s?; var psp : pspdef_t?) {
    var newstate : statenum_t
    psp.sy -= FRACUNIT * 6
    if (psp.sy > 32 * FRACUNIT) {
        return
    }
    psp.sy = 32 * FRACUNIT
    // The weapon has been raised all the way,
    // so change to the ready state.
    newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].readystate)
    P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
}

// A_GunFlash
[unsafe_deref, hint(unsafe_range_check)]
def A_GunFlash(var player : player_s?; var psp : pspdef_t?) {
    P_SetMobjState(player.mo, statenum_t.S_PLAY_ATK2)
    P_SetPsprite(player, int(psprnum_t.ps_flash), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].flashstate))
}

// A_Punch
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Punch(var player : player_s?; var psp : pspdef_t?) {
    var angle : uint
    var damage : int
    var slope : int
    damage = (P_Random() % 10 + 1) << 1
    if (player.powers[int(powertype_t.pw_strength)] != 0) {
        damage *= 10
    }
    angle = player.mo.angle
    angle += uint((P_Random() - P_Random()) << 18)
    slope = P_AimLineAttack(player.mo, angle, MELEERANGE)
    P_LineAttack(player.mo, angle, MELEERANGE, slope, damage)
    // turn to face target
    if (linetarget != null) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_punch))
        player.mo.angle = R_PointToAngle2(player.mo.x, player.mo.y, linetarget.x, linetarget.y)
    }
}

// A_Saw
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Saw(var player : player_s?; var psp : pspdef_t?) {
    var angle : uint
    var damage : int
    var slope : int
    damage = 2 * (P_Random() % 10 + 1)
    angle = player.mo.angle
    angle += uint((P_Random() - P_Random()) << 18)
    // use meleerange + 1 se the puff doesn't skip the flash
    slope = P_AimLineAttack(player.mo, angle, MELEERANGE + 1)
    P_LineAttack(player.mo, angle, MELEERANGE + 1, slope, damage)
    if (linetarget == null) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawful))
        return
    }
    S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawhit))
    // turn to face target
    angle = R_PointToAngle2(player.mo.x, player.mo.y, linetarget.x, linetarget.y)
    if (angle - player.mo.angle > ANG180) {
        if (int(angle - player.mo.angle) < -ANG90 / 20) {
            player.mo.angle = angle + uint(ANG90 / 21)
        } else {
            player.mo.angle -= uint(ANG90 / 20)
        }
    } else {
        if (angle - player.mo.angle > uint(ANG90 / 20)) {
            player.mo.angle = angle - uint(ANG90 / 21)
        } else {
            player.mo.angle += uint(ANG90 / 20)
        }
    }
    player.mo.flags |= int(mobjflag_t.MF_JUSTATTACKED)
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__DecreaseAmmo(var player : player_s?; ammonum : int; amount : int) {
    if (ammonum < int(ammotype_t.NUMAMMO)) {
        player.ammo[ammonum] -= amount
    } else {
        player.maxammo[ammonum - int(ammotype_t.NUMAMMO)] -= amount
    }
}

// A_FireMissile
[unsafe_deref, hint(unsafe_range_check)]
def A_FireMissile(var player : player_s?; var psp : pspdef_t?) {
    doom_all__DecreaseAmmo(player, int(weaponinfo[int(player.readyweapon)].ammo), 1)
    P_SpawnPlayerMissile(player.mo, mobjtype_t.MT_ROCKET)
}

// A_FireBFG
[unsafe_deref, hint(unsafe_range_check)]
def A_FireBFG(var player : player_s?; var psp : pspdef_t?) {
    doom_all__DecreaseAmmo(player, int(weaponinfo[int(player.readyweapon)].ammo), deh_bfg_cells_per_shot)
    P_SpawnPlayerMissile(player.mo, mobjtype_t.MT_BFG)
}

// A_FirePlasma
[unsafe_deref, hint(unsafe_range_check)]
def A_FirePlasma(var player : player_s?; var psp : pspdef_t?) {
    doom_all__DecreaseAmmo(player, int(weaponinfo[int(player.readyweapon)].ammo), 1)
    P_SetPsprite(player, int(psprnum_t.ps_flash), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].flashstate + (P_Random() & 1)))
    P_SpawnPlayerMissile(player.mo, mobjtype_t.MT_PLASMA)
}

[unsafe_deref, hint(unsafe_range_check)]
def P_BulletSlope(var mo : mobj_s?) {
    var an : uint
    // see which target is to be aimed at
    an = mo.angle
    bulletslope = P_AimLineAttack(mo, an, 16 * 64 * FRACUNIT)
    if (linetarget == null) {
        an += uint(1 << 26)
        bulletslope = P_AimLineAttack(mo, an, 16 * 64 * FRACUNIT)
        if (linetarget == null) {
            an -= uint(2 << 26)
            bulletslope = P_AimLineAttack(mo, an, 16 * 64 * FRACUNIT)
        }
    }
}

// P_GunShot
[unsafe_deref, hint(unsafe_range_check)]
def P_GunShot(var mo : mobj_s?; accurate : uint) {
    var angle : uint
    var damage : int
    damage = 5 * (P_Random() % 3 + 1)
    angle = mo.angle
    if (accurate == 0) {
        angle += uint((P_Random() - P_Random()) << 18)
    }
    P_LineAttack(mo, angle, MISSILERANGE, bulletslope, damage)
}

// A_FirePistol
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_FirePistol(var player : player_s?; var psp : pspdef_t?) {
    S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_pistol))
    P_SetMobjState(player.mo, statenum_t.S_PLAY_ATK2)
    doom_all__DecreaseAmmo(player, int(weaponinfo[int(player.readyweapon)].ammo), 1)
    P_SetPsprite(player, int(psprnum_t.ps_flash), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].flashstate))
    P_BulletSlope(player.mo)
    P_GunShot(player.mo, uint(int_of(player.refire == 0)))
}

// A_FireShotgun
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_FireShotgun(var player : player_s?; var psp : pspdef_t?) {
    S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_shotgn))
    P_SetMobjState(player.mo, statenum_t.S_PLAY_ATK2)
    doom_all__DecreaseAmmo(player, int(weaponinfo[int(player.readyweapon)].ammo), 1)
    P_SetPsprite(player, int(psprnum_t.ps_flash), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].flashstate))
    P_BulletSlope(player.mo)
    for (i in range(7)) {
        P_GunShot(player.mo, 0u)
    }
}

// A_FireShotgun2
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_FireShotgun2(var player : player_s?; var psp : pspdef_t?) {
    var angle : uint
    var damage : int
    S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_dshtgn))
    P_SetMobjState(player.mo, statenum_t.S_PLAY_ATK2)
    doom_all__DecreaseAmmo(player, int(weaponinfo[int(player.readyweapon)].ammo), 2)
    P_SetPsprite(player, int(psprnum_t.ps_flash), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].flashstate))
    P_BulletSlope(player.mo)
    for (i in range(20)) {
        damage = 5 * (P_Random() % 3 + 1)
        angle = player.mo.angle
        angle += uint((P_Random() - P_Random()) << 19)
        P_LineAttack(player.mo, angle, MISSILERANGE, bulletslope + ((P_Random() - P_Random()) << 5), damage)
    }
}

// A_FireCGun
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_FireCGun(var player : player_s?; var psp : pspdef_t?) {
    S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_pistol))
    if (player.ammo[int(weaponinfo[int(player.readyweapon)].ammo)] == 0) {
        return
    }
    P_SetMobjState(player.mo, statenum_t.S_PLAY_ATK2)
    doom_all__DecreaseAmmo(player, int(weaponinfo[int(player.readyweapon)].ammo), 1)
    P_SetPsprite(player, int(psprnum_t.ps_flash),
            enum_from_int(type<statenum_t>, int(int64(psp.state + weaponinfo[int(player.readyweapon)].flashstate - addr(states[int(statenum_t.S_CHAIN1)])))))
    P_BulletSlope(player.mo)
    P_GunShot(player.mo, uint(int_of(player.refire == 0)))
}

// ?
[unsafe_deref, hint(unsafe_range_check)]
def A_Light0(var player : player_s?; var psp : pspdef_t?) {
    player.extralight = 0
}

[unsafe_deref, hint(unsafe_range_check)]
def A_Light1(var player : player_s?; var psp : pspdef_t?) {
    player.extralight = 1
}

[unsafe_deref, hint(unsafe_range_check)]
def A_Light2(var player : player_s?; var psp : pspdef_t?) {
    player.extralight = 2
}

// A_BFGSpray
// Spawn a BFG explosion on every monster in view
[unsafe_deref, hint(unsafe_range_check)]
def A_BFGSpray(var mo : mobj_s?) {
    var j : int
    var damage : int
    var an : uint
    // offset angles from its attack angle
    for (i in range(40)) {
        an = mo.angle - uint(ANG90 / 2) + uint(ANG90 / 40 * i)
        // mo->target is the originator (player)
        // of the missile
        P_AimLineAttack(mo.target, an, 16 * 64 * FRACUNIT)
        if (linetarget == null) {
            continue
        }
        P_SpawnMobj(linetarget.x, linetarget.y, linetarget.z + (linetarget.height >> 2), mobjtype_t.MT_EXTRABFG)
        damage = 0
        j = 0
        while (j < 15) {
            damage += (P_Random() & 7) + 1
            j++
        }
        P_DamageMobj(linetarget, mo.target, mo.target, damage)
    }
}

// A_BFGsound
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_BFGsound(var player : player_s?; var psp : pspdef_t?) {
    S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_bfg))
}

// P_SetupPsprites
// Called at start of level for each player.
[unsafe_deref, hint(unsafe_range_check)]
def P_SetupPsprites(var player : player_s?) {
    // remove all psprites
    for (i in range(int(psprnum_t.NUMPSPRITES))) {
        player.psprites[i].state = null
    }
    // spawn the gun
    player.pendingweapon = player.readyweapon
    P_BringUpWeapon(player)
}

// P_MovePsprites
// Called every tic by player thinking routine.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_MovePsprites(var player : player_s?) {
    var i : int
    var psp : pspdef_t?
    var state : state_t?
    psp = addr(player.psprites[0])
    i = 0
    while (i < int(psprnum_t.NUMPSPRITES)) {
        // a null state means not active
        state = psp.state
        if (state != null) {
            // drop tic count and possibly change state
            // a -1 tic count never changes
            if (psp.tics != -1) {
                psp.tics--
                if (psp.tics == 0) {
                    P_SetPsprite(player, i, psp.state.nextstate)
                }
            }
        }
        i++
        psp++
    }
    player.psprites[int(psprnum_t.ps_flash)].sx = player.psprites[int(psprnum_t.ps_weapon)].sx
    player.psprites[int(psprnum_t.ps_flash)].sy = player.psprites[int(psprnum_t.ps_weapon)].sy
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_TempSaveGameFile : uint8? {
    if (P_TempSaveGameFile_filename == null) {
        P_TempSaveGameFile_filename = M_StringJoin`va(savegamedir, (cstr("temp.dsg"), null))
    }
    return P_TempSaveGameFile_filename
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SaveGameFile(slot : int) : uint8? {
    var basename : uint8[32]
    if (P_SaveGameFile_filename == null) {
        P_SaveGameFile_filename_size = crt::strlen(savegamedir) + 32ul
        P_SaveGameFile_filename = reinterpret<uint8?>(crt::malloc(P_SaveGameFile_filename_size))
    }
    snprintf(addr(basename[0]), 32ul, cstr("doomsav%d.dsg"), slot)
    M_snprintf`va(P_SaveGameFile_filename, P_SaveGameFile_filename_size, cstr("%s%s"), (savegamedir, addr(basename[0])))
    return P_SaveGameFile_filename
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read8 : uint8 {
    var result : uint8
    if (crt::fread(reinterpret<void?>(addr(result)), 1ul, 1ul, reinterpret<void?>(save_stream)) < 1ul) {
        if (savegame_error == 0) {
            fprintf(crt::c_stderr(), cstr("saveg_read8: Unexpected end of file while reading save game\n"))
            savegame_error = 1u
        }
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write8(var value : uint8) {
    if (crt::fwrite(reinterpret<void?>(addr(value)), 1ul, 1ul, reinterpret<void?>(save_stream)) < 1ul) {
        if (savegame_error == 0) {
            fprintf(crt::c_stderr(), cstr("saveg_write8: Error while writing save game\n"))
            savegame_error = 1u
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read16 : int16 {
    var result : int
    result = int(doom_all__saveg_read8())
    result |= int(doom_all__saveg_read8()) << 8
    return int16(result)
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write16(value : int16) {
    doom_all__saveg_write8(uint8(int(value) & 255))
    doom_all__saveg_write8(uint8((int(value) >> 8) & 255))
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read32 : int {
    var result : int
    result = int(doom_all__saveg_read8())
    result |= int(doom_all__saveg_read8()) << 8
    result |= int(doom_all__saveg_read8()) << 16
    result |= int(doom_all__saveg_read8()) << 24
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write32(value : int) {
    doom_all__saveg_write8(uint8(value & 255))
    doom_all__saveg_write8(uint8((value >> 8) & 255))
    doom_all__saveg_write8(uint8((value >> 16) & 255))
    doom_all__saveg_write8(uint8((value >> 24) & 255))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_pad {
    var pos : uint64
    var padding : int
    pos = uint64(crt::ftell(reinterpret<void?>(save_stream)))
    padding = int((4ul - (pos & 3ul)) & 3ul)
    for (i in range(padding)) {
        doom_all__saveg_read8()
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_pad {
    var pos : uint64
    var padding : int
    pos = uint64(crt::ftell(reinterpret<void?>(save_stream)))
    padding = int((4ul - (pos & 3ul)) & 3ul)
    for (i in range(padding)) {
        doom_all__saveg_write8(0u8)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_readp : void? {
    return reinterpret<void?>(uint64(int64(doom_all__saveg_read32())))
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_writep(var p : void?) {
    doom_all__saveg_write32(int(int64(intptr(p))))
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_mapthing_t(var str : mapthing_t?) {
    // short x;
    str.x = doom_all__saveg_read16()
    // short y;
    str.y = doom_all__saveg_read16()
    // short angle;
    str.angle = doom_all__saveg_read16()
    // short type;
    str._c_type = doom_all__saveg_read16()
    // short options;
    str._c_options = doom_all__saveg_read16()
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_mapthing_t(var str : mapthing_t?) {
    // short x;
    doom_all__saveg_write16(str.x)
    // short y;
    doom_all__saveg_write16(str.y)
    // short angle;
    doom_all__saveg_write16(str.angle)
    // short type;
    doom_all__saveg_write16(str._c_type)
    // short options;
    doom_all__saveg_write16(str._c_options)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_actionf_t(var str : actionf_t?) {
    // actionf_p1 acp1;
    str.acp1 = reinterpret<function<(var a0 : void?) : void>>(doom_all__saveg_readp())
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_actionf_t(var str : actionf_t?) {
    // actionf_p1 acp1;
    doom_all__saveg_writep(reinterpret<void?>(str.acp1))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_thinker_t(var str : thinker_s?) {
    // struct thinker_s* prev;
    str.prev = reinterpret<thinker_s?>(doom_all__saveg_readp())
    // struct thinker_s* next;
    str.next = reinterpret<thinker_s?>(doom_all__saveg_readp())
    // think_t function;
    doom_all__saveg_read_actionf_t(addr(str._c_function))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_thinker_t(var str : thinker_s?) {
    // struct thinker_s* prev;
    doom_all__saveg_writep(reinterpret<void?>(str.prev))
    // struct thinker_s* next;
    doom_all__saveg_writep(reinterpret<void?>(str.next))
    // think_t function;
    doom_all__saveg_write_actionf_t(addr(str._c_function))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_mobj_t(var str : mobj_s?) {
    var pl : int
    // thinker_t thinker;
    doom_all__saveg_read_thinker_t(addr(str.thinker))
    // fixed_t x;
    str.x = doom_all__saveg_read32()
    // fixed_t y;
    str.y = doom_all__saveg_read32()
    // fixed_t z;
    str.z = doom_all__saveg_read32()
    // struct mobj_s* snext;
    str.snext = reinterpret<mobj_s?>(doom_all__saveg_readp())
    // struct mobj_s* sprev;
    str.sprev = reinterpret<mobj_s?>(doom_all__saveg_readp())
    // angle_t angle;
    str.angle = uint(doom_all__saveg_read32())
    // spritenum_t sprite;
    str.sprite = enum_from_int(type<spritenum_t>, doom_all__saveg_read32())
    // int frame;
    str.frame = doom_all__saveg_read32()
    // struct mobj_s* bnext;
    str.bnext = reinterpret<mobj_s?>(doom_all__saveg_readp())
    // struct mobj_s* bprev;
    str.bprev = reinterpret<mobj_s?>(doom_all__saveg_readp())
    // struct subsector_s* subsector;
    str.subsector = reinterpret<subsector_s?>(doom_all__saveg_readp())
    // fixed_t floorz;
    str.floorz = doom_all__saveg_read32()
    // fixed_t ceilingz;
    str.ceilingz = doom_all__saveg_read32()
    // fixed_t radius;
    str.radius = doom_all__saveg_read32()
    // fixed_t height;
    str.height = doom_all__saveg_read32()
    // fixed_t momx;
    str.momx = doom_all__saveg_read32()
    // fixed_t momy;
    str.momy = doom_all__saveg_read32()
    // fixed_t momz;
    str.momz = doom_all__saveg_read32()
    // int validcount;
    str.validcount = doom_all__saveg_read32()
    // mobjtype_t type;
    str._c_type = enum_from_int(type<mobjtype_t>, doom_all__saveg_read32())
    // mobjinfo_t* info;
    str.info = reinterpret<mobjinfo_t?>(doom_all__saveg_readp())
    // int tics;
    str.tics = doom_all__saveg_read32()
    // state_t* state;
    str.state = addr(states[0]) + end_index(doom_all__saveg_read32(), 967)
    // int flags;
    str.flags = doom_all__saveg_read32()
    // int health;
    str.health = doom_all__saveg_read32()
    // int movedir;
    str.movedir = doom_all__saveg_read32()
    // int movecount;
    str.movecount = doom_all__saveg_read32()
    // struct mobj_s* target;
    str.target = reinterpret<mobj_s?>(doom_all__saveg_readp())
    // int reactiontime;
    str.reactiontime = doom_all__saveg_read32()
    // int threshold;
    str.threshold = doom_all__saveg_read32()
    // struct player_s* player;
    pl = doom_all__saveg_read32()
    if (pl > 0) {
        str.player = addr(players[0]) + end_index(pl - 1, 4)
        str.player.mo = str
    } else {
        str.player = null
    }
    // int lastlook;
    str.lastlook = doom_all__saveg_read32()
    // mapthing_t spawnpoint;
    doom_all__saveg_read_mapthing_t(addr(str.spawnpoint))
    // struct mobj_s* tracer;
    str.tracer = reinterpret<mobj_s?>(doom_all__saveg_readp())
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_mobj_t(var str : mobj_s?) {
    // thinker_t thinker;
    doom_all__saveg_write_thinker_t(addr(str.thinker))
    // fixed_t x;
    doom_all__saveg_write32(str.x)
    // fixed_t y;
    doom_all__saveg_write32(str.y)
    // fixed_t z;
    doom_all__saveg_write32(str.z)
    // struct mobj_s* snext;
    doom_all__saveg_writep(reinterpret<void?>(str.snext))
    // struct mobj_s* sprev;
    doom_all__saveg_writep(reinterpret<void?>(str.sprev))
    // angle_t angle;
    doom_all__saveg_write32(int(str.angle))
    // spritenum_t sprite;
    doom_all__saveg_write32(int(str.sprite))
    // int frame;
    doom_all__saveg_write32(str.frame)
    // struct mobj_s* bnext;
    doom_all__saveg_writep(reinterpret<void?>(str.bnext))
    // struct mobj_s* bprev;
    doom_all__saveg_writep(reinterpret<void?>(str.bprev))
    // struct subsector_s* subsector;
