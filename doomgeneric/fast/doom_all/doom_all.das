[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__CheckVolumeSeparation(var vol : int?; var sep : int?) {
    if (*sep < 0) {
        *sep = 0
    } elif (*sep > 254) {
        *sep = 254
    }
    if (*vol < 0) {
        *vol = 0
    } elif (*vol > 127) {
        *vol = 127
    }
}

