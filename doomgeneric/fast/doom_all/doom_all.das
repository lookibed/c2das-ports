[c_function, unsafe_deref, hint(unsafe_range_check)]
def WritePCXfile(var filename : uint8?; var data : uint8?; width : int; height : int; var palette : uint8?) {
    var length : int
    var pcx : uint8?
    var pack : uint8?
    pcx = reinterpret<uint8?>(Z_Malloc(width * height * 2 + 1000, int(anon_28.PU_STATIC), null))
    // PCX id
    write_pcx_t_manufacturer(pcx, 0, 10u8)
    // 256 color
    write_pcx_t_version(pcx, 0, 5u8)
    // uncompressed
    write_pcx_t_encoding(pcx, 0, 1u8)
    // 256 color
    write_pcx_t_bits_per_pixel(pcx, 0, 8u8)
    write_pcx_t_xmin(pcx, 0, uint16(0))
    write_pcx_t_ymin(pcx, 0, uint16(0))
    write_pcx_t_xmax(pcx, 0, uint16(int16(width - 1)))
    write_pcx_t_ymax(pcx, 0, uint16(int16(height - 1)))
    write_pcx_t_hres(pcx, 0, uint16(int16(width)))
    write_pcx_t_vres(pcx, 0, uint16(int16(height)))
    crt::memset(reinterpret<void?>(ptr_pcx_t_palette(pcx, 0)), 0, uint64(typeinfo sizeof(type<uint8[48]>)))
    // chunky image
    write_pcx_t_color_planes(pcx, 0, 1u8)
    write_pcx_t_bytes_per_line(pcx, 0, uint16(int16(width)))
    // not a grey scale
    write_pcx_t_palette_type(pcx, 0, uint16(int16(2)))
    crt::memset(reinterpret<void?>(ptr_pcx_t_filler(pcx, 0)), 0, uint64(typeinfo sizeof(type<uint8[58]>)))
    // pack the image
    pack = reinterpret<uint8?>(pcx + 128)
    for (i in range(width * height)) {
        if ((int(*data) & 192) != 192) {
            var _t0 = pack
            pack++
            var _t1 = data
            data++
            *_t0 = *_t1
        } else {
            var _t2 = pack
            pack++
            *_t2 = 193u8
            var _t3 = pack
            pack++
            var _t4 = data
            data++
            *_t3 = *_t4
        }
    }
    // write the palette
    // palette ID byte
    var _t5 = pack
    pack++
    *_t5 = 12u8
    for (i in range(768)) {
        var _t6 = pack
        pack++
        var _t7 = palette
        palette++
        *_t6 = *_t7
    }
    // write output file
    length = int(int64(pack - reinterpret<uint8?>(pcx)))
    M_WriteFile(filename, reinterpret<void?>(pcx), length)
    Z_Free(reinterpret<void?>(pcx))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_ScreenShot(var format : uint8?) {
    var i : int
    // haleyjd 20110213: BUG FIX - 12 is too small!
    var lbmname : uint8[16]
    var ext : uint8?
    // find a file name to save it to
    ext = cstr("pcx")
    i = 0
    while (i <= 99) {
        M_snprintf`va(addr(lbmname[0]), uint64(typeinfo sizeof(type<uint8[16]>)), format, (i, ext))
        if (M_FileExists(addr(lbmname[0])) == 0) {
            // file doesn't exist
            break
        }
        i++
    }
    if (i == 100) {
        I_Error`va(cstr("V_ScreenShot: Couldn't create a PCX"), VaNone())
    }
    // save the pcx file
    WritePCXfile(addr(lbmname[0]), I_VideoBuffer, SCREENWIDTH, SCREENHEIGHT, reinterpret<uint8?>(W_CacheLumpName(cstr("PLAYPAL"), int(anon_28.PU_CACHE))))
}

[unsafe_deref, hint(unsafe_range_check)]
def V_DrawMouseSpeedBox(speed : int) {
    var bgcolor : int
    var bordercolor : int
    var red : int
    var black : int
    var white : int
    var yellow : int
    var box_x : int
    var box_y : int
    var original_speed : int
    var redline_x : int
    var linelen : int
    // Get palette indices for colors for widget. These depend on the
    // palette of the game being played.
    bgcolor = I_GetPaletteIndex(119, 119, 119)
    bordercolor = I_GetPaletteIndex(85, 85, 85)
    red = I_GetPaletteIndex(255, 0, 0)
    black = I_GetPaletteIndex(0, 0, 0)
    yellow = I_GetPaletteIndex(255, 255, 0)
    white = I_GetPaletteIndex(255, 255, 255)
    // If the mouse is turned off or acceleration is turned off, don't
    // draw the box at all.
    if (usemouse == 0 || math::abs(double(mouse_acceleration - 1.0f)) < 0.01lf) {
        return
    }
    // Calculate box position
    box_x = SCREENWIDTH - MOUSE_SPEED_BOX_WIDTH - 10
    box_y = 15
    V_DrawFilledBox(box_x, box_y, MOUSE_SPEED_BOX_WIDTH, MOUSE_SPEED_BOX_HEIGHT, bgcolor)
    V_DrawBox(box_x, box_y, MOUSE_SPEED_BOX_WIDTH, MOUSE_SPEED_BOX_HEIGHT, bordercolor)
    // Calculate the position of the red line. This is 1/3 of the way
    // along the box.
    redline_x = MOUSE_SPEED_BOX_WIDTH / 3
    // Undo acceleration and get back the original mouse speed
    if (speed < mouse_threshold) {
        original_speed = speed
    } else {
        original_speed = speed - mouse_threshold
        original_speed = int(float(original_speed) / mouse_acceleration)
        original_speed += mouse_threshold
    }
    // Calculate line length
    linelen = (original_speed * redline_x) / mouse_threshold
    // Draw horizontal "thermometer"
    if (linelen > MOUSE_SPEED_BOX_WIDTH - 1) {
        linelen = MOUSE_SPEED_BOX_WIDTH - 1
    }
    V_DrawHorizLine(box_x + 1, box_y + 4, MOUSE_SPEED_BOX_WIDTH - 2, black)
    if (linelen < redline_x) {
        V_DrawHorizLine(box_x + 1, box_y + MOUSE_SPEED_BOX_HEIGHT / 2, linelen, white)
    } else {
        V_DrawHorizLine(box_x + 1, box_y + MOUSE_SPEED_BOX_HEIGHT / 2, redline_x, white)
        V_DrawHorizLine(box_x + redline_x, box_y + MOUSE_SPEED_BOX_HEIGHT / 2, linelen - redline_x, yellow)
    }
    // Draw red line
    V_DrawVertLine(box_x + redline_x, box_y + 1, MOUSE_SPEED_BOX_HEIGHT - 2, red)
}

// slam background
[unsafe_deref, hint(unsafe_range_check)]
def WI_slamBackground {
