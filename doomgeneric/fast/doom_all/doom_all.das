[c_function, unsafe_deref, hint(unsafe_range_check)]
def mem_fopen_read(var buf : void?; buflen : uint64) : _MEMFILE? {
    var file : _MEMFILE?
    file = reinterpret<_MEMFILE?>(Z_Malloc(typeinfo sizeof(type<_MEMFILE>), int(anon_28.PU_STATIC), null))
    file.buf = reinterpret<uint8?>(buf)
    file.buflen = buflen
    file.position = 0u
    file.mode = memfile_mode_t.MODE_READ
    return file
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def mem_fread(var buf : void?; size : uint64; nmemb : uint64; var stream : _MEMFILE?) : uint64 {
    var items : uint64
    if (stream.mode != memfile_mode_t.MODE_READ) {
        fprintf(crt::c_stderr(), cstr("not a read stream\n"))
        return uint64(-1)
    }
    // Trying to read more bytes than we have left?
    items = nmemb
    if (items * size > stream.buflen - uint64(stream.position)) {
        items = (stream.buflen - uint64(stream.position)) / size
    }
    // Copy bytes to buffer
    crt::memcpy(buf, reinterpret<void?>(stream.buf + stream.position), items * size)
    // Update position
    stream.position = uint(uint64(stream.position) + items * size)
    return items
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def mem_fopen_write : _MEMFILE? {
    var file : _MEMFILE?
    file = reinterpret<_MEMFILE?>(Z_Malloc(typeinfo sizeof(type<_MEMFILE>), int(anon_28.PU_STATIC), null))
    file.alloced = 1024ul
    file.buf = reinterpret<uint8?>(Z_Malloc(int(file.alloced), int(anon_28.PU_STATIC), null))
    file.buflen = 0ul
    file.position = 0u
    file.mode = memfile_mode_t.MODE_WRITE
    return file
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def mem_fwrite(var ptr : void?; size : uint64; nmemb : uint64; var stream : _MEMFILE?) : uint64 {
    var bytes : uint64
    if (stream.mode != memfile_mode_t.MODE_WRITE) {
        return uint64(-1)
    }
    // More bytes than can fit in the buffer?
    // If so, reallocate bigger.
    bytes = size * nmemb
    while (bytes > stream.alloced - uint64(stream.position)) {
        var newbuf : uint8?
        newbuf = reinterpret<uint8?>(Z_Malloc(int(stream.alloced * 2ul), int(anon_28.PU_STATIC), null))
        crt::memcpy(reinterpret<void?>(newbuf), reinterpret<void?>(stream.buf), stream.alloced)
        Z_Free(reinterpret<void?>(stream.buf))
        stream.buf = newbuf
        stream.alloced *= 2ul
    }
    // Copy into buffer
    crt::memcpy(reinterpret<void?>(stream.buf + stream.position), ptr, bytes)
    stream.position = uint(uint64(stream.position) + bytes)
    if (uint64(stream.position) > stream.buflen) {
        stream.buflen = uint64(stream.position)
    }
    return nmemb
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def mem_get_buf(var stream : _MEMFILE?; var buf : void ??; var buflen : uint64?) {
    *buf = reinterpret<void?>(stream.buf)
    *buflen = stream.buflen
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def mem_fclose(var stream : _MEMFILE?) {
    if (stream.mode == memfile_mode_t.MODE_WRITE) {
        Z_Free(reinterpret<void?>(stream.buf))
    }
    Z_Free(reinterpret<void?>(stream))
}

[unsafe_deref, hint(unsafe_range_check)]
def mem_ftell(var stream : _MEMFILE?) : int64 {
    return int64(stream.position)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def mem_fseek(var stream : _MEMFILE?; position : int64; whence : mem_rel_t) : int {
    var newpos : uint
    c_switch(whence) {
        case(mem_rel_t.MEM_SEEK_SET) {
            newpos = uint(int(position))
            break
        }
        case(mem_rel_t.MEM_SEEK_CUR) {
            newpos = uint(int(int64(stream.position) + position))
            break
        }
        case(mem_rel_t.MEM_SEEK_END) {
            newpos = uint(int(stream.buflen + uint64(position)))
            break
        }
        case(_) {
            return -1
        }
    }
    if (uint64(newpos) < stream.buflen) {
        stream.position = newpos
        return 0
    } else {
        fprintf(crt::c_stderr(), cstr("Error seeking to %i\n"), newpos)
        return -1
    }
}

