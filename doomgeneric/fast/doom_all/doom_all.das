[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__CheckBossEnd(motype : mobjtype_t) : uint {
    if (uint(gameversion) < uint(GameVersion_t.exe_ultimate)) {
        if (gamemap != 8) {
            return 0u
        }
        // Baron death on later episodes is nothing special.
        if (motype == mobjtype_t.MT_BRUISER && gameepisode != 1) {
            return 0u
        }
        return 1u
    } else {
        // New logic that appeared in Ultimate Doom.
        // Looks like the logic was overhauled while adding in the
        // episode 4 support. Now bosses only trigger on their
        // specific episode.
        c_switch(gameepisode) {
            case(1) {
                return uint(int_of(gamemap == 8 && motype == mobjtype_t.MT_BRUISER))
            }
            case(2) {
                return uint(int_of(gamemap == 8 && motype == mobjtype_t.MT_CYBORG))
            }
            case(3) {
                return uint(int_of(gamemap == 8 && motype == mobjtype_t.MT_SPIDER))
            }
            case(4) {
                return uint(int_of((gamemap == 6 && motype == mobjtype_t.MT_CYBORG) || (gamemap == 8 && motype == mobjtype_t.MT_SPIDER)))
            }
            case(_) {
                return uint(int_of(gamemap == 8))
            }
        }
    }
}

// A_BossDeath
// Possibly trigger special effects
// if on first boss level
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_BossDeath(var mo : mobj_s?) {
    var th : thinker_s?
    var mo2 : mobj_s?
    var junk : line_s
    var i : int
    if (gamemode == GameMode_t.commercial) {
        if (gamemap != 7) {
            return
        }
        if ((mo._c_type != mobjtype_t.MT_FATSO) && (mo._c_type != mobjtype_t.MT_BABY)) {
            return
        }
    } else {
        if (doom_all__CheckBossEnd(mo._c_type) == 0) {
            return
        }
    }
    // make sure there is a player alive for victory
    i = 0
    while (i < MAXPLAYERS) {
        if (playeringame[i] != 0 && players[i].health > 0) {
            break
        }
        i++
    }
    if (i == MAXPLAYERS) {
        // no one left alive, so do not end game
        return
    }
    // scan the remaining thinkers to see
    // if all bosses are dead
    {
        th = thinkercap.next
        var _f = false
        while (true) {
            if (_f) {
                th = th.next
            }
            _f = true
            if (!(th != addr(thinkercap))) {
                break
            }
            if (th._c_function.acp1 != reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
                continue
            }
            mo2 = reinterpret<mobj_s?>(th)
            if (mo2 != mo && mo2._c_type == mo._c_type && mo2.health > 0) {
                // other boss not dead
                return
            }
        }
    }
    // victory!
    if (gamemode == GameMode_t.commercial) {
        if (gamemap == 7) {
            if (mo._c_type == mobjtype_t.MT_FATSO) {
                junk.tag = int16(666)
                EV_DoFloor(addr(junk), floor_e.lowerFloorToLowest)
                return
            }
            if (mo._c_type == mobjtype_t.MT_BABY) {
                junk.tag = int16(667)
                EV_DoFloor(addr(junk), floor_e.raiseToTexture)
                return
            }
        }
    } else {
        c_switch(gameepisode) {
            case(1) {
                junk.tag = int16(666)
                EV_DoFloor(addr(junk), floor_e.lowerFloorToLowest)
                return
                break
            }
            case(4) {
                c_switch(gamemap) {
                    case(6) {
                        junk.tag = int16(666)
                        EV_DoDoor(addr(junk), vldoor_e.vld_blazeOpen)
                        return
                        break
                    }
                    case(8) {
                        junk.tag = int16(666)
                        EV_DoFloor(addr(junk), floor_e.lowerFloorToLowest)
                        return
                        break
                    }
                }
            }
        }
    }
    G_ExitLevel()
}

