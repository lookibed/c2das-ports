    var name : uint8[32]
    // haleyjd: signedness conflict
    M_BindVariable(cstr("key_multi_msg"), reinterpret<void?>(addr(key_multi_msg)))
    for (i in urange(num_players)) {
        M_snprintf`va(addr(name[0]), uint64(typeinfo sizeof(type<uint8[32]>)), cstr("key_multi_msgplayer%i"), (i + 1u,))
        M_BindVariable(addr(name[0]), reinterpret<void?>(addr(key_multi_msgplayer[0]) + end_index(i, 8)))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
