        case(126) {
            // TELEPORT MonsterONLY.
            if (thing.player == null) {
                EV_Teleport(line, side, thing)
            }
            break
        }
        case(128) {
            // Raise To Nearest Floor
            EV_DoFloor(line, floor_e.raiseFloorToNearest)
            break
        }
        case(129) {
            // Raise Floor Turbo
            EV_DoFloor(line, floor_e.raiseFloorTurbo)
            break
        }
    }
}

// P_ShootSpecialLine - IMPACT SPECIALS
// Called when a thing shoots a special line.
[unsafe_deref, hint(unsafe_range_check)]
def P_ShootSpecialLine(var thing : mobj_s?; var line : line_s?) {
    var ok : int
    // Impacts that other things can activate.
    if (thing.player == null) {
        ok = 0
        c_switch(int(line.special)) {
            case(46) {
                // OPEN DOOR IMPACT
                ok = 1
                break
            }
        }
        if (ok == 0) {
            return
        }
    }
    c_switch(int(line.special)) {
        case(24) {
            // RAISE FLOOR
            EV_DoFloor(line, floor_e.raiseFloor)
            P_ChangeSwitchTexture(line, 0)
            break
        }
        case(46) {
            // OPEN DOOR
            EV_DoDoor(line, vldoor_e.vld_open)
            P_ChangeSwitchTexture(line, 1)
            break
        }
        case(47) {
            // RAISE FLOOR NEAR AND CHANGE
            EV_DoPlat(line, plattype_e.raiseToNearestAndChange, 0)
            P_ChangeSwitchTexture(line, 0)
            break
        }
    }
}

// P_PlayerInSpecialSector
// Called every tic frame
// that the player origin is in a special sector
[unsafe_deref, hint(unsafe_range_check)]
def P_PlayerInSpecialSector(var player : player_s?) {
    var sector : sector_t?
    sector = player.mo.subsector.sector
    // Falling, not all the way down yet?
    if (player.mo.z != sector.floorheight) {
        return
    }
    // Has hitten ground.
    c_switch(int(sector.special)) {
        case(5) {
            // HELLSLIME DAMAGE
            if (player.powers[int(powertype_t.pw_ironfeet)] == 0) {
                if ((leveltime & 31) == 0) {
                    P_DamageMobj(player.mo, null, null, 10)
                }
            }
            break
        }
        case(7) {
            // NUKAGE DAMAGE
            if (player.powers[int(powertype_t.pw_ironfeet)] == 0) {
                if ((leveltime & 31) == 0) {
                    P_DamageMobj(player.mo, null, null, 5)
                }
            }
            break
        }
        case(16, 4) {
            // SUPER HELLSLIME DAMAGE
            // STROBE HURT
            if (player.powers[int(powertype_t.pw_ironfeet)] == 0 || (P_Random() < 5)) {
                if ((leveltime & 31) == 0) {
                    P_DamageMobj(player.mo, null, null, 20)
                }
            }
            break
        }
        case(9) {
            // SECRET SECTOR
            player.secretcount++
            sector.special = int16(0)
            break
        }
        case(11) {
            // EXIT SUPER DAMAGE! (for E1M8 finale)
            player.cheats &= ~int(cheat_t.CF_GODMODE)
            if ((leveltime & 31) == 0) {
                P_DamageMobj(player.mo, null, null, 20)
            }
            if (player.health <= 10) {
                G_ExitLevel()
            }
            break
        }
        case(_) {
            I_Error`va(cstr("P_PlayerInSpecialSector: unknown special %i"), (int(sector.special),))
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UpdateSpecials {
    var anim : anim_t?
    var pic : int
    var i : int
    var line : line_s?
    // LEVEL TIMER
    if (levelTimer == 1u) {
        levelTimeCount--
        if (levelTimeCount == 0) {
            G_ExitLevel()
        }
    }
    // ANIMATE FLATS AND TEXTURES GLOBALLY
    anim = addr(anims[0])
    while (reinterpret<uint64>(anim) < reinterpret<uint64>(lastanim)) {
        i = anim.basepic
        while (i < anim.basepic + anim.numpics) {
            pic = anim.basepic + ((leveltime / anim.speed + i) % anim.numpics)
            if (anim.istexture != 0) {
                texturetranslation[i] = pic
            } else {
                flattranslation[i] = pic
            }
            i++
        }
        anim++
    }
    // ANIMATE LINE SPECIALS
    for (i1 in range(int(numlinespecials))) {
        line = linespeciallist[i1]
        c_switch(int(line.special)) {
            case(48) {
                // EFFECT FIRSTCOL SCROLL +
                sides[int(line.sidenum[0])].textureoffset += FRACUNIT
                break
            }
        }
    }
    // DO BUTTONS
    for (i1 in range(MAXBUTTONS)) {
        if (buttonlist[i1].btimer != 0) {
            buttonlist[i1].btimer--
            if (buttonlist[i1].btimer == 0) {
                c_switch(buttonlist[i1]._c_where) {
                    case(bwhere_e.top) {
                        sides[int(buttonlist[i1].line.sidenum[0])].toptexture = int16(buttonlist[i1].btexture)
                        break
                    }
                    case(bwhere_e.middle) {
                        sides[int(buttonlist[i1].line.sidenum[0])].midtexture = int16(buttonlist[i1].btexture)
                        break
                    }
                    case(bwhere_e.bottom) {
                        sides[int(buttonlist[i1].line.sidenum[0])].bottomtexture = int16(buttonlist[i1].btexture)
                        break
                    }
                }
                S_StartSound(reinterpret<void?>(addr(buttonlist[i1].soundorg)), int(sfxenum_t.sfx_swtchn))
                crt::memset(reinterpret<void?>(addr(buttonlist[0]) + end_index(i1, 16)), 0, uint64(typeinfo sizeof(type<button_t>)))
            }
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__DonutOverrun(var s3_floorheight : int?; var s3_floorpic : int16?; var line : line_s?; var pillar_sector : sector_t?) {
    if (DonutOverrun_first != 0) {
        var p : int
        // This is the first time we have had an overrun.
        DonutOverrun_first = 0
        // Default values
        DonutOverrun_tmp_s3_floorheight = DONUT_FLOORHEIGHT_DEFAULT
        DonutOverrun_tmp_s3_floorpic = DONUT_FLOORPIC_DEFAULT
        // !
        // @category compat
        // @arg <x> <y>
        // Use the specified magic values when emulating behavior caused
        // by memory overruns from improperly constructed donuts.
        // In Vanilla Doom this can differ depending on the operating
        // system. The default (if this option is not specified) is to
        // emulate the behavior when running under Windows 98.
        p = M_CheckParmWithArgs(cstr("-donut"), 2)
        if (p > 0) {
            // Dump of needed memory: (fixed_t)0000:0000 and (short)0000:0008
            // C:\>debug
            // -d 0:0
            // DOS 6.22:
            // 0000:0000 (57 92 19 00) F4 06 70 00-(16 00)
            // DOS 7.1:
            // 0000:0000 (9E 0F C9 00) 65 04 70 00-(16 00)
            // Win98:
            // 0000:0000 (00 00 00 00) 65 04 70 00-(16 00)
            // DOSBox under XP:
            // 0000:0000 (00 00 00 F1) ?? ?? ?? 00-(07 00)
            M_StrToInt(myargv[p + 1], addr(DonutOverrun_tmp_s3_floorheight))
            M_StrToInt(myargv[p + 2], addr(DonutOverrun_tmp_s3_floorpic))
            if (DonutOverrun_tmp_s3_floorpic >= numflats) {
                fprintf(crt::c_stderr(),
                        cstr("DonutOverrun: The second parameter for \"-donut\" switch should be greater than 0 and less than number of flats (%d). Using default value (%d) instead. \n"),
                        numflats, DONUT_FLOORPIC_DEFAULT)
                DonutOverrun_tmp_s3_floorpic = DONUT_FLOORPIC_DEFAULT
            }
        }
    }
    // fprintf(stderr,
    // "Linedef: %d; Sector: %d; "
    // "New floor height: %d; New floor pic: %d\n",
    // line->iLineID, pillar_sector->iSectorID,
    // tmp_s3_floorheight >> 16, tmp_s3_floorpic);
    *s3_floorheight = DonutOverrun_tmp_s3_floorheight
    *s3_floorpic = int16(DonutOverrun_tmp_s3_floorpic)
}

// Special Stuff that can not be categorized
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_DoDonut(var line : line_s?) : int {
    var s1 : sector_t?
    var s2 : sector_t?
    var s3 : sector_t?
    var secnum : int
    var rtn : int
    var i : int
    var floor : floormove_t?
    var s3_floorheight : int
    var s3_floorpic : int16
    secnum = -1
    rtn = 0
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        s1 = addr(sectors[secnum])
        // ALREADY MOVING? IF SO, KEEP GOING...
        if (s1.specialdata != null) {
            continue
        }
        rtn = 1
        s2 = getNextSector(s1.lines[0], s1)
        // Vanilla Doom does not check if the linedef is one sided. The
        // game does not crash, but reads invalid memory and causes the
        // sector floor to move "down" to some unknown height.
        // DOSbox prints a warning about an invalid memory access.
        // I'm not sure exactly what invalid memory is being read. This
        // isn't something that should be done, anyway.
        // Just print a warning and return.
        if (s2 == null) {
            fprintf(crt::c_stderr(), cstr("EV_DoDonut: linedef had no second sidedef! Unexpected behavior may occur in Vanilla Doom. \n"))
            break
        }
        {
            i = 0
            var _f = false
            while (true) {
                if (_f) {
                    i++
                }
                _f = true
                if (!(i < s2.linecount)) {
                    break
                }
                s3 = s2.lines[i].backsector
                if (s3 == s1) {
                    continue
                }
                if (s3 == null) {
                    // e6y
                    // s3 is NULL, so
                    // s3->floorheight is an int at 0000:0000
                    // s3->floorpic is a short at 0000:0008
                    // Trying to emulate
                    fprintf(crt::c_stderr(),
                            cstr("EV_DoDonut: WARNING: emulating buffer overrun due to NULL back sector. Unexpected behavior may occur in Vanilla Doom.\n"))
                    doom_all__DonutOverrun(addr(s3_floorheight), addr(s3_floorpic), line, s1)
                } else {
                    s3_floorheight = s3.floorheight
                    s3_floorpic = s3.floorpic
                }
                // Spawn rising slime
                floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), int(anon_28.PU_LEVSPEC), null))
                P_AddThinker(addr(floor.thinker))
                s2.specialdata = reinterpret<void?>(floor)
                floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
                floor._c_type = floor_e.donutRaise
                floor.crush = 0u
                floor.direction = 1
                floor.sector = s2
                floor.speed = FRACUNIT / 2
                floor.texture = s3_floorpic
                floor.newspecial = 0
                floor.floordestheight = s3_floorheight
                // Spawn lowering donut-hole
                floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), int(anon_28.PU_LEVSPEC), null))
                P_AddThinker(addr(floor.thinker))
                s1.specialdata = reinterpret<void?>(floor)
                floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
                floor._c_type = floor_e.lowerFloor
                floor.crush = 0u
                floor.direction = -1
                floor.sector = s1
                floor.speed = FRACUNIT / 2
                floor.floordestheight = s3_floorheight
                break
            }
        }
    }
    return rtn
}

// Parses command line parameters.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnSpecials {
    var sector : sector_t?
    var i : int
    // See if -TIMER was specified.
    if (timelimit > 0 && deathmatch != 0) {
        levelTimer = 1u
        levelTimeCount = timelimit * 60 * TICRATE
    } else {
        levelTimer = 0u
    }
    // Init special SECTORs.
    sector = sectors
    i = 0
    while (i < numsectors) {
        {
            if (sector.special == 0) {
                continue
            }
            c_switch(int(sector.special)) {
                case(1) {
                    // FLICKERING LIGHTS
                    P_SpawnLightFlash(sector)
                    break
                }
                case(2) {
                    // STROBE FAST
                    P_SpawnStrobeFlash(sector, FASTDARK, 0)
                    break
                }
                case(3) {
                    // STROBE SLOW
                    P_SpawnStrobeFlash(sector, SLOWDARK, 0)
                    break
                }
                case(4) {
                    // STROBE FAST/DEATH SLIME
                    P_SpawnStrobeFlash(sector, FASTDARK, 0)
                    sector.special = int16(4)
                    break
                }
                case(8) {
                    // GLOWING LIGHT
                    P_SpawnGlowingLight(sector)
                    break
                }
                case(9) {
                    // SECRET SECTOR
                    totalsecret++
                    break
                }
                case(10) {
                    // DOOR CLOSE IN 30 SECONDS
                    P_SpawnDoorCloseIn30(sector)
                    break
                }
                case(12) {
                    // SYNC STROBE SLOW
                    P_SpawnStrobeFlash(sector, SLOWDARK, 1)
                    break
                }
                case(13) {
                    // SYNC STROBE FAST
                    P_SpawnStrobeFlash(sector, FASTDARK, 1)
                    break
                }
                case(14) {
                    // DOOR RAISE IN 5 MINUTES
                    P_SpawnDoorRaiseIn5Mins(sector, i)
                    break
                }
                case(17) {
                    P_SpawnFireFlicker(sector)
                    break
                }
            }
        } finally {
            i++
            sector++
        }
    }
    // Init line EFFECTs
    numlinespecials = int16(0)
    i = 0
    while (i < numlines) {
        c_switch(int(lines[i].special)) {
            case(48) {
                if (int(numlinespecials) >= MAXLINEANIMS) {
                    I_Error`va(cstr("Too many scrolling wall linedefs! (Vanilla limit is 64)"), VaNone())
                }
                // EFFECT FIRSTCOL SCROLL+
                linespeciallist[int(numlinespecials)] = addr(lines[i])
                numlinespecials = int16(int(numlinespecials) + 1)
                break
            }
        }
        i++
    }
    // Init other misc stuff
    for (i1 in range(MAXCEILINGS)) {
        activeceilings[i1] = null
    }
    for (i1 in range(MAXPLATS)) {
        activeplats[i1] = null
    }
    for (i1 in range(MAXBUTTONS)) {
        crt::memset(reinterpret<void?>(addr(buttonlist[0]) + end_index(i1, 16)), 0, uint64(typeinfo sizeof(type<button_t>)))
    }
}

// P_InitSwitchList
// Only called at game initialization.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_InitSwitchList {
    var i : int
    var index : int
    var episode : int
    episode = 1
    if (gamemode == GameMode_t.registered || gamemode == GameMode_t.retail) {
        episode = 2
    } elif (gamemode == GameMode_t.commercial) {
        episode = 3
    }
    index = 0
    i = 0
    while (i < MAXSWITCHES) {
        if (alphSwitchList[i].episode == 0) {
            numswitches = index / 2
            switchlist[index] = -1
            break
        }
        if (int(alphSwitchList[i].episode) <= episode) {
            // UNUSED - debug?
            let _t0 = index
            index++
            switchlist[_t0] = R_TextureNumForName(addr(alphSwitchList[i].name1[0]))
            let _t1 = index
            index++
            switchlist[_t1] = R_TextureNumForName(addr(alphSwitchList[i].name2[0]))
        }
        i++
    }
}

// Start a button counting down till it turns off.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_StartButton(var line : line_s?; w : bwhere_e; texture : int; time : int) {
    // See if button is already pressed
    for (i in range(MAXBUTTONS)) {
        if (buttonlist[i].btimer != 0 && buttonlist[i].line == line) {
            return
        }
    }
    for (i in range(MAXBUTTONS)) {
        if (buttonlist[i].btimer == 0) {
            buttonlist[i].line = line
            buttonlist[i]._c_where = w
            buttonlist[i].btexture = texture
            buttonlist[i].btimer = time
            buttonlist[i].soundorg = addr(line.frontsector.soundorg)
            return
        }
    }
    I_Error`va(cstr("P_StartButton: no button slots left!"), VaNone())
}

// Function that changes wall texture.
// Tell it if switch is ok to use again (1=yes, it's a button).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ChangeSwitchTexture(var line : line_s?; useAgain : int) {
    var texTop : int
    var texMid : int
    var texBot : int
    var i : int
    var sound : int
    if (useAgain == 0) {
        line.special = int16(0)
    }
    texTop = int(sides[int(line.sidenum[0])].toptexture)
    texMid = int(sides[int(line.sidenum[0])].midtexture)
    texBot = int(sides[int(line.sidenum[0])].bottomtexture)
    sound = int(sfxenum_t.sfx_swtchn)
    // EXIT SWITCH?
    if (line.special == 11) {
        sound = int(sfxenum_t.sfx_swtchx)
    }
    i = 0
    while (i < numswitches * 2) {
        if (switchlist[i] == texTop) {
            S_StartSound(reinterpret<void?>(addr(buttonlist[0]).soundorg), sound)
            sides[int(line.sidenum[0])].toptexture = int16(switchlist[i ^ 1])
            if (useAgain != 0) {
                P_StartButton(line, bwhere_e.top, switchlist[i], BUTTONTIME)
            }
            return
        } else {
            if (switchlist[i] == texMid) {
                S_StartSound(reinterpret<void?>(addr(buttonlist[0]).soundorg), sound)
                sides[int(line.sidenum[0])].midtexture = int16(switchlist[i ^ 1])
                if (useAgain != 0) {
                    P_StartButton(line, bwhere_e.middle, switchlist[i], BUTTONTIME)
                }
                return
            } else {
                if (switchlist[i] == texBot) {
                    S_StartSound(reinterpret<void?>(addr(buttonlist[0]).soundorg), sound)
                    sides[int(line.sidenum[0])].bottomtexture = int16(switchlist[i ^ 1])
                    if (useAgain != 0) {
                        P_StartButton(line, bwhere_e.bottom, switchlist[i], BUTTONTIME)
                    }
                    return
                }
            }
        }
        i++
    }
}

// P_UseSpecialLine
// Called when a thing uses a special line.
// Only the front sides of lines are usable.
[unsafe_deref, hint(unsafe_range_check)]
def P_UseSpecialLine(var thing : mobj_s?; var line : line_s?; side : int) : uint {
    // Err...
    // Use the back sides of VERY SPECIAL lines...
    if (side != 0) {
        c_switch(int(line.special)) {
            case(124) {
                // Sliding door open&close
                // UNUSED?
                break
            }
            case(_) {
                return 0u
                break
            }
        }
    }
    // Switches that other things can activate.
    if (thing.player == null) {
        // never open secret doors
        if ((int(line.flags) & ML_SECRET) != 0) {
            return 0u
        }
        c_switch(int(line.special)) {
            case(1, 32, 33, 34) {
                // MANUAL DOOR RAISE
                // MANUAL BLUE
                // MANUAL RED
                // MANUAL YELLOW
                break
            }
            case(_) {
                return 0u
                break
            }
        }
    }
    // do something
    c_switch(int(line.special)) {
        case(1, 26, 27, 28, 31, 32, 33, 34, 117, 118) {
            // MANUALS
            // Vertical Door
            // Blue Door/Locked
            // Yellow Door /Locked
            // Red Door /Locked
            // Manual door open
            // Blue locked door open
            // Red locked door open
            // Yellow locked door open
            // Blazing door raise
            // Blazing door open
            EV_VerticalDoor(line, thing)
            break
        }
        case(7) {
            // UNUSED - Door Slide Open&Close
            // case 124:
            // EV_SlidingDoor (line, thing);
            // break;
            // SWITCHES
            // Build Stairs
            if (EV_BuildStairs(line, stair_e.build8) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(9) {
            // Change Donut
            if (EV_DoDonut(line) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(11) {
            // Exit level
            P_ChangeSwitchTexture(line, 0)
            G_ExitLevel()
            break
        }
        case(14) {
            // Raise Floor 32 and change texture
            if (EV_DoPlat(line, plattype_e.raiseAndChange, 32) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(15) {
            // Raise Floor 24 and change texture
            if (EV_DoPlat(line, plattype_e.raiseAndChange, 24) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(18) {
            // Raise Floor to next highest floor
            if (EV_DoFloor(line, floor_e.raiseFloorToNearest) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(20) {
            // Raise Plat next highest floor and change texture
            if (EV_DoPlat(line, plattype_e.raiseToNearestAndChange, 0) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(21) {
            // PlatDownWaitUpStay
            if (EV_DoPlat(line, plattype_e.downWaitUpStay, 0) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(23) {
            // Lower Floor to Lowest
            if (EV_DoFloor(line, floor_e.lowerFloorToLowest) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(29) {
            // Raise Door
            if (EV_DoDoor(line, vldoor_e.vld_normal) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(41) {
            // Lower Ceiling to Floor
            if (EV_DoCeiling(line, ceiling_e.lowerToFloor) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(71) {
            // Turbo Lower Floor
            if (EV_DoFloor(line, floor_e.turboLower) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(49) {
            // Ceiling Crush And Raise
            if (EV_DoCeiling(line, ceiling_e.crushAndRaise) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(50) {
            // Close Door
            if (EV_DoDoor(line, vldoor_e.vld_close) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(51) {
            // Secret EXIT
            P_ChangeSwitchTexture(line, 0)
            G_SecretExitLevel()
            break
        }
        case(55) {
            // Raise Floor Crush
            if (EV_DoFloor(line, floor_e.raiseFloorCrush) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(101) {
            // Raise Floor
            if (EV_DoFloor(line, floor_e.raiseFloor) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(102) {
            // Lower Floor to Surrounding floor height
            if (EV_DoFloor(line, floor_e.lowerFloor) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(103) {
            // Open Door
            if (EV_DoDoor(line, vldoor_e.vld_open) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(111) {
            // Blazing Door Raise (faster than TURBO!)
            if (EV_DoDoor(line, vldoor_e.vld_blazeRaise) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(112) {
            // Blazing Door Open (faster than TURBO!)
            if (EV_DoDoor(line, vldoor_e.vld_blazeOpen) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(113) {
            // Blazing Door Close (faster than TURBO!)
            if (EV_DoDoor(line, vldoor_e.vld_blazeClose) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(122) {
            // Blazing PlatDownWaitUpStay
            if (EV_DoPlat(line, plattype_e.blazeDWUS, 0) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(127) {
            // Build Stairs Turbo 16
            if (EV_BuildStairs(line, stair_e.turbo16) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(131) {
            // Raise Floor Turbo
            if (EV_DoFloor(line, floor_e.raiseFloorTurbo) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(133, 135, 137) {
            // BlzOpenDoor BLUE
            // BlzOpenDoor RED
            // BlzOpenDoor YELLOW
            if (EV_DoLockedDoor(line, vldoor_e.vld_blazeOpen, thing) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(140) {
            // Raise Floor 512
            if (EV_DoFloor(line, floor_e.raiseFloor512) != 0) {
                P_ChangeSwitchTexture(line, 0)
            }
            break
        }
        case(42) {
            // BUTTONS
            // Close Door
            if (EV_DoDoor(line, vldoor_e.vld_close) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(43) {
            // Lower Ceiling to Floor
            if (EV_DoCeiling(line, ceiling_e.lowerToFloor) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(45) {
            // Lower Floor to Surrounding floor height
            if (EV_DoFloor(line, floor_e.lowerFloor) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(60) {
            // Lower Floor to Lowest
            if (EV_DoFloor(line, floor_e.lowerFloorToLowest) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(61) {
            // Open Door
            if (EV_DoDoor(line, vldoor_e.vld_open) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(62) {
            // PlatDownWaitUpStay
            if (EV_DoPlat(line, plattype_e.downWaitUpStay, 1) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(63) {
            // Raise Door
            if (EV_DoDoor(line, vldoor_e.vld_normal) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(64) {
            // Raise Floor to ceiling
            if (EV_DoFloor(line, floor_e.raiseFloor) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(66) {
            // Raise Floor 24 and change texture
            if (EV_DoPlat(line, plattype_e.raiseAndChange, 24) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(67) {
            // Raise Floor 32 and change texture
            if (EV_DoPlat(line, plattype_e.raiseAndChange, 32) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(65) {
            // Raise Floor Crush
            if (EV_DoFloor(line, floor_e.raiseFloorCrush) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(68) {
            // Raise Plat to next highest floor and change texture
            if (EV_DoPlat(line, plattype_e.raiseToNearestAndChange, 0) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(69) {
            // Raise Floor to next highest floor
            if (EV_DoFloor(line, floor_e.raiseFloorToNearest) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(70) {
            // Turbo Lower Floor
            if (EV_DoFloor(line, floor_e.turboLower) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(114) {
            // Blazing Door Raise (faster than TURBO!)
            if (EV_DoDoor(line, vldoor_e.vld_blazeRaise) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(115) {
            // Blazing Door Open (faster than TURBO!)
            if (EV_DoDoor(line, vldoor_e.vld_blazeOpen) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(116) {
            // Blazing Door Close (faster than TURBO!)
            if (EV_DoDoor(line, vldoor_e.vld_blazeClose) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(123) {
            // Blazing PlatDownWaitUpStay
            if (EV_DoPlat(line, plattype_e.blazeDWUS, 0) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(132) {
            // Raise Floor Turbo
            if (EV_DoFloor(line, floor_e.raiseFloorTurbo) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(99, 134, 136) {
            // BlzOpenDoor BLUE
            // BlzOpenDoor RED
            // BlzOpenDoor YELLOW
            if (EV_DoLockedDoor(line, vldoor_e.vld_blazeOpen, thing) != 0) {
                P_ChangeSwitchTexture(line, 1)
            }
            break
        }
        case(138) {
            // Light Turn On
            EV_LightTurnOn(line, 255)
            P_ChangeSwitchTexture(line, 1)
            break
        }
        case(139) {
            // Light Turn Off
            EV_LightTurnOn(line, 35)
            P_ChangeSwitchTexture(line, 1)
            break
        }
    }
    return 1u
}

// TELEPORTATION
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_Teleport(var line : line_s?; side : int; var thing : mobj_s?) : int {
    var i : int
    var tag : int
    var m : mobj_s?
    var fog : mobj_s?
    var an : uint
    var thinker : thinker_s?
    var sector : sector_t?
    var oldx : int
    var oldy : int
    var oldz : int
    // don't teleport missiles
    if ((thing.flags & int(mobjflag_t.MF_MISSILE)) != 0) {
        return 0
    }
    // Don't teleport if hit back of line,
    // so you can get out of teleporter.
    if (side == 1) {
        return 0
    }
    tag = int(line.tag)
    i = 0
    while (i < numsectors) {
        if (int(sectors[i].tag) == tag) {
            thinker = thinkercap.next
            {
                thinker = thinkercap.next
                var _f = false
                while (true) {
                    if (_f) {
                        thinker = thinker.next
                    }
                    _f = true
                    if (!(thinker != addr(thinkercap))) {
                        break
                    }
                    // not a mobj
                    if (thinker._c_function.acp1 != reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
                        continue
                    }
                    m = reinterpret<mobj_s?>(thinker)
                    // not a teleportman
                    if (m._c_type != mobjtype_t.MT_TELEPORTMAN) {
                        continue
                    }
                    sector = m.subsector.sector
                    // wrong sector
                    if (int64(sector - sectors) != int64(i)) {
                        continue
                    }
                    oldx = thing.x
                    oldy = thing.y
                    oldz = thing.z
                    if (P_TeleportMove(thing, m.x, m.y) == 0) {
                        return 0
                    }
                    // The first Final Doom executable does not set thing->z
                    // when teleporting. This quirk is unique to this
                    // particular version; the later version included in
                    // some versions of the Id Anthology fixed this.
                    if (gameversion != GameVersion_t.exe_final) {
                        thing.z = thing.floorz
                    }
                    if (thing.player != null) {
                        thing.player.viewz = thing.z + thing.player.viewheight
                    }
                    // spawn teleport fog at source and destination
                    fog = P_SpawnMobj(oldx, oldy, oldz, mobjtype_t.MT_TFOG)
                    S_StartSound(reinterpret<void?>(fog), int(sfxenum_t.sfx_telept))
                    an = m.angle >> uint(ANGLETOFINESHIFT)
                    fog = P_SpawnMobj(m.x + 20 * finecosine[an], m.y + 20 * finesine[an], thing.z, mobjtype_t.MT_TFOG)
                    // emit sound, where?
                    S_StartSound(reinterpret<void?>(fog), int(sfxenum_t.sfx_telept))
                    // don't move for a bit
                    if (thing.player != null) {
                        thing.reactiontime = 18
                    }
                    thing.angle = m.angle
                    thing.momz = 0
                    thing.momy = thing.momz
                    thing.momx = thing.momy
                    return 1
                }
            }
        }
        i++
    }
    return 0
}

// P_InitThinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_InitThinkers {
    thinkercap.next = addr(thinkercap)
    thinkercap.prev = thinkercap.next
}

// P_AddThinker
// Adds a new thinker at the end of the list.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_AddThinker(var thinker : thinker_s?) {
    thinkercap.prev.next = thinker
    thinker.next = addr(thinkercap)
    thinker.prev = thinkercap.prev
    thinkercap.prev = thinker
}

// P_RemoveThinker
// Deallocation is lazy -- it will not actually be freed
// until its thinking turn comes up.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RemoveThinker(var thinker : thinker_s?) {
    // FIXME: NOP.
    thinker._c_function.acv = reinterpret<function<() : void>>(uint64(-1))
}

// P_AllocateThinker
// Allocates memory and adds a new thinker at the end of the list.
[unsafe_deref, hint(unsafe_range_check)]
def P_AllocateThinker(var thinker : thinker_s?) {
}

// P_RunThinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RunThinkers {
    var currentthinker : thinker_s?
    currentthinker = thinkercap.next
    while (currentthinker != addr(thinkercap)) {
        if (currentthinker._c_function.acv == reinterpret<function<() : void>>(uint64(-1))) {
            // time to remove it
            currentthinker.next.prev = currentthinker.prev
            currentthinker.prev.next = currentthinker.next
            Z_Free(reinterpret<void?>(currentthinker))
        } else {
            if (currentthinker._c_function.acp1 != null) {
                invoke(currentthinker._c_function.acp1, reinterpret<void?>(currentthinker))
            }
        }
        currentthinker = currentthinker.next
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_Ticker {
    // run the tic
    if (paused != 0) {
        return
    }
    // pause if in menu and at least one tic has been run
    if (netgame == 0 && menuactive != 0 && demoplayback == 0 && players[consoleplayer].viewz != 1) {
        return
    }
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] != 0) {
            P_PlayerThink(addr(players[0]) + end_index(i, 4))
        }
    }
    P_RunThinkers()
    P_UpdateSpecials()
    P_RespawnSpecials()
    // for par times
    leveltime++
}

// P_Thrust
// Moves the given origin along a given angle.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_Thrust(var player : player_s?; var angle : uint; move : int) {
    angle >>= uint(ANGLETOFINESHIFT)
    player.mo.momx += FixedMul(move, finecosine[angle])
    player.mo.momy += FixedMul(move, finesine[angle])
}

// P_CalcHeight
// Calculate the walking / running height adjustment
[unsafe_deref, hint(unsafe_range_check)]
def P_CalcHeight(var player : player_s?) {
    var angle : int
    var bob : int
    // Regular movement bobbing
    // (needs to be calculated for gun swing
    // even if not on ground)
    // OPTIMIZE: tablify angle
    // Note: a LUT allows for effects
    // like a ramp with low health.
    player.bob = FixedMul(player.mo.momx, player.mo.momx) + FixedMul(player.mo.momy, player.mo.momy)
    player.bob >>= 2
    if (player.bob > MAXBOB) {
        player.bob = MAXBOB
    }
    if ((player.cheats & int(cheat_t.CF_NOMOMENTUM)) != 0 || onground == 0) {
        player.viewz = player.mo.z + VIEWHEIGHT
        if (player.viewz > player.mo.ceilingz - 4 * FRACUNIT) {
            player.viewz = player.mo.ceilingz - 4 * FRACUNIT
        }
        player.viewz = player.mo.z + player.viewheight
        return
    }
    angle = (FINEANGLES / 20 * leveltime) & FINEMASK
    bob = FixedMul(player.bob / 2, finesine[angle])
    // move viewheight
    if (player.playerstate == playerstate_t.PST_LIVE) {
        player.viewheight += player.deltaviewheight
        if (player.viewheight > VIEWHEIGHT) {
            player.viewheight = VIEWHEIGHT
            player.deltaviewheight = 0
        }
        if (player.viewheight < VIEWHEIGHT / 2) {
            player.viewheight = VIEWHEIGHT / 2
            if (player.deltaviewheight <= 0) {
                player.deltaviewheight = 1
            }
        }
        if (player.deltaviewheight != 0) {
            player.deltaviewheight += FRACUNIT / 4
            if (player.deltaviewheight == 0) {
                player.deltaviewheight = 1
            }
        }
    }
    player.viewz = player.mo.z + player.viewheight + bob
    if (player.viewz > player.mo.ceilingz - 4 * FRACUNIT) {
        player.viewz = player.mo.ceilingz - 4 * FRACUNIT
    }
}

// P_MovePlayer
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_MovePlayer(var player : player_s?) {
    var cmd : ticcmd_t?
    cmd = addr(player.cmd)
    player.mo.angle += uint(int(cmd.angleturn) << 16)
    // Do not let the player control movement
    // if not onground.
    onground = uint(int_of(player.mo.z <= player.mo.floorz))
    if (cmd.forwardmove != 0 && onground != 0) {
        P_Thrust(player, player.mo.angle, int(cmd.forwardmove) * 2048)
    }
    if (cmd.sidemove != 0 && onground != 0) {
        P_Thrust(player, player.mo.angle - uint(ANG90), int(cmd.sidemove) * 2048)
    }
    if ((cmd.forwardmove != 0 || cmd.sidemove != 0) && player.mo.state == addr(states[int(statenum_t.S_PLAY)])) {
        P_SetMobjState(player.mo, statenum_t.S_PLAY_RUN1)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def P_DeathThink(var player : player_s?) {
    var angle : uint
    var delta : uint
    P_MovePsprites(player)
    // fall to the ground
    if (player.viewheight > 6 * FRACUNIT) {
        player.viewheight -= FRACUNIT
    }
    if (player.viewheight < 6 * FRACUNIT) {
        player.viewheight = 6 * FRACUNIT
    }
    player.deltaviewheight = 0
    onground = uint(int_of(player.mo.z <= player.mo.floorz))
    P_CalcHeight(player)
    if (player.attacker != null && player.attacker != player.mo) {
        angle = R_PointToAngle2(player.mo.x, player.mo.y, player.attacker.x, player.attacker.y)
        delta = angle - player.mo.angle
        if (delta < uint(ANG5) || delta > uint(-ANG5)) {
            // Looking at killer,
            // so fade damage flash down.
            player.mo.angle = angle
            if (player.damagecount != 0) {
                player.damagecount--
            }
        } elif (delta < ANG180) {
            player.mo.angle += uint(ANG5)
        } else {
            player.mo.angle -= uint(ANG5)
        }
    } elif (player.damagecount != 0) {
        player.damagecount--
    }
    if ((int(player.cmd.buttons) & int(buttoncode_t.BT_USE)) != 0) {
        player.playerstate = playerstate_t.PST_REBORN
    }
}

// P_PlayerThink
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_PlayerThink(var player : player_s?) {
    var cmd : ticcmd_t?
    var newweapon : weapontype_t
    // fixme: do this in the cheat code
    if ((player.cheats & int(cheat_t.CF_NOCLIP)) != 0) {
        player.mo.flags |= int(mobjflag_t.MF_NOCLIP)
    } else {
        player.mo.flags &= ~int(mobjflag_t.MF_NOCLIP)
    }
    // chain saw run forward
    cmd = addr(player.cmd)
    if ((player.mo.flags & int(mobjflag_t.MF_JUSTATTACKED)) != 0) {
        cmd.angleturn = int16(0)
        cmd.forwardmove = int8(51200 / 512)
        cmd.sidemove = int8(0)
        player.mo.flags &= ~int(mobjflag_t.MF_JUSTATTACKED)
    }
    if (player.playerstate == playerstate_t.PST_DEAD) {
        P_DeathThink(player)
        return
    }
    // Move around.
    // Reactiontime is used to prevent movement
    // for a bit after a teleport.
    if (player.mo.reactiontime != 0) {
        player.mo.reactiontime--
    } else {
        P_MovePlayer(player)
    }
    P_CalcHeight(player)
    if (player.mo.subsector.sector.special != 0) {
        P_PlayerInSpecialSector(player)
    }
    // Check for weapon change.
    // A special event has no other buttons.
    if ((int(cmd.buttons) & int(buttoncode_t.BT_SPECIAL)) != 0) {
        cmd.buttons = 0u8
    }
    if ((int(cmd.buttons) & int(buttoncode_t.BT_CHANGE)) != 0) {
        // The actual changing of the weapon is done
        // when the weapon psprite can do it
        // (read: not in the middle of an attack).
        newweapon = enum_from_int(type<weapontype_t>, (int(cmd.buttons) & int(buttoncode_t.BT_WEAPONMASK)) >> int(buttoncode_t.BT_WEAPONSHIFT))
        if (newweapon == weapontype_t.wp_fist && player.weaponowned[int(weapontype_t.wp_chainsaw)] != 0 &&
                !(player.readyweapon == weapontype_t.wp_chainsaw && player.powers[int(powertype_t.pw_strength)] != 0)) {
            newweapon = weapontype_t.wp_chainsaw
        }
        if ((gamemode == GameMode_t.commercial) && newweapon == weapontype_t.wp_shotgun && player.weaponowned[int(weapontype_t.wp_supershotgun)] != 0 &&
                player.readyweapon != weapontype_t.wp_supershotgun) {
            newweapon = weapontype_t.wp_supershotgun
        }
        if (player.weaponowned[int(newweapon)] != 0 && newweapon != player.readyweapon) {
            // Do not go to plasma or BFG in shareware,
            // even if cheated.
            if ((newweapon != weapontype_t.wp_plasma && newweapon != weapontype_t.wp_bfg) || (gamemode != GameMode_t.shareware)) {
                player.pendingweapon = newweapon
            }
        }
    }
    // check for use
    if ((int(cmd.buttons) & int(buttoncode_t.BT_USE)) != 0) {
        if (player.usedown == 0) {
            P_UseLines(player)
            player.usedown = 1
        }
    } else {
        player.usedown = 0
    }
    // cycle psprites
    P_MovePsprites(player)
    // Counters, time dependend power ups.
    // Strength counts up to diminish fade.
    if (player.powers[int(powertype_t.pw_strength)] != 0) {
        player.powers[int(powertype_t.pw_strength)]++
    }
    if (player.powers[int(powertype_t.pw_invulnerability)] != 0) {
        player.powers[int(powertype_t.pw_invulnerability)]--
    }
    if (player.powers[int(powertype_t.pw_invisibility)] != 0) {
        player.powers[int(powertype_t.pw_invisibility)]--
        if (player.powers[int(powertype_t.pw_invisibility)] == 0) {
            player.mo.flags &= ~int(mobjflag_t.MF_SHADOW)
        }
    }
    if (player.powers[int(powertype_t.pw_infrared)] != 0) {
        player.powers[int(powertype_t.pw_infrared)]--
    }
    if (player.powers[int(powertype_t.pw_ironfeet)] != 0) {
        player.powers[int(powertype_t.pw_ironfeet)]--
    }
    if (player.damagecount != 0) {
        player.damagecount--
    }
    if (player.bonuscount != 0) {
        player.bonuscount--
    }
    // Handling colormaps.
    if (player.powers[int(powertype_t.pw_invulnerability)] != 0) {
        if (player.powers[int(powertype_t.pw_invulnerability)] > 4 * 32 || (player.powers[int(powertype_t.pw_invulnerability)] & 8) != 0) {
            player.fixedcolormap = INVERSECOLORMAP
        } else {
            player.fixedcolormap = 0
        }
    } elif (player.powers[int(powertype_t.pw_infrared)] != 0) {
        if (player.powers[int(powertype_t.pw_infrared)] > 4 * 32 || (player.powers[int(powertype_t.pw_infrared)] & 8) != 0) {
            // almost full bright
            player.fixedcolormap = 1
        } else {
            player.fixedcolormap = 0
        }
    } else {
        player.fixedcolormap = 0
    }
}

// R_ClearDrawSegs
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClearDrawSegs {
    ds_p = addr(drawsegs[0])
}

// R_ClipSolidWallSegment
// Does handle solid walls,
// e.g. single sided LineDefs (middle texture)
// that entirely block the view.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClipSolidWallSegment(first : int; last : int) {
    var next : cliprange_t?
    var start : cliprange_t?
    // Find the first range that touches the range
    // (adjacent pixels are touching).
    start = addr(solidsegs[0])
    while (start.last < first - 1) {
        start++
    }
    if (first < start.first) {
        if (last < start.first - 1) {
            // Post is entirely visible (above start),
            // so insert a new clippost.
            R_StoreWallRange(first, last)
            next = newend
            newend++
            while (next != start) {
                *next = *(next - 1)
                next--
            }
            next.first = first
            next.last = last
            return
        }
        // There is a fragment above *start.
        R_StoreWallRange(first, start.first - 1)
        // Now adjust the clip size.
        start.first = first
    }
    // Bottom contained in start?
    if (last <= start.last) {
        return
    }
    next = start
    while (last >= (next + 1).first - 1) {
        // There is a fragment between two posts.
        R_StoreWallRange(next.last + 1, (next + 1).first - 1)
        next++
        if (last <= next.last) {
            // Bottom is contained in next.
            // Adjust the clip size.
            start.last = next.last
            goto label 1
        }
    }
    // There is a fragment after *next.
    R_StoreWallRange(next.last + 1, last)
    // Adjust the clip size.
    start.last = last
    label 1:  // crunch
    // Remove start+1 to next from the clip list,
    // because start now covers their area.
    if (next == start) {
        // Post just extended past the bottom of one post.
        return
    }
    while (true) {
        var _t0 = next
        next++
        if (!(_t0 != newend)) {
            break
        }
        // Remove a post.
        start++
        *start = *next
    }
    newend = start + 1
}

// R_ClipPassWallSegment
// Clips the given range of columns,
// but does not includes it in the clip list.
// Does handle windows,
// e.g. LineDefs with upper and lower texture.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClipPassWallSegment(first : int; last : int) {
    var start : cliprange_t?
    // Find the first range that touches the range
    // (adjacent pixels are touching).
    start = addr(solidsegs[0])
    while (start.last < first - 1) {
        start++
    }
    if (first < start.first) {
        if (last < start.first - 1) {
            // Post is entirely visible (above start).
            R_StoreWallRange(first, last)
            return
        }
        // There is a fragment above *start.
        R_StoreWallRange(first, start.first - 1)
    }
    // Bottom contained in start?
    if (last <= start.last) {
        return
    }
    while (last >= (start + 1).first - 1) {
        // There is a fragment between two posts.
        R_StoreWallRange(start.last + 1, (start + 1).first - 1)
        start++
        if (last <= start.last) {
            return
        }
    }
    // There is a fragment after *next.
    R_StoreWallRange(start.last + 1, last)
}

// R_ClearClipSegs
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClearClipSegs {
    solidsegs[0].first = -2147483647
    solidsegs[0].last = -1
    solidsegs[1].first = viewwidth
    solidsegs[1].last = 2147483647
    newend = addr(solidsegs[0]) + 2
}

// R_AddLine
// Clips the given segment
// and adds any visible pieces to the line list.
[unsafe_deref, hint(unsafe_range_check)]
def R_AddLine(var line : seg_t?) {
    var x1 : int
    var x2 : int
    var angle1 : uint
    var angle2 : uint
    var span : uint
    var tspan : uint
    curline = line
    // OPTIMIZE: quickly reject orthogonal back sides.
    angle1 = R_PointToAngle(line.v1.x, line.v1.y)
    angle2 = R_PointToAngle(line.v2.x, line.v2.y)
    // Clip to view edges.
    // OPTIMIZE: make constant out of 2*clipangle (FIELDOFVIEW).
    span = angle1 - angle2
    // Back side? I.e. backface culling?
    if (span >= ANG180) {
        return
    }
    // Global angle needed by segcalc.
    rw_angle1 = int(angle1)
    angle1 -= viewangle
    angle2 -= viewangle
    tspan = angle1 + clipangle
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return
        }
        angle1 = clipangle
    }
    tspan = clipangle - angle2
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return
        }
        angle2 = -clipangle
    }
    // The seg is in the view range,
    // but not necessarily visible.
    angle1 = (angle1 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    angle2 = (angle2 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    x1 = viewangletox[angle1]
    x2 = viewangletox[angle2]
    // Does not cross a pixel?
    if (x1 == x2) {
        return
    }
    backsector = line.backsector
    // Single sided line?
    if (backsector == null) {
        goto label 2
    }
    // Closed door.
    if (backsector.ceilingheight <= frontsector.floorheight || backsector.floorheight >= frontsector.ceilingheight) {
        goto label 2
    }
    // Window.
    if (backsector.ceilingheight != frontsector.ceilingheight || backsector.floorheight != frontsector.floorheight) {
        goto label 1
    }
    // Reject empty lines used for triggers
    // and special events.
    // Identical floor and ceiling on both sides,
    // identical light levels on both sides,
    // and no middle texture.
    if (backsector.ceilingpic == frontsector.ceilingpic && backsector.floorpic == frontsector.floorpic && backsector.lightlevel == frontsector.lightlevel &&
            curline.sidedef.midtexture == 0) {
        return
    }
    label 1:  // clippass
    R_ClipPassWallSegment(x1, x2 - 1)
    return
    label 2:  // clipsolid
    R_ClipSolidWallSegment(x1, x2 - 1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_CheckBBox(var bspcoord : int?) : uint {
    var boxx : int
    var boxy : int
    var boxpos : int
    var x1 : int
    var y1 : int
    var x2 : int
    var y2 : int
    var angle1 : uint
    var angle2 : uint
    var span : uint
    var tspan : uint
    var start : cliprange_t?
    var sx1 : int
    var sx2 : int
    // Find the corners of the box
    // that define the edges from current viewpoint.
    if (viewx <= bspcoord[int(anon_982.BOXLEFT)]) {
        boxx = 0
    } elif (viewx < bspcoord[int(anon_982.BOXRIGHT)]) {
        boxx = 1
    } else {
        boxx = 2
    }
    if (viewy >= bspcoord[int(anon_982.BOXTOP)]) {
        boxy = 0
    } elif (viewy > bspcoord[int(anon_982.BOXBOTTOM)]) {
        boxy = 1
    } else {
        boxy = 2
    }
    boxpos = (boxy << 2) + boxx
    if (boxpos == 5) {
        return 1u
    }
    x1 = bspcoord[checkcoord[boxpos][0]]
    y1 = bspcoord[checkcoord[boxpos][1]]
    x2 = bspcoord[checkcoord[boxpos][2]]
    y2 = bspcoord[checkcoord[boxpos][3]]
    // check clip list for an open space
    angle1 = R_PointToAngle(x1, y1) - viewangle
    angle2 = R_PointToAngle(x2, y2) - viewangle
    span = angle1 - angle2
    // Sitting on a line?
    if (span >= ANG180) {
        return 1u
    }
    tspan = angle1 + clipangle
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return 0u
        }
        angle1 = clipangle
    }
    tspan = clipangle - angle2
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return 0u
        }
        angle2 = -clipangle
    }
    // Find the first clippost
    // that touches the source post
    // (adjacent pixels are touching).
    angle1 = (angle1 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    angle2 = (angle2 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    sx1 = viewangletox[angle1]
    sx2 = viewangletox[angle2]
    // Does not cross a pixel.
    if (sx1 == sx2) {
        return 0u
    }
    sx2--
    start = addr(solidsegs[0])
    while (start.last < sx2) {
        start++
    }
    if (sx1 >= start.first && sx2 <= start.last) {
        // The clippost contains the new span.
        return 0u
    }
    return 1u
}

// R_Subsector
// Determine floor/ceiling planes.
// Add sprites of things in sector.
// Draw one or more line segments.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_Subsector(num : int) {
    var count : int
    var line : seg_t?
    var sub : subsector_s?
    if (num >= numsubsectors) {
        I_Error`va(cstr("R_Subsector: ss %i with numss = %i"), (num, numsubsectors))
    }
    sscount++
    sub = addr(subsectors[num])
    frontsector = sub.sector
    count = int(sub.numlines)
    line = addr(segs[int(sub.firstline)])
    if (frontsector.floorheight < viewz) {
        floorplane = R_FindPlane(frontsector.floorheight, int(frontsector.floorpic), int(frontsector.lightlevel))
    } else {
        floorplane = null
    }
    if (frontsector.ceilingheight > viewz || int(frontsector.ceilingpic) == skyflatnum) {
        ceilingplane = R_FindPlane(frontsector.ceilingheight, int(frontsector.ceilingpic), int(frontsector.lightlevel))
    } else {
        ceilingplane = null
    }
    R_AddSprites(frontsector)
    while (true) {
        let _t0 = count
        count--
        if (_t0 == 0) {
            break
        }
        R_AddLine(line)
        line++
    }
}

// RenderBSPNode
// Renders all subsectors below a given node,
// traversing subtree recursively.
// Just call with BSP root.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_RenderBSPNode(bspnum : int) {
    var bsp : node_t?
    var side : int
    // Found a subsector?
    if ((bspnum & NF_SUBSECTOR) != 0) {
        if (bspnum == -1) {
            R_Subsector(0)
        } else {
            R_Subsector(bspnum & (~NF_SUBSECTOR))
        }
        return
    }
    bsp = addr(nodes[bspnum])
    // Decide which side the view point is on.
    side = R_PointOnSide(viewx, viewy, bsp)
    // Recursively divide front space.
    R_RenderBSPNode(int(bsp.children[side]))
    // Possibly divide back space.
    if (R_CheckBBox(addr(bsp.bbox[side ^ 1][0])) != 0) {
        R_RenderBSPNode(int(bsp.children[side ^ 1]))
    }
}

// R_DrawColumnInCache
// Clip and draw a column
// from a patch into a cached post.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawColumnInCache(var patch : post_t?; var cache : uint8?; originy : int; cacheheight : int) {
    var count : int
    var position : int
    var source : uint8?
    while (patch.topdelta != 255) {
        source = reinterpret<uint8?>(patch) + 3
        count = int(patch.length)
        position = originy + int(patch.topdelta)
        if (position < 0) {
            count += position
            position = 0
        }
        if (position + count > cacheheight) {
            count = cacheheight - position
        }
        if (count > 0) {
            crt::memcpy(reinterpret<void?>(cache + position), reinterpret<void?>(source), uint64(count))
        }
        patch = reinterpret<post_t?>(reinterpret<uint8?>(patch) + int(patch.length) + 4)
    }
}

// R_GenerateComposite
// Using the texture definition,
// the composite texture is created from the patches,
// and each column is cached.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GenerateComposite(texnum : int) {
    var _c_block : uint8?
    var texture : texture_s?
    var patch : texpatch_t?
    var realpatch : patch_t?
    var x : int
    var x1 : int
    var x2 : int
    var i : int
    var patchcol : post_t?
    var collump : int16?
    var colofs : uint16?
    texture = textures[texnum]
    _c_block = reinterpret<uint8?>(Z_Malloc(texturecompositesize[texnum], int(anon_28.PU_STATIC), reinterpret<void?>(addr(texturecomposite[texnum]))))
    collump = texturecolumnlump[texnum]
    colofs = texturecolumnofs[texnum]
    // Composite the columns together.
    patch = addr(texture.patches[0])
    i = 0
    patch = addr(texture.patches[0])
    while (i < int(texture.patchcount)) {
        realpatch = reinterpret<patch_t?>(W_CacheLumpNum(patch.patch, int(anon_28.PU_CACHE)))
        x1 = int(patch.originx)
        x2 = x1 + int(realpatch.width)
        if (x1 < 0) {
            x = 0
        } else {
            x = x1
        }
        if (x2 > int(texture.width)) {
            x2 = int(texture.width)
        }
        while (x < x2) {
            {
                // Column does not have multiple patches?
                if (int(collump[x]) >= 0) {
                    continue
                }
                patchcol = reinterpret<post_t?>(reinterpret<uint8?>(realpatch) + addr(realpatch.columnofs[0])[x - x1])
                R_DrawColumnInCache(patchcol, _c_block + int(colofs[x]), int(patch.originy), int(texture.height))
            } finally {
                x++
            }
        }
        i++
        patch++
    }
    // Now that the texture has been built in column cache,
    // it is purgable from zone memory.
    Z_ChangeTag2(reinterpret<void?>(_c_block), int(anon_28.PU_CACHE), cstr("/root/c2das/tests/manual/doomgeneric/upstream/doomgeneric/doomgeneric/r_data.c"),
            286)
}

// R_GenerateLookup
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GenerateLookup(texnum : int) {
    var texture : texture_s?
    // patchcount[texture->width]
    var patchcount : uint8?
    var patch : texpatch_t?
    var realpatch : patch_t?
    var x : int
    var x1 : int
    var x2 : int
    var i : int
    var collump : int16?
    var colofs : uint16?
    texture = textures[texnum]
    // Composited texture not created yet.
    texturecomposite[texnum] = null
    texturecompositesize[texnum] = 0
    collump = texturecolumnlump[texnum]
    colofs = texturecolumnofs[texnum]
    // Now count the number of columns
    // that are covered by more than one patch.
    // Fill in the lump / offset, so columns
    // with only a single patch are all done.
    patchcount = reinterpret<uint8?>(Z_Malloc(int(texture.width), int(anon_28.PU_STATIC), reinterpret<void?>(addr(patchcount))))
    crt::memset(reinterpret<void?>(patchcount), 0, uint64(texture.width))
    patch = addr(texture.patches[0])
    i = 0
    patch = addr(texture.patches[0])
    while (i < int(texture.patchcount)) {
        realpatch = reinterpret<patch_t?>(W_CacheLumpNum(patch.patch, int(anon_28.PU_CACHE)))
        x1 = int(patch.originx)
        x2 = x1 + int(realpatch.width)
        if (x1 < 0) {
            x = 0
        } else {
            x = x1
        }
        if (x2 > int(texture.width)) {
            x2 = int(texture.width)
        }
        while (x < x2) {
            patchcount[x] = uint8(uint(patchcount[x]) + 1)
            collump[x] = int16(patch.patch)
            colofs[x] = uint16(addr(realpatch.columnofs[0])[x - x1] + 3)
            x++
        }
        i++
        patch++
    }
    x = 0
    while (x < int(texture.width)) {
        if (patchcount[x] == 0) {
            fprintf(crt::c_stderr(), cstr("R_GenerateLookup: column without a patch (%s)\n"), addr(texture.name[0]))
            return
        }
        // I_Error ("R_GenerateLookup: column without a patch");
        if (int(patchcount[x]) > 1) {
            // Use the cached block.
            collump[x] = int16(-1)
            colofs[x] = uint16(texturecompositesize[texnum])
            if (texturecompositesize[texnum] > 65536 - int(texture.height)) {
                I_Error`va(cstr("R_GenerateLookup: texture %i is >64k"), (texnum,))
            }
            texturecompositesize[texnum] += int(texture.height)
        }
        x++
    }
    Z_Free(reinterpret<void?>(patchcount))
}

// R_GetColumn
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_GetColumn(tex : int; var col : int) : uint8? {
    var lump : int
    var ofs : int
    col &= texturewidthmask[tex]
    lump = int(texturecolumnlump[tex][col])
    ofs = int(texturecolumnofs[tex][col])
    if (lump > 0) {
        return reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_CACHE))) + ofs
    }
    if (texturecomposite[tex] == null) {
        R_GenerateComposite(tex)
    }
    return texturecomposite[tex] + ofs
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GenerateTextureHashTable {
    var rover : texture_s ??
    var key : int
    textures_hashtable = reinterpret<texture_s ??>(Z_Malloc(int(uint64(typeinfo sizeof(type<texture_s?>)) * uint64(numtextures)), int(anon_28.PU_STATIC), null))
    crt::memset(reinterpret<void?>(textures_hashtable), 0, uint64(typeinfo sizeof(type<texture_s?>)) * uint64(numtextures))
    // Add all textures to hash table
    for (i in range(numtextures)) {
        // Store index
        textures[i].index = i
        // Vanilla Doom does a linear search of the texures array
        // and stops at the first entry it finds. If there are two
        // entries with the same name, the first one in the array
        // wins. The new entry must therefore be added at the end
        // of the hash chain, so that earlier entries win.
        key = int(W_LumpNameHash(addr(textures[i].name[0])) % uint(numtextures))
        rover = addr(textures_hashtable[key])
        while (*rover != null) {
            rover = addr((*rover).next)
        }
        // Hook into hash table
        textures[i].next = null
        *rover = textures[i]
    }
}

// R_InitTextures
// Initializes the texture list
// with the textures from the world map.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitTextures {
    var mtexture : maptexture_t?
    var texture : texture_s?
    var mpatch : mappatch_t?
    var patch : texpatch_t?
    var i : int
    var j : int
    var maptex : int?
    var maptex2 : int?
    var maptex1 : int?
    var name : uint8[9]
    var names : uint8?
    var name_p : uint8?
    var patchlookup : int?
    var totalwidth : int
    var nummappatches : int
    var offset : int
    var maxoff : int
    var maxoff2 : int
    var numtextures1 : int
    var numtextures2 : int
    var directory : int?
    var temp1 : int
    var temp2 : int
    var temp3 : int
    // Load the patch names from pnames.lmp.
    name[8] = 0u8
    names = reinterpret<uint8?>(W_CacheLumpName(cstr("PNAMES"), int(anon_28.PU_STATIC)))
    nummappatches = *reinterpret<int?>(names)
    name_p = names + 4
    patchlookup = reinterpret<int?>(Z_Malloc(int(uint64(nummappatches) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    for (i1 in range(nummappatches)) {
        M_StringCopy(addr(name[0]), name_p + i1 * 8, uint64(typeinfo sizeof(type<uint8[9]>)))
        patchlookup[i1] = W_CheckNumForName(addr(name[0]))
    }
    W_ReleaseLumpName(cstr("PNAMES"))
    // Load the map texture definitions from textures.lmp.
    // The data is contained in one or two lumps,
    // TEXTURE1 for shareware, plus TEXTURE2 for commercial.
    maptex1 = reinterpret<int?>(W_CacheLumpName(cstr("TEXTURE1"), int(anon_28.PU_STATIC)))
    maptex = maptex1
    numtextures1 = *maptex
    maxoff = W_LumpLength(uint(W_GetNumForName(cstr("TEXTURE1"))))
    directory = maptex + 1
    if (W_CheckNumForName(cstr("TEXTURE2")) != -1) {
        maptex2 = reinterpret<int?>(W_CacheLumpName(cstr("TEXTURE2"), int(anon_28.PU_STATIC)))
        numtextures2 = *maptex2
        maxoff2 = W_LumpLength(uint(W_GetNumForName(cstr("TEXTURE2"))))
    } else {
        maptex2 = null
        numtextures2 = 0
        maxoff2 = 0
    }
    numtextures = numtextures1 + numtextures2
    textures = reinterpret<texture_s ??>(Z_Malloc(int(uint64(numtextures) * uint64(typeinfo sizeof(type<texture_s?>))), int(anon_28.PU_STATIC), null))
    texturecolumnlump = reinterpret<int16 ??>(Z_Malloc(int(uint64(numtextures) * uint64(typeinfo sizeof(type<int16?>))), int(anon_28.PU_STATIC), null))
    texturecolumnofs = reinterpret<uint16 ??>(Z_Malloc(int(uint64(numtextures) * uint64(typeinfo sizeof(type<uint16?>))), int(anon_28.PU_STATIC), null))
    texturecomposite = reinterpret<uint8 ??>(Z_Malloc(int(uint64(numtextures) * uint64(typeinfo sizeof(type<uint8?>))), int(anon_28.PU_STATIC), null))
    texturecompositesize = reinterpret<int?>(Z_Malloc(int(uint64(numtextures) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    texturewidthmask = reinterpret<int?>(Z_Malloc(int(uint64(numtextures) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    textureheight = reinterpret<int?>(Z_Malloc(int(uint64(numtextures) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    totalwidth = 0
    // Really complex printing shit...
    // P_???????
    temp1 = W_GetNumForName(cstr("S_START"))
    temp2 = W_GetNumForName(cstr("S_END")) - 1
    temp3 = ((temp2 - temp1 + 63) / 64) + ((numtextures + 63) / 64)
    // If stdout is a real console, use the classic vanilla "filling
    // up the box" effect, which uses backspace to "step back" inside
    // the box. If stdout is a file, don't draw the box.
    if (I_ConsoleStdout() != 0) {
        fprintf(crt::c_stderr(), cstr("["))
        for (i1 in range(temp3 + 9)) {
            fprintf(crt::c_stderr(), cstr(" "))
        }
        fprintf(crt::c_stderr(), cstr("]"))
        for (i1 in range(temp3 + 10)) {
            fprintf(crt::c_stderr(), cstr("\b"))
        }
    }
    i = 0
    while (i < numtextures) {
        if ((i & 63) == 0) {
            fprintf(crt::c_stderr(), cstr("."))
        }
        if (i == numtextures1) {
            // Start looking in second texture file.
            maptex = maptex2
            maxoff = maxoff2
            directory = maptex + 1
        }
        offset = *directory
        if (offset > maxoff) {
            I_Error`va(cstr("R_InitTextures: bad texture directory"), VaNone())
        }
        mtexture = reinterpret<maptexture_t?>(reinterpret<uint8?>(maptex) + offset)
        textures[i] = reinterpret<texture_s?>(Z_Malloc(int(uint64(typeinfo sizeof(type<texture_s>)) + uint64(typeinfo sizeof(type<texpatch_t>)) *
                    uint64(int(mtexture.patchcount) - 1)),
                int(anon_28.PU_STATIC), null))
        texture = textures[i]
        texture.width = mtexture.width
        texture.height = mtexture.height
        texture.patchcount = mtexture.patchcount
        crt::memcpy(reinterpret<void?>(addr(texture.name[0])), reinterpret<void?>(addr(mtexture.name[0])), uint64(typeinfo sizeof(type<uint8[8]>)))
        mpatch = addr(addr(mtexture.patches[0])[0])
        patch = addr(addr(texture.patches[0])[0])
        j = 0
        while (j < int(texture.patchcount)) {
            patch.originx = mpatch.originx
            patch.originy = mpatch.originy
            patch.patch = patchlookup[int(mpatch.patch)]
            if (patch.patch == -1) {
                I_Error`va(cstr("R_InitTextures: Missing patch in texture %s"), (addr(texture.name[0]),))
            }
            j++
            mpatch++
            patch++
        }
        texturecolumnlump[i] = reinterpret<int16?>(Z_Malloc(int(uint64(texture.width) * uint64(typeinfo sizeof(type<int16>))), int(anon_28.PU_STATIC), null))
        texturecolumnofs[i] = reinterpret<uint16?>(Z_Malloc(int(uint64(texture.width) * uint64(typeinfo sizeof(type<uint16>))), int(anon_28.PU_STATIC), null))
        j = 1
        while (j * 2 <= int(texture.width)) {
            j <<= 1
        }
        texturewidthmask[i] = j - 1
        textureheight[i] = int(texture.height) << FRACBITS
        totalwidth += int(texture.width)
        i++
        directory++
    }
    Z_Free(reinterpret<void?>(patchlookup))
    W_ReleaseLumpName(cstr("TEXTURE1"))
    if (maptex2 != null) {
        W_ReleaseLumpName(cstr("TEXTURE2"))
    }
    // Precalculate whatever possible.
    i = 0
    while (i < numtextures) {
        R_GenerateLookup(i)
        i++
    }
    // Create translation table for global animation.
    texturetranslation = reinterpret<int?>(Z_Malloc(int(uint64(numtextures + 1) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    for (i1 in range(numtextures)) {
        texturetranslation[i1] = i1
    }
    doom_all__GenerateTextureHashTable()
}

// R_InitFlats
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitFlats {
    firstflat = W_GetNumForName(cstr("F_START")) + 1
    lastflat = W_GetNumForName(cstr("F_END")) - 1
    numflats = lastflat - firstflat + 1
    // Create translation table for global animation.
    flattranslation = reinterpret<int?>(Z_Malloc(int(uint64(numflats + 1) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    for (i in range(numflats)) {
        flattranslation[i] = i
    }
}

// R_InitSpriteLumps
// Finds the width and hoffset of all sprites in the wad,
// so the sprite does not need to be cached completely
// just for having the header info ready during rendering.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitSpriteLumps {
    var i : int
    var patch : patch_t?
    firstspritelump = W_GetNumForName(cstr("S_START")) + 1
    lastspritelump = W_GetNumForName(cstr("S_END")) - 1
    numspritelumps = lastspritelump - firstspritelump + 1
    spritewidth = reinterpret<int?>(Z_Malloc(int(uint64(numspritelumps) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    spriteoffset = reinterpret<int?>(Z_Malloc(int(uint64(numspritelumps) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    spritetopoffset = reinterpret<int?>(Z_Malloc(int(uint64(numspritelumps) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    i = 0
    while (i < numspritelumps) {
        if ((i & 63) == 0) {
            fprintf(crt::c_stderr(), cstr("."))
        }
        patch = reinterpret<patch_t?>(W_CacheLumpNum(firstspritelump + i, int(anon_28.PU_CACHE)))
        spritewidth[i] = int(patch.width) << FRACBITS
        spriteoffset[i] = int(patch.leftoffset) << FRACBITS
        spritetopoffset[i] = int(patch.topoffset) << FRACBITS
        i++
    }
}

// R_InitColormaps
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitColormaps {
    var lump : int
    // Load in the light tables,
    // 256 byte align tables.
    lump = W_GetNumForName(cstr("COLORMAP"))
    colormaps = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
}

// R_InitData
// Locates all the lumps
// that will be used by all views
// Must be called after W_Init.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitData {
    R_InitTextures()
    fprintf(crt::c_stderr(), cstr("."))
    R_InitFlats()
    fprintf(crt::c_stderr(), cstr("."))
    R_InitSpriteLumps()
    fprintf(crt::c_stderr(), cstr("."))
    R_InitColormaps()
}

// R_FlatNumForName
// Retrieval, get a flat number for a flat name.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_FlatNumForName(var name : uint8?) : int {
    var i : int
    var namet : uint8[9]
    i = W_CheckNumForName(name)
    if (i == -1) {
        namet[8] = 0u8
        crt::memcpy(reinterpret<void?>(addr(namet[0])), reinterpret<void?>(name), 8ul)
        I_Error`va(cstr("R_FlatNumForName: %s not found"), (addr(namet[0]),))
    }
    return i - firstflat
}

// R_CheckTextureNumForName
// Check whether texture is available.
// Filter out NoTexture indicator.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_CheckTextureNumForName(var name : uint8?) : int {
    var texture : texture_s?
    var key : int
    // "NoTexture" marker.
    if (name[0] == '-') {
        return 0
    }
    key = int(W_LumpNameHash(name) % uint(numtextures))
    texture = textures_hashtable[key]
    while (texture != null) {
        if (crt::strncasecmp(addr(texture.name[0]), name, 8ul) == 0) {
            return texture.index
        }
        texture = texture.next
    }
    return -1
}

// R_TextureNumForName
// Calls R_CheckTextureNumForName,
// aborts with error message.
[unsafe_deref, hint(unsafe_range_check)]
def R_TextureNumForName(var name : uint8?) : int {
    var i : int
    i = R_CheckTextureNumForName(name)
    if (i == -1) {
        I_Error`va(cstr("R_TextureNumForName: %s not found"), (name,))
    }
    return i
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_PrecacheLevel {
    var flatpresent : uint8?
    var texturepresent : uint8?
    var spritepresent : uint8?
    var i : int
    var j : int
    var k : int
    var lump : int
    var texture : texture_s?
    var th : thinker_s?
    var sf : spriteframe_t?
    if (demoplayback != 0) {
        return
    }
    // Precache flats.
    flatpresent = reinterpret<uint8?>(Z_Malloc(numflats, int(anon_28.PU_STATIC), null))
    crt::memset(reinterpret<void?>(flatpresent), 0, uint64(numflats))
    for (i1 in range(numsectors)) {
        flatpresent[int(sectors[i1].floorpic)] = 1u8
        flatpresent[int(sectors[i1].ceilingpic)] = 1u8
    }
    flatmemory = 0
    i = 0
    while (i < numflats) {
        if (flatpresent[i] != 0) {
            lump = firstflat + i
            flatmemory += lumpinfo[lump].size
            W_CacheLumpNum(lump, int(anon_28.PU_CACHE))
        }
        i++
    }
    Z_Free(reinterpret<void?>(flatpresent))
    // Precache textures.
    texturepresent = reinterpret<uint8?>(Z_Malloc(numtextures, int(anon_28.PU_STATIC), null))
    crt::memset(reinterpret<void?>(texturepresent), 0, uint64(numtextures))
    for (i1 in range(numsides)) {
        texturepresent[int(sides[i1].toptexture)] = 1u8
        texturepresent[int(sides[i1].midtexture)] = 1u8
        texturepresent[int(sides[i1].bottomtexture)] = 1u8
    }
    // Sky texture is always present.
    // Note that F_SKY1 is the name used to
    // indicate a sky floor/ceiling as a flat,
    // while the sky texture is stored like
    // a wall texture, with an episode dependend
    // name.
    texturepresent[skytexture] = 1u8
    texturememory = 0
    i = 0
    while (i < numtextures) {
        {
            if (texturepresent[i] == 0) {
                continue
            }
            texture = textures[i]
            j = 0
            while (j < int(texture.patchcount)) {
                lump = addr(texture.patches[0])[j].patch
                texturememory += lumpinfo[lump].size
                W_CacheLumpNum(lump, int(anon_28.PU_CACHE))
                j++
            }
        } finally {
            i++
        }
    }
    Z_Free(reinterpret<void?>(texturepresent))
    // Precache sprites.
    spritepresent = reinterpret<uint8?>(Z_Malloc(numsprites, int(anon_28.PU_STATIC), null))
    crt::memset(reinterpret<void?>(spritepresent), 0, uint64(numsprites))
    th = thinkercap.next
    while (th != addr(thinkercap)) {
        if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
            spritepresent[int(reinterpret<mobj_s?>(th).sprite)] = 1u8
        }
        th = th.next
    }
    spritememory = 0
    i = 0
    while (i < numsprites) {
        {
            if (spritepresent[i] == 0) {
                continue
            }
            j = 0
            while (j < sprites[i].numframes) {
                sf = addr(sprites[i].spriteframes[j])
                k = 0
                while (k < 8) {
                    lump = firstspritelump + int(sf.lump[k])
                    spritememory += lumpinfo[lump].size
                    W_CacheLumpNum(lump, int(anon_28.PU_CACHE))
                    k++
                }
                j++
            }
        } finally {
            i++
        }
    }
    Z_Free(reinterpret<void?>(spritepresent))
}

// A column is a vertical slice/span from a wall texture that,
// given the DOOM style restrictions on the view orientation,
// will always have constant z depth.
// Thus a special case loop for very fast rendering can
// be used. It has also been used with Wolfenstein 3D.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawColumn {
    var count : int
    var dest : uint8?
    var frac : int
    var fracstep : int
    count = dc_yh - dc_yl
    // Zero length, column does not exceed a pixel.
    if (count < 0) {
        return
    }
    if (uint(dc_x) >= uint(SCREENWIDTH) || dc_yl < 0 || dc_yh >= SCREENHEIGHT) {
        I_Error`va(cstr("R_DrawColumn: %i to %i at %i"), (dc_yl, dc_yh, dc_x))
    }
    // Framebuffer destination address.
    // Use ylookup LUT to avoid multiply with ScreenWidth.
    // Use columnofs LUT for subwindows?
    dest = ylookup[dc_yl] + columnofs[dc_x]
    // Determine scaling,
    // which is the only mapping to be done.
    fracstep = dc_iscale
    frac = dc_texturemid + (dc_yl - centery) * fracstep
    // Inner loop that does the actual texture mapping,
    // e.g. a DDA-lile scaling.
    // This is as fast as it gets.
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Re-map color indices from wall texture column
        // using a lighting/special effects LUT.
        *dest = dc_colormap[int(dc_source[(frac >> FRACBITS) & 127])]
        dest += SCREENWIDTH
        frac += fracstep
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawColumnLow {
    var count : int
    var dest : uint8?
    var dest2 : uint8?
    var frac : int
    var fracstep : int
    var x : int
    count = dc_yh - dc_yl
    // Zero length.
    if (count < 0) {
        return
    }
    if (uint(dc_x) >= uint(SCREENWIDTH) || dc_yl < 0 || dc_yh >= SCREENHEIGHT) {
        I_Error`va(cstr("R_DrawColumn: %i to %i at %i"), (dc_yl, dc_yh, dc_x))
    }
    // dccount++;
    // Blocky mode, need to multiply by 2.
    x = dc_x << 1
    dest = ylookup[dc_yl] + columnofs[x]
    dest2 = ylookup[dc_yl] + columnofs[x + 1]
    fracstep = dc_iscale
    frac = dc_texturemid + (dc_yl - centery) * fracstep
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Hack. Does not work corretly.
        *dest = dc_colormap[int(dc_source[(frac >> FRACBITS) & 127])]
        *dest2 = *dest
        dest += SCREENWIDTH
        dest2 += SCREENWIDTH
        frac += fracstep
    }
}

// Framebuffer postprocessing.
// Creates a fuzzy image by copying pixels
// from adjacent ones to left and right.
// Used with an all black colormap, this
// could create the SHADOW effect,
// i.e. spectres and invisible players.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawFuzzColumn {
    var count : int
    var dest : uint8?
    var frac : int
    var fracstep : int
    // Adjust borders. Low...
    if (dc_yl == 0) {
        dc_yl = 1
    }
    // .. and high.
    if (dc_yh == viewheight - 1) {
        dc_yh = viewheight - 2
    }
    count = dc_yh - dc_yl
    // Zero length.
    if (count < 0) {
        return
    }
    if (uint(dc_x) >= uint(SCREENWIDTH) || dc_yl < 0 || dc_yh >= SCREENHEIGHT) {
        I_Error`va(cstr("R_DrawFuzzColumn: %i to %i at %i"), (dc_yl, dc_yh, dc_x))
    }
    dest = ylookup[dc_yl] + columnofs[dc_x]
    // Looks familiar.
    fracstep = dc_iscale
    frac = dc_texturemid + (dc_yl - centery) * fracstep
    // Looks like an attempt at dithering,
    // using the colormap #6 (of 0-31, a bit
    // brighter than average).
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Lookup framebuffer, and retrieve
        // a pixel that is either one column
        // left or right of the current one.
        // Add index from colormap to index.
        *dest = colormaps[6 * 256 + int(dest[fuzzoffset[fuzzpos]])]
        // Clamp table lookup index.
        fuzzpos++
        if (fuzzpos == FUZZTABLE) {
            fuzzpos = 0
        }
        dest += SCREENWIDTH
        frac += fracstep
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawFuzzColumnLow {
    var count : int
    var dest : uint8?
    var dest2 : uint8?
    var frac : int
    var fracstep : int
    var x : int
    // Adjust borders. Low...
    if (dc_yl == 0) {
        dc_yl = 1
    }
    // .. and high.
    if (dc_yh == viewheight - 1) {
        dc_yh = viewheight - 2
    }
    count = dc_yh - dc_yl
    // Zero length.
    if (count < 0) {
        return
    }
    // low detail mode, need to multiply by 2
    x = dc_x << 1
    if (uint(x) >= uint(SCREENWIDTH) || dc_yl < 0 || dc_yh >= SCREENHEIGHT) {
        I_Error`va(cstr("R_DrawFuzzColumn: %i to %i at %i"), (dc_yl, dc_yh, dc_x))
    }
    dest = ylookup[dc_yl] + columnofs[x]
    dest2 = ylookup[dc_yl] + columnofs[x + 1]
    // Looks familiar.
    fracstep = dc_iscale
    frac = dc_texturemid + (dc_yl - centery) * fracstep
    // Looks like an attempt at dithering,
    // using the colormap #6 (of 0-31, a bit
    // brighter than average).
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Lookup framebuffer, and retrieve
        // a pixel that is either one column
        // left or right of the current one.
        // Add index from colormap to index.
        *dest = colormaps[6 * 256 + int(dest[fuzzoffset[fuzzpos]])]
        *dest2 = colormaps[6 * 256 + int(dest2[fuzzoffset[fuzzpos]])]
        // Clamp table lookup index.
        fuzzpos++
        if (fuzzpos == FUZZTABLE) {
            fuzzpos = 0
        }
        dest += SCREENWIDTH
        dest2 += SCREENWIDTH
        frac += fracstep
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawTranslatedColumn {
    var count : int
    var dest : uint8?
    var frac : int
    var fracstep : int
    count = dc_yh - dc_yl
    if (count < 0) {
        return
    }
    if (uint(dc_x) >= uint(SCREENWIDTH) || dc_yl < 0 || dc_yh >= SCREENHEIGHT) {
        I_Error`va(cstr("R_DrawColumn: %i to %i at %i"), (dc_yl, dc_yh, dc_x))
    }
    dest = ylookup[dc_yl] + columnofs[dc_x]
    // Looks familiar.
    fracstep = dc_iscale
    frac = dc_texturemid + (dc_yl - centery) * fracstep
    // Here we do an additional index re-mapping.
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Translation tables are used
        // to map certain colorramps to other ones,
        // used with PLAY sprites.
        // Thus the "green" ramp of the player 0 sprite
        // is mapped to gray, red, black/indigo.
        *dest = dc_colormap[int(dc_translation[int(dc_source[frac >> FRACBITS])])]
        dest += SCREENWIDTH
        frac += fracstep
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawTranslatedColumnLow {
    var count : int
    var dest : uint8?
    var dest2 : uint8?
    var frac : int
    var fracstep : int
    var x : int
    count = dc_yh - dc_yl
    if (count < 0) {
        return
    }
    // low detail, need to scale by 2
    x = dc_x << 1
    if (uint(x) >= uint(SCREENWIDTH) || dc_yl < 0 || dc_yh >= SCREENHEIGHT) {
        I_Error`va(cstr("R_DrawColumn: %i to %i at %i"), (dc_yl, dc_yh, x))
    }
    dest = ylookup[dc_yl] + columnofs[x]
    dest2 = ylookup[dc_yl] + columnofs[x + 1]
    // Looks familiar.
    fracstep = dc_iscale
    frac = dc_texturemid + (dc_yl - centery) * fracstep
    // Here we do an additional index re-mapping.
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Translation tables are used
        // to map certain colorramps to other ones,
        // used with PLAY sprites.
        // Thus the "green" ramp of the player 0 sprite
        // is mapped to gray, red, black/indigo.
        *dest = dc_colormap[int(dc_translation[int(dc_source[frac >> FRACBITS])])]
        *dest2 = dc_colormap[int(dc_translation[int(dc_source[frac >> FRACBITS])])]
        dest += SCREENWIDTH
        dest2 += SCREENWIDTH
        frac += fracstep
    }
}

// R_InitTranslationTables
// Creates the translation tables to map
// the green color ramp to gray, brown, red.
// Assumes a given structure of the PLAYPAL.
// Could be read from a lump instead.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitTranslationTables {
    translationtables = reinterpret<uint8?>(Z_Malloc(256 * 3, int(anon_28.PU_STATIC), null))
    // translate just the 16 green colors
    for (i in range(256)) {
        if (i >= 112 && i <= 127) {
            // map green ramp to gray, brown, red
            translationtables[i] = uint8(96 + (i & 15))
            translationtables[i + 256] = uint8(64 + (i & 15))
            translationtables[i + 512] = uint8(32 + (i & 15))
        } else {
            // Keep all other colors as is.
            translationtables[i + 512] = uint8(i)
            translationtables[i + 256] = translationtables[i + 512]
            translationtables[i] = translationtables[i + 256]
        }
    }
}

// Draws the actual span.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawSpan {
    var position : uint
    var step : uint
    var dest : uint8?
    var count : int
    var spot : int
    var xtemp : uint
    var ytemp : uint
    if (ds_x2 < ds_x1 || ds_x1 < 0 || ds_x2 >= SCREENWIDTH || uint(ds_y) > uint(SCREENHEIGHT)) {
        I_Error`va(cstr("R_DrawSpan: %i to %i at %i"), (ds_x1, ds_x2, ds_y))
    }
    // dscount++;
    // Pack position and step variables into a single 32-bit integer,
    // with x in the top 16 bits and y in the bottom 16 bits. For
    // each 16-bit part, the top 6 bits are the integer part and the
    // bottom 10 bits are the fractional part of the pixel position.
    position = (uint(ds_xfrac << 10) & 4294901760u) | uint((ds_yfrac >> 6) & 65535)
    step = (uint(ds_xstep << 10) & 4294901760u) | uint((ds_ystep >> 6) & 65535)
    dest = ylookup[ds_y] + columnofs[ds_x1]
    // We do not check for zero spans here?
    count = ds_x2 - ds_x1
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Calculate current texture index in u,v.
        ytemp = (position >> 4u) & 4032u
        xtemp = position >> 26u
        spot = int(xtemp | ytemp)
        // Lookup pixel from flat texture tile,
        // re-index using light/colormap.
        var _t1 = dest
        dest++
        *_t1 = ds_colormap[int(ds_source[spot])]
        position += step
    }
}

// Again..
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawSpanLow {
    var position : uint
    var step : uint
    var xtemp : uint
    var ytemp : uint
    var dest : uint8?
    var count : int
    var spot : int
    if (ds_x2 < ds_x1 || ds_x1 < 0 || ds_x2 >= SCREENWIDTH || uint(ds_y) > uint(SCREENHEIGHT)) {
        I_Error`va(cstr("R_DrawSpan: %i to %i at %i"), (ds_x1, ds_x2, ds_y))
    }
    // dscount++;
    position = (uint(ds_xfrac << 10) & 4294901760u) | uint((ds_yfrac >> 6) & 65535)
    step = (uint(ds_xstep << 10) & 4294901760u) | uint((ds_ystep >> 6) & 65535)
    count = ds_x2 - ds_x1
    // Blocky mode, need to multiply by 2.
    ds_x1 <<= 1
    ds_x2 <<= 1
    dest = ylookup[ds_y] + columnofs[ds_x1]
    for (_t0 in urange64(uint64(uint(count)) + 1ul)) {
        // Calculate current texture index in u,v.
        ytemp = (position >> 4u) & 4032u
        xtemp = position >> 26u
        spot = int(xtemp | ytemp)
        // Lowres/blocky mode does it twice,
        // while scale is adjusted appropriately.
        var _t1 = dest
        dest++
        *_t1 = ds_colormap[int(ds_source[spot])]
        var _t2 = dest
        dest++
        *_t2 = ds_colormap[int(ds_source[spot])]
        position += step
    }
}

// R_InitBuffer
// Creats lookup tables that avoid
// multiplies and other hazzles
// for getting the framebuffer address
// of a pixel to draw.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitBuffer(width : int; height : int) {
    // Handle resize,
    // e.g. smaller view windows
    // with border and/or status bar.
    viewwindowx = (SCREENWIDTH - width) >> 1
    // Column offset. For windows.
    for (i in range(width)) {
        columnofs[i] = viewwindowx + i
    }
    // Samw with base row offset.
    if (width == SCREENWIDTH) {
        viewwindowy = 0
    } else {
        viewwindowy = (SCREENHEIGHT - SBARHEIGHT - height) >> 1
    }
    // Preclaculate all row offsets.
    for (i in range(height)) {
        ylookup[i] = I_VideoBuffer + (i + viewwindowy) * SCREENWIDTH
    }
}

// R_FillBackScreen
// Fills the back screen with a pattern
// for variable screen sizes
// Also draws a beveled edge.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_FillBackScreen {
    var src : uint8?
    var dest : uint8?
    var x : int
    var y : int
    var patch : patch_t?
    // DOOM border patch.
    var name1 : uint8? = cstr("FLOOR7_2")
    // DOOM II border patch.
    var name2 : uint8? = cstr("GRNROCK")
    var name : uint8?
    // If we are running full screen, there is no need to do any of this,
    // and the background buffer can be freed if it was previously in use.
    if (scaledviewwidth == SCREENWIDTH) {
        if (doom_all__background_buffer != null) {
            Z_Free(reinterpret<void?>(doom_all__background_buffer))
            doom_all__background_buffer = null
        }
        return
    }
    // Allocate the background buffer if necessary
    if (doom_all__background_buffer == null) {
        doom_all__background_buffer = reinterpret<uint8?>(Z_Malloc(SCREENWIDTH * (SCREENHEIGHT - SBARHEIGHT), int(anon_28.PU_STATIC), null))
    }
    if (gamemode == GameMode_t.commercial) {
        name = name2
    } else {
        name = name1
    }
    src = reinterpret<uint8?>(W_CacheLumpName(name, int(anon_28.PU_CACHE)))
    dest = doom_all__background_buffer
    for (y1 in range(SCREENHEIGHT - SBARHEIGHT)) {
        x = 0
        while (x < SCREENWIDTH / 64) {
            crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(src + ((y1 & 63) << 6)), 64ul)
            dest += 64
            x++
        }
        if ((SCREENWIDTH & 63) != 0) {
            crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(src + ((y1 & 63) << 6)), uint64(SCREENWIDTH & 63))
            dest += SCREENWIDTH & 63
        }
    }
    // Draw screen and bezel; this is done to a separate screen buffer.
    V_UseBuffer(doom_all__background_buffer)
    patch = reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_t"), int(anon_28.PU_CACHE)))
    x = 0
    while (x < scaledviewwidth) {
        V_DrawPatch(viewwindowx + x, viewwindowy - 8, patch)
        x += 8
    }
    patch = reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_b"), int(anon_28.PU_CACHE)))
    x = 0
    while (x < scaledviewwidth) {
        V_DrawPatch(viewwindowx + x, viewwindowy + viewheight, patch)
        x += 8
    }
    patch = reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_l"), int(anon_28.PU_CACHE)))
    y = 0
    while (y < viewheight) {
        V_DrawPatch(viewwindowx - 8, viewwindowy + y, patch)
        y += 8
    }
    patch = reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_r"), int(anon_28.PU_CACHE)))
    y = 0
    while (y < viewheight) {
        V_DrawPatch(viewwindowx + scaledviewwidth, viewwindowy + y, patch)
        y += 8
    }
    // Draw beveled edge.
    V_DrawPatch(viewwindowx - 8, viewwindowy - 8, reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_tl"), int(anon_28.PU_CACHE))))
    V_DrawPatch(viewwindowx + scaledviewwidth, viewwindowy - 8, reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_tr"), int(anon_28.PU_CACHE))))
    V_DrawPatch(viewwindowx - 8, viewwindowy + viewheight, reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_bl"), int(anon_28.PU_CACHE))))
    V_DrawPatch(viewwindowx + scaledviewwidth, viewwindowy + viewheight, reinterpret<patch_t?>(W_CacheLumpName(cstr("brdr_br"), int(anon_28.PU_CACHE))))
    V_RestoreBuffer()
}

// Copy a screen buffer.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_VideoErase(ofs : uint; count : int) {
    // LFB copy.
    // This might not be a good idea if memcpy
    // is not optiomal, e.g. byte by byte on
    // a 32bit CPU, as GNU GCC/Linux libc did
    // at one point.
    if (doom_all__background_buffer != null) {
        crt::memcpy(reinterpret<void?>(I_VideoBuffer + ofs), reinterpret<void?>(doom_all__background_buffer + ofs), uint64(count))
    }
}

// R_DrawViewBorder
// Draws the border around the view
// for different size windows?
[unsafe_deref, hint(unsafe_range_check)]
def R_DrawViewBorder {
    var top : int
    var side : int
    var ofs : int
    if (scaledviewwidth == SCREENWIDTH) {
        return
    }
    top = ((SCREENHEIGHT - SBARHEIGHT) - viewheight) / 2
    side = (SCREENWIDTH - scaledviewwidth) / 2
    // copy top and one line of left side
    R_VideoErase(0u, top * SCREENWIDTH + side)
    // copy one line of right side and bottom
    ofs = (viewheight + top) * SCREENWIDTH - side
    R_VideoErase(uint(ofs), top * SCREENWIDTH + side)
    // copy sides using wraparound
    ofs = top * SCREENWIDTH + SCREENWIDTH - side
    side <<= 1
    for (i in range(1, viewheight)) {
        R_VideoErase(uint(ofs), side)
        ofs += SCREENWIDTH
    }
    // ?
    V_MarkRect(0, 0, SCREENWIDTH, SCREENHEIGHT - SBARHEIGHT)
}

// R_AddPointToBox
// Expand a given bbox
// so that it encloses a given point.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AddPointToBox(x : int; y : int; var box : int?) {
    if (x < box[int(anon_982.BOXLEFT)]) {
        box[int(anon_982.BOXLEFT)] = x
    }
    if (x > box[int(anon_982.BOXRIGHT)]) {
        box[int(anon_982.BOXRIGHT)] = x
    }
    if (y < box[int(anon_982.BOXBOTTOM)]) {
        box[int(anon_982.BOXBOTTOM)] = y
    }
    if (y > box[int(anon_982.BOXTOP)]) {
        box[int(anon_982.BOXTOP)] = y
    }
}

// R_PointOnSide
// Traverse BSP (sub) tree,
// check point against partition plane.
// Returns side 0 (front) or 1 (back).
[unsafe_deref, hint(unsafe_range_check)]
def R_PointOnSide(x : int; y : int; var node : node_t?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (node.dx == 0) {
        if (x <= node.x) {
            return int_of(node.dy > 0)
        }
        return int_of(node.dy < 0)
    }
    if (node.dy == 0) {
        if (y <= node.y) {
            return int_of(node.dx < 0)
        }
        return int_of(node.dx > 0)
    }
    dx = x - node.x
    dy = y - node.y
    // Try to quickly decide by looking at sign bits.
    if ((uint(node.dy ^ node.dx ^ dx ^ dy) & 2147483648u) != 0) {
        if ((uint(node.dy ^ dx) & 2147483648u) != 0) {
            // (left is negative)
            return 1
        }
        return 0
    }
    left = FixedMul(node.dy >> FRACBITS, dx)
    right = FixedMul(dy, node.dx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def R_PointOnSegSide(x : int; y : int; var line : seg_t?) : int {
    var lx : int
    var ly : int
    var ldx : int
    var ldy : int
    var dx : int
    var dy : int
    var left : int
    var right : int
    lx = line.v1.x
    ly = line.v1.y
    ldx = line.v2.x - lx
    ldy = line.v2.y - ly
    if (ldx == 0) {
        if (x <= lx) {
            return int_of(ldy > 0)
        }
        return int_of(ldy < 0)
    }
    if (ldy == 0) {
        if (y <= ly) {
            return int_of(ldx < 0)
        }
        return int_of(ldx > 0)
    }
    dx = x - lx
    dy = y - ly
    // Try to quickly decide by looking at sign bits.
    if ((uint(ldy ^ ldx ^ dx ^ dy) & 2147483648u) != 0) {
        if ((uint(ldy ^ dx) & 2147483648u) != 0) {
            // (left is negative)
            return 1
        }
        return 0
    }
    left = FixedMul(ldy >> FRACBITS, dx)
    right = FixedMul(dy, ldx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def R_PointToAngle(var x : int; var y : int) : uint {
    x -= viewx
    y -= viewy
    if ((x == 0) && (y == 0)) {
        return 0u
    }
    if (x >= 0) {
        // x >=0
        if (y >= 0) {
            // y>= 0
            if (x > y) {
                // octant 0
                return tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 1
                return uint(ANG90 - 1) - tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        } else {
            // y<0
            y = -y
            if (x > y) {
                // octant 8
                return -tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 7
                return ANG270 + tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        }
    } else {
        // x<0
        x = -x
        if (y >= 0) {
            // y>= 0
            if (x > y) {
                // octant 3
                return ANG180 - 1u - tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 2
                return uint(ANG90) + tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        } else {
            // y<0
            y = -y
            if (x > y) {
                // octant 4
                return ANG180 + tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 5
                return ANG270 - 1u - tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        }
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def R_PointToAngle2(x1 : int; y1 : int; x2 : int; y2 : int) : uint {
    viewx = x1
    viewy = y1
    return R_PointToAngle(x2, y2)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_PointToDist(x : int; y : int) : int {
    var angle : int
    var dx : int
    var dy : int
    var temp : int
    var dist : int
    var frac : int
    dx = crt::abs(x - viewx)
    dy = crt::abs(y - viewy)
    if (dy > dx) {
        temp = dx
        dx = dy
        dy = temp
    }
    // Fix crashes in udm1.wad
    if (dx != 0) {
        frac = FixedDiv(dy, dx)
    } else {
        frac = 0
    }
    angle = int((tantoangle[frac >> DBITS] + uint(ANG90)) >> uint(ANGLETOFINESHIFT))
    // use as cosine
    dist = FixedDiv(dx, finesine[angle])
    return dist
}

// R_InitPointToAngle
[unsafe_deref, hint(unsafe_range_check)]
def R_InitPointToAngle {
}

// R_ScaleFromGlobalAngle
// Returns the texture mapping scale
// for the current line (horizontal span)
// at the given angle.
// rw_distance must be calculated first.
[unsafe_deref, hint(unsafe_range_check)]
def R_ScaleFromGlobalAngle(visangle : uint) : int {
    var scale : int
    var anglea : uint
    var angleb : uint
    var sinea : int
    var sineb : int
    var num : int
    var den : int
    // UNUSED
    anglea = uint(ANG90) + (visangle - viewangle)
    angleb = uint(ANG90) + (visangle - rw_normalangle)
    // both sines are allways positive
    sinea = finesine[anglea >> uint(ANGLETOFINESHIFT)]
    sineb = finesine[angleb >> uint(ANGLETOFINESHIFT)]
    num = FixedMul(projection, sineb) << detailshift
    den = FixedMul(rw_distance, sinea)
    if (den > num >> 16) {
        scale = FixedDiv(num, den)
        if (scale > 64 * FRACUNIT) {
            scale = 64 * FRACUNIT
        } elif (scale < 256) {
            scale = 256
        }
    } else {
        scale = 64 * FRACUNIT
    }
    return scale
}

// R_InitTables
[unsafe_deref, hint(unsafe_range_check)]
def R_InitTables {
}

// R_InitTextureMapping
[unsafe_deref, hint(unsafe_range_check)]
def R_InitTextureMapping {
    var i : int
    var t : int
    var focallength : int
    // Use tangent table to generate viewangletox:
    // viewangletox will give the next greatest x
    // after the view angle.
    // Calc focallength
    // so FIELDOFVIEW angles covers SCREENWIDTH.
    focallength = FixedDiv(centerxfrac, finetangent[FINEANGLES / 4 + FIELDOFVIEW / 2])
    i = 0
    while (i < FINEANGLES / 2) {
        if (finetangent[i] > FRACUNIT * 2) {
            t = -1
        } elif (finetangent[i] < -FRACUNIT * 2) {
            t = viewwidth + 1
        } else {
            t = FixedMul(finetangent[i], focallength)
            t = (centerxfrac - t + FRACUNIT - 1) >> FRACBITS
            if (t < -1) {
                t = -1
            } elif (t > viewwidth + 1) {
                t = viewwidth + 1
            }
        }
        viewangletox[i] = t
        i++
    }
    // Scan viewangletox[] to generate xtoviewangle[]:
    // xtoviewangle will give the smallest view angle
    // that maps to x.
    for (x in range(viewwidth + 1)) {
        i = 0
        while (viewangletox[i] > x) {
            i++
        }
        xtoviewangle[x] = uint((i << ANGLETOFINESHIFT) - ANG90)
    }
    // Take out the fencepost cases from viewangletox.
    i = 0
    while (i < FINEANGLES / 2) {
        t = FixedMul(finetangent[i], focallength)
        t = centerx - t
        if (viewangletox[i] == -1) {
            viewangletox[i] = 0
        } elif (viewangletox[i] == viewwidth + 1) {
            viewangletox[i] = viewwidth
        }
        i++
    }
    clipangle = xtoviewangle[0]
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitLightTables {
    var level : int
    var startmap : int
    var scale : int
    // Calculate the light levels to use
    // for each level / distance combination.
    for (i in range(LIGHTLEVELS)) {
        startmap = ((LIGHTLEVELS - 1 - i) * 2) * NUMCOLORMAPS / LIGHTLEVELS
        for (j in range(MAXLIGHTZ)) {
            scale = FixedDiv(SCREENWIDTH / 2 * FRACUNIT, (j + 1) << LIGHTZSHIFT)
            scale >>= LIGHTSCALESHIFT
            level = startmap - scale / DISTMAP
            if (level < 0) {
                level = 0
            }
            if (level >= NUMCOLORMAPS) {
                level = NUMCOLORMAPS - 1
            }
            zlight[i][j] = colormaps + level * 256
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def R_SetViewSize(blocks : int; detail : int) {
    setsizeneeded = 1u
    setblocks = blocks
    setdetail = detail
}

// R_ExecuteSetViewSize
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ExecuteSetViewSize {
    var cosadj : int
    var dy : int
    var level : int
    var startmap : int
    setsizeneeded = 0u
    if (setblocks == 11) {
        scaledviewwidth = SCREENWIDTH
        viewheight = SCREENHEIGHT
    } else {
        scaledviewwidth = setblocks * 32
        viewheight = (setblocks * 168 / 10) & ~7
    }
    detailshift = setdetail
    viewwidth = scaledviewwidth >> detailshift
    centery = viewheight / 2
    centerx = viewwidth / 2
    centerxfrac = centerx << FRACBITS
    centeryfrac = centery << FRACBITS
    projection = centerxfrac
    if (detailshift == 0) {
        basecolfunc = @@R_DrawColumn
        colfunc = basecolfunc
        fuzzcolfunc = @@R_DrawFuzzColumn
        transcolfunc = @@R_DrawTranslatedColumn
        spanfunc = @@R_DrawSpan
    } else {
        basecolfunc = @@R_DrawColumnLow
        colfunc = basecolfunc
        fuzzcolfunc = @@R_DrawFuzzColumnLow
        transcolfunc = @@R_DrawTranslatedColumnLow
        spanfunc = @@R_DrawSpanLow
    }
    R_InitBuffer(scaledviewwidth, viewheight)
    R_InitTextureMapping()
    // psprite scales
    pspritescale = FRACUNIT * viewwidth / SCREENWIDTH
    pspriteiscale = FRACUNIT * SCREENWIDTH / viewwidth
    // thing clipping
    for (i in range(viewwidth)) {
        screenheightarray[i] = int16(viewheight)
    }
    // planes
    for (i in range(viewheight)) {
        dy = ((i - viewheight / 2) << FRACBITS) + FRACUNIT / 2
        dy = crt::abs(dy)
        yslope[i] = FixedDiv((viewwidth << detailshift) / 2 * FRACUNIT, dy)
    }
    for (i in range(viewwidth)) {
        cosadj = crt::abs(finecosine[xtoviewangle[i] >> uint(ANGLETOFINESHIFT)])
        distscale[i] = FixedDiv(FRACUNIT, cosadj)
    }
    // Calculate the light levels to use
    // for each level / scale combination.
    for (i in range(LIGHTLEVELS)) {
        startmap = ((LIGHTLEVELS - 1 - i) * 2) * NUMCOLORMAPS / LIGHTLEVELS
        for (j in range(MAXLIGHTSCALE)) {
            level = startmap - j * SCREENWIDTH / (viewwidth << detailshift) / DISTMAP
            if (level < 0) {
                level = 0
            }
            if (level >= NUMCOLORMAPS) {
                level = NUMCOLORMAPS - 1
            }
            scalelight[i][j] = colormaps + level * 256
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_Init {
    R_InitData()
    fprintf(crt::c_stderr(), cstr("."))
    R_InitPointToAngle()
    fprintf(crt::c_stderr(), cstr("."))
    R_InitTables()
    // viewwidth / viewheight / detailLevel are set by the defaults
    fprintf(crt::c_stderr(), cstr("."))
    R_SetViewSize(screenblocks, detailLevel)
    R_InitPlanes()
    fprintf(crt::c_stderr(), cstr("."))
    R_InitLightTables()
    fprintf(crt::c_stderr(), cstr("."))
    R_InitSkyMap()
    R_InitTranslationTables()
    fprintf(crt::c_stderr(), cstr("."))
    framecount = 0
}

// R_PointInSubsector
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_PointInSubsector(x : int; y : int) : subsector_s? {
    var node : node_t?
    var side : int
    var nodenum : int
    // single subsector is a special case
    if (numnodes == 0) {
        return subsectors
    }
    nodenum = numnodes - 1
    while ((nodenum & NF_SUBSECTOR) == 0) {
        node = addr(nodes[nodenum])
        side = R_PointOnSide(x, y, node)
        nodenum = int(node.children[side])
    }
    return addr(subsectors[nodenum & ~NF_SUBSECTOR])
}

// R_SetupFrame
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_SetupFrame(var player : player_s?) {
    viewplayer = player
    viewx = player.mo.x
    viewy = player.mo.y
    viewangle = player.mo.angle + uint(viewangleoffset)
    extralight = player.extralight
    viewz = player.viewz
    viewsin = finesine[viewangle >> uint(ANGLETOFINESHIFT)]
    viewcos = finecosine[viewangle >> uint(ANGLETOFINESHIFT)]
    sscount = 0
    if (player.fixedcolormap != 0) {
        fixedcolormap = colormaps + uint64(player.fixedcolormap * 256) * uint64(typeinfo sizeof(type<uint8>))
        walllights = addr(scalelightfixed[0])
        for (i in range(MAXLIGHTSCALE)) {
            scalelightfixed[i] = fixedcolormap
        }
    } else {
        fixedcolormap = null
    }
    framecount++
    validcount++
}

// R_RenderView
[unsafe_deref, hint(unsafe_range_check)]
def R_RenderPlayerView(var player : player_s?) {
    R_SetupFrame(player)
    // Clear buffers.
    R_ClearClipSegs()
    R_ClearDrawSegs()
    R_ClearPlanes()
    R_ClearSprites()
    // check for new console commands.
    NetUpdate()
    // The head node is the last node output.
    R_RenderBSPNode(numnodes - 1)
    // Check for new console commands.
    NetUpdate()
    R_DrawPlanes()
    // Check for new console commands.
    NetUpdate()
    R_DrawMasked()
    // Check for new console commands.
    NetUpdate()
}

// R_InitPlanes
// Only at game startup.
[unsafe_deref, hint(unsafe_range_check)]
def R_InitPlanes {
}

// R_MapPlane
// Uses global vars:
// planeheight
// ds_source
// basexscale
// baseyscale
// viewx
// viewy
// BASIC PRIMITIVE
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_MapPlane(y : int; x1 : int; x2 : int) {
    var angle : uint
    var distance : int
    var length : int
    var index : uint
    if (x2 < x1 || x1 < 0 || x2 >= viewwidth || y > viewheight) {
        I_Error`va(cstr("R_MapPlane: %i, %i at %i"), (x1, x2, y))
    }
    if (planeheight != cachedheight[y]) {
        cachedheight[y] = planeheight
        cacheddistance[y] = FixedMul(planeheight, yslope[y])
        distance = cacheddistance[y]
        cachedxstep[y] = FixedMul(distance, basexscale)
        ds_xstep = cachedxstep[y]
        cachedystep[y] = FixedMul(distance, baseyscale)
        ds_ystep = cachedystep[y]
    } else {
        distance = cacheddistance[y]
        ds_xstep = cachedxstep[y]
        ds_ystep = cachedystep[y]
    }
    length = FixedMul(distance, distscale[x1])
    angle = (viewangle + xtoviewangle[x1]) >> uint(ANGLETOFINESHIFT)
    ds_xfrac = viewx + FixedMul(finecosine[angle], length)
    ds_yfrac = -viewy - FixedMul(finesine[angle], length)
    if (fixedcolormap != null) {
        ds_colormap = fixedcolormap
    } else {
        index = uint(distance >> LIGHTZSHIFT)
        if (index >= uint(MAXLIGHTZ)) {
            index = uint(MAXLIGHTZ - 1)
        }
        ds_colormap = planezlight[index]
    }
    ds_y = y
    ds_x1 = x1
    ds_x2 = x2
    // high or low detail
    invoke(spanfunc)
}

// R_ClearPlanes
// At begining of frame.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClearPlanes {
    var angle : uint
    // opening / clipping determination
    for (i in range(viewwidth)) {
        floorclip[i] = int16(viewheight)
        ceilingclip[i] = int16(-1)
    }
    lastvisplane = addr(visplanes[0])
    lastopening = addr(openings[0])
    // texture calculation
    crt::memset(reinterpret<void?>(addr(cachedheight[0])), 0, uint64(typeinfo sizeof(type<int[200]>)))
    // left to right mapping
    angle = (viewangle - uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    // scale will be unit scale at SCREENWIDTH/2 distance
    basexscale = FixedDiv(finecosine[angle], centerxfrac)
    baseyscale = -FixedDiv(finesine[angle], centerxfrac)
}

// R_FindPlane
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_FindPlane(var height : int; picnum : int; var lightlevel : int) : visplane_t? {
    var check : visplane_t?
    if (picnum == skyflatnum) {
        // all skys map together
        height = 0
        lightlevel = 0
    }
    check = addr(visplanes[0])
    while (reinterpret<uint64>(check) < reinterpret<uint64>(lastvisplane)) {
        if (height == check.height && picnum == check.picnum && lightlevel == check.lightlevel) {
            break
        }
        check++
    }
    if (reinterpret<uint64>(check) < reinterpret<uint64>(lastvisplane)) {
        return check
    }
    if (int64(lastvisplane - addr(visplanes[0])) == int64(MAXVISPLANES)) {
        I_Error`va(cstr("R_FindPlane: no more visplanes"), VaNone())
    }
    lastvisplane++
    check.height = height
    check.picnum = picnum
    check.lightlevel = lightlevel
    check.minx = SCREENWIDTH
    check.maxx = -1
    crt::memset(reinterpret<void?>(addr(check.top[0])), 255, uint64(typeinfo sizeof(type<uint8[320]>)))
    return check
}

// R_CheckPlane
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_CheckPlane(var pl : visplane_t?; start : int; stop : int) : visplane_t? {
    var intrl : int
    var intrh : int
    var unionl : int
    var unionh : int
    var x : int
    if (start < pl.minx) {
        intrl = pl.minx
        unionl = start
    } else {
        unionl = pl.minx
        intrl = start
    }
    if (stop > pl.maxx) {
        intrh = pl.maxx
        unionh = stop
    } else {
        unionh = pl.maxx
        intrh = stop
    }
    x = intrl
    while (x <= intrh) {
        if (addr(pl.top[0])[x] != 255) {
            break
        }
        x++
    }
    if (x > intrh) {
        pl.minx = unionl
        pl.maxx = unionh
        // use the same one
        return pl
    }
    // make a new visplane
    lastvisplane.height = pl.height
    lastvisplane.picnum = pl.picnum
    lastvisplane.lightlevel = pl.lightlevel
    var _t0 = lastvisplane
    lastvisplane++
    pl = _t0
    pl.minx = start
    pl.maxx = stop
    crt::memset(reinterpret<void?>(addr(pl.top[0])), 255, uint64(typeinfo sizeof(type<uint8[320]>)))
    return pl
}

// R_MakeSpans
[unsafe_deref, hint(unsafe_range_check)]
def R_MakeSpans(x : int; var t1 : int; var b1 : int; var t2 : int; var b2 : int) {
    while (t1 < t2 && t1 <= b1) {
        R_MapPlane(t1, spanstart[t1], x - 1)
        t1++
    }
    while (b1 > b2 && b1 >= t1) {
        R_MapPlane(b1, spanstart[b1], x - 1)
        b1--
    }
    while (t2 < t1 && t2 <= b2) {
        spanstart[t2] = x
        t2++
    }
    while (b2 > b1 && b2 >= t2) {
        spanstart[b2] = x
        b2--
    }
}

// R_DrawPlanes
// At the end of each frame.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawPlanes {
    var pl : visplane_t?
    var light : int
    var x : int
    var stop : int
    var angle : int
    var lumpnum : int
    if (int64(ds_p - addr(drawsegs[0])) > int64(MAXDRAWSEGS)) {
        I_Error`va(cstr("R_DrawPlanes: drawsegs overflow (%i)"), (int64(ds_p - addr(drawsegs[0])),))
    }
    if (int64(lastvisplane - addr(visplanes[0])) > int64(MAXVISPLANES)) {
        I_Error`va(cstr("R_DrawPlanes: visplane overflow (%i)"), (int64(lastvisplane - addr(visplanes[0])),))
    }
    if (int64(lastopening - addr(openings[0])) > int64(SCREENWIDTH * 64)) {
        I_Error`va(cstr("R_DrawPlanes: opening overflow (%i)"), (int64(lastopening - addr(openings[0])),))
    }
    pl = addr(visplanes[0])
    while (reinterpret<uint64>(pl) < reinterpret<uint64>(lastvisplane)) {
        {
            if (pl.minx > pl.maxx) {
                continue
            }
            // sky flat
            if (pl.picnum == skyflatnum) {
                dc_iscale = pspriteiscale >> detailshift
                // Sky is allways drawn full bright,
                // i.e. colormaps[0] is used.
                // Because of this hack, sky is not affected
                // by INVUL inverse mapping.
                dc_colormap = colormaps
                dc_texturemid = skytexturemid
                x = pl.minx
                while (x <= pl.maxx) {
                    dc_yl = int(addr(pl.top[0])[x])
                    dc_yh = int(addr(pl.bottom[0])[x])
                    if (dc_yl <= dc_yh) {
                        angle = int((viewangle + xtoviewangle[x]) >> uint(ANGLETOSKYSHIFT))
                        dc_x = x
                        dc_source = R_GetColumn(skytexture, angle)
                        invoke(colfunc)
                    }
                    x++
                }
                continue
            }
            // regular flat
            lumpnum = firstflat + flattranslation[pl.picnum]
            ds_source = reinterpret<uint8?>(W_CacheLumpNum(lumpnum, int(anon_28.PU_STATIC)))
            planeheight = crt::abs(pl.height - viewz)
            light = (pl.lightlevel >> LIGHTSEGSHIFT) + extralight
            if (light >= LIGHTLEVELS) {
                light = LIGHTLEVELS - 1
            }
            if (light < 0) {
                light = 0
            }
            planezlight = addr(zlight[light][0])
            addr(pl.top[0])[pl.maxx + 1] = 255u8
            addr(pl.top[0])[pl.minx - 1] = 255u8
            stop = pl.maxx + 1
            x = pl.minx
            while (x <= stop) {
                R_MakeSpans(x, int(addr(pl.top[0])[x - 1]), int(addr(pl.bottom[0])[x - 1]), int(addr(pl.top[0])[x]), int(addr(pl.bottom[0])[x]))
                x++
            }
            W_ReleaseLumpNum(lumpnum)
        } finally {
            pl++
        }
    }
}

// R_RenderMaskedSegRange
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_RenderMaskedSegRange(var ds : drawseg_s?; x1 : int; x2 : int) {
    var index : uint
    var col : post_t?
    var lightnum : int
    var texnum : int
    // Calculate light table.
    // Use different light tables
    // for horizontal / vertical / diagonal. Diagonal?
    // OPTIMIZE: get rid of LIGHTSEGSHIFT globally
    curline = ds.curline
    frontsector = curline.frontsector
    backsector = curline.backsector
    texnum = texturetranslation[int(curline.sidedef.midtexture)]
    lightnum = (int(frontsector.lightlevel) >> LIGHTSEGSHIFT) + extralight
    if (curline.v1.y == curline.v2.y) {
        lightnum--
    } elif (curline.v1.x == curline.v2.x) {
        lightnum++
    }
    if (lightnum < 0) {
        walllights = addr(scalelight[0][0])
    } elif (lightnum >= LIGHTLEVELS) {
        walllights = addr(scalelight[LIGHTLEVELS - 1][0])
    } else {
        walllights = addr(scalelight[lightnum][0])
    }
    maskedtexturecol = ds.maskedtexturecol
    rw_scalestep = ds.scalestep
    spryscale = ds.scale1 + (x1 - ds.x1) * rw_scalestep
    mfloorclip = ds.sprbottomclip
    mceilingclip = ds.sprtopclip
    // find positioning
    if ((int(curline.linedef.flags) & ML_DONTPEGBOTTOM) != 0) {
        dc_texturemid = frontsector.floorheight > backsector.floorheight ? frontsector.floorheight : backsector.floorheight
        dc_texturemid = dc_texturemid + textureheight[texnum] - viewz
    } else {
        dc_texturemid = frontsector.ceilingheight < backsector.ceilingheight ? frontsector.ceilingheight : backsector.ceilingheight
        dc_texturemid -= viewz
    }
    dc_texturemid += curline.sidedef.rowoffset
    if (fixedcolormap != null) {
        dc_colormap = fixedcolormap
    }
    // draw the columns
    dc_x = x1
    while (dc_x <= x2) {
        // calculate lighting
        if (maskedtexturecol[dc_x] != 32767) {
            if (fixedcolormap == null) {
                index = uint(spryscale >> LIGHTSCALESHIFT)
                if (index >= uint(MAXLIGHTSCALE)) {
                    index = uint(MAXLIGHTSCALE - 1)
                }
                dc_colormap = walllights[index]
            }
            sprtopscreen = centeryfrac - FixedMul(dc_texturemid, spryscale)
            dc_iscale = int(4294967295u / uint(spryscale))
            // draw the texture
            col = reinterpret<post_t?>(R_GetColumn(texnum, int(maskedtexturecol[dc_x])) + -(3))
            R_DrawMaskedColumn(col)
            maskedtexturecol[dc_x] = int16(32767)
        }
        spryscale += rw_scalestep
        dc_x++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_RenderSegLoop {
    var angle : uint
    var index : uint
    var yl : int
    var yh : int
    var mid : int
    var texturecolumn : int
    var top : int
    var bottom : int
    while (rw_x < rw_stopx) {
        // mark floor / ceiling areas
        yl = (topfrac + HEIGHTUNIT - 1) >> HEIGHTBITS
        // no space above wall?
        if (yl < int(ceilingclip[rw_x]) + 1) {
            yl = int(ceilingclip[rw_x]) + 1
        }
        if (markceiling != 0) {
            top = int(ceilingclip[rw_x]) + 1
            bottom = yl - 1
            if (bottom >= int(floorclip[rw_x])) {
                bottom = int(floorclip[rw_x]) - 1
            }
            if (top <= bottom) {
                addr(ceilingplane.top[0])[rw_x] = uint8(top)
                addr(ceilingplane.bottom[0])[rw_x] = uint8(bottom)
            }
        }
        yh = bottomfrac >> HEIGHTBITS
        if (yh >= int(floorclip[rw_x])) {
            yh = int(floorclip[rw_x]) - 1
        }
        if (markfloor != 0) {
            top = yh + 1
            bottom = int(floorclip[rw_x]) - 1
            if (top <= int(ceilingclip[rw_x])) {
                top = int(ceilingclip[rw_x]) + 1
            }
            if (top <= bottom) {
                addr(floorplane.top[0])[rw_x] = uint8(top)
                addr(floorplane.bottom[0])[rw_x] = uint8(bottom)
            }
        }
        // texturecolumn and lighting are independent of wall tiers
        if (segtextured != 0) {
            // calculate texture offset
            angle = (rw_centerangle + xtoviewangle[rw_x]) >> uint(ANGLETOFINESHIFT)
            texturecolumn = rw_offset - FixedMul(finetangent[angle], rw_distance)
            texturecolumn >>= FRACBITS
            // calculate lighting
            index = uint(rw_scale >> LIGHTSCALESHIFT)
            if (index >= uint(MAXLIGHTSCALE)) {
                index = uint(MAXLIGHTSCALE - 1)
            }
            dc_colormap = walllights[index]
            dc_x = rw_x
            dc_iscale = int(4294967295u / uint(rw_scale))
        } else {
            // purely to shut up the compiler
            texturecolumn = 0
        }
        // draw the wall tiers
        if (midtexture != 0) {
            // single sided line
            dc_yl = yl
            dc_yh = yh
            dc_texturemid = rw_midtexturemid
            dc_source = R_GetColumn(midtexture, texturecolumn)
            invoke(colfunc)
            ceilingclip[rw_x] = int16(viewheight)
            floorclip[rw_x] = int16(-1)
        } else {
            // two sided line
            if (toptexture != 0) {
                // top wall
                mid = pixhigh >> HEIGHTBITS
                pixhigh += pixhighstep
                if (mid >= int(floorclip[rw_x])) {
                    mid = int(floorclip[rw_x]) - 1
                }
                if (mid >= yl) {
                    dc_yl = yl
                    dc_yh = mid
                    dc_texturemid = rw_toptexturemid
                    dc_source = R_GetColumn(toptexture, texturecolumn)
                    invoke(colfunc)
                    ceilingclip[rw_x] = int16(mid)
                } else {
                    ceilingclip[rw_x] = int16(yl - 1)
                }
            } else {
                // no top wall
                if (markceiling != 0) {
                    ceilingclip[rw_x] = int16(yl - 1)
                }
            }
            if (bottomtexture != 0) {
                // bottom wall
                mid = (pixlow + HEIGHTUNIT - 1) >> HEIGHTBITS
                pixlow += pixlowstep
                // no space above wall?
                if (mid <= int(ceilingclip[rw_x])) {
                    mid = int(ceilingclip[rw_x]) + 1
                }
                if (mid <= yh) {
                    dc_yl = mid
                    dc_yh = yh
                    dc_texturemid = rw_bottomtexturemid
                    dc_source = R_GetColumn(bottomtexture, texturecolumn)
                    invoke(colfunc)
                    floorclip[rw_x] = int16(mid)
                } else {
                    floorclip[rw_x] = int16(yh + 1)
                }
            } else {
                // no bottom wall
                if (markfloor != 0) {
                    floorclip[rw_x] = int16(yh + 1)
                }
            }
            if (maskedtexture != 0) {
                // save texturecol
                // for backdrawing of masked mid texture
                maskedtexturecol[rw_x] = int16(texturecolumn)
            }
        }
        rw_scale += rw_scalestep
        topfrac += topstep
        bottomfrac += bottomstep
        rw_x++
    }
}

// R_StoreWallRange
// A wall segment will be drawn
// between start and stop pixels (inclusive).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_StoreWallRange(start : int; stop : int) {
    var hyp : int
    var sineval : int
    var distangle : uint
    var offsetangle : uint
    var vtop : int
    var lightnum : int
    // don't overflow and crash
    if (ds_p == addr(drawsegs[0]) + 256) {
        return
    }
    if (start >= viewwidth || start > stop) {
        I_Error`va(cstr("Bad R_RenderWallRange: %i to %i"), (start, stop))
    }
    sidedef = curline.sidedef
    linedef = curline.linedef
    // mark the segment as visible for auto map
    linedef.flags = int16(int(linedef.flags) | ML_MAPPED)
    // calculate rw_distance for scale calculation
    rw_normalangle = curline.angle + uint(ANG90)
    offsetangle = uint(crt::abs(int(rw_normalangle - uint(rw_angle1))))
    if (offsetangle > uint(ANG90)) {
        offsetangle = uint(ANG90)
    }
    distangle = uint(ANG90) - offsetangle
    hyp = R_PointToDist(curline.v1.x, curline.v1.y)
    sineval = finesine[distangle >> uint(ANGLETOFINESHIFT)]
    rw_distance = FixedMul(hyp, sineval)
    rw_x = start
    ds_p.x1 = rw_x
    ds_p.x2 = stop
    ds_p.curline = curline
    rw_stopx = stop + 1
    // calculate scale at both ends and step
    rw_scale = R_ScaleFromGlobalAngle(viewangle + xtoviewangle[start])
    ds_p.scale1 = rw_scale
    if (stop > start) {
        ds_p.scale2 = R_ScaleFromGlobalAngle(viewangle + xtoviewangle[stop])
        rw_scalestep = (ds_p.scale2 - rw_scale) / (stop - start)
        ds_p.scalestep = rw_scalestep
    } else {
        // UNUSED: try to fix the stretched line bug
        ds_p.scale2 = ds_p.scale1
    }
    // calculate texture boundaries
    // and decide if floor / ceiling marks are needed
    worldtop = frontsector.ceilingheight - viewz
    worldbottom = frontsector.floorheight - viewz
    maskedtexture = 0u
    bottomtexture = int(maskedtexture)
    toptexture = bottomtexture
    midtexture = toptexture
    ds_p.maskedtexturecol = null
    if (backsector == null) {
        // single sided line
        midtexture = texturetranslation[int(sidedef.midtexture)]
        // a single sided line is terminal, so it must mark ends
        markceiling = 1u
        markfloor = markceiling
        if ((int(linedef.flags) & ML_DONTPEGBOTTOM) != 0) {
            vtop = frontsector.floorheight + textureheight[int(sidedef.midtexture)]
            // bottom of texture at bottom
            rw_midtexturemid = vtop - viewz
        } else {
            // top of texture at top
            rw_midtexturemid = worldtop
        }
        rw_midtexturemid += sidedef.rowoffset
        ds_p.silhouette = SIL_BOTH
        ds_p.sprtopclip = addr(screenheightarray[0])
        ds_p.sprbottomclip = addr(negonearray[0])
        ds_p.bsilheight = 2147483647
        ds_p.tsilheight = -2147483647 - 1
    } else {
        // two sided line
        ds_p.sprbottomclip = null
        ds_p.sprtopclip = ds_p.sprbottomclip
        ds_p.silhouette = 0
        if (frontsector.floorheight > backsector.floorheight) {
            ds_p.silhouette = SIL_BOTTOM
            ds_p.bsilheight = frontsector.floorheight
        } elif (backsector.floorheight > viewz) {
            ds_p.silhouette = SIL_BOTTOM
            ds_p.bsilheight = 2147483647
        }
        // ds_p->sprbottomclip = negonearray;
        if (frontsector.ceilingheight < backsector.ceilingheight) {
            ds_p.silhouette |= SIL_TOP
            ds_p.tsilheight = frontsector.ceilingheight
        } elif (backsector.ceilingheight < viewz) {
            ds_p.silhouette |= SIL_TOP
            ds_p.tsilheight = -2147483647 - 1
        }
        // ds_p->sprtopclip = screenheightarray;
        if (backsector.ceilingheight <= frontsector.floorheight) {
            ds_p.sprbottomclip = addr(negonearray[0])
            ds_p.bsilheight = 2147483647
            ds_p.silhouette |= SIL_BOTTOM
        }
        if (backsector.floorheight >= frontsector.ceilingheight) {
            ds_p.sprtopclip = addr(screenheightarray[0])
            ds_p.tsilheight = -2147483647 - 1
            ds_p.silhouette |= SIL_TOP
        }
        worldhigh = backsector.ceilingheight - viewz
        worldlow = backsector.floorheight - viewz
        // hack to allow height changes in outdoor areas
        if (int(frontsector.ceilingpic) == skyflatnum && int(backsector.ceilingpic) == skyflatnum) {
            worldtop = worldhigh
        }
        if (worldlow != worldbottom || backsector.floorpic != frontsector.floorpic || backsector.lightlevel != frontsector.lightlevel) {
            markfloor = 1u
        } else {
            // same plane on both sides
            markfloor = 0u
        }
        if (worldhigh != worldtop || backsector.ceilingpic != frontsector.ceilingpic || backsector.lightlevel != frontsector.lightlevel) {
            markceiling = 1u
        } else {
            // same plane on both sides
            markceiling = 0u
        }
        if (backsector.ceilingheight <= frontsector.floorheight || backsector.floorheight >= frontsector.ceilingheight) {
            // closed door
            markfloor = 1u
            markceiling = markfloor
        }
        if (worldhigh < worldtop) {
            // top texture
            toptexture = texturetranslation[int(sidedef.toptexture)]
            if ((int(linedef.flags) & ML_DONTPEGTOP) != 0) {
                // top of texture at top
                rw_toptexturemid = worldtop
            } else {
                vtop = backsector.ceilingheight + textureheight[int(sidedef.toptexture)]
                // bottom of texture
                rw_toptexturemid = vtop - viewz
            }
        }
        if (worldlow > worldbottom) {
            // bottom texture
            bottomtexture = texturetranslation[int(sidedef.bottomtexture)]
            if ((int(linedef.flags) & ML_DONTPEGBOTTOM) != 0) {
                // bottom of texture at bottom
                // top of texture at top
                rw_bottomtexturemid = worldtop
            } else {
                // top of texture at top
                rw_bottomtexturemid = worldlow
            }
        }
        rw_toptexturemid += sidedef.rowoffset
        rw_bottomtexturemid += sidedef.rowoffset
        // allocate space for masked texture tables
        if (sidedef.midtexture != 0) {
            // masked midtexture
            maskedtexture = 1u
            maskedtexturecol = lastopening - rw_x
            ds_p.maskedtexturecol = maskedtexturecol
            lastopening += rw_stopx - rw_x
        }
    }
    // calculate rw_offset (only needed for textured lines)
    segtextured = uint(midtexture | toptexture | bottomtexture) | maskedtexture
    if (segtextured != 0) {
        offsetangle = rw_normalangle - uint(rw_angle1)
        if (offsetangle > ANG180) {
            offsetangle = -offsetangle
        }
        if (offsetangle > uint(ANG90)) {
            offsetangle = uint(ANG90)
        }
        sineval = finesine[offsetangle >> uint(ANGLETOFINESHIFT)]
        rw_offset = FixedMul(hyp, sineval)
        if (rw_normalangle - uint(rw_angle1) < ANG180) {
            rw_offset = -rw_offset
        }
        rw_offset += sidedef.textureoffset + curline.offset
        rw_centerangle = uint(ANG90) + viewangle - rw_normalangle
        // calculate light table
        // use different light tables
        // for horizontal / vertical / diagonal
        // OPTIMIZE: get rid of LIGHTSEGSHIFT globally
        if (fixedcolormap == null) {
            lightnum = (int(frontsector.lightlevel) >> LIGHTSEGSHIFT) + extralight
            if (curline.v1.y == curline.v2.y) {
                lightnum--
            } elif (curline.v1.x == curline.v2.x) {
                lightnum++
            }
            if (lightnum < 0) {
                walllights = addr(scalelight[0][0])
            } elif (lightnum >= LIGHTLEVELS) {
                walllights = addr(scalelight[LIGHTLEVELS - 1][0])
            } else {
                walllights = addr(scalelight[lightnum][0])
            }
        }
    }
    // if a floor / ceiling plane is on the wrong side
    // of the view plane, it is definitely invisible
    // and doesn't need to be marked.
    if (frontsector.floorheight >= viewz) {
        // above view plane
        markfloor = 0u
    }
    if (frontsector.ceilingheight <= viewz && int(frontsector.ceilingpic) != skyflatnum) {
        // below view plane
        markceiling = 0u
    }
    // calculate incremental stepping values for texture edges
    worldtop >>= 4
    worldbottom >>= 4
    topstep = -FixedMul(rw_scalestep, worldtop)
    topfrac = (centeryfrac >> 4) - FixedMul(worldtop, rw_scale)
    bottomstep = -FixedMul(rw_scalestep, worldbottom)
    bottomfrac = (centeryfrac >> 4) - FixedMul(worldbottom, rw_scale)
    if (backsector != null) {
        worldhigh >>= 4
        worldlow >>= 4
        if (worldhigh < worldtop) {
            pixhigh = (centeryfrac >> 4) - FixedMul(worldhigh, rw_scale)
            pixhighstep = -FixedMul(rw_scalestep, worldhigh)
        }
        if (worldlow > worldbottom) {
            pixlow = (centeryfrac >> 4) - FixedMul(worldlow, rw_scale)
            pixlowstep = -FixedMul(rw_scalestep, worldlow)
        }
    }
    // render it
    if (markceiling != 0) {
        ceilingplane = R_CheckPlane(ceilingplane, rw_x, rw_stopx - 1)
    }
    if (markfloor != 0) {
        floorplane = R_CheckPlane(floorplane, rw_x, rw_stopx - 1)
    }
    R_RenderSegLoop()
    // save sprite clipping info
    if (((ds_p.silhouette & SIL_TOP) != 0 || maskedtexture != 0) && ds_p.sprtopclip == null) {
        crt::memcpy(reinterpret<void?>(lastopening), reinterpret<void?>(addr(ceilingclip[0]) + start), uint64(2 * (rw_stopx - start)))
        ds_p.sprtopclip = lastopening - start
        lastopening += rw_stopx - start
    }
    if (((ds_p.silhouette & SIL_BOTTOM) != 0 || maskedtexture != 0) && ds_p.sprbottomclip == null) {
        crt::memcpy(reinterpret<void?>(lastopening), reinterpret<void?>(addr(floorclip[0]) + start), uint64(2 * (rw_stopx - start)))
        ds_p.sprbottomclip = lastopening - start
        lastopening += rw_stopx - start
    }
    if (maskedtexture != 0 && (ds_p.silhouette & SIL_TOP) == 0) {
        ds_p.silhouette |= SIL_TOP
        ds_p.tsilheight = -2147483647 - 1
    }
    if (maskedtexture != 0 && (ds_p.silhouette & SIL_BOTTOM) == 0) {
        ds_p.silhouette |= SIL_BOTTOM
        ds_p.bsilheight = 2147483647
    }
    ds_p++
}

// R_InitSkyMap
// Called whenever the view size changes.
[unsafe_deref, hint(unsafe_range_check)]
def R_InitSkyMap {
    // skyflatnum = R_FlatNumForName ( SKYFLATNAME );
    skytexturemid = 100 * FRACUNIT
}

// R_InstallSpriteLump
// Local function for R_InitSprites.
[unsafe_deref, hint(unsafe_range_check)]
def R_InstallSpriteLump(lump : int; frame : uint; var rotation : uint; flipped : uint) {
    if (frame >= 29u || rotation > 8u) {
        I_Error`va(cstr("R_InstallSpriteLump: Bad frame characters in lump %i"), (lump,))
    }
    if (int(frame) > maxframe) {
        maxframe = int(frame)
    }
    if (rotation == 0u) {
        // the lump should be used for all rotations
        if (sprtemp[frame].rotate == 0u) {
            I_Error`va(cstr("R_InitSprites: Sprite %s frame %c has multip rot=0 lump"), (spritename, uint('A') + frame))
        }
        if (sprtemp[frame].rotate == 1u) {
            I_Error`va(cstr("R_InitSprites: Sprite %s frame %c has rotations and a rot=0 lump"), (spritename, uint('A') + frame))
        }
        sprtemp[frame].rotate = 0u
        for (r in range(8)) {
            sprtemp[frame].lump[r] = int16(lump - firstspritelump)
            sprtemp[frame].flip[r] = uint8(flipped)
        }
        return
    }
    // the lump is only used for one rotation
    if (sprtemp[frame].rotate == 0u) {
        I_Error`va(cstr("R_InitSprites: Sprite %s frame %c has rotations and a rot=0 lump"), (spritename, uint('A') + frame))
    }
    sprtemp[frame].rotate = 1u
    // make 0 based
    rotation--
    if (sprtemp[frame].lump[rotation] != -1) {
        I_Error`va(cstr("R_InitSprites: Sprite %s : %c : %c has two lumps mapped to it"), (spritename, uint('A') + frame, uint('1') + rotation))
    }
    sprtemp[frame].lump[rotation] = int16(lump - firstspritelump)
    sprtemp[frame].flip[rotation] = uint8(flipped)
}

// R_InitSpriteDefs
// Pass a null terminated list of sprite names
// (4 chars exactly) to be used.
// Builds the sprite rotation matrixes to account
// for horizontally flipped sprites.
// Will report an error if the lumps are inconsistant.
// Only called at startup.
// Sprite lump names are 4 characters for the actor,
// a letter for the frame, and a number for the rotation.
// A sprite that is flippable will have an additional
// letter/number appended.
// The rotation character can be 0 to signify no rotations.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_InitSpriteDefs(var namelist : uint8 ??) {
    var check : uint8 ??
    var i : int
    var l : int
    var frame : int
    var rotation : int
    var start : int
    var end : int
    var patched : int
    // count the number of sprite names
    check = namelist
    while (*check != null) {
        check++
    }
    numsprites = int(int64(check - namelist))
    if (numsprites == 0) {
        return
    }
    sprites = reinterpret<spritedef_t?>(Z_Malloc(int(uint64(numsprites) * uint64(typeinfo sizeof(type<spritedef_t>))), int(anon_28.PU_STATIC), null))
    start = firstspritelump - 1
    end = lastspritelump + 1
    // scan all the lump names for each of the names,
    // noting the highest frame letter.
    // Just compare 4 characters as ints
    i = 0
    while (i < numsprites) {
        {
            spritename = namelist[i]
            crt::memset(reinterpret<void?>(addr(sprtemp[0])), -1, uint64(typeinfo sizeof(type<spriteframe_t[29]>)))
            maxframe = -1
            // scan the lumps,
            // filling in the frames for whatever is found
            l = start + 1
            while (l < end) {
                if (crt::strncasecmp(addr(lumpinfo[l].name[0]), spritename, 4ul) == 0) {
                    frame = int(lumpinfo[l].name[4]) - 'A'
                    rotation = int(lumpinfo[l].name[5]) - '0'
                    if (modifiedgame != 0) {
                        patched = W_GetNumForName(addr(lumpinfo[l].name[0]))
                    } else {
                        patched = l
                    }
                    R_InstallSpriteLump(patched, uint(frame), uint(rotation), 0u)
                    if (lumpinfo[l].name[6] != 0) {
                        frame = int(lumpinfo[l].name[6]) - 'A'
                        rotation = int(lumpinfo[l].name[7]) - '0'
                        R_InstallSpriteLump(l, uint(frame), uint(rotation), 1u)
                    }
                }
                l++
            }
            // check the frames that were found for completeness
            if (maxframe == -1) {
                sprites[i].numframes = 0
                continue
            }
            maxframe++
            frame = 0
            while (frame < maxframe) {
                c_switch(int(sprtemp[frame].rotate)) {
                    case(-1) {
                        // no rotations were found for that frame at all
                        I_Error`va(cstr("R_InitSprites: No patches found for %s frame %c"), (spritename, frame + 'A'))
                        break
                    }
                    case(0) {
                        // only the first rotation is needed
                        break
                    }
                    case(1) {
                        // must have all 8 frames
                        rotation = 0
                        while (rotation < 8) {
                            if (sprtemp[frame].lump[rotation] == -1) {
                                I_Error`va(cstr("R_InitSprites: Sprite %s frame %c is missing rotations"), (spritename, frame + 'A'))
                            }
                            rotation++
                        }
                        break
                    }
                }
                frame++
            }
            // allocate space for the frames present and copy sprtemp to it
            sprites[i].numframes = maxframe
            sprites[i].spriteframes = reinterpret<spriteframe_t?>(Z_Malloc(int(uint64(maxframe) * uint64(typeinfo sizeof(type<spriteframe_t>))),
                    int(anon_28.PU_STATIC), null))
            crt::memcpy(reinterpret<void?>(sprites[i].spriteframes), reinterpret<void?>(addr(sprtemp[0])),
                    uint64(maxframe) * uint64(typeinfo sizeof(type<spriteframe_t>)))
        } finally {
            i++
        }
    }
}

// R_InitSprites
// Called at program start.
[unsafe_deref, hint(unsafe_range_check)]
def R_InitSprites(var namelist : uint8 ??) {
    for (i in range(SCREENWIDTH)) {
        negonearray[i] = int16(-1)
    }
    R_InitSpriteDefs(namelist)
}

// R_ClearSprites
// Called at frame start.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ClearSprites {
    vissprite_p = addr(vissprites[0])
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_NewVisSprite : vissprite_s? {
    if (vissprite_p == addr(vissprites[0]) + 128) {
        return addr(overflowsprite)
    }
    vissprite_p++
    return vissprite_p - 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawMaskedColumn(var column : post_t?) {
    var topscreen : int
    var bottomscreen : int
    var basetexturemid : int
    basetexturemid = dc_texturemid
    while (column.topdelta != 255) {
        // calculate unclipped screen coordinates
        // for post
        topscreen = sprtopscreen + spryscale * int(column.topdelta)
        bottomscreen = topscreen + spryscale * int(column.length)
        dc_yl = (topscreen + FRACUNIT - 1) >> FRACBITS
        dc_yh = (bottomscreen - 1) >> FRACBITS
        if (dc_yh >= int(mfloorclip[dc_x])) {
            dc_yh = int(mfloorclip[dc_x]) - 1
        }
        if (dc_yl <= int(mceilingclip[dc_x])) {
            dc_yl = int(mceilingclip[dc_x]) + 1
        }
        if (dc_yl <= dc_yh) {
            dc_source = reinterpret<uint8?>(column) + 3
            dc_texturemid = basetexturemid - (int(column.topdelta) << FRACBITS)
            // dc_source = (byte *)column + 3 - column->topdelta;
            // Drawn by either R_DrawColumn
            // or (SHADOW) R_DrawFuzzColumn.
            invoke(colfunc)
        }
        column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
    }
    dc_texturemid = basetexturemid
}

// R_DrawVisSprite
// mfloorclip and mceilingclip should also be set.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawVisSprite(var vis : vissprite_s?; x1 : int; x2 : int) {
    var column : post_t?
    var texturecolumn : int
    var frac : int
    var patch : patch_t?
    patch = reinterpret<patch_t?>(W_CacheLumpNum(vis.patch + firstspritelump, int(anon_28.PU_CACHE)))
    dc_colormap = vis.colormap
    if (dc_colormap == null) {
        // NULL colormap = shadow draw
        colfunc = fuzzcolfunc
    } elif ((vis.mobjflags & int(mobjflag_t.MF_TRANSLATION)) != 0) {
        colfunc = transcolfunc
        dc_translation = translationtables - 256 + ((vis.mobjflags & int(mobjflag_t.MF_TRANSLATION)) >> (int(mobjflag_t.MF_TRANSSHIFT) - 8))
    }
    dc_iscale = crt::abs(vis.xiscale) >> detailshift
    dc_texturemid = vis.texturemid
    frac = vis.startfrac
    spryscale = vis.scale
    sprtopscreen = centeryfrac - FixedMul(dc_texturemid, spryscale)
    dc_x = vis.x1
    while (dc_x <= vis.x2) {
        texturecolumn = frac >> FRACBITS
        if (texturecolumn < 0 || texturecolumn >= int(patch.width)) {
            I_Error`va(cstr("R_DrawSpriteRange: bad texturecolumn"), VaNone())
        }
        column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[texturecolumn])
        R_DrawMaskedColumn(column)
        dc_x++
        frac += vis.xiscale
    }
    colfunc = basecolfunc
}

// R_ProjectSprite
// Generates a vissprite for a thing
// if it might be visible.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_ProjectSprite(var thing : mobj_s?) {
    var tr_x : int
    var tr_y : int
    var gxt : int
    var gyt : int
    var tx : int
    var tz : int
    var xscale : int
    var x1 : int
    var x2 : int
    var sprdef : spritedef_t?
    var sprframe : spriteframe_t?
    var lump : int
    var rot : uint
    var flip : uint
    var index : int
    var vis : vissprite_s?
    var ang : uint
    var iscale : int
    // transform the origin point
    tr_x = thing.x - viewx
    tr_y = thing.y - viewy
    gxt = FixedMul(tr_x, viewcos)
    gyt = -FixedMul(tr_y, viewsin)
    tz = gxt - gyt
    // thing is behind view plane?
    if (tz < MINZ) {
        return
    }
    xscale = FixedDiv(projection, tz)
    gxt = -FixedMul(tr_x, viewsin)
    gyt = FixedMul(tr_y, viewcos)
    tx = -(gyt + gxt)
    // too far off the side?
    if (crt::abs(tx) > (tz << 2)) {
        return
    }
    // decide which patch to use for sprite relative to player
    if (uint(thing.sprite) >= uint(numsprites)) {
        I_Error`va(cstr("R_ProjectSprite: invalid sprite number %i "), (uint(thing.sprite),))
    }
    sprdef = addr(sprites[int(thing.sprite)])
    if ((thing.frame & FF_FRAMEMASK) >= sprdef.numframes) {
        I_Error`va(cstr("R_ProjectSprite: invalid sprite frame %i : %i "), (uint(thing.sprite), thing.frame))
    }
    sprframe = addr(sprdef.spriteframes[thing.frame & FF_FRAMEMASK])
    if (sprframe.rotate != 0) {
        // choose a different rotation based on player view
        ang = R_PointToAngle(thing.x, thing.y)
        rot = (ang - thing.angle + uint(ANG45 / 2) * 9u) >> 29u
        lump = int(sprframe.lump[rot])
        flip = uint(sprframe.flip[rot])
    } else {
        // use single rotation for all views
        lump = int(sprframe.lump[0])
        flip = uint(sprframe.flip[0])
    }
    // calculate edges of the shape
    tx -= spriteoffset[lump]
    x1 = (centerxfrac + FixedMul(tx, xscale)) >> FRACBITS
    // off the right side?
    if (x1 > viewwidth) {
        return
    }
    tx += spritewidth[lump]
    x2 = ((centerxfrac + FixedMul(tx, xscale)) >> FRACBITS) - 1
    // off the left side
    if (x2 < 0) {
        return
    }
    // store information in a vissprite
    vis = R_NewVisSprite()
    vis.mobjflags = thing.flags
    vis.scale = xscale << detailshift
    vis.gx = thing.x
    vis.gy = thing.y
    vis.gz = thing.z
    vis.gzt = thing.z + spritetopoffset[lump]
    vis.texturemid = vis.gzt - viewz
    vis.x1 = x1 < 0 ? 0 : x1
    vis.x2 = x2 >= viewwidth ? viewwidth - 1 : x2
    iscale = FixedDiv(FRACUNIT, xscale)
    if (flip != 0) {
        vis.startfrac = spritewidth[lump] - 1
        vis.xiscale = -iscale
    } else {
        vis.startfrac = 0
        vis.xiscale = iscale
    }
    if (vis.x1 > x1) {
        vis.startfrac += vis.xiscale * (vis.x1 - x1)
    }
    vis.patch = lump
    // get light level
    if ((thing.flags & int(mobjflag_t.MF_SHADOW)) != 0) {
        // shadow draw
        vis.colormap = null
    } elif (fixedcolormap != null) {
        // fixed map
        vis.colormap = fixedcolormap
    } elif ((thing.frame & FF_FULLBRIGHT) != 0) {
        // full bright
        vis.colormap = colormaps
    } else {
        // diminished light
        index = xscale >> (LIGHTSCALESHIFT - detailshift)
        if (index >= MAXLIGHTSCALE) {
            index = MAXLIGHTSCALE - 1
        }
        vis.colormap = spritelights[index]
    }
}

// R_AddSprites
// During BSP traversal, this adds sprites by sector.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_AddSprites(var sec : sector_t?) {
    var thing : mobj_s?
    var lightnum : int
    // BSP is traversed by subsector.
    // A sector might have been split into several
    // subsectors during BSP building.
    // Thus we check whether its already added.
    if (sec.validcount == validcount) {
        return
    }
    // Well, now it will be done.
    sec.validcount = validcount
    lightnum = (int(sec.lightlevel) >> LIGHTSEGSHIFT) + extralight
    if (lightnum < 0) {
        spritelights = addr(scalelight[0][0])
    } elif (lightnum >= LIGHTLEVELS) {
        spritelights = addr(scalelight[LIGHTLEVELS - 1][0])
    } else {
        spritelights = addr(scalelight[lightnum][0])
    }
    // Handle all things in sector.
    thing = sec.thinglist
    while (thing != null) {
        R_ProjectSprite(thing)
        thing = thing.snext
    }
}

// R_DrawPSprite
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawPSprite(var psp : pspdef_t?) {
    var tx : int
    var x1 : int
    var x2 : int
    var sprdef : spritedef_t?
    var sprframe : spriteframe_t?
    var lump : int
    var flip : uint
    var vis : vissprite_s?
    var avis : vissprite_s
    // decide which patch to use
    if (uint(psp.state.sprite) >= uint(numsprites)) {
        I_Error`va(cstr("R_ProjectSprite: invalid sprite number %i "), (uint(psp.state.sprite),))
    }
    sprdef = addr(sprites[int(psp.state.sprite)])
    if ((psp.state.frame & FF_FRAMEMASK) >= sprdef.numframes) {
        I_Error`va(cstr("R_ProjectSprite: invalid sprite frame %i : %i "), (uint(psp.state.sprite), psp.state.frame))
    }
    sprframe = addr(sprdef.spriteframes[psp.state.frame & FF_FRAMEMASK])
    lump = int(sprframe.lump[0])
    flip = uint(sprframe.flip[0])
    // calculate edges of the shape
    tx = psp.sx - 160 * FRACUNIT
    tx -= spriteoffset[lump]
    x1 = (centerxfrac + FixedMul(tx, pspritescale)) >> FRACBITS
    // off the right side
    if (x1 > viewwidth) {
        return
    }
    tx += spritewidth[lump]
    x2 = ((centerxfrac + FixedMul(tx, pspritescale)) >> FRACBITS) - 1
    // off the left side
    if (x2 < 0) {
        return
    }
    // store information in a vissprite
    vis = addr(avis)
    vis.mobjflags = 0
    vis.texturemid = (BASEYCENTER << FRACBITS) + FRACUNIT / 2 - (psp.sy - spritetopoffset[lump])
    vis.x1 = x1 < 0 ? 0 : x1
    vis.x2 = x2 >= viewwidth ? viewwidth - 1 : x2
    vis.scale = pspritescale << detailshift
    if (flip != 0) {
        vis.xiscale = -pspriteiscale
        vis.startfrac = spritewidth[lump] - 1
    } else {
        vis.xiscale = pspriteiscale
        vis.startfrac = 0
    }
    if (vis.x1 > x1) {
        vis.startfrac += vis.xiscale * (vis.x1 - x1)
    }
    vis.patch = lump
    if (viewplayer.powers[int(powertype_t.pw_invisibility)] > 4 * 32 || (viewplayer.powers[int(powertype_t.pw_invisibility)] & 8) != 0) {
        // shadow draw
        vis.colormap = null
    } elif (fixedcolormap != null) {
        // fixed color
        vis.colormap = fixedcolormap
    } elif ((psp.state.frame & FF_FULLBRIGHT) != 0) {
        // full bright
        vis.colormap = colormaps
    } else {
        // local light
        vis.colormap = spritelights[MAXLIGHTSCALE - 1]
    }
    R_DrawVisSprite(vis, vis.x1, vis.x2)
}

// R_DrawPlayerSprites
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawPlayerSprites {
    var i : int
    var lightnum : int
    var psp : pspdef_t?
    // get light level
    lightnum = (int(viewplayer.mo.subsector.sector.lightlevel) >> LIGHTSEGSHIFT) + extralight
    if (lightnum < 0) {
        spritelights = addr(scalelight[0][0])
    } elif (lightnum >= LIGHTLEVELS) {
        spritelights = addr(scalelight[LIGHTLEVELS - 1][0])
    } else {
        spritelights = addr(scalelight[lightnum][0])
    }
    // clip to screen bounds
    mfloorclip = addr(screenheightarray[0])
    mceilingclip = addr(negonearray[0])
    // add all active psprites
    i = 0
    psp = addr(viewplayer.psprites[0])
    while (i < int(psprnum_t.NUMPSPRITES)) {
        if (psp.state != null) {
            R_DrawPSprite(psp)
        }
        i++
        psp++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_SortVisSprites {
    var count : int
    var ds : vissprite_s?
    var best : vissprite_s?
    var unsorted : vissprite_s
    var bestscale : int
    count = int(int64(vissprite_p - addr(vissprites[0])))
    unsorted.prev = addr(unsorted)
    unsorted.next = unsorted.prev
    if (count == 0) {
        return
    }
    ds = addr(vissprites[0])
    while (reinterpret<uint64>(ds) < reinterpret<uint64>(vissprite_p)) {
        ds.next = ds + 1
        ds.prev = ds - 1
        ds++
    }
    vissprites[0].prev = addr(unsorted)
    unsorted.next = addr(vissprites[0])
    (vissprite_p - 1).next = addr(unsorted)
    unsorted.prev = vissprite_p - 1
    // pull the vissprites out by scale
    vsprsortedhead.prev = addr(vsprsortedhead)
    vsprsortedhead.next = vsprsortedhead.prev
    for (i in range(count)) {
        bestscale = 2147483647
        best = unsorted.next
        ds = unsorted.next
        while (ds != addr(unsorted)) {
            if (ds.scale < bestscale) {
                bestscale = ds.scale
                best = ds
            }
            ds = ds.next
        }
        best.next.prev = best.prev
        best.prev.next = best.next
        best.next = addr(vsprsortedhead)
        best.prev = vsprsortedhead.prev
        vsprsortedhead.prev.next = best
        vsprsortedhead.prev = best
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawSprite(var spr : vissprite_s?) {
    var ds : drawseg_s?
    var x : int
    var r1 : int
    var r2 : int
    var scale : int
    var lowscale : int
    var silhouette : int
    x = spr.x1
    while (x <= spr.x2) {
        doom_all__cliptop[x] = int16(-2)
        doom_all__clipbot[x] = doom_all__cliptop[x]
        x++
    }
    // Scan drawsegs from end to start for obscuring segs.
    // The first drawseg that has a greater scale
    // is the clip seg.
    ds = ds_p - 1
    while (reinterpret<uint64>(ds) >= reinterpret<uint64>(addr(drawsegs[0]))) {
        {
            // determine if the drawseg obscures the sprite
            if (ds.x1 > spr.x2 || ds.x2 < spr.x1 || (ds.silhouette == 0 && ds.maskedtexturecol == null)) {
                // does not cover sprite
                continue
            }
            r1 = ds.x1 < spr.x1 ? spr.x1 : ds.x1
            r2 = ds.x2 > spr.x2 ? spr.x2 : ds.x2
            if (ds.scale1 > ds.scale2) {
                lowscale = ds.scale2
                scale = ds.scale1
            } else {
                lowscale = ds.scale1
                scale = ds.scale2
            }
            if (scale < spr.scale || (lowscale < spr.scale && R_PointOnSegSide(spr.gx, spr.gy, ds.curline) == 0)) {
                // masked mid texture?
                if (ds.maskedtexturecol != null) {
                    R_RenderMaskedSegRange(ds, r1, r2)
                }
                // seg is behind sprite
                continue
            }
            // clip this piece of the sprite
            silhouette = ds.silhouette
            if (spr.gz >= ds.bsilheight) {
                silhouette &= ~SIL_BOTTOM
            }
            if (spr.gzt <= ds.tsilheight) {
                silhouette &= ~SIL_TOP
            }
            if (silhouette == 1) {
                // bottom sil
                x = r1
                while (x <= r2) {
                    if (doom_all__clipbot[x] == -2) {
                        doom_all__clipbot[x] = ds.sprbottomclip[x]
                    }
                    x++
                }
            } elif (silhouette == 2) {
                // top sil
                x = r1
                while (x <= r2) {
                    if (doom_all__cliptop[x] == -2) {
                        doom_all__cliptop[x] = ds.sprtopclip[x]
                    }
                    x++
                }
            } elif (silhouette == 3) {
                // both
                x = r1
                while (x <= r2) {
                    if (doom_all__clipbot[x] == -2) {
                        doom_all__clipbot[x] = ds.sprbottomclip[x]
                    }
                    if (doom_all__cliptop[x] == -2) {
                        doom_all__cliptop[x] = ds.sprtopclip[x]
                    }
                    x++
                }
            }
        } finally {
            ds--
        }
    }
    // all clipping has been performed, so draw the sprite
    // check for unclipped columns
    x = spr.x1
    while (x <= spr.x2) {
        if (doom_all__clipbot[x] == -2) {
            doom_all__clipbot[x] = int16(viewheight)
        }
        if (doom_all__cliptop[x] == -2) {
            doom_all__cliptop[x] = int16(-1)
        }
        x++
    }
    mfloorclip = addr(doom_all__clipbot[0])
    mceilingclip = addr(doom_all__cliptop[0])
    R_DrawVisSprite(spr, spr.x1, spr.x2)
}

// R_DrawMasked
[c_function, unsafe_deref, hint(unsafe_range_check)]
def R_DrawMasked {
    var spr : vissprite_s?
    var ds : drawseg_s?
    R_SortVisSprites()
    if (reinterpret<uint64>(vissprite_p) > reinterpret<uint64>(addr(vissprites[0]))) {
        // draw all vissprites back to front
        spr = vsprsortedhead.next
        while (spr != addr(vsprsortedhead)) {
            R_DrawSprite(spr)
            spr = spr.next
        }
    }
    // render any remaining masked mid textures
    ds = ds_p - 1
    while (reinterpret<uint64>(ds) >= reinterpret<uint64>(addr(drawsegs[0]))) {
        if (ds.maskedtexturecol != null) {
            R_RenderMaskedSegRange(ds, ds.x1, ds.x2)
        }
        ds--
    }
    // draw the psprites on top of everything
    // but does not draw on side views
    if (viewangleoffset == 0) {
        R_DrawPlayerSprites()
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def SHA1_Init(var hd : sha1_context_s?) {
    hd.h0 = 1732584193u
    hd.h1 = 4023233417u
    hd.h2 = 2562383102u
    hd.h3 = 271733878u
    hd.h4 = 3285377520u
    hd.nblocks = 0u
    hd.count = 0
}

// Transform the message X which consists of 16 32-bit-words
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__Transform(var hd : sha1_context_s?; var data : uint8?) {
    var a : uint
    var b : uint
    var c : uint
    var d : uint
    var e : uint
    var tm : uint
    var x : uint[16]
    // get values from the chaining vars
    a = hd.h0
    b = hd.h1
    c = hd.h2
    d = hd.h3
    e = hd.h4
    {
        var i : int
        var p2 : uint8?
        i = 0
        p2 = reinterpret<uint8?>(addr(x[0]))
        while (i < 16) {
            var _t0 = data
            data++
            p2[3] = *_t0
            var _t1 = data
            data++
            p2[2] = *_t1
            var _t2 = data
            data++
            p2[1] = *_t2
            var _t3 = data
            data++
            p2[0] = *_t3
            i++
            p2 += 4
        }
    }
    {
        e = uint(int64(e) + (int64(rol(a, 5) + (d ^ (b & (c ^ d)))) + K1 + int64(x[0])))
        b = (b << 30u) | (b >> uint(32 - 30))
    }
    {
        d = uint(int64(d) + (int64(rol(e, 5) + (c ^ (a & (b ^ c)))) + K1 + int64(x[1])))
        a = (a << 30u) | (a >> uint(32 - 30))
    }
    {
        c = uint(int64(c) + (int64(rol(d, 5) + (b ^ (e & (a ^ b)))) + K1 + int64(x[2])))
        e = (e << 30u) | (e >> uint(32 - 30))
    }
    {
        b = uint(int64(b) + (int64(rol(c, 5) + (a ^ (d & (e ^ a)))) + K1 + int64(x[3])))
        d = (d << 30u) | (d >> uint(32 - 30))
    }
    {
        a = uint(int64(a) + (int64(rol(b, 5) + (e ^ (c & (d ^ e)))) + K1 + int64(x[4])))
        c = (c << 30u) | (c >> uint(32 - 30))
    }
    {
        e = uint(int64(e) + (int64(rol(a, 5) + (d ^ (b & (c ^ d)))) + K1 + int64(x[5])))
        b = (b << 30u) | (b >> uint(32 - 30))
    }
    {
        d = uint(int64(d) + (int64(rol(e, 5) + (c ^ (a & (b ^ c)))) + K1 + int64(x[6])))
        a = (a << 30u) | (a >> uint(32 - 30))
