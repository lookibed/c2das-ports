// M_SaveGame & Cie.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_DrawSave {
    var i : int
    V_DrawPatchDirect(72, 28, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_SAVEG"), int(anon_28.PU_CACHE))))
    for (i1 in range(int(anon_1033.load_end))) {
