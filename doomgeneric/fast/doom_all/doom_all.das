    var multi_pitch : int
    multi_pitch = doom_all__dest_pitch * 2
    bufp = doom_all__src_buffer + y1 * SCREENWIDTH + x1
    screenp = doom_all__dest_buffer + (y1 * doom_all__dest_pitch + x1) * 2
    screenp2 = screenp + doom_all__dest_pitch
    for (y in range(y1, y2)) {
        var sp : uint8?
        var sp2 : uint8?
        var bp : uint8?
        sp = screenp
        sp2 = screenp2
        bp = bufp
        for (x in range(x1, x2)) {
            var _t0 = sp
            sp++
            *_t0 = *bp
            var _t1 = sp
            sp++
            *_t1 = *bp
            var _t2 = sp2
            sp2++
            *_t2 = *bp
            var _t3 = sp2
            sp2++
            *_t3 = *bp
            bp++
        }
        screenp += multi_pitch
        screenp2 += multi_pitch
        bufp += SCREENWIDTH
    }
    return 1u
}

