    // fixed_t momx;
    doom_all__saveg_write32(str.momx)
    // fixed_t momy;
    doom_all__saveg_write32(str.momy)
    // fixed_t momz;
    doom_all__saveg_write32(str.momz)
    // int validcount;
    doom_all__saveg_write32(str.validcount)
    // mobjtype_t type;
    doom_all__saveg_write32(int(str._c_type))
    // mobjinfo_t* info;
    doom_all__saveg_writep(reinterpret<void?>(str.info))
    // int tics;
    doom_all__saveg_write32(str.tics)
    // state_t* state;
    doom_all__saveg_write32(int(int64(str.state - addr(states[0]))))
    // int flags;
    doom_all__saveg_write32(str.flags)
    // int health;
    doom_all__saveg_write32(str.health)
    // int movedir;
    doom_all__saveg_write32(str.movedir)
    // int movecount;
    doom_all__saveg_write32(str.movecount)
    // struct mobj_s* target;
    doom_all__saveg_writep(reinterpret<void?>(str.target))
    // int reactiontime;
    doom_all__saveg_write32(str.reactiontime)
    // int threshold;
    doom_all__saveg_write32(str.threshold)
    // struct player_s* player;
    if (str.player != null) {
        doom_all__saveg_write32(int(int64(str.player - addr(players[0])) + 1l))
    } else {
        doom_all__saveg_write32(0)
    }
    // int lastlook;
    doom_all__saveg_write32(str.lastlook)
    // mapthing_t spawnpoint;
    doom_all__saveg_write_mapthing_t(addr(str.spawnpoint))
    // struct mobj_s* tracer;
    doom_all__saveg_writep(reinterpret<void?>(str.tracer))
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_ticcmd_t(var str : ticcmd_t?) {
    // signed char forwardmove;
    str.forwardmove = int8(doom_all__saveg_read8())
    // signed char sidemove;
    str.sidemove = int8(doom_all__saveg_read8())
    // short angleturn;
    str.angleturn = doom_all__saveg_read16()
    // short consistancy;
    str.consistancy = uint8(doom_all__saveg_read16())
    // byte chatchar;
    str.chatchar = doom_all__saveg_read8()
    // byte buttons;
    str.buttons = doom_all__saveg_read8()
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_ticcmd_t(var str : ticcmd_t?) {
    // signed char forwardmove;
    doom_all__saveg_write8(uint8(str.forwardmove))
    // signed char sidemove;
    doom_all__saveg_write8(uint8(str.sidemove))
    // short angleturn;
    doom_all__saveg_write16(str.angleturn)
    // short consistancy;
    doom_all__saveg_write16(int16(str.consistancy))
    // byte chatchar;
