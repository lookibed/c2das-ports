    if (variable == null || variable.bound == 0 || (variable._c_type != default_type_t.DEFAULT_INT && variable._c_type != default_type_t.DEFAULT_INT_HEX)) {
        return 0
    }
    return *reinterpret<int?>(variable.location)
}

