// am_map.c:102: #define FTOM(x) FixedMul(((x)<<16),scale_ftom)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private FTOM(x) => FixedMul(x << 16, doom_all__scale_ftom)

// am_map.c:103: #define MTOF(x) (FixedMul((x),scale_mtof)>>16)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private MTOF(x) => FixedMul(x, doom_all__scale_mtof) >> 16

// am_map.c:105: #define CXMTOF(x) (f_x + MTOF((x)-m_x))
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private CXMTOF(x) => doom_all__f_x + MTOF(x - doom_all__m_x)

// am_map.c:106: #define CYMTOF(y) (f_y + (f_h - MTOF((y)-m_y)))
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private CYMTOF(y) => doom_all__f_y + (doom_all__f_h - MTOF(y - doom_all__m_y))

// am_map.c:1010: #define PUTDOT(xx,yy,cc) fb[(yy)*f_w+(xx)]=(cc)
[c_macro, c_function, unsafe_deref, hint(unsafe_range_check)]
def private PUTDOT(xx; yy; cc) {
    doom_all__fb[yy * doom_all__f_w + xx] = uint8(cc)
}

// sha1.c:93: #define rol(x,n) ( ((x) << (n)) | ((x) >> (32-(n))) )
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private rol(x; n) => (x << 5u) | (x >> uint(32 - n))

// i_video.c:384: #define GFX_RGB565_R(color) ((0xF800 & color) >> 11)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private GFX_RGB565_R(color) => (63488 & int(color)) >> 11

// i_video.c:385: #define GFX_RGB565_G(color) ((0x07E0 & color) >> 5)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private GFX_RGB565_G(color) => (2016 & int(color)) >> 5

// i_video.c:386: #define GFX_RGB565_B(color) (0x001F & color)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private GFX_RGB565_B(color) => 31 & int(color)

