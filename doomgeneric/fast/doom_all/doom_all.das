}

// The ticker is used to detect keys
// because of timing issues in netgames.
[unsafe_deref, hint(unsafe_range_check)]
def WI_Responder(var ev : event_t?) : uint {
    return 0u
}

// Draws "<Levelname> Finished!"
[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_drawLF {
    var y : int = WI_TITLEY
    if (gamemode != GameMode_t.commercial || doom_all__wbs.last < doom_all__NUMCMAPS) {
        // draw <LevelName>
        V_DrawPatch((SCREENWIDTH - int(doom_all__lnames[doom_all__wbs.last].width)) / 2, y, doom_all__lnames[doom_all__wbs.last])
        // draw "Finished!"
        y += (5 * int(doom_all__lnames[doom_all__wbs.last].height)) / 4
        V_DrawPatch((SCREENWIDTH - int(doom_all__finished.width)) / 2, y, doom_all__finished)
    } elif (doom_all__wbs.last == doom_all__NUMCMAPS) {
    } elif (doom_all__wbs.last > doom_all__NUMCMAPS) {
        // MAP33 - nothing is displayed!
        // > MAP33. Doom bombs out here with a Bad V_DrawPatch error.
        // I'm pretty sure that doom2.exe is just reading into random
        // bits of memory at this point, but let's try to be accurate
        // anyway. This deliberately triggers a V_DrawPatch error.
        var tmp : patch_t = patch_t(width = int16(SCREENWIDTH), height = int16(SCREENHEIGHT), leftoffset = int16(1), topoffset = int16(1),
                columnofs = fixed_array(0, 0, 0, 0, 0, 0, 0, 0))
        V_DrawPatch(0, y, addr(tmp))
    }
}

// Draws "Entering <LevelName>"
[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_drawEL {
    var y : int = WI_TITLEY
    // draw "Entering"
    V_DrawPatch((SCREENWIDTH - int(doom_all__entering.width)) / 2, y, doom_all__entering)
    // draw level
    y += (5 * int(doom_all__lnames[doom_all__wbs.next].height)) / 4
    V_DrawPatch((SCREENWIDTH - int(doom_all__lnames[doom_all__wbs.next].width)) / 2, y, doom_all__lnames[doom_all__wbs.next])
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_drawOnLnode(n : int; var c : patch_t ??) {
    var i : int
    var left : int
    var top : int
    var right : int
    var bottom : int
    var fits : uint = 0u
    i = 0
    c_do_while(fits == 0 && i != 2 && c[i] != null) {
        left = doom_all__lnodes[doom_all__wbs.epsd][n].x - int(c[i].leftoffset)
        top = doom_all__lnodes[doom_all__wbs.epsd][n].y - int(c[i].topoffset)
        right = left + int(c[i].width)
        bottom = top + int(c[i].height)
        if (left >= 0 && right < SCREENWIDTH && top >= 0 && bottom < SCREENHEIGHT) {
            fits = 1u
        } else {
            i++
        }
    }
    if (fits != 0 && i < 2) {
        V_DrawPatch(doom_all__lnodes[doom_all__wbs.epsd][n].x, doom_all__lnodes[doom_all__wbs.epsd][n].y, c[i])
    } else {
        // DEBUG
        fprintf(crt::c_stderr(), cstr("Could not place patch on level %d"), n + 1)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_initAnimatedBack {
    var i : int
    var a : wi_anim_t?
    if (gamemode == GameMode_t.commercial) {
        return
    }
    if (doom_all__wbs.epsd > 2) {
        return
    }
    i = 0
    while (i < doom_all__NUMANIMS[doom_all__wbs.epsd]) {
        a = addr(doom_all__wi_anims[doom_all__wbs.epsd][i])
        // init variables
        a.ctr = -1
        // specify the next time to draw it
        if (a._c_type == animenum_t.ANIM_ALWAYS) {
            a.nexttic = doom_all__bcnt + 1 + (M_Random() % a.period)
        } elif (a._c_type == animenum_t.ANIM_RANDOM) {
            a.nexttic = doom_all__bcnt + 1 + a.data2 + (M_Random() % a.data1)
        } elif (a._c_type == animenum_t.ANIM_LEVEL) {
            a.nexttic = doom_all__bcnt + 1
        }
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_updateAnimatedBack {
    var i : int
    var a : wi_anim_t?
    if (gamemode == GameMode_t.commercial) {
        return
    }
    if (doom_all__wbs.epsd > 2) {
        return
    }
    i = 0
    while (i < doom_all__NUMANIMS[doom_all__wbs.epsd]) {
        a = addr(doom_all__wi_anims[doom_all__wbs.epsd][i])
        if (doom_all__bcnt == a.nexttic) {
            c_switch(a._c_type) {
                case(animenum_t.ANIM_ALWAYS) {
                    a.ctr++
                    if (a.ctr >= a.nanims) {
                        a.ctr = 0
                    }
                    a.nexttic = doom_all__bcnt + a.period
                    break
                }
                case(animenum_t.ANIM_RANDOM) {
                    a.ctr++
                    if (a.ctr == a.nanims) {
                        a.ctr = -1
                        a.nexttic = doom_all__bcnt + a.data2 + (M_Random() % a.data1)
                    } else {
                        a.nexttic = doom_all__bcnt + a.period
                    }
                    break
                }
                case(animenum_t.ANIM_LEVEL) {
                    // gawd-awful hack for level anims
                    if (!(doom_all__state == stateenum_t.StatCount && i == 7) && doom_all__wbs.next == a.data1) {
                        a.ctr++
                        if (a.ctr == a.nanims) {
                            a.ctr--
                        }
                        a.nexttic = doom_all__bcnt + a.period
                    }
                    break
                }
            }
        }
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_drawAnimatedBack {
    var i : int
    var a : wi_anim_t?
    if (gamemode == GameMode_t.commercial) {
        return
    }
    if (doom_all__wbs.epsd > 2) {
        return
    }
    i = 0
    while (i < doom_all__NUMANIMS[doom_all__wbs.epsd]) {
        a = addr(doom_all__wi_anims[doom_all__wbs.epsd][i])
        if (a.ctr >= 0) {
            V_DrawPatch(a.loc.x, a.loc.y, a.p[a.ctr])
        }
        i++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_drawNum(var x : int; y : int; var n : int; var digits : int) : int {
    let fontwidth : int = int(doom_all__num[0].width)
    var neg : int
    var temp : int
    if (digits < 0) {
        if (n == 0) {
            // make variable-length zeros 1 digit long
            digits = 1
        } else {
            // figure out # of digits in #
            digits = 0
            temp = n
            while (temp != 0) {
                temp /= 10
                digits++
            }
        }
    }
    neg = int_of(n < 0)
    if (neg != 0) {
        n = -n
    }
    // if non-number, do not draw it
    if (n == 1994) {
        return 0
    }
    // draw the new number
    while (true) {
        let _t0 = digits
        digits--
        if (_t0 == 0) {
            break
        }
        x -= fontwidth
        V_DrawPatch(x, y, doom_all__num[n % 10])
        n /= 10
    }
    // draw a minus sign if necessary
    if (neg != 0) {
        x -= 8
        V_DrawPatch(x, y, doom_all__wiminus)
    }
    return x
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_drawPercent(x : int; y : int; p : int) {
    if (p < 0) {
        return
    }
    V_DrawPatch(x, y, doom_all__percent)
    WI_drawNum(x, y, p, -1)
}

// Display level completion time and par,
// or "sucks" message if overflow.
[unsafe_deref, hint(unsafe_range_check)]
def WI_drawTime(var x : int; y : int; t : int) {
    var div : int
    var n : int
    if (t < 0) {
        return
    }
    if (t <= 61 * 59) {
        div = 1
        c_do_while(t / div != 0) {
            n = (t / div) % 60
            x = WI_drawNum(x, y, n, 2) - int(doom_all__colon.width)
            div *= 60
            // draw
            if (div == 60 || t / div != 0) {
                V_DrawPatch(x, y, doom_all__colon)
            }
        }
    } else {
        // "sucks"
        V_DrawPatch(x - int(doom_all__sucks.width), y, doom_all__sucks)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_End {
    WI_unloadData()
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_initNoState {
    doom_all__state = stateenum_t.NoState
    doom_all__acceleratestage = 0
    doom_all__cnt = 10
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_updateNoState {
    WI_updateAnimatedBack()
    doom_all__cnt--
    if (doom_all__cnt == 0) {
        // Don't call WI_End yet. G_WorldDone doesnt immediately
        // change gamestate, so WI_Drawer is still going to get
        // run until that happens. If we do that after WI_End
        // (which unloads all the graphics), we're in trouble.
        // WI_End();
        G_WorldDone()
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_initShowNextLoc {
    doom_all__state = stateenum_t.ShowNextLoc
    doom_all__acceleratestage = 0
    doom_all__cnt = SHOWNEXTLOCDELAY * TICRATE
    WI_initAnimatedBack()
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_updateShowNextLoc {
    WI_updateAnimatedBack()
    doom_all__cnt--
    if (doom_all__cnt == 0 || doom_all__acceleratestage != 0) {
        WI_initNoState()
    } else {
        doom_all__snl_pointeron = uint(int_of((doom_all__cnt & 31) < 20))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_drawShowNextLoc {
    var i : int
    var last : int
    WI_slamBackground()
    // draw animated background
    WI_drawAnimatedBack()
    if (gamemode != GameMode_t.commercial) {
        if (doom_all__wbs.epsd > 2) {
            WI_drawEL()
            return
        }
        last = (doom_all__wbs.last == 8) ? doom_all__wbs.next - 1 : doom_all__wbs.last
        // draw a splat on taken cities.
        i = 0
        while (i <= last) {
            WI_drawOnLnode(i, addr(doom_all__splat[0]))
            i++
        }
        // splat the secret level?
        if (doom_all__wbs.didsecret != 0) {
            WI_drawOnLnode(8, addr(doom_all__splat[0]))
        }
        // draw flashing ptr
        if (doom_all__snl_pointeron != 0) {
            WI_drawOnLnode(doom_all__wbs.next, addr(doom_all__yah[0]))
        }
    }
    // draws which level you are entering..
    if ((gamemode != GameMode_t.commercial) || doom_all__wbs.next != 30) {
        WI_drawEL()
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_drawNoState {
    doom_all__snl_pointeron = 1u
    WI_drawShowNextLoc()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_fragSum(playernum : int) : int {
    var frags : int = 0
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] != 0 && i != playernum) {
            frags += doom_all__plrs[playernum].frags[i]
        }
    }
    // JDC hack - negative frags.
    frags -= doom_all__plrs[playernum].frags[playernum]
    // UNUSED if (frags < 0)
    // frags = 0;
    return frags
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_initDeathmatchStats {
    doom_all__state = stateenum_t.StatCount
    doom_all__acceleratestage = 0
    doom_all__dm_state = 1
    doom_all__cnt_pause = TICRATE
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] != 0) {
            for (j in range(MAXPLAYERS)) {
                if (playeringame[j] != 0) {
                    doom_all__dm_frags[i][j] = 0
                }
            }
            doom_all__dm_totals[i] = 0
        }
    }
    WI_initAnimatedBack()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_updateDeathmatchStats {
    var stillticking : uint
    WI_updateAnimatedBack()
    if (doom_all__acceleratestage != 0 && doom_all__dm_state != 4) {
        doom_all__acceleratestage = 0
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] != 0) {
                for (j in range(MAXPLAYERS)) {
                    if (playeringame[j] != 0) {
                        doom_all__dm_frags[i][j] = doom_all__plrs[i].frags[j]
                    }
                }
                doom_all__dm_totals[i] = WI_fragSum(i)
            }
        }
        S_StartSound(null, int(sfxenum_t.sfx_barexp))
        doom_all__dm_state = 4
    }
    if (doom_all__dm_state == 2) {
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = 0u
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] != 0) {
                for (j in range(MAXPLAYERS)) {
                    if (playeringame[j] != 0 && doom_all__dm_frags[i][j] != doom_all__plrs[i].frags[j]) {
                        if (doom_all__plrs[i].frags[j] < 0) {
                            doom_all__dm_frags[i][j]--
                        } else {
                            doom_all__dm_frags[i][j]++
                        }
                        if (doom_all__dm_frags[i][j] > 99) {
                            doom_all__dm_frags[i][j] = 99
                        }
                        if (doom_all__dm_frags[i][j] < -99) {
                            doom_all__dm_frags[i][j] = -99
                        }
                        stillticking = 1u
                    }
                }
                doom_all__dm_totals[i] = WI_fragSum(i)
                if (doom_all__dm_totals[i] > 99) {
                    doom_all__dm_totals[i] = 99
                }
                if (doom_all__dm_totals[i] < -99) {
                    doom_all__dm_totals[i] = -99
                }
            }
        }
        if (stillticking == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            doom_all__dm_state++
        }
    } elif (doom_all__dm_state == 4) {
        if (doom_all__acceleratestage != 0) {
            S_StartSound(null, int(sfxenum_t.sfx_slop))
            if (gamemode == GameMode_t.commercial) {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif ((doom_all__dm_state & 1) != 0) {
        doom_all__cnt_pause--
        if (doom_all__cnt_pause == 0) {
            doom_all__dm_state++
            doom_all__cnt_pause = TICRATE
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_drawDeathmatchStats {
    var x : int
    var y : int
    var w : int
    WI_slamBackground()
    // draw animated background
    WI_drawAnimatedBack()
    WI_drawLF()
    // draw stat titles (top line)
    V_DrawPatch(DM_TOTALSX - int(doom_all__total.width) / 2, DM_MATRIXY - WI_SPACINGY + 10, doom_all__total)
    V_DrawPatch(DM_KILLERSX, DM_KILLERSY, doom_all__killers)
    V_DrawPatch(DM_VICTIMSX, DM_VICTIMSY, doom_all__victims)
    // draw P?
    x = DM_MATRIXX + DM_SPACINGX
    y = DM_MATRIXY
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] != 0) {
            V_DrawPatch(x - int(doom_all__p[i].width) / 2, DM_MATRIXY - WI_SPACINGY, doom_all__p[i])
            V_DrawPatch(DM_MATRIXX - int(doom_all__p[i].width) / 2, y, doom_all__p[i])
            if (i == doom_all__me) {
                V_DrawPatch(x - int(doom_all__p[i].width) / 2, DM_MATRIXY - WI_SPACINGY, doom_all__bstar)
                V_DrawPatch(DM_MATRIXX - int(doom_all__p[i].width) / 2, y, doom_all__star)
            }
        } else {
        }
        // V_DrawPatch(x-SHORT(bp[i]->width)/2,
        // DM_MATRIXY - WI_SPACINGY, bp[i]);
        // V_DrawPatch(DM_MATRIXX-SHORT(bp[i]->width)/2,
        // y, bp[i]);
        x += DM_SPACINGX
        y += WI_SPACINGY
    }
    // draw stats
    y = DM_MATRIXY + 10
    w = int(doom_all__num[0].width)
    for (i in range(MAXPLAYERS)) {
        x = DM_MATRIXX + DM_SPACINGX
        if (playeringame[i] != 0) {
            for (j in range(MAXPLAYERS)) {
                if (playeringame[j] != 0) {
                    WI_drawNum(x + w, y, doom_all__dm_frags[i][j], 2)
                }
                x += DM_SPACINGX
            }
            WI_drawNum(DM_TOTALSX + w, y, doom_all__dm_totals[i], 2)
        }
        y += WI_SPACINGY
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_initNetgameStats {
    doom_all__state = stateenum_t.StatCount
    doom_all__acceleratestage = 0
    doom_all__ng_state = 1
    doom_all__cnt_pause = TICRATE
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] == 0) {
            continue
        }
        doom_all__cnt_frags[i] = 0
        doom_all__cnt_secret[i] = doom_all__cnt_frags[i]
        doom_all__cnt_items[i] = doom_all__cnt_secret[i]
        doom_all__cnt_kills[i] = doom_all__cnt_items[i]
        doom_all__dofrags += WI_fragSum(i)
    }
    doom_all__dofrags = int_of(doom_all__dofrags != 0)
    WI_initAnimatedBack()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_updateNetgameStats {
    var fsum : int
    var stillticking : uint
    WI_updateAnimatedBack()
    if (doom_all__acceleratestage != 0 && doom_all__ng_state != 10) {
        doom_all__acceleratestage = 0
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] == 0) {
                continue
            }
            doom_all__cnt_kills[i] = (doom_all__plrs[i].skills * 100) / doom_all__wbs.maxkills
            doom_all__cnt_items[i] = (doom_all__plrs[i].sitems * 100) / doom_all__wbs.maxitems
            doom_all__cnt_secret[i] = (doom_all__plrs[i].ssecret * 100) / doom_all__wbs.maxsecret
            if (doom_all__dofrags != 0) {
                doom_all__cnt_frags[i] = WI_fragSum(i)
            }
        }
        S_StartSound(null, int(sfxenum_t.sfx_barexp))
        doom_all__ng_state = 10
    }
    if (doom_all__ng_state == 2) {
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = 0u
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] == 0) {
                continue
            }
            doom_all__cnt_kills[i] += 2
            if (doom_all__cnt_kills[i] >= (doom_all__plrs[i].skills * 100) / doom_all__wbs.maxkills) {
                doom_all__cnt_kills[i] = (doom_all__plrs[i].skills * 100) / doom_all__wbs.maxkills
            } else {
                stillticking = 1u
            }
        }
        if (stillticking == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            doom_all__ng_state++
        }
    } elif (doom_all__ng_state == 4) {
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = 0u
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] == 0) {
                continue
            }
            doom_all__cnt_items[i] += 2
            if (doom_all__cnt_items[i] >= (doom_all__plrs[i].sitems * 100) / doom_all__wbs.maxitems) {
                doom_all__cnt_items[i] = (doom_all__plrs[i].sitems * 100) / doom_all__wbs.maxitems
            } else {
                stillticking = 1u
            }
        }
        if (stillticking == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            doom_all__ng_state++
        }
    } elif (doom_all__ng_state == 6) {
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = 0u
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] == 0) {
                continue
            }
            doom_all__cnt_secret[i] += 2
            if (doom_all__cnt_secret[i] >= (doom_all__plrs[i].ssecret * 100) / doom_all__wbs.maxsecret) {
                doom_all__cnt_secret[i] = (doom_all__plrs[i].ssecret * 100) / doom_all__wbs.maxsecret
            } else {
                stillticking = 1u
            }
        }
        if (stillticking == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            doom_all__ng_state += 1 + 2 * int_of(doom_all__dofrags == 0)
        }
    } elif (doom_all__ng_state == 8) {
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = 0u
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] == 0) {
                continue
            }
            doom_all__cnt_frags[i] += 1
            fsum = WI_fragSum(i)
            if (doom_all__cnt_frags[i] >= fsum) {
                doom_all__cnt_frags[i] = fsum
            } else {
                stillticking = 1u
            }
        }
        if (stillticking == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pldeth))
            doom_all__ng_state++
        }
    } elif (doom_all__ng_state == 10) {
        if (doom_all__acceleratestage != 0) {
            S_StartSound(null, int(sfxenum_t.sfx_sgcock))
            if (gamemode == GameMode_t.commercial) {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif ((doom_all__ng_state & 1) != 0) {
        doom_all__cnt_pause--
        if (doom_all__cnt_pause == 0) {
            doom_all__ng_state++
            doom_all__cnt_pause = TICRATE
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_drawNetgameStats {
    var x : int
    var y : int
    let pwidth : int = int(doom_all__percent.width)
    WI_slamBackground()
    // draw animated background
    WI_drawAnimatedBack()
    WI_drawLF()
    // draw stat titles (top line)
    V_DrawPatch(32 + int(doom_all__star.width) / 2 + 32 * int_of(doom_all__dofrags == 0) + NG_SPACINGX - int(doom_all__kills.width), NG_STATSY, doom_all__kills)
    V_DrawPatch(32 + int(doom_all__star.width) / 2 + 32 * int_of(doom_all__dofrags == 0) + 2 * NG_SPACINGX - int(doom_all__items.width), NG_STATSY,
            doom_all__items)
    V_DrawPatch(32 + int(doom_all__star.width) / 2 + 32 * int_of(doom_all__dofrags == 0) + 3 * NG_SPACINGX - int(doom_all__secret.width), NG_STATSY,
            doom_all__secret)
    if (doom_all__dofrags != 0) {
        V_DrawPatch(32 + int(doom_all__star.width) / 2 + 32 * int_of(doom_all__dofrags == 0) + 4 * NG_SPACINGX - int(doom_all__frags.width), NG_STATSY,
                doom_all__frags)
    }
    // draw stats
    y = NG_STATSY + int(doom_all__kills.height)
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] == 0) {
            continue
        }
        x = 32 + int(doom_all__star.width) / 2 + 32 * int_of(doom_all__dofrags == 0)
        V_DrawPatch(x - int(doom_all__p[i].width), y, doom_all__p[i])
        if (i == doom_all__me) {
            V_DrawPatch(x - int(doom_all__p[i].width), y, doom_all__star)
        }
        x += NG_SPACINGX
        WI_drawPercent(x - pwidth, y + 10, doom_all__cnt_kills[i])
        x += NG_SPACINGX
        WI_drawPercent(x - pwidth, y + 10, doom_all__cnt_items[i])
        x += NG_SPACINGX
        WI_drawPercent(x - pwidth, y + 10, doom_all__cnt_secret[i])
        x += NG_SPACINGX
        if (doom_all__dofrags != 0) {
            WI_drawNum(x, y + 10, doom_all__cnt_frags[i], -1)
        }
        y += WI_SPACINGY
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_initStats {
    doom_all__state = stateenum_t.StatCount
    doom_all__acceleratestage = 0
    doom_all__sp_state = 1
    doom_all__cnt_secret[0] = -1
    doom_all__cnt_items[0] = doom_all__cnt_secret[0]
    doom_all__cnt_kills[0] = doom_all__cnt_items[0]
    doom_all__cnt_par = -1
    doom_all__cnt_time = doom_all__cnt_par
    doom_all__cnt_pause = TICRATE
    WI_initAnimatedBack()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_updateStats {
    WI_updateAnimatedBack()
    if (doom_all__acceleratestage != 0 && doom_all__sp_state != 10) {
        doom_all__acceleratestage = 0
        doom_all__cnt_kills[0] = (doom_all__plrs[doom_all__me].skills * 100) / doom_all__wbs.maxkills
        doom_all__cnt_items[0] = (doom_all__plrs[doom_all__me].sitems * 100) / doom_all__wbs.maxitems
        doom_all__cnt_secret[0] = (doom_all__plrs[doom_all__me].ssecret * 100) / doom_all__wbs.maxsecret
        doom_all__cnt_time = doom_all__plrs[doom_all__me].stime / TICRATE
        doom_all__cnt_par = doom_all__wbs.partime / TICRATE
        S_StartSound(null, int(sfxenum_t.sfx_barexp))
        doom_all__sp_state = 10
    }
    if (doom_all__sp_state == 2) {
        doom_all__cnt_kills[0] += 2
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        if (doom_all__cnt_kills[0] >= (doom_all__plrs[doom_all__me].skills * 100) / doom_all__wbs.maxkills) {
            doom_all__cnt_kills[0] = (doom_all__plrs[doom_all__me].skills * 100) / doom_all__wbs.maxkills
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            doom_all__sp_state++
        }
    } elif (doom_all__sp_state == 4) {
        doom_all__cnt_items[0] += 2
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        if (doom_all__cnt_items[0] >= (doom_all__plrs[doom_all__me].sitems * 100) / doom_all__wbs.maxitems) {
            doom_all__cnt_items[0] = (doom_all__plrs[doom_all__me].sitems * 100) / doom_all__wbs.maxitems
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            doom_all__sp_state++
        }
    } elif (doom_all__sp_state == 6) {
        doom_all__cnt_secret[0] += 2
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        if (doom_all__cnt_secret[0] >= (doom_all__plrs[doom_all__me].ssecret * 100) / doom_all__wbs.maxsecret) {
            doom_all__cnt_secret[0] = (doom_all__plrs[doom_all__me].ssecret * 100) / doom_all__wbs.maxsecret
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            doom_all__sp_state++
        }
    } elif (doom_all__sp_state == 8) {
        if ((doom_all__bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        doom_all__cnt_time += 3
        if (doom_all__cnt_time >= doom_all__plrs[doom_all__me].stime / TICRATE) {
            doom_all__cnt_time = doom_all__plrs[doom_all__me].stime / TICRATE
        }
        doom_all__cnt_par += 3
        if (doom_all__cnt_par >= doom_all__wbs.partime / TICRATE) {
            doom_all__cnt_par = doom_all__wbs.partime / TICRATE
            if (doom_all__cnt_time >= doom_all__plrs[doom_all__me].stime / TICRATE) {
                S_StartSound(null, int(sfxenum_t.sfx_barexp))
                doom_all__sp_state++
            }
        }
    } elif (doom_all__sp_state == 10) {
        if (doom_all__acceleratestage != 0) {
            S_StartSound(null, int(sfxenum_t.sfx_sgcock))
            if (gamemode == GameMode_t.commercial) {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif ((doom_all__sp_state & 1) != 0) {
        doom_all__cnt_pause--
        if (doom_all__cnt_pause == 0) {
            doom_all__sp_state++
            doom_all__cnt_pause = TICRATE
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_drawStats {
    // line height
    var lh : int
    lh = (3 * int(doom_all__num[0].height)) / 2
    WI_slamBackground()
    // draw animated background
    WI_drawAnimatedBack()
    WI_drawLF()
    V_DrawPatch(SP_STATSX, SP_STATSY, doom_all__kills)
    WI_drawPercent(SCREENWIDTH - SP_STATSX, SP_STATSY, doom_all__cnt_kills[0])
    V_DrawPatch(SP_STATSX, SP_STATSY + lh, doom_all__items)
    WI_drawPercent(SCREENWIDTH - SP_STATSX, SP_STATSY + lh, doom_all__cnt_items[0])
    V_DrawPatch(SP_STATSX, SP_STATSY + 2 * lh, doom_all__sp_secret)
    WI_drawPercent(SCREENWIDTH - SP_STATSX, SP_STATSY + 2 * lh, doom_all__cnt_secret[0])
    V_DrawPatch(SP_TIMEX, SP_TIMEY, doom_all__timepatch)
    WI_drawTime(SCREENWIDTH / 2 - SP_TIMEX, SP_TIMEY, doom_all__cnt_time)
    if (doom_all__wbs.epsd < 3) {
        V_DrawPatch(SCREENWIDTH / 2 + SP_TIMEX, SP_TIMEY, doom_all__par)
        WI_drawTime(SCREENWIDTH - SP_TIMEX, SP_TIMEY, doom_all__cnt_par)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_checkForAccelerate {
    var i : int
    var player : player_s?
    // check for button presses to skip delays
    i = 0
    player = addr(players[0])
    while (i < MAXPLAYERS) {
        if (playeringame[i] != 0) {
            if ((int(player.cmd.buttons) & int(buttoncode_t.BT_ATTACK)) != 0) {
                if (player.attackdown == 0) {
                    doom_all__acceleratestage = 1
                }
                player.attackdown = 1
            } else {
                player.attackdown = 0
            }
            if ((int(player.cmd.buttons) & int(buttoncode_t.BT_USE)) != 0) {
                if (player.usedown == 0) {
                    doom_all__acceleratestage = 1
                }
                player.usedown = 1
            } else {
                player.usedown = 0
            }
        }
        i++
        player++
    }
}

// Updates stuff each tick
[unsafe_deref, hint(unsafe_range_check)]
def WI_Ticker {
    // counter for general background animation
    doom_all__bcnt++
    if (doom_all__bcnt == 1) {
        // intermission music
        if (gamemode == GameMode_t.commercial) {
            S_ChangeMusic(int(musicenum_t.mus_dm2int), 1)
        } else {
            S_ChangeMusic(int(musicenum_t.mus_inter), 1)
        }
    }
    WI_checkForAccelerate()
    c_switch(doom_all__state) {
        case(stateenum_t.StatCount) {
            if (deathmatch != 0) {
                WI_updateDeathmatchStats()
            } elif (netgame != 0) {
                WI_updateNetgameStats()
            } else {
                WI_updateStats()
            }
            break
        }
        case(stateenum_t.ShowNextLoc) {
            WI_updateShowNextLoc()
            break
        }
        case(stateenum_t.NoState) {
            WI_updateNoState()
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WI_loadUnloadData(callback : function<(var a0 : uint8?; var a1 : patch_t ??) : void>) {
    var i : int
    var j : int
    var name : uint8[9]
    var a : wi_anim_t?
    if (gamemode == GameMode_t.commercial) {
        i = 0
        while (i < doom_all__NUMCMAPS) {
            snprintf(addr(name[0]), 9ul, cstr("CWILV%2.2d"), i)
            invoke(callback, addr(name[0]), addr(doom_all__lnames[i]))
            i++
        }
    } else {
        for (i1 in range(NUMMAPS)) {
            snprintf(addr(name[0]), 9ul, cstr("WILV%d%d"), doom_all__wbs.epsd, i1)
            invoke(callback, addr(name[0]), addr(doom_all__lnames[i1]))
        }
        // you are here
        invoke(callback, cstr("WIURH0"), addr(doom_all__yah[0]))
        // you are here (alt.)
        invoke(callback, cstr("WIURH1"), addr(doom_all__yah[1]))
        // splat
        invoke(callback, cstr("WISPLAT"), addr(doom_all__splat[0]))
        if (doom_all__wbs.epsd < 3) {
            j = 0
            while (j < doom_all__NUMANIMS[doom_all__wbs.epsd]) {
                a = addr(doom_all__wi_anims[doom_all__wbs.epsd][j])
                i = 0
                while (i < a.nanims) {
                    // MONDO HACK!
                    if (doom_all__wbs.epsd != 1 || j != 8) {
                        // animations
                        snprintf(addr(name[0]), 9ul, cstr("WIA%d%.2d%.2d"), doom_all__wbs.epsd, j, i)
                        invoke(callback, addr(name[0]), addr(a.p[0]) + end_index(i, 3))
                    } else {
                        // HACK ALERT!
                        a.p[i] = doom_all__wi_anims[1][4].p[i]
                    }
                    i++
                }
                j++
            }
        }
    }
    // More hacks on minus sign.
    invoke(callback, cstr("WIMINUS"), addr(doom_all__wiminus))
    for (i1 in range(10)) {
        // numbers 0-9
        snprintf(addr(name[0]), 9ul, cstr("WINUM%d"), i1)
        invoke(callback, addr(name[0]), addr(doom_all__num[0]) + end_index(i1, 10))
    }
    // percent sign
    invoke(callback, cstr("WIPCNT"), addr(doom_all__percent))
    // "finished"
    invoke(callback, cstr("WIF"), addr(doom_all__finished))
    // "entering"
    invoke(callback, cstr("WIENTER"), addr(doom_all__entering))
    // "kills"
    invoke(callback, cstr("WIOSTK"), addr(doom_all__kills))
    // "scrt"
    invoke(callback, cstr("WIOSTS"), addr(doom_all__secret))
    // "secret"
    invoke(callback, cstr("WISCRT2"), addr(doom_all__sp_secret))
    // french wad uses WIOBJ (?)
    if (W_CheckNumForName(cstr("WIOBJ")) >= 0) {
        // "items"
        if (netgame != 0 && deathmatch == 0) {
            invoke(callback, cstr("WIOBJ"), addr(doom_all__items))
        } else {
            invoke(callback, cstr("WIOSTI"), addr(doom_all__items))
        }
    } else {
        invoke(callback, cstr("WIOSTI"), addr(doom_all__items))
    }
    // "frgs"
    invoke(callback, cstr("WIFRGS"), addr(doom_all__frags))
    // ":"
    invoke(callback, cstr("WICOLON"), addr(doom_all__colon))
    // "time"
    invoke(callback, cstr("WITIME"), addr(doom_all__timepatch))
    // "sucks"
    invoke(callback, cstr("WISUCKS"), addr(doom_all__sucks))
    // "par"
    invoke(callback, cstr("WIPAR"), addr(doom_all__par))
    // "killers" (vertical)
    invoke(callback, cstr("WIKILRS"), addr(doom_all__killers))
    // "victims" (horiz)
    invoke(callback, cstr("WIVCTMS"), addr(doom_all__victims))
    // "total"
    invoke(callback, cstr("WIMSTT"), addr(doom_all__total))
    for (i1 in range(MAXPLAYERS)) {
        // "1,2,3,4"
        snprintf(addr(name[0]), 9ul, cstr("STPB%d"), i1)
        invoke(callback, addr(name[0]), addr(doom_all__p[0]) + end_index(i1, 4))
        // "1,2,3,4"
        snprintf(addr(name[0]), 9ul, cstr("WIBP%d"), i1 + 1)
        invoke(callback, addr(name[0]), addr(doom_all__bp[0]) + end_index(i1, 4))
    }
    // Background image
    if (gamemode == GameMode_t.commercial) {
        M_StringCopy(addr(name[0]), cstr("INTERPIC"), uint64(typeinfo sizeof(type<uint8[9]>)))
    } elif (gamemode == GameMode_t.retail && doom_all__wbs.epsd == 3) {
        M_StringCopy(addr(name[0]), cstr("INTERPIC"), uint64(typeinfo sizeof(type<uint8[9]>)))
    } else {
        snprintf(addr(name[0]), uint64(typeinfo sizeof(type<uint8[9]>)), cstr("WIMAP%d"), doom_all__wbs.epsd)
    }
    // Draw backdrop and save to a temporary buffer
    invoke(callback, addr(name[0]), addr(doom_all__background))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WI_loadCallback(var name : uint8?; var variable : patch_t ??) {
    *variable = reinterpret<patch_t?>(W_CacheLumpName(name, int(anon_28.PU_STATIC)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_loadData {
    if (gamemode == GameMode_t.commercial) {
        doom_all__NUMCMAPS = 32
        doom_all__lnames = reinterpret<patch_t ??>(Z_Malloc(int(uint64(typeinfo sizeof(type<patch_t?>)) * uint64(doom_all__NUMCMAPS)), int(anon_28.PU_STATIC),
                null))
    } else {
        doom_all__lnames = reinterpret<patch_t ??>(Z_Malloc(int(uint64(typeinfo sizeof(type<patch_t?>)) * uint64(NUMMAPS)), int(anon_28.PU_STATIC), null))
    }
    doom_all__WI_loadUnloadData(@@doom_all__WI_loadCallback)
    // These two graphics are special cased because we're sharing
    // them with the status bar code
    // your face
    doom_all__star = reinterpret<patch_t?>(W_CacheLumpName(cstr("STFST01"), int(anon_28.PU_STATIC)))
    // dead face
    doom_all__bstar = reinterpret<patch_t?>(W_CacheLumpName(cstr("STFDEAD0"), int(anon_28.PU_STATIC)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WI_unloadCallback(var name : uint8?; var variable : patch_t ??) {
    W_ReleaseLumpName(name)
    *variable = null
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_unloadData {
    doom_all__WI_loadUnloadData(@@doom_all__WI_unloadCallback)
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_Drawer {
    c_switch(doom_all__state) {
        case(stateenum_t.StatCount) {
            if (deathmatch != 0) {
                WI_drawDeathmatchStats()
            } elif (netgame != 0) {
                WI_drawNetgameStats()
            } else {
                WI_drawStats()
            }
            break
        }
        case(stateenum_t.ShowNextLoc) {
            WI_drawShowNextLoc()
            break
        }
        case(stateenum_t.NoState) {
            WI_drawNoState()
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def WI_initVariables(var wbstartstruct : wbstartstruct_t?) {
    doom_all__wbs = wbstartstruct
    doom_all__acceleratestage = 0
    doom_all__bcnt = 0
    doom_all__cnt = doom_all__bcnt
    doom_all__firstrefresh = 1
    doom_all__me = doom_all__wbs.pnum
    doom_all__plrs = addr(doom_all__wbs.plyr[0])
    if (doom_all__wbs.maxkills == 0) {
        doom_all__wbs.maxkills = 1
    }
    if (doom_all__wbs.maxitems == 0) {
        doom_all__wbs.maxitems = 1
    }
    if (doom_all__wbs.maxsecret == 0) {
        doom_all__wbs.maxsecret = 1
    }
    if (gamemode != GameMode_t.retail) {
        if (doom_all__wbs.epsd > 2) {
            doom_all__wbs.epsd -= 3
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def WI_Start(var wbstartstruct : wbstartstruct_t?) {
    WI_initVariables(wbstartstruct)
    WI_loadData()
    if (deathmatch != 0) {
        WI_initDeathmatchStats()
    } elif (netgame != 0) {
        WI_initNetgameStats()
    } else {
        WI_initStats()
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GetFileNumber(var handle : _wad_file_s?) : int {
    var result : int
    for (i in range(doom_all__num_open_wadfiles)) {
        if (doom_all__open_wadfiles[i] == handle) {
            return i
        }
    }
    // Not found in list. This is a new file we haven't seen yet.
    // Allocate another slot for this file.
    doom_all__open_wadfiles = reinterpret<_wad_file_s ??>(crt::realloc(reinterpret<void?>(doom_all__open_wadfiles),
            uint64(typeinfo sizeof(type<_wad_file_s?>)) * uint64(doom_all__num_open_wadfiles + 1)))
    doom_all__open_wadfiles[doom_all__num_open_wadfiles] = handle
    result = doom_all__num_open_wadfiles
    doom_all__num_open_wadfiles++
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ChecksumAddLump(var sha1_context : sha1_context_s?; var lump : lumpinfo_s?) {
    var buf : uint8[9]
    M_StringCopy(addr(buf[0]), addr(lump.name[0]), uint64(typeinfo sizeof(type<uint8[9]>)))
    SHA1_UpdateString(sha1_context, addr(buf[0]))
    SHA1_UpdateInt32(sha1_context, uint(doom_all__GetFileNumber(lump.wad_file)))
    SHA1_UpdateInt32(sha1_context, uint(lump.position))
    SHA1_UpdateInt32(sha1_context, uint(lump.size))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_Checksum(var digest : uint8?) {
    var sha1_context : sha1_context_s
    SHA1_Init(addr(sha1_context))
    doom_all__num_open_wadfiles = 0
    // Go through each entry in the WAD directory, adding information
    // about each entry to the SHA1 hash.
    for (i in urange(numlumps)) {
        doom_all__ChecksumAddLump(addr(sha1_context), addr(lumpinfo[i]))
    }
    SHA1_Final(digest, addr(sha1_context))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_OpenFile(var path : uint8?) : _wad_file_s? {
    var result : _wad_file_s?
    var i : int
    // !
    // Use the OS's virtual memory subsystem to map WAD files
    // directly into memory.
    if (M_CheckParm(cstr("-mmap")) == 0) {
        return invoke(stdc_wad_file.OpenFile, path)
    }
    // Try all classes in order until we find one that works
    result = null
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<wad_file_class_t? [1]>)) / uint64(typeinfo sizeof(type<wad_file_class_t?>))) {
        result = invoke(doom_all__wad_file_classes[i].OpenFile, path)
        if (result != null) {
            break
        }
        i++
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def W_CloseFile(var wad : _wad_file_s?) {
    invoke(wad.file_class.CloseFile, wad)
}

[unsafe_deref, hint(unsafe_range_check)]
def W_Read(var wad : _wad_file_s?; offset : uint; var buffer : void?; buffer_len : uint64) : uint64 {
    return invoke(wad.file_class.Read, wad, offset, buffer, buffer_len)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_ParseCommandLine : uint {
    var modifiedgame : uint = 0u
    var p : int
    // Merged PWADs are loaded first, because they are supposed to be
    // modified IWADs.
    // !
    // @arg <files>
    // @category mod
    // Simulates the behavior of deutex's -merge option, merging a PWAD
    // into the main IWAD. Multiple files may be specified.
    // NWT-style merging:
    // NWT's -merge option:
    // !
    // @arg <files>
    // @category mod
    // Simulates the behavior of NWT's -merge option. Multiple files
    // may be specified.
    // Add flats
    // !
    // @arg <files>
    // @category mod
    // Simulates the behavior of NWT's -af option, merging flats into
    // the main IWAD directory. Multiple files may be specified.
    // !
    // @arg <files>
    // @category mod
    // Simulates the behavior of NWT's -as option, merging sprites
    // into the main IWAD directory. Multiple files may be specified.
    // !
    // @arg <files>
    // @category mod
    // Equivalent to "-af <files> -as <files>".
    // !
    // @arg <files>
    // @vanilla
    // Load the specified PWAD files.
    p = M_CheckParmWithArgs(cstr("-file"), 1)
    if (p != 0) {
        // the parms after p are wadfile/lump names,
        // until end of parms or another - preceded parm
        // homebrew levels
        modifiedgame = 1u
        while (true) {
            p++
            if (!(p != myargc && myargv[p][0] != '-')) {
                break
            }
            var filename : uint8?
            filename = D_TryFindWADByName(myargv[p])
            fprintf(crt::c_stderr(), cstr(" adding %s\n"), filename)
            W_AddFile(filename)
        }
    }
    // W_PrintDirectory();
    return modifiedgame
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_LumpNameHash(var s : uint8?) : uint {
    // This is the djb2 string hash function, modded to work on strings
    // that have a maximum length of 8.
    var result : uint = 5381u
    var i : uint
    i = 0u
    while (i < 8u && s[i] != '\0') {
        result = ((result << 5u) ^ result) ^ uint(crt::toupper(int(s[i])))
        i++
    }
    return result
}

// Increase the size of the lumpinfo[] array to the specified size.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ExtendLumpInfo(newnumlumps : int) {
    var newlumpinfo : lumpinfo_s?
    var i : uint
    newlumpinfo = reinterpret<lumpinfo_s?>(crt::calloc(uint64(newnumlumps), uint64(typeinfo sizeof(type<lumpinfo_s>))))
    if (newlumpinfo == null) {
        I_Error`va(cstr("Couldn't realloc lumpinfo"), VaNone())
    }
    // Copy over lumpinfo_t structures from the old array. If any of
    // these lumps have been cached, we need to update the user
    // pointers to the new location.
    i = 0u
    while (i < numlumps && i < uint(newnumlumps)) {
        crt::memcpy(reinterpret<void?>(addr(newlumpinfo[i])), reinterpret<void?>(addr(lumpinfo[i])), uint64(typeinfo sizeof(type<lumpinfo_s>)))
        if (newlumpinfo[i].cache != null) {
            Z_ChangeUser(newlumpinfo[i].cache, addr(newlumpinfo[i].cache))
        }
        // We shouldn't be generating a hash table until after all WADs have
        // been loaded, but just in case...
        if (lumpinfo[i].next != null) {
            let nextlumpnum : int = int(int64(lumpinfo[i].next - lumpinfo))
            newlumpinfo[i].next = addr(newlumpinfo[nextlumpnum])
        }
        i++
    }
    // All done.
    crt::free(reinterpret<void?>(lumpinfo))
    lumpinfo = newlumpinfo
    numlumps = uint(newnumlumps)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_AddFile(var filename : uint8?) : _wad_file_s? {
    var header : wadinfo_t
    var lump_p : lumpinfo_s?
    var wad_file : _wad_file_s?
    var length : int
    var startlump : int
    var fileinfo : filelump_t?
    var filerover : filelump_t?
    var newnumlumps : int
    // open the file and add to directory
    wad_file = W_OpenFile(filename)
    if (wad_file == null) {
        fprintf(crt::c_stderr(), cstr(" couldn't open %s\n"), filename)
        return null
    }
    newnumlumps = int(numlumps)
    if (crt::strcasecmp(filename + crt::strlen(filename) + -(3), cstr("wad")) != 0) {
        // single lump file
        // fraggle: Swap the filepos and size here. The WAD directory
        // parsing code expects a little-endian directory, so will swap
        // them back. Effectively we're constructing a "fake WAD directory"
        // here, as it would appear on disk.
        fileinfo = reinterpret<filelump_t?>(Z_Malloc(typeinfo sizeof(type<filelump_t>), int(anon_28.PU_STATIC), null))
        fileinfo.filepos = 0
        fileinfo.size = int(wad_file.length)
        // Name the lump after the base of the filename (without the
        // extension).
        M_ExtractFileBase(filename, addr(fileinfo.name[0]))
        newnumlumps++
    } else {
        // WAD file
        W_Read(wad_file, 0u, reinterpret<void?>(addr(header)), uint64(typeinfo sizeof(type<wadinfo_t>)))
        if (crt::strncmp(addr(header.identification[0]), cstr("IWAD"), 4ul) != 0) {
            // Homebrew levels?
            if (crt::strncmp(addr(header.identification[0]), cstr("PWAD"), 4ul) != 0) {
                I_Error`va(cstr("Wad file %s doesn't have IWAD or PWAD id\n"), (filename,))
            }
        }
        // ???modifiedgame = true;
        header.numlumps = header.numlumps
        header.infotableofs = header.infotableofs
        length = int(uint64(header.numlumps) * uint64(typeinfo sizeof(type<filelump_t>)))
        fileinfo = reinterpret<filelump_t?>(Z_Malloc(length, int(anon_28.PU_STATIC), null))
        W_Read(wad_file, uint(header.infotableofs), reinterpret<void?>(fileinfo), uint64(length))
        newnumlumps += header.numlumps
    }
    // Increase size of numlumps array to accomodate the new file.
    startlump = int(numlumps)
    doom_all__ExtendLumpInfo(newnumlumps)
    lump_p = addr(lumpinfo[startlump])
    filerover = fileinfo
    for (i in urange(uint(startlump), numlumps)) {
        lump_p.wad_file = wad_file
        lump_p.position = filerover.filepos
        lump_p.size = filerover.size
        lump_p.cache = null
        crt::strncpy(addr(lump_p.name[0]), addr(filerover.name[0]), 8ul)
        lump_p++
        filerover++
    }
    Z_Free(reinterpret<void?>(fileinfo))
    if (doom_all__lumphash != null) {
        Z_Free(reinterpret<void?>(doom_all__lumphash))
        doom_all__lumphash = null
    }
    return wad_file
}

// W_NumLumps
[unsafe_deref, hint(unsafe_range_check)]
def W_NumLumps : int {
    return int(numlumps)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_CheckNumForName(var name : uint8?) : int {
    var lump_p : lumpinfo_s?
    var i : int
    // Do we have a hash table yet?
    if (doom_all__lumphash != null) {
        var hash : int
        // We do! Excellent.
        hash = int(W_LumpNameHash(name) % numlumps)
        lump_p = doom_all__lumphash[hash]
        while (lump_p != null) {
            if (crt::strncasecmp(addr(lump_p.name[0]), name, 8ul) == 0) {
                return int(int64(lump_p - lumpinfo))
            }
            lump_p = lump_p.next
        }
    } else {
        // We don't have a hash table generate yet. Linear search :-(
        // scan backwards so patch lump files take precedence
        i = int(numlumps - 1u)
        while (i >= 0) {
            if (crt::strncasecmp(addr(lumpinfo[i].name[0]), name, 8ul) == 0) {
                return i
            }
            i--
        }
    }
    // TFB. Not found.
    return -1
}

// W_GetNumForName
// Calls W_CheckNumForName, but bombs out if not found.
[unsafe_deref, hint(unsafe_range_check)]
def W_GetNumForName(var name : uint8?) : int {
    var i : int
    i = W_CheckNumForName(name)
    if (i < 0) {
        I_Error`va(cstr("W_GetNumForName: %s not found!"), (name,))
    }
    return i
}

// W_LumpLength
// Returns the buffer size needed to load the given lump.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_LumpLength(lump : uint) : int {
    if (lump >= numlumps) {
        I_Error`va(cstr("W_LumpLength: %i >= numlumps"), (lump,))
    }
    return lumpinfo[lump].size
}

// W_ReadLump
// Loads the lump into the given buffer,
// which must be >= W_LumpLength().
[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_ReadLump(lump : uint; var dest : void?) {
    var c : int
    var l : lumpinfo_s?
    if (lump >= numlumps) {
        I_Error`va(cstr("W_ReadLump: %i >= numlumps"), (lump,))
    }
    l = lumpinfo + lump
    I_BeginRead()
    c = int(W_Read(l.wad_file, uint(l.position), dest, uint64(l.size)))
    if (c < l.size) {
        I_Error`va(cstr("W_ReadLump: only read %i of %i on lump %i"), (c, l.size, lump))
    }
    I_EndRead()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_CacheLumpNum(lumpnum : int; tag : int) : void? {
    var result : uint8?
    var lump : lumpinfo_s?
    if (uint(lumpnum) >= numlumps) {
        I_Error`va(cstr("W_CacheLumpNum: %i >= numlumps"), (lumpnum,))
    }
    lump = addr(lumpinfo[lumpnum])
    // Get the pointer to return. If the lump is in a memory-mapped
    // file, we can just return a pointer to within the memory-mapped
    // region. If the lump is in an ordinary file, we may already
    // have it cached; otherwise, load it into memory.
    if (lump.wad_file.mapped != null) {
        // Memory mapped file, return from the mmapped region.
        result = lump.wad_file.mapped + lump.position
    } elif (lump.cache != null) {
        // Already cached, so just switch the zone tag.
        result = reinterpret<uint8?>(lump.cache)
        Z_ChangeTag2(lump.cache, tag, cstr("/root/c2das/tests/manual/doomgeneric/upstream/doomgeneric/doomgeneric/w_wad.c"), 410)
    } else {
        // Not yet loaded, so load it now
        lump.cache = Z_Malloc(W_LumpLength(uint(lumpnum)), tag, reinterpret<void?>(addr(lump.cache)))
        W_ReadLump(uint(lumpnum), lump.cache)
        result = reinterpret<uint8?>(lump.cache)
    }
    return reinterpret<void?>(result)
}

// W_CacheLumpName
[unsafe_deref, hint(unsafe_range_check)]
def W_CacheLumpName(var name : uint8?; tag : int) : void? {
    return W_CacheLumpNum(W_GetNumForName(name), tag)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_ReleaseLumpNum(lumpnum : int) {
    var lump : lumpinfo_s?
    if (uint(lumpnum) >= numlumps) {
        I_Error`va(cstr("W_ReleaseLumpNum: %i >= numlumps"), (lumpnum,))
    }
    lump = addr(lumpinfo[lumpnum])
    if (lump.wad_file.mapped != null) {
    } else {
        // Memory-mapped file, so nothing needs to be done here.
        Z_ChangeTag2(lump.cache, int(anon_28.PU_CACHE), cstr("/root/c2das/tests/manual/doomgeneric/upstream/doomgeneric/doomgeneric/w_wad.c"), 461)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def W_ReleaseLumpName(var name : uint8?) {
