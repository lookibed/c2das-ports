}

[unsafe_deref, hint(unsafe_range_check)]
def FixedMul(a : int; b : int) : int {
    return int((int64(a) * int64(b)) >> int64(FRACBITS))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def FixedDiv(a : int; b : int) : int {
    if ((crt::abs(a) >> 14) >= crt::abs(b)) {
        return (a ^ b) < 0 ? -2147483647 - 1 : 2147483647
    } else {
        var result : int64
        result = (int64(a) << 16l) / int64(b)
        return int(result)
    }
}

// M_ReadSaveStrings
// read the strings from the savegame files
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_ReadSaveStrings {
    var handle : _IO_FILE?
    var name : uint8[256]
    for (i in range(int(anon_1033.load_end))) {
        M_StringCopy(addr(name[0]), P_SaveGameFile(i), uint64(typeinfo sizeof(type<uint8[256]>)))
        handle = reinterpret<_IO_FILE?>(crt::fopen(addr(name[0]), cstr("rb")))
        if (handle == null) {
            M_StringCopy(addr(savegamestrings[i][0]), cstr("empty slot"), uint64(SAVESTRINGSIZE))
            LoadMenu[i].status = int16(0)
            continue
        }
        crt::fread(reinterpret<void?>(addr(savegamestrings[0]) + end_index(i, 10)), 1ul, uint64(SAVESTRINGSIZE), reinterpret<void?>(handle))
        crt::fclose(reinterpret<void?>(handle))
        LoadMenu[i].status = int16(1)
    }
}

