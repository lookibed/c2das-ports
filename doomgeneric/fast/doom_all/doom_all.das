// Z_ChangeTag
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_ChangeTag2(var ptr : void?; tag : int; var file : uint8?; line : int) {
    var _c_block : memblock_s?
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(ptr) + -int64(uint64(typeinfo sizeof(type<memblock_s>))))
    if (_c_block.id != ZONEID) {
        I_Error`va(cstr("%s:%i: Z_ChangeTag: block without a ZONEID!"), (file, line))
    }
    if (tag >= int(anon_28.PU_PURGELEVEL) && _c_block.user == null) {
        I_Error`va(cstr("%s:%i: Z_ChangeTag: an owner is required for purgable blocks"), (file, line))
    }
    _c_block.tag = tag
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_ChangeUser(var ptr : void?; var user : void ??) {
    var _c_block : memblock_s?
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(ptr) + -int64(uint64(typeinfo sizeof(type<memblock_s>))))
    if (_c_block.id != ZONEID) {
        I_Error`va(cstr("Z_ChangeUser: Tried to change user for invalid block!"), VaNone())
    }
    _c_block.user = user
    *user = ptr
}

// Z_FreeMemory
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_FreeMemory : int {
    var _c_block : memblock_s?
    var free : int
    free = 0
    _c_block = mainzone.blocklist.next
    while (_c_block != addr(mainzone.blocklist)) {
        if (_c_block.tag == int(anon_28.PU_FREE) || _c_block.tag >= int(anon_28.PU_PURGELEVEL)) {
            free += _c_block.size
        }
        _c_block = _c_block.next
    }
    return free
}

[unsafe_deref, hint(unsafe_range_check)]
def Z_ZoneSize : uint {
    return uint(mainzone.size)
