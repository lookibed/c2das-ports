}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_GenerateHashTable {
    // Free the old hash table, if there is one
    if (doom_all__lumphash != null) {
        Z_Free(reinterpret<void?>(doom_all__lumphash))
    }
    // Generate hash table
    if (numlumps > 0u) {
        doom_all__lumphash = reinterpret<lumpinfo_s ??>(Z_Malloc(int(uint64(typeinfo sizeof(type<lumpinfo_s?>)) * uint64(numlumps)), int(anon_28.PU_STATIC),
                null))
        crt::memset(reinterpret<void?>(doom_all__lumphash), 0, uint64(typeinfo sizeof(type<lumpinfo_s?>)) * uint64(numlumps))
        for (i in urange(numlumps)) {
            var hash : uint
            hash = W_LumpNameHash(addr(lumpinfo[i].name[0])) % numlumps
            // Hook into the hash table
            lumpinfo[i].next = doom_all__lumphash[hash]
            doom_all__lumphash[hash] = addr(lumpinfo[i])
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def W_CheckCorrectIWAD(mission : GameMission_t) {
    var i : int
    var lumpnum : int
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<anon_1385[4]>)) / uint64(typeinfo sizeof(type<anon_1385>))) {
        if (mission != doom_all__unique_lumps[i].mission) {
            lumpnum = W_CheckNumForName(doom_all__unique_lumps[i].lumpname)
            if (lumpnum >= 0) {
                I_Error`va(cstr("\nYou are trying to use a %s IWAD file with the %s%s binary.\nThis isn't going to work.\nYou probably want to use the %s%s binary."),
                        (D_SuggestGameName(doom_all__unique_lumps[i].mission, GameMode_t.indetermined), cstr("doomgeneric"), D_GameMissionString(mission),
                            cstr("doomgeneric"), D_GameMissionString(doom_all__unique_lumps[i].mission)))
            }
        }
        i++
    }
}

// Z_ClearZone
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_ClearZone(var zone : memzone_t?) {
    var _c_block : memblock_s?
    // set the entire zone to one free block
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(zone) + uint64(typeinfo sizeof(type<memzone_t>)))
    zone.blocklist.prev = _c_block
    zone.blocklist.next = zone.blocklist.prev
    zone.blocklist.user = reinterpret<void ??>(reinterpret<void?>(zone))
    zone.blocklist.tag = int(anon_28.PU_STATIC)
    zone.rover = _c_block
    _c_block.next = addr(zone.blocklist)
    _c_block.prev = _c_block.next
    // a free block.
    _c_block.tag = int(anon_28.PU_FREE)
    _c_block.size = int(uint64(zone.size) - uint64(typeinfo sizeof(type<memzone_t>)))
}

// Z_Init
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_Init {
    var _c_block : memblock_s?
    var size : int
    mainzone = reinterpret<memzone_t?>(I_ZoneBase(addr(size)))
    mainzone.size = size
    // set the entire zone to one free block
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(mainzone) + uint64(typeinfo sizeof(type<memzone_t>)))
    mainzone.blocklist.prev = _c_block
    mainzone.blocklist.next = mainzone.blocklist.prev
    mainzone.blocklist.user = reinterpret<void ??>(reinterpret<void?>(mainzone))
    mainzone.blocklist.tag = int(anon_28.PU_STATIC)
    mainzone.rover = _c_block
    _c_block.next = addr(mainzone.blocklist)
    _c_block.prev = _c_block.next
    // free block
    _c_block.tag = int(anon_28.PU_FREE)
    _c_block.size = int(uint64(mainzone.size) - uint64(typeinfo sizeof(type<memzone_t>)))
}

// Z_Free
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_Free(var ptr : void?) {
    var _c_block : memblock_s?
    var other : memblock_s?
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(ptr) + -int64(uint64(typeinfo sizeof(type<memblock_s>))))
    if (_c_block.id != ZONEID) {
        I_Error`va(cstr("Z_Free: freed a pointer without ZONEID"), VaNone())
    }
    if (_c_block.tag != int(anon_28.PU_FREE) && _c_block.user != null) {
        // clear the user's mark
        *_c_block.user = null
    }
    // mark as free
    _c_block.tag = int(anon_28.PU_FREE)
    _c_block.user = null
    _c_block.id = 0
    other = _c_block.prev
    if (other.tag == int(anon_28.PU_FREE)) {
        // merge with previous free block
        other.size += _c_block.size
        other.next = _c_block.next
        other.next.prev = other
        if (_c_block == mainzone.rover) {
            mainzone.rover = other
        }
        _c_block = other
    }
    other = _c_block.next
    if (other.tag == int(anon_28.PU_FREE)) {
        // merge the next free block onto the end
        _c_block.size += other.size
        _c_block.next = other.next
        _c_block.next.prev = _c_block
        if (other == mainzone.rover) {
            mainzone.rover = _c_block
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_Malloc(var size : int; tag : int; var user : void?) : void? {
    var extra : int
    var start : memblock_s?
    var rover : memblock_s?
    var newblock : memblock_s?
    var base : memblock_s?
    var result : void?
    size = int((uint64(size) + MEM_ALIGN - 1ul) & ~(MEM_ALIGN - 1ul))
    // scan through the block list,
    // looking for the first free block
    // of sufficient size,
    // throwing out any purgable blocks along the way.
    // account for size of block header
    size = int(uint64(size) + uint64(typeinfo sizeof(type<memblock_s>)))
    // if there is a free block behind the rover,
    // back up over them
    base = mainzone.rover
    if (base.prev.tag == int(anon_28.PU_FREE)) {
        base = base.prev
    }
    rover = base
    start = base.prev
    c_do_while(base.tag != int(anon_28.PU_FREE) || base.size < size) {
        if (rover == start) {
            // scanned all the way around the list
            I_Error`va(cstr("Z_Malloc: failed on allocation of %i bytes"), (size,))
        }
        if (rover.tag != int(anon_28.PU_FREE)) {
            if (rover.tag < int(anon_28.PU_PURGELEVEL)) {
                // hit a block that can't be purged,
                // so move base past it
                rover = rover.next
                base = rover
            } else {
                // free the rover block (adding the size to base)
                // the rover can be the base block
                base = base.prev
                Z_Free(reinterpret<void?>(reinterpret<uint8?>(rover) + uint64(typeinfo sizeof(type<memblock_s>))))
                base = base.next
                rover = base.next
            }
        } else {
            rover = rover.next
        }
    }
    // found a block big enough
    extra = base.size - size
    if (extra > MINFRAGMENT) {
        // there will be a free fragment after the allocated block
        newblock = reinterpret<memblock_s?>(reinterpret<uint8?>(base) + size)
        newblock.size = extra
        newblock.tag = int(anon_28.PU_FREE)
        newblock.user = null
        newblock.prev = base
        newblock.next = base.next
        newblock.next.prev = newblock
        base.next = newblock
        base.size = size
    }
    if (user == null && tag >= int(anon_28.PU_PURGELEVEL)) {
        I_Error`va(cstr("Z_Malloc: an owner is required for purgable blocks"), VaNone())
    }
    base.user = reinterpret<void ??>(user)
    base.tag = tag
    result = reinterpret<void?>(reinterpret<uint8?>(base) + uint64(typeinfo sizeof(type<memblock_s>)))
    if (base.user != null) {
        *base.user = result
    }
    // next allocation will start looking here
    mainzone.rover = base.next
    base.id = ZONEID
    return result
}

// Z_FreeTags
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_FreeTags(lowtag : int; hightag : int) {
    var _c_block : memblock_s?
    var next : memblock_s?
    _c_block = mainzone.blocklist.next
    while (_c_block != addr(mainzone.blocklist)) {
        {
            // get link before freeing
            next = _c_block.next
            // free block?
            if (_c_block.tag == int(anon_28.PU_FREE)) {
                continue
            }
            if (_c_block.tag >= lowtag && _c_block.tag <= hightag) {
                Z_Free(reinterpret<void?>(reinterpret<uint8?>(_c_block) + uint64(typeinfo sizeof(type<memblock_s>))))
            }
        } finally {
            _c_block = next
        }
    }
}

// Z_DumpHeap
// Note: TFileDumpHeap( stdout ) ?
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_DumpHeap(lowtag : int; hightag : int) {
    var _c_block : memblock_s?
    fprintf(crt::c_stderr(), cstr("zone size: %i  location: %p\n"), mainzone.size, mainzone)
    fprintf(crt::c_stderr(), cstr("tag range: %i to %i\n"), lowtag, hightag)
    _c_block = mainzone.blocklist.next
    while (true) {
        if (_c_block.tag >= lowtag && _c_block.tag <= hightag) {
            fprintf(crt::c_stderr(), cstr("block:%p    size:%7i    user:%p    tag:%3i\n"), _c_block, _c_block.size, _c_block.user, _c_block.tag)
        }
        if (_c_block.next == addr(mainzone.blocklist)) {
            // all blocks have been hit
            break
        }
        if (reinterpret<uint8?>(_c_block) + _c_block.size != reinterpret<uint8?>(_c_block.next)) {
            fprintf(crt::c_stderr(), cstr("ERROR: block size does not touch the next block\n"))
        }
        if (_c_block.next.prev != _c_block) {
            fprintf(crt::c_stderr(), cstr("ERROR: next block doesn't have proper back link\n"))
        }
        if (_c_block.tag == int(anon_28.PU_FREE) && _c_block.next.tag == int(anon_28.PU_FREE)) {
            fprintf(crt::c_stderr(), cstr("ERROR: two consecutive free blocks\n"))
        }
        _c_block = _c_block.next
    }
}

// Z_FileDumpHeap
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_FileDumpHeap(var f : _IO_FILE?) {
    var _c_block : memblock_s?
