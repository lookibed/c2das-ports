struct point_t {
    x, y : int
}

struct wi_anim_t {
    _c_type : animenum_t
    period, nanims : int
    loc : point_t
    data1, data2 : int
    p : patch_t? [3]
    nexttic, lastdrawn, ctr, state : int
}

struct wadinfo_t {
    identification : uint8[4]
    numlumps, infotableofs : int
}

struct filelump_t {
    filepos, size : int
    name : uint8[8]
}

struct anon_1385 {
    mission : GameMission_t
    lumpname : uint8?
}

struct memblock_s {
    size : int
    user : void ??
    tag, id : int
    next, prev : memblock_s?
}

struct memzone_t {
    size : int
    blocklist : memblock_s
    rover : memblock_s?
}

struct stdc_wad_file_t {
    wad : _wad_file_s
    fstream : _IO_FILE?
}

struct FB_BitField {
    offset, length : uint
}

struct FB_ScreenInfo {
    xres, yres, xres_virtual, yres_virtual, bits_per_pixel : uint
    red, green, blue, transp : FB_BitField
}

struct col_t {
    r, g, b : uint8
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<sha1_context_s>) == 92 && typeinfo alignof(type<sha1_context_s>) == 4,
            "sha1_context_s: clang lays it out as size 92, align 4")
    static_assert(typeinfo offsetof < h0 > (type<sha1_context_s>) == 0, "sha1_context_s.h0: clang puts it at 0")
    static_assert(typeinfo offsetof < h1 > (type<sha1_context_s>) == 4, "sha1_context_s.h1: clang puts it at 4")
    static_assert(typeinfo offsetof < h2 > (type<sha1_context_s>) == 8, "sha1_context_s.h2: clang puts it at 8")
    static_assert(typeinfo offsetof < h3 > (type<sha1_context_s>) == 12, "sha1_context_s.h3: clang puts it at 12")
    static_assert(typeinfo offsetof < h4 > (type<sha1_context_s>) == 16, "sha1_context_s.h4: clang puts it at 16")
    static_assert(typeinfo offsetof < nblocks > (type<sha1_context_s>) == 20, "sha1_context_s.nblocks: clang puts it at 20")
    static_assert(typeinfo offsetof < buf > (type<sha1_context_s>) == 24, "sha1_context_s.buf: clang puts it at 24")
    static_assert(typeinfo offsetof < count > (type<sha1_context_s>) == 88, "sha1_context_s.count: clang puts it at 88")
    static_assert(typeinfo sizeof(type<event_t>) == 20 && typeinfo alignof(type<event_t>) == 4, "event_t: clang lays it out as size 20, align 4")
    static_assert(typeinfo offsetof < _c_type > (type<event_t>) == 0, "event_t._c_type: clang puts it at 0")
    static_assert(typeinfo offsetof < data1 > (type<event_t>) == 4, "event_t.data1: clang puts it at 4")
    static_assert(typeinfo offsetof < data2 > (type<event_t>) == 8, "event_t.data2: clang puts it at 8")
    static_assert(typeinfo offsetof < data3 > (type<event_t>) == 12, "event_t.data3: clang puts it at 12")
    static_assert(typeinfo offsetof < data4 > (type<event_t>) == 16, "event_t.data4: clang puts it at 16")
    static_assert(typeinfo sizeof(type<cheatseq_t>) == 72 && typeinfo alignof(type<cheatseq_t>) == 8, "cheatseq_t: clang lays it out as size 72, align 8")
    static_assert(typeinfo offsetof < sequence > (type<cheatseq_t>) == 0, "cheatseq_t.sequence: clang puts it at 0")
    static_assert(typeinfo offsetof < sequence_len > (type<cheatseq_t>) == 32, "cheatseq_t.sequence_len: clang puts it at 32")
    static_assert(typeinfo offsetof < parameter_chars > (type<cheatseq_t>) == 40, "cheatseq_t.parameter_chars: clang puts it at 40")
    static_assert(typeinfo offsetof < chars_read > (type<cheatseq_t>) == 48, "cheatseq_t.chars_read: clang puts it at 48")
    static_assert(typeinfo offsetof < param_chars_read > (type<cheatseq_t>) == 56, "cheatseq_t.param_chars_read: clang puts it at 56")
    static_assert(typeinfo offsetof < parameter_buf > (type<cheatseq_t>) == 60, "cheatseq_t.parameter_buf: clang puts it at 60")
    static_assert(typeinfo sizeof(type<actionf_t>) == 8 && typeinfo alignof(type<actionf_t>) == 8, "actionf_t: clang lays it out as size 8, align 8")
    static_assert(typeinfo offsetof < _storage > (type<actionf_t>) == 0, "actionf_t: every member sits at 0")
    static_assert(typeinfo sizeof(type<thinker_s>) == 24 && typeinfo alignof(type<thinker_s>) == 8, "thinker_s: clang lays it out as size 24, align 8")
    static_assert(typeinfo offsetof < prev > (type<thinker_s>) == 0, "thinker_s.prev: clang puts it at 0")
    static_assert(typeinfo offsetof < next > (type<thinker_s>) == 8, "thinker_s.next: clang puts it at 8")
    static_assert(typeinfo offsetof < _c_function > (type<thinker_s>) == 16, "thinker_s._c_function: clang puts it at 16")
    static_assert(typeinfo sizeof(type<mapvertex_t>) == 4 && typeinfo alignof(type<mapvertex_t>) == 2,
            "mapvertex_t: clang lays it out as size 4, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < x > (type<mapvertex_t>) == 0, "mapvertex_t.x: clang puts it at 0")
    static_assert(typeinfo offsetof < y > (type<mapvertex_t>) == 2, "mapvertex_t.y: clang puts it at 2")
    static_assert(typeinfo sizeof(type<mapsidedef_t>) == 30 && typeinfo alignof(type<mapsidedef_t>) == 2,
            "mapsidedef_t: clang lays it out as size 30, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < textureoffset > (type<mapsidedef_t>) == 0, "mapsidedef_t.textureoffset: clang puts it at 0")
    static_assert(typeinfo offsetof < rowoffset > (type<mapsidedef_t>) == 2, "mapsidedef_t.rowoffset: clang puts it at 2")
    static_assert(typeinfo offsetof < toptexture > (type<mapsidedef_t>) == 4, "mapsidedef_t.toptexture: clang puts it at 4")
    static_assert(typeinfo offsetof < bottomtexture > (type<mapsidedef_t>) == 12, "mapsidedef_t.bottomtexture: clang puts it at 12")
    static_assert(typeinfo offsetof < midtexture > (type<mapsidedef_t>) == 20, "mapsidedef_t.midtexture: clang puts it at 20")
    static_assert(typeinfo offsetof < sector > (type<mapsidedef_t>) == 28, "mapsidedef_t.sector: clang puts it at 28")
    static_assert(typeinfo sizeof(type<maplinedef_t>) == 14 && typeinfo alignof(type<maplinedef_t>) == 2,
            "maplinedef_t: clang lays it out as size 14, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < v1 > (type<maplinedef_t>) == 0, "maplinedef_t.v1: clang puts it at 0")
    static_assert(typeinfo offsetof < v2 > (type<maplinedef_t>) == 2, "maplinedef_t.v2: clang puts it at 2")
    static_assert(typeinfo offsetof < flags > (type<maplinedef_t>) == 4, "maplinedef_t.flags: clang puts it at 4")
    static_assert(typeinfo offsetof < special > (type<maplinedef_t>) == 6, "maplinedef_t.special: clang puts it at 6")
    static_assert(typeinfo offsetof < tag > (type<maplinedef_t>) == 8, "maplinedef_t.tag: clang puts it at 8")
    static_assert(typeinfo offsetof < sidenum > (type<maplinedef_t>) == 10, "maplinedef_t.sidenum: clang puts it at 10")
    static_assert(typeinfo sizeof(type<mapsector_t>) == 26 && typeinfo alignof(type<mapsector_t>) == 2,
            "mapsector_t: clang lays it out as size 26, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < floorheight > (type<mapsector_t>) == 0, "mapsector_t.floorheight: clang puts it at 0")
    static_assert(typeinfo offsetof < ceilingheight > (type<mapsector_t>) == 2, "mapsector_t.ceilingheight: clang puts it at 2")
    static_assert(typeinfo offsetof < floorpic > (type<mapsector_t>) == 4, "mapsector_t.floorpic: clang puts it at 4")
    static_assert(typeinfo offsetof < ceilingpic > (type<mapsector_t>) == 12, "mapsector_t.ceilingpic: clang puts it at 12")
    static_assert(typeinfo offsetof < lightlevel > (type<mapsector_t>) == 20, "mapsector_t.lightlevel: clang puts it at 20")
    static_assert(typeinfo offsetof < special > (type<mapsector_t>) == 22, "mapsector_t.special: clang puts it at 22")
    static_assert(typeinfo offsetof < tag > (type<mapsector_t>) == 24, "mapsector_t.tag: clang puts it at 24")
    static_assert(typeinfo sizeof(type<mapsubsector_t>) == 4 && typeinfo alignof(type<mapsubsector_t>) == 2,
            "mapsubsector_t: clang lays it out as size 4, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < numsegs > (type<mapsubsector_t>) == 0, "mapsubsector_t.numsegs: clang puts it at 0")
    static_assert(typeinfo offsetof < firstseg > (type<mapsubsector_t>) == 2, "mapsubsector_t.firstseg: clang puts it at 2")
    static_assert(typeinfo sizeof(type<mapseg_t>) == 12 && typeinfo alignof(type<mapseg_t>) == 2,
            "mapseg_t: clang lays it out as size 12, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < v1 > (type<mapseg_t>) == 0, "mapseg_t.v1: clang puts it at 0")
    static_assert(typeinfo offsetof < v2 > (type<mapseg_t>) == 2, "mapseg_t.v2: clang puts it at 2")
    static_assert(typeinfo offsetof < angle > (type<mapseg_t>) == 4, "mapseg_t.angle: clang puts it at 4")
    static_assert(typeinfo offsetof < linedef > (type<mapseg_t>) == 6, "mapseg_t.linedef: clang puts it at 6")
    static_assert(typeinfo offsetof < side > (type<mapseg_t>) == 8, "mapseg_t.side: clang puts it at 8")
    static_assert(typeinfo offsetof < offset > (type<mapseg_t>) == 10, "mapseg_t.offset: clang puts it at 10")
    static_assert(typeinfo sizeof(type<mapnode_t>) == 28 && typeinfo alignof(type<mapnode_t>) == 2,
            "mapnode_t: clang lays it out as size 28, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < x > (type<mapnode_t>) == 0, "mapnode_t.x: clang puts it at 0")
    static_assert(typeinfo offsetof < y > (type<mapnode_t>) == 2, "mapnode_t.y: clang puts it at 2")
    static_assert(typeinfo offsetof < dx > (type<mapnode_t>) == 4, "mapnode_t.dx: clang puts it at 4")
    static_assert(typeinfo offsetof < dy > (type<mapnode_t>) == 6, "mapnode_t.dy: clang puts it at 6")
    static_assert(typeinfo offsetof < bbox > (type<mapnode_t>) == 8, "mapnode_t.bbox: clang puts it at 8")
    static_assert(typeinfo offsetof < children > (type<mapnode_t>) == 24, "mapnode_t.children: clang puts it at 24")
    static_assert(typeinfo sizeof(type<mapthing_t>) == 10 && typeinfo alignof(type<mapthing_t>) == 2,
            "mapthing_t: clang lays it out as size 10, align 1, its das alignment is 2")
    static_assert(typeinfo offsetof < x > (type<mapthing_t>) == 0, "mapthing_t.x: clang puts it at 0")
    static_assert(typeinfo offsetof < y > (type<mapthing_t>) == 2, "mapthing_t.y: clang puts it at 2")
    static_assert(typeinfo offsetof < angle > (type<mapthing_t>) == 4, "mapthing_t.angle: clang puts it at 4")
    static_assert(typeinfo offsetof < _c_type > (type<mapthing_t>) == 6, "mapthing_t._c_type: clang puts it at 6")
    static_assert(typeinfo offsetof < _c_options > (type<mapthing_t>) == 8, "mapthing_t._c_options: clang puts it at 8")
    static_assert(typeinfo sizeof(type<state_t>) == 40 && typeinfo alignof(type<state_t>) == 8, "state_t: clang lays it out as size 40, align 8")
    static_assert(typeinfo offsetof < sprite > (type<state_t>) == 0, "state_t.sprite: clang puts it at 0")
    static_assert(typeinfo offsetof < frame > (type<state_t>) == 4, "state_t.frame: clang puts it at 4")
    static_assert(typeinfo offsetof < tics > (type<state_t>) == 8, "state_t.tics: clang puts it at 8")
    static_assert(typeinfo offsetof < action > (type<state_t>) == 16, "state_t.action: clang puts it at 16")
    static_assert(typeinfo offsetof < nextstate > (type<state_t>) == 24, "state_t.nextstate: clang puts it at 24")
    static_assert(typeinfo offsetof < misc1 > (type<state_t>) == 28, "state_t.misc1: clang puts it at 28")
    static_assert(typeinfo offsetof < misc2 > (type<state_t>) == 32, "state_t.misc2: clang puts it at 32")
    static_assert(typeinfo sizeof(type<mobjinfo_t>) == 92 && typeinfo alignof(type<mobjinfo_t>) == 4, "mobjinfo_t: clang lays it out as size 92, align 4")
    static_assert(typeinfo offsetof < doomednum > (type<mobjinfo_t>) == 0, "mobjinfo_t.doomednum: clang puts it at 0")
    static_assert(typeinfo offsetof < spawnstate > (type<mobjinfo_t>) == 4, "mobjinfo_t.spawnstate: clang puts it at 4")
    static_assert(typeinfo offsetof < spawnhealth > (type<mobjinfo_t>) == 8, "mobjinfo_t.spawnhealth: clang puts it at 8")
    static_assert(typeinfo offsetof < seestate > (type<mobjinfo_t>) == 12, "mobjinfo_t.seestate: clang puts it at 12")
    static_assert(typeinfo offsetof < seesound > (type<mobjinfo_t>) == 16, "mobjinfo_t.seesound: clang puts it at 16")
    static_assert(typeinfo offsetof < reactiontime > (type<mobjinfo_t>) == 20, "mobjinfo_t.reactiontime: clang puts it at 20")
    static_assert(typeinfo offsetof < attacksound > (type<mobjinfo_t>) == 24, "mobjinfo_t.attacksound: clang puts it at 24")
    static_assert(typeinfo offsetof < painstate > (type<mobjinfo_t>) == 28, "mobjinfo_t.painstate: clang puts it at 28")
    static_assert(typeinfo offsetof < painchance > (type<mobjinfo_t>) == 32, "mobjinfo_t.painchance: clang puts it at 32")
    static_assert(typeinfo offsetof < painsound > (type<mobjinfo_t>) == 36, "mobjinfo_t.painsound: clang puts it at 36")
    static_assert(typeinfo offsetof < meleestate > (type<mobjinfo_t>) == 40, "mobjinfo_t.meleestate: clang puts it at 40")
    static_assert(typeinfo offsetof < missilestate > (type<mobjinfo_t>) == 44, "mobjinfo_t.missilestate: clang puts it at 44")
    static_assert(typeinfo offsetof < deathstate > (type<mobjinfo_t>) == 48, "mobjinfo_t.deathstate: clang puts it at 48")
    static_assert(typeinfo offsetof < xdeathstate > (type<mobjinfo_t>) == 52, "mobjinfo_t.xdeathstate: clang puts it at 52")
    static_assert(typeinfo offsetof < deathsound > (type<mobjinfo_t>) == 56, "mobjinfo_t.deathsound: clang puts it at 56")
    static_assert(typeinfo offsetof < speed > (type<mobjinfo_t>) == 60, "mobjinfo_t.speed: clang puts it at 60")
    static_assert(typeinfo offsetof < radius > (type<mobjinfo_t>) == 64, "mobjinfo_t.radius: clang puts it at 64")
    static_assert(typeinfo offsetof < height > (type<mobjinfo_t>) == 68, "mobjinfo_t.height: clang puts it at 68")
    static_assert(typeinfo offsetof < mass > (type<mobjinfo_t>) == 72, "mobjinfo_t.mass: clang puts it at 72")
    static_assert(typeinfo offsetof < damage > (type<mobjinfo_t>) == 76, "mobjinfo_t.damage: clang puts it at 76")
    static_assert(typeinfo offsetof < activesound > (type<mobjinfo_t>) == 80, "mobjinfo_t.activesound: clang puts it at 80")
    static_assert(typeinfo offsetof < flags > (type<mobjinfo_t>) == 84, "mobjinfo_t.flags: clang puts it at 84")
    static_assert(typeinfo offsetof < raisestate > (type<mobjinfo_t>) == 88, "mobjinfo_t.raisestate: clang puts it at 88")
    static_assert(typeinfo sizeof(type<mobj_s>) == 224 && typeinfo alignof(type<mobj_s>) == 8, "mobj_s: clang lays it out as size 224, align 8")
