[unsafe_deref, hint(unsafe_range_check)]
def M_SfxVol(choice : int) {
    c_switch(choice) {
        case(0) {
            if (sfxVolume != 0) {
                sfxVolume--
            }
            break
        }
        case(1) {
            if (sfxVolume < 15) {
                sfxVolume++
            }
            break
        }
    }
    S_SetSfxVolume(sfxVolume * 8)
}

[unsafe_deref, hint(unsafe_range_check)]
def M_MusicVol(choice : int) {
    c_switch(choice) {
        case(0) {
            if (musicVolume != 0) {
                musicVolume--
            }
            break
        }
        case(1) {
            if (musicVolume < 15) {
                musicVolume++
            }
            break
        }
    }
    S_SetMusicVolume(musicVolume * 8)
}

