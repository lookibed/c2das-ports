    entry = doom_all__exit_funcs
    while (entry != null) {
        invoke(entry.func)
        entry = entry.next
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ZenityAvailable : int {
    return int_of(crt::system(cstr("/usr/bin/zenity --help >/dev/null 2>&1")) == 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__EscapeShellString(var _c_string : uint8?) : uint8? {
    var result : uint8?
    var r : uint8?
    var s : uint8?
    // In the worst case, every character might be escaped.
    result = reinterpret<uint8?>(crt::malloc(crt::strlen(_c_string) * 2ul + 3ul))
    r = result
    // Enclosing quotes.
    *r = uint8('"')
    r++
    s = _c_string
    while (*s != '\0') {
        // From the bash manual:
        // "Enclosing characters in double quotes preserves the literal
        // value of all characters within the quotes, with the exception
        // of $, `, \, and, when history expansion is enabled, !."
        // Therefore, escape these characters by prefixing with a backslash.
        if (crt::strchr(cstr("$`\\!"), int(*s)) != null) {
            *r = uint8('\\')
            r++
        }
        *r = *s
        r++
        s++
    }
    // Enclosing quotes.
    *r = uint8('"')
    r++
    *r = uint8('\0')
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ZenityErrorBox(var message : uint8?) : int {
    var result : int
    var escaped_message : uint8?
    var errorboxpath : uint8?
    if (doom_all__ZenityAvailable() == 0) {
        return 0
    }
    escaped_message = doom_all__EscapeShellString(message)
    ZenityErrorBox_errorboxpath_size = crt::strlen(cstr("/usr/bin/zenity")) + crt::strlen(escaped_message) + 19ul
    errorboxpath = reinterpret<uint8?>(crt::malloc(ZenityErrorBox_errorboxpath_size))
    M_snprintf`va(errorboxpath, ZenityErrorBox_errorboxpath_size, cstr("%s --error --text=%s"), (cstr("/usr/bin/zenity"), escaped_message))
    result = crt::system(errorboxpath)
    crt::free(reinterpret<void?>(errorboxpath))
    crt::free(reinterpret<void?>(escaped_message))
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check), variadic]
def I_Error(var error : uint8?; va : va_args) {
    var msgbuf : uint8[512]
    var argptr : CVaCursor
    var entry : atexit_listentry_s?
    var exit_gui_popup : uint
    if (doom_all__already_quitting != 0) {
        fprintf(crt::c_stderr(), cstr("Warning: recursive call to I_Error detected.\n"))
    } else {
        doom_all__already_quitting = 1u
    }
    // Message first.
    argptr = va_begin(va)
    // fprintf(stderr, "\nError: ");
    c_vfprintf(crt::c_stderr(), error, va_rest(argptr))
    fprintf(crt::c_stderr(), cstr("\n\n"))
    crt::fflush(crt::c_stderr())
    // Write a copy of the message into buffer.
    argptr = va_begin(va)
    crt::memset(reinterpret<void?>(addr(msgbuf[0])), 0, uint64(typeinfo sizeof(type<uint8[512]>)))
    M_vsnprintf(addr(msgbuf[0]), uint64(typeinfo sizeof(type<uint8[512]>)), error, argptr)
    // Shutdown. Here might be other errors.
    entry = doom_all__exit_funcs
    while (entry != null) {
        if (entry.run_on_error != 0) {
            invoke(entry.func)
        }
        entry = entry.next
    }
    exit_gui_popup = uint(int_of(M_ParmExists(cstr("-nogui")) == 0))
    // Pop up a GUI dialog box to show the error message, if the
    // game was not run from the console (and the user will
    // therefore be unable to otherwise see the message).
    if (exit_gui_popup != 0 && I_ConsoleStdout() == 0) {
        // The CoreFoundation message box wraps text lines, so replace
        // newline characters with spaces so that multiline messages
        // are continuous.
        doom_all__ZenityErrorBox(addr(msgbuf[0]))
    }
    // abort();
    c_exit(-1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_GetMemoryValue(offset : uint; var value : void?; size : int) : uint {
    if (I_GetMemoryValue_firsttime != 0) {
        var p : int
        var i : int
        var val : int
        I_GetMemoryValue_firsttime = 0u
        i = 0
        // !
        // @category compat
        // @arg <version>
        // Specify DOS version to emulate for NULL pointer dereference
        // emulation. Supported versions are: dos622, dos71, dosbox.
        // The default is to emulate DOS 7.1 (Windows 98).
        p = M_CheckParmWithArgs(cstr("-setmem"), 1)
        if (p > 0) {
            if (crt::strcasecmp(myargv[p + 1], cstr("dos622")) == 0) {
                doom_all__dos_mem_dump = addr(doom_all__mem_dump_dos622[0])
            }
            if (crt::strcasecmp(myargv[p + 1], cstr("dos71")) == 0) {
                doom_all__dos_mem_dump = addr(doom_all__mem_dump_win98[0])
            } elif (crt::strcasecmp(myargv[p + 1], cstr("dosbox")) == 0) {
                doom_all__dos_mem_dump = addr(doom_all__mem_dump_dosbox[0])
            } else {
                i = 0
                while (i < DOS_MEM_DUMP_SIZE) {
                    p++
                    if (p >= myargc || myargv[p][0] == '-') {
                        break
                    }
                    M_StrToInt(myargv[p], addr(val))
                    let _t0 = i
                    i++
                    doom_all__mem_dump_custom[_t0] = uint8(val)
                    i++
                }
                doom_all__dos_mem_dump = addr(doom_all__mem_dump_custom[0])
            }
        }
    }
    c_switch(size) {
        case(1) {
            *reinterpret<uint8?>(value) = doom_all__dos_mem_dump[offset]
            return 1u
        }
        case(2) {
            *reinterpret<uint16?>(value) = uint16(int(doom_all__dos_mem_dump[offset]) | (int(doom_all__dos_mem_dump[offset + 1u]) << 8))
            return 1u
        }
        case(4) {
            *reinterpret<uint?>(value) = uint(int(doom_all__dos_mem_dump[offset]) | (int(doom_all__dos_mem_dump[offset + 1u]) << 8) |
                    (int(doom_all__dos_mem_dump[offset + 2u]) << 16) | (int(doom_all__dos_mem_dump[offset + 3u]) << 24))
            return 1u
        }
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def I_GetTicks : int {
    return int(DG_GetTicksMs())
}

[unsafe_deref, hint(unsafe_range_check)]
def I_GetTime : int {
    var ticks : uint
    ticks = uint(I_GetTicks())
    if (doom_all__basetime == 0u) {
        doom_all__basetime = ticks
    }
    ticks -= doom_all__basetime
    return int((ticks * uint(TICRATE)) / 1000u)
}

[unsafe_deref, hint(unsafe_range_check)]
def I_GetTimeMS : int {
    var ticks : uint
    ticks = uint(I_GetTicks())
    if (doom_all__basetime == 0u) {
        doom_all__basetime = ticks
    }
    return int(ticks - doom_all__basetime)
}

