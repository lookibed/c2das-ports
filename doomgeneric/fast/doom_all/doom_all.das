def M_GetSaveGameDir(var iwadname : uint8?) : uint8? {
    var savegamedir : uint8?
    // If not "doing" a configuration directory (Windows), don't "do"
    // a savegame directory, either.
    if (crt::strcmp(configdir, addr(c2das_empty[0])) == 0) {
        savegamedir = crt::strdup(addr(c2das_empty[0]))
    } else {
        // ~/.chocolate-doom/savegames
        // eg. ~/.chocolate-doom/savegames/doom2.wad
        savegamedir = M_StringJoin`va(configdir, (cstr("/"), cstr(".savegame/"), null))
        M_MakeDirectory(savegamedir)
        fprintf(crt::c_stderr(), cstr("Using %s for savegames\n"), savegamedir)
    }
    return savegamedir
}

