    // int brighttime;
    doom_all__saveg_write32(str.brighttime)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_glow_t(var str : glow_t?) {
    var sector : int
    // thinker_t thinker;
    doom_all__saveg_read_thinker_t(addr(str.thinker))
    // sector_t* sector;
    sector = doom_all__saveg_read32()
    str.sector = addr(sectors[sector])
    // int minlight;
    str.minlight = doom_all__saveg_read32()
    // int maxlight;
    str.maxlight = doom_all__saveg_read32()
    // int direction;
    str.direction = doom_all__saveg_read32()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_glow_t(var str : glow_t?) {
    // thinker_t thinker;
    doom_all__saveg_write_thinker_t(addr(str.thinker))
    // sector_t* sector;
    doom_all__saveg_write32(int(int64(str.sector - sectors)))
    // int minlight;
    doom_all__saveg_write32(str.minlight)
    // int maxlight;
    doom_all__saveg_write32(str.maxlight)
    // int direction;
    doom_all__saveg_write32(str.direction)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_WriteSaveGameHeader(var description : uint8?) {
    var name : uint8[16]
    var i : int
    i = 0
    while (description[i] != '\0') {
        doom_all__saveg_write8(description[i])
        i++
    }
    while (i < SAVESTRINGSIZE) {
        doom_all__saveg_write8(0u8)
        i++
    }
    crt::memset(reinterpret<void?>(addr(name[0])), 0, uint64(typeinfo sizeof(type<uint8[16]>)))
    M_snprintf`va(addr(name[0]), uint64(typeinfo sizeof(type<uint8[16]>)), cstr("version %i"), (G_VanillaVersionCode(),))
    for (i1 in range(VERSIONSIZE)) {
        doom_all__saveg_write8(name[i1])
    }
    doom_all__saveg_write8(uint8(gameskill))
    doom_all__saveg_write8(uint8(gameepisode))
    doom_all__saveg_write8(uint8(gamemap))
    for (i1 in range(MAXPLAYERS)) {
        doom_all__saveg_write8(uint8(playeringame[i1]))
    }
    doom_all__saveg_write8(uint8((leveltime >> 16) & 255))
    doom_all__saveg_write8(uint8((leveltime >> 8) & 255))
    doom_all__saveg_write8(uint8(leveltime & 255))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ReadSaveGameHeader : uint {
    var a : uint8
    var b : uint8
    var c : uint8
    var vcheck : uint8[16]
    var read_vcheck : uint8[16]
    // skip the description field
    for (i in range(SAVESTRINGSIZE)) {
        doom_all__saveg_read8()
    }
    for (i in range(VERSIONSIZE)) {
        read_vcheck[i] = doom_all__saveg_read8()
    }
    crt::memset(reinterpret<void?>(addr(vcheck[0])), 0, uint64(typeinfo sizeof(type<uint8[16]>)))
    M_snprintf`va(addr(vcheck[0]), uint64(typeinfo sizeof(type<uint8[16]>)), cstr("version %i"), (G_VanillaVersionCode(),))
    if (crt::strcmp(addr(read_vcheck[0]), addr(vcheck[0])) != 0) {
        // bad version
        return 0u
    }
    gameskill = enum_from_int(type<skill_t>, int(doom_all__saveg_read8()))
    gameepisode = int(doom_all__saveg_read8())
    gamemap = int(doom_all__saveg_read8())
    for (i in range(MAXPLAYERS)) {
        playeringame[i] = uint(doom_all__saveg_read8())
    }
    // get the times
    a = doom_all__saveg_read8()
    b = doom_all__saveg_read8()
    c = doom_all__saveg_read8()
    leveltime = (int(a) << 16) + (int(b) << 8) + int(c)
    return 1u
}

[unsafe_deref, hint(unsafe_range_check)]
def P_ReadSaveGameEOF : uint {
    var value : int
    value = int(doom_all__saveg_read8())
    return uint(int_of(value == SAVEGAME_EOF))
}

[unsafe_deref, hint(unsafe_range_check)]
def P_WriteSaveGameEOF {
    doom_all__saveg_write8(uint8(SAVEGAME_EOF))
}

// P_ArchivePlayers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ArchivePlayers {
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] == 0) {
            continue
        }
        doom_all__saveg_write_pad()
        doom_all__saveg_write_player_t(addr(players[0]) + end_index(i, 4))
    }
}

// P_UnArchivePlayers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UnArchivePlayers {
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] == 0) {
            continue
        }
        doom_all__saveg_read_pad()
        doom_all__saveg_read_player_t(addr(players[0]) + end_index(i, 4))
        // will be set when unarc thinker
        players[i].mo = null
        players[i].message = null
        players[i].attacker = null
    }
}

// P_ArchiveWorld
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ArchiveWorld {
    var i : int
    var sec : sector_t?
    var li : line_s?
    var si : side_t?
    // do sectors
    i = 0
    sec = sectors
    while (i < numsectors) {
        doom_all__saveg_write16(int16(sec.floorheight >> FRACBITS))
        doom_all__saveg_write16(int16(sec.ceilingheight >> FRACBITS))
        doom_all__saveg_write16(sec.floorpic)
        doom_all__saveg_write16(sec.ceilingpic)
        doom_all__saveg_write16(sec.lightlevel)
        // needed?
        doom_all__saveg_write16(sec.special)
        // needed?
        doom_all__saveg_write16(sec.tag)
        i++
        sec++
    }
    // do lines
    i = 0
    li = lines
    while (i < numlines) {
        doom_all__saveg_write16(li.flags)
        doom_all__saveg_write16(li.special)
        doom_all__saveg_write16(li.tag)
        for (j in range(2)) {
            if (li.sidenum[j] == -1) {
                continue
            }
            si = addr(sides[int(li.sidenum[j])])
            doom_all__saveg_write16(int16(si.textureoffset >> FRACBITS))
            doom_all__saveg_write16(int16(si.rowoffset >> FRACBITS))
            doom_all__saveg_write16(si.toptexture)
            doom_all__saveg_write16(si.bottomtexture)
            doom_all__saveg_write16(si.midtexture)
        }
        i++
        li++
    }
}

// P_UnArchiveWorld
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UnArchiveWorld {
    var i : int
    var sec : sector_t?
    var li : line_s?
    var si : side_t?
    // do sectors
    i = 0
    sec = sectors
    while (i < numsectors) {
        sec.floorheight = int(doom_all__saveg_read16()) << FRACBITS
        sec.ceilingheight = int(doom_all__saveg_read16()) << FRACBITS
        sec.floorpic = doom_all__saveg_read16()
        sec.ceilingpic = doom_all__saveg_read16()
        sec.lightlevel = doom_all__saveg_read16()
        // needed?
        sec.special = doom_all__saveg_read16()
        // needed?
        sec.tag = doom_all__saveg_read16()
        sec.specialdata = null
        sec.soundtarget = null
        i++
        sec++
    }
    // do lines
    i = 0
    li = lines
    while (i < numlines) {
        li.flags = doom_all__saveg_read16()
        li.special = doom_all__saveg_read16()
        li.tag = doom_all__saveg_read16()
        for (j in range(2)) {
            if (li.sidenum[j] == -1) {
                continue
            }
            si = addr(sides[int(li.sidenum[j])])
            si.textureoffset = int(doom_all__saveg_read16()) << FRACBITS
            si.rowoffset = int(doom_all__saveg_read16()) << FRACBITS
            si.toptexture = doom_all__saveg_read16()
            si.bottomtexture = doom_all__saveg_read16()
            si.midtexture = doom_all__saveg_read16()
        }
        i++
        li++
    }
}

// P_ArchiveThinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ArchiveThinkers {
    var th : thinker_s?
    // save off the current thinkers
    th = thinkercap.next
    while (th != addr(thinkercap)) {
        {
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
                doom_all__saveg_write8(uint8(thinkerclass_t.tc_mobj))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_mobj_t(reinterpret<mobj_s?>(th))
                continue
            }
        } finally {
            th = th.next
        }
    }
    // I_Error ("P_ArchiveThinkers: Unknown thinker function");
    // add a terminating marker
    doom_all__saveg_write8(uint8(thinkerclass_t.tc_end))
}

// P_UnArchiveThinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UnArchiveThinkers {
    var tclass : uint8
    var currentthinker : thinker_s?
    var next : thinker_s?
    var mobj : mobj_s?
    // remove all the current thinkers
    currentthinker = thinkercap.next
    while (currentthinker != addr(thinkercap)) {
        next = currentthinker.next
        if (currentthinker._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
            P_RemoveMobj(reinterpret<mobj_s?>(currentthinker))
        } else {
            Z_Free(reinterpret<void?>(currentthinker))
        }
        currentthinker = next
    }
    P_InitThinkers()
    // read in saved thinkers
    while (1 != 0) {
        tclass = doom_all__saveg_read8()
        c_switch(int(tclass)) {
            case(0) {
                // end of list
                return
            }
            case(1) {
                doom_all__saveg_read_pad()
                mobj = reinterpret<mobj_s?>(Z_Malloc(typeinfo sizeof(type<mobj_s>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_mobj_t(mobj)
                mobj.target = null
                mobj.tracer = null
                P_SetThingPosition(mobj)
                mobj.info = addr(mobjinfo[0]) + end_index(int(mobj._c_type), 137)
                mobj.floorz = mobj.subsector.sector.floorheight
                mobj.ceilingz = mobj.subsector.sector.ceilingheight
                mobj.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)
                P_AddThinker(addr(mobj.thinker))
                break
            }
            case(_) {
                I_Error`va(cstr("Unknown tclass %i in savegame"), (int(tclass),))
            }
        }
    }
}

// Things to handle:
// T_MoveCeiling, (ceiling_t: sector_t * swizzle), - active list
// T_VerticalDoor, (vldoor_t: sector_t * swizzle),
// T_MoveFloor, (floormove_t: sector_t * swizzle),
// T_LightFlash, (lightflash_t: sector_t * swizzle),
// T_StrobeFlash, (strobe_t: sector_t *),
// T_Glow, (glow_t: sector_t *),
// T_PlatRaise, (plat_t: sector_t *), - active list
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ArchiveSpecials {
    var th : thinker_s?
    var i : int
    // save off the current thinkers
    th = thinkercap.next
    while (th != addr(thinkercap)) {
        {
            if (th._c_function.acv == null) {
                i = 0
                while (i < MAXCEILINGS) {
                    if (activeceilings[i] == reinterpret<ceiling_t?>(th)) {
                        break
                    }
                    i++
                }
                if (i < MAXCEILINGS) {
                    doom_all__saveg_write8(uint8(anon_1161.tc_ceiling))
                    doom_all__saveg_write_pad()
                    doom_all__saveg_write_ceiling_t(reinterpret<ceiling_t?>(th))
                }
                continue
            }
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_MoveCeiling)) {
                doom_all__saveg_write8(uint8(anon_1161.tc_ceiling))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_ceiling_t(reinterpret<ceiling_t?>(th))
                continue
            }
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_VerticalDoor)) {
                doom_all__saveg_write8(uint8(anon_1161.tc_door))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_vldoor_t(reinterpret<vldoor_t?>(th))
                continue
            }
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)) {
                doom_all__saveg_write8(uint8(anon_1161.tc_floor))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_floormove_t(reinterpret<floormove_t?>(th))
                continue
            }
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_PlatRaise)) {
                doom_all__saveg_write8(uint8(anon_1161.tc_plat))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_plat_t(reinterpret<plat_t?>(th))
                continue
            }
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_LightFlash)) {
                doom_all__saveg_write8(uint8(anon_1161.tc_flash))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_lightflash_t(reinterpret<lightflash_t?>(th))
                continue
            }
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_StrobeFlash)) {
                doom_all__saveg_write8(uint8(anon_1161.tc_strobe))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_strobe_t(reinterpret<strobe_t?>(th))
                continue
            }
            if (th._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_Glow)) {
                doom_all__saveg_write8(uint8(anon_1161.tc_glow))
                doom_all__saveg_write_pad()
                doom_all__saveg_write_glow_t(reinterpret<glow_t?>(th))
                continue
            }
        } finally {
            th = th.next
        }
    }
    // add a terminating marker
    doom_all__saveg_write8(uint8(anon_1161.tc_endspecials))
}

// P_UnArchiveSpecials
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UnArchiveSpecials {
    var tclass : uint8
    var ceiling : ceiling_t?
    var door : vldoor_t?
    var floor : floormove_t?
    var plat : plat_t?
    var flash : lightflash_t?
    var strobe : strobe_t?
    var glow : glow_t?
    // read in saved thinkers
    while (1 != 0) {
        tclass = doom_all__saveg_read8()
        c_switch(int(tclass)) {
            case(7) {
                // end of list
                return
            }
            case(0) {
                doom_all__saveg_read_pad()
                ceiling = reinterpret<ceiling_t?>(Z_Malloc(typeinfo sizeof(type<ceiling_t>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_ceiling_t(ceiling)
                ceiling.sector.specialdata = reinterpret<void?>(ceiling)
                if (ceiling.thinker._c_function.acp1 != null) {
                    ceiling.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveCeiling)
                }
                P_AddThinker(addr(ceiling.thinker))
                P_AddActiveCeiling(ceiling)
                break
            }
            case(1) {
                doom_all__saveg_read_pad()
                door = reinterpret<vldoor_t?>(Z_Malloc(typeinfo sizeof(type<vldoor_t>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_vldoor_t(door)
                door.sector.specialdata = reinterpret<void?>(door)
                door.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_VerticalDoor)
                P_AddThinker(addr(door.thinker))
                break
            }
            case(2) {
                doom_all__saveg_read_pad()
                floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_floormove_t(floor)
                floor.sector.specialdata = reinterpret<void?>(floor)
                floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
                P_AddThinker(addr(floor.thinker))
                break
            }
            case(3) {
                doom_all__saveg_read_pad()
                plat = reinterpret<plat_t?>(Z_Malloc(typeinfo sizeof(type<plat_t>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_plat_t(plat)
                plat.sector.specialdata = reinterpret<void?>(plat)
                if (plat.thinker._c_function.acp1 != null) {
                    plat.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_PlatRaise)
                }
                P_AddThinker(addr(plat.thinker))
                P_AddActivePlat(plat)
                break
            }
            case(4) {
                doom_all__saveg_read_pad()
                flash = reinterpret<lightflash_t?>(Z_Malloc(typeinfo sizeof(type<lightflash_t>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_lightflash_t(flash)
                flash.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_LightFlash)
                P_AddThinker(addr(flash.thinker))
                break
            }
            case(5) {
                doom_all__saveg_read_pad()
                strobe = reinterpret<strobe_t?>(Z_Malloc(typeinfo sizeof(type<strobe_t>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_strobe_t(strobe)
                strobe.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_StrobeFlash)
                P_AddThinker(addr(strobe.thinker))
                break
            }
            case(6) {
                doom_all__saveg_read_pad()
                glow = reinterpret<glow_t?>(Z_Malloc(typeinfo sizeof(type<glow_t>), int(anon_28.PU_LEVEL), null))
                doom_all__saveg_read_glow_t(glow)
                glow.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_Glow)
                P_AddThinker(addr(glow.thinker))
                break
            }
            case(_) {
                I_Error`va(cstr("P_UnarchiveSpecials:Unknown tclass %i in savegame"), (int(tclass),))
            }
        }
    }
}

// P_LoadVertexes
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadVertexes(lump : int) {
    var data : uint8?
    var i : int
    var ml : mapvertex_t?
    var li : vertex_t?
    // Determine number of lumps:
    // total lump length / vertex record length.
    numvertexes = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<mapvertex_t>)))
    // Allocate zone memory for buffer.
    vertexes = reinterpret<vertex_t?>(Z_Malloc(int(uint64(numvertexes) * uint64(typeinfo sizeof(type<vertex_t>))), int(anon_28.PU_LEVEL), null))
    // Load data into cache.
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    ml = reinterpret<mapvertex_t?>(data)
    li = vertexes
    // Copy and convert vertex coordinates,
    // internal representation as fixed.
    i = 0
    while (i < numvertexes) {
        li.x = int(ml.x) << FRACBITS
        li.y = int(ml.y) << FRACBITS
        i++
        li++
        ml++
    }
    // Free buffer memory.
    W_ReleaseLumpNum(lump)
}

// GetSectorAtNullAddress
[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetSectorAtNullAddress : sector_t? {
    if (GetSectorAtNullAddress_null_sector_is_initialized == 0) {
        crt::memset(reinterpret<void?>(addr(GetSectorAtNullAddress_null_sector)), 0, uint64(typeinfo sizeof(type<sector_t>)))
        I_GetMemoryValue(0u, reinterpret<void?>(addr(GetSectorAtNullAddress_null_sector.floorheight)), 4)
        I_GetMemoryValue(4u, reinterpret<void?>(addr(GetSectorAtNullAddress_null_sector.ceilingheight)), 4)
        GetSectorAtNullAddress_null_sector_is_initialized = 1u
    }
    return addr(GetSectorAtNullAddress_null_sector)
}

// P_LoadSegs
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadSegs(lump : int) {
    var data : uint8?
    var i : int
    var ml : mapseg_t?
    var li : seg_t?
    var ldef : line_s?
    var linedef : int
    var side : int
    var sidenum : int
    numsegs = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<mapseg_t>)))
    segs = reinterpret<seg_t?>(Z_Malloc(int(uint64(numsegs) * uint64(typeinfo sizeof(type<seg_t>))), int(anon_28.PU_LEVEL), null))
    crt::memset(reinterpret<void?>(segs), 0, uint64(numsegs) * uint64(typeinfo sizeof(type<seg_t>)))
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    ml = reinterpret<mapseg_t?>(data)
    li = segs
    i = 0
    while (i < numsegs) {
        li.v1 = addr(vertexes[int(ml.v1)])
        li.v2 = addr(vertexes[int(ml.v2)])
        li.angle = uint(int(ml.angle) << 16)
        li.offset = int(ml.offset) << 16
        linedef = int(ml.linedef)
        ldef = addr(lines[linedef])
        li.linedef = ldef
        side = int(ml.side)
        li.sidedef = addr(sides[int(ldef.sidenum[side])])
        li.frontsector = sides[int(ldef.sidenum[side])].sector
        if ((int(ldef.flags) & ML_TWOSIDED) != 0) {
            sidenum = int(ldef.sidenum[side ^ 1])
            // If the sidenum is out of range, this may be a "glass hack"
            // impassible window. Point at side #0 (this may not be
            // the correct Vanilla behavior; however, it seems to work for
            // OTTAWAU.WAD, which is the one place I've seen this trick
            // used).
            if (sidenum < 0 || sidenum >= numsides) {
                li.backsector = GetSectorAtNullAddress()
            } else {
                li.backsector = sides[sidenum].sector
            }
        } else {
            li.backsector = null
        }
        i++
        li++
        ml++
    }
    W_ReleaseLumpNum(lump)
}

// P_LoadSubsectors
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadSubsectors(lump : int) {
    var data : uint8?
    var i : int
    var ms : mapsubsector_t?
    var ss : subsector_s?
    numsubsectors = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<mapsubsector_t>)))
    subsectors = reinterpret<subsector_s?>(Z_Malloc(int(uint64(numsubsectors) * uint64(typeinfo sizeof(type<subsector_s>))), int(anon_28.PU_LEVEL), null))
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    ms = reinterpret<mapsubsector_t?>(data)
    crt::memset(reinterpret<void?>(subsectors), 0, uint64(numsubsectors) * uint64(typeinfo sizeof(type<subsector_s>)))
    ss = subsectors
    i = 0
    while (i < numsubsectors) {
        ss.numlines = ms.numsegs
        ss.firstline = ms.firstseg
        i++
        ss++
        ms++
    }
    W_ReleaseLumpNum(lump)
}

// P_LoadSectors
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadSectors(lump : int) {
    var data : uint8?
    var i : int
    var ms : mapsector_t?
    var ss : sector_t?
    numsectors = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<mapsector_t>)))
    sectors = reinterpret<sector_t?>(Z_Malloc(int(uint64(numsectors) * uint64(typeinfo sizeof(type<sector_t>))), int(anon_28.PU_LEVEL), null))
    crt::memset(reinterpret<void?>(sectors), 0, uint64(numsectors) * uint64(typeinfo sizeof(type<sector_t>)))
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    ms = reinterpret<mapsector_t?>(data)
    ss = sectors
    i = 0
    while (i < numsectors) {
        ss.floorheight = int(ms.floorheight) << FRACBITS
        ss.ceilingheight = int(ms.ceilingheight) << FRACBITS
        ss.floorpic = int16(R_FlatNumForName(addr(ms.floorpic[0])))
        ss.ceilingpic = int16(R_FlatNumForName(addr(ms.ceilingpic[0])))
        ss.lightlevel = ms.lightlevel
        ss.special = ms.special
        ss.tag = ms.tag
        ss.thinglist = null
        i++
        ss++
        ms++
    }
    W_ReleaseLumpNum(lump)
}

// P_LoadNodes
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadNodes(lump : int) {
    var data : uint8?
    var i : int
    var mn : mapnode_t?
    var no : node_t?
    numnodes = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<mapnode_t>)))
    nodes = reinterpret<node_t?>(Z_Malloc(int(uint64(numnodes) * uint64(typeinfo sizeof(type<node_t>))), int(anon_28.PU_LEVEL), null))
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    mn = reinterpret<mapnode_t?>(data)
    no = nodes
    i = 0
    while (i < numnodes) {
        no.x = int(mn.x) << FRACBITS
        no.y = int(mn.y) << FRACBITS
        no.dx = int(mn.dx) << FRACBITS
        no.dy = int(mn.dy) << FRACBITS
        for (j in range(2)) {
            no.children[j] = uint16(int16(mn.children[j]))
            for (k in range(4)) {
                no.bbox[j][k] = int(mn.bbox[j][k]) << FRACBITS
            }
        }
        i++
        no++
        mn++
    }
    W_ReleaseLumpNum(lump)
}

// P_LoadThings
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadThings(lump : int) {
    var data : uint8?
    var i : int
    var mt : mapthing_t?
    var spawnthing : mapthing_t
    var numthings : int
    var spawn : uint
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    numthings = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<mapthing_t>)))
    mt = reinterpret<mapthing_t?>(data)
    i = 0
    while (i < numthings) {
        spawn = 1u
        // Do not spawn cool, new monsters if !commercial
        if (gamemode != GameMode_t.commercial) {
            c_switch(int(mt._c_type)) {
                case(68, 64, 88, 89, 69, 67, 71, 65, 66, 84) {
                    // Arachnotron
                    // Archvile
                    // Boss Brain
                    // Boss Shooter
                    // Hell Knight
                    // Mancubus
                    // Pain Elemental
                    // Former Human Commando
                    // Revenant
                    // Wolf SS
                    spawn = 0u
                    break
                }
            }
        }
        if (spawn == 0u) {
            break
        }
        // Do spawn all other stuff.
        spawnthing.x = mt.x
        spawnthing.y = mt.y
        spawnthing.angle = mt.angle
        spawnthing._c_type = mt._c_type
        spawnthing._c_options = mt._c_options
        P_SpawnMapThing(addr(spawnthing))
        i++
        mt++
    }
    W_ReleaseLumpNum(lump)
}

// P_LoadLineDefs
// Also counts secret lines for intermissions.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadLineDefs(lump : int) {
    var data : uint8?
    var i : int
    var mld : maplinedef_t?
    var ld : line_s?
    var v1 : vertex_t?
    var v2 : vertex_t?
    numlines = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<maplinedef_t>)))
    lines = reinterpret<line_s?>(Z_Malloc(int(uint64(numlines) * uint64(typeinfo sizeof(type<line_s>))), int(anon_28.PU_LEVEL), null))
    crt::memset(reinterpret<void?>(lines), 0, uint64(numlines) * uint64(typeinfo sizeof(type<line_s>)))
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    mld = reinterpret<maplinedef_t?>(data)
    ld = lines
    i = 0
    while (i < numlines) {
        ld.flags = mld.flags
        ld.special = mld.special
        ld.tag = mld.tag
        ld.v1 = addr(vertexes[int(mld.v1)])
        v1 = ld.v1
        ld.v2 = addr(vertexes[int(mld.v2)])
        v2 = ld.v2
        ld.dx = v2.x - v1.x
        ld.dy = v2.y - v1.y
        if (ld.dx == 0) {
            ld.slopetype = slopetype_t.ST_VERTICAL
        } elif (ld.dy == 0) {
            ld.slopetype = slopetype_t.ST_HORIZONTAL
        } else {
            if (FixedDiv(ld.dy, ld.dx) > 0) {
                ld.slopetype = slopetype_t.ST_POSITIVE
            } else {
                ld.slopetype = slopetype_t.ST_NEGATIVE
            }
        }
        if (v1.x < v2.x) {
            ld.bbox[int(anon_982.BOXLEFT)] = v1.x
            ld.bbox[int(anon_982.BOXRIGHT)] = v2.x
        } else {
            ld.bbox[int(anon_982.BOXLEFT)] = v2.x
            ld.bbox[int(anon_982.BOXRIGHT)] = v1.x
        }
        if (v1.y < v2.y) {
            ld.bbox[int(anon_982.BOXBOTTOM)] = v1.y
            ld.bbox[int(anon_982.BOXTOP)] = v2.y
        } else {
            ld.bbox[int(anon_982.BOXBOTTOM)] = v2.y
            ld.bbox[int(anon_982.BOXTOP)] = v1.y
        }
        ld.sidenum[0] = mld.sidenum[0]
        ld.sidenum[1] = mld.sidenum[1]
        if (ld.sidenum[0] != -1) {
            ld.frontsector = sides[int(ld.sidenum[0])].sector
        } else {
            ld.frontsector = null
        }
        if (ld.sidenum[1] != -1) {
            ld.backsector = sides[int(ld.sidenum[1])].sector
        } else {
            ld.backsector = null
        }
        i++
        mld++
        ld++
    }
    W_ReleaseLumpNum(lump)
}

// P_LoadSideDefs
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadSideDefs(lump : int) {
    var data : uint8?
    var i : int
    var msd : mapsidedef_t?
    var sd : side_t?
    numsides = int(uint64(W_LumpLength(uint(lump))) / uint64(typeinfo sizeof(type<mapsidedef_t>)))
    sides = reinterpret<side_t?>(Z_Malloc(int(uint64(numsides) * uint64(typeinfo sizeof(type<side_t>))), int(anon_28.PU_LEVEL), null))
    crt::memset(reinterpret<void?>(sides), 0, uint64(numsides) * uint64(typeinfo sizeof(type<side_t>)))
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, int(anon_28.PU_STATIC)))
    msd = reinterpret<mapsidedef_t?>(data)
    sd = sides
    i = 0
    while (i < numsides) {
        sd.textureoffset = int(msd.textureoffset) << FRACBITS
        sd.rowoffset = int(msd.rowoffset) << FRACBITS
        sd.toptexture = int16(R_TextureNumForName(addr(msd.toptexture[0])))
        sd.bottomtexture = int16(R_TextureNumForName(addr(msd.bottomtexture[0])))
        sd.midtexture = int16(R_TextureNumForName(addr(msd.midtexture[0])))
        sd.sector = addr(sectors[int(msd.sector)])
        i++
        msd++
        sd++
    }
    W_ReleaseLumpNum(lump)
}

// P_LoadBlockMap
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LoadBlockMap(lump : int) {
    var count : int
    var lumplen : int
    lumplen = W_LumpLength(uint(lump))
    count = lumplen / 2
    blockmaplump = reinterpret<int16?>(Z_Malloc(lumplen, int(anon_28.PU_LEVEL), null))
    W_ReadLump(uint(lump), reinterpret<void?>(blockmaplump))
    blockmap = blockmaplump + 4
    // Swap all short integers to native byte ordering.
    for (i in range(count)) {
        blockmaplump[i] = blockmaplump[i]
    }
    // Read the header
    bmaporgx = int(blockmaplump[0]) << FRACBITS
    bmaporgy = int(blockmaplump[1]) << FRACBITS
    bmapwidth = int(blockmaplump[2])
    bmapheight = int(blockmaplump[3])
    // Clear out mobj chains
    count = int(uint64(typeinfo sizeof(type<mobj_s?>)) * uint64(bmapwidth) * uint64(bmapheight))
    blocklinks = reinterpret<mobj_s ??>(Z_Malloc(count, int(anon_28.PU_LEVEL), null))
    crt::memset(reinterpret<void?>(blocklinks), 0, uint64(count))
}

// P_GroupLines
// Builds sector line lists and subsector sector numbers.
// Finds block bounding boxes for sectors.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_GroupLines {
    var linebuffer : line_s ??
    var i : int
    var j : int
    var li : line_s?
    var sector : sector_t?
    var ss : subsector_s?
    var seg : seg_t?
    var bbox : int[4]
    var _c_block : int
    // look up sector number for each subsector
    ss = subsectors
    i = 0
    while (i < numsubsectors) {
        seg = addr(segs[int(ss.firstline)])
        ss.sector = seg.sidedef.sector
        i++
        ss++
    }
    // count number of lines in each sector
    li = lines
    doom_all__totallines = 0
    i = 0
    while (i < numlines) {
        doom_all__totallines++
        li.frontsector.linecount++
        if (li.backsector != null && li.backsector != li.frontsector) {
            li.backsector.linecount++
            doom_all__totallines++
        }
        i++
        li++
    }
    // build line tables for each sector
    linebuffer = reinterpret<line_s ??>(Z_Malloc(int(uint64(doom_all__totallines) * uint64(typeinfo sizeof(type<line_s?>))), int(anon_28.PU_LEVEL), null))
    for (i1 in range(numsectors)) {
        // Assign the line buffer for this sector
        sectors[i1].lines = linebuffer
        linebuffer += sectors[i1].linecount
        // Reset linecount to zero so in the next stage we can count
        // lines into the list.
        sectors[i1].linecount = 0
    }
    // Assign lines to sectors
    for (i1 in range(numlines)) {
        li = addr(lines[i1])
        if (li.frontsector != null) {
            sector = li.frontsector
            sector.lines[sector.linecount] = li
            sector.linecount++
        }
        if (li.backsector != null && li.frontsector != li.backsector) {
            sector = li.backsector
            sector.lines[sector.linecount] = li
            sector.linecount++
        }
    }
    // Generate bounding boxes for sectors
    sector = sectors
    i = 0
    while (i < numsectors) {
        M_ClearBox(addr(bbox[0]))
        j = 0
        while (j < sector.linecount) {
            li = sector.lines[j]
            M_AddToBox(addr(bbox[0]), li.v1.x, li.v1.y)
            M_AddToBox(addr(bbox[0]), li.v2.x, li.v2.y)
            j++
        }
        // set the degenmobj_t to the middle of the bounding box
        sector.soundorg.x = (bbox[int(anon_982.BOXRIGHT)] + bbox[int(anon_982.BOXLEFT)]) / 2
        sector.soundorg.y = (bbox[int(anon_982.BOXTOP)] + bbox[int(anon_982.BOXBOTTOM)]) / 2
        // adjust bounding box to map blocks
        _c_block = (bbox[int(anon_982.BOXTOP)] - bmaporgy + 32 * FRACUNIT) >> MAPBLOCKSHIFT
        _c_block = _c_block >= bmapheight ? bmapheight - 1 : _c_block
        sector.blockbox[int(anon_982.BOXTOP)] = _c_block
        _c_block = (bbox[int(anon_982.BOXBOTTOM)] - bmaporgy - 32 * FRACUNIT) >> MAPBLOCKSHIFT
        _c_block = _c_block < 0 ? 0 : _c_block
        sector.blockbox[int(anon_982.BOXBOTTOM)] = _c_block
        _c_block = (bbox[int(anon_982.BOXRIGHT)] - bmaporgx + 32 * FRACUNIT) >> MAPBLOCKSHIFT
        _c_block = _c_block >= bmapwidth ? bmapwidth - 1 : _c_block
        sector.blockbox[int(anon_982.BOXRIGHT)] = _c_block
        _c_block = (bbox[int(anon_982.BOXLEFT)] - bmaporgx - 32 * FRACUNIT) >> MAPBLOCKSHIFT
        _c_block = _c_block < 0 ? 0 : _c_block
        sector.blockbox[int(anon_982.BOXLEFT)] = _c_block
        i++
        sector++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__PadRejectArray(var _c_array : uint8?; len : uint) {
    var i : uint
    var byte_num : uint
    var dest : uint8?
    var padvalue : uint
    // Values to pad the REJECT array with:
    var rejectpad : uint[4] = fixed_array(uint(((doom_all__totallines * 4 + 3) & ~3) + 24), 0u, 50u, 1919505u)
    // Size
    // Part of z_zone block header
    // PU_LEVEL
    // DOOM_CONST_ZONEID
    // Copy values from rejectpad into the destination array.
    dest = _c_array
    i = 0u
    while (i < len && uint64(i) < uint64(typeinfo sizeof(type<uint[4]>))) {
        byte_num = i % 4u
        *dest = uint8((rejectpad[i / 4u] >> (byte_num * 8u)) & 255u)
        dest++
        i++
    }
    // We only have a limited pad size. Print a warning if the
    // REJECT lump is too small.
    if (uint64(len) > uint64(typeinfo sizeof(type<uint[4]>))) {
        fprintf(crt::c_stderr(), cstr("PadRejectArray: REJECT lump too short to pad! (%i > %i)\n"), len, typeinfo sizeof(type<uint[4]>))
        // Pad remaining space with 0 (or 0xff, if specified on command line).
        if (M_CheckParm(cstr("-reject_pad_with_ff")) != 0) {
            padvalue = 255u
        } else {
            padvalue = 3840u
        }
        crt::memset(reinterpret<void?>(_c_array + uint64(typeinfo sizeof(type<uint[4]>))), int(padvalue), uint64(len) - uint64(typeinfo sizeof(type<uint[4]>)))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__P_LoadReject(lumpnum : int) {
    var minlength : int
    var lumplen : int
    // Calculate the size that the REJECT lump *should* be.
    minlength = (numsectors * numsectors + 7) / 8
    // If the lump meets the minimum length, it can be loaded directly.
    // Otherwise, we need to allocate a buffer of the correct size
    // and pad it with appropriate data.
    lumplen = W_LumpLength(uint(lumpnum))
    if (lumplen >= minlength) {
        rejectmatrix = reinterpret<uint8?>(W_CacheLumpNum(lumpnum, int(anon_28.PU_LEVEL)))
    } else {
        rejectmatrix = reinterpret<uint8?>(Z_Malloc(minlength, int(anon_28.PU_LEVEL), reinterpret<void?>(addr(rejectmatrix))))
        W_ReadLump(uint(lumpnum), reinterpret<void?>(rejectmatrix))
        doom_all__PadRejectArray(rejectmatrix + lumplen, uint(minlength - lumplen))
    }
}

// P_SetupLevel
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SetupLevel(episode : int; map : int; playermask : int; skill : skill_t) {
    var lumpname : uint8[9]
    var lumpnum : int
    wminfo.maxfrags = 0
    totalsecret = wminfo.maxfrags
    totalitems = totalsecret
    totalkills = totalitems
    wminfo.partime = 180
    for (i in range(MAXPLAYERS)) {
        players[i].itemcount = 0
        players[i].secretcount = players[i].itemcount
        players[i].killcount = players[i].secretcount
    }
    // Initial height of PointOfView
    // will be set by player think.
    players[consoleplayer].viewz = 1
    // Make sure all sounds are stopped before Z_FreeTags.
    S_Start()
    Z_FreeTags(int(anon_28.PU_LEVEL), int(anon_28.PU_PURGELEVEL) - 1)
    // UNUSED W_Profile ();
    P_InitThinkers()
    // find map name
    if (gamemode == GameMode_t.commercial) {
        if (map < 10) {
            snprintf(addr(lumpname[0]), 9ul, cstr("map0%i"), map)
        } else {
            snprintf(addr(lumpname[0]), 9ul, cstr("map%i"), map)
        }
    } else {
        lumpname[0] = uint8('E')
        lumpname[1] = uint8('0' + episode)
        lumpname[2] = uint8('M')
        lumpname[3] = uint8('0' + map)
        lumpname[4] = 0u8
    }
    lumpnum = W_GetNumForName(addr(lumpname[0]))
    leveltime = 0
    // note: most of this ordering is important
    P_LoadBlockMap(lumpnum + int(anon_118.ML_BLOCKMAP))
    P_LoadVertexes(lumpnum + int(anon_118.ML_VERTEXES))
    P_LoadSectors(lumpnum + int(anon_118.ML_SECTORS))
    P_LoadSideDefs(lumpnum + int(anon_118.ML_SIDEDEFS))
    P_LoadLineDefs(lumpnum + int(anon_118.ML_LINEDEFS))
    P_LoadSubsectors(lumpnum + int(anon_118.ML_SSECTORS))
    P_LoadNodes(lumpnum + int(anon_118.ML_NODES))
    P_LoadSegs(lumpnum + int(anon_118.ML_SEGS))
    P_GroupLines()
    doom_all__P_LoadReject(lumpnum + int(anon_118.ML_REJECT))
    bodyqueslot = 0
    deathmatch_p = addr(deathmatchstarts[0])
    P_LoadThings(lumpnum + int(anon_118.ML_THINGS))
    // if deathmatch, randomly spawn the active players
    if (deathmatch != 0) {
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] != 0) {
                players[i].mo = null
                G_DeathMatchSpawnPlayer(i)
            }
        }
    }
    // clear special respawning que
    iquetail = 0
    iquehead = iquetail
    // set up world state
    P_SpawnSpecials()
    // build subsector connect matrix
    // UNUSED P_ConnectSubsectors ();
    // preload graphics
    if (precache != 0) {
        R_PrecacheLevel()
    }
}

// P_Init
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_Init {
    P_InitSwitchList()
    P_InitPicAnims()
    R_InitSprites(addr(sprnames[0]))
}

// P_DivlineSide
// Returns side 0 (front), 1 (back), or 2 (on).
[unsafe_deref, hint(unsafe_range_check)]
def P_DivlineSide(x : int; y : int; var node : divline_t?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (node.dx == 0) {
        if (x == node.x) {
            return 2
        }
        if (x <= node.x) {
            return int_of(node.dy > 0)
        }
        return int_of(node.dy < 0)
    }
    if (node.dy == 0) {
        if (x == node.y) {
            return 2
        }
        if (y <= node.y) {
            return int_of(node.dx < 0)
        }
        return int_of(node.dx > 0)
    }
    dx = x - node.x
    dy = y - node.y
    left = (node.dy >> FRACBITS) * (dx >> FRACBITS)
    right = (dy >> FRACBITS) * (node.dx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    if (left == right) {
        return 2
    }
    // back side
    return 1
}

// P_InterceptVector2
// Returns the fractional intercept point
// along the first divline.
// This is only called by the addthings and addlines traversers.
[unsafe_deref, hint(unsafe_range_check)]
def P_InterceptVector2(var v2 : divline_t?; var v1 : divline_t?) : int {
    var frac : int
    var num : int
    var den : int
    den = FixedMul(v1.dy >> 8, v2.dx) - FixedMul(v1.dx >> 8, v2.dy)
    if (den == 0) {
        return 0
    }
    // I_Error ("P_InterceptVector: parallel");
    num = FixedMul((v1.x - v2.x) >> 8, v1.dy) + FixedMul((v2.y - v1.y) >> 8, v1.dx)
    frac = FixedDiv(num, den)
    return frac
}

// P_CrossSubsector
// Returns true
// if strace crosses the given subsector successfully.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CrossSubsector(num : int) : uint {
    var seg : seg_t?
    var line : line_s?
    var s1 : int
    var s2 : int
    var count : int
    var sub : subsector_s?
    var front : sector_t?
    var back : sector_t?
    var opentop : int
    var openbottom : int
    var divl : divline_t
    var v1 : vertex_t?
    var v2 : vertex_t?
    var frac : int
    var slope : int
    if (num >= numsubsectors) {
        I_Error`va(cstr("P_CrossSubsector: ss %i with numss = %i"), (num, numsubsectors))
    }
    sub = addr(subsectors[num])
    // check lines
    count = int(sub.numlines)
    seg = addr(segs[int(sub.firstline)])
    {
        var _f = false
        while (true) {
            if (_f) {
                seg++
                count--
            }
            _f = true
            if (count == 0) {
                break
            }
            line = seg.linedef
            // allready checked other side?
            if (line.validcount == validcount) {
                continue
            }
            line.validcount = validcount
            v1 = line.v1
            v2 = line.v2
            s1 = P_DivlineSide(v1.x, v1.y, addr(strace))
            s2 = P_DivlineSide(v2.x, v2.y, addr(strace))
            // line isn't crossed?
            if (s1 == s2) {
                continue
            }
            divl.x = v1.x
            divl.y = v1.y
            divl.dx = v2.x - v1.x
            divl.dy = v2.y - v1.y
            s1 = P_DivlineSide(strace.x, strace.y, addr(divl))
            s2 = P_DivlineSide(t2x, t2y, addr(divl))
            // line isn't crossed?
            if (s1 == s2) {
                continue
            }
            // Backsector may be NULL if this is an "impassible
            // glass" hack line.
            if (line.backsector == null) {
                return 0u
            }
            // stop because it is not two sided anyway
            // might do this after updating validcount?
            if ((int(line.flags) & ML_TWOSIDED) == 0) {
                return 0u
            }
            // crosses a two sided line
            front = seg.frontsector
            back = seg.backsector
            // no wall to block sight with?
            if (front.floorheight == back.floorheight && front.ceilingheight == back.ceilingheight) {
                continue
            }
            // possible occluder
            // because of ceiling height differences
            if (front.ceilingheight < back.ceilingheight) {
                opentop = front.ceilingheight
            } else {
                opentop = back.ceilingheight
            }
            // because of ceiling height differences
            if (front.floorheight > back.floorheight) {
                openbottom = front.floorheight
            } else {
                openbottom = back.floorheight
            }
            // quick test for totally closed doors
            if (openbottom >= opentop) {
                // stop
                return 0u
            }
            frac = P_InterceptVector2(addr(strace), addr(divl))
            if (front.floorheight != back.floorheight) {
                slope = FixedDiv(openbottom - sightzstart, frac)
                if (slope > bottomslope) {
                    bottomslope = slope
                }
            }
            if (front.ceilingheight != back.ceilingheight) {
                slope = FixedDiv(opentop - sightzstart, frac)
                if (slope < topslope) {
                    topslope = slope
                }
            }
            if (topslope <= bottomslope) {
                // stop
                return 0u
            }
        }
    }
    // passed the subsector ok
    return 1u
}

// P_CrossBSPNode
// Returns true
// if strace crosses the given node successfully.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CrossBSPNode(bspnum : int) : uint {
    var bsp : node_t?
    var side : int
    if ((bspnum & NF_SUBSECTOR) != 0) {
        if (bspnum == -1) {
            return P_CrossSubsector(0)
        } else {
            return P_CrossSubsector(bspnum & (~NF_SUBSECTOR))
        }
    }
    bsp = addr(nodes[bspnum])
    // decide which side the start point is on
    side = P_DivlineSide(strace.x, strace.y, reinterpret<divline_t?>(bsp))
    if (side == 2) {
        // an "on" should cross both sides
        side = 0
    }
    // cross the starting side
    if (P_CrossBSPNode(int(bsp.children[side])) == 0) {
        return 0u
    }
    // the partition plane is crossed here
    if (side == P_DivlineSide(t2x, t2y, reinterpret<divline_t?>(bsp))) {
        // the line doesn't touch the other side
        return 1u
    }
    // cross the ending side
    return P_CrossBSPNode(int(bsp.children[side ^ 1]))
}

// P_CheckSight
// Returns true
// if a straight line between t1 and t2 is unobstructed.
// Uses REJECT.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CheckSight(var t1 : mobj_s?; var t2 : mobj_s?) : uint {
    var s1 : int
    var s2 : int
    var pnum : int
    var bytenum : int
    var bitnum : int
    // First check for trivial rejection.
    // Determine subsector entries in REJECT table.
    s1 = int(int64(t1.subsector.sector - sectors))
    s2 = int(int64(t2.subsector.sector - sectors))
    pnum = s1 * numsectors + s2
    bytenum = pnum >> 3
    bitnum = 1 << (pnum & 7)
    // Check in REJECT table.
    if ((int(rejectmatrix[bytenum]) & bitnum) != 0) {
        sightcounts[0]++
        // can't possibly be connected
        return 0u
    }
    // An unobstructed LOS is possible.
    // Now look from eyes of t1 to any part of t2.
    sightcounts[1]++
    validcount++
    sightzstart = t1.z + t1.height - (t1.height >> 2)
    topslope = (t2.z + t2.height) - sightzstart
    bottomslope = t2.z - sightzstart
    strace.x = t1.x
    strace.y = t1.y
    t2x = t2.x
    t2y = t2.y
    strace.dx = t2.x - t1.x
    strace.dy = t2.y - t1.y
    // the head node is the last node output
    return P_CrossBSPNode(numnodes - 1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_InitPicAnims {
    var i : int
    // Init animation
    lastanim = addr(anims[0])
    i = 0
    while (animdefs[i].istexture != -1) {
        {
            var startname : uint8?
            var endname : uint8?
            startname = addr(animdefs[i].startname[0])
            endname = addr(animdefs[i].endname[0])
            if (animdefs[i].istexture != 0) {
                // different episode ?
                if (R_CheckTextureNumForName(startname) == -1) {
                    continue
                }
                lastanim.picnum = R_TextureNumForName(endname)
                lastanim.basepic = R_TextureNumForName(startname)
            } else {
                if (W_CheckNumForName(startname) == -1) {
                    continue
                }
                lastanim.picnum = R_FlatNumForName(endname)
                lastanim.basepic = R_FlatNumForName(startname)
            }
            lastanim.istexture = uint(animdefs[i].istexture)
            lastanim.numpics = lastanim.picnum - lastanim.basepic + 1
            if (lastanim.numpics < 2) {
                I_Error`va(cstr("P_InitPicAnims: bad cycle from %s to %s"), (startname, endname))
            }
            lastanim.speed = animdefs[i].speed
            lastanim++
        } finally {
            i++
        }
    }
}

// getSide()
// Will return a side_t
// given the number of the current sector,
// the line number, and the side (0/1) that you want.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def getSide(currentSector : int; line : int; side : int) : side_t? {
    return addr(sides[int(sectors[currentSector].lines[line].sidenum[side])])
}

// getSector()
// Will return a sector_t
// given the number of the current sector,
// the line number and the side (0/1) that you want.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def getSector(currentSector : int; line : int; side : int) : sector_t? {
    return sides[int(sectors[currentSector].lines[line].sidenum[side])].sector
}

// twoSided()
// Given the sector number and the line number,
// it will tell you whether the line is two-sided or not.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def twoSided(sector : int; line : int) : int {
    return int(sectors[sector].lines[line].flags) & ML_TWOSIDED
}

// getNextSector()
// Return sector_t * of sector next to current.
// NULL if not two-sided line
[unsafe_deref, hint(unsafe_range_check)]
def getNextSector(var line : line_s?; var sec : sector_t?) : sector_t? {
    if ((int(line.flags) & ML_TWOSIDED) == 0) {
        return null
    }
    if (line.frontsector == sec) {
        return line.backsector
    }
    return line.frontsector
}

// P_FindLowestFloorSurrounding()
// FIND LOWEST FLOOR HEIGHT IN SURROUNDING SECTORS
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindLowestFloorSurrounding(var sec : sector_t?) : int {
    var check : line_s?
    var other : sector_t?
    var floor : int = sec.floorheight
    for (i in range(sec.linecount)) {
        check = sec.lines[i]
        other = getNextSector(check, sec)
        if (other == null) {
            continue
        }
        if (other.floorheight < floor) {
            floor = other.floorheight
        }
    }
    return floor
}

// P_FindHighestFloorSurrounding()
// FIND HIGHEST FLOOR HEIGHT IN SURROUNDING SECTORS
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindHighestFloorSurrounding(var sec : sector_t?) : int {
    var check : line_s?
    var other : sector_t?
    var floor : int = -500 * FRACUNIT
    for (i in range(sec.linecount)) {
        check = sec.lines[i]
        other = getNextSector(check, sec)
        if (other == null) {
            continue
        }
        if (other.floorheight > floor) {
            floor = other.floorheight
        }
    }
    return floor
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindNextHighestFloor(var sec : sector_t?; currentheight : int) : int {
    var i : int
    var h : int
    var min : int
    var check : line_s?
    var other : sector_t?
    var height : int = currentheight
    var heightlist : int[22]
    i = 0
    h = 0
    while (i < sec.linecount) {
        {
            check = sec.lines[i]
            other = getNextSector(check, sec)
            if (other == null) {
                continue
            }
            if (other.floorheight > height) {
                // Emulation of memory (stack) overflow
                if (h == MAX_ADJOINING_SECTORS + 1) {
                    height = other.floorheight
                } elif (h == MAX_ADJOINING_SECTORS + 2) {
                    // Fatal overflow: game crashes at 22 textures
                    I_Error`va(cstr("Sector with more than 22 adjoining sectors. Vanilla will crash here"), VaNone())
                }
                let _t0 = h
                h++
                heightlist[_t0] = other.floorheight
            }
        } finally {
            i++
        }
    }
    // Find lowest height in list
    if (h == 0) {
        return currentheight
    }
    min = heightlist[0]
    // Range checking?
    for (i1 in range(1, h)) {
        if (heightlist[i1] < min) {
            min = heightlist[i1]
        }
    }
    return min
}

// FIND LOWEST CEILING IN THE SURROUNDING SECTORS
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindLowestCeilingSurrounding(var sec : sector_t?) : int {
    var check : line_s?
    var other : sector_t?
    var height : int = 2147483647
    for (i in range(sec.linecount)) {
        check = sec.lines[i]
        other = getNextSector(check, sec)
        if (other == null) {
            continue
        }
        if (other.ceilingheight < height) {
            height = other.ceilingheight
        }
    }
    return height
}

// FIND HIGHEST CEILING IN THE SURROUNDING SECTORS
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindHighestCeilingSurrounding(var sec : sector_t?) : int {
    var check : line_s?
    var other : sector_t?
    var height : int = 0
    for (i in range(sec.linecount)) {
        check = sec.lines[i]
        other = getNextSector(check, sec)
        if (other == null) {
            continue
        }
        if (other.ceilingheight > height) {
            height = other.ceilingheight
        }
    }
    return height
}

// RETURN NEXT SECTOR # THAT LINE TAG REFERS TO
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindSectorFromLineTag(var line : line_s?; start : int) : int {
    for (i in range(start + 1, numsectors)) {
        if (sectors[i].tag == line.tag) {
            return i
        }
    }
    return -1
}

// Find minimum light from an adjacent sector
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindMinSurroundingLight(var sector : sector_t?; max : int) : int {
    var min : int
    var line : line_s?
    var check : sector_t?
    min = max
    for (i in range(sector.linecount)) {
        line = sector.lines[i]
        check = getNextSector(line, sector)
        if (check == null) {
            continue
        }
        if (int(check.lightlevel) < min) {
            min = int(check.lightlevel)
        }
    }
    return min
}

// P_CrossSpecialLine - TRIGGER
// Called every time a thing origin is about
// to cross a line with a non 0 special.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CrossSpecialLine(linenum : int; side : int; var thing : mobj_s?) {
    var line : line_s?
    var ok : int
    line = addr(lines[linenum])
    // Triggers that other things can activate
    if (thing.player == null) {
        // Things that should NOT trigger specials...
        c_switch(thing._c_type) {
            case(mobjtype_t.MT_ROCKET, mobjtype_t.MT_PLASMA, mobjtype_t.MT_BFG, mobjtype_t.MT_TROOPSHOT, mobjtype_t.MT_HEADSHOT, mobjtype_t.MT_BRUISERSHOT) {
                return
                break
            }
            case(_) {
                break
            }
        }
        ok = 0
        c_switch(int(line.special)) {
            case(39, 97, 125, 126, 4, 10, 88) {
                // TELEPORT TRIGGER
                // TELEPORT RETRIGGER
                // TELEPORT MONSTERONLY TRIGGER
                // TELEPORT MONSTERONLY RETRIGGER
                // RAISE DOOR
                // PLAT DOWN-WAIT-UP-STAY TRIGGER
                // PLAT DOWN-WAIT-UP-STAY RETRIGGER
                ok = 1
                break
            }
        }
        if (ok == 0) {
            return
        }
    }
    // Note: could use some const's here.
    c_switch(int(line.special)) {
        case(2) {
            // TRIGGERS.
            // All from here to RETRIGGERS.
            // Open Door
            EV_DoDoor(line, vldoor_e.vld_open)
            line.special = int16(0)
            break
        }
        case(3) {
            // Close Door
            EV_DoDoor(line, vldoor_e.vld_close)
            line.special = int16(0)
            break
        }
        case(4) {
            // Raise Door
            EV_DoDoor(line, vldoor_e.vld_normal)
            line.special = int16(0)
            break
        }
        case(5) {
            // Raise Floor
            EV_DoFloor(line, floor_e.raiseFloor)
            line.special = int16(0)
            break
        }
        case(6) {
            // Fast Ceiling Crush & Raise
            EV_DoCeiling(line, ceiling_e.fastCrushAndRaise)
            line.special = int16(0)
            break
        }
        case(8) {
            // Build Stairs
            EV_BuildStairs(line, stair_e.build8)
            line.special = int16(0)
            break
        }
        case(10) {
            // PlatDownWaitUp
            EV_DoPlat(line, plattype_e.downWaitUpStay, 0)
            line.special = int16(0)
            break
        }
        case(12) {
            // Light Turn On - brightest near
            EV_LightTurnOn(line, 0)
            line.special = int16(0)
            break
        }
        case(13) {
            // Light Turn On 255
            EV_LightTurnOn(line, 255)
            line.special = int16(0)
            break
        }
        case(16) {
            // Close Door 30
            EV_DoDoor(line, vldoor_e.vld_close30ThenOpen)
            line.special = int16(0)
            break
        }
        case(17) {
            // Start Light Strobing
            EV_StartLightStrobing(line)
            line.special = int16(0)
            break
        }
        case(19) {
            // Lower Floor
            EV_DoFloor(line, floor_e.lowerFloor)
            line.special = int16(0)
            break
        }
        case(22) {
            // Raise floor to nearest height and change texture
            EV_DoPlat(line, plattype_e.raiseToNearestAndChange, 0)
            line.special = int16(0)
            break
        }
        case(25) {
            // Ceiling Crush and Raise
            EV_DoCeiling(line, ceiling_e.crushAndRaise)
            line.special = int16(0)
            break
        }
        case(30) {
            // Raise floor to shortest texture height
            // on either side of lines.
            EV_DoFloor(line, floor_e.raiseToTexture)
            line.special = int16(0)
            break
        }
        case(35) {
            // Lights Very Dark
            EV_LightTurnOn(line, 35)
            line.special = int16(0)
            break
        }
        case(36) {
            // Lower Floor (TURBO)
            EV_DoFloor(line, floor_e.turboLower)
            line.special = int16(0)
            break
        }
        case(37) {
            // LowerAndChange
            EV_DoFloor(line, floor_e.lowerAndChange)
            line.special = int16(0)
            break
        }
        case(38) {
            // Lower Floor To Lowest
            EV_DoFloor(line, floor_e.lowerFloorToLowest)
            line.special = int16(0)
            break
        }
        case(39) {
            // TELEPORT!
            EV_Teleport(line, side, thing)
            line.special = int16(0)
            break
        }
        case(40) {
            // RaiseCeilingLowerFloor
            EV_DoCeiling(line, ceiling_e.raiseToHighest)
            EV_DoFloor(line, floor_e.lowerFloorToLowest)
            line.special = int16(0)
            break
        }
        case(44) {
            // Ceiling Crush
            EV_DoCeiling(line, ceiling_e.lowerAndCrush)
            line.special = int16(0)
            break
        }
        case(52) {
            // EXIT!
            G_ExitLevel()
            break
        }
        case(53) {
            // Perpetual Platform Raise
            EV_DoPlat(line, plattype_e.perpetualRaise, 0)
            line.special = int16(0)
            break
        }
        case(54) {
            // Platform Stop
            EV_StopPlat(line)
            line.special = int16(0)
            break
        }
        case(56) {
            // Raise Floor Crush
            EV_DoFloor(line, floor_e.raiseFloorCrush)
            line.special = int16(0)
            break
        }
        case(57) {
            // Ceiling Crush Stop
            EV_CeilingCrushStop(line)
            line.special = int16(0)
            break
        }
        case(58) {
            // Raise Floor 24
            EV_DoFloor(line, floor_e.raiseFloor24)
            line.special = int16(0)
            break
        }
        case(59) {
            // Raise Floor 24 And Change
            EV_DoFloor(line, floor_e.raiseFloor24AndChange)
            line.special = int16(0)
            break
        }
        case(104) {
            // Turn lights off in sector(tag)
            EV_TurnTagLightsOff(line)
            line.special = int16(0)
            break
        }
        case(108) {
            // Blazing Door Raise (faster than TURBO!)
            EV_DoDoor(line, vldoor_e.vld_blazeRaise)
            line.special = int16(0)
            break
        }
        case(109) {
            // Blazing Door Open (faster than TURBO!)
            EV_DoDoor(line, vldoor_e.vld_blazeOpen)
            line.special = int16(0)
            break
        }
        case(100) {
            // Build Stairs Turbo 16
            EV_BuildStairs(line, stair_e.turbo16)
            line.special = int16(0)
            break
        }
        case(110) {
            // Blazing Door Close (faster than TURBO!)
            EV_DoDoor(line, vldoor_e.vld_blazeClose)
            line.special = int16(0)
            break
        }
        case(119) {
            // Raise floor to nearest surr. floor
            EV_DoFloor(line, floor_e.raiseFloorToNearest)
            line.special = int16(0)
            break
        }
        case(121) {
            // Blazing PlatDownWaitUpStay
            EV_DoPlat(line, plattype_e.blazeDWUS, 0)
            line.special = int16(0)
            break
        }
        case(124) {
            // Secret EXIT
            G_SecretExitLevel()
            break
        }
        case(125) {
            // TELEPORT MonsterONLY
            if (thing.player == null) {
                EV_Teleport(line, side, thing)
                line.special = int16(0)
            }
            break
        }
        case(130) {
            // Raise Floor Turbo
            EV_DoFloor(line, floor_e.raiseFloorTurbo)
            line.special = int16(0)
            break
        }
        case(141) {
            // Silent Ceiling Crush & Raise
            EV_DoCeiling(line, ceiling_e.silentCrushAndRaise)
            line.special = int16(0)
            break
        }
        case(72) {
            // RETRIGGERS. All from here till end.
            // Ceiling Crush
            EV_DoCeiling(line, ceiling_e.lowerAndCrush)
            break
        }
        case(73) {
            // Ceiling Crush and Raise
            EV_DoCeiling(line, ceiling_e.crushAndRaise)
            break
        }
        case(74) {
            // Ceiling Crush Stop
            EV_CeilingCrushStop(line)
            break
        }
        case(75) {
            // Close Door
            EV_DoDoor(line, vldoor_e.vld_close)
            break
        }
        case(76) {
            // Close Door 30
            EV_DoDoor(line, vldoor_e.vld_close30ThenOpen)
            break
        }
        case(77) {
            // Fast Ceiling Crush & Raise
            EV_DoCeiling(line, ceiling_e.fastCrushAndRaise)
            break
        }
        case(79) {
            // Lights Very Dark
            EV_LightTurnOn(line, 35)
            break
        }
        case(80) {
            // Light Turn On - brightest near
            EV_LightTurnOn(line, 0)
            break
        }
        case(81) {
            // Light Turn On 255
            EV_LightTurnOn(line, 255)
            break
        }
        case(82) {
            // Lower Floor To Lowest
            EV_DoFloor(line, floor_e.lowerFloorToLowest)
            break
        }
        case(83) {
            // Lower Floor
            EV_DoFloor(line, floor_e.lowerFloor)
            break
        }
        case(84) {
            // LowerAndChange
            EV_DoFloor(line, floor_e.lowerAndChange)
            break
        }
        case(86) {
            // Open Door
            EV_DoDoor(line, vldoor_e.vld_open)
            break
        }
        case(87) {
            // Perpetual Platform Raise
            EV_DoPlat(line, plattype_e.perpetualRaise, 0)
            break
        }
        case(88) {
            // PlatDownWaitUp
            EV_DoPlat(line, plattype_e.downWaitUpStay, 0)
            break
        }
        case(89) {
            // Platform Stop
            EV_StopPlat(line)
            break
        }
        case(90) {
            // Raise Door
            EV_DoDoor(line, vldoor_e.vld_normal)
            break
        }
        case(91) {
            // Raise Floor
            EV_DoFloor(line, floor_e.raiseFloor)
            break
        }
        case(92) {
            // Raise Floor 24
            EV_DoFloor(line, floor_e.raiseFloor24)
            break
        }
        case(93) {
