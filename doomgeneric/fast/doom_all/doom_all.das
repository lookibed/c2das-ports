[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__InitSfxModule(use_sfx_prefix : uint) {
    var i : int
    doom_all__sound_module = null
    i = 0
    while (doom_all__sound_modules[i] != null) {
        // Is the sfx device in the list of devices supported by
        // this module?
        if (doom_all__SndDeviceInList(enum_from_int(type<snddevice_t>, snd_sfxdevice), doom_all__sound_modules[i].sound_devices,
                doom_all__sound_modules[i].num_sound_devices) != 0) {
            // Initialize the module
            if (invoke(doom_all__sound_modules[i].Init, use_sfx_prefix) != 0) {
                doom_all__sound_module = doom_all__sound_modules[i]
                return
            }
        }
        i++
    }
}

