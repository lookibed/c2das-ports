    // Yet another hack...
    if ((gamemode == GameMode_t.registered) && (choice > 2)) {
        fprintf(crt::c_stderr(), cstr("M_Episode: 4th episode requires UltimateDOOM\n"))
        choice = 0
    }
    epi = choice
    M_SetupNextMenu(addr(NewDef))
}

