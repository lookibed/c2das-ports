[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__FindNearestColor(var palette : uint8?; r : int; g : int; b : int) : int {
    var col : uint8?
    var best : int
    var best_diff : int
    var diff : int
    best = 0
    best_diff = 2147483647
    for (i in range(256)) {
        col = palette + i * 3
        diff = (r - int(col[0])) * (r - int(col[0])) + (g - int(col[1])) * (g - int(col[1])) + (b - int(col[2])) * (b - int(col[2]))
        if (diff == 0) {
            return i
        } elif (diff < best_diff) {
            best = i
            best_diff = diff
        }
    }
    return best
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GenerateStretchTable(var palette : uint8?; pct : int) : uint8? {
    var result : uint8?
    var r : int
    var g : int
    var b : int
    var col1 : uint8?
    var col2 : uint8?
    result = reinterpret<uint8?>(Z_Malloc(256 * 256, int(anon_28.PU_STATIC), null))
    for (x in range(256)) {
        for (y in range(256)) {
            col1 = palette + x * 3
            col2 = palette + y * 3
            r = (int(col1[0]) * pct + int(col2[0]) * (100 - pct)) / 100
            g = (int(col1[1]) * pct + int(col2[1]) * (100 - pct)) / 100
            b = (int(col1[2]) * pct + int(col2[2]) * (100 - pct)) / 100
            result[x * 256 + y] = uint8(doom_all__FindNearestColor(palette, r, g, b))
        }
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__I_InitStretchTables(var palette : uint8?) {
    if (doom_all__stretch_tables[0] != null) {
        return
    }
    // We only actually need two lookup tables:
    // mix 0% = just write line 1
    // mix 20% = stretch_tables[0]
    // mix 40% = stretch_tables[1]
    // mix 60% = stretch_tables[1] used backwards
    // mix 80% = stretch_tables[0] used backwards
    // mix 100% = just write line 2
    fprintf(crt::c_stderr(), cstr("I_InitStretchTables: Generating lookup tables.."))
    crt::fflush(crt::c_stdout())
    doom_all__stretch_tables[0] = doom_all__GenerateStretchTable(palette, 20)
    fprintf(crt::c_stderr(), cstr(".."))
    crt::fflush(crt::c_stdout())
    doom_all__stretch_tables[1] = doom_all__GenerateStretchTable(palette, 40)
    fprintf(crt::c_stderr(), cstr("%s\n"), addr(c2das_empty[0]))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__I_InitSquashTable(var palette : uint8?) {
    if (doom_all__half_stretch_table != null) {
        return
    }
    fprintf(crt::c_stderr(), cstr("I_InitSquashTable: Generating lookup table.."))
    crt::fflush(crt::c_stdout())
    doom_all__half_stretch_table = doom_all__GenerateStretchTable(palette, 50)
    fprintf(crt::c_stderr(), cstr("%s\n"), addr(c2das_empty[0]))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_ResetScaleTables(var palette : uint8?) {
    if (doom_all__stretch_tables[0] != null) {
        Z_Free(reinterpret<void?>(doom_all__stretch_tables[0]))
        Z_Free(reinterpret<void?>(doom_all__stretch_tables[1]))
        fprintf(crt::c_stderr(), cstr("I_ResetScaleTables: Regenerating lookup tables..\n"))
        doom_all__stretch_tables[0] = doom_all__GenerateStretchTable(palette, 20)
        doom_all__stretch_tables[1] = doom_all__GenerateStretchTable(palette, 40)
    }
    if (doom_all__half_stretch_table != null) {
        Z_Free(reinterpret<void?>(doom_all__half_stretch_table))
        fprintf(crt::c_stderr(), cstr("I_ResetScaleTables: Regenerating lookup table..\n"))
        doom_all__half_stretch_table = doom_all__GenerateStretchTable(palette, 50)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WriteBlendedLine1x(var dest : uint8?; var src1 : uint8?; var src2 : uint8?; var stretch_table : uint8?) {
    for (x in range(SCREENWIDTH)) {
        *dest = stretch_table[int(*src1) * 256 + int(*src2)]
        dest++
        src1++
        src2++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__I_Stretch1x(x1 : int; y1 : int; x2 : int; y2 : int) : uint {
    var bufp : uint8?
    var screenp : uint8?
    var y : int
    // Only works with full screen update
    if (x1 != 0 || y1 != 0 || x2 != SCREENWIDTH || y2 != SCREENHEIGHT) {
        return 0u
    }
    // Need to byte-copy from buffer into the screen buffer
    bufp = doom_all__src_buffer + y1 * SCREENWIDTH + x1
    screenp = doom_all__dest_buffer + y1 * doom_all__dest_pitch + x1
    // For every 5 lines of src_buffer, 6 lines are written to dest_buffer
    // (200 -> 240)
    y = 0
    while (y < SCREENHEIGHT) {
        // 100% line 0
        crt::memcpy(reinterpret<void?>(screenp), reinterpret<void?>(bufp), uint64(SCREENWIDTH))
        screenp += doom_all__dest_pitch
        // 20% line 0, 80% line 1
        doom_all__WriteBlendedLine1x(screenp, bufp, bufp + SCREENWIDTH, doom_all__stretch_tables[0])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 40% line 1, 60% line 2
        doom_all__WriteBlendedLine1x(screenp, bufp, bufp + SCREENWIDTH, doom_all__stretch_tables[1])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 60% line 2, 40% line 3
        doom_all__WriteBlendedLine1x(screenp, bufp + SCREENWIDTH, bufp, doom_all__stretch_tables[1])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 80% line 3, 20% line 4
        doom_all__WriteBlendedLine1x(screenp, bufp + SCREENWIDTH, bufp, doom_all__stretch_tables[0])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 100% line 4
        crt::memcpy(reinterpret<void?>(screenp), reinterpret<void?>(bufp), uint64(SCREENWIDTH))
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        y += 5
    }
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WriteLine2x(var dest : uint8?; var src : uint8?) {
    for (x in range(SCREENWIDTH)) {
        dest[0] = *src
        dest[1] = *src
        dest += 2
        src++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WriteBlendedLine2x(var dest : uint8?; var src1 : uint8?; var src2 : uint8?; var stretch_table : uint8?) {
    var val : int
    for (x in range(SCREENWIDTH)) {
        val = int(stretch_table[int(*src1) * 256 + int(*src2)])
        dest[0] = uint8(val)
        dest[1] = uint8(val)
        dest += 2
        src1++
        src2++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__I_Stretch2x(x1 : int; y1 : int; x2 : int; y2 : int) : uint {
    var bufp : uint8?
    var screenp : uint8?
    var y : int
    // Only works with full screen update
    if (x1 != 0 || y1 != 0 || x2 != SCREENWIDTH || y2 != SCREENHEIGHT) {
        return 0u
    }
    // Need to byte-copy from buffer into the screen buffer
    bufp = doom_all__src_buffer + y1 * SCREENWIDTH + x1
    screenp = doom_all__dest_buffer + y1 * doom_all__dest_pitch + x1
    // For every 5 lines of src_buffer, 12 lines are written to dest_buffer.
    // (200 -> 480)
    y = 0
    while (y < SCREENHEIGHT) {
        // 100% line 0
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        // 100% line 0
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        // 40% line 0, 60% line 1
        doom_all__WriteBlendedLine2x(screenp, bufp, bufp + SCREENWIDTH, doom_all__stretch_tables[1])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 100% line 1
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        // 80% line 1, 20% line 2
        doom_all__WriteBlendedLine2x(screenp, bufp + SCREENWIDTH, bufp, doom_all__stretch_tables[0])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 100% line 2
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        // 100% line 2
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        // 20% line 2, 80% line 3
        doom_all__WriteBlendedLine2x(screenp, bufp, bufp + SCREENWIDTH, doom_all__stretch_tables[0])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 100% line 3
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        // 60% line 3, 40% line 4
        doom_all__WriteBlendedLine2x(screenp, bufp + SCREENWIDTH, bufp, doom_all__stretch_tables[1])
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        // 100% line 4
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        // 100% line 4
        doom_all__WriteLine2x(screenp, bufp)
        screenp += doom_all__dest_pitch
        bufp += SCREENWIDTH
        y += 5
    }
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WriteLine3x(var dest : uint8?; var src : uint8?) {
    for (x in range(SCREENWIDTH)) {
