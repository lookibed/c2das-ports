[unsafe_deref, hint(unsafe_range_check)]
def G_DoNewGame {
    demoplayback = 0u
    netdemo = 0u
    netgame = 0u
    deathmatch = 0
    playeringame[3] = 0u
    playeringame[2] = playeringame[3]
    playeringame[1] = playeringame[2]
    respawnparm = 0u
    fastparm = 0u
    nomonsters = 0u
    consoleplayer = 0
    G_InitNew(d_skill, d_episode, d_map)
    gameaction = gameaction_t.ga_nothing
}

[unsafe_deref, hint(unsafe_range_check)]
def G_InitNew(var skill : skill_t; var episode : int; var map : int) {
    var skytexturename : uint8?
    if (paused != 0) {
        paused = 0u
        S_ResumeSound()
    }
    // Note: This commented-out block of code was added at some point
    // between the DOS version(s) and the Doom source release. It isn't
    // found in disassemblies of the DOS version and causes IDCLEV and
    // the -warp command line parameter to behave differently.
    // This is left here for posterity.
    // This was quite messy with SPECIAL and commented parts.
    // Supposedly hacks to make the latest edition work.
    // It might not work properly.
    // if (episode < 1)
    // episode = 1;
    // if ( gamemode == retail )
    // {
    // if (episode > 4)
    // episode = 4;
    // }
    // else if ( gamemode == shareware )
    // {
    // if (episode > 1)
    // episode = 1; // only start episode 1 on shareware
    // }
    // else
    // {
    // if (episode > 3)
    // episode = 3;
    // }
    if (int(skill) > int(skill_t.sk_nightmare)) {
        skill = skill_t.sk_nightmare
    }
    if (uint(gameversion) >= uint(GameVersion_t.exe_ultimate)) {
        if (episode == 0) {
            episode = 4
        }
    } else {
        if (episode < 1) {
            episode = 1
        }
        if (episode > 3) {
            episode = 3
        }
    }
    if (episode > 1 && gamemode == GameMode_t.shareware) {
        episode = 1
    }
    if (map < 1) {
        map = 1
    }
    if ((map > 9) && (gamemode != GameMode_t.commercial)) {
        map = 9
    }
    M_ClearRandom()
    if (skill == skill_t.sk_nightmare || respawnparm != 0) {
        respawnmonsters = 1u
    } else {
        respawnmonsters = 0u
    }
    if (fastparm != 0 || (skill == skill_t.sk_nightmare && gameskill != skill_t.sk_nightmare)) {
        for (i in range(int(statenum_t.S_SARG_RUN1), int(statenum_t.S_SARG_PAIN2) + 1)) {
            states[i].tics >>= 1
        }
        mobjinfo[int(mobjtype_t.MT_BRUISERSHOT)].speed = 20 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_HEADSHOT)].speed = 20 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_TROOPSHOT)].speed = 20 * FRACUNIT
    } elif (skill != skill_t.sk_nightmare && gameskill == skill_t.sk_nightmare) {
        for (i in range(int(statenum_t.S_SARG_RUN1), int(statenum_t.S_SARG_PAIN2) + 1)) {
            states[i].tics <<= 1
        }
        mobjinfo[int(mobjtype_t.MT_BRUISERSHOT)].speed = 15 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_HEADSHOT)].speed = 10 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_TROOPSHOT)].speed = 10 * FRACUNIT
    }
    // force players to be initialized upon first level load
    for (i in range(MAXPLAYERS)) {
        players[i].playerstate = playerstate_t.PST_REBORN
    }
    // will be set false if a demo
    usergame = 1u
    paused = 0u
    demoplayback = 0u
    automapactive = 0u
    viewactive = 1u
    gameepisode = episode
    gamemap = map
    gameskill = skill
    viewactive = 1u
    // Set the sky to use.
    // Note: This IS broken, but it is how Vanilla Doom behaves.
    // See http://doomwiki.org/wiki/Sky_never_changes_in_Doom_II.
    // Because we set the sky here at the start of a game, not at the
    // start of a level, the sky texture never changes unless we
    // restore from a saved game. This was fixed before the Doom
    // source release, but this IS the way Vanilla DOS Doom behaves.
    if (gamemode == GameMode_t.commercial) {
        if (gamemap < 12) {
            skytexturename = cstr("SKY1")
        } elif (gamemap < 21) {
            skytexturename = cstr("SKY2")
        } else {
            skytexturename = cstr("SKY3")
        }
    } else {
        c_switch(gameepisode) {
            case(1, _) {
                skytexturename = cstr("SKY1")
                break
            }
            case(2) {
                skytexturename = cstr("SKY2")
                break
            }
            case(3) {
                skytexturename = cstr("SKY3")
                break
            }
            case(4) {
                // Special Edition sky
                skytexturename = cstr("SKY4")
                break
            }
        }
    }
    skytexturename = skytexturename
    skytexture = R_TextureNumForName(skytexturename)
    G_DoLoadLevel()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_ReadDemoTiccmd(var cmd : ticcmd_t?) {
    if (int(*demo_p) == DEMOMARKER) {
        // end of demo data stream
        G_CheckDemoStatus()
        return
    }
    var _t0 = demo_p
    demo_p++
    cmd.forwardmove = int8(*_t0)
    var _t1 = demo_p
    demo_p++
    cmd.sidemove = int8(*_t1)
    // If this is a longtics demo, read back in higher resolution
    if (longtics != 0) {
        var _t2 = demo_p
        demo_p++
        cmd.angleturn = int16(*_t2)
        var _t3 = demo_p
        demo_p++
        cmd.angleturn = int16(int(cmd.angleturn) | int(*_t3) << 8)
    } else {
        var _t4 = demo_p
        demo_p++
        cmd.angleturn = int16(int(*_t4) << 8)
    }
    var _t5 = demo_p
    demo_p++
    cmd.buttons = *_t5
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__IncreaseDemoBuffer {
    var current_length : int
    var new_demobuffer : uint8?
    var new_demop : uint8?
    var new_length : int
    // Find the current size
    current_length = int(int64(demoend - demobuffer))
    // Generate a new buffer twice the size
    new_length = current_length * 2
    new_demobuffer = reinterpret<uint8?>(Z_Malloc(new_length, int(anon_28.PU_STATIC), null))
    new_demop = new_demobuffer + int64(demo_p - demobuffer)
    // Copy over the old data
    crt::memcpy(reinterpret<void?>(new_demobuffer), reinterpret<void?>(demobuffer), uint64(current_length))
    // Free the old buffer and point the demo pointers at the new buffer.
    Z_Free(reinterpret<void?>(demobuffer))
    demobuffer = new_demobuffer
    demo_p = new_demop
    demoend = demobuffer + new_length
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_WriteDemoTiccmd(var cmd : ticcmd_t?) {
    var demo_start : uint8?
    // press q to end demo recording
    if (doom_all__gamekeydown[key_demo_quit] != 0) {
        G_CheckDemoStatus()
    }
    demo_start = demo_p
    var _t0 = demo_p
    demo_p++
    *_t0 = uint8(cmd.forwardmove)
    var _t1 = demo_p
    demo_p++
    *_t1 = uint8(cmd.sidemove)
    // If this is a longtics demo, record in higher resolution
    if (longtics != 0) {
        var _t2 = demo_p
        demo_p++
        *_t2 = uint8(int(cmd.angleturn) & 255)
        var _t3 = demo_p
        demo_p++
        *_t3 = uint8((int(cmd.angleturn) >> 8) & 255)
    } else {
        var _t4 = demo_p
        demo_p++
        *_t4 = uint8(int(cmd.angleturn) >> 8)
    }
    var _t5 = demo_p
    demo_p++
    *_t5 = cmd.buttons
    // reset demo pointer back
    demo_p = demo_start
    if (reinterpret<uint64>(demo_p) > reinterpret<uint64>(demoend - 16)) {
        if (vanilla_demo_limit != 0) {
            // no more space
            G_CheckDemoStatus()
            return
        } else {
            // Vanilla demo limit disabled: unlimited
            // demo lengths!
            doom_all__IncreaseDemoBuffer()
        }
    }
    // make SURE it is exactly the same
    G_ReadDemoTiccmd(cmd)
}

// G_RecordDemo
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_RecordDemo(var name : uint8?) {
    var demoname_size : uint64
    var i : int
    var maxsize : int
    usergame = 0u
    demoname_size = crt::strlen(name) + 5ul
    demoname = reinterpret<uint8?>(Z_Malloc(int(demoname_size), int(anon_28.PU_STATIC), null))
    M_snprintf`va(demoname, demoname_size, cstr("%s.lmp"), (name,))
    maxsize = 131072
    // !
    // @arg <size>
    // @category demo
    // @vanilla
    // Specify the demo buffer size (KiB)
    i = M_CheckParmWithArgs(cstr("-maxdemo"), 1)
    if (i != 0) {
        maxsize = crt::atoi(myargv[i + 1]) * 1024
    }
    demobuffer = reinterpret<uint8?>(Z_Malloc(maxsize, int(anon_28.PU_STATIC), null))
    demoend = demobuffer + maxsize
    demorecording = 1u
}

// Get the demo version code appropriate for the version set in gameversion.
[unsafe_deref, hint(unsafe_range_check)]
def G_VanillaVersionCode : int {
    c_switch(gameversion) {
        case(GameVersion_t.exe_doom_1_2) {
            I_Error`va(cstr("Doom 1.2 does not have a version code!"), VaNone())
        }
        case(GameVersion_t.exe_doom_1_666) {
            return 106
        }
        case(GameVersion_t.exe_doom_1_7) {
            return 107
        }
        case(GameVersion_t.exe_doom_1_8) {
            return 108
        }
        case(GameVersion_t.exe_doom_1_9, _) {
            // All other versions are variants on v1.9:
            return 109
        }
    }
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_BeginRecording {
    // !
    // @category demo
    // Record a high resolution "Doom 1.91" demo.
    longtics = uint(int_of(M_CheckParm(cstr("-longtics")) != 0))
    // If not recording a longtics demo, record in low res
    lowres_turn = uint(int_of(longtics == 0))
    demo_p = demobuffer
    // Save the right version code for this demo
    if (longtics != 0) {
        var _t0 = demo_p
        demo_p++
        *_t0 = uint8(DOOM_191_VERSION)
    } else {
        var _t1 = demo_p
        demo_p++
        *_t1 = uint8(G_VanillaVersionCode())
    }
    var _t2 = demo_p
    demo_p++
    *_t2 = uint8(gameskill)
    var _t3 = demo_p
    demo_p++
    *_t3 = uint8(gameepisode)
    var _t4 = demo_p
    demo_p++
    *_t4 = uint8(gamemap)
    var _t5 = demo_p
    demo_p++
    *_t5 = uint8(deathmatch)
    var _t6 = demo_p
    demo_p++
    *_t6 = uint8(respawnparm)
    var _t7 = demo_p
    demo_p++
    *_t7 = uint8(fastparm)
    var _t8 = demo_p
    demo_p++
    *_t8 = uint8(nomonsters)
    var _t9 = demo_p
    demo_p++
    *_t9 = uint8(consoleplayer)
    for (i in range(MAXPLAYERS)) {
        var _t10 = demo_p
        demo_p++
        *_t10 = uint8(playeringame[i])
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def G_DeferedPlayDemo(var name : uint8?) {
    defdemoname = name
    gameaction = gameaction_t.ga_playdemo
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__DemoVersionDescription(version : int) : uint8? {
    c_switch(version) {
        case(104) {
            return cstr("v1.4")
        }
        case(105) {
            return cstr("v1.5")
        }
        case(106) {
            return cstr("v1.6/v1.666")
        }
        case(107) {
            return cstr("v1.7/v1.7a")
        }
        case(108) {
            return cstr("v1.8")
        }
        case(109) {
            return cstr("v1.9")
        }
        case(_) {
            break
        }
    }
    // Unknown version. Perhaps this is a pre-v1.4 IWAD? If the version
    // byte is in the range 0-4 then it can be a v1.0-v1.2 demo.
    if (version >= 0 && version <= 4) {
        return cstr("v1.0/v1.1/v1.2")
    } else {
        M_snprintf`va(addr(DemoVersionDescription_resultbuf[0]), uint64(typeinfo sizeof(type<uint8[16]>)), cstr("%i.%i (unknown)"),
                (version / 100, version % 100))
        return addr(DemoVersionDescription_resultbuf[0])
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_DoPlayDemo {
    var skill : skill_t
    var episode : int
    var map : int
    var demoversion : int
    gameaction = gameaction_t.ga_nothing
    demo_p = reinterpret<uint8?>(W_CacheLumpName(defdemoname, int(anon_28.PU_STATIC)))
    demobuffer = demo_p
    var _t0 = demo_p
    demo_p++
    demoversion = int(*_t0)
    if (demoversion == G_VanillaVersionCode()) {
        longtics = 0u
    } elif (demoversion == DOOM_191_VERSION) {
        // demo recorded with cph's modified "v1.91" doom exe
        longtics = 1u
    } else {
        var message : uint8? = cstr("Demo is from a different game version!\n(read %i, should be %i)\n\n*** You may need to upgrade your version of Doom to v1.9. ***\n    See: https://www.doomworld.com/classicdoom/info/patches.php\n    This appears to be %s.")
        // I_Error(message, demoversion, G_VanillaVersionCode(),
        fprintf(crt::c_stderr(), message, demoversion, G_VanillaVersionCode(), doom_all__DemoVersionDescription(demoversion))
    }
    var _t1 = demo_p
    demo_p++
    skill = enum_from_int(type<skill_t>, int(*_t1))
    var _t2 = demo_p
    demo_p++
    episode = int(*_t2)
    var _t3 = demo_p
    demo_p++
    map = int(*_t3)
    var _t4 = demo_p
    demo_p++
    deathmatch = int(*_t4)
    var _t5 = demo_p
    demo_p++
    respawnparm = uint(*_t5)
    var _t6 = demo_p
    demo_p++
    fastparm = uint(*_t6)
    var _t7 = demo_p
    demo_p++
    nomonsters = uint(*_t7)
    var _t8 = demo_p
    demo_p++
    consoleplayer = int(*_t8)
    for (i in range(MAXPLAYERS)) {
        var _t9 = demo_p
        demo_p++
        playeringame[i] = uint(*_t9)
    }
    if (playeringame[1] != 0 || M_CheckParm(cstr("-solo-net")) > 0 || M_CheckParm(cstr("-netdemo")) > 0) {
        netgame = 1u
        netdemo = 1u
    }
    // don't spend a lot of time in loadlevel
    precache = 0u
    G_InitNew(skill, episode, map)
    precache = 1u
    starttime = I_GetTime()
    usergame = 0u
    demoplayback = 1u
}

// G_TimeDemo
[unsafe_deref, hint(unsafe_range_check)]
def G_TimeDemo(var name : uint8?) {
    // !
    // @vanilla
    // Disable rendering the screen entirely.
    nodrawers = uint(M_CheckParm(cstr("-nodraw")))
    timingdemo = 1u
    singletics = 1u
    defdemoname = name
    gameaction = gameaction_t.ga_playdemo
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_CheckDemoStatus : uint {
    var endtime : int
    if (timingdemo != 0) {
        var fps : float
        var realtics : int
        endtime = I_GetTime()
        realtics = endtime - starttime
        fps = (float(gametic) * float(TICRATE)) / float(realtics)
        // Prevent recursive calls
        timingdemo = 0u
        demoplayback = 0u
        I_Error`va(cstr("timed %i gametics in %i realtics (%f fps)"), (gametic, realtics, double(fps)))
    }
    if (demoplayback != 0) {
        W_ReleaseLumpName(defdemoname)
        demoplayback = 0u
        netdemo = 0u
        netgame = 0u
        deathmatch = 0
        playeringame[3] = 0u
        playeringame[2] = playeringame[3]
        playeringame[1] = playeringame[2]
        respawnparm = 0u
        fastparm = 0u
        nomonsters = 0u
        consoleplayer = 0
        if (singledemo != 0) {
            I_Quit()
        } else {
            D_AdvanceDemo()
        }
        return 1u
    }
    if (demorecording != 0) {
        var _t0 = demo_p
        demo_p++
        *_t0 = uint8(DEMOMARKER)
        M_WriteFile(demoname, reinterpret<void?>(demobuffer), int(int64(demo_p - demobuffer)))
        Z_Free(reinterpret<void?>(demobuffer))
        demorecording = 0u
        I_Error`va(cstr("Demo %s recorded"), (demoname,))
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_init {
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_clearTextLine(var t : hu_textline_t?) {
    t.len = 0
    t.l[0] = 0u8
    t.needsupdate = 1
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_initTextLine(var t : hu_textline_t?; x : int; y : int; var f : patch_t ??; sc : int) {
    t.x = x
    t.y = y
    t.f = f
    t.sc = sc
    HUlib_clearTextLine(t)
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_addCharToTextLine(var t : hu_textline_t?; ch : uint8) : uint {
    if (t.len == HU_MAXLINELENGTH) {
        return 0u
    } else {
        let _t0 = t.len
        t.len++
        t.l[_t0] = ch
        t.l[t.len] = 0u8
        t.needsupdate = 4
        return 1u
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_delCharFromTextLine(var t : hu_textline_t?) : uint {
    if (t.len == 0) {
        return 0u
    } else {
        t.len--
        t.l[t.len] = 0u8
        t.needsupdate = 4
        return 1u
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_drawTextLine(var l : hu_textline_t?; drawcursor : uint) {
    var i : int
    var w : int
    var x : int
    var c : uint8
    // draw the new stuff
    x = l.x
    i = 0
    while (i < l.len) {
        c = uint8(crt::toupper(int(l.l[i])))
        if (c != ' ' && int(c) >= l.sc && int(c) <= '_') {
            w = int(l.f[int(c) - l.sc].width)
            if (x + w > SCREENWIDTH) {
                break
            }
            V_DrawPatchDirect(x, l.y, l.f[int(c) - l.sc])
            x += w
        } else {
            x += 4
            if (x >= SCREENWIDTH) {
                break
            }
        }
        i++
    }
    // draw the cursor if requested
    if (drawcursor != 0 && x + int(l.f['_' - l.sc].width) <= SCREENWIDTH) {
        V_DrawPatchDirect(x, l.y, l.f['_' - l.sc])
    }
}

// sorta called by HU_Erase and just better darn get things straight
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseTextLine(var l : hu_textline_t?) {
    var lh : int
    var y : int
    var yoffset : int
    // Only erases when NOT in automap and the screen is reduced,
    // and the text must either need updating or refreshing
    // (because of a recent change back from the automap)
    if (automapactive == 0 && viewwindowx != 0 && l.needsupdate != 0) {
        lh = int(l.f[0].height) + 1
        y = l.y
        yoffset = y * SCREENWIDTH
        while (y < l.y + lh) {
            if (y < viewwindowy || y >= viewwindowy + viewheight) {
                // erase entire line
                R_VideoErase(uint(yoffset), SCREENWIDTH)
            } else {
                // erase left border
                R_VideoErase(uint(yoffset), viewwindowx)
                R_VideoErase(uint(yoffset + viewwindowx + viewwidth), viewwindowx)
            }
            y++
            yoffset += SCREENWIDTH
        }
    }
    // erase right border
    if (l.needsupdate != 0) {
        l.needsupdate--
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_initSText(var s : hu_stext_t?; x : int; y : int; h : int; var font : patch_t ??; startchar : int; var on : uint?) {
    s.h = h
    s.on = on
    s.laston = 1u
    s.cl = 0
    for (i in range(h)) {
        HUlib_initTextLine(addr(s.l[0]) + end_index(i, 4), x, y - i * (int(font[0].height) + 1), font, startchar)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_addLineToSText(var s : hu_stext_t?) {
    var i : int
    // add a clear line
    s.cl++
    if (s.cl == s.h) {
        s.cl = 0
    }
    HUlib_clearTextLine(addr(s.l[0]) + end_index(s.cl, 4))
    // everything needs updating
    i = 0
    while (i < s.h) {
        s.l[i].needsupdate = 4
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_addMessageToSText(var s : hu_stext_t?; var prefix : uint8?; var msg : uint8?) {
    HUlib_addLineToSText(s)
    if (prefix != null) {
        while (*prefix != 0) {
            var _t0 = prefix
            prefix++
            HUlib_addCharToTextLine(addr(s.l[0]) + end_index(s.cl, 4), *_t0)
        }
    }
    while (*msg != 0) {
        var _t1 = msg
        msg++
        HUlib_addCharToTextLine(addr(s.l[0]) + end_index(s.cl, 4), *_t1)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_drawSText(var s : hu_stext_t?) {
    var i : int
    var idx : int
    var l : hu_textline_t?
    if (*s.on == 0) {
        // if not on, don't draw
        return
    }
    // draw everything
    i = 0
    while (i < s.h) {
        idx = s.cl - i
        if (idx < 0) {
            // handle queue of lines
            idx += s.h
        }
        l = addr(s.l[0]) + end_index(idx, 4)
        // need a decision made here on whether to skip the draw
        // no cursor, please
        HUlib_drawTextLine(l, 0u)
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseSText(var s : hu_stext_t?) {
    var i : int
    i = 0
    while (i < s.h) {
        if (s.laston != 0 && *s.on == 0) {
            s.l[i].needsupdate = 4
        }
        HUlib_eraseTextLine(addr(s.l[0]) + end_index(i, 4))
        i++
    }
    s.laston = *s.on
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_initIText(var it : hu_itext_t?; x : int; y : int; var font : patch_t ??; startchar : int; var on : uint?) {
    // default left margin is start of text
    it.lm = 0
    it.on = on
    it.laston = 1u
    HUlib_initTextLine(addr(it.l), x, y, font, startchar)
}

// The following deletion routines adhere to the left margin restriction
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_delCharFromIText(var it : hu_itext_t?) {
    if (it.l.len != it.lm) {
        HUlib_delCharFromTextLine(addr(it.l))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseLineFromIText(var it : hu_itext_t?) {
    while (it.lm != it.l.len) {
        HUlib_delCharFromTextLine(addr(it.l))
    }
}

// Resets left margin as well
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_resetIText(var it : hu_itext_t?) {
    it.lm = 0
    HUlib_clearTextLine(addr(it.l))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_addPrefixToIText(var it : hu_itext_t?; var str : uint8?) {
    while (*str != 0) {
        var _t0 = str
        str++
        HUlib_addCharToTextLine(addr(it.l), *_t0)
    }
    it.lm = it.l.len
}

// wrapper function for handling general keyed input.
// returns true if it ate the key
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_keyInIText(var it : hu_itext_t?; var ch : uint8) : uint {
    ch = uint8(crt::toupper(int(ch)))
    if (int(ch) >= ' ' && int(ch) <= '_') {
        HUlib_addCharToTextLine(addr(it.l), ch)
    } elif (int(ch) == KEY_BACKSPACE) {
        HUlib_delCharFromIText(it)
    } elif (int(ch) != KEY_ENTER) {
        // did not eat key
        return 0u
    }
    // ate the key
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_drawIText(var it : hu_itext_t?) {
    var l : hu_textline_t? = addr(it.l)
    if (*it.on == 0) {
        return
    }
    // draw the line w/ cursor
    HUlib_drawTextLine(l, 1u)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseIText(var it : hu_itext_t?) {
    if (it.laston != 0 && *it.on == 0) {
        it.l.needsupdate = 4
    }
    HUlib_eraseTextLine(addr(it.l))
    it.laston = *it.on
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HU_Init {
    var j : int
    var buffer : uint8[9]
    // load the heads-up font
    j = HU_FONTSTART
    for (i in range(HU_FONTSIZE)) {
        let _t0 = j
        j++
        snprintf(addr(buffer[0]), 9ul, cstr("STCFN%.3d"), _t0)
        hu_font[i] = reinterpret<patch_t?>(W_CacheLumpName(addr(buffer[0]), int(anon_28.PU_STATIC)))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def HU_Stop {
    doom_all__headsupactive = 0u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HU_Start {
    var s : uint8?
    if (doom_all__headsupactive != 0) {
        HU_Stop()
    }
    doom_all__plr = addr(players[0]) + end_index(consoleplayer, 4)
    doom_all__message_on = 0u
    message_dontfuckwithme = 0u
    doom_all__message_nottobefuckedwith = 0u
    chat_on = 0u
    // create the message widget
    HUlib_initSText(addr(doom_all__w_message), HU_MSGX, HU_MSGY, HU_MSGHEIGHT, addr(hu_font[0]), HU_FONTSTART, addr(doom_all__message_on))
    // create the map title widget
    HUlib_initTextLine(addr(doom_all__w_title), HU_TITLEX, 167 - int(hu_font[0].height), addr(hu_font[0]), HU_FONTSTART)
    c_switch(gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
            (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) {
        case(0u) {
            s = mapnames[(gameepisode - 1) * 9 + gamemap - 1]
            break
        }
        case(1u) {
            s = mapnames_commercial[gamemap - 1]
            break
        }
        case(3u) {
            s = mapnames_commercial[gamemap - 1 + 32]
            break
        }
        case(2u) {
            s = mapnames_commercial[gamemap - 1 + 64]
            break
        }
        case(_) {
            s = cstr("Unknown level")
            break
        }
    }
    // Chex.exe always uses the episode 1 level title
    // eg. E2M1 gives the title for E1M1
    if (gameversion == GameVersion_t.exe_chex) {
        s = mapnames[gamemap - 1]
    }
    // dehacked substitution to get modified level name
    s = s
    while (*s != 0) {
        var _t0 = s
        s++
        HUlib_addCharToTextLine(addr(doom_all__w_title), *_t0)
    }
    // create the chat widget
    HUlib_initIText(addr(doom_all__w_chat), HU_INPUTX, HU_MSGY + HU_MSGHEIGHT * (int(hu_font[0].height) + 1), addr(hu_font[0]), HU_FONTSTART, addr(chat_on))
    // create the inputbuffer widgets
    for (i in range(MAXPLAYERS)) {
        HUlib_initIText(addr(doom_all__w_inputbuffer[0]) + end_index(i, 4), 0, 0, null, 0, addr(doom_all__always_off))
    }
    doom_all__headsupactive = 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HU_Drawer {
    HUlib_drawSText(addr(doom_all__w_message))
    HUlib_drawIText(addr(doom_all__w_chat))
    if (automapactive != 0) {
        HUlib_drawTextLine(addr(doom_all__w_title), 0u)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HU_Erase {
    HUlib_eraseSText(addr(doom_all__w_message))
    HUlib_eraseIText(addr(doom_all__w_chat))
    HUlib_eraseTextLine(addr(doom_all__w_title))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HU_Ticker {
    var rc : int
    var c : uint8
    // tick down message counter if message is up
    var _t0 = doom_all__message_counter != 0
    if (_t0) {
        doom_all__message_counter--
        _t0 = doom_all__message_counter == 0
    }
    if (_t0) {
        doom_all__message_on = 0u
        doom_all__message_nottobefuckedwith = 0u
    }
    if (showMessages != 0 || message_dontfuckwithme != 0) {
        // display message if necessary
        if ((doom_all__plr.message != null && doom_all__message_nottobefuckedwith == 0) || (doom_all__plr.message != null && message_dontfuckwithme != 0)) {
            HUlib_addMessageToSText(addr(doom_all__w_message), null, doom_all__plr.message)
            doom_all__plr.message = null
            doom_all__message_on = 1u
            doom_all__message_counter = HU_MSGTIMEOUT
            doom_all__message_nottobefuckedwith = message_dontfuckwithme
            message_dontfuckwithme = 0u
        }
    }
    // else message_on = false;
    // check for incoming chat characters
    if (netgame != 0) {
        for (i in range(MAXPLAYERS)) {
            if (playeringame[i] == 0) {
                continue
            }
            var _t1 = i != consoleplayer
            if (_t1) {
                c = players[i].cmd.chatchar
                _t1 = c != 0
            }
            if (_t1) {
                if (int(c) <= HU_BROADCAST) {
                    doom_all__chat_dest[i] = c
                } else {
                    rc = int(HUlib_keyInIText(addr(doom_all__w_inputbuffer[0]) + end_index(i, 4), c))
                    if (rc != 0 && int(c) == KEY_ENTER) {
                        if (doom_all__w_inputbuffer[i].l.len != 0 &&
                                (int(doom_all__chat_dest[i]) == consoleplayer + 1 || int(doom_all__chat_dest[i]) == HU_BROADCAST)) {
                            HUlib_addMessageToSText(addr(doom_all__w_message), player_names[i], addr(doom_all__w_inputbuffer[i].l.l[0]))
                            doom_all__message_nottobefuckedwith = 1u
                            doom_all__message_on = 1u
                            doom_all__message_counter = HU_MSGTIMEOUT
                            if (gamemode == GameMode_t.commercial) {
                                S_StartSound(null, int(sfxenum_t.sfx_radio))
                            } else {
                                S_StartSound(null, int(sfxenum_t.sfx_tink))
                            }
                        }
                        HUlib_resetIText(addr(doom_all__w_inputbuffer[0]) + end_index(i, 4))
                    }
                }
                players[i].cmd.chatchar = 0u8
            }
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def HU_queueChatChar(c : uint8) {
    if (((doom_all__head + 1) & (QUEUESIZE - 1)) == doom_all__tail) {
        doom_all__plr.message = cstr("[Message unsent]")
    } else {
        doom_all__chatchars[doom_all__head] = c
        doom_all__head = (doom_all__head + 1) & (QUEUESIZE - 1)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def HU_dequeueChatChar : uint8 {
    var c : uint8
    if (doom_all__head != doom_all__tail) {
        c = doom_all__chatchars[doom_all__tail]
        doom_all__tail = (doom_all__tail + 1) & (QUEUESIZE - 1)
    } else {
        c = 0u8
    }
    return c
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HU_Responder(var ev : event_t?) : uint {
    var macromessage : uint8?
    var eatkey : uint = 0u
    var c : uint8
    var numplayers : int
    numplayers = 0
    for (i in range(MAXPLAYERS)) {
        numplayers = int(uint(numplayers) + playeringame[i])
    }
    if (ev.data1 == KEY_RSHIFT) {
        return 0u
    } elif (ev.data1 == KEY_RALT || ev.data1 == KEY_LALT) {
        HU_Responder_altdown = uint(int_of(ev._c_type == evtype_t.ev_keydown))
        return 0u
    }
    if (ev._c_type != evtype_t.ev_keydown) {
        return 0u
    }
    if (chat_on == 0) {
        if (ev.data1 == key_message_refresh) {
            doom_all__message_on = 1u
            doom_all__message_counter = HU_MSGTIMEOUT
            eatkey = 1u
        } elif (netgame != 0 && ev.data2 == key_multi_msg) {
            chat_on = 1u
            eatkey = chat_on
            HUlib_resetIText(addr(doom_all__w_chat))
            HU_queueChatChar(uint8(HU_BROADCAST))
        } elif (netgame != 0 && numplayers > 2) {
            for (i in range(MAXPLAYERS)) {
                if (ev.data2 == key_multi_msgplayer[i]) {
                    if (playeringame[i] != 0 && i != consoleplayer) {
                        chat_on = 1u
                        eatkey = chat_on
                        HUlib_resetIText(addr(doom_all__w_chat))
                        HU_queueChatChar(uint8(i + 1))
                        break
                    } elif (i == consoleplayer) {
                        HU_Responder_num_nobrainers++
                        if (HU_Responder_num_nobrainers < 3) {
                            doom_all__plr.message = cstr("You mumble to yourself")
                        } elif (HU_Responder_num_nobrainers < 6) {
                            doom_all__plr.message = cstr("Who's there?")
                        } elif (HU_Responder_num_nobrainers < 9) {
                            doom_all__plr.message = cstr("You scare yourself")
                        } elif (HU_Responder_num_nobrainers < 32) {
                            doom_all__plr.message = cstr("You start to rave")
                        } else {
                            doom_all__plr.message = cstr("You've lost it...")
                        }
                    }
                }
            }
        }
    } else {
        // send a macro
        if (HU_Responder_altdown != 0) {
            c = uint8(ev.data1 - '0')
            if (int(c) > 9) {
                return 0u
            }
            // fprintf(stderr, "got here\n");
            macromessage = chat_macros[int(c)]
            // kill last message with a '\n'
            // DEBUG!!!
            HU_queueChatChar(uint8(KEY_ENTER))
            // send the macro message
            while (*macromessage != 0) {
                var _t0 = macromessage
                macromessage++
                HU_queueChatChar(*_t0)
            }
            HU_queueChatChar(uint8(KEY_ENTER))
            // leave chat mode and notify that it was sent
            chat_on = 0u
            M_StringCopy(addr(HU_Responder_lastmessage[0]), chat_macros[int(c)], uint64(typeinfo sizeof(type<uint8[81]>)))
            doom_all__plr.message = addr(HU_Responder_lastmessage[0])
            eatkey = 1u
        } else {
            c = uint8(ev.data2)
            eatkey = HUlib_keyInIText(addr(doom_all__w_chat), c)
            if (eatkey != 0) {
                // static unsigned char buf[20]; // DEBUG
                HU_queueChatChar(c)
            }
            // M_snprintf(buf, sizeof(buf), "KEY: %d => %d", ev->data1, c);
            // plr->message = buf;
            if (int(c) == KEY_ENTER) {
                chat_on = 0u
                if (doom_all__w_chat.l.len != 0) {
                    M_StringCopy(addr(HU_Responder_lastmessage[0]), addr(doom_all__w_chat.l.l[0]), uint64(typeinfo sizeof(type<uint8[81]>)))
                    doom_all__plr.message = addr(HU_Responder_lastmessage[0])
                }
            } elif (int(c) == KEY_ESCAPE) {
                chat_on = 0u
            }
        }
    }
    return eatkey
}

