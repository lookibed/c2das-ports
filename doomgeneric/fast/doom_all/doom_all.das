        tm = x[69 & 15] ^ x[69 - 14 & 15] ^ x[69 - 8 & 15] ^ x[69 - 3 & 15]
        x[69 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        a = uint(int64(a) + (int64(rol(b, 5) + (c ^ d ^ e)) + K4 + int64(x[69 & 15])))
        c = (c << 30u) | (c >> uint(32 - 30))
    }
    {
        tm = x[70 & 15] ^ x[70 - 14 & 15] ^ x[70 - 8 & 15] ^ x[70 - 3 & 15]
        x[70 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        e = uint(int64(e) + (int64(rol(a, 5) + (b ^ c ^ d)) + K4 + int64(x[70 & 15])))
        b = (b << 30u) | (b >> uint(32 - 30))
    }
    {
        tm = x[71 & 15] ^ x[71 - 14 & 15] ^ x[71 - 8 & 15] ^ x[71 - 3 & 15]
        x[71 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        d = uint(int64(d) + (int64(rol(e, 5) + (a ^ b ^ c)) + K4 + int64(x[71 & 15])))
        a = (a << 30u) | (a >> uint(32 - 30))
    }
    {
        tm = x[72 & 15] ^ x[72 - 14 & 15] ^ x[72 - 8 & 15] ^ x[72 - 3 & 15]
        x[72 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        c = uint(int64(c) + (int64(rol(d, 5) + (e ^ a ^ b)) + K4 + int64(x[72 & 15])))
        e = (e << 30u) | (e >> uint(32 - 30))
    }
    {
        tm = x[73 & 15] ^ x[73 - 14 & 15] ^ x[73 - 8 & 15] ^ x[73 - 3 & 15]
        x[73 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        b = uint(int64(b) + (int64(rol(c, 5) + (d ^ e ^ a)) + K4 + int64(x[73 & 15])))
        d = (d << 30u) | (d >> uint(32 - 30))
    }
    {
        tm = x[74 & 15] ^ x[74 - 14 & 15] ^ x[74 - 8 & 15] ^ x[74 - 3 & 15]
        x[74 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        a = uint(int64(a) + (int64(rol(b, 5) + (c ^ d ^ e)) + K4 + int64(x[74 & 15])))
        c = (c << 30u) | (c >> uint(32 - 30))
    }
    {
        tm = x[75 & 15] ^ x[75 - 14 & 15] ^ x[75 - 8 & 15] ^ x[75 - 3 & 15]
        x[75 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        e = uint(int64(e) + (int64(rol(a, 5) + (b ^ c ^ d)) + K4 + int64(x[75 & 15])))
        b = (b << 30u) | (b >> uint(32 - 30))
    }
    {
        tm = x[76 & 15] ^ x[76 - 14 & 15] ^ x[76 - 8 & 15] ^ x[76 - 3 & 15]
        x[76 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        d = uint(int64(d) + (int64(rol(e, 5) + (a ^ b ^ c)) + K4 + int64(x[76 & 15])))
        a = (a << 30u) | (a >> uint(32 - 30))
    }
    {
        tm = x[77 & 15] ^ x[77 - 14 & 15] ^ x[77 - 8 & 15] ^ x[77 - 3 & 15]
        x[77 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        c = uint(int64(c) + (int64(rol(d, 5) + (e ^ a ^ b)) + K4 + int64(x[77 & 15])))
        e = (e << 30u) | (e >> uint(32 - 30))
    }
    {
        tm = x[78 & 15] ^ x[78 - 14 & 15] ^ x[78 - 8 & 15] ^ x[78 - 3 & 15]
        x[78 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        b = uint(int64(b) + (int64(rol(c, 5) + (d ^ e ^ a)) + K4 + int64(x[78 & 15])))
        d = (d << 30u) | (d >> uint(32 - 30))
    }
    {
        tm = x[79 & 15] ^ x[79 - 14 & 15] ^ x[79 - 8 & 15] ^ x[79 - 3 & 15]
        x[79 & 15] = (tm << 1u) | (tm >> uint(32 - 1))
        a = uint(int64(a) + (int64(rol(b, 5) + (c ^ d ^ e)) + K4 + int64(x[79 & 15])))
        c = (c << 30u) | (c >> uint(32 - 30))
    }
    // update chainig vars
    hd.h0 += a
    hd.h1 += b
    hd.h2 += c
    hd.h3 += d
    hd.h4 += e
}

// Update the message digest with the contents
// of INBUF with length INLEN.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_Update(var hd : sha1_context_s?; var inbuf : uint8?; var inlen : uint64) {
    if (hd.count == 64) {
        // flush the buffer
        doom_all__Transform(hd, addr(hd.buf[0]))
        hd.count = 0
        hd.nblocks++
    }
    if (inbuf == null) {
        return
    }
    if (hd.count != 0) {
        while (inlen != 0 && hd.count < 64) {
            let _t0 = hd.count
            hd.count++
            var _t1 = inbuf
            inbuf++
            hd.buf[_t0] = *_t1
            inlen--
        }
        SHA1_Update(hd, null, 0ul)
        if (inlen == 0) {
            return
        }
    }
    while (inlen >= 64ul) {
        doom_all__Transform(hd, inbuf)
        hd.count = 0
        hd.nblocks++
        inlen -= 64ul
        inbuf += 64
    }
    while (inlen != 0 && hd.count < 64) {
        let _t2 = hd.count
        hd.count++
        var _t3 = inbuf
        inbuf++
        hd.buf[_t2] = *_t3
        inlen--
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_Final(var digest : uint8?; var hd : sha1_context_s?) {
    var t : uint
    var msb : uint
    var lsb : uint
    var p : uint8?
    // flush
    SHA1_Update(hd, null, 0ul)
    t = hd.nblocks
    // multiply by 64 to make a byte count
    lsb = t << 6u
    msb = t >> 26u
    // add the count
    t = lsb
    lsb += uint(hd.count)
    if (lsb < t) {
        msb++
    }
    // multiply by 8 to make a bit count
    t = lsb
    lsb <<= 3u
    msb <<= 3u
    msb |= t >> 29u
    if (hd.count < 56) {
        // enough room
        // pad
        let _t0 = hd.count
        hd.count++
        hd.buf[_t0] = 128u8
        while (hd.count < 56) {
            // pad
            let _t1 = hd.count
            hd.count++
            hd.buf[_t1] = 0u8
        }
    } else {
        // need one extra block
        // pad character
        let _t2 = hd.count
        hd.count++
        hd.buf[_t2] = 128u8
        while (hd.count < 64) {
            let _t3 = hd.count
            hd.count++
            hd.buf[_t3] = 0u8
        }
        // flush
        SHA1_Update(hd, null, 0ul)
        // fill next block with zeroes
        crt::memset(reinterpret<void?>(addr(hd.buf[0])), 0, 56ul)
    }
    // append the 64 bit count
    hd.buf[56] = uint8(msb >> 24u)
    hd.buf[57] = uint8(msb >> 16u)
    hd.buf[58] = uint8(msb >> 8u)
    hd.buf[59] = uint8(msb)
    hd.buf[60] = uint8(lsb >> 24u)
    hd.buf[61] = uint8(lsb >> 16u)
    hd.buf[62] = uint8(lsb >> 8u)
    hd.buf[63] = uint8(lsb)
    doom_all__Transform(hd, addr(hd.buf[0]))
    p = addr(hd.buf[0])
    // little endian
    {
        var _t4 = p
        p++
        *_t4 = uint8(hd.h0 >> 24u)
        var _t5 = p
        p++
        *_t5 = uint8(hd.h0 >> 16u)
        var _t6 = p
        p++
        *_t6 = uint8(hd.h0 >> 8u)
        var _t7 = p
        p++
        *_t7 = uint8(hd.h0)
    }
    {
        var _t8 = p
        p++
        *_t8 = uint8(hd.h1 >> 24u)
        var _t9 = p
        p++
        *_t9 = uint8(hd.h1 >> 16u)
        var _t10 = p
        p++
        *_t10 = uint8(hd.h1 >> 8u)
        var _t11 = p
        p++
        *_t11 = uint8(hd.h1)
    }
    {
        var _t12 = p
        p++
        *_t12 = uint8(hd.h2 >> 24u)
        var _t13 = p
        p++
        *_t13 = uint8(hd.h2 >> 16u)
        var _t14 = p
        p++
        *_t14 = uint8(hd.h2 >> 8u)
        var _t15 = p
        p++
        *_t15 = uint8(hd.h2)
    }
    {
        var _t16 = p
        p++
        *_t16 = uint8(hd.h3 >> 24u)
        var _t17 = p
        p++
        *_t17 = uint8(hd.h3 >> 16u)
        var _t18 = p
        p++
        *_t18 = uint8(hd.h3 >> 8u)
        var _t19 = p
        p++
        *_t19 = uint8(hd.h3)
    }
    {
        var _t20 = p
        p++
        *_t20 = uint8(hd.h4 >> 24u)
        var _t21 = p
        p++
        *_t21 = uint8(hd.h4 >> 16u)
        var _t22 = p
        p++
        *_t22 = uint8(hd.h4 >> 8u)
        var _t23 = p
        p++
        *_t23 = uint8(hd.h4)
    }
    crt::memcpy(reinterpret<void?>(digest), reinterpret<void?>(addr(hd.buf[0])), uint64(typeinfo sizeof(type<uint8[20]>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_UpdateInt32(var context : sha1_context_s?; val : uint) {
    var buf : uint8[4]
    buf[0] = uint8((val >> 24u) & 255u)
    buf[1] = uint8((val >> 16u) & 255u)
    buf[2] = uint8((val >> 8u) & 255u)
    buf[3] = uint8(val & 255u)
    SHA1_Update(context, addr(buf[0]), 4ul)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SHA1_UpdateString(var context : sha1_context_s?; var str : uint8?) {
    SHA1_Update(context, reinterpret<uint8?>(str), crt::strlen(str) + 1ul)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def StatCopy(var stats : wbstartstruct_t?) {
    if (M_ParmExists(cstr("-statdump")) != 0 && doom_all__num_captured_stats < MAX_CAPTURES) {
        crt::memcpy(reinterpret<void?>(addr(doom_all__captured_stats[0]) + end_index(doom_all__num_captured_stats, 32)), reinterpret<void?>(stats),
                uint64(typeinfo sizeof(type<wbstartstruct_t>)))
        doom_all__num_captured_stats++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def StatDump {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def STlib_init {
    sttminus = reinterpret<patch_t?>(W_CacheLumpName(cstr("STTMINUS"), int(anon_28.PU_STATIC)))
}

// ?
[unsafe_deref, hint(unsafe_range_check)]
def STlib_initNum(var n : st_number_t?; x : int; y : int; var pl : patch_t ??; var num : int?; var on : uint?; width : int) {
    n.x = x
    n.y = y
    n.oldnum = 0
    n.width = width
    n.num = num
    n.on = on
    n.p = pl
}

// A fairly efficient way to draw a number
// based on differences from the old number.
// Note: worth the trouble?
[c_function, unsafe_deref, hint(unsafe_range_check)]
def STlib_drawNum(var n : st_number_t?; refresh : uint) {
    var numdigits : int = n.width
    var num : int = *n.num
    let w : int = int(n.p[0].width)
    let h : int = int(n.p[0].height)
    var x : int = n.x
    var neg : int
    n.oldnum = *n.num
    neg = int_of(num < 0)
    if (neg != 0) {
        if (numdigits == 2 && num < -9) {
            num = -9
        } elif (numdigits == 3 && num < -99) {
            num = -99
        }
        num = -num
    }
    // clear the area
    x = n.x - numdigits * w
    if (n.y - ST_Y < 0) {
        I_Error`va(cstr("drawNum: n->y - ST_Y < 0"), VaNone())
    }
    V_CopyRect(x, n.y - ST_Y, st_backing_screen, w * numdigits, h, x, n.y)
    // if non-number, do not draw it
    if (num == 1994) {
        return
    }
    x = n.x
    // in the special case of 0, you draw 0
    if (num == 0) {
        V_DrawPatch(x - w, n.y, n.p[0])
    }
    // draw the new number
    while (true) {
        var _t1 = num != 0
        if (_t1) {
            let _t0 = numdigits
            numdigits--
            _t1 = _t0 != 0
        }
        if (!(_t1)) {
            break
        }
        x -= w
        V_DrawPatch(x, n.y, n.p[num % 10])
        num /= 10
    }
    // draw a minus sign if necessary
    if (neg != 0) {
        V_DrawPatch(x - 8, n.y, sttminus)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def STlib_updateNum(var n : st_number_t?; refresh : uint) {
    if (*n.on != 0) {
        STlib_drawNum(n, refresh)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def STlib_initPercent(var p : st_percent_t?; x : int; y : int; var pl : patch_t ??; var num : int?; var on : uint?; var percent : patch_t?) {
    STlib_initNum(addr(p.n), x, y, pl, num, on, 3)
    p.p = percent
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def STlib_updatePercent(var per : st_percent_t?; refresh : int) {
    if (refresh != 0 && *per.n.on != 0) {
        V_DrawPatch(per.n.x, per.n.y, per.p)
    }
    STlib_updateNum(addr(per.n), uint(refresh))
}

[unsafe_deref, hint(unsafe_range_check)]
def STlib_initMultIcon(var i : st_multicon_t?; x : int; y : int; var il : patch_t ??; var inum : int?; var on : uint?) {
    i.x = x
    i.y = y
    i.oldinum = -1
    i.inum = inum
    i.on = on
    i.p = il
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def STlib_updateMultIcon(var mi : st_multicon_t?; refresh : uint) {
    var w : int
    var h : int
    var x : int
    var y : int
    if (*mi.on != 0 && (mi.oldinum != *mi.inum || refresh != 0) && (*mi.inum != -1)) {
        if (mi.oldinum != -1) {
            x = mi.x - int(mi.p[mi.oldinum].leftoffset)
            y = mi.y - int(mi.p[mi.oldinum].topoffset)
            w = int(mi.p[mi.oldinum].width)
            h = int(mi.p[mi.oldinum].height)
            if (y - ST_Y < 0) {
                I_Error`va(cstr("updateMultIcon: y - ST_Y < 0"), VaNone())
            }
            V_CopyRect(x, y - ST_Y, st_backing_screen, w, h, x, y)
        }
        V_DrawPatch(mi.x, mi.y, mi.p[*mi.inum])
        mi.oldinum = *mi.inum
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def STlib_initBinIcon(var b : st_binicon_t?; x : int; y : int; var i : patch_t?; var val : uint?; var on : uint?) {
    b.x = x
    b.y = y
    b.oldval = 0u
    b.val = val
    b.on = on
    b.p = i
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def STlib_updateBinIcon(var bi : st_binicon_t?; refresh : uint) {
    var x : int
    var y : int
    var w : int
    var h : int
    if (*bi.on != 0 && (bi.oldval != *bi.val || refresh != 0)) {
        x = bi.x - int(bi.p.leftoffset)
        y = bi.y - int(bi.p.topoffset)
        w = int(bi.p.width)
        h = int(bi.p.height)
        if (y - ST_Y < 0) {
            I_Error`va(cstr("updateBinIcon: y - ST_Y < 0"), VaNone())
        }
        if (*bi.val != 0) {
            V_DrawPatch(bi.x, bi.y, bi.p)
        } else {
            V_CopyRect(x, y - ST_Y, st_backing_screen, w, h, x, y)
        }
        bi.oldval = *bi.val
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_refreshBackground {
    if (doom_all__st_statusbaron != 0) {
        V_UseBuffer(st_backing_screen)
        V_DrawPatch(ST_X, 0, doom_all__sbar)
        if (netgame != 0) {
            V_DrawPatch(ST_FX, 0, doom_all__faceback)
        }
        V_RestoreBuffer()
        V_CopyRect(ST_X, 0, st_backing_screen, ST_WIDTH, ST_HEIGHT, ST_X, ST_Y)
    }
}

// Respond to keyboard input events,
// intercept cheats.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_Responder(var ev : event_t?) : uint {
    // Filter automap on/off.
    if (ev._c_type == evtype_t.ev_keyup && ((uint(ev.data1) & 4294901760u) == uint(AM_MSGHEADER))) {
        c_switch(ev.data1) {
            case(1634559232) {
                doom_all__st_gamestate = st_stateenum_t.AutomapState
                doom_all__st_firsttime = 1u
                break
            }
            case(1634564096) {
                // fprintf(stderr, "AM exited\n");
                doom_all__st_gamestate = st_stateenum_t.FirstPersonState
                break
            }
        }
    } elif (ev._c_type == evtype_t.ev_keydown) {
        // if a user keypress...
        if (netgame == 0 && gameskill != skill_t.sk_nightmare) {
            // 'dqd' cheat for toggleable god mode
            if (cht_CheckCheat(addr(cheat_god), uint8(ev.data2)) != 0) {
                doom_all__plyr.cheats ^= int(cheat_t.CF_GODMODE)
                if ((doom_all__plyr.cheats & int(cheat_t.CF_GODMODE)) != 0) {
                    if (doom_all__plyr.mo != null) {
                        doom_all__plyr.mo.health = 100
                    }
                    doom_all__plyr.health = deh_god_mode_health
                    doom_all__plyr.message = cstr("Degreelessness Mode On")
                } else {
                    doom_all__plyr.message = cstr("Degreelessness Mode Off")
                }
            } elif (cht_CheckCheat(addr(cheat_ammonokey), uint8(ev.data2)) != 0) {
                // 'fa' cheat for killer fucking arsenal
                doom_all__plyr.armorpoints = deh_idfa_armor
                doom_all__plyr.armortype = deh_idfa_armor_class
                for (i in range(int(weapontype_t.NUMWEAPONS))) {
                    doom_all__plyr.weaponowned[i] = 1u
                }
                for (i in range(int(ammotype_t.NUMAMMO))) {
                    doom_all__plyr.ammo[i] = doom_all__plyr.maxammo[i]
                }
                doom_all__plyr.message = cstr("Ammo (no keys) Added")
            } elif (cht_CheckCheat(addr(cheat_ammo), uint8(ev.data2)) != 0) {
                // 'kfa' cheat for key full ammo
                doom_all__plyr.armorpoints = deh_idkfa_armor
                doom_all__plyr.armortype = deh_idkfa_armor_class
                for (i in range(int(weapontype_t.NUMWEAPONS))) {
                    doom_all__plyr.weaponowned[i] = 1u
                }
                for (i in range(int(ammotype_t.NUMAMMO))) {
                    doom_all__plyr.ammo[i] = doom_all__plyr.maxammo[i]
                }
                for (i in range(int(card_t.NUMCARDS))) {
                    doom_all__plyr.cards[i] = 1u
                }
                doom_all__plyr.message = cstr("Very Happy Ammo Added")
            } elif (cht_CheckCheat(addr(cheat_mus), uint8(ev.data2)) != 0) {
                // 'mus' cheat for changing music
                var buf : uint8[3]
                var musnum : int
                doom_all__plyr.message = cstr("Music Change")
                cht_GetParam(addr(cheat_mus), addr(buf[0]))
                // Note: The original v1.9 had a bug that tried to play back
                // the Doom II music regardless of gamemode. This was fixed
                // in the Ultimate Doom executable so that it would work for
                // the Doom 1 music as well.
                if (gamemode == GameMode_t.commercial || uint(gameversion) < uint(GameVersion_t.exe_ultimate)) {
                    musnum = int(musicenum_t.mus_runnin) + (int(buf[0]) - '0') * 10 + int(buf[1]) - '0' - 1
                    if (((int(buf[0]) - '0') * 10 + int(buf[1]) - '0') > 35) {
                        doom_all__plyr.message = cstr("IMPOSSIBLE SELECTION")
                    } else {
                        S_ChangeMusic(musnum, 1)
                    }
                } else {
                    musnum = int(musicenum_t.mus_e1m1) + (int(buf[0]) - '1') * 9 + (int(buf[1]) - '1')
                    if (((int(buf[0]) - '1') * 9 + int(buf[1]) - '1') > 31) {
                        doom_all__plyr.message = cstr("IMPOSSIBLE SELECTION")
                    } else {
                        S_ChangeMusic(musnum, 1)
                    }
                }
            } elif (((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                                (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
                            uint(GameMission_t.doom) &&
                        cht_CheckCheat(addr(cheat_noclip), uint8(ev.data2)) != 0) ||
                    ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                                (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) !=
                            uint(GameMission_t.doom) &&
                        cht_CheckCheat(addr(cheat_commercial_noclip), uint8(ev.data2)) != 0)) {
                // Noclip cheat.
                // For Doom 1, use the idspipsopd cheat; for all others, use
                // idclip
                doom_all__plyr.cheats ^= int(cheat_t.CF_NOCLIP)
                if ((doom_all__plyr.cheats & int(cheat_t.CF_NOCLIP)) != 0) {
                    doom_all__plyr.message = cstr("No Clipping Mode ON")
                } else {
                    doom_all__plyr.message = cstr("No Clipping Mode OFF")
                }
            }
            // 'behold?' power-up cheats
            for (i in range(6)) {
                if (cht_CheckCheat(addr(cheat_powerup[0]) + end_index(i, 7), uint8(ev.data2)) != 0) {
                    if (doom_all__plyr.powers[i] == 0) {
                        P_GivePower(doom_all__plyr, i)
                    } elif (i != int(powertype_t.pw_strength)) {
                        doom_all__plyr.powers[i] = 1
                    } else {
                        doom_all__plyr.powers[i] = 0
                    }
                    doom_all__plyr.message = cstr("Power-up Toggled")
                }
            }
            // 'behold' power-up menu
            if (cht_CheckCheat(addr(cheat_powerup[6]), uint8(ev.data2)) != 0) {
                doom_all__plyr.message = cstr("inVuln, Str, Inviso, Rad, Allmap, or Lite-amp")
            } elif (cht_CheckCheat(addr(cheat_choppers), uint8(ev.data2)) != 0) {
                // 'choppers' invulnerability & chainsaw
                doom_all__plyr.weaponowned[int(weapontype_t.wp_chainsaw)] = 1u
                doom_all__plyr.powers[int(powertype_t.pw_invulnerability)] = 1
                doom_all__plyr.message = cstr("... doesn't suck - GM")
            } elif (cht_CheckCheat(addr(cheat_mypos), uint8(ev.data2)) != 0) {
                // 'mypos' for player position
                M_snprintf`va(addr(ST_Responder_buf[0]), uint64(typeinfo sizeof(type<uint8[52]>)), cstr("ang=0x%x;x,y=(0x%x,0x%x)"),
                        (players[consoleplayer].mo.angle, players[consoleplayer].mo.x, players[consoleplayer].mo.y))
                doom_all__plyr.message = addr(ST_Responder_buf[0])
            }
        }
        // 'clev' change-level cheat
        if (netgame == 0 && cht_CheckCheat(addr(cheat_clev), uint8(ev.data2)) != 0) {
            var buf : uint8[3]
            var epsd : int
            var map : int
            cht_GetParam(addr(cheat_clev), addr(buf[0]))
            if (gamemode == GameMode_t.commercial) {
                epsd = 1
                map = (int(buf[0]) - '0') * 10 + int(buf[1]) - '0'
            } else {
                epsd = int(buf[0]) - '0'
                map = int(buf[1]) - '0'
            }
            // Chex.exe always warps to episode 1.
            if (gameversion == GameVersion_t.exe_chex) {
                epsd = 1
            }
            // Catch invalid maps.
            if (epsd < 1) {
                return 0u
            }
            if (map < 1) {
                return 0u
            }
            // Ohmygod - this is not going to work.
            if ((gamemode == GameMode_t.retail) && ((epsd > 4) || (map > 9))) {
                return 0u
            }
            if ((gamemode == GameMode_t.registered) && ((epsd > 3) || (map > 9))) {
                return 0u
            }
            if ((gamemode == GameMode_t.shareware) && ((epsd > 1) || (map > 9))) {
                return 0u
            }
            // The source release has this check as map > 34. However, Vanilla
            // Doom allows IDCLEV up to MAP40 even though it normally crashes.
            if ((gamemode == GameMode_t.commercial) && ((epsd > 1) || (map > 40))) {
                return 0u
            }
            // So be it.
            doom_all__plyr.message = cstr("Changing Level...")
            G_DeferedInitNew(gameskill, epsd, map)
        }
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_calcPainOffset : int {
    var health : int
    health = doom_all__plyr.health > 100 ? 100 : doom_all__plyr.health
    if (health != ST_calcPainOffset_oldhealth) {
        ST_calcPainOffset_lastcalc = ST_FACESTRIDE * (((100 - health) * ST_NUMPAINFACES) / 101)
        ST_calcPainOffset_oldhealth = health
    }
    return ST_calcPainOffset_lastcalc
}

// This is a not-very-pretty routine which handles
// the face states and their timing.
// the precedence of expressions is:
// dead > evil grin > turned head > straight ahead
[unsafe_deref, hint(unsafe_range_check)]
def ST_updateFaceWidget {
    var i : int
    var badguyangle : uint
    var diffang : uint
    var doevilgrin : uint
    if (ST_updateFaceWidget_priority < 10) {
        // dead
        if (doom_all__plyr.health == 0) {
            ST_updateFaceWidget_priority = 9
            doom_all__st_faceindex = ST_DEADFACE
            doom_all__st_facecount = 1
        }
    }
    if (ST_updateFaceWidget_priority < 9) {
        if (doom_all__plyr.bonuscount != 0) {
            // picking up bonus
            doevilgrin = 0u
            for (i1 in range(int(weapontype_t.NUMWEAPONS))) {
                if (doom_all__oldweaponsowned[i1] != doom_all__plyr.weaponowned[i1]) {
                    doevilgrin = 1u
                    doom_all__oldweaponsowned[i1] = doom_all__plyr.weaponowned[i1]
                }
            }
            if (doevilgrin != 0) {
                // evil grin if just picked up weapon
                ST_updateFaceWidget_priority = 8
                doom_all__st_facecount = ST_EVILGRINCOUNT
                doom_all__st_faceindex = ST_calcPainOffset() + ST_EVILGRINOFFSET
            }
        }
    }
    if (ST_updateFaceWidget_priority < 8) {
        if (doom_all__plyr.damagecount != 0 && doom_all__plyr.attacker != null && doom_all__plyr.attacker != doom_all__plyr.mo) {
            // being attacked
            ST_updateFaceWidget_priority = 7
            if (doom_all__plyr.health - doom_all__st_oldhealth > ST_MUCHPAIN) {
                doom_all__st_facecount = ST_TURNCOUNT
                doom_all__st_faceindex = ST_calcPainOffset() + ST_OUCHOFFSET
            } else {
                badguyangle = R_PointToAngle2(doom_all__plyr.mo.x, doom_all__plyr.mo.y, doom_all__plyr.attacker.x, doom_all__plyr.attacker.y)
                if (badguyangle > doom_all__plyr.mo.angle) {
                    // whether right or left
                    diffang = badguyangle - doom_all__plyr.mo.angle
                    i = int_of(diffang > ANG180)
                } else {
                    // whether left or right
                    diffang = doom_all__plyr.mo.angle - badguyangle
                    i = int_of(diffang <= ANG180)
                }
                // confusing, aint it?
                doom_all__st_facecount = ST_TURNCOUNT
                doom_all__st_faceindex = ST_calcPainOffset()
                if (diffang < uint(ANG45)) {
                    // head-on
                    doom_all__st_faceindex += ST_RAMPAGEOFFSET
                } elif (i != 0) {
                    // turn face right
                    doom_all__st_faceindex += ST_TURNOFFSET
                } else {
                    // turn face left
                    doom_all__st_faceindex += ST_TURNOFFSET + 1
                }
            }
        }
    }
    if (ST_updateFaceWidget_priority < 7) {
        // getting hurt because of your own damn stupidity
        if (doom_all__plyr.damagecount != 0) {
            if (doom_all__plyr.health - doom_all__st_oldhealth > ST_MUCHPAIN) {
                ST_updateFaceWidget_priority = 7
                doom_all__st_facecount = ST_TURNCOUNT
                doom_all__st_faceindex = ST_calcPainOffset() + ST_OUCHOFFSET
            } else {
                ST_updateFaceWidget_priority = 6
                doom_all__st_facecount = ST_TURNCOUNT
                doom_all__st_faceindex = ST_calcPainOffset() + ST_RAMPAGEOFFSET
            }
        }
    }
    if (ST_updateFaceWidget_priority < 6) {
        // rapid firing
        if (doom_all__plyr.attackdown != 0) {
            if (ST_updateFaceWidget_lastattackdown == -1) {
                ST_updateFaceWidget_lastattackdown = ST_RAMPAGEDELAY
            } else {
                ST_updateFaceWidget_lastattackdown--
                if (ST_updateFaceWidget_lastattackdown == 0) {
                    ST_updateFaceWidget_priority = 5
                    doom_all__st_faceindex = ST_calcPainOffset() + ST_RAMPAGEOFFSET
                    doom_all__st_facecount = 1
                    ST_updateFaceWidget_lastattackdown = 1
                }
            }
        } else {
            ST_updateFaceWidget_lastattackdown = -1
        }
    }
    if (ST_updateFaceWidget_priority < 5) {
        // invulnerability
        if ((doom_all__plyr.cheats & int(cheat_t.CF_GODMODE)) != 0 || doom_all__plyr.powers[int(powertype_t.pw_invulnerability)] != 0) {
            ST_updateFaceWidget_priority = 4
            doom_all__st_faceindex = ST_GODFACE
            doom_all__st_facecount = 1
        }
    }
    // look left or look right if the facecount has timed out
    if (doom_all__st_facecount == 0) {
        doom_all__st_faceindex = ST_calcPainOffset() + (doom_all__st_randomnumber % 3)
        doom_all__st_facecount = ST_STRAIGHTFACECOUNT
        ST_updateFaceWidget_priority = 0
    }
    doom_all__st_facecount--
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_updateWidgets {
    // means "n/a"
    // must redirect the pointer if the ready weapon has changed.
    // if (w_ready.data != plyr->readyweapon)
    // {
    if (weaponinfo[int(doom_all__plyr.readyweapon)].ammo == ammotype_t.am_noammo) {
        doom_all__w_ready.num = addr(ST_updateWidgets_largeammo)
    } else {
        doom_all__w_ready.num = addr(doom_all__plyr.ammo[0]) + end_index(int(weaponinfo[int(doom_all__plyr.readyweapon)].ammo), 4)
    }
    // {
    // static int tic=0;
    // static int dir=-1;
    // if (!(tic&15))
    // plyr->ammo[weaponinfo[plyr->readyweapon].ammo]+=dir;
    // if (plyr->ammo[weaponinfo[plyr->readyweapon].ammo] == -100)
    // dir = 1;
    // tic++;
    // }
    doom_all__w_ready.data = int(doom_all__plyr.readyweapon)
    // if (*w_ready.on)
    // STlib_updateNum(&w_ready, true);
    // refresh weapon change
    // }
    // update keycard multiple widgets
    for (i in range(3)) {
        doom_all__keyboxes[i] = doom_all__plyr.cards[i] != 0 ? i : -1
        if (doom_all__plyr.cards[i + 3] != 0) {
            doom_all__keyboxes[i] = i + 3
        }
    }
    // refresh everything if this is him coming back to life
    ST_updateFaceWidget()
    // used by the w_armsbg widget
    doom_all__st_notdeathmatch = uint(int_of(deathmatch == 0))
    // used by w_arms[] widgets
    doom_all__st_armson = uint(int_of(doom_all__st_statusbaron != 0 && deathmatch == 0))
    // used by w_frags widget
    doom_all__st_fragson = uint(int_of(deathmatch != 0 && doom_all__st_statusbaron != 0))
    doom_all__st_fragscount = 0
    for (i in range(MAXPLAYERS)) {
        if (i != consoleplayer) {
            doom_all__st_fragscount += doom_all__plyr.frags[i]
        } else {
            doom_all__st_fragscount -= doom_all__plyr.frags[i]
        }
    }
    // get rid of chat window if up because of message
    doom_all__st_msgcounter--
    if (doom_all__st_msgcounter == 0) {
        doom_all__st_chat = doom_all__st_oldchat
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_Ticker {
    doom_all__st_clock++
    doom_all__st_randomnumber = M_Random()
    ST_updateWidgets()
    doom_all__st_oldhealth = doom_all__plyr.health
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_doPaletteStuff {
    var palette : int
    var pal : uint8?
    var cnt : int
    var bzc : int
    cnt = doom_all__plyr.damagecount
    if (doom_all__plyr.powers[int(powertype_t.pw_strength)] != 0) {
        // slowly fade the berzerk out
        bzc = 12 - (doom_all__plyr.powers[int(powertype_t.pw_strength)] >> 6)
        if (bzc > cnt) {
            cnt = bzc
        }
    }
    if (cnt != 0) {
        palette = (cnt + 7) >> 3
        if (palette >= NUMREDPALS) {
            palette = NUMREDPALS - 1
        }
        palette += STARTREDPALS
    } elif (doom_all__plyr.bonuscount != 0) {
        palette = (doom_all__plyr.bonuscount + 7) >> 3
        if (palette >= NUMBONUSPALS) {
            palette = NUMBONUSPALS - 1
        }
        palette += STARTBONUSPALS
    } elif (doom_all__plyr.powers[int(powertype_t.pw_ironfeet)] > 4 * 32 || (doom_all__plyr.powers[int(powertype_t.pw_ironfeet)] & 8) != 0) {
        palette = RADIATIONPAL
    } else {
        palette = 0
    }
    // In Chex Quest, the player never sees red. Instead, the
    // radiation suit palette is used to tint the screen green,
    // as though the player is being covered in goo by an
    // attacking flemoid.
    if (gameversion == GameVersion_t.exe_chex && palette >= STARTREDPALS && palette < STARTREDPALS + NUMREDPALS) {
        palette = RADIATIONPAL
    }
    if (palette != doom_all__st_palette) {
        doom_all__st_palette = palette
        pal = reinterpret<uint8?>(W_CacheLumpNum(doom_all__lu_palette, int(anon_28.PU_CACHE))) + palette * 768
        I_SetPalette(pal)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_drawWidgets(refresh : uint) {
    // used by w_arms[] widgets
    doom_all__st_armson = uint(int_of(doom_all__st_statusbaron != 0 && deathmatch == 0))
    // used by w_frags widget
    doom_all__st_fragson = uint(int_of(deathmatch != 0 && doom_all__st_statusbaron != 0))
    STlib_updateNum(addr(doom_all__w_ready), refresh)
    for (i in range(4)) {
        STlib_updateNum(addr(doom_all__w_ammo[0]) + end_index(i, 4), refresh)
        STlib_updateNum(addr(doom_all__w_maxammo[0]) + end_index(i, 4), refresh)
    }
    STlib_updatePercent(addr(doom_all__w_health), int(refresh))
    STlib_updatePercent(addr(doom_all__w_armor), int(refresh))
    STlib_updateBinIcon(addr(doom_all__w_armsbg), refresh)
    for (i in range(6)) {
        STlib_updateMultIcon(addr(doom_all__w_arms[0]) + end_index(i, 6), refresh)
    }
    STlib_updateMultIcon(addr(doom_all__w_faces), refresh)
    for (i in range(3)) {
        STlib_updateMultIcon(addr(doom_all__w_keyboxes[0]) + end_index(i, 3), refresh)
    }
    STlib_updateNum(addr(doom_all__w_frags), refresh)
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_doRefresh {
    doom_all__st_firsttime = 0u
    // draw status bar background to off-screen buff
    ST_refreshBackground()
    // and refresh all widgets
    ST_drawWidgets(1u)
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_diffDraw {
    // update all widgets
    ST_drawWidgets(0u)
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_Drawer(fullscreen : uint; refresh : uint) {
    doom_all__st_statusbaron = uint(int_of((fullscreen == 0) || automapactive != 0))
    doom_all__st_firsttime = uint(int_of(doom_all__st_firsttime != 0 || refresh != 0))
    // Do red-/gold-shifts from damage/items
    ST_doPaletteStuff()
    // If just after ST_Start(), refresh all
    if (doom_all__st_firsttime != 0) {
        ST_doRefresh()
    } else {
        // Otherwise, update as little as possible
        ST_diffDraw()
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ST_loadUnloadGraphics(callback : function<(var a0 : uint8?; var a1 : patch_t ??) : void>) {
    var facenum : int
    var namebuf : uint8[9]
    // Load the numbers, tall and short
    for (i in range(10)) {
        snprintf(addr(namebuf[0]), 9ul, cstr("STTNUM%d"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__tallnum[0]) + end_index(i, 10))
        snprintf(addr(namebuf[0]), 9ul, cstr("STYSNUM%d"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__shortnum[0]) + end_index(i, 10))
    }
    // Load percent key.
    // Note: why not load STMINUS here, too?
    invoke(callback, cstr("STTPRCNT"), addr(doom_all__tallpercent))
    // key cards
    for (i in range(int(card_t.NUMCARDS))) {
        snprintf(addr(namebuf[0]), 9ul, cstr("STKEYS%d"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__keys[0]) + end_index(i, 6))
    }
    // arms background
    invoke(callback, cstr("STARMS"), addr(doom_all__armsbg))
    // arms ownership widgets
    for (i in range(6)) {
        snprintf(addr(namebuf[0]), 9ul, cstr("STGNUM%d"), i + 2)
        // gray #
        invoke(callback, addr(namebuf[0]), addr(doom_all__arms[i][0]))
        // yellow #
        doom_all__arms[i][1] = doom_all__shortnum[i + 2]
    }
    // face backgrounds for different color players
    snprintf(addr(namebuf[0]), 9ul, cstr("STFB%d"), consoleplayer)
    invoke(callback, addr(namebuf[0]), addr(doom_all__faceback))
    // status bar background bits
    invoke(callback, cstr("STBAR"), addr(doom_all__sbar))
    // face states
    facenum = 0
    for (i in range(ST_NUMPAINFACES)) {
        for (j in range(ST_NUMSTRAIGHTFACES)) {
            snprintf(addr(namebuf[0]), 9ul, cstr("STFST%d%d"), i, j)
            invoke(callback, addr(namebuf[0]), addr(doom_all__faces[0]) + end_index(facenum, 42))
            facenum++
        }
        // turn right
        snprintf(addr(namebuf[0]), 9ul, cstr("STFTR%d0"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__faces[0]) + end_index(facenum, 42))
        facenum++
        // turn left
        snprintf(addr(namebuf[0]), 9ul, cstr("STFTL%d0"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__faces[0]) + end_index(facenum, 42))
        facenum++
        // ouch!
        snprintf(addr(namebuf[0]), 9ul, cstr("STFOUCH%d"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__faces[0]) + end_index(facenum, 42))
        facenum++
        // evil grin ;)
        snprintf(addr(namebuf[0]), 9ul, cstr("STFEVL%d"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__faces[0]) + end_index(facenum, 42))
        facenum++
        // pissed off
        snprintf(addr(namebuf[0]), 9ul, cstr("STFKILL%d"), i)
        invoke(callback, addr(namebuf[0]), addr(doom_all__faces[0]) + end_index(facenum, 42))
        facenum++
    }
    invoke(callback, cstr("STFGOD0"), addr(doom_all__faces[0]) + end_index(facenum, 42))
    facenum++
    invoke(callback, cstr("STFDEAD0"), addr(doom_all__faces[0]) + end_index(facenum, 42))
    facenum++
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ST_loadCallback(var lumpname : uint8?; var variable : patch_t ??) {
    *variable = reinterpret<patch_t?>(W_CacheLumpName(lumpname, int(anon_28.PU_STATIC)))
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_loadGraphics {
    doom_all__ST_loadUnloadGraphics(@@doom_all__ST_loadCallback)
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_loadData {
    doom_all__lu_palette = W_GetNumForName(cstr("PLAYPAL"))
    ST_loadGraphics()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ST_unloadCallback(var lumpname : uint8?; var variable : patch_t ??) {
    W_ReleaseLumpName(lumpname)
    *variable = null
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_unloadGraphics {
    doom_all__ST_loadUnloadGraphics(@@doom_all__ST_unloadCallback)
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_unloadData {
    ST_unloadGraphics()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_initData {
    doom_all__st_firsttime = 1u
    doom_all__plyr = addr(players[0]) + end_index(consoleplayer, 4)
    doom_all__st_clock = 0u
    doom_all__st_chatstate = st_chatstateenum_t.StartChatState
    doom_all__st_gamestate = st_stateenum_t.FirstPersonState
    doom_all__st_statusbaron = 1u
    doom_all__st_chat = 0u
    doom_all__st_oldchat = doom_all__st_chat
    doom_all__st_cursoron = 0u
    doom_all__st_faceindex = 0
    doom_all__st_palette = -1
    doom_all__st_oldhealth = -1
    for (i in range(int(weapontype_t.NUMWEAPONS))) {
        doom_all__oldweaponsowned[i] = doom_all__plyr.weaponowned[i]
    }
    for (i in range(3)) {
        doom_all__keyboxes[i] = -1
    }
    STlib_init()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_createWidgets {
    // ready weapon ammo
    STlib_initNum(addr(doom_all__w_ready), ST_AMMOX, ST_AMMOY, addr(doom_all__tallnum[0]),
            addr(doom_all__plyr.ammo[0]) + end_index(int(weaponinfo[int(doom_all__plyr.readyweapon)].ammo), 4), addr(doom_all__st_statusbaron), ST_AMMOWIDTH)
    // the last weapon type
    doom_all__w_ready.data = int(doom_all__plyr.readyweapon)
    // health percentage
    STlib_initPercent(addr(doom_all__w_health), ST_HEALTHX, ST_HEALTHY, addr(doom_all__tallnum[0]), addr(doom_all__plyr.health), addr(doom_all__st_statusbaron),
            doom_all__tallpercent)
    // arms background
    STlib_initBinIcon(addr(doom_all__w_armsbg), ST_ARMSBGX, ST_ARMSBGY, doom_all__armsbg, addr(doom_all__st_notdeathmatch), addr(doom_all__st_statusbaron))
    // weapons owned
    for (i in range(6)) {
        STlib_initMultIcon(addr(doom_all__w_arms[0]) + end_index(i, 6), ST_ARMSX + (i % 3) * ST_ARMSXSPACE, ST_ARMSY + (i / 3) * ST_ARMSYSPACE,
                addr(doom_all__arms[i][0]), reinterpret<int?>(addr(doom_all__plyr.weaponowned[0]) + end_index(i + 1, 9)), addr(doom_all__st_armson))
    }
    // frags sum
    STlib_initNum(addr(doom_all__w_frags), ST_FRAGSX, ST_FRAGSY, addr(doom_all__tallnum[0]), addr(doom_all__st_fragscount), addr(doom_all__st_fragson),
            ST_FRAGSWIDTH)
    // faces
    STlib_initMultIcon(addr(doom_all__w_faces), ST_FACESX, ST_FACESY, addr(doom_all__faces[0]), addr(doom_all__st_faceindex), addr(doom_all__st_statusbaron))
    // armor percentage - should be colored later
    STlib_initPercent(addr(doom_all__w_armor), ST_ARMORX, ST_ARMORY, addr(doom_all__tallnum[0]), addr(doom_all__plyr.armorpoints),
            addr(doom_all__st_statusbaron), doom_all__tallpercent)
    // keyboxes 0-2
    STlib_initMultIcon(addr(doom_all__w_keyboxes[0]), ST_KEY0X, ST_KEY0Y, addr(doom_all__keys[0]), addr(doom_all__keyboxes[0]), addr(doom_all__st_statusbaron))
    STlib_initMultIcon(addr(doom_all__w_keyboxes[1]), ST_KEY1X, ST_KEY1Y, addr(doom_all__keys[0]), addr(doom_all__keyboxes[1]), addr(doom_all__st_statusbaron))
    STlib_initMultIcon(addr(doom_all__w_keyboxes[2]), ST_KEY2X, ST_KEY2Y, addr(doom_all__keys[0]), addr(doom_all__keyboxes[2]), addr(doom_all__st_statusbaron))
    // ammo count (all four kinds)
    STlib_initNum(addr(doom_all__w_ammo[0]), ST_AMMO0X, ST_AMMO0Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.ammo[0]), addr(doom_all__st_statusbaron),
            ST_AMMO0WIDTH)
    STlib_initNum(addr(doom_all__w_ammo[1]), ST_AMMO1X, ST_AMMO1Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.ammo[1]), addr(doom_all__st_statusbaron),
            ST_AMMO1WIDTH)
    STlib_initNum(addr(doom_all__w_ammo[2]), ST_AMMO2X, ST_AMMO2Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.ammo[2]), addr(doom_all__st_statusbaron),
            ST_AMMO2WIDTH)
    STlib_initNum(addr(doom_all__w_ammo[3]), ST_AMMO3X, ST_AMMO3Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.ammo[3]), addr(doom_all__st_statusbaron),
            ST_AMMO3WIDTH)
    // max ammo count (all four kinds)
    STlib_initNum(addr(doom_all__w_maxammo[0]), ST_MAXAMMO0X, ST_MAXAMMO0Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.maxammo[0]),
            addr(doom_all__st_statusbaron), ST_MAXAMMO0WIDTH)
    STlib_initNum(addr(doom_all__w_maxammo[1]), ST_MAXAMMO1X, ST_MAXAMMO1Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.maxammo[1]),
            addr(doom_all__st_statusbaron), ST_MAXAMMO1WIDTH)
    STlib_initNum(addr(doom_all__w_maxammo[2]), ST_MAXAMMO2X, ST_MAXAMMO2Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.maxammo[2]),
            addr(doom_all__st_statusbaron), ST_MAXAMMO2WIDTH)
    STlib_initNum(addr(doom_all__w_maxammo[3]), ST_MAXAMMO3X, ST_MAXAMMO3Y, addr(doom_all__shortnum[0]), addr(doom_all__plyr.maxammo[3]),
            addr(doom_all__st_statusbaron), ST_MAXAMMO3WIDTH)
}

[unsafe_deref, hint(unsafe_range_check)]
def ST_Start {
    if (doom_all__st_stopped == 0) {
        ST_Stop()
    }
    ST_initData()
    ST_createWidgets()
    doom_all__st_stopped = 0u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_Stop {
    if (doom_all__st_stopped != 0) {
        return
    }
    I_SetPalette(reinterpret<uint8?>(W_CacheLumpNum(doom_all__lu_palette, int(anon_28.PU_CACHE))))
    doom_all__st_stopped = 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ST_Init {
    ST_loadData()
    st_backing_screen = reinterpret<uint8?>(Z_Malloc(SCREENWIDTH * ST_HEIGHT, int(anon_28.PU_STATIC), null))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_Init(sfxVolume : int; musicVolume : int) {
    var i : int
    I_PrecacheSounds(addr(S_sfx[0]), int(sfxenum_t.NUMSFX))
    S_SetSfxVolume(sfxVolume)
    S_SetMusicVolume(musicVolume)
    // Allocating the internal channels for mixing
    // (the maximum numer of sounds rendered
    // simultaneously) within zone memory.
    doom_all__channels = reinterpret<channel_t?>(Z_Malloc(int(uint64(snd_channels) * uint64(typeinfo sizeof(type<channel_t>))), int(anon_28.PU_STATIC), null))
    // Free all channels for use
    i = 0
    while (i < snd_channels) {
        doom_all__channels[i].sfxinfo = null
        i++
    }
    // no sounds are playing, and they are not mus_paused
    doom_all__mus_paused = 0u
    // Note that sounds have not been cached (yet).
    for (i1 in range(1, int(sfxenum_t.NUMSFX))) {
        S_sfx[i1].usefulness = -1
        S_sfx[i1].lumpnum = S_sfx[i1].usefulness
    }
    I_AtExit(@@S_Shutdown, 1u)
}

[unsafe_deref, hint(unsafe_range_check)]
def S_Shutdown {
    I_ShutdownSound()
    I_ShutdownMusic()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__S_StopChannel(cnum : int) {
    var c : channel_t?
    c = addr(doom_all__channels[cnum])
    if (c.sfxinfo != null) {
        // stop the sound playing
        if (I_SoundIsPlaying(c.handle) != 0) {
            I_StopSound(c.handle)
        }
        // check to see if other channels are playing the sound
        for (i in range(snd_channels)) {
            if (cnum != i && c.sfxinfo == doom_all__channels[i].sfxinfo) {
                break
            }
        }
        // degrade usefulness of sound data
        c.sfxinfo.usefulness--
        c.sfxinfo = null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_Start {
    var cnum : int
    var mnum : int
    // kill all playing sounds at start of level
    // (trust me - a good idea)
    cnum = 0
    while (cnum < snd_channels) {
        if (doom_all__channels[cnum].sfxinfo != null) {
            doom_all__S_StopChannel(cnum)
        }
        cnum++
    }
    // start new music for the level
    doom_all__mus_paused = 0u
    if (gamemode == GameMode_t.commercial) {
        mnum = int(musicenum_t.mus_runnin) + gamemap - 1
    } else {
        var spmus : int[9] = fixed_array(int(musicenum_t.mus_e3m4), int(musicenum_t.mus_e3m2), int(musicenum_t.mus_e3m3), int(musicenum_t.mus_e1m5),
                int(musicenum_t.mus_e2m7), int(musicenum_t.mus_e2m4), int(musicenum_t.mus_e2m6), int(musicenum_t.mus_e2m5), int(musicenum_t.mus_e1m9))
        // Song - Who? - Where?
        // American e4m1
        // Romero e4m2
        // Shawn e4m3
        // American e4m4
        // Tim e4m5
        // Romero e4m6
        // J.Anderson e4m7 CHIRON.WAD
        // Shawn e4m8
        // Tim e4m9
        if (gameepisode < 4) {
            mnum = int(musicenum_t.mus_e1m1) + (gameepisode - 1) * 9 + gamemap - 1
        } else {
            mnum = spmus[gamemap - 1]
        }
    }
    S_ChangeMusic(mnum, 1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_StopSound(var origin : mobj_s?) {
    var cnum : int
    cnum = 0
    while (cnum < snd_channels) {
        if (doom_all__channels[cnum].sfxinfo != null && doom_all__channels[cnum].origin == origin) {
            doom_all__S_StopChannel(cnum)
            break
        }
        cnum++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__S_GetChannel(var origin : mobj_s?; var sfxinfo : sfxinfo_struct?) : int {
    // channel number to use
    var cnum : int
    var c : channel_t?
    // Find an open channel
    cnum = 0
    while (cnum < snd_channels) {
        if (doom_all__channels[cnum].sfxinfo == null) {
            break
        } elif (origin != null && doom_all__channels[cnum].origin == origin) {
            doom_all__S_StopChannel(cnum)
            break
        }
        cnum++
    }
    // None available
    if (cnum == snd_channels) {
        // Look for lower priority
        cnum = 0
        while (cnum < snd_channels) {
            if (doom_all__channels[cnum].sfxinfo.priority >= sfxinfo.priority) {
                break
            }
            cnum++
        }
        if (cnum == snd_channels) {
            // FUCK! No lower priority. Sorry, Charlie.
            return -1
        } else {
            // Otherwise, kick out lower priority.
            doom_all__S_StopChannel(cnum)
        }
    }
    c = addr(doom_all__channels[cnum])
    // channel is decided to be cnum.
    c.sfxinfo = sfxinfo
    c.origin = origin
    return cnum
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__S_AdjustSoundParams(var listener : mobj_s?; var source : mobj_s?; var vol : int?; var sep : int?) : int {
    var approx_dist : int
    var adx : int
    var ady : int
    var angle : uint
    // calculate the distance to sound origin
    // and clip it if necessary
    adx = crt::abs(listener.x - source.x)
    ady = crt::abs(listener.y - source.y)
    // From _GG1_ p.428. Appox. eucledian distance fast.
    approx_dist = adx + ady - ((adx < ady ? adx : ady) >> 1)
    if (gamemap != 8 && approx_dist > S_CLIPPING_DIST) {
        return 0
    }
    // angle of source to listener
    angle = R_PointToAngle2(listener.x, listener.y, source.x, source.y)
    if (angle > listener.angle) {
        angle -= listener.angle
    } else {
        angle += (4294967295u - listener.angle)
    }
    angle >>= uint(ANGLETOFINESHIFT)
    // stereo separation
    *sep = 128 - (FixedMul(S_STEREO_SWING, finesine[angle]) >> FRACBITS)
    // volume calculation
    if (approx_dist < S_CLOSE_DIST) {
        *vol = doom_all__snd_SfxVolume
    } elif (gamemap == 8) {
        if (approx_dist > S_CLIPPING_DIST) {
            approx_dist = S_CLIPPING_DIST
        }
        *vol = 15 + ((doom_all__snd_SfxVolume - 15) * ((S_CLIPPING_DIST - approx_dist) >> FRACBITS)) / S_ATTENUATOR
    } else {
        // distance effect
        *vol = (doom_all__snd_SfxVolume * ((S_CLIPPING_DIST - approx_dist) >> FRACBITS)) / S_ATTENUATOR
    }
    return int_of(*vol > 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_StartSound(var origin_p : void?; sfx_id : int) {
    var sfx : sfxinfo_struct?
    var origin : mobj_s?
    var rc : int
    var sep : int
    var cnum : int
    var volume : int
    origin = reinterpret<mobj_s?>(origin_p)
    volume = doom_all__snd_SfxVolume
    // check for bogus sound #
    if (sfx_id < 1 || sfx_id > int(sfxenum_t.NUMSFX)) {
        I_Error`va(cstr("Bad sfx #: %d"), (sfx_id,))
    }
    sfx = addr(S_sfx[0]) + end_index(sfx_id, 109)
    // Initialize sound parameters
    if (sfx.link != null) {
        volume += sfx.volume
        if (volume < 1) {
            return
        }
        if (volume > doom_all__snd_SfxVolume) {
            volume = doom_all__snd_SfxVolume
        }
    }
    // Check to see if it is audible,
    // and if not, modify the params
    if (origin != null && origin != players[consoleplayer].mo) {
        rc = doom_all__S_AdjustSoundParams(players[consoleplayer].mo, origin, addr(volume), addr(sep))
        if (origin.x == players[consoleplayer].mo.x && origin.y == players[consoleplayer].mo.y) {
            sep = NORM_SEP
        }
        if (rc == 0) {
            return
        }
    } else {
        sep = NORM_SEP
    }
    // kill old sound
    S_StopSound(origin)
    // try to find a channel
    cnum = doom_all__S_GetChannel(origin, sfx)
    if (cnum < 0) {
        return
    }
    // increase the usefulness
    let _t0 = sfx.usefulness
    sfx.usefulness++
    if (_t0 < 0) {
        sfx.usefulness = 1
    }
    if (sfx.lumpnum < 0) {
        sfx.lumpnum = I_GetSfxLumpNum(sfx)
    }
    doom_all__channels[cnum].handle = I_StartSound(sfx, cnum, volume, sep)
}

[unsafe_deref, hint(unsafe_range_check)]
def S_PauseSound {
    if (doom_all__mus_playing != null && doom_all__mus_paused == 0) {
        I_PauseSong()
        doom_all__mus_paused = 1u
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def S_ResumeSound {
    if (doom_all__mus_playing != null && doom_all__mus_paused != 0) {
        I_ResumeSong()
        doom_all__mus_paused = 0u
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_UpdateSounds(var listener : mobj_s?) {
    var audible : int
    var cnum : int
    var volume : int
    var sep : int
    var sfx : sfxinfo_struct?
    var c : channel_t?
    I_UpdateSound()
    cnum = 0
    while (cnum < snd_channels) {
        {
            c = addr(doom_all__channels[cnum])
            sfx = c.sfxinfo
            if (c.sfxinfo != null) {
                if (I_SoundIsPlaying(c.handle) != 0) {
                    // initialize parameters
                    volume = doom_all__snd_SfxVolume
                    sep = NORM_SEP
                    if (sfx.link != null) {
                        volume += sfx.volume
                        if (volume < 1) {
                            doom_all__S_StopChannel(cnum)
                            continue
                        } elif (volume > doom_all__snd_SfxVolume) {
                            volume = doom_all__snd_SfxVolume
                        }
                    }
                    // check non-local sounds for distance clipping
                    // or modify their params
                    if (c.origin != null && listener != c.origin) {
                        audible = doom_all__S_AdjustSoundParams(listener, c.origin, addr(volume), addr(sep))
                        if (audible == 0) {
                            doom_all__S_StopChannel(cnum)
                        } else {
                            I_UpdateSoundParams(c.handle, volume, sep)
                        }
                    }
                } else {
                    // if channel is allocated but sound has stopped,
                    // free it
                    doom_all__S_StopChannel(cnum)
                }
            }
        } finally {
            cnum++
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def S_SetMusicVolume(volume : int) {
    if (volume < 0 || volume > 127) {
        I_Error`va(cstr("Attempt to set music volume at %d"), (volume,))
    }
    I_SetMusicVolume(volume)
}

[unsafe_deref, hint(unsafe_range_check)]
def S_SetSfxVolume(volume : int) {
    if (volume < 0 || volume > 127) {
        I_Error`va(cstr("Attempt to set sfx volume at %d"), (volume,))
    }
    doom_all__snd_SfxVolume = volume
}

[unsafe_deref, hint(unsafe_range_check)]
def S_StartMusic(m_id : int) {
    S_ChangeMusic(m_id, 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_ChangeMusic(var musicnum : int; looping : int) {
    var music : musicinfo_t? = null
    var namebuf : uint8[9]
    var handle : void?
    // The Doom IWAD file has two versions of the intro music: d_intro
    // and d_introa. The latter is used for OPL playback.
    if (musicnum == int(musicenum_t.mus_intro) && (snd_musicdevice == int(snddevice_t.SNDDEVICE_ADLIB) || snd_musicdevice == int(snddevice_t.SNDDEVICE_SB))) {
        musicnum = int(musicenum_t.mus_introa)
    }
    if (musicnum <= int(musicenum_t.mus_None) || musicnum >= int(musicenum_t.NUMMUSIC)) {
        I_Error`va(cstr("Bad music number %d"), (musicnum,))
    } else {
        music = addr(S_music[0]) + end_index(musicnum, 68)
    }
    if (doom_all__mus_playing == music) {
        return
    }
    // shutdown old music
    S_StopMusic()
    // get lumpnum if neccessary
    if (music.lumpnum == 0) {
        M_snprintf`va(addr(namebuf[0]), uint64(typeinfo sizeof(type<uint8[9]>)), cstr("d_%s"), (music.name,))
        music.lumpnum = W_GetNumForName(addr(namebuf[0]))
    }
    music.data = W_CacheLumpNum(music.lumpnum, int(anon_28.PU_STATIC))
    handle = I_RegisterSong(music.data, W_LumpLength(uint(music.lumpnum)))
    music.handle = handle
    I_PlaySong(handle, uint(looping))
    doom_all__mus_playing = music
}

[unsafe_deref, hint(unsafe_range_check)]
def S_MusicPlaying : uint {
    return I_MusicIsPlaying()
}

[unsafe_deref, hint(unsafe_range_check)]
def S_StopMusic {
    if (doom_all__mus_playing != null) {
        if (doom_all__mus_paused != 0) {
            I_ResumeSong()
        }
        I_StopSong()
        I_UnRegisterSong(doom_all__mus_playing.handle)
        W_ReleaseLumpNum(doom_all__mus_playing.lumpnum)
        doom_all__mus_playing.data = null
        doom_all__mus_playing = null
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def SlopeDiv(num : uint; den : uint) : int {
    var ans : uint
    if (den < 512u) {
        return SLOPERANGE
    } else {
        ans = (num << 3u) / (den >> 8u)
        if (ans <= uint(SLOPERANGE)) {
            return int(ans)
        } else {
            return SLOPERANGE
        }
    }
}

// V_MarkRect
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_MarkRect(x : int; y : int; width : int; height : int) {
    // If we are temporarily using an alternate screen, do not
    // affect the update box.
    if (doom_all__dest_screen == I_VideoBuffer) {
        M_AddToBox(addr(dirtybox[0]), x, y)
        M_AddToBox(addr(dirtybox[0]), x + width - 1, y + height - 1)
    }
}

// V_CopyRect
[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_CopyRect(srcx : int; srcy : int; var source : uint8?; width : int; var height : int; destx : int; desty : int) {
    var src : uint8?
    var dest : uint8?
    if (srcx < 0 || srcx + width > SCREENWIDTH || srcy < 0 || srcy + height > SCREENHEIGHT || destx < 0 || destx + width > SCREENWIDTH || desty < 0 ||
            desty + height > SCREENHEIGHT) {
        I_Error`va(cstr("Bad V_CopyRect"), VaNone())
    }
    V_MarkRect(destx, desty, width, height)
    src = source + SCREENWIDTH * srcy + srcx
    dest = doom_all__dest_screen + SCREENWIDTH * desty + destx
    while (height > 0) {
        crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(src), uint64(width))
        src += SCREENWIDTH
        dest += SCREENWIDTH
        height--
    }
}

// V_SetPatchClipCallback
// haleyjd 08/28/10: Added for Strife support.
// By calling this function, you can setup runtime error checking for patch
// clipping. Strife never caused errors by drawing patches partway off-screen.
// Some versions of vanilla DOOM also behaved differently than the default
// implementation, so this could possibly be extended to those as well for
// accurate emulation.
[unsafe_deref, hint(unsafe_range_check)]
def V_SetPatchClipCallback(func : function<(var a0 : patch_t?; a1 : int; a2 : int) : uint>) {
    doom_all__patchclip_callback = func
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawPatch(var x : int; var y : int; var patch : patch_t?) {
    var count : int
    var col : int
    var column : post_t?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var w : int
    y -= int(patch.topoffset)
    x -= int(patch.leftoffset)
    // haleyjd 08/28/10: Strife needs silent error checking here.
    if (doom_all__patchclip_callback != null) {
        if (invoke(doom_all__patchclip_callback, patch, x, y) == 0) {
            return
        }
    }
    if (x < 0 || x + int(patch.width) > SCREENWIDTH || y < 0 || y + int(patch.height) > SCREENHEIGHT) {
        I_Error`va(cstr("Bad V_DrawPatch x=%i y=%i patch.width=%i patch.height=%i topoffset=%i leftoffset=%i"),
                (x, y, int(patch.width), int(patch.height), int(patch.topoffset), int(patch.leftoffset)))
    }
    V_MarkRect(x, y, int(patch.width), int(patch.height))
    col = 0
    desttop = doom_all__dest_screen + y * SCREENWIDTH + x
    w = int(patch.width)
    while (col < w) {
        column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[col])
        // step through the posts in a column
        while (column.topdelta != 255) {
            source = reinterpret<uint8?>(column) + 3
            dest = desttop + int(column.topdelta) * SCREENWIDTH
            count = int(column.length)
            while (true) {
                let _t0 = count
                count--
                if (_t0 == 0) {
                    break
                }
                var _t1 = source
                source++
                *dest = *_t1
                dest += SCREENWIDTH
            }
            column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
        }
        x++
        col++
        desttop++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawPatchFlipped(var x : int; var y : int; var patch : patch_t?) {
    var count : int
    var col : int
    var column : post_t?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var w : int
    y -= int(patch.topoffset)
    x -= int(patch.leftoffset)
    // haleyjd 08/28/10: Strife needs silent error checking here.
    if (doom_all__patchclip_callback != null) {
        if (invoke(doom_all__patchclip_callback, patch, x, y) == 0) {
            return
        }
    }
    if (x < 0 || x + int(patch.width) > SCREENWIDTH || y < 0 || y + int(patch.height) > SCREENHEIGHT) {
        I_Error`va(cstr("Bad V_DrawPatchFlipped"), VaNone())
    }
    V_MarkRect(x, y, int(patch.width), int(patch.height))
    col = 0
    desttop = doom_all__dest_screen + y * SCREENWIDTH + x
    w = int(patch.width)
    while (col < w) {
        column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[w - 1 - col])
        // step through the posts in a column
        while (column.topdelta != 255) {
            source = reinterpret<uint8?>(column) + 3
            dest = desttop + int(column.topdelta) * SCREENWIDTH
            count = int(column.length)
            while (true) {
                let _t0 = count
                count--
                if (_t0 == 0) {
                    break
                }
                var _t1 = source
                source++
                *dest = *_t1
                dest += SCREENWIDTH
            }
            column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
        }
        x++
        col++
        desttop++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def V_DrawPatchDirect(x : int; y : int; var patch : patch_t?) {
    V_DrawPatch(x, y, patch)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawTLPatch(var x : int; var y : int; var patch : patch_t?) {
    var count : int
    var col : int
    var column : post_t?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var w : int
    y -= int(patch.topoffset)
    x -= int(patch.leftoffset)
    if (x < 0 || x + int(patch.width) > SCREENWIDTH || y < 0 || y + int(patch.height) > SCREENHEIGHT) {
        I_Error`va(cstr("Bad V_DrawTLPatch"), VaNone())
    }
    col = 0
    desttop = doom_all__dest_screen + y * SCREENWIDTH + x
    w = int(patch.width)
    while (col < w) {
        column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[col])
        // step through the posts in a column
        while (column.topdelta != 255) {
            source = reinterpret<uint8?>(column) + 3
            dest = desttop + int(column.topdelta) * SCREENWIDTH
            count = int(column.length)
            while (true) {
                let _t0 = count
                count--
                if (_t0 == 0) {
                    break
                }
                var _t1 = source
                source++
                *dest = tinttable[(int(*dest) << 8) + int(*_t1)]
                dest += SCREENWIDTH
            }
            column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
        }
        x++
        col++
        desttop++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawXlaPatch(var x : int; var y : int; var patch : patch_t?) {
    var count : int
    var col : int
    var column : post_t?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var w : int
    y -= int(patch.topoffset)
    x -= int(patch.leftoffset)
    if (doom_all__patchclip_callback != null) {
        if (invoke(doom_all__patchclip_callback, patch, x, y) == 0) {
            return
        }
    }
    col = 0
    desttop = doom_all__dest_screen + y * SCREENWIDTH + x
    w = int(patch.width)
    while (col < w) {
        column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[col])
        // step through the posts in a column
        while (column.topdelta != 255) {
            source = reinterpret<uint8?>(column) + 3
            dest = desttop + int(column.topdelta) * SCREENWIDTH
            count = int(column.length)
            while (true) {
                let _t0 = count
                count--
                if (_t0 == 0) {
                    break
                }
                *dest = xlatab[int(*dest) + (int(*source) << 8)]
                source++
                dest += SCREENWIDTH
            }
            column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
        }
        x++
        col++
        desttop++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawAltTLPatch(var x : int; var y : int; var patch : patch_t?) {
    var count : int
    var col : int
    var column : post_t?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var w : int
    y -= int(patch.topoffset)
    x -= int(patch.leftoffset)
    if (x < 0 || x + int(patch.width) > SCREENWIDTH || y < 0 || y + int(patch.height) > SCREENHEIGHT) {
        I_Error`va(cstr("Bad V_DrawAltTLPatch"), VaNone())
    }
    col = 0
    desttop = doom_all__dest_screen + y * SCREENWIDTH + x
    w = int(patch.width)
    while (col < w) {
        column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[col])
        // step through the posts in a column
        while (column.topdelta != 255) {
            source = reinterpret<uint8?>(column) + 3
            dest = desttop + int(column.topdelta) * SCREENWIDTH
            count = int(column.length)
            while (true) {
                let _t0 = count
                count--
                if (_t0 == 0) {
                    break
                }
                var _t1 = source
                source++
                *dest = tinttable[(int(*dest) << 8) + int(*_t1)]
                dest += SCREENWIDTH
            }
            column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
        }
        x++
        col++
        desttop++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawShadowedPatch(var x : int; var y : int; var patch : patch_t?) {
    var count : int
    var col : int
    var column : post_t?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var desttop2 : uint8?
    var dest2 : uint8?
    var w : int
    y -= int(patch.topoffset)
    x -= int(patch.leftoffset)
    if (x < 0 || x + int(patch.width) > SCREENWIDTH || y < 0 || y + int(patch.height) > SCREENHEIGHT) {
        I_Error`va(cstr("Bad V_DrawShadowedPatch"), VaNone())
    }
    col = 0
    desttop = doom_all__dest_screen + y * SCREENWIDTH + x
    desttop2 = doom_all__dest_screen + (y + 2) * SCREENWIDTH + x + 2
    w = int(patch.width)
    while (col < w) {
        column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[col])
        // step through the posts in a column
        while (column.topdelta != 255) {
            source = reinterpret<uint8?>(column) + 3
            dest = desttop + int(column.topdelta) * SCREENWIDTH
            dest2 = desttop2 + int(column.topdelta) * SCREENWIDTH
            count = int(column.length)
            while (true) {
                let _t0 = count
                count--
                if (_t0 == 0) {
                    break
                }
                *dest2 = tinttable[int(*dest2) << 8]
                dest2 += SCREENWIDTH
                var _t1 = source
                source++
                *dest = *_t1
                dest += SCREENWIDTH
            }
            column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
        }
        x++
        col++
        desttop++
        desttop2++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_LoadTintTable {
    tinttable = reinterpret<uint8?>(W_CacheLumpName(cstr("TINTTAB"), int(anon_28.PU_STATIC)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_LoadXlaTable {
