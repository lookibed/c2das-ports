def M_SaveSelect(choice : int) {
    // we are going to be intercepting all chars
    saveStringEnter = 1
    saveSlot = choice
    M_StringCopy(addr(saveOldString[0]), addr(savegamestrings[choice][0]), uint64(SAVESTRINGSIZE))
    if (crt::strcmp(addr(savegamestrings[choice][0]), cstr("empty slot")) == 0) {
        savegamestrings[choice][0] = 0u8
    }
    saveCharIndex = int(crt::strlen(addr(savegamestrings[choice][0])))
}

