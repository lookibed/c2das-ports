[c_function, unsafe_deref, hint(unsafe_range_check)]
def doomgeneric_Create(argc : int; var argv : uint8 ??) {
    // save arguments
    myargc = argc
    myargv = argv
    M_FindResponseFile()
    DG_ScreenBuffer = reinterpret<uint8?>(crt::malloc(uint64(DOOMGENERIC_RESX * DOOMGENERIC_RESY * 4)))
    DG_Init()
    D_DoomMain()
}

// 32-bit FNV-1a over the frame's pixels, one 24-bit RGB word per pixel.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__dg_hash_frame : uint {
    var hash : uint = 2166136261u
    for (i in range(DOOMGENERIC_RESX * DOOMGENERIC_RESY)) {
        var c : color = colors[int(DG_ScreenBuffer[i])]
        let rgb : uint = (c.r << 16u) | (c.g << 8u) | c.b
        hash = (hash ^ rgb) * 16777619u
    }
    return hash
}

[unsafe_deref, hint(unsafe_range_check)]
def DG_Init {
}

[unsafe_deref, hint(unsafe_range_check)]
def DG_DrawFrame {
    if (dg_frame_count < DG_MAX_FRAMES) {
        dg_frame_hash[dg_frame_count] = int(doom_all__dg_hash_frame())
    }
    dg_frame_count += 1
}

[unsafe_deref, hint(unsafe_range_check)]
def DG_SleepMs(ms : uint) {
    doom_all__dg_virtual_ms += ms
}

[unsafe_deref, hint(unsafe_range_check)]
def DG_GetTicksMs : uint {
    return doom_all__dg_virtual_ms
}

[unsafe_deref, hint(unsafe_range_check)]
def DG_GetKey(var pressed : int?; var key : uint8?) : int {
    return 0
}

[unsafe_deref, hint(unsafe_range_check)]
def DG_SetWindowTitle(var title : uint8?) {
}

// One engine tic of virtual time (1000 / 35 ms, rounded down), advanced by
// the entries between two `doomgeneric_Tick` calls.
[unsafe_deref, hint(unsafe_range_check)]
def dg_advance_clock {
    doom_all__dg_virtual_ms += 28u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def c_main(argc : int; var argv : uint8 ??) : int {
    crt::setvbuf(crt::c_stdout(), null, 2, 0ul)
    if (argc < 2) {
        printf(cstr("load=0\n"))
        return 2
    }
    doom_all__doom_argv[0] = cstr("doom")
    doom_all__doom_argv[1] = cstr("-iwad")
    doom_all__doom_argv[2] = argv[argc - 1]
    doom_all__doom_argv[3] = cstr("-nosound")
    doom_all__doom_argv[4] = cstr("-nomusic")
    doom_all__doom_argv[5] = cstr("-timedemo")
    doom_all__doom_argv[6] = cstr("demo1")
    doom_all__doom_argv[7] = null
    doomgeneric_Create(7, addr(doom_all__doom_argv[0]))
    while (dg_frame_count < FRAME_LIMIT) {
        dg_advance_clock()
        doomgeneric_Tick()
    }
    for (i in range(FRAME_LIMIT)) {
        printf(cstr("frame[%d]=%d\n"), i, dg_frame_hash[i])
    }
    printf(cstr("frames=%d\n"), FRAME_LIMIT)
    return 0
}

[export]
def main : int {
    c_runtime_init("doom_all")
    return c_main(c_argc(), c_argv())
}
