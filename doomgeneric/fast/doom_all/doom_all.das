    orig_main = doom_all__doom_defaults.filename
    orig_extra = doom_all__extra_defaults.filename
    doom_all__doom_defaults.filename = main
    doom_all__extra_defaults.filename = extra
    M_SaveDefaults()
    // Restore normal filenames
    doom_all__doom_defaults.filename = orig_main
    doom_all__extra_defaults.filename = orig_extra
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_LoadDefaults {
    var i : int
    // check for a custom default file
    // !
    // @arg <file>
    // @vanilla
    // Load main configuration from the specified file, instead of the
    // default.
    i = M_CheckParmWithArgs(cstr("-config"), 1)
    if (i != 0) {
        doom_all__doom_defaults.filename = myargv[i + 1]
        fprintf(crt::c_stderr(), cstr("\tdefault file: %s\n"), doom_all__doom_defaults.filename)
    } else {
        doom_all__doom_defaults.filename = M_StringJoin`va(configdir, (doom_all__default_main_config, null))
    }
    fprintf(crt::c_stderr(), cstr("saving config in %s\n"), doom_all__doom_defaults.filename)
    // !
    // @arg <file>
    // Load additional configuration from the specified file, instead of
    // the default.
    i = M_CheckParmWithArgs(cstr("-extraconfig"), 1)
    if (i != 0) {
        doom_all__extra_defaults.filename = myargv[i + 1]
        fprintf(crt::c_stderr(), cstr("        extra configuration file: %s\n"), doom_all__extra_defaults.filename)
    } else {
        doom_all__extra_defaults.filename = M_StringJoin`va(configdir, (doom_all__default_extra_config, null))
    }
    doom_all__LoadDefaultCollection(addr(doom_all__doom_defaults))
    doom_all__LoadDefaultCollection(addr(doom_all__extra_defaults))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GetDefaultForName(var name : uint8?) : default_t? {
    var result : default_t?
    // Try the main list and the extras
    result = doom_all__SearchCollection(addr(doom_all__doom_defaults), name)
    if (result == null) {
        result = doom_all__SearchCollection(addr(doom_all__extra_defaults), name)
    }
    // Not found? Internal error.
    if (result == null) {
        I_Error`va(cstr("Unknown configuration variable: '%s'"), (name,))
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def M_BindVariable(var name : uint8?; var location : void?) {
    var variable : default_t?
    variable = doom_all__GetDefaultForName(name)
    variable.location = location
    variable.bound = 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_SetVariable(var name : uint8?; var value : uint8?) : uint {
    var variable : default_t?
    variable = doom_all__GetDefaultForName(name)
    if (variable == null || variable.bound == 0) {
        return 0u
    }
    doom_all__SetVariable(variable, value)
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
