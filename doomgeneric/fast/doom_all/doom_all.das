[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__ParseIntParameter(var strparm : uint8?) : int {
    var parm : int
    if (strparm[0] == '0' && strparm[1] == 'x') {
        sscanf(strparm + 2, cstr("%x"), addr(parm))
    } else {
        sscanf(strparm, cstr("%i"), addr(parm))
    }
    return parm
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SetVariable(var _c_def : default_t?; var value : uint8?) {
    var intparm : int
    // parameter found
    c_switch(_c_def._c_type) {
        case(default_type_t.DEFAULT_STRING) {
            *reinterpret<uint8 ??>(_c_def.location) = crt::strdup(value)
            break
        }
        case(default_type_t.DEFAULT_INT, default_type_t.DEFAULT_INT_HEX) {
            *reinterpret<int?>(_c_def.location) = doom_all__ParseIntParameter(value)
            break
        }
        case(default_type_t.DEFAULT_KEY) {
            // translate scancodes read from config
            // file (save the old value in untranslated)
            intparm = doom_all__ParseIntParameter(value)
            _c_def.untranslated = intparm
            if (intparm >= 0 && intparm < 128) {
                intparm = doom_all__scantokey[intparm]
            } else {
                intparm = 0
            }
            _c_def.original_translated = intparm
            *reinterpret<int?>(_c_def.location) = intparm
            break
        }
        case(default_type_t.DEFAULT_FLOAT) {
            *reinterpret<float?>(_c_def.location) = float(crt::atof(value))
            break
        }
    }
}

