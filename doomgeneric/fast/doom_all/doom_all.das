[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_BrainAwake(var mo : mobj_s?) {
    var thinker : thinker_s?
    var m : mobj_s?
    // find all the target spots
    numbraintargets = 0
    braintargeton = 0
    thinker = thinkercap.next
    thinker = thinkercap.next
    while (thinker != addr(thinkercap)) {
        {
            if (thinker._c_function.acp1 != reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
                // not a mobj
                continue
            }
            m = reinterpret<mobj_s?>(thinker)
            if (m._c_type == mobjtype_t.MT_BOSSTARGET) {
                braintargets[numbraintargets] = m
                numbraintargets++
            }
        } finally {
            thinker = thinker.next
        }
    }
    S_StartSound(null, int(sfxenum_t.sfx_bossit))
}

