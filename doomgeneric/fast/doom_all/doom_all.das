[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_QuickSave {
    if (usergame == 0) {
        S_StartSound(null, int(sfxenum_t.sfx_oof))
        return
    }
    if (gamestate != gamestate_t.GS_LEVEL) {
        return
    }
    if (quickSaveSlot < 0) {
        M_StartControlPanel()
        M_ReadSaveStrings()
        M_SetupNextMenu(addr(SaveDef))
        // means to pick a slot now
        quickSaveSlot = -2
        return
    }
    snprintf(addr(tempstring[0]), 80ul, cstr("quicksave over your game named\n\n'%s'?\n\npress y or n."), addr(savegamestrings[quickSaveSlot][0]))
    M_StartMessage(addr(tempstring[0]), reinterpret<void?>(@@M_QuickSaveResponse), 1u)
}

