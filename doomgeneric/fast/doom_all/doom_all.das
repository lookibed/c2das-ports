[unsafe_deref, hint(unsafe_range_check)]
def AM_getIslope(var ml : mline_t?; var _c_is : islope_t?) {
    var dx : int
    var dy : int
    dy = ml.a.y - ml.b.y
    dx = ml.b.x - ml.a.x
    if (dy == 0) {
        _c_is.islp = dx < 0 ? -2147483647 : 2147483647
    } else {
        _c_is.islp = FixedDiv(dx, dy)
    }
    if (dx == 0) {
        _c_is.slp = dy < 0 ? -2147483647 : 2147483647
    } else {
        _c_is.slp = FixedDiv(dy, dx)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_activateNewScale {
    doom_all__m_x += doom_all__m_w / 2
    doom_all__m_y += doom_all__m_h / 2
    doom_all__m_w = FTOM(doom_all__f_w)
    doom_all__m_h = FTOM(doom_all__f_h)
    doom_all__m_x -= doom_all__m_w / 2
    doom_all__m_y -= doom_all__m_h / 2
    doom_all__m_x2 = doom_all__m_x + doom_all__m_w
    doom_all__m_y2 = doom_all__m_y + doom_all__m_h
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_saveScaleAndLoc {
    doom_all__old_m_x = doom_all__m_x
    doom_all__old_m_y = doom_all__m_y
    doom_all__old_m_w = doom_all__m_w
    doom_all__old_m_h = doom_all__m_h
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_restoreScaleAndLoc {
    doom_all__m_w = doom_all__old_m_w
    doom_all__m_h = doom_all__old_m_h
    if (doom_all__followplayer == 0) {
        doom_all__m_x = doom_all__old_m_x
        doom_all__m_y = doom_all__old_m_y
    } else {
        doom_all__m_x = doom_all__plr.mo.x - doom_all__m_w / 2
        doom_all__m_y = doom_all__plr.mo.y - doom_all__m_h / 2
    }
    doom_all__m_x2 = doom_all__m_x + doom_all__m_w
    doom_all__m_y2 = doom_all__m_y + doom_all__m_h
    // Change the scaling multipliers
    doom_all__scale_mtof = FixedDiv(doom_all__f_w << FRACBITS, doom_all__m_w)
    doom_all__scale_ftom = FixedDiv(FRACUNIT, doom_all__scale_mtof)
}

// adds a marker at the current location
[unsafe_deref, hint(unsafe_range_check)]
def AM_addMark {
    doom_all__markpoints[doom_all__markpointnum].x = doom_all__m_x + doom_all__m_w / 2
    doom_all__markpoints[doom_all__markpointnum].y = doom_all__m_y + doom_all__m_h / 2
    doom_all__markpointnum = (doom_all__markpointnum + 1) % AM_NUMMARKPOINTS
}

// Determines bounding box of all vertices,
// sets global variables controlling zoom range.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_findMinMaxBoundaries {
    var a : int
    var b : int
    doom_all__min_y = 2147483647
    doom_all__min_x = doom_all__min_y
    doom_all__max_y = -2147483647
    doom_all__max_x = doom_all__max_y
    for (i in range(numvertexes)) {
        if (vertexes[i].x < doom_all__min_x) {
            doom_all__min_x = vertexes[i].x
        } elif (vertexes[i].x > doom_all__max_x) {
            doom_all__max_x = vertexes[i].x
        }
        if (vertexes[i].y < doom_all__min_y) {
            doom_all__min_y = vertexes[i].y
        } elif (vertexes[i].y > doom_all__max_y) {
            doom_all__max_y = vertexes[i].y
        }
    }
    doom_all__max_w = doom_all__max_x - doom_all__min_x
    doom_all__max_h = doom_all__max_y - doom_all__min_y
    // const? never changed?
    doom_all__min_w = 2 * 16 * FRACUNIT
    doom_all__min_h = 2 * 16 * FRACUNIT
    a = FixedDiv(doom_all__f_w << FRACBITS, doom_all__max_w)
    b = FixedDiv(doom_all__f_h << FRACBITS, doom_all__max_h)
    doom_all__min_scale_mtof = a < b ? a : b
    doom_all__max_scale_mtof = FixedDiv(doom_all__f_h << FRACBITS, 2 * 16 * FRACUNIT)
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_changeWindowLoc {
    if (doom_all__m_paninc.x != 0 || doom_all__m_paninc.y != 0) {
        doom_all__followplayer = 0
        doom_all__f_oldloc.x = 2147483647
    }
    doom_all__m_x += doom_all__m_paninc.x
    doom_all__m_y += doom_all__m_paninc.y
    if (doom_all__m_x + doom_all__m_w / 2 > doom_all__max_x) {
        doom_all__m_x = doom_all__max_x - doom_all__m_w / 2
    } elif (doom_all__m_x + doom_all__m_w / 2 < doom_all__min_x) {
        doom_all__m_x = doom_all__min_x - doom_all__m_w / 2
    }
    if (doom_all__m_y + doom_all__m_h / 2 > doom_all__max_y) {
        doom_all__m_y = doom_all__max_y - doom_all__m_h / 2
    } elif (doom_all__m_y + doom_all__m_h / 2 < doom_all__min_y) {
        doom_all__m_y = doom_all__min_y - doom_all__m_h / 2
    }
    doom_all__m_x2 = doom_all__m_x + doom_all__m_w
    doom_all__m_y2 = doom_all__m_y + doom_all__m_h
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_initVariables {
    automapactive = 1u
    doom_all__fb = I_VideoBuffer
    doom_all__f_oldloc.x = 2147483647
    doom_all__amclock = 0
    doom_all__lightlev = 0
    doom_all__m_paninc.y = 0
    doom_all__m_paninc.x = doom_all__m_paninc.y
    doom_all__ftom_zoommul = FRACUNIT
    doom_all__mtof_zoommul = FRACUNIT
    doom_all__m_w = FTOM(doom_all__f_w)
    doom_all__m_h = FTOM(doom_all__f_h)
    // find player to center on initially
    if (playeringame[consoleplayer] != 0) {
        doom_all__plr = addr(players[0]) + end_index(consoleplayer, 4)
    } else {
        doom_all__plr = addr(players[0])
        for (pnum in range(MAXPLAYERS)) {
            if (playeringame[pnum] != 0) {
                doom_all__plr = addr(players[0]) + end_index(pnum, 4)
                break
            }
        }
    }
    doom_all__m_x = doom_all__plr.mo.x - doom_all__m_w / 2
    doom_all__m_y = doom_all__plr.mo.y - doom_all__m_h / 2
    AM_changeWindowLoc()
    // for saving & restoring
    doom_all__old_m_x = doom_all__m_x
    doom_all__old_m_y = doom_all__m_y
    doom_all__old_m_w = doom_all__m_w
    doom_all__old_m_h = doom_all__m_h
    // inform the status bar of the change
    ST_Responder(addr(AM_initVariables_st_notify))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_loadPics {
    var namebuf : uint8[9]
    for (i in range(10)) {
        snprintf(addr(namebuf[0]), 9ul, cstr("AMMNUM%d"), i)
        doom_all__marknums[i] = reinterpret<patch_t?>(W_CacheLumpName(addr(namebuf[0]), int(anon_28.PU_STATIC)))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_unloadPics {
    var namebuf : uint8[9]
    for (i in range(10)) {
        snprintf(addr(namebuf[0]), 9ul, cstr("AMMNUM%d"), i)
        W_ReleaseLumpName(addr(namebuf[0]))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_clearMarks {
    for (i in range(AM_NUMMARKPOINTS)) {
        // means empty
        doom_all__markpoints[i].x = -1
    }
    doom_all__markpointnum = 0
}

// should be called at the start of every level
// right now, i figure it out myself
[unsafe_deref, hint(unsafe_range_check)]
def AM_LevelInit {
    doom_all__leveljuststarted = 0
    doom_all__f_y = 0
    doom_all__f_x = doom_all__f_y
    doom_all__f_w = doom_all__finit_width
    doom_all__f_h = doom_all__finit_height
    AM_clearMarks()
    AM_findMinMaxBoundaries()
    doom_all__scale_mtof = FixedDiv(doom_all__min_scale_mtof, int(0.7lf * double(FRACUNIT)))
    if (doom_all__scale_mtof > doom_all__max_scale_mtof) {
        doom_all__scale_mtof = doom_all__min_scale_mtof
    }
    doom_all__scale_ftom = FixedDiv(FRACUNIT, doom_all__scale_mtof)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_Stop {
    AM_unloadPics()
    automapactive = 0u
    ST_Responder(addr(AM_Stop_st_notify))
    doom_all__stopped = 1u
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_Start {
    if (doom_all__stopped == 0) {
        AM_Stop()
    }
    doom_all__stopped = 0u
    if (AM_Start_lastlevel != gamemap || AM_Start_lastepisode != gameepisode) {
        AM_LevelInit()
        AM_Start_lastlevel = gamemap
        AM_Start_lastepisode = gameepisode
    }
    AM_initVariables()
    AM_loadPics()
}

// set the window scale to the maximum size
[unsafe_deref, hint(unsafe_range_check)]
def AM_minOutWindowScale {
    doom_all__scale_mtof = doom_all__min_scale_mtof
    doom_all__scale_ftom = FixedDiv(FRACUNIT, doom_all__scale_mtof)
    AM_activateNewScale()
}

// set the window scale to the minimum size
[unsafe_deref, hint(unsafe_range_check)]
def AM_maxOutWindowScale {
    doom_all__scale_mtof = doom_all__max_scale_mtof
    doom_all__scale_ftom = FixedDiv(FRACUNIT, doom_all__scale_mtof)
    AM_activateNewScale()
}

// Handle events (user inputs) in automap mode
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_Responder(var ev : event_t?) : uint {
    var rc : int
    var key : int
    rc = 0
    if (automapactive == 0) {
        if (ev._c_type == evtype_t.ev_keydown && ev.data1 == key_map_toggle) {
            AM_Start()
            viewactive = 0u
            rc = 1
        }
    } elif (ev._c_type == evtype_t.ev_keydown) {
        rc = 1
        key = ev.data1
        // pan right
        if (key == key_map_east) {
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.x = FixedMul(F_PANINC << 16, doom_all__scale_ftom)
            } else {
                rc = 0
            }
        } elif (key == key_map_west) {
            // pan left
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.x = -FTOM(F_PANINC)
            } else {
                rc = 0
            }
        } elif (key == key_map_north) {
            // pan up
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.y = FTOM(F_PANINC)
            } else {
                rc = 0
            }
        } elif (key == key_map_south) {
            // pan down
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.y = -FTOM(F_PANINC)
            } else {
                rc = 0
            }
        } elif (key == key_map_zoomout) {
            // zoom out
            doom_all__mtof_zoommul = M_ZOOMOUT
            doom_all__ftom_zoommul = M_ZOOMIN
        } elif (key == key_map_zoomin) {
            // zoom in
            doom_all__mtof_zoommul = M_ZOOMIN
            doom_all__ftom_zoommul = M_ZOOMOUT
        } elif (key == key_map_toggle) {
            AM_Responder_bigstate = 0
            viewactive = 1u
            AM_Stop()
        } elif (key == key_map_maxzoom) {
            AM_Responder_bigstate = int_of(AM_Responder_bigstate == 0)
            if (AM_Responder_bigstate != 0) {
                AM_saveScaleAndLoc()
                AM_minOutWindowScale()
            } else {
                AM_restoreScaleAndLoc()
            }
        } elif (key == key_map_follow) {
            doom_all__followplayer = int_of(doom_all__followplayer == 0)
            doom_all__f_oldloc.x = 2147483647
            if (doom_all__followplayer != 0) {
                doom_all__plr.message = cstr("Follow Mode ON")
            } else {
                doom_all__plr.message = cstr("Follow Mode OFF")
            }
        } elif (key == key_map_grid) {
            doom_all__grid = int_of(doom_all__grid == 0)
            if (doom_all__grid != 0) {
                doom_all__plr.message = cstr("Grid ON")
            } else {
                doom_all__plr.message = cstr("Grid OFF")
            }
        } elif (key == key_map_mark) {
            M_snprintf`va(addr(AM_Responder_buffer[0]), uint64(typeinfo sizeof(type<uint8[20]>)), cstr("%s %d"), (cstr("Marked Spot"), doom_all__markpointnum))
            doom_all__plr.message = addr(AM_Responder_buffer[0])
            AM_addMark()
        } elif (key == key_map_clearmark) {
            AM_clearMarks()
            doom_all__plr.message = cstr("All Marks Cleared")
        } else {
            rc = 0
        }
        if (deathmatch == 0 && cht_CheckCheat(addr(cheat_amap), uint8(ev.data2)) != 0) {
            rc = 0
            doom_all__cheating = (doom_all__cheating + 1) % 3
        }
    } elif (ev._c_type == evtype_t.ev_keyup) {
        rc = 0
        key = ev.data1
        if (key == key_map_east) {
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.x = 0
            }
        } elif (key == key_map_west) {
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.x = 0
            }
        } elif (key == key_map_north) {
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.y = 0
            }
        } elif (key == key_map_south) {
            if (doom_all__followplayer == 0) {
                doom_all__m_paninc.y = 0
            }
        } elif (key == key_map_zoomout || key == key_map_zoomin) {
            doom_all__mtof_zoommul = FRACUNIT
            doom_all__ftom_zoommul = FRACUNIT
        }
    }
    return uint(rc)
}

// Zooming
[unsafe_deref, hint(unsafe_range_check)]
def AM_changeWindowScale {
    // Change the scaling multipliers
    doom_all__scale_mtof = FixedMul(doom_all__scale_mtof, doom_all__mtof_zoommul)
    doom_all__scale_ftom = FixedDiv(FRACUNIT, doom_all__scale_mtof)
    if (doom_all__scale_mtof < doom_all__min_scale_mtof) {
        AM_minOutWindowScale()
    } elif (doom_all__scale_mtof > doom_all__max_scale_mtof) {
        AM_maxOutWindowScale()
    } else {
        AM_activateNewScale()
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_doFollowPlayer {
    if (doom_all__f_oldloc.x != doom_all__plr.mo.x || doom_all__f_oldloc.y != doom_all__plr.mo.y) {
        doom_all__m_x = FTOM(MTOF(doom_all__plr.mo.x)) - doom_all__m_w / 2
        doom_all__m_y = FTOM(MTOF(doom_all__plr.mo.y)) - doom_all__m_h / 2
        doom_all__m_x2 = doom_all__m_x + doom_all__m_w
        doom_all__m_y2 = doom_all__m_y + doom_all__m_h
        doom_all__f_oldloc.x = doom_all__plr.mo.x
        doom_all__f_oldloc.y = doom_all__plr.mo.y
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_updateLightLev {
    // static int litelevels[] = { 0, 3, 5, 6, 6, 7, 7, 7 };
    // Change light level
    if (doom_all__amclock > AM_updateLightLev_nexttic) {
        let _t0 = AM_updateLightLev_litelevelscnt
        AM_updateLightLev_litelevelscnt++
        doom_all__lightlev = AM_updateLightLev_litelevels[_t0]
        if (uint64(AM_updateLightLev_litelevelscnt) == uint64(typeinfo sizeof(type<int[8]>)) / uint64(typeinfo sizeof(type<int>))) {
            AM_updateLightLev_litelevelscnt = 0
        }
        AM_updateLightLev_nexttic = doom_all__amclock + 6 - (doom_all__amclock % 6)
    }
}

// Updates on Game Tick
[unsafe_deref, hint(unsafe_range_check)]
def AM_Ticker {
    if (automapactive == 0) {
        return
    }
    doom_all__amclock++
    if (doom_all__followplayer != 0) {
        AM_doFollowPlayer()
    }
    // Change the zoom if necessary
    if (doom_all__ftom_zoommul != FRACUNIT) {
        AM_changeWindowScale()
    }
    // Change x,y location
    if (doom_all__m_paninc.x != 0 || doom_all__m_paninc.y != 0) {
        AM_changeWindowLoc()
    }
}

// Clear automap frame buffer.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_clearFB(color : int) {
    crt::memset(reinterpret<void?>(doom_all__fb), color, uint64(doom_all__f_w * doom_all__f_h))
}

// Automap clipping of lines.
// Based on Cohen-Sutherland clipping algorithm but with a slightly
// faster reject and precalculated slopes. If the speed is needed,
// use a hash algorithm to handle the common cases.
[unsafe_deref, hint(unsafe_range_check)]
def AM_clipMline(var ml : mline_t?; var fl : fline_t?) : uint {
    var outcode1 : int = 0
    var outcode2 : int = 0
    var outside : int
    var tmp : fpoint_t
    var dx : int
    var dy : int
    // do trivial rejects and outcodes
    if (ml.a.y > doom_all__m_y2) {
        outcode1 = int(anon_564.TOP)
    } elif (ml.a.y < doom_all__m_y) {
        outcode1 = int(anon_564.BOTTOM)
    }
    if (ml.b.y > doom_all__m_y2) {
        outcode2 = int(anon_564.TOP)
    } elif (ml.b.y < doom_all__m_y) {
        outcode2 = int(anon_564.BOTTOM)
    }
    if ((outcode1 & outcode2) != 0) {
        // trivially outside
        return 0u
    }
    if (ml.a.x < doom_all__m_x) {
        outcode1 |= int(anon_564.LEFT)
    } elif (ml.a.x > doom_all__m_x2) {
        outcode1 |= int(anon_564.RIGHT)
    }
    if (ml.b.x < doom_all__m_x) {
        outcode2 |= int(anon_564.LEFT)
    } elif (ml.b.x > doom_all__m_x2) {
        outcode2 |= int(anon_564.RIGHT)
    }
    if ((outcode1 & outcode2) != 0) {
        // trivially outside
        return 0u
    }
    // transform to frame-buffer coordinates.
    fl.a.x = CXMTOF(ml.a.x)
    fl.a.y = CYMTOF(ml.a.y)
    fl.b.x = CXMTOF(ml.b.x)
    fl.b.y = CYMTOF(ml.b.y)
    outcode1 = 0
    if (fl.a.y < 0) {
        outcode1 |= int(anon_564.TOP)
    } elif (fl.a.y >= doom_all__f_h) {
        outcode1 |= int(anon_564.BOTTOM)
    }
    if (fl.a.x < 0) {
        outcode1 |= int(anon_564.LEFT)
    } elif (fl.a.x >= doom_all__f_w) {
        outcode1 |= int(anon_564.RIGHT)
    }
    outcode2 = 0
    if (fl.b.y < 0) {
        outcode2 |= int(anon_564.TOP)
    } elif (fl.b.y >= doom_all__f_h) {
        outcode2 |= int(anon_564.BOTTOM)
    }
    if (fl.b.x < 0) {
        outcode2 |= int(anon_564.LEFT)
    } elif (fl.b.x >= doom_all__f_w) {
        outcode2 |= int(anon_564.RIGHT)
    }
    if ((outcode1 & outcode2) != 0) {
        return 0u
    }
    while ((outcode1 | outcode2) != 0) {
        // may be partially inside box
        // find an outside point
        if (outcode1 != 0) {
            outside = outcode1
        } else {
            outside = outcode2
        }
        // clip to each side
        if ((outside & int(anon_564.TOP)) != 0) {
            dy = fl.a.y - fl.b.y
            dx = fl.b.x - fl.a.x
            tmp.x = fl.a.x + (dx * fl.a.y) / dy
            tmp.y = 0
        } elif ((outside & int(anon_564.BOTTOM)) != 0) {
            dy = fl.a.y - fl.b.y
            dx = fl.b.x - fl.a.x
            tmp.x = fl.a.x + (dx * (fl.a.y - doom_all__f_h)) / dy
            tmp.y = doom_all__f_h - 1
        } elif ((outside & int(anon_564.RIGHT)) != 0) {
            dy = fl.b.y - fl.a.y
            dx = fl.b.x - fl.a.x
            tmp.y = fl.a.y + (dy * (doom_all__f_w - 1 - fl.a.x)) / dx
            tmp.x = doom_all__f_w - 1
        } elif ((outside & int(anon_564.LEFT)) != 0) {
            dy = fl.b.y - fl.a.y
            dx = fl.b.x - fl.a.x
            tmp.y = fl.a.y + (dy * (-fl.a.x)) / dx
            tmp.x = 0
        } else {
            tmp.x = 0
            tmp.y = 0
        }
        if (outside == outcode1) {
            fl.a = tmp
            outcode1 = 0
            if (fl.a.y < 0) {
                outcode1 |= int(anon_564.TOP)
            } elif (fl.a.y >= doom_all__f_h) {
                outcode1 |= int(anon_564.BOTTOM)
            }
            if (fl.a.x < 0) {
                outcode1 |= int(anon_564.LEFT)
            } elif (fl.a.x >= doom_all__f_w) {
                outcode1 |= int(anon_564.RIGHT)
            }
        } else {
            fl.b = tmp
            outcode2 = 0
            if (fl.b.y < 0) {
                outcode2 |= int(anon_564.TOP)
            } elif (fl.b.y >= doom_all__f_h) {
                outcode2 |= int(anon_564.BOTTOM)
            }
            if (fl.b.x < 0) {
                outcode2 |= int(anon_564.LEFT)
            } elif (fl.b.x >= doom_all__f_w) {
                outcode2 |= int(anon_564.RIGHT)
            }
        }
        if ((outcode1 & outcode2) != 0) {
            // trivially outside
            return 0u
        }
    }
    return 1u
}

// Classic Bresenham w/ whatever optimizations needed for speed
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawFline(var fl : fline_t?; color : int) {
    var x : int
    var y : int
    var dx : int
    var dy : int
    var sx : int
    var sy : int
    var ax : int
    var ay : int
    var d : int
    // For debugging only
    if (fl.a.x < 0 || fl.a.x >= doom_all__f_w || fl.a.y < 0 || fl.a.y >= doom_all__f_h || fl.b.x < 0 || fl.b.x >= doom_all__f_w || fl.b.y < 0 ||
            fl.b.y >= doom_all__f_h) {
        let _t0 = AM_drawFline_fuck
        AM_drawFline_fuck++
        fprintf(crt::c_stderr(), cstr("fuck %d \r"), _t0)
        return
    }
    dx = fl.b.x - fl.a.x
    ax = 2 * (dx < 0 ? -dx : dx)
    sx = dx < 0 ? -1 : 1
    dy = fl.b.y - fl.a.y
    ay = 2 * (dy < 0 ? -dy : dy)
    sy = dy < 0 ? -1 : 1
    x = fl.a.x
    y = fl.a.y
    if (ax > ay) {
        d = ay - ax / 2
        while (1 != 0) {
            PUTDOT(x, y, color)
            if (x == fl.b.x) {
                return
            }
            if (d >= 0) {
                y += sy
                d -= ax
            }
            x += sx
            d += ay
        }
    } else {
        d = ax - ay / 2
        while (1 != 0) {
            PUTDOT(x, y, color)
            if (y == fl.b.y) {
                return
            }
            if (d >= 0) {
                x += sx
                d -= ay
            }
            y += sy
            d += ax
        }
    }
}

// Clip lines, draw visible part sof lines.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawMline(var ml : mline_t?; color : int) {
    if (AM_clipMline(ml, addr(AM_drawMline_fl)) != 0) {
        // draws it on frame buffer using fb coords
        AM_drawFline(addr(AM_drawMline_fl), color)
    }
}

// Draws flat (floor/ceiling tile) aligned grid lines.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawGrid(color : int) {
    var x : int
    var y : int
    var start : int
    var end : int
    var ml : mline_t
    // Figure out start of vertical gridlines
    start = doom_all__m_x
    if ((start - bmaporgx) % (MAPBLOCKUNITS << FRACBITS) != 0) {
        start += (MAPBLOCKUNITS << FRACBITS) - ((start - bmaporgx) % (MAPBLOCKUNITS << FRACBITS))
    }
    end = doom_all__m_x + doom_all__m_w
    // draw vertical gridlines
    ml.a.y = doom_all__m_y
    ml.b.y = doom_all__m_y + doom_all__m_h
    x = start
    while (x < end) {
        ml.a.x = x
        ml.b.x = x
        AM_drawMline(addr(ml), color)
        x += MAPBLOCKUNITS << FRACBITS
    }
    // Figure out start of horizontal gridlines
    start = doom_all__m_y
    if ((start - bmaporgy) % (MAPBLOCKUNITS << FRACBITS) != 0) {
        start += (MAPBLOCKUNITS << FRACBITS) - ((start - bmaporgy) % (MAPBLOCKUNITS << FRACBITS))
    }
    end = doom_all__m_y + doom_all__m_h
    // draw horizontal gridlines
    ml.a.x = doom_all__m_x
    ml.b.x = doom_all__m_x + doom_all__m_w
    y = start
    while (y < end) {
        ml.a.y = y
        ml.b.y = y
        AM_drawMline(addr(ml), color)
        y += MAPBLOCKUNITS << FRACBITS
    }
}

// Determines visible lines, draws them.
// This is LineDef based, not LineSeg based.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawWalls {
    for (i in range(numlines)) {
        AM_drawWalls_l.a.x = lines[i].v1.x
        AM_drawWalls_l.a.y = lines[i].v1.y
        AM_drawWalls_l.b.x = lines[i].v2.x
        AM_drawWalls_l.b.y = lines[i].v2.y
        if (doom_all__cheating != 0 || (int(lines[i].flags) & ML_MAPPED) != 0) {
            if ((int(lines[i].flags) & ML_DONTDRAW) != 0 && doom_all__cheating == 0) {
                continue
            }
            if (lines[i].backsector == null) {
                AM_drawMline(addr(AM_drawWalls_l), WALLCOLORS + doom_all__lightlev)
            } else {
                if (lines[i].special == 39) {
                    // teleporters
                    AM_drawMline(addr(AM_drawWalls_l), WALLCOLORS + WALLRANGE / 2)
                } elif ((int(lines[i].flags) & ML_SECRET) != 0) {
                    // secret door
                    if (doom_all__cheating != 0) {
                        AM_drawMline(addr(AM_drawWalls_l), SECRETWALLCOLORS + doom_all__lightlev)
                    } else {
                        AM_drawMline(addr(AM_drawWalls_l), WALLCOLORS + doom_all__lightlev)
                    }
                } elif (lines[i].backsector.floorheight != lines[i].frontsector.floorheight) {
                    // floor level change
                    AM_drawMline(addr(AM_drawWalls_l), FDWALLCOLORS + doom_all__lightlev)
                } elif (lines[i].backsector.ceilingheight != lines[i].frontsector.ceilingheight) {
                    // ceiling level change
                    AM_drawMline(addr(AM_drawWalls_l), CDWALLCOLORS + doom_all__lightlev)
                } elif (doom_all__cheating != 0) {
                    AM_drawMline(addr(AM_drawWalls_l), TSWALLCOLORS + doom_all__lightlev)
                }
            }
        } elif (doom_all__plr.powers[int(powertype_t.pw_allmap)] != 0) {
            if ((int(lines[i].flags) & ML_DONTDRAW) == 0) {
                AM_drawMline(addr(AM_drawWalls_l), GRAYS + 3)
            }
        }
    }
}

// Rotation in 2D.
// Used to rotate player arrow line character.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_rotate(var x : int?; var y : int?; a : uint) {
    var tmpx : int
    tmpx = FixedMul(*x, finecosine[a >> uint(ANGLETOFINESHIFT)]) - FixedMul(*y, finesine[a >> uint(ANGLETOFINESHIFT)])
    *y = FixedMul(*x, finesine[a >> uint(ANGLETOFINESHIFT)]) + FixedMul(*y, finecosine[a >> uint(ANGLETOFINESHIFT)])
    *x = tmpx
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawLineCharacter(var lineguy : mline_t?; lineguylines : int; scale : int; angle : uint; color : int; x : int; y : int) {
    var l : mline_t
    for (i in range(lineguylines)) {
        l.a.x = lineguy[i].a.x
        l.a.y = lineguy[i].a.y
        if (scale != 0) {
            l.a.x = FixedMul(scale, l.a.x)
            l.a.y = FixedMul(scale, l.a.y)
        }
        if (angle != 0) {
            AM_rotate(addr(l.a.x), addr(l.a.y), angle)
        }
        l.a.x += x
        l.a.y += y
        l.b.x = lineguy[i].b.x
        l.b.y = lineguy[i].b.y
        if (scale != 0) {
            l.b.x = FixedMul(scale, l.b.x)
            l.b.y = FixedMul(scale, l.b.y)
        }
        if (angle != 0) {
            AM_rotate(addr(l.b.x), addr(l.b.y), angle)
        }
        l.b.x += x
        l.b.y += y
        AM_drawMline(addr(l), color)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawPlayers {
    var p : player_s?
    var their_color : int = -1
    var color : int
    if (netgame == 0) {
        if (doom_all__cheating != 0) {
            AM_drawLineCharacter(addr(cheat_player_arrow[0]), int(uint64(typeinfo sizeof(type<mline_t[16]>)) / uint64(typeinfo sizeof(type<mline_t>))), 0,
                    doom_all__plr.mo.angle, WHITE, doom_all__plr.mo.x, doom_all__plr.mo.y)
        } else {
            AM_drawLineCharacter(addr(player_arrow[0]), int(uint64(typeinfo sizeof(type<mline_t[7]>)) / uint64(typeinfo sizeof(type<mline_t>))), 0,
                    doom_all__plr.mo.angle, WHITE, doom_all__plr.mo.x, doom_all__plr.mo.y)
        }
        return
    }
    for (i in range(MAXPLAYERS)) {
        their_color++
        p = addr(players[0]) + end_index(i, 4)
        if ((deathmatch != 0 && singledemo == 0) && p != doom_all__plr) {
            continue
        }
        if (playeringame[i] == 0) {
            continue
        }
        if (p.powers[int(powertype_t.pw_invisibility)] != 0) {
            // close* to black
            color = 246
        } else {
            color = AM_drawPlayers_their_colors[their_color]
        }
        AM_drawLineCharacter(addr(player_arrow[0]), int(uint64(typeinfo sizeof(type<mline_t[7]>)) / uint64(typeinfo sizeof(type<mline_t>))), 0, p.mo.angle,
                color, p.mo.x, p.mo.y)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawThings(colors : int; colorrange : int) {
    var t : mobj_s?
    for (i in range(numsectors)) {
        t = sectors[i].thinglist
        while (t != null) {
            AM_drawLineCharacter(addr(thintriangle_guy[0]), int(uint64(typeinfo sizeof(type<mline_t[3]>)) / uint64(typeinfo sizeof(type<mline_t>))),
                    16 << FRACBITS, t.angle, colors + doom_all__lightlev, t.x, t.y)
            t = t.snext
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_drawMarks {
    var fx : int
    var fy : int
    var w : int
    var h : int
    for (i in range(AM_NUMMARKPOINTS)) {
        if (doom_all__markpoints[i].x != -1) {
            // w = SHORT(marknums[i]->width);
            // h = SHORT(marknums[i]->height);
            // because something's wrong with the wad, i guess
            w = 5
            // because something's wrong with the wad, i guess
            h = 6
            fx = CXMTOF(doom_all__markpoints[i].x)
            fy = CYMTOF(doom_all__markpoints[i].y)
            if (fx >= doom_all__f_x && fx <= doom_all__f_w - w && fy >= doom_all__f_y && fy <= doom_all__f_h - h) {
                V_DrawPatch(fx, fy, doom_all__marknums[i])
            }
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AM_drawCrosshair(color : int) {
    // single point for now
    doom_all__fb[(doom_all__f_w * (doom_all__f_h + 1)) / 2] = uint8(color)
}

[unsafe_deref, hint(unsafe_range_check)]
def AM_Drawer {
    if (automapactive == 0) {
        return
    }
    AM_clearFB(BACKGROUND)
    if (doom_all__grid != 0) {
        AM_drawGrid(GRIDCOLORS)
    }
    AM_drawWalls()
    AM_drawPlayers()
    if (doom_all__cheating == 2) {
        AM_drawThings(THINGCOLORS, THINGRANGE)
    }
    AM_drawCrosshair(XHAIRCOLORS)
    AM_drawMarks()
    V_MarkRect(doom_all__f_x, doom_all__f_y, doom_all__f_w, doom_all__f_h)
}

// D_PostEvent
// Called by the I/O functions when input is detected
[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_PostEvent(var ev : event_t?) {
    doom_all__events[doom_all__eventhead] = *ev
    doom_all__eventhead = (doom_all__eventhead + 1) % MAXEVENTS
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_PopEvent : event_t? {
    var result : event_t?
    // No more events waiting.
    if (doom_all__eventtail == doom_all__eventhead) {
        return null
    }
    result = addr(doom_all__events[0]) + end_index(doom_all__eventtail, 64)
    // Advance to the next event in the queue.
    doom_all__eventtail = (doom_all__eventtail + 1) % MAXEVENTS
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__AddIWADDir(var dir : uint8?) {
    if (doom_all__num_iwad_dirs < MAX_IWAD_DIRS) {
        doom_all__iwad_dirs[doom_all__num_iwad_dirs] = dir
        doom_all__num_iwad_dirs++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__DirIsFile(var path : uint8?; var filename : uint8?) : uint {
    var path_len : uint64
    var filename_len : uint64
    path_len = crt::strlen(path)
    filename_len = crt::strlen(filename)
    return uint(int_of(path_len >= filename_len + 1ul && int(path[path_len - filename_len - 1ul]) == DIR_SEPARATOR &&
            crt::strcasecmp(addr(path[path_len - filename_len]), filename) == 0))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__CheckDirectoryHasIWAD(var dir : uint8?; var iwadname : uint8?) : uint8? {
    var filename : uint8?
    // As a special case, the "directory" may refer directly to an
    // IWAD file if the path comes from DOOMWADDIR or DOOMWADPATH.
    if (doom_all__DirIsFile(dir, iwadname) != 0 && M_FileExists(dir) != 0) {
        return crt::strdup(dir)
    }
    // Construct the full path to the IWAD if it is located in
    // this directory, and check if it exists.
    if (crt::strcmp(dir, cstr(".")) == 0) {
        filename = crt::strdup(iwadname)
    } else {
        filename = M_StringJoin`va(dir, (cstr("/"), iwadname, null))
    }
    fprintf(crt::c_stderr(), cstr("Trying IWAD file:%s\n"), filename)
    if (M_FileExists(filename) != 0) {
        return filename
    }
    crt::free(reinterpret<void?>(filename))
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SearchDirectoryForIWAD(var dir : uint8?; mask : int; var mission : GameMission_t?) : uint8? {
    var filename : uint8?
    var i : uint64
    {
        i = 0ul
        var _f = false
        while (true) {
            if (_f) {
                i++
            }
            _f = true
            if (!(i < uint64(typeinfo sizeof(type<iwad_t[14]>)) / uint64(typeinfo sizeof(type<iwad_t>)))) {
                break
            }
            if (((1 << int(uint(doom_all__iwads[i].mission))) & mask) == 0) {
                continue
            }
            filename = doom_all__CheckDirectoryHasIWAD(dir, doom_all__iwads[i].name)
            if (filename != null) {
                *mission = doom_all__iwads[i].mission
                return filename
            }
        }
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__IdentifyIWADByName(var name : uint8?; mask : int) : GameMission_t {
    var i : uint64
    var mission : GameMission_t
    var p : uint8?
    p = crt::strrchr(name, DIR_SEPARATOR)
    if (p != null) {
        name = p + 1
    }
    mission = GameMission_t.none
    {
        i = 0ul
        var _f = false
        while (true) {
            if (_f) {
                i++
            }
            _f = true
            if (!(i < uint64(typeinfo sizeof(type<iwad_t[14]>)) / uint64(typeinfo sizeof(type<iwad_t>)))) {
                break
            }
            // Check if the filename is this IWAD name.
            // Only use supported missions:
            if (((1 << int(uint(doom_all__iwads[i].mission))) & mask) == 0) {
                continue
            }
            // Check if it ends in this IWAD name.
            if (crt::strcasecmp(name, doom_all__iwads[i].name) == 0) {
                mission = doom_all__iwads[i].mission
                break
            }
        }
    }
    return mission
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__BuildIWADDirList {
    // Look in the current directory. Doom always does this.
    // Add DOOMWADDIR if it is in the environment
    // Add dirs from DOOMWADPATH
    // Search the registry and find where IWADs have been installed.
    // Check for GUS patches installed with the BFG edition!
    // Standard places where IWAD files are installed under Unix.
    doom_all__AddIWADDir(cstr("."))
    // Don't run this function again.
    doom_all__iwad_dirs_built = 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_FindWADByName(var name : uint8?) : uint8? {
    var path : uint8?
    var i : int
    // Absolute path?
    if (M_FileExists(name) != 0) {
        return name
    }
    doom_all__BuildIWADDirList()
    // Search through all IWAD paths for a file with the given name.
    i = 0
    while (i < doom_all__num_iwad_dirs) {
        // As a special case, if this is in DOOMWADDIR or DOOMWADPATH,
        // the "directory" may actually refer directly to an IWAD
        // file.
        if (doom_all__DirIsFile(doom_all__iwad_dirs[i], name) != 0 && M_FileExists(doom_all__iwad_dirs[i]) != 0) {
            return crt::strdup(doom_all__iwad_dirs[i])
        }
        // Construct a string for the full path
        path = M_StringJoin`va(doom_all__iwad_dirs[i], (cstr("/"), name, null))
        if (M_FileExists(path) != 0) {
            return path
        }
        crt::free(reinterpret<void?>(path))
        i++
    }
    // File not found
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_TryFindWADByName(var filename : uint8?) : uint8? {
    var result : uint8?
    result = D_FindWADByName(filename)
    if (result != null) {
        return result
    } else {
        return filename
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_FindIWAD(mask : int; var mission : GameMission_t?) : uint8? {
    var result : uint8?
    var iwadfile : uint8?
    var iwadparm : int
    var i : int
    // Check for the -iwad parameter
    // !
    // Specify an IWAD file to use.
    // @arg <file>
    iwadparm = M_CheckParmWithArgs(cstr("-iwad"), 1)
    if (iwadparm != 0) {
        // Search through IWAD dirs for an IWAD with the given name.
        iwadfile = myargv[iwadparm + 1]
        result = D_FindWADByName(iwadfile)
        if (result == null) {
            I_Error`va(cstr("IWAD file '%s' not found!"), (iwadfile,))
        }
        *mission = doom_all__IdentifyIWADByName(result, mask)
    } else {
        // Search through the list and look for an IWAD
        fprintf(crt::c_stderr(), cstr("-iwad not specified, trying a few iwad names\n"))
        result = null
        doom_all__BuildIWADDirList()
        i = 0
        while (result == null && i < doom_all__num_iwad_dirs) {
            result = doom_all__SearchDirectoryForIWAD(doom_all__iwad_dirs[i], mask, mission)
            i++
        }
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_FindAllIWADs(mask : int) : iwad_t ?? {
    var result : iwad_t ??
    var result_len : int
    var filename : uint8?
    var i : int
    result = reinterpret<iwad_t ??>(crt::malloc(uint64(typeinfo sizeof(type<iwad_t?>)) *
            (uint64(typeinfo sizeof(type<iwad_t[14]>)) / uint64(typeinfo sizeof(type<iwad_t>)) + 1ul)))
    result_len = 0
    // Try to find all IWADs
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<iwad_t[14]>)) / uint64(typeinfo sizeof(type<iwad_t>))) {
        {
            if (((1 << int(uint(doom_all__iwads[i].mission))) & mask) == 0) {
                continue
            }
            filename = D_FindWADByName(doom_all__iwads[i].name)
            if (filename != null) {
                result[result_len] = addr(doom_all__iwads[0]) + end_index(i, 14)
                result_len++
            }
        } finally {
            i++
        }
    }
    // End of list
    result[result_len] = null
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def D_SaveGameIWADName(gamemission : GameMission_t) : uint8? {
    var i : uint64
    // Determine the IWAD name to use for savegames.
    // This determines the directory the savegame files get put into.
    // Note that we match on gamemission rather than on IWAD name.
    // This ensures that doom1.wad and doom.wad saves are stored
    // in the same place.
    i = 0ul
    while (i < uint64(typeinfo sizeof(type<iwad_t[14]>)) / uint64(typeinfo sizeof(type<iwad_t>))) {
        if (gamemission == doom_all__iwads[i].mission) {
            return doom_all__iwads[i].name
        }
        i++
    }
    // Default fallback:
    return cstr("unknown.wad")
}

[unsafe_deref, hint(unsafe_range_check)]
def D_SuggestIWADName(mission : GameMission_t; mode : GameMode_t) : uint8? {
    var i : int
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<iwad_t[14]>)) / uint64(typeinfo sizeof(type<iwad_t>))) {
        if (doom_all__iwads[i].mission == mission && doom_all__iwads[i].mode == mode) {
            return doom_all__iwads[i].name
        }
        i++
    }
    return cstr("unknown.wad")
}

[unsafe_deref, hint(unsafe_range_check)]
def D_SuggestGameName(mission : GameMission_t; mode : GameMode_t) : uint8? {
    var i : int
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<iwad_t[14]>)) / uint64(typeinfo sizeof(type<iwad_t>))) {
        if (doom_all__iwads[i].mission == mission && (mode == GameMode_t.indetermined || doom_all__iwads[i].mode == mode)) {
            return doom_all__iwads[i].description
        }
        i++
    }
    return cstr("Unknown game?")
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GetAdjustedTime : int {
    var time_ms : int
    time_ms = I_GetTimeMS()
    if (doom_all__new_sync != 0) {
        // Use the adjustments from net_client.c only if we are
        // using the new sync mode.
        time_ms += offsetms / FRACUNIT
    }
    return (time_ms * TICRATE) / 1000
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__BuildNewTic : uint {
    var gameticdiv : int
    var cmd : ticcmd_t
    gameticdiv = gametic / ticdup
    I_StartTic()
    invoke(doom_all__loop_interface.ProcessEvents)
    // Always run the menu
    invoke(doom_all__loop_interface.RunMenu)
    if (drone != 0) {
        // In drone mode, do not generate any ticcmds.
        return 0u
    }
    if (doom_all__new_sync != 0) {
        // If playing single player, do not allow tics to buffer
        // up very far
        if (net_client_connected == 0 && doom_all__maketic - gameticdiv > 2) {
            return 0u
        }
        // Never go more than ~200ms ahead
        if (doom_all__maketic - gameticdiv > 8) {
            return 0u
        }
    } else {
        if (doom_all__maketic - gameticdiv >= 5) {
            return 0u
        }
    }
    // printf ("mk:%i ",maketic);
    crt::memset(reinterpret<void?>(addr(cmd)), 0, uint64(typeinfo sizeof(type<ticcmd_t>)))
    invoke(doom_all__loop_interface.BuildTiccmd, addr(cmd), doom_all__maketic)
    doom_all__ticdata[doom_all__maketic % BACKUPTICS].cmds[doom_all__localplayer] = cmd
    doom_all__ticdata[doom_all__maketic % BACKUPTICS].ingame[doom_all__localplayer] = 1u
    doom_all__maketic++
    return 1u
}

[unsafe_deref, hint(unsafe_range_check)]
def NetUpdate {
    var nowtime : int
    var newtics : int
    // If we are running with singletics (timing a demo), this
    // is all done separately.
    if (singletics != 0) {
        return
    }
    // Run network subsystems
    // check time
    nowtime = doom_all__GetAdjustedTime() / ticdup
    newtics = nowtime - lasttime
    lasttime = nowtime
    if (doom_all__skiptics <= newtics) {
        newtics -= doom_all__skiptics
        doom_all__skiptics = 0
    } else {
        doom_all__skiptics -= newtics
        newtics = 0
    }
    // build new ticcmds for console player
    for (i in range(newtics)) {
        if (doom_all__BuildNewTic() == 0) {
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__D_Disconnected {
    // In drone mode, the game cannot continue once disconnected.
    if (drone != 0) {
        I_Error`va(cstr("Disconnected from server in drone mode."), VaNone())
    }
    // disconnected from server
    fprintf(crt::c_stderr(), cstr("Disconnected from server.\n"))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_ReceiveTic(var ticcmds : ticcmd_t?; var players_mask : uint?) {
    // Disconnected from server?
    if (ticcmds == null && players_mask == null) {
        doom_all__D_Disconnected()
        return
    }
    for (i in range(NET_MAXPLAYERS)) {
        if (drone == 0 && i == doom_all__localplayer) {
        } else {
            // This is us. Don't overwrite it.
            doom_all__ticdata[doom_all__recvtic % BACKUPTICS].cmds[i] = ticcmds[i]
            doom_all__ticdata[doom_all__recvtic % BACKUPTICS].ingame[i] = players_mask[i]
        }
    }
    doom_all__recvtic++
}

[unsafe_deref, hint(unsafe_range_check)]
def D_StartGameLoop {
    lasttime = doom_all__GetAdjustedTime() / ticdup
}

[unsafe_deref, hint(unsafe_range_check)]
def D_StartNetGame(var settings : net_gamesettings_t?; callback : function<(a0 : int; a1 : int) : uint>) {
    // !
    // @category net
    // Use new network client sync code rather than the classic
    // sync code. This is currently disabled by default because it
    // has some bugs.
    // TODO: New sync code is not enabled by default because it's
    // currently broken.
    // if (M_CheckParm("-oldsync") > 0)
    // settings->new_sync = 0;
    // else
    // settings->new_sync = 1;
    // !
    // @category net
    // @arg <n>
    // Send n extra tics in every packet as insurance against dropped
    // packets.
    // !
    // @category net
    // @arg <n>
    // Reduce the resolution of the game by a factor of n, reducing
    // the amount of network bandwidth needed.
    // Send our game settings and block until game start is received
    // from the server.
    // Read the game settings that were received.
    // Set the local player and playeringame[] values.
    // Copy settings to global variables.
    // TODO: Message disabled until we fix new_sync.
    // if (!new_sync)
    // {
    // printf("Syncing netgames like Vanilla Doom.\n");
    // }
    settings.consoleplayer = 0
    settings.num_players = 1
    settings.player_classes[0] = doom_all__player_class
    settings.new_sync = 0
    settings.extratics = 1
    settings.ticdup = 1
    ticdup = settings.ticdup
    doom_all__new_sync = uint(settings.new_sync)
}

[unsafe_deref, hint(unsafe_range_check)]
def D_InitNetGame(var connect_data : net_connect_data_t?) : uint {
    let result : uint = 0u
    // Call D_QuitNetGame on exit:
    I_AtExit(@@D_QuitNetGame, 1u)
    doom_all__player_class = connect_data.player_class
    // !
    // @category net
    // Start a multiplayer server, listening for connections.
    // !
    // @category net
    // Automatically search the local LAN for a multiplayer
    // server and join it.
    // !
    // @arg <address>
    // @category net
    // Connect to a multiplayer server running on the given
    // address.
    // Wait for launch message received from server.
    return result
}

// D_QuitNetGame
// Called before quitting to leave a net game
// without hanging the other players
[unsafe_deref, hint(unsafe_range_check)]
def D_QuitNetGame {
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GetLowTic : int {
    var lowtic : int
    lowtic = doom_all__maketic
    return lowtic
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__OldNetSync {
    var keyplayer : int = -1
    doom_all__frameon++
    // ideally maketic should be 1 - 3 tics above lowtic
    // if we are consistantly slower, speed up time
    for (i in urange(uint(NET_MAXPLAYERS))) {
        if (doom_all__local_playeringame[i] != 0) {
            keyplayer = int(i)
            break
        }
    }
    if (keyplayer < 0) {
        // If there are no players, we can never advance anyway
        return
    }
    if (doom_all__localplayer == keyplayer) {
    } else {
        // the key player does not adapt
        if (doom_all__maketic <= doom_all__recvtic) {
            lasttime--
        }
        // printf ("-");
        doom_all__frameskip[doom_all__frameon & 3] = int_of(doom_all__oldnettics > doom_all__recvtic)
        doom_all__oldnettics = doom_all__maketic
        if (doom_all__frameskip[0] != 0 && doom_all__frameskip[1] != 0 && doom_all__frameskip[2] != 0 && doom_all__frameskip[3] != 0) {
            doom_all__skiptics = 1
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__PlayersInGame : uint {
    var result : uint = 0u
    // If we are connected to a server, check if there are any players
    // in the game.
    if (net_client_connected != 0) {
        for (i in urange(uint(NET_MAXPLAYERS))) {
            result = uint(int_of(result != 0 || doom_all__local_playeringame[i] != 0))
        }
    }
    // Whether single or multi-player, unless we are running as a drone,
    // we are in the game.
    if (drone == 0) {
        result = 1u
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__TicdupSquash(var set : ticcmd_set_t?) {
    var cmd : ticcmd_t?
    for (i in urange(uint(NET_MAXPLAYERS))) {
        cmd = addr(set.cmds[0]) + end_index(i, 8)
        cmd.chatchar = 0u8
        if ((int(cmd.buttons) & int(buttoncode_t.BT_SPECIAL)) != 0) {
            cmd.buttons = 0u8
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SinglePlayerClear(var set : ticcmd_set_t?) {
    for (i in urange(uint(NET_MAXPLAYERS))) {
        if (i != uint(doom_all__localplayer)) {
            set.ingame[i] = 0u
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def TryRunTics {
    var i : int
    var lowtic : int
    var entertic : int
    var realtics : int
    var availabletics : int
    var counts : int
    // get real tics
    entertic = I_GetTime() / ticdup
    realtics = entertic - TryRunTics_oldentertics
    TryRunTics_oldentertics = entertic
    // in singletics mode, run a single tic every time this function
    // is called.
    if (singletics != 0) {
        doom_all__BuildNewTic()
    } else {
        NetUpdate()
    }
    lowtic = doom_all__GetLowTic()
    availabletics = lowtic - gametic / ticdup
    // decide how many tics to run
    if (doom_all__new_sync != 0) {
        counts = availabletics
    } else {
        // decide how many tics to run
        if (realtics < availabletics - 1) {
            counts = realtics + 1
        } elif (realtics < availabletics) {
            counts = realtics
        } else {
            counts = availabletics
        }
        if (counts < 1) {
            counts = 1
        }
        if (net_client_connected != 0) {
            doom_all__OldNetSync()
        }
    }
    if (counts < 1) {
        counts = 1
    }
    // wait for new tics if needed
    while (doom_all__PlayersInGame() == 0 || lowtic < gametic / ticdup + counts) {
        NetUpdate()
        lowtic = doom_all__GetLowTic()
        if (lowtic < gametic / ticdup) {
            I_Error`va(cstr("TryRunTics: lowtic < gametic"), VaNone())
        }
        // Don't stay in this loop forever. The menu is still running,
        // so return to update the screen
        if (I_GetTime() / ticdup - entertic > 0) {
            return
        }
        I_Sleep(1)
    }
    // run the count * ticdup dics
    while (true) {
        let _t0 = counts
        counts--
        if (_t0 == 0) {
            break
        }
        var set : ticcmd_set_t?
        if (doom_all__PlayersInGame() == 0) {
            return
        }
        set = addr(doom_all__ticdata[0]) + end_index((gametic / ticdup) % BACKUPTICS, 128)
        if (net_client_connected == 0) {
            doom_all__SinglePlayerClear(set)
        }
        i = 0
        while (i < ticdup) {
            if (gametic / ticdup > lowtic) {
                I_Error`va(cstr("gametic>lowtic"), VaNone())
            }
            crt::memcpy(reinterpret<void?>(addr(doom_all__local_playeringame[0])), reinterpret<void?>(addr(set.ingame[0])),
                    uint64(typeinfo sizeof(type<uint[8]>)))
            invoke(doom_all__loop_interface.RunTic, addr(set.cmds[0]), addr(set.ingame[0]))
            gametic++
            // modify command for duplicated tics
            doom_all__TicdupSquash(set)
            i++
        }
        // check for new console commands
        NetUpdate()
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def D_RegisterLoopCallbacks(var i : loop_interface_t?) {
    doom_all__loop_interface = i
}

// D_ProcessEvents
// Send all the events of the given timestamp down the responder chain
[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_ProcessEvents {
    var ev : event_t?
    // IF STORE DEMO, DO NOT ACCEPT INPUT
    if (storedemo != 0) {
        return
    }
    while (true) {
        ev = D_PopEvent()
        if (!(ev != null)) {
            break
        }
        if (M_Responder(ev) != 0) {
            // menu ate the event
            continue
        }
        G_Responder(ev)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_Display {
    var nowtime : int
    var tics : int
    var wipestart : int
    var y : int
    var done : uint
    var wipe : uint
    var redrawsbar : uint
    if (nodrawers != 0) {
        // for comparative timing / profiling
        return
    }
    redrawsbar = 0u
    // change the view size if needed
    if (setsizeneeded != 0) {
        R_ExecuteSetViewSize()
        // force background redraw
        D_Display_oldgamestate = enum_from_int(type<gamestate_t>, -1)
        D_Display_borderdrawcount = 3
    }
    // save the current screen if about to wipe
    if (gamestate != wipegamestate) {
        wipe = 1u
        wipe_StartScreen(0, 0, SCREENWIDTH, SCREENHEIGHT)
    } else {
        wipe = 0u
    }
    if (gamestate == gamestate_t.GS_LEVEL && gametic != 0) {
        HU_Erase()
    }
    // do buffered drawing
    c_switch(gamestate) {
        case(gamestate_t.GS_LEVEL) {
            if (gametic == 0) {
                break
            }
            if (automapactive != 0) {
                AM_Drawer()
            }
            if (wipe != 0 || (viewheight != 200 && D_Display_fullscreen != 0)) {
                redrawsbar = 1u
            }
            if (D_Display_inhelpscreensstate != 0 && inhelpscreens == 0) {
                // just put away the help screen
                redrawsbar = 1u
            }
            ST_Drawer(uint(int_of(viewheight == 200)), redrawsbar)
            D_Display_fullscreen = uint(int_of(viewheight == 200))
            break
        }
        case(gamestate_t.GS_INTERMISSION) {
            WI_Drawer()
            break
        }
        case(gamestate_t.GS_FINALE) {
            F_Drawer()
            break
        }
        case(gamestate_t.GS_DEMOSCREEN) {
            D_PageDrawer()
            break
        }
    }
    // draw buffered stuff to screen
    I_UpdateNoBlit()
    // draw the view directly
    if (gamestate == gamestate_t.GS_LEVEL && automapactive == 0 && gametic != 0) {
        R_RenderPlayerView(addr(players[0]) + end_index(displayplayer, 4))
    }
    if (gamestate == gamestate_t.GS_LEVEL && gametic != 0) {
        HU_Drawer()
    }
    // clean up border stuff
    if (gamestate != D_Display_oldgamestate && gamestate != gamestate_t.GS_LEVEL) {
        I_SetPalette(reinterpret<uint8?>(W_CacheLumpName(cstr("PLAYPAL"), int(anon_28.PU_CACHE))))
    }
    // see if the border needs to be initially drawn
    if (gamestate == gamestate_t.GS_LEVEL && D_Display_oldgamestate != gamestate_t.GS_LEVEL) {
        // view was not active
        D_Display_viewactivestate = 0u
        // draw the pattern into the back screen
        R_FillBackScreen()
    }
    // see if the border needs to be updated to the screen
    if (gamestate == gamestate_t.GS_LEVEL && automapactive == 0 && scaledviewwidth != 320) {
        if (menuactive != 0 || D_Display_menuactivestate != 0 || D_Display_viewactivestate == 0) {
            D_Display_borderdrawcount = 3
        }
        if (D_Display_borderdrawcount != 0) {
            // erase old menu stuff
            R_DrawViewBorder()
            D_Display_borderdrawcount--
        }
    }
    if (testcontrols != 0) {
        // Box showing current mouse speed
        V_DrawMouseSpeedBox(testcontrols_mousespeed)
    }
    D_Display_menuactivestate = menuactive
    D_Display_viewactivestate = viewactive
    D_Display_inhelpscreensstate = inhelpscreens
    wipegamestate = gamestate
    D_Display_oldgamestate = wipegamestate
    // draw pause pic
    if (paused != 0) {
        if (automapactive != 0) {
            y = 4
        } else {
            y = viewwindowy + 4
        }
        V_DrawPatchDirect(viewwindowx + (scaledviewwidth - 68) / 2, y, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_PAUSE"), int(anon_28.PU_CACHE))))
    }
    // menus go directly to the screen
    // menu is drawn even on top of everything
    M_Drawer()
    // send out any new accumulation
    NetUpdate()
    // normal update
    if (wipe == 0) {
        // page flip or blit buffer
        I_FinishUpdate()
        return
    }
    // wipe update
    wipe_EndScreen(0, 0, SCREENWIDTH, SCREENHEIGHT)
    wipestart = I_GetTime() - 1
    c_do_while(done == 0) {
        c_do_while(tics <= 0) {
            nowtime = I_GetTime()
            tics = nowtime - wipestart
            I_Sleep(1)
        }
        wipestart = nowtime
        done = uint(wipe_ScreenWipe(int(anon_706.wipe_Melt), 0, 0, SCREENWIDTH, SCREENHEIGHT, tics))
        I_UpdateNoBlit()
        // menu is drawn even on top of wipes
        M_Drawer()
        // page flip or blit buffer
        I_FinishUpdate()
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_BindVariables {
    M_ApplyPlatformDefaults()
    I_BindVideoVariables()
    I_BindJoystickVariables()
    I_BindSoundVariables()
    M_BindBaseControls()
    M_BindWeaponControls()
    M_BindMapControls()
    M_BindMenuControls()
    M_BindChatControls(uint(MAXPLAYERS))
    key_multi_msgplayer[0] = HUSTR_KEYGREEN
    key_multi_msgplayer[1] = HUSTR_KEYINDIGO
    key_multi_msgplayer[2] = HUSTR_KEYBROWN
    key_multi_msgplayer[3] = HUSTR_KEYRED
    M_BindVariable(cstr("mouse_sensitivity"), reinterpret<void?>(addr(mouseSensitivity)))
    M_BindVariable(cstr("sfx_volume"), reinterpret<void?>(addr(sfxVolume)))
    M_BindVariable(cstr("music_volume"), reinterpret<void?>(addr(musicVolume)))
    M_BindVariable(cstr("show_messages"), reinterpret<void?>(addr(showMessages)))
    M_BindVariable(cstr("screenblocks"), reinterpret<void?>(addr(screenblocks)))
    M_BindVariable(cstr("detaillevel"), reinterpret<void?>(addr(detailLevel)))
    M_BindVariable(cstr("snd_channels"), reinterpret<void?>(addr(snd_channels)))
    M_BindVariable(cstr("vanilla_savegame_limit"), reinterpret<void?>(addr(vanilla_savegame_limit)))
    M_BindVariable(cstr("vanilla_demo_limit"), reinterpret<void?>(addr(vanilla_demo_limit)))
    M_BindVariable(cstr("show_endoom"), reinterpret<void?>(addr(show_endoom)))
    // Multiplayer chat macros
    for (i in range(10)) {
        var buf : uint8[12]
        M_snprintf`va(addr(buf[0]), uint64(typeinfo sizeof(type<uint8[12]>)), cstr("chatmacro%i"), (i,))
        M_BindVariable(addr(buf[0]), reinterpret<void?>(addr(chat_macros[0]) + end_index(i, 10)))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def D_GrabMouseCallback : uint {
    // Drone players don't need mouse focus
    if (drone != 0) {
        return 0u
    }
    // when menu is active or game is paused, release the mouse
    if (menuactive != 0 || paused != 0) {
        return 0u
    }
    // only grab mouse when playing levels (but not demos)
    return uint(int_of((gamestate == gamestate_t.GS_LEVEL) && demoplayback == 0 && advancedemo == 0))
}

[unsafe_deref, hint(unsafe_range_check)]
def doomgeneric_Tick {
    // frame syncronous IO operations
    I_StartFrame()
    // will run at least one tic
    TryRunTics()
    // move positional sounds
    S_UpdateSounds(players[consoleplayer].mo)
    // Update display, next frame, with current state.
    if (screenvisible != 0) {
        D_Display()
    }
}

// D_DoomLoop
[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_DoomLoop {
    if (bfgedition != 0 && (demorecording != 0 || (gameaction == gameaction_t.ga_playdemo) || netgame != 0)) {
        fprintf(crt::c_stderr(),
                cstr(" WARNING: You are playing using one of the Doom Classic\n IWAD files shipped with the Doom 3: BFG Edition. These are\n known to be incompatible with the regular IWAD files and\n may cause demos and network games to get out of sync.\n"))
    }
    if (demorecording != 0) {
        G_BeginRecording()
    }
    main_loop_started = 1u
    TryRunTics()
    I_SetWindowTitle(gamedescription)
    I_GraphicsCheckCommandLine()
    I_SetGrabMouseCallback(@@D_GrabMouseCallback)
    I_InitGraphics()
    I_EnableLoadingDisk()
    V_RestoreBuffer()
    R_ExecuteSetViewSize()
    D_StartGameLoop()
    if (testcontrols != 0) {
        wipegamestate = gamestate
    }
    doomgeneric_Tick()
}

// D_PageTicker
// Handles timing for warped projection
[unsafe_deref, hint(unsafe_range_check)]
def D_PageTicker {
    pagetic--
    if (pagetic < 0) {
        D_AdvanceDemo()
    }
}

// D_PageDrawer
[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_PageDrawer {
    V_DrawPatch(0, 0, reinterpret<patch_t?>(W_CacheLumpName(pagename, int(anon_28.PU_CACHE))))
}

// D_AdvanceDemo
// Called after each demo or intro demosequence finishes
[unsafe_deref, hint(unsafe_range_check)]
def D_AdvanceDemo {
    advancedemo = 1u
}

// This cycles through the demo sequences.
// FIXME - version dependend demo numbers?
[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_DoAdvanceDemo {
    // not reborn
    players[consoleplayer].playerstate = playerstate_t.PST_LIVE
    advancedemo = 0u
    // no save / end game here
    usergame = 0u
    paused = 0u
    gameaction = gameaction_t.ga_nothing
    // The Ultimate Doom executable changed the demo sequence to add
    // a DEMO4 demo. Final Doom was based on Ultimate, so also
    // includes this change; however, the Final Doom IWADs do not
    // include a DEMO4 lump, so the game bombs out with an error
    // when it reaches this point in the demo sequence.
    // However! There is an alternate version of Final Doom that
    // includes a fixed executable.
    if (gameversion == GameVersion_t.exe_ultimate || gameversion == GameVersion_t.exe_final) {
        demosequence = (demosequence + 1) % 7
    } else {
        demosequence = (demosequence + 1) % 6
    }
    c_switch(demosequence) {
        case(0) {
            if (gamemode == GameMode_t.commercial) {
                pagetic = TICRATE * 11
            } else {
                pagetic = 170
            }
            gamestate = gamestate_t.GS_DEMOSCREEN
            pagename = cstr("TITLEPIC")
            if (gamemode == GameMode_t.commercial) {
                S_StartMusic(int(musicenum_t.mus_dm2ttl))
            } else {
                S_StartMusic(int(musicenum_t.mus_intro))
            }
            break
        }
        case(1) {
            G_DeferedPlayDemo(cstr("demo1"))
            break
        }
        case(2) {
            pagetic = 200
            gamestate = gamestate_t.GS_DEMOSCREEN
            pagename = cstr("CREDIT")
            break
        }
        case(3) {
            G_DeferedPlayDemo(cstr("demo2"))
            break
        }
        case(4) {
            gamestate = gamestate_t.GS_DEMOSCREEN
            if (gamemode == GameMode_t.commercial) {
                pagetic = TICRATE * 11
                pagename = cstr("TITLEPIC")
                S_StartMusic(int(musicenum_t.mus_dm2ttl))
            } else {
                pagetic = 200
                if (gamemode == GameMode_t.retail) {
                    pagename = cstr("CREDIT")
                } else {
                    pagename = cstr("HELP2")
                }
            }
            break
        }
        case(5) {
            G_DeferedPlayDemo(cstr("demo3"))
            break
        }
        case(6) {
            // THE DEFINITIVE DOOM Special Edition demo
            G_DeferedPlayDemo(cstr("demo4"))
            break
        }
    }
    // The Doom 3: BFG Edition version of doom2.wad does not have a
    // TITLETPIC lump. Use INTERPIC instead as a workaround.
    if (bfgedition != 0 && crt::strcasecmp(pagename, cstr("TITLEPIC")) == 0 && W_CheckNumForName(cstr("titlepic")) < 0) {
        pagename = cstr("INTERPIC")
    }
}

// D_StartTitle
[unsafe_deref, hint(unsafe_range_check)]
def D_StartTitle {
    gameaction = gameaction_t.ga_nothing
    demosequence = -1
    D_AdvanceDemo()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GetGameName(var gamename : uint8?) : uint8? {
    var i : uint64
    var deh_sub : uint8?
    i = 0ul
    while (i < uint64(typeinfo sizeof(type<uint8? [7]>)) / uint64(typeinfo sizeof(type<uint8?>))) {
        // Has the banner been replaced?
        deh_sub = doom_all__banners[i]
        if (deh_sub != doom_all__banners[i]) {
            var gamename_size : uint64
            var version : int
            // Has been replaced.
            // We need to expand via printf to include the Doom version number
            // We also need to cut off spaces to get the basic name
            gamename_size = crt::strlen(deh_sub) + 10ul
            gamename = reinterpret<uint8?>(Z_Malloc(int(gamename_size), int(anon_28.PU_STATIC), null))
            version = G_VanillaVersionCode()
            M_snprintf`va(gamename, gamename_size, deh_sub, (version / 100, version % 100))
            while (gamename[0] != '\0' && crt::isspace(int(gamename[0])) != 0) {
                crt::memmove(reinterpret<void?>(gamename), reinterpret<void?>(gamename + 1), gamename_size - 1ul)
            }
            while (gamename[0] != '\0' && crt::isspace(int(gamename[crt::strlen(gamename) - 1ul])) != 0) {
                gamename[crt::strlen(gamename) - 1ul] = uint8('\0')
            }
            return gamename
        }
        i++
    }
    return gamename
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SetMissionForPackName(var pack_name : uint8?) {
    var i : int
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<anon_740[3]>)) / uint64(typeinfo sizeof(type<anon_740>))) {
        if (crt::strcasecmp(pack_name, SetMissionForPackName_packs[i].name) == 0) {
            gamemission = enum_from_int(type<GameMission_t>, SetMissionForPackName_packs[i].mission)
            return
        }
        i++
    }
    fprintf(crt::c_stderr(), cstr("Valid mission packs are:\n"))
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<anon_740[3]>)) / uint64(typeinfo sizeof(type<anon_740>))) {
        fprintf(crt::c_stderr(), cstr("\t%s\n"), SetMissionForPackName_packs[i].name)
        i++
    }
    I_Error`va(cstr("Unknown mission pack name: %s"), (pack_name,))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_IdentifyVersion {
    // gamemission is set up by the D_FindIWAD function. But if
    // we specify '-iwad', we have to identify using
    // IdentifyIWADByName. However, if the iwad does not match
    // any known IWAD name, we may have a dilemma. Try to
    // identify by its contents.
    if (gamemission == GameMission_t.none) {
        for (i in urange(numlumps)) {
            if (crt::strncasecmp(addr(lumpinfo[i].name[0]), cstr("MAP01"), 8ul) == 0) {
                gamemission = GameMission_t.doom2
                break
            } elif (crt::strncasecmp(addr(lumpinfo[i].name[0]), cstr("E1M1"), 8ul) == 0) {
                gamemission = GameMission_t.doom
                break
            }
        }
        if (gamemission == GameMission_t.none) {
            // Still no idea. I don't think this is going to work.
            I_Error`va(cstr("Unknown or invalid IWAD file."), VaNone())
        }
    }
    // Make sure gamemode is set up correctly
    if ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
            uint(GameMission_t.doom)) {
        // Doom 1. But which version?
        if (W_CheckNumForName(cstr("E4M1")) > 0) {
            // Ultimate Doom
            gamemode = GameMode_t.retail
        } elif (W_CheckNumForName(cstr("E3M1")) > 0) {
            gamemode = GameMode_t.registered
        } else {
            gamemode = GameMode_t.shareware
        }
    } else {
        var p : int
        // Doom 2 of some kind.
        gamemode = GameMode_t.commercial
        // We can manually override the gamemission that we got from the
        // IWAD detection code. This allows us to eg. play Plutonia 2
        // with Freedoom and get the right level names.
        // !
        // @arg <pack>
        // Explicitly specify a Doom II "mission pack" to run as, instead of
        // detecting it based on the filename. Valid values are: "doom2",
        // "tnt" and "plutonia".
        p = M_CheckParmWithArgs(cstr("-pack"), 1)
        if (p > 0) {
            doom_all__SetMissionForPackName(myargv[p + 1])
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def D_SetGameDescription {
    let is_freedoom : uint = uint(int_of(W_CheckNumForName(cstr("FREEDOOM")) >= 0))
    let is_freedm : uint = uint(int_of(W_CheckNumForName(cstr("FREEDM")) >= 0))
    gamedescription = cstr("Unknown")
    if ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
            uint(GameMission_t.doom)) {
        // Doom 1. But which version?
        if (is_freedoom != 0) {
            gamedescription = doom_all__GetGameName(cstr("Freedoom: Phase 1"))
        } elif (gamemode == GameMode_t.retail) {
            // Ultimate Doom
            gamedescription = doom_all__GetGameName(cstr("The Ultimate DOOM"))
        } elif (gamemode == GameMode_t.registered) {
            gamedescription = doom_all__GetGameName(cstr("DOOM Registered"))
        } elif (gamemode == GameMode_t.shareware) {
            gamedescription = doom_all__GetGameName(cstr("DOOM Shareware"))
        }
    } else {
        // Doom 2 of some kind. But which mission?
        if (is_freedoom != 0) {
            if (is_freedm != 0) {
                gamedescription = doom_all__GetGameName(cstr("FreeDM"))
            } else {
                gamedescription = doom_all__GetGameName(cstr("Freedoom: Phase 2"))
            }
        } elif ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                    (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
                uint(GameMission_t.doom2)) {
            gamedescription = doom_all__GetGameName(cstr("DOOM 2: Hell on Earth"))
        } elif ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                    (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
                uint(GameMission_t.pack_plut)) {
            gamedescription = doom_all__GetGameName(cstr("DOOM 2: Plutonia Experiment"))
        } elif ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                    (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
                uint(GameMission_t.pack_tnt)) {
            gamedescription = doom_all__GetGameName(cstr("DOOM 2: TNT - Evilution"))
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__D_AddFile(var filename : uint8?) : uint {
    var handle : _wad_file_s?
    fprintf(crt::c_stderr(), cstr(" adding %s\n"), filename)
    handle = W_AddFile(filename)
    return uint(int_of(handle != null))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def PrintDehackedBanners {
    var i : uint64
    i = 0ul
    while (i < uint64(typeinfo sizeof(type<uint8? [3]>)) / uint64(typeinfo sizeof(type<uint8?>))) {
        var deh_s : uint8?
        deh_s = doom_all__copyright_banners[i]
        if (deh_s != doom_all__copyright_banners[i]) {
            fprintf(crt::c_stderr(), cstr("%s"), deh_s)
            // Make sure the modified banner always ends in a newline character.
            // If it doesn't, add a newline. This fixes av.wad.
            if (deh_s[crt::strlen(deh_s) - 1ul] != '\n') {
                fprintf(crt::c_stderr(), cstr("\n"))
            }
        }
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__InitGameVersion {
    var p : int
    var i : int
    // !
    // @arg <version>
    // @category compat
    // Emulate a specific version of Doom. Valid values are "1.9",
    // "ultimate", "final", "final2", "hacx" and "chex".
    p = M_CheckParmWithArgs(cstr("-gameversion"), 1)
    if (p != 0) {
        i = 0
        while (doom_all__gameversions[i].description != null) {
            if (crt::strcmp(myargv[p + 1], doom_all__gameversions[i].cmdline) == 0) {
                gameversion = doom_all__gameversions[i].version
                break
            }
            i++
        }
        if (doom_all__gameversions[i].description == null) {
            fprintf(crt::c_stderr(), cstr("Supported game versions:\n"))
            i = 0
            while (doom_all__gameversions[i].description != null) {
                fprintf(crt::c_stderr(), cstr("\t%s (%s)\n"), doom_all__gameversions[i].cmdline, doom_all__gameversions[i].description)
                i++
            }
            I_Error`va(cstr("Unknown game version '%s'"), (myargv[p + 1],))
        }
    } else {
        // Determine automatically
        if (gamemission == GameMission_t.pack_chex) {
            // chex.exe - identified by iwad filename
            gameversion = GameVersion_t.exe_chex
        } elif (gamemission == GameMission_t.pack_hacx) {
            // hacx.exe: identified by iwad filename
            gameversion = GameVersion_t.exe_hacx
        } elif (gamemode == GameMode_t.shareware || gamemode == GameMode_t.registered) {
            // original
            gameversion = GameVersion_t.exe_doom_1_9
        } elif (gamemode == GameMode_t.retail) {
            // TODO: Detect IWADs earlier than Doom v1.9.
            gameversion = GameVersion_t.exe_ultimate
        } elif (gamemode == GameMode_t.commercial) {
            if (gamemission == GameMission_t.doom2) {
                gameversion = GameVersion_t.exe_doom_1_9
            } else {
                // Final Doom: tnt or plutonia
                // Defaults to emulating the first Final Doom executable,
                // which has the crash in the demo loop; however, having
                // this as the default should mean that it plays back
                // most demos correctly.
                gameversion = GameVersion_t.exe_final
            }
        }
    }
    // The original exe does not support retail - 4th episode not supported
    if (uint(gameversion) < uint(GameVersion_t.exe_ultimate) && gamemode == GameMode_t.retail) {
        gamemode = GameMode_t.registered
    }
    // EXEs prior to the Final Doom exes do not support Final Doom.
    if (uint(gameversion) < uint(GameVersion_t.exe_final) && gamemode == GameMode_t.commercial &&
            (gamemission == GameMission_t.pack_tnt || gamemission == GameMission_t.pack_plut)) {
        gamemission = GameMission_t.doom2
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def PrintGameVersion {
    var i : int
    i = 0
    while (doom_all__gameversions[i].description != null) {
        if (doom_all__gameversions[i].version == gameversion) {
            fprintf(crt::c_stderr(), cstr("Emulating the behavior of the '%s' executable.\n"), doom_all__gameversions[i].description)
            break
        }
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__D_Endoom {
    var endoom : uint8?
    // Don't show ENDOOM if we have it disabled, or we're running
    // in screensaver or control test mode. Only show it once the
    // game has actually started.
    if (show_endoom == 0 || main_loop_started == 0 || screensaver_mode != 0 || M_CheckParm(cstr("-testcontrols")) > 0) {
        return
    }
    endoom = reinterpret<uint8?>(W_CacheLumpName(cstr("ENDOOM"), int(anon_28.PU_STATIC)))
    I_Endoom(endoom)
    c_exit(0)
}

// D_DoomMain
[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_DoomMain {
    var p : int
    var file : uint8[256]
    var demolumpname : uint8[9]
    I_AtExit(@@doom_all__D_Endoom, 0u)
    // print banner
    I_PrintBanner(cstr("Doom Generic 0.1"))
    fprintf(crt::c_stderr(), cstr("Z_Init: Init zone memory allocation daemon. \n"))
    Z_Init()
    // !
    // @category net
    // Start a dedicated server, routing packets but not participating
    // in the game itself.
    // Never returns
    // !
    // @category net
    // Query the Internet master server for a global list of active
    // servers.
    // !
    // @arg <address>
    // @category net
    // Query the status of the server running on the given IP
    // address.
    // !
    // @category net
    // Search the local LAN for running servers.
    // !
    // @vanilla
    // Disable monsters.
    nomonsters = uint(M_CheckParm(cstr("-nomonsters")))
    // !
    // @vanilla
    // Monsters respawn after being killed.
    respawnparm = uint(M_CheckParm(cstr("-respawn")))
    // !
    // @vanilla
    // Monsters move faster.
    fastparm = uint(M_CheckParm(cstr("-fast")))
    // !
    // @vanilla
    // Developer mode. F1 saves a screenshot in the current working
    // directory.
    devparm = uint(M_CheckParm(cstr("-devparm")))
    I_DisplayFPSDots(devparm)
    // !
    // @category net
    // @vanilla
    // Start a deathmatch game.
    if (M_CheckParm(cstr("-deathmatch")) != 0) {
        deathmatch = 1
    }
    // !
    // @category net
    // @vanilla
    // Start a deathmatch 2.0 game. Weapons do not stay in place and
    // all items respawn after 30 seconds.
    if (M_CheckParm(cstr("-altdeath")) != 0) {
        deathmatch = 2
    }
    if (devparm != 0) {
        fprintf(crt::c_stderr(), cstr("Development mode ON.\n"))
    }
    // find which dir to use for config files
    // !
    // @platform windows
    // @vanilla
    // Save configuration data and savegames in c:\doomdata,
    // allowing play from CD.
    // Auto-detect the configuration dir.
    M_SetConfigDir(null)
    // !
    // @arg <x>
    // @vanilla
    // Turbo mode. The player's speed is multiplied by x%. If unspecified,
    // x defaults to 200. Values are rounded up to 10 and down to 400.
    p = M_CheckParm(cstr("-turbo"))
    if (p != 0) {
        var scale : int = 200
        if (p < myargc - 1) {
            scale = crt::atoi(myargv[p + 1])
        }
        if (scale < 10) {
            scale = 10
        }
        if (scale > 400) {
            scale = 400
        }
        fprintf(crt::c_stderr(), cstr("turbo scale: %i%%\n"), scale)
        forwardmove[0] = forwardmove[0] * scale / 100
        forwardmove[1] = forwardmove[1] * scale / 100
        sidemove[0] = sidemove[0] * scale / 100
        sidemove[1] = sidemove[1] * scale / 100
    }
    // init subsystems
    fprintf(crt::c_stderr(), cstr("V_Init: allocate screens.\n"))
    V_Init()
    // Load configuration files before initialising other subsystems.
    fprintf(crt::c_stderr(), cstr("M_LoadDefaults: Load system defaults.\n"))
    M_SetConfigFilenames(cstr("default.cfg"), cstr("doomgenericdoom.cfg"))
    D_BindVariables()
    M_LoadDefaults()
    // Save configuration at exit.
    I_AtExit(@@M_SaveDefaults, 0u)
    // Find main IWAD file and load it.
    iwadfile = D_FindIWAD(IWAD_MASK_DOOM, addr(gamemission))
    // None found?
    if (iwadfile == null) {
        I_Error`va(cstr("Game mode indeterminate.  No IWAD file was found.  Try\nspecifying one with the '-iwad' command line parameter.\n"), VaNone())
    }
    modifiedgame = 0u
    fprintf(crt::c_stderr(), cstr("W_Init: Init WADfiles.\n"))
    doom_all__D_AddFile(iwadfile)
    W_CheckCorrectIWAD(GameMission_t.doom)
    // Now that we've loaded the IWAD, we can figure out what gamemission
    // we're playing and which version of Vanilla Doom we need to emulate.
    D_IdentifyVersion()
    doom_all__InitGameVersion()
    // !
    // @category mod
    // Disable automatic loading of Dehacked patches for certain
    // IWAD files.
    // Some IWADs have dehacked patches that need to be loaded for
    // them to be played properly.
    // Doom 3: BFG Edition includes modified versions of the classic
    // IWADs which can be identified by an additional DMENUPIC lump.
    // Furthermore, the M_GDHIGH lumps have been modified in a way that
    // makes them incompatible to Vanilla Doom and the modified version
    // of doom2.wad is missing the TITLEPIC lump.
    // We specifically check for DMENUPIC here, before PWADs have been
    // loaded which could probably include a lump of that name.
    if (W_CheckNumForName(cstr("dmenupic")) >= 0) {
        fprintf(crt::c_stderr(), cstr("BFG Edition: Using workarounds as needed.\n"))
        bfgedition = 1u
        // BFG Edition changes the names of the secret levels to
        // censor the Wolfenstein references. It also has an extra
        // secret level (MAP33). In Vanilla Doom (meaning the DOS
        // version), MAP33 overflows into the Plutonia level names
        // array, so HUSTR_33 is actually PHUSTR_1.
        // The BFG edition doesn't have the "low detail" menu option (fair
        // enough). But bizarrely, it reuses the M_GDHIGH patch as a label
        // for the options menu (says "Fullscreen:"). Why the perpetrators
        // couldn't just add a new graphic lump and had to reuse this one,
        // I don't know.
        // The end result is that M_GDHIGH is too wide and causes the game
        // to crash. As a workaround to get a minimum level of support for
        // the BFG edition IWADs, use the "ON"/"OFF" graphics instead.
    }
    // Load Dehacked patches specified on the command line with -deh.
    // Note that there's a very careful and deliberate ordering to how
    // Dehacked patches are loaded. The order we use is:
    // 1. IWAD dehacked patches.
    // 2. Command line dehacked patches specified with -deh.
    // 3. PWAD dehacked patches in DEHACKED lumps.
    // Load PWAD files.
    modifiedgame = W_ParseCommandLine()
    // Debug:
    // W_PrintDirectory();
    // !
    // @arg <demo>
    // @category demo
    // @vanilla
    // Play back the demo named demo.lmp.
    p = M_CheckParmWithArgs(cstr("-playdemo"), 1)
    if (p == 0) {
        // !
        // @arg <demo>
        // @category demo
        // @vanilla
        // Play back the demo named demo.lmp, determining the framerate
        // of the screen.
        p = M_CheckParmWithArgs(cstr("-timedemo"), 1)
    }
    if (p != 0) {
        // With Vanilla you have to specify the file without extension,
        // but make that optional.
        if (M_StringEndsWith(myargv[p + 1], cstr(".lmp")) != 0) {
            M_StringCopy(addr(file[0]), myargv[p + 1], uint64(typeinfo sizeof(type<uint8[256]>)))
        } else {
            snprintf(addr(file[0]), uint64(typeinfo sizeof(type<uint8[256]>)), cstr("%s.lmp"), myargv[p + 1])
        }
        if (doom_all__D_AddFile(addr(file[0])) != 0) {
            M_StringCopy(addr(demolumpname[0]), addr(lumpinfo[numlumps - 1u].name[0]), uint64(typeinfo sizeof(type<uint8[9]>)))
        } else {
            // If file failed to load, still continue trying to play
            // the demo in the same way as Vanilla Doom. This makes
            // tricks like "-playdemo demo1" possible.
            M_StringCopy(addr(demolumpname[0]), myargv[p + 1], uint64(typeinfo sizeof(type<uint8[9]>)))
        }
        fprintf(crt::c_stderr(), cstr("Playing demo %s.\n"), addr(file[0]))
    }
    I_AtExit(reinterpret<function<() : void>>(@@G_CheckDemoStatus), 1u)
    // Generate the WAD hash table. Speed things up a bit.
    W_GenerateHashTable()
    // Load DEHACKED lumps from WAD files - but only if we give the right
    // command line parameter.
    // !
    // @category mod
    // Load Dehacked patches from DEHACKED lumps contained in one of the
    // loaded PWAD files.
    // Set the gamedescription string. This is only possible now that
    // we've finished loading Dehacked patches.
    D_SetGameDescription()
    // In -cdrom mode, we write savegames to c:\doomdata as well as configs.
    savegamedir = M_GetSaveGameDir(D_SaveGameIWADName(gamemission))
    // Check for -file in shareware
    if (modifiedgame != 0) {
        // These are the lumps that will be checked in IWAD,
        // if any one is not present, execution will be aborted.
        var name : uint8[23][8] = fixed_array(cstr_array("e2m1", 8), cstr_array("e2m2", 8), cstr_array("e2m3", 8), cstr_array("e2m4", 8), cstr_array("e2m5", 8),
                cstr_array("e2m6", 8), cstr_array("e2m7", 8), cstr_array("e2m8", 8), cstr_array("e2m9", 8), cstr_array("e3m1", 8), cstr_array("e3m3", 8),
                cstr_array("e3m3", 8), cstr_array("e3m4", 8), cstr_array("e3m5", 8), cstr_array("e3m6", 8), cstr_array("e3m7", 8), cstr_array("e3m8", 8),
                cstr_array("e3m9", 8), cstr_array("dphoof", 8), cstr_array("bfgga0", 8), cstr_array("heada1", 8), cstr_array("cybra1", 8),
                cstr_array("spida1d1", 8))
        if (gamemode == GameMode_t.shareware) {
            I_Error`va(cstr("\nYou cannot -file with the shareware version. Register!"), VaNone())
        }
        // Check for fake IWAD with right name,
        // but w/o all the lumps of the registered version.
        if (gamemode == GameMode_t.registered) {
            for (i in range(23)) {
                if (W_CheckNumForName(addr(name[i][0])) < 0) {
                    I_Error`va(cstr("\nThis is not the registered version."), VaNone())
                }
            }
        }
    }
    if (W_CheckNumForName(cstr("SS_START")) >= 0 || W_CheckNumForName(cstr("FF_END")) >= 0) {
        I_PrintDivider()
        fprintf(crt::c_stderr(),
                cstr(" WARNING: The loaded WAD file contains modified sprites or\n floor textures.  You may want to use the '-merge' command\n line option instead of '-file'.\n"))
    }
    I_PrintStartupBanner(gamedescription)
    PrintDehackedBanners()
    // Freedoom's IWADs are Boom-compatible, which means they usually
    // don't work in Vanilla (though FreeDM is okay). Show a warning
    // message and give a link to the website.
    if (W_CheckNumForName(cstr("FREEDOOM")) >= 0 && W_CheckNumForName(cstr("FREEDM")) < 0) {
        fprintf(crt::c_stderr(),
                cstr(" WARNING: You are playing using one of the Freedoom IWAD\n files, which might not work in this port. See this page\n for more information on how to play using Freedoom:\n   http://www.chocolate-doom.org/wiki/index.php/Freedoom\n"))
        I_PrintDivider()
    }
    fprintf(crt::c_stderr(), cstr("I_Init: Setting up machine state.\n"))
    I_CheckIsScreensaver()
    I_InitTimer()
    I_InitJoystick()
    I_InitSound(1u)
    I_InitMusic()
    // Initial netgame startup. Connect to server etc.
    D_ConnectNetGame()
    // get skill / episode / map from parms
    startskill = skill_t.sk_medium
    startepisode = 1
    startmap = 1
    autostart = 0u
    // !
    // @arg <skill>
    // @vanilla
    // Set the game skill, 1-5 (1: easiest, 5: hardest). A skill of
    // 0 disables all monsters.
    p = M_CheckParmWithArgs(cstr("-skill"), 1)
    if (p != 0) {
        startskill = enum_from_int(type<skill_t>, int(myargv[p + 1][0]) - '1')
        autostart = 1u
    }
    // !
    // @arg <n>
    // @vanilla
    // Start playing on episode n (1-4)
    p = M_CheckParmWithArgs(cstr("-episode"), 1)
    if (p != 0) {
        startepisode = int(myargv[p + 1][0]) - '0'
        startmap = 1
        autostart = 1u
    }
    timelimit = 0
    // !
    // @arg <n>
    // @category net
    // @vanilla
    // For multiplayer games: exit each level after n minutes.
    p = M_CheckParmWithArgs(cstr("-timer"), 1)
    if (p != 0) {
        timelimit = crt::atoi(myargv[p + 1])
    }
    // !
    // @category net
    // @vanilla
    // Austin Virtual Gaming: end levels after 20 minutes.
    p = M_CheckParm(cstr("-avg"))
    if (p != 0) {
        timelimit = 20
    }
    // !
    // @arg [<x> <y> | <xy>]
    // @vanilla
    // Start a game immediately, warping to ExMy (Doom 1) or MAPxy
    // (Doom 2)
    p = M_CheckParmWithArgs(cstr("-warp"), 1)
    if (p != 0) {
        if (gamemode == GameMode_t.commercial) {
            startmap = crt::atoi(myargv[p + 1])
        } else {
            startepisode = int(myargv[p + 1][0]) - '0'
            if (p + 2 < myargc) {
                startmap = int(myargv[p + 2][0]) - '0'
            } else {
                startmap = 1
            }
        }
        autostart = 1u
    }
    // Undocumented:
    // Invoked by setup to test the controls.
    p = M_CheckParm(cstr("-testcontrols"))
    if (p > 0) {
        startepisode = 1
        startmap = 1
        autostart = 1u
        testcontrols = 1u
    }
    // Check for load game parameter
    // We do this here and save the slot number, so that the network code
    // can override it or send the load slot to other players.
    // !
    // @arg <s>
    // @vanilla
    // Load the game in slot s.
    p = M_CheckParmWithArgs(cstr("-loadgame"), 1)
    if (p != 0) {
        startloadgame = crt::atoi(myargv[p + 1])
    } else {
        // Not loading a game
        startloadgame = -1
    }
    fprintf(crt::c_stderr(), cstr("M_Init: Init miscellaneous info.\n"))
    M_Init()
    fprintf(crt::c_stderr(), cstr("R_Init: Init DOOM refresh daemon - "))
    R_Init()
    fprintf(crt::c_stderr(), cstr("\nP_Init: Init Playloop state.\n"))
    P_Init()
    fprintf(crt::c_stderr(), cstr("S_Init: Setting up sound.\n"))
    S_Init(sfxVolume * 8, musicVolume * 8)
    fprintf(crt::c_stderr(), cstr("D_CheckNetGame: Checking network game status.\n"))
    D_CheckNetGame()
    PrintGameVersion()
    fprintf(crt::c_stderr(), cstr("HU_Init: Setting up heads up display.\n"))
    HU_Init()
    fprintf(crt::c_stderr(), cstr("ST_Init: Init status bar.\n"))
    ST_Init()
    // If Doom II without a MAP01 lump, this is a store demo.
    // Moved this here so that MAP01 isn't constantly looked up
    // in the main loop.
    if (gamemode == GameMode_t.commercial && W_CheckNumForName(cstr("map01")) < 0) {
        storedemo = 1u
    }
    if (M_CheckParmWithArgs(cstr("-statdump"), 1) != 0) {
        I_AtExit(@@StatDump, 1u)
        fprintf(crt::c_stderr(), cstr("External statistics registered.\n"))
    }
    // !
    // @arg <x>
    // @category demo
    // @vanilla
    // Record a demo named x.lmp.
    p = M_CheckParmWithArgs(cstr("-record"), 1)
    if (p != 0) {
        G_RecordDemo(myargv[p + 1])
        autostart = 1u
    }
    p = M_CheckParmWithArgs(cstr("-playdemo"), 1)
    if (p != 0) {
        // quit after one demo
        singledemo = 1u
        G_DeferedPlayDemo(addr(demolumpname[0]))
        D_DoomLoop()
        return
    }
    p = M_CheckParmWithArgs(cstr("-timedemo"), 1)
    if (p != 0) {
        G_TimeDemo(addr(demolumpname[0]))
        D_DoomLoop()
        return
    }
    if (startloadgame >= 0) {
        M_StringCopy(addr(file[0]), P_SaveGameFile(startloadgame), uint64(typeinfo sizeof(type<uint8[256]>)))
        G_LoadGame(addr(file[0]))
    }
    if (gameaction != gameaction_t.ga_loadgame) {
        if (autostart != 0 || netgame != 0) {
            G_InitNew(startskill, startepisode, startmap)
        } else {
            // start up intro loop
            D_StartTitle()
        }
    }
    D_DoomLoop()
}

[unsafe_deref, hint(unsafe_range_check)]
def D_ValidGameMode(mission : GameMission_t; mode : GameMode_t) : uint {
    var i : int
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<anon_781[13]>)) / uint64(typeinfo sizeof(type<anon_781>))) {
        if (doom_all__valid_modes[i].mode == mode && doom_all__valid_modes[i].mission == mission) {
            return 1u
        }
        i++
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def D_ValidEpisodeMap(mission : GameMission_t; mode : GameMode_t; episode : int; map : int) : uint {
    var i : int
    // Hacks for Heretic secret episodes
    if (mission == GameMission_t.heretic) {
        if (mode == GameMode_t.retail && episode == 6) {
            return uint(int_of(map >= 1 && map <= 3))
        } elif (mode == GameMode_t.registered && episode == 4) {
            return uint(int_of(map == 1))
        }
    }
    // Find the table entry for this mission/mode combination.
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<anon_781[13]>)) / uint64(typeinfo sizeof(type<anon_781>))) {
        if (mission == doom_all__valid_modes[i].mission && mode == doom_all__valid_modes[i].mode) {
            return uint(int_of(episode >= 1 && episode <= doom_all__valid_modes[i].episode && map >= 1 && map <= doom_all__valid_modes[i].map))
        }
        i++
    }
    // Unknown mode/mission combination
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def D_GetNumEpisodes(mission : GameMission_t; mode : GameMode_t) : int {
    var episode : int
    episode = 1
    while (D_ValidEpisodeMap(mission, mode, episode, 1) != 0) {
        episode++
    }
    return episode - 1
}

[unsafe_deref, hint(unsafe_range_check)]
def D_ValidGameVersion(var mission : GameMission_t; version : GameVersion_t) : uint {
    var i : int
    // All Doom variants can use the Doom versions.
    if (mission == GameMission_t.doom2 || mission == GameMission_t.pack_plut || mission == GameMission_t.pack_tnt || mission == GameMission_t.pack_hacx ||
            mission == GameMission_t.pack_chex) {
        mission = GameMission_t.doom
    }
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<anon_785[10]>)) / uint64(typeinfo sizeof(type<anon_785>))) {
        if (doom_all__valid_versions[i].mission == mission && doom_all__valid_versions[i].version == version) {
            return 1u
        }
        i++
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def D_IsEpisodeMap(mission : GameMission_t) : uint {
    c_switch(mission) {
        case(GameMission_t.doom, GameMission_t.heretic, GameMission_t.pack_chex) {
            return 1u
        }
        case(GameMission_t.none, GameMission_t.hexen, GameMission_t.doom2, GameMission_t.pack_hacx, GameMission_t.pack_tnt, GameMission_t.pack_plut, GameMission_t.strife, _) {
            return 0u
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def D_GameMissionString(mission : GameMission_t) : uint8? {
    c_switch(mission) {
        case(GameMission_t.none, _) {
            return cstr("none")
        }
        case(GameMission_t.doom) {
            return cstr("doom")
        }
        case(GameMission_t.doom2) {
            return cstr("doom2")
        }
        case(GameMission_t.pack_tnt) {
            return cstr("tnt")
        }
        case(GameMission_t.pack_plut) {
            return cstr("plutonia")
        }
        case(GameMission_t.pack_hacx) {
            return cstr("hacx")
        }
        case(GameMission_t.pack_chex) {
            return cstr("chex")
        }
        case(GameMission_t.heretic) {
            return cstr("heretic")
        }
        case(GameMission_t.hexen) {
            return cstr("hexen")
        }
        case(GameMission_t.strife) {
            return cstr("strife")
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__PlayerQuitGame(var player : player_s?) {
    var player_num : uint
    player_num = uint(int64(player - addr(players[0])))
    // Do this the same way as Vanilla Doom does, to allow dehacked
    // replacements of this message
    M_StringCopy(addr(PlayerQuitGame_exitmsg[0]), cstr("Player 1 left the game"), uint64(typeinfo sizeof(type<uint8[80]>)))
    PlayerQuitGame_exitmsg[7] = uint8(uint(PlayerQuitGame_exitmsg[7]) + player_num)
    playeringame[player_num] = 0u
    players[consoleplayer].message = addr(PlayerQuitGame_exitmsg[0])
    // TODO: check if it is sensible to do this:
    if (demorecording != 0) {
        G_CheckDemoStatus()
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__RunTic(var cmds : ticcmd_t?; var ingame : uint?) {
    // Check for player quits.
    for (i in urange(uint(MAXPLAYERS))) {
        if (demoplayback == 0 && playeringame[i] != 0 && ingame[i] == 0) {
            doom_all__PlayerQuitGame(addr(players[0]) + end_index(i, 4))
        }
    }
    netcmds = cmds
    // check that there are players in the game. if not, we cannot
    // run a tic.
    if (advancedemo != 0) {
        D_DoAdvanceDemo()
    }
    G_Ticker()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__LoadGameSettings(var settings : net_gamesettings_t?) {
    deathmatch = settings.deathmatch
    startepisode = settings.episode
    startmap = settings.map
    startskill = enum_from_int(type<skill_t>, settings.skill)
    startloadgame = settings.loadgame
    lowres_turn = uint(settings.lowres_turn)
    nomonsters = uint(settings.nomonsters)
    fastparm = uint(settings.fast_monsters)
    respawnparm = uint(settings.respawn_monsters)
    timelimit = settings.timelimit
    consoleplayer = settings.consoleplayer
    if (lowres_turn != 0) {
        fprintf(crt::c_stderr(), cstr("NOTE: Turning resolution is reduced; this is probably because there is a client recording a Vanilla demo.\n"))
    }
    for (i in urange(uint(MAXPLAYERS))) {
        playeringame[i] = uint(int_of(i < uint(settings.num_players)))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SaveGameSettings(var settings : net_gamesettings_t?) {
    // Fill in game settings structure with appropriate parameters
    // for the new game
    settings.deathmatch = deathmatch
    settings.episode = startepisode
    settings.map = startmap
    settings.skill = int(startskill)
    settings.loadgame = startloadgame
    settings.gameversion = int(gameversion)
    settings.nomonsters = int(nomonsters)
    settings.fast_monsters = int(fastparm)
    settings.respawn_monsters = int(respawnparm)
    settings.timelimit = timelimit
    settings.lowres_turn = int_of(M_CheckParm(cstr("-record")) > 0 && M_CheckParm(cstr("-longtics")) == 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__InitConnectData(var connect_data : net_connect_data_t?) {
    connect_data.max_players = MAXPLAYERS
    connect_data.drone = 0
    // !
    // @category net
    // Run as the left screen in three screen mode.
    if (M_CheckParm(cstr("-left")) > 0) {
        viewangleoffset = ANG90
        connect_data.drone = 1
    }
    // !
    // @category net
    // Run as the right screen in three screen mode.
    if (M_CheckParm(cstr("-right")) > 0) {
        viewangleoffset = int(ANG270)
        connect_data.drone = 1
    }
    // Connect data
    // Game type fields:
    connect_data.gamemode = int(gamemode)
    connect_data.gamemission = int(gamemission)
    // Are we recording a demo? Possibly set lowres turn mode
    connect_data.lowres_turn = int_of(M_CheckParm(cstr("-record")) > 0 && M_CheckParm(cstr("-longtics")) == 0)
    // Read checksums of our WAD directory and dehacked information
    W_Checksum(addr(connect_data.wad_sha1sum[0]))
    // Are we playing with the Freedoom IWAD?
    connect_data.is_freedoom = int_of(W_CheckNumForName(cstr("FREEDOOM")) >= 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_ConnectNetGame {
    var connect_data : net_connect_data_t
    doom_all__InitConnectData(addr(connect_data))
    netgame = D_InitNetGame(addr(connect_data))
    // !
    // @category net
    // Start the game playing as though in a netgame with a single
    // player. This can also be used to play back single player netgame
    // demos.
    if (M_CheckParm(cstr("-solo-net")) > 0) {
        netgame = 1u
    }
}

// D_CheckNetGame
// Works out player numbers among the net participants
[c_function, unsafe_deref, hint(unsafe_range_check)]
def D_CheckNetGame {
    var settings : net_gamesettings_t
    if (netgame != 0) {
        autostart = 1u
    }
    D_RegisterLoopCallbacks(addr(doom_all__doom_loop_interface))
    doom_all__SaveGameSettings(addr(settings))
    D_StartNetGame(addr(settings), default<function<(a0 : int; a1 : int) : uint>>)
    doom_all__LoadGameSettings(addr(settings))
    fprintf(crt::c_stderr(), cstr("startskill %i  deathmatch: %i  startmap: %i  startepisode: %i\n"), int(startskill), deathmatch, startmap, startepisode)
    fprintf(crt::c_stderr(), cstr("player %i of %i (%i nodes)\n"), consoleplayer + 1, settings.num_players, settings.num_players)
    // Show players here; the server might have specified a time limit
    if (timelimit > 0 && deathmatch != 0) {
        // Gross hack to work like Vanilla:
        if (timelimit == 20 && M_CheckParm(cstr("-avg")) != 0) {
            fprintf(crt::c_stderr(), cstr("Austin Virtual Gaming: Levels will end after 20 minutes\n"))
        } else {
            fprintf(crt::c_stderr(), cstr("Levels will end after %d minute"), timelimit)
            if (timelimit > 1) {
                fprintf(crt::c_stderr(), cstr("s"))
            }
            fprintf(crt::c_stderr(), cstr(".\n"))
        }
    }
}

// F_StartFinale
[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_StartFinale {
    var i : uint64
    gameaction = gameaction_t.ga_nothing
    gamestate = gamestate_t.GS_FINALE
    viewactive = 0u
    automapactive = 0u
    if ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
            uint(GameMission_t.doom)) {
        S_ChangeMusic(int(musicenum_t.mus_victor), 1)
    } else {
        S_ChangeMusic(int(musicenum_t.mus_read_m), 1)
    }
    // Find the right screen and set the text and background
    i = 0ul
    while (i < uint64(typeinfo sizeof(type<textscreen_t[22]>)) / uint64(typeinfo sizeof(type<textscreen_t>))) {
        var screen : textscreen_t? = addr(doom_all__textscreens[0]) + end_index(i, 22)
        // Hack for Chex Quest
        if (gameversion == GameVersion_t.exe_chex && screen.mission == GameMission_t.doom) {
            screen.level = 5
        }
        if ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                        (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
                    uint(screen.mission) &&
                ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                            (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) !=
                        uint(GameMission_t.doom) ||
                    gameepisode == screen.episode) &&
                gamemap == screen.level) {
            finaletext = screen.text
            finaleflat = screen.background
        }
        i++
    }
    // Do dehacked substitutions of strings
    finaletext = finaletext
    finaleflat = finaleflat
    finalestage = finalestage_t.F_STAGE_TEXT
    finalecount = 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def F_Responder(var event : event_t?) : uint {
    if (finalestage == finalestage_t.F_STAGE_CAST) {
        return F_CastResponder(event)
    }
    return 0u
}

// F_Ticker
[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_Ticker {
    var i : uint64
    // check for skipping
    if ((gamemode == GameMode_t.commercial) && (finalecount > 50u)) {
        // go on to the next level
        i = 0ul
        while (i < uint64(MAXPLAYERS)) {
            if (players[i].cmd.buttons != 0) {
                break
            }
            i++
        }
        if (i < uint64(MAXPLAYERS)) {
            if (gamemap == 30) {
                F_StartCast()
            } else {
                gameaction = gameaction_t.ga_worlddone
            }
        }
    }
    // advance animation
    finalecount++
    if (finalestage == finalestage_t.F_STAGE_CAST) {
        F_CastTicker()
        return
    }
    if (gamemode == GameMode_t.commercial) {
        return
    }
    if (finalestage == finalestage_t.F_STAGE_TEXT && uint64(finalecount) > crt::strlen(finaletext) * uint64(TEXTSPEED) + uint64(TEXTWAIT)) {
        finalecount = 0u
        finalestage = finalestage_t.F_STAGE_ARTSCREEN
        // force a wipe
        wipegamestate = enum_from_int(type<gamestate_t>, -1)
        if (gameepisode == 3) {
            S_StartMusic(int(musicenum_t.mus_bunny))
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_TextWrite {
    var src : uint8?
    var dest : uint8?
    var x : int
    var w : int
    var count : int
    var ch : uint8?
    var c : int
    var cx : int
    var cy : int
    // erase the entire screen to a tiled background
    src = reinterpret<uint8?>(W_CacheLumpName(finaleflat, int(anon_28.PU_CACHE)))
    dest = I_VideoBuffer
    for (y in range(SCREENHEIGHT)) {
        x = 0
        while (x < SCREENWIDTH / 64) {
            crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(src + ((y & 63) << 6)), 64ul)
            dest += 64
            x++
        }
        if ((SCREENWIDTH & 63) != 0) {
            crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(src + ((y & 63) << 6)), uint64(SCREENWIDTH & 63))
            dest += SCREENWIDTH & 63
        }
    }
    V_MarkRect(0, 0, SCREENWIDTH, SCREENHEIGHT)
    // draw some of the text onto the screen
    cx = 10
    cy = 10
    ch = finaletext
    count = (int(finalecount) - 10) / TEXTSPEED
    if (count < 0) {
        count = 0
    }
    {
        var _f = false
        while (true) {
            if (_f) {
                count--
            }
            _f = true
            if (count == 0) {
                break
            }
            var _t0 = ch
            ch++
            c = int(*_t0)
            if (c == 0) {
                break
            }
            if (c == '\n') {
                cx = 10
                cy += 11
                continue
            }
            c = crt::toupper(c) - HU_FONTSTART
            if (c < 0 || c > HU_FONTSIZE) {
                cx += 4
                continue
            }
            w = int(hu_font[c].width)
            if (cx + w > SCREENWIDTH) {
                break
            }
            V_DrawPatch(cx, cy, hu_font[c])
            cx += w
        }
    }
}

// F_StartCast
[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_StartCast {
    // force a screen wipe
    wipegamestate = enum_from_int(type<gamestate_t>, -1)
    castnum = 0
    caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].seestate, 967)
    casttics = caststate.tics
    castdeath = 0u
    finalestage = finalestage_t.F_STAGE_CAST
    castframes = 0
    castonmelee = 0
    castattacking = 0u
    S_ChangeMusic(int(musicenum_t.mus_evil), 1)
}

// F_CastTicker
[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_CastTicker {
    var st : int
    var sfx : int
    casttics--
    if (casttics > 0) {
        // not time to change state yet
        return
    }
    if (caststate.tics == -1 || caststate.nextstate == statenum_t.S_NULL) {
        // switch from deathstate to next monster
        castnum++
        castdeath = 0u
        if (castorder[castnum].name == null) {
            castnum = 0
        }
        if (mobjinfo[int(castorder[castnum]._c_type)].seesound != 0) {
            S_StartSound(null, mobjinfo[int(castorder[castnum]._c_type)].seesound)
        }
        caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].seestate, 967)
        castframes = 0
    } else {
        // just advance to next state in animation
        if (caststate == addr(states[int(statenum_t.S_PLAY_ATK1)])) {
            // Oh, gross hack!
            goto label 1
        }
        st = int(caststate.nextstate)
        caststate = addr(states[0]) + end_index(st, 967)
        castframes++
        // sound hacks....
        c_switch(st) {
            case(154) {
                sfx = int(sfxenum_t.sfx_dshtgn)
                break
            }
            case(185) {
                sfx = int(sfxenum_t.sfx_pistol)
                break
            }
            case(218) {
                sfx = int(sfxenum_t.sfx_shotgn)
                break
            }
            case(256) {
                sfx = int(sfxenum_t.sfx_vilatk)
                break
            }
            case(336) {
                sfx = int(sfxenum_t.sfx_skeswg)
                break
            }
            case(338) {
                sfx = int(sfxenum_t.sfx_skepch)
                break
            }
            case(340) {
                sfx = int(sfxenum_t.sfx_skeatk)
                break
            }
            case(383, 380, 377) {
                sfx = int(sfxenum_t.sfx_firsht)
                break
            }
            case(417, 418, 419) {
                sfx = int(sfxenum_t.sfx_shotgn)
                break
            }
            case(454) {
                sfx = int(sfxenum_t.sfx_claw)
                break
            }
            case(486) {
                sfx = int(sfxenum_t.sfx_sgtatk)
                break
            }
            case(538, 567, 505) {
                sfx = int(sfxenum_t.sfx_firsht)
                break
            }
            case(590) {
                sfx = int(sfxenum_t.sfx_sklatk)
                break
            }
            case(616, 617) {
                sfx = int(sfxenum_t.sfx_shotgn)
                break
            }
            case(648) {
                sfx = int(sfxenum_t.sfx_plasma)
                break
            }
            case(685, 687, 689) {
                sfx = int(sfxenum_t.sfx_rlaunc)
                break
            }
            case(710) {
                sfx = int(sfxenum_t.sfx_sklatk)
                break
            }
            case(_) {
                sfx = 0
                break
            }
        }
        if (sfx != 0) {
            S_StartSound(null, sfx)
        }
    }
    if (castframes == 12) {
        // go into attack frame
        castattacking = 1u
        if (castonmelee != 0) {
            caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].meleestate, 967)
        } else {
            caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].missilestate, 967)
        }
        castonmelee ^= 1
        if (caststate == addr(states[int(statenum_t.S_NULL)])) {
            if (castonmelee != 0) {
                caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].meleestate, 967)
            } else {
                caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].missilestate, 967)
            }
        }
    }
    if (castattacking == 0) {
        goto label 2
    }
    if (!(castframes == 24 || caststate == addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].seestate, 967))) {
        goto label 3
    }
    label 1:  // stopattack
    castattacking = 0u
    castframes = 0
    caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].seestate, 967)
    label 3:  // end if
    label 2:  // end if
    casttics = caststate.tics
    if (casttics == -1) {
        casttics = 15
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_CastResponder(var ev : event_t?) : uint {
    if (ev._c_type != evtype_t.ev_keydown) {
        return 0u
    }
    if (castdeath != 0) {
        // already in dying frames
        return 1u
    }
    // go into death frame
    castdeath = 1u
    caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].deathstate, 967)
    casttics = caststate.tics
    castframes = 0
    castattacking = 0u
    if (mobjinfo[int(castorder[castnum]._c_type)].deathsound != 0) {
        S_StartSound(null, mobjinfo[int(castorder[castnum]._c_type)].deathsound)
    }
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_CastPrint(var text : uint8?) {
    var ch : uint8?
    var c : int
    var cx : int
    var w : int
    var width : int
    // find width
    ch = text
    width = 0
    while (ch != null) {
        var _t0 = ch
        ch++
        c = int(*_t0)
        if (c == 0) {
            break
        }
        c = crt::toupper(c) - HU_FONTSTART
        if (c < 0 || c > HU_FONTSIZE) {
            width += 4
            continue
        }
        w = int(hu_font[c].width)
        width += w
    }
    // draw it
    cx = 160 - width / 2
    ch = text
    while (ch != null) {
        var _t1 = ch
        ch++
        c = int(*_t1)
        if (c == 0) {
            break
        }
        c = crt::toupper(c) - HU_FONTSTART
        if (c < 0 || c > HU_FONTSIZE) {
            cx += 4
            continue
        }
        w = int(hu_font[c].width)
        V_DrawPatch(cx, 180, hu_font[c])
        cx += w
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_CastDrawer {
    var sprdef : spritedef_t?
    var sprframe : spriteframe_t?
    var lump : int
    var flip : uint
    var patch : patch_t?
    // erase the entire screen to a background
    V_DrawPatch(0, 0, reinterpret<patch_t?>(W_CacheLumpName(cstr("BOSSBACK"), int(anon_28.PU_CACHE))))
    F_CastPrint(castorder[castnum].name)
    // draw the current frame in the middle of the screen
    sprdef = addr(sprites[int(caststate.sprite)])
    sprframe = addr(sprdef.spriteframes[caststate.frame & FF_FRAMEMASK])
    lump = int(sprframe.lump[0])
    flip = uint(sprframe.flip[0])
    patch = reinterpret<patch_t?>(W_CacheLumpNum(lump + firstspritelump, int(anon_28.PU_CACHE)))
    if (flip != 0) {
        V_DrawPatchFlipped(160, 170, patch)
    } else {
        V_DrawPatch(160, 170, patch)
    }
}

// F_DrawPatchCol
[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_DrawPatchCol(x : int; var patch : patch_t?; col : int) {
    var column : post_t?
    var source : uint8?
    var dest : uint8?
    var desttop : uint8?
    var count : int
    column = reinterpret<post_t?>(reinterpret<uint8?>(patch) + addr(patch.columnofs[0])[col])
    desttop = I_VideoBuffer + x
    // step through the posts in a column
    while (column.topdelta != 255) {
        source = reinterpret<uint8?>(column) + 3
        dest = desttop + int(column.topdelta) * SCREENWIDTH
        count = int(column.length)
        while (true) {
            let _t0 = count
            count--
            if (_t0 == 0) {
                break
            }
            var _t1 = source
            source++
            *dest = *_t1
            dest += SCREENWIDTH
        }
        column = reinterpret<post_t?>(reinterpret<uint8?>(column) + int(column.length) + 4)
    }
}

// F_BunnyScroll
[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_BunnyScroll {
    var scrolled : int
    var p1 : patch_t?
    var p2 : patch_t?
    var name : uint8[10]
    var stage : int
    p1 = reinterpret<patch_t?>(W_CacheLumpName(cstr("PFUB2"), int(anon_28.PU_LEVEL)))
    p2 = reinterpret<patch_t?>(W_CacheLumpName(cstr("PFUB1"), int(anon_28.PU_LEVEL)))
    V_MarkRect(0, 0, SCREENWIDTH, SCREENHEIGHT)
    scrolled = 320 - (int(finalecount) - 230) / 2
    if (scrolled > 320) {
        scrolled = 320
    }
    if (scrolled < 0) {
        scrolled = 0
    }
    for (x in range(SCREENWIDTH)) {
        if (x + scrolled < 320) {
            F_DrawPatchCol(x, p1, x + scrolled)
        } else {
            F_DrawPatchCol(x, p2, x + scrolled - 320)
        }
    }
    if (finalecount < 1130u) {
        return
    }
    if (finalecount < 1180u) {
        V_DrawPatch((SCREENWIDTH - 13 * 8) / 2, (SCREENHEIGHT - 8 * 8) / 2, reinterpret<patch_t?>(W_CacheLumpName(cstr("END0"), int(anon_28.PU_CACHE))))
        F_BunnyScroll_laststage = 0
        return
    }
    stage = int((finalecount - 1180u) / 5u)
    if (stage > 6) {
        stage = 6
    }
    if (stage > F_BunnyScroll_laststage) {
        S_StartSound(null, int(sfxenum_t.sfx_pistol))
        F_BunnyScroll_laststage = stage
    }
    snprintf(addr(name[0]), 10ul, cstr("END%i"), stage)
    V_DrawPatch((SCREENWIDTH - 13 * 8) / 2, (SCREENHEIGHT - 8 * 8) / 2, reinterpret<patch_t?>(W_CacheLumpName(addr(name[0]), int(anon_28.PU_CACHE))))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__F_ArtScreenDrawer {
    var lumpname : uint8?
    if (gameepisode == 3) {
        F_BunnyScroll()
    } else {
        c_switch(gameepisode) {
            case(1) {
                if (gamemode == GameMode_t.retail) {
                    lumpname = cstr("CREDIT")
                } else {
                    lumpname = cstr("HELP2")
                }
                break
            }
            case(2) {
                lumpname = cstr("VICTORY2")
                break
            }
            case(4) {
                lumpname = cstr("ENDPIC")
                break
            }
            case(_) {
                return
            }
        }
        lumpname = lumpname
        V_DrawPatch(0, 0, reinterpret<patch_t?>(W_CacheLumpName(lumpname, int(anon_28.PU_CACHE))))
    }
}

// F_Drawer
[unsafe_deref, hint(unsafe_range_check)]
def F_Drawer {
    c_switch(finalestage) {
        case(finalestage_t.F_STAGE_CAST) {
            F_CastDrawer()
            break
        }
        case(finalestage_t.F_STAGE_TEXT) {
            F_TextWrite()
            break
        }
        case(finalestage_t.F_STAGE_ARTSCREEN) {
            doom_all__F_ArtScreenDrawer()
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_shittyColMajorXform(var _c_array : int16?; width : int; height : int) {
    var dest : int16?
    dest = reinterpret<int16?>(Z_Malloc(width * height * 2, int(anon_28.PU_STATIC), null))
    for (y in range(height)) {
        for (x in range(width)) {
            dest[x * height + y] = _c_array[y * width + x]
        }
    }
    crt::memcpy(reinterpret<void?>(_c_array), reinterpret<void?>(dest), uint64(width * height * 2))
    Z_Free(reinterpret<void?>(dest))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_initColorXForm(width : int; height : int; ticks : int) : int {
    crt::memcpy(reinterpret<void?>(doom_all__wipe_scr), reinterpret<void?>(doom_all__wipe_scr_start), uint64(width * height))
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_doColorXForm(width : int; height : int; ticks : int) : int {
    var changed : uint
    var w : uint8?
    var e : uint8?
    var newval : int
    changed = 0u
    w = doom_all__wipe_scr
    e = doom_all__wipe_scr_end
    while (w != doom_all__wipe_scr + width * height) {
        if (*w != *e) {
            if (int(*w) > int(*e)) {
                newval = int(*w) - ticks
                if (newval < int(*e)) {
                    *w = *e
                } else {
                    *w = uint8(newval)
                }
                changed = 1u
            } elif (int(*w) < int(*e)) {
                newval = int(*w) + ticks
                if (newval > int(*e)) {
                    *w = *e
                } else {
                    *w = uint8(newval)
                }
                changed = 1u
            }
        }
        w++
        e++
    }
    return int_of(changed == 0)
}

[unsafe_deref, hint(unsafe_range_check)]
def wipe_exitColorXForm(width : int; height : int; ticks : int) : int {
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_initMelt(width : int; height : int; ticks : int) : int {
    var r : int
    // copy start screen to main screen
    crt::memcpy(reinterpret<void?>(doom_all__wipe_scr), reinterpret<void?>(doom_all__wipe_scr_start), uint64(width * height))
    // makes this wipe faster (in theory)
    // to have stuff in column-major format
    wipe_shittyColMajorXform(reinterpret<int16?>(doom_all__wipe_scr_start), width / 2, height)
    wipe_shittyColMajorXform(reinterpret<int16?>(doom_all__wipe_scr_end), width / 2, height)
    // setup initial column positions
    // (y<0 => not ready to scroll yet)
    doom_all__y = reinterpret<int?>(Z_Malloc(int(uint64(width) * uint64(typeinfo sizeof(type<int>))), int(anon_28.PU_STATIC), null))
    doom_all__y[0] = -(M_Random() % 16)
    for (i in range(1, width)) {
        r = (M_Random() % 3) - 1
        doom_all__y[i] = doom_all__y[i - 1] + r
        if (doom_all__y[i] > 0) {
            doom_all__y[i] = 0
        } elif (doom_all__y[i] == -16) {
            doom_all__y[i] = -15
        }
    }
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_doMelt(var width : int; height : int; var ticks : int) : int {
    var j : int
    var dy : int
    var idx : int
    var s : int16?
    var d : int16?
    var done : uint = 1u
    width /= 2
    while (true) {
        let _t0 = ticks
        ticks--
        if (_t0 == 0) {
            break
        }
        for (i in range(width)) {
            if (doom_all__y[i] < 0) {
                doom_all__y[i]++
                done = 0u
            } elif (doom_all__y[i] < height) {
                dy = (doom_all__y[i] < 16) ? doom_all__y[i] + 1 : 8
                if (doom_all__y[i] + dy >= height) {
                    dy = height - doom_all__y[i]
                }
                s = addr(reinterpret<int16?>(doom_all__wipe_scr_end)[i * height + doom_all__y[i]])
                d = addr(reinterpret<int16?>(doom_all__wipe_scr)[doom_all__y[i] * width + i])
                idx = 0
                j = dy
                while (j != 0) {
                    var _t1 = s
                    s++
                    d[idx] = *_t1
                    idx += width
                    j--
                }
                doom_all__y[i] += dy
                s = addr(reinterpret<int16?>(doom_all__wipe_scr_start)[i * height])
                d = addr(reinterpret<int16?>(doom_all__wipe_scr)[doom_all__y[i] * width + i])
                idx = 0
                j = height - doom_all__y[i]
                while (j != 0) {
                    var _t2 = s
                    s++
                    d[idx] = *_t2
                    idx += width
                    j--
                }
                done = 0u
            }
        }
    }
    return int(done)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_exitMelt(width : int; height : int; ticks : int) : int {
    Z_Free(reinterpret<void?>(doom_all__y))
    Z_Free(reinterpret<void?>(doom_all__wipe_scr_start))
    Z_Free(reinterpret<void?>(doom_all__wipe_scr_end))
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_StartScreen(x : int; y : int; width : int; height : int) : int {
    doom_all__wipe_scr_start = reinterpret<uint8?>(Z_Malloc(SCREENWIDTH * SCREENHEIGHT, int(anon_28.PU_STATIC), null))
    I_ReadScreen(doom_all__wipe_scr_start)
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def wipe_EndScreen(x : int; y : int; width : int; height : int) : int {
    doom_all__wipe_scr_end = reinterpret<uint8?>(Z_Malloc(SCREENWIDTH * SCREENHEIGHT, int(anon_28.PU_STATIC), null))
    I_ReadScreen(doom_all__wipe_scr_end)
    // restore start scr.
    V_DrawBlock(x, y, width, height, doom_all__wipe_scr_start)
    return 0
}

[unsafe_deref, hint(unsafe_range_check)]
def wipe_ScreenWipe(wipeno : int; x : int; y : int; width : int; height : int; ticks : int) : int {
    var rc : int
    // initial stuff
    if (doom_all__go == 0) {
        doom_all__go = 1u
        // wipe_scr = (byte *) Z_Malloc(width*height, PU_STATIC, 0); // DEBUG
        doom_all__wipe_scr = I_VideoBuffer
        invoke(wipe_ScreenWipe_wipes[wipeno * 3], width, height, ticks)
    }
    // do a piece of wipe-in
    V_MarkRect(0, 0, width, height)
    rc = invoke(wipe_ScreenWipe_wipes[wipeno * 3 + 1], width, height, ticks)
    // V_DrawBlock(x, y, 0, width, height, wipe_scr); // DEBUG
    // final stuff
    if (rc != 0) {
        doom_all__go = 0u
        invoke(wipe_ScreenWipe_wipes[wipeno * 3 + 2], width, height, ticks)
    }
    return int_of(doom_all__go == 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_CmdChecksum(var cmd : ticcmd_t?) : int {
    var i : uint64
    var sum : int = 0
    i = 0ul
    while (i < uint64(typeinfo sizeof(type<ticcmd_t>)) / 4ul - 1ul) {
        sum += reinterpret<int?>(cmd)[i]
        i++
    }
    return sum
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__WeaponSelectable(weapon : weapontype_t) : uint {
    // Can't select the super shotgun in Doom 1.
    if (weapon == weapontype_t.wp_supershotgun &&
            (gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                    (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
                uint(GameMission_t.doom)) {
        return 0u
    }
    // These weapons aren't available in shareware.
    if ((weapon == weapontype_t.wp_plasma || weapon == weapontype_t.wp_bfg) && gamemission == GameMission_t.doom && gamemode == GameMode_t.shareware) {
        return 0u
    }
    // Can't select a weapon if we don't own it.
    if (players[consoleplayer].weaponowned[int(weapon)] == 0) {
        return 0u
    }
    // Can't select the fist if we have the chainsaw, unless
    // we also have the berserk pack.
    if (weapon == weapontype_t.wp_fist && players[consoleplayer].weaponowned[int(weapontype_t.wp_chainsaw)] != 0 &&
            players[consoleplayer].powers[int(powertype_t.pw_strength)] == 0) {
        return 0u
    }
    return 1u
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__G_NextWeapon(direction : int) : int {
    var weapon : weapontype_t
    var start_i : int
    var i : int
    // Find index in the table.
    if (players[consoleplayer].pendingweapon == weapontype_t.wp_nochange) {
        weapon = players[consoleplayer].readyweapon
    } else {
        weapon = players[consoleplayer].pendingweapon
    }
    i = 0
    while (uint64(i) < uint64(typeinfo sizeof(type<anon_844[9]>)) / uint64(typeinfo sizeof(type<anon_844>))) {
        if (doom_all__weapon_order_table[i].weapon == weapon) {
            break
        }
        i++
    }
    // Switch weapon. Don't loop forever.
    start_i = i
    c_do_while(i != start_i && doom_all__WeaponSelectable(doom_all__weapon_order_table[i].weapon) == 0) {
        i += direction
        i = int((uint64(i) + uint64(typeinfo sizeof(type<anon_844[9]>)) / uint64(typeinfo sizeof(type<anon_844>))) %
                (uint64(typeinfo sizeof(type<anon_844[9]>)) / uint64(typeinfo sizeof(type<anon_844>))))
    }
    return int(doom_all__weapon_order_table[i].weapon_num)
}

// G_BuildTiccmd
// Builds a ticcmd from all of the available inputs
// or reads it from the demo buffer.
// If recording a demo, write it out
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_BuildTiccmd(var cmd : ticcmd_t?; maketic : int) {
    var i : int
    var strafe : uint
    var bstrafe : uint
    var speed : int
    var tspeed : int
    var forward : int
    var side : int
    crt::memset(reinterpret<void?>(cmd), 0, uint64(typeinfo sizeof(type<ticcmd_t>)))
    cmd.consistancy = consistancy[consoleplayer][maketic % BACKUPTICS]
    strafe = uint(int_of(doom_all__gamekeydown[key_strafe] != 0 || doom_all__mousebuttons[mousebstrafe] != 0 || doom_all__joybuttons[joybstrafe] != 0))
    // fraggle: support the old "joyb_speed = 31" hack which
    // allowed an autorun effect
    speed = int_of(key_speed >= NUMKEYS || joybspeed >= MAX_JOY_BUTTONS || doom_all__gamekeydown[key_speed] != 0 || doom_all__joybuttons[joybspeed] != 0)
    side = 0
    forward = side
    // use two stage accelerative turning
    // on the keyboard and joystick
    if (doom_all__joyxmove < 0 || doom_all__joyxmove > 0 || doom_all__gamekeydown[key_right] != 0 || doom_all__gamekeydown[key_left] != 0) {
        doom_all__turnheld += ticdup
    } else {
        doom_all__turnheld = 0
    }
    if (doom_all__turnheld < SLOWTURNTICS) {
        // slow turn
        tspeed = 2
    } else {
        tspeed = speed
    }
    // let movement keys cancel each other out
    if (strafe != 0) {
        if (doom_all__gamekeydown[key_right] != 0) {
            // fprintf(stderr, "strafe right\n");
            side += sidemove[speed]
        }
        if (doom_all__gamekeydown[key_left] != 0) {
            // fprintf(stderr, "strafe left\n");
            side -= sidemove[speed]
        }
        if (doom_all__joyxmove > 0) {
            side += sidemove[speed]
        }
        if (doom_all__joyxmove < 0) {
            side -= sidemove[speed]
        }
    } else {
        if (doom_all__gamekeydown[key_right] != 0) {
            cmd.angleturn = int16(int(cmd.angleturn) - angleturn[tspeed])
        }
        if (doom_all__gamekeydown[key_left] != 0) {
            cmd.angleturn = int16(int(cmd.angleturn) + angleturn[tspeed])
        }
        if (doom_all__joyxmove > 0) {
            cmd.angleturn = int16(int(cmd.angleturn) - angleturn[tspeed])
        }
        if (doom_all__joyxmove < 0) {
            cmd.angleturn = int16(int(cmd.angleturn) + angleturn[tspeed])
        }
    }
    if (doom_all__gamekeydown[key_up] != 0) {
        // fprintf(stderr, "up\n");
        forward += forwardmove[speed]
    }
    if (doom_all__gamekeydown[key_down] != 0) {
        // fprintf(stderr, "down\n");
        forward -= forwardmove[speed]
    }
    if (doom_all__joyymove < 0) {
        forward += forwardmove[speed]
    }
    if (doom_all__joyymove > 0) {
        forward -= forwardmove[speed]
    }
    if (doom_all__gamekeydown[key_strafeleft] != 0 || doom_all__joybuttons[joybstrafeleft] != 0 || doom_all__mousebuttons[mousebstrafeleft] != 0 ||
            doom_all__joystrafemove < 0) {
        side -= sidemove[speed]
    }
    if (doom_all__gamekeydown[key_straferight] != 0 || doom_all__joybuttons[joybstraferight] != 0 || doom_all__mousebuttons[mousebstraferight] != 0 ||
            doom_all__joystrafemove > 0) {
        side += sidemove[speed]
    }
    // buttons
    cmd.chatchar = HU_dequeueChatChar()
    if (doom_all__gamekeydown[key_fire] != 0 || doom_all__mousebuttons[mousebfire] != 0 || doom_all__joybuttons[joybfire] != 0) {
        cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_ATTACK))
    }
    if (doom_all__gamekeydown[key_use] != 0 || doom_all__joybuttons[joybuse] != 0 || doom_all__mousebuttons[mousebuse] != 0) {
        cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_USE))
        // clear double clicks if hit use button
        doom_all__dclicks = 0
    }
    // If the previous or next weapon button is pressed, the
    // next_weapon variable is set to change weapons when
    // we generate a ticcmd. Choose a new weapon.
    if (gamestate == gamestate_t.GS_LEVEL && doom_all__next_weapon != 0) {
        i = doom_all__G_NextWeapon(doom_all__next_weapon)
        cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_CHANGE))
        cmd.buttons = uint8(int(cmd.buttons) | i << int(buttoncode_t.BT_WEAPONSHIFT))
    } else {
        // Check weapon keys.
        i = 0
        while (uint64(i) < uint64(typeinfo sizeof(type<int? [8]>)) / uint64(typeinfo sizeof(type<int?>))) {
            let key : int = *doom_all__weapon_keys[i]
            if (doom_all__gamekeydown[key] != 0) {
                cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_CHANGE))
                cmd.buttons = uint8(int(cmd.buttons) | i << int(buttoncode_t.BT_WEAPONSHIFT))
                break
            }
            i++
        }
    }
    doom_all__next_weapon = 0
    // mouse
    if (doom_all__mousebuttons[mousebforward] != 0) {
        forward += forwardmove[speed]
    }
    if (doom_all__mousebuttons[mousebbackward] != 0) {
        forward -= forwardmove[speed]
    }
    if (dclick_use != 0) {
        // forward double click
        if (doom_all__mousebuttons[mousebforward] != doom_all__dclickstate && doom_all__dclicktime > 1) {
            doom_all__dclickstate = doom_all__mousebuttons[mousebforward]
            if (doom_all__dclickstate != 0) {
                doom_all__dclicks++
            }
            if (doom_all__dclicks == 2) {
                cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_USE))
                doom_all__dclicks = 0
            } else {
                doom_all__dclicktime = 0
            }
        } else {
            doom_all__dclicktime += ticdup
            if (doom_all__dclicktime > 20) {
                doom_all__dclicks = 0
                doom_all__dclickstate = 0u
            }
        }
        // strafe double click
        bstrafe = uint(int_of(doom_all__mousebuttons[mousebstrafe] != 0 || doom_all__joybuttons[joybstrafe] != 0))
        if (bstrafe != doom_all__dclickstate2 && doom_all__dclicktime2 > 1) {
            doom_all__dclickstate2 = bstrafe
            if (doom_all__dclickstate2 != 0) {
                doom_all__dclicks2++
            }
            if (doom_all__dclicks2 == 2) {
                cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_USE))
                doom_all__dclicks2 = 0
            } else {
                doom_all__dclicktime2 = 0
            }
        } else {
            doom_all__dclicktime2 += ticdup
            if (doom_all__dclicktime2 > 20) {
                doom_all__dclicks2 = 0
                doom_all__dclickstate2 = 0u
            }
        }
    }
    forward += mousey
    if (strafe != 0) {
        side += mousex * 2
    } else {
        cmd.angleturn = int16(int(cmd.angleturn) - mousex * 8)
    }
    if (mousex == 0) {
        // No movement in the previous frame
        testcontrols_mousespeed = 0
    }
    mousey = 0
    mousex = mousey
    if (forward > forwardmove[1]) {
        forward = forwardmove[1]
    } elif (forward < -forwardmove[1]) {
        forward = -forwardmove[1]
    }
    if (side > forwardmove[1]) {
        side = forwardmove[1]
    } elif (side < -forwardmove[1]) {
        side = -forwardmove[1]
    }
    cmd.forwardmove = int8(int(cmd.forwardmove) + forward)
    cmd.sidemove = int8(int(cmd.sidemove) + side)
    // special buttons
    if (sendpause != 0) {
        sendpause = 0u
        cmd.buttons = uint8(int(buttoncode_t.BT_SPECIAL) | int(buttoncode_t.BTS_PAUSE))
    }
    if (sendsave != 0) {
        sendsave = 0u
        cmd.buttons = uint8(int(buttoncode_t.BT_SPECIAL) | int(buttoncode_t.BTS_SAVEGAME) | (doom_all__savegameslot << int(buttoncode_t.BTS_SAVESHIFT)))
    }
    // low-res turning
    if (lowres_turn != 0) {
        var desired_angleturn : int16
        desired_angleturn = int16(int(cmd.angleturn) + int(G_BuildTiccmd_carry))
        // round angleturn to the nearest 256 unit boundary
        // for recording demos with single byte values for turn
        cmd.angleturn = int16((int(desired_angleturn) + 128) & 65280)
        // Carry forward the error from the reduced resolution to the
        // next tic, so that successive small movements can accumulate.
        G_BuildTiccmd_carry = int16(int(desired_angleturn) - int(cmd.angleturn))
    }
}

// G_DoLoadLevel
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_DoLoadLevel {
    // Set the sky map.
    // First thing, we have a dummy sky texture name,
    // a flat. The data is in the WAD only because
    // we look for an actual index, instead of simply
    // setting one.
    skyflatnum = R_FlatNumForName(cstr("F_SKY1"))
    // The "Sky never changes in Doom II" bug was fixed in
    // the id Anthology version of doom2.exe for Final Doom.
    if ((gamemode == GameMode_t.commercial) && (gameversion == GameVersion_t.exe_final2 || gameversion == GameVersion_t.exe_chex)) {
        var skytexturename : uint8?
        if (gamemap < 12) {
            skytexturename = cstr("SKY1")
        } elif (gamemap < 21) {
            skytexturename = cstr("SKY2")
        } else {
            skytexturename = cstr("SKY3")
        }
        skytexturename = skytexturename
        skytexture = R_TextureNumForName(skytexturename)
    }
    // for time calculation
    levelstarttic = gametic
    if (wipegamestate == gamestate_t.GS_LEVEL) {
        // force a wipe
        wipegamestate = enum_from_int(type<gamestate_t>, -1)
    }
    gamestate = gamestate_t.GS_LEVEL
    for (i in range(MAXPLAYERS)) {
        turbodetected[i] = 0u
        if (playeringame[i] != 0 && players[i].playerstate == playerstate_t.PST_DEAD) {
            players[i].playerstate = playerstate_t.PST_REBORN
        }
        crt::memset(reinterpret<void?>(addr(players[i].frags[0])), 0, uint64(typeinfo sizeof(type<int[4]>)))
    }
    P_SetupLevel(gameepisode, gamemap, 0, gameskill)
    // view the guy you are playing
    displayplayer = consoleplayer
    gameaction = gameaction_t.ga_nothing
    Z_CheckHeap()
    // clear cmd building stuff
    crt::memset(reinterpret<void?>(addr(doom_all__gamekeydown[0])), 0, uint64(typeinfo sizeof(type<uint[256]>)))
    doom_all__joystrafemove = 0
    doom_all__joyymove = doom_all__joystrafemove
    doom_all__joyxmove = doom_all__joyymove
    mousey = 0
    mousex = mousey
    paused = 0u
    sendsave = paused
    sendpause = sendsave
    crt::memset(reinterpret<void?>(addr(doom_all__mousearray[0])), 0, uint64(typeinfo sizeof(type<uint[9]>)))
    crt::memset(reinterpret<void?>(addr(doom_all__joyarray[0])), 0, uint64(typeinfo sizeof(type<uint[21]>)))
    if (testcontrols != 0) {
        players[consoleplayer].message = cstr("Press escape to quit.")
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SetJoyButtons(buttons_mask : uint) {
    for (i in range(MAX_JOY_BUTTONS)) {
        let button_on : int = int_of((buttons_mask & uint(1 << i)) != 0u)
        // Detect button press:
        if (doom_all__joybuttons[i] == 0 && button_on != 0) {
            // Weapon cycling:
            if (i == joybprevweapon) {
                doom_all__next_weapon = -1
            } elif (i == joybnextweapon) {
                doom_all__next_weapon = 1
            }
        }
        doom_all__joybuttons[i] = uint(button_on)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__SetMouseButtons(buttons_mask : uint) {
    for (i in range(MAX_MOUSE_BUTTONS)) {
        let button_on : uint = uint(int_of((buttons_mask & uint(1 << i)) != 0u))
        // Detect button press:
        if (doom_all__mousebuttons[i] == 0 && button_on != 0) {
            if (i == mousebprevweapon) {
                doom_all__next_weapon = -1
            } elif (i == mousebnextweapon) {
                doom_all__next_weapon = 1
            }
        }
        doom_all__mousebuttons[i] = button_on
    }
}

// G_Responder
// Get info needed to make ticcmd_ts for the players.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_Responder(var ev : event_t?) : uint {
    // allow spy mode changes even during the demo
    if (gamestate == gamestate_t.GS_LEVEL && ev._c_type == evtype_t.ev_keydown && ev.data1 == key_spy && (singledemo != 0 || deathmatch == 0)) {
        // spy mode
        c_do_while(playeringame[displayplayer] == 0 && displayplayer != consoleplayer) {
            displayplayer++
            if (displayplayer == MAXPLAYERS) {
                displayplayer = 0
            }
        }
        return 1u
    }
    // any other key pops up menu if in demos
    if (gameaction == gameaction_t.ga_nothing && singledemo == 0 && (demoplayback != 0 || gamestate == gamestate_t.GS_DEMOSCREEN)) {
        if (ev._c_type == evtype_t.ev_keydown || (ev._c_type == evtype_t.ev_mouse && ev.data1 != 0) || (ev._c_type == evtype_t.ev_joystick && ev.data1 != 0)) {
            M_StartControlPanel()
            return 1u
        }
        return 0u
    }
    if (gamestate == gamestate_t.GS_LEVEL) {
        if (HU_Responder(ev) != 0) {
            // chat ate the event
            return 1u
        }
        if (ST_Responder(ev) != 0) {
            // status window ate it
            return 1u
        }
        if (AM_Responder(ev) != 0) {
            // automap ate it
            return 1u
        }
    }
    if (gamestate == gamestate_t.GS_FINALE) {
        if (F_Responder(ev) != 0) {
            // finale ate the event
            return 1u
        }
    }
    if (testcontrols != 0 && ev._c_type == evtype_t.ev_mouse) {
        // If we are invoked by setup to test the controls, save the
        // mouse speed so that we can display it on-screen.
        // Perform a low pass filter on this so that the thermometer
        // appears to move smoothly.
        testcontrols_mousespeed = crt::abs(ev.data2)
    }
    // If the next/previous weapon keys are pressed, set the next_weapon
    // variable to change weapons when the next ticcmd is generated.
    if (ev._c_type == evtype_t.ev_keydown && ev.data1 == key_prevweapon) {
        doom_all__next_weapon = -1
    } elif (ev._c_type == evtype_t.ev_keydown && ev.data1 == key_nextweapon) {
        doom_all__next_weapon = 1
    }
    c_switch(ev._c_type) {
        case(evtype_t.ev_keydown) {
            if (ev.data1 == key_pause) {
                sendpause = 1u
            } elif (ev.data1 < NUMKEYS) {
                doom_all__gamekeydown[ev.data1] = 1u
            }
            // eat key down events
            return 1u
        }
        case(evtype_t.ev_keyup) {
            if (ev.data1 < NUMKEYS) {
                doom_all__gamekeydown[ev.data1] = 0u
            }
            // always let key up events filter down
            return 0u
        }
        case(evtype_t.ev_mouse) {
            doom_all__SetMouseButtons(uint(ev.data1))
            mousex = ev.data2 * (mouseSensitivity + 5) / 10
            mousey = ev.data3 * (mouseSensitivity + 5) / 10
            // eat events
            return 1u
        }
        case(evtype_t.ev_joystick) {
            doom_all__SetJoyButtons(uint(ev.data1))
            doom_all__joyxmove = ev.data2
            doom_all__joyymove = ev.data3
            doom_all__joystrafemove = ev.data4
            // eat events
            return 1u
        }
        case(_) {
            break
        }
    }
    return 0u
}

// G_Ticker
// Make ticcmd_ts for the players.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_Ticker {
    var buf : int
    var cmd : ticcmd_t?
    // do player reborns if needed
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] != 0 && players[i].playerstate == playerstate_t.PST_REBORN) {
            G_DoReborn(i)
        }
    }
    // do things to change the game state
    while (gameaction != gameaction_t.ga_nothing) {
        c_switch(gameaction) {
            case(gameaction_t.ga_loadlevel) {
                G_DoLoadLevel()
                break
            }
            case(gameaction_t.ga_newgame) {
                G_DoNewGame()
                break
            }
            case(gameaction_t.ga_loadgame) {
                G_DoLoadGame()
                break
            }
            case(gameaction_t.ga_savegame) {
                G_DoSaveGame()
                break
            }
            case(gameaction_t.ga_playdemo) {
                G_DoPlayDemo()
                break
            }
            case(gameaction_t.ga_completed) {
                G_DoCompleted()
                break
            }
            case(gameaction_t.ga_victory) {
                F_StartFinale()
                break
            }
            case(gameaction_t.ga_worlddone) {
                G_DoWorldDone()
                break
            }
            case(gameaction_t.ga_screenshot) {
                V_ScreenShot(cstr("DOOM%02i.%s"))
                players[consoleplayer].message = cstr("screen shot")
                gameaction = gameaction_t.ga_nothing
                break
            }
            case(gameaction_t.ga_nothing) {
                break
            }
        }
    }
    // get commands, check consistancy,
    // and build new consistancy check
    buf = (gametic / ticdup) % BACKUPTICS
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] != 0) {
            cmd = addr(players[i].cmd)
            crt::memcpy(reinterpret<void?>(cmd), reinterpret<void?>(addr(netcmds[i])), uint64(typeinfo sizeof(type<ticcmd_t>)))
            if (demoplayback != 0) {
                G_ReadDemoTiccmd(cmd)
            }
            if (demorecording != 0) {
                G_WriteDemoTiccmd(cmd)
            }
            // check for turbo cheats
            // check ~ 4 seconds whether to display the turbo message.
            // store if the turbo threshold was exceeded in any tics
            // over the past 4 seconds. offset the checking period
            // for each player so messages are not displayed at the
            // same time.
            if (int(cmd.forwardmove) > TURBOTHRESHOLD) {
                turbodetected[i] = 1u
            }
            if ((gametic & 31) == 0 && ((gametic >> 5) % MAXPLAYERS) == i && turbodetected[i] != 0) {
                M_snprintf`va(addr(G_Ticker_turbomessage[0]), uint64(typeinfo sizeof(type<uint8[80]>)), cstr("%s is turbo!"), (player_names[i],))
                players[consoleplayer].message = addr(G_Ticker_turbomessage[0])
                turbodetected[i] = 0u
            }
            if (netgame != 0 && netdemo == 0 && (gametic % ticdup) == 0) {
                if (gametic > BACKUPTICS && consistancy[i][buf] != cmd.consistancy) {
                    I_Error`va(cstr("consistency failure (%i should be %i)"), (int(cmd.consistancy), int(consistancy[i][buf])))
                }
                if (players[i].mo != null) {
                    consistancy[i][buf] = uint8(players[i].mo.x)
                } else {
                    consistancy[i][buf] = uint8(rndindex)
                }
            }
        }
    }
    // check for special buttons
    for (i in range(MAXPLAYERS)) {
        if (playeringame[i] != 0) {
            if ((int(players[i].cmd.buttons) & int(buttoncode_t.BT_SPECIAL)) != 0) {
                c_switch(int(players[i].cmd.buttons) & int(buttoncode_t.BT_SPECIALMASK)) {
                    case(1) {
                        paused ^= 1u
                        if (paused != 0) {
                            S_PauseSound()
                        } else {
                            S_ResumeSound()
                        }
                        break
                    }
                    case(2) {
                        if (doom_all__savedescription[0] == 0) {
                            M_StringCopy(addr(doom_all__savedescription[0]), cstr("NET GAME"), uint64(typeinfo sizeof(type<uint8[32]>)))
                        }
                        doom_all__savegameslot = (int(players[i].cmd.buttons) & int(buttoncode_t.BTS_SAVEMASK)) >> int(buttoncode_t.BTS_SAVESHIFT)
                        gameaction = gameaction_t.ga_savegame
                        break
                    }
                }
            }
        }
    }
    // Have we just finished displaying an intermission screen?
    if (oldgamestate == gamestate_t.GS_INTERMISSION && gamestate != gamestate_t.GS_INTERMISSION) {
        WI_End()
    }
    oldgamestate = gamestate
    // do main actions
    c_switch(gamestate) {
        case(gamestate_t.GS_LEVEL) {
            P_Ticker()
            ST_Ticker()
            AM_Ticker()
            HU_Ticker()
            break
        }
        case(gamestate_t.GS_INTERMISSION) {
            WI_Ticker()
            break
        }
        case(gamestate_t.GS_FINALE) {
            F_Ticker()
            break
        }
        case(gamestate_t.GS_DEMOSCREEN) {
            D_PageTicker()
            break
        }
    }
}

// G_InitPlayer
// Called at the start.
// Called by the game initialization functions.
[unsafe_deref, hint(unsafe_range_check)]
def G_InitPlayer(player : int) {
    // clear everything else to defaults
    G_PlayerReborn(player)
}

// G_PlayerFinishLevel
// Can when a player completes a level.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_PlayerFinishLevel(player : int) {
    var p : player_s?
    p = addr(players[0]) + end_index(player, 4)
    crt::memset(reinterpret<void?>(addr(p.powers[0])), 0, uint64(typeinfo sizeof(type<int[6]>)))
    crt::memset(reinterpret<void?>(addr(p.cards[0])), 0, uint64(typeinfo sizeof(type<uint[6]>)))
    // cancel invisibility
    p.mo.flags &= ~int(mobjflag_t.MF_SHADOW)
    // cancel gun flashes
    p.extralight = 0
    // cancel ir gogles
    p.fixedcolormap = 0
    // no palette changes
    p.damagecount = 0
    p.bonuscount = 0
}

// G_PlayerReborn
// Called after a player dies
// almost everything is cleared and initialized
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_PlayerReborn(player : int) {
    var p : player_s?
    var frags : int[4]
    var killcount : int
    var itemcount : int
    var secretcount : int
    crt::memcpy(reinterpret<void?>(addr(frags[0])), reinterpret<void?>(addr(players[player].frags[0])), uint64(typeinfo sizeof(type<int[4]>)))
    killcount = players[player].killcount
    itemcount = players[player].itemcount
    secretcount = players[player].secretcount
    p = addr(players[0]) + end_index(player, 4)
    crt::memset(reinterpret<void?>(p), 0, uint64(typeinfo sizeof(type<player_s>)))
    crt::memcpy(reinterpret<void?>(addr(players[player].frags[0])), reinterpret<void?>(addr(frags[0])), uint64(typeinfo sizeof(type<int[4]>)))
    players[player].killcount = killcount
    players[player].itemcount = itemcount
    players[player].secretcount = secretcount
    // don't do anything immediately
    p.attackdown = 1
    p.usedown = p.attackdown
    p.playerstate = playerstate_t.PST_LIVE
    // Use dehacked value
    p.health = deh_initial_health
    p.pendingweapon = weapontype_t.wp_pistol
    p.readyweapon = p.pendingweapon
    p.weaponowned[int(weapontype_t.wp_fist)] = 1u
    p.weaponowned[int(weapontype_t.wp_pistol)] = 1u
    p.ammo[int(ammotype_t.am_clip)] = deh_initial_bullets
    for (i in range(int(ammotype_t.NUMAMMO))) {
        p.maxammo[i] = maxammo[i]
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_CheckSpot(playernum : int; var mthing : mapthing_t?) : uint {
    var x : int
    var y : int
    var ss : subsector_s?
    var mo : mobj_s?
    if (players[playernum].mo == null) {
        // first spawn of level, before corpses
        for (i in range(playernum)) {
            if (players[i].mo.x == int(mthing.x) << FRACBITS && players[i].mo.y == int(mthing.y) << FRACBITS) {
                return 0u
            }
        }
        return 1u
    }
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    if (P_CheckPosition(players[playernum].mo, x, y) == 0) {
        return 0u
    }
    // flush an old corpse if needed
    if (bodyqueslot >= BODYQUESIZE) {
        P_RemoveMobj(bodyque[bodyqueslot % BODYQUESIZE])
    }
    bodyque[bodyqueslot % BODYQUESIZE] = players[playernum].mo
    bodyqueslot++
    // spawn a teleport fog
    ss = R_PointInSubsector(x, y)
    {
        // The code in the released source looks like this:
        // an = ( ANG45 * (((unsigned int) mthing->angle)/45) )
        // >> ANGLETOFINESHIFT;
        // mo = P_SpawnMobj (x+20*finecosine[an], y+20*finesine[an]
        // , ss->sector->floorheight
        // , MT_TFOG);
        // But 'an' can be a signed value in the DOS version. This means that
        // we get a negative index and the lookups into finecosine/finesine
        // end up dereferencing values in finetangent[].
        // A player spawning on a deathmatch start facing directly west spawns
        // "silently" with no spawn fog. Emulate this.
        // This code is imported from PrBoom+.
        var xa : int
        var ya : int
        var an : int
        // This calculation overflows in Vanilla Doom, but here we deliberately
        // avoid integer overflow as it is undefined behavior, so the value of
        // 'an' will always be positive.
        an = (ANG45 >> ANGLETOFINESHIFT) * (int(mthing.angle) / 45)
        c_switch(an) {
            case(4096) {
                // -4096:
                // finecosine[-4096]
                xa = finetangent[2048]
                // finesine[-4096]
                ya = finetangent[0]
                break
            }
            case(5120) {
                // -3072:
                // finecosine[-3072]
                xa = finetangent[3072]
                // finesine[-3072]
                ya = finetangent[1024]
                break
            }
            case(6144) {
                // -2048:
                // finecosine[-2048]
                xa = finesine[0]
                // finesine[-2048]
                ya = finetangent[2048]
                break
            }
            case(7168) {
                // -1024:
                // finecosine[-1024]
                xa = finesine[1024]
                // finesine[-1024]
                ya = finetangent[3072]
                break
            }
            case(0, 1024, 2048, 3072) {
                xa = finecosine[an]
                ya = finesine[an]
                break
            }
            case(_) {
                I_Error`va(cstr("G_CheckSpot: unexpected angle %d\n"), (an,))
                ya = 0
                xa = ya
                break
            }
        }
        mo = P_SpawnMobj(x + 20 * xa, y + 20 * ya, ss.sector.floorheight, mobjtype_t.MT_TFOG)
    }
    if (players[consoleplayer].viewz != 1) {
        // don't start sound on first frame
        S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_telept))
    }
    return 1u
}

// G_DeathMatchSpawnPlayer
// Spawns a player at one of the random death match spots
// called at level load and each death
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_DeathMatchSpawnPlayer(playernum : int) {
    var i : int
    var selections : int
    selections = int(int64(deathmatch_p - addr(deathmatchstarts[0])))
    if (selections < 4) {
        I_Error`va(cstr("Only %i deathmatch spots, 4 required"), (selections,))
    }
    for (j in range(20)) {
        i = P_Random() % selections
        if (G_CheckSpot(playernum, addr(deathmatchstarts[0]) + end_index(i, 10)) != 0) {
            deathmatchstarts[i]._c_type = int16(playernum + 1)
            P_SpawnPlayer(addr(deathmatchstarts[0]) + end_index(i, 10))
            return
        }
    }
    // no good spot, so the player will probably get stuck
    P_SpawnPlayer(addr(playerstarts[0]) + end_index(playernum, 4))
}

// G_DoReborn
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_DoReborn(playernum : int) {
    if (netgame == 0) {
        // reload the level from scratch
        gameaction = gameaction_t.ga_loadlevel
    } else {
        // respawn at the start
        // first dissasociate the corpse
        players[playernum].mo.player = null
        // spawn at random spot if in death match
        if (deathmatch != 0) {
            G_DeathMatchSpawnPlayer(playernum)
            return
        }
        if (G_CheckSpot(playernum, addr(playerstarts[0]) + end_index(playernum, 4)) != 0) {
            P_SpawnPlayer(addr(playerstarts[0]) + end_index(playernum, 4))
            return
        }
        // try to spawn at one of the other players spots
        for (i in range(MAXPLAYERS)) {
            if (G_CheckSpot(playernum, addr(playerstarts[0]) + end_index(i, 4)) != 0) {
                // fake as other player
                playerstarts[i]._c_type = int16(playernum + 1)
                P_SpawnPlayer(addr(playerstarts[0]) + end_index(i, 4))
                // restore
                playerstarts[i]._c_type = int16(i + 1)
                return
            }
        }
        // he's going to be inside something. Too bad.
        P_SpawnPlayer(addr(playerstarts[0]) + end_index(playernum, 4))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def G_ScreenShot {
    gameaction = gameaction_t.ga_screenshot
}

[unsafe_deref, hint(unsafe_range_check)]
def G_ExitLevel {
    secretexit = 0u
    gameaction = gameaction_t.ga_completed
}

// Here's for the german edition.
[unsafe_deref, hint(unsafe_range_check)]
def G_SecretExitLevel {
    // IF NO WOLF3D LEVELS, NO SECRET EXIT!
    if ((gamemode == GameMode_t.commercial) && (W_CheckNumForName(cstr("map31")) < 0)) {
        secretexit = 0u
    } else {
        secretexit = 1u
    }
    gameaction = gameaction_t.ga_completed
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_DoCompleted {
    var i : int
    gameaction = gameaction_t.ga_nothing
    i = 0
    while (i < MAXPLAYERS) {
        if (playeringame[i] != 0) {
            // take away cards and stuff
            G_PlayerFinishLevel(i)
        }
        i++
    }
    if (automapactive != 0) {
        AM_Stop()
    }
    if (gamemode != GameMode_t.commercial) {
        // Chex Quest ends after 5 levels, rather than 8.
        if (gameversion == GameVersion_t.exe_chex) {
            if (gamemap == 5) {
                gameaction = gameaction_t.ga_victory
                return
            }
        } else {
            c_switch(gamemap) {
                case(8) {
                    gameaction = gameaction_t.ga_victory
                    return
                }
                case(9) {
                    i = 0
                    while (i < MAXPLAYERS) {
                        players[i].didsecret = 1u
                        i++
                    }
                    break
                }
            }
        }
    }
    // #if 0 Hmmm - why?
    if ((gamemap == 8) && (gamemode != GameMode_t.commercial)) {
        // victory
        gameaction = gameaction_t.ga_victory
        return
    }
    if ((gamemap == 9) && (gamemode != GameMode_t.commercial)) {
        // exit secret level
        for (i1 in range(MAXPLAYERS)) {
            players[i1].didsecret = 1u
        }
    }
    // #endif
    wminfo.didsecret = players[consoleplayer].didsecret
    wminfo.epsd = gameepisode - 1
    wminfo.last = gamemap - 1
    // wminfo.next is 0 biased, unlike gamemap
    if (gamemode == GameMode_t.commercial) {
        if (secretexit != 0) {
            c_switch(gamemap) {
                case(15) {
                    wminfo.next = 30
                    break
                }
                case(31) {
                    wminfo.next = 31
                    break
                }
            }
        } else {
            c_switch(gamemap) {
                case(31, 32) {
                    wminfo.next = 15
                    break
                }
                case(_) {
                    wminfo.next = gamemap
                }
            }
        }
    } else {
        if (secretexit != 0) {
            // go to secret level
            wminfo.next = 8
        } elif (gamemap == 9) {
            // returning from secret level
            c_switch(gameepisode) {
                case(1) {
                    wminfo.next = 3
                    break
                }
                case(2) {
                    wminfo.next = 5
                    break
                }
                case(3) {
                    wminfo.next = 6
                    break
                }
                case(4) {
                    wminfo.next = 2
                    break
                }
            }
        } else {
            // go to next level
            wminfo.next = gamemap
        }
    }
    wminfo.maxkills = totalkills
    wminfo.maxitems = totalitems
    wminfo.maxsecret = totalsecret
    wminfo.maxfrags = 0
    // Set par time. Doom episode 4 doesn't have a par time, so this
    // overflows into the cpars array. It's necessary to emulate this
    // for statcheck regression testing.
    if (gamemode == GameMode_t.commercial) {
        wminfo.partime = TICRATE * cpars[gamemap - 1]
    } elif (gameepisode < 4) {
        wminfo.partime = TICRATE * pars[gameepisode][gamemap]
    } else {
        wminfo.partime = TICRATE * cpars[gamemap]
    }
    wminfo.pnum = consoleplayer
    for (i1 in range(MAXPLAYERS)) {
        wminfo.plyr[i1]._c_in = playeringame[i1]
        wminfo.plyr[i1].skills = players[i1].killcount
        wminfo.plyr[i1].sitems = players[i1].itemcount
        wminfo.plyr[i1].ssecret = players[i1].secretcount
        wminfo.plyr[i1].stime = leveltime
        crt::memcpy(reinterpret<void?>(addr(wminfo.plyr[i1].frags[0])), reinterpret<void?>(addr(players[i1].frags[0])), uint64(typeinfo sizeof(type<int[4]>)))
    }
    gamestate = gamestate_t.GS_INTERMISSION
    viewactive = 0u
    automapactive = 0u
    StatCopy(addr(wminfo))
    WI_Start(addr(wminfo))
}

// G_WorldDone
[unsafe_deref, hint(unsafe_range_check)]
def G_WorldDone {
    gameaction = gameaction_t.ga_worlddone
    if (secretexit != 0) {
        players[consoleplayer].didsecret = 1u
    }
    if (gamemode == GameMode_t.commercial) {
        c_switch(gamemap) {
            case(15, 31) {
                if (secretexit == 0) {
                    break
                }
            }
            case(6, 11, 20, 30) {
                F_StartFinale()
                break
            }
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def G_DoWorldDone {
    gamestate = gamestate_t.GS_LEVEL
    gamemap = wminfo.next + 1
    G_DoLoadLevel()
    gameaction = gameaction_t.ga_nothing
    viewactive = 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_LoadGame(var name : uint8?) {
    M_StringCopy(addr(savename[0]), name, uint64(typeinfo sizeof(type<uint8[256]>)))
    gameaction = gameaction_t.ga_loadgame
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_DoLoadGame {
    var savedleveltime : int
    gameaction = gameaction_t.ga_nothing
    save_stream = reinterpret<_IO_FILE?>(crt::fopen(addr(savename[0]), cstr("rb")))
    if (save_stream == null) {
        return
    }
    savegame_error = 0u
    if (P_ReadSaveGameHeader() == 0) {
        crt::fclose(reinterpret<void?>(save_stream))
        return
    }
    savedleveltime = leveltime
    // load a base level
    G_InitNew(gameskill, gameepisode, gamemap)
    leveltime = savedleveltime
    // dearchive all the modifications
    P_UnArchivePlayers()
    P_UnArchiveWorld()
    P_UnArchiveThinkers()
    P_UnArchiveSpecials()
    if (P_ReadSaveGameEOF() == 0) {
        I_Error`va(cstr("Bad savegame"), VaNone())
    }
    crt::fclose(reinterpret<void?>(save_stream))
    if (setsizeneeded != 0) {
        R_ExecuteSetViewSize()
    }
    // draw the pattern into the back screen
    R_FillBackScreen()
}

// G_SaveGame
// Called by the menu task.
// Description is a 24 byte text string
[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_SaveGame(slot : int; var description : uint8?) {
    doom_all__savegameslot = slot
    M_StringCopy(addr(doom_all__savedescription[0]), description, uint64(typeinfo sizeof(type<uint8[32]>)))
    sendsave = 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def G_DoSaveGame {
    var savegame_file : uint8?
    var temp_savegame_file : uint8?
    var recovery_savegame_file : uint8?
    recovery_savegame_file = null
    temp_savegame_file = P_TempSaveGameFile()
    savegame_file = P_SaveGameFile(doom_all__savegameslot)
    // Open the savegame file for writing. We write to a temporary file
    // and then rename it at the end if it was successfully written.
    // This prevents an existing savegame from being overwritten by
    // a corrupted one, or if a savegame buffer overrun occurs.
    save_stream = reinterpret<_IO_FILE?>(crt::fopen(temp_savegame_file, cstr("wb")))
    if (save_stream == null) {
        // Failed to save the game, so we're going to have to abort. But
        // to be nice, save to somewhere else before we call I_Error().
        recovery_savegame_file = M_TempFile(cstr("recovery.dsg"))
        save_stream = reinterpret<_IO_FILE?>(crt::fopen(recovery_savegame_file, cstr("wb")))
        if (save_stream == null) {
            I_Error`va(cstr("Failed to open either '%s' or '%s' to write savegame."), (temp_savegame_file, recovery_savegame_file))
        }
    }
    savegame_error = 0u
    P_WriteSaveGameHeader(addr(doom_all__savedescription[0]))
    P_ArchivePlayers()
    P_ArchiveWorld()
    P_ArchiveThinkers()
    P_ArchiveSpecials()
    P_WriteSaveGameEOF()
    // Enforce the same savegame size limit as in Vanilla Doom,
    // except if the vanilla_savegame_limit setting is turned off.
    if (vanilla_savegame_limit != 0 && crt::ftell(reinterpret<void?>(save_stream)) > int64(SAVEGAMESIZE)) {
        I_Error`va(cstr("Savegame buffer overrun"), VaNone())
    }
    // Finish up, close the savegame file.
    crt::fclose(reinterpret<void?>(save_stream))
    if (recovery_savegame_file != null) {
        // We failed to save to the normal location, but we wrote a
        // recovery file to the temp directory. Now we can bomb out
        // with an error.
        I_Error`va(cstr("Failed to open savegame file '%s' for writing.\nBut your game has been saved to '%s' for recovery."),
                (temp_savegame_file, recovery_savegame_file))
    }
    // Now rename the temporary savegame file to the actual savegame
    // file, overwriting the old savegame if there was one there.
    crt::remove(savegame_file)
    crt::rename(temp_savegame_file, savegame_file)
    gameaction = gameaction_t.ga_nothing
    M_StringCopy(addr(doom_all__savedescription[0]), addr(c2das_empty[0]), uint64(typeinfo sizeof(type<uint8[32]>)))
    players[consoleplayer].message = cstr("game saved.")
    // draw the pattern into the back screen
    R_FillBackScreen()
}

[unsafe_deref, hint(unsafe_range_check)]
def G_DeferedInitNew(skill : skill_t; episode : int; map : int) {
    d_skill = skill
    d_episode = episode
    d_map = map
    gameaction = gameaction_t.ga_newgame
