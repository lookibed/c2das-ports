[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawBlock(x : int; y : int; width : int; var height : int; var src : uint8?) {
    var dest : uint8?
    if (x < 0 || x + width > SCREENWIDTH || y < 0 || y + height > SCREENHEIGHT) {
        I_Error`va(cstr("Bad V_DrawBlock"), VaNone())
    }
    V_MarkRect(x, y, width, height)
    dest = doom_all__dest_screen + y * SCREENWIDTH + x
    while (true) {
        let _t0 = height
        height--
        if (_t0 == 0) {
            break
        }
        crt::memcpy(reinterpret<void?>(dest), reinterpret<void?>(src), uint64(width))
        src += width
        dest += SCREENWIDTH
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawFilledBox(x : int; y : int; w : int; h : int; c : int) {
    var buf : uint8?
    var buf1 : uint8?
    buf = I_VideoBuffer + SCREENWIDTH * y + x
    for (y1 in range(h)) {
        buf1 = buf
        for (x1 in range(w)) {
            var _t0 = buf1
            buf1++
            *_t0 = uint8(c)
        }
        buf += SCREENWIDTH
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawHorizLine(x : int; y : int; w : int; c : int) {
    var buf : uint8?
    buf = I_VideoBuffer + SCREENWIDTH * y + x
    for (x1 in range(w)) {
        var _t0 = buf
        buf++
        *_t0 = uint8(c)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawVertLine(x : int; y : int; h : int; c : int) {
    var buf : uint8?
    buf = I_VideoBuffer + SCREENWIDTH * y + x
    for (y1 in range(h)) {
        *buf = uint8(c)
        buf += SCREENWIDTH
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def V_DrawBox(x : int; y : int; w : int; h : int; c : int) {
    V_DrawHorizLine(x, y, w, c)
    V_DrawHorizLine(x, y + h - 1, w, c)
    V_DrawVertLine(x, y, h, c)
    V_DrawVertLine(x + w - 1, y, h, c)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def V_DrawRawScreen(var raw : uint8?) {
    crt::memcpy(reinterpret<void?>(doom_all__dest_screen), reinterpret<void?>(raw), uint64(SCREENWIDTH * SCREENHEIGHT))
}

