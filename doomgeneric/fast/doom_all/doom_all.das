    screenp = doom_all__dest_buffer + y1 * doom_all__dest_pitch + x1
    // For every 1 line of src_buffer, 6 lines are written to dest_buffer.
    // (200 -> 1200)
    for (y3 in range(SCREENHEIGHT)) {
