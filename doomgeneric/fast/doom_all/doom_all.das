struct pcx_t {
    manufacturer, version, encoding, bits_per_pixel : uint8
    xmin, ymin, xmax, ymax, hres, vres : uint16
    palette : uint8[48]
    reserved, color_planes : uint8
    bytes_per_line, palette_type : uint16
    filler : uint8[58]
    data : uint8
}

[c_function]
def read_pcx_t(bytes : uint8?; ofs : int) : pcx_t {
    var r : pcx_t
    memcpy(reinterpret<void?>(addr(r.manufacturer)), reinterpret<void?>(bytes + (ofs + 0)), 1)
    memcpy(reinterpret<void?>(addr(r.version)), reinterpret<void?>(bytes + (ofs + 1)), 1)
    memcpy(reinterpret<void?>(addr(r.encoding)), reinterpret<void?>(bytes + (ofs + 2)), 1)
    memcpy(reinterpret<void?>(addr(r.bits_per_pixel)), reinterpret<void?>(bytes + (ofs + 3)), 1)
    memcpy(reinterpret<void?>(addr(r.xmin)), reinterpret<void?>(bytes + (ofs + 4)), 2)
    memcpy(reinterpret<void?>(addr(r.ymin)), reinterpret<void?>(bytes + (ofs + 6)), 2)
    memcpy(reinterpret<void?>(addr(r.xmax)), reinterpret<void?>(bytes + (ofs + 8)), 2)
    memcpy(reinterpret<void?>(addr(r.ymax)), reinterpret<void?>(bytes + (ofs + 10)), 2)
    memcpy(reinterpret<void?>(addr(r.hres)), reinterpret<void?>(bytes + (ofs + 12)), 2)
    memcpy(reinterpret<void?>(addr(r.vres)), reinterpret<void?>(bytes + (ofs + 14)), 2)
    memcpy(reinterpret<void?>(addr(r.palette)), reinterpret<void?>(bytes + (ofs + 16)), 48)
    memcpy(reinterpret<void?>(addr(r.reserved)), reinterpret<void?>(bytes + (ofs + 64)), 1)
    memcpy(reinterpret<void?>(addr(r.color_planes)), reinterpret<void?>(bytes + (ofs + 65)), 1)
    memcpy(reinterpret<void?>(addr(r.bytes_per_line)), reinterpret<void?>(bytes + (ofs + 66)), 2)
    memcpy(reinterpret<void?>(addr(r.palette_type)), reinterpret<void?>(bytes + (ofs + 68)), 2)
    memcpy(reinterpret<void?>(addr(r.filler)), reinterpret<void?>(bytes + (ofs + 70)), 58)
    memcpy(reinterpret<void?>(addr(r.data)), reinterpret<void?>(bytes + (ofs + 128)), 1)
    return r
}

[c_function]
def write_pcx_t(bytes : uint8?; ofs : int; v : pcx_t) {
    var copy = v
    memcpy(reinterpret<void?>(bytes + (ofs + 0)), reinterpret<void?>(addr(copy.manufacturer)), 1)
    memcpy(reinterpret<void?>(bytes + (ofs + 1)), reinterpret<void?>(addr(copy.version)), 1)
    memcpy(reinterpret<void?>(bytes + (ofs + 2)), reinterpret<void?>(addr(copy.encoding)), 1)
    memcpy(reinterpret<void?>(bytes + (ofs + 3)), reinterpret<void?>(addr(copy.bits_per_pixel)), 1)
    memcpy(reinterpret<void?>(bytes + (ofs + 4)), reinterpret<void?>(addr(copy.xmin)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 6)), reinterpret<void?>(addr(copy.ymin)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 8)), reinterpret<void?>(addr(copy.xmax)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 10)), reinterpret<void?>(addr(copy.ymax)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 12)), reinterpret<void?>(addr(copy.hres)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 14)), reinterpret<void?>(addr(copy.vres)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 16)), reinterpret<void?>(addr(copy.palette)), 48)
    memcpy(reinterpret<void?>(bytes + (ofs + 64)), reinterpret<void?>(addr(copy.reserved)), 1)
    memcpy(reinterpret<void?>(bytes + (ofs + 65)), reinterpret<void?>(addr(copy.color_planes)), 1)
    memcpy(reinterpret<void?>(bytes + (ofs + 66)), reinterpret<void?>(addr(copy.bytes_per_line)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 68)), reinterpret<void?>(addr(copy.palette_type)), 2)
    memcpy(reinterpret<void?>(bytes + (ofs + 70)), reinterpret<void?>(addr(copy.filler)), 58)
    memcpy(reinterpret<void?>(bytes + (ofs + 128)), reinterpret<void?>(addr(copy.data)), 1)
}

