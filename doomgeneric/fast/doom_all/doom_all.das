}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_pspdef_t(var str : pspdef_t?) {
    var state : int
    // state_t* state;
    state = doom_all__saveg_read32()
    if (state > 0) {
        str.state = addr(states[0]) + end_index(state, 967)
    } else {
        str.state = null
    }
    // int tics;
    str.tics = doom_all__saveg_read32()
    // fixed_t sx;
    str.sx = doom_all__saveg_read32()
    // fixed_t sy;
    str.sy = doom_all__saveg_read32()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_write_pspdef_t(var str : pspdef_t?) {
    // state_t* state;
    if (str.state != null) {
        doom_all__saveg_write32(int(int64(str.state - addr(states[0]))))
    } else {
        doom_all__saveg_write32(0)
    }
    // int tics;
    doom_all__saveg_write32(str.tics)
    // fixed_t sx;
    doom_all__saveg_write32(str.sx)
    // fixed_t sy;
    doom_all__saveg_write32(str.sy)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__saveg_read_player_t(var str : player_s?) {
    // mobj_t* mo;
    str.mo = reinterpret<mobj_s?>(doom_all__saveg_readp())
    // playerstate_t playerstate;
    str.playerstate = enum_from_int(type<playerstate_t>, doom_all__saveg_read32())
    // ticcmd_t cmd;
    doom_all__saveg_read_ticcmd_t(addr(str.cmd))
    // fixed_t viewz;
    str.viewz = doom_all__saveg_read32()
    // fixed_t viewheight;
    str.viewheight = doom_all__saveg_read32()
    // fixed_t deltaviewheight;
    str.deltaviewheight = doom_all__saveg_read32()
    // fixed_t bob;
    str.bob = doom_all__saveg_read32()
    // int health;
    str.health = doom_all__saveg_read32()
    // int armorpoints;
    str.armorpoints = doom_all__saveg_read32()
    // int armortype;
    str.armortype = doom_all__saveg_read32()
    // int powers[NUMPOWERS];
    for (i in range(int(powertype_t.NUMPOWERS))) {
        str.powers[i] = doom_all__saveg_read32()
    }
    // boolean cards[NUMCARDS];
    for (i in range(int(card_t.NUMCARDS))) {
        str.cards[i] = uint(doom_all__saveg_read32())
    }
    // boolean backpack;
    str.backpack = uint(doom_all__saveg_read32())
    // int frags[MAXPLAYERS];
    for (i in range(MAXPLAYERS)) {
        str.frags[i] = doom_all__saveg_read32()
    }
    // weapontype_t readyweapon;
    str.readyweapon = enum_from_int(type<weapontype_t>, doom_all__saveg_read32())
    // weapontype_t pendingweapon;
    str.pendingweapon = enum_from_int(type<weapontype_t>, doom_all__saveg_read32())
    // boolean weaponowned[NUMWEAPONS];
    for (i in range(int(weapontype_t.NUMWEAPONS))) {
        str.weaponowned[i] = uint(doom_all__saveg_read32())
    }
    // int ammo[NUMAMMO];
    for (i in range(int(ammotype_t.NUMAMMO))) {
        str.ammo[i] = doom_all__saveg_read32()
    }
    // int maxammo[NUMAMMO];
    for (i in range(int(ammotype_t.NUMAMMO))) {
        str.maxammo[i] = doom_all__saveg_read32()
    }
    // int attackdown;
    str.attackdown = doom_all__saveg_read32()
    // int usedown;
    str.usedown = doom_all__saveg_read32()
    // int cheats;
    str.cheats = doom_all__saveg_read32()
    // int refire;
    str.refire = doom_all__saveg_read32()
    // int killcount;
    str.killcount = doom_all__saveg_read32()
    // int itemcount;
    str.itemcount = doom_all__saveg_read32()
    // int secretcount;
    str.secretcount = doom_all__saveg_read32()
    // char* message;
    str.message = reinterpret<uint8?>(doom_all__saveg_readp())
    // int damagecount;
    str.damagecount = doom_all__saveg_read32()
    // int bonuscount;
    str.bonuscount = doom_all__saveg_read32()
    // mobj_t* attacker;
    str.attacker = reinterpret<mobj_s?>(doom_all__saveg_readp())
    // int extralight;
    str.extralight = doom_all__saveg_read32()
    // int fixedcolormap;
    str.fixedcolormap = doom_all__saveg_read32()
    // int colormap;
    str.colormap = doom_all__saveg_read32()
    // pspdef_t psprites[NUMPSPRITES];
    for (i in range(int(psprnum_t.NUMPSPRITES))) {
        doom_all__saveg_read_pspdef_t(addr(str.psprites[0]) + end_index(i, 2))
    }
    // boolean didsecret;
    str.didsecret = uint(doom_all__saveg_read32())
}

