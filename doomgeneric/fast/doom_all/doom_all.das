[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__W_StdC_OpenFile(var path : uint8?) : _wad_file_s? {
    var result : stdc_wad_file_t?
    var fstream : _IO_FILE?
    fstream = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("rb")))
    if (fstream == null) {
        return null
    }
    // Create a new stdc_wad_file_t to hold the file handle.
    result = reinterpret<stdc_wad_file_t?>(Z_Malloc(typeinfo sizeof(type<stdc_wad_file_t>), int(anon_28.PU_STATIC), null))
    result.wad.file_class = addr(stdc_wad_file)
    result.wad.mapped = null
    result.wad.length = uint(M_FileLength(fstream))
    result.fstream = fstream
    return addr(result.wad)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__W_StdC_CloseFile(var wad : _wad_file_s?) {
    var stdc_wad : stdc_wad_file_t?
    stdc_wad = reinterpret<stdc_wad_file_t?>(wad)
    crt::fclose(reinterpret<void?>(stdc_wad.fstream))
    Z_Free(reinterpret<void?>(stdc_wad))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def W_StdC_Read(var wad : _wad_file_s?; offset : uint; var buffer : void?; buffer_len : uint64) : uint64 {
    var stdc_wad : stdc_wad_file_t?
    var result : uint64
    stdc_wad = reinterpret<stdc_wad_file_t?>(wad)
    // Jump to the specified position in the file.
    crt::fseek(reinterpret<void?>(stdc_wad.fstream), int64(offset), 0)
    // Read into the buffer.
    result = crt::fread(buffer, 1ul, buffer_len, reinterpret<void?>(stdc_wad.fstream))
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__TranslateKey(key : uint8) : uint8 {
    return key
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__GetTypedChar(var key : uint8) : uint8 {
    key = doom_all__TranslateKey(key)
    // Is shift held down? If so, perform a translation.
    if (doom_all__shiftdown > 0) {
        if (int(key) >= 0 && uint64(key) < uint64(typeinfo sizeof(type<uint8[128]>)) / uint64(typeinfo sizeof(type<uint8>))) {
            key = doom_all__shiftxform[int(key)]
        } else {
            key = 0u8
        }
    }
    return key
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__UpdateShiftStatus(pressed : int; key : uint8) {
    var change : int
    if (pressed != 0) {
        change = 1
    } else {
        change = -1
    }
    if (int(key) == KEY_RSHIFT) {
        doom_all__shiftdown += change
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_GetEvent {
    var event : event_t
    var pressed : int
    var key : uint8
    while (DG_GetKey(addr(pressed), addr(key)) != 0) {
        doom_all__UpdateShiftStatus(pressed, key)
        // process event
        if (pressed != 0) {
            // data1 has the key pressed, data2 has the character
            // (shift-translated, etc)
            event._c_type = evtype_t.ev_keydown
            event.data1 = int(doom_all__TranslateKey(key))
            event.data2 = int(doom_all__GetTypedChar(key))
            if (event.data1 != 0) {
                D_PostEvent(addr(event))
            }
        } else {
            event._c_type = evtype_t.ev_keyup
            event.data1 = int(doom_all__TranslateKey(key))
            // data2 is just initialized to zero for ev_keyup.
            // For ev_keydown it's the shifted Unicode character
            // that was typed, but if something wants to detect
            // key releases it should do so based on data1
            // (key ID), not the printable char.
            event.data2 = 0
            if (event.data1 != 0) {
                D_PostEvent(addr(event))
            }
            break
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def I_InitInput {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def cmap_to_rgb565(var out : uint16?; var _c_in : uint8?; in_pixels : int) {
    var c : color
    var r : uint16
    var g : uint16
    var b : uint16
    for (i in range(in_pixels)) {
        c = colors[int(*_c_in)]
        r = uint16(int(uint16(int(c.r) >> 3)) << 11)
        g = uint16(int(uint16(int(c.g) >> 2)) << 5)
        b = uint16(int(uint16(int(c.b) >> 3)) << 0)
        *out = uint16(int(r) | int(g) | int(b))
        _c_in++
        for (j in range(fb_scaling)) {
            out++
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def cmap_to_fb(var out : uint8?; var _c_in : uint8?; in_pixels : int) {
    var c : color
    var pix : uint
    for (i in range(in_pixels)) {
        // R:8 G:8 B:8
        c = colors[int(*_c_in)]
        if (doom_all__s_Fb.bits_per_pixel == 16u) {
            // RGB565 packing
            let p : uint16 = uint16(((int(c.r) & 248) << 8) | ((int(c.g) & 252) << 3) | (int(c.b) >> 3))
            // can't use SHORT() because this needs to stay unsigned
            for (k in range(fb_scaling)) {
                *reinterpret<uint16?>(out) = p
                out += 2
            }
        } elif (doom_all__s_Fb.bits_per_pixel == 32u) {
            // Assuming RGBA8888
            pix = uint((int(c.r) << int(doom_all__s_Fb.red.offset)) | (int(c.g) << int(doom_all__s_Fb.green.offset)) |
                    (int(c.b) << int(doom_all__s_Fb.blue.offset)))
            for (k in range(fb_scaling)) {
                *reinterpret<uint?>(out) = pix
                out += 4
            }
        } else {
            // no clue how to convert this
            I_Error`va(cstr("No idea how to convert %d bpp pixels"), (doom_all__s_Fb.bits_per_pixel,))
        }
        _c_in++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_InitGraphics {
    var i : int
    var gfxmodeparm : int
    var mode : uint8?
    crt::memset(reinterpret<void?>(addr(doom_all__s_Fb)), 0, uint64(typeinfo sizeof(type<FB_ScreenInfo>)))
    doom_all__s_Fb.xres = uint(DOOMGENERIC_RESX)
    doom_all__s_Fb.yres = uint(DOOMGENERIC_RESY)
    doom_all__s_Fb.xres_virtual = doom_all__s_Fb.xres
    doom_all__s_Fb.yres_virtual = doom_all__s_Fb.yres
    doom_all__s_Fb.bits_per_pixel = 8u
    // CMAP256
    // default to rgba8888 like the old behavior, for compatibility
    // maybe could warn here?
    // default mode
    // CMAP256
    fprintf(crt::c_stderr(), cstr("I_InitGraphics: framebuffer: x_res: %d, y_res: %d, x_virtual: %d, y_virtual: %d, bpp: %d\n"), doom_all__s_Fb.xres,
            doom_all__s_Fb.yres, doom_all__s_Fb.xres_virtual, doom_all__s_Fb.yres_virtual, doom_all__s_Fb.bits_per_pixel)
    fprintf(crt::c_stderr(), cstr("I_InitGraphics: framebuffer: RGBA: %d%d%d%d, red_off: %d, green_off: %d, blue_off: %d, transp_off: %d\n"),
            doom_all__s_Fb.red.length, doom_all__s_Fb.green.length, doom_all__s_Fb.blue.length, doom_all__s_Fb.transp.length, doom_all__s_Fb.red.offset,
            doom_all__s_Fb.green.offset, doom_all__s_Fb.blue.offset, doom_all__s_Fb.transp.offset)
    fprintf(crt::c_stderr(), cstr("I_InitGraphics: DOOM screen size: w x h: %d x %d\n"), SCREENWIDTH, SCREENHEIGHT)
    i = M_CheckParmWithArgs(cstr("-scaling"), 1)
    if (i > 0) {
        i = crt::atoi(myargv[i + 1])
        fb_scaling = i
        fprintf(crt::c_stderr(), cstr("I_InitGraphics: Scaling factor: %d\n"), fb_scaling)
    } else {
        fb_scaling = int(doom_all__s_Fb.xres / uint(SCREENWIDTH))
        if (doom_all__s_Fb.yres / uint(SCREENHEIGHT) < uint(fb_scaling)) {
            fb_scaling = int(doom_all__s_Fb.yres / uint(SCREENHEIGHT))
        }
        fprintf(crt::c_stderr(), cstr("I_InitGraphics: Auto-scaling factor: %d\n"), fb_scaling)
    }
    // Allocate screen to draw to
    // For DOOM to draw on
    I_VideoBuffer = reinterpret<uint8?>(Z_Malloc(SCREENWIDTH * SCREENHEIGHT, int(anon_28.PU_STATIC), null))
    screenvisible = 1u
    I_InitInput()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_ShutdownGraphics {
    Z_Free(reinterpret<void?>(I_VideoBuffer))
}

[unsafe_deref, hint(unsafe_range_check)]
def I_StartFrame {
}

[unsafe_deref, hint(unsafe_range_check)]
def I_StartTic {
    I_GetEvent()
}

[unsafe_deref, hint(unsafe_range_check)]
def I_UpdateNoBlit {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_FinishUpdate {
    var y : int
    var x_offset : int
    var y_offset : int
    var x_offset_end : int
    var line_in : uint8?
    var line_out : uint8?
    // Offsets in case FB is bigger than DOOM
    // 600 = s_Fb heigt, 200 screenheight
    // 600 = s_Fb heigt, 200 screenheight
    // 2048 =s_Fb width, 320 screenwidth
    y_offset = int(((doom_all__s_Fb.yres - uint(SCREENHEIGHT * fb_scaling)) * doom_all__s_Fb.bits_per_pixel / 8u) / 2u)
    // XXX: siglent FB hack: /4 instead of /2, since it seems to handle the resolution in a funny way
    x_offset = int(((doom_all__s_Fb.xres - uint(SCREENWIDTH * fb_scaling)) * doom_all__s_Fb.bits_per_pixel / 8u) / 2u)
    // x_offset = 0;
    x_offset_end = int(((doom_all__s_Fb.xres - uint(SCREENWIDTH * fb_scaling)) * doom_all__s_Fb.bits_per_pixel / 8u) - uint(x_offset))
    // DRAW SCREEN
    line_in = I_VideoBuffer
    line_out = DG_ScreenBuffer
    y = SCREENHEIGHT
    while (true) {
        let _t0 = y
        y--
        if (_t0 == 0) {
            break
        }
        for (i in range(fb_scaling)) {
            line_out += x_offset
            if (fb_scaling == 1) {
                // fb_width is bigger than Doom SCREENWIDTH...
                crt::memcpy(reinterpret<void?>(line_out), reinterpret<void?>(line_in), uint64(SCREENWIDTH))
            } else {
                for (j in range(SCREENWIDTH)) {
                    for (k in range(fb_scaling)) {
                        line_out[j * fb_scaling + k] = line_in[j]
                    }
                }
            }
            // cmap_to_rgb565((void*)line_out, (void*)line_in, SCREENWIDTH);
            line_out += (uint(SCREENWIDTH * fb_scaling) * (doom_all__s_Fb.bits_per_pixel / 8u)) + uint(x_offset_end)
        }
        line_in += SCREENWIDTH
    }
    DG_DrawFrame()
}

// I_ReadScreen
[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_ReadScreen(var scr : uint8?) {
    crt::memcpy(reinterpret<void?>(scr), reinterpret<void?>(I_VideoBuffer), uint64(SCREENWIDTH * SCREENHEIGHT))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_SetPalette(var palette : uint8?) {
    // col_t* c;
    // for (i = 0; i < 256; i++)
    // {
    // c = (col_t*)palette;
    // rgb565_palette[i] = GFX_RGB565(gammatable[usegamma][c->r],
    // gammatable[usegamma][c->g],
    // gammatable[usegamma][c->b]);
    // palette += 3;
    // }
    // performance boost:
    // map to the right pixel format over here!
    for (i in range(256)) {
        colors[i].a = 0u
        var _t0 = palette
        palette++
        colors[i].r = uint(gammatable[usegamma][int(*_t0)])
        var _t1 = palette
        palette++
        colors[i].g = uint(gammatable[usegamma][int(*_t1)])
        var _t2 = palette
        palette++
        colors[i].b = uint(gammatable[usegamma][int(*_t2)])
    }
    palette_changed = 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_GetPaletteIndex(r : int; g : int; b : int) : int {
    var best : int
    var best_diff : int
    var diff : int
    var color : col_t
    fprintf(crt::c_stderr(), cstr("I_GetPaletteIndex\n"))
    best = 0
    best_diff = 2147483647
    for (i in range(256)) {
        color.r = uint8(GFX_RGB565_R(doom_all__rgb565_palette[i]))
        color.g = uint8(GFX_RGB565_G(doom_all__rgb565_palette[i]))
        color.b = uint8(GFX_RGB565_B(doom_all__rgb565_palette[i]))
        diff = (r - int(color.r)) * (r - int(color.r)) + (g - int(color.g)) * (g - int(color.g)) + (b - int(color.b)) * (b - int(color.b))
        if (diff < best_diff) {
            best = i
            best_diff = diff
        }
        if (diff == 0) {
            break
        }
    }
    return best
}

