// Read This Menus
// Had a "quick hack to fix romero bug"
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_DrawReadThis1 {
    var lumpname : uint8? = cstr("CREDIT")
    var skullx : int = 330
    var skully : int = 175
    inhelpscreens = 1u
    // Different versions of Doom 1.9 work differently
    c_switch(gameversion) {
        case(GameVersion_t.exe_doom_1_666, GameVersion_t.exe_doom_1_7, GameVersion_t.exe_doom_1_8, GameVersion_t.exe_doom_1_9, GameVersion_t.exe_hacx) {
            if (gamemode == GameMode_t.commercial) {
                // Doom 2
                lumpname = cstr("HELP")
                skullx = 330
                skully = 165
            } else {
                // Doom 1
                // HELP2 is the first screen shown in Doom 1
                lumpname = cstr("HELP2")
                skullx = 280
                skully = 185
            }
            break
        }
        case(GameVersion_t.exe_ultimate, GameVersion_t.exe_chex) {
            // Ultimate Doom always displays "HELP1".
            // Chex Quest version also uses "HELP1", even though it is based
            // on Final Doom.
            lumpname = cstr("HELP1")
            break
        }
        case(GameVersion_t.exe_final, GameVersion_t.exe_final2) {
            // Final Doom always displays "HELP".
            lumpname = cstr("HELP")
            break
        }
        case(_) {
            I_Error`va(cstr("Unhandled game version"), VaNone())
            break
        }
    }
    lumpname = lumpname
    V_DrawPatchDirect(0, 0, reinterpret<patch_t?>(W_CacheLumpName(lumpname, int(anon_28.PU_CACHE))))
    ReadDef1.x = int16(skullx)
    ReadDef1.y = int16(skully)
}

