[unsafe_deref, hint(unsafe_range_check)]
def M_QuitResponse(key : int) {
    if (key != key_menu_confirm) {
        return
    }
    if (netgame == 0) {
        if (gamemode == GameMode_t.commercial) {
            S_StartSound(null, quitsounds2[(gametic >> 2) & 7])
        } else {
            S_StartSound(null, quitsounds[(gametic >> 2) & 7])
        }
        I_WaitVBL(105)
    }
    I_Quit()
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doom_all__M_SelectEndMessage : uint8? {
    var endmsg : uint8 ??
    if ((gamemission == GameMission_t.pack_chex ? uint(GameMission_t.doom) :
                (gamemission == GameMission_t.pack_hacx ? uint(GameMission_t.doom2) : uint(gamemission))) ==
            uint(GameMission_t.doom)) {
        // Doom 1
        endmsg = addr(doom1_endmsg[0])
    } else {
        // Doom 2
        endmsg = addr(doom2_endmsg[0])
    }
    return endmsg[gametic % NUM_QUITMESSAGES]
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_QuitDOOM(choice : int) {
    snprintf(addr(endstring[0]), uint64(typeinfo sizeof(type<uint8[160]>)), cstr("%s\n\n(press y to quit to dos.)"), doom_all__M_SelectEndMessage())
    M_StartMessage(addr(endstring[0]), reinterpret<void?>(@@M_QuitResponse), 1u)
}

[unsafe_deref, hint(unsafe_range_check)]
def M_ChangeSensitivity(choice : int) {
    c_switch(choice) {
        case(0) {
            if (mouseSensitivity != 0) {
                mouseSensitivity--
            }
            break
        }
        case(1) {
            if (mouseSensitivity < 9) {
                mouseSensitivity++
            }
            break
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def M_ChangeDetail(var choice : int) {
    choice = 0
    detailLevel = 1 - detailLevel
    R_SetViewSize(screenblocks, detailLevel)
    if (detailLevel == 0) {
        players[consoleplayer].message = cstr("High detail")
    } else {
        players[consoleplayer].message = cstr("Low detail")
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def M_SizeDisplay(choice : int) {
    c_switch(choice) {
        case(0) {
            if (screenSize > 0) {
                screenblocks--
                screenSize--
            }
            break
        }
        case(1) {
            if (screenSize < 8) {
                screenblocks++
                screenSize++
            }
            break
        }
    }
    R_SetViewSize(screenblocks, detailLevel)
}

// Menu Functions
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_DrawThermo(x : int; y : int; thermWidth : int; thermDot : int) {
    var xx : int
    xx = x
    V_DrawPatchDirect(xx, y, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_THERML"), int(anon_28.PU_CACHE))))
    xx += 8
    for (i in range(thermWidth)) {
        V_DrawPatchDirect(xx, y, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_THERMM"), int(anon_28.PU_CACHE))))
        xx += 8
    }
    V_DrawPatchDirect(xx, y, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_THERMR"), int(anon_28.PU_CACHE))))
    V_DrawPatchDirect((x + 8) + thermDot * 8, y, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_THERMO"), int(anon_28.PU_CACHE))))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_DrawEmptyCell(var menu : menu_s?; item : int) {
    V_DrawPatchDirect(int(menu.x) - 10, int(menu.y) + item * LINEHEIGHT - 1, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_CELL1"), int(anon_28.PU_CACHE))))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_DrawSelCell(var menu : menu_s?; item : int) {
    V_DrawPatchDirect(int(menu.x) - 10, int(menu.y) + item * LINEHEIGHT - 1, reinterpret<patch_t?>(W_CacheLumpName(cstr("M_CELL2"), int(anon_28.PU_CACHE))))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StartMessage(var _c_string : uint8?; var routine : void?; input : uint) {
    messageLastMenuActive = int(menuactive)
    messageToPrint = 1
    messageString = _c_string
    messageRoutine = reinterpret<function<(a0 : int) : void>>(routine)
    messageNeedsInput = input
    menuactive = 1u
    return
}

[unsafe_deref, hint(unsafe_range_check)]
def M_StopMessage {
    menuactive = uint(messageLastMenuActive)
    messageToPrint = 0
}

// Find string width from hu_font chars
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringWidth(var _c_string : uint8?) : int {
    var i : uint64
    var w : int = 0
    var c : int
    i = 0ul
    while (i < crt::strlen(_c_string)) {
        c = crt::toupper(int(_c_string[i])) - HU_FONTSTART
        if (c < 0 || c >= HU_FONTSIZE) {
            w += 4
        } else {
            w += int(hu_font[c].width)
        }
        i++
    }
    return w
}

// Find string height from hu_font chars
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringHeight(var _c_string : uint8?) : int {
    var i : uint64
    var h : int
    let height : int = int(hu_font[0].height)
    h = height
    i = 0ul
    while (i < crt::strlen(_c_string)) {
        if (_c_string[i] == '\n') {
            h += height
        }
        i++
    }
    return h
}

// Write a string using the hu_font
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_WriteText(x : int; y : int; var _c_string : uint8?) {
    var w : int
    var ch : uint8?
    var c : int
    var cx : int
    var cy : int
    ch = _c_string
    cx = x
    cy = y
    while (1 != 0) {
        var _t0 = ch
        ch++
        c = int(*_t0)
        if (c == 0) {
            break
        }
        if (c == '\n') {
            cx = x
            cy += 12
            continue
        }
        c = crt::toupper(c) - HU_FONTSTART
        if (c < 0 || c >= HU_FONTSIZE) {
            cx += 4
            continue
        }
        w = int(hu_font[c].width)
        if (cx + w > SCREENWIDTH) {
            break
        }
        V_DrawPatchDirect(cx, cy, hu_font[c])
        cx += w
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private doom_all__IsNullKey(key : int) : uint {
    return uint(int_of(key == KEY_PAUSE || key == KEY_CAPSLOCK || key == KEY_SCRLCK || key == KEY_NUMLOCK))
}

// M_Responder
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Responder(var ev : event_t?) : uint {
    var ch : int
    var key : int
    var i : int
    // In testcontrols mode, none of the function keys should do anything
    // - the only key is escape to quit.
    if (testcontrols != 0) {
        if (ev._c_type == evtype_t.ev_quit || (ev._c_type == evtype_t.ev_keydown && (ev.data1 == key_menu_activate || ev.data1 == key_menu_quit))) {
            I_Quit()
            return 1u
        }
        return 0u
    }
    // "close" button pressed on window?
    if (ev._c_type == evtype_t.ev_quit) {
        // First click on close button = bring up quit confirm message.
        // Second click on close button = confirm quit
        if (menuactive != 0 && messageToPrint != 0 && messageRoutine == @@M_QuitResponse) {
            M_QuitResponse(key_menu_confirm)
        } else {
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            M_QuitDOOM(0)
        }
        return 1u
    }
    // key is the key pressed, ch is the actual character typed
    ch = 0
    key = -1
    if (ev._c_type == evtype_t.ev_joystick && M_Responder_joywait < I_GetTime()) {
        if (ev.data3 < 0) {
            key = key_menu_up
            M_Responder_joywait = I_GetTime() + 5
        } elif (ev.data3 > 0) {
            key = key_menu_down
            M_Responder_joywait = I_GetTime() + 5
        }
        if (ev.data2 < 0) {
            key = key_menu_left
            M_Responder_joywait = I_GetTime() + 2
        } elif (ev.data2 > 0) {
            key = key_menu_right
            M_Responder_joywait = I_GetTime() + 2
        }
        if ((ev.data1 & 1) != 0) {
            key = key_menu_forward
            M_Responder_joywait = I_GetTime() + 5
        }
        if ((ev.data1 & 2) != 0) {
            key = key_menu_back
            M_Responder_joywait = I_GetTime() + 5
        }
        if (joybmenu >= 0 && (ev.data1 & (1 << joybmenu)) != 0) {
            key = key_menu_activate
            M_Responder_joywait = I_GetTime() + 5
        }
    } else {
        if (ev._c_type == evtype_t.ev_mouse && M_Responder_mousewait < I_GetTime()) {
            M_Responder_mousey += ev.data3
            if (M_Responder_mousey < M_Responder_lasty - 30) {
                key = key_menu_down
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lasty -= 30
                M_Responder_mousey = M_Responder_lasty
            } elif (M_Responder_mousey > M_Responder_lasty + 30) {
                key = key_menu_up
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lasty += 30
                M_Responder_mousey = M_Responder_lasty
            }
            M_Responder_mousex += ev.data2
            if (M_Responder_mousex < M_Responder_lastx - 30) {
                key = key_menu_left
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lastx -= 30
                M_Responder_mousex = M_Responder_lastx
            } elif (M_Responder_mousex > M_Responder_lastx + 30) {
                key = key_menu_right
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lastx += 30
                M_Responder_mousex = M_Responder_lastx
            }
            if ((ev.data1 & 1) != 0) {
                key = key_menu_forward
                M_Responder_mousewait = I_GetTime() + 15
            }
            if ((ev.data1 & 2) != 0) {
                key = key_menu_back
                M_Responder_mousewait = I_GetTime() + 15
            }
        } else {
            if (ev._c_type == evtype_t.ev_keydown) {
                key = ev.data1
                ch = ev.data2
            }
        }
    }
    if (key == -1) {
        return 0u
    }
    // Save Game string input
    if (saveStringEnter != 0) {
        c_switch(key) {
            case(127) {
                if (saveCharIndex > 0) {
                    saveCharIndex--
                    savegamestrings[saveSlot][saveCharIndex] = 0u8
                }
                break
            }
            case(27) {
                saveStringEnter = 0
                M_StringCopy(addr(savegamestrings[saveSlot][0]), addr(saveOldString[0]), uint64(SAVESTRINGSIZE))
                break
            }
            case(13) {
                saveStringEnter = 0
                if (savegamestrings[saveSlot][0] != 0) {
                    M_DoSave(saveSlot)
                }
                break
            }
            case(_) {
                // This is complicated.
                // Vanilla has a bug where the shift key is ignored when entering
                // a savegame name. If vanilla_keyboard_mapping is on, we want
                // to emulate this bug by using 'data1'. But if it's turned off,
                // it implies the user doesn't care about Vanilla emulation: just
                // use the correct 'data2'.
                if (vanilla_keyboard_mapping != 0) {
                    ch = key
                }
                ch = crt::toupper(ch)
                if (ch != ' ' && (ch - HU_FONTSTART < 0 || ch - HU_FONTSTART >= HU_FONTSIZE)) {
                    break
                }
                if (ch >= 32 && ch <= 127 && saveCharIndex < SAVESTRINGSIZE - 1 &&
                        M_StringWidth(addr(savegamestrings[saveSlot][0])) < (SAVESTRINGSIZE - 2) * 8) {
                    let _t0 = saveCharIndex
                    saveCharIndex++
                    savegamestrings[saveSlot][_t0] = uint8(ch)
                    savegamestrings[saveSlot][saveCharIndex] = 0u8
                }
                break
            }
        }
        return 1u
    }
    // Take care of any messages that need input
    if (messageToPrint != 0) {
        if (messageNeedsInput != 0) {
            if (key != ' ' && key != KEY_ESCAPE && key != key_menu_confirm && key != key_menu_abort) {
                return 0u
            }
        }
        menuactive = uint(messageLastMenuActive)
        messageToPrint = 0
        if (messageRoutine != null) {
            invoke(messageRoutine, key)
        }
        menuactive = 0u
        S_StartSound(null, int(sfxenum_t.sfx_swtchx))
        return 1u
    }
    if ((devparm != 0 && key == key_menu_help) || (key != 0 && key == key_menu_screenshot)) {
        G_ScreenShot()
        return 1u
    }
    // F-Keys
    if (menuactive == 0) {
        // Screen size down
        if (key == key_menu_decscreen) {
            if (automapactive != 0 || chat_on != 0) {
                return 0u
            }
            M_SizeDisplay(0)
            S_StartSound(null, int(sfxenum_t.sfx_stnmov))
            return 1u
        } elif (key == key_menu_incscreen) {
            // Screen size up
            if (automapactive != 0 || chat_on != 0) {
                return 0u
            }
            M_SizeDisplay(1)
            S_StartSound(null, int(sfxenum_t.sfx_stnmov))
            return 1u
        } elif (key == key_menu_help) {
            // Help key
            M_StartControlPanel()
            if (gamemode == GameMode_t.retail) {
                currentMenu = addr(ReadDef2)
            } else {
                currentMenu = addr(ReadDef1)
            }
            itemOn = int16(0)
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            return 1u
        } elif (key == key_menu_save) {
            // Save
            M_StartControlPanel()
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            M_SaveGame(0)
            return 1u
        } elif (key == key_menu_load) {
            // Load
            M_StartControlPanel()
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            M_LoadGame(0)
            return 1u
        } elif (key == key_menu_volume) {
            // Sound Volume
            M_StartControlPanel()
            currentMenu = addr(SoundDef)
            itemOn = int16(anon_1032.sfx_vol)
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            return 1u
        } elif (key == key_menu_detail) {
            // Detail toggle
            M_ChangeDetail(0)
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            return 1u
        } elif (key == key_menu_qsave) {
            // Quicksave
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            M_QuickSave()
            return 1u
        } elif (key == key_menu_endgame) {
            // End game
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            M_EndGame(0)
            return 1u
        } elif (key == key_menu_messages) {
            // Toggle messages
            M_ChangeMessages(0)
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            return 1u
        } elif (key == key_menu_qload) {
            // Quickload
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            M_QuickLoad()
            return 1u
        } elif (key == key_menu_quit) {
            // Quit DOOM
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            M_QuitDOOM(0)
            return 1u
        } elif (key == key_menu_gamma) {
            // gamma toggle
            usegamma++
            if (usegamma > 4) {
                usegamma = 0
            }
            players[consoleplayer].message = addr(gammamsg[usegamma][0])
            I_SetPalette(reinterpret<uint8?>(W_CacheLumpName(cstr("PLAYPAL"), int(anon_28.PU_CACHE))))
            return 1u
        }
    }
    // Pop-up menu?
    if (menuactive == 0) {
        if (key == key_menu_activate) {
            M_StartControlPanel()
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            return 1u
        }
        return 0u
    }
    // Keys usable within menu
    if (key == key_menu_down) {
        // Move down to next item
        c_do_while(currentMenu.menuitems[int(itemOn)].status == -1) {
            if (int(itemOn) + 1 > int(currentMenu.numitems) - 1) {
                itemOn = int16(0)
            } else {
                itemOn = int16(int(itemOn) + 1)
            }
            S_StartSound(null, int(sfxenum_t.sfx_pstop))
        }
        return 1u
    } elif (key == key_menu_up) {
        // Move back up to previous item
        c_do_while(currentMenu.menuitems[int(itemOn)].status == -1) {
            if (itemOn == 0) {
                itemOn = int16(int(currentMenu.numitems) - 1)
            } else {
                itemOn = int16(int(itemOn) - 1)
            }
            S_StartSound(null, int(sfxenum_t.sfx_pstop))
        }
        return 1u
    } elif (key == key_menu_left) {
        // Slide slider left
        if (currentMenu.menuitems[int(itemOn)].routine != null && currentMenu.menuitems[int(itemOn)].status == 2) {
            S_StartSound(null, int(sfxenum_t.sfx_stnmov))
            invoke(currentMenu.menuitems[int(itemOn)].routine, 0)
        }
        return 1u
    } elif (key == key_menu_right) {
        // Slide slider right
        if (currentMenu.menuitems[int(itemOn)].routine != null && currentMenu.menuitems[int(itemOn)].status == 2) {
            S_StartSound(null, int(sfxenum_t.sfx_stnmov))
            invoke(currentMenu.menuitems[int(itemOn)].routine, 1)
        }
        return 1u
    } elif (key == key_menu_forward) {
        // Activate menu item
        if (currentMenu.menuitems[int(itemOn)].routine != null && currentMenu.menuitems[int(itemOn)].status != 0) {
            currentMenu.lastOn = itemOn
            if (currentMenu.menuitems[int(itemOn)].status == 2) {
                // right arrow
                invoke(currentMenu.menuitems[int(itemOn)].routine, 1)
                S_StartSound(null, int(sfxenum_t.sfx_stnmov))
            } else {
                invoke(currentMenu.menuitems[int(itemOn)].routine, int(itemOn))
                S_StartSound(null, int(sfxenum_t.sfx_pistol))
            }
        }
        return 1u
    } elif (key == key_menu_activate) {
        // Deactivate menu
        currentMenu.lastOn = itemOn
        M_ClearMenus()
        S_StartSound(null, int(sfxenum_t.sfx_swtchx))
        return 1u
    } elif (key == key_menu_back) {
        // Go back to previous menu
        currentMenu.lastOn = itemOn
        if (currentMenu.prevMenu != null) {
            currentMenu = currentMenu.prevMenu
            itemOn = currentMenu.lastOn
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
        }
        return 1u
    } elif (ch != 0 || doom_all__IsNullKey(key) != 0) {
        // Keyboard shortcut?
        // Vanilla Doom has a weird behavior where it jumps to the scroll bars
        // when the certain keys are pressed, so emulate this.
        i = int(itemOn) + 1
        while (i < int(currentMenu.numitems)) {
            if (int(currentMenu.menuitems[i].alphaKey) == ch) {
                itemOn = int16(i)
                S_StartSound(null, int(sfxenum_t.sfx_pstop))
                return 1u
            }
            i++
        }
        i = 0
        while (i <= int(itemOn)) {
            if (int(currentMenu.menuitems[i].alphaKey) == ch) {
                itemOn = int16(i)
                S_StartSound(null, int(sfxenum_t.sfx_pstop))
                return 1u
            }
            i++
        }
    }
    return 0u
}

// M_StartControlPanel
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StartControlPanel {
    // intro might call this repeatedly
    if (menuactive != 0) {
        return
    }
    menuactive = 1u
    // JDC
    currentMenu = addr(MainDef)
    // JDC
    itemOn = currentMenu.lastOn
}

// M_Drawer
// Called after the view has been rendered,
// but before it has been blitted.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Drawer {
    var i : uint
    var max : uint
    var _c_string : uint8[80]
    var name : uint8?
    var start : int
    inhelpscreens = 0u
    // Horiz. & Vertically center string and print it.
    if (messageToPrint != 0) {
        start = 0
        M_Drawer_y = int16(SCREENHEIGHT / 2 - M_StringHeight(messageString) / 2)
        while (messageString[start] != '\0') {
            var foundnewline : int = 0
            i = 0u
            while (uint64(i) < crt::strlen(messageString + start)) {
                if (messageString[uint(start) + i] == '\n') {
                    M_StringCopy(addr(_c_string[0]), messageString + start, uint64(typeinfo sizeof(type<uint8[80]>)))
                    if (uint64(i) < uint64(typeinfo sizeof(type<uint8[80]>))) {
                        _c_string[i] = uint8('\0')
                    }
                    foundnewline = 1
                    start = int(uint(start) + (i + 1u))
                    break
                }
                i++
            }
            if (foundnewline == 0) {
                M_StringCopy(addr(_c_string[0]), messageString + start, uint64(typeinfo sizeof(type<uint8[80]>)))
                start = int(uint64(start) + crt::strlen(addr(_c_string[0])))
            }
            M_Drawer_x = int16(SCREENWIDTH / 2 - M_StringWidth(addr(_c_string[0])) / 2)
            M_WriteText(int(M_Drawer_x), int(M_Drawer_y), addr(_c_string[0]))
            M_Drawer_y = int16(int(M_Drawer_y) + int(hu_font[0].height))
        }
        return
    }
    // if (opldev)
    // {
    // M_DrawOPLDev();
    // }
    if (menuactive == 0) {
        return
    }
    if (currentMenu.routine != null) {
        // call Draw routine
        invoke(currentMenu.routine)
    }
    // DRAW MENU
    M_Drawer_x = currentMenu.x
    M_Drawer_y = currentMenu.y
    max = uint(currentMenu.numitems)
    for (i1 in urange(max)) {
        name = addr(currentMenu.menuitems[i1].name[0])
        if (name[0] != 0) {
            V_DrawPatchDirect(int(M_Drawer_x), int(M_Drawer_y), reinterpret<patch_t?>(W_CacheLumpName(name, int(anon_28.PU_CACHE))))
        }
        M_Drawer_y = int16(int(M_Drawer_y) + LINEHEIGHT)
    }
    // DRAW SKULL
    V_DrawPatchDirect(int(M_Drawer_x) + SKULLXOFF, int(currentMenu.y) - 5 + int(itemOn) * LINEHEIGHT,
            reinterpret<patch_t?>(W_CacheLumpName(skullName[int(whichSkull)], int(anon_28.PU_CACHE))))
}

// M_ClearMenus
[unsafe_deref, hint(unsafe_range_check)]
def M_ClearMenus {
    menuactive = 0u
}

// M_SetupNextMenu
[unsafe_deref, hint(unsafe_range_check)]
def M_SetupNextMenu(var menudef : menu_s?) {
    currentMenu = menudef
    itemOn = currentMenu.lastOn
}

// M_Ticker
[unsafe_deref, hint(unsafe_range_check)]
def M_Ticker {
    skullAnimCounter = int16(int(skullAnimCounter) - 1)
    if (int(skullAnimCounter) <= 0) {
        whichSkull = int16(int(whichSkull) ^ 1)
        skullAnimCounter = int16(8)
    }
}

// M_Init
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Init {
    currentMenu = addr(MainDef)
    menuactive = 0u
    itemOn = currentMenu.lastOn
    whichSkull = int16(0)
    skullAnimCounter = int16(10)
    screenSize = screenblocks - 3
    messageToPrint = 0
    messageString = null
    messageLastMenuActive = int(menuactive)
    quickSaveSlot = -1
    // Here we could catch other version dependencies,
    // like HELP1/2, and four episodes.
    c_switch(gamemode) {
        case(GameMode_t.commercial) {
            // Commercial has no "read this" entry.
            MainMenu[int(anon_1021.readthis)] = MainMenu[int(anon_1021.quitdoom)]
            MainDef.numitems = int16(int(MainDef.numitems) - 1)
            MainDef.y = int16(int(MainDef.y) + 8)
            NewDef.prevMenu = addr(MainDef)
            break
        }
        case(GameMode_t.shareware, GameMode_t.registered) {
            // Episode 2 and 3 are handled,
            // branching to an ad screen.
            break
        }
        case(GameMode_t.retail, _) {
            // We are fine.
            break
        }
    }
    // Versions of doom.exe before the Ultimate Doom release only had
    // three episodes; if we're emulating one of those then don't try
    // to show episode four. If we are, then do show episode four
    // (should crash if missing).
    if (uint(gameversion) < uint(GameVersion_t.exe_ultimate)) {
        EpiDef.numitems = int16(int(EpiDef.numitems) - 1)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_MakeDirectory(var path : uint8?) {
    crt::mkdir(path, 493u)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_FileExists(var filename : uint8?) : uint {
    var fstream : _IO_FILE?
    fstream = reinterpret<_IO_FILE?>(crt::fopen(filename, cstr("r")))
    if (fstream != null) {
        crt::fclose(reinterpret<void?>(fstream))
        return 1u
    } else {
        // If we can't open because the file is a directory, the
        // "file" exists at least!
        return uint(int_of(*crt::c_errno_location() == 21))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_FileLength(var handle : _IO_FILE?) : int64 {
    var savedpos : int64
    var length : int64
    // save the current position in the file
    savedpos = crt::ftell(reinterpret<void?>(handle))
    // jump to the end and find the length
    crt::fseek(reinterpret<void?>(handle), 0l, 2)
    length = crt::ftell(reinterpret<void?>(handle))
    // go back to the old location
    crt::fseek(reinterpret<void?>(handle), savedpos, 0)
    return length
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_WriteFile(var name : uint8?; var source : void?; length : int) : uint {
    var handle : _IO_FILE?
    var count : int
    handle = reinterpret<_IO_FILE?>(crt::fopen(name, cstr("wb")))
    if (handle == null) {
        return 0u
    }
    count = int(crt::fwrite(source, 1ul, uint64(length), reinterpret<void?>(handle)))
    crt::fclose(reinterpret<void?>(handle))
    if (count < length) {
        return 0u
    }
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_ReadFile(var name : uint8?; var buffer : uint8 ??) : int {
    var handle : _IO_FILE?
    var count : int
    var length : int
    var buf : uint8?
    handle = reinterpret<_IO_FILE?>(crt::fopen(name, cstr("rb")))
    if (handle == null) {
        I_Error`va(cstr("Couldn't read file %s"), (name,))
    }
    // find the size of the file by seeking to the end and
    // reading the current position
    length = int(M_FileLength(handle))
    buf = reinterpret<uint8?>(Z_Malloc(length, int(anon_28.PU_STATIC), null))
    count = int(crt::fread(reinterpret<void?>(buf), 1ul, uint64(length), reinterpret<void?>(handle)))
    crt::fclose(reinterpret<void?>(handle))
    if (count < length) {
        I_Error`va(cstr("Couldn't read file %s"), (name,))
    }
    *buffer = buf
    return length
}

[unsafe_deref, hint(unsafe_range_check)]
def M_TempFile(var s : uint8?) : uint8? {
    var tempdir : uint8?
    // Check the TEMP environment variable to find the location.
    // In Unix, just use /tmp.
    tempdir = cstr("/tmp")
    return M_StringJoin`va(tempdir, (cstr("/"), s, null))
}

[unsafe_deref, hint(unsafe_range_check)]
def M_StrToInt(var str : uint8?; var result : int?) : uint {
    return uint(int_of(sscanf(str, cstr(" 0x%x"), result) == 1 || sscanf(str, cstr(" 0X%x"), result) == 1 || sscanf(str, cstr(" 0%o"), result) == 1 ||
            sscanf(str, cstr(" %d"), result) == 1))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_ExtractFileBase(var path : uint8?; var dest : uint8?) {
    var src : uint8?
    var filename : uint8?
    var length : int
    src = path + crt::strlen(path) + -(1)
    // back up until a \ or the start
    while (src != path && int(*(src - 1)) != DIR_SEPARATOR) {
        src--
    }
    filename = src
    // Copy up to eight characters
    // Note: Vanilla Doom exits with an error if a filename is specified
    // with a base of more than eight characters. To remove the 8.3
    // filename limit, instead we simply truncate the name.
    length = 0
    crt::memset(reinterpret<void?>(dest), 0, 8ul)
    while (*src != '\0' && *src != '.') {
        if (length >= 8) {
            fprintf(crt::c_stderr(), cstr("Warning: Truncated '%s' lump name to '%.8s'.\n"), filename, dest)
            break
        }
        let _t0 = length
        length++
        var _t1 = src
        src++
        dest[_t0] = uint8(crt::toupper(int(*_t1)))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_ForceUppercase(var text : uint8?) {
    var p : uint8?
    p = text
    while (*p != '\0') {
        *p = uint8(crt::toupper(int(*p)))
        p++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StrCaseStr(var haystack : uint8?; var needle : uint8?) : uint8? {
    var haystack_len : uint
    var needle_len : uint
    var len : uint
    var i : uint
    haystack_len = uint(crt::strlen(haystack))
    needle_len = uint(crt::strlen(needle))
    if (haystack_len < needle_len) {
        return null
    }
    len = haystack_len - needle_len
    i = 0u
    while (i <= len) {
        if (crt::strncasecmp(haystack + i, needle, uint64(needle_len)) == 0) {
            return haystack + i
        }
        i++
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringDuplicate(var orig : uint8?) : uint8? {
    var result : uint8?
    result = crt::strdup(orig)
    if (result == null) {
        I_Error`va(cstr("Failed to duplicate string (length %i)\n"), (crt::strlen(orig),))
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringReplace(var haystack : uint8?; var needle : uint8?; var replacement : uint8?) : uint8? {
    var result : uint8?
    var dst : uint8?
    var p : uint8?
    let needle_len : uint64 = crt::strlen(needle)
    var result_len : uint64
    var dst_len : uint64
    // Iterate through occurrences of 'needle' and calculate the size of
    // the new string.
    result_len = crt::strlen(haystack) + 1ul
    p = haystack
    while (true) {
        p = crt::strstr(p, needle)
        if (p == null) {
            break
        }
        p += needle_len
        result_len += crt::strlen(replacement) - needle_len
    }
    // Construct new string.
    result = reinterpret<uint8?>(crt::malloc(result_len))
    if (result == null) {
        I_Error`va(cstr("M_StringReplace: Failed to allocate new string"), VaNone())
        return null
    }
    dst = result
    dst_len = result_len
    p = haystack
    while (*p != '\0') {
        if (crt::strncmp(p, needle, needle_len) == 0) {
            M_StringCopy(dst, replacement, dst_len)
            p += needle_len
            dst += crt::strlen(replacement)
            dst_len -= crt::strlen(replacement)
        } else {
            *dst = *p
            dst++
            dst_len--
            p++
        }
    }
    *dst = uint8('\0')
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringCopy(var dest : uint8?; var src : uint8?; dest_size : uint64) : uint {
    var len : uint64
    if (dest_size >= 1ul) {
        dest[dest_size - 1ul] = uint8('\0')
        crt::strncpy(dest, src, dest_size - 1ul)
    } else {
        return 0u
    }
    len = crt::strlen(dest)
    return uint(int_of(src[len] == '\0'))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringConcat(var dest : uint8?; var src : uint8?; dest_size : uint64) : uint {
    var offset : uint64
    offset = crt::strlen(dest)
    if (offset > dest_size) {
        offset = dest_size
    }
    return M_StringCopy(dest + offset, src, dest_size - offset)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringStartsWith(var s : uint8?; var prefix : uint8?) : uint {
    return uint(int_of(crt::strlen(s) > crt::strlen(prefix) && crt::strncmp(s, prefix, crt::strlen(prefix)) == 0))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringEndsWith(var s : uint8?; var suffix : uint8?) : uint {
    return uint(int_of(crt::strlen(s) >= crt::strlen(suffix) && crt::strcmp(s + crt::strlen(s) + -int64(crt::strlen(suffix)), suffix) == 0))
}

[c_function, unsafe_deref, hint(unsafe_range_check), variadic]
def M_StringJoin(var s : uint8?; va : va_args) : uint8? {
    var result : uint8?
    var v : uint8?
    var args : CVaCursor
    var result_len : uint64
    result_len = crt::strlen(s) + 1ul
    args = va_begin(va)
    while (true) {
        v = reinterpret<uint8?>(va_p(args))
        if (v == null) {
            break
        }
        result_len += crt::strlen(v)
    }
    result = reinterpret<uint8?>(crt::malloc(result_len))
    if (result == null) {
        I_Error`va(cstr("M_StringJoin: Failed to allocate new string."), VaNone())
        return null
    }
    M_StringCopy(result, s, result_len)
    args = va_begin(va)
    while (true) {
        v = reinterpret<uint8?>(va_p(args))
        if (v == null) {
            break
        }
        M_StringConcat(result, v, result_len)
    }
    return result
}

// Safe, portable vsnprintf().
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_vsnprintf(var buf : uint8?; buf_len : uint64; var s : uint8?; var args : CVaCursor) : int {
    var result : int
    if (buf_len < 1ul) {
        return 0
    }
    // Windows (and other OSes?) has a vsnprintf() that doesn't always
    // append a trailing \0. So we must do it, and write into a buffer
    // that is one byte shorter; otherwise this function is unsafe.
    result = c_vsnprintf(buf, buf_len, s, va_rest(args))
    // If truncated, change the final char in the buffer to a \0.
    // A negative result indicates a truncated buffer on Windows.
    if (result < 0 || uint64(result) >= buf_len) {
        buf[buf_len - 1ul] = uint8('\0')
        result = int(buf_len - 1ul)
    }
    return result
}

// Safe, portable snprintf().
[unsafe_deref, hint(unsafe_range_check), variadic]
def M_snprintf(var buf : uint8?; buf_len : uint64; var s : uint8?; va : va_args) : int {
    var args : CVaCursor
    var result : int
    args = va_begin(va)
    result = M_vsnprintf(buf, buf_len, s, args)
    return result
}

// Which one is deterministic?
[unsafe_deref, hint(unsafe_range_check)]
def P_Random : int {
    prndindex = (prndindex + 1) & 255
    return int(doom_all__rndtable[prndindex])
}

[unsafe_deref, hint(unsafe_range_check)]
def M_Random : int {
    rndindex = (rndindex + 1) & 255
    return int(doom_all__rndtable[rndindex])
}

[unsafe_deref, hint(unsafe_range_check)]
def M_ClearRandom {
    prndindex = 0
    rndindex = prndindex
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def T_MoveCeiling(var ceiling : ceiling_t?) {
    var res : result_e
    c_switch(ceiling.direction) {
        case(0) {
            // IN STASIS
            break
        }
        case(1) {
            // UP
            res = T_MovePlane(ceiling.sector, ceiling.speed, ceiling.topheight, 0u, 1, ceiling.direction)
            if ((leveltime & 7) == 0) {
                c_switch(ceiling._c_type) {
                    case(ceiling_e.silentCrushAndRaise) {
                        break
                    }
                    case(_) {
                        S_StartSound(reinterpret<void?>(addr(ceiling.sector.soundorg)), int(sfxenum_t.sfx_stnmov))
                        // ?
                        break
                    }
                }
            }
            if (res == result_e.pastdest) {
                c_switch(ceiling._c_type) {
                    case(ceiling_e.raiseToHighest) {
                        P_RemoveActiveCeiling(ceiling)
                        break
                    }
                    case(ceiling_e.silentCrushAndRaise) {
                        S_StartSound(reinterpret<void?>(addr(ceiling.sector.soundorg)), int(sfxenum_t.sfx_pstop))
                    }
                    case(ceiling_e.fastCrushAndRaise, ceiling_e.crushAndRaise) {
                        ceiling.direction = -1
                        break
                    }
                    case(_) {
                        break
                    }
                }
            }
            break
        }
        case(-1) {
            // DOWN
            res = T_MovePlane(ceiling.sector, ceiling.speed, ceiling.bottomheight, ceiling.crush, 1, ceiling.direction)
            if ((leveltime & 7) == 0) {
                c_switch(ceiling._c_type) {
                    case(ceiling_e.silentCrushAndRaise) {
                        break
                    }
                    case(_) {
                        S_StartSound(reinterpret<void?>(addr(ceiling.sector.soundorg)), int(sfxenum_t.sfx_stnmov))
                    }
                }
            }
            if (res == result_e.pastdest) {
                c_switch(ceiling._c_type) {
                    case(ceiling_e.silentCrushAndRaise) {
                        S_StartSound(reinterpret<void?>(addr(ceiling.sector.soundorg)), int(sfxenum_t.sfx_pstop))
                    }
                    case(ceiling_e.crushAndRaise) {
                        ceiling.speed = FRACUNIT
                    }
                    case(ceiling_e.fastCrushAndRaise) {
                        ceiling.direction = 1
                        break
                    }
                    case(ceiling_e.lowerAndCrush, ceiling_e.lowerToFloor) {
                        P_RemoveActiveCeiling(ceiling)
                        break
                    }
                    case(_) {
                        break
                    }
                }
            } else {
                // ( res != pastdest )
                if (res == result_e.crushed) {
                    c_switch(ceiling._c_type) {
                        case(ceiling_e.silentCrushAndRaise, ceiling_e.crushAndRaise, ceiling_e.lowerAndCrush) {
                            ceiling.speed = FRACUNIT / 8
                            break
                        }
                        case(_) {
                            break
                        }
                    }
                }
            }
            break
        }
    }
}

// EV_DoCeiling
// Move a ceiling up/down and all around!
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_DoCeiling(var line : line_s?; _c_type : ceiling_e) : int {
    var secnum : int
    var rtn : int
    var sec : sector_t?
    var ceiling : ceiling_t?
    secnum = -1
    rtn = 0
    // Reactivate in-stasis ceilings...for certain types.
    c_switch(_c_type) {
        case(ceiling_e.fastCrushAndRaise, ceiling_e.silentCrushAndRaise, ceiling_e.crushAndRaise) {
            P_ActivateInStasisCeiling(line)
        }
        case(_) {
            break
        }
    }
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        if (sec.specialdata != null) {
            continue
        }
        // new door thinker
        rtn = 1
        ceiling = reinterpret<ceiling_t?>(Z_Malloc(typeinfo sizeof(type<ceiling_t>), int(anon_28.PU_LEVSPEC), null))
        P_AddThinker(addr(ceiling.thinker))
        sec.specialdata = reinterpret<void?>(ceiling)
        ceiling.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveCeiling)
        ceiling.sector = sec
        ceiling.crush = 0u
        c_switch(_c_type) {
            case(ceiling_e.fastCrushAndRaise) {
                ceiling.crush = 1u
                ceiling.topheight = sec.ceilingheight
                ceiling.bottomheight = sec.floorheight + (8 * FRACUNIT)
                ceiling.direction = -1
                ceiling.speed = FRACUNIT * 2
                break
            }
            case(ceiling_e.silentCrushAndRaise, ceiling_e.crushAndRaise) {
                ceiling.crush = 1u
                ceiling.topheight = sec.ceilingheight
            }
            case(ceiling_e.lowerAndCrush, ceiling_e.lowerToFloor) {
                ceiling.bottomheight = sec.floorheight
                if (_c_type != ceiling_e.lowerToFloor) {
                    ceiling.bottomheight += 8 * FRACUNIT
                }
                ceiling.direction = -1
                ceiling.speed = FRACUNIT
                break
            }
            case(ceiling_e.raiseToHighest) {
                ceiling.topheight = P_FindHighestCeilingSurrounding(sec)
                ceiling.direction = 1
                ceiling.speed = FRACUNIT
                break
            }
        }
        ceiling.tag = int(sec.tag)
        ceiling._c_type = _c_type
        P_AddActiveCeiling(ceiling)
    }
    return rtn
}

// Add an active ceiling
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_AddActiveCeiling(var c : ceiling_t?) {
    for (i in range(MAXCEILINGS)) {
        if (activeceilings[i] == null) {
            activeceilings[i] = c
            return
        }
    }
}

// Remove a ceiling's thinker
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RemoveActiveCeiling(var c : ceiling_t?) {
    for (i in range(MAXCEILINGS)) {
        if (activeceilings[i] == c) {
            activeceilings[i].sector.specialdata = null
            P_RemoveThinker(addr(activeceilings[i].thinker))
            activeceilings[i] = null
            break
        }
    }
}

// Restart a ceiling that's in-stasis
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ActivateInStasisCeiling(var line : line_s?) {
    for (i in range(MAXCEILINGS)) {
        if (activeceilings[i] != null && (activeceilings[i].tag == int(line.tag)) && (activeceilings[i].direction == 0)) {
            activeceilings[i].direction = activeceilings[i].olddirection
            activeceilings[i].thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveCeiling)
        }
    }
}

// EV_CeilingCrushStop
// Stop a ceiling from crushing!
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_CeilingCrushStop(var line : line_s?) : int {
    var rtn : int
    rtn = 0
    for (i in range(MAXCEILINGS)) {
        if (activeceilings[i] != null && (activeceilings[i].tag == int(line.tag)) && (activeceilings[i].direction != 0)) {
            activeceilings[i].olddirection = activeceilings[i].direction
            activeceilings[i].thinker._c_function.acv = reinterpret<function<() : void>>(null)
            // in-stasis
            activeceilings[i].direction = 0
            rtn = 1
        }
    }
    return rtn
}

// T_VerticalDoor
[c_function, unsafe_deref, hint(unsafe_range_check)]
def T_VerticalDoor(var door : vldoor_t?) {
    var res : result_e
    c_switch(door.direction) {
        case(0) {
            // WAITING
            door.topcountdown--
            if (door.topcountdown == 0) {
                c_switch(door._c_type) {
                    case(vldoor_e.vld_blazeRaise) {
                        // time to go back down
                        door.direction = -1
                        S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_bdcls))
                        break
                    }
                    case(vldoor_e.vld_normal) {
                        // time to go back down
                        door.direction = -1
                        S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_dorcls))
                        break
                    }
                    case(vldoor_e.vld_close30ThenOpen) {
                        door.direction = 1
                        S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_doropn))
                        break
                    }
                    case(_) {
                        break
                    }
                }
            }
            break
        }
        case(2) {
            // INITIAL WAIT
            door.topcountdown--
            if (door.topcountdown == 0) {
                c_switch(door._c_type) {
                    case(vldoor_e.vld_raiseIn5Mins) {
                        door.direction = 1
                        door._c_type = vldoor_e.vld_normal
                        S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_doropn))
                        break
                    }
                    case(_) {
                        break
                    }
                }
            }
            break
        }
        case(-1) {
            // DOWN
            res = T_MovePlane(door.sector, door.speed, door.sector.floorheight, 0u, 1, door.direction)
            if (res == result_e.pastdest) {
                c_switch(door._c_type) {
                    case(vldoor_e.vld_blazeRaise, vldoor_e.vld_blazeClose) {
                        door.sector.specialdata = null
                        // unlink and free
                        P_RemoveThinker(addr(door.thinker))
                        S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_bdcls))
                        break
                    }
                    case(vldoor_e.vld_normal, vldoor_e.vld_close) {
                        door.sector.specialdata = null
                        // unlink and free
                        P_RemoveThinker(addr(door.thinker))
                        break
                    }
                    case(vldoor_e.vld_close30ThenOpen) {
                        door.direction = 0
                        door.topcountdown = TICRATE * 30
                        break
                    }
                    case(_) {
                        break
                    }
                }
            } elif (res == result_e.crushed) {
                c_switch(door._c_type) {
                    case(vldoor_e.vld_blazeClose, vldoor_e.vld_close) {
                        // DO NOT GO BACK UP!
                        break
                    }
                    case(_) {
                        door.direction = 1
                        S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_doropn))
                        break
                    }
                }
            }
            break
        }
        case(1) {
            // UP
            res = T_MovePlane(door.sector, door.speed, door.topheight, 0u, 1, door.direction)
            if (res == result_e.pastdest) {
                c_switch(door._c_type) {
                    case(vldoor_e.vld_blazeRaise, vldoor_e.vld_normal) {
                        // wait at top
                        door.direction = 0
                        door.topcountdown = door.topwait
                        break
                    }
                    case(vldoor_e.vld_close30ThenOpen, vldoor_e.vld_blazeOpen, vldoor_e.vld_open) {
                        door.sector.specialdata = null
                        // unlink and free
                        P_RemoveThinker(addr(door.thinker))
                        break
                    }
                    case(_) {
                        break
                    }
                }
            }
            break
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def EV_DoLockedDoor(var line : line_s?; _c_type : vldoor_e; var thing : mobj_s?) : int {
    var p : player_s?
    p = thing.player
    if (p == null) {
        return 0
    }
    c_switch(int(line.special)) {
        case(99, 133) {
            // Blue Lock
            if (p == null) {
                return 0
            }
            if (p.cards[int(card_t.it_bluecard)] == 0 && p.cards[int(card_t.it_blueskull)] == 0) {
                p.message = cstr("You need a blue key to activate this object")
                S_StartSound(null, int(sfxenum_t.sfx_oof))
                return 0
            }
            break
        }
        case(134, 135) {
            // Red Lock
            if (p == null) {
                return 0
            }
            if (p.cards[int(card_t.it_redcard)] == 0 && p.cards[int(card_t.it_redskull)] == 0) {
                p.message = cstr("You need a red key to activate this object")
                S_StartSound(null, int(sfxenum_t.sfx_oof))
                return 0
            }
            break
        }
        case(136, 137) {
            // Yellow Lock
            if (p == null) {
                return 0
            }
            if (p.cards[int(card_t.it_yellowcard)] == 0 && p.cards[int(card_t.it_yellowskull)] == 0) {
                p.message = cstr("You need a yellow key to activate this object")
                S_StartSound(null, int(sfxenum_t.sfx_oof))
                return 0
            }
            break
        }
    }
    return EV_DoDoor(line, _c_type)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_DoDoor(var line : line_s?; _c_type : vldoor_e) : int {
    var secnum : int
    var rtn : int
    var sec : sector_t?
    var door : vldoor_t?
    secnum = -1
    rtn = 0
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        if (sec.specialdata != null) {
            continue
        }
        // new door thinker
        rtn = 1
        door = reinterpret<vldoor_t?>(Z_Malloc(typeinfo sizeof(type<vldoor_t>), int(anon_28.PU_LEVSPEC), null))
        P_AddThinker(addr(door.thinker))
        sec.specialdata = reinterpret<void?>(door)
        door.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_VerticalDoor)
        door.sector = sec
        door._c_type = _c_type
        door.topwait = VDOORWAIT
        door.speed = FRACUNIT * 2
        c_switch(_c_type) {
            case(vldoor_e.vld_blazeClose) {
                door.topheight = P_FindLowestCeilingSurrounding(sec)
                door.topheight -= 4 * FRACUNIT
                door.direction = -1
                door.speed = FRACUNIT * 2 * 4
                S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_bdcls))
                break
            }
            case(vldoor_e.vld_close) {
                door.topheight = P_FindLowestCeilingSurrounding(sec)
                door.topheight -= 4 * FRACUNIT
                door.direction = -1
                S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_dorcls))
                break
            }
            case(vldoor_e.vld_close30ThenOpen) {
                door.topheight = sec.ceilingheight
                door.direction = -1
                S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_dorcls))
                break
            }
            case(vldoor_e.vld_blazeRaise, vldoor_e.vld_blazeOpen) {
                door.direction = 1
                door.topheight = P_FindLowestCeilingSurrounding(sec)
                door.topheight -= 4 * FRACUNIT
                door.speed = FRACUNIT * 2 * 4
                if (door.topheight != sec.ceilingheight) {
                    S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_bdopn))
                }
                break
            }
            case(vldoor_e.vld_normal, vldoor_e.vld_open) {
                door.direction = 1
                door.topheight = P_FindLowestCeilingSurrounding(sec)
                door.topheight -= 4 * FRACUNIT
                if (door.topheight != sec.ceilingheight) {
                    S_StartSound(reinterpret<void?>(addr(door.sector.soundorg)), int(sfxenum_t.sfx_doropn))
                }
                break
            }
            case(_) {
                break
            }
        }
    }
    return rtn
}

// EV_VerticalDoor : open a door manually, no tag value
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_VerticalDoor(var line : line_s?; var thing : mobj_s?) {
    var player : player_s?
    var sec : sector_t?
    var door : vldoor_t?
    var side : int
    // only front sides can be used
    side = 0
    // Check for locks
    player = thing.player
    c_switch(int(line.special)) {
        case(26, 32) {
            // Blue Lock
            if (player == null) {
                return
            }
            if (player.cards[int(card_t.it_bluecard)] == 0 && player.cards[int(card_t.it_blueskull)] == 0) {
                player.message = cstr("You need a blue key to open this door")
                S_StartSound(null, int(sfxenum_t.sfx_oof))
                return
            }
            break
        }
        case(27, 34) {
            // Yellow Lock
            if (player == null) {
                return
            }
            if (player.cards[int(card_t.it_yellowcard)] == 0 && player.cards[int(card_t.it_yellowskull)] == 0) {
                player.message = cstr("You need a yellow key to open this door")
                S_StartSound(null, int(sfxenum_t.sfx_oof))
                return
            }
            break
        }
        case(28, 33) {
            // Red Lock
            if (player == null) {
                return
            }
            if (player.cards[int(card_t.it_redcard)] == 0 && player.cards[int(card_t.it_redskull)] == 0) {
                player.message = cstr("You need a red key to open this door")
                S_StartSound(null, int(sfxenum_t.sfx_oof))
                return
            }
            break
        }
    }
    // if the sector has an active thinker, use it
    sec = sides[int(line.sidenum[side ^ 1])].sector
    if (sec.specialdata != null) {
        door = reinterpret<vldoor_t?>(sec.specialdata)
        c_switch(int(line.special)) {
            case(1, 26, 27, 28, 117) {
                // ONLY FOR "RAISE" DOORS, NOT "OPEN"s
                if (door.direction == -1) {
                    // go back up
                    door.direction = 1
                } else {
                    if (thing.player == null) {
                        // JDC: bad guys never close doors
                        return
                    }
                    // When is a door not a door?
                    // In Vanilla, door->direction is set, even though
                    // "specialdata" might not actually point at a door.
                    if (door.thinker._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_VerticalDoor)) {
                        // start going down immediately
                        door.direction = -1
                    } elif (door.thinker._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@T_PlatRaise)) {
                        // Erm, this is a plat, not a door.
                        // This notably causes a problem in ep1-0500.lmp where
                        // a plat and a door are cross-referenced; the door
                        // doesn't open on 64-bit.
                        // The direction field in vldoor_t corresponds to the wait
                        // field in plat_t. Let's set that to -1 instead.
                        var plat : plat_t?
                        plat = reinterpret<plat_t?>(door)
                        plat.wait = -1
                    } else {
                        // This isn't a door OR a plat. Now we're in trouble.
                        fprintf(crt::c_stderr(), cstr("EV_VerticalDoor: Tried to close something that wasn't a door.\n"))
                        // Try closing it anyway. At least it will work on 32-bit
                        // machines.
                        door.direction = -1
                    }
                }
                return
            }
        }
    }
    // for proper sound
    c_switch(int(line.special)) {
        case(117, 118) {
            // BLAZING DOOR RAISE
            // BLAZING DOOR OPEN
            S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_bdopn))
            break
        }
        case(1, 31) {
            // NORMAL DOOR SOUND
            S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_doropn))
            break
        }
        case(_) {
            // LOCKED DOOR SOUND
            S_StartSound(reinterpret<void?>(addr(sec.soundorg)), int(sfxenum_t.sfx_doropn))
            break
        }
    }
    // new door thinker
    door = reinterpret<vldoor_t?>(Z_Malloc(typeinfo sizeof(type<vldoor_t>), int(anon_28.PU_LEVSPEC), null))
    P_AddThinker(addr(door.thinker))
    sec.specialdata = reinterpret<void?>(door)
    door.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_VerticalDoor)
    door.sector = sec
    door.direction = 1
    door.speed = FRACUNIT * 2
    door.topwait = VDOORWAIT
    c_switch(int(line.special)) {
        case(1, 26, 27, 28) {
            door._c_type = vldoor_e.vld_normal
            break
        }
        case(31, 32, 33, 34) {
            door._c_type = vldoor_e.vld_open
            line.special = int16(0)
            break
        }
        case(117) {
            // blazing door raise
            door._c_type = vldoor_e.vld_blazeRaise
            door.speed = FRACUNIT * 2 * 4
            break
        }
        case(118) {
            // blazing door open
            door._c_type = vldoor_e.vld_blazeOpen
            line.special = int16(0)
            door.speed = FRACUNIT * 2 * 4
            break
        }
    }
    // find the top and bottom of the movement range
    door.topheight = P_FindLowestCeilingSurrounding(sec)
    door.topheight -= 4 * FRACUNIT
}

// Spawn a door that closes after 30 seconds
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnDoorCloseIn30(var sec : sector_t?) {
    var door : vldoor_t?
    door = reinterpret<vldoor_t?>(Z_Malloc(typeinfo sizeof(type<vldoor_t>), int(anon_28.PU_LEVSPEC), null))
    P_AddThinker(addr(door.thinker))
    sec.specialdata = reinterpret<void?>(door)
    sec.special = int16(0)
    door.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_VerticalDoor)
    door.sector = sec
    door.direction = 0
    door._c_type = vldoor_e.vld_normal
    door.speed = FRACUNIT * 2
    door.topcountdown = 30 * TICRATE
}

// Spawn a door that opens after 5 minutes
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnDoorRaiseIn5Mins(var sec : sector_t?; secnum : int) {
    var door : vldoor_t?
    door = reinterpret<vldoor_t?>(Z_Malloc(typeinfo sizeof(type<vldoor_t>), int(anon_28.PU_LEVSPEC), null))
    P_AddThinker(addr(door.thinker))
    sec.specialdata = reinterpret<void?>(door)
    sec.special = int16(0)
    door.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_VerticalDoor)
    door.sector = sec
    door.direction = 2
    door._c_type = vldoor_e.vld_raiseIn5Mins
    door.speed = FRACUNIT * 2
    door.topheight = P_FindLowestCeilingSurrounding(sec)
    door.topheight -= 4 * FRACUNIT
    door.topwait = VDOORWAIT
    door.topcountdown = 5 * 60 * TICRATE
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RecursiveSound(var sec : sector_t?; soundblocks : int) {
    var i : int
    var check : line_s?
    var other : sector_t?
    // wake up all monsters in this sector
    if (sec.validcount == validcount && sec.soundtraversed <= soundblocks + 1) {
        // already flooded
        return
    }
    sec.validcount = validcount
    sec.soundtraversed = soundblocks + 1
    sec.soundtarget = soundtarget
    i = 0
    while (i < sec.linecount) {
        {
            check = sec.lines[i]
            if ((int(check.flags) & ML_TWOSIDED) == 0) {
                continue
            }
            P_LineOpening(check)
            if (openrange <= 0) {
                // closed door
                continue
            }
            if (sides[int(check.sidenum[0])].sector == sec) {
                other = sides[int(check.sidenum[1])].sector
            } else {
                other = sides[int(check.sidenum[0])].sector
            }
            if ((int(check.flags) & ML_SOUNDBLOCK) != 0) {
                if (soundblocks == 0) {
                    P_RecursiveSound(other, 1)
                }
            } else {
                P_RecursiveSound(other, soundblocks)
            }
        } finally {
            i++
        }
    }
}

// P_NoiseAlert
// If a monster yells at a player,
// it will alert other monsters to the player.
[unsafe_deref, hint(unsafe_range_check)]
def P_NoiseAlert(var target : mobj_s?; var emmiter : mobj_s?) {
    soundtarget = target
    validcount++
    P_RecursiveSound(emmiter.subsector.sector, 0)
}

// P_CheckMeleeRange
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckMeleeRange(var actor : mobj_s?) : uint {
    var pl : mobj_s?
    var dist : int
    if (actor.target == null) {
        return 0u
    }
    pl = actor.target
    dist = P_AproxDistance(pl.x - actor.x, pl.y - actor.y)
    if (dist >= MELEERANGE - 20 * FRACUNIT + pl.info.radius) {
        return 0u
    }
    if (P_CheckSight(actor, actor.target) == 0) {
        return 0u
    }
    return 1u
}

// P_CheckMissileRange
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckMissileRange(var actor : mobj_s?) : uint {
    var dist : int
    if (P_CheckSight(actor, actor.target) == 0) {
        return 0u
    }
    if ((actor.flags & int(mobjflag_t.MF_JUSTHIT)) != 0) {
        // the target just hit the enemy,
        // so fight back!
        actor.flags &= ~int(mobjflag_t.MF_JUSTHIT)
        return 1u
    }
    if (actor.reactiontime != 0) {
        // do not attack yet
        return 0u
    }
    // OPTIMIZE: get this from a global checksight
    dist = P_AproxDistance(actor.x - actor.target.x, actor.y - actor.target.y) - 64 * FRACUNIT
    if (actor.info.meleestate == 0) {
        // no melee attack, so fire more
        dist -= 128 * FRACUNIT
    }
    dist >>= 16
    if (actor._c_type == mobjtype_t.MT_VILE) {
        if (dist > 14 * 64) {
            // too far away
            return 0u
        }
    }
    if (actor._c_type == mobjtype_t.MT_UNDEAD) {
        if (dist < 196) {
            // close for fist attack
            return 0u
        }
        dist >>= 1
    }
    if (actor._c_type == mobjtype_t.MT_CYBORG || actor._c_type == mobjtype_t.MT_SPIDER || actor._c_type == mobjtype_t.MT_SKULL) {
        dist >>= 1
    }
    if (dist > 200) {
        dist = 200
    }
    if (actor._c_type == mobjtype_t.MT_CYBORG && dist > 160) {
        dist = 160
    }
    if (P_Random() < dist) {
        return 0u
    }
    return 1u
}

[unsafe_deref, hint(unsafe_range_check)]
def P_Move(var actor : mobj_s?) : uint {
    var tryx : int
    var tryy : int
    var ld : line_s?
    // warning: 'catch', 'throw', and 'try'
    // are all C++ reserved words
    var try_ok : uint
    var good : uint
    if (actor.movedir == int(dirtype_t.DI_NODIR)) {
        return 0u
    }
    if (uint(actor.movedir) >= 8u) {
        I_Error`va(cstr("Weird actor->movedir!"), VaNone())
    }
    tryx = actor.x + actor.info.speed * xspeed[actor.movedir]
    tryy = actor.y + actor.info.speed * yspeed[actor.movedir]
    try_ok = P_TryMove(actor, tryx, tryy)
    if (try_ok == 0) {
        // open any specials
        if ((actor.flags & int(mobjflag_t.MF_FLOAT)) != 0 && floatok != 0) {
            // must adjust height
            if (actor.z < tmfloorz) {
                actor.z += FLOATSPEED
            } else {
                actor.z -= FLOATSPEED
            }
            actor.flags |= int(mobjflag_t.MF_INFLOAT)
            return 1u
        }
        if (numspechit == 0) {
            return 0u
        }
        actor.movedir = int(dirtype_t.DI_NODIR)
        good = 0u
        while (true) {
            let _t0 = numspechit
            numspechit--
            if (_t0 == 0) {
                break
            }
            ld = spechit[numspechit]
            // if the special is not a door
            // that can be opened,
            // return false
            if (P_UseSpecialLine(actor, ld, 0) != 0) {
                good = 1u
            }
        }
        return good
    } else {
        actor.flags &= ~int(mobjflag_t.MF_INFLOAT)
    }
    if ((actor.flags & int(mobjflag_t.MF_FLOAT)) == 0) {
        actor.z = actor.floorz
    }
    return 1u
}

// TryWalk
// Attempts to move actor on
// in its current (ob->moveangle) direction.
// If blocked by either a wall or an actor
// returns FALSE
// If move is either clear or blocked only by a door,
// returns TRUE and sets...
// If a door is in the way,
// an OpenDoor call is made to start it opening.
[unsafe_deref, hint(unsafe_range_check)]
def P_TryWalk(var actor : mobj_s?) : uint {
    if (P_Move(actor) == 0) {
        return 0u
    }
    actor.movecount = P_Random() & 15
    return 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_NewChaseDir(var actor : mobj_s?) {
    var deltax : int
    var deltay : int
    var d : dirtype_t[3]
    var tdir : int
    var olddir : dirtype_t
    var turnaround : dirtype_t
    if (actor.target == null) {
        I_Error`va(cstr("P_NewChaseDir: called with no target"), VaNone())
    }
    olddir = enum_from_int(type<dirtype_t>, actor.movedir)
    turnaround = opposite[int(olddir)]
    deltax = actor.target.x - actor.x
    deltay = actor.target.y - actor.y
    if (deltax > 10 * FRACUNIT) {
        d[1] = dirtype_t.DI_EAST
    } elif (deltax < -10 * FRACUNIT) {
        d[1] = dirtype_t.DI_WEST
    } else {
        d[1] = dirtype_t.DI_NODIR
    }
    if (deltay < -10 * FRACUNIT) {
        d[2] = dirtype_t.DI_SOUTH
    } elif (deltay > 10 * FRACUNIT) {
        d[2] = dirtype_t.DI_NORTH
    } else {
        d[2] = dirtype_t.DI_NODIR
    }
    // try direct route
    if (d[1] != dirtype_t.DI_NODIR && d[2] != dirtype_t.DI_NODIR) {
        actor.movedir = int(diags[(int_of(deltay < 0) << 1) + int_of(deltax > 0)])
        if (actor.movedir != int(turnaround) && P_TryWalk(actor) != 0) {
            return
        }
    }
    // try other directions
    if (P_Random() > 200 || crt::abs(deltay) > crt::abs(deltax)) {
        tdir = int(d[1])
        d[1] = d[2]
        d[2] = enum_from_int(type<dirtype_t>, tdir)
    }
    if (d[1] == turnaround) {
        d[1] = dirtype_t.DI_NODIR
    }
    if (d[2] == turnaround) {
        d[2] = dirtype_t.DI_NODIR
    }
    if (d[1] != dirtype_t.DI_NODIR) {
        actor.movedir = int(d[1])
        if (P_TryWalk(actor) != 0) {
            // either moved forward or attacked
            return
        }
    }
    if (d[2] != dirtype_t.DI_NODIR) {
        actor.movedir = int(d[2])
        if (P_TryWalk(actor) != 0) {
            return
        }
    }
    // there is no direct path to the player,
    // so pick another direction.
    if (olddir != dirtype_t.DI_NODIR) {
        actor.movedir = int(olddir)
        if (P_TryWalk(actor) != 0) {
            return
        }
    }
    // randomly determine direction of search
    if ((P_Random() & 1) != 0) {
        for (tdir1 in range(int(dirtype_t.DI_EAST), int(dirtype_t.DI_SOUTHEAST) + 1)) {
            if (tdir1 != int(turnaround)) {
                actor.movedir = tdir1
                if (P_TryWalk(actor) != 0) {
                    return
                }
            }
        }
    } else {
        tdir = int(dirtype_t.DI_SOUTHEAST)
        while (tdir != (int(dirtype_t.DI_EAST) - 1)) {
            if (tdir != int(turnaround)) {
                actor.movedir = tdir
                if (P_TryWalk(actor) != 0) {
                    return
                }
            }
            tdir--
        }
    }
    if (turnaround != dirtype_t.DI_NODIR) {
        actor.movedir = int(turnaround)
        if (P_TryWalk(actor) != 0) {
            return
        }
    }
    // can not move
    actor.movedir = int(dirtype_t.DI_NODIR)
}

// P_LookForPlayers
// If allaround is false, only look 180 degrees in front.
// Returns true if a player is targeted.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LookForPlayers(var actor : mobj_s?; allaround : uint) : uint {
    var c : int
    var stop : int
    var player : player_s?
    var an : uint
    var dist : int
    c = 0
    stop = (actor.lastlook - 1) & 3
    {
        var _f = false
        while (true) {
            if (_f) {
                actor.lastlook = (actor.lastlook + 1) & 3
            }
            _f = true
            if (playeringame[actor.lastlook] == 0) {
                continue
            }
            let _t0 = c
            c++
            if (_t0 == 2 || actor.lastlook == stop) {
                // done looking
                return 0u
            }
            player = addr(players[0]) + end_index(actor.lastlook, 4)
            if (player.health <= 0) {
                // dead
                continue
            }
            if (P_CheckSight(actor, player.mo) == 0) {
                // out of sight
                continue
            }
            if (allaround == 0) {
                an = R_PointToAngle2(actor.x, actor.y, player.mo.x, player.mo.y) - actor.angle
                if (an > uint(ANG90) && an < ANG270) {
                    dist = P_AproxDistance(player.mo.x - actor.x, player.mo.y - actor.y)
                    // if real close, react anyway
                    if (dist > MELEERANGE) {
                        // behind back
                        continue
                    }
                }
            }
            actor.target = player.mo
            return 1u
        }
    }
    return 0u
}

// A_KeenDie
// DOOM II special, map 32.
// Uses special tag 666.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_KeenDie(var mo : mobj_s?) {
    var th : thinker_s?
    var mo2 : mobj_s?
    var junk : line_s
    A_Fall(mo)
    // scan the remaining thinkers
    // to see if all Keens are dead
    {
        th = thinkercap.next
        var _f = false
        while (true) {
            if (_f) {
                th = th.next
            }
            _f = true
            if (!(th != addr(thinkercap))) {
                break
            }
            if (th._c_function.acp1 != reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
                continue
            }
            mo2 = reinterpret<mobj_s?>(th)
            if (mo2 != mo && mo2._c_type == mo._c_type && mo2.health > 0) {
                // other Keen not dead
                return
            }
        }
    }
    junk.tag = int16(666)
    EV_DoDoor(addr(junk), vldoor_e.vld_open)
}

// A_Look
// Stay in state until a player is sighted.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Look(var actor : mobj_s?) {
    var targ : mobj_s?
    // any shot will wake up
    actor.threshold = 0
    targ = actor.subsector.sector.soundtarget
    if (targ != null && (targ.flags & int(mobjflag_t.MF_SHOOTABLE)) != 0) {
        actor.target = targ
        if ((actor.flags & int(mobjflag_t.MF_AMBUSH)) != 0) {
            if (P_CheckSight(actor, actor.target) != 0) {
                goto label 1
            }
        } else {
            goto label 1
        }
    }
    if (P_LookForPlayers(actor, 0u) == 0) {
        return
    }
    label 1:  // seeyou
    // go into chase state
    if (actor.info.seesound != 0) {
        var sound : int
        c_switch(actor.info.seesound) {
            case(36, 37, 38) {
                sound = int(sfxenum_t.sfx_posit1) + P_Random() % 3
                break
            }
            case(39, 40) {
                sound = int(sfxenum_t.sfx_bgsit1) + P_Random() % 2
                break
            }
            case(_) {
                sound = actor.info.seesound
                break
            }
        }
        if (actor._c_type == mobjtype_t.MT_SPIDER || actor._c_type == mobjtype_t.MT_CYBORG) {
            // full volume
            S_StartSound(null, sound)
        } else {
            S_StartSound(reinterpret<void?>(actor), sound)
        }
    }
    P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.seestate))
}

// A_Chase
// Actor has a melee attack,
// so it tries to close as fast as possible
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Chase(var actor : mobj_s?) {
    var delta : int
    if (actor.reactiontime != 0) {
        actor.reactiontime--
    }
    // modify target threshold
    if (actor.threshold != 0) {
        if (actor.target == null || actor.target.health <= 0) {
            actor.threshold = 0
        } else {
            actor.threshold--
        }
    }
    // turn towards movement direction if not there yet
    if (actor.movedir < 8) {
        actor.angle &= uint(7 << 29)
        delta = int(actor.angle - uint(actor.movedir << 29))
        if (delta > 0) {
            actor.angle -= uint(ANG90 / 2)
        } elif (delta < 0) {
            actor.angle += uint(ANG90 / 2)
        }
    }
    if (actor.target == null || (actor.target.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // look for a new target
        if (P_LookForPlayers(actor, 1u) != 0) {
            // got a new target
            return
        }
        P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.spawnstate))
        return
    }
    // do not attack twice in a row
    if ((actor.flags & int(mobjflag_t.MF_JUSTATTACKED)) != 0) {
        actor.flags &= ~int(mobjflag_t.MF_JUSTATTACKED)
        if (gameskill != skill_t.sk_nightmare && fastparm == 0) {
            P_NewChaseDir(actor)
        }
        return
    }
    // check for melee attack
    if (actor.info.meleestate != 0 && P_CheckMeleeRange(actor) != 0) {
        if (actor.info.attacksound != 0) {
            S_StartSound(reinterpret<void?>(actor), actor.info.attacksound)
        }
        P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.meleestate))
        return
    }
    // check for missile attack
    if (actor.info.missilestate != 0) {
        if (int(gameskill) < int(skill_t.sk_nightmare) && fastparm == 0 && actor.movecount != 0) {
            goto label 1
        }
        if (P_CheckMissileRange(actor) == 0) {
            goto label 1
        }
        P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.missilestate))
        actor.flags |= int(mobjflag_t.MF_JUSTATTACKED)
        return
    }
    label 1:  // nomissile
    // ?
    // possibly choose another target
    if (netgame != 0 && actor.threshold == 0 && P_CheckSight(actor, actor.target) == 0) {
        if (P_LookForPlayers(actor, 1u) != 0) {
            // got a new target
            return
        }
    }
    // chase towards player
    actor.movecount--
    if (actor.movecount < 0 || P_Move(actor) == 0) {
        P_NewChaseDir(actor)
    }
    // make active sound
    if (actor.info.activesound != 0 && P_Random() < 3) {
        S_StartSound(reinterpret<void?>(actor), actor.info.activesound)
    }
}

// A_FaceTarget
[unsafe_deref, hint(unsafe_range_check)]
def A_FaceTarget(var actor : mobj_s?) {
    if (actor.target == null) {
        return
    }
    actor.flags &= ~int(mobjflag_t.MF_AMBUSH)
    actor.angle = R_PointToAngle2(actor.x, actor.y, actor.target.x, actor.target.y)
    if ((actor.target.flags & int(mobjflag_t.MF_SHADOW)) != 0) {
        actor.angle += uint((P_Random() - P_Random()) << 21)
    }
}

// A_PosAttack
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_PosAttack(var actor : mobj_s?) {
    var angle : int
    var damage : int
    var slope : int
    if (actor.target == null) {
        return
    }
    A_FaceTarget(actor)
    angle = int(actor.angle)
    slope = P_AimLineAttack(actor, uint(angle), MISSILERANGE)
    S_StartSound(reinterpret<void?>(actor), int(sfxenum_t.sfx_pistol))
    angle += (P_Random() - P_Random()) << 20
    damage = ((P_Random() % 5) + 1) * 3
    P_LineAttack(actor, uint(angle), MISSILERANGE, slope, damage)
}

