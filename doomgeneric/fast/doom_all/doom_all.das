[unsafe_deref, hint(unsafe_range_check)]
def A_BrainSpit(var mo : mobj_s?) {
    var targ : mobj_s?
    var newmobj : mobj_s?
    A_BrainSpit_easy ^= 1
    if (int(gameskill) <= int(skill_t.sk_easy) && (A_BrainSpit_easy == 0)) {
        return
    }
    // shoot a cube at current target
    targ = braintargets[braintargeton]
    braintargeton = (braintargeton + 1) % numbraintargets
    // spawn brain missile
    newmobj = P_SpawnMissile(mo, targ, mobjtype_t.MT_SPAWNSHOT)
    newmobj.target = targ
    newmobj.reactiontime = ((targ.y - mo.y) / newmobj.momy) / newmobj.state.tics
    S_StartSound(null, int(sfxenum_t.sfx_bospit))
}

// travelling cube sound
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_SpawnSound(var mo : mobj_s?) {
    S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_boscub))
    A_SpawnFly(mo)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_SpawnFly(var mo : mobj_s?) {
    var newmobj : mobj_s?
    var fog : mobj_s?
    var targ : mobj_s?
    var r : int
    var _c_type : mobjtype_t
    mo.reactiontime--
    if (mo.reactiontime != 0) {
        // still flying
        return
    }
    targ = P_SubstNullMobj(mo.target)
    // First spawn teleport fog.
    fog = P_SpawnMobj(targ.x, targ.y, targ.z, mobjtype_t.MT_SPAWNFIRE)
    S_StartSound(reinterpret<void?>(fog), int(sfxenum_t.sfx_telept))
    // Randomly select monster to spawn.
    r = P_Random()
    // Probability distribution (kind of :),
    // decreasing likelihood.
    if (r < 50) {
        _c_type = mobjtype_t.MT_TROOP
    } elif (r < 90) {
        _c_type = mobjtype_t.MT_SERGEANT
    } elif (r < 120) {
        _c_type = mobjtype_t.MT_SHADOWS
    } elif (r < 130) {
        _c_type = mobjtype_t.MT_PAIN
    } elif (r < 160) {
        _c_type = mobjtype_t.MT_HEAD
    } elif (r < 162) {
        _c_type = mobjtype_t.MT_VILE
    } elif (r < 172) {
        _c_type = mobjtype_t.MT_UNDEAD
    } elif (r < 192) {
        _c_type = mobjtype_t.MT_BABY
    } elif (r < 222) {
        _c_type = mobjtype_t.MT_FATSO
    } elif (r < 246) {
        _c_type = mobjtype_t.MT_KNIGHT
    } else {
        _c_type = mobjtype_t.MT_BRUISER
    }
    newmobj = P_SpawnMobj(targ.x, targ.y, targ.z, _c_type)
    if (P_LookForPlayers(newmobj, 1u) != 0) {
        P_SetMobjState(newmobj, enum_from_int(type<statenum_t>, newmobj.info.seestate))
    }
    // telefrag anything in this spot
    P_TeleportMove(newmobj, newmobj.x, newmobj.y)
    // remove self (i.e., cube).
    P_RemoveMobj(mo)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
