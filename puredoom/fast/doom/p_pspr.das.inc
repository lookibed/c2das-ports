// generated by c2das - regenerate, never edit
var swingx : int
var swingy : int
var bulletslope : int

// P_SetPsprite
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SetPsprite(var player : player_s?; position : int; var stnum : statenum_t) {
    var psp : pspdef_t?
    var state : state_t?
    psp = addr(player.psprites[0]) + end_index(position, 2)
    c_do_while(psp.tics == 0) {
        if (int(stnum) == 0) {
            // object removed itself
            psp.state = null
            break
        }
        state = addr(states[0]) + end_index(int(stnum), 967)
        psp.state = state
        // could be 0
        psp.tics = int(state.tics)
        if (state.misc1 != 0) {
            // coordinate set
            psp.sx = int(state.misc1 << int64(FRACBITS))
            psp.sy = int(state.misc2 << int64(FRACBITS))
        }
        // Call action routine.
        // Modified handling.
        if (state.action.acp2 != null) {
            invoke(state.action.acp2, reinterpret<void?>(player), reinterpret<void?>(psp))
            if (psp.state == null) {
                break
            }
        }
        stnum = psp.state.nextstate
    }
}

// P_BringUpWeapon
// Starts bringing the pending weapon up
// from the bottom of the screen.
// Uses player
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BringUpWeapon(var player : player_s?) {
    var newstate : statenum_t
    if (player.pendingweapon == weapontype_t.wp_nochange) {
        player.pendingweapon = player.readyweapon
    }
    if (player.pendingweapon == weapontype_t.wp_chainsaw) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawup))
    }
    newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.pendingweapon)].upstate)
    player.pendingweapon = weapontype_t.wp_nochange
    player.psprites[int(psprnum_t.ps_weapon)].sy = WEAPONBOTTOM
    P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
}

// P_CheckAmmo
// Returns true if there is enough ammo to shoot.
// If not, selects the next weapon to use.
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckAmmo(var player : player_s?) : doom_boolean {
    var ammo : ammotype_t
    var count : int
    ammo = weaponinfo[int(player.readyweapon)].ammo
    // Minimal amount for one shot varies.
    if (player.readyweapon == weapontype_t.wp_bfg) {
        count = BFGCELLS
    } elif (player.readyweapon == weapontype_t.wp_supershotgun) {
        // Double barrel.
        count = 2
    } else {
        // Regular.
        count = 1
    }
    // Some do not need ammunition anyway.
    // Return if current ammunition sufficient.
    if (ammo == ammotype_t.am_noammo || player.ammo[int(ammo)] >= count) {
        return doom_boolean._c_true
    }
    // Out of ammo, pick a weapon to change to.
    // Preferences are set here.
    c_do_while(player.pendingweapon == weapontype_t.wp_nochange) {
        if (uint(player.weaponowned[int(weapontype_t.wp_plasma)]) != 0 && player.ammo[int(ammotype_t.am_cell)] != 0 && (gamemode != GameMode_t.shareware)) {
            player.pendingweapon = weapontype_t.wp_plasma
        } elif (uint(player.weaponowned[int(weapontype_t.wp_supershotgun)]) != 0 && player.ammo[int(ammotype_t.am_shell)] > 2 &&
                (gamemode == GameMode_t.commercial)) {
            player.pendingweapon = weapontype_t.wp_supershotgun
        } elif (uint(player.weaponowned[int(weapontype_t.wp_chaingun)]) != 0 && player.ammo[int(ammotype_t.am_clip)] != 0) {
            player.pendingweapon = weapontype_t.wp_chaingun
        } elif (uint(player.weaponowned[int(weapontype_t.wp_shotgun)]) != 0 && player.ammo[int(ammotype_t.am_shell)] != 0) {
            player.pendingweapon = weapontype_t.wp_shotgun
        } elif (player.ammo[int(ammotype_t.am_clip)] != 0) {
            player.pendingweapon = weapontype_t.wp_pistol
        } elif (int(player.weaponowned[int(weapontype_t.wp_chainsaw)]) != 0) {
            player.pendingweapon = weapontype_t.wp_chainsaw
        } elif (uint(player.weaponowned[int(weapontype_t.wp_missile)]) != 0 && player.ammo[int(ammotype_t.am_misl)] != 0) {
            player.pendingweapon = weapontype_t.wp_missile
        } elif (uint(player.weaponowned[int(weapontype_t.wp_bfg)]) != 0 && player.ammo[int(ammotype_t.am_cell)] > 40 && (gamemode != GameMode_t.shareware)) {
            player.pendingweapon = weapontype_t.wp_bfg
        } else {
            // If everything fails.
            player.pendingweapon = weapontype_t.wp_fist
        }
    }
    // Now set appropriate weapon overlay.
    P_SetPsprite(player, int(psprnum_t.ps_weapon), enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].downstate))
    return doom_boolean._c_false
}

// P_FireWeapon.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FireWeapon(var player : player_s?) {
    var newstate : statenum_t
    if (int(P_CheckAmmo(player)) == 0) {
        return
    }
    P_SetMobjState(player.mo, statenum_t.S_PLAY_ATK1)
    newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].atkstate)
    P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
    P_NoiseAlert(player.mo, player.mo)
    // [pd] Stop gun bobbing when shooting
    var psp : pspdef_t?
    psp = addr(player.psprites[int(psprnum_t.ps_weapon)])
    psp.sx = FRACUNIT
    psp.sy = WEAPONTOP
}

