[unsafe_deref, hint(unsafe_range_check)]
def P_GunShot(var mo : mobj_s?; accurate : doom_boolean) {
    var angle : uint
    var damage : int
    damage = 5 * (P_Random() % 3 + 1)
    angle = mo.angle
    if (int(accurate) == 0) {
        angle += uint((P_Random() - P_Random()) << 18)
    }
    P_LineAttack(mo, angle, MISSILERANGE, bulletslope, damage)
}

