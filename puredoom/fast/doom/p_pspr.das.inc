// A_WeaponReady
// The player can fire the weapon
// or change to another weapon at this time.
// Follows after getting weapon up,
// or after previous attack/fire sequence.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_WeaponReady(var player : player_s?; var psp : pspdef_t?) {
    var newstate : statenum_t
    var angle : int
    // get out of attack state
    if (player.mo.state == addr(states[int(statenum_t.S_PLAY_ATK1)]) || player.mo.state == addr(states[int(statenum_t.S_PLAY_ATK2)])) {
        P_SetMobjState(player.mo, statenum_t.S_PLAY)
    }
    if (player.readyweapon == weapontype_t.wp_chainsaw && psp.state == addr(states[int(statenum_t.S_SAW)])) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawidl))
    }
    // check for change
    // if player is dead, put the weapon away
    if (player.pendingweapon != weapontype_t.wp_nochange || player.health == 0) {
        // change weapon
        // (pending weapon should allready be validated)
        newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].downstate)
        P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
        return
    }
    // check for fire
    // the missile launcher and bfg do not auto fire
    if ((int(player.cmd.buttons) & int(buttoncode_t.BT_ATTACK)) != 0) {
        if (player.attackdown == 0 || (player.readyweapon != weapontype_t.wp_missile && player.readyweapon != weapontype_t.wp_bfg)) {
            player.attackdown = int(doom_boolean._c_true)
            P_FireWeapon(player)
            return
        }
    } else {
        player.attackdown = int(doom_boolean._c_false)
    }
    // bob the weapon based on movement speed
    angle = (128 * leveltime) & FINEMASK
    psp.sx = FRACUNIT + FixedMul(player.bob, finecosine[angle])
    angle &= FINEANGLES / 2 - 1
    psp.sy = WEAPONTOP + FixedMul(player.bob, finesine[angle])
}

// A_ReFire
// The player can re-fire the weapon
// without lowering it entirely.
[unsafe_deref, hint(unsafe_range_check)]
def A_ReFire(var player : player_s?; var psp : pspdef_t?) {
    // check for fire
    // (if a weaponchange is pending, let it go through instead)
    if ((int(player.cmd.buttons) & int(buttoncode_t.BT_ATTACK)) != 0 && player.pendingweapon == weapontype_t.wp_nochange && player.health != 0) {
        player.refire++
        P_FireWeapon(player)
    } else {
        player.refire = 0
        P_CheckAmmo(player)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def A_CheckReload(var player : player_s?; var psp : pspdef_t?) {
    P_CheckAmmo(player)
}

// A_Lower
// Lowers current weapon,
// and changes weapon at bottom.
[unsafe_deref, hint(unsafe_range_check)]
def A_Lower(var player : player_s?; var psp : pspdef_t?) {
    psp.sy += LOWERSPEED
    // Is already down.
    if (psp.sy < WEAPONBOTTOM) {
        return
    }
    // Player is dead.
    if (player.playerstate == playerstate_t.PST_DEAD) {
        psp.sy = WEAPONBOTTOM
        // don't bring weapon back up
        return
    }
    // The old weapon has been lowered off the screen,
    // so change the weapon and start raising it
    if (player.health == 0) {
        // Player is dead, so keep the weapon off screen.
        P_SetPsprite(player, int(psprnum_t.ps_weapon), statenum_t.S_NULL)
        return
    }
    player.readyweapon = player.pendingweapon
    P_BringUpWeapon(player)
}

// A_Raise
[unsafe_deref, hint(unsafe_range_check)]
def A_Raise(var player : player_s?; var psp : pspdef_t?) {
    var newstate : statenum_t
    psp.sy -= RAISESPEED
    if (psp.sy > WEAPONTOP) {
        return
    }
    psp.sy = WEAPONTOP
    // The weapon has been raised all the way,
    // so change to the ready state.
    newstate = enum_from_int(type<statenum_t>, weaponinfo[int(player.readyweapon)].readystate)
    P_SetPsprite(player, int(psprnum_t.ps_weapon), newstate)
}

