// A_Punch
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Punch(var player : player_s?; var psp : pspdef_t?) {
    var angle : uint
    var damage : int
    var slope : int
    damage = (P_Random() % 10 + 1) << 1
    if (player.powers[int(powertype_t.pw_strength)] != 0) {
        damage *= 10
    }
    angle = player.mo.angle
    angle += uint((P_Random() - P_Random()) << 18)
    slope = P_AimLineAttack(player.mo, angle, MELEERANGE)
    P_LineAttack(player.mo, angle, MELEERANGE, slope, damage)
    // turn to face target
    if (linetarget != null) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_punch))
        player.mo.angle = R_PointToAngle2(player.mo.x, player.mo.y, linetarget.x, linetarget.y)
    }
}

// A_Saw
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Saw(var player : player_s?; var psp : pspdef_t?) {
    var angle : uint
    var damage : int
    var slope : int
    damage = 2 * (P_Random() % 10 + 1)
    angle = player.mo.angle
    angle += uint((P_Random() - P_Random()) << 18)
    // use meleerange + 1 se the puff doesn't skip the flash
    slope = P_AimLineAttack(player.mo, angle, MELEERANGE + 1)
    P_LineAttack(player.mo, angle, MELEERANGE + 1, slope, damage)
    if (linetarget == null) {
        S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawful))
        return
    }
    S_StartSound(reinterpret<void?>(player.mo), int(sfxenum_t.sfx_sawhit))
    // turn to face target
    angle = R_PointToAngle2(player.mo.x, player.mo.y, linetarget.x, linetarget.y)
    if (angle - player.mo.angle > ANG180) {
        if (angle - player.mo.angle < uint(-ANG90 / 20)) {
            player.mo.angle = angle + uint(ANG90 / 21)
        } else {
            player.mo.angle -= uint(ANG90 / 20)
        }
    } else {
        if (angle - player.mo.angle > uint(ANG90 / 20)) {
            player.mo.angle = angle - uint(ANG90 / 21)
        } else {
            player.mo.angle += uint(ANG90 / 20)
        }
    }
    player.mo.flags |= int(mobjflag_t.MF_JUSTATTACKED)
}

