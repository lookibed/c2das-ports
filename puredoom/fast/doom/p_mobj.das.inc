// generated by c2das - regenerate, never edit
var itemrespawnque : mapthing_t[128]
var itemrespawntime : int[128]
var iquehead : int
var iquetail : int

[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SetMobjState(var mobj : mobj_s?; var state : statenum_t) : doom_boolean {
    var st : state_t?
    c_do_while(mobj.tics == 0) {
        if (state == statenum_t.S_NULL) {
            mobj.state = null
            P_RemoveMobj(mobj)
            return doom_boolean._c_false
        }
        st = addr(states[0]) + end_index(int(state), 967)
        mobj.state = st
        mobj.tics = int(st.tics)
        mobj.sprite = st.sprite
        mobj.frame = int(st.frame)
        // Modified handling.
        // Call action functions when the state is set
        if (st.action.acp1 != null) {
            invoke(st.action.acp1, reinterpret<void?>(mobj))
        }
        state = st.nextstate
    }
    return doom_boolean._c_true
}

// P_ExplodeMissile
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ExplodeMissile(var mo : mobj_s?) {
    mo.momz = 0
    mo.momy = mo.momz
    mo.momx = mo.momy
    P_SetMobjState(mo, enum_from_int(type<statenum_t>, mobjinfo[int(mo._c_type)].deathstate))
    mo.tics -= P_Random() & 3
    if (mo.tics < 1) {
        mo.tics = 1
    }
    mo.flags &= ~int(mobjflag_t.MF_MISSILE)
    if (mo.info.deathsound != 0) {
        S_StartSound(reinterpret<void?>(mo), mo.info.deathsound)
    }
}

// P_XYMovement
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_XYMovement(var mo : mobj_s?) {
    var ptryx : int
    var ptryy : int
    var player : player_s?
    var xmove : int
    var ymove : int
    if (mo.momx == 0 && mo.momy == 0) {
        if ((mo.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
            // the skull slammed into something
            mo.flags &= ~int(mobjflag_t.MF_SKULLFLY)
            mo.momz = 0
            mo.momy = mo.momz
            mo.momx = mo.momy
            P_SetMobjState(mo, enum_from_int(type<statenum_t>, mo.info.spawnstate))
        }
        return
    }
    player = mo.player
    if (mo.momx > MAXMOVE) {
        mo.momx = MAXMOVE
    } elif (mo.momx < -MAXMOVE) {
        mo.momx = -MAXMOVE
    }
    if (mo.momy > MAXMOVE) {
        mo.momy = MAXMOVE
    } elif (mo.momy < -MAXMOVE) {
        mo.momy = -MAXMOVE
    }
    xmove = mo.momx
    ymove = mo.momy
    c_do_while(xmove != 0 || ymove != 0) {
        if (xmove > MAXMOVE / 2 || ymove > MAXMOVE / 2) {
            ptryx = mo.x + xmove / 2
            ptryy = mo.y + ymove / 2
            xmove >>= 1
            ymove >>= 1
        } else {
            ptryx = mo.x + xmove
            ptryy = mo.y + ymove
            ymove = 0
            xmove = ymove
        }
        if (int(P_TryMove(mo, ptryx, ptryy)) == 0) {
            // blocked move
            if (mo.player != null) {
                // try to slide along it
                P_SlideMove(mo)
            } elif ((mo.flags & int(mobjflag_t.MF_MISSILE)) != 0) {
                // explode a missile
                if (ceilingline != null && ceilingline.backsector != null && int(ceilingline.backsector.ceilingpic) == skyflatnum) {
                    // Hack to prevent missiles exploding
                    // against the sky.
                    // Does not handle sky floors.
                    P_RemoveMobj(mo)
                    return
                }
                P_ExplodeMissile(mo)
            } else {
                mo.momy = 0
                mo.momx = mo.momy
            }
        }
    }
    // slow down
    if (player != null && (player.cheats & int(cheat_t.CF_NOMOMENTUM)) != 0) {
        // debug option for no sliding at all
        mo.momy = 0
        mo.momx = mo.momy
        return
    }
    if ((mo.flags & (int(mobjflag_t.MF_MISSILE) | int(mobjflag_t.MF_SKULLFLY))) != 0) {
        // no friction for missiles ever
        return
    }
    if (mo.z > mo.floorz) {
        // no friction when airborne
        return
    }
    if ((mo.flags & int(mobjflag_t.MF_CORPSE)) != 0) {
        // do not stop sliding
        // if halfway off a step with some momentum
        if (mo.momx > FRACUNIT / 4 || mo.momx < -FRACUNIT / 4 || mo.momy > FRACUNIT / 4 || mo.momy < -FRACUNIT / 4) {
            if (mo.floorz != mo.subsector.sector.floorheight) {
                return
            }
        }
    }
    if (mo.momx > -STOPSPEED && mo.momx < STOPSPEED && mo.momy > -STOPSPEED && mo.momy < STOPSPEED &&
            (player == null || (player.cmd.forwardmove == 0 && player.cmd.sidemove == 0))) {
        // if in a walking frame, stop moving
        if (player != null && uint(int64(player.mo.state - addr(states[0])) - int64(uint(statenum_t.S_PLAY_RUN1))) < 4u) {
            P_SetMobjState(player.mo, statenum_t.S_PLAY)
        }
        mo.momx = 0
        mo.momy = 0
    } else {
        mo.momx = FixedMul(mo.momx, FRICTION)
        mo.momy = FixedMul(mo.momy, FRICTION)
    }
}

// P_ZMovement
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_ZMovement(var mo : mobj_s?) {
    var dist : int
    var delta : int
    // check for smooth step up
    if (mo.player != null && mo.z < mo.floorz) {
        mo.player.viewheight -= mo.floorz - mo.z
        mo.player.deltaviewheight = (VIEWHEIGHT - mo.player.viewheight) >> 3
    }
    // adjust height
    mo.z += mo.momz
    if ((mo.flags & int(mobjflag_t.MF_FLOAT)) != 0 && mo.target != null) {
        // float down towards target if too close
        if ((mo.flags & int(mobjflag_t.MF_SKULLFLY)) == 0 && (mo.flags & int(mobjflag_t.MF_INFLOAT)) == 0) {
            dist = P_AproxDistance(mo.x - mo.target.x, mo.y - mo.target.y)
            delta = (mo.target.z + (mo.height >> 1)) - mo.z
            if (delta < 0 && dist < -(delta * 3)) {
                mo.z -= FLOATSPEED
            } elif (delta > 0 && dist < (delta * 3)) {
                mo.z += FLOATSPEED
            }
        }
    }
    // clip movement
    if (mo.z <= mo.floorz) {
        // hit the floor
        // Note (id):
        // somebody left this after the setting momz to 0,
        // kinda useless there.
        if ((mo.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
            // the skull slammed into something
            mo.momz = -mo.momz
        }
        if (mo.momz < 0) {
            if (mo.player != null && mo.momz < -FRACUNIT * 8) {
                // Squat down.
                // Decrease viewheight for a moment
                // after hitting the ground (hard),
                // and utter appropriate sound.
                mo.player.deltaviewheight = mo.momz >> 3
                S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_oof))
            }
            mo.momz = 0
        }
        mo.z = mo.floorz
        if ((mo.flags & int(mobjflag_t.MF_MISSILE)) != 0 && (mo.flags & int(mobjflag_t.MF_NOCLIP)) == 0) {
            P_ExplodeMissile(mo)
            return
        }
    } elif ((mo.flags & int(mobjflag_t.MF_NOGRAVITY)) == 0) {
        if (mo.momz == 0) {
            mo.momz = -FRACUNIT * 2
        } else {
            mo.momz -= FRACUNIT
        }
    }
    if (mo.z + mo.height > mo.ceilingz) {
        // hit the ceiling
        if (mo.momz > 0) {
            mo.momz = 0
        }
        mo.z = mo.ceilingz - mo.height
        if ((mo.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
            // the skull slammed into something
            mo.momz = -mo.momz
        }
        if ((mo.flags & int(mobjflag_t.MF_MISSILE)) != 0 && (mo.flags & int(mobjflag_t.MF_NOCLIP)) == 0) {
            P_ExplodeMissile(mo)
            return
        }
    }
}

// P_NightmareRespawn
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_NightmareRespawn(var mobj : mobj_s?) {
    var x : int
    var y : int
    var z : int
    var ss : subsector_s?
    var mo : mobj_s?
    var mthing : mapthing_t?
    x = int(mobj.spawnpoint.x) << FRACBITS
    y = int(mobj.spawnpoint.y) << FRACBITS
    // somthing is occupying it's position?
    if (int(P_CheckPosition(mobj, x, y)) == 0) {
        // no respwan
        return
    }
    // spawn a teleport fog at old spot
    // because of removal of the body?
    mo = P_SpawnMobj(mobj.x, mobj.y, mobj.subsector.sector.floorheight, mobjtype_t.MT_TFOG)
    // initiate teleport sound
    S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_telept))
    // spawn a teleport fog at the new spot
    ss = R_PointInSubsector(x, y)
    mo = P_SpawnMobj(x, y, ss.sector.floorheight, mobjtype_t.MT_TFOG)
    S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_telept))
    // spawn the new monster
    mthing = addr(mobj.spawnpoint)
    // spawn it
    if ((mobj.info.flags & int(mobjflag_t.MF_SPAWNCEILING)) != 0) {
        z = DOOM_MAXINT
    } else {
        z = DOOM_MININT
    }
    // inherit attributes from deceased one
    mo = P_SpawnMobj(x, y, z, mobj._c_type)
    mo.spawnpoint = mobj.spawnpoint
    mo.angle = uint(ANG45 * (int(mthing.angle) / 45))
    if ((int(mthing._c_options) & MTF_AMBUSH) != 0) {
        mo.flags |= int(mobjflag_t.MF_AMBUSH)
    }
    mo.reactiontime = 18
    // remove the old monster,
    P_RemoveMobj(mobj)
}

// P_MobjThinker
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_MobjThinker(var mobj : mobj_s?) {
    // momentum movement
    if (mobj.momx != 0 || mobj.momy != 0 || (mobj.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
        P_XYMovement(mobj)
        // FIXME: decent NOP/0/Nil function pointer please.
        if (mobj.thinker._c_function.acv == reinterpret<function<() : void>>(uint64(-1))) {
            // mobj was removed
            return
        }
    }
    if ((mobj.z != mobj.floorz) || mobj.momz != 0) {
        P_ZMovement(mobj)
        // FIXME: decent NOP/0/Nil function pointer please.
        if (mobj.thinker._c_function.acv == reinterpret<function<() : void>>(uint64(-1))) {
            // mobj was removed
            return
        }
    }
    // cycle through states,
    // calling action functions at transitions
    if (mobj.tics != -1) {
        mobj.tics--
        // you can cycle through multiple states in a tic
        if (mobj.tics == 0) {
            if (int(P_SetMobjState(mobj, mobj.state.nextstate)) == 0) {
                // freed itself
                return
            }
        }
    } else {
        // check for nightmare respawn
        if ((mobj.flags & int(mobjflag_t.MF_COUNTKILL)) == 0) {
            return
        }
        if (int(respawnmonsters) == 0) {
            return
        }
        mobj.movecount++
        if (mobj.movecount < 12 * 35) {
            return
        }
        if ((leveltime & 31) != 0) {
            return
        }
        if (P_Random() > 4) {
            return
        }
        P_NightmareRespawn(mobj)
    }
}

// P_SpawnMobj
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnMobj(x : int; y : int; z : int; _c_type : mobjtype_t) : mobj_s? {
    var mobj : mobj_s?
    var st : state_t?
    var info : mobjinfo_t?
    mobj = reinterpret<mobj_s?>(Z_Malloc(typeinfo sizeof(type<mobj_s>), PU_LEVEL, null))
    doom_memset(reinterpret<void?>(mobj), 0, typeinfo sizeof(type<mobj_s>))
    info = addr(mobjinfo[0]) + end_index(int(_c_type), 137)
    mobj._c_type = _c_type
    mobj.info = info
    mobj.x = x
    mobj.y = y
    mobj.radius = info.radius
    mobj.height = info.height
    mobj.flags = info.flags
    mobj.health = info.spawnhealth
    if (gameskill != skill_t.sk_nightmare) {
        mobj.reactiontime = info.reactiontime
    }
    mobj.lastlook = P_Random() % MAXPLAYERS
    // do not set the state with P_SetMobjState,
    // because action routines can not be called yet
    st = addr(states[0]) + end_index(info.spawnstate, 967)
    mobj.state = st
    mobj.tics = int(st.tics)
    mobj.sprite = st.sprite
    mobj.frame = int(st.frame)
    // set subsector and/or block links
    P_SetThingPosition(mobj)
    mobj.floorz = mobj.subsector.sector.floorheight
    mobj.ceilingz = mobj.subsector.sector.ceilingheight
    if (z == DOOM_MININT) {
        mobj.z = mobj.floorz
    } elif (z == DOOM_MAXINT) {
        mobj.z = mobj.ceilingz - mobj.info.height
    } else {
        mobj.z = z
    }
    mobj.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)
    P_AddThinker(addr(mobj.thinker))
    return mobj
}

// P_RemoveMobj
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RemoveMobj(var mobj : mobj_s?) {
    if ((mobj.flags & int(mobjflag_t.MF_SPECIAL)) != 0 && (mobj.flags & int(mobjflag_t.MF_DROPPED)) == 0 && (mobj._c_type != mobjtype_t.MT_INV) &&
            (mobj._c_type != mobjtype_t.MT_INS)) {
        itemrespawnque[iquehead] = mobj.spawnpoint
        itemrespawntime[iquehead] = leveltime
        iquehead = (iquehead + 1) & (ITEMQUESIZE - 1)
        // lose one off the end?
        if (iquehead == iquetail) {
            iquetail = (iquetail + 1) & (ITEMQUESIZE - 1)
        }
    }
    // unlink from sector and block lists
    P_UnsetThingPosition(mobj)
    // stop any playing sound
    S_StopSound(reinterpret<void?>(mobj))
    // free block
    P_RemoveThinker(reinterpret<thinker_s?>(mobj))
}

// P_RespawnSpecials
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RespawnSpecials {
    var x : int
    var y : int
    var z : int
    var ss : subsector_s?
    var mo : mobj_s?
    var mthing : mapthing_t?
    var i : int
    // only respawn items in deathmatch
    if (uint(deathmatch) != 2u) {
        return
    }
    // nothing left to respawn?
    if (iquehead == iquetail) {
        return
    }
    // wait at least 30 seconds
    if (leveltime - itemrespawntime[iquetail] < 30 * 35) {
        return
    }
    mthing = addr(itemrespawnque[0]) + end_index(iquetail, 128)
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    // spawn a teleport fog at the new spot
    ss = R_PointInSubsector(x, y)
    mo = P_SpawnMobj(x, y, ss.sector.floorheight, mobjtype_t.MT_IFOG)
    S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_itmbk))
    // find which type to spawn
    i = 0
    while (i < int(mobjtype_t.NUMMOBJTYPES)) {
        if (int(mthing._c_type) == mobjinfo[i].doomednum) {
            break
        }
        i++
    }
    // spawn it
    if ((mobjinfo[i].flags & int(mobjflag_t.MF_SPAWNCEILING)) != 0) {
        z = DOOM_MAXINT
    } else {
        z = DOOM_MININT
    }
    mo = P_SpawnMobj(x, y, z, enum_from_int(type<mobjtype_t>, i))
    mo.spawnpoint = *mthing
    mo.angle = uint(ANG45 * (int(mthing.angle) / 45))
    // pull it from the que
    iquetail = (iquetail + 1) & (ITEMQUESIZE - 1)
}

// P_SpawnPlayer
// Called when a player is spawned on the level.
// Most of the player structure stays unchanged
// between levels.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnPlayer(var mthing : mapthing_t?) {
    var p : player_s?
    var x : int
    var y : int
    var z : int
    var mobj : mobj_s?
    // not playing?
    if (int(playeringame[int(mthing._c_type) - 1]) == 0) {
        return
    }
    p = addr(players[0]) + end_index(int(mthing._c_type) - 1, 4)
    if (p.playerstate == playerstate_t.PST_REBORN) {
        G_PlayerReborn(int(mthing._c_type) - 1)
    }
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    z = DOOM_MININT
    mobj = P_SpawnMobj(x, y, z, mobjtype_t.MT_PLAYER)
    // set color translations for player sprites
    if (int(mthing._c_type) > 1) {
        mobj.flags |= (int(mthing._c_type) - 1) << int(mobjflag_t.MF_TRANSSHIFT)
    }
    mobj.angle = uint(ANG45 * (int(mthing.angle) / 45))
    mobj.player = p
    mobj.health = p.health
    p.mo = mobj
    p.playerstate = playerstate_t.PST_LIVE
    p.refire = 0
    p.message = null
    p.damagecount = 0
    p.bonuscount = 0
    p.extralight = 0
    p.fixedcolormap = 0
    p.viewheight = VIEWHEIGHT
    // setup gun psprite
    P_SetupPsprites(p)
    // give all cards in death match mode
    if (int(deathmatch) != 0) {
        for (i in range(int(card_t.NUMCARDS))) {
            p.cards[i] = doom_boolean._c_true
        }
    }
    if (int(mthing._c_type) - 1 == consoleplayer) {
        // wake up the status bar
        ST_Start()
        // wake up the heads up text
        HU_Start()
    }
}

// P_SpawnMapThing
// The fields of the mapthing should
// already be in host byte order.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnMapThing(var mthing : mapthing_t?) {
    var i : int
    var bit : int
    var mobj : mobj_s?
    var x : int
    var y : int
    var z : int
    // count deathmatch start positions
    if (mthing._c_type == 11) {
        if (intptr(deathmatch_p) < intptr(addr(deathmatchstarts[0]) + 10)) {
            doom_memcpy(reinterpret<void?>(deathmatch_p), reinterpret<void?>(mthing), typeinfo sizeof(type<mapthing_t>))
            deathmatch_p++
        }
        return
    }
    // check for players specially
    if (int(mthing._c_type) <= 4) {
        // save spots for respawning in network games
        playerstarts[int(mthing._c_type) - 1] = *mthing
        if (int(deathmatch) == 0) {
            P_SpawnPlayer(mthing)
        }
        return
    }
    // check for apropriate skill level
    if (int(netgame) == 0 && (int(mthing._c_options) & 16) != 0) {
        return
    }
    if (gameskill == skill_t.sk_baby) {
        bit = 1
    } elif (gameskill == skill_t.sk_nightmare) {
        bit = 4
    } else {
        bit = 1 << int(uint(gameskill) - 1u)
    }
    if ((int(mthing._c_options) & bit) == 0) {
        return
    }
    // find which type to spawn
    i = 0
    while (i < int(mobjtype_t.NUMMOBJTYPES)) {
        if (int(mthing._c_type) == mobjinfo[i].doomednum) {
            break
        }
        i++
    }
    if (i == int(mobjtype_t.NUMMOBJTYPES)) {
        // I_Error("Error: P_SpawnMapThing: Unknown type %i at (%i, %i)",
        // mthing->type,
        // mthing->x, mthing->y);
        doom_strcpy(addr(error_buf[0]), cstr("Error: P_SpawnMapThing: Unknown type "))
        doom_concat(addr(error_buf[0]), doom_itoa(int(mthing._c_type), 10))
        doom_concat(addr(error_buf[0]), cstr(" at ("))
        doom_concat(addr(error_buf[0]), doom_itoa(int(mthing.x), 10))
        doom_concat(addr(error_buf[0]), cstr(", "))
        doom_concat(addr(error_buf[0]), doom_itoa(int(mthing.y), 10))
        doom_concat(addr(error_buf[0]), cstr(")"))
        I_Error(addr(error_buf[0]))
    }
    // don't spawn keycards and players in deathmatch
    if (uint(deathmatch) != 0 && (mobjinfo[i].flags & int(mobjflag_t.MF_NOTDMATCH)) != 0) {
        return
    }
    // don't spawn any monsters if -nomonsters
    if (uint(nomonsters) != 0 && (i == int(mobjtype_t.MT_SKULL) || (mobjinfo[i].flags & int(mobjflag_t.MF_COUNTKILL)) != 0)) {
        return
    }
    // spawn it
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    if ((mobjinfo[i].flags & int(mobjflag_t.MF_SPAWNCEILING)) != 0) {
        z = DOOM_MAXINT
    } else {
        z = DOOM_MININT
    }
    mobj = P_SpawnMobj(x, y, z, enum_from_int(type<mobjtype_t>, i))
    mobj.spawnpoint = *mthing
    if (mobj.tics > 0) {
        mobj.tics = 1 + (P_Random() % mobj.tics)
    }
    if ((mobj.flags & int(mobjflag_t.MF_COUNTKILL)) != 0) {
        totalkills++
    }
    if ((mobj.flags & int(mobjflag_t.MF_COUNTITEM)) != 0) {
        totalitems++
    }
    mobj.angle = uint(ANG45 * (int(mthing.angle) / 45))
    if ((int(mthing._c_options) & MTF_AMBUSH) != 0) {
        mobj.flags |= int(mobjflag_t.MF_AMBUSH)
    }
}

// P_SpawnPuff
[unsafe_deref, hint(unsafe_range_check)]
def P_SpawnPuff(x : int; y : int; var z : int) {
    var th : mobj_s?
    z += (P_Random() - P_Random()) << 10
    th = P_SpawnMobj(x, y, z, mobjtype_t.MT_PUFF)
    th.momz = FRACUNIT
    th.tics -= P_Random() & 3
    if (th.tics < 1) {
        th.tics = 1
    }
    // don't make punches spark on the wall
    if (attackrange == MELEERANGE) {
        P_SetMobjState(th, statenum_t.S_PUFF3)
    }
}

// P_SpawnBlood
[unsafe_deref, hint(unsafe_range_check)]
def P_SpawnBlood(x : int; y : int; var z : int; damage : int) {
    var th : mobj_s?
    z += (P_Random() - P_Random()) << 10
    th = P_SpawnMobj(x, y, z, mobjtype_t.MT_BLOOD)
    th.momz = FRACUNIT * 2
    th.tics -= P_Random() & 3
    if (th.tics < 1) {
        th.tics = 1
    }
    if (damage <= 12 && damage >= 9) {
        P_SetMobjState(th, statenum_t.S_BLOOD2)
    } elif (damage < 9) {
        P_SetMobjState(th, statenum_t.S_BLOOD3)
    }
}

// P_CheckMissileSpawn
// Moves the missile forward a bit
// and possibly explodes it right there.
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckMissileSpawn(var th : mobj_s?) {
    th.tics -= P_Random() & 3
    if (th.tics < 1) {
        th.tics = 1
    }
    // move a little forward so an angle can
    // be computed if it immediately explodes
    th.x += th.momx >> 1
    th.y += th.momy >> 1
    th.z += th.momz >> 1
    if (int(P_TryMove(th, th.x, th.y)) == 0) {
        P_ExplodeMissile(th)
    }
}

// P_SpawnMissile
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnMissile(var source : mobj_s?; var dest : mobj_s?; _c_type : mobjtype_t) : mobj_s? {
    var th : mobj_s?
    var an : uint
    var dist : int
    th = P_SpawnMobj(source.x, source.y, source.z + 4 * 8 * FRACUNIT, _c_type)
    if (th.info.seesound != 0) {
        S_StartSound(reinterpret<void?>(th), th.info.seesound)
    }
    // where it came from
    th.target = source
    an = R_PointToAngle2(source.x, source.y, dest.x, dest.y)
    // fuzzy player
    if ((dest.flags & int(mobjflag_t.MF_SHADOW)) != 0) {
        an += uint((P_Random() - P_Random()) << 20)
    }
    th.angle = an
    an >>= uint(ANGLETOFINESHIFT)
    th.momx = FixedMul(th.info.speed, finecosine[an])
    th.momy = FixedMul(th.info.speed, finesine[an])
    dist = P_AproxDistance(dest.x - source.x, dest.y - source.y)
    dist = dist / th.info.speed
    if (dist < 1) {
        dist = 1
    }
    th.momz = (dest.z - source.z) / dist
    P_CheckMissileSpawn(th)
    return th
}

// P_SpawnPlayerMissile
// Tries to aim at a nearby monster
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnPlayerMissile(var source : mobj_s?; _c_type : mobjtype_t) {
    var th : mobj_s?
    var an : uint
    var x : int
    var y : int
    var z : int
    var slope : int
    // see which target is to be aimed at
    an = source.angle
    slope = P_AimLineAttack(source, an, 16 * 64 * FRACUNIT)
    if (linetarget == null) {
        an += uint(1 << 26)
        slope = P_AimLineAttack(source, an, 16 * 64 * FRACUNIT)
        if (linetarget == null) {
            an -= uint(2 << 26)
            slope = P_AimLineAttack(source, an, 16 * 64 * FRACUNIT)
        }
        if (linetarget == null) {
            an = source.angle
            slope = 0
        }
    }
    x = source.x
    y = source.y
    z = source.z + 4 * 8 * FRACUNIT
    th = P_SpawnMobj(x, y, z, _c_type)
    if (th.info.seesound != 0) {
        S_StartSound(reinterpret<void?>(th), th.info.seesound)
    }
    th.target = source
    th.angle = an
    th.momx = FixedMul(th.info.speed, finecosine[an >> uint(ANGLETOFINESHIFT)])
    th.momy = FixedMul(th.info.speed, finesine[an >> uint(ANGLETOFINESHIFT)])
    th.momz = FixedMul(th.info.speed, slope)
    P_CheckMissileSpawn(th)
}

