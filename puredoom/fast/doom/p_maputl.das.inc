// P_AproxDistance
// Gives an estimation of distance (not exact)
[unsafe_deref, hint(unsafe_range_check)]
def P_AproxDistance(var dx : int; var dy : int) : int {
    dx = doom_abs(dx)
    dy = doom_abs(dy)
    if (dx < dy) {
        return dx + dy - (dx >> 1)
    }
    return dx + dy - (dy >> 1)
}

// P_PointOnLineSide
// Returns 0 or 1
[unsafe_deref, hint(unsafe_range_check)]
def P_PointOnLineSide(x : int; y : int; var line : line_s?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (line.dx == 0) {
        if (x <= line.v1.x) {
            return int_of(line.dy > 0)
        }
        return int_of(line.dy < 0)
    }
    if (line.dy == 0) {
        if (y <= line.v1.y) {
            return int_of(line.dx < 0)
        }
        return int_of(line.dx > 0)
    }
    dx = x - line.v1.x
    dy = y - line.v1.y
    left = FixedMul(line.dy >> FRACBITS, dx)
    right = FixedMul(dy, line.dx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

// P_BoxOnLineSide
// Considers the line to be infinite
// Returns side 0 or 1, -1 if box crosses the line.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BoxOnLineSide(var tmbox : int?; var ld : line_s?) : int {
    var p1 : int
    var p2 : int
    c_switch(ld.slopetype) {
        case(slopetype_t.ST_HORIZONTAL) {
            p1 = int_of(tmbox[int(anon_787.BOXTOP)] > ld.v1.y)
            p2 = int_of(tmbox[int(anon_787.BOXBOTTOM)] > ld.v1.y)
            if (ld.dx < 0) {
                p1 ^= 1
                p2 ^= 1
            }
            break
        }
        case(slopetype_t.ST_VERTICAL) {
            p1 = int_of(tmbox[int(anon_787.BOXRIGHT)] < ld.v1.x)
            p2 = int_of(tmbox[int(anon_787.BOXLEFT)] < ld.v1.x)
            if (ld.dy < 0) {
                p1 ^= 1
                p2 ^= 1
            }
            break
        }
        case(slopetype_t.ST_POSITIVE) {
            p1 = P_PointOnLineSide(tmbox[int(anon_787.BOXLEFT)], tmbox[int(anon_787.BOXTOP)], ld)
            p2 = P_PointOnLineSide(tmbox[int(anon_787.BOXRIGHT)], tmbox[int(anon_787.BOXBOTTOM)], ld)
            break
        }
        case(slopetype_t.ST_NEGATIVE) {
            p1 = P_PointOnLineSide(tmbox[int(anon_787.BOXRIGHT)], tmbox[int(anon_787.BOXTOP)], ld)
            p2 = P_PointOnLineSide(tmbox[int(anon_787.BOXLEFT)], tmbox[int(anon_787.BOXBOTTOM)], ld)
            break
        }
    }
    if (p1 == p2) {
        return p1
    }
    return -1
}

// P_PointOnDivlineSide
// Returns 0 or 1.
[unsafe_deref, hint(unsafe_range_check)]
def P_PointOnDivlineSide(x : int; y : int; var line : divline_t?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (line.dx == 0) {
        if (x <= line.x) {
            return int_of(line.dy > 0)
        }
        return int_of(line.dy < 0)
    }
    if (line.dy == 0) {
        if (y <= line.y) {
            return int_of(line.dx < 0)
        }
        return int_of(line.dx > 0)
    }
    dx = x - line.x
    dy = y - line.y
    // try to quickly decide by looking at sign bits
    if ((uint(line.dy ^ line.dx ^ dx ^ dy) & 2147483648u) != 0) {
        if ((uint(line.dy ^ dx) & 2147483648u) != 0) {
            // (left is negative)
            return 1
        }
        return 0
    }
    left = FixedMul(line.dy >> 8, dx >> 8)
    right = FixedMul(dy >> 8, line.dx >> 8)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

// P_MakeDivline
[unsafe_deref, hint(unsafe_range_check)]
def P_MakeDivline(var li : line_s?; var dl : divline_t?) {
    dl.x = li.v1.x
    dl.y = li.v1.y
    dl.dx = li.dx
    dl.dy = li.dy
}

// P_InterceptVector
// Returns the fractional intercept point
// along the first divline.
// This is only called by the addthings
// and addlines traversers.
[unsafe_deref, hint(unsafe_range_check)]
def P_InterceptVector(var v2 : divline_t?; var v1 : divline_t?) : int {
    var frac : int
    var num : int
    var den : int
    den = FixedMul(v1.dy >> 8, v2.dx) - FixedMul(v1.dx >> 8, v2.dy)
    if (den == 0) {
        return 0
    }
    // I_Error ("P_InterceptVector: parallel");
    num = FixedMul((v1.x - v2.x) >> 8, v1.dy) + FixedMul((v2.y - v1.y) >> 8, v1.dx)
    frac = FixedDiv(num, den)
    return frac
}

// P_LineOpening
// Sets opentop and openbottom to the window
// through a two sided line.
// OPTIMIZE: keep this precalculated
[unsafe_deref, hint(unsafe_range_check)]
def P_LineOpening(var linedef : line_s?) {
    var front : sector_t?
    var back : sector_t?
    if (linedef.sidenum[1] == -1) {
        // single sided line
        openrange = 0
        return
    }
    front = linedef.frontsector
    back = linedef.backsector
    if (front.ceilingheight < back.ceilingheight) {
        opentop = front.ceilingheight
    } else {
        opentop = back.ceilingheight
    }
    if (front.floorheight > back.floorheight) {
        openbottom = front.floorheight
        lowfloor = back.floorheight
    } else {
        openbottom = back.floorheight
        lowfloor = front.floorheight
    }
    openrange = opentop - openbottom
}

// P_UnsetThingPosition
// Unlinks a thing from block map and sectors.
// On each position change, BLOCKMAP and other
// lookups maintaining lists ot things inside
// these structures need to be updated.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UnsetThingPosition(var thing : mobj_s?) {
    var blockx : int
    var blocky : int
    if ((thing.flags & int(mobjflag_t.MF_NOSECTOR)) == 0) {
        // inert things don't need to be in blockmap?
        // unlink from subsector
        if (thing.snext != null) {
            thing.snext.sprev = thing.sprev
        }
        if (thing.sprev != null) {
            thing.sprev.snext = thing.snext
        } else {
            thing.subsector.sector.thinglist = thing.snext
        }
    }
    if ((thing.flags & int(mobjflag_t.MF_NOBLOCKMAP)) == 0) {
        // inert things don't need to be in blockmap
        // unlink from block map
        if (thing.bnext != null) {
            thing.bnext.bprev = thing.bprev
        }
        if (thing.bprev != null) {
            thing.bprev.bnext = thing.bnext
        } else {
            blockx = (thing.x - bmaporgx) >> MAPBLOCKSHIFT
            blocky = (thing.y - bmaporgy) >> MAPBLOCKSHIFT
            if (blockx >= 0 && blockx < bmapwidth && blocky >= 0 && blocky < bmapheight) {
                blocklinks[blocky * bmapwidth + blockx] = thing.bnext
            }
        }
    }
}

// P_SetThingPosition
// Links a thing into both a block and a subsector
// based on it's x y.
// Sets thing->subsector properly
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SetThingPosition(var thing : mobj_s?) {
    var ss : subsector_s?
    var sec : sector_t?
    var blockx : int
    var blocky : int
    var link : mobj_s ??
    // link into subsector
    ss = R_PointInSubsector(thing.x, thing.y)
    thing.subsector = ss
    if ((thing.flags & int(mobjflag_t.MF_NOSECTOR)) == 0) {
        // invisible things don't go into the sector links
        sec = ss.sector
        thing.sprev = null
        thing.snext = sec.thinglist
        if (sec.thinglist != null) {
            sec.thinglist.sprev = thing
        }
        sec.thinglist = thing
    }
    // link into blockmap
    if ((thing.flags & int(mobjflag_t.MF_NOBLOCKMAP)) == 0) {
        // inert things don't need to be in blockmap
        blockx = (thing.x - bmaporgx) >> MAPBLOCKSHIFT
        blocky = (thing.y - bmaporgy) >> MAPBLOCKSHIFT
        if (blockx >= 0 && blockx < bmapwidth && blocky >= 0 && blocky < bmapheight) {
            link = addr(blocklinks[blocky * bmapwidth + blockx])
            thing.bprev = null
            thing.bnext = *link
            if (*link != null) {
                (*link).bprev = thing
            }
            *link = thing
        } else {
            // thing is off the map
            thing.bprev = null
            thing.bnext = thing.bprev
        }
    }
}

// P_BlockLinesIterator
// The validcount flags are used to avoid checking lines
// that are marked in multiple mapblocks,
// so increment validcount before the first call
// to P_BlockLinesIterator, then make one or more calls
// to it.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BlockLinesIterator(x : int; y : int; func : function<(var a0 : line_s?) : doom_boolean>) : doom_boolean {
    var offset : int
    var list : int16?
    var ld : line_s?
    if (x < 0 || y < 0 || x >= bmapwidth || y >= bmapheight) {
        return doom_boolean._c_true
    }
    offset = y * bmapwidth + x
    offset = int(blockmap[offset])
    {
        list = blockmaplump + offset
        var _f = false
        while (true) {
            if (_f) {
                list++
            }
            _f = true
            if (!(*list != -1)) {
                break
            }
            ld = addr(lines[int(*list)])
            if (ld.validcount == validcount) {
                // line has already been checked
                continue
            }
            ld.validcount = validcount
            if (int(invoke(func, ld)) == 0) {
                return doom_boolean._c_false
            }
        }
    }
    // everything was checked
    return doom_boolean._c_true
}

// P_BlockThingsIterator
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_BlockThingsIterator(x : int; y : int; func : function<(var a0 : mobj_s?) : doom_boolean>) : doom_boolean {
    var mobj : mobj_s?
    if (x < 0 || y < 0 || x >= bmapwidth || y >= bmapheight) {
        return doom_boolean._c_true
    }
    mobj = blocklinks[y * bmapwidth + x]
    while (mobj != null) {
        if (int(invoke(func, mobj)) == 0) {
            return doom_boolean._c_false
        }
        mobj = mobj.bnext
    }
    return doom_boolean._c_true
}

// PIT_AddLineIntercepts.
// Looks for lines in the given block
// that intercept the given trace
// to add to the intercepts list.
// A line is crossed if its endpoints
// are on opposite sides of the trace.
// Returns true if earlyout and a solid line hit.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_AddLineIntercepts(var ld : line_s?) : doom_boolean {
    var s1 : int
    var s2 : int
    var frac : int
    var dl : divline_t
    // avoid precision problems with two routines
    if (trace.dx > FRACUNIT * 16 || trace.dy > FRACUNIT * 16 || trace.dx < -FRACUNIT * 16 || trace.dy < -FRACUNIT * 16) {
        s1 = P_PointOnDivlineSide(ld.v1.x, ld.v1.y, addr(trace))
        s2 = P_PointOnDivlineSide(ld.v2.x, ld.v2.y, addr(trace))
    } else {
        s1 = P_PointOnLineSide(trace.x, trace.y, ld)
        s2 = P_PointOnLineSide(trace.x + trace.dx, trace.y + trace.dy, ld)
    }
    if (s1 == s2) {
        // line isn't crossed
        return doom_boolean._c_true
    }
    // hit the line
    P_MakeDivline(ld, addr(dl))
    frac = P_InterceptVector(addr(trace), addr(dl))
    if (frac < 0) {
        // behind source
        return doom_boolean._c_true
    }
    // try to early out the check
    if (uint(earlyout) != 0 && frac < FRACUNIT && ld.backsector == null) {
        // stop checking
        return doom_boolean._c_false
    }
    intercept_p.frac = frac
    intercept_p.isaline = doom_boolean._c_true
    intercept_p.d.line = ld
    intercept_p++
    // continue
    return doom_boolean._c_true
}

// PIT_AddThingIntercepts
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PIT_AddThingIntercepts(var thing : mobj_s?) : doom_boolean {
    var x1 : int
    var y1 : int
    var x2 : int
    var y2 : int
    var s1 : int
    var s2 : int
    var tracepositive : doom_boolean
    var dl : divline_t
    var frac : int
    tracepositive = enum_from_int(type<doom_boolean>, int_of((trace.dx ^ trace.dy) > 0))
    // check a corner to corner crossection for hit
    if (int(tracepositive) != 0) {
        x1 = thing.x - thing.radius
        y1 = thing.y + thing.radius
        x2 = thing.x + thing.radius
        y2 = thing.y - thing.radius
    } else {
        x1 = thing.x - thing.radius
        y1 = thing.y - thing.radius
        x2 = thing.x + thing.radius
        y2 = thing.y + thing.radius
    }
    s1 = P_PointOnDivlineSide(x1, y1, addr(trace))
    s2 = P_PointOnDivlineSide(x2, y2, addr(trace))
    if (s1 == s2) {
        // line isn't crossed
        return doom_boolean._c_true
    }
    dl.x = x1
    dl.y = y1
    dl.dx = x2 - x1
    dl.dy = y2 - y1
    frac = P_InterceptVector(addr(trace), addr(dl))
    if (frac < 0) {
        // behind source
        return doom_boolean._c_true
    }
    intercept_p.frac = frac
    intercept_p.isaline = doom_boolean._c_false
    intercept_p.d.thing = thing
    intercept_p++
    // keep going
    return doom_boolean._c_true
}

// P_TraverseIntercepts
// Returns true if the traverser function returns true
// for all lines.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_TraverseIntercepts(func : function<(var a0 : intercept_t?) : doom_boolean>; maxfrac : int) : doom_boolean {
    var count : int
    var dist : int
    var scan : intercept_t?
    var _c_in : intercept_t?
    count = int(int64(intercept_p - addr(intercepts[0])))
    // shut up compiler warning
    _c_in = null
    while (true) {
        let _t0 = count
        count--
        if (_t0 == 0) {
            break
        }
        dist = DOOM_MAXINT
        scan = addr(intercepts[0])
        while (reinterpret<uint64>(scan) < reinterpret<uint64>(intercept_p)) {
            if (scan.frac < dist) {
                dist = scan.frac
                _c_in = scan
            }
            scan++
        }
        if (dist > maxfrac) {
            // checked everything in range
            return doom_boolean._c_true
        }
        // UNUSED
        // don't check these yet, there may be others inserted
        if (int(invoke(func, _c_in)) == 0) {
            // don't bother going farther
            return doom_boolean._c_false
        }
        _c_in.frac = DOOM_MAXINT
    }
    // everything was traversed
    return doom_boolean._c_true
}

// P_PathTraverse
// Traces a line from x1,y1 to x2,y2,
// calling the traverser function for each.
// Returns true if the traverser function returns true
// for all lines.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_PathTraverse(var x1 : int; var y1 : int; var x2 : int; var y2 : int; flags : int;
                   trav : function<(var a0 : intercept_t?) : doom_boolean>) : doom_boolean {
    var xt1 : int
    var yt1 : int
    var xt2 : int
    var yt2 : int
    var xstep : int
    var ystep : int
    var partial : int
    var xintercept : int
    var yintercept : int
    var mapx : int
    var mapy : int
    var mapxstep : int
    var mapystep : int
    earlyout = enum_from_int(type<doom_boolean>, flags & PT_EARLYOUT)
    validcount++
    intercept_p = addr(intercepts[0])
    if (((x1 - bmaporgx) & (MAPBLOCKSIZE - 1)) == 0) {
        // don't side exactly on a line
        x1 += FRACUNIT
    }
    if (((y1 - bmaporgy) & (MAPBLOCKSIZE - 1)) == 0) {
        // don't side exactly on a line
        y1 += FRACUNIT
    }
    trace.x = x1
    trace.y = y1
    trace.dx = x2 - x1
    trace.dy = y2 - y1
    x1 -= bmaporgx
    y1 -= bmaporgy
    xt1 = x1 >> MAPBLOCKSHIFT
    yt1 = y1 >> MAPBLOCKSHIFT
    x2 -= bmaporgx
    y2 -= bmaporgy
    xt2 = x2 >> MAPBLOCKSHIFT
    yt2 = y2 >> MAPBLOCKSHIFT
    if (xt2 > xt1) {
        mapxstep = 1
        partial = FRACUNIT - ((x1 >> MAPBTOFRAC) & (FRACUNIT - 1))
        ystep = FixedDiv(y2 - y1, doom_abs(x2 - x1))
    } elif (xt2 < xt1) {
        mapxstep = -1
        partial = (x1 >> MAPBTOFRAC) & (FRACUNIT - 1)
        ystep = FixedDiv(y2 - y1, doom_abs(x2 - x1))
    } else {
        mapxstep = 0
        partial = FRACUNIT
        ystep = 256 * FRACUNIT
    }
    yintercept = (y1 >> MAPBTOFRAC) + FixedMul(partial, ystep)
    if (yt2 > yt1) {
        mapystep = 1
        partial = FRACUNIT - ((y1 >> MAPBTOFRAC) & (FRACUNIT - 1))
        xstep = FixedDiv(x2 - x1, doom_abs(y2 - y1))
    } elif (yt2 < yt1) {
        mapystep = -1
        partial = (y1 >> MAPBTOFRAC) & (FRACUNIT - 1)
        xstep = FixedDiv(x2 - x1, doom_abs(y2 - y1))
    } else {
        mapystep = 0
        partial = FRACUNIT
        xstep = 256 * FRACUNIT
    }
    xintercept = (x1 >> MAPBTOFRAC) + FixedMul(partial, xstep)
    // Step through map blocks.
    // Count is present to prevent a round off error
    // from skipping the break.
    mapx = xt1
    mapy = yt1
    for (count in range(64)) {
        if ((flags & PT_ADDLINES) != 0) {
            if (int(P_BlockLinesIterator(mapx, mapy, @@PIT_AddLineIntercepts)) == 0) {
                // early out
                return doom_boolean._c_false
            }
        }
        if ((flags & PT_ADDTHINGS) != 0) {
            if (int(P_BlockThingsIterator(mapx, mapy, @@PIT_AddThingIntercepts)) == 0) {
                // early out
                return doom_boolean._c_false
            }
        }
        if (mapx == xt2 && mapy == yt2) {
            break
        }
        if ((yintercept >> FRACBITS) == mapy) {
            yintercept += ystep
            mapx += mapxstep
        } elif ((xintercept >> FRACBITS) == mapx) {
            xintercept += xstep
            mapy += mapystep
        }
    }
    // go through the sorted list
    return P_TraverseIntercepts(trav, FRACUNIT)
}

