// generated by c2das - regenerate, never edit
var private HUlib_eraseTextLine_lastautomapactive : doom_boolean = doom_boolean._c_true

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_init {
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_clearTextLine(var t : hu_textline_t?) {
    t.len = 0
    t.l[0] = 0u8
    t.needsupdate = int(doom_boolean._c_true)
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_initTextLine(var t : hu_textline_t?; x : int; y : int; var f : uint8 ??; sc : int) {
    t.x = x
    t.y = y
    t.f = f
    t.sc = sc
    HUlib_clearTextLine(t)
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_addCharToTextLine(var t : hu_textline_t?; ch : uint8) : doom_boolean {
    if (t.len == HU_MAXLINELENGTH) {
        return doom_boolean._c_false
    } else {
        let _t0 = t.len
        t.len++
        t.l[_t0] = ch
        t.l[t.len] = 0u8
        t.needsupdate = 4
        return doom_boolean._c_true
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def HUlib_delCharFromTextLine(var t : hu_textline_t?) : doom_boolean {
    if (t.len == 0) {
        return doom_boolean._c_false
    } else {
        t.len--
        t.l[t.len] = 0u8
        t.needsupdate = 4
        return doom_boolean._c_true
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_drawTextLine(var l : hu_textline_t?; drawcursor : doom_boolean) {
    var i : int
    var w : int
    var x : int
    var c : uint8
    // draw the new stuff
    x = l.x
    i = 0
    while (i < l.len) {
        c = uint8(doom_toupper(int(l.l[i])))
        if (c != ' ' && int(c) >= l.sc && int(c) <= '_') {
            w = int(read_patch_t_width(l.f[int(c) - l.sc], 0))
            if (x + w > SCREENWIDTH) {
                break
            }
            V_DrawPatchDirect(x, l.y, FG, l.f[int(c) - l.sc])
            x += w
        } else {
            x += 4
            if (x >= SCREENWIDTH) {
                break
            }
        }
        i++
    }
    // draw the cursor if requested
    if (uint(drawcursor) != 0 && x + int(read_patch_t_width(l.f['_' - l.sc], 0)) <= SCREENWIDTH) {
        V_DrawPatchDirect(x, l.y, FG, l.f['_' - l.sc])
    }
}

// sorta called by HU_Erase and just better darn get things straight
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseTextLine(var l : hu_textline_t?) {
    var lh : int
    var y : int
    var yoffset : int
    // Only erases when NOT in automap and the screen is reduced,
    // and the text must either need updating or refreshing
    // (because of a recent change back from the automap)
    if (int(automapactive) == 0 && viewwindowx != 0 && l.needsupdate != 0) {
        lh = int(read_patch_t_height(l.f[0], 0)) + 1
        y = l.y
        yoffset = y * SCREENWIDTH
        while (y < l.y + lh) {
            if (y < viewwindowy || y >= viewwindowy + viewheight) {
                // erase entire line
                R_VideoErase(uint(yoffset), SCREENWIDTH)
            } else {
                // erase left border
                R_VideoErase(uint(yoffset), viewwindowx)
                R_VideoErase(uint(yoffset + viewwindowx + viewwidth), viewwindowx)
            }
            y++
            yoffset += SCREENWIDTH
        }
    }
    // erase right border
    HUlib_eraseTextLine_lastautomapactive = automapactive
    if (l.needsupdate != 0) {
        l.needsupdate--
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_initSText(var s : hu_stext_t?; x : int; y : int; h : int; var font : uint8 ??; startchar : int; var on : doom_boolean?) {
    s.h = h
    s.on = on
    s.laston = doom_boolean._c_true
    s.cl = 0
    for (i in range(h)) {
        HUlib_initTextLine(addr(s.l[0]) + end_index(i, 4), x, y - i * (int(read_patch_t_height(font[0], 0)) + 1), font, startchar)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_addLineToSText(var s : hu_stext_t?) {
    var i : int
    // add a clear line
    s.cl++
    if (s.cl == s.h) {
        s.cl = 0
    }
    HUlib_clearTextLine(addr(s.l[0]) + end_index(s.cl, 4))
    // everything needs updating
    i = 0
    while (i < s.h) {
        s.l[i].needsupdate = 4
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_addMessageToSText(var s : hu_stext_t?; var prefix : uint8?; var msg : uint8?) {
    HUlib_addLineToSText(s)
    if (prefix != null) {
        while (*prefix != 0) {
            var _t0 = prefix
            prefix++
            HUlib_addCharToTextLine(addr(s.l[0]) + end_index(s.cl, 4), *_t0)
        }
    }
    while (*msg != 0) {
        var _t1 = msg
        msg++
        HUlib_addCharToTextLine(addr(s.l[0]) + end_index(s.cl, 4), *_t1)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_drawSText(var s : hu_stext_t?) {
    var i : int
    var idx : int
    var l : hu_textline_t?
    if (int(*s.on) == 0) {
        // if not on, don't draw
        return
    }
    // draw everything
    i = 0
    while (i < s.h) {
        idx = s.cl - i
        if (idx < 0) {
            // handle queue of lines
            idx += s.h
        }
        l = addr(s.l[0]) + end_index(idx, 4)
        // need a decision made here on whether to skip the draw
        // no cursor, please
        HUlib_drawTextLine(l, doom_boolean._c_false)
        i++
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseSText(var s : hu_stext_t?) {
    var i : int
    i = 0
    while (i < s.h) {
        if (uint(s.laston) != 0 && int(*s.on) == 0) {
            s.l[i].needsupdate = 4
        }
        HUlib_eraseTextLine(addr(s.l[0]) + end_index(i, 4))
        i++
    }
    s.laston = *s.on
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_initIText(var it : hu_itext_t?; x : int; y : int; var font : uint8 ??; startchar : int; var on : doom_boolean?) {
    // default left margin is start of text
    it.lm = 0
    it.on = on
    it.laston = doom_boolean._c_true
    HUlib_initTextLine(addr(it.l), x, y, font, startchar)
}

// The following deletion routines adhere to the left margin restriction
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_delCharFromIText(var it : hu_itext_t?) {
    if (it.l.len != it.lm) {
        HUlib_delCharFromTextLine(addr(it.l))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseLineFromIText(var it : hu_itext_t?) {
    while (it.lm != it.l.len) {
        HUlib_delCharFromTextLine(addr(it.l))
    }
}

// Resets left margin as well
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_resetIText(var it : hu_itext_t?) {
    it.lm = 0
    HUlib_clearTextLine(addr(it.l))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_addPrefixToIText(var it : hu_itext_t?; var str : uint8?) {
    while (*str != 0) {
        var _t0 = str
        str++
        HUlib_addCharToTextLine(addr(it.l), *_t0)
    }
    it.lm = it.l.len
}

// wrapper function for handling general keyed input.
// returns true if it ate the key
[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_keyInIText(var it : hu_itext_t?; ch : uint8) : doom_boolean {
    if (int(ch) >= ' ' && int(ch) <= '_') {
        HUlib_addCharToTextLine(addr(it.l), ch)
    } elif (int(ch) == KEY_BACKSPACE) {
        HUlib_delCharFromIText(it)
    } elif (int(ch) != KEY_ENTER) {
        // did not eat key
        return doom_boolean._c_false
    }
    // ate the key
    return doom_boolean._c_true
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_drawIText(var it : hu_itext_t?) {
    var l : hu_textline_t? = addr(it.l)
    if (int(*it.on) == 0) {
        return
    }
    // draw the line w/ cursor
    HUlib_drawTextLine(l, doom_boolean._c_true)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def HUlib_eraseIText(var it : hu_itext_t?) {
    if (uint(it.laston) != 0 && int(*it.on) == 0) {
        it.l.needsupdate = 4
    }
    HUlib_eraseTextLine(addr(it.l))
    it.laston = *it.on
}

