// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_union

[c_union]
struct actionf_t {
    acp1 : function<(var a0 : void?) : void>
    acv : function<() : void>
    acp2 : function<(var a0 : void?; var a1 : void?) : void>
}

struct thinker_s {
    prev, next : thinker_s?
    _c_function : actionf_t
}

include d_think_h.layout.das.inc

