// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
options strict_aliasing = false
require DOOM_cluster
require c_runtime/c_args
require c_runtime/c_exit
require c_runtime/c_function
require c_runtime/cstr
require c_runtime/printf
require c_runtime/setjmp
require c_types
require crt

[init]
def private c2das_dialect {
    c_long_bits = 64
}

var private virtual_usec : int64 = 0l
var private work_started : int64 = -1l
var private return_from_main : int = 0
var private exit_code : int = 0
var private leave_main : CJmpBuf

let private MAX_UPDATES = 2000000

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private virtual_gettime(var sec : int?; var usec : int?) {
    *sec = int(virtual_usec / 1000000l)
    *usec = int(virtual_usec % 1000000l)
}

// the playback's line: the tics Doom has run and the CPU seconds since the update loop started
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private report_work {
    if (work_started >= 0l) {
        printf(cstr("host: timed %d gametics in %.6f s\n"), gametic, double(crt::clock() - work_started) / double(1000000l))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private flush_and_exit(code : int) {
    report_work()
    crt::fflush(crt::c_stdout())
    if (return_from_main != 0) {
        exit_code = code
        c_longjmp(addr(leave_main), 1)
    }
    c_exit(code)
}

// doom_init and the update loop; under -return-from-main the exit callback's longjmp lands at the
// setjmp and play returns, exit_code set. No return sits after the setjmp: under daslang's JIT a
// return inside the try arm the setjmp lowers to leaves the arm, not the function (F75).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private play(argc : int; var argv : uint8 ??; tic_cap : int) {
    try {
        doom_set_gettime(@@virtual_gettime)
        doom_set_exit(@@flush_and_exit)
        doom_init(argc, argv, 0)
        work_started = crt::clock()
        for (update in range64(int64(MAX_UPDATES))) {
            doom_force_update()
            virtual_usec += int64(1000000 / 35)
            if (tic_cap > 0 && gametic >= tic_cap) {
                printf(cstr("host: stopped after %d tics\n"), gametic)
                flush_and_exit(0)
            }
        }
        printf(cstr("host: Doom did not exit within %d updates\n"), MAX_UPDATES)
        exit_code = 2
    } recover {
        if (c_jmp_target != addr(leave_main)) {
            c_jmp_rethrow()
        }
        c_jmp_target = null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def c_main(argc : int; var argv : uint8 ??) : int {
    var tic_cap : int = 0
    for (i in range(1, argc)) {
        if (crt::strcmp(argv[i], cstr("-tics")) == 0 && i + 1 < argc) {
            tic_cap = crt::atoi(argv[i + 1])
        }
        if (crt::strcmp(argv[i], cstr("-return-from-main")) == 0) {
            return_from_main = 1
        }
    }
    play(argc, argv, tic_cap)
    return exit_code
}

[export]
def main : int {
    c_runtime_init("doom_main")
    return c_main(c_argc(), c_argv())
}
