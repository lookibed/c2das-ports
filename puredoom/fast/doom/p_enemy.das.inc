[unsafe_deref, hint(unsafe_range_check)]
def A_BrainSpit(var mo : mobj_s?) {
    var targ : mobj_s?
    var newmobj : mobj_s?
    A_BrainSpit_easy ^= 1
    if (uint(gameskill) <= uint(skill_t.sk_easy) && (A_BrainSpit_easy == 0)) {
        return
    }
    // shoot a cube at current target
    targ = braintargets[braintargeton]
    braintargeton = (braintargeton + 1) % numbraintargets
    // spawn brain missile
    newmobj = P_SpawnMissile(mo, targ, mobjtype_t.MT_SPAWNSHOT)
    newmobj.target = targ
    newmobj.reactiontime = int(int64((targ.y - mo.y) / newmobj.momy) / newmobj.state.tics)
    S_StartSound(null, int(sfxenum_t.sfx_bospit))
}

