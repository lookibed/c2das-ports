[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_SpawnFly(var mo : mobj_s?) {
    var newmobj : mobj_s?
    var fog : mobj_s?
    var targ : mobj_s?
    var r : int
    var _c_type : mobjtype_t
    mo.reactiontime--
    if (mo.reactiontime != 0) {
        // still flying
        return
    }
    targ = mo.target
    // First spawn teleport fog.
    fog = P_SpawnMobj(targ.x, targ.y, targ.z, mobjtype_t.MT_SPAWNFIRE)
    S_StartSound(reinterpret<void?>(fog), int(sfxenum_t.sfx_telept))
    // Randomly select monster to spawn.
    r = P_Random()
    // Probability distribution (kind of :),
    // decreasing likelihood.
    if (r < 50) {
        _c_type = mobjtype_t.MT_TROOP
    } elif (r < 90) {
        _c_type = mobjtype_t.MT_SERGEANT
    } elif (r < 120) {
        _c_type = mobjtype_t.MT_SHADOWS
    } elif (r < 130) {
        _c_type = mobjtype_t.MT_PAIN
    } elif (r < 160) {
        _c_type = mobjtype_t.MT_HEAD
    } elif (r < 162) {
        _c_type = mobjtype_t.MT_VILE
    } elif (r < 172) {
        _c_type = mobjtype_t.MT_UNDEAD
    } elif (r < 192) {
        _c_type = mobjtype_t.MT_BABY
    } elif (r < 222) {
        _c_type = mobjtype_t.MT_FATSO
    } elif (r < 246) {
        _c_type = mobjtype_t.MT_KNIGHT
    } else {
        _c_type = mobjtype_t.MT_BRUISER
    }
    newmobj = P_SpawnMobj(targ.x, targ.y, targ.z, _c_type)
    if (int(P_LookForPlayers(newmobj, doom_boolean._c_true)) != 0) {
        P_SetMobjState(newmobj, enum_from_int(type<statenum_t>, newmobj.info.seestate))
    }
    // telefrag anything in this spot
    P_TeleportMove(newmobj, newmobj.x, newmobj.y)
    // remove self (i.e., cube).
    P_RemoveMobj(mo)
}

