// PIT_VileCheck
// Detect a corpse that could be raised.
[unsafe_deref, hint(unsafe_range_check)]
def PIT_VileCheck(var thing : mobj_s?) : doom_boolean {
    var maxdist : int
    var check : doom_boolean
    if ((thing.flags & int(mobjflag_t.MF_CORPSE)) == 0) {
        // not a monster
        return doom_boolean._c_true
    }
    if (thing.tics != -1) {
        // not lying still yet
        return doom_boolean._c_true
    }
    if (thing.info.raisestate == int(statenum_t.S_NULL)) {
        // monster doesn't have a raise state
        return doom_boolean._c_true
    }
    maxdist = thing.info.radius + mobjinfo[int(mobjtype_t.MT_VILE)].radius
    if ((thing.x - viletryx < 0 ? -(thing.x - viletryx) : thing.x - viletryx) > maxdist ||
            (thing.y - viletryy < 0 ? -(thing.y - viletryy) : thing.y - viletryy) > maxdist) {
        // not actually touching
        return doom_boolean._c_true
    }
    corpsehit = thing
    corpsehit.momy = 0
    corpsehit.momx = corpsehit.momy
    corpsehit.height <<= 2
    check = P_CheckPosition(corpsehit, corpsehit.x, corpsehit.y)
    corpsehit.height >>= 2
    if (int(check) == 0) {
        // doesn't fit here
        return doom_boolean._c_true
    }
    // got one, so stop checking
    return doom_boolean._c_false
}

// A_VileChase
// Check for ressurecting a body
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_VileChase(var actor : mobj_s?) {
    var xl : int
    var xh : int
    var yl : int
    var yh : int
    var bx : int
    var by : int
    var info : mobjinfo_t?
    var temp : mobj_s?
    if (actor.movedir != int(dirtype_t.DI_NODIR)) {
        // check for corpses to raise
        viletryx = actor.x + actor.info.speed * xspeed[actor.movedir]
        viletryy = actor.y + actor.info.speed * yspeed[actor.movedir]
        xl = (viletryx - bmaporgx - 32 * FRACUNIT * 2) >> MAPBLOCKSHIFT
        xh = (viletryx - bmaporgx + 32 * FRACUNIT * 2) >> MAPBLOCKSHIFT
        yl = (viletryy - bmaporgy - 32 * FRACUNIT * 2) >> MAPBLOCKSHIFT
        yh = (viletryy - bmaporgy + 32 * FRACUNIT * 2) >> MAPBLOCKSHIFT
        vileobj = actor
        bx = xl
        while (bx <= xh) {
            by = yl
            while (by <= yh) {
                // Call PIT_VileCheck to check
                // whether object is a corpse
                // that canbe raised.
                if (int(P_BlockThingsIterator(bx, by, @@PIT_VileCheck)) == 0) {
                    // got one!
                    temp = actor.target
                    actor.target = corpsehit
                    A_FaceTarget(actor)
                    actor.target = temp
                    P_SetMobjState(actor, statenum_t.S_VILE_HEAL1)
                    S_StartSound(reinterpret<void?>(corpsehit), int(sfxenum_t.sfx_slop))
                    info = corpsehit.info
                    P_SetMobjState(corpsehit, enum_from_int(type<statenum_t>, info.raisestate))
                    corpsehit.height <<= 2
                    corpsehit.flags = info.flags
                    corpsehit.health = info.spawnhealth
                    corpsehit.target = null
                    return
                }
                by++
            }
            bx++
        }
    }
    // Return to normal attack.
    A_Chase(actor)
}

