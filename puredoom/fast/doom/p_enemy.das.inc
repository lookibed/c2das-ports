// A_PainShootSkull
// Spawn a lost soul and launch it at the target
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_PainShootSkull(var actor : mobj_s?; angle : uint) {
    var x : int
    var y : int
    var z : int
    var newmobj : mobj_s?
    var an : uint
    var prestep : int
    var count : int
    var currentthinker : thinker_s?
    // count total number of skull currently on the level
    count = 0
    currentthinker = thinkercap.next
    while (intptr(currentthinker) != intptr(addr(thinkercap))) {
        if ((currentthinker._c_function.acp1 == reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) &&
                reinterpret<mobj_s?>(currentthinker)._c_type == mobjtype_t.MT_SKULL) {
            count++
        }
        currentthinker = currentthinker.next
    }
    // if there are allready 20 skulls on the level,
    // don't spit another one
    if (count > 20) {
        return
    }
    // okay, there's playe for another one
    an = angle >> uint(ANGLETOFINESHIFT)
    prestep = 4 * FRACUNIT + 3 * (actor.info.radius + mobjinfo[int(mobjtype_t.MT_SKULL)].radius) / 2
    x = actor.x + FixedMul(prestep, finecosine[an])
    y = actor.y + FixedMul(prestep, finesine[an])
    z = actor.z + 8 * FRACUNIT
    newmobj = P_SpawnMobj(x, y, z, mobjtype_t.MT_SKULL)
    // Check for movements.
    if (int(P_TryMove(newmobj, newmobj.x, newmobj.y)) == 0) {
        // kill it immediately
        P_DamageMobj(newmobj, actor, actor, 10000)
        return
    }
    newmobj.target = actor.target
    A_SkullAttack(newmobj)
}

