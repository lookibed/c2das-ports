// A_BossDeath
// Possibly trigger special effects
// if on first boss level
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_BossDeath(var mo : mobj_s?) {
    var th : thinker_s?
    var mo2 : mobj_s?
    var junk : line_s
    var i : int
    if (gamemode == GameMode_t.commercial) {
        if (gamemap != 7) {
            return
        }
        if ((mo._c_type != mobjtype_t.MT_FATSO) && (mo._c_type != mobjtype_t.MT_BABY)) {
            return
        }
    } else {
        c_switch(gameepisode) {
            case(1) {
                if (gamemap != 8) {
                    return
                }
                if (mo._c_type != mobjtype_t.MT_BRUISER) {
                    return
                }
                break
            }
            case(2) {
                if (gamemap != 8) {
                    return
                }
                if (mo._c_type != mobjtype_t.MT_CYBORG) {
                    return
                }
                break
            }
            case(3) {
                if (gamemap != 8) {
                    return
                }
                if (mo._c_type != mobjtype_t.MT_SPIDER) {
                    return
                }
                break
            }
            case(4) {
                c_switch(gamemap) {
                    case(6) {
                        if (mo._c_type != mobjtype_t.MT_CYBORG) {
                            return
                        }
                        break
                    }
                    case(8) {
                        if (mo._c_type != mobjtype_t.MT_SPIDER) {
                            return
                        }
                        break
                    }
                    case(_) {
                        return
                        break
                    }
                }
                break
            }
            case(_) {
                if (gamemap != 8) {
                    return
                }
                break
            }
        }
    }
    // make sure there is a player alive for victory
    i = 0
    while (i < MAXPLAYERS) {
        if (uint(playeringame[i]) != 0 && players[i].health > 0) {
            break
        }
        i++
    }
    if (i == MAXPLAYERS) {
        // no one left alive, so do not end game
        return
    }
    // scan the remaining thinkers to see
    // if all bosses are dead
    {
        th = thinkercap.next
        var _f = false
        while (true) {
            if (_f) {
                th = th.next
            }
            _f = true
            if (!(intptr(th) != intptr(addr(thinkercap)))) {
                break
            }
            if (th._c_function.acp1 != reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
                continue
            }
            mo2 = reinterpret<mobj_s?>(th)
            if (intptr(mo2) != intptr(mo) && mo2._c_type == mo._c_type && mo2.health > 0) {
                // other boss not dead
                return
            }
        }
    }
    // victory!
    if (gamemode == GameMode_t.commercial) {
        if (gamemap == 7) {
            if (mo._c_type == mobjtype_t.MT_FATSO) {
                junk.tag = int16(666)
                EV_DoFloor(addr(junk), floor_e.lowerFloorToLowest)
                return
            }
            if (mo._c_type == mobjtype_t.MT_BABY) {
                junk.tag = int16(667)
                EV_DoFloor(addr(junk), floor_e.raiseToTexture)
                return
            }
        }
    } else {
        c_switch(gameepisode) {
            case(1) {
                junk.tag = int16(666)
                EV_DoFloor(addr(junk), floor_e.lowerFloorToLowest)
                return
                break
            }
            case(4) {
                c_switch(gamemap) {
                    case(6) {
                        junk.tag = int16(666)
                        EV_DoDoor(addr(junk), vldoor_e.blazeOpen)
                        return
                        break
                    }
                    case(8) {
                        junk.tag = int16(666)
                        EV_DoFloor(addr(junk), floor_e.lowerFloorToLowest)
                        return
                        break
                    }
                }
            }
        }
    }
    G_ExitLevel()
}

