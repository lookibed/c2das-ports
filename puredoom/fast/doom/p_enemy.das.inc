[unsafe_deref, hint(unsafe_range_check)]
def A_BrainScream(var mo : mobj_s?) {
    var x : int
    var y : int
    var z : int
    var th : mobj_s?
    x = mo.x - 196 * FRACUNIT
    while (x < mo.x + 320 * FRACUNIT) {
        y = mo.y - 320 * FRACUNIT
        z = 128 + P_Random() * 2 * FRACUNIT
        th = P_SpawnMobj(x, y, z, mobjtype_t.MT_ROCKET)
        th.momz = P_Random() * 512
        P_SetMobjState(th, statenum_t.S_BRAINEXPLODE1)
        th.tics -= P_Random() & 7
        if (th.tics < 1) {
            th.tics = 1
        }
        x += FRACUNIT * 8
    }
    S_StartSound(null, int(sfxenum_t.sfx_bosdth))
}

