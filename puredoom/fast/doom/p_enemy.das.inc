// Called by P_NoiseAlert.
// Recursively traverse adjacent sectors,
// sound blocking lines cut off traversal.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RecursiveSound(var sec : sector_t?; soundblocks : int) {
    var i : int
    var check : line_s?
    var other : sector_t?
    // wake up all monsters in this sector
    if (sec.validcount == validcount && sec.soundtraversed <= soundblocks + 1) {
        // already flooded
        return
    }
    sec.validcount = validcount
    sec.soundtraversed = soundblocks + 1
    sec.soundtarget = soundtarget
    i = 0
    while (i < sec.linecount) {
        {
            check = sec.lines[i]
            if ((int(check.flags) & ML_TWOSIDED) == 0) {
                continue
            }
            P_LineOpening(check)
            if (openrange <= 0) {
                // closed door
                continue
            }
            if (intptr(sides[int(check.sidenum[0])].sector) == intptr(sec)) {
                other = sides[int(check.sidenum[1])].sector
            } else {
                other = sides[int(check.sidenum[0])].sector
            }
            if ((int(check.flags) & ML_SOUNDBLOCK) != 0) {
                if (soundblocks == 0) {
                    P_RecursiveSound(other, 1)
                }
            } else {
                P_RecursiveSound(other, soundblocks)
            }
        } finally {
            i++
        }
    }
}

// P_NoiseAlert
// If a monster yells at a player,
// it will alert other monsters to the player.
[unsafe_deref, hint(unsafe_range_check)]
def P_NoiseAlert(var target : mobj_s?; var emmiter : mobj_s?) {
    soundtarget = target
    validcount++
    P_RecursiveSound(emmiter.subsector.sector, 0)
}

// P_CheckMeleeRange
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckMeleeRange(var actor : mobj_s?) : doom_boolean {
    var pl : mobj_s?
    var dist : int
    if (actor.target == null) {
        return doom_boolean._c_false
    }
    pl = actor.target
    dist = P_AproxDistance(pl.x - actor.x, pl.y - actor.y)
    if (dist >= MELEERANGE - 20 * FRACUNIT + pl.info.radius) {
        return doom_boolean._c_false
    }
    if (int(P_CheckSight(actor, actor.target)) == 0) {
        return doom_boolean._c_false
    }
    return doom_boolean._c_true
}

// P_CheckMissileRange
[unsafe_deref, hint(unsafe_range_check)]
def P_CheckMissileRange(var actor : mobj_s?) : doom_boolean {
    var dist : int
    if (int(P_CheckSight(actor, actor.target)) == 0) {
        return doom_boolean._c_false
    }
    if ((actor.flags & int(mobjflag_t.MF_JUSTHIT)) != 0) {
        // the target just hit the enemy,
        // so fight back!
        actor.flags &= ~int(mobjflag_t.MF_JUSTHIT)
        return doom_boolean._c_true
    }
    if (actor.reactiontime != 0) {
        // do not attack yet
        return doom_boolean._c_false
    }
    // OPTIMIZE: get this from a global checksight
    dist = P_AproxDistance(actor.x - actor.target.x, actor.y - actor.target.y) - 64 * FRACUNIT
    if (actor.info.meleestate == 0) {
        // no melee attack, so fire more
        dist -= 128 * FRACUNIT
    }
    dist >>= 16
    if (actor._c_type == mobjtype_t.MT_VILE) {
        if (dist > 14 * 64) {
            // too far away
            return doom_boolean._c_false
        }
    }
    if (actor._c_type == mobjtype_t.MT_UNDEAD) {
        if (dist < 196) {
            // close for fist attack
            return doom_boolean._c_false
        }
        dist >>= 1
    }
    if (actor._c_type == mobjtype_t.MT_CYBORG || actor._c_type == mobjtype_t.MT_SPIDER || actor._c_type == mobjtype_t.MT_SKULL) {
        dist >>= 1
    }
    if (dist > 200) {
        dist = 200
    }
    if (actor._c_type == mobjtype_t.MT_CYBORG && dist > 160) {
        dist = 160
    }
    if (P_Random() < dist) {
        return doom_boolean._c_false
    }
    return doom_boolean._c_true
}

// P_Move
// Move in the current direction,
// returns false if the move is blocked.
[unsafe_deref, hint(unsafe_range_check)]
def P_Move(var actor : mobj_s?) : doom_boolean {
    var tryx : int
    var tryy : int
    var ld : line_s?
    // warning: 'catch', 'throw', and 'try'
    // are all C++ reserved words
    var try_ok : doom_boolean
    var good : doom_boolean
    if (actor.movedir == int(dirtype_t.DI_NODIR)) {
        return doom_boolean._c_false
    }
    if (uint(actor.movedir) >= 8u) {
        I_Error(cstr("Error: Weird actor->movedir!"))
    }
    tryx = actor.x + actor.info.speed * xspeed[actor.movedir]
    tryy = actor.y + actor.info.speed * yspeed[actor.movedir]
    try_ok = P_TryMove(actor, tryx, tryy)
    if (int(try_ok) == 0) {
        // open any specials
        if ((actor.flags & int(mobjflag_t.MF_FLOAT)) != 0 && uint(floatok) != 0) {
            // must adjust height
            if (actor.z < tmfloorz) {
                actor.z += FLOATSPEED
            } else {
                actor.z -= FLOATSPEED
            }
            actor.flags |= int(mobjflag_t.MF_INFLOAT)
            return doom_boolean._c_true
        }
        if (numspechit == 0) {
            return doom_boolean._c_false
        }
        actor.movedir = int(dirtype_t.DI_NODIR)
        good = doom_boolean._c_false
        while (true) {
            let _t0 = numspechit
            numspechit--
            if (_t0 == 0) {
                break
            }
            ld = spechit[numspechit]
            // if the special is not a door
            // that can be opened,
            // return false
            if (int(P_UseSpecialLine(actor, ld, 0)) != 0) {
                good = doom_boolean._c_true
            }
        }
        return good
    } else {
        actor.flags &= ~int(mobjflag_t.MF_INFLOAT)
    }
    if ((actor.flags & int(mobjflag_t.MF_FLOAT)) == 0) {
        actor.z = actor.floorz
    }
    return doom_boolean._c_true
}

// TryWalk
// Attempts to move actor on
// in its current (ob->moveangle) direction.
// If blocked by either a wall or an actor
// returns FALSE
// If move is either clear or blocked only by a door,
// returns TRUE and sets...
// If a door is in the way,
// an OpenDoor call is made to start it opening.
[unsafe_deref, hint(unsafe_range_check)]
def P_TryWalk(var actor : mobj_s?) : doom_boolean {
    if (int(P_Move(actor)) == 0) {
        return doom_boolean._c_false
    }
    actor.movecount = P_Random() & 15
    return doom_boolean._c_true
}

[unsafe_deref, hint(unsafe_range_check)]
def P_NewChaseDir(var actor : mobj_s?) {
    var deltax : int
    var deltay : int
    var d : dirtype_t[3]
    var tdir : int
    var olddir : dirtype_t
    var turnaround : dirtype_t
    if (actor.target == null) {
        I_Error(cstr("Error: P_NewChaseDir: called with no target"))
    }
    olddir = enum_from_int(type<dirtype_t>, actor.movedir)
    turnaround = opposite[int(olddir)]
    deltax = actor.target.x - actor.x
    deltay = actor.target.y - actor.y
    if (deltax > 10 * FRACUNIT) {
        d[1] = dirtype_t.DI_EAST
    } elif (deltax < -10 * FRACUNIT) {
        d[1] = dirtype_t.DI_WEST
    } else {
        d[1] = dirtype_t.DI_NODIR
    }
    if (deltay < -10 * FRACUNIT) {
        d[2] = dirtype_t.DI_SOUTH
    } elif (deltay > 10 * FRACUNIT) {
        d[2] = dirtype_t.DI_NORTH
    } else {
        d[2] = dirtype_t.DI_NODIR
    }
    // try direct route
    if (d[1] != dirtype_t.DI_NODIR && d[2] != dirtype_t.DI_NODIR) {
        actor.movedir = int(diags[(int_of(deltay < 0) << 1) + int_of(deltax > 0)])
        if (uint(actor.movedir) != uint(turnaround) && uint(P_TryWalk(actor)) != 0) {
            return
        }
    }
    // try other directions
    if (P_Random() > 200 || doom_abs(deltay) > doom_abs(deltax)) {
        tdir = int(d[1])
        d[1] = d[2]
        d[2] = enum_from_int(type<dirtype_t>, tdir)
    }
    if (d[1] == turnaround) {
        d[1] = dirtype_t.DI_NODIR
    }
    if (d[2] == turnaround) {
        d[2] = dirtype_t.DI_NODIR
    }
    if (d[1] != dirtype_t.DI_NODIR) {
        actor.movedir = int(d[1])
        if (int(P_TryWalk(actor)) != 0) {
            // either moved forward or attacked
            return
        }
    }
    if (d[2] != dirtype_t.DI_NODIR) {
        actor.movedir = int(d[2])
        if (int(P_TryWalk(actor)) != 0) {
            return
        }
    }
    // there is no direct path to the player,
    // so pick another direction.
    if (olddir != dirtype_t.DI_NODIR) {
        actor.movedir = int(olddir)
        if (int(P_TryWalk(actor)) != 0) {
            return
        }
    }
    // randomly determine direction of search
    if ((P_Random() & 1) != 0) {
        for (tdir1 in range(int(dirtype_t.DI_EAST), int(dirtype_t.DI_SOUTHEAST) + 1)) {
            if (uint(tdir1) != uint(turnaround)) {
                actor.movedir = tdir1
                if (int(P_TryWalk(actor)) != 0) {
                    return
                }
            }
        }
    } else {
        tdir = int(dirtype_t.DI_SOUTHEAST)
        while (tdir != (int(dirtype_t.DI_EAST) - 1)) {
            if (uint(tdir) != uint(turnaround)) {
                actor.movedir = tdir
                if (int(P_TryWalk(actor)) != 0) {
                    return
                }
            }
            tdir--
        }
    }
    if (turnaround != dirtype_t.DI_NODIR) {
        actor.movedir = int(turnaround)
        if (int(P_TryWalk(actor)) != 0) {
            return
        }
    }
    // can not move
    actor.movedir = int(dirtype_t.DI_NODIR)
}

// P_LookForPlayers
// If allaround is false, only look 180 degrees in front.
// Returns true if a player is targeted.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LookForPlayers(var actor : mobj_s?; allaround : doom_boolean) : doom_boolean {
    var c : int
    var stop : int
    var player : player_s?
    var sector : sector_t?
    var an : uint
    var dist : int
    sector = actor.subsector.sector
    c = 0
    stop = (actor.lastlook - 1) & 3
    {
        var _f = false
        while (true) {
            if (_f) {
                actor.lastlook = (actor.lastlook + 1) & 3
            }
            _f = true
            if (int(playeringame[actor.lastlook]) == 0) {
                continue
            }
            let _t0 = c
            c++
            if (_t0 == 2 || actor.lastlook == stop) {
                // done looking
                return doom_boolean._c_false
            }
            player = addr(players[0]) + end_index(actor.lastlook, 4)
            if (player.health <= 0) {
                // dead
                continue
            }
            if (int(P_CheckSight(actor, player.mo)) == 0) {
                // out of sight
                continue
            }
            if (int(allaround) == 0) {
                an = R_PointToAngle2(actor.x, actor.y, player.mo.x, player.mo.y) - actor.angle
                if (an > uint(ANG90) && an < ANG270) {
                    dist = P_AproxDistance(player.mo.x - actor.x, player.mo.y - actor.y)
                    // if real close, react anyway
                    if (dist > MELEERANGE) {
                        // behind back
                        continue
                    }
                }
            }
            actor.target = player.mo
            return doom_boolean._c_true
        }
    }
    return doom_boolean._c_false
}

// A_KeenDie
// DOOM II special, map 32.
// Uses special tag 666.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_KeenDie(var mo : mobj_s?) {
    var th : thinker_s?
    var mo2 : mobj_s?
    var junk : line_s
    A_Fall(mo)
    // scan the remaining thinkers
    // to see if all Keens are dead
    {
        th = thinkercap.next
        var _f = false
        while (true) {
            if (_f) {
                th = th.next
            }
            _f = true
            if (!(intptr(th) != intptr(addr(thinkercap)))) {
                break
            }
            if (th._c_function.acp1 != reinterpret<function<(var a0 : void?) : void>>(@@P_MobjThinker)) {
                continue
            }
            mo2 = reinterpret<mobj_s?>(th)
            if (intptr(mo2) != intptr(mo) && mo2._c_type == mo._c_type && mo2.health > 0) {
                // other Keen not dead
                return
            }
        }
    }
    junk.tag = int16(666)
    EV_DoDoor(addr(junk), vldoor_e.door_open)
}

// A_Look
// Stay in state until a player is sighted.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Look(var actor : mobj_s?) {
    var targ : mobj_s?
    // any shot will wake up
    actor.threshold = 0
    targ = actor.subsector.sector.soundtarget
    if (targ != null && (targ.flags & int(mobjflag_t.MF_SHOOTABLE)) != 0) {
        actor.target = targ
        if ((actor.flags & int(mobjflag_t.MF_AMBUSH)) != 0) {
            if (int(P_CheckSight(actor, actor.target)) != 0) {
                goto label 1
            }
        } else {
            goto label 1
        }
    }
    if (int(P_LookForPlayers(actor, doom_boolean._c_false)) == 0) {
        return
    }
    label 1:  // seeyou
    // go into chase state
    if (actor.info.seesound != 0) {
        var sound : int
        c_switch(actor.info.seesound) {
            case(36, 37, 38) {
                sound = int(sfxenum_t.sfx_posit1) + P_Random() % 3
                break
            }
            case(39, 40) {
                sound = int(sfxenum_t.sfx_bgsit1) + P_Random() % 2
                break
            }
            case(_) {
                sound = actor.info.seesound
                break
            }
        }
        if (actor._c_type == mobjtype_t.MT_SPIDER || actor._c_type == mobjtype_t.MT_CYBORG) {
            // full volume
            S_StartSound(null, sound)
        } else {
            S_StartSound(reinterpret<void?>(actor), sound)
        }
    }
    P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.seestate))
}

// A_Chase
// Actor has a melee attack,
// so it tries to close as fast as possible
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_Chase(var actor : mobj_s?) {
    var delta : int
    if (actor.reactiontime != 0) {
        actor.reactiontime--
    }
    // modify target threshold
    if (actor.threshold != 0) {
        if (actor.target == null || actor.target.health <= 0) {
            actor.threshold = 0
        } else {
            actor.threshold--
        }
    }
    // turn towards movement direction if not there yet
    if (actor.movedir < 8) {
        actor.angle &= uint(7 << 29)
        delta = int(actor.angle - uint(actor.movedir << 29))
        if (delta > 0) {
            actor.angle -= uint(ANG90 / 2)
        } elif (delta < 0) {
            actor.angle += uint(ANG90 / 2)
        }
    }
    if (actor.target == null || (actor.target.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // look for a new target
        if (int(P_LookForPlayers(actor, doom_boolean._c_true)) != 0) {
            // got a new target
            return
        }
        P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.spawnstate))
        return
    }
    // do not attack twice in a row
    if ((actor.flags & int(mobjflag_t.MF_JUSTATTACKED)) != 0) {
        actor.flags &= ~int(mobjflag_t.MF_JUSTATTACKED)
        if (gameskill != skill_t.sk_nightmare && int(fastparm) == 0) {
            P_NewChaseDir(actor)
        }
        return
    }
    // check for melee attack
    if (actor.info.meleestate != 0 && uint(P_CheckMeleeRange(actor)) != 0) {
        if (actor.info.attacksound != 0) {
            S_StartSound(reinterpret<void?>(actor), actor.info.attacksound)
        }
        P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.meleestate))
        return
    }
    // check for missile attack
    if (actor.info.missilestate != 0) {
        if (uint(gameskill) < uint(skill_t.sk_nightmare) && int(fastparm) == 0 && actor.movecount != 0) {
            goto label 1
        }
        if (int(P_CheckMissileRange(actor)) == 0) {
            goto label 1
        }
        P_SetMobjState(actor, enum_from_int(type<statenum_t>, actor.info.missilestate))
        actor.flags |= int(mobjflag_t.MF_JUSTATTACKED)
        return
    }
    label 1:  // nomissile
    // ?
    // possibly choose another target
    if (uint(netgame) != 0 && actor.threshold == 0 && int(P_CheckSight(actor, actor.target)) == 0) {
        if (int(P_LookForPlayers(actor, doom_boolean._c_true)) != 0) {
            // got a new target
            return
        }
    }
    // chase towards player
    actor.movecount--
    if (actor.movecount < 0 || int(P_Move(actor)) == 0) {
        P_NewChaseDir(actor)
    }
    // make active sound
    if (actor.info.activesound != 0 && P_Random() < 3) {
        S_StartSound(reinterpret<void?>(actor), actor.info.activesound)
    }
}

// A_FaceTarget
[unsafe_deref, hint(unsafe_range_check)]
def A_FaceTarget(var actor : mobj_s?) {
    if (actor.target == null) {
        return
    }
    actor.flags &= ~int(mobjflag_t.MF_AMBUSH)
    actor.angle = R_PointToAngle2(actor.x, actor.y, actor.target.x, actor.target.y)
    if ((actor.target.flags & int(mobjflag_t.MF_SHADOW)) != 0) {
        actor.angle += uint((P_Random() - P_Random()) << 21)
    }
}

// A_PosAttack
[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_PosAttack(var actor : mobj_s?) {
    var angle : int
    var damage : int
    var slope : int
    if (actor.target == null) {
        return
    }
    A_FaceTarget(actor)
    angle = int(actor.angle)
    slope = P_AimLineAttack(actor, uint(angle), MISSILERANGE)
    S_StartSound(reinterpret<void?>(actor), int(sfxenum_t.sfx_pistol))
    angle += (P_Random() - P_Random()) << 20
    damage = ((P_Random() % 5) + 1) * 3
    P_LineAttack(actor, uint(angle), MISSILERANGE, slope, damage)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def A_SPosAttack(var actor : mobj_s?) {
    var angle : int
    var bangle : int
    var damage : int
    var slope : int
    if (actor.target == null) {
        return
    }
    S_StartSound(reinterpret<void?>(actor), int(sfxenum_t.sfx_shotgn))
    A_FaceTarget(actor)
    bangle = int(actor.angle)
    slope = P_AimLineAttack(actor, uint(bangle), MISSILERANGE)
