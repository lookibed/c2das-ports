// Find string width from hu_font chars
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringWidth(var _c_string : uint8?) : int {
    var i : int
    var w : int = 0
    var c : int
    i = 0
    while (i < doom_strlen(_c_string)) {
        c = doom_toupper(int(_c_string[i])) - HU_FONTSTART
        if (c < 0 || c >= HU_FONTSIZE) {
            w += 4
        } else {
            w += int(read_patch_t_width(hu_font[c], 0))
        }
        i++
    }
    return w
}

// Find string height from hu_font chars
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StringHeight(var _c_string : uint8?) : int {
    var i : int
    var h : int
    let height : int = int(read_patch_t_height(hu_font[0], 0))
    h = height
    i = 0
    while (i < doom_strlen(_c_string)) {
        if (_c_string[i] == '\n') {
            h += height
        }
        i++
    }
    return h
}

// Write a string using the hu_font
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_WriteText(x : int; y : int; var _c_string : uint8?) {
    var w : int
    var ch : uint8?
    var c : int
    var cx : int
    var cy : int
    ch = _c_string
    cx = x
    cy = y
    while (1 != 0) {
        var _t0 = ch
        ch++
        c = int(*_t0)
        if (c == 0) {
            break
        }
        if (c == '\n') {
            cx = x
            cy += 12
            continue
        }
        c = doom_toupper(c) - HU_FONTSTART
        if (c < 0 || c >= HU_FONTSIZE) {
            cx += 4
            continue
        }
        w = int(read_patch_t_width(hu_font[c], 0))
        if (cx + w > SCREENWIDTH) {
            break
        }
        V_DrawPatchDirect(cx, cy, 0, hu_font[c])
        cx += w
    }
}

// M_Responder
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Responder(var ev : event_t?) : doom_boolean {
    var ch : int
    var i : int
    ch = -1
    if (ev._c_type == evtype_t.ev_joystick && M_Responder_joywait < I_GetTime()) {
        if (ev.data3 == -1) {
            ch = KEY_UPARROW
            M_Responder_joywait = I_GetTime() + 5
        } elif (ev.data3 == 1) {
            ch = KEY_DOWNARROW
            M_Responder_joywait = I_GetTime() + 5
        }
        if (ev.data2 == -1) {
            ch = KEY_LEFTARROW
            M_Responder_joywait = I_GetTime() + 2
        } elif (ev.data2 == 1) {
            ch = KEY_RIGHTARROW
            M_Responder_joywait = I_GetTime() + 2
        }
        if ((ev.data1 & 1) != 0) {
            ch = KEY_ENTER
            M_Responder_joywait = I_GetTime() + 5
        }
        if ((ev.data1 & 2) != 0) {
            ch = KEY_BACKSPACE
            M_Responder_joywait = I_GetTime() + 5
        }
    } else {
        if (ev._c_type == evtype_t.ev_mouse && M_Responder_mousewait < I_GetTime()) {
            M_Responder_mousey += ev.data3
            if (M_Responder_mousey < M_Responder_lasty - 30) {
                ch = KEY_DOWNARROW
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lasty -= 30
                M_Responder_mousey = M_Responder_lasty
            } elif (M_Responder_mousey > M_Responder_lasty + 30) {
                ch = KEY_UPARROW
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lasty += 30
                M_Responder_mousey = M_Responder_lasty
            }
            M_Responder_mousex += ev.data2
            if (M_Responder_mousex < M_Responder_lastx - 30) {
                ch = KEY_LEFTARROW
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lastx -= 30
                M_Responder_mousex = M_Responder_lastx
            } elif (M_Responder_mousex > M_Responder_lastx + 30) {
                ch = KEY_RIGHTARROW
                M_Responder_mousewait = I_GetTime() + 5
                M_Responder_lastx += 30
                M_Responder_mousex = M_Responder_lastx
            }
            if ((ev.data1 & 1) != 0) {
                ch = KEY_ENTER
                M_Responder_mousewait = I_GetTime() + 15
            }
            if ((ev.data1 & 2) != 0) {
                ch = KEY_BACKSPACE
                M_Responder_mousewait = I_GetTime() + 15
            }
        } elif (ev._c_type == evtype_t.ev_keydown) {
            ch = ev.data1
        }
    }
    if (ch == -1) {
        return doom_boolean._c_false
    }
    // Save Game string input
    if (saveStringEnter != 0) {
        c_switch(ch) {
            case(127) {
                if (saveCharIndex > 0) {
                    saveCharIndex--
                    savegamestrings[saveSlot][saveCharIndex] = 0u8
                }
                break
            }
            case(27) {
                saveStringEnter = 0
                doom_strcpy(addr(savegamestrings[saveSlot][0]), addr(saveOldString[0]))
                break
            }
            case(13) {
                saveStringEnter = 0
                if (savegamestrings[saveSlot][0] != 0) {
                    M_DoSave(saveSlot)
                }
                break
            }
            case(_) {
                ch = doom_toupper(ch)
                if (ch != 32) {
                    if (ch - HU_FONTSTART < 0 || ch - HU_FONTSTART >= HU_FONTSIZE) {
                        break
                    }
                }
                if (ch >= 32 && ch <= 127 && saveCharIndex < SAVESTRINGSIZE - 1 &&
                        M_StringWidth(addr(savegamestrings[saveSlot][0])) < (SAVESTRINGSIZE - 2) * 8) {
                    let _t0 = saveCharIndex
                    saveCharIndex++
                    savegamestrings[saveSlot][_t0] = uint8(ch)
                    savegamestrings[saveSlot][saveCharIndex] = 0u8
                }
                break
            }
        }
        return doom_boolean._c_true
    }
    // Take care of any messages that need input
    if (messageToPrint != 0) {
        if (messageNeedsInput == doom_boolean._c_true && !(ch == ' ' || ch == 'n' || ch == 'y' || ch == KEY_ESCAPE)) {
            return doom_boolean._c_false
        }
        menuactive = enum_from_int(type<doom_boolean>, messageLastMenuActive)
        messageToPrint = 0
        if (messageRoutine != null) {
            invoke(messageRoutine, ch)
        }
        menuactive = doom_boolean._c_false
        S_StartSound(null, int(sfxenum_t.sfx_swtchx))
        return doom_boolean._c_true
    }
    if (uint(devparm) != 0 && ch == KEY_F1) {
        G_ScreenShot()
        return doom_boolean._c_true
    }
    // F-Keys
    if (int(menuactive) == 0) {
        c_switch(ch) {
            case(45) {
                // Screen size down
                if (uint(automapactive) != 0 || uint(chat_on) != 0) {
                    return doom_boolean._c_false
                }
                M_SizeDisplay(0)
                S_StartSound(null, int(sfxenum_t.sfx_stnmov))
                return doom_boolean._c_true
            }
            case(61) {
                // Screen size up
                if (uint(automapactive) != 0 || uint(chat_on) != 0) {
                    return doom_boolean._c_false
                }
                M_SizeDisplay(1)
                S_StartSound(null, int(sfxenum_t.sfx_stnmov))
                return doom_boolean._c_true
            }
            case(187) {
                // Help key
                M_StartControlPanel()
                if (gamemode == GameMode_t.retail) {
                    currentMenu = addr(ReadDef2)
                } else {
                    currentMenu = addr(ReadDef1)
                }
                itemOn = int16(0)
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                return doom_boolean._c_true
            }
            case(188) {
                // Save
                M_StartControlPanel()
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                M_SaveGame(0)
                return doom_boolean._c_true
            }
            case(189) {
                // Load
                M_StartControlPanel()
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                M_LoadGame(0)
                return doom_boolean._c_true
            }
            case(190) {
                // Sound Volume
                M_StartControlPanel()
                currentMenu = addr(SoundDef)
                itemOn = int16(anon_826.sfx_vol)
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                return doom_boolean._c_true
            }
            case(191) {
                // case KEY_F5: // Detail toggle
                // M_ChangeDetail(0);
                // S_StartSound(0, sfx_swtchn);
                // return true;
                // Crosshair toggle
                M_ChangeCrosshair(0)
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                return doom_boolean._c_true
            }
            case(192) {
                // Quicksave
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                M_QuickSave()
                return doom_boolean._c_true
            }
            case(193) {
                // End game
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                M_EndGame(0)
                return doom_boolean._c_true
            }
            case(194) {
                // Toggle messages
                M_ChangeMessages(0)
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                return doom_boolean._c_true
            }
            case(195) {
                // Quickload
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                M_QuickLoad()
                return doom_boolean._c_true
            }
            case(196) {
                // Quit DOOM
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
                M_QuitDOOM(0)
                return doom_boolean._c_true
            }
            case(215) {
                // gamma toggle
                usegamma++
                if (usegamma > 4) {
                    usegamma = 0
                }
                players[consoleplayer].message = addr(gammamsg[usegamma][0])
                I_SetPalette(reinterpret<uint8?>(W_CacheLumpName(cstr("PLAYPAL"), PU_CACHE)))
                return doom_boolean._c_true
            }
        }
    }
    // Pop-up menu?
    if (int(menuactive) == 0) {
        if (ch == KEY_ESCAPE) {
            M_StartControlPanel()
            S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            return doom_boolean._c_true
        }
        return doom_boolean._c_false
    }
    // Keys usable within menu
    c_switch(ch) {
        case(175) {
            c_do_while(currentMenu.menuitems[int(itemOn)].status == -1) {
                if (int(itemOn) + 1 > int(currentMenu.numitems) - 1) {
                    itemOn = int16(0)
                } else {
                    itemOn = int16(int(itemOn) + 1)
                }
                S_StartSound(null, int(sfxenum_t.sfx_pstop))
            }
            return doom_boolean._c_true
        }
        case(173) {
            c_do_while(currentMenu.menuitems[int(itemOn)].status == -1) {
                if (itemOn == 0) {
                    itemOn = int16(int(currentMenu.numitems) - 1)
                } else {
                    itemOn = int16(int(itemOn) - 1)
                }
                S_StartSound(null, int(sfxenum_t.sfx_pstop))
            }
            return doom_boolean._c_true
        }
        case(172) {
            if (currentMenu.menuitems[int(itemOn)].routine != null && currentMenu.menuitems[int(itemOn)].status == 2) {
                S_StartSound(null, int(sfxenum_t.sfx_stnmov))
                invoke(currentMenu.menuitems[int(itemOn)].routine, 0)
            }
            return doom_boolean._c_true
        }
        case(174) {
            if (currentMenu.menuitems[int(itemOn)].routine != null && currentMenu.menuitems[int(itemOn)].status == 2) {
                S_StartSound(null, int(sfxenum_t.sfx_stnmov))
                invoke(currentMenu.menuitems[int(itemOn)].routine, 1)
            }
            return doom_boolean._c_true
        }
        case(13) {
            if (currentMenu.menuitems[int(itemOn)].routine != null && currentMenu.menuitems[int(itemOn)].status != 0) {
                currentMenu.lastOn = itemOn
                if (currentMenu.menuitems[int(itemOn)].status == 2) {
                    // right arrow
                    invoke(currentMenu.menuitems[int(itemOn)].routine, 1)
                    S_StartSound(null, int(sfxenum_t.sfx_stnmov))
                } else {
                    invoke(currentMenu.menuitems[int(itemOn)].routine, int(itemOn))
                    S_StartSound(null, int(sfxenum_t.sfx_pistol))
                }
            }
            return doom_boolean._c_true
        }
        case(27) {
            currentMenu.lastOn = itemOn
            M_ClearMenus()
            S_StartSound(null, int(sfxenum_t.sfx_swtchx))
            return doom_boolean._c_true
        }
        case(127) {
            currentMenu.lastOn = itemOn
            if (currentMenu.prevMenu != null) {
                currentMenu = currentMenu.prevMenu
                itemOn = currentMenu.lastOn
                S_StartSound(null, int(sfxenum_t.sfx_swtchn))
            }
            return doom_boolean._c_true
        }
        case(_) {
            i = int(itemOn) + 1
            while (i < int(currentMenu.numitems)) {
                if (int(currentMenu.menuitems[i].alphaKey) == ch) {
                    itemOn = int16(i)
                    S_StartSound(null, int(sfxenum_t.sfx_pstop))
                    return doom_boolean._c_true
                }
                i++
            }
            i = 0
            while (i <= int(itemOn)) {
                if (int(currentMenu.menuitems[i].alphaKey) == ch) {
                    itemOn = int16(i)
                    S_StartSound(null, int(sfxenum_t.sfx_pstop))
                    return doom_boolean._c_true
                }
                i++
            }
            break
        }
    }
    return doom_boolean._c_false
}

// M_StartControlPanel
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_StartControlPanel {
    // intro might call this repeatedly
    if (int(menuactive) != 0) {
        return
    }
    menuactive = doom_boolean._c_true
    // JDC
    currentMenu = addr(MainDef)
    // JDC
    itemOn = currentMenu.lastOn
}

// M_Drawer
// Called after the view has been rendered,
// but before it has been blitted.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Drawer {
    var i : int16
    var max : int16
    var _c_string : uint8[40]
    var start : int
    inhelpscreens = doom_boolean._c_false
    // Horiz. & Vertically center string and print it.
    if (messageToPrint != 0) {
        start = 0
        M_Drawer_y = int16(100 - M_StringHeight(messageString) / 2)
        while (messageString[start] != 0) {
            i = int16(0)
            while (int(i) < doom_strlen(messageString + start)) {
                if ((messageString + start)[int(i)] == '\n') {
                    doom_memset(reinterpret<void?>(addr(_c_string[0])), 0, 40)
                    doom_strncpy(addr(_c_string[0]), messageString + start, int(i))
                    start += int(i) + 1
                    break
                }
                i = int16(int(i) + 1)
            }
            if (int(i) == doom_strlen(messageString + start)) {
                doom_strcpy(addr(_c_string[0]), messageString + start)
                start += int(i)
            }
            M_Drawer_x = int16(160 - M_StringWidth(addr(_c_string[0])) / 2)
            M_WriteText(int(M_Drawer_x), int(M_Drawer_y), addr(_c_string[0]))
            M_Drawer_y = int16(int(M_Drawer_y) + int(read_patch_t_height(hu_font[0], 0)))
        }
        return
    }
    if (int(menuactive) == 0) {
        return
    }
    // Darken background so the menu is more readable.
    if ((doom_flags & DOOM_FLAG_MENU_DARKEN_BG) != 0) {
        {
            var j : int = 0
            let len : int = SCREENWIDTH * SCREENHEIGHT
            while (j < len) {
                var color : uint8 = screens[0][j]
                color = colormaps[int(color) + (20 * 256)]
                screens[0][j] = color
                j++
            }
        }
    }
    if (currentMenu.routine != null) {
        // call Draw routine
        invoke(currentMenu.routine)
    }
    // DRAW MENU
    M_Drawer_x = currentMenu.x
    M_Drawer_y = currentMenu.y
    max = currentMenu.numitems
    i = int16(0)
    while (int(i) < int(max)) {
        var menuitem : menuitem_t? = currentMenu.menuitems + int(i)
        if (menuitem.name[0] != 0) {
            if (doom_strncmp(addr(menuitem.name[0]), cstr("TXT_"), 4) == 0) {
                M_DrawCustomMenuText(addr(menuitem.name[0]), int(M_Drawer_x), int(M_Drawer_y))
            } else {
                V_DrawPatchDirect(int(M_Drawer_x), int(M_Drawer_y), 0, reinterpret<uint8?>(W_CacheLumpName(addr(menuitem.name[0]), PU_CACHE)))
            }
        }
        M_Drawer_y = int16(int(M_Drawer_y) + LINEHEIGHT)
        i = int16(int(i) + 1)
    }
    // DRAW SKULL
    V_DrawPatchDirect(int(M_Drawer_x) + SKULLXOFF, int(currentMenu.y) - 5 + int(itemOn) * LINEHEIGHT, 0,
            reinterpret<uint8?>(W_CacheLumpName(addr(skullName[int(whichSkull)][0]), PU_CACHE)))
}

// M_ClearMenus
[unsafe_deref, hint(unsafe_range_check)]
def M_ClearMenus {
    menuactive = doom_boolean._c_false
}

// M_SetupNextMenu
[unsafe_deref, hint(unsafe_range_check)]
def M_SetupNextMenu(var menudef : menu_s?) {
    currentMenu = menudef
    itemOn = currentMenu.lastOn
}

// M_Ticker
[unsafe_deref, hint(unsafe_range_check)]
def M_Ticker {
    skullAnimCounter = int16(int(skullAnimCounter) - 1)
    if (int(skullAnimCounter) <= 0) {
        whichSkull = int16(int(whichSkull) ^ 1)
        skullAnimCounter = int16(8)
    }
}

// M_Init
[c_function, unsafe_deref, hint(unsafe_range_check)]
def M_Init {
    let hide_mouse : doom_boolean = (doom_flags & DOOM_FLAG_HIDE_MOUSE_OPTIONS) != 0 ? doom_boolean._c_true : doom_boolean._c_false
    let hide_sound : doom_boolean = ((doom_flags & DOOM_FLAG_HIDE_MUSIC_OPTIONS) != 0 &&
            (doom_flags & DOOM_FLAG_HIDE_SOUND_OPTIONS) != 0) ? doom_boolean._c_true : doom_boolean._c_false
    OptionsMenu = addr(OptionsMenuFull[0])
    if (uint(hide_mouse) != 0 && int(hide_sound) == 0) {
        OptionsMenu = addr(OptionsMenuNoMouse[0])
        doom_memcpy(reinterpret<void?>(addr(OptionsDef)), reinterpret<void?>(addr(OptionsNoMouseDef)), typeinfo sizeof(type<menu_s>))
    } elif (int(hide_mouse) == 0 && uint(hide_sound) != 0) {
        OptionsMenu = addr(OptionsMenuNoSound[0])
        doom_memcpy(reinterpret<void?>(addr(OptionsDef)), reinterpret<void?>(addr(OptionsNoSoundDef)), typeinfo sizeof(type<menu_s>))
    } elif (uint(hide_mouse) != 0 && uint(hide_sound) != 0) {
        OptionsMenu = addr(OptionsMenuNoSoundNoMouse[0])
        doom_memcpy(reinterpret<void?>(addr(OptionsDef)), reinterpret<void?>(addr(OptionsNoSoundNoMouseDef)), typeinfo sizeof(type<menu_s>))
    }
    SoundMenu = addr(SoundMenuFull[0])
    if ((doom_flags & DOOM_FLAG_HIDE_MUSIC_OPTIONS) != 0) {
        SoundMenu = addr(SoundMenuNoMusic[0])
        doom_memcpy(reinterpret<void?>(addr(SoundDef)), reinterpret<void?>(addr(SoundNoMusicDef)), typeinfo sizeof(type<menu_s>))
    } elif ((doom_flags & DOOM_FLAG_HIDE_SOUND_OPTIONS) != 0) {
        SoundMenu = addr(SoundMenuNoSFX[0])
        doom_memcpy(reinterpret<void?>(addr(SoundDef)), reinterpret<void?>(addr(SoundNoSFXDef)), typeinfo sizeof(type<menu_s>))
    }
    currentMenu = addr(MainDef)
    menuactive = doom_boolean._c_false
    itemOn = currentMenu.lastOn
    whichSkull = int16(0)
    skullAnimCounter = int16(10)
    screenSize = screenblocks - 3
    messageToPrint = 0
    messageString = null
    messageLastMenuActive = int(menuactive)
    quickSaveSlot = -1
    // Here we could catch other version dependencies,
    // like HELP1/2, and four episodes.
    c_switch(gamemode) {
        case(GameMode_t.commercial) {
            // This is used because DOOM 2 had only one HELP
            // page. I use CREDIT as second page now, but
            // kept this hack for educational purposes.
            MainMenu[int(anon_809.readthis)] = MainMenu[int(anon_809.quitdoom)]
            MainDef.numitems = int16(int(MainDef.numitems) - 1)
            MainDef.y = int16(int(MainDef.y) + 8)
            NewDef.prevMenu = addr(MainDef)
            ReadDef1.routine = @@M_DrawReadThis1
            ReadDef1.x = int16(330)
            ReadDef1.y = int16(165)
            ReadMenu1[0].routine = @@M_FinishReadThis
            break
        }
        case(GameMode_t.shareware, GameMode_t.registered) {
            // Episode 2 and 3 are handled,
            // branching to an ad screen.
            // We need to remove the fourth episode.
            EpiDef.numitems = int16(int(EpiDef.numitems) - 1)
            break
        }
        case(GameMode_t.retail, _) {
            // We are fine.
            break
        }
    }
}

