// generated by c2das - regenerate, never edit
var sightzstart : int
var topslope : int
var bottomslope : int
var strace : divline_t
var t2x : int
var t2y : int
var sightcounts : int[2]

// P_DivlineSide
// Returns side 0 (front), 1 (back), or 2 (on).
[unsafe_deref, hint(unsafe_range_check)]
def P_DivlineSide(x : int; y : int; var node : divline_t?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (node.dx == 0) {
        if (x == node.x) {
            return 2
        }
        if (x <= node.x) {
            return int_of(node.dy > 0)
        }
        return int_of(node.dy < 0)
    }
    if (node.dy == 0) {
        if (x == node.y) {
            return 2
        }
        if (y <= node.y) {
            return int_of(node.dx < 0)
        }
        return int_of(node.dx > 0)
    }
    dx = x - node.x
    dy = y - node.y
    left = (node.dy >> FRACBITS) * (dx >> FRACBITS)
    right = (dy >> FRACBITS) * (node.dx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    if (left == right) {
        return 2
    }
    // back side
    return 1
}

// P_InterceptVector2
// Returns the fractional intercept point
// along the first divline.
// This is only called by the addthings and addlines traversers.
[unsafe_deref, hint(unsafe_range_check)]
def P_InterceptVector2(var v2 : divline_t?; var v1 : divline_t?) : int {
    var frac : int
    var num : int
    var den : int
    den = FixedMul(v1.dy >> 8, v2.dx) - FixedMul(v1.dx >> 8, v2.dy)
    if (den == 0) {
        return 0
    }
    num = FixedMul((v1.x - v2.x) >> 8, v1.dy) + FixedMul((v2.y - v1.y) >> 8, v1.dx)
    frac = FixedDiv(num, den)
    return frac
}

// P_CrossSubsector
// Returns true
// if strace crosses the given subsector successfully.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CrossSubsector(num : int) : doom_boolean {
    var seg : seg_t?
    var line : line_s?
    var s1 : int
    var s2 : int
    var count : int
    var sub : subsector_s?
    var front : sector_t?
    var back : sector_t?
    var opentop : int
    var openbottom : int
    var divl : divline_t
    var v1 : vertex_t?
    var v2 : vertex_t?
    var frac : int
    var slope : int
    if (num >= numsubsectors) {
        // I_Error("Error: P_CrossSubsector: ss %i with numss = %i",
        // num,
        // numsubsectors);
        doom_strcpy(addr(error_buf[0]), cstr("Error: P_CrossSubsector: ss "))
        doom_concat(addr(error_buf[0]), doom_itoa(num, 10))
        doom_concat(addr(error_buf[0]), cstr(" with numss = "))
        doom_concat(addr(error_buf[0]), doom_itoa(numsubsectors, 10))
        I_Error(addr(error_buf[0]))
    }
    sub = addr(subsectors[num])
    // check lines
    count = int(sub.numlines)
    seg = addr(segs[int(sub.firstline)])
    {
        var _f = false
        while (true) {
            if (_f) {
                seg++
                count--
            }
            _f = true
            if (count == 0) {
                break
            }
            line = seg.linedef
            // allready checked other side?
            if (line.validcount == validcount) {
                continue
            }
            line.validcount = validcount
            v1 = line.v1
            v2 = line.v2
            s1 = P_DivlineSide(v1.x, v1.y, addr(strace))
            s2 = P_DivlineSide(v2.x, v2.y, addr(strace))
            // line isn't crossed?
            if (s1 == s2) {
                continue
            }
            divl.x = v1.x
            divl.y = v1.y
            divl.dx = v2.x - v1.x
            divl.dy = v2.y - v1.y
            s1 = P_DivlineSide(strace.x, strace.y, addr(divl))
            s2 = P_DivlineSide(t2x, t2y, addr(divl))
            // line isn't crossed?
            if (s1 == s2) {
                continue
            }
            // stop because it is not two sided anyway
            // might do this after updating validcount?
            if ((int(line.flags) & ML_TWOSIDED) == 0) {
                return doom_boolean._c_false
            }
            // crosses a two sided line
            front = seg.frontsector
            back = seg.backsector
            // no wall to block sight with?
            if (front.floorheight == back.floorheight && front.ceilingheight == back.ceilingheight) {
                continue
            }
            // possible occluder
            // because of ceiling height differences
            if (front.ceilingheight < back.ceilingheight) {
                opentop = front.ceilingheight
            } else {
                opentop = back.ceilingheight
            }
            // because of ceiling height differences
            if (front.floorheight > back.floorheight) {
                openbottom = front.floorheight
            } else {
                openbottom = back.floorheight
            }
            // quick test for totally closed doors
            if (openbottom >= opentop) {
                // stop
                return doom_boolean._c_false
            }
            frac = P_InterceptVector2(addr(strace), addr(divl))
            if (front.floorheight != back.floorheight) {
                slope = FixedDiv(openbottom - sightzstart, frac)
                if (slope > bottomslope) {
                    bottomslope = slope
                }
            }
            if (front.ceilingheight != back.ceilingheight) {
                slope = FixedDiv(opentop - sightzstart, frac)
                if (slope < topslope) {
                    topslope = slope
                }
            }
            if (topslope <= bottomslope) {
                // stop
                return doom_boolean._c_false
            }
        }
    }
    // passed the subsector ok
    return doom_boolean._c_true
}

// P_CrossBSPNode
// Returns true
// if strace crosses the given node successfully.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CrossBSPNode(bspnum : int) : doom_boolean {
    var bsp : node_t?
    var side : int
    if ((bspnum & NF_SUBSECTOR) != 0) {
        if (bspnum == -1) {
            return P_CrossSubsector(0)
        } else {
            return P_CrossSubsector(bspnum & (~NF_SUBSECTOR))
        }
    }
    bsp = addr(nodes[bspnum])
    // decide which side the start point is on
    side = P_DivlineSide(strace.x, strace.y, reinterpret<divline_t?>(bsp))
    if (side == 2) {
        // an "on" should cross both sides
        side = 0
    }
    // cross the starting side
    if (int(P_CrossBSPNode(int(bsp.children[side]))) == 0) {
        return doom_boolean._c_false
    }
    // the partition plane is crossed here
    if (side == P_DivlineSide(t2x, t2y, reinterpret<divline_t?>(bsp))) {
        // the line doesn't touch the other side
        return doom_boolean._c_true
    }
    // cross the ending side
    return P_CrossBSPNode(int(bsp.children[side ^ 1]))
}

// P_CheckSight
// Returns true
// if a straight line between t1 and t2 is unobstructed.
// Uses REJECT.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CheckSight(var t1 : mobj_s?; var t2 : mobj_s?) : doom_boolean {
    var s1 : int
    var s2 : int
    var pnum : int
    var bytenum : int
    var bitnum : int
    // First check for trivial rejection.
    // Determine subsector entries in REJECT table.
    s1 = int(int64(t1.subsector.sector - sectors))
    s2 = int(int64(t2.subsector.sector - sectors))
    pnum = s1 * numsectors + s2
    bytenum = pnum >> 3
    bitnum = 1 << (pnum & 7)
    // Check in REJECT table.
    if ((int(rejectmatrix[bytenum]) & bitnum) != 0) {
        sightcounts[0]++
        // can't possibly be connected
        return doom_boolean._c_false
    }
    // An unobstructed LOS is possible.
    // Now look from eyes of t1 to any part of t2.
    sightcounts[1]++
    validcount++
    sightzstart = t1.z + t1.height - (t1.height >> 2)
    topslope = (t2.z + t2.height) - sightzstart
    bottomslope = t2.z - sightzstart
    strace.x = t1.x
    strace.y = t1.y
    t2x = t2.x
    t2y = t2.y
    strace.dx = t2.x - t1.x
    strace.dy = t2.y - t1.y
    // the head node is the last node output
    return P_CrossBSPNode(numnodes - 1)
}

