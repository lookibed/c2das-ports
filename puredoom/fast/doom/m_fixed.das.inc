// generated by c2das - regenerate, never edit
[unsafe_deref, hint(unsafe_range_check)]
def FixedMul(a : int; b : int) : int {
    return int((int64(a) * int64(b)) >> int64(FRACBITS))
}

// FixedDiv, C version.
[unsafe_deref, hint(unsafe_range_check)]
def FixedDiv(a : int; b : int) : int {
    if ((doom_abs(a) >> 14) >= doom_abs(b)) {
        return (a ^ b) < 0 ? DOOM_MININT : DOOM_MAXINT
    }
    return FixedDiv2(a, b)
}

[unsafe_deref, hint(unsafe_range_check)]
def FixedDiv2(a : int; b : int) : int {
    var c : double
    c = double(a) / double(b) * double(FRACUNIT)
    if (c >= 2147483648.0lf || c < -2147483648.0lf) {
        I_Error(cstr("Error: FixedDiv: divide by zero"))
    }
    return int(c)
}

