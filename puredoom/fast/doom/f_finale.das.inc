// F_CastResponder
[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_CastResponder(var ev : event_t?) : doom_boolean {
    if (ev._c_type != evtype_t.ev_keydown) {
        return doom_boolean._c_false
    }
    if (int(castdeath) != 0) {
        // already in dying frames
        return doom_boolean._c_true
    }
    // go into death frame
    castdeath = doom_boolean._c_true
    caststate = addr(states[0]) + end_index(mobjinfo[int(castorder[castnum]._c_type)].deathstate, 967)
    casttics = int(caststate.tics)
    castframes = 0
    castattacking = doom_boolean._c_false
    if (mobjinfo[int(castorder[castnum]._c_type)].deathsound != 0) {
        S_StartSound(null, mobjinfo[int(castorder[castnum]._c_type)].deathsound)
    }
    return doom_boolean._c_true
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def F_CastPrint(var text : uint8?) {
    var ch : uint8?
    var c : int
    var cx : int
    var w : int
    var width : int
    // find width
    ch = text
    width = 0
    while (ch != null) {
        var _t0 = ch
        ch++
        c = int(*_t0)
        if (c == 0) {
            break
        }
        c = doom_toupper(c) - HU_FONTSTART
        if (c < 0 || c > HU_FONTSIZE) {
            width += 4
            continue
        }
        w = int(read_patch_t_width(hu_font[c], 0))
        width += w
    }
    // draw it
    cx = 160 - width / 2
    ch = text
    while (ch != null) {
        var _t1 = ch
        ch++
        c = int(*_t1)
        if (c == 0) {
            break
        }
        c = doom_toupper(c) - HU_FONTSTART
        if (c < 0 || c > HU_FONTSIZE) {
            cx += 4
            continue
        }
        w = int(read_patch_t_width(hu_font[c], 0))
        V_DrawPatch(cx, 180, 0, hu_font[c])
        cx += w
    }
}

