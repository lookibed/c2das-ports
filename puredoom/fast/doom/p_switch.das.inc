    // do something
    c_switch(int(line.special)) {
        case(1, 26, 27, 28, 31, 32, 33, 34, 117, 118) {
            // MANUALS
            // Vertical Door
            // Blue Door/Locked
            // Yellow Door /Locked
            // Red Door /Locked
