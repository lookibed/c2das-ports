// generated by c2das - regenerate, never edit
var thinkercap : thinker_s
var leveltime : int

// P_InitThinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_InitThinkers {
    thinkercap.next = addr(thinkercap)
    thinkercap.prev = thinkercap.next
}

// P_AddThinker
// Adds a new thinker at the end of the list.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_AddThinker(var thinker : thinker_s?) {
    thinkercap.prev.next = thinker
    thinker.next = addr(thinkercap)
    thinker.prev = thinkercap.prev
    thinkercap.prev = thinker
}

// P_RemoveThinker
// Deallocation is lazy -- it will not actually be freed
// until its thinking turn comes up.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RemoveThinker(var thinker : thinker_s?) {
    // FIXME: NOP.
    thinker._c_function.acv = reinterpret<function<() : void>>(uint64(-1))
}

// P_RunThinkers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_RunThinkers {
    var currentthinker : thinker_s?
    currentthinker = thinkercap.next
    while (currentthinker != addr(thinkercap)) {
        if (currentthinker._c_function.acv == reinterpret<function<() : void>>(uint64(-1))) {
            // time to remove it
            currentthinker.next.prev = currentthinker.prev
            currentthinker.prev.next = currentthinker.next
            Z_Free(reinterpret<void?>(currentthinker))
        } else {
            if (currentthinker._c_function.acp1 != null) {
                invoke(currentthinker._c_function.acp1, reinterpret<void?>(currentthinker))
            }
        }
        currentthinker = currentthinker.next
    }
}

// P_Ticker
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_Ticker {
    // run the tic
    if (int(paused) != 0) {
        return
    }
    // pause if in menu and at least one tic has been run
    if (int(netgame) == 0 && uint(menuactive) != 0 && int(demoplayback) == 0 && players[consoleplayer].viewz != 1) {
        return
    }
    for (i in range(MAXPLAYERS)) {
        if (int(playeringame[i]) != 0) {
            P_PlayerThink(addr(players[0]) + end_index(i, 4))
        }
    }
    P_RunThinkers()
    P_UpdateSpecials()
    P_RespawnSpecials()
    // for par times
    leveltime++
}

