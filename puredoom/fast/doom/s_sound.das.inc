// generated by c2das - regenerate, never edit
struct channel_t {
    sfxinfo : sfxinfo_struct?
    origin : void?
    handle : int
}

var snd_SfxVolume : int = 15
var snd_MusicVolume : int = 15
var private channels_s_sound : channel_t?
var private mus_paused : doom_boolean
var private mus_playing_s_sound : musicinfo_t? = null
var private nextcleanup : int
var numChannels : int

// Initializes sound stuff, including volume
// Sets channels, SFX and music volume,
// allocates channel buffer, sets S_sfx lookup.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_Init(sfxVolume : int; musicVolume : int) {
    var i : int
    // doom_print("S_Init: default sfx volume %d\n", sfxVolume);
    invoke(doom_print, cstr("S_Init: default sfx volume "))
    invoke(doom_print, doom_itoa(sfxVolume, 10))
    invoke(doom_print, cstr("\n"))
    // Whatever these did with DMX, these are rather dummies now.
    I_SetChannels()
    S_SetSfxVolume(sfxVolume)
    // No music with Linux - another dummy.
    S_SetMusicVolume(musicVolume)
    // Allocating the internal channels for mixing
    // (the maximum numer of sounds rendered
    // simultaneously) within zone memory.
    channels_s_sound = reinterpret<channel_t?>(Z_Malloc(int(uint64(numChannels) * uint64(typeinfo sizeof(type<channel_t>))), PU_STATIC, null))
    // Free all channels for use
    i = 0
    while (i < numChannels) {
        channels_s_sound[i].sfxinfo = null
        i++
    }
    // no sounds are playing, and they are not mus_paused
    mus_paused = doom_boolean._c_false
    // Note that sounds have not been cached (yet).
    for (i1 in range(1, int(sfxenum_t.NUMSFX))) {
        S_sfx[i1].usefulness = -1
        S_sfx[i1].lumpnum = S_sfx[i1].usefulness
    }
}

// Per level startup code.
// Kills playing sounds at start of level,
// determines music if any, changes music.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_Start {
    var cnum : int
    var mnum : int
    // kill all playing sounds at start of level
    // (trust me - a good idea)
    cnum = 0
    while (cnum < numChannels) {
        if (channels_s_sound[cnum].sfxinfo != null) {
            S_StopChannel(cnum)
        }
        cnum++
    }
    // start new music for the level
    mus_paused = doom_boolean._c_false
    if (gamemode == GameMode_t.commercial) {
        mnum = int(musicenum_t.mus_runnin) + gamemap - 1
    } else {
        var spmus : int[9] = fixed_array(int(musicenum_t.mus_e3m4), int(musicenum_t.mus_e3m2), int(musicenum_t.mus_e3m3), int(musicenum_t.mus_e1m5),
                int(musicenum_t.mus_e2m7), int(musicenum_t.mus_e2m4), int(musicenum_t.mus_e2m6), int(musicenum_t.mus_e2m5), int(musicenum_t.mus_e1m9))
        // Song - Who? - Where?
        // American e4m1
        // Romero e4m2
        // Shawn e4m3
        // American e4m4
        // Tim e4m5
        // Romero e4m6
        // J.Anderson e4m7 CHIRON.WAD
        // Shawn e4m8
        // Tim e4m9
        if (gameepisode < 4) {
            mnum = int(musicenum_t.mus_e1m1) + (gameepisode - 1) * 9 + gamemap - 1
        } else {
            mnum = spmus[gamemap - 1]
        }
    }
    // HACK FOR COMMERCIAL
    // if (commercial && mnum > mus_e3m9)
    // mnum -= mus_e3m9;
    S_ChangeMusic(mnum, int(doom_boolean._c_true))
    nextcleanup = 15
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_StartSoundAtVolume(var origin_p : void?; sfx_id : int; var volume : int) {
    var rc : int
    var sep : int
    var pitch : int
    var priority : int
    var sfx : sfxinfo_struct?
    var cnum : int
    var origin : mobj_s? = reinterpret<mobj_s?>(origin_p)
    // check for bogus sound #
    if (sfx_id < 1 || sfx_id > int(sfxenum_t.NUMSFX)) {
        // I_Error("Error: Bad sfx #: %d", sfx_id);
        doom_strcpy(addr(error_buf[0]), cstr("Error: Bad sfx #: "))
        doom_concat(addr(error_buf[0]), doom_itoa(sfx_id, 10))
        I_Error(addr(error_buf[0]))
    }
    sfx = addr(S_sfx[0]) + end_index(sfx_id, 109)
    // Initialize sound parameters
    if (sfx.link != null) {
        pitch = sfx.pitch
        priority = sfx.priority
        volume += sfx.volume
        if (volume < 1) {
            return
        }
        if (volume > snd_SfxVolume) {
            volume = snd_SfxVolume
        }
    } else {
        pitch = NORM_PITCH
        priority = NORM_PRIORITY
    }
    // Check to see if it is audible,
    // and if not, modify the params
    if (origin != null && origin != players[consoleplayer].mo) {
        rc = S_AdjustSoundParams(players[consoleplayer].mo, origin, addr(volume), addr(sep), addr(pitch))
        if (origin.x == players[consoleplayer].mo.x && origin.y == players[consoleplayer].mo.y) {
            sep = NORM_SEP
        }
        if (rc == 0) {
            return
        }
    } else {
        sep = NORM_SEP
    }
    // hacks to vary the sfx pitches
    if (sfx_id >= int(sfxenum_t.sfx_sawup) && sfx_id <= int(sfxenum_t.sfx_sawhit)) {
        pitch += 8 - (M_Random() & 15)
        if (pitch < 0) {
            pitch = 0
        } elif (pitch > 255) {
            pitch = 255
        }
    } elif (sfx_id != int(sfxenum_t.sfx_itemup) && sfx_id != int(sfxenum_t.sfx_tink)) {
        pitch += 16 - (M_Random() & 31)
        if (pitch < 0) {
            pitch = 0
        } elif (pitch > 255) {
            pitch = 255
        }
    }
    // kill old sound
    S_StopSound(reinterpret<void?>(origin))
    // try to find a channel
    cnum = S_getChannel(reinterpret<void?>(origin), sfx)
    if (cnum < 0) {
        return
    }
    // This is supposed to handle the loading/caching.
    // For some odd reason, the caching is done nearly
    // each time the sound is needed?
    // get lumpnum if necessary
    if (sfx.lumpnum < 0) {
        sfx.lumpnum = I_GetSfxLumpNum(sfx)
    }
    // cache data if necessary
    if (sfx.data == null) {
        invoke(doom_print, cstr("S_StartSoundAtVolume: 16bit and not pre-cached - wtf?\n"))
    }
    // DOS remains, 8bit handling
    // sfx->data = (void *) W_CacheLumpNum(sfx->lumpnum, PU_MUSIC);
    // fprintf( stderr,
    // "S_StartSoundAtVolume: loading %d (lump %d) : 0x%x\n",
    // sfx_id, sfx->lumpnum, (int)sfx->data );
    // increase the usefulness
    let _t0 = sfx.usefulness
    sfx.usefulness++
    if (_t0 < 0) {
        sfx.usefulness = 1
    }
    // Assigns the handle to one of the channels in the
    // mix/output buffer.
    channels_s_sound[cnum].handle = I_StartSound(sfx_id, volume, sep, pitch, priority)
}

[unsafe_deref, hint(unsafe_range_check)]
def S_StartSound(var origin : void?; sfx_id : int) {
    S_StartSoundAtVolume(origin, sfx_id, snd_SfxVolume)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_StopSound(var origin : void?) {
    var cnum : int
    cnum = 0
    while (cnum < numChannels) {
        if (channels_s_sound[cnum].sfxinfo != null && channels_s_sound[cnum].origin == origin) {
            S_StopChannel(cnum)
            break
        }
        cnum++
    }
}

// Stop and resume music, during game PAUSE.
[unsafe_deref, hint(unsafe_range_check)]
def S_PauseSound {
    if (mus_playing_s_sound != null && int(mus_paused) == 0) {
        I_PauseSong(mus_playing_s_sound.handle)
        mus_paused = doom_boolean._c_true
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def S_ResumeSound {
    if (mus_playing_s_sound != null && uint(mus_paused) != 0) {
        I_ResumeSong(mus_playing_s_sound.handle)
        mus_paused = doom_boolean._c_false
    }
}

// Updates music & sounds
[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_UpdateSounds(var listener_p : void?) {
    var audible : int
    var cnum : int
    var volume : int
    var sep : int
    var pitch : int
    var sfx : sfxinfo_struct?
    var c : channel_t?
    var listener : mobj_s? = reinterpret<mobj_s?>(listener_p)
    cnum = 0
    while (cnum < numChannels) {
        {
            c = addr(channels_s_sound[cnum])
            sfx = c.sfxinfo
            if (c.sfxinfo != null) {
                if (I_SoundIsPlaying(c.handle) != 0) {
                    // initialize parameters
                    volume = snd_SfxVolume
                    pitch = NORM_PITCH
                    sep = NORM_SEP
                    if (sfx.link != null) {
                        pitch = sfx.pitch
                        volume += sfx.volume
                        if (volume < 1) {
                            S_StopChannel(cnum)
                            continue
                        } elif (volume > snd_SfxVolume) {
                            volume = snd_SfxVolume
                        }
                    }
                    // check non-local sounds for distance clipping
                    // or modify their params
                    if (c.origin != null && listener_p != c.origin) {
                        audible = S_AdjustSoundParams(listener, reinterpret<mobj_s?>(c.origin), addr(volume), addr(sep), addr(pitch))
                        if (audible == 0) {
                            S_StopChannel(cnum)
                        } else {
                            I_UpdateSoundParams(c.handle, volume, sep, pitch)
                        }
                    }
                } else {
                    // if channel is allocated but sound has stopped,
                    // free it
                    S_StopChannel(cnum)
                }
            }
        } finally {
            cnum++
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_SetMusicVolume(volume : int) {
    if (volume < 0 || volume > 127) {
        // I_Error("Error: Attempt to set music volume at %d",
        // volume);
        doom_strcpy(addr(error_buf[0]), cstr("Error: Attempt to set music volume at "))
        doom_concat(addr(error_buf[0]), doom_itoa(volume, 10))
        I_Error(addr(error_buf[0]))
    }
    I_SetMusicVolume(127)
    I_SetMusicVolume(volume)
    snd_MusicVolume = volume
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_SetSfxVolume(volume : int) {
    if (volume < 0 || volume > 127) {
        // I_Error("Error: Attempt to set sfx volume at %d", volume);
        doom_strcpy(addr(error_buf[0]), cstr("Error: Attempt to set sfx volume at "))
        doom_concat(addr(error_buf[0]), doom_itoa(volume, 10))
        I_Error(addr(error_buf[0]))
    }
    snd_SfxVolume = volume
}

// Starts some music with the music id found in sounds.h.
[unsafe_deref, hint(unsafe_range_check)]
def S_StartMusic(m_id : int) {
    S_ChangeMusic(m_id, int(doom_boolean._c_false))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_ChangeMusic(musicnum : int; looping : int) {
    var music : musicinfo_t?
    var namebuf : uint8[9]
    if ((musicnum <= int(musicenum_t.mus_None)) || (musicnum >= int(musicenum_t.NUMMUSIC))) {
        // I_Error("Error: Bad music number %d", musicnum);
        doom_strcpy(addr(error_buf[0]), cstr("Error: Bad music number "))
        doom_concat(addr(error_buf[0]), doom_itoa(musicnum, 10))
        I_Error(addr(error_buf[0]))
    } else {
        music = addr(S_music[0]) + end_index(musicnum, 68)
    }
    if (mus_playing_s_sound == music) {
        return
    }
    // shutdown old music
    S_StopMusic()
    // get lumpnum if neccessary
    if (music.lumpnum == 0) {
        // doom_sprintf(namebuf, "d_%s", music->name);
        doom_strcpy(addr(namebuf[0]), cstr("d_"))
        doom_concat(addr(namebuf[0]), music.name)
        music.lumpnum = W_GetNumForName(addr(namebuf[0]))
    }
    // load & register it
    music.data = W_CacheLumpNum(music.lumpnum, PU_MUSIC)
    music.handle = I_RegisterSong(music.data)
    // play it
    I_PlaySong(music.handle, looping)
    mus_playing_s_sound = music
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_StopMusic {
    if (mus_playing_s_sound != null) {
        if (int(mus_paused) != 0) {
            I_ResumeSong(mus_playing_s_sound.handle)
        }
        I_StopSong(mus_playing_s_sound.handle)
        I_UnRegisterSong(mus_playing_s_sound.handle)
        if (reinterpret<memblock_s?>(reinterpret<uint8?>(mus_playing_s_sound.data) + -int64(uint64(typeinfo sizeof(type<memblock_s>)))).id != 1919505) {
            var buf : uint8[260]
            doom_strcpy(addr(buf[0]), cstr("Error: Z_CT at /root/wt-ports-h3/doom/work/src/s_sound.c:"))
            doom_concat(addr(buf[0]), doom_itoa(567, 10))
            I_Error(addr(buf[0]))
        }
        Z_ChangeTag2(mus_playing_s_sound.data, PU_CACHE)
        mus_playing_s_sound.data = null
        mus_playing_s_sound = null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_StopChannel(cnum : int) {
    var c : channel_t? = addr(channels_s_sound[cnum])
    if (c.sfxinfo != null) {
        // stop the sound playing
        if (I_SoundIsPlaying(c.handle) != 0) {
            I_StopSound(c.handle)
        }
        // check to see
        // if other channels are playing the sound
        for (i in range(numChannels)) {
            if (cnum != i && c.sfxinfo == channels_s_sound[i].sfxinfo) {
                break
            }
        }
        // degrade usefulness of sound data
        c.sfxinfo.usefulness--
        c.sfxinfo = null
    }
}

// Changes volume, stereo-separation, and pitch variables
// from the norm of a sound effect to be played.
// If the sound is not audible, returns a 0.
// Otherwise, modifies parameters and returns 1.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_AdjustSoundParams(var listener : mobj_s?; var source : mobj_s?; var vol : int?; var sep : int?; var pitch : int?) : int {
    var approx_dist : int
    var adx : int
    var ady : int
    var angle : uint
    // calculate the distance to sound origin
    // and clip it if necessary
    adx = listener.x - source.x < 0 ? -(listener.x - source.x) : listener.x - source.x
    ady = listener.y - source.y < 0 ? -(listener.y - source.y) : listener.y - source.y
    // From _GG1_ p.428. Appox. eucledian distance fast.
    approx_dist = adx + ady - ((adx < ady ? adx : ady) >> 1)
    if (gamemap != 8 && approx_dist > S_CLIPPING_DIST) {
        return 0
    }
    // angle of source to listener
    angle = R_PointToAngle2(listener.x, listener.y, source.x, source.y)
    if (angle > listener.angle) {
        angle -= listener.angle
    } else {
        angle += (4294967295u - listener.angle)
    }
    angle >>= uint(ANGLETOFINESHIFT)
    // stereo separation
    *sep = 128 - (FixedMul(S_STEREO_SWING, finesine[angle]) >> FRACBITS)
    // volume calculation
    if (approx_dist < S_CLOSE_DIST) {
        *vol = snd_SfxVolume
    } elif (gamemap == 8) {
        if (approx_dist > S_CLIPPING_DIST) {
            approx_dist = S_CLIPPING_DIST
        }
        *vol = 15 + ((snd_SfxVolume - 15) * ((S_CLIPPING_DIST - approx_dist) >> FRACBITS)) / S_ATTENUATOR
    } else {
        // distance effect
        *vol = (snd_SfxVolume * ((S_CLIPPING_DIST - approx_dist) >> FRACBITS)) / S_ATTENUATOR
    }
    return int_of(*vol > 0)
}

// S_getChannel :
// If none available, return -1. Otherwise channel #.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def S_getChannel(var origin : void?; var sfxinfo : sfxinfo_struct?) : int {
    // channel number to use
    var cnum : int
    var c : channel_t?
    // Find an open channel
    cnum = 0
    while (cnum < numChannels) {
        if (channels_s_sound[cnum].sfxinfo == null) {
            break
        } elif (origin != null && channels_s_sound[cnum].origin == origin) {
            S_StopChannel(cnum)
            break
        }
        cnum++
    }
    // None available
    if (cnum == numChannels) {
        // Look for lower priority
        cnum = 0
        while (cnum < numChannels) {
            if (channels_s_sound[cnum].sfxinfo.priority >= sfxinfo.priority) {
                break
            }
            cnum++
        }
        if (cnum == numChannels) {
            // FUCK! No lower priority. Sorry, Charlie.
            return -1
        } else {
            // Otherwise, kick out lower priority.
            S_StopChannel(cnum)
        }
    }
    c = addr(channels_s_sound[cnum])
    // channel is decided to be cnum.
    c.sfxinfo = sfxinfo
    c.origin = origin
    return cnum
}

