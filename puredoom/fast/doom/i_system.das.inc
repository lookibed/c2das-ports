[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_AllocLow(length : int) : uint8? {
    var mem : uint8?
    mem = reinterpret<uint8?>(invoke(doom_malloc, length))
    doom_memset(reinterpret<void?>(mem), 0, length)
    return mem
}

// I_Error
[unsafe_deref, hint(unsafe_range_check)]
def I_Error(var error : uint8?) {
    // Message first.
    if (error != null) {
        invoke(doom_print, error)
    }
    invoke(doom_print, cstr("\n"))
    // Shutdown. Here might be other errors.
    if (int(demorecording) != 0) {
        G_CheckDemoStatus()
    }
    D_QuitNetGame()
    I_ShutdownGraphics()
    invoke(doom_exit, -1)
}

