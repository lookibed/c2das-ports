// generated by c2das - regenerate, never edit
var mb_used : int = int(6ul * (uint64(typeinfo sizeof(type<void?>)) / 4ul))
var emptycmd : ticcmd_t
var private I_GetTime_basetime : int = 0

[unsafe_deref, hint(unsafe_range_check)]
def I_Tactile(on : int; off : int; total : int) {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_BaseTiccmd : ticcmd_t? {
    return addr(emptycmd)
}

[unsafe_deref, hint(unsafe_range_check)]
def I_GetHeapSize : int {
    return mb_used * 1024 * 1024
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_ZoneBase(var size : int?) : uint8? {
    *size = mb_used * 1024 * 1024
    return reinterpret<uint8?>(invoke(doom_malloc, *size))
}

// I_GetTime
// returns time in 1/70th second tics
[c_function, unsafe_deref, hint(unsafe_range_check)]
def I_GetTime : int {
    var sec : int
    var usec : int
    var newtics : int
    invoke(doom_gettime, addr(sec), addr(usec))
    if (I_GetTime_basetime == 0) {
        I_GetTime_basetime = sec
    }
    newtics = (sec - I_GetTime_basetime) * TICRATE + usec * TICRATE / 1000000
    return newtics
}

