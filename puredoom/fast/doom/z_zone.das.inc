// Z_FreeMemory
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_FreeMemory : int {
    var _c_block : memblock_s?
    var free : int
    free = 0
    _c_block = mainzone.blocklist.next
    while (_c_block != addr(mainzone.blocklist)) {
        if (_c_block.user == null || _c_block.tag >= PU_PURGELEVEL) {
            free += _c_block.size
        }
        _c_block = _c_block.next
    }
    return free
}

