// generated by c2das - regenerate, never edit
struct memzone_t {
    size : int
    blocklist : memblock_s
    rover : memblock_s?
}

var mainzone : memzone_t?

// Z_ClearZone
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Z_ClearZone(var zone : memzone_t?) {
    var _c_block : memblock_s?
    // set the entire zone to one free block
    _c_block = reinterpret<memblock_s?>(reinterpret<uint8?>(zone) + uint64(typeinfo sizeof(type<memzone_t>)))
    zone.blocklist.prev = _c_block
    zone.blocklist.next = zone.blocklist.prev
    zone.blocklist.user = reinterpret<void ??>(reinterpret<void?>(zone))
    zone.blocklist.tag = PU_STATIC
    zone.rover = _c_block
    _c_block.next = addr(zone.blocklist)
    _c_block.prev = _c_block.next
    // 0 indicates a free block.
    _c_block.user = null
    _c_block.size = int(uint64(zone.size) - uint64(typeinfo sizeof(type<memzone_t>)))
}

