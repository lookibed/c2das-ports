// P_TryMove
// Attempt to move to a new position,
// crossing special lines unless MF_TELEPORT is set.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_TryMove(var thing : mobj_s?; x : int; y : int) : doom_boolean {
    var oldx : int
    var oldy : int
    var side : int
    var oldside : int
    var ld : line_s?
    floatok = doom_boolean._c_false
    if (int(P_CheckPosition(thing, x, y)) == 0) {
        // solid wall or thing
        return doom_boolean._c_false
    }
    if ((thing.flags & int(mobjflag_t.MF_NOCLIP)) == 0) {
        if (tmceilingz - tmfloorz < thing.height) {
            // doesn't fit
            return doom_boolean._c_false
        }
        floatok = doom_boolean._c_true
        if ((thing.flags & int(mobjflag_t.MF_TELEPORT)) == 0 && tmceilingz - thing.z < thing.height) {
            // mobj must lower itself to fit
            return doom_boolean._c_false
        }
        if ((thing.flags & int(mobjflag_t.MF_TELEPORT)) == 0 && tmfloorz - thing.z > 24 * FRACUNIT) {
            // too big a step up
            return doom_boolean._c_false
        }
        if ((thing.flags & (int(mobjflag_t.MF_DROPOFF) | int(mobjflag_t.MF_FLOAT))) == 0 && tmfloorz - tmdropoffz > 24 * FRACUNIT) {
            // don't stand over a dropoff
            return doom_boolean._c_false
        }
    }
    // the move is ok,
    // so link the thing into its new position
    P_UnsetThingPosition(thing)
    oldx = thing.x
    oldy = thing.y
    thing.floorz = tmfloorz
    thing.ceilingz = tmceilingz
    thing.x = x
    thing.y = y
    P_SetThingPosition(thing)
    // if any special lines were hit, do the effect
    if ((thing.flags & (int(mobjflag_t.MF_TELEPORT) | int(mobjflag_t.MF_NOCLIP))) == 0) {
        while (true) {
            let _t0 = numspechit
            numspechit--
            if (_t0 == 0) {
                break
            }
            // see if the line was crossed
            ld = spechit[numspechit]
            side = P_PointOnLineSide(thing.x, thing.y, ld)
            oldside = P_PointOnLineSide(oldx, oldy, ld)
            if (side != oldside) {
                if (ld.special != 0) {
                    P_CrossSpecialLine(int(int64(ld - lines)), oldside, thing)
                }
            }
        }
    }
    return doom_boolean._c_true
}

// P_ThingHeightClip
// Takes a valid thing and adjusts the thing->floorz,
// thing->ceilingz, and possibly thing->z.
// This is called for all nearby monsters
// whenever a sector changes height.
// If the thing doesn't fit,
// the z will be set to the lowest value
// and false will be returned.
[unsafe_deref, hint(unsafe_range_check)]
def P_ThingHeightClip(var thing : mobj_s?) : doom_boolean {
    var onfloor : doom_boolean
    onfloor = enum_from_int(type<doom_boolean>, int_of(thing.z == thing.floorz))
    P_CheckPosition(thing, thing.x, thing.y)
    // what about stranding a monster partially off an edge?
    thing.floorz = tmfloorz
    thing.ceilingz = tmceilingz
    if (int(onfloor) != 0) {
        // walking monsters rise and fall with the floor
        thing.z = thing.floorz
    } else {
        // don't adjust a floating monster unless forced to
        if (thing.z + thing.height > thing.ceilingz) {
            thing.z = thing.ceilingz - thing.height
        }
    }
    if (thing.ceilingz - thing.floorz < thing.height) {
        return doom_boolean._c_false
    }
    return doom_boolean._c_true
}

// P_HitSlideLine
// Adjusts the xmove / ymove
// so that the next move will slide along the wall.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_HitSlideLine(var ld : line_s?) {
    var side : int
    var lineangle : uint
    var moveangle : uint
    var deltaangle : uint
    var movelen : int
    var newlen : int
    if (ld.slopetype == slopetype_t.ST_HORIZONTAL) {
        tmymove = 0
        return
    }
    if (ld.slopetype == slopetype_t.ST_VERTICAL) {
        tmxmove = 0
        return
    }
    side = P_PointOnLineSide(slidemo.x, slidemo.y, ld)
    lineangle = R_PointToAngle2(0, 0, ld.dx, ld.dy)
    if (side == 1) {
        lineangle += ANG180
    }
    moveangle = R_PointToAngle2(0, 0, tmxmove, tmymove)
    deltaangle = moveangle - lineangle
    if (deltaangle > ANG180) {
        deltaangle += ANG180
    }
    lineangle >>= uint(ANGLETOFINESHIFT)
    deltaangle >>= uint(ANGLETOFINESHIFT)
    movelen = P_AproxDistance(tmxmove, tmymove)
    newlen = FixedMul(movelen, finecosine[deltaangle])
    tmxmove = FixedMul(newlen, finecosine[lineangle])
    tmymove = FixedMul(newlen, finesine[lineangle])
}

// PTR_SlideTraverse
[unsafe_deref, hint(unsafe_range_check)]
def PTR_SlideTraverse(var _c_in : intercept_t?) : doom_boolean {
    var li : line_s?
    if (int(_c_in.isaline) == 0) {
        I_Error(cstr("Error: PTR_SlideTraverse: not a line?"))
    }
    li = _c_in.d.line
    if ((int(li.flags) & ML_TWOSIDED) == 0) {
        if (P_PointOnLineSide(slidemo.x, slidemo.y, li) != 0) {
            // don't hit the back side
            return doom_boolean._c_true
        }
        goto label 1
    }
    // set openrange, opentop, openbottom
    P_LineOpening(li)
    if (openrange < slidemo.height) {
        // doesn't fit
        goto label 1
    }
    if (opentop - slidemo.z < slidemo.height) {
        // mobj is too high
        goto label 1
    }
    if (openbottom - slidemo.z > 24 * FRACUNIT) {
        // too big a step up
        goto label 1
    }
    // this line doesn't block movement
    return doom_boolean._c_true
    label 1:  // isblocking
    // the line does block movement,
    // see if it is closer than best so far
    if (_c_in.frac < bestslidefrac) {
        secondslidefrac = bestslidefrac
        secondslideline = bestslideline
        bestslidefrac = _c_in.frac
        bestslideline = li
    }
    // stop
    return doom_boolean._c_false
}

// P_SlideMove
// The momx / momy move is bad, so try to slide
// along a wall.
// Find the first line hit, move flush to it,
// and slide along it
// This is a kludgy mess.
[unsafe_deref, hint(unsafe_range_check)]
def P_SlideMove(var mo : mobj_s?) {
    var leadx : int
    var leady : int
    var trailx : int
    var traily : int
    var newx : int
    var newy : int
    var hitcount : int
    slidemo = mo
    hitcount = 0
    label 1:  // retry
    hitcount++
    if (hitcount == 3) {
        // don't loop forever
        goto label 2
    }
    // trace along the three leading corners
    if (mo.momx > 0) {
        leadx = mo.x + mo.radius
        trailx = mo.x - mo.radius
    } else {
        leadx = mo.x - mo.radius
        trailx = mo.x + mo.radius
    }
    if (mo.momy > 0) {
        leady = mo.y + mo.radius
        traily = mo.y - mo.radius
    } else {
        leady = mo.y - mo.radius
        traily = mo.y + mo.radius
    }
    bestslidefrac = FRACUNIT + 1
    P_PathTraverse(leadx, leady, leadx + mo.momx, leady + mo.momy, PT_ADDLINES, @@PTR_SlideTraverse)
    P_PathTraverse(trailx, leady, trailx + mo.momx, leady + mo.momy, PT_ADDLINES, @@PTR_SlideTraverse)
    P_PathTraverse(leadx, traily, leadx + mo.momx, traily + mo.momy, PT_ADDLINES, @@PTR_SlideTraverse)
    // move up to the wall
    if (!(bestslidefrac == FRACUNIT + 1)) {
        goto label 3
    }
    label 2:  // stairstep
    // the move most have hit the middle, so stairstep
    if (int(P_TryMove(mo, mo.x, mo.y + mo.momy)) == 0) {
        P_TryMove(mo, mo.x + mo.momx, mo.y)
    }
    return
    label 3:  // end if
    // fudge a bit to make sure it doesn't hit
    bestslidefrac -= 2048
    if (bestslidefrac > 0) {
        newx = FixedMul(mo.momx, bestslidefrac)
        newy = FixedMul(mo.momy, bestslidefrac)
        if (int(P_TryMove(mo, mo.x + newx, mo.y + newy)) == 0) {
            goto label 2
        }
    }
    // Now continue along the wall.
    // First calculate remainder.
    bestslidefrac = FRACUNIT - (bestslidefrac + 2048)
    if (bestslidefrac > FRACUNIT) {
        bestslidefrac = FRACUNIT
    }
    if (bestslidefrac <= 0) {
        return
    }
    tmxmove = FixedMul(mo.momx, bestslidefrac)
    tmymove = FixedMul(mo.momy, bestslidefrac)
    // clip the moves
    P_HitSlideLine(bestslideline)
    mo.momx = tmxmove
    mo.momy = tmymove
    if (int(P_TryMove(mo, mo.x + tmxmove, mo.y + tmymove)) == 0) {
        goto label 1
    }
}

// PTR_AimTraverse
// Sets linetaget and aimslope when a target is aimed at.
[unsafe_deref, hint(unsafe_range_check)]
def PTR_AimTraverse(var _c_in : intercept_t?) : doom_boolean {
    var li : line_s?
    var th : mobj_s?
    var slope : int
    var thingtopslope : int
    var thingbottomslope : int
    var dist : int
    if (int(_c_in.isaline) != 0) {
        li = _c_in.d.line
        if ((int(li.flags) & ML_TWOSIDED) == 0) {
            // stop
            return doom_boolean._c_false
        }
        // Crosses a two sided line.
        // A two sided line will restrict
        // the possible target ranges.
        P_LineOpening(li)
        if (openbottom >= opentop) {
            // stop
            return doom_boolean._c_false
        }
        dist = FixedMul(attackrange, _c_in.frac)
        if (li.frontsector.floorheight != li.backsector.floorheight) {
            slope = FixedDiv(openbottom - shootz, dist)
            if (slope > bottomslope) {
                bottomslope = slope
            }
        }
        if (li.frontsector.ceilingheight != li.backsector.ceilingheight) {
            slope = FixedDiv(opentop - shootz, dist)
            if (slope < topslope) {
                topslope = slope
            }
        }
        if (topslope <= bottomslope) {
            // stop
            return doom_boolean._c_false
        }
        // shot continues
        return doom_boolean._c_true
    }
    // shoot a thing
    th = _c_in.d.thing
    if (intptr(th) == intptr(shootthing)) {
        // can't shoot self
        return doom_boolean._c_true
    }
    if ((th.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // corpse or something
        return doom_boolean._c_true
    }
    // check angles to see if the thing can be aimed at
    dist = FixedMul(attackrange, _c_in.frac)
    thingtopslope = FixedDiv(th.z + th.height - shootz, dist)
    if (thingtopslope < bottomslope) {
        // shot over the thing
        return doom_boolean._c_true
    }
    thingbottomslope = FixedDiv(th.z - shootz, dist)
    if (thingbottomslope > topslope) {
        // shot under the thing
        return doom_boolean._c_true
    }
    // this thing can be hit!
    if (thingtopslope > topslope) {
        thingtopslope = topslope
    }
    if (thingbottomslope < bottomslope) {
        thingbottomslope = bottomslope
    }
    aimslope = (thingtopslope + thingbottomslope) / 2
    linetarget = th
    // don't go any farther
    return doom_boolean._c_false
}

// PTR_ShootTraverse
[unsafe_deref, hint(unsafe_range_check)]
def PTR_ShootTraverse(var _c_in : intercept_t?) : doom_boolean {
    var x : int
    var y : int
    var z : int
    var frac : int
    var li : line_s?
    var th : mobj_s?
    var slope : int
    var dist : int
    var thingtopslope : int
    var thingbottomslope : int
    if (int(_c_in.isaline) != 0) {
        li = _c_in.d.line
        if (li.special != 0) {
            P_ShootSpecialLine(shootthing, li)
        }
        if ((int(li.flags) & ML_TWOSIDED) == 0) {
            goto label 1
        }
        // crosses a two sided line
        P_LineOpening(li)
        dist = FixedMul(attackrange, _c_in.frac)
        if (li.frontsector.floorheight != li.backsector.floorheight) {
            slope = FixedDiv(openbottom - shootz, dist)
            if (slope > aimslope) {
                goto label 1
            }
        }
        if (li.frontsector.ceilingheight != li.backsector.ceilingheight) {
            slope = FixedDiv(opentop - shootz, dist)
            if (slope < aimslope) {
                goto label 1
            }
        }
        // shot continues
        return doom_boolean._c_true
        label 1:  // hitline
        // hit line
        // position a bit closer
        frac = _c_in.frac - FixedDiv(4 * FRACUNIT, attackrange)
        x = trace.x + FixedMul(trace.dx, frac)
        y = trace.y + FixedMul(trace.dy, frac)
        z = shootz + FixedMul(aimslope, FixedMul(frac, attackrange))
        if (int(li.frontsector.ceilingpic) == skyflatnum) {
            // don't shoot the sky!
            if (z > li.frontsector.ceilingheight) {
                return doom_boolean._c_false
            }
            // it's a sky hack wall
            if (li.backsector != null && int(li.backsector.ceilingpic) == skyflatnum) {
                return doom_boolean._c_false
            }
        }
        // Spawn bullet puffs.
        P_SpawnPuff(x, y, z)
        // don't go any farther
        return doom_boolean._c_false
    }
    // shoot a thing
    th = _c_in.d.thing
    if (intptr(th) == intptr(shootthing)) {
        // can't shoot self
        return doom_boolean._c_true
    }
    if ((th.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // corpse or something
        return doom_boolean._c_true
    }
    // check angles to see if the thing can be aimed at
    dist = FixedMul(attackrange, _c_in.frac)
    thingtopslope = FixedDiv(th.z + th.height - shootz, dist)
    if (thingtopslope < aimslope) {
        // shot over the thing
        return doom_boolean._c_true
    }
    thingbottomslope = FixedDiv(th.z - shootz, dist)
    if (thingbottomslope > aimslope) {
        // shot under the thing
        return doom_boolean._c_true
    }
    // hit thing
    // position a bit closer
    frac = _c_in.frac - FixedDiv(10 * FRACUNIT, attackrange)
    x = trace.x + FixedMul(trace.dx, frac)
    y = trace.y + FixedMul(trace.dy, frac)
    z = shootz + FixedMul(aimslope, FixedMul(frac, attackrange))
    // Spawn bullet puffs or blod spots,
    // depending on target type.
    if ((_c_in.d.thing.flags & int(mobjflag_t.MF_NOBLOOD)) != 0) {
        P_SpawnPuff(x, y, z)
    } else {
        P_SpawnBlood(x, y, z, la_damage)
    }
    if (la_damage != 0) {
        P_DamageMobj(th, shootthing, shootthing, la_damage)
    }
    // don't go any farther
    return doom_boolean._c_false
}

// P_AimLineAttack
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_AimLineAttack(var t1 : mobj_s?; var angle : uint; distance : int) : int {
    var x2 : int
    var y2 : int
    angle >>= uint(ANGLETOFINESHIFT)
    shootthing = t1
    x2 = t1.x + (distance >> FRACBITS) * finecosine[angle]
    y2 = t1.y + (distance >> FRACBITS) * finesine[angle]
    shootz = t1.z + (t1.height >> 1) + 8 * FRACUNIT
    // can't shoot outside view angles
    topslope = 100 * FRACUNIT / 160
    bottomslope = -100 * FRACUNIT / 160
    attackrange = distance
    linetarget = null
    P_PathTraverse(t1.x, t1.y, x2, y2, PT_ADDLINES | PT_ADDTHINGS, @@PTR_AimTraverse)
    if (linetarget != null) {
        return aimslope
    }
    return 0
}

// P_LineAttack
// If damage == 0, it is just a test trace
// that will leave linetarget set.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_LineAttack(var t1 : mobj_s?; var angle : uint; distance : int; slope : int; damage : int) {
    var x2 : int
    var y2 : int
    angle >>= uint(ANGLETOFINESHIFT)
    shootthing = t1
    la_damage = damage
    x2 = t1.x + (distance >> FRACBITS) * finecosine[angle]
    y2 = t1.y + (distance >> FRACBITS) * finesine[angle]
    shootz = t1.z + (t1.height >> 1) + 8 * FRACUNIT
    attackrange = distance
    aimslope = slope
    P_PathTraverse(t1.x, t1.y, x2, y2, PT_ADDLINES | PT_ADDTHINGS, @@PTR_ShootTraverse)
}

// USE LINES
[c_function, unsafe_deref, hint(unsafe_range_check)]
def PTR_UseTraverse(var _c_in : intercept_t?) : doom_boolean {
    var side : int
    if (_c_in.d.line.special == 0) {
        P_LineOpening(_c_in.d.line)
        if (openrange <= 0) {
            S_StartSound(reinterpret<void?>(usething), int(sfxenum_t.sfx_noway))
            // can't use through a wall
            return doom_boolean._c_false
        }
        // not a special line, but keep checking
        return doom_boolean._c_true
    }
    side = 0
    if (P_PointOnLineSide(usething.x, usething.y, _c_in.d.line) == 1) {
        side = 1
    }
    P_UseSpecialLine(usething, _c_in.d.line, side)
    // can't use for than one special line in a row
    return doom_boolean._c_false
}

// P_UseLines
// Looks for special lines in front of the player to activate.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UseLines(var player : player_s?) {
    var angle : int
    var x1 : int
    var y1 : int
    var x2 : int
    var y2 : int
    usething = player.mo
    angle = int(player.mo.angle >> uint(ANGLETOFINESHIFT))
    x1 = player.mo.x
    y1 = player.mo.y
    x2 = x1 + (USERANGE >> FRACBITS) * finecosine[angle]
    y2 = y1 + (USERANGE >> FRACBITS) * finesine[angle]
    P_PathTraverse(x1, y1, x2, y2, PT_ADDLINES, @@PTR_UseTraverse)
}

// PIT_RadiusAttack
// "bombsource" is the creature
// that caused the explosion at "bombspot".
[unsafe_deref, hint(unsafe_range_check)]
def PIT_RadiusAttack(var thing : mobj_s?) : doom_boolean {
    var dx : int
    var dy : int
    var dist : int
    if ((thing.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        return doom_boolean._c_true
    }
    // Boss spider and cyborg
    // take no damage from concussion.
    if (thing._c_type == mobjtype_t.MT_CYBORG || thing._c_type == mobjtype_t.MT_SPIDER) {
        return doom_boolean._c_true
    }
    dx = thing.x - bombspot.x < 0 ? -(thing.x - bombspot.x) : thing.x - bombspot.x
    dy = thing.y - bombspot.y < 0 ? -(thing.y - bombspot.y) : thing.y - bombspot.y
    dist = dx > dy ? dx : dy
    dist = (dist - thing.radius) >> FRACBITS
    if (dist < 0) {
        dist = 0
    }
    if (dist >= bombdamage) {
        // out of range
        return doom_boolean._c_true
    }
    if (int(P_CheckSight(thing, bombspot)) != 0) {
        // must be in direct path
        P_DamageMobj(thing, bombspot, bombsource, bombdamage - dist)
    }
    return doom_boolean._c_true
}

// P_RadiusAttack
// Source is the creature that caused the explosion at spot.
[unsafe_deref, hint(unsafe_range_check)]
def P_RadiusAttack(var spot : mobj_s?; var source : mobj_s?; damage : int) {
    var x : int
    var y : int
    var xl : int
    var xh : int
    var yl : int
    var yh : int
    var dist : int
    dist = (damage + 32 * FRACUNIT) << FRACBITS
    yh = (spot.y + dist - bmaporgy) >> MAPBLOCKSHIFT
    yl = (spot.y - dist - bmaporgy) >> MAPBLOCKSHIFT
    xh = (spot.x + dist - bmaporgx) >> MAPBLOCKSHIFT
    xl = (spot.x - dist - bmaporgx) >> MAPBLOCKSHIFT
    bombspot = spot
    bombsource = source
    bombdamage = damage
    y = yl
    while (y <= yh) {
        x = xl
        while (x <= xh) {
            P_BlockThingsIterator(x, y, @@PIT_RadiusAttack)
            x++
        }
        y++
    }
}

// PIT_ChangeSector
[unsafe_deref, hint(unsafe_range_check)]
def PIT_ChangeSector(var thing : mobj_s?) : doom_boolean {
    var mo : mobj_s?
    if (int(P_ThingHeightClip(thing)) != 0) {
        // keep checking
        return doom_boolean._c_true
    }
    // crunch bodies to giblets
    if (thing.health <= 0) {
        P_SetMobjState(thing, statenum_t.S_GIBS)
        thing.flags &= ~int(mobjflag_t.MF_SOLID)
        thing.height = 0
        thing.radius = 0
        // keep checking
        return doom_boolean._c_true
    }
    // crunch dropped items
    if ((thing.flags & int(mobjflag_t.MF_DROPPED)) != 0) {
        P_RemoveMobj(thing)
        // keep checking
        return doom_boolean._c_true
    }
    if ((thing.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // assume it is bloody gibs or something
        return doom_boolean._c_true
    }
    nofit = doom_boolean._c_true
    if (uint(crushchange) != 0 && (leveltime & 3) == 0) {
        P_DamageMobj(thing, null, null, 10)
        // spray blood in a random direction
        mo = P_SpawnMobj(thing.x, thing.y, thing.z + thing.height / 2, mobjtype_t.MT_BLOOD)
        mo.momx = (P_Random() - P_Random()) << 12
        mo.momy = (P_Random() - P_Random()) << 12
    }
    // keep checking (crush other things)
    return doom_boolean._c_true
}

// P_ChangeSector
[unsafe_deref, hint(unsafe_range_check)]
def P_ChangeSector(var sector : sector_t?; crunch : doom_boolean) : doom_boolean {
    var x : int
    var y : int
    nofit = doom_boolean._c_false
    crushchange = crunch
    // re-check heights for all things near the moving sector
    x = sector.blockbox[int(anon_787.BOXLEFT)]
    while (x <= sector.blockbox[int(anon_787.BOXRIGHT)]) {
        y = sector.blockbox[int(anon_787.BOXBOTTOM)]
        while (y <= sector.blockbox[int(anon_787.BOXTOP)]) {
            P_BlockThingsIterator(x, y, @@PIT_ChangeSector)
            y++
        }
        x++
    }
    return nofit
}

