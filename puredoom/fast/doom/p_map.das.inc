// PIT_StompThing
[unsafe_deref, hint(unsafe_range_check)]
def PIT_StompThing(var thing : mobj_s?) : doom_boolean {
    var blockdist : int
    if ((thing.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        return doom_boolean._c_true
    }
    blockdist = thing.radius + tmthing.radius
    if ((thing.x - tmx < 0 ? -(thing.x - tmx) : thing.x - tmx) >= blockdist || (thing.y - tmy < 0 ? -(thing.y - tmy) : thing.y - tmy) >= blockdist) {
        // didn't hit it
        return doom_boolean._c_true
    }
    // don't clip against self
    if (intptr(thing) == intptr(tmthing)) {
        return doom_boolean._c_true
    }
    // monsters don't stomp things except on boss level
    if (tmthing.player == null && gamemap != 30) {
        return doom_boolean._c_false
    }
    P_DamageMobj(thing, tmthing, tmthing, 10000)
    return doom_boolean._c_true
}

