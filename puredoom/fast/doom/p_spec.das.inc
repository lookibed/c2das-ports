// RETURN NEXT SECTOR # THAT LINE TAG REFERS TO
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindSectorFromLineTag(var line : line_s?; start : int) : int {
    for (i in range(start + 1, numsectors)) {
        if (sectors[i].tag == line.tag) {
            return i
        }
    }
    return -1
}

// Find minimum light from an adjacent sector
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_FindMinSurroundingLight(var sector : sector_t?; max : int) : int {
    var min : int
    var line : line_s?
    var check : sector_t?
    min = max
    for (i in range(sector.linecount)) {
        line = sector.lines[i]
        check = getNextSector(line, sector)
        if (check == null) {
            continue
        }
        if (int(check.lightlevel) < min) {
            min = int(check.lightlevel)
        }
    }
    return min
}

// P_CrossSpecialLine - TRIGGER
// Called every time a thing origin is about
// to cross a line with a non 0 special.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_CrossSpecialLine(linenum : int; side : int; var thing : mobj_s?) {
    var line : line_s?
    var ok : int
    line = addr(lines[linenum])
    // Triggers that other things can activate
    if (thing.player == null) {
        // Things that should NOT trigger specials...
        c_switch(thing._c_type) {
            case(mobjtype_t.MT_ROCKET, mobjtype_t.MT_PLASMA, mobjtype_t.MT_BFG, mobjtype_t.MT_TROOPSHOT, mobjtype_t.MT_HEADSHOT, mobjtype_t.MT_BRUISERSHOT) {
                return
                break
            }
            case(_) {
                break
            }
        }
        ok = 0
        c_switch(int(line.special)) {
            case(39, 97, 125, 126, 4, 10, 88) {
                // TELEPORT TRIGGER
                // TELEPORT RETRIGGER
                // TELEPORT MONSTERONLY TRIGGER
                // TELEPORT MONSTERONLY RETRIGGER
                // RAISE DOOR
                // PLAT DOWN-WAIT-UP-STAY TRIGGER
                // PLAT DOWN-WAIT-UP-STAY RETRIGGER
                ok = 1
                break
            }
        }
        if (ok == 0) {
            return
        }
    }
    // Note: could use some const's here.
    c_switch(int(line.special)) {
        case(2) {
            // TRIGGERS.
            // All from here to RETRIGGERS.
            // Open Door
            EV_DoDoor(line, vldoor_e.door_open)
            line.special = int16(0)
            break
        }
        case(3) {
            // Close Door
            EV_DoDoor(line, vldoor_e.door_close)
            line.special = int16(0)
            break
        }
        case(4) {
            // Raise Door
            EV_DoDoor(line, vldoor_e.door_normal)
            line.special = int16(0)
            break
        }
        case(5) {
            // Raise Floor
            EV_DoFloor(line, floor_e.raiseFloor)
            line.special = int16(0)
            break
        }
        case(6) {
            // Fast Ceiling Crush & Raise
            EV_DoCeiling(line, ceiling_e.fastCrushAndRaise)
            line.special = int16(0)
            break
