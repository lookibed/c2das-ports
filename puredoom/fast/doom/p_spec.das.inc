            break
        }
        case(126) {
            // TELEPORT MonsterONLY.
            if (thing.player == null) {
                EV_Teleport(line, side, thing)
            }
            break
        }
        case(128) {
            // Raise To Nearest Floor
            EV_DoFloor(line, floor_e.raiseFloorToNearest)
            break
        }
        case(129) {
            // Raise Floor Turbo
            EV_DoFloor(line, floor_e.raiseFloorTurbo)
            break
        }
    }
}

// P_ShootSpecialLine - IMPACT SPECIALS
// Called when a thing shoots a special line.
[unsafe_deref, hint(unsafe_range_check)]
def P_ShootSpecialLine(var thing : mobj_s?; var line : line_s?) {
    var ok : int
    // Impacts that other things can activate.
    if (thing.player == null) {
        ok = 0
        c_switch(int(line.special)) {
            case(46) {
                // OPEN DOOR IMPACT
                ok = 1
                break
            }
        }
        if (ok == 0) {
            return
        }
    }
    c_switch(int(line.special)) {
        case(24) {
            // RAISE FLOOR
            EV_DoFloor(line, floor_e.raiseFloor)
            P_ChangeSwitchTexture(line, 0)
            break
        }
        case(46) {
            // OPEN DOOR
            EV_DoDoor(line, vldoor_e.door_open)
            P_ChangeSwitchTexture(line, 1)
            break
        }
        case(47) {
            // RAISE FLOOR NEAR AND CHANGE
            EV_DoPlat(line, plattype_e.raiseToNearestAndChange, 0)
            P_ChangeSwitchTexture(line, 0)
            break
        }
    }
}

// P_PlayerInSpecialSector
// Called every tic frame
// that the player origin is in a special sector
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_PlayerInSpecialSector(var player : player_s?) {
    var sector : sector_t?
    sector = player.mo.subsector.sector
    // Falling, not all the way down yet?
    if (player.mo.z != sector.floorheight) {
        return
    }
    // Has hitten ground.
    c_switch(int(sector.special)) {
        case(5) {
            // HELLSLIME DAMAGE
            if (player.powers[int(powertype_t.pw_ironfeet)] == 0) {
                if ((leveltime & 31) == 0) {
                    P_DamageMobj(player.mo, null, null, 10)
                }
            }
            break
        }
        case(7) {
            // NUKAGE DAMAGE
            if (player.powers[int(powertype_t.pw_ironfeet)] == 0) {
                if ((leveltime & 31) == 0) {
                    P_DamageMobj(player.mo, null, null, 5)
                }
            }
            break
        }
        case(16, 4) {
            // SUPER HELLSLIME DAMAGE
            // STROBE HURT
            if (player.powers[int(powertype_t.pw_ironfeet)] == 0 || (P_Random() < 5)) {
                if ((leveltime & 31) == 0) {
                    P_DamageMobj(player.mo, null, null, 20)
                }
            }
            break
        }
        case(9) {
            // SECRET SECTOR
            player.secretcount++
            player.message = cstr("A secret is revealed!")
            S_StartSound(null, int(sfxenum_t.sfx_getpow))
            sector.special = int16(0)
            break
        }
        case(11) {
            // EXIT SUPER DAMAGE! (for E1M8 finale)
            player.cheats &= ~int(cheat_t.CF_GODMODE)
            if ((leveltime & 31) == 0) {
                P_DamageMobj(player.mo, null, null, 20)
            }
            if (player.health <= 10) {
                G_ExitLevel()
            }
            break
        }
        case(_) {
            // I_Error("Error: P_PlayerInSpecialSector: "
            // "unknown special %i",
            // sector->special);
            doom_strcpy(addr(error_buf[0]), cstr("Error: P_PlayerInSpecialSector: unknown special "))
            doom_concat(addr(error_buf[0]), doom_itoa(int(sector.special), 10))
            I_Error(addr(error_buf[0]))
            break
        }
    }
}

// P_UpdateSpecials
// Animate planes, scroll walls, etc.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_UpdateSpecials {
    var anim : anim_t?
    var pic : int
    var i : int
    var line : line_s?
    // LEVEL TIMER
    if (levelTimer == doom_boolean._c_true) {
        levelTimeCount--
        if (levelTimeCount == 0) {
            G_ExitLevel()
        }
    }
    // ANIMATE FLATS AND TEXTURES GLOBALLY
    anim = addr(anims[0])
    while (intptr(anim) < intptr(lastanim)) {
        i = anim.basepic
        while (i < anim.basepic + anim.numpics) {
            pic = anim.basepic + ((leveltime / anim.speed + i) % anim.numpics)
            if (int(anim.istexture) != 0) {
                texturetranslation[i] = pic
            } else {
                flattranslation[i] = pic
            }
            i++
        }
        anim++
    }
    // ANIMATE LINE SPECIALS
    for (i1 in range(int(numlinespecials))) {
        line = linespeciallist[i1]
        c_switch(int(line.special)) {
            case(48) {
                // EFFECT FIRSTCOL SCROLL +
                sides[int(line.sidenum[0])].textureoffset += FRACUNIT
                break
            }
        }
    }
    // DO BUTTONS
    for (i1 in range(MAXBUTTONS)) {
        if (buttonlist[i1].btimer != 0) {
            buttonlist[i1].btimer--
            if (buttonlist[i1].btimer == 0) {
                c_switch(buttonlist[i1]._c_where) {
                    case(bwhere_e.top) {
                        sides[int(buttonlist[i1].line.sidenum[0])].toptexture = int16(buttonlist[i1].btexture)
                        break
                    }
                    case(bwhere_e.middle) {
                        sides[int(buttonlist[i1].line.sidenum[0])].midtexture = int16(buttonlist[i1].btexture)
                        break
                    }
                    case(bwhere_e.bottom) {
                        sides[int(buttonlist[i1].line.sidenum[0])].bottomtexture = int16(buttonlist[i1].btexture)
                        break
                    }
                }
                S_StartSound(reinterpret<void?>(reinterpret<mobj_s?>(addr(buttonlist[i1].soundorg))), int(sfxenum_t.sfx_swtchn))
                doom_memset(reinterpret<void?>(addr(buttonlist[0]) + end_index(i1, 16)), 0, typeinfo sizeof(type<button_t>))
            }
        }
    }
}

// Special Stuff that can not be categorized
[c_function, unsafe_deref, hint(unsafe_range_check)]
def EV_DoDonut(var line : line_s?) : int {
    var s1 : sector_t?
    var s2 : sector_t?
    var s3 : sector_t?
    var secnum : int
    var rtn : int
    var i : int
    var floor : floormove_t?
    secnum = -1
    rtn = 0
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        s1 = addr(sectors[secnum])
        // ALREADY MOVING? IF SO, KEEP GOING...
        if (s1.specialdata != null) {
            continue
        }
        rtn = 1
        s2 = getNextSector(s1.lines[0], s1)
        {
            i = 0
            var _f = false
            while (true) {
                if (_f) {
                    i++
                }
                _f = true
                if (!(i < s2.linecount)) {
                    break
                }
                if (((int(s2.lines[i].flags) & ML_TWOSIDED) == 0) || (intptr(s2.lines[i].backsector) == intptr(s1))) {
                    continue
                }
                s3 = s2.lines[i].backsector
                // Spawn rising slime
                floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), PU_LEVSPEC, null))
                P_AddThinker(addr(floor.thinker))
                s2.specialdata = reinterpret<void?>(floor)
                floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
                floor._c_type = floor_e.donutRaise
                floor.crush = doom_boolean._c_false
                floor.direction = 1
                floor.sector = s2
                floor.speed = FRACUNIT / 2
                floor.texture = s3.floorpic
                floor.newspecial = 0
                floor.floordestheight = s3.floorheight
                // Spawn lowering donut-hole
                floor = reinterpret<floormove_t?>(Z_Malloc(typeinfo sizeof(type<floormove_t>), PU_LEVSPEC, null))
                P_AddThinker(addr(floor.thinker))
                s1.specialdata = reinterpret<void?>(floor)
                floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
                floor._c_type = floor_e.lowerFloor
                floor.crush = doom_boolean._c_false
                floor.direction = -1
                floor.sector = s1
                floor.speed = FRACUNIT / 2
                floor.floordestheight = s3.floorheight
                break
            }
        }
    }
    return rtn
}

// Parses command line parameters.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def P_SpawnSpecials {
    var sector : sector_t?
    var i : int
    var episode : int
    episode = 1
    if (W_CheckNumForName(cstr("texture2")) >= 0) {
        episode = 2
    }
    // See if -TIMER needs to be used.
    levelTimer = doom_boolean._c_false
    i = M_CheckParm(cstr("-avg"))
    if (i != 0 && uint(deathmatch) != 0) {
        levelTimer = doom_boolean._c_true
        levelTimeCount = 20 * 60 * 35
    }
    i = M_CheckParm(cstr("-timer"))
    if (i != 0 && uint(deathmatch) != 0) {
        var time : int
        time = doom_atoi(myargv[i + 1]) * 60 * 35
        levelTimer = doom_boolean._c_true
        levelTimeCount = time
    }
    // Init special SECTORs.
    sector = sectors
    i = 0
    while (i < numsectors) {
        {
            if (sector.special == 0) {
                continue
            }
            c_switch(int(sector.special)) {
                case(1) {
                    // FLICKERING LIGHTS
                    P_SpawnLightFlash(sector)
                    break
                }
                case(2) {
                    // STROBE FAST
                    P_SpawnStrobeFlash(sector, FASTDARK, 0)
                    break
                }
                case(3) {
                    // STROBE SLOW
                    P_SpawnStrobeFlash(sector, SLOWDARK, 0)
                    break
                }
                case(4) {
                    // STROBE FAST/DEATH SLIME
                    P_SpawnStrobeFlash(sector, FASTDARK, 0)
                    sector.special = int16(4)
                    break
                }
                case(8) {
                    // GLOWING LIGHT
                    P_SpawnGlowingLight(sector)
                    break
                }
                case(9) {
                    // SECRET SECTOR
                    totalsecret++
                    break
                }
                case(10) {
                    // DOOR CLOSE IN 30 SECONDS
                    P_SpawnDoorCloseIn30(sector)
                    break
                }
                case(12) {
                    // SYNC STROBE SLOW
                    P_SpawnStrobeFlash(sector, SLOWDARK, 1)
                    break
                }
                case(13) {
                    // SYNC STROBE FAST
                    P_SpawnStrobeFlash(sector, FASTDARK, 1)
                    break
                }
                case(14) {
                    // DOOR RAISE IN 5 MINUTES
                    P_SpawnDoorRaiseIn5Mins(sector, i)
                    break
                }
                case(17) {
                    P_SpawnFireFlicker(sector)
                    break
                }
            }
        } finally {
            i++
            sector++
        }
    }
    // Init line EFFECTs
    numlinespecials = int16(0)
    for (i1 in range(numlines)) {
        c_switch(int(lines[i1].special)) {
            case(48) {
                // EFFECT FIRSTCOL SCROLL+
                linespeciallist[int(numlinespecials)] = addr(lines[i1])
                numlinespecials = int16(int(numlinespecials) + 1)
                break
            }
        }
    }
    // Init other misc stuff
    for (i1 in range(MAXCEILINGS)) {
        activeceilings[i1] = null
    }
    for (i1 in range(MAXPLATS)) {
        activeplats[i1] = null
    }
    for (i1 in range(MAXBUTTONS)) {
        doom_memset(reinterpret<void?>(addr(buttonlist[0]) + end_index(i1, 16)), 0, typeinfo sizeof(type<button_t>))
    }
}

