// R_AddLine
// Clips the given segment
// and adds any visible pieces to the line list.
def R_AddLine(var line : seg_t?) {
    var x1 : int
    var x2 : int
    var angle1 : uint
    var angle2 : uint
    var span : uint
    var tspan : uint
    curline = line
    // OPTIMIZE: quickly reject orthogonal back sides.
    angle1 = R_PointToAngle(line.v1.x, line.v1.y)
    angle2 = R_PointToAngle(line.v2.x, line.v2.y)
    // Clip to view edges.
    // OPTIMIZE: make constant out of 2*clipangle (FIELDOFVIEW).
    span = angle1 - angle2
    // Back side? I.e. backface culling?
    if (span >= ANG180) {
        return
    }
    // Global angle needed by segcalc.
    rw_angle1 = int(angle1)
    angle1 -= viewangle
    angle2 -= viewangle
    tspan = angle1 + clipangle
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return
        }
        angle1 = clipangle
    }
    tspan = clipangle - angle2
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return
        }
        angle2 = -clipangle
    }
    // The seg is in the view range,
    // but not necessarily visible.
    angle1 = (angle1 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    angle2 = (angle2 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    x1 = viewangletox[angle1]
    x2 = viewangletox[angle2]
    // Does not cross a pixel?
    if (x1 == x2) {
        return
    }
    backsector = line.backsector
    // Single sided line?
    if (backsector == null) {
        goto label 2
    }
    // Closed door.
    if (backsector.ceilingheight <= frontsector.floorheight || backsector.floorheight >= frontsector.ceilingheight) {
        goto label 2
    }
    // Window.
    if (backsector.ceilingheight != frontsector.ceilingheight || backsector.floorheight != frontsector.floorheight) {
        goto label 1
    }
    // Reject empty lines used for triggers
    // and special events.
    // Identical floor and ceiling on both sides,
    // identical light levels on both sides,
    // and no middle texture.
    if (backsector.ceilingpic == frontsector.ceilingpic && backsector.floorpic == frontsector.floorpic && backsector.lightlevel == frontsector.lightlevel &&
            curline.sidedef.midtexture == 0) {
        return
    }
    label 1:  // clippass
    R_ClipPassWallSegment(x1, x2 - 1)
    return
    label 2:  // clipsolid
    R_ClipSolidWallSegment(x1, x2 - 1)
}

// R_CheckBBox
// Checks BSP node/subtree bounding box.
// Returns true
// if some part of the bbox might be visible.
[c_function]
def R_CheckBBox(var bspcoord : int?) : doom_boolean {
    var boxx : int
    var boxy : int
    var boxpos : int
    var x1 : int
    var y1 : int
    var x2 : int
    var y2 : int
    var angle1 : uint
    var angle2 : uint
    var span : uint
    var tspan : uint
    var start : cliprange_t?
    var sx1 : int
    var sx2 : int
    // Find the corners of the box
    // that define the edges from current viewpoint.
    if (viewx <= bspcoord[int(anon_787.BOXLEFT)]) {
        boxx = 0
    } elif (viewx < bspcoord[int(anon_787.BOXRIGHT)]) {
        boxx = 1
    } else {
        boxx = 2
    }
    if (viewy >= bspcoord[int(anon_787.BOXTOP)]) {
        boxy = 0
    } elif (viewy > bspcoord[int(anon_787.BOXBOTTOM)]) {
        boxy = 1
    } else {
        boxy = 2
    }
    boxpos = (boxy << 2) + boxx
    if (boxpos == 5) {
        return doom_boolean._c_true
    }
    x1 = bspcoord[checkcoord[boxpos][0]]
    y1 = bspcoord[checkcoord[boxpos][1]]
    x2 = bspcoord[checkcoord[boxpos][2]]
    y2 = bspcoord[checkcoord[boxpos][3]]
    // check clip list for an open space
    angle1 = R_PointToAngle(x1, y1) - viewangle
    angle2 = R_PointToAngle(x2, y2) - viewangle
    span = angle1 - angle2
    // Sitting on a line?
    if (span >= ANG180) {
        return doom_boolean._c_true
    }
    tspan = angle1 + clipangle
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return doom_boolean._c_false
        }
        angle1 = clipangle
    }
    tspan = clipangle - angle2
    if (tspan > 2u * clipangle) {
        tspan -= 2u * clipangle
        // Totally off the left edge?
        if (tspan >= span) {
            return doom_boolean._c_false
        }
        angle2 = -clipangle
    }
    // Find the first clippost
    // that touches the source post
    // (adjacent pixels are touching).
    angle1 = (angle1 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    angle2 = (angle2 + uint(ANG90)) >> uint(ANGLETOFINESHIFT)
    sx1 = viewangletox[angle1]
    sx2 = viewangletox[angle2]
    // Does not cross a pixel.
    if (sx1 == sx2) {
        return doom_boolean._c_false
    }
    sx2--
    start = addr(solidsegs[0])
    while (start.last < sx2) {
        start++
    }
    if (sx1 >= start.first && sx2 <= start.last) {
        // The clippost contains the new span.
        return doom_boolean._c_false
    }
    return doom_boolean._c_true
}

// R_Subsector
// Determine floor/ceiling planes.
// Add sprites of things in sector.
// Draw one or more line segments.
[c_function]
def R_Subsector(num : int) {
    var count : int
    var line : seg_t?
    var sub : subsector_s?
    if (num >= numsubsectors) {
        // I_Error("Error: R_Subsector: ss %i with numss = %i",
        // num,
        // numsubsectors);
        doom_strcpy(addr(error_buf[0]), cstr("Error: R_Subsector: ss "))
        doom_concat(addr(error_buf[0]), doom_itoa(num, 10))
        doom_concat(addr(error_buf[0]), cstr(" with numss = "))
        doom_concat(addr(error_buf[0]), doom_itoa(numsubsectors, 10))
        I_Error(addr(error_buf[0]))
    }
    sscount++
    sub = addr(subsectors[num])
    frontsector = sub.sector
    count = int(sub.numlines)
    line = addr(segs[int(sub.firstline)])
    if (frontsector.floorheight < viewz) {
        floorplane = R_FindPlane(frontsector.floorheight, int(frontsector.floorpic), int(frontsector.lightlevel))
    } else {
        floorplane = null
    }
    if (frontsector.ceilingheight > viewz || int(frontsector.ceilingpic) == skyflatnum) {
        ceilingplane = R_FindPlane(frontsector.ceilingheight, int(frontsector.ceilingpic), int(frontsector.lightlevel))
    } else {
        ceilingplane = null
    }
    R_AddSprites(frontsector)
    while (true) {
        let _t0 = count
        count--
        if (_t0 == 0) {
            break
        }
        R_AddLine(line)
        line++
    }
}

// RenderBSPNode
// Renders all subsectors below a given node,
// traversing subtree recursively.
// Just call with BSP root.
[c_function]
def R_RenderBSPNode(bspnum : int) {
    var bsp : node_t?
    var side : int
    // Found a subsector?
    if ((bspnum & NF_SUBSECTOR) != 0) {
        if (bspnum == -1) {
            R_Subsector(0)
        } else {
            R_Subsector(bspnum & (~NF_SUBSECTOR))
        }
        return
    }
    bsp = addr(nodes[bspnum])
    // Decide which side the view point is on.
    side = R_PointOnSide(viewx, viewy, bsp)
    // Recursively divide front space.
    R_RenderBSPNode(int(bsp.children[side]))
    // Possibly divide back space.
    if (int(R_CheckBBox(addr(bsp.bbox[side ^ 1][0]))) != 0) {
        R_RenderBSPNode(int(bsp.children[side ^ 1]))
    }
}

