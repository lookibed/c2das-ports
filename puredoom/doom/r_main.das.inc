// R_AddPointToBox
// Expand a given bbox
// so that it encloses a given point.
[c_function]
def R_AddPointToBox(x : int; y : int; var box : int?) {
    if (x < box[int(anon_787.BOXLEFT)]) {
        box[int(anon_787.BOXLEFT)] = x
    }
    if (x > box[int(anon_787.BOXRIGHT)]) {
        box[int(anon_787.BOXRIGHT)] = x
    }
    if (y < box[int(anon_787.BOXBOTTOM)]) {
        box[int(anon_787.BOXBOTTOM)] = y
    }
    if (y > box[int(anon_787.BOXTOP)]) {
        box[int(anon_787.BOXTOP)] = y
    }
}

// R_PointOnSide
// Traverse BSP (sub) tree,
// check point against partition plane.
// Returns side 0 (front) or 1 (back).
def R_PointOnSide(x : int; y : int; var node : node_t?) : int {
    var dx : int
    var dy : int
    var left : int
    var right : int
    if (!(node.dx != 0)) {
        if (x <= node.x) {
            return node.dy > 0 ? 1 : 0
        }
        return node.dy < 0 ? 1 : 0
    }
    if (!(node.dy != 0)) {
        if (y <= node.y) {
            return node.dx < 0 ? 1 : 0
        }
        return node.dx > 0 ? 1 : 0
    }
    dx = x - node.x
    dy = y - node.y
    // Try to quickly decide by looking at sign bits.
    if ((uint(node.dy ^ node.dx ^ dx ^ dy) & 2147483648u) != 0) {
        if ((uint(node.dy ^ dx) & 2147483648u) != 0) {
            // (left is negative)
            return 1
        }
        return 0
    }
    left = FixedMul(node.dy >> FRACBITS, dx)
    right = FixedMul(dy, node.dx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

def R_PointOnSegSide(x : int; y : int; var line : seg_t?) : int {
    var lx : int
    var ly : int
    var ldx : int
    var ldy : int
    var dx : int
    var dy : int
    var left : int
    var right : int
    lx = line.v1.x
    ly = line.v1.y
    ldx = line.v2.x - lx
    ldy = line.v2.y - ly
    if (!(ldx != 0)) {
        if (x <= lx) {
            return ldy > 0 ? 1 : 0
        }
        return ldy < 0 ? 1 : 0
    }
    if (!(ldy != 0)) {
        if (y <= ly) {
            return ldx < 0 ? 1 : 0
        }
        return ldx > 0 ? 1 : 0
    }
    dx = x - lx
    dy = y - ly
    // Try to quickly decide by looking at sign bits.
    if ((uint(ldy ^ ldx ^ dx ^ dy) & 2147483648u) != 0) {
        if ((uint(ldy ^ dx) & 2147483648u) != 0) {
            // (left is negative)
            return 1
        }
        return 0
    }
    left = FixedMul(ldy >> FRACBITS, dx)
    right = FixedMul(dy, ldx >> FRACBITS)
    if (right < left) {
        // front side
        return 0
    }
    // back side
    return 1
}

def R_PointToAngle(var x : int; var y : int) : uint {
    x -= viewx
    y -= viewy
    if ((!(x != 0)) && (!(y != 0))) {
        return 0u
    }
    if (x >= 0) {
        // x >=0
        if (y >= 0) {
            // y>= 0
            if (x > y) {
                // octant 0
                return tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 1
                return uint(ANG90 - 1) - tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        } else {
            // y<0
            y = -y
            if (x > y) {
                // octant 8
                return -tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 7
                return ANG270 + tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        }
    } else {
        // x<0
        x = -x
        if (y >= 0) {
            // y>= 0
            if (x > y) {
                // octant 3
                return ANG180 - 1u - tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 2
                return uint(ANG90) + tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        } else {
            // y<0
            y = -y
            if (x > y) {
                // octant 4
                return ANG180 + tantoangle[SlopeDiv(uint(y), uint(x))]
            } else {
                // octant 5
                return ANG270 - 1u - tantoangle[SlopeDiv(uint(x), uint(y))]
            }
        }
    }
    return 0u
}

def R_PointToAngle2(x1 : int; y1 : int; x2 : int; y2 : int) : uint {
    viewx = x1
    viewy = y1
    return R_PointToAngle(x2, y2)
}

def R_PointToDist(x : int; y : int) : int {
    var angle : int
    var dx : int
    var dy : int
    var temp : int
    var dist : int
    dx = x - viewx < 0 ? -(x - viewx) : x - viewx
    dy = y - viewy < 0 ? -(y - viewy) : y - viewy
    if (dy > dx) {
        temp = dx
        dx = dy
        dy = temp
    }
    angle = int((tantoangle[FixedDiv(dy, dx) >> DBITS] + uint(ANG90)) >> uint(ANGLETOFINESHIFT))
    // use as cosine
    dist = FixedDiv(dx, finesine[angle])
    return dist
}

