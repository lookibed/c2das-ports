// R_InitTextureMapping
def R_InitTextureMapping {
    var i : int
    var x : int
    var t : int
    var focallength : int
    // Use tangent table to generate viewangletox:
    // viewangletox will give the next greatest x
    // after the view angle.
    // Calc focallength
    // so FIELDOFVIEW angles covers SCREENWIDTH.
    focallength = FixedDiv(centerxfrac, finetangent[FINEANGLES / 4 + FIELDOFVIEW / 2])
    i = 0
    while (i < FINEANGLES / 2) {
        if (finetangent[i] > FRACUNIT * 2) {
            t = -1
        } elif (finetangent[i] < -FRACUNIT * 2) {
            t = viewwidth + 1
        } else {
            t = FixedMul(finetangent[i], focallength)
            t = (centerxfrac - t + FRACUNIT - 1) >> FRACBITS
            if (t < -1) {
                t = -1
            } elif (t > viewwidth + 1) {
                t = viewwidth + 1
            }
        }
        viewangletox[i] = t
        i++
    }
    // Scan viewangletox[] to generate xtoviewangle[]:
    // xtoviewangle will give the smallest view angle
    // that maps to x.
    x = 0
    while (x <= viewwidth) {
        i = 0
        while (viewangletox[i] > x) {
            i++
        }
        xtoviewangle[x] = uint((i << ANGLETOFINESHIFT) - ANG90)
        x++
    }
    // Take out the fencepost cases from viewangletox.
    i = 0
    while (i < FINEANGLES / 2) {
        t = FixedMul(finetangent[i], focallength)
        t = centerx - t
        if (viewangletox[i] == -1) {
            viewangletox[i] = 0
        } elif (viewangletox[i] == viewwidth + 1) {
            viewangletox[i] = viewwidth
        }
        i++
    }
    clipangle = xtoviewangle[0]
}

[c_function]
def R_InitLightTables {
    var level : int
    var startmap : int
    var scale : int
    // Calculate the light levels to use
    // for each level / distance combination.
    for (i in range(LIGHTLEVELS)) {
        startmap = ((LIGHTLEVELS - 1 - i) * 2) * NUMCOLORMAPS / LIGHTLEVELS
        for (j in range(MAXLIGHTZ)) {
            scale = FixedDiv(SCREENWIDTH / 2 * FRACUNIT, (j + 1) << LIGHTZSHIFT)
            scale >>= LIGHTSCALESHIFT
            level = startmap - scale / DISTMAP
            if (level < 0) {
                level = 0
            }
            if (level >= NUMCOLORMAPS) {
                level = NUMCOLORMAPS - 1
            }
            zlight[i][j] = colormaps + level * 256
        }
    }
}

def R_SetViewSize(blocks : int; detail : int) {
    setsizeneeded = doom_boolean._c_true
    setblocks = blocks
    setdetail = detail
}

// R_ExecuteSetViewSize
[c_function]
def R_ExecuteSetViewSize {
    var cosadj : int
    var dy : int
    var i : int
    var level : int
    var startmap : int
    setsizeneeded = doom_boolean._c_false
    if (setblocks == 11) {
        scaledviewwidth = SCREENWIDTH
        viewheight = SCREENHEIGHT
    } else {
        scaledviewwidth = setblocks * 32
        viewheight = (setblocks * 168 / 10) & ~7
    }
    detailshift = setdetail
    viewwidth = scaledviewwidth >> detailshift
    centery = viewheight / 2
    centerx = viewwidth / 2
    centerxfrac = centerx << FRACBITS
    centeryfrac = centery << FRACBITS
    projection = centerxfrac
    if (!(detailshift != 0)) {
        basecolfunc = @@R_DrawColumn
        colfunc = basecolfunc
        fuzzcolfunc = @@R_DrawFuzzColumn
        transcolfunc = @@R_DrawTranslatedColumn
        spanfunc = @@R_DrawSpan
    } else {
        basecolfunc = @@R_DrawColumnLow
        colfunc = basecolfunc
        fuzzcolfunc = @@R_DrawFuzzColumn
        transcolfunc = @@R_DrawTranslatedColumn
        spanfunc = @@R_DrawSpanLow
    }
    R_InitBuffer(scaledviewwidth, viewheight)
    R_InitTextureMapping()
    // psprite scales
    pspritescale = FRACUNIT * viewwidth / SCREENWIDTH
    pspriteiscale = FRACUNIT * SCREENWIDTH / viewwidth
    // thing clipping
    i = 0
    while (i < viewwidth) {
        screenheightarray[i] = int16(viewheight)
        i++
    }
    // planes
    i = 0
    while (i < viewheight) {
        dy = ((i - viewheight / 2) << FRACBITS) + FRACUNIT / 2
        dy = dy < 0 ? -dy : dy
        yslope[i] = FixedDiv((viewwidth << detailshift) / 2 * FRACUNIT, dy)
        i++
    }
    i = 0
    while (i < viewwidth) {
        cosadj = finecosine[xtoviewangle[i] >> uint(ANGLETOFINESHIFT)] < 0 ? -finecosine[xtoviewangle[i] >> uint(ANGLETOFINESHIFT)] : finecosine[xtoviewangle[i] >> uint(ANGLETOFINESHIFT)]
        distscale[i] = FixedDiv(FRACUNIT, cosadj)
        i++
    }
    // Calculate the light levels to use
    // for each level / scale combination.
    for (i1 in range(LIGHTLEVELS)) {
        startmap = ((LIGHTLEVELS - 1 - i1) * 2) * NUMCOLORMAPS / LIGHTLEVELS
        for (j in range(MAXLIGHTSCALE)) {
            level = startmap - j * SCREENWIDTH / (viewwidth << detailshift) / DISTMAP
            if (level < 0) {
                level = 0
            }
            if (level >= NUMCOLORMAPS) {
                level = NUMCOLORMAPS - 1
            }
            scalelight[i1][j] = colormaps + level * 256
        }
    }
}

// R_Init
def R_Init {
    R_InitData()
    invoke(doom_print, cstr("\nR_InitData"))
    R_InitPointToAngle()
    invoke(doom_print, cstr("\nR_InitPointToAngle"))
    R_InitTables()
    // viewwidth / viewheight / detailLevel are set by the defaults
    invoke(doom_print, cstr("\nR_InitTables"))
    R_SetViewSize(screenblocks, detailLevel)
    R_InitPlanes()
    invoke(doom_print, cstr("\nR_InitPlanes"))
    R_InitLightTables()
    invoke(doom_print, cstr("\nR_InitLightTables"))
    R_InitSkyMap()
    invoke(doom_print, cstr("\nR_InitSkyMap"))
    R_InitTranslationTables()
    invoke(doom_print, cstr("\nR_InitTranslationsTables"))
    framecount = 0
}

// R_PointInSubsector
[c_function]
def R_PointInSubsector(x : int; y : int) : subsector_s? {
    var node : node_t?
    var side : int
    var nodenum : int
    // single subsector is a special case
    if (!(numnodes != 0)) {
        return subsectors
    }
    nodenum = numnodes - 1
    while (!((nodenum & NF_SUBSECTOR) != 0)) {
        node = addr(nodes[nodenum])
        side = R_PointOnSide(x, y, node)
        nodenum = int(node.children[side])
    }
    return addr(subsectors[nodenum & ~NF_SUBSECTOR])
}

// R_SetupFrame
[c_function]
def R_SetupFrame(var player : player_s?) {
    viewplayer = player
    viewx = player.mo.x
    viewy = player.mo.y
    viewangle = player.mo.angle + uint(viewangleoffset)
    extralight = player.extralight
    viewz = player.viewz
    viewsin = finesine[viewangle >> uint(ANGLETOFINESHIFT)]
    viewcos = finecosine[viewangle >> uint(ANGLETOFINESHIFT)]
    sscount = 0
    if (player.fixedcolormap != 0) {
        fixedcolormap = colormaps + uint64(player.fixedcolormap * 256) * uint64(typeinfo sizeof(type<uint8>))
        walllights = addr(scalelightfixed[0])
        for (i in range(MAXLIGHTSCALE)) {
            scalelightfixed[i] = fixedcolormap
        }
    } else {
        fixedcolormap = null
    }
    framecount++
    validcount++
}

// R_RenderView
def R_RenderPlayerView(var player : player_s?) {
    R_SetupFrame(player)
    // Clear buffers.
    R_ClearClipSegs()
    R_ClearDrawSegs()
    R_ClearPlanes()
    R_ClearSprites()
    // check for new console commands.
    NetUpdate()
    // The head node is the last node output.
    R_RenderBSPNode(numnodes - 1)
    // Check for new console commands.
    NetUpdate()
    R_DrawPlanes()
    // Check for new console commands.
    NetUpdate()
    R_DrawMasked()
    // Check for new console commands.
    NetUpdate()
}

