// generated by c2das - regenerate, never edit
// Move a plane (floor or ceiling) and check for crushing
def T_MovePlane(var sector : sector_t?; speed : int; dest : int; crush : doom_boolean; floorOrCeiling : int; direction : int) : result_e {
    var flag : doom_boolean
    var lastpos : int
    let _cond = floorOrCeiling
    if (_cond == 0) {
        // FLOOR
        let _cond2 = direction
        if (_cond2 == -1) {
            // DOWN
            if (sector.floorheight - speed < dest) {
                lastpos = sector.floorheight
                sector.floorheight = dest
                flag = P_ChangeSector(sector, crush)
                if (flag == doom_boolean._c_true) {
                    sector.floorheight = lastpos
                    P_ChangeSector(sector, crush)
                }
                // return crushed;
                return result_e.pastdest
            } else {
                lastpos = sector.floorheight
                sector.floorheight -= speed
                flag = P_ChangeSector(sector, crush)
                if (flag == doom_boolean._c_true) {
                    sector.floorheight = lastpos
                    P_ChangeSector(sector, crush)
                    return result_e.crushed
                }
            }
        } elif (_cond2 == 1) {
            // UP
            if (sector.floorheight + speed > dest) {
                lastpos = sector.floorheight
                sector.floorheight = dest
                flag = P_ChangeSector(sector, crush)
                if (flag == doom_boolean._c_true) {
                    sector.floorheight = lastpos
                    P_ChangeSector(sector, crush)
                }
                // return crushed;
                return result_e.pastdest
            } else {
                // COULD GET CRUSHED
                lastpos = sector.floorheight
                sector.floorheight += speed
                flag = P_ChangeSector(sector, crush)
                if (flag == doom_boolean._c_true) {
                    if (crush == doom_boolean._c_true) {
                        return result_e.crushed
                    }
                    sector.floorheight = lastpos
                    P_ChangeSector(sector, crush)
                    return result_e.crushed
                }
            }
        }
    } elif (_cond == 1) {
        // CEILING
        let _cond3 = direction
        if (_cond3 == -1) {
            // DOWN
            if (sector.ceilingheight - speed < dest) {
                lastpos = sector.ceilingheight
                sector.ceilingheight = dest
                flag = P_ChangeSector(sector, crush)
                if (flag == doom_boolean._c_true) {
                    sector.ceilingheight = lastpos
                    P_ChangeSector(sector, crush)
                }
                // return crushed;
                return result_e.pastdest
            } else {
                // COULD GET CRUSHED
                lastpos = sector.ceilingheight
                sector.ceilingheight -= speed
                flag = P_ChangeSector(sector, crush)
                if (flag == doom_boolean._c_true) {
                    if (crush == doom_boolean._c_true) {
                        return result_e.crushed
                    }
                    sector.ceilingheight = lastpos
                    P_ChangeSector(sector, crush)
                    return result_e.crushed
                }
            }
        } elif (_cond3 == 1) {
            // UP
            if (sector.ceilingheight + speed > dest) {
                lastpos = sector.ceilingheight
                sector.ceilingheight = dest
                flag = P_ChangeSector(sector, crush)
                if (flag == doom_boolean._c_true) {
                    sector.ceilingheight = lastpos
                    P_ChangeSector(sector, crush)
                }
                // return crushed;
                return result_e.pastdest
            } else {
                lastpos = sector.ceilingheight
                sector.ceilingheight += speed
                flag = P_ChangeSector(sector, crush)
            }
        }
    }
    // UNUSED
    return result_e.ok
}

// MOVE A FLOOR TO IT'S DESTINATION (UP OR DOWN)
[c_function]
def T_MoveFloor(var floor : floormove_t?) {
    var res : result_e
    res = T_MovePlane(floor.sector, floor.speed, floor.floordestheight, floor.crush, 0, floor.direction)
    if (!((leveltime & 7) != 0)) {
        S_StartSound(reinterpret<void?>(reinterpret<mobj_s?>(addr(floor.sector.soundorg))), int(sfxenum_t.sfx_stnmov))
    }
    if (res == result_e.pastdest) {
        floor.sector.specialdata = null
        if (floor.direction == 1) {
            let _cond = floor._c_type
            while (true) {
                var _flag = false
                _flag ||= _cond == floor_e.donutRaise
                if (_flag) {
                    floor.sector.special = int16(floor.newspecial)
                    floor.sector.floorpic = floor.texture
                }
                _flag ||= !(_cond == floor_e.donutRaise)
                if (_flag) {
                    break
                }
                break
            }
        } elif (floor.direction == -1) {
            let _cond2 = floor._c_type
            while (true) {
                var _flag2 = false
                _flag2 ||= _cond2 == floor_e.lowerAndChange
                if (_flag2) {
                    floor.sector.special = int16(floor.newspecial)
                    floor.sector.floorpic = floor.texture
                }
                _flag2 ||= !(_cond2 == floor_e.lowerAndChange)
                if (_flag2) {
                    break
                }
                break
            }
        }
        P_RemoveThinker(addr(floor.thinker))
        S_StartSound(reinterpret<void?>(reinterpret<mobj_s?>(addr(floor.sector.soundorg))), int(sfxenum_t.sfx_pstop))
    }
}

// HANDLE FLOOR TYPES
[c_function]
def EV_DoFloor(var line : line_s?; floortype : floor_e) : int {
    var secnum : int
    var rtn : int
    var i : int
    var sec : sector_t?
    var floor : floormove_t?
    secnum = -1
    rtn = 0
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(deref(sectors + secnum))
        // ALREADY MOVING? IF SO, KEEP GOING...
        if (sec.specialdata != null) {
            continue
        }
        // new floor thinker
        rtn = 1
        floor = reinterpret<floormove_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<floormove_t>))), PU_LEVSPEC, null))
        P_AddThinker(addr(floor.thinker))
        sec.specialdata = reinterpret<void?>(floor)
        floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
        floor._c_type = floortype
        floor.crush = doom_boolean._c_false
        let _cond = floortype
        while (true) {
            var _flag = false
            if (_cond == floor_e.lowerFloor) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = P_FindHighestFloorSurrounding(sec)
                break
            }
            if (_cond == floor_e.lowerFloorToLowest) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = P_FindLowestFloorSurrounding(sec)
                break
            }
            if (_cond == floor_e.turboLower) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = (1 << 16) * 4
                floor.floordestheight = P_FindHighestFloorSurrounding(sec)
                if (floor.floordestheight != sec.floorheight) {
                    floor.floordestheight += 8 * FRACUNIT
                }
                break
            }
            _flag ||= _cond == floor_e.raiseFloorCrush
            if (_flag) {
                floor.crush = doom_boolean._c_true
            }
            _flag ||= _cond == floor_e.raiseFloor
            if (_flag) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = P_FindLowestCeilingSurrounding(sec)
                if (floor.floordestheight > sec.ceilingheight) {
                    floor.floordestheight = sec.ceilingheight
                }
                floor.floordestheight -= 8 * FRACUNIT * (floortype == floor_e.raiseFloorCrush ? 1 : 0)
                break
            }
            if (_cond == floor_e.raiseFloorTurbo) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = (1 << 16) * 4
                floor.floordestheight = P_FindNextHighestFloor(sec, sec.floorheight)
                break
            }
            if (_cond == floor_e.raiseFloorToNearest) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = P_FindNextHighestFloor(sec, sec.floorheight)
                break
            }
            if (_cond == floor_e.raiseFloor24) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = floor.sector.floorheight + 24 * FRACUNIT
                break
            }
            if (_cond == floor_e.raiseFloor512) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = floor.sector.floorheight + 512 * FRACUNIT
                break
            }
            if (_cond == floor_e.raiseFloor24AndChange) {
                floor.direction = 1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = floor.sector.floorheight + 24 * FRACUNIT
                sec.floorpic = line.frontsector.floorpic
                sec.special = line.frontsector.special
                break
            }
            if (_cond == floor_e.raiseToTexture) {
                {
                    var minsize : int = DOOM_MAXINT
                    var side : side_t?
                    floor.direction = 1
                    floor.sector = sec
                    floor.speed = 1 << 16
                    {
                        i = 0
                        while (i < sec.linecount) {
                            if (twoSided(secnum, i) != 0) {
                                side = getSide(secnum, i, 0)
                                if (int(side.bottomtexture) >= 0) {
                                    if (deref(textureheight + int(side.bottomtexture)) < minsize) {
                                        minsize = deref(textureheight + int(side.bottomtexture))
                                    }
                                }
                                side = getSide(secnum, i, 1)
                                if (int(side.bottomtexture) >= 0) {
                                    if (deref(textureheight + int(side.bottomtexture)) < minsize) {
                                        minsize = deref(textureheight + int(side.bottomtexture))
                                    }
                                }
                            }
                            i++
                        }
                    }
                    floor.floordestheight = floor.sector.floorheight + minsize
                }
                break
            }
            _flag ||= _cond == floor_e.lowerAndChange
            if (_flag) {
                floor.direction = -1
                floor.sector = sec
                floor.speed = 1 << 16
                floor.floordestheight = P_FindLowestFloorSurrounding(sec)
                floor.texture = sec.floorpic
                {
                    i = 0
                    while (i < sec.linecount) {
                        if (twoSided(secnum, i) != 0) {
                            if (int64(getSide(secnum, i, 0).sector - sectors) == int64(secnum)) {
                                sec = getSector(secnum, i, 1)
                                if (sec.floorheight == floor.floordestheight) {
                                    floor.texture = sec.floorpic
                                    floor.newspecial = int(sec.special)
                                    break
                                }
                            } else {
                                sec = getSector(secnum, i, 0)
                                if (sec.floorheight == floor.floordestheight) {
                                    floor.texture = sec.floorpic
                                    floor.newspecial = int(sec.special)
                                    break
                                }
                            }
                        }
                        i++
                    }
                }
            }
            _flag ||= !(_cond == floor_e.lowerFloor || _cond == floor_e.lowerFloorToLowest || _cond == floor_e.turboLower || _cond == floor_e.raiseFloorCrush || _cond == floor_e.raiseFloor || _cond == floor_e.raiseFloorTurbo || _cond == floor_e.raiseFloorToNearest || _cond == floor_e.raiseFloor24 || _cond == floor_e.raiseFloor512 || _cond == floor_e.raiseFloor24AndChange || _cond == floor_e.raiseToTexture || _cond == floor_e.lowerAndChange)
            if (_flag) {
                break
            }
            break
        }
    }
    return rtn
}

// BUILD A STAIRCASE!
[c_function]
def EV_BuildStairs(var line : line_s?; _c_type : stair_e) : int {
    var secnum : int
    var height : int
    var i : int
    var newsecnum : int
    var texture : int
    var ok : int
    var rtn : int
    var sec : sector_t?
    var tsec : sector_t?
    var floor : floormove_t?
    var stairsize : int
    var speed : int
    secnum = -1
    rtn = 0
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(deref(sectors + secnum))
        // ALREADY MOVING? IF SO, KEEP GOING...
        if (sec.specialdata != null) {
            continue
        }
        // new floor thinker
        rtn = 1
        floor = reinterpret<floormove_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<floormove_t>))), PU_LEVSPEC, null))
        P_AddThinker(addr(floor.thinker))
        sec.specialdata = reinterpret<void?>(floor)
        floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
        floor.direction = 1
        floor.sector = sec
        let _cond = _c_type
        if (_cond == stair_e.build8) {
            speed = (1 << 16) / 4
            stairsize = 8 * FRACUNIT
        } elif (_cond == stair_e.turbo16) {
            speed = (1 << 16) * 4
            stairsize = 16 * FRACUNIT
        }
        floor.speed = speed
        height = sec.floorheight + stairsize
        floor.floordestheight = height
        texture = int(sec.floorpic)
        // Find next sector to raise
        // 1. Find 2-sided line with same sector side[0]
        // 2. Other side is the next sector to raise
        while (true) {
            ok = 0
            {
                i = 0
                var _f = false
                while (true) {
                    if (_f) {
                        i++
                    }
                    _f = true
                    if (!(i < sec.linecount)) {
                        break
                    }
                    if (!((int(deref(sec.lines + i).flags) & ML_TWOSIDED) != 0)) {
                        continue
                    }
                    tsec = deref(sec.lines + i).frontsector
                    newsecnum = int(int64(tsec - sectors))
                    if (secnum != newsecnum) {
                        continue
                    }
                    tsec = deref(sec.lines + i).backsector
                    newsecnum = int(int64(tsec - sectors))
                    if (int(tsec.floorpic) != texture) {
                        continue
                    }
                    height += stairsize
                    if (tsec.specialdata != null) {
                        continue
                    }
                    sec = tsec
                    secnum = newsecnum
                    floor = reinterpret<floormove_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<floormove_t>))), PU_LEVSPEC, null))
                    P_AddThinker(addr(floor.thinker))
                    sec.specialdata = reinterpret<void?>(floor)
                    floor.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveFloor)
                    floor.direction = 1
                    floor.sector = sec
                    floor.speed = speed
                    floor.floordestheight = height
                    ok = 1
                    break
                }
            }
            if (!(ok != 0)) {
                break
            }
        }
    }
    return rtn
}

