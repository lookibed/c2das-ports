def HU_queueChatChar(c : uint8) {
    if (((head + 1) & (QUEUESIZE - 1)) == tail) {
        hu_stuff_plr.message = cstr("[Message unsent]")
    } else {
        chatchars[head] = c
        head = (head + 1) & (QUEUESIZE - 1)
    }
}

def HU_dequeueChatChar : uint8 {
    var c : uint8
    if (head != tail) {
        c = chatchars[tail]
        tail = (tail + 1) & (QUEUESIZE - 1)
    } else {
        c = 0u8
    }
    return c
}

