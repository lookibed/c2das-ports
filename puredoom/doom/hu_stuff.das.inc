def HU_Responder(var ev : event_t?) : doom_boolean {
    var macromessage : uint8?
    var eatkey : doom_boolean = doom_boolean._c_false
    var c : uint8
    var numplayers : int
    numplayers = 0
    for (i in range(MAXPLAYERS)) {
        numplayers = int(uint(numplayers) + uint(int(playeringame[i])))
    }
    if (ev.data1 == KEY_RSHIFT) {
        HU_Responder_shiftdown = enum_from_int(type<doom_boolean>, ev._c_type == evtype_t.ev_keydown ? 1 : 0)
        return doom_boolean._c_false
    } elif (ev.data1 == KEY_RALT || ev.data1 == KEY_LALT) {
        HU_Responder_altdown = enum_from_int(type<doom_boolean>, ev._c_type == evtype_t.ev_keydown ? 1 : 0)
        return doom_boolean._c_false
    }
    if (ev._c_type != evtype_t.ev_keydown) {
        return doom_boolean._c_false
    }
    if (!(int(chat_on) != 0)) {
        if (ev.data1 == KEY_ENTER) {
            message_on = doom_boolean._c_true
            message_counter = HU_MSGTIMEOUT
            eatkey = doom_boolean._c_true
        } elif (uint(int(netgame)) != 0 && ev.data1 == HU_INPUTTOGGLE) {
            chat_on = doom_boolean._c_true
            eatkey = chat_on
            HUlib_resetIText(addr(w_chat))
            HU_queueChatChar(uint8(HU_BROADCAST))
        } elif (uint(int(netgame)) != 0 && numplayers > 2) {
            for (i in range(MAXPLAYERS)) {
                if (ev.data1 == int(HU_Responder_destination_keys[i])) {
                    if (uint(int(playeringame[i])) != 0 && i != consoleplayer) {
                        chat_on = doom_boolean._c_true
                        eatkey = chat_on
                        HUlib_resetIText(addr(w_chat))
                        HU_queueChatChar(uint8(i + 1))
                        break
                    } elif (i == consoleplayer) {
                        HU_Responder_num_nobrainers++
                        if (HU_Responder_num_nobrainers < 3) {
                            hu_stuff_plr.message = cstr("You mumble to yourself")
                        } elif (HU_Responder_num_nobrainers < 6) {
                            hu_stuff_plr.message = cstr("Who's there?")
                        } elif (HU_Responder_num_nobrainers < 9) {
                            hu_stuff_plr.message = cstr("You scare yourself")
                        } elif (HU_Responder_num_nobrainers < 32) {
                            hu_stuff_plr.message = cstr("You start to rave")
                        } else {
                            hu_stuff_plr.message = cstr("You've lost it...")
                        }
                    }
                }
            }
        }
    } else {
        c = uint8(ev.data1)
        // send a macro
        if (int(HU_Responder_altdown) != 0) {
            c = uint8(int(c) - '0')
            if (int(c) > 9) {
                return doom_boolean._c_false
            }
            macromessage = chat_macros[int(c)]
            // kill last message with a '\n'
            // DEBUG!!!
            HU_queueChatChar(uint8(KEY_ENTER))
            // send the macro message
            while (deref(macromessage) != 0) {
                var _t0 = macromessage
                macromessage = macromessage + 1
                HU_queueChatChar(deref(_t0))
            }
            HU_queueChatChar(uint8(KEY_ENTER))
            // leave chat mode and notify that it was sent
            chat_on = doom_boolean._c_false
            doom_strcpy(addr(HU_Responder_lastmessage[0]), chat_macros[int(c)])
            hu_stuff_plr.message = addr(HU_Responder_lastmessage[0])
            eatkey = doom_boolean._c_true
        } else {
            if (int(Language_t.french) != 0) {
                c = uint8(ForeignTranslation(c))
            }
            if (uint(int(HU_Responder_shiftdown)) != 0 || (int(c) >= 'a' && int(c) <= 'z')) {
                c = uint8(shiftxform[int(c)])
            }
            eatkey = HUlib_keyInIText(addr(w_chat), c)
            if (int(eatkey) != 0) {
                HU_queueChatChar(uint8(c))
            }
            if (int(c) == KEY_ENTER) {
                chat_on = doom_boolean._c_false
                if (w_chat.l.len != 0) {
                    doom_strcpy(addr(HU_Responder_lastmessage[0]), addr(w_chat.l.l[0]))
                    hu_stuff_plr.message = addr(HU_Responder_lastmessage[0])
                }
            } elif (int(c) == KEY_ESCAPE) {
                chat_on = doom_boolean._c_false
            }
        }
    }
    return eatkey
}

