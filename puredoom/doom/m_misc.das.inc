[c_function]
def M_DrawText(var x : int; y : int; direct : doom_boolean; var _c_string : uint8?) : int {
    var c : int
    var w : int
    while (*_c_string != 0) {
        c = doom_toupper(int(*_c_string)) - HU_FONTSTART
        _c_string++
        if (c < 0 || c > HU_FONTSIZE) {
            x += 4
            continue
        }
        w = int(read_patch_t_width(hu_font[c], 0))
        if (x + w > SCREENWIDTH) {
            break
        }
        if (int(direct) != 0) {
            V_DrawPatchDirect(x, y, 0, hu_font[c])
        } else {
            V_DrawPatch(x, y, 0, hu_font[c])
        }
        x += w
    }
    return x
}

// M_WriteFile
def M_WriteFile(var name : uint8?; var source : void?; length : int) : doom_boolean {
    var handle : void?
    var count : int
    handle = invoke(doom_open, name, cstr("wb"))
    if (handle == null) {
        return doom_boolean._c_false
    }
    count = invoke(doom_write, handle, source, length)
    invoke(doom_close, handle)
    if (count < length) {
        return doom_boolean._c_false
    }
    return doom_boolean._c_true
}

// M_ReadFile
[c_function]
def M_ReadFile(var name : uint8?; var buffer : uint8 ??) : int {
    var handle : void?
    var count : int
    var length : int
    var buf : uint8?
    handle = invoke(doom_open, name, cstr("rb"))
    if (handle == null) {
        // I_Error("Error: Couldn't read file %s", name);
        doom_strcpy(addr(error_buf[0]), cstr("Error: Couldn't read file "))
        doom_concat(addr(error_buf[0]), name)
        I_Error(addr(error_buf[0]))
    }
    invoke(doom_seek, handle, 0, doom_seek_t.DOOM_SEEK_END)
    length = invoke(doom_tell, handle)
    invoke(doom_seek, handle, 0, doom_seek_t.DOOM_SEEK_SET)
    buf = reinterpret<uint8?>(Z_Malloc(length, PU_STATIC, null))
    count = invoke(doom_read, handle, reinterpret<void?>(buf), length)
    invoke(doom_close, handle)
    if (count < length) {
        // I_Error("Error: Couldn't read file %s", name);
        doom_strcpy(addr(error_buf[0]), cstr("Error: Couldn't read file "))
        doom_concat(addr(error_buf[0]), name)
        I_Error(addr(error_buf[0]))
    }
    *buffer = buf
    return length
}

// M_SaveDefaults
[c_function]
def M_SaveDefaults {
    var i : int
    var v : int
    var f : void?
    f = invoke(doom_open, defaultfile, cstr("w"))
    if (f == null) {
        // can't write the file, but don't complain
        return
    }
    i = 0
    while (i < numdefaults) {
        if (defaults[i].defaultvalue > -4095 && defaults[i].defaultvalue < 4095) {
            v = *defaults[i].location
            // fprintf(f, "%s\t\t%i\n", defaults[i].name, v);
            doom_fprint(f, defaults[i].name)
            doom_fprint(f, cstr("\t\t"))
            doom_fprint(f, doom_itoa(v, 10))
            doom_fprint(f, cstr("\n"))
        } else {
            // fprintf(f, "%s\t\t\"%s\"\n", defaults[i].name,
            // (char**)(defaults[i].text_location));
            doom_fprint(f, defaults[i].name)
            doom_fprint(f, cstr("\t\t\""))
            doom_fprint(f, *defaults[i].text_location)
            doom_fprint(f, cstr("\"\n"))
        }
        i++
    }
    invoke(doom_close, f)
}

// M_LoadDefaults
[c_function]
def M_LoadDefaults {
    var i : int
    var len : int
    var f : void?
    var _c_def : uint8[80]
    var strparm : uint8[100]
    var newstring : uint8?
    var parm : int
    var isstring : doom_boolean
    // set everything to base values
    // numdefaults = sizeof(defaults)/sizeof(defaults[0]);
    i = 0
    while (i < numdefaults) {
        if (defaults[i].defaultvalue == 65535) {
            *defaults[i].text_location = defaults[i].default_text_value
        } else {
            *defaults[i].location = defaults[i].defaultvalue
        }
        i++
    }
    // check for a custom default file
    i = M_CheckParm(cstr("-config"))
    if (i != 0 && i < myargc - 1) {
        defaultfile = myargv[i + 1]
        // doom_print(" default file: %s\n", defaultfile);
        invoke(doom_print, cstr("        default file: "))
        invoke(doom_print, defaultfile)
        invoke(doom_print, cstr("\n"))
    } else {
        defaultfile = addr(basedefault[0])
    }
    // read the file in, overriding any set defaults
    f = invoke(doom_open, defaultfile, cstr("r"))
    if (f != null) {
        while (invoke(doom_eof, f) == 0) {
            // def
            var arg_read : int = 0
            var c : uint8
            i = 0
            while (i < 79) {
                invoke(doom_read, f, reinterpret<void?>(addr(c)), 1)
                if (c == ' ' || c == '\n' || c == '\t') {
                    if (i > 0) {
                        arg_read++
                    }
                    break
                }
                _c_def[i] = c
                i++
            }
            _c_def[i] = uint8('\0')
            // Ignore spaces
            if (c != '\n') {
                while (1 != 0) {
                    invoke(doom_read, f, reinterpret<void?>(addr(c)), 1)
                    if (c != ' ' && c != '\t') {
                        break
                    }
                }
                // strparam
                i = 0
                if (c != '\n') {
                    while (i < 260) {
                        let _t0 = i
                        i++
                        strparm[_t0] = c
                        invoke(doom_read, f, reinterpret<void?>(addr(c)), 1)
                        if (c == '\n') {
                            if (i > 0) {
                                arg_read++
                            }
                            break
                        }
                    }
                }
                strparm[i] = uint8('\0')
            }
            isstring = doom_boolean._c_false
            // if (fscanf(f, "%79s %[^\n]\n", def, strparm) == 2)
            if (arg_read == 2) {
                if (strparm[0] == '"') {
                    // get a string default
                    isstring = doom_boolean._c_true
                    len = doom_strlen(addr(strparm[0]))
                    newstring = reinterpret<uint8?>(invoke(doom_malloc, len))
                    strparm[len - 1] = 0u8
                    doom_strcpy(newstring, addr(strparm[0]) + 1)
                } elif (strparm[0] == '0' && strparm[1] == 'x') {
                    // sscanf(strparm + 2, "%x", &parm);
                    parm = doom_atox(addr(strparm[0]) + 2)
                } else {
                    // sscanf(strparm, "%i", &parm);
                    parm = doom_atoi(addr(strparm[0]))
                }
                i = 0
                while (i < numdefaults) {
                    if (doom_strcmp(addr(_c_def[0]), defaults[i].name) == 0) {
                        if (int(isstring) == 0) {
                            *defaults[i].location = parm
                        } else {
                            *defaults[i].text_location = newstring
                        }
                        break
                    }
                    i++
                }
            }
        }
        invoke(doom_close, f)
    }
}

// WritePCXfile
[c_function]
def WritePCXfile(var filename : uint8?; var data : uint8?; width : int; height : int; var palette : uint8?) {
    var length : int
    var pcx : pcx_t?
    var pack : uint8?
    pcx = reinterpret<pcx_t?>(Z_Malloc(width * height * 2 + 1000, PU_STATIC, null))
    // PCX id
    pcx.manufacturer = 10u8
    // 256 color
    pcx.version = 5u8
    // uncompressed
    pcx.encoding = 1u8
    // 256 color
    pcx.bits_per_pixel = 8u8
    pcx.xmin = uint16(0)
    pcx.ymin = uint16(0)
    pcx.xmax = uint16(width - 1)
    pcx.ymax = uint16(height - 1)
    pcx.hres = uint16(width)
    pcx.vres = uint16(height)
    doom_memset(reinterpret<void?>(addr(pcx.palette[0])), 0, typeinfo sizeof(type<uint8[48]>))
    // chunky image
    pcx.color_planes = 1u8
    pcx.bytes_per_line = uint16(width)
    // not a grey scale
    pcx.palette_type = uint16(2)
    doom_memset(reinterpret<void?>(addr(pcx.filler[0])), 0, typeinfo sizeof(type<uint8[58]>))
    // pack the image
    pack = addr(pcx.data)
    for (i in range(width * height)) {
        if ((int(*data) & 192) != 192) {
            var _t0 = pack
            pack++
            var _t1 = data
            data++
            *_t0 = *_t1
        } else {
            var _t2 = pack
            pack++
            *_t2 = 193u8
            var _t3 = pack
            pack++
            var _t4 = data
            data++
            *_t3 = *_t4
        }
    }
    // write the palette
    // palette ID byte
    var _t5 = pack
    pack++
    *_t5 = 12u8
    for (i in range(768)) {
        var _t6 = pack
        pack++
        var _t7 = palette
        palette++
        *_t6 = *_t7
    }
    // write output file
    length = int(int64(pack - reinterpret<uint8?>(pcx)))
    M_WriteFile(filename, reinterpret<void?>(pcx), length)
    Z_Free(reinterpret<void?>(pcx))
}

// M_ScreenShot
[c_function]
def M_ScreenShot {
    var i : int
    var linear : uint8?
    var lbmname : uint8[12]
    var f : void?
    // munge planar buffer to linear
    linear = screens[2]
    I_ReadScreen(linear)
    // find a file name to save it to
    doom_strcpy(addr(lbmname[0]), cstr("DOOM00.pcx"))
    i = 0
    while (i <= 99) {
        lbmname[4] = uint8(i / 10 + '0')
        lbmname[5] = uint8(i % 10 + '0')
        f = invoke(doom_open, addr(lbmname[0]), cstr("wb"))
        if (f == null) {
            // file doesn't exist
            break
        }
        invoke(doom_close, f)
        i++
    }
    if (i == 100) {
        I_Error(cstr("Error: M_ScreenShot: Couldn't create a PCX"))
    }
    // save the pcx file
    WritePCXfile(addr(lbmname[0]), linear, SCREENWIDTH, SCREENHEIGHT, reinterpret<uint8?>(W_CacheLumpName(cstr("PLAYPAL"), PU_CACHE)))
    players[consoleplayer].message = cstr("screen shot")
}

