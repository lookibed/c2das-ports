// V_DrawPatch
// Masks a column based masked pic to the screen.
[c_function]
def V_DrawPatch(var x : int; var y : int; scrn : int; var patch : uint8?) {
    var count : int
    var col : int
    var column : uint8?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var w : int
    y -= int(read_patch_t_topoffset(patch, 0))
    x -= int(read_patch_t_leftoffset(patch, 0))
    if (x < 0 || x + int(read_patch_t_width(patch, 0)) > SCREENWIDTH || y < 0 || y + int(read_patch_t_height(patch, 0)) > SCREENHEIGHT || uint(scrn) > 4u) {
        // doom_print("Patch at %d,%d exceeds LFB\n", x, y);
        invoke(doom_print, cstr("Patch at "))
        invoke(doom_print, doom_itoa(x, 10))
        invoke(doom_print, cstr(","))
        invoke(doom_print, doom_itoa(y, 10))
        invoke(doom_print, cstr(" exceeds LFB\n"))
        // No I_Error abort - what is up with TNT.WAD?
        invoke(doom_print, cstr("V_DrawPatch: bad patch (ignored)\n"))
        return
    }
    if (scrn == 0) {
        V_MarkRect(x, y, int(read_patch_t_width(patch, 0)), int(read_patch_t_height(patch, 0)))
    }
    col = 0
    desttop = screens[scrn] + y * SCREENWIDTH + x
    w = int(read_patch_t_width(patch, 0))
    while (col < w) {
        column = reinterpret<uint8?>(reinterpret<uint8?>(patch) + ptr_patch_t_columnofs(patch, 0)[col])
        // step through the posts in a column
        while (read_post_t_topdelta(column, 0) != 255) {
            source = reinterpret<uint8?>(column) + 3
            dest = desttop + int(read_post_t_topdelta(column, 0)) * SCREENWIDTH
            count = int(read_post_t_length(column, 0))
            while (true) {
                let _t0 = count
                count--
                if (_t0 == 0) {
                    break
                }
                var _t1 = source
                source++
                *dest = *_t1
                dest += SCREENWIDTH
            }
            column = reinterpret<uint8?>(reinterpret<uint8?>(column) + int(read_post_t_length(column, 0)) + 4)
        }
        x++
        col++
        desttop++
    }
}

