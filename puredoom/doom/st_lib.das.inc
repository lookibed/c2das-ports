var sttminus : uint8?

[c_function]
def STlib_init {
    sttminus = reinterpret<uint8?>(W_CacheLumpName(cstr("STTMINUS"), PU_STATIC))
}

// ?
def STlib_initNum(var n : st_number_t?; x : int; y : int; var pl : uint8 ??; var num : int?; var on : doom_boolean?; width : int) {
    n.x = x
    n.y = y
    n.oldnum = 0
    n.width = width
    n.num = num
    n.on = on
    n.p = pl
}

// A fairly efficient way to draw a number
// based on differences from the old number.
// Note: worth the trouble?
[c_function]
def STlib_drawNum(var n : st_number_t?; refresh : doom_boolean) {
    var numdigits : int = n.width
    var num : int = deref(n.num)
    var w : int = int(read_patch_t_width(n.p[0], 0))
    var h : int = int(read_patch_t_height(n.p[0], 0))
    var x : int = n.x
    var neg : int
    n.oldnum = deref(n.num)
    neg = num < 0 ? 1 : 0
    if (neg != 0) {
        if (numdigits == 2 && num < -9) {
            num = -9
        } elif (numdigits == 3 && num < -99) {
            num = -99
        }
        num = -num
    }
    // clear the area
    x = n.x - numdigits * w
    if (n.y - ST_Y < 0) {
        I_Error(cstr("Error: drawNum: n->y - ST_Y < 0"))
    }
    V_CopyRect(x, n.y - ST_Y, STLIB_BG, w * numdigits, h, x, n.y, STLIB_FG)
    // if non-number, do not draw it
    if (num == 1994) {
        return
    }
    x = n.x
    // in the special case of 0, you draw 0
    if (!(num != 0)) {
        V_DrawPatch(x - w, n.y, STLIB_FG, n.p[0])
    }
    // draw the new number
    while (true) {
        var _t1 = num != 0
        if (_t1) {
            let _t0 = numdigits
            numdigits--
            _t1 = _t0 != 0
        }
        if (!(_t1)) {
            break
        }
        x -= w
        V_DrawPatch(x, n.y, STLIB_FG, n.p[num % 10])
        num /= 10
    }
    // draw a minus sign if necessary
    if (neg != 0) {
        V_DrawPatch(x - 8, n.y, STLIB_FG, sttminus)
    }
}

[c_function]
def STlib_updateNum(var n : st_number_t?; refresh : doom_boolean) {
    if (int(deref(n.on)) != 0) {
        STlib_drawNum(n, refresh)
    }
}

[c_function]
def STlib_initPercent(var p : st_percent_t?; x : int; y : int; var pl : uint8 ??; var num : int?; var on : doom_boolean?; var percent : uint8?) {
    STlib_initNum(addr(p.n), x, y, pl, num, on, 3)
    p.p = percent
}

[c_function]
def STlib_updatePercent(var per : st_percent_t?; refresh : int) {
    if (refresh != 0 && uint(int(deref(per.n.on))) != 0) {
        V_DrawPatch(per.n.x, per.n.y, STLIB_FG, per.p)
    }
    STlib_updateNum(addr(per.n), enum_from_int(type<doom_boolean>, refresh))
}

def STlib_initMultIcon(var i : st_multicon_t?; x : int; y : int; var il : uint8 ??; var inum : int?; var on : doom_boolean?) {
    i.x = x
    i.y = y
    i.oldinum = -1
    i.inum = inum
    i.on = on
    i.p = il
}

[c_function]
def STlib_updateMultIcon(var mi : st_multicon_t?; refresh : doom_boolean) {
    var w : int
    var h : int
    var x : int
    var y : int
    if (uint(int(deref(mi.on))) != 0 && (mi.oldinum != deref(mi.inum) || uint(int(refresh)) != 0) && (deref(mi.inum) != -1)) {
        if (mi.oldinum != -1) {
            x = mi.x - int(read_patch_t_leftoffset(mi.p[mi.oldinum], 0))
            y = mi.y - int(read_patch_t_topoffset(mi.p[mi.oldinum], 0))
            w = int(read_patch_t_width(mi.p[mi.oldinum], 0))
            h = int(read_patch_t_height(mi.p[mi.oldinum], 0))
            if (y - ST_Y < 0) {
                I_Error(cstr("Error: updateMultIcon: y - ST_Y < 0"))
            }
            V_CopyRect(x, y - ST_Y, STLIB_BG, w, h, x, y, STLIB_FG)
        }
        V_DrawPatch(mi.x, mi.y, STLIB_FG, mi.p[deref(mi.inum)])
        mi.oldinum = deref(mi.inum)
    }
}

def STlib_initBinIcon(var b : st_binicon_t?; x : int; y : int; var i : uint8?; var val : doom_boolean?; var on : doom_boolean?) {
    b.x = x
    b.y = y
    b.oldval = 0
    b.val = val
    b.on = on
    b.p = i
}

[c_function]
def STlib_updateBinIcon(var bi : st_binicon_t?; refresh : doom_boolean) {
    var x : int
    var y : int
    var w : int
    var h : int
    if (uint(int(deref(bi.on))) != 0 && (uint(bi.oldval) != uint(int(deref(bi.val))) || uint(int(refresh)) != 0)) {
        x = bi.x - int(read_patch_t_leftoffset(bi.p, 0))
        y = bi.y - int(read_patch_t_topoffset(bi.p, 0))
        w = int(read_patch_t_width(bi.p, 0))
        h = int(read_patch_t_height(bi.p, 0))
        if (y - ST_Y < 0) {
            I_Error(cstr("Error: updateBinIcon: y - ST_Y < 0"))
        }
        if (int(deref(bi.val)) != 0) {
            V_DrawPatch(bi.x, bi.y, STLIB_FG, bi.p)
        } else {
            V_CopyRect(x, y - ST_Y, STLIB_BG, w, h, x, y, STLIB_FG)
        }
        bi.oldval = int(deref(bi.val))
    }
}

