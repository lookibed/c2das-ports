// generated by c2das - regenerate, never edit
// T_FireFlicker
def T_FireFlicker(var flick : fireflicker_t?) {
    var amount : int
    flick.count--
    if (flick.count != 0) {
        return
    }
    amount = (P_Random() & 3) * 16
    if (int(flick.sector.lightlevel) - amount < flick.minlight) {
        flick.sector.lightlevel = int16(flick.minlight)
    } else {
        flick.sector.lightlevel = int16(flick.maxlight - amount)
    }
    flick.count = 4
}

// P_SpawnFireFlicker
[c_function]
def P_SpawnFireFlicker(var sector : sector_t?) {
    var flick : fireflicker_t?
    // Note that we are resetting sector attributes.
    // Nothing special about it during gameplay.
    sector.special = int16(0)
    flick = reinterpret<fireflicker_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<fireflicker_t>))), PU_LEVSPEC, null))
    P_AddThinker(addr(flick.thinker))
    flick.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_FireFlicker)
    flick.sector = sector
    flick.maxlight = int(sector.lightlevel)
    flick.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel)) + 16
    flick.count = 4
}

// T_LightFlash
// Do flashing lights.
def T_LightFlash(var flash : lightflash_t?) {
    flash.count--
    if (flash.count != 0) {
        return
    }
    if (int(flash.sector.lightlevel) == flash.maxlight) {
        flash.sector.lightlevel = int16(flash.minlight)
        flash.count = (P_Random() & flash.mintime) + 1
    } else {
        flash.sector.lightlevel = int16(flash.maxlight)
        flash.count = (P_Random() & flash.maxtime) + 1
    }
}

// P_SpawnLightFlash
// After the map has been loaded, scan each sector
// for specials that spawn thinkers
[c_function]
def P_SpawnLightFlash(var sector : sector_t?) {
    var flash : lightflash_t?
    // nothing special about it during gameplay
    sector.special = int16(0)
    flash = reinterpret<lightflash_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<lightflash_t>))), PU_LEVSPEC, null))
    P_AddThinker(addr(flash.thinker))
    flash.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_LightFlash)
    flash.sector = sector
    flash.maxlight = int(sector.lightlevel)
    flash.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel))
    flash.maxtime = 64
    flash.mintime = 7
    flash.count = (P_Random() & flash.maxtime) + 1
}

// T_StrobeFlash
def T_StrobeFlash(var flash : strobe_t?) {
    flash.count--
    if (flash.count != 0) {
        return
    }
    if (int(flash.sector.lightlevel) == flash.minlight) {
        flash.sector.lightlevel = int16(flash.maxlight)
        flash.count = flash.brighttime
    } else {
        flash.sector.lightlevel = int16(flash.minlight)
        flash.count = flash.darktime
    }
}

// P_SpawnStrobeFlash
// After the map has been loaded, scan each sector
// for specials that spawn thinkers
[c_function]
def P_SpawnStrobeFlash(var sector : sector_t?; fastOrSlow : int; inSync : int) {
    var flash : strobe_t?
    flash = reinterpret<strobe_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<strobe_t>))), PU_LEVSPEC, null))
    P_AddThinker(addr(flash.thinker))
    flash.sector = sector
    flash.darktime = fastOrSlow
    flash.brighttime = STROBEBRIGHT
    flash.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_StrobeFlash)
    flash.maxlight = int(sector.lightlevel)
    flash.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel))
    if (flash.minlight == flash.maxlight) {
        flash.minlight = 0
    }
    // nothing special about it during gameplay
    sector.special = int16(0)
    if (!(inSync != 0)) {
        flash.count = (P_Random() & 7) + 1
    } else {
        flash.count = 1
    }
}

// Start strobing lights (usually from a trigger)
[c_function]
def EV_StartLightStrobing(var line : line_s?) {
    var secnum : int
    var sec : sector_t?
    secnum = -1
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        if (sec.specialdata != null) {
            continue
        }
        P_SpawnStrobeFlash(sec, SLOWDARK, 0)
    }
}

// TURN LINE'S TAG LIGHTS OFF
[c_function]
def EV_TurnTagLightsOff(var line : line_s?) {
    var i : int
    var j : int
    var min : int
    var sector : sector_t?
    var tsec : sector_t?
    var templine : line_s?
    sector = sectors
    j = 0
    while (j < numsectors) {
        if (int(sector.tag) == int(line.tag)) {
            min = int(sector.lightlevel)
            i = 0
            while (i < sector.linecount) {
                {
                    templine = sector.lines[i]
                    tsec = getNextSector(templine, sector)
                    if (!(tsec != null)) {
                        continue
                    }
                    if (int(tsec.lightlevel) < min) {
                        min = int(tsec.lightlevel)
                    }
                } finally {
                    i++
                }
            }
            sector.lightlevel = int16(min)
        }
        j++
        sector = sector + 1
    }
}

// TURN LINE'S TAG LIGHTS ON
[c_function]
def EV_LightTurnOn(var line : line_s?; var bright : int) {
    var i : int
    var j : int
    var sector : sector_t?
    var temp : sector_t?
    var templine : line_s?
    sector = sectors
    i = 0
    while (i < numsectors) {
        if (int(sector.tag) == int(line.tag)) {
            // bright = 0 means to search
            // for highest light level
            // surrounding sector
            if (!(bright != 0)) {
                j = 0
                while (j < sector.linecount) {
                    {
                        templine = sector.lines[j]
                        temp = getNextSector(templine, sector)
                        if (!(temp != null)) {
                            continue
                        }
                        if (int(temp.lightlevel) > bright) {
                            bright = int(temp.lightlevel)
                        }
                    } finally {
                        j++
                    }
                }
            }
            sector.lightlevel = int16(bright)
        }
        i++
        sector = sector + 1
    }
}

// Spawn glowing light
def T_Glow(var g : glow_t?) {
    let _cond = g.direction
    if (_cond == -1) {
        // DOWN
        g.sector.lightlevel = int16(int(g.sector.lightlevel) - GLOWSPEED)
        if (int(g.sector.lightlevel) <= g.minlight) {
            g.sector.lightlevel = int16(int(g.sector.lightlevel) + GLOWSPEED)
            g.direction = 1
        }
    } elif (_cond == 1) {
        // UP
        g.sector.lightlevel = int16(int(g.sector.lightlevel) + GLOWSPEED)
        if (int(g.sector.lightlevel) >= g.maxlight) {
            g.sector.lightlevel = int16(int(g.sector.lightlevel) - GLOWSPEED)
            g.direction = -1
        }
    }
}

[c_function]
def P_SpawnGlowingLight(var sector : sector_t?) {
    var g : glow_t?
    g = reinterpret<glow_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<glow_t>))), PU_LEVSPEC, null))
    P_AddThinker(addr(g.thinker))
    g.sector = sector
    g.minlight = P_FindMinSurroundingLight(sector, int(sector.lightlevel))
    g.maxlight = int(sector.lightlevel)
    g.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_Glow)
    g.direction = -1
    sector.special = int16(0)
}

