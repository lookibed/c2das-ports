[c_function]
def G_CmdChecksum(var cmd : ticcmd_t?) : int {
    var i : int
    var sum : int = 0
    {
        i = 0
        while (uint64(i) < uint64(typeinfo sizeof(type<ticcmd_t>)) / uint64(4) - uint64(1)) {
            sum += deref(reinterpret<int?>(cmd) + i)
            i++
        }
    }
    return sum
}

// G_BuildTiccmd
// Builds a ticcmd from all of the available inputs
// or reads it from the demo buffer.
// If recording a demo, write it out
[c_function]
def G_BuildTiccmd(var cmd : ticcmd_t?) {
    var strafe : doom_boolean
    var bstrafe : doom_boolean
    var speed : int
    var tspeed : int
    var forward : int
    var side : int
    var base : ticcmd_t?
    // empty, or external driver
    base = I_BaseTiccmd()
    doom_memcpy(reinterpret<void?>(cmd), reinterpret<void?>(base), int(uint64(typeinfo sizeof(type<ticcmd_t>))))
    cmd.consistancy = consistancy[consoleplayer][maketic % BACKUPTICS]
    strafe = enum_from_int(type<doom_boolean>, uint(int(gamekeydown[key_strafe])) != 0 || uint(int(deref(mousebuttons + mousebstrafe))) != 0 || uint(int(deref(joybuttons + joybstrafe))) != 0 ? 1 : 0)
    var running : doom_boolean = enum_from_int(type<doom_boolean>, always_run != 0 ? (uint(int(gamekeydown[key_speed])) != 0 ? int(doom_boolean._c_false) : int(doom_boolean._c_true)) : (uint(int(gamekeydown[key_speed])) != 0 ? int(doom_boolean._c_true) : int(doom_boolean._c_false)))
    speed = uint(int(running)) != 0 || uint(int(deref(joybuttons + joybspeed))) != 0 ? 1 : 0
    side = 0
    forward = side
    // use two stage accelerative turning
    // on the keyboard and joystick
    if (joyxmove < 0 || joyxmove > 0 || uint(int(gamekeydown[key_right])) != 0 || uint(int(gamekeydown[key_left])) != 0) {
        turnheld += ticdup
    } else {
        turnheld = 0
    }
    if (turnheld < SLOWTURNTICS) {
        // slow turn
        tspeed = 2
    } else {
        tspeed = speed
    }
    // let movement keys cancel each other out
    if (int(strafe) != 0) {
        if (int(gamekeydown[key_right]) != 0) {
            side += sidemove[speed]
        }
        if (int(gamekeydown[key_left]) != 0) {
            side -= sidemove[speed]
        }
        if (joyxmove > 0) {
            side += sidemove[speed]
        }
        if (joyxmove < 0) {
            side -= sidemove[speed]
        }
    } else {
        if (int(gamekeydown[key_right]) != 0) {
            cmd.angleturn = int16(int(cmd.angleturn) - angleturn[tspeed])
        }
        if (int(gamekeydown[key_left]) != 0) {
            cmd.angleturn = int16(int(cmd.angleturn) + angleturn[tspeed])
        }
        if (joyxmove > 0) {
            cmd.angleturn = int16(int(cmd.angleturn) - angleturn[tspeed])
        }
        if (joyxmove < 0) {
            cmd.angleturn = int16(int(cmd.angleturn) + angleturn[tspeed])
        }
    }
    if (int(gamekeydown[key_up]) != 0) {
        forward += forwardmove[speed]
    }
    if (int(gamekeydown[key_down]) != 0) {
        forward -= forwardmove[speed]
    }
    if (joyymove < 0) {
        forward += forwardmove[speed]
    }
    if (joyymove > 0) {
        forward -= forwardmove[speed]
    }
    if (int(gamekeydown[key_straferight]) != 0) {
        side += sidemove[speed]
    }
    if (int(gamekeydown[key_strafeleft]) != 0) {
        side -= sidemove[speed]
    }
    // buttons
    cmd.chatchar = uint8(HU_dequeueChatChar())
    if (uint(int(gamekeydown[key_fire])) != 0 || uint(int(deref(mousebuttons + mousebfire))) != 0 || uint(int(deref(joybuttons + joybfire))) != 0) {
        cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_ATTACK))
    }
    if (uint(int(gamekeydown[key_use])) != 0 || uint(int(deref(joybuttons + joybuse))) != 0) {
        cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_USE))
        // clear double clicks if hit use button
        dclicks = 0
    }
    // chainsaw overrides
    for (i in range(int(weapontype_t.NUMWEAPONS) - 1)) {
        if (int(gamekeydown['1' + i]) != 0) {
            cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_CHANGE))
            cmd.buttons = uint8(int(cmd.buttons) | i << int(buttoncode_t.BT_WEAPONSHIFT))
            break
        }
    }
    // mouse
    if (int(deref(mousebuttons + mousebforward)) != 0) {
        forward += forwardmove[speed]
    }
    // forward double click
    if (uint(int(deref(mousebuttons + mousebforward))) != uint(dclickstate) && dclicktime > 1) {
        dclickstate = int(deref(mousebuttons + mousebforward))
        if (dclickstate != 0) {
            dclicks++
        }
        if (dclicks == 2) {
            cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_USE))
            dclicks = 0
        } else {
            dclicktime = 0
        }
    } else {
        dclicktime += ticdup
        if (dclicktime > 20) {
            dclicks = 0
            dclickstate = 0
        }
    }
    // strafe double click
    bstrafe = enum_from_int(type<doom_boolean>, uint(int(deref(mousebuttons + mousebstrafe))) != 0 || uint(int(deref(joybuttons + joybstrafe))) != 0 ? 1 : 0)
    if (uint(int(bstrafe)) != uint(dclickstate2) && dclicktime2 > 1) {
        dclickstate2 = int(bstrafe)
        if (dclickstate2 != 0) {
            dclicks2++
        }
        if (dclicks2 == 2) {
            cmd.buttons = uint8(int(cmd.buttons) | int(buttoncode_t.BT_USE))
            dclicks2 = 0
        } else {
            dclicktime2 = 0
        }
    } else {
        dclicktime2 += ticdup
        if (dclicktime2 > 20) {
            dclicks2 = 0
            dclickstate2 = 0
        }
    }
    if (mousemove != 0) {
        forward += mousey
    }
    if (int(strafe) != 0) {
        side += mousex * 2
    } else {
        cmd.angleturn = int16(int(cmd.angleturn) - mousex * 8)
    }
    mousey = 0
    mousex = mousey
    if (forward > forwardmove[1]) {
        forward = forwardmove[1]
    } elif (forward < -forwardmove[1]) {
        forward = -forwardmove[1]
    }
    if (side > forwardmove[1]) {
        side = forwardmove[1]
    } elif (side < -forwardmove[1]) {
        side = -forwardmove[1]
    }
    cmd.forwardmove = int8(int(cmd.forwardmove) + forward)
    cmd.sidemove = int8(int(cmd.sidemove) + side)
    // special buttons
    if (int(sendpause) != 0) {
        sendpause = doom_boolean._c_false
        cmd.buttons = uint8(int(buttoncode_t.BT_SPECIAL) | int(buttoncode_t.BTS_PAUSE))
    }
    if (int(sendsave) != 0) {
        sendsave = doom_boolean._c_false
        cmd.buttons = uint8(int(buttoncode_t.BT_SPECIAL) | int(buttoncode_t.BTS_SAVEGAME) | savegameslot << int(buttoncode_t.BTS_SAVESHIFT))
    }
}

// G_DoLoadLevel
[c_function]
def G_DoLoadLevel {
    // Set the sky map.
    // First thing, we have a dummy sky texture name,
    // a flat. The data is in the WAD only because
    // we look for an actual index, instead of simply
    // setting one.
    skyflatnum = R_FlatNumForName(reinterpret<uint8?>("F_SKY1"))
    // DOOM determines the sky texture to be used
    // depending on the current episode, and the game version.
    if (gamemode == GameMode_t.commercial || uint(int(gamemode)) == uint(int(GameMission_t.pack_tnt)) || uint(int(gamemode)) == uint(int(GameMission_t.pack_plut))) {
        skytexture = R_TextureNumForName(reinterpret<uint8?>("SKY3"))
        if (gamemap < 12) {
            skytexture = R_TextureNumForName(reinterpret<uint8?>("SKY1"))
        } elif (gamemap < 21) {
            skytexture = R_TextureNumForName(reinterpret<uint8?>("SKY2"))
        }
    }
    // for time calculation
    levelstarttic = gametic
    if (wipegamestate == gamestate_t.GS_LEVEL) {
        // force a wipe
        wipegamestate = enum_from_int(type<gamestate_t>, -1)
    }
    gamestate = gamestate_t.GS_LEVEL
    for (i in range(MAXPLAYERS)) {
        if (uint(int(playeringame[i])) != 0 && players[i].playerstate == playerstate_t.PST_DEAD) {
            players[i].playerstate = playerstate_t.PST_REBORN
        }
        doom_memset(reinterpret<void?>(addr(players[i].frags[0])), 0, int(uint64(typeinfo sizeof(type<int[4]>))))
    }
    P_SetupLevel(gameepisode, gamemap, 0, gameskill)
    // view the guy you are playing
    displayplayer = consoleplayer
    starttime = I_GetTime()
    gameaction = gameaction_t.ga_nothing
    Z_CheckHeap()
    // clear cmd building stuff
    doom_memset(reinterpret<void?>(addr(gamekeydown[0])), 0, int(uint64(typeinfo sizeof(type<doom_boolean[256]>))))
    joyymove = 0
    joyxmove = joyymove
    mousey = 0
    mousex = mousey
    paused = doom_boolean._c_false
    sendsave = paused
    sendpause = sendsave
    doom_memset(reinterpret<void?>(mousebuttons), 0, int(uint64(typeinfo sizeof(type<doom_boolean>)) * uint64(3)))
    doom_memset(reinterpret<void?>(joybuttons), 0, int(uint64(typeinfo sizeof(type<doom_boolean>)) * uint64(4)))
}

// G_Responder
// Get info needed to make ticcmd_ts for the players.
[c_function]
def G_Responder(var ev : event_t?) : doom_boolean {
    // allow spy mode changes even during the demo
    if (gamestate == gamestate_t.GS_LEVEL && ev._c_type == evtype_t.ev_keydown && ev.data1 == KEY_F12 && (uint(int(singledemo)) != 0 || !(int(deathmatch) != 0))) {
        // spy mode
        while (true) {
            displayplayer++
            if (displayplayer == MAXPLAYERS) {
                displayplayer = 0
            }
            if (!(!(int(playeringame[displayplayer]) != 0) && displayplayer != consoleplayer)) {
                break
            }
        }
        return doom_boolean._c_true
    }
    // any other key pops up menu if in demos
    if (gameaction == gameaction_t.ga_nothing && !(int(singledemo) != 0) && (uint(int(demoplayback)) != 0 || gamestate == gamestate_t.GS_DEMOSCREEN)) {
        if (ev._c_type == evtype_t.ev_keydown || ev._c_type == evtype_t.ev_mouse && ev.data1 != 0 || ev._c_type == evtype_t.ev_joystick && ev.data1 != 0) {
            M_StartControlPanel()
            return doom_boolean._c_true
        }
        return doom_boolean._c_false
    }
    if (gamestate == gamestate_t.GS_LEVEL) {
        if (int(HU_Responder(ev)) != 0) {
            // chat ate the event
            return doom_boolean._c_true
        }
        if (int(ST_Responder(ev)) != 0) {
            // status window ate it
            return doom_boolean._c_true
        }
        if (int(AM_Responder(ev)) != 0) {
            // automap ate it
            return doom_boolean._c_true
        }
    }
    if (gamestate == gamestate_t.GS_FINALE) {
        if (int(F_Responder(ev)) != 0) {
            // finale ate the event
            return doom_boolean._c_true
        }
    }
    let _cond = ev._c_type
    if (_cond == evtype_t.ev_keydown) {
        if (ev.data1 == KEY_PAUSE) {
            sendpause = doom_boolean._c_true
            return doom_boolean._c_true
        }
        if (ev.data1 < NUMKEYS) {
            gamekeydown[ev.data1] = doom_boolean._c_true
        }
        // eat key down events
        return doom_boolean._c_true
    } elif (_cond == evtype_t.ev_keyup) {
        if (ev.data1 < NUMKEYS) {
            gamekeydown[ev.data1] = doom_boolean._c_false
        }
        // always let key up events filter down
        return doom_boolean._c_false
    } elif (_cond == evtype_t.ev_mouse) {
        deref(mousebuttons + 0) = enum_from_int(type<doom_boolean>, ev.data1 & 1)
        deref(mousebuttons + 1) = enum_from_int(type<doom_boolean>, ev.data1 & 2)
        deref(mousebuttons + 2) = enum_from_int(type<doom_boolean>, ev.data1 & 4)
        mousex = ev.data2 * (mouseSensitivity + 5) / 10
        mousey = ev.data3 * (mouseSensitivity + 5) / 10
        // eat events
        return doom_boolean._c_true
    } elif (_cond == evtype_t.ev_joystick) {
        deref(joybuttons + 0) = enum_from_int(type<doom_boolean>, ev.data1 & 1)
        deref(joybuttons + 1) = enum_from_int(type<doom_boolean>, ev.data1 & 2)
        deref(joybuttons + 2) = enum_from_int(type<doom_boolean>, ev.data1 & 4)
        deref(joybuttons + 3) = enum_from_int(type<doom_boolean>, ev.data1 & 8)
        joyxmove = ev.data2
        joyymove = ev.data3
        // eat events
        return doom_boolean._c_true
    } else {
    }
    return doom_boolean._c_false
}

// G_TicChecksum
// [c2das] The 32-bit FNV-1a over the little-endian bytes of players[0].mo->x, y, z, angle
// (0 without a mobj), players[0].health and prndindex, the P_Random index.
def private G_TicChecksum : uint {
    var mo : mobj_s? = players[0].mo
    var values : uint[6]
    var cs : uint = 2166136261u
    var b : int
    values[0] = mo != null ? uint(mo.x) : uint(0)
    values[1] = mo != null ? uint(mo.y) : uint(0)
    values[2] = mo != null ? uint(mo.z) : uint(0)
    values[3] = mo != null ? mo.angle : uint(0)
    values[4] = uint(players[0].health)
    values[5] = uint(prndindex)
    for (i in range(6)) {
        {
            b = 0
            while (b < 32) {
                cs ^= values[i] >> uint(b) & uint(255)
                cs *= 16777619u
                b += 8
            }
        }
    }
    return cs
}

// G_Ticker
// Make ticcmd_ts for the players.
[c_function]
def G_Ticker {
    var buf : int
    var cmd : ticcmd_t?
    // do player reborns if needed
    for (i in range(MAXPLAYERS)) {
        if (uint(int(playeringame[i])) != 0 && players[i].playerstate == playerstate_t.PST_REBORN) {
            G_DoReborn(i)
        }
    }
    // do things to change the game state
    while (gameaction != gameaction_t.ga_nothing) {
        let _cond = gameaction
        if (_cond == gameaction_t.ga_loadlevel) {
            G_DoLoadLevel()
        } elif (_cond == gameaction_t.ga_newgame) {
            G_DoNewGame()
        } elif (_cond == gameaction_t.ga_loadgame) {
            G_DoLoadGame()
        } elif (_cond == gameaction_t.ga_savegame) {
            G_DoSaveGame()
        } elif (_cond == gameaction_t.ga_playdemo) {
            G_DoPlayDemo()
        } elif (_cond == gameaction_t.ga_completed) {
            G_DoCompleted()
        } elif (_cond == gameaction_t.ga_victory) {
            F_StartFinale()
        } elif (_cond == gameaction_t.ga_worlddone) {
            G_DoWorldDone()
        } elif (_cond == gameaction_t.ga_screenshot) {
            M_ScreenShot()
            gameaction = gameaction_t.ga_nothing
        } elif (_cond == gameaction_t.ga_nothing) {
        }
    }
    // get commands, check consistancy,
    // and build new consistancy check
    buf = gametic / ticdup % BACKUPTICS
    for (i in range(MAXPLAYERS)) {
        if (int(playeringame[i]) != 0) {
            cmd = addr(players[i].cmd)
            doom_memcpy(reinterpret<void?>(cmd), reinterpret<void?>(addr(netcmds[i][0]) + end_index(buf, 12)), int(uint64(typeinfo sizeof(type<ticcmd_t>))))
            if (int(demoplayback) != 0) {
                G_ReadDemoTiccmd(cmd)
            }
            if (int(demorecording) != 0) {
                G_WriteDemoTiccmd(cmd)
            }
            // check for turbo cheats
            if (int(cmd.forwardmove) > TURBOTHRESHOLD && !((gametic & 31) != 0) && (gametic >> 5 & 3) == i) {
                // doom_sprintf(turbomessage, "%s is turbo!", player_names[i]);
                doom_strcpy(addr(G_Ticker_turbomessage[0]), player_names[i])
                doom_concat(addr(G_Ticker_turbomessage[0]), reinterpret<uint8?>(" is turbo!"))
                players[consoleplayer].message = addr(G_Ticker_turbomessage[0])
            }
            if (uint(int(netgame)) != 0 && !(int(netdemo) != 0) && !(gametic % ticdup != 0)) {
                if (gametic > BACKUPTICS && int(consistancy[i][buf]) != int(cmd.consistancy)) {
                    // I_Error("Error: consistency failure (%i should be %i)",
                    // cmd->consistancy, consistancy[i][buf]);
                    doom_strcpy(addr(error_buf[0]), reinterpret<uint8?>("Error: consistency failure ("))
                    doom_concat(addr(error_buf[0]), doom_itoa(int(cmd.consistancy), 10))
                    doom_concat(addr(error_buf[0]), reinterpret<uint8?>(" should be "))
                    doom_concat(addr(error_buf[0]), doom_itoa(int(consistancy[i][buf]), 10))
                    doom_concat(addr(error_buf[0]), reinterpret<uint8?>(")"))
                    I_Error(addr(error_buf[0]))
                }
                if (players[i].mo != null) {
                    consistancy[i][buf] = int16(players[i].mo.x)
                } else {
                    consistancy[i][buf] = int16(rndindex)
                }
            }
        }
    }
    // check for special buttons
    for (i in range(MAXPLAYERS)) {
        if (int(playeringame[i]) != 0) {
            if ((int(players[i].cmd.buttons) & int(buttoncode_t.BT_SPECIAL)) != 0) {
                let _cond2 = int(players[i].cmd.buttons) & int(buttoncode_t.BT_SPECIALMASK)
                if (_cond2 == 1) {
                    paused = enum_from_int(type<doom_boolean>, int(uint(int(paused)) ^ uint(1)))
                    if (int(paused) != 0) {
                        S_PauseSound()
                    } else {
                        S_ResumeSound()
                    }
                } elif (_cond2 == 2) {
                    if (!(savedescription[0] != 0)) {
                        doom_strcpy(addr(savedescription[0]), reinterpret<uint8?>("NET GAME"))
                    }
                    savegameslot = (int(players[i].cmd.buttons) & int(buttoncode_t.BTS_SAVEMASK)) >> int(buttoncode_t.BTS_SAVESHIFT)
                    gameaction = gameaction_t.ga_savegame
                }
            }
        }
    }
    // do main actions
    let _cond3 = gamestate
    if (_cond3 == gamestate_t.GS_LEVEL) {
        P_Ticker()
        ST_Ticker()
        AM_Ticker()
        HU_Ticker()
    } elif (_cond3 == gamestate_t.GS_INTERMISSION) {
        WI_Ticker()
    } elif (_cond3 == gamestate_t.GS_FINALE) {
        F_Ticker()
    } elif (_cond3 == gamestate_t.GS_DEMOSCREEN) {
        D_PageTicker()
    }
    tic_checksum_cs = G_TicChecksum()
    tic_checksum_tic = gametic
}

// G_InitPlayer
// Called at the start.
// Called by the game initialization functions.
[c_function]
def G_InitPlayer(player : int) {
    var p : player_s?
    // set up the saved info
    p = addr(players[0]) + end_index(player, 4)
    // clear everything else to defaults
    G_PlayerReborn(player)
}

// G_PlayerFinishLevel
// Can when a player completes a level.
[c_function]
def G_PlayerFinishLevel(player : int) {
    var p : player_s?
    p = addr(players[0]) + end_index(player, 4)
    doom_memset(reinterpret<void?>(addr(p.powers[0])), 0, int(uint64(typeinfo sizeof(type<int[6]>))))
    doom_memset(reinterpret<void?>(addr(p.cards[0])), 0, int(uint64(typeinfo sizeof(type<doom_boolean[6]>))))
    // cancel invisibility
    p.mo.flags &= ~int(mobjflag_t.MF_SHADOW)
    // cancel gun flashes
    p.extralight = 0
    // cancel ir gogles
    p.fixedcolormap = 0
    // no palette changes
    p.damagecount = 0
    p.bonuscount = 0
}

// G_PlayerReborn
// Called after a player dies
// almost everything is cleared and initialized
[c_function]
def G_PlayerReborn(player : int) {
    var p : player_s?
    var frags : int[4]
    var killcount : int
    var itemcount : int
    var secretcount : int
    doom_memcpy(reinterpret<void?>(addr(frags[0])), reinterpret<void?>(addr(players[player].frags[0])), int(uint64(typeinfo sizeof(type<int[4]>))))
    killcount = players[player].killcount
    itemcount = players[player].itemcount
    secretcount = players[player].secretcount
    p = addr(players[0]) + end_index(player, 4)
    doom_memset(reinterpret<void?>(p), 0, int(uint64(typeinfo sizeof(type<player_s>))))
    doom_memcpy(reinterpret<void?>(addr(players[player].frags[0])), reinterpret<void?>(addr(frags[0])), int(uint64(typeinfo sizeof(type<int[4]>))))
    players[player].killcount = killcount
    players[player].itemcount = itemcount
    players[player].secretcount = secretcount
    // don't do anything immediately
    p.attackdown = int(doom_boolean._c_true)
    p.usedown = p.attackdown
    p.playerstate = playerstate_t.PST_LIVE
    p.health = MAXHEALTH
    p.pendingweapon = weapontype_t.wp_pistol
    p.readyweapon = p.pendingweapon
    p.weaponowned[int(weapontype_t.wp_fist)] = doom_boolean._c_true
    p.weaponowned[int(weapontype_t.wp_pistol)] = doom_boolean._c_true
    p.ammo[int(ammotype_t.am_clip)] = 50
    for (i in range(int(ammotype_t.NUMAMMO))) {
        p.maxammo[i] = maxammo[i]
    }
}

[c_function]
def G_CheckSpot(playernum : int; var mthing : mapthing_t?) : doom_boolean {
    var x : int
    var y : int
    var ss : subsector_s?
    var an : uint
    var mo : mobj_s?
    if (!(players[playernum].mo != null)) {
        // first spawn of level, before corpses
        for (i in range(playernum)) {
            if (players[i].mo.x == int(mthing.x) << FRACBITS && players[i].mo.y == int(mthing.y) << FRACBITS) {
                return doom_boolean._c_false
            }
        }
        return doom_boolean._c_true
    }
    x = int(mthing.x) << FRACBITS
    y = int(mthing.y) << FRACBITS
    if (!(int(P_CheckPosition(players[playernum].mo, x, y)) != 0)) {
        return doom_boolean._c_false
    }
    // flush an old corpse if needed
    if (bodyqueslot >= BODYQUESIZE) {
        P_RemoveMobj(bodyque[bodyqueslot % BODYQUESIZE])
    }
    bodyque[bodyqueslot % BODYQUESIZE] = players[playernum].mo
    bodyqueslot++
    // spawn a teleport fog
    ss = R_PointInSubsector(x, y)
    an = uint(ANG45 * (int(mthing.angle) / 45) >> ANGLETOFINESHIFT)
    mo = P_SpawnMobj(x + 20 * deref(finecosine + an), y + 20 * finesine[an], ss.sector.floorheight, mobjtype_t.MT_TFOG)
    if (players[consoleplayer].viewz != 1) {
        // don't start sound on first frame
        S_StartSound(reinterpret<void?>(mo), int(sfxenum_t.sfx_telept))
    }
    return doom_boolean._c_true
}

// G_DeathMatchSpawnPlayer
// Spawns a player at one of the random death match spots
// called at level load and each death
[c_function]
def G_DeathMatchSpawnPlayer(playernum : int) {
    var i : int
    var selections : int
    selections = int(int64(deathmatch_p - addr(deathmatchstarts[0])))
    if (selections < 4) {
        // I_Error("Error: Only %i deathmatch spots, 4 required", selections);
        doom_strcpy(addr(error_buf[0]), reinterpret<uint8?>("Error: Only "))
        doom_concat(addr(error_buf[0]), doom_itoa(selections, 10))
        doom_concat(addr(error_buf[0]), reinterpret<uint8?>(" deathmatch spots, 4 required"))
        I_Error(addr(error_buf[0]))
    }
    for (j in range(20)) {
        i = P_Random() % selections
        if (int(G_CheckSpot(playernum, addr(deathmatchstarts[0]) + end_index(i, 10))) != 0) {
            deathmatchstarts[i]._c_type = int16(playernum + 1)
            P_SpawnPlayer(addr(deathmatchstarts[0]) + end_index(i, 10))
            return
        }
    }
    // no good spot, so the player will probably get stuck
    P_SpawnPlayer(addr(playerstarts[0]) + end_index(playernum, 4))
}

// G_DoReborn
[c_function]
def G_DoReborn(playernum : int) {
    if (!(int(netgame) != 0)) {
        // reload the level from scratch
        gameaction = gameaction_t.ga_loadlevel
    } else {
        // respawn at the start
        // first dissasociate the corpse
        players[playernum].mo.player = null
        // spawn at random spot if in death match
        if (int(deathmatch) != 0) {
            G_DeathMatchSpawnPlayer(playernum)
            return
        }
        if (int(G_CheckSpot(playernum, addr(playerstarts[0]) + end_index(playernum, 4))) != 0) {
            P_SpawnPlayer(addr(playerstarts[0]) + end_index(playernum, 4))
            return
        }
        // try to spawn at one of the other players spots
        for (i in range(MAXPLAYERS)) {
            if (int(G_CheckSpot(playernum, addr(playerstarts[0]) + end_index(i, 4))) != 0) {
                // fake as other player
                playerstarts[i]._c_type = int16(playernum + 1)
                P_SpawnPlayer(addr(playerstarts[0]) + end_index(i, 4))
                // restore
                playerstarts[i]._c_type = int16(i + 1)
                return
            }
        }
        // he's going to be inside something. Too bad.
        P_SpawnPlayer(addr(playerstarts[0]) + end_index(playernum, 4))
    }
}

