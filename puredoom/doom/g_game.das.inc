[c_function]
def G_DoLoadGame {
    var length : int
    var a : int
    var b : int
    var c : int
    var vcheck : uint8[16]
    gameaction = gameaction_t.ga_nothing
    length = M_ReadFile(addr(savename[0]), addr(savebuffer))
    save_p = savebuffer + SAVESTRINGSIZE
    // skip the description field
    doom_memset(reinterpret<void?>(addr(vcheck[0])), 0, int(uint64(typeinfo sizeof(type<uint8[16]>))))
    // doom_sprintf(vcheck, "version %i", VERSION);
    doom_strcpy(addr(vcheck[0]), reinterpret<uint8?>("version "))
    doom_concat(addr(vcheck[0]), doom_itoa(int(anon_82.VERSION), 10))
    if (doom_strcmp(reinterpret<uint8?>(save_p), addr(vcheck[0])) != 0) {
        // bad version
        return
    }
    save_p = save_p + VERSIONSIZE
    var _t0 = save_p
    save_p = save_p + 1
    gameskill = enum_from_int(type<skill_t>, int(deref(_t0)))
    var _t1 = save_p
    save_p = save_p + 1
    gameepisode = int(deref(_t1))
    var _t2 = save_p
    save_p = save_p + 1
    gamemap = int(deref(_t2))
    for (i in range(MAXPLAYERS)) {
        var _t3 = save_p
        save_p = save_p + 1
        playeringame[i] = enum_from_int(type<doom_boolean>, int(deref(_t3)))
    }
    // load a base level
    G_InitNew(gameskill, gameepisode, gamemap)
    // get the times
    var _t4 = save_p
    save_p = save_p + 1
    a = int(deref(_t4))
    var _t5 = save_p
    save_p = save_p + 1
    b = int(deref(_t5))
    var _t6 = save_p
    save_p = save_p + 1
    c = int(deref(_t6))
    leveltime = (a << 16) + (b << 8) + c
    // dearchive all the modifications
    P_UnArchivePlayers()
    P_UnArchiveWorld()
    P_UnArchiveThinkers()
    P_UnArchiveSpecials()
    if (int(deref(save_p)) != 29) {
        I_Error(reinterpret<uint8?>("Error: Bad savegame"))
    }
    // done
    Z_Free(reinterpret<void?>(savebuffer))
    if (int(setsizeneeded) != 0) {
        R_ExecuteSetViewSize()
    }
    // draw the pattern into the back screen
    R_FillBackScreen()
}

