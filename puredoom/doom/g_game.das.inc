    }
    if (gamemode == GameMode_t.commercial) {
        let _cond = gamemap
        while (true) {
            var _flag = false
            _flag ||= _cond == 15
            _flag ||= _cond == 31
            if (_flag) {
                if (!(int(secretexit) != 0)) {
