def P_SpawnDoorRaiseIn5Mins(var sec : sector_t?; secnum : int) {
    var door : vldoor_t?
    door = reinterpret<vldoor_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<vldoor_t>))), PU_LEVSPEC, null))
    P_AddThinker(addr(door.thinker))
