    var delta_time : int = now - last_update_time
    while (true) {
        let _t0 = delta_time
        delta_time--
        if (!(_t0 > 0)) {
            break
        }
        if (int(is_wiping_screen) != 0) {
            D_UpdateWipe()
        } else {
            D_DoomLoop()
        }
    }
    last_update_time = now
