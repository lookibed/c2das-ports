def doom_get_framebuffer(channels : int) : uint8? {
    var i : int
    var len : int
    doom_memcpy(reinterpret<void?>(screen_buffer), reinterpret<void?>(screens[0]), SCREENWIDTH * SCREENHEIGHT)
    // Draw crosshair
    if (crosshair != 0 && int(menuactive) == 0 && gamestate == gamestate_t.GS_LEVEL && int(automapactive) == 0) {
        var y : int
        if (setblocks == 11) {
            y = SCREENHEIGHT / 2 + 8
        } else {
            y = SCREENHEIGHT / 2 - 8
        }
        for (i1 in range(2)) {
            screen_buffer[SCREENWIDTH / 2 - 2 - i1 + y * SCREENWIDTH] = 4u8
            screen_buffer[SCREENWIDTH / 2 + 2 + i1 + y * SCREENWIDTH] = 4u8
        }
        i = 0
        while (i < 2) {
            screen_buffer[SCREENWIDTH / 2 + (y - 2 - i) * SCREENWIDTH] = 4u8
            screen_buffer[SCREENWIDTH / 2 + (y + 2 + i) * SCREENWIDTH] = 4u8
            i++
        }
    }
    if (channels == 1) {
        return screen_buffer
    } elif (channels == 3) {
        i = 0
        len = SCREENWIDTH * SCREENHEIGHT
        while (i < len) {
            var k : int = i * 3
            var kpal : int = int(screen_buffer[i]) * 3
            final_screen_buffer[k + 0] = screen_palette[kpal + 0]
            final_screen_buffer[k + 1] = screen_palette[kpal + 1]
            final_screen_buffer[k + 2] = screen_palette[kpal + 2]
            i++
        }
        return final_screen_buffer
    } elif (channels == 4) {
        i = 0
        len = SCREENWIDTH * SCREENHEIGHT
        while (i < len) {
            var k : int = i * 4
            var kpal : int = int(screen_buffer[i]) * 3
            final_screen_buffer[k + 0] = screen_palette[kpal + 0]
            final_screen_buffer[k + 1] = screen_palette[kpal + 1]
            final_screen_buffer[k + 2] = screen_palette[kpal + 2]
            final_screen_buffer[k + 3] = 255u8
            i++
        }
        return final_screen_buffer
    } else {
        return null
    }
}

