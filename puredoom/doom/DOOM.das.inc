    button_states[int(button)] = 0
    var event : event_t
    event._c_type = evtype_t.ev_mouse
    event.data1 = button_states[0] | (button_states[1] != 0 ? 2 : 0) | (button_states[2] != 0 ? 4 : 0)
    event.data1 = event.data1 ^ (button_states[0] != 0 ? 1 : 0) ^ (button_states[1] != 0 ? 2 : 0) ^ (button_states[2] != 0 ? 4 : 0)
    event.data3 = 0
    event.data2 = event.data3
    D_PostEvent(addr(event))
}

[c_function]
