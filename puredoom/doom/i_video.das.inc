// I_FinishUpdate
[c_function]
def I_FinishUpdate {
    var tics : int
    var i : int
    // draws little dots on the bottom of the screen
    if (int(devparm) != 0) {
        i = I_GetTime()
        tics = i - I_FinishUpdate_lasttic
        I_FinishUpdate_lasttic = i
        if (tics > 20) {
            tics = 20
        }
        {
            i = 0
            while (i < tics * 2) {
                deref(screens[0] + ((SCREENHEIGHT - 1) * SCREENWIDTH + i)) = uint8(255)
                i += 2
            }
        }
        {
            while (i < 20 * 2) {
                deref(screens[0] + ((SCREENHEIGHT - 1) * SCREENWIDTH + i)) = uint8(0)
                i += 2
            }
        }
    }
}

// I_ReadScreen
[c_function]
def I_ReadScreen(var scr : uint8?) {
    doom_memcpy(reinterpret<void?>(scr), reinterpret<void?>(screens[0]), SCREENWIDTH * SCREENHEIGHT)
}

// I_SetPalette
[c_function]
def I_SetPalette(var palette : uint8?) {
    doom_memcpy(reinterpret<void?>(addr(screen_palette[0])), reinterpret<void?>(palette), 256 * 3)
}

[c_function]
def I_InitGraphics {
    screens[0] = reinterpret<uint8?>(invoke(doom_malloc, SCREENWIDTH * SCREENHEIGHT))
    // [c2das] the frame checksum reads the screen before the first tic draws it
    doom_memset(reinterpret<void?>(screens[0]), 0, SCREENWIDTH * SCREENHEIGHT)
}

