// EV_DoCeiling
// Move a ceiling up/down and all around!
[c_function]
def EV_DoCeiling(var line : line_s?; _c_type : ceiling_e) : int {
    var secnum : int
    var rtn : int
    var sec : sector_t?
    var ceiling : ceiling_t?
    secnum = -1
    rtn = 0
    // Reactivate in-stasis ceilings...for certain types.
    let _cond = _c_type
    while (true) {
        var _flag = false
        _flag ||= _cond == ceiling_e.fastCrushAndRaise
        _flag ||= _cond == ceiling_e.silentCrushAndRaise
        _flag ||= _cond == ceiling_e.crushAndRaise
        if (_flag) {
            P_ActivateInStasisCeiling(line)
        }
        _flag ||= !(_cond == ceiling_e.fastCrushAndRaise || _cond == ceiling_e.silentCrushAndRaise || _cond == ceiling_e.crushAndRaise)
        if (_flag) {
            break
        }
        break
    }
    while (true) {
        secnum = P_FindSectorFromLineTag(line, secnum)
        if (!(secnum >= 0)) {
            break
        }
        sec = addr(sectors[secnum])
        if (sec.specialdata != null) {
            continue
        }
        // new door thinker
        rtn = 1
        ceiling = reinterpret<ceiling_t?>(Z_Malloc(int(uint64(typeinfo sizeof(type<ceiling_t>))), PU_LEVSPEC, null))
        P_AddThinker(addr(ceiling.thinker))
        sec.specialdata = reinterpret<void?>(ceiling)
        ceiling.thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveCeiling)
        ceiling.sector = sec
        ceiling.crush = doom_boolean._c_false
        let _cond2 = _c_type
        while (true) {
            var _flag2 = false
            if (_cond2 == ceiling_e.fastCrushAndRaise) {
                ceiling.crush = doom_boolean._c_true
                ceiling.topheight = sec.ceilingheight
                ceiling.bottomheight = sec.floorheight + (8 * FRACUNIT)
                ceiling.direction = -1
                ceiling.speed = FRACUNIT * 2
                break
            }
            _flag2 ||= _cond2 == ceiling_e.silentCrushAndRaise
            _flag2 ||= _cond2 == ceiling_e.crushAndRaise
            if (_flag2) {
                ceiling.crush = doom_boolean._c_true
                ceiling.topheight = sec.ceilingheight
            }
            _flag2 ||= _cond2 == ceiling_e.lowerAndCrush
            _flag2 ||= _cond2 == ceiling_e.lowerToFloor
            if (_flag2) {
                ceiling.bottomheight = sec.floorheight
                if (_c_type != ceiling_e.lowerToFloor) {
                    ceiling.bottomheight += 8 * FRACUNIT
                }
                ceiling.direction = -1
                ceiling.speed = FRACUNIT
                break
            }
            if (_cond2 == ceiling_e.raiseToHighest) {
                ceiling.topheight = P_FindHighestCeilingSurrounding(sec)
                ceiling.direction = 1
                ceiling.speed = FRACUNIT
                break
            }
            break
        }
        ceiling.tag = int(sec.tag)
        ceiling._c_type = _c_type
        P_AddActiveCeiling(ceiling)
    }
    return rtn
}

// Add an active ceiling
def P_AddActiveCeiling(var c : ceiling_t?) {
    for (i in range(MAXCEILINGS)) {
        if (activeceilings[i] == null) {
            activeceilings[i] = c
            return
        }
    }
}

// Remove a ceiling's thinker
[c_function]
def P_RemoveActiveCeiling(var c : ceiling_t?) {
    for (i in range(MAXCEILINGS)) {
        if (intptr(activeceilings[i]) == intptr(c)) {
            activeceilings[i].sector.specialdata = null
            P_RemoveThinker(addr(activeceilings[i].thinker))
            activeceilings[i] = null
            break
        }
    }
}

// Restart a ceiling that's in-stasis
[c_function]
def P_ActivateInStasisCeiling(var line : line_s?) {
    for (i in range(MAXCEILINGS)) {
        if (activeceilings[i] != null && (activeceilings[i].tag == int(line.tag)) && (activeceilings[i].direction == 0)) {
            activeceilings[i].direction = activeceilings[i].olddirection
            activeceilings[i].thinker._c_function.acp1 = reinterpret<function<(var a0 : void?) : void>>(@@T_MoveCeiling)
        }
    }
}

// EV_CeilingCrushStop
// Stop a ceiling from crushing!
def EV_CeilingCrushStop(var line : line_s?) : int {
    var rtn : int
    rtn = 0
    for (i in range(MAXCEILINGS)) {
        if (activeceilings[i] != null && (activeceilings[i].tag == int(line.tag)) && (activeceilings[i].direction != 0)) {
            activeceilings[i].olddirection = activeceilings[i].direction
            activeceilings[i].thinker._c_function.acv = default<function<() : void>>
            // in-stasis
            activeceilings[i].direction = 0
            rtn = 1
        }
    }
    return rtn
}

