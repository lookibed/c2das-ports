def WI_Drawer {
    c_switch(state) {
        case(stateenum_t.StatCount) {
            if (int(deathmatch) != 0) {
                WI_drawDeathmatchStats()
            } elif (int(netgame) != 0) {
                WI_drawNetgameStats()
            } else {
                WI_drawStats()
            }
            break
        }
        case(stateenum_t.ShowNextLoc) {
            WI_drawShowNextLoc()
            break
        }
        case(stateenum_t.NoState) {
            WI_drawNoState()
            break
        }
    }
}

[c_function]
def WI_initVariables(var wbstartstruct : wbstartstruct_t?) {
    wbs = wbstartstruct
    acceleratestage = 0
    bcnt = 0
    cnt = bcnt
    firstrefresh = 1
    me = wbs.pnum
    plrs = addr(wbs.plyr[0])
    if (wbs.maxkills == 0) {
        wbs.maxkills = 1
    }
    if (wbs.maxitems == 0) {
        wbs.maxitems = 1
    }
    if (wbs.maxsecret == 0) {
        wbs.maxsecret = 1
    }
    if (gamemode != GameMode_t.retail) {
        if (wbs.epsd > 2) {
            wbs.epsd -= 3
        }
    }
}

def WI_Start(var wbstartstruct : wbstartstruct_t?) {
    WI_initVariables(wbstartstruct)
    WI_loadData()
    if (int(deathmatch) != 0) {
        WI_initDeathmatchStats()
    } elif (int(netgame) != 0) {
        WI_initNetgameStats()
    } else {
        WI_initStats()
    }
}

