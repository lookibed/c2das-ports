[c_function]
def WI_checkForAccelerate {
    var i : int
    var player : player_s?
    // check for button presses to skip delays
    i = 0
    player = addr(players[0])
    while (i < MAXPLAYERS) {
        if (int(playeringame[i]) != 0) {
            if ((int(player.cmd.buttons) & int(buttoncode_t.BT_ATTACK)) != 0) {
                if (player.attackdown == 0) {
                    acceleratestage = 1
                }
                player.attackdown = int(doom_boolean._c_true)
            } else {
                player.attackdown = int(doom_boolean._c_false)
            }
            if ((int(player.cmd.buttons) & int(buttoncode_t.BT_USE)) != 0) {
                if (player.usedown == 0) {
                    acceleratestage = 1
                }
                player.usedown = int(doom_boolean._c_true)
            } else {
                player.usedown = int(doom_boolean._c_false)
            }
        }
        i++
        player++
    }
}

// Updates stuff each tick
def WI_Ticker {
    // counter for general background animation
    bcnt++
    if (bcnt == 1) {
        // intermission music
        if (gamemode == GameMode_t.commercial) {
            S_ChangeMusic(int(musicenum_t.mus_dm2int), int(doom_boolean._c_true))
        } else {
            S_ChangeMusic(int(musicenum_t.mus_inter), int(doom_boolean._c_true))
        }
    }
    WI_checkForAccelerate()
    c_switch(state) {
        case(stateenum_t.StatCount) {
            if (int(deathmatch) != 0) {
                WI_updateDeathmatchStats()
            } elif (int(netgame) != 0) {
                WI_updateNetgameStats()
            } else {
                WI_updateStats()
            }
            break
        }
        case(stateenum_t.ShowNextLoc) {
            WI_updateShowNextLoc()
            break
        }
        case(stateenum_t.NoState) {
            WI_updateNoState()
            break
        }
    }
}

