[c_function]
def WI_slamBackground {
    doom_memcpy(reinterpret<void?>(screens[0]), reinterpret<void?>(screens[1]), SCREENWIDTH * SCREENHEIGHT)
    V_MarkRect(0, 0, SCREENWIDTH, SCREENHEIGHT)
}

// The ticker is used to detect keys
// because of timing issues in netgames.
def WI_Responder(var ev : event_t?) : doom_boolean {
    return doom_boolean._c_false
}

// Draws "<Levelname> Finished!"
[c_function]
def WI_drawLF {
    var y : int = WI_TITLEY
    // draw <LevelName>
    V_DrawPatch((SCREENWIDTH - int(read_patch_t_width(lnames[wbs.last], 0))) / 2, y, FB, lnames[wbs.last])
    // draw "Finished!"
    y += (5 * int(read_patch_t_height(lnames[wbs.last], 0))) / 4
    V_DrawPatch((SCREENWIDTH - int(read_patch_t_width(finished, 0))) / 2, y, FB, finished)
}

// Draws "Entering <LevelName>"
[c_function]
def WI_drawEL {
    var y : int = WI_TITLEY
    // draw "Entering"
    V_DrawPatch((SCREENWIDTH - int(read_patch_t_width(entering, 0))) / 2, y, FB, entering)
    // draw level
    y += (5 * int(read_patch_t_height(lnames[wbs.next], 0))) / 4
    V_DrawPatch((SCREENWIDTH - int(read_patch_t_width(lnames[wbs.next], 0))) / 2, y, FB, lnames[wbs.next])
}

[c_function]
def WI_drawOnLnode(n : int; var c : uint8 ??) {
    var i : int
    var left : int
    var top : int
    var right : int
    var bottom : int
    var fits : doom_boolean = doom_boolean._c_false
    i = 0
    c_do_while(int(fits) == 0 && i != 2) {
        left = lnodes[wbs.epsd][n].x - int(read_patch_t_leftoffset(c[i], 0))
        top = lnodes[wbs.epsd][n].y - int(read_patch_t_topoffset(c[i], 0))
        right = left + int(read_patch_t_width(c[i], 0))
        bottom = top + int(read_patch_t_height(c[i], 0))
        if (left >= 0 && right < SCREENWIDTH && top >= 0 && bottom < SCREENHEIGHT) {
            fits = doom_boolean._c_true
        } else {
            i++
        }
    }
    if (uint(fits) != 0 && i < 2) {
        V_DrawPatch(lnodes[wbs.epsd][n].x, lnodes[wbs.epsd][n].y, FB, c[i])
    } else {
        // DEBUG
        // doom_print("Could not place patch on level %d", n + 1);
        invoke(doom_print, cstr("Could not place patch on level "))
        invoke(doom_print, doom_itoa(n + 1, 10))
    }
}

[c_function]
def WI_initAnimatedBack {
    var i : int
    var a : anim_t_wi_stuff?
    if (gamemode == GameMode_t.commercial) {
        return
    }
    if (wbs.epsd > 2) {
        return
    }
    i = 0
    while (i < NUMANIMS[wbs.epsd]) {
        a = addr(anims_wi_stuff[wbs.epsd][i])
        // init variables
        a.ctr = -1
        // specify the next time to draw it
        if (a._c_type == animenum_t.ANIM_ALWAYS) {
            a.nexttic = bcnt + 1 + (M_Random() % a.period)
        } elif (a._c_type == animenum_t.ANIM_RANDOM) {
            a.nexttic = bcnt + 1 + a.data2 + (M_Random() % a.data1)
        } elif (a._c_type == animenum_t.ANIM_LEVEL) {
            a.nexttic = bcnt + 1
        }
        i++
    }
}

[c_function]
def WI_updateAnimatedBack {
    var i : int
    var a : anim_t_wi_stuff?
    if (gamemode == GameMode_t.commercial) {
        return
    }
    if (wbs.epsd > 2) {
        return
    }
    i = 0
    while (i < NUMANIMS[wbs.epsd]) {
        a = addr(anims_wi_stuff[wbs.epsd][i])
        if (bcnt == a.nexttic) {
            c_switch(a._c_type) {
                case(animenum_t.ANIM_ALWAYS) {
                    a.ctr++
                    if (a.ctr >= a.nanims) {
                        a.ctr = 0
                    }
                    a.nexttic = bcnt + a.period
                    break
                }
                case(animenum_t.ANIM_RANDOM) {
                    a.ctr++
                    if (a.ctr == a.nanims) {
                        a.ctr = -1
                        a.nexttic = bcnt + a.data2 + (M_Random() % a.data1)
                    } else {
                        a.nexttic = bcnt + a.period
                    }
                    break
                }
                case(animenum_t.ANIM_LEVEL) {
                    // gawd-awful hack for level anims
                    if (!(state == stateenum_t.StatCount && i == 7) && wbs.next == a.data1) {
                        a.ctr++
                        if (a.ctr == a.nanims) {
                            a.ctr--
                        }
                        a.nexttic = bcnt + a.period
                    }
                    break
                }
            }
        }
        i++
    }
}

[c_function]
def WI_drawAnimatedBack {
    var i : int
    var a : anim_t_wi_stuff?
    if (int(GameMode_t.commercial) != 0) {
        return
    }
    if (wbs.epsd > 2) {
        return
    }
    i = 0
    while (i < NUMANIMS[wbs.epsd]) {
        a = addr(anims_wi_stuff[wbs.epsd][i])
        if (a.ctr >= 0) {
            V_DrawPatch(a.loc.x, a.loc.y, FB, a.p[a.ctr])
        }
        i++
    }
}

// Draws a number.
// If digits > 0, then use that many digits minimum,
// otherwise only use as many as necessary.
// Returns new x position.
def WI_drawNum(var x : int; y : int; var n : int; var digits : int) : int {
    let fontwidth : int = int(read_patch_t_width(num[0], 0))
    var neg : int
    var temp : int
    if (digits < 0) {
        if (n == 0) {
            // make variable-length zeros 1 digit long
            digits = 1
        } else {
            // figure out # of digits in #
            digits = 0
            temp = n
            while (temp != 0) {
                temp /= 10
                digits++
            }
        }
    }
    neg = int_of(n < 0)
    if (neg != 0) {
        n = -n
    }
    // if non-number, do not draw it
    if (n == 1994) {
        return 0
    }
    // draw the new number
    while (true) {
        let _t0 = digits
        digits--
        if (_t0 == 0) {
            break
        }
        x -= fontwidth
        V_DrawPatch(x, y, FB, num[n % 10])
        n /= 10
    }
    // draw a minus sign if necessary
    if (neg != 0) {
        x -= 8
        V_DrawPatch(x, y, FB, wiminus)
    }
    return x
}

def WI_drawPercent(x : int; y : int; p : int) {
    if (p < 0) {
        return
    }
    V_DrawPatch(x, y, FB, percent)
    WI_drawNum(x, y, p, -1)
}

// Display level completion time and par,
// or "sucks" message if overflow.
def WI_drawTime(var x : int; y : int; t : int) {
    var div : int
    var n : int
    if (t < 0) {
        return
    }
    if (t <= 61 * 59) {
        div = 1
        c_do_while(t / div != 0) {
            n = (t / div) % 60
            x = WI_drawNum(x, y, n, 2) - int(read_patch_t_width(colon, 0))
            div *= 60
            // draw
            if (div == 60 || t / div != 0) {
                V_DrawPatch(x, y, FB, colon)
            }
        }
    } else {
        // "sucks"
        V_DrawPatch(x - int(read_patch_t_width(sucks, 0)), y, FB, sucks)
    }
}

def WI_End {
    WI_unloadData()
}

def WI_initNoState {
    state = stateenum_t.NoState
    acceleratestage = 0
    cnt = 10
}

def WI_updateNoState {
    WI_updateAnimatedBack()
    cnt--
    if (cnt == 0) {
        WI_End()
        G_WorldDone()
    }
}

def WI_initShowNextLoc {
    state = stateenum_t.ShowNextLoc
    acceleratestage = 0
    cnt = SHOWNEXTLOCDELAY * TICRATE
    WI_initAnimatedBack()
}

def WI_updateShowNextLoc {
    WI_updateAnimatedBack()
    cnt--
    if (cnt == 0 || acceleratestage != 0) {
        WI_initNoState()
    } else {
        snl_pointeron = enum_from_int(type<doom_boolean>, int_of((cnt & 31) < 20))
    }
}

[c_function]
def WI_drawShowNextLoc {
    var i : int
    var last : int
    WI_slamBackground()
    // draw animated background
    WI_drawAnimatedBack()
    if (gamemode != GameMode_t.commercial) {
        if (wbs.epsd > 2) {
            WI_drawEL()
            return
        }
        last = (wbs.last == 8) ? wbs.next - 1 : wbs.last
        // draw a splat on taken cities.
        i = 0
        while (i <= last) {
            WI_drawOnLnode(i, addr(splat))
            i++
        }
        // splat the secret level?
        if (int(wbs.didsecret) != 0) {
            WI_drawOnLnode(8, addr(splat))
        }
        // draw flashing ptr
        if (int(snl_pointeron) != 0) {
            WI_drawOnLnode(wbs.next, addr(yah[0]))
        }
    }
    // draws which level you are entering..
    if ((gamemode != GameMode_t.commercial) || wbs.next != 30) {
        WI_drawEL()
    }
}

def WI_drawNoState {
    snl_pointeron = doom_boolean._c_true
    WI_drawShowNextLoc()
}

[c_function]
def WI_fragSum(playernum : int) : int {
    var frags : int = 0
    for (i in range(MAXPLAYERS)) {
        if (uint(playeringame[i]) != 0 && i != playernum) {
            frags += plrs[playernum].frags[i]
        }
    }
    // JDC hack - negative frags.
    frags -= plrs[playernum].frags[playernum]
    // UNUSED if (frags < 0)
    // frags = 0;
    return frags
}

def WI_initDeathmatchStats {
    state = stateenum_t.StatCount
    acceleratestage = 0
    dm_state = 1
    cnt_pause = TICRATE
    for (i in range(MAXPLAYERS)) {
        if (int(playeringame[i]) != 0) {
            for (j in range(MAXPLAYERS)) {
                if (int(playeringame[j]) != 0) {
                    dm_frags[i][j] = 0
                }
            }
            dm_totals[i] = 0
        }
    }
    WI_initAnimatedBack()
}

[c_function]
def WI_updateDeathmatchStats {
    var stillticking : doom_boolean
    WI_updateAnimatedBack()
    if (acceleratestage != 0 && dm_state != 4) {
        acceleratestage = 0
        for (i in range(MAXPLAYERS)) {
            if (int(playeringame[i]) != 0) {
                for (j in range(MAXPLAYERS)) {
                    if (int(playeringame[j]) != 0) {
                        dm_frags[i][j] = plrs[i].frags[j]
                    }
                }
                dm_totals[i] = WI_fragSum(i)
            }
        }
        S_StartSound(null, int(sfxenum_t.sfx_barexp))
        dm_state = 4
    }
    if (dm_state == 2) {
        if ((bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = doom_boolean._c_false
        for (i in range(MAXPLAYERS)) {
            if (int(playeringame[i]) != 0) {
                for (j in range(MAXPLAYERS)) {
                    if (uint(playeringame[j]) != 0 && dm_frags[i][j] != plrs[i].frags[j]) {
                        if (plrs[i].frags[j] < 0) {
                            dm_frags[i][j]--
                        } else {
                            dm_frags[i][j]++
                        }
                        if (dm_frags[i][j] > 99) {
                            dm_frags[i][j] = 99
                        }
                        if (dm_frags[i][j] < -99) {
                            dm_frags[i][j] = -99
                        }
                        stillticking = doom_boolean._c_true
                    }
                }
                dm_totals[i] = WI_fragSum(i)
                if (dm_totals[i] > 99) {
                    dm_totals[i] = 99
                }
                if (dm_totals[i] < -99) {
                    dm_totals[i] = -99
                }
            }
        }
        if (int(stillticking) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            dm_state++
        }
    } elif (dm_state == 4) {
        if (acceleratestage != 0) {
            S_StartSound(null, int(sfxenum_t.sfx_slop))
            if (gamemode == GameMode_t.commercial) {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif ((dm_state & 1) != 0) {
        cnt_pause--
        if (cnt_pause == 0) {
            dm_state++
            cnt_pause = TICRATE
        }
    }
}

def WI_drawDeathmatchStats {
    var x : int
    var y : int
    var w : int
    // line height
    var lh : int
    lh = WI_SPACINGY
    WI_slamBackground()
    // draw animated background
    WI_drawAnimatedBack()
    WI_drawLF()
    // draw stat titles (top line)
    V_DrawPatch(DM_TOTALSX - int(read_patch_t_width(total, 0)) / 2, DM_MATRIXY - WI_SPACINGY + 10, FB, total)
    V_DrawPatch(DM_KILLERSX, DM_KILLERSY, FB, killers)
    V_DrawPatch(DM_VICTIMSX, DM_VICTIMSY, FB, victims)
    // draw P?
    x = DM_MATRIXX + DM_SPACINGX
    y = DM_MATRIXY
    for (i in range(MAXPLAYERS)) {
        if (int(playeringame[i]) != 0) {
            V_DrawPatch(x - int(read_patch_t_width(p[i], 0)) / 2, DM_MATRIXY - WI_SPACINGY, FB, p[i])
            V_DrawPatch(DM_MATRIXX - int(read_patch_t_width(p[i], 0)) / 2, y, FB, p[i])
            if (i == me) {
                V_DrawPatch(x - int(read_patch_t_width(p[i], 0)) / 2, DM_MATRIXY - WI_SPACINGY, FB, bstar)
                V_DrawPatch(DM_MATRIXX - int(read_patch_t_width(p[i], 0)) / 2, y, FB, star)
            }
        } else {
        }
        // V_DrawPatch(x-SHORT(bp[i]->width)/2,
        // DM_MATRIXY - WI_SPACINGY, FB, bp[i]);
        // V_DrawPatch(DM_MATRIXX-SHORT(bp[i]->width)/2,
        // y, FB, bp[i]);
        x += DM_SPACINGX
        y += WI_SPACINGY
    }
    // draw stats
    y = DM_MATRIXY + 10
    w = int(read_patch_t_width(num[0], 0))
    for (i in range(MAXPLAYERS)) {
        x = DM_MATRIXX + DM_SPACINGX
        if (int(playeringame[i]) != 0) {
            for (j in range(MAXPLAYERS)) {
                if (int(playeringame[j]) != 0) {
                    WI_drawNum(x + w, y, dm_frags[i][j], 2)
                }
                x += DM_SPACINGX
            }
            WI_drawNum(DM_TOTALSX + w, y, dm_totals[i], 2)
        }
        y += WI_SPACINGY
    }
}

def WI_initNetgameStats {
    state = stateenum_t.StatCount
    acceleratestage = 0
    ng_state = 1
    cnt_pause = TICRATE
    for (i in range(MAXPLAYERS)) {
        if (int(playeringame[i]) == 0) {
            continue
        }
        cnt_frags[i] = 0
        cnt_secret[i] = cnt_frags[i]
        cnt_items[i] = cnt_secret[i]
        cnt_kills[i] = cnt_items[i]
        dofrags += WI_fragSum(i)
    }
    dofrags = int_of(dofrags != 0)
    WI_initAnimatedBack()
}

[c_function]
def WI_updateNetgameStats {
    var fsum : int
    var stillticking : doom_boolean
    WI_updateAnimatedBack()
    if (acceleratestage != 0 && ng_state != 10) {
        acceleratestage = 0
        for (i in range(MAXPLAYERS)) {
            if (int(playeringame[i]) == 0) {
                continue
            }
            cnt_kills[i] = (plrs[i].skills * 100) / wbs.maxkills
            cnt_items[i] = (plrs[i].sitems * 100) / wbs.maxitems
            cnt_secret[i] = (plrs[i].ssecret * 100) / wbs.maxsecret
            if (dofrags != 0) {
                cnt_frags[i] = WI_fragSum(i)
            }
        }
        S_StartSound(null, int(sfxenum_t.sfx_barexp))
        ng_state = 10
    }
    if (ng_state == 2) {
        if ((bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = doom_boolean._c_false
        for (i in range(MAXPLAYERS)) {
            if (int(playeringame[i]) == 0) {
                continue
            }
            cnt_kills[i] += 2
            if (cnt_kills[i] >= (plrs[i].skills * 100) / wbs.maxkills) {
                cnt_kills[i] = (plrs[i].skills * 100) / wbs.maxkills
            } else {
                stillticking = doom_boolean._c_true
            }
        }
        if (int(stillticking) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            ng_state++
        }
    } elif (ng_state == 4) {
        if ((bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = doom_boolean._c_false
        for (i in range(MAXPLAYERS)) {
            if (int(playeringame[i]) == 0) {
                continue
            }
            cnt_items[i] += 2
            if (cnt_items[i] >= (plrs[i].sitems * 100) / wbs.maxitems) {
                cnt_items[i] = (plrs[i].sitems * 100) / wbs.maxitems
            } else {
                stillticking = doom_boolean._c_true
            }
        }
        if (int(stillticking) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            ng_state++
        }
    } elif (ng_state == 6) {
        if ((bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = doom_boolean._c_false
        for (i in range(MAXPLAYERS)) {
            if (int(playeringame[i]) == 0) {
                continue
            }
            cnt_secret[i] += 2
            if (cnt_secret[i] >= (plrs[i].ssecret * 100) / wbs.maxsecret) {
                cnt_secret[i] = (plrs[i].ssecret * 100) / wbs.maxsecret
            } else {
                stillticking = doom_boolean._c_true
            }
        }
        if (int(stillticking) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_barexp))
            ng_state += 1 + 2 * int_of(dofrags == 0)
        }
    } elif (ng_state == 8) {
        if ((bcnt & 3) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pistol))
        }
        stillticking = doom_boolean._c_false
        for (i in range(MAXPLAYERS)) {
            if (int(playeringame[i]) == 0) {
                continue
            }
            cnt_frags[i] += 1
            fsum = WI_fragSum(i)
            if (cnt_frags[i] >= fsum) {
                cnt_frags[i] = fsum
            } else {
                stillticking = doom_boolean._c_true
            }
        }
        if (int(stillticking) == 0) {
            S_StartSound(null, int(sfxenum_t.sfx_pldeth))
            ng_state++
        }
    } elif (ng_state == 10) {
        if (acceleratestage != 0) {
            S_StartSound(null, int(sfxenum_t.sfx_sgcock))
            if (gamemode == GameMode_t.commercial) {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif ((ng_state & 1) != 0) {
        cnt_pause--
        if (cnt_pause == 0) {
            ng_state++
            cnt_pause = TICRATE
        }
    }
}

def WI_drawNetgameStats {
    var x : int
    var y : int
    let pwidth : int = int(read_patch_t_width(percent, 0))
    WI_slamBackground()
