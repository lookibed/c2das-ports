        var _f = false
        while (true) {
            if (_f) {
                mem = mem.next
            }
            _f = true
            if (mem == null) {
                break
            }
            // Anonymous struct member
            if (mem.ty.kind == TypeKind.TY_STRUCT && mem.name == null) {
                if (get_struct_member(mem.ty, tok) != null) {
                    *rest = start
                    return mem
                }
                continue
            }
            // Regular struct member
            if (mem.name.len == tok.len && crt::strncmp(mem.name.loc, tok.loc, uint64(tok.len)) == 0) {
                *rest = tok.next
                return mem
            }
