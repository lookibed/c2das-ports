[c_function]
def private consume_end(var rest : Token ??; var tok : Token?) : bool {
    if (equal(tok, cstr("\}"))) {
        *rest = tok.next
        return 1 != 0
    }
    if (equal(tok, cstr(",")) && equal(tok.next, cstr("\}"))) {
        *rest = tok.next.next
        return 1 != 0
    }
    return 0 != 0
}

