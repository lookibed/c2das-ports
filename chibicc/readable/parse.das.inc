def private write_gvar_data(var cur : Relocation?; var init : Initializer?; var ty : Type?; var buf : uint8?; offset : int) : Relocation? {
    if (ty.kind == TypeKind.TY_ARRAY) {
        let sz : int = ty.base.size
        {
            var i : int = 0
            while (i < ty.array_len) {
                cur = write_gvar_data(cur, init.children[i], ty.base, buf, offset + sz * i)
                i++
            }
        }
        return cur
    }
    if (ty.kind == TypeKind.TY_STRUCT) {
        {
            var mem : Member? = ty.members
            while (mem != null) {
                if (mem.is_bitfield) {
                    var expr : Node? = init.children[mem.idx].expr
                    if (expr == null) {
                        break
                    }
                    var loc : uint8? = buf + offset + mem.offset
                    let oldval : uint64 = read_buf(loc, mem.ty.size)
                    let newval : uint64 = uint64(eval(expr))
                    let mask : uint64 = uint64((1l << int64(mem.bit_width)) - 1l)
                    let combined : uint64 = oldval | ((newval & mask) << uint64(mem.bit_offset))
                    write_buf(loc, combined, mem.ty.size)
                } else {
                    cur = write_gvar_data(cur, init.children[mem.idx], mem.ty, buf, offset + mem.offset)
                }
                mem = mem.next
            }
        }
        return cur
    }
    if (ty.kind == TypeKind.TY_UNION) {
        if (init.mem == null) {
            return cur
        }
        return write_gvar_data(cur, init.children[init.mem.idx], init.mem.ty, buf, offset)
    }
    if (init.expr == null) {
        return cur
    }
    if (ty.kind == TypeKind.TY_FLOAT) {
        *reinterpret<float?>(buf + offset) = float(eval_double(init.expr))
        return cur
    }
    if (ty.kind == TypeKind.TY_DOUBLE) {
        *reinterpret<double?>(buf + offset) = eval_double(init.expr)
        return cur
    }
    var _c_label : uint8 ?? = null
    let val : uint64 = uint64(eval2(init.expr, addr(_c_label)))
    if (_c_label == null) {
        write_buf(buf + offset, val, ty.size)
        return cur
    }
    var rel : Relocation? = reinterpret<Relocation?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<Relocation>))))
    rel.offset = offset
    rel._c_label = _c_label
    rel.addend = int64(val)
    cur.next = rel
    return cur.next
}

// Initializers for global variables are evaluated at compile-time and
// embedded to .data section. This function serializes Initializer
// objects to a flat byte array. It is a compile error if an
// initializer list contains a non-constant expression.
[c_function]
def private gvar_initializer(var rest : Token ??; var tok : Token?; var _c_var : Obj?) {
    var init : Initializer? = initializer(rest, tok, _c_var.ty, addr(_c_var.ty))
    var head : Relocation = Relocation()
    var buf : uint8? = reinterpret<uint8?>(crt::calloc(1ul, uint64(_c_var.ty.size)))
    write_gvar_data(addr(head), init, _c_var.ty, buf, 0)
    _c_var.init_data = buf
    _c_var.rel = head.next
}

// Returns true if a given token represents a type.
[c_function]
def private is_typename(var tok : Token?) : bool {
    if (is_typename_map.capacity == 0) {
        {
            var i : int = 0
            while (uint64(i) < uint64(typeinfo sizeof(type<uint8? [30]>)) / uint64(typeinfo sizeof(type<uint8?>))) {
                hashmap_put(addr(is_typename_map), is_typename_kw[i], reinterpret<void?>(uint64(1)))
                i++
            }
        }
    }
    return hashmap_get2(addr(is_typename_map), tok.loc, tok.len) != null || find_typedef(tok) != null
}

// asm-stmt = "asm" ("volatile" | "inline")* "(" string-literal ")"
[c_function]
def private asm_stmt(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = new_node(NodeKind.ND_ASM, tok)
    tok = tok.next
    while (equal(tok, cstr("volatile")) || equal(tok, cstr("inline"))) {
        tok = tok.next
    }
    tok = skip(tok, cstr("("))
    if (tok.kind != TokenKind.TK_STR || tok.ty.base.kind != TypeKind.TY_CHAR) {
        error_tok`va(tok, cstr("expected string literal"), VaNone())
    }
    node.asm_str = tok.str
    *rest = skip(tok.next, cstr(")"))
    return node
}

// stmt = "return" expr? ";"
// | "if" "(" expr ")" stmt ("else" stmt)?
// | "switch" "(" expr ")" stmt
// | "case" const-expr ("..." const-expr)? ":" stmt
// | "default" ":" stmt
// | "for" "(" expr-stmt expr? ";" expr? ")" stmt
// | "while" "(" expr ")" stmt
// | "do" stmt "while" "(" expr ")" ";"
// | "asm" asm-stmt
// | "goto" (ident | "*" expr) ";"
// | "break" ";"
// | "continue" ";"
// | ident ":" stmt
// | "{" compound-stmt
// | expr-stmt
[c_function]
def private stmt(var rest : Token ??; var tok : Token?) : Node? {
    if (equal(tok, cstr("return"))) {
        var node : Node? = new_node(NodeKind.ND_RETURN, tok)
        if (consume(rest, tok.next, cstr(";"))) {
            return node
        }
        var exp : Node? = expr(addr(tok), tok.next)
        *rest = skip(tok, cstr(";"))
        add_type(exp)
        var ty : Type? = parse_current_fn.ty.return_ty
        if (ty.kind != TypeKind.TY_STRUCT && ty.kind != TypeKind.TY_UNION) {
            exp = new_cast(exp, parse_current_fn.ty.return_ty)
        }
        node.lhs = exp
        return node
    }
    if (equal(tok, cstr("if"))) {
        var node : Node? = new_node(NodeKind.ND_IF, tok)
        tok = skip(tok.next, cstr("("))
        node.cond = expr(addr(tok), tok)
        tok = skip(tok, cstr(")"))
        node.then = stmt(addr(tok), tok)
        if (equal(tok, cstr("else"))) {
            node.els = stmt(addr(tok), tok.next)
        }
        *rest = tok
        return node
    }
    if (equal(tok, cstr("switch"))) {
        var node : Node? = new_node(NodeKind.ND_SWITCH, tok)
        tok = skip(tok.next, cstr("("))
        node.cond = expr(addr(tok), tok)
        tok = skip(tok, cstr(")"))
        var sw : Node? = current_switch
        current_switch = node
        var brk : uint8? = brk_label
        node.brk_label = new_unique_name()
        brk_label = node.brk_label
        node.then = stmt(rest, tok)
        current_switch = sw
        brk_label = brk
        return node
    }
    if (equal(tok, cstr("case"))) {
        if (current_switch == null) {
            error_tok`va(tok, cstr("stray case"), VaNone())
        }
        var node : Node? = new_node(NodeKind.ND_CASE, tok)
        let begin : int = int(const_expr(addr(tok), tok.next))
        var end : int
        if (equal(tok, cstr("..."))) {
            // [GNU] Case ranges, e.g. "case 1 ... 5:"
            end = int(const_expr(addr(tok), tok.next))
            if (end < begin) {
                error_tok`va(tok, cstr("empty case range specified"), VaNone())
            }
        } else {
            end = begin
        }
        tok = skip(tok, cstr(":"))
        node._c_label = new_unique_name()
        node.lhs = stmt(rest, tok)
        node.begin = int64(begin)
        node.end = int64(end)
        node.case_next = current_switch.case_next
        current_switch.case_next = node
        return node
    }
    if (equal(tok, cstr("default"))) {
        if (current_switch == null) {
            error_tok`va(tok, cstr("stray default"), VaNone())
        }
        var node : Node? = new_node(NodeKind.ND_CASE, tok)
        tok = skip(tok.next, cstr(":"))
        node._c_label = new_unique_name()
        node.lhs = stmt(rest, tok)
        current_switch.default_case = node
        return node
    }
    if (equal(tok, cstr("for"))) {
        var node : Node? = new_node(NodeKind.ND_FOR, tok)
        tok = skip(tok.next, cstr("("))
        enter_scope()
        var brk : uint8? = brk_label
        var cont : uint8? = cont_label
        node.brk_label = new_unique_name()
        brk_label = node.brk_label
        node.cont_label = new_unique_name()
        cont_label = node.cont_label
        if (is_typename(tok)) {
            var basety : Type? = declspec(addr(tok), tok, null)
            node.init = declaration(addr(tok), tok, basety, null)
        } else {
            node.init = expr_stmt(addr(tok), tok)
        }
        if (!equal(tok, cstr(";"))) {
            node.cond = expr(addr(tok), tok)
        }
        tok = skip(tok, cstr(";"))
        if (!equal(tok, cstr(")"))) {
            node.inc = expr(addr(tok), tok)
        }
        tok = skip(tok, cstr(")"))
        node.then = stmt(rest, tok)
        leave_scope()
        brk_label = brk
        cont_label = cont
        return node
    }
    if (equal(tok, cstr("while"))) {
        var node : Node? = new_node(NodeKind.ND_FOR, tok)
        tok = skip(tok.next, cstr("("))
        node.cond = expr(addr(tok), tok)
        tok = skip(tok, cstr(")"))
        var brk : uint8? = brk_label
        var cont : uint8? = cont_label
        node.brk_label = new_unique_name()
        brk_label = node.brk_label
        node.cont_label = new_unique_name()
        cont_label = node.cont_label
        node.then = stmt(rest, tok)
        brk_label = brk
        cont_label = cont
        return node
    }
    if (equal(tok, cstr("do"))) {
        var node : Node? = new_node(NodeKind.ND_DO, tok)
        var brk : uint8? = brk_label
        var cont : uint8? = cont_label
        node.brk_label = new_unique_name()
        brk_label = node.brk_label
        node.cont_label = new_unique_name()
        cont_label = node.cont_label
        node.then = stmt(addr(tok), tok.next)
        brk_label = brk
        cont_label = cont
        tok = skip(tok, cstr("while"))
        tok = skip(tok, cstr("("))
        node.cond = expr(addr(tok), tok)
        tok = skip(tok, cstr(")"))
        *rest = skip(tok, cstr(";"))
        return node
    }
    if (equal(tok, cstr("asm"))) {
        return asm_stmt(rest, tok)
    }
    if (equal(tok, cstr("goto"))) {
        if (equal(tok.next, cstr("*"))) {
            // [GNU] `goto *ptr` jumps to the address specified by `ptr`.
            var node : Node? = new_node(NodeKind.ND_GOTO_EXPR, tok)
            node.lhs = expr(addr(tok), tok.next.next)
            *rest = skip(tok, cstr(";"))
            return node
        }
        var node : Node? = new_node(NodeKind.ND_GOTO, tok)
        node._c_label = get_ident(tok.next)
        node.goto_next = gotos
        gotos = node
        *rest = skip(tok.next.next, cstr(";"))
        return node
    }
    if (equal(tok, cstr("break"))) {
        if (brk_label == null) {
            error_tok`va(tok, cstr("stray break"), VaNone())
        }
        var node : Node? = new_node(NodeKind.ND_GOTO, tok)
        node.unique_label = brk_label
        *rest = skip(tok.next, cstr(";"))
        return node
    }
    if (equal(tok, cstr("continue"))) {
        if (cont_label == null) {
            error_tok`va(tok, cstr("stray continue"), VaNone())
        }
        var node : Node? = new_node(NodeKind.ND_GOTO, tok)
        node.unique_label = cont_label
        *rest = skip(tok.next, cstr(";"))
        return node
    }
    if (tok.kind == TokenKind.TK_IDENT && equal(tok.next, cstr(":"))) {
        var node : Node? = new_node(NodeKind.ND_LABEL, tok)
        node._c_label = host_strndup(tok.loc, uint64(tok.len))
        node.unique_label = new_unique_name()
        node.lhs = stmt(rest, tok.next.next)
        node.goto_next = labels
        labels = node
        return node
    }
    if (equal(tok, cstr("\{"))) {
        return compound_stmt(rest, tok.next)
    }
    return expr_stmt(rest, tok)
}

// compound-stmt = (typedef | declaration | stmt)* "}"
[c_function]
def private compound_stmt(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = new_node(NodeKind.ND_BLOCK, tok)
    var head : Node = Node()
    var cur : Node? = addr(head)
    enter_scope()
    while (!equal(tok, cstr("\}"))) {
        if (is_typename(tok) && !equal(tok.next, cstr(":"))) {
            var attr : VarAttr = VarAttr()
            var basety : Type? = declspec(addr(tok), tok, addr(attr))
            if (attr.is_typedef) {
                tok = parse_typedef(tok, basety)
                continue
            }
            if (is_function(tok)) {
                tok = _c_function(tok, basety, addr(attr))
                continue
            }
            if (attr.is_extern) {
                tok = global_variable(tok, basety, addr(attr))
                continue
            }
            cur.next = declaration(addr(tok), tok, basety, addr(attr))
            cur = cur.next
        } else {
            cur.next = stmt(addr(tok), tok)
            cur = cur.next
        }
        add_type(cur)
    }
    leave_scope()
    node.body = head.next
    *rest = tok.next
    return node
}

// expr-stmt = expr? ";"
[c_function]
def private expr_stmt(var rest : Token ??; var tok : Token?) : Node? {
    if (equal(tok, cstr(";"))) {
        *rest = tok.next
        return new_node(NodeKind.ND_BLOCK, tok)
    }
    var node : Node? = new_node(NodeKind.ND_EXPR_STMT, tok)
    node.lhs = expr(addr(tok), tok)
    *rest = skip(tok, cstr(";"))
    return node
}

// expr = assign ("," expr)?
[c_function]
def private expr(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = assign(addr(tok), tok)
    if (equal(tok, cstr(","))) {
        return new_binary(NodeKind.ND_COMMA, node, expr(rest, tok.next), tok)
    }
    *rest = tok
    return node
}

def private eval(var node : Node?) : int64 {
    return eval2(node, null)
}

// Evaluate a given node as a constant expression.
// A constant expression is either just a number or ptr+n where ptr
// is a pointer to a global variable and n is a postiive/negative
// number. The latter form is accepted only as an initialization
// expression for a global variable.
[c_function]
def private eval2(var node : Node?; var _c_label : uint8 ?? ?) : int64 {
    add_type(node)
    if (is_flonum(node.ty)) {
        return int64(eval_double(node))
    }
    c_switch(node.kind) {
        case(NodeKind.ND_ADD) {
            return eval2(node.lhs, _c_label) + eval(node.rhs)
        }
        case(NodeKind.ND_SUB) {
            return eval2(node.lhs, _c_label) - eval(node.rhs)
        }
        case(NodeKind.ND_MUL) {
            return eval(node.lhs) * eval(node.rhs)
        }
        case(NodeKind.ND_DIV) {
            if (node.ty.is_unsigned) {
                return int64(uint64(eval(node.lhs)) / uint64(eval(node.rhs)))
            }
            return eval(node.lhs) / eval(node.rhs)
        }
        case(NodeKind.ND_NEG) {
            return -eval(node.lhs)
        }
        case(NodeKind.ND_MOD) {
            if (node.ty.is_unsigned) {
                return int64(uint64(eval(node.lhs)) % uint64(eval(node.rhs)))
            }
            return eval(node.lhs) % eval(node.rhs)
        }
        case(NodeKind.ND_BITAND) {
            return eval(node.lhs) & eval(node.rhs)
        }
        case(NodeKind.ND_BITOR) {
            return eval(node.lhs) | eval(node.rhs)
        }
        case(NodeKind.ND_BITXOR) {
            return eval(node.lhs) ^ eval(node.rhs)
        }
        case(NodeKind.ND_SHL) {
            return eval(node.lhs) << eval(node.rhs)
        }
        case(NodeKind.ND_SHR) {
            if (node.ty.is_unsigned && node.ty.size == 8) {
                return int64(uint64(eval(node.lhs)) >> uint64(eval(node.rhs)))
            }
            return eval(node.lhs) >> eval(node.rhs)
        }
        case(NodeKind.ND_EQ) {
            return int64(int_of(eval(node.lhs) == eval(node.rhs)))
        }
        case(NodeKind.ND_NE) {
            return int64(int_of(eval(node.lhs) != eval(node.rhs)))
        }
        case(NodeKind.ND_LT) {
            if (node.lhs.ty.is_unsigned) {
                return int64(int_of(uint64(eval(node.lhs)) < uint64(eval(node.rhs))))
            }
            return int64(int_of(eval(node.lhs) < eval(node.rhs)))
        }
        case(NodeKind.ND_LE) {
            if (node.lhs.ty.is_unsigned) {
                return int64(int_of(uint64(eval(node.lhs)) <= uint64(eval(node.rhs))))
            }
            return int64(int_of(eval(node.lhs) <= eval(node.rhs)))
        }
        case(NodeKind.ND_COND) {
            return eval(node.cond) != 0 ? eval2(node.then, _c_label) : eval2(node.els, _c_label)
        }
        case(NodeKind.ND_COMMA) {
            return eval2(node.rhs, _c_label)
        }
        case(NodeKind.ND_NOT) {
            return int64(int_of(eval(node.lhs) == 0))
        }
        case(NodeKind.ND_BITNOT) {
            return ~eval(node.lhs)
        }
        case(NodeKind.ND_LOGAND) {
            return int64(int_of(eval(node.lhs) != 0 && eval(node.rhs) != 0))
        }
        case(NodeKind.ND_LOGOR) {
            return int64(int_of(eval(node.lhs) != 0 || eval(node.rhs) != 0))
        }
        case(NodeKind.ND_CAST) {
            {
                let val : int64 = eval2(node.lhs, _c_label)
                if (is_integer(node.ty)) {
                    c_switch(node.ty.size) {
                        case(1) {
                            return int64(node.ty.is_unsigned ? int(uint8(val)) : int(int8(val)))
                        }
                        case(2) {
                            return int64(node.ty.is_unsigned ? int(uint16(val)) : int(int16(val)))
                        }
                        case(4) {
                            return int64(node.ty.is_unsigned ? uint(val) : uint(int(val)))
                        }
                    }
                }
                return val
            }
        }
        case(NodeKind.ND_ADDR) {
            return eval_rval(node.lhs, _c_label)
        }
        case(NodeKind.ND_LABEL_VAL) {
            *_c_label = addr(node.unique_label)
            return 0l
        }
        case(NodeKind.ND_MEMBER) {
            if (_c_label == null) {
                error_tok`va(node.tok, cstr("not a compile-time constant"), VaNone())
            }
            if (node.ty.kind != TypeKind.TY_ARRAY) {
                error_tok`va(node.tok, cstr("invalid initializer"), VaNone())
            }
            return eval_rval(node.lhs, _c_label) + int64(node.member.offset)
        }
        case(NodeKind.ND_VAR) {
            if (_c_label == null) {
                error_tok`va(node.tok, cstr("not a compile-time constant"), VaNone())
            }
            if (node._c_var.ty.kind != TypeKind.TY_ARRAY && node._c_var.ty.kind != TypeKind.TY_FUNC) {
                error_tok`va(node.tok, cstr("invalid initializer"), VaNone())
            }
            *_c_label = addr(node._c_var.name)
            return 0l
        }
        case(NodeKind.ND_NUM) {
            return node.val
        }
    }
    error_tok`va(node.tok, cstr("not a compile-time constant"), VaNone())
    return int64(0)
}

[c_function]
def private eval_rval(var node : Node?; var _c_label : uint8 ?? ?) : int64 {
    c_switch(node.kind) {
        case(NodeKind.ND_VAR) {
            if (node._c_var.is_local) {
                error_tok`va(node.tok, cstr("not a compile-time constant"), VaNone())
            }
            *_c_label = addr(node._c_var.name)
            return 0l
        }
        case(NodeKind.ND_DEREF) {
            return eval2(node.lhs, _c_label)
        }
        case(NodeKind.ND_MEMBER) {
            return eval_rval(node.lhs, _c_label) + int64(node.member.offset)
        }
    }
    error_tok`va(node.tok, cstr("invalid initializer"), VaNone())
    return int64(0)
}

def private is_const_expr(var node : Node?) : bool {
    add_type(node)
    c_switch(node.kind) {
        case(NodeKind.ND_ADD, NodeKind.ND_SUB, NodeKind.ND_MUL, NodeKind.ND_DIV, NodeKind.ND_BITAND, NodeKind.ND_BITOR, NodeKind.ND_BITXOR, NodeKind.ND_SHL, NodeKind.ND_SHR, NodeKind.ND_EQ, NodeKind.ND_NE, NodeKind.ND_LT, NodeKind.ND_LE, NodeKind.ND_LOGAND, NodeKind.ND_LOGOR) {
            return is_const_expr(node.lhs) && is_const_expr(node.rhs)
        }
        case(NodeKind.ND_COND) {
            if (!is_const_expr(node.cond)) {
                return 0 != 0
            }
            return is_const_expr(eval(node.cond) != 0 ? node.then : node.els)
        }
        case(NodeKind.ND_COMMA) {
            return is_const_expr(node.rhs)
        }
        case(NodeKind.ND_NEG, NodeKind.ND_NOT, NodeKind.ND_BITNOT, NodeKind.ND_CAST) {
            return is_const_expr(node.lhs)
        }
        case(NodeKind.ND_NUM) {
            return 1 != 0
        }
    }
    return 0 != 0
}

def const_expr(var rest : Token ??; var tok : Token?) : int64 {
    var node : Node? = conditional(rest, tok)
    return eval(node)
}

def private eval_double(var node : Node?) : double {
    add_type(node)
    if (is_integer(node.ty)) {
        if (node.ty.is_unsigned) {
            return double(uint64(eval(node)))
        }
        return double(eval(node))
    }
    c_switch(node.kind) {
        case(NodeKind.ND_ADD) {
            return eval_double(node.lhs) + eval_double(node.rhs)
        }
        case(NodeKind.ND_SUB) {
            return eval_double(node.lhs) - eval_double(node.rhs)
        }
        case(NodeKind.ND_MUL) {
            return eval_double(node.lhs) * eval_double(node.rhs)
        }
        case(NodeKind.ND_DIV) {
            return eval_double(node.lhs) / eval_double(node.rhs)
        }
        case(NodeKind.ND_NEG) {
            return -eval_double(node.lhs)
        }
        case(NodeKind.ND_COND) {
            return eval_double(node.cond) != 0.0lf ? eval_double(node.then) : eval_double(node.els)
        }
        case(NodeKind.ND_COMMA) {
            return eval_double(node.rhs)
        }
        case(NodeKind.ND_CAST) {
            if (is_flonum(node.lhs.ty)) {
                return eval_double(node.lhs)
            }
            return double(eval(node.lhs))
        }
        case(NodeKind.ND_NUM) {
            return node.fval
        }
    }
    error_tok`va(node.tok, cstr("not a compile-time constant"), VaNone())
    return 0.0lf
}

// Convert op= operators to expressions containing an assignment.
// In general, `A op= C` is converted to ``tmp = &A, *tmp = *tmp op B`.
// However, if a given expression is of form `A.x op= C`, the input is
// converted to `tmp = &A, (*tmp).x = (*tmp).x op C` to handle assignments
// to bitfields.
[c_function]
def private to_assign(var binary : Node?) : Node? {
    add_type(binary.lhs)
    add_type(binary.rhs)
    var tok : Token? = binary.tok
    // Convert `A.x op= C` to `tmp = &A, (*tmp).x = (*tmp).x op C`.
    if (binary.lhs.kind == NodeKind.ND_MEMBER) {
        var _c_var : Obj? = new_lvar(addr(c2das_empty[0]), pointer_to(binary.lhs.lhs.ty))
        var expr1 : Node? = new_binary(NodeKind.ND_ASSIGN, new_var_node(_c_var, tok), new_unary(NodeKind.ND_ADDR, binary.lhs.lhs, tok), tok)
        var expr2 : Node? = new_unary(NodeKind.ND_MEMBER, new_unary(NodeKind.ND_DEREF, new_var_node(_c_var, tok), tok), tok)
        expr2.member = binary.lhs.member
        var expr3 : Node? = new_unary(NodeKind.ND_MEMBER, new_unary(NodeKind.ND_DEREF, new_var_node(_c_var, tok), tok), tok)
        expr3.member = binary.lhs.member
        var expr4 : Node? = new_binary(NodeKind.ND_ASSIGN, expr2, new_binary(binary.kind, expr3, binary.rhs, tok), tok)
        return new_binary(NodeKind.ND_COMMA, expr1, expr4, tok)
    }
    // If A is an atomic type, Convert `A op= B` to
    // ({
    // T1 *addr = &A; T2 val = (B); T1 old = *addr; T1 new;
    // do {
    // new = old op val;
    // } while (!atomic_compare_exchange_strong(addr, &old, new));
    // new;
    // })
    if (binary.lhs.ty.is_atomic) {
        var head : Node = Node()
        var cur : Node? = addr(head)
        var _c_addr : Obj? = new_lvar(addr(c2das_empty[0]), pointer_to(binary.lhs.ty))
        var val : Obj? = new_lvar(addr(c2das_empty[0]), binary.rhs.ty)
        var old : Obj? = new_lvar(addr(c2das_empty[0]), binary.lhs.ty)
        var _c_new : Obj? = new_lvar(addr(c2das_empty[0]), binary.lhs.ty)
        cur.next = new_unary(NodeKind.ND_EXPR_STMT,
                new_binary(NodeKind.ND_ASSIGN, new_var_node(_c_addr, tok), new_unary(NodeKind.ND_ADDR, binary.lhs, tok), tok), tok)
        cur = cur.next
        cur.next = new_unary(NodeKind.ND_EXPR_STMT, new_binary(NodeKind.ND_ASSIGN, new_var_node(val, tok), binary.rhs, tok), tok)
        cur = cur.next
        cur.next = new_unary(NodeKind.ND_EXPR_STMT,
                new_binary(NodeKind.ND_ASSIGN, new_var_node(old, tok), new_unary(NodeKind.ND_DEREF, new_var_node(_c_addr, tok), tok), tok), tok)
        cur = cur.next
        var loop : Node? = new_node(NodeKind.ND_DO, tok)
        loop.brk_label = new_unique_name()
        loop.cont_label = new_unique_name()
        var body : Node? = new_binary(NodeKind.ND_ASSIGN, new_var_node(_c_new, tok),
                new_binary(binary.kind, new_var_node(old, tok), new_var_node(val, tok), tok), tok)
        loop.then = new_node(NodeKind.ND_BLOCK, tok)
        loop.then.body = new_unary(NodeKind.ND_EXPR_STMT, body, tok)
        var cas : Node? = new_node(NodeKind.ND_CAS, tok)
        cas.cas_addr = new_var_node(_c_addr, tok)
        cas.cas_old = new_unary(NodeKind.ND_ADDR, new_var_node(old, tok), tok)
        cas.cas_new = new_var_node(_c_new, tok)
        loop.cond = new_unary(NodeKind.ND_NOT, cas, tok)
        cur.next = loop
        cur = cur.next
        cur.next = new_unary(NodeKind.ND_EXPR_STMT, new_var_node(_c_new, tok), tok)
        cur = cur.next
        var node : Node? = new_node(NodeKind.ND_STMT_EXPR, tok)
        node.body = head.next
        return node
    }
    // Convert `A op= B` to ``tmp = &A, *tmp = *tmp op B`.
    var _c_var : Obj? = new_lvar(addr(c2das_empty[0]), pointer_to(binary.lhs.ty))
    var expr1 : Node? = new_binary(NodeKind.ND_ASSIGN, new_var_node(_c_var, tok), new_unary(NodeKind.ND_ADDR, binary.lhs, tok), tok)
    var expr2 : Node? = new_binary(NodeKind.ND_ASSIGN, new_unary(NodeKind.ND_DEREF, new_var_node(_c_var, tok), tok),
            new_binary(binary.kind, new_unary(NodeKind.ND_DEREF, new_var_node(_c_var, tok), tok), binary.rhs, tok), tok)
    return new_binary(NodeKind.ND_COMMA, expr1, expr2, tok)
}

// assign = conditional (assign-op assign)?
// assign-op = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^="
// | "<<=" | ">>="
[c_function]
def private assign(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = conditional(addr(tok), tok)
    if (equal(tok, cstr("="))) {
        return new_binary(NodeKind.ND_ASSIGN, node, assign(rest, tok.next), tok)
    }
    if (equal(tok, cstr("+="))) {
        return to_assign(new_add(node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("-="))) {
        return to_assign(new_sub(node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("*="))) {
        return to_assign(new_binary(NodeKind.ND_MUL, node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("/="))) {
        return to_assign(new_binary(NodeKind.ND_DIV, node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("%="))) {
        return to_assign(new_binary(NodeKind.ND_MOD, node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("&="))) {
        return to_assign(new_binary(NodeKind.ND_BITAND, node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("|="))) {
        return to_assign(new_binary(NodeKind.ND_BITOR, node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("^="))) {
        return to_assign(new_binary(NodeKind.ND_BITXOR, node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr("<<="))) {
        return to_assign(new_binary(NodeKind.ND_SHL, node, assign(rest, tok.next), tok))
    }
    if (equal(tok, cstr(">>="))) {
        return to_assign(new_binary(NodeKind.ND_SHR, node, assign(rest, tok.next), tok))
    }
    *rest = tok
    return node
}

// conditional = logor ("?" expr? ":" conditional)?
[c_function]
def private conditional(var rest : Token ??; var tok : Token?) : Node? {
    var cond : Node? = logor(addr(tok), tok)
    if (!equal(tok, cstr("?"))) {
        *rest = tok
        return cond
    }
    if (equal(tok.next, cstr(":"))) {
        // [GNU] Compile `a ?: b` as `tmp = a, tmp ? tmp : b`.
        add_type(cond)
        var _c_var : Obj? = new_lvar(addr(c2das_empty[0]), cond.ty)
        var lhs : Node? = new_binary(NodeKind.ND_ASSIGN, new_var_node(_c_var, tok), cond, tok)
        var rhs : Node? = new_node(NodeKind.ND_COND, tok)
        rhs.cond = new_var_node(_c_var, tok)
        rhs.then = new_var_node(_c_var, tok)
        rhs.els = conditional(rest, tok.next.next)
        return new_binary(NodeKind.ND_COMMA, lhs, rhs, tok)
    }
    var node : Node? = new_node(NodeKind.ND_COND, tok)
    node.cond = cond
    node.then = expr(addr(tok), tok.next)
    tok = skip(tok, cstr(":"))
    node.els = conditional(rest, tok)
    return node
}

// logor = logand ("||" logand)
[c_function]
def private logor(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = logand(addr(tok), tok)
    while (equal(tok, cstr("||"))) {
        var start : Token? = tok
        node = new_binary(NodeKind.ND_LOGOR, node, logand(addr(tok), tok.next), start)
    }
    *rest = tok
    return node
}

// logand = bitor ("&&" bitor)
[c_function]
def private logand(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = bitor(addr(tok), tok)
    while (equal(tok, cstr("&&"))) {
        var start : Token? = tok
        node = new_binary(NodeKind.ND_LOGAND, node, bitor(addr(tok), tok.next), start)
    }
    *rest = tok
    return node
}

// bitor = bitxor ("|" bitxor)
[c_function]
def private bitor(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = bitxor(addr(tok), tok)
    while (equal(tok, cstr("|"))) {
        var start : Token? = tok
        node = new_binary(NodeKind.ND_BITOR, node, bitxor(addr(tok), tok.next), start)
