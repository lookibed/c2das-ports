def private array_designator(var rest : Token ??; var tok : Token?; var ty : Type?; var begin : int?; var end : int?) {
    *begin = int(const_expr(addr(tok), tok.next))
    if (*begin >= ty.array_len) {
        error_tok`va(tok, cstr("array designator index exceeds array bounds"), VaNone())
    }
    if (equal(tok, cstr("..."))) {
        *end = int(const_expr(addr(tok), tok.next))
        if (*end >= ty.array_len) {
            error_tok`va(tok, cstr("array designator index exceeds array bounds"), VaNone())
        }
        if (*end < *begin) {
            error_tok`va(tok, cstr("array designator range [%d, %d] is empty"), (*begin, *end))
        }
    } else {
        *end = *begin
    }
    *rest = skip(tok, cstr("]"))
}

