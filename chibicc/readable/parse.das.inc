// func-params = ("void" | param ("," param)* ("," "...")?)? ")"
// param = declspec declarator
[c_function]
def private func_params(var rest : Token ??; var tok : Token?; var ty : Type?) : Type? {
    if (equal(tok, cstr("void")) && equal(tok.next, cstr(")"))) {
        *rest = tok.next.next
        return func_type(ty)
    }
    var head : Type = Type()
    var cur : Type? = addr(head)
    var is_variadic : bool = 0 != 0
    while (!equal(tok, cstr(")"))) {
        if (cur != addr(head)) {
            tok = skip(tok, cstr(","))
        }
        if (equal(tok, cstr("..."))) {
            is_variadic = 1 != 0
            tok = tok.next
            skip(tok, cstr(")"))
            break
        }
        var ty2 : Type? = declspec(addr(tok), tok, null)
        ty2 = declarator(addr(tok), tok, ty2)
        var name : Token? = ty2.name
        if (ty2.kind == TypeKind.TY_ARRAY) {
            // "array of T" is converted to "pointer to T" only in the parameter
            // context. For example, *argv[] is converted to **argv by this.
            ty2 = pointer_to(ty2.base)
            ty2.name = name
        } elif (ty2.kind == TypeKind.TY_FUNC) {
            // Likewise, a function is converted to a pointer to a function
            // only in the parameter context.
            ty2 = pointer_to(ty2)
            ty2.name = name
        }
        cur.next = copy_type(ty2)
        cur = cur.next
    }
    if (cur == addr(head)) {
        is_variadic = 1 != 0
    }
    ty = func_type(ty)
    ty.params = head.next
    ty.is_variadic = is_variadic
    *rest = tok.next
    return ty
}

