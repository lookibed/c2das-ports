// bitand = equality ("&" equality)
[c_function]
def private bitand(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = equality(addr(tok), tok)
    while (equal(tok, cstr("&"))) {
        var start : Token? = tok
        node = new_binary(NodeKind.ND_BITAND, node, equality(addr(tok), tok.next), start)
