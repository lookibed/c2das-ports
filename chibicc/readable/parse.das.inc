}

// equality = relational ("==" relational | "!=" relational)
[c_function]
def private equality(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = relational(addr(tok), tok)
    while (true) {
        var start : Token? = tok
        if (equal(tok, cstr("=="))) {
            node = new_binary(NodeKind.ND_EQ, node, relational(addr(tok), tok.next), start)
            continue
        }
        if (equal(tok, cstr("!="))) {
            node = new_binary(NodeKind.ND_NE, node, relational(addr(tok), tok.next), start)
            continue
        }
        *rest = tok
        return node
    }
}

// relational = shift ("<" shift | "<=" shift | ">" shift | ">=" shift)
[c_function]
def private relational(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = shift(addr(tok), tok)
    while (true) {
        var start : Token? = tok
        if (equal(tok, cstr("<"))) {
            node = new_binary(NodeKind.ND_LT, node, shift(addr(tok), tok.next), start)
            continue
        }
        if (equal(tok, cstr("<="))) {
            node = new_binary(NodeKind.ND_LE, node, shift(addr(tok), tok.next), start)
            continue
        }
        if (equal(tok, cstr(">"))) {
            node = new_binary(NodeKind.ND_LT, shift(addr(tok), tok.next), node, start)
            continue
        }
        if (equal(tok, cstr(">="))) {
            node = new_binary(NodeKind.ND_LE, shift(addr(tok), tok.next), node, start)
            continue
        }
        *rest = tok
        return node
    }
}

// shift = add ("<<" add | ">>" add)
[c_function]
def private shift(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = add(addr(tok), tok)
    while (true) {
        var start : Token? = tok
        if (equal(tok, cstr("<<"))) {
            node = new_binary(NodeKind.ND_SHL, node, add(addr(tok), tok.next), start)
            continue
        }
        if (equal(tok, cstr(">>"))) {
            node = new_binary(NodeKind.ND_SHR, node, add(addr(tok), tok.next), start)
            continue
        }
        *rest = tok
        return node
    }
}

// In C, `+` operator is overloaded to perform the pointer arithmetic.
// If p is a pointer, p+n adds not n but sizeof(*p)*n to the value of p,
// so that p+n points to the location n elements (not bytes) ahead of p.
// In other words, we need to scale an integer value before adding to a
// pointer value. This function takes care of the scaling.
def private new_add(var lhs : Node?; var rhs : Node?; var tok : Token?) : Node? {
    add_type(lhs)
    add_type(rhs)
    // num + num
    if (is_numeric(lhs.ty) && is_numeric(rhs.ty)) {
        return new_binary(NodeKind.ND_ADD, lhs, rhs, tok)
    }
    if (lhs.ty.base != null && rhs.ty.base != null) {
        error_tok`va(tok, cstr("invalid operands"), VaNone())
    }
    // Canonicalize `num + ptr` to `ptr + num`.
    if (lhs.ty.base == null && rhs.ty.base != null) {
        var tmp : Node? = lhs
        lhs = rhs
        rhs = tmp
    }
    // VLA + num
    if (lhs.ty.base.kind == TypeKind.TY_VLA) {
        rhs = new_binary(NodeKind.ND_MUL, rhs, new_var_node(lhs.ty.base.vla_size, tok), tok)
        return new_binary(NodeKind.ND_ADD, lhs, rhs, tok)
    }
    // ptr + num
    rhs = new_binary(NodeKind.ND_MUL, rhs, new_long(int64(lhs.ty.base.size), tok), tok)
    return new_binary(NodeKind.ND_ADD, lhs, rhs, tok)
}

// Like `+`, `-` is overloaded for the pointer type.
def private new_sub(var lhs : Node?; var rhs : Node?; var tok : Token?) : Node? {
    add_type(lhs)
    add_type(rhs)
    // num - num
    if (is_numeric(lhs.ty) && is_numeric(rhs.ty)) {
        return new_binary(NodeKind.ND_SUB, lhs, rhs, tok)
    }
    // VLA + num
    if (lhs.ty.base.kind == TypeKind.TY_VLA) {
        rhs = new_binary(NodeKind.ND_MUL, rhs, new_var_node(lhs.ty.base.vla_size, tok), tok)
        add_type(rhs)
        var node : Node? = new_binary(NodeKind.ND_SUB, lhs, rhs, tok)
        node.ty = lhs.ty
        return node
    }
    // ptr - num
    if (lhs.ty.base != null && is_integer(rhs.ty)) {
        rhs = new_binary(NodeKind.ND_MUL, rhs, new_long(int64(lhs.ty.base.size), tok), tok)
        add_type(rhs)
        var node : Node? = new_binary(NodeKind.ND_SUB, lhs, rhs, tok)
        node.ty = lhs.ty
        return node
    }
    // ptr - ptr, which returns how many elements are between the two.
    if (lhs.ty.base != null && rhs.ty.base != null) {
        var node : Node? = new_binary(NodeKind.ND_SUB, lhs, rhs, tok)
        node.ty = ty_long
        return new_binary(NodeKind.ND_DIV, node, new_num(int64(lhs.ty.base.size), tok), tok)
    }
    error_tok`va(tok, cstr("invalid operands"), VaNone())
    return null
}

// add = mul ("+" mul | "-" mul)
[c_function]
def private add(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = mul(addr(tok), tok)
    while (true) {
        var start : Token? = tok
        if (equal(tok, cstr("+"))) {
            node = new_add(node, mul(addr(tok), tok.next), start)
            continue
        }
        if (equal(tok, cstr("-"))) {
            node = new_sub(node, mul(addr(tok), tok.next), start)
            continue
        }
        *rest = tok
        return node
    }
}

// mul = cast ("*" cast | "/" cast | "%" cast)
[c_function]
def private mul(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = parse_cast(addr(tok), tok)
    while (true) {
        var start : Token? = tok
        if (equal(tok, cstr("*"))) {
            node = new_binary(NodeKind.ND_MUL, node, parse_cast(addr(tok), tok.next), start)
            continue
        }
        if (equal(tok, cstr("/"))) {
            node = new_binary(NodeKind.ND_DIV, node, parse_cast(addr(tok), tok.next), start)
            continue
        }
        if (equal(tok, cstr("%"))) {
            node = new_binary(NodeKind.ND_MOD, node, parse_cast(addr(tok), tok.next), start)
            continue
        }
        *rest = tok
        return node
    }
}

// cast = "(" type-name ")" cast | unary
[c_function]
def private parse_cast(var rest : Token ??; var tok : Token?) : Node? {
    if (equal(tok, cstr("(")) && is_typename(tok.next)) {
        var start : Token? = tok
        var ty : Type? = _c_typename(addr(tok), tok.next)
        tok = skip(tok, cstr(")"))
        // compound literal
        if (equal(tok, cstr("\{"))) {
            return unary(rest, start)
        }
        // type cast
        var node : Node? = new_cast(parse_cast(rest, tok), ty)
        node.tok = start
        return node
    }
    return unary(rest, tok)
}

// unary = ("+" | "-" | "*" | "&" | "!" | "~") cast
// | ("++" | "--") unary
// | "&&" ident
// | postfix
[c_function]
def private unary(var rest : Token ??; var tok : Token?) : Node? {
    if (equal(tok, cstr("+"))) {
        return parse_cast(rest, tok.next)
    }
    if (equal(tok, cstr("-"))) {
        return new_unary(NodeKind.ND_NEG, parse_cast(rest, tok.next), tok)
    }
    if (equal(tok, cstr("&"))) {
        var lhs : Node? = parse_cast(rest, tok.next)
        add_type(lhs)
        if (lhs.kind == NodeKind.ND_MEMBER && lhs.member.is_bitfield) {
            error_tok`va(tok, cstr("cannot take address of bitfield"), VaNone())
        }
        return new_unary(NodeKind.ND_ADDR, lhs, tok)
    }
    if (equal(tok, cstr("*"))) {
        // [https://www.sigbus.info/n1570#6.5.3.2p4] This is an oddity
        // in the C spec, but dereferencing a function shouldn't do
        // anything. If foo is a function, `*foo`, `**foo` or `*****foo`
        // are all equivalent to just `foo`.
        var node : Node? = parse_cast(rest, tok.next)
        add_type(node)
        if (node.ty.kind == TypeKind.TY_FUNC) {
            return node
        }
        return new_unary(NodeKind.ND_DEREF, node, tok)
    }
    if (equal(tok, cstr("!"))) {
        return new_unary(NodeKind.ND_NOT, parse_cast(rest, tok.next), tok)
    }
    if (equal(tok, cstr("~"))) {
        return new_unary(NodeKind.ND_BITNOT, parse_cast(rest, tok.next), tok)
    }
    // Read ++i as i+=1
    if (equal(tok, cstr("++"))) {
        return to_assign(new_add(unary(rest, tok.next), new_num(1l, tok), tok))
    }
    // Read --i as i-=1
    if (equal(tok, cstr("--"))) {
        return to_assign(new_sub(unary(rest, tok.next), new_num(1l, tok), tok))
    }
    // [GNU] labels-as-values
    if (equal(tok, cstr("&&"))) {
        var node : Node? = new_node(NodeKind.ND_LABEL_VAL, tok)
        node._c_label = get_ident(tok.next)
        node.goto_next = gotos
        gotos = node
        *rest = tok.next.next
        return node
    }
    return postfix(rest, tok)
}

// struct-members = (declspec declarator ("," declarator)* ";")
[c_function]
def private struct_members(var rest : Token ??; var tok : Token?; var ty : Type?) {
    var head : Member = Member()
    var cur : Member? = addr(head)
    var idx : int = 0
    while (!equal(tok, cstr("\}"))) {
        var attr : VarAttr = VarAttr()
        var basety : Type? = declspec(addr(tok), tok, addr(attr))
        var first : bool = 1 != 0
        // Anonymous struct member
        if ((basety.kind == TypeKind.TY_STRUCT || basety.kind == TypeKind.TY_UNION) && consume(addr(tok), tok, cstr(";"))) {
            var mem : Member? = reinterpret<Member?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<Member>))))
            mem.ty = basety
            let _t0 = idx
            idx++
            mem.idx = _t0
            mem.align = attr.align != 0 ? attr.align : mem.ty.align
            cur.next = mem
            cur = cur.next
            continue
        }
        // Regular struct members
        while (!consume(addr(tok), tok, cstr(";"))) {
            if (!first) {
                tok = skip(tok, cstr(","))
            }
            first = 0 != 0
            var mem : Member? = reinterpret<Member?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<Member>))))
            mem.ty = declarator(addr(tok), tok, basety)
            mem.name = mem.ty.name
            let _t1 = idx
            idx++
            mem.idx = _t1
            mem.align = attr.align != 0 ? attr.align : mem.ty.align
            if (consume(addr(tok), tok, cstr(":"))) {
                mem.is_bitfield = 1 != 0
                mem.bit_width = int(const_expr(addr(tok), tok))
            }
            cur.next = mem
            cur = cur.next
        }
    }
    // If the last element is an array of incomplete type, it's
    // called a "flexible array member". It should behave as if
    // if were a zero-sized array.
    if (cur != addr(head) && cur.ty.kind == TypeKind.TY_ARRAY && cur.ty.array_len < 0) {
        cur.ty = array_of(cur.ty.base, 0)
        ty.is_flexible = 1 != 0
    }
    *rest = tok.next
    ty.members = head.next
}

// attribute = ("__attribute__" "(" "(" "packed" ")" ")")
[c_function]
def private attribute_list(var tok : Token?; var ty : Type?) : Token? {
    while (consume(addr(tok), tok, cstr("__attribute__"))) {
        tok = skip(tok, cstr("("))
        tok = skip(tok, cstr("("))
        var first : bool = 1 != 0
        while (!consume(addr(tok), tok, cstr(")"))) {
            if (!first) {
                tok = skip(tok, cstr(","))
            }
            first = 0 != 0
            if (consume(addr(tok), tok, cstr("packed"))) {
                ty.is_packed = 1 != 0
                continue
            }
            if (consume(addr(tok), tok, cstr("aligned"))) {
                tok = skip(tok, cstr("("))
                ty.align = int(const_expr(addr(tok), tok))
                tok = skip(tok, cstr(")"))
                continue
            }
            error_tok`va(tok, cstr("unknown attribute"), VaNone())
        }
        tok = skip(tok, cstr(")"))
    }
    return tok
}

// struct-union-decl = attribute? ident? ("{" struct-members)?
[c_function]
def private struct_union_decl(var rest : Token ??; var tok : Token?) : Type? {
    var ty : Type? = struct_type()
    tok = attribute_list(tok, ty)
    // Read a tag.
    var tag : Token? = null
    if (tok.kind == TokenKind.TK_IDENT) {
        tag = tok
        tok = tok.next
    }
    if (tag != null && !equal(tok, cstr("\{"))) {
        *rest = tok
        var ty2 : Type? = find_tag(tag)
        if (ty2 != null) {
            return ty2
        }
        ty.size = -1
        push_tag_scope(tag, ty)
        return ty
    }
    tok = skip(tok, cstr("\{"))
    // Construct a struct object.
    struct_members(addr(tok), tok, ty)
    *rest = attribute_list(tok, ty)
    if (tag != null) {
        // If this is a redefinition, overwrite a previous type.
        // Otherwise, register the struct type.
        var ty2 : Type? = reinterpret<Type?>(hashmap_get2(addr(scope.tags), tag.loc, tag.len))
        if (ty2 != null) {
            *ty2 = *ty
            return ty2
        }
        push_tag_scope(tag, ty)
    }
    return ty
}

// struct-decl = struct-union-decl
def private struct_decl(var rest : Token ??; var tok : Token?) : Type? {
    var ty : Type? = struct_union_decl(rest, tok)
    ty.kind = TypeKind.TY_STRUCT
    if (ty.size < 0) {
        return ty
    }
    // Assign offsets within the struct to members.
    var bits : int = 0
    {
        var mem : Member? = ty.members
        while (mem != null) {
            if (mem.is_bitfield && mem.bit_width == 0) {
                // Zero-width anonymous bitfield has a special meaning.
                // It affects only alignment.
                bits = align_to(bits, mem.ty.size * 8)
            } elif (mem.is_bitfield) {
                let sz : int = mem.ty.size
                if (bits / (sz * 8) != (bits + mem.bit_width - 1) / (sz * 8)) {
                    bits = align_to(bits, sz * 8)
                }
                mem.offset = align_down(bits / 8, sz)
                mem.bit_offset = bits % (sz * 8)
                bits += mem.bit_width
            } else {
                if (!ty.is_packed) {
                    bits = align_to(bits, mem.align * 8)
                }
                mem.offset = bits / 8
                bits += mem.ty.size * 8
            }
            if (!ty.is_packed && ty.align < mem.align) {
                ty.align = mem.align
            }
            mem = mem.next
        }
    }
    ty.size = align_to(bits, ty.align * 8) / 8
    return ty
}

// union-decl = struct-union-decl
def private union_decl(var rest : Token ??; var tok : Token?) : Type? {
    var ty : Type? = struct_union_decl(rest, tok)
    ty.kind = TypeKind.TY_UNION
    if (ty.size < 0) {
        return ty
    }
    // If union, we don't have to assign offsets because they
    // are already initialized to zero. We need to compute the
    // alignment and the size though.
    {
        var mem : Member? = ty.members
        while (mem != null) {
            if (ty.align < mem.align) {
                ty.align = mem.align
            }
            if (ty.size < mem.ty.size) {
                ty.size = mem.ty.size
            }
            mem = mem.next
        }
    }
    ty.size = align_to(ty.size, ty.align)
    return ty
}

// Find a struct member by name.
[c_function]
def private get_struct_member(var ty : Type?; var tok : Token?) : Member? {
    {
        var mem : Member? = ty.members
        var _f = false
        while (true) {
            if (_f) {
                mem = mem.next
            }
            _f = true
            if (mem == null) {
                break
            }
            // Anonymous struct member
            if ((mem.ty.kind == TypeKind.TY_STRUCT || mem.ty.kind == TypeKind.TY_UNION) && mem.name == null) {
                if (get_struct_member(mem.ty, tok) != null) {
                    return mem
                }
                continue
            }
            // Regular struct member
            if (mem.name.len == tok.len && crt::strncmp(mem.name.loc, tok.loc, uint64(tok.len)) == 0) {
                return mem
            }
        }
    }
    return null
}

// Create a node representing a struct member access, such as foo.bar
// where foo is a struct and bar is a member name.
// C has a feature called "anonymous struct" which allows a struct to
// have another unnamed struct as a member like this:
// struct { struct { int a; }; int b; } x;
// The members of an anonymous struct belong to the outer struct's
// member namespace. Therefore, in the above example, you can access
// member "a" of the anonymous struct as "x.a".
// This function takes care of anonymous structs.
def private struct_ref(var node : Node?; var tok : Token?) : Node? {
    add_type(node)
    if (node.ty.kind != TypeKind.TY_STRUCT && node.ty.kind != TypeKind.TY_UNION) {
        error_tok`va(node.tok, cstr("not a struct nor a union"), VaNone())
    }
    var ty : Type? = node.ty
    while (true) {
        var mem : Member? = get_struct_member(ty, tok)
        if (mem == null) {
            error_tok`va(tok, cstr("no such member"), VaNone())
        }
        node = new_unary(NodeKind.ND_MEMBER, node, tok)
        node.member = mem
        if (mem.name != null) {
            break
        }
        ty = mem.ty
    }
    return node
}

// Convert A++ to `(typeof A)((A += 1) - 1)`
def private new_inc_dec(var node : Node?; var tok : Token?; addend : int) : Node? {
    add_type(node)
    return new_cast(new_add(to_assign(new_add(node, new_num(int64(addend), tok), tok)), new_num(int64(-addend), tok), tok), node.ty)
}

// postfix = "(" type-name ")" "{" initializer-list "}"
// = ident "(" func-args ")" postfix-tail
// | primary postfix-tail
// postfix-tail = "[" expr "]"
// | "(" func-args ")"
// | "." ident
// | "->" ident
// | "++"
// | "--"
[c_function]
def private postfix(var rest : Token ??; var tok : Token?) : Node? {
    if (equal(tok, cstr("(")) && is_typename(tok.next)) {
        // Compound literal
        var start : Token? = tok
        var ty : Type? = _c_typename(addr(tok), tok.next)
        tok = skip(tok, cstr(")"))
        if (scope.next == null) {
            var _c_var : Obj? = new_anon_gvar(ty)
            gvar_initializer(rest, tok, _c_var)
            return new_var_node(_c_var, start)
        }
        var _c_var : Obj? = new_lvar(addr(c2das_empty[0]), ty)
        var lhs : Node? = lvar_initializer(rest, tok, _c_var)
        var rhs : Node? = new_var_node(_c_var, tok)
        return new_binary(NodeKind.ND_COMMA, lhs, rhs, start)
    }
    var node : Node? = primary(addr(tok), tok)
    while (true) {
        if (equal(tok, cstr("("))) {
            node = funcall(addr(tok), tok.next, node)
            continue
        }
        if (equal(tok, cstr("["))) {
            // x[y] is short for *(x+y)
            var start : Token? = tok
            var idx : Node? = expr(addr(tok), tok.next)
            tok = skip(tok, cstr("]"))
            node = new_unary(NodeKind.ND_DEREF, new_add(node, idx, start), start)
            continue
        }
        if (equal(tok, cstr("."))) {
            node = struct_ref(node, tok.next)
            tok = tok.next.next
            continue
        }
        if (equal(tok, cstr("->"))) {
            // x->y is short for (*x).y
            node = new_unary(NodeKind.ND_DEREF, node, tok)
            node = struct_ref(node, tok.next)
            tok = tok.next.next
            continue
        }
        if (equal(tok, cstr("++"))) {
            node = new_inc_dec(node, tok, 1)
            tok = tok.next
            continue
        }
        if (equal(tok, cstr("--"))) {
            node = new_inc_dec(node, tok, -1)
            tok = tok.next
            continue
        }
        *rest = tok
        return node
    }
}

// funcall = (assign ("," assign)*)? ")"
[c_function]
def private funcall(var rest : Token ??; var tok : Token?; var fn : Node?) : Node? {
    add_type(fn)
    if (fn.ty.kind != TypeKind.TY_FUNC && (fn.ty.kind != TypeKind.TY_PTR || fn.ty.base.kind != TypeKind.TY_FUNC)) {
        error_tok`va(fn.tok, cstr("not a function"), VaNone())
    }
    var ty : Type? = (fn.ty.kind == TypeKind.TY_FUNC) ? fn.ty : fn.ty.base
    var param_ty : Type? = ty.params
    var head : Node = Node()
    var cur : Node? = addr(head)
    while (!equal(tok, cstr(")"))) {
        if (cur != addr(head)) {
            tok = skip(tok, cstr(","))
        }
        var arg : Node? = assign(addr(tok), tok)
        add_type(arg)
        if (param_ty == null && !ty.is_variadic) {
            error_tok`va(tok, cstr("too many arguments"), VaNone())
        }
        if (param_ty != null) {
            if (param_ty.kind != TypeKind.TY_STRUCT && param_ty.kind != TypeKind.TY_UNION) {
                arg = new_cast(arg, param_ty)
            }
            param_ty = param_ty.next
        } elif (arg.ty.kind == TypeKind.TY_FLOAT) {
            // If parameter type is omitted (e.g. in "..."), float
            // arguments are promoted to double.
            arg = new_cast(arg, ty_double)
        }
        cur.next = arg
        cur = cur.next
    }
    if (param_ty != null) {
        error_tok`va(tok, cstr("too few arguments"), VaNone())
    }
    *rest = skip(tok, cstr(")"))
    var node : Node? = new_unary(NodeKind.ND_FUNCALL, fn, tok)
    node.func_ty = ty
    node.ty = ty.return_ty
    node.args = head.next
    // If a function returns a struct, it is caller's responsibility
    // to allocate a space for the return value.
    if (node.ty.kind == TypeKind.TY_STRUCT || node.ty.kind == TypeKind.TY_UNION) {
        node.ret_buffer = new_lvar(addr(c2das_empty[0]), node.ty)
    }
    return node
}

// generic-selection = "(" assign "," generic-assoc ("," generic-assoc)* ")"
// generic-assoc = type-name ":" assign
// | "default" ":" assign
[c_function]
def private generic_selection(var rest : Token ??; var tok : Token?) : Node? {
    var start : Token? = tok
    tok = skip(tok, cstr("("))
    var ctrl : Node? = assign(addr(tok), tok)
    add_type(ctrl)
    var t1 : Type? = ctrl.ty
    if (t1.kind == TypeKind.TY_FUNC) {
        t1 = pointer_to(t1)
    } elif (t1.kind == TypeKind.TY_ARRAY) {
        t1 = pointer_to(t1.base)
    }
    var ret : Node? = null
    while (!consume(rest, tok, cstr(")"))) {
        tok = skip(tok, cstr(","))
        if (equal(tok, cstr("default"))) {
            tok = skip(tok.next, cstr(":"))
            var node : Node? = assign(addr(tok), tok)
            if (ret == null) {
                ret = node
            }
            continue
        }
        var t2 : Type? = _c_typename(addr(tok), tok)
        tok = skip(tok, cstr(":"))
        var node : Node? = assign(addr(tok), tok)
        if (is_compatible(t1, t2)) {
            ret = node
        }
    }
    if (ret == null) {
        error_tok`va(start, cstr("controlling expression type not compatible with any generic association type"), VaNone())
    }
    return ret
}

// primary = "(" "{" stmt+ "}" ")"
// | "(" expr ")"
// | "sizeof" "(" type-name ")"
// | "sizeof" unary
// | "_Alignof" "(" type-name ")"
// | "_Alignof" unary
// | "_Generic" generic-selection
// | "__builtin_types_compatible_p" "(" type-name, type-name, ")"
// | "__builtin_reg_class" "(" type-name ")"
// | ident
// | str
// | num
[c_function]
def private primary(var rest : Token ??; var tok : Token?) : Node? {
    var start : Token? = tok
    if (equal(tok, cstr("(")) && equal(tok.next, cstr("\{"))) {
        // This is a GNU statement expresssion.
        var node : Node? = new_node(NodeKind.ND_STMT_EXPR, tok)
        node.body = compound_stmt(addr(tok), tok.next.next).body
        *rest = skip(tok, cstr(")"))
        return node
    }
    if (equal(tok, cstr("("))) {
        var node : Node? = expr(addr(tok), tok.next)
        *rest = skip(tok, cstr(")"))
        return node
    }
    if (equal(tok, cstr("sizeof")) && equal(tok.next, cstr("(")) && is_typename(tok.next.next)) {
        var ty : Type? = _c_typename(addr(tok), tok.next.next)
        *rest = skip(tok, cstr(")"))
        if (ty.kind == TypeKind.TY_VLA) {
            if (ty.vla_size != null) {
                return new_var_node(ty.vla_size, tok)
            }
            var lhs : Node? = compute_vla_size(ty, tok)
            var rhs : Node? = new_var_node(ty.vla_size, tok)
            return new_binary(NodeKind.ND_COMMA, lhs, rhs, tok)
        }
        return new_ulong(int64(ty.size), start)
    }
    if (equal(tok, cstr("sizeof"))) {
        var node : Node? = unary(rest, tok.next)
        add_type(node)
        if (node.ty.kind == TypeKind.TY_VLA) {
            return new_var_node(node.ty.vla_size, tok)
        }
        return new_ulong(int64(node.ty.size), tok)
    }
    if (equal(tok, cstr("_Alignof")) && equal(tok.next, cstr("(")) && is_typename(tok.next.next)) {
        var ty : Type? = _c_typename(addr(tok), tok.next.next)
        *rest = skip(tok, cstr(")"))
        return new_ulong(int64(ty.align), tok)
    }
    if (equal(tok, cstr("_Alignof"))) {
        var node : Node? = unary(rest, tok.next)
        add_type(node)
        return new_ulong(int64(node.ty.align), tok)
    }
    if (equal(tok, cstr("_Generic"))) {
        return generic_selection(rest, tok.next)
    }
    if (equal(tok, cstr("__builtin_types_compatible_p"))) {
        tok = skip(tok.next, cstr("("))
        var t1 : Type? = _c_typename(addr(tok), tok)
        tok = skip(tok, cstr(","))
        var t2 : Type? = _c_typename(addr(tok), tok)
        *rest = skip(tok, cstr(")"))
        return new_num(int64(int_of(is_compatible(t1, t2))), start)
    }
    if (equal(tok, cstr("__builtin_reg_class"))) {
        tok = skip(tok.next, cstr("("))
        var ty : Type? = _c_typename(addr(tok), tok)
        *rest = skip(tok, cstr(")"))
        if (is_integer(ty) || ty.kind == TypeKind.TY_PTR) {
            return new_num(0l, start)
        }
        if (is_flonum(ty)) {
            return new_num(1l, start)
        }
        return new_num(2l, start)
    }
    if (equal(tok, cstr("__builtin_compare_and_swap"))) {
        var node : Node? = new_node(NodeKind.ND_CAS, tok)
        tok = skip(tok.next, cstr("("))
        node.cas_addr = assign(addr(tok), tok)
        tok = skip(tok, cstr(","))
        node.cas_old = assign(addr(tok), tok)
        tok = skip(tok, cstr(","))
        node.cas_new = assign(addr(tok), tok)
        *rest = skip(tok, cstr(")"))
        return node
    }
    if (equal(tok, cstr("__builtin_atomic_exchange"))) {
        var node : Node? = new_node(NodeKind.ND_EXCH, tok)
        tok = skip(tok.next, cstr("("))
        node.lhs = assign(addr(tok), tok)
        tok = skip(tok, cstr(","))
        node.rhs = assign(addr(tok), tok)
        *rest = skip(tok, cstr(")"))
        return node
    }
    if (tok.kind == TokenKind.TK_IDENT) {
        // Variable or enum constant
        var sc : VarScope? = find_var(tok)
        *rest = tok.next
        // For "static inline" function
        if (sc != null && sc._c_var != null && sc._c_var.is_function) {
            if (parse_current_fn != null) {
                strarray_push(addr(parse_current_fn.refs), sc._c_var.name)
            } else {
                sc._c_var.is_root = 1 != 0
            }
        }
        if (sc != null) {
            if (sc._c_var != null) {
                return new_var_node(sc._c_var, tok)
            }
            if (sc.enum_ty != null) {
                return new_num(int64(sc.enum_val), tok)
            }
        }
        if (equal(tok.next, cstr("("))) {
            error_tok`va(tok, cstr("implicit declaration of a function"), VaNone())
        }
        error_tok`va(tok, cstr("undefined variable"), VaNone())
    }
    if (tok.kind == TokenKind.TK_STR) {
        var _c_var : Obj? = new_string_literal(tok.str, tok.ty)
        *rest = tok.next
        return new_var_node(_c_var, tok)
    }
    if (tok.kind == TokenKind.TK_NUM) {
        var node : Node?
        if (is_flonum(tok.ty)) {
            node = new_node(NodeKind.ND_NUM, tok)
            node.fval = tok.fval
        } else {
            node = new_num(tok.val, tok)
        }
        node.ty = tok.ty
        *rest = tok.next
        return node
    }
    error_tok`va(tok, cstr("expected an expression"), VaNone())
    return null
}

[c_function]
def private parse_typedef(var tok : Token?; var basety : Type?) : Token? {
    var first : bool = 1 != 0
    while (!consume(addr(tok), tok, cstr(";"))) {
        if (!first) {
            tok = skip(tok, cstr(","))
        }
        first = 0 != 0
        var ty : Type? = declarator(addr(tok), tok, basety)
        if (ty.name == null) {
            error_tok`va(ty.name_pos, cstr("typedef name omitted"), VaNone())
        }
        push_scope(get_ident(ty.name)).type_def = ty
    }
    return tok
}

def private create_param_lvars(var param : Type?) {
    if (param != null) {
        create_param_lvars(param.next)
        if (param.name == null) {
            error_tok`va(param.name_pos, cstr("parameter name omitted"), VaNone())
        }
        new_lvar(get_ident(param.name), param)
    }
}

// This function matches gotos or labels-as-values with labels.
// We cannot resolve gotos as we parse a function because gotos
// can refer a label that appears later in the function.
// So, we need to do this after we parse the entire function.
[c_function]
def private resolve_goto_labels {
    {
        var x : Node? = gotos
        while (x != null) {
            {
                var y : Node? = labels
                while (y != null) {
                    if (crt::strcmp(x._c_label, y._c_label) == 0) {
                        x.unique_label = y.unique_label
                        break
                    }
                    y = y.goto_next
                }
            }
            if (x.unique_label == null) {
                error_tok`va(x.tok.next, cstr("use of undeclared label"), VaNone())
            }
            x = x.goto_next
        }
    }
    labels = null
    gotos = labels
}

[c_function]
def private find_func(var name : uint8?) : Obj? {
    var sc : Scope? = scope
    while (sc.next != null) {
        sc = sc.next
    }
    var sc2 : VarScope? = reinterpret<VarScope?>(hashmap_get(addr(sc.vars), name))
    if (sc2 != null && sc2._c_var != null && sc2._c_var.is_function) {
        return sc2._c_var
    }
    return null
}

[c_function]
def private mark_live(var _c_var : Obj?) {
    if (!_c_var.is_function || _c_var.is_live) {
        return
    }
    _c_var.is_live = 1 != 0
    {
        var i : int = 0
        while (i < _c_var.refs.len) {
            var fn : Obj? = find_func(_c_var.refs.data[i])
            if (fn != null) {
                mark_live(fn)
            }
            i++
        }
    }
}

[c_function]
def private _c_function(var tok : Token?; var basety : Type?; var attr : VarAttr?) : Token? {
    var ty : Type? = declarator(addr(tok), tok, basety)
    if (ty.name == null) {
        error_tok`va(ty.name_pos, cstr("function name omitted"), VaNone())
    }
    var name_str : uint8? = get_ident(ty.name)
    var fn : Obj? = find_func(name_str)
    if (fn != null) {
        // Redeclaration
        if (!fn.is_function) {
            error_tok`va(tok, cstr("redeclared as a different kind of symbol"), VaNone())
        }
        if (fn.is_definition && equal(tok, cstr("\{"))) {
            error_tok`va(tok, cstr("redefinition of %s"), (name_str,))
        }
        if (!fn.is_static && attr.is_static) {
            error_tok`va(tok, cstr("static declaration follows a non-static declaration"), VaNone())
        }
        fn.is_definition = fn.is_definition || equal(tok, cstr("\{"))
    } else {
        fn = new_gvar(name_str, ty)
        fn.is_function = 1 != 0
        fn.is_definition = equal(tok, cstr("\{"))
        fn.is_static = attr.is_static || (attr.is_inline && !attr.is_extern)
        fn.is_inline = attr.is_inline
    }
    fn.is_root = !(fn.is_static && fn.is_inline)
    if (consume(addr(tok), tok, cstr(";"))) {
        return tok
    }
    parse_current_fn = fn
    locals = null
    enter_scope()
    create_param_lvars(ty.params)
    // A buffer for a struct/union return value is passed
    // as the hidden first parameter.
    var rty : Type? = ty.return_ty
    if ((rty.kind == TypeKind.TY_STRUCT || rty.kind == TypeKind.TY_UNION) && rty.size > 16) {
        new_lvar(addr(c2das_empty[0]), pointer_to(rty))
    }
    fn.params = locals
    if (ty.is_variadic) {
        fn.va_area = new_lvar(cstr("__va_area__"), array_of(ty_char, 136))
    }
    fn.alloca_bottom = new_lvar(cstr("__alloca_size__"), pointer_to(ty_char))
    tok = skip(tok, cstr("\{"))
    // [https://www.sigbus.info/n1570#6.4.2.2p1] "__func__" is
    // automatically defined as a local variable containing the
    // current function name.
    push_scope(cstr("__func__"))._c_var = new_string_literal(fn.name, array_of(ty_char, int(crt::strlen(fn.name) + 1ul)))
    // [GNU] __FUNCTION__ is yet another name of __func__.
    push_scope(cstr("__FUNCTION__"))._c_var = new_string_literal(fn.name, array_of(ty_char, int(crt::strlen(fn.name) + 1ul)))
    fn.body = compound_stmt(addr(tok), tok)
    fn.locals = locals
    leave_scope()
    resolve_goto_labels()
    return tok
}

[c_function]
def private global_variable(var tok : Token?; var basety : Type?; var attr : VarAttr?) : Token? {
    var first : bool = 1 != 0
    while (!consume(addr(tok), tok, cstr(";"))) {
        if (!first) {
            tok = skip(tok, cstr(","))
        }
        first = 0 != 0
        var ty : Type? = declarator(addr(tok), tok, basety)
        if (ty.name == null) {
            error_tok`va(ty.name_pos, cstr("variable name omitted"), VaNone())
        }
        var _c_var : Obj? = new_gvar(get_ident(ty.name), ty)
        _c_var.is_definition = !attr.is_extern
        _c_var.is_static = attr.is_static
        _c_var.is_tls = attr.is_tls
        if (attr.align != 0) {
            _c_var.align = attr.align
        }
        if (equal(tok, cstr("="))) {
            gvar_initializer(addr(tok), tok.next, _c_var)
        } elif (!attr.is_extern && !attr.is_tls) {
            _c_var.is_tentative = 1 != 0
        }
    }
    return tok
}

// Lookahead tokens and returns true if a given token is a start
// of a function definition or declaration.
[c_function]
def private is_function(var tok : Token?) : bool {
    if (equal(tok, cstr(";"))) {
        return 0 != 0
    }
    var dummy : Type = Type()
    var ty : Type? = declarator(addr(tok), tok, addr(dummy))
    return ty.kind == TypeKind.TY_FUNC
}

// Remove redundant tentative definitions.
[c_function]
def private scan_globals {
    var head : Obj
    var cur : Obj? = addr(head)
    {
        var _c_var : Obj? = globals
        while (_c_var != null) {
            {
                if (!_c_var.is_tentative) {
                    cur.next = _c_var
                    cur = cur.next
                    continue
                }
                // Find another definition of the same identifier.
                var var2 : Obj? = globals
                while (var2 != null) {
                    if (_c_var != var2 && var2.is_definition && crt::strcmp(_c_var.name, var2.name) == 0) {
                        break
                    }
                    var2 = var2.next
                }
                // If there's another definition, the tentative definition
                // is redundant
                if (var2 == null) {
                    cur.next = _c_var
                    cur = cur.next
                }
            } finally {
                _c_var = _c_var.next
            }
        }
    }
    cur.next = null
    globals = head.next
}

def private declare_builtin_functions {
    var ty : Type? = func_type(pointer_to(ty_void))
    ty.params = copy_type(ty_int)
    parse_builtin_alloca = new_gvar(cstr("alloca"), ty)
    parse_builtin_alloca.is_definition = 0 != 0
}

// program = (typedef | function-definition | global-variable)
[c_function]
def parse(var tok : Token?) : Obj? {
    declare_builtin_functions()
    globals = null
    while (tok.kind != TokenKind.TK_EOF) {
        var attr : VarAttr = VarAttr()
        var basety : Type? = declspec(addr(tok), tok, addr(attr))
        // Typedef
        if (attr.is_typedef) {
            tok = parse_typedef(tok, basety)
            continue
        }
        // Function
        if (is_function(tok)) {
            tok = _c_function(tok, basety, addr(attr))
            continue
        }
        // Global variable
        tok = global_variable(tok, basety, addr(attr))
    }
    {
        var _c_var : Obj? = globals
        while (_c_var != null) {
            if (_c_var.is_root) {
                mark_live(_c_var)
            }
            _c_var = _c_var.next
        }
    }
    // Remove redundant tentative definitions.
    scan_globals()
    return globals
}

