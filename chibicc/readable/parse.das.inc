}

// bitxor = bitand ("^" bitand)
[c_function]
def private bitxor(var rest : Token ??; var tok : Token?) : Node? {
    var node : Node? = bitand(addr(tok), tok)
    while (equal(tok, cstr("^"))) {
        var start : Token? = tok
        node = new_binary(NodeKind.ND_BITXOR, node, bitand(addr(tok), tok.next), start)
