def private is_hash(var tok : Token?) : bool {
    return tok.at_bol && equal(tok, cstr("#"))
}

// Some preprocessor directives such as #include allow extraneous
// tokens before newline. This function skips such tokens.
def private skip_line(var tok : Token?) : Token? {
    if (tok.at_bol) {
        return tok
    }
    warn_tok`va(tok, cstr("extra token"), VaNone())
    while (tok.at_bol) {
        tok = tok.next
    }
    return tok
}

[c_function]
def private copy_token(var tok : Token?) : Token? {
    var t : Token? = reinterpret<Token?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<Token>))))
    *t = *tok
    t.next = null
    return t
}

def private new_eof(var tok : Token?) : Token? {
    var t : Token? = copy_token(tok)
    t.kind = TokenKind.TK_EOF
    t.len = 0
    return t
}

[c_function]
def private new_hideset(var name : uint8?) : Hideset? {
    var hs : Hideset? = reinterpret<Hideset?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<Hideset>))))
    hs.name = name
    return hs
}

[c_function]
def private hideset_union(var hs1 : Hideset?; var hs2 : Hideset?) : Hideset? {
    var head : Hideset = Hideset()
    var cur : Hideset? = addr(head)
    while (hs1 != null) {
        cur.next = new_hideset(hs1.name)
        cur = cur.next
        hs1 = hs1.next
    }
    cur.next = hs2
    return head.next
}

[c_function]
def private hideset_contains(var hs : Hideset?; var s : uint8?; len : int) : bool {
    while (hs != null) {
        if (crt::strlen(hs.name) == uint64(len) && crt::strncmp(hs.name, s, uint64(len)) == 0) {
            return 1 != 0
        }
        hs = hs.next
    }
    return 0 != 0
}

[c_function]
def private hideset_intersection(var hs1 : Hideset?; var hs2 : Hideset?) : Hideset? {
    var head : Hideset = Hideset()
    var cur : Hideset? = addr(head)
    while (hs1 != null) {
        if (hideset_contains(hs2, hs1.name, int(crt::strlen(hs1.name)))) {
            cur.next = new_hideset(hs1.name)
            cur = cur.next
        }
        hs1 = hs1.next
    }
    return head.next
}

[c_function]
def private add_hideset(var tok : Token?; var hs : Hideset?) : Token? {
    var head : Token = Token()
    var cur : Token? = addr(head)
    while (tok != null) {
        var t : Token? = copy_token(tok)
        t.hideset = hideset_union(t.hideset, hs)
        cur.next = t
        cur = cur.next
        tok = tok.next
    }
    return head.next
}

// Append tok2 to the end of tok1.
[c_function]
def private append(var tok1 : Token?; var tok2 : Token?) : Token? {
    if (tok1.kind == TokenKind.TK_EOF) {
        return tok2
    }
    var head : Token = Token()
    var cur : Token? = addr(head)
    while (tok1.kind != TokenKind.TK_EOF) {
        cur.next = copy_token(tok1)
        cur = cur.next
        tok1 = tok1.next
    }
    cur.next = tok2
    return head.next
}

def private skip_cond_incl2(var tok : Token?) : Token? {
    while (tok.kind != TokenKind.TK_EOF) {
        if (is_hash(tok) && (equal(tok.next, cstr("if")) || equal(tok.next, cstr("ifdef")) || equal(tok.next, cstr("ifndef")))) {
            tok = skip_cond_incl2(tok.next.next)
            continue
        }
        if (is_hash(tok) && equal(tok.next, cstr("endif"))) {
            return tok.next.next
        }
        tok = tok.next
    }
    return tok
}

// Skip until next `#else`, `#elif` or `#endif`.
// Nested `#if` and `#endif` are skipped.
def private skip_cond_incl(var tok : Token?) : Token? {
    while (tok.kind != TokenKind.TK_EOF) {
        if (is_hash(tok) && (equal(tok.next, cstr("if")) || equal(tok.next, cstr("ifdef")) || equal(tok.next, cstr("ifndef")))) {
            tok = skip_cond_incl2(tok.next.next)
            continue
        }
        if (is_hash(tok) && (equal(tok.next, cstr("elif")) || equal(tok.next, cstr("else")) || equal(tok.next, cstr("endif")))) {
            break
        }
        tok = tok.next
    }
    return tok
}

// Double-quote a given string and returns it.
[c_function]
def private quote_string(var str : uint8?) : uint8? {
    var bufsize : int = 3
    {
        var i : int = 0
        while (str[i] != 0) {
            if (str[i] == '\\' || str[i] == '"') {
                bufsize++
            }
            bufsize++
            i++
        }
    }
    var buf : uint8? = reinterpret<uint8?>(crt::calloc(1ul, uint64(bufsize)))
    var p : uint8? = buf
    var _t0 = p
    p++
    *_t0 = uint8('"')
    {
        var i : int = 0
        while (str[i] != 0) {
            if (str[i] == '\\' || str[i] == '"') {
                var _t1 = p
                p++
                *_t1 = uint8('\\')
            }
            var _t2 = p
            p++
            *_t2 = str[i]
            i++
        }
    }
    var _t3 = p
    p++
    *_t3 = uint8('"')
    var _t4 = p
    p++
    *_t4 = uint8('\0')
    return buf
}

def private new_str_token(var str : uint8?; var tmpl : Token?) : Token? {
    var buf : uint8? = quote_string(str)
    return tokenize(new_file(tmpl.file.name, tmpl.file.file_no, buf))
}

// Copy all tokens until the next newline, terminate them with
// an EOF token and then returns them. This function is used to
// create a new list of tokens for `#if` arguments.
[c_function]
def private copy_line(var rest : Token ??; var tok : Token?) : Token? {
    var head : Token = Token()
    var cur : Token? = addr(head)
    while (!tok.at_bol) {
        cur.next = copy_token(tok)
        cur = cur.next
        tok = tok.next
    }
    cur.next = new_eof(tok)
    *rest = tok
    return head.next
}

def private new_num_token(val : int; var tmpl : Token?) : Token? {
    var buf : uint8? = format`va(cstr("%d\n"), (val,))
    return tokenize(new_file(tmpl.file.name, tmpl.file.file_no, buf))
}

[c_function]
def private read_const_expr(var rest : Token ??; var tok : Token?) : Token? {
    tok = copy_line(rest, tok)
    var head : Token = Token()
    var cur : Token? = addr(head)
    while (tok.kind != TokenKind.TK_EOF) {
        // "defined(foo)" or "defined foo" becomes "1" if macro "foo"
        // is defined. Otherwise "0".
        if (equal(tok, cstr("defined"))) {
            var start : Token? = tok
            let has_paren : bool = consume(addr(tok), tok.next, cstr("("))
            if (tok.kind != TokenKind.TK_IDENT) {
                error_tok`va(start, cstr("macro name must be an identifier"), VaNone())
            }
            var m : Macro? = find_macro(tok)
            tok = tok.next
            if (has_paren) {
                tok = skip(tok, cstr(")"))
            }
            cur.next = new_num_token(m != null ? 1 : 0, start)
            cur = cur.next
            continue
        }
        cur.next = tok
        cur = cur.next
        tok = tok.next
    }
    cur.next = tok
    return head.next
}

// Read and evaluate a constant expression.
[c_function]
def private eval_const_expr(var rest : Token ??; var tok : Token?) : int64 {
    var start : Token? = tok
    var expr : Token? = read_const_expr(rest, tok.next)
    expr = preprocess2(expr)
    if (expr.kind == TokenKind.TK_EOF) {
        error_tok`va(start, cstr("no expression"), VaNone())
    }
    // [https://www.sigbus.info/n1570#6.10.1p4] The standard requires
    // we replace remaining non-macro identifiers with "0" before
    // evaluating a constant expression. For example, `#if foo` is
    // equivalent to `#if 0` if foo is not defined.
    {
        var t : Token? = expr
        while (t.kind != TokenKind.TK_EOF) {
            if (t.kind == TokenKind.TK_IDENT) {
                var next : Token? = t.next
                *t = *new_num_token(0, t)
                t.next = next
            }
            t = t.next
        }
    }
    // Convert pp-numbers to regular numbers
    convert_pp_tokens(expr)
    var rest2 : Token?
    let val : int64 = const_expr(addr(rest2), expr)
    if (rest2.kind != TokenKind.TK_EOF) {
        error_tok`va(rest2, cstr("extra token"), VaNone())
    }
    return val
}

[c_function]
def private push_cond_incl(var tok : Token?; included : bool) : CondIncl? {
    var ci : CondIncl? = reinterpret<CondIncl?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<CondIncl>))))
    ci.next = cond_incl
    ci.ctx = anon_386.IN_THEN
    ci.tok = tok
    ci.included = included
    cond_incl = ci
    return ci
}

[c_function]
def private find_macro(var tok : Token?) : Macro? {
    if (tok.kind != TokenKind.TK_IDENT) {
        return null
    }
    return reinterpret<Macro?>(hashmap_get2(addr(macros), tok.loc, tok.len))
}

[c_function]
def private add_macro(var name : uint8?; is_objlike : bool; var body : Token?) : Macro? {
    var m : Macro? = reinterpret<Macro?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<Macro>))))
    m.name = name
    m.is_objlike = is_objlike
    m.body = body
    hashmap_put(addr(macros), name, reinterpret<void?>(m))
    return m
}

[c_function]
def private read_macro_params(var rest : Token ??; var tok : Token?; var va_args_name : uint8 ??) : MacroParam? {
    var head : MacroParam = MacroParam()
    var cur : MacroParam? = addr(head)
    while (!equal(tok, cstr(")"))) {
        if (cur != addr(head)) {
            tok = skip(tok, cstr(","))
        }
        if (equal(tok, cstr("..."))) {
            *va_args_name = cstr("__VA_ARGS__")
            *rest = skip(tok.next, cstr(")"))
            return head.next
        }
        if (tok.kind != TokenKind.TK_IDENT) {
            error_tok`va(tok, cstr("expected an identifier"), VaNone())
        }
        if (equal(tok.next, cstr("..."))) {
            *va_args_name = host_strndup(tok.loc, uint64(tok.len))
            *rest = skip(tok.next.next, cstr(")"))
            return head.next
        }
        var m : MacroParam? = reinterpret<MacroParam?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<MacroParam>))))
        m.name = host_strndup(tok.loc, uint64(tok.len))
        cur.next = m
        cur = cur.next
        tok = tok.next
    }
    *rest = tok.next
    return head.next
}

[c_function]
def private read_macro_definition(var rest : Token ??; var tok : Token?) {
    if (tok.kind != TokenKind.TK_IDENT) {
        error_tok`va(tok, cstr("macro name must be an identifier"), VaNone())
    }
    var name : uint8? = host_strndup(tok.loc, uint64(tok.len))
    tok = tok.next
    if (!tok.has_space && equal(tok, cstr("("))) {
        // Function-like macro
        var va_args_name : uint8? = null
        var params : MacroParam? = read_macro_params(addr(tok), tok.next, addr(va_args_name))
        var m : Macro? = add_macro(name, 0 != 0, copy_line(rest, tok))
        m.params = params
        m.va_args_name = va_args_name
    } else {
        // Object-like macro
        add_macro(name, 1 != 0, copy_line(rest, tok))
    }
}

[c_function]
def private read_macro_arg_one(var rest : Token ??; var tok : Token?; read_rest : bool) : MacroArg? {
    var head : Token = Token()
    var cur : Token? = addr(head)
    var level : int = 0
    while (true) {
        if (level == 0 && equal(tok, cstr(")"))) {
            break
        }
        if (level == 0 && !read_rest && equal(tok, cstr(","))) {
            break
        }
        if (tok.kind == TokenKind.TK_EOF) {
            error_tok`va(tok, cstr("premature end of input"), VaNone())
        }
        if (equal(tok, cstr("("))) {
            level++
        } elif (equal(tok, cstr(")"))) {
            level--
        }
        cur.next = copy_token(tok)
        cur = cur.next
        tok = tok.next
    }
    cur.next = new_eof(tok)
    var arg : MacroArg? = reinterpret<MacroArg?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<MacroArg>))))
    arg.tok = head.next
    *rest = tok
    return arg
}

[c_function]
def private read_macro_args(var rest : Token ??; var tok : Token?; var params : MacroParam?; var va_args_name : uint8?) : MacroArg? {
    var start : Token? = tok
    tok = tok.next.next
    var head : MacroArg = MacroArg()
    var cur : MacroArg? = addr(head)
    var pp : MacroParam? = params
    while (pp != null) {
        if (cur != addr(head)) {
            tok = skip(tok, cstr(","))
        }
        cur.next = read_macro_arg_one(addr(tok), tok, 0 != 0)
        cur = cur.next
        cur.name = pp.name
        pp = pp.next
    }
    if (va_args_name != null) {
        var arg : MacroArg?
        if (equal(tok, cstr(")"))) {
            arg = reinterpret<MacroArg?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<MacroArg>))))
            arg.tok = new_eof(tok)
        } else {
            if (pp != params) {
                tok = skip(tok, cstr(","))
            }
            arg = read_macro_arg_one(addr(tok), tok, 1 != 0)
        }
        arg.name = va_args_name
        arg.is_va_args = 1 != 0
        cur.next = arg
        cur = cur.next
    } elif (pp != null) {
        error_tok`va(start, cstr("too many arguments"), VaNone())
    }
    skip(tok, cstr(")"))
    *rest = tok
    return head.next
}

[c_function]
def private find_arg(var args : MacroArg?; var tok : Token?) : MacroArg? {
    {
        var ap : MacroArg? = args
        while (ap != null) {
            if (uint64(tok.len) == crt::strlen(ap.name) && crt::strncmp(tok.loc, ap.name, uint64(tok.len)) == 0) {
                return ap
            }
            ap = ap.next
        }
    }
    return null
}

// Concatenates all tokens in `tok` and returns a new string.
[c_function]
def private join_tokens(var tok : Token?; var end : Token?) : uint8? {
    // Compute the length of the resulting token.
    var len : int = 1
    {
        var t : Token? = tok
        while (t != end && t.kind != TokenKind.TK_EOF) {
            if (t != tok && t.has_space) {
                len++
            }
            len += t.len
            t = t.next
        }
    }
    var buf : uint8? = reinterpret<uint8?>(crt::calloc(1ul, uint64(len)))
    // Copy token texts.
    var pos : int = 0
    {
        var t : Token? = tok
        while (t != end && t.kind != TokenKind.TK_EOF) {
            if (t != tok && t.has_space) {
                let _t0 = pos
                pos++
                buf[_t0] = uint8(' ')
            }
            crt::strncpy(buf + pos, t.loc, uint64(t.len))
            pos += t.len
            t = t.next
        }
    }
    buf[pos] = uint8('\0')
    return buf
}

// Concatenates all tokens in `arg` and returns a new string token.
// This function is used for the stringizing operator (#).
def private stringize(var hash : Token?; var arg : Token?) : Token? {
    // Create a new string token. We need to set some value to its
    // source location for error reporting function, so we use a macro
    // name token as a template.
    var s : uint8? = join_tokens(arg, null)
    return new_str_token(s, hash)
}

// Concatenate two tokens to create a new token.
def private paste(var lhs : Token?; var rhs : Token?) : Token? {
    // Paste the two tokens.
    var buf : uint8? = format`va(cstr("%.*s%.*s"), (lhs.len, lhs.loc, rhs.len, rhs.loc))
    // Tokenize the resulting string.
    var tok : Token? = tokenize(new_file(lhs.file.name, lhs.file.file_no, buf))
    if (tok.next.kind != TokenKind.TK_EOF) {
        error_tok`va(lhs, cstr("pasting forms '%s', an invalid token"), (buf,))
    }
    return tok
}

[c_function]
def private has_varargs(var args : MacroArg?) : bool {
    {
        var ap : MacroArg? = args
        while (ap != null) {
            if (crt::strcmp(ap.name, cstr("__VA_ARGS__")) == 0) {
                return ap.tok.kind != TokenKind.TK_EOF
            }
            ap = ap.next
        }
    }
    return 0 != 0
}

// Replace func-like macro parameters with given arguments.
[c_function]
def private subst(var tok : Token?; var args : MacroArg?) : Token? {
    var head : Token = Token()
    var cur : Token? = addr(head)
    while (tok.kind != TokenKind.TK_EOF) {
        // "#" followed by a parameter is replaced with stringized actuals.
        if (equal(tok, cstr("#"))) {
            var arg : MacroArg? = find_arg(args, tok.next)
            if (arg == null) {
                error_tok`va(tok.next, cstr("'#' is not followed by a macro parameter"), VaNone())
            }
            cur.next = stringize(tok, arg.tok)
            cur = cur.next
            tok = tok.next.next
            continue
        }
        // [GNU] If __VA_ARG__ is empty, `,##__VA_ARGS__` is expanded
        // to the empty token list. Otherwise, its expaned to `,` and
        // __VA_ARGS__.
        if (equal(tok, cstr(",")) && equal(tok.next, cstr("##"))) {
            var arg : MacroArg? = find_arg(args, tok.next.next)
            if (arg != null && arg.is_va_args) {
                if (arg.tok.kind == TokenKind.TK_EOF) {
                    tok = tok.next.next.next
                } else {
                    cur.next = copy_token(tok)
                    cur = cur.next
                    tok = tok.next.next
                }
                continue
            }
        }
        if (equal(tok, cstr("##"))) {
            if (cur == addr(head)) {
                error_tok`va(tok, cstr("'##' cannot appear at start of macro expansion"), VaNone())
            }
            if (tok.next.kind == TokenKind.TK_EOF) {
                error_tok`va(tok, cstr("'##' cannot appear at end of macro expansion"), VaNone())
            }
            var arg : MacroArg? = find_arg(args, tok.next)
            if (arg != null) {
                if (arg.tok.kind != TokenKind.TK_EOF) {
                    *cur = *paste(cur, arg.tok)
                    {
                        var t : Token? = arg.tok.next
                        while (t.kind != TokenKind.TK_EOF) {
                            cur.next = copy_token(t)
                            cur = cur.next
                            t = t.next
                        }
                    }
                }
                tok = tok.next.next
                continue
            }
            *cur = *paste(cur, tok.next)
            tok = tok.next.next
            continue
        }
        var arg : MacroArg? = find_arg(args, tok)
        if (arg != null && equal(tok.next, cstr("##"))) {
            var rhs : Token? = tok.next.next
            if (arg.tok.kind == TokenKind.TK_EOF) {
                var arg2 : MacroArg? = find_arg(args, rhs)
                if (arg2 != null) {
                    {
                        var t : Token? = arg2.tok
                        while (t.kind != TokenKind.TK_EOF) {
                            cur.next = copy_token(t)
                            cur = cur.next
                            t = t.next
                        }
                    }
                } else {
                    cur.next = copy_token(rhs)
                    cur = cur.next
                }
                tok = rhs.next
                continue
            }
            {
                var t : Token? = arg.tok
                while (t.kind != TokenKind.TK_EOF) {
                    cur.next = copy_token(t)
                    cur = cur.next
                    t = t.next
                }
            }
            tok = tok.next
            continue
        }
        // If __VA_ARG__ is empty, __VA_OPT__(x) is expanded to the
        // empty token list. Otherwise, __VA_OPT__(x) is expanded to x.
        if (equal(tok, cstr("__VA_OPT__")) && equal(tok.next, cstr("("))) {
            var arg1 : MacroArg? = read_macro_arg_one(addr(tok), tok.next.next, 1 != 0)
            if (has_varargs(args)) {
                {
                    var t : Token? = arg1.tok
                    while (t.kind != TokenKind.TK_EOF) {
                        cur.next = t
                        cur = cur.next
                        t = t.next
                    }
                }
            }
            tok = skip(tok, cstr(")"))
            continue
        }
        // Handle a macro token. Macro arguments are completely macro-expanded
        // before they are substituted into a macro body.
        if (arg != null) {
            var t : Token? = preprocess2(arg.tok)
            t.at_bol = tok.at_bol
            t.has_space = tok.has_space
            while (t.kind != TokenKind.TK_EOF) {
                cur.next = copy_token(t)
                cur = cur.next
                t = t.next
            }
            tok = tok.next
            continue
        }
        // Handle a non-macro token.
        cur.next = copy_token(tok)
        cur = cur.next
        tok = tok.next
        continue
    }
    cur.next = tok
    return head.next
}

// If tok is a macro, expand it and return true.
// Otherwise, do nothing and return false.
[c_function]
def private expand_macro(var rest : Token ??; var tok : Token?) : bool {
    if (hideset_contains(tok.hideset, tok.loc, tok.len)) {
        return 0 != 0
    }
    var m : Macro? = find_macro(tok)
    if (m == null) {
        return 0 != 0
    }
    // Built-in dynamic macro application such as __LINE__
    if (m.handler != null) {
        *rest = invoke(m.handler, tok)
        (*rest).next = tok.next
        return 1 != 0
    }
    // Object-like macro application
    if (m.is_objlike) {
        var hs : Hideset? = hideset_union(tok.hideset, new_hideset(m.name))
        var body : Token? = add_hideset(m.body, hs)
        {
            var t : Token? = body
            while (t.kind != TokenKind.TK_EOF) {
                t.origin = tok
                t = t.next
            }
        }
        *rest = append(body, tok.next)
        (*rest).at_bol = tok.at_bol
        (*rest).has_space = tok.has_space
        return 1 != 0
    }
    // If a funclike macro token is not followed by an argument list,
    // treat it as a normal identifier.
    if (!equal(tok.next, cstr("("))) {
        return 0 != 0
    }
    // Function-like macro application
    var macro_token : Token? = tok
    var args : MacroArg? = read_macro_args(addr(tok), tok, m.params, m.va_args_name)
    var rparen : Token? = tok
    // Tokens that consist a func-like macro invocation may have different
    // hidesets, and if that's the case, it's not clear what the hideset
    // for the new tokens should be. We take the interesection of the
    // macro token and the closing parenthesis and use it as a new hideset
    // as explained in the Dave Prossor's algorithm.
    var hs : Hideset? = hideset_intersection(macro_token.hideset, rparen.hideset)
    hs = hideset_union(hs, new_hideset(m.name))
    var body : Token? = subst(m.body, args)
    body = add_hideset(body, hs)
    {
        var t : Token? = body
        while (t.kind != TokenKind.TK_EOF) {
            t.origin = macro_token
            t = t.next
        }
    }
    *rest = append(body, tok.next)
    (*rest).at_bol = macro_token.at_bol
    (*rest).has_space = macro_token.has_space
    return 1 != 0
}

[c_function]
def search_include_paths(var filename : uint8?) : uint8? {
    if (filename[0] == '/') {
        return filename
    }
    var cached : uint8? = reinterpret<uint8?>(hashmap_get(addr(search_include_paths_cache), filename))
    if (cached != null) {
        return cached
    }
    // Search a file from the include paths.
    {
        var i : int = 0
        var _f = false
        while (true) {
            if (_f) {
                i++
            }
            _f = true
            if (!(i < include_paths.len)) {
                break
            }
            var path : uint8? = format`va(cstr("%s/%s"), (include_paths.data[i], filename))
            if (!file_exists(path)) {
                continue
            }
            hashmap_put(addr(search_include_paths_cache), filename, reinterpret<void?>(path))
            include_next_idx = i + 1
            return path
        }
    }
    return null
}

[c_function]
def private search_include_next(var filename : uint8?) : uint8? {
    while (include_next_idx < include_paths.len) {
        var path : uint8? = format`va(cstr("%s/%s"), (include_paths.data[include_next_idx], filename))
        if (file_exists(path)) {
            return path
        }
        include_next_idx++
    }
    return null
}

// Read an #include argument.
[c_function]
def private read_include_filename(var rest : Token ??; var tok : Token?; var is_dquote : bool?) : uint8? {
    // Pattern 1: #include "foo.h"
    if (tok.kind == TokenKind.TK_STR) {
        // A double-quoted filename for #include is a special kind of
        // token, and we don't want to interpret any escape sequences in it.
        // For example, "\f" in "C:\foo" is not a formfeed character but
        // just two non-control characters, backslash and f.
        // So we don't want to use token->str.
        *is_dquote = 1 != 0
        *rest = skip_line(tok.next)
        return host_strndup(tok.loc + 1, uint64(tok.len - 2))
    }
    // Pattern 2: #include <foo.h>
    if (equal(tok, cstr("<"))) {
        // Reconstruct a filename from a sequence of tokens between
        // "<" and ">".
        var start : Token? = tok
        // Find closing ">".
        while (!equal(tok, cstr(">"))) {
            if (tok.at_bol || tok.kind == TokenKind.TK_EOF) {
                error_tok`va(tok, cstr("expected '>'"), VaNone())
            }
            tok = tok.next
        }
        *is_dquote = 0 != 0
        *rest = skip_line(tok.next)
        return join_tokens(start.next, tok)
    }
    // Pattern 3: #include FOO
    // In this case FOO must be macro-expanded to either
    // a single string token or a sequence of "<" ... ">".
    if (tok.kind == TokenKind.TK_IDENT) {
        var tok2 : Token? = preprocess2(copy_line(rest, tok))
        return read_include_filename(addr(tok2), tok2, is_dquote)
    }
    error_tok`va(tok, cstr("expected a filename"), VaNone())
    return null
}

// Detect the following "include guard" pattern.
// #ifndef FOO_H
// #define FOO_H
// ...
// #endif
def private detect_include_guard(var tok : Token?) : uint8? {
    // Detect the first two lines.
    if (!is_hash(tok) || !equal(tok.next, cstr("ifndef"))) {
        return null
    }
    tok = tok.next.next
    if (tok.kind != TokenKind.TK_IDENT) {
        return null
    }
    var macro : uint8? = host_strndup(tok.loc, uint64(tok.len))
    tok = tok.next
    if (!is_hash(tok) || !equal(tok.next, cstr("define")) || !equal(tok.next.next, macro)) {
        return null
    }
    // Read until the end of the file.
    while (tok.kind != TokenKind.TK_EOF) {
        if (!is_hash(tok)) {
            tok = tok.next
            continue
        }
        if (equal(tok.next, cstr("endif")) && tok.next.next.kind == TokenKind.TK_EOF) {
            return macro
        }
        if (equal(tok, cstr("if")) || equal(tok, cstr("ifdef")) || equal(tok, cstr("ifndef"))) {
            tok = skip_cond_incl(tok.next)
        } else {
            tok = tok.next
        }
    }
    return null
}

[c_function]
def private include_file(var tok : Token?; var path : uint8?; var filename_tok : Token?) : Token? {
    // Check for "#pragma once"
    if (hashmap_get(addr(pragma_once), path) != null) {
        return tok
    }
    // If we read the same file before, and if the file was guarded
    // by the usual #ifndef ... #endif pattern, we may be able to
    // skip the file without opening it.
    var guard_name : uint8? = reinterpret<uint8?>(hashmap_get(addr(include_file_include_guards), path))
    if (guard_name != null && hashmap_get(addr(macros), guard_name) != null) {
        return tok
    }
    var tok2 : Token? = tokenize_file(path)
    if (tok2 == null) {
        error_tok`va(filename_tok, cstr("%s: cannot open file: %s"), (path, crt::strerror(*crt::c_errno_location())))
    }
    guard_name = detect_include_guard(tok2)
    if (guard_name != null) {
        hashmap_put(addr(include_file_include_guards), path, reinterpret<void?>(guard_name))
    }
    return append(tok2, tok)
}

// Read #line arguments
def private read_line_marker(var rest : Token ??; var tok : Token?) {
    var start : Token? = tok
    tok = preprocess(copy_line(rest, tok))
    if (tok.kind != TokenKind.TK_NUM || tok.ty.kind != TypeKind.TY_INT) {
        error_tok`va(tok, cstr("invalid line marker"), VaNone())
    }
    start.file.line_delta = int(tok.val - int64(start.line_no))
    tok = tok.next
    if (tok.kind == TokenKind.TK_EOF) {
        return
    }
    if (tok.kind != TokenKind.TK_STR) {
        error_tok`va(tok, cstr("filename expected"), VaNone())
    }
    start.file.display_name = tok.str
}

// Visit all tokens in `tok` while evaluating preprocessing
// macros and directives.
[c_function]
def private preprocess2(var tok : Token?) : Token? {
    var head : Token = Token()
    var cur : Token? = addr(head)
    while (tok.kind != TokenKind.TK_EOF) {
        // If it is a macro, expand it.
        if (expand_macro(addr(tok), tok)) {
            continue
        }
        // Pass through if it is not a "#".
        if (!is_hash(tok)) {
            tok.line_delta = tok.file.line_delta
            tok.filename = tok.file.display_name
            cur.next = tok
            cur = cur.next
            tok = tok.next
            continue
        }
        var start : Token? = tok
        tok = tok.next
        if (equal(tok, cstr("include"))) {
            var is_dquote : bool
            var filename : uint8? = read_include_filename(addr(tok), tok.next, addr(is_dquote))
            if (filename[0] != '/' && is_dquote) {
                var path : uint8? = format`va(cstr("%s/%s"), (host_dirname(crt::strdup(start.file.name)), filename))
                if (file_exists(path)) {
                    tok = include_file(tok, path, start.next.next)
                    continue
                }
            }
            var path : uint8? = search_include_paths(filename)
            tok = include_file(tok, path != null ? path : filename, start.next.next)
            continue
        }
        if (equal(tok, cstr("include_next"))) {
            var ignore : bool
            var filename : uint8? = read_include_filename(addr(tok), tok.next, addr(ignore))
            var path : uint8? = search_include_next(filename)
            tok = include_file(tok, path != null ? path : filename, start.next.next)
            continue
        }
        if (equal(tok, cstr("define"))) {
            read_macro_definition(addr(tok), tok.next)
            continue
        }
        if (equal(tok, cstr("undef"))) {
            tok = tok.next
            if (tok.kind != TokenKind.TK_IDENT) {
                error_tok`va(tok, cstr("macro name must be an identifier"), VaNone())
            }
            undef_macro(host_strndup(tok.loc, uint64(tok.len)))
            tok = skip_line(tok.next)
            continue
        }
        if (equal(tok, cstr("if"))) {
            let val : int64 = eval_const_expr(addr(tok), tok)
            push_cond_incl(start, val != 0)
            if (val == 0) {
                tok = skip_cond_incl(tok)
            }
            continue
        }
        if (equal(tok, cstr("ifdef"))) {
            let defined : bool = find_macro(tok.next) != null
            push_cond_incl(tok, defined)
            tok = skip_line(tok.next.next)
            if (!defined) {
                tok = skip_cond_incl(tok)
            }
            continue
        }
        if (equal(tok, cstr("ifndef"))) {
            let defined : bool = find_macro(tok.next) != null
            push_cond_incl(tok, !defined)
            tok = skip_line(tok.next.next)
            if (defined) {
                tok = skip_cond_incl(tok)
            }
            continue
        }
        if (equal(tok, cstr("elif"))) {
            if (cond_incl == null || cond_incl.ctx == anon_386.IN_ELSE) {
                error_tok`va(start, cstr("stray #elif"), VaNone())
            }
            cond_incl.ctx = anon_386.IN_ELIF
            if (!cond_incl.included && eval_const_expr(addr(tok), tok) != 0) {
                cond_incl.included = 1 != 0
            } else {
                tok = skip_cond_incl(tok)
            }
            continue
        }
        if (equal(tok, cstr("else"))) {
            if (cond_incl == null || cond_incl.ctx == anon_386.IN_ELSE) {
                error_tok`va(start, cstr("stray #else"), VaNone())
            }
            cond_incl.ctx = anon_386.IN_ELSE
            tok = skip_line(tok.next)
            if (cond_incl.included) {
                tok = skip_cond_incl(tok)
            }
            continue
        }
        if (equal(tok, cstr("endif"))) {
            if (cond_incl == null) {
                error_tok`va(start, cstr("stray #endif"), VaNone())
            }
            cond_incl = cond_incl.next
            tok = skip_line(tok.next)
            continue
        }
        if (equal(tok, cstr("line"))) {
            read_line_marker(addr(tok), tok.next)
            continue
        }
        if (tok.kind == TokenKind.TK_PP_NUM) {
            read_line_marker(addr(tok), tok)
            continue
        }
        if (equal(tok, cstr("pragma")) && equal(tok.next, cstr("once"))) {
            hashmap_put(addr(pragma_once), tok.file.name, reinterpret<void?>(uint64(1)))
            tok = skip_line(tok.next.next)
            continue
        }
        if (equal(tok, cstr("pragma"))) {
            c_do_while(!tok.at_bol) {
                tok = tok.next
            }
            continue
        }
        if (equal(tok, cstr("error"))) {
            error_tok`va(tok, cstr("error"), VaNone())
        }
        // `#`-only line is legal. It's called a null directive.
        if (tok.at_bol) {
            continue
        }
        error_tok`va(tok, cstr("invalid preprocessor directive"), VaNone())
    }
    cur.next = tok
    return head.next
}

def define_macro(var name : uint8?; var buf : uint8?) {
    var tok : Token? = tokenize(new_file(cstr("<built-in>"), 1, buf))
    add_macro(name, 1 != 0, tok)
}

[c_function]
def undef_macro(var name : uint8?) {
    hashmap_delete(addr(macros), name)
}

def private add_builtin(var name : uint8?; fn : function<(var a0 : Token?) : Token?>) : Macro? {
    var m : Macro? = add_macro(name, 1 != 0, null)
    m.handler = fn
    return m
}

def private file_macro(var tmpl : Token?) : Token? {
    while (tmpl.origin != null) {
        tmpl = tmpl.origin
    }
    return new_str_token(tmpl.file.display_name, tmpl)
}

def private line_macro(var tmpl : Token?) : Token? {
    while (tmpl.origin != null) {
        tmpl = tmpl.origin
    }
    let i : int = tmpl.line_no + tmpl.file.line_delta
    return new_num_token(i, tmpl)
}

// __COUNTER__ is expanded to serial values starting from 0.
def private counter_macro(var tmpl : Token?) : Token? {
    let _t0 = counter_macro_i
    counter_macro_i++
    return new_num_token(_t0, tmpl)
}

// __TIMESTAMP__ is expanded to a string describing the last
// modification time of the current file. E.g.
// "Fri Jul 24 01:32:50 2020"
def private timestamp_macro(var tmpl : Token?) : Token? {
    // c2das-re port: no stat
    return new_str_token(cstr("??? ??? ?? ??:??:?? ????"), tmpl)
}

def private base_file_macro(var tmpl : Token?) : Token? {
    return new_str_token(base_file, tmpl)
}

// __DATE__ is expanded to the current date, e.g. "May 17 2020".
[c_function]
def private format_date(var tm : tm?) : uint8? {
    return format`va(cstr("\"%s %2d %d\""), (addr(format_date_mon[tm.tm_mon][0]), tm.tm_mday, tm.tm_year + 1900))
}

// __TIME__ is expanded to the current time, e.g. "13:34:03".
def private format_time(var tm : tm?) : uint8? {
    return format`va(cstr("\"%02d:%02d:%02d\""), (tm.tm_hour, tm.tm_min, tm.tm_sec))
}

