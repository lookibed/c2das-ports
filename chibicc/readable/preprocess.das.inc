[c_function]
def private getStringKind(var tok : Token?) : StringKind {
    if (crt::strcmp(tok.loc, cstr("u8")) == 0) {
        return StringKind.STR_UTF8
    }
    c_switch(int(tok.loc[0])) {
        case('"') {
            return StringKind.STR_NONE
        }
        case('u') {
            return StringKind.STR_UTF16
        }
        case('U') {
            return StringKind.STR_UTF32
        }
        case('L') {
            return StringKind.STR_WIDE
        }
    }
    error`va(cstr("internal error at %s:%d"), (cstr("/root/wt-chibicc-pub/chibicc/fetch/chibicc/preprocess.c"), 1123))
    return StringKind.STR_NONE
}

// Concatenate adjacent string literals into a single string literal
// as per the C spec.
[c_function]
def private join_adjacent_string_literals(var tok : Token?) {
    // First pass: If regular string literals are adjacent to wide
    // string literals, regular string literals are converted to a wide
    // type before concatenation. In this pass, we do the conversion.
    {
        var tok1 : Token? = tok
        while (tok1.kind != TokenKind.TK_EOF) {
            if (tok1.kind != TokenKind.TK_STR || tok1.next.kind != TokenKind.TK_STR) {
                tok1 = tok1.next
                continue
            }
            var kind : StringKind = getStringKind(tok1)
            var basety : Type? = tok1.ty.base
            {
                var t : Token? = tok1.next
                while (t.kind == TokenKind.TK_STR) {
                    let k : StringKind = getStringKind(t)
                    if (kind == StringKind.STR_NONE) {
                        kind = k
                        basety = t.ty.base
                    } elif (k != StringKind.STR_NONE && kind != k) {
                        error_tok`va(t, cstr("unsupported non-standard concatenation of string literals"), VaNone())
                    }
                    t = t.next
                }
            }
            if (basety.size > 1) {
                {
                    var t : Token? = tok1
                    while (t.kind == TokenKind.TK_STR) {
                        if (t.ty.base.size == 1) {
                            *t = *tokenize_string_literal(t, basety)
                        }
                        t = t.next
                    }
                }
            }
            while (tok1.kind == TokenKind.TK_STR) {
                tok1 = tok1.next
            }
        }
    }
    // Second pass: concatenate adjacent string literals.
    {
        var tok1 : Token? = tok
        while (tok1.kind != TokenKind.TK_EOF) {
            if (tok1.kind != TokenKind.TK_STR || tok1.next.kind != TokenKind.TK_STR) {
                tok1 = tok1.next
                continue
            }
            var tok2 : Token? = tok1.next
            while (tok2.kind == TokenKind.TK_STR) {
                tok2 = tok2.next
            }
            var len : int = tok1.ty.array_len
            {
                var t : Token? = tok1.next
                while (t != tok2) {
                    len = len + t.ty.array_len - 1
                    t = t.next
                }
            }
            var buf : uint8? = reinterpret<uint8?>(crt::calloc(uint64(tok1.ty.base.size), uint64(len)))
            var i : int = 0
            {
                var t : Token? = tok1
                while (t != tok2) {
                    crt::memcpy(reinterpret<void?>(buf + i), reinterpret<void?>(t.str), uint64(t.ty.size))
                    i = i + t.ty.size - t.ty.base.size
                    t = t.next
                }
            }
            *tok1 = *copy_token(tok1)
            tok1.ty = array_of(tok1.ty.base, len)
            tok1.str = buf
            tok1.next = tok2
            tok1 = tok2
        }
    }
}

// Entry point function of the preprocessor.
def preprocess(var tok : Token?) : Token? {
    tok = preprocess2(tok)
    if (cond_incl != null) {
        error_tok`va(cond_incl.tok, cstr("unterminated conditional directive"), VaNone())
    }
    convert_pp_tokens(tok)
    join_adjacent_string_literals(tok)
    {
        var t : Token? = tok
        while (t != null) {
            t.line_no += t.line_delta
            t = t.next
        }
    }
    return tok
}

