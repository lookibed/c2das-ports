                    if (depth == 0) {
                    } else {
                        c_assert_fail(cstr("depth == 0"), cstr("/root/wt-chibicc-pub/chibicc/fetch/chibicc/codegen.c"), 1568u, cstr("void emit_text(Obj *)"))
