                                        fp++
                                        store_fp(_t1, _c_var.offset, 8 < ty.size ? 8 : ty.size)
                                    } else {
                                        let _t2 = gp
                                        gp++
                                        store_gp(_t2, _c_var.offset, 8 < ty.size ? 8 : ty.size)
                                    }
                                    if (ty.size > 8) {
                                        if (has_flonum(ty, 8, 16, 0)) {
                                            let _t3 = fp
                                            fp++
                                            store_fp(_t3, _c_var.offset + 8, ty.size - 8)
                                        } else {
                                            let _t4 = gp
                                            gp++
                                            store_gp(_t4, _c_var.offset + 8, ty.size - 8)
                                        }
                                    }
                                    break
                                }
                                case(TypeKind.TY_FLOAT, TypeKind.TY_DOUBLE) {
                                    let _t5 = fp
                                    fp++
                                    store_fp(_t5, _c_var.offset, ty.size)
