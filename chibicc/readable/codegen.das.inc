                    println`va(cstr("  movsd %%xmm3, %d(%%rbp)"), (off + 96,))
                    println`va(cstr("  movsd %%xmm4, %d(%%rbp)"), (off + 104,))
                    println`va(cstr("  movsd %%xmm5, %d(%%rbp)"), (off + 112,))
                    println`va(cstr("  movsd %%xmm6, %d(%%rbp)"), (off + 120,))
