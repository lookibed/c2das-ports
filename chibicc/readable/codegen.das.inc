[c_function]
def codegen(var prog : Obj?; var out : _IO_FILE?) {
    codegen_output_file = out
    var files : File ?? = get_input_files()
    {
        var i : int = 0
        while (files[i] != null) {
            println`va(cstr("  .file %d \"%s\""), (files[i].file_no, files[i].name))
            i++
        }
    }
    assign_lvar_offsets(prog)
    emit_data(prog)
    emit_text(prog)
}

