// Structs or unions equal or smaller than 16 bytes are passed
// using up to two registers.
// If the first 8 bytes contains only floating-point type members,
// they are passed in an XMM register. Otherwise, they are passed
// in a general-purpose register.
// If a struct/union is larger than 8 bytes, the same rule is
// applied to the the next 8 byte chunk.
// This function returns true if `ty` has only floating-point
// members in its byte range [lo, hi).
def private has_flonum(var ty : Type?; lo : int; hi : int; offset : int) : bool {
    if (ty.kind == TypeKind.TY_STRUCT || ty.kind == TypeKind.TY_UNION) {
        {
            var mem : Member? = ty.members
            while (mem != null) {
                if (!has_flonum(mem.ty, lo, hi, offset + mem.offset)) {
                    return 0 != 0
                }
                mem = mem.next
            }
        }
        return 1 != 0
    }
    if (ty.kind == TypeKind.TY_ARRAY) {
        for (i in range(ty.array_len)) {
            if (!has_flonum(ty.base, lo, hi, offset + ty.base.size * i)) {
                return 0 != 0
            }
        }
        return 1 != 0
    }
    return offset < lo || hi <= offset || ty.kind == TypeKind.TY_FLOAT || ty.kind == TypeKind.TY_DOUBLE
}

def private has_flonum1(var ty : Type?) : bool {
    return has_flonum(ty, 0, 8, 0)
}

def private has_flonum2(var ty : Type?) : bool {
    return has_flonum(ty, 8, 16, 0)
}

def private push_struct(var ty : Type?) {
    let sz : int = align_to(ty.size, 8)
    println`va(cstr("  sub $%d, %%rsp"), (sz,))
    depth += sz / 8
    {
        var i : int = 0
        while (i < ty.size) {
            println`va(cstr("  mov %d(%%rax), %%r10b"), (i,))
            println`va(cstr("  mov %%r10b, %d(%%rsp)"), (i,))
            i++
        }
    }
}

def private push_args2(var args : Node?; first_pass : bool) {
    if (args == null) {
        return
    }
    push_args2(args.next, first_pass)
    if ((first_pass && !args.pass_by_stack) || (!first_pass && args.pass_by_stack)) {
        return
    }
    gen_expr(args)
    c_switch(args.ty.kind) {
        case(TypeKind.TY_STRUCT, TypeKind.TY_UNION) {
            push_struct(args.ty)
            break
        }
        case(TypeKind.TY_FLOAT, TypeKind.TY_DOUBLE) {
            pushf()
            break
        }
        case(TypeKind.TY_LDOUBLE) {
            println`va(cstr("  sub $16, %%rsp"), VaNone())
            println`va(cstr("  fstpt (%%rsp)"), VaNone())
            depth += 2
            break
        }
        case(_) {
            push()
        }
    }
}

// Load function call arguments. Arguments are already evaluated and
// stored to the stack as local variables. What we need to do in this
// function is to load them to registers or push them to the stack as
// specified by the x86-64 psABI. Here is what the spec says:
// - Up to 6 arguments of integral type are passed using RDI, RSI,
// RDX, RCX, R8 and R9.
// - Up to 8 arguments of floating-point type are passed using XMM0 to
// XMM7.
// - If all registers of an appropriate type are already used, push an
// argument to the stack in the right-to-left order.
// - Each argument passed on the stack takes 8 bytes, and the end of
// the argument area must be aligned to a 16 byte boundary.
// - If a function is variadic, set the number of floating-point type
// arguments to RAX.
def private push_args(var node : Node?) : int {
    var stack : int = 0
    var gp : int = 0
    var fp : int = 0
    // If the return type is a large struct/union, the caller passes
    // a pointer to a buffer as if it were the first argument.
    if (node.ret_buffer != null && node.ty.size > 16) {
        gp++
    }
    // Load as many arguments to the registers as possible.
    {
        var arg : Node? = node.args
        while (arg != null) {
            var ty : Type? = arg.ty
            c_switch(ty.kind) {
                case(TypeKind.TY_STRUCT, TypeKind.TY_UNION) {
                    if (ty.size > 16) {
                        arg.pass_by_stack = 1 != 0
                        stack += align_to(ty.size, 8) / 8
                    } else {
                        let fp1 : bool = has_flonum1(ty)
                        let fp2 : bool = has_flonum2(ty)
                        if (fp + int_of(fp1) + int_of(fp2) < FP_MAX && gp + int_of(!fp1) + int_of(!fp2) < GP_MAX) {
                            fp = fp + int_of(fp1) + int_of(fp2)
                            gp = gp + int_of(!fp1) + int_of(!fp2)
                        } else {
                            arg.pass_by_stack = 1 != 0
                            stack += align_to(ty.size, 8) / 8
                        }
                    }
                    break
                }
                case(TypeKind.TY_FLOAT, TypeKind.TY_DOUBLE) {
                    let _t0 = fp
                    fp++
                    if (_t0 >= FP_MAX) {
                        arg.pass_by_stack = 1 != 0
                        stack++
                    }
                    break
                }
                case(TypeKind.TY_LDOUBLE) {
                    arg.pass_by_stack = 1 != 0
                    stack += 2
                    break
                }
                case(_) {
                    let _t1 = gp
                    gp++
                    if (_t1 >= GP_MAX) {
                        arg.pass_by_stack = 1 != 0
                        stack++
                    }
                }
            }
            arg = arg.next
        }
    }
    if ((depth + stack) % 2 == 1) {
        println`va(cstr("  sub $8, %%rsp"), VaNone())
        depth++
        stack++
    }
    push_args2(node.args, 1 != 0)
    push_args2(node.args, 0 != 0)
    // If the return type is a large struct/union, the caller passes
    // a pointer to a buffer as if it were the first argument.
    if (node.ret_buffer != null && node.ty.size > 16) {
        println`va(cstr("  lea %d(%%rbp), %%rax"), (node.ret_buffer.offset,))
        push()
    }
    return stack
}

