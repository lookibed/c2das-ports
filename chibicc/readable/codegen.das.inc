                println`va(cstr("  mov $%d, %%rax"), (fp,))
                println`va(cstr("  call *%%r10"), VaNone())
                println`va(cstr("  add $%d, %%rsp"), (stack_args * 8,))
                depth -= stack_args
                // It looks like the most significant 48 or 56 bits in RAX may
                // contain garbage if a function return type is short or bool/char,
                // respectively. We clear the upper bits here.
                c_switch(node.ty.kind) {
                    case(TypeKind.TY_BOOL) {
                        println`va(cstr("  movzx %%al, %%eax"), VaNone())
                        return
                    }
                    case(TypeKind.TY_CHAR) {
                        if (node.ty.is_unsigned) {
                            println`va(cstr("  movzbl %%al, %%eax"), VaNone())
                        } else {
                            println`va(cstr("  movsbl %%al, %%eax"), VaNone())
                        }
                        return
                    }
                    case(TypeKind.TY_SHORT) {
                        if (node.ty.is_unsigned) {
                            println`va(cstr("  movzwl %%ax, %%eax"), VaNone())
                        } else {
                            println`va(cstr("  movswl %%ax, %%eax"), VaNone())
                        }
                        return
                    }
                }
                // If the return type is a small struct, a value is returned
                // using up to two registers.
                if (node.ret_buffer != null && node.ty.size <= 16) {
                    copy_ret_buffer(node.ret_buffer)
                    println`va(cstr("  lea %d(%%rbp), %%rax"), (node.ret_buffer.offset,))
                }
                return
            }
        }
        case(NodeKind.ND_LABEL_VAL) {
            println`va(cstr("  lea %s(%%rip), %%rax"), (node.unique_label,))
            return
        }
        case(NodeKind.ND_CAS) {
            {
                gen_expr(node.cas_addr)
                push()
                gen_expr(node.cas_new)
                push()
                gen_expr(node.cas_old)
                println`va(cstr("  mov %%rax, %%r8"), VaNone())
                load(node.cas_old.ty.base)
                // new
                pop(cstr("%rdx"))
                // addr
                pop(cstr("%rdi"))
                let sz : int = node.cas_addr.ty.base.size
                println`va(cstr("  lock cmpxchg %s, (%%rdi)"), (reg_dx(sz),))
                println`va(cstr("  sete %%cl"), VaNone())
                println`va(cstr("  je 1f"), VaNone())
                println`va(cstr("  mov %s, (%%r8)"), (reg_ax(sz),))
                println`va(cstr("1:"), VaNone())
                println`va(cstr("  movzbl %%cl, %%eax"), VaNone())
                return
            }
        }
        case(NodeKind.ND_EXCH) {
            {
                gen_expr(node.lhs)
                push()
                gen_expr(node.rhs)
                pop(cstr("%rdi"))
                let sz : int = node.lhs.ty.base.size
                println`va(cstr("  xchg %s, (%%rdi)"), (reg_ax(sz),))
                return
            }
        }
    }
    c_switch(node.lhs.ty.kind) {
        case(TypeKind.TY_FLOAT, TypeKind.TY_DOUBLE) {
            {
                gen_expr(node.rhs)
                pushf()
                gen_expr(node.lhs)
                popf(1)
                var sz : uint8? = (node.lhs.ty.kind == TypeKind.TY_FLOAT) ? cstr("ss") : cstr("sd")
                c_switch(node.kind) {
                    case(NodeKind.ND_ADD) {
                        println`va(cstr("  add%s %%xmm1, %%xmm0"), (sz,))
                        return
                    }
                    case(NodeKind.ND_SUB) {
                        println`va(cstr("  sub%s %%xmm1, %%xmm0"), (sz,))
                        return
                    }
                    case(NodeKind.ND_MUL) {
                        println`va(cstr("  mul%s %%xmm1, %%xmm0"), (sz,))
                        return
                    }
                    case(NodeKind.ND_DIV) {
                        println`va(cstr("  div%s %%xmm1, %%xmm0"), (sz,))
                        return
                    }
                    case(NodeKind.ND_EQ, NodeKind.ND_NE, NodeKind.ND_LT, NodeKind.ND_LE) {
                        println`va(cstr("  ucomi%s %%xmm0, %%xmm1"), (sz,))
                        if (node.kind == NodeKind.ND_EQ) {
                            println`va(cstr("  sete %%al"), VaNone())
                            println`va(cstr("  setnp %%dl"), VaNone())
                            println`va(cstr("  and %%dl, %%al"), VaNone())
                        } elif (node.kind == NodeKind.ND_NE) {
                            println`va(cstr("  setne %%al"), VaNone())
                            println`va(cstr("  setp %%dl"), VaNone())
                            println`va(cstr("  or %%dl, %%al"), VaNone())
                        } elif (node.kind == NodeKind.ND_LT) {
                            println`va(cstr("  seta %%al"), VaNone())
                        } else {
                            println`va(cstr("  setae %%al"), VaNone())
                        }
                        println`va(cstr("  and $1, %%al"), VaNone())
                        println`va(cstr("  movzb %%al, %%rax"), VaNone())
                        return
                    }
                }
                error_tok`va(node.tok, cstr("invalid expression"), VaNone())
            }
        }
        case(TypeKind.TY_LDOUBLE) {
            gen_expr(node.lhs)
            gen_expr(node.rhs)
            c_switch(node.kind) {
                case(NodeKind.ND_ADD) {
                    println`va(cstr("  faddp"), VaNone())
                    return
                }
                case(NodeKind.ND_SUB) {
                    println`va(cstr("  fsubrp"), VaNone())
                    return
                }
                case(NodeKind.ND_MUL) {
                    println`va(cstr("  fmulp"), VaNone())
                    return
                }
                case(NodeKind.ND_DIV) {
                    println`va(cstr("  fdivrp"), VaNone())
                    return
                }
                case(NodeKind.ND_EQ, NodeKind.ND_NE, NodeKind.ND_LT, NodeKind.ND_LE) {
                    println`va(cstr("  fcomip"), VaNone())
                    println`va(cstr("  fstp %%st(0)"), VaNone())
                    if (node.kind == NodeKind.ND_EQ) {
                        println`va(cstr("  sete %%al"), VaNone())
                    } elif (node.kind == NodeKind.ND_NE) {
                        println`va(cstr("  setne %%al"), VaNone())
                    } elif (node.kind == NodeKind.ND_LT) {
                        println`va(cstr("  seta %%al"), VaNone())
                    } else {
                        println`va(cstr("  setae %%al"), VaNone())
                    }
                    println`va(cstr("  movzb %%al, %%rax"), VaNone())
                    return
                }
            }
            error_tok`va(node.tok, cstr("invalid expression"), VaNone())
        }
    }
    gen_expr(node.rhs)
    push()
    gen_expr(node.lhs)
    pop(cstr("%rdi"))
    var ax : uint8?
    var di : uint8?
    var dx : uint8?
    if (node.lhs.ty.kind == TypeKind.TY_LONG || node.lhs.ty.base != null) {
        ax = cstr("%rax")
        di = cstr("%rdi")
        dx = cstr("%rdx")
    } else {
        ax = cstr("%eax")
        di = cstr("%edi")
        dx = cstr("%edx")
    }
    c_switch(node.kind) {
        case(NodeKind.ND_ADD) {
            println`va(cstr("  add %s, %s"), (di, ax))
            return
        }
        case(NodeKind.ND_SUB) {
            println`va(cstr("  sub %s, %s"), (di, ax))
            return
        }
        case(NodeKind.ND_MUL) {
            println`va(cstr("  imul %s, %s"), (di, ax))
            return
        }
        case(NodeKind.ND_DIV, NodeKind.ND_MOD) {
            if (node.ty.is_unsigned) {
                println`va(cstr("  mov $0, %s"), (dx,))
                println`va(cstr("  div %s"), (di,))
            } else {
                if (node.lhs.ty.size == 8) {
                    println`va(cstr("  cqo"), VaNone())
                } else {
                    println`va(cstr("  cdq"), VaNone())
                }
                println`va(cstr("  idiv %s"), (di,))
            }
            if (node.kind == NodeKind.ND_MOD) {
                println`va(cstr("  mov %%rdx, %%rax"), VaNone())
            }
            return
        }
        case(NodeKind.ND_BITAND) {
            println`va(cstr("  and %s, %s"), (di, ax))
            return
        }
        case(NodeKind.ND_BITOR) {
            println`va(cstr("  or %s, %s"), (di, ax))
            return
        }
        case(NodeKind.ND_BITXOR) {
            println`va(cstr("  xor %s, %s"), (di, ax))
            return
        }
        case(NodeKind.ND_EQ, NodeKind.ND_NE, NodeKind.ND_LT, NodeKind.ND_LE) {
            println`va(cstr("  cmp %s, %s"), (di, ax))
            if (node.kind == NodeKind.ND_EQ) {
                println`va(cstr("  sete %%al"), VaNone())
            } elif (node.kind == NodeKind.ND_NE) {
                println`va(cstr("  setne %%al"), VaNone())
            } elif (node.kind == NodeKind.ND_LT) {
                if (node.lhs.ty.is_unsigned) {
                    println`va(cstr("  setb %%al"), VaNone())
                } else {
                    println`va(cstr("  setl %%al"), VaNone())
                }
            } elif (node.kind == NodeKind.ND_LE) {
                if (node.lhs.ty.is_unsigned) {
                    println`va(cstr("  setbe %%al"), VaNone())
                } else {
                    println`va(cstr("  setle %%al"), VaNone())
                }
            }
            println`va(cstr("  movzb %%al, %%rax"), VaNone())
            return
        }
        case(NodeKind.ND_SHL) {
            println`va(cstr("  mov %%rdi, %%rcx"), VaNone())
            println`va(cstr("  shl %%cl, %s"), (ax,))
            return
        }
        case(NodeKind.ND_SHR) {
            println`va(cstr("  mov %%rdi, %%rcx"), VaNone())
            if (node.lhs.ty.is_unsigned) {
                println`va(cstr("  shr %%cl, %s"), (ax,))
            } else {
                println`va(cstr("  sar %%cl, %s"), (ax,))
            }
            return
        }
    }
    error_tok`va(node.tok, cstr("invalid expression"), VaNone())
}

def private gen_stmt(var node : Node?) {
    println`va(cstr("  .loc %d %d"), (node.tok.file.file_no, node.tok.line_no))
    c_switch(node.kind) {
        case(NodeKind.ND_IF) {
            {
                let c : int = count1()
                gen_expr(node.cond)
                cmp_zero(node.cond.ty)
                println`va(cstr("  je  .L.else.%d"), (c,))
                gen_stmt(node.then)
                println`va(cstr("  jmp .L.end.%d"), (c,))
                println`va(cstr(".L.else.%d:"), (c,))
                if (node.els != null) {
                    gen_stmt(node.els)
                }
                println`va(cstr(".L.end.%d:"), (c,))
                return
            }
        }
        case(NodeKind.ND_FOR) {
            {
                let c : int = count1()
                if (node.init != null) {
                    gen_stmt(node.init)
                }
                println`va(cstr(".L.begin.%d:"), (c,))
                if (node.cond != null) {
                    gen_expr(node.cond)
                    cmp_zero(node.cond.ty)
                    println`va(cstr("  je %s"), (node.brk_label,))
                }
                gen_stmt(node.then)
                println`va(cstr("%s:"), (node.cont_label,))
                if (node.inc != null) {
                    gen_expr(node.inc)
                }
                println`va(cstr("  jmp .L.begin.%d"), (c,))
                println`va(cstr("%s:"), (node.brk_label,))
                return
            }
        }
        case(NodeKind.ND_DO) {
            {
                let c : int = count1()
                println`va(cstr(".L.begin.%d:"), (c,))
                gen_stmt(node.then)
                println`va(cstr("%s:"), (node.cont_label,))
                gen_expr(node.cond)
                cmp_zero(node.cond.ty)
                println`va(cstr("  jne .L.begin.%d"), (c,))
                println`va(cstr("%s:"), (node.brk_label,))
                return
            }
        }
        case(NodeKind.ND_SWITCH) {
            gen_expr(node.cond)
            {
                var n : Node? = node.case_next
                while (n != null) {
                    {
                        var ax : uint8? = (node.cond.ty.size == 8) ? cstr("%rax") : cstr("%eax")
                        var di : uint8? = (node.cond.ty.size == 8) ? cstr("%rdi") : cstr("%edi")
                        if (n.begin == n.end) {
                            println`va(cstr("  cmp $%ld, %s"), (n.begin, ax))
                            println`va(cstr("  je %s"), (n._c_label,))
                            continue
                        }
                        // [GNU] Case ranges
                        println`va(cstr("  mov %s, %s"), (ax, di))
                        println`va(cstr("  sub $%ld, %s"), (n.begin, di))
                        println`va(cstr("  cmp $%ld, %s"), (n.end - n.begin, di))
                        println`va(cstr("  jbe %s"), (n._c_label,))
                    } finally {
                        n = n.case_next
                    }
                }
            }
            if (node.default_case != null) {
                println`va(cstr("  jmp %s"), (node.default_case._c_label,))
            }
            println`va(cstr("  jmp %s"), (node.brk_label,))
            gen_stmt(node.then)
            println`va(cstr("%s:"), (node.brk_label,))
            return
        }
        case(NodeKind.ND_CASE) {
            println`va(cstr("%s:"), (node._c_label,))
            gen_stmt(node.lhs)
            return
        }
        case(NodeKind.ND_BLOCK) {
            {
                var n : Node? = node.body
                while (n != null) {
                    gen_stmt(n)
                    n = n.next
                }
            }
            return
        }
        case(NodeKind.ND_GOTO) {
            println`va(cstr("  jmp %s"), (node.unique_label,))
            return
        }
        case(NodeKind.ND_GOTO_EXPR) {
            gen_expr(node.lhs)
            println`va(cstr("  jmp *%%rax"), VaNone())
            return
        }
        case(NodeKind.ND_LABEL) {
            println`va(cstr("%s:"), (node.unique_label,))
            gen_stmt(node.lhs)
            return
        }
        case(NodeKind.ND_RETURN) {
            if (node.lhs != null) {
                gen_expr(node.lhs)
                var ty : Type? = node.lhs.ty
                c_switch(ty.kind) {
                    case(TypeKind.TY_STRUCT, TypeKind.TY_UNION) {
                        if (ty.size <= 16) {
                            copy_struct_reg()
                        } else {
                            copy_struct_mem()
                        }
                        break
                    }
                }
            }
            println`va(cstr("  jmp .L.return.%s"), (codegen_current_fn.name,))
            return
        }
        case(NodeKind.ND_EXPR_STMT) {
            gen_expr(node.lhs)
            return
        }
        case(NodeKind.ND_ASM) {
            println`va(cstr("  %s"), (node.asm_str,))
            return
        }
    }
    error_tok`va(node.tok, cstr("invalid statement"), VaNone())
}

// Assign offsets to local variables.
def private assign_lvar_offsets(var prog : Obj?) {
    {
        var fn : Obj? = prog
        while (fn != null) {
            {
                if (!fn.is_function) {
                    continue
                }
                // If a function has many parameters, some parameters are
                // inevitably passed by stack rather than by register.
                // The first passed-by-stack parameter resides at RBP+16.
                var top : int = 16
                var bottom : int = 0
                var gp : int = 0
                var fp : int = 0
                // Assign offsets to pass-by-stack parameters.
                {
                    var _c_var : Obj? = fn.params
                    while (_c_var != null) {
                        {
                            var ty : Type? = _c_var.ty
                            c_switch(ty.kind) {
                                case(TypeKind.TY_STRUCT, TypeKind.TY_UNION) {
                                    if (ty.size <= 16) {
                                        let fp1 : bool = has_flonum(ty, 0, 8, 0)
                                        let fp2 : bool = has_flonum(ty, 8, 16, 8)
                                        if (fp + int_of(fp1) + int_of(fp2) < FP_MAX && gp + int_of(!fp1) + int_of(!fp2) < GP_MAX) {
                                            fp = fp + int_of(fp1) + int_of(fp2)
                                            gp = gp + int_of(!fp1) + int_of(!fp2)
                                            continue
                                        }
                                    }
                                    break
                                }
                                case(TypeKind.TY_FLOAT, TypeKind.TY_DOUBLE) {
                                    let _t0 = fp
                                    fp++
                                    if (_t0 < FP_MAX) {
                                        continue
                                    }
                                    break
                                }
                                case(TypeKind.TY_LDOUBLE) {
                                    break
                                }
                                case(_) {
                                    let _t1 = gp
                                    gp++
                                    if (_t1 < GP_MAX) {
                                        continue
                                    }
                                }
                            }
                            top = align_to(top, 8)
                            _c_var.offset = top
                            top += _c_var.ty.size
                        } finally {
                            _c_var = _c_var.next
                        }
                    }
                }
                // Assign offsets to pass-by-register parameters and local variables.
                {
                    var _c_var : Obj? = fn.locals
                    while (_c_var != null) {
                        {
                            if (_c_var.offset != 0) {
                                continue
                            }
                            // AMD64 System V ABI has a special alignment rule for an array of
                            // length at least 16 bytes. We need to align such array to at least
                            // 16-byte boundaries. See p.14 of
                            // https://github.com/hjl-tools/x86-psABI/wiki/x86-64-psABI-draft.pdf.
                            let align : int = (_c_var.ty.kind == TypeKind.TY_ARRAY && _c_var.ty.size >= 16) ? (16 < _c_var.align ? _c_var.align :
                                    16) : _c_var.align
                            bottom += _c_var.ty.size
                            bottom = align_to(bottom, align)
                            _c_var.offset = -bottom
                        } finally {
                            _c_var = _c_var.next
                        }
                    }
                }
                fn.stack_size = align_to(bottom, 16)
            } finally {
                fn = fn.next
            }
        }
    }
}

[c_function]
def private emit_data(var prog : Obj?) {
    {
        var _c_var : Obj? = prog
        while (_c_var != null) {
            {
                if (_c_var.is_function || !_c_var.is_definition) {
                    continue
                }
                if (_c_var.is_static) {
                    println`va(cstr("  .local %s"), (_c_var.name,))
                } else {
                    println`va(cstr("  .globl %s"), (_c_var.name,))
                }
                let align : int = (_c_var.ty.kind == TypeKind.TY_ARRAY && _c_var.ty.size >= 16) ? (16 < _c_var.align ? _c_var.align : 16) : _c_var.align
                // Common symbol
                if (opt_fcommon && _c_var.is_tentative) {
                    println`va(cstr("  .comm %s, %d, %d"), (_c_var.name, _c_var.ty.size, align))
                    continue
                }
                // .data or .tdata
                if (_c_var.init_data != null) {
                    if (_c_var.is_tls) {
                        println`va(cstr("  .section .tdata,\"awT\",@progbits"), VaNone())
                    } else {
                        println`va(cstr("  .data"), VaNone())
                    }
                    println`va(cstr("  .type %s, @object"), (_c_var.name,))
                    println`va(cstr("  .size %s, %d"), (_c_var.name, _c_var.ty.size))
                    println`va(cstr("  .align %d"), (align,))
                    println`va(cstr("%s:"), (_c_var.name,))
                    var rel : Relocation? = _c_var.rel
                    var pos : int = 0
                    while (pos < _c_var.ty.size) {
                        if (rel != null && rel.offset == pos) {
                            println`va(cstr("  .quad %s%+ld"), (*rel._c_label, rel.addend))
                            rel = rel.next
                            pos += 8
                        } else {
                            let _t0 = pos
                            pos++
                            println`va(cstr("  .byte %d"), (int(_c_var.init_data[_t0]),))
                        }
                    }
                    continue
                }
                // .bss or .tbss
                if (_c_var.is_tls) {
                    println`va(cstr("  .section .tbss,\"awT\",@nobits"), VaNone())
                } else {
                    println`va(cstr("  .bss"), VaNone())
                }
                println`va(cstr("  .align %d"), (align,))
                println`va(cstr("%s:"), (_c_var.name,))
                println`va(cstr("  .zero %d"), (_c_var.ty.size,))
            } finally {
                _c_var = _c_var.next
            }
        }
    }
}

def private store_fp(r : int; offset : int; sz : int) {
    c_switch(sz) {
        case(4) {
            println`va(cstr("  movss %%xmm%d, %d(%%rbp)"), (r, offset))
            return
        }
        case(8) {
            println`va(cstr("  movsd %%xmm%d, %d(%%rbp)"), (r, offset))
            return
        }
    }
    error`va(cstr("internal error at %s:%d"), (cstr("/root/wt-chibicc-pub/chibicc/fetch/chibicc/codegen.c"), 1444))
}

def private store_gp(r : int; offset : int; sz : int) {
    c_switch(sz) {
        case(1) {
            println`va(cstr("  mov %s, %d(%%rbp)"), (argreg8[r], offset))
            return
        }
        case(2) {
            println`va(cstr("  mov %s, %d(%%rbp)"), (argreg16[r], offset))
            return
        }
        case(4) {
            println`va(cstr("  mov %s, %d(%%rbp)"), (argreg32[r], offset))
            return
        }
        case(8) {
            println`va(cstr("  mov %s, %d(%%rbp)"), (argreg64[r], offset))
            return
        }
        case(_) {
            for (i in range(sz)) {
                println`va(cstr("  mov %s, %d(%%rbp)"), (argreg8[r], offset + i))
                println`va(cstr("  shr $8, %s"), (argreg64[r],))
            }
            return
        }
    }
}

[c_function]
def private emit_text(var prog : Obj?) {
    {
        var fn : Obj? = prog
        while (fn != null) {
            {
                if (!fn.is_function || !fn.is_definition) {
                    continue
                }
                // No code is emitted for "static inline" functions
                // if no one is referencing them.
                if (!fn.is_live) {
                    continue
                }
                if (fn.is_static) {
                    println`va(cstr("  .local %s"), (fn.name,))
                } else {
                    println`va(cstr("  .globl %s"), (fn.name,))
                }
                println`va(cstr("  .text"), VaNone())
                println`va(cstr("  .type %s, @function"), (fn.name,))
                println`va(cstr("%s:"), (fn.name,))
                codegen_current_fn = fn
                // Prologue
                println`va(cstr("  push %%rbp"), VaNone())
                println`va(cstr("  mov %%rsp, %%rbp"), VaNone())
                println`va(cstr("  sub $%d, %%rsp"), (fn.stack_size,))
                println`va(cstr("  mov %%rsp, %d(%%rbp)"), (fn.alloca_bottom.offset,))
                // Save arg registers if function is variadic
                if (fn.va_area != null) {
                    var gp : int = 0
                    var fp : int = 0
                    {
                        var _c_var : Obj? = fn.params
                        while (_c_var != null) {
                            if (is_flonum(_c_var.ty)) {
                                fp++
                            } else {
                                gp++
                            }
                            _c_var = _c_var.next
                        }
                    }
                    let off : int = fn.va_area.offset
                    // va_elem
                    // gp_offset
                    println`va(cstr("  movl $%d, %d(%%rbp)"), (gp * 8, off))
                    // fp_offset
                    println`va(cstr("  movl $%d, %d(%%rbp)"), (fp * 8 + 48, off + 4))
                    // overflow_arg_area
                    println`va(cstr("  movq %%rbp, %d(%%rbp)"), (off + 8,))
                    println`va(cstr("  addq $16, %d(%%rbp)"), (off + 8,))
                    // reg_save_area
                    println`va(cstr("  movq %%rbp, %d(%%rbp)"), (off + 16,))
                    println`va(cstr("  addq $%d, %d(%%rbp)"), (off + 24, off + 16))
                    // __reg_save_area__
                    println`va(cstr("  movq %%rdi, %d(%%rbp)"), (off + 24,))
                    println`va(cstr("  movq %%rsi, %d(%%rbp)"), (off + 32,))
                    println`va(cstr("  movq %%rdx, %d(%%rbp)"), (off + 40,))
                    println`va(cstr("  movq %%rcx, %d(%%rbp)"), (off + 48,))
                    println`va(cstr("  movq %%r8, %d(%%rbp)"), (off + 56,))
                    println`va(cstr("  movq %%r9, %d(%%rbp)"), (off + 64,))
                    println`va(cstr("  movsd %%xmm0, %d(%%rbp)"), (off + 72,))
                    println`va(cstr("  movsd %%xmm1, %d(%%rbp)"), (off + 80,))
