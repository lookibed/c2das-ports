            p += cur.len
            continue
        }
        error_at`va(p, cstr("invalid token"), VaNone())
    }
    cur.next = new_token(TokenKind.TK_EOF, p, p)
    cur = cur.next
    add_line_numbers(head.next)
    return head.next
}

// Returns the contents of a given file.
[c_function]
def private read_file(var path : uint8?) : uint8? {
    var fp : _IO_FILE?
    if (crt::strcmp(path, cstr("-")) == 0) {
        // By convention, read from stdin if a given filename is "-".
        fp = reinterpret<_IO_FILE?>(crt::c_stdin())
    } else {
        fp = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("r")))
        if (fp == null) {
            return null
        }
    }
    var cap : uint64 = 4096ul
    var buflen : uint64 = 0ul
    var buf : uint8? = reinterpret<uint8?>(crt::malloc(cap + 2ul))
    // Read the entire file.
    while (true) {
        var buf2 : uint8[4096]
        let n : int = int(crt::fread(reinterpret<void?>(addr(buf2[0])), 1ul, uint64(typeinfo sizeof(type<uint8[4096]>)), reinterpret<void?>(fp)))
        if (n == 0) {
            break
        }
        if (buflen + uint64(n) > cap) {
            cap = (buflen + uint64(n)) * 2ul
            buf = reinterpret<uint8?>(crt::realloc(reinterpret<void?>(buf), cap + 2ul))
        }
        crt::memcpy(reinterpret<void?>(buf + buflen), reinterpret<void?>(addr(buf2[0])), uint64(n))
        buflen += uint64(n)
    }
    if (fp != reinterpret<_IO_FILE?>(crt::c_stdin())) {
        crt::fclose(reinterpret<void?>(fp))
    }
    // Make sure that the last line is properly terminated with '\n'.
    if (buflen == 0ul || buf[buflen - 1ul] != '\n') {
        let _t0 = buflen
        buflen++
        buf[_t0] = uint8('\n')
    }
    buf[buflen] = uint8('\0')
    return buf
}

def get_input_files : File ?? {
    return input_files
}

[c_function]
def new_file(var name : uint8?; file_no : int; var contents : uint8?) : File? {
    var file : File? = reinterpret<File?>(crt::calloc(1ul, uint64(typeinfo sizeof(type<File>))))
    file.name = name
    file.display_name = name
    file.file_no = file_no
    file.contents = contents
    return file
}

// Replaces \r or \r\n with \n.
[c_function]
def private canonicalize_newline(var p : uint8?) {
    var i : int = 0
    var j : int = 0
    while (p[i] != 0) {
        if (p[i] == '\r' && p[i + 1] == '\n') {
            i += 2
            let _t0 = j
            j++
            p[_t0] = uint8('\n')
        } elif (p[i] == '\r') {
            i++
            let _t1 = j
            j++
            p[_t1] = uint8('\n')
        } else {
            let _t2 = j
            j++
            let _t3 = i
            i++
            p[_t2] = p[_t3]
        }
    }
    p[j] = uint8('\0')
}

// Removes backslashes followed by a newline.
[c_function]
def private remove_backslash_newline(var p : uint8?) {
    var i : int = 0
    var j : int = 0
    // We want to keep the number of newline characters so that
    // the logical line number matches the physical one.
    // This counter maintain the number of newlines we have removed.
    var n : int = 0
    while (p[i] != 0) {
        if (p[i] == '\\' && p[i + 1] == '\n') {
            i += 2
            n++
        } elif (p[i] == '\n') {
            let _t0 = j
            j++
            let _t1 = i
            i++
            p[_t0] = p[_t1]
            while (n > 0) {
                let _t2 = j
                j++
                p[_t2] = uint8('\n')
                n--
            }
        } else {
            let _t3 = j
            j++
            let _t4 = i
            i++
            p[_t3] = p[_t4]
        }
    }
    while (n > 0) {
        let _t5 = j
        j++
        p[_t5] = uint8('\n')
        n--
    }
    p[j] = uint8('\0')
}

[c_function]
def private read_universal_char(var p : uint8?; len : int) : uint {
    var c : uint = 0u
    for (i in range(len)) {
        if (crt::isxdigit(int(p[i])) == 0) {
            return 0u
        }
        c = (c << 4u) | uint(from_hex(p[i]))
    }
    return c
}

// Replace \u or \U escape sequences with corresponding UTF-8 bytes.
[c_function]
def private convert_universal_chars(var p : uint8?) {
    var q : uint8? = p
    while (*p != 0) {
        if (startswith(p, cstr("\\u"))) {
            let c : uint = read_universal_char(p + 2, 4)
            if (c != 0) {
                p += 6
                q += encode_utf8(q, c)
            } else {
                var _t0 = q
                q++
                var _t1 = p
                p++
                *_t0 = *_t1
            }
        } elif (startswith(p, cstr("\\U"))) {
            let c : uint = read_universal_char(p + 2, 8)
            if (c != 0) {
                p += 10
                q += encode_utf8(q, c)
            } else {
                var _t2 = q
                q++
                var _t3 = p
                p++
                *_t2 = *_t3
            }
        } elif (p[0] == '\\') {
            var _t4 = q
            q++
            var _t5 = p
            p++
            *_t4 = *_t5
            var _t6 = q
            q++
            var _t7 = p
            p++
            *_t6 = *_t7
        } else {
            var _t8 = q
            q++
            var _t9 = p
            p++
            *_t8 = *_t9
        }
    }
    *q = uint8('\0')
}

[c_function]
def tokenize_file(var path : uint8?) : Token? {
    var p : uint8? = read_file(path)
    if (p == null) {
        return null
    }
    // UTF-8 texts may start with a 3-byte "BOM" marker sequence.
    // If exists, just skip them because they are useless bytes.
    // (It is actually not recommended to add BOM markers to UTF-8
    // texts, but it's not uncommon particularly on Windows.)
    if (crt::memcmp(reinterpret<void?>(p), reinterpret<void?>(cstr("\xef\xbb\xbf")), 3ul) == 0) {
        p += 3
    }
    canonicalize_newline(p)
    remove_backslash_newline(p)
    convert_universal_chars(p)
    // Save the filename for assembler .file directive.
    var file : File? = new_file(path, tokenize_file_file_no + 1, p)
    // Save the filename for assembler .file directive.
    input_files = reinterpret<File ??>(crt::realloc(reinterpret<void?>(input_files), uint64(typeinfo sizeof(type<uint8?>)) * uint64(tokenize_file_file_no + 2)))
    input_files[tokenize_file_file_no] = file
    input_files[tokenize_file_file_no + 1] = null
    tokenize_file_file_no++
    return tokenize(file)
}

