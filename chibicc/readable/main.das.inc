def private open_file(var path : uint8?) : _IO_FILE? {
    if (path == null || crt::strcmp(path, cstr("-")) == 0) {
        return reinterpret<_IO_FILE?>(crt::c_stdout())
    }
    var out : _IO_FILE? = reinterpret<_IO_FILE?>(crt::fopen(path, cstr("w")))
    if (out == null) {
        error`va(cstr("cannot open output file: %s: %s"), (path, crt::strerror(*crt::c_errno_location())))
    }
    return out
}

