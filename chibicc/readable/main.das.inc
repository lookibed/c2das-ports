    strarray_push(addr(arr), format`va(cstr("-L%s"), (gcc_libpath,)))
    strarray_push(addr(arr), cstr("-L/usr/lib/x86_64-linux-gnu"))
    strarray_push(addr(arr), cstr("-L/usr/lib64"))
