// Print tokens to stdout. Used for -E.
[c_function]
def private print_tokens(var tok : Token?) {
    var out : _IO_FILE? = open_file(opt_o != null ? opt_o : cstr("-"))
    var line : int = 1
    while (tok.kind != TokenKind.TK_EOF) {
        if (line > 1 && tok.at_bol) {
            fprintf(reinterpret<void?>(out), cstr("\n"))
        }
        if (tok.has_space && !tok.at_bol) {
            fprintf(reinterpret<void?>(out), cstr(" "))
        }
        fprintf(reinterpret<void?>(out), cstr("%.*s"), tok.len, tok.loc)
        line++
        tok = tok.next
    }
    fprintf(reinterpret<void?>(out), cstr("\n"))
}

[c_function]
def private in_std_include_path(var path : uint8?) : bool {
    for (i in range(std_include_paths.len)) {
        var dir : uint8? = std_include_paths.data[i]
        let len : int = int(crt::strlen(dir))
        if (crt::strncmp(dir, path, uint64(len)) == 0 && path[len] == '/') {
            return 1 != 0
        }
    }
    return 0 != 0
}

// If -M options is given, the compiler write a list of input files to
// stdout in a format that "make" command can read. This feature is
// used to automate file dependency management.
[c_function]
def private print_dependencies {
    var path : uint8?
    if (opt_MF != null) {
        path = opt_MF
    } elif (opt_MD) {
        path = replace_extn(opt_o != null ? opt_o : base_file, cstr(".d"))
    } elif (opt_o != null) {
        path = opt_o
    } else {
        path = cstr("-")
    }
    var out : _IO_FILE? = open_file(path)
    if (opt_MT != null) {
        fprintf(reinterpret<void?>(out), cstr("%s:"), opt_MT)
    } else {
        fprintf(reinterpret<void?>(out), cstr("%s:"), quote_makefile(replace_extn(base_file, cstr(".o"))))
    }
    var files : File ?? = get_input_files()
    {
        var i : int = 0
        while (files[i] != null) {
            {
                if (opt_MMD && in_std_include_path(files[i].name)) {
                    continue
                }
                fprintf(reinterpret<void?>(out), cstr(" \\\n  %s"), files[i].name)
            } finally {
                i++
            }
        }
    }
    fprintf(reinterpret<void?>(out), cstr("\n\n"))
    if (opt_MP) {
        {
            var i : int = 1
            while (files[i] != null) {
                {
                    if (opt_MMD && in_std_include_path(files[i].name)) {
                        continue
                    }
                    fprintf(reinterpret<void?>(out), cstr("%s:\n\n"), quote_makefile(files[i].name))
                } finally {
                    i++
                }
            }
        }
    }
}

[c_function]
def private must_tokenize_file(var path : uint8?) : Token? {
    var tok : Token? = tokenize_file(path)
    if (tok == null) {
        error`va(cstr("%s: %s"), (path, crt::strerror(*crt::c_errno_location())))
    }
    return tok
}

def private append_tokens(var tok1 : Token?; var tok2 : Token?) : Token? {
    if (tok1 == null || tok1.kind == TokenKind.TK_EOF) {
        return tok2
    }
    var t : Token? = tok1
    while (t.next.kind != TokenKind.TK_EOF) {
        t = t.next
    }
    t.next = tok2
    return tok1
}

[c_function]
def private cc1 {
    var tok : Token? = null
    // Process -include option
    {
        var i : int = 0
        while (i < opt_include.len) {
            var incl : uint8? = opt_include.data[i]
            var path : uint8?
            if (file_exists(incl)) {
                path = incl
            } else {
                path = search_include_paths(incl)
                if (path == null) {
                    error`va(cstr("-include: %s: %s"), (incl, crt::strerror(*crt::c_errno_location())))
                }
            }
            var tok2 : Token? = must_tokenize_file(path)
            tok = append_tokens(tok, tok2)
            i++
        }
    }
    // Tokenize and parse.
    var tok2 : Token? = must_tokenize_file(base_file)
    tok = append_tokens(tok, tok2)
    tok = preprocess(tok)
    // If -M or -MD are given, print file dependencies.
    if (opt_M || opt_MD) {
        print_dependencies()
        if (opt_M) {
            return
        }
    }
    // If -E is given, print out preprocessed C code as a result.
    if (opt_E) {
        print_tokens(tok)
        return
    }
    var prog : Obj? = parse(tok)
    // Traverse the AST to emit assembly (c2das-re port: straight to the file).
    var out : _IO_FILE? = open_file(main_output_file)
    codegen(prog, out)
    crt::fclose(reinterpret<void?>(out))
}

