    strarray_push(addr(arr), cstr("-L/usr/lib/x86_64-linux-gnu"))
    strarray_push(addr(arr), cstr("-L/usr/lib/x86_64-pc-linux-gnu"))
    strarray_push(addr(arr), cstr("-L/usr/lib/x86_64-redhat-linux"))
    strarray_push(addr(arr), cstr("-L/usr/lib"))
    strarray_push(addr(arr), cstr("-L/lib"))
    if (!opt_static) {
        strarray_push(addr(arr), cstr("-dynamic-linker"))
        strarray_push(addr(arr), cstr("/lib64/ld-linux-x86-64.so.2"))
    }
    {
        var i : int = 0
        while (i < ld_extra_args.len) {
            strarray_push(addr(arr), ld_extra_args.data[i])
            i++
        }
    }
    {
        var i : int = 0
        while (i < inputs.len) {
            strarray_push(addr(arr), inputs.data[i])
            i++
        }
    }
    if (opt_static) {
        strarray_push(addr(arr), cstr("--start-group"))
        strarray_push(addr(arr), cstr("-lgcc"))
        strarray_push(addr(arr), cstr("-lgcc_eh"))
        strarray_push(addr(arr), cstr("-lc"))
        strarray_push(addr(arr), cstr("--end-group"))
    } else {
        strarray_push(addr(arr), cstr("-lc"))
        strarray_push(addr(arr), cstr("-lgcc"))
        strarray_push(addr(arr), cstr("--as-needed"))
        strarray_push(addr(arr), cstr("-lgcc_s"))
        strarray_push(addr(arr), cstr("--no-as-needed"))
    }
    if (opt_shared) {
        strarray_push(addr(arr), format`va(cstr("%s/crtendS.o"), (gcc_libpath,)))
    } else {
        strarray_push(addr(arr), format`va(cstr("%s/crtend.o"), (gcc_libpath,)))
    }
    strarray_push(addr(arr), format`va(cstr("%s/crtn.o"), (libpath,)))
    strarray_push(addr(arr), null)
    run_subprocess(arr.data)
}

def private get_file_type(var filename : uint8?) : FileType {
    if (opt_x != FileType.FILE_NONE) {
        return opt_x
    }
    if (endswith(filename, cstr(".a"))) {
        return FileType.FILE_AR
    }
    if (endswith(filename, cstr(".so"))) {
        return FileType.FILE_DSO
    }
    if (endswith(filename, cstr(".o"))) {
        return FileType.FILE_OBJ
    }
    if (endswith(filename, cstr(".c"))) {
        return FileType.FILE_C
    }
    if (endswith(filename, cstr(".s"))) {
        return FileType.FILE_ASM
    }
    error`va(cstr("<command line>: unknown file extension: %s"), (filename,))
    return FileType.FILE_NONE
}

[c_function]
def c_main(argc : int; var argv : uint8 ??) : int {
    init_macros()
    parse_args(argc, argv)
    if (opt_cc1) {
        add_default_include_paths(argv[0])
        cc1()
        return 0
    }
    if (input_paths.len > 1 && opt_o != null && (opt_c || (int_of(opt_S) | int_of(opt_E)) != 0)) {
        error`va(cstr("cannot specify '-o' with '-c,' '-S' or '-E' with multiple files"), VaNone())
    }
    var ld_args : StringArray = StringArray()
    {
        var i : int = 0
        while (i < input_paths.len) {
            {
                var input : uint8? = input_paths.data[i]
                if (crt::strncmp(input, cstr("-l"), 2ul) == 0) {
                    strarray_push(addr(ld_args), input)
                    continue
                }
                if (crt::strncmp(input, cstr("-Wl,"), 4ul) == 0) {
                    var s : uint8? = crt::strdup(input + 4)
                    var arg : uint8? = host_strtok(s, cstr(","))
                    while (arg != null) {
                        strarray_push(addr(ld_args), arg)
                        arg = host_strtok(null, cstr(","))
                    }
                    continue
                }
                var output : uint8?
                if (opt_o != null) {
                    output = opt_o
                } elif (opt_S) {
                    output = replace_extn(input, cstr(".s"))
                } else {
                    output = replace_extn(input, cstr(".o"))
                }
                let _c_type : FileType = get_file_type(input)
                // Handle .o or .a
                if (_c_type == FileType.FILE_OBJ || _c_type == FileType.FILE_AR || _c_type == FileType.FILE_DSO) {
                    strarray_push(addr(ld_args), input)
                    continue
                }
                // Handle .s
                if (_c_type == FileType.FILE_ASM) {
                    if (!opt_S) {
                        assemble(input, output)
                    }
                    continue
                }
                {
                    let _t0 = uint64(typeinfo sizeof(type<int>))
                    if (_c_type == FileType.FILE_C) {
                    } else {
                        c_assert_fail(cstr("type == FILE_C"), cstr("/root/wt-chibicc-pub/chibicc/fetch/chibicc/main.c"), 725u, cstr("int main(int, char **)"))
                    }
                }
                // Just preprocess
                if (opt_E || opt_M) {
                    run_cc1(argc, argv, input, null)
                    continue
                }
                // Compile
                if (opt_S) {
                    run_cc1(argc, argv, input, output)
                    continue
                }
                // Compile and assemble
                if (opt_c) {
                    var tmp : uint8? = create_tmpfile()
                    run_cc1(argc, argv, input, tmp)
                    assemble(tmp, output)
                    continue
                }
                // Compile, assemble and link
                var tmp1 : uint8? = create_tmpfile()
                var tmp2 : uint8? = create_tmpfile()
                run_cc1(argc, argv, input, tmp1)
                assemble(tmp1, tmp2)
                strarray_push(addr(ld_args), tmp2)
                continue
            } finally {
                i++
            }
        }
    }
    if (ld_args.len > 0) {
        run_linker(addr(ld_args), opt_o != null ? opt_o : cstr("a.out"))
    }
    return 0
}

