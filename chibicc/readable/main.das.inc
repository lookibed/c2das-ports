def private find_libpath : uint8? {
    if (file_exists(cstr("/usr/lib/x86_64-linux-gnu/crti.o"))) {
        return cstr("/usr/lib/x86_64-linux-gnu")
    }
    if (file_exists(cstr("/usr/lib64/crti.o"))) {
        return cstr("/usr/lib64")
    }
    error`va(cstr("library path is not found"), VaNone())
    return null
}

def private find_gcc_libpath : uint8? {
    var paths : uint8? [3] = fixed_array<uint8?>(cstr("/usr/lib/gcc/x86_64-linux-gnu/*/crtbegin.o"), cstr("/usr/lib/gcc/x86_64-pc-linux-gnu/*/crtbegin.o"),
            cstr("/usr/lib/gcc/x86_64-redhat-linux/*/crtbegin.o"))
    // For Gentoo
    // For Fedora
    {
        var i : int = 0
        while (uint64(i) < uint64(typeinfo sizeof(type<uint8? [3]>)) / uint64(typeinfo sizeof(type<uint8?>))) {
            var path : uint8? = find_file(paths[i])
            if (path != null) {
                return host_dirname(path)
            }
            i++
        }
    }
    error`va(cstr("gcc library path is not found"), VaNone())
    return null
}

