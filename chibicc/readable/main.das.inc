def private endswith(var p : uint8?; var q : uint8?) : bool {
    let len1 : int = int(crt::strlen(p))
    let len2 : int = int(crt::strlen(q))
    return (len1 >= len2) && crt::strcmp(p + len1 + -(len2), q) == 0
}

