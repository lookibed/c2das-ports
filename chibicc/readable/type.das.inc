def is_integer(var ty : Type?) : bool {
    let k : TypeKind = ty.kind
    return k == TypeKind.TY_BOOL || k == TypeKind.TY_CHAR || k == TypeKind.TY_SHORT || k == TypeKind.TY_INT || k == TypeKind.TY_LONG || k == TypeKind.TY_ENUM
}

def is_flonum(var ty : Type?) : bool {
    return ty.kind == TypeKind.TY_FLOAT || ty.kind == TypeKind.TY_DOUBLE || ty.kind == TypeKind.TY_LDOUBLE
}

def is_numeric(var ty : Type?) : bool {
    return is_integer(ty) || is_flonum(ty)
}

