        case(NodeKind.ND_ADD, NodeKind.ND_SUB, NodeKind.ND_MUL, NodeKind.ND_DIV, NodeKind.ND_MOD, NodeKind.ND_BITAND, NodeKind.ND_BITOR, NodeKind.ND_BITXOR) {
            usual_arith_conv(addr(node.lhs), addr(node.rhs))
            node.ty = node.lhs.ty
            return
        }
        case(NodeKind.ND_NEG) {
            {
                var ty : Type? = get_common_type(ty_int, node.lhs.ty)
                node.lhs = new_cast(node.lhs, ty)
                node.ty = ty
                return
