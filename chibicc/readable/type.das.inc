                node.rhs = new_cast(node.rhs, node.lhs.ty)
            }
            node.ty = node.lhs.ty
            return
        }
        case(NodeKind.ND_EQ, NodeKind.ND_NE, NodeKind.ND_LT, NodeKind.ND_LE) {
            usual_arith_conv(addr(node.lhs), addr(node.rhs))
            node.ty = ty_int
            return
        }
        case(NodeKind.ND_FUNCALL) {
            node.ty = node.func_ty.return_ty
            return
        }
        case(NodeKind.ND_NOT, NodeKind.ND_LOGOR, NodeKind.ND_LOGAND) {
            node.ty = ty_int
            return
        }
        case(NodeKind.ND_BITNOT, NodeKind.ND_SHL, NodeKind.ND_SHR) {
            node.ty = node.lhs.ty
            return
        }
        case(NodeKind.ND_VAR, NodeKind.ND_VLA_PTR) {
            node.ty = node._c_var.ty
            return
        }
        case(NodeKind.ND_COND) {
            if (node.then.ty.kind == TypeKind.TY_VOID || node.els.ty.kind == TypeKind.TY_VOID) {
                node.ty = ty_void
            } else {
                usual_arith_conv(addr(node.then), addr(node.els))
                node.ty = node.then.ty
            }
            return
        }
        case(NodeKind.ND_COMMA) {
            node.ty = node.rhs.ty
            return
        }
        case(NodeKind.ND_MEMBER) {
            node.ty = node.member.ty
            return
        }
