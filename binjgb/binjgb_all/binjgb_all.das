[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<FileData>) == 16 && typeinfo alignof(type<FileData>) == 8, "FileData: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < data > (type<FileData>) == 0, "FileData.data: clang puts it at 0")
    static_assert(typeinfo offsetof < size > (type<FileData>) == 8, "FileData.size: clang puts it at 8")
    static_assert(typeinfo sizeof(type<JoypadButtons>) == 32 && typeinfo alignof(type<JoypadButtons>) == 4, "JoypadButtons: clang lays it out as size 32, align 4")
    static_assert(typeinfo offsetof < down > (type<JoypadButtons>) == 0, "JoypadButtons.down: clang puts it at 0")
    static_assert(typeinfo offsetof < up > (type<JoypadButtons>) == 4, "JoypadButtons.up: clang puts it at 4")
    static_assert(typeinfo offsetof < left > (type<JoypadButtons>) == 8, "JoypadButtons.left: clang puts it at 8")
    static_assert(typeinfo offsetof < right > (type<JoypadButtons>) == 12, "JoypadButtons.right: clang puts it at 12")
    static_assert(typeinfo offsetof < start > (type<JoypadButtons>) == 16, "JoypadButtons.start: clang puts it at 16")
    static_assert(typeinfo offsetof < select > (type<JoypadButtons>) == 20, "JoypadButtons.select: clang puts it at 20")
    static_assert(typeinfo offsetof < B > (type<JoypadButtons>) == 24, "JoypadButtons.B: clang puts it at 24")
    static_assert(typeinfo offsetof < A > (type<JoypadButtons>) == 28, "JoypadButtons.A: clang puts it at 28")
    static_assert(typeinfo sizeof(type<JoypadCallbackInfo>) == 16 && typeinfo alignof(type<JoypadCallbackInfo>) == 8, "JoypadCallbackInfo: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < callback > (type<JoypadCallbackInfo>) == 0, "JoypadCallbackInfo.callback: clang puts it at 0")
    static_assert(typeinfo offsetof < user_data > (type<JoypadCallbackInfo>) == 8, "JoypadCallbackInfo.user_data: clang puts it at 8")
    static_assert(typeinfo sizeof(type<anon_121>) == 2 && typeinfo alignof(type<anon_121>) == 1, "anon_121: clang lays it out as size 2, align 1")
    static_assert(typeinfo offsetof < C > (type<anon_121>) == 0, "anon_121.C: clang puts it at 0")
    static_assert(typeinfo offsetof < B > (type<anon_121>) == 1, "anon_121.B: clang puts it at 1")
    static_assert(typeinfo sizeof(type<anon_120>) == 2 && typeinfo alignof(type<anon_120>) == 2, "anon_120: clang lays it out as size 2, align 2")
    static_assert(typeinfo offsetof < _storage > (type<anon_120>) == 0, "anon_120: every member sits at 0")
    static_assert(typeinfo sizeof(type<anon_123>) == 2 && typeinfo alignof(type<anon_123>) == 1, "anon_123: clang lays it out as size 2, align 1")
    static_assert(typeinfo offsetof < E > (type<anon_123>) == 0, "anon_123.E: clang puts it at 0")
    static_assert(typeinfo offsetof < D > (type<anon_123>) == 1, "anon_123.D: clang puts it at 1")
    static_assert(typeinfo sizeof(type<anon_122>) == 2 && typeinfo alignof(type<anon_122>) == 2, "anon_122: clang lays it out as size 2, align 2")
    static_assert(typeinfo offsetof < _storage > (type<anon_122>) == 0, "anon_122: every member sits at 0")
    static_assert(typeinfo sizeof(type<anon_125>) == 2 && typeinfo alignof(type<anon_125>) == 1, "anon_125: clang lays it out as size 2, align 1")
    static_assert(typeinfo offsetof < L > (type<anon_125>) == 0, "anon_125.L: clang puts it at 0")
    static_assert(typeinfo offsetof < H > (type<anon_125>) == 1, "anon_125.H: clang puts it at 1")
    static_assert(typeinfo sizeof(type<anon_124>) == 2 && typeinfo alignof(type<anon_124>) == 2, "anon_124: clang lays it out as size 2, align 2")
    static_assert(typeinfo offsetof < _storage > (type<anon_124>) == 0, "anon_124: every member sits at 0")
    static_assert(typeinfo sizeof(type<anon_126>) == 16 && typeinfo alignof(type<anon_126>) == 4, "anon_126: clang lays it out as size 16, align 4")
    static_assert(typeinfo offsetof < Z > (type<anon_126>) == 0, "anon_126.Z: clang puts it at 0")
