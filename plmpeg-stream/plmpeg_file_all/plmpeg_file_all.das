                        v_index += 128 - 32
                        d_index += 64 - 32
                    }
                    d_index -= 512 - 32
                    v_index = 128 - 32 + 1024 - v_index
                    while (v_index < 1024) {
                        for (i in range(32)) {
                            let _t2 = d_index
                            d_index++
                            let _t3 = v_index
                            v_index++
                            self.U[i] += self.D[_t2] * self.V[ch][_t3]
                        }
                        v_index += 128 - 32
                        d_index += 64 - 32
                    }
                    // Output samples
                    for (j in range(32)) {
                        self.samples.interleaved[(out_pos + j << 1) + ch] = self.U[j] / -1090519000f
