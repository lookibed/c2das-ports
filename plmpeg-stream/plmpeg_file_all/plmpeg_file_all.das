// `abs` is ordinary decoder arithmetic, not part of the raw-memory runtime.
// Bind the single-header implementation to a local C helper so the target
// graph never depends on shim.c's reference-side libc implementation.
def plmpeg_abs(value : int) : int {
    return value < 0 ? -value : value
}

def plm_create_with_memory(var bytes : uint8?; length : uint64; free_when_done : int) : plm_t? {
    var buffer : plm_buffer_t? = plm_buffer_create_with_memory(bytes, length, free_when_done)
    return plm_create_with_buffer(buffer, TRUE)
}

[c_function]
def plm_create_with_buffer(var buffer : plm_buffer_t?; destroy_when_done : int) : plm_t? {
    var self : plm_t? = reinterpret<plm_t?>(crt::malloc(uint64(typeinfo sizeof(type<plm_t>))))
    crt::memset(reinterpret<void?>(self), 0, uint64(typeinfo sizeof(type<plm_t>)))
    self.demux = plm_demux_create(buffer, destroy_when_done)
    self.video_enabled = TRUE
    self.audio_enabled = TRUE
    plm_init_decoders(self)
    return self
}

[c_function]
def plm_init_decoders(var self : plm_t?) : int {
    if (self.has_decoders != 0) {
        return TRUE
    }
    if (!(plm_demux_has_headers(self.demux) != 0)) {
        return FALSE
    }
    if (plm_demux_get_num_video_streams(self.demux) > 0) {
        if (self.video_enabled != 0) {
            self.video_packet_type = plmpeg_file_all__PLM_DEMUX_PACKET_VIDEO_1
        }
        if (!(self.video_decoder != null)) {
            self.video_buffer = plm_buffer_create_with_capacity(uint64(PLM_BUFFER_DEFAULT_SIZE))
            plm_buffer_set_load_callback(self.video_buffer, @@plm_read_video_packet, reinterpret<void?>(self))
            self.video_decoder = plm_video_create_with_buffer(self.video_buffer, TRUE)
        }
    }
    if (plm_demux_get_num_audio_streams(self.demux) > 0) {
        if (self.audio_enabled != 0) {
            self.audio_packet_type = plmpeg_file_all__PLM_DEMUX_PACKET_AUDIO_1 + self.audio_stream_index
        }
        if (!(self.audio_decoder != null)) {
            self.audio_buffer = plm_buffer_create_with_capacity(uint64(PLM_BUFFER_DEFAULT_SIZE))
            plm_buffer_set_load_callback(self.audio_buffer, @@plm_read_audio_packet, reinterpret<void?>(self))
            self.audio_decoder = plm_audio_create_with_buffer(self.audio_buffer, TRUE)
        }
    }
    self.has_decoders = TRUE
    return TRUE
}

[c_function]
def plm_destroy(var self : plm_t?) {
    if (self.video_decoder != null) {
        plm_video_destroy(self.video_decoder)
    }
    if (self.audio_decoder != null) {
        plm_audio_destroy(self.audio_decoder)
    }
    plm_demux_destroy(self.demux)
    crt::free(reinterpret<void?>(self))
}

def plm_get_audio_enabled(var self : plm_t?) : int {
    return self.audio_enabled
}

def plm_has_headers(var self : plm_t?) : int {
    if (!(plm_demux_has_headers(self.demux) != 0)) {
        return FALSE
    }
    if (!(plm_init_decoders(self) != 0)) {
        return FALSE
    }
    if (self.video_decoder != null && !(plm_video_has_header(self.video_decoder) != 0) || self.audio_decoder != null && !(plm_audio_has_header(self.audio_decoder) != 0)) {
        return FALSE
    }
    return TRUE
}

def plm_probe(var self : plm_t?; probesize : uint64) : int {
    var found_streams : int = plm_demux_probe(self.demux, probesize)
    if (!(found_streams != 0)) {
        return FALSE
    }
    // Re-init decoders
    self.has_decoders = FALSE
    self.video_packet_type = 0
    self.audio_packet_type = 0
    return plm_init_decoders(self)
}

def plm_set_audio_enabled(var self : plm_t?; enabled : int) {
    self.audio_enabled = enabled
    if (!(enabled != 0)) {
        self.audio_packet_type = 0
        return
    }
    self.audio_packet_type = plm_init_decoders(self) != 0 && self.audio_decoder != null ? plmpeg_file_all__PLM_DEMUX_PACKET_AUDIO_1 + self.audio_stream_index : 0
}

def plm_set_audio_stream(var self : plm_t?; stream_index : int) {
    if (stream_index < 0 || stream_index > 3) {
        return
    }
    self.audio_stream_index = stream_index
    // Set the correct audio_packet_type
    plm_set_audio_enabled(self, self.audio_enabled)
}

def plm_get_video_enabled(var self : plm_t?) : int {
    return self.video_enabled
}

def plm_set_video_enabled(var self : plm_t?; enabled : int) {
    self.video_enabled = enabled
    if (!(enabled != 0)) {
        self.video_packet_type = 0
        return
    }
    self.video_packet_type = plm_init_decoders(self) != 0 && self.video_decoder != null ? plmpeg_file_all__PLM_DEMUX_PACKET_VIDEO_1 : 0
}

def plm_get_num_video_streams(var self : plm_t?) : int {
    return plm_demux_get_num_video_streams(self.demux)
}

def plm_get_width(var self : plm_t?) : int {
    return plm_init_decoders(self) != 0 && self.video_decoder != null ? plm_video_get_width(self.video_decoder) : 0
}

def plm_get_height(var self : plm_t?) : int {
    return plm_init_decoders(self) != 0 && self.video_decoder != null ? plm_video_get_height(self.video_decoder) : 0
}

def plm_get_framerate(var self : plm_t?) : double {
    return plm_init_decoders(self) != 0 && self.video_decoder != null ? plm_video_get_framerate(self.video_decoder) : double(0)
}

def plm_get_pixel_aspect_ratio(var self : plm_t?) : double {
    return plm_init_decoders(self) != 0 && self.video_decoder != null ? plm_video_get_pixel_aspect_ratio(self.video_decoder) : double(0)
}

def plm_get_num_audio_streams(var self : plm_t?) : int {
    return plm_demux_get_num_audio_streams(self.demux)
}

def plm_get_samplerate(var self : plm_t?) : int {
    return plm_init_decoders(self) != 0 && self.audio_decoder != null ? plm_audio_get_samplerate(self.audio_decoder) : 0
}

def plm_get_audio_lead_time(var self : plm_t?) : double {
    return self.audio_lead_time
}

def plm_set_audio_lead_time(var self : plm_t?; lead_time : double) {
    self.audio_lead_time = lead_time
}

def plm_get_time(var self : plm_t?) : double {
    return self.time
}

def plm_get_duration(var self : plm_t?) : double {
    return plm_demux_get_duration(self.demux, plmpeg_file_all__PLM_DEMUX_PACKET_VIDEO_1)
}

def plm_rewind(var self : plm_t?) {
    if (self.video_decoder != null) {
        plm_video_rewind(self.video_decoder)
    }
    if (self.audio_decoder != null) {
        plm_audio_rewind(self.audio_decoder)
    }
    plm_demux_rewind(self.demux)
    self.time = double(0)
    self.has_ended = FALSE
}

def plm_get_loop(var self : plm_t?) : int {
    return self.loop
}

def plm_set_loop(var self : plm_t?; loop : int) {
    self.loop = loop
}

def plm_has_ended(var self : plm_t?) : int {
    return self.has_ended
}

def plm_set_video_decode_callback(var self : plm_t?; fp : function<(var a0 : plm_t?; var a1 : plm_frame_t?; var a2 : void?) : void>; var user : void?) {
    self.video_decode_callback = fp
    self.video_decode_callback_user_data = user
}

def plm_set_audio_decode_callback(var self : plm_t?; fp : function<(var a0 : plm_t?; var a1 : plm_samples_t?; var a2 : void?) : void>; var user : void?) {
    self.audio_decode_callback = fp
    self.audio_decode_callback_user_data = user
}

def plm_decode(var self : plm_t?; tick : double) {
    if (!(plm_init_decoders(self) != 0)) {
        return
    }
    var decode_video : int = self.video_decode_callback != null && self.video_packet_type != 0 ? 1 : 0
    var decode_audio : int = self.audio_decode_callback != null && self.audio_packet_type != 0 ? 1 : 0
    if (!(decode_video != 0) && !(decode_audio != 0)) {
        // Nothing to do here
        return
    }
    var did_decode : int = FALSE
    var decode_video_failed : int = FALSE
    var decode_audio_failed : int = FALSE
    var video_target_time : double = self.time + tick
    var audio_target_time : double = self.time + tick + self.audio_lead_time
    while (true) {
        did_decode = FALSE
        if (decode_video != 0 && plm_video_get_time(self.video_decoder) < video_target_time) {
            var frame : plm_frame_t? = plm_video_decode(self.video_decoder)
            if (frame != null) {
                invoke(self.video_decode_callback, self, frame, self.video_decode_callback_user_data)
                did_decode = TRUE
            } else {
                decode_video_failed = TRUE
            }
        }
        if (decode_audio != 0 && plm_audio_get_time(self.audio_decoder) < audio_target_time) {
            var samples : plm_samples_t? = plm_audio_decode(self.audio_decoder)
            if (samples != null) {
                invoke(self.audio_decode_callback, self, samples, self.audio_decode_callback_user_data)
                did_decode = TRUE
            } else {
                decode_audio_failed = TRUE
            }
        }
        if (!(did_decode != 0)) {
            break
        }
    }
    // Did all sources we wanted to decode fail and the demuxer is at the end?
    if ((!(decode_video != 0) || decode_video_failed != 0) && (!(decode_audio != 0) || decode_audio_failed != 0) && plm_demux_has_ended(self.demux) != 0) {
        plm_handle_end(self)
        return
    }
    self.time += tick
}

def plm_decode_video(var self : plm_t?) : plm_frame_t? {
    if (!(plm_init_decoders(self) != 0)) {
        return null
    }
    if (!(self.video_packet_type != 0)) {
        return null
    }
    var frame : plm_frame_t? = plm_video_decode(self.video_decoder)
    if (frame != null) {
        self.time = frame.time
    } elif (plm_demux_has_ended(self.demux) != 0) {
        plm_handle_end(self)
    }
    return frame
}

def plm_decode_audio(var self : plm_t?) : plm_samples_t? {
    if (!(plm_init_decoders(self) != 0)) {
        return null
    }
    if (!(self.audio_packet_type != 0)) {
        return null
    }
    var samples : plm_samples_t? = plm_audio_decode(self.audio_decoder)
    if (samples != null) {
        self.time = samples.time
    } elif (plm_demux_has_ended(self.demux) != 0) {
        plm_handle_end(self)
    }
    return samples
}

def plm_handle_end(var self : plm_t?) {
    if (self.loop != 0) {
        plm_rewind(self)
    } else {
        self.has_ended = TRUE
    }
}

[c_function]
def plm_read_video_packet(var buffer : plm_buffer_t?; var user : void?) {
    var self : plm_t? = reinterpret<plm_t?>(user)
    plm_read_packets(self, self.video_packet_type)
}

[c_function]
def plm_read_audio_packet(var buffer : plm_buffer_t?; var user : void?) {
    var self : plm_t? = reinterpret<plm_t?>(user)
    plm_read_packets(self, self.audio_packet_type)
}

def plm_read_packets(var self : plm_t?; requested_type : int) {
    var packet : plm_packet_t?
    while (true) {
        packet = plm_demux_decode(self.demux)
        if (!(packet != null)) {
            break
        }
        if (packet._c_type == self.video_packet_type) {
            plm_buffer_write(self.video_buffer, packet.data, packet.length)
        } elif (packet._c_type == self.audio_packet_type) {
            plm_buffer_write(self.audio_buffer, packet.data, packet.length)
        }
        if (packet._c_type == requested_type) {
            return
        }
    }
    if (plm_demux_has_ended(self.demux) != 0) {
        if (self.video_buffer != null) {
            plm_buffer_signal_end(self.video_buffer)
        }
        if (self.audio_buffer != null) {
            plm_buffer_signal_end(self.audio_buffer)
        }
    }
}

def plm_seek_frame(var self : plm_t?; var time : double; seek_exact : int) : plm_frame_t? {
    if (!(plm_init_decoders(self) != 0)) {
        return null
    }
    if (!(self.video_packet_type != 0)) {
        return null
    }
    var _c_type : int = self.video_packet_type
    var start_time : double = plm_demux_get_start_time(self.demux, _c_type)
    var duration : double = plm_demux_get_duration(self.demux, _c_type)
    if (time < double(0)) {
        time = double(0)
    } elif (time > duration) {
        time = duration
    }
    var packet : plm_packet_t? = plm_demux_seek(self.demux, time, _c_type, TRUE)
    if (!(packet != null)) {
        return null
    }
    // Disable writing to the audio buffer while decoding video
    var previous_audio_packet_type : int = self.audio_packet_type
    self.audio_packet_type = 0
    // Clear video buffer and decode the found packet
    plm_video_rewind(self.video_decoder)
    plm_video_set_time(self.video_decoder, packet.pts - start_time)
    plm_buffer_write(self.video_buffer, packet.data, packet.length)
    var frame : plm_frame_t? = plm_video_decode(self.video_decoder)
    // If we want to seek to an exact frame, we have to decode all frames
    // on top of the intra frame we just jumped to.
    if (seek_exact != 0) {
        while (frame != null && frame.time < time) {
            frame = plm_video_decode(self.video_decoder)
        }
    }
    // Enable writing to the audio buffer again?
    self.audio_packet_type = previous_audio_packet_type
    if (frame != null) {
        self.time = frame.time
    }
    self.has_ended = FALSE
    return frame
}

def plm_seek(var self : plm_t?; time : double; seek_exact : int) : int {
    var frame : plm_frame_t? = plm_seek_frame(self, time, seek_exact)
    if (!(frame != null)) {
        return FALSE
    }
    if (self.video_decode_callback != null) {
        invoke(self.video_decode_callback, self, frame, self.video_decode_callback_user_data)
    }
    // If audio is not enabled we are done here.
    if (!(self.audio_packet_type != 0)) {
        return TRUE
    }
    // Sync up Audio. This demuxes more packets until the first audio packet
    // with a PTS greater than the current time is found. plm_decode() is then
    // called to decode enough audio data to satisfy the audio_lead_time.
    var start_time : double = plm_demux_get_start_time(self.demux, self.video_packet_type)
    plm_audio_rewind(self.audio_decoder)
    var packet : plm_packet_t? = null
    while (true) {
        packet = plm_demux_decode(self.demux)
        if (!(packet != null)) {
            break
        }
        if (packet._c_type == self.video_packet_type) {
            plm_buffer_write(self.video_buffer, packet.data, packet.length)
        } elif (packet._c_type == self.audio_packet_type && packet.pts - start_time > self.time) {
            plm_audio_set_time(self.audio_decoder, packet.pts - start_time)
            plm_buffer_write(self.audio_buffer, packet.data, packet.length)
            plm_decode(self, double(0))
            break
        }
    }
    return TRUE
}

def plm_buffer_create_with_callbacks(load_callback : function<(var a0 : plm_buffer_t?; var a1 : void?) : void>; seek_callback : function<(var a0 : plm_buffer_t?; a1 : uint64; var a2 : void?) : void>; tell_callback : function<(var a0 : plm_buffer_t?; var a1 : void?) : uint64>; length : uint64; var user : void?) : plm_buffer_t? {
    var self : plm_buffer_t? = plm_buffer_create_with_capacity(uint64(PLM_BUFFER_DEFAULT_SIZE))
    self.mode = plm_buffer_mode.PLM_BUFFER_MODE_FILE
    self.total_size = length
    self.load_callback = load_callback
    self.seek_callback = seek_callback
    self.tell_callback = tell_callback
    self.load_callback_user_data = user
    return self
}

[c_function]
def plm_buffer_create_with_memory(var bytes : uint8?; length : uint64; free_when_done : int) : plm_buffer_t? {
    var self : plm_buffer_t? = reinterpret<plm_buffer_t?>(crt::malloc(uint64(typeinfo sizeof(type<plm_buffer_t>))))
    crt::memset(reinterpret<void?>(self), 0, uint64(typeinfo sizeof(type<plm_buffer_t>)))
    self.capacity = length
    self.length = length
    self.total_size = length
    self.free_when_done = free_when_done
    self.bytes = bytes
    self.mode = plm_buffer_mode.PLM_BUFFER_MODE_FIXED_MEM
    self.discard_read_bytes = FALSE
    return self
}

[c_function]
def plm_buffer_create_with_capacity(capacity : uint64) : plm_buffer_t? {
    var self : plm_buffer_t? = reinterpret<plm_buffer_t?>(crt::malloc(uint64(typeinfo sizeof(type<plm_buffer_t>))))
    crt::memset(reinterpret<void?>(self), 0, uint64(typeinfo sizeof(type<plm_buffer_t>)))
    self.capacity = capacity
    self.free_when_done = TRUE
    self.bytes = reinterpret<uint8?>(crt::malloc(capacity))
    self.mode = plm_buffer_mode.PLM_BUFFER_MODE_RING
    self.discard_read_bytes = TRUE
    return self
}

def plm_buffer_create_for_appending(initial_capacity : uint64) : plm_buffer_t? {
    var self : plm_buffer_t? = plm_buffer_create_with_capacity(initial_capacity)
    self.mode = plm_buffer_mode.PLM_BUFFER_MODE_APPEND
    self.discard_read_bytes = FALSE
    return self
}

[c_function]
def plm_buffer_destroy(var self : plm_buffer_t?) {
    if (self.free_when_done != 0) {
        crt::free(reinterpret<void?>(self.bytes))
    }
    crt::free(reinterpret<void?>(self))
}

def plm_buffer_get_size(var self : plm_buffer_t?) : uint64 {
    return self.mode == plm_buffer_mode.PLM_BUFFER_MODE_FILE ? self.total_size : self.length
}

def plm_buffer_get_remaining(var self : plm_buffer_t?) : uint64 {
    return self.length - (self.bit_index >> 3ul)
}

[c_function]
def plm_buffer_write(var self : plm_buffer_t?; var bytes : uint8?; length : uint64) : uint64 {
    if (self.mode == plm_buffer_mode.PLM_BUFFER_MODE_FIXED_MEM) {
        return uint64(0)
    }
    if (self.discard_read_bytes != 0) {
        // This should be a ring buffer, but instead it just shifts all unread
        // data to the beginning of the buffer and appends new data at the end.
        // Seems to be good enough.
        plm_buffer_discard_read_bytes(self)
        if (self.mode == plm_buffer_mode.PLM_BUFFER_MODE_RING) {
            self.total_size = uint64(0)
        }
    }
    // Do we have to resize to fit the new data?
    var bytes_available : uint64 = self.capacity - self.length
    if (bytes_available < length) {
        var new_size : uint64 = self.capacity
        while (true) {
            new_size *= uint64(2)
            if (!(new_size - self.length < length)) {
                break
            }
        }
        self.bytes = reinterpret<uint8?>(crt::realloc(reinterpret<void?>(self.bytes), new_size))
        self.capacity = new_size
    }
    crt::memcpy(reinterpret<void?>(self.bytes + self.length), reinterpret<void?>(bytes), length)
    self.length += length
    self.has_ended = FALSE
    return length
}

def plm_buffer_signal_end(var self : plm_buffer_t?) {
    self.total_size = self.length
}

def plm_buffer_set_load_callback(var self : plm_buffer_t?; fp : function<(var a0 : plm_buffer_t?; var a1 : void?) : void>; var user : void?) {
    self.load_callback = fp
    self.load_callback_user_data = user
}

def plm_buffer_rewind(var self : plm_buffer_t?) {
    plm_buffer_seek(self, uint64(0))
}

def plm_buffer_seek(var self : plm_buffer_t?; pos : uint64) {
    self.has_ended = FALSE
    if (self.seek_callback != null) {
        invoke(self.seek_callback, self, pos, self.load_callback_user_data)
        self.bit_index = uint64(0)
        self.length = uint64(0)
    } elif (self.mode == plm_buffer_mode.PLM_BUFFER_MODE_RING) {
        if (pos != uint64(0)) {
            // Seeking to non-0 is forbidden for dynamic-mem buffers
            return
        }
        self.bit_index = uint64(0)
        self.length = uint64(0)
        self.total_size = uint64(0)
    } elif (pos < self.length) {
        self.bit_index = pos << 3ul
    }
}

def plm_buffer_tell(var self : plm_buffer_t?) : uint64 {
    return self.tell_callback != null ? invoke(self.tell_callback, self, self.load_callback_user_data) + (self.bit_index >> 3ul) - self.length : self.bit_index >> 3ul
}

[c_function]
def plm_buffer_discard_read_bytes(var self : plm_buffer_t?) {
    var byte_pos : uint64 = self.bit_index >> 3ul
    if (byte_pos == self.length) {
        self.bit_index = uint64(0)
        self.length = uint64(0)
    } elif (byte_pos > uint64(0)) {
        crt::memmove(reinterpret<void?>(self.bytes), reinterpret<void?>(self.bytes + byte_pos), self.length - byte_pos)
        self.bit_index -= byte_pos << 3ul
        self.length -= byte_pos
    }
}

def plm_buffer_has_ended(var self : plm_buffer_t?) : int {
    return self.has_ended
}

def plm_buffer_has(var self : plm_buffer_t?; count : uint64) : int {
    if ((self.length << 3ul) - self.bit_index >= count) {
        return TRUE
    }
    if (self.load_callback != null) {
        invoke(self.load_callback, self, self.load_callback_user_data)
        if ((self.length << 3ul) - self.bit_index >= count) {
            return TRUE
        }
    }
    if (self.total_size != uint64(0) && self.length == self.total_size) {
        self.has_ended = TRUE
    }
    return FALSE
}

[c_function]
def plm_buffer_read(var self : plm_buffer_t?; var count : int) : int {
    if (!(plm_buffer_has(self, uint64(count)) != 0)) {
        return 0
    }
    var value : int = 0
    while (count != 0) {
        var current_byte : int = int(deref(self.bytes + (self.bit_index >> 3ul)))
        // Remaining bits in byte
        var remaining : int = int(uint64(8) - (self.bit_index & uint64(7)))
        // Bits in self run
        var read : int = remaining < count ? remaining : count
        var shift : int = remaining - read
        var mask : int = 255 >> 8 - read
        value = value << read | (current_byte & mask << shift) >> shift
        self.bit_index += uint64(read)
        count -= read
    }
    return value
}

def plm_buffer_align(var self : plm_buffer_t?) {
    // Align to next byte
    self.bit_index = self.bit_index + uint64(7) >> 3ul << 3ul
}

def plm_buffer_skip(var self : plm_buffer_t?; count : uint64) {
    if (plm_buffer_has(self, count) != 0) {
        self.bit_index += count
    }
}

[c_function]
def plm_buffer_skip_bytes(var self : plm_buffer_t?; v : uint8) : int {
    plm_buffer_align(self)
    var skipped : int = 0
    while (plm_buffer_has(self, uint64(8)) != 0 && int(deref(self.bytes + (self.bit_index >> 3ul))) == int(v)) {
        self.bit_index += uint64(8)
        skipped++
    }
    return skipped
}

[c_function]
def plm_buffer_next_start_code(var self : plm_buffer_t?) : int {
    plm_buffer_align(self)
    while (plm_buffer_has(self, uint64(5 << 3)) != 0) {
        var byte_index : uint64 = self.bit_index >> 3ul
        if (int(deref(self.bytes + byte_index)) == 0 && int(deref(self.bytes + (byte_index + uint64(1)))) == 0 && int(deref(self.bytes + (byte_index + uint64(2)))) == 1) {
            self.bit_index = byte_index + uint64(4) << 3ul
            return int(deref(self.bytes + (byte_index + uint64(3))))
        }
        self.bit_index += uint64(8)
    }
    return -1
}

def plm_buffer_find_start_code(var self : plm_buffer_t?; code : int) : int {
    var current : int = 0
    while (TRUE != 0) {
        current = plm_buffer_next_start_code(self)
        if (current == code || current == -1) {
            return current
        }
    }
    return -1
}

def plm_buffer_has_start_code(var self : plm_buffer_t?; code : int) : int {
    var previous_bit_index : uint64 = self.bit_index
    var previous_discard_read_bytes : int = self.discard_read_bytes
    self.discard_read_bytes = FALSE
    var current : int = plm_buffer_find_start_code(self, code)
    self.bit_index = previous_bit_index
    self.discard_read_bytes = previous_discard_read_bytes
    return current
}

def plm_buffer_peek_non_zero(var self : plm_buffer_t?; bit_count : int) : int {
    if (!(plm_buffer_has(self, uint64(bit_count)) != 0)) {
        return FALSE
    }
    var val : int = plm_buffer_read(self, bit_count)
    self.bit_index -= uint64(bit_count)
    return val != 0 ? 1 : 0
}

[c_function]
def plm_buffer_read_vlc(var self : plm_buffer_t?; var _c_table : plm_vlc_t?) : int16 {
    var state : plm_vlc_t = plm_vlc_t(index = int16(0), value = int16(0))
    while (true) {
        state = deref(_c_table + (int(state.index) + plm_buffer_read(self, 1)))
        if (!(int(state.index) > 0)) {
            break
        }
    }
    return state.value
}

[c_function]
def plm_buffer_read_vlc_uint(var self : plm_buffer_t?; var _c_table : plm_vlc_uint_t?) : uint16 {
    return uint16(plm_buffer_read_vlc(self, reinterpret<plm_vlc_t?>(_c_table)))
}

[c_function]
def plm_demux_create(var buffer : plm_buffer_t?; destroy_when_done : int) : plm_demux_t? {
    var self : plm_demux_t? = reinterpret<plm_demux_t?>(crt::malloc(uint64(typeinfo sizeof(type<plm_demux_t>))))
    crt::memset(reinterpret<void?>(self), 0, uint64(typeinfo sizeof(type<plm_demux_t>)))
    self.buffer = buffer
    self.destroy_buffer_when_done = destroy_when_done
    self.start_time = double(-1)
    self.duration = double(-1)
    self.start_code = -1
    plm_demux_has_headers(self)
    return self
}

[c_function]
def plm_demux_destroy(var self : plm_demux_t?) {
    if (self.destroy_buffer_when_done != 0) {
        plm_buffer_destroy(self.buffer)
    }
    crt::free(reinterpret<void?>(self))
}

def plm_demux_has_headers(var self : plm_demux_t?) : int {
    if (self.has_headers != 0) {
        return TRUE
    }
    // Decode pack header
    if (!(self.has_pack_header != 0)) {
        if (self.start_code != plmpeg_file_all__PLM_START_PACK && plm_buffer_find_start_code(self.buffer, plmpeg_file_all__PLM_START_PACK) == -1) {
            return FALSE
        }
        self.start_code = plmpeg_file_all__PLM_START_PACK
        if (!(plm_buffer_has(self.buffer, uint64(64)) != 0)) {
            return FALSE
        }
        self.start_code = -1
        if (plm_buffer_read(self.buffer, 4) != 2) {
            return FALSE
        }
        self.system_clock_ref = plm_demux_decode_time(self)
        plm_buffer_skip(self.buffer, uint64(1))
        // mux_rate * 50
        plm_buffer_skip(self.buffer, uint64(22))
        plm_buffer_skip(self.buffer, uint64(1))
        self.has_pack_header = TRUE
    }
    // Decode system header
    if (!(self.has_system_header != 0)) {
        if (self.start_code != plmpeg_file_all__PLM_START_SYSTEM && plm_buffer_find_start_code(self.buffer, plmpeg_file_all__PLM_START_SYSTEM) == -1) {
            return FALSE
        }
        self.start_code = plmpeg_file_all__PLM_START_SYSTEM
        if (!(plm_buffer_has(self.buffer, uint64(56)) != 0)) {
            return FALSE
        }
        self.start_code = -1
        // header_length
        plm_buffer_skip(self.buffer, uint64(16))
        // rate bound
        plm_buffer_skip(self.buffer, uint64(24))
        self.num_audio_streams = plm_buffer_read(self.buffer, 6)
        // misc flags
        plm_buffer_skip(self.buffer, uint64(5))
        self.num_video_streams = plm_buffer_read(self.buffer, 5)
        self.has_system_header = TRUE
    }
    self.has_headers = TRUE
    return TRUE
}

def plm_demux_probe(var self : plm_demux_t?; probesize : uint64) : int {
    var previous_pos : int = int(plm_buffer_tell(self.buffer))
    var video_stream : int = FALSE
    var audio_streams : int[4] = fixed_array(FALSE, FALSE, FALSE, FALSE)
    while (true) {
        self.start_code = plm_buffer_next_start_code(self.buffer)
        if (self.start_code == plmpeg_file_all__PLM_DEMUX_PACKET_VIDEO_1) {
            video_stream = TRUE
        } elif (self.start_code >= plmpeg_file_all__PLM_DEMUX_PACKET_AUDIO_1 && self.start_code <= plmpeg_file_all__PLM_DEMUX_PACKET_AUDIO_4) {
            audio_streams[self.start_code - plmpeg_file_all__PLM_DEMUX_PACKET_AUDIO_1] = TRUE
        }
        if (!(self.start_code != -1 && plm_buffer_tell(self.buffer) - uint64(previous_pos) < probesize)) {
            break
        }
    }
    self.num_video_streams = video_stream != 0 ? 1 : 0
    self.num_audio_streams = 0
    for (i in range(4)) {
        if (audio_streams[i] != 0) {
            self.num_audio_streams++
        }
    }
    plm_demux_buffer_seek(self, uint64(previous_pos))
    return self.num_video_streams != 0 || self.num_audio_streams != 0 ? 1 : 0
}

def plm_demux_get_num_video_streams(var self : plm_demux_t?) : int {
    return plm_demux_has_headers(self) != 0 ? self.num_video_streams : 0
}

def plm_demux_get_num_audio_streams(var self : plm_demux_t?) : int {
    return plm_demux_has_headers(self) != 0 ? self.num_audio_streams : 0
}

def plm_demux_rewind(var self : plm_demux_t?) {
    plm_buffer_rewind(self.buffer)
    self.current_packet.length = uint64(0)
    self.next_packet.length = uint64(0)
    self.start_code = -1
}

def plm_demux_has_ended(var self : plm_demux_t?) : int {
    return plm_buffer_has_ended(self.buffer)
}

def plm_demux_buffer_seek(var self : plm_demux_t?; pos : uint64) {
    plm_buffer_seek(self.buffer, pos)
    self.current_packet.length = uint64(0)
    self.next_packet.length = uint64(0)
    self.start_code = -1
}

def plm_demux_get_start_time(var self : plm_demux_t?; _c_type : int) : double {
    if (self.start_time != double(-1)) {
        return self.start_time
    }
    var previous_pos : int = int(plm_buffer_tell(self.buffer))
    var previous_start_code : int = self.start_code
    // Find first video PTS
    plm_demux_rewind(self)
    while (true) {
        var packet : plm_packet_t? = plm_demux_decode(self)
        if (!(packet != null)) {
            break
        }
        if (packet._c_type == _c_type) {
            self.start_time = packet.pts
        }
        if (!(self.start_time == double(-1))) {
            break
        }
    }
    plm_demux_buffer_seek(self, uint64(previous_pos))
    self.start_code = previous_start_code
    return self.start_time
}

def plm_demux_get_duration(var self : plm_demux_t?; _c_type : int) : double {
    var file_size : uint64 = plm_buffer_get_size(self.buffer)
    if (self.duration != double(-1) && self.last_file_size == file_size) {
        return self.duration
    }
    var previous_pos : uint64 = plm_buffer_tell(self.buffer)
    var previous_start_code : int = self.start_code
    // Find last video PTS. Start searching 64kb from the end and go further
    // back if needed.
    var start_range : int64 = int64(64 * 1024)
    var max_range : int64 = int64(4096 * 1024)
    {
        var _c_range : int64 = start_range
        while (_c_range <= max_range) {
            var seek_pos : int64 = int64(file_size - uint64(_c_range))
            if (seek_pos < int64(0)) {
                seek_pos = int64(0)
                // Make sure to bail after this round
                _c_range = max_range
            }
            plm_demux_buffer_seek(self, uint64(seek_pos))
            self.current_packet.length = uint64(0)
            var last_pts : double = double(PLM_PACKET_INVALID_TS)
            var packet : plm_packet_t? = null
            while (true) {
                packet = plm_demux_decode(self)
                if (!(packet != null)) {
                    break
                }
                if (packet.pts != double(-1) && packet._c_type == _c_type) {
                    last_pts = packet.pts
                }
            }
            if (last_pts != double(-1)) {
                self.duration = last_pts - plm_demux_get_start_time(self, _c_type)
                break
            }
            _c_range *= int64(2)
        }
    }
    plm_demux_buffer_seek(self, previous_pos)
    self.start_code = previous_start_code
    self.last_file_size = file_size
    return self.duration
}

[c_function]
def plm_demux_seek(var self : plm_demux_t?; var seek_time : double; _c_type : int; force_intra : int) : plm_packet_t? {
    if (!(plm_demux_has_headers(self) != 0)) {
        return null
    }
    // Using the current time, current byte position and the average bytes per
    // second for this file, try to jump to a byte position that hopefully has
    // packets containing timestamps within one second before to the desired
    // seek_time.
    // If we hit close to the seek_time scan through all packets to find the
    // last one (just before the seek_time) containing an intra frame.
    // Otherwise we should at least be closer than before. Calculate the bytes
    // per second for the jumped range and jump again.
    // The number of retries here is hard-limited to a generous amount. Usually
    // the correct range is found after 1--5 jumps, even for files with very
    // variable bitrates. If significantly more jumps are needed, there's
    // probably something wrong with the file and we just avoid getting into an
    // infinite loop. 32 retries should be enough for anybody.
    var duration : double = plm_demux_get_duration(self, _c_type)
    var file_size : int64 = int64(plm_buffer_get_size(self.buffer))
    var byterate : int64 = int64(double(file_size) / duration)
    var cur_time : double = self.last_decoded_pts
    var scan_span : double = double(1)
    if (seek_time > duration) {
        seek_time = duration
    } elif (seek_time < double(0)) {
        seek_time = double(0)
    }
    seek_time += self.start_time
    for (retry in range(32)) {
        var found_packet_with_pts : int = FALSE
        var found_packet_in_range : int = FALSE
        var last_valid_packet_start : int64 = int64(-1)
        var first_packet_time : double = double(PLM_PACKET_INVALID_TS)
        var cur_pos : int64 = int64(plm_buffer_tell(self.buffer))
        // Estimate byte offset and jump to it.
        var offset : int64 = int64((seek_time - cur_time - scan_span) * double(byterate))
        var seek_pos : int64 = cur_pos + offset
        if (seek_pos < int64(0)) {
            seek_pos = int64(0)
        } elif (seek_pos > file_size - int64(256)) {
            seek_pos = file_size - int64(256)
        }
        plm_demux_buffer_seek(self, uint64(seek_pos))
        // Scan through all packets up to the seek_time to find the last packet
        // containing an intra frame.
        while (plm_buffer_find_start_code(self.buffer, _c_type) != -1) {
            var packet_start : int64 = int64(plm_buffer_tell(self.buffer))
            var packet : plm_packet_t? = plm_demux_decode_packet(self, _c_type)
            // Skip packet if it has no PTS
            if (!(packet != null) || packet.pts == double(-1)) {
                continue
            }
            // Bail scanning through packets if we hit one that is outside
            // seek_time - scan_span.
            // We also adjust the cur_time and byterate values here so the next
            // iteration can be a bit more precise.
            if (packet.pts > seek_time || packet.pts < seek_time - scan_span) {
                found_packet_with_pts = TRUE
                byterate = int64(double(seek_pos - cur_pos) / (packet.pts - cur_time))
                cur_time = packet.pts
                break
            }
            // If we are still here, it means this packet is in close range to
            // the seek_time. If this is the first packet for this jump position
            // record the PTS. If we later have to back off, when there was no
            // intra frame in this range, we can lower the seek_time to not scan
            // this range again.
            if (!(found_packet_in_range != 0)) {
                found_packet_in_range = TRUE
                first_packet_time = packet.pts
            }
            // Check if this is an intra frame packet. If so, record the buffer
            // position of the start of this packet. We want to jump back to it
            // later, when we know it's the last intra frame before desired
            // seek time.
            if (force_intra != 0) {
                {
                    var i : uint64 = uint64(0)
                    while (i < packet.length - uint64(6)) {
                        // Find the START_PICTURE code
                        if (int(deref(packet.data + i)) == 0 && int(deref(packet.data + (i + uint64(1)))) == 0 && int(deref(packet.data + (i + uint64(2)))) == 1 && int(deref(packet.data + (i + uint64(3)))) == 0) {
                            // Bits 11--13 in the picture header contain the frame
                            // type, where 1=Intra
                            if ((int(deref(packet.data + (i + uint64(5)))) & 56) == 8) {
                                last_valid_packet_start = packet_start
                            }
                            break
                        }
                        i++
                    }
                }
            } else {
                // If we don't want intra frames, just use the last PTS found.
                last_valid_packet_start = packet_start
            }
        }
        // If there was at least one intra frame in the range scanned above,
        // our search is over. Jump back to the packet and decode it again.
        if (last_valid_packet_start != int64(-1)) {
            plm_demux_buffer_seek(self, uint64(last_valid_packet_start))
            return plm_demux_decode_packet(self, _c_type)
        } elif (found_packet_in_range != 0) {
            // If we hit the right range, but still found no intra frame, we have
            // to increases the scan_span. This is done exponentially to also handle
            // video files with very few intra frames.
            scan_span *= double(2)
            seek_time = first_packet_time
        } elif (!(found_packet_with_pts != 0)) {
            // If we didn't find any packet with a PTS, it probably means we reached
            // the end of the file. Estimate byterate and cur_time accordingly.
            byterate = int64(double(seek_pos - cur_pos) / (duration - cur_time))
            cur_time = duration
        }
    }
    return null
}

def plm_demux_decode(var self : plm_demux_t?) : plm_packet_t? {
    if (!(plm_demux_has_headers(self) != 0)) {
        return null
    }
    if (self.current_packet.length != 0) {
        var bits_till_next_packet : uint64 = self.current_packet.length << 3ul
        if (!(plm_buffer_has(self.buffer, bits_till_next_packet) != 0)) {
            return null
        }
        plm_buffer_skip(self.buffer, bits_till_next_packet)
        self.current_packet.length = uint64(0)
    }
    // Pending packet waiting for data?
    if (self.next_packet.length != 0) {
        return plm_demux_get_packet(self)
    }
    // Pending packet waiting for header?
    if (self.start_code != -1) {
        return plm_demux_decode_packet(self, self.start_code)
    }
    while (true) {
        self.start_code = plm_buffer_next_start_code(self.buffer)
        if (self.start_code == plmpeg_file_all__PLM_DEMUX_PACKET_VIDEO_1 || self.start_code == plmpeg_file_all__PLM_DEMUX_PACKET_PRIVATE || self.start_code >= plmpeg_file_all__PLM_DEMUX_PACKET_AUDIO_1 && self.start_code <= plmpeg_file_all__PLM_DEMUX_PACKET_AUDIO_4) {
            return plm_demux_decode_packet(self, self.start_code)
        }
        if (!(self.start_code != -1)) {
            break
        }
    }
    return null
}

def plm_demux_decode_time(var self : plm_demux_t?) : double {
    var clock : int64 = int64(plm_buffer_read(self.buffer, 3) << 30)
    plm_buffer_skip(self.buffer, uint64(1))
    clock |= int64(plm_buffer_read(self.buffer, 15) << 15)
    plm_buffer_skip(self.buffer, uint64(1))
    clock |= int64(plm_buffer_read(self.buffer, 15))
    plm_buffer_skip(self.buffer, uint64(1))
    return double(clock) / 90000.0lf
}

def plm_demux_decode_packet(var self : plm_demux_t?; _c_type : int) : plm_packet_t? {
    if (!(plm_buffer_has(self.buffer, uint64(16 << 3)) != 0)) {
        return null
    }
    self.start_code = -1
    self.next_packet._c_type = _c_type
    self.next_packet.length = uint64(plm_buffer_read(self.buffer, 16))
    // stuffing
    self.next_packet.length -= uint64(plm_buffer_skip_bytes(self.buffer, uint8(255)))
    // skip P-STD
    if (plm_buffer_read(self.buffer, 2) == 1) {
        plm_buffer_skip(self.buffer, uint64(16))
        self.next_packet.length -= uint64(2)
    }
    var pts_dts_marker : int = plm_buffer_read(self.buffer, 2)
    if (pts_dts_marker == 3) {
        self.next_packet.pts = plm_demux_decode_time(self)
        self.last_decoded_pts = self.next_packet.pts
        // skip dts
        plm_buffer_skip(self.buffer, uint64(40))
        self.next_packet.length -= uint64(10)
    } elif (pts_dts_marker == 2) {
        self.next_packet.pts = plm_demux_decode_time(self)
        self.last_decoded_pts = self.next_packet.pts
        self.next_packet.length -= uint64(5)
    } elif (pts_dts_marker == 0) {
        self.next_packet.pts = double(-1)
        plm_buffer_skip(self.buffer, uint64(4))
        self.next_packet.length -= uint64(1)
    } else {
        // invalid
        return null
    }
    return plm_demux_get_packet(self)
}

[c_function]
def plm_demux_get_packet(var self : plm_demux_t?) : plm_packet_t? {
    if (!(plm_buffer_has(self.buffer, self.next_packet.length << 3ul) != 0)) {
        return null
    }
    self.current_packet.data = self.buffer.bytes + (self.buffer.bit_index >> 3ul)
    self.current_packet.length = self.next_packet.length
    self.current_packet._c_type = self.next_packet._c_type
    self.current_packet.pts = self.next_packet.pts
    self.next_packet.length = uint64(0)
    return addr(self.current_packet)
}

def private plmpeg_file_all__plm_clamp(var n : int) : uint8 {
    if (n > 255) {
        n = 255
    } elif (n < 0) {
        n = 0
    }
    return uint8(n)
}

[c_function]
def plm_video_create_with_buffer(var buffer : plm_buffer_t?; destroy_when_done : int) : plm_video_t? {
    var self : plm_video_t? = reinterpret<plm_video_t?>(crt::malloc(uint64(typeinfo sizeof(type<plm_video_t>))))
    crt::memset(reinterpret<void?>(self), 0, uint64(typeinfo sizeof(type<plm_video_t>)))
    self.buffer = buffer
    self.destroy_buffer_when_done = destroy_when_done
    // Attempt to decode the sequence header
    self.start_code = plm_buffer_find_start_code(self.buffer, plmpeg_file_all__PLM_START_SEQUENCE)
    if (self.start_code != -1) {
        plm_video_decode_sequence_header(self)
    }
    return self
}

[c_function]
def plm_video_destroy(var self : plm_video_t?) {
    if (self.destroy_buffer_when_done != 0) {
        plm_buffer_destroy(self.buffer)
    }
    if (self.has_sequence_header != 0) {
        crt::free(reinterpret<void?>(self.frames_data))
    }
    crt::free(reinterpret<void?>(self))
}

def plm_video_get_framerate(var self : plm_video_t?) : double {
    return plm_video_has_header(self) != 0 ? self.framerate : double(0)
}

def plm_video_get_pixel_aspect_ratio(var self : plm_video_t?) : double {
    return plm_video_has_header(self) != 0 ? self.pixel_aspect_ratio : double(0)
}

def plm_video_get_width(var self : plm_video_t?) : int {
    return plm_video_has_header(self) != 0 ? self.width : 0
}

def plm_video_get_height(var self : plm_video_t?) : int {
    return plm_video_has_header(self) != 0 ? self.height : 0
}

def plm_video_set_no_delay(var self : plm_video_t?; no_delay : int) {
    self.assume_no_b_frames = no_delay
}

def plm_video_get_time(var self : plm_video_t?) : double {
    return self.time
}

def plm_video_set_time(var self : plm_video_t?; time : double) {
    self.frames_decoded = int(self.framerate * time)
    self.time = time
}

def plm_video_rewind(var self : plm_video_t?) {
    plm_buffer_rewind(self.buffer)
    self.time = double(0)
    self.frames_decoded = 0
    self.has_reference_frame = FALSE
    self.start_code = -1
}

def plm_video_has_ended(var self : plm_video_t?) : int {
    return plm_buffer_has_ended(self.buffer)
}

[c_function]
def plm_video_decode(var self : plm_video_t?) : plm_frame_t? {
    if (!(plm_video_has_header(self) != 0)) {
        return null
    }
    var frame : plm_frame_t? = null
    while (true) {
        if (self.start_code != plmpeg_file_all__PLM_START_PICTURE) {
            self.start_code = plm_buffer_find_start_code(self.buffer, plmpeg_file_all__PLM_START_PICTURE)
            if (self.start_code == -1) {
                // If we reached the end of the file and the previously decoded
                // frame was a reference frame, we still have to return it.
                if (self.has_reference_frame != 0 && !(self.assume_no_b_frames != 0) && plm_buffer_has_ended(self.buffer) != 0 && (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_INTRA || self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_PREDICTIVE)) {
                    self.has_reference_frame = FALSE
                    frame = addr(self.frame_backward)
                    break
                }
                return null
            }
        }
        // Make sure we have a full picture in the buffer before attempting to
        // decode it. Sadly, this can only be done by seeking for the start code
        // of the next picture. Also, if we didn't find the start code for the
        // next picture, but the source has ended, we assume that this last
        // picture is in the buffer.
        if (plm_buffer_has_start_code(self.buffer, plmpeg_file_all__PLM_START_PICTURE) == -1 && !(plm_buffer_has_ended(self.buffer) != 0)) {
            return null
        }
        plm_buffer_discard_read_bytes(self.buffer)
        plm_video_decode_picture(self)
        if (self.assume_no_b_frames != 0) {
            frame = addr(self.frame_backward)
        } elif (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_B) {
            frame = addr(self.frame_current)
        } elif (self.has_reference_frame != 0) {
            frame = addr(self.frame_forward)
        } else {
            self.has_reference_frame = TRUE
        }
        if (!(!(frame != null))) {
            break
        }
    }
    frame.time = self.time
    self.frames_decoded++
    self.time = double(self.frames_decoded) / self.framerate
    return frame
}

def plm_video_has_header(var self : plm_video_t?) : int {
    if (self.has_sequence_header != 0) {
        return TRUE
    }
    if (self.start_code != plmpeg_file_all__PLM_START_SEQUENCE) {
        self.start_code = plm_buffer_find_start_code(self.buffer, plmpeg_file_all__PLM_START_SEQUENCE)
    }
    if (self.start_code == -1) {
        return FALSE
    }
    if (!(plm_video_decode_sequence_header(self) != 0)) {
        return FALSE
    }
    return TRUE
}

[c_function]
def plm_video_decode_sequence_header(var self : plm_video_t?) : int {
    // 64 bit header + 2x 64 byte matrix
    var max_header_size : int = 64 + 2 * 64 * 8
    if (!(plm_buffer_has(self.buffer, uint64(max_header_size)) != 0)) {
        return FALSE
    }
    self.width = plm_buffer_read(self.buffer, 12)
    self.height = plm_buffer_read(self.buffer, 12)
    if (self.width <= 0 || self.height <= 0) {
        return FALSE
    }
    // Get pixel aspect ratio
    var pixel_aspect_ratio_code : int
    pixel_aspect_ratio_code = plm_buffer_read(self.buffer, 4)
    pixel_aspect_ratio_code -= 1
    if (pixel_aspect_ratio_code < 0) {
        pixel_aspect_ratio_code = 0
    }
    var par_last : int = int(uint64(typeinfo sizeof(type<float[14]>)) / uint64(typeinfo sizeof(type<float>)) - uint64(1))
    if (pixel_aspect_ratio_code > par_last) {
        pixel_aspect_ratio_code = par_last
    }
    self.pixel_aspect_ratio = double(plmpeg_file_all__PLM_VIDEO_PIXEL_ASPECT_RATIO[pixel_aspect_ratio_code])
    // Get frame rate
    self.framerate = plmpeg_file_all__PLM_VIDEO_PICTURE_RATE[plm_buffer_read(self.buffer, 4)]
    // Skip bit_rate, marker, buffer_size and constrained bit
    plm_buffer_skip(self.buffer, uint64(18 + 1 + 10 + 1))
    // Load custom intra quant matrix?
    if (plm_buffer_read(self.buffer, 1) != 0) {
        for (i in range(64)) {
            var idx : int = int(plmpeg_file_all__PLM_VIDEO_ZIG_ZAG[i])
            self.intra_quant_matrix[idx] = uint8(plm_buffer_read(self.buffer, 8))
        }
    } else {
        crt::memcpy(reinterpret<void?>(addr(self.intra_quant_matrix[0])), reinterpret<void?>(addr(plmpeg_file_all__PLM_VIDEO_INTRA_QUANT_MATRIX[0])), uint64(64))
    }
    // Load custom non intra quant matrix?
    if (plm_buffer_read(self.buffer, 1) != 0) {
        for (i in range(64)) {
            var idx : int = int(plmpeg_file_all__PLM_VIDEO_ZIG_ZAG[i])
            self.non_intra_quant_matrix[idx] = uint8(plm_buffer_read(self.buffer, 8))
        }
    } else {
        crt::memcpy(reinterpret<void?>(addr(self.non_intra_quant_matrix[0])), reinterpret<void?>(addr(plmpeg_file_all__PLM_VIDEO_NON_INTRA_QUANT_MATRIX[0])), uint64(64))
    }
    self.mb_width = self.width + 15 >> 4
    self.mb_height = self.height + 15 >> 4
    self.mb_size = self.mb_width * self.mb_height
    self.luma_width = self.mb_width << 4
    self.luma_height = self.mb_height << 4
    self.chroma_width = self.mb_width << 3
    self.chroma_height = self.mb_height << 3
    // Allocate one big chunk of data for all 3 frames = 9 planes
    var luma_plane_size : uint64 = uint64(self.luma_width * self.luma_height)
    var chroma_plane_size : uint64 = uint64(self.chroma_width * self.chroma_height)
    var frame_data_size : uint64 = luma_plane_size + uint64(2) * chroma_plane_size
    self.frames_data = reinterpret<uint8?>(crt::malloc(frame_data_size * uint64(3)))
    plm_video_init_frame(self, addr(self.frame_current), self.frames_data + frame_data_size * uint64(0))
    plm_video_init_frame(self, addr(self.frame_forward), self.frames_data + frame_data_size * uint64(1))
    plm_video_init_frame(self, addr(self.frame_backward), self.frames_data + frame_data_size * uint64(2))
    self.has_sequence_header = TRUE
    return TRUE
}

[c_function]
def plm_video_init_frame(var self : plm_video_t?; var frame : plm_frame_t?; var base : uint8?) {
    var luma_plane_size : uint64 = uint64(self.luma_width * self.luma_height)
    var chroma_plane_size : uint64 = uint64(self.chroma_width * self.chroma_height)
    frame.width = uint(self.width)
    frame.height = uint(self.height)
    frame.y.width = uint(self.luma_width)
    frame.y.height = uint(self.luma_height)
    frame.y.data = base
    frame.cr.width = uint(self.chroma_width)
    frame.cr.height = uint(self.chroma_height)
    frame.cr.data = base + luma_plane_size
    frame.cb.width = uint(self.chroma_width)
    frame.cb.height = uint(self.chroma_height)
    frame.cb.data = base + luma_plane_size + chroma_plane_size
}

def plm_video_decode_picture(var self : plm_video_t?) {
    // skip temporalReference
    plm_buffer_skip(self.buffer, uint64(10))
    self.picture_type = plm_buffer_read(self.buffer, 3)
    // skip vbv_delay
    plm_buffer_skip(self.buffer, uint64(16))
    // D frames or unknown coding type
    if (self.picture_type <= 0 || self.picture_type > plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_B) {
        return
    }
    // Forward full_px, f_code
    if (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_PREDICTIVE || self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_B) {
        self.motion_forward.full_px = plm_buffer_read(self.buffer, 1)
        var f_code : int = plm_buffer_read(self.buffer, 3)
        if (f_code == 0) {
            // Ignore picture with zero f_code
            return
        }
        self.motion_forward.r_size = f_code - 1
    }
    // Backward full_px, f_code
    if (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_B) {
        self.motion_backward.full_px = plm_buffer_read(self.buffer, 1)
        var f_code : int = plm_buffer_read(self.buffer, 3)
        if (f_code == 0) {
            // Ignore picture with zero f_code
            return
        }
        self.motion_backward.r_size = f_code - 1
    }
    var frame_temp : plm_frame_t = self.frame_forward
    if (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_INTRA || self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_PREDICTIVE) {
        self.frame_forward = self.frame_backward
    }
    // Find first slice start code; skip extension and user data
    while (true) {
        self.start_code = plm_buffer_next_start_code(self.buffer)
        if (!(self.start_code == plmpeg_file_all__PLM_START_EXTENSION || self.start_code == plmpeg_file_all__PLM_START_USER_DATA)) {
            break
        }
    }
    // Decode all slices
    while (self.start_code >= plmpeg_file_all__PLM_START_SLICE_FIRST && self.start_code <= plmpeg_file_all__PLM_START_SLICE_LAST) {
        plm_video_decode_slice(self, self.start_code & 255)
        if (self.macroblock_address >= self.mb_size - 1) {
            break
        }
        self.start_code = plm_buffer_next_start_code(self.buffer)
    }
    // If this is a reference picture rotate the prediction pointers
    if (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_INTRA || self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_PREDICTIVE) {
        self.frame_backward = self.frame_current
        self.frame_current = frame_temp
    }
}

def plm_video_decode_slice(var self : plm_video_t?; slice : int) {
    self.slice_begin = TRUE
    self.macroblock_address = (slice - 1) * self.mb_width - 1
    // Reset motion vectors and DC predictors
    self.motion_forward.h = 0
    self.motion_backward.h = self.motion_forward.h
    self.motion_forward.v = 0
    self.motion_backward.v = self.motion_forward.v
    self.dc_predictor[0] = 128
    self.dc_predictor[1] = 128
    self.dc_predictor[2] = 128
    self.quantizer_scale = plm_buffer_read(self.buffer, 5)
    // Skip extra
    while (plm_buffer_read(self.buffer, 1) != 0) {
        plm_buffer_skip(self.buffer, uint64(8))
    }
    while (true) {
        plm_video_decode_macroblock(self)
        if (!(self.macroblock_address < self.mb_size - 1 && plm_buffer_peek_non_zero(self.buffer, 23) != 0)) {
            break
        }
    }
}

[c_function]
def plm_video_decode_macroblock(var self : plm_video_t?) {
    // Decode increment
    var increment : int = 0
    var t : int = int(plm_buffer_read_vlc(self.buffer, addr(plmpeg_file_all__PLM_VIDEO_MACROBLOCK_ADDRESS_INCREMENT[0])))
    while (t == 34) {
        // macroblock_stuffing
        t = int(plm_buffer_read_vlc(self.buffer, addr(plmpeg_file_all__PLM_VIDEO_MACROBLOCK_ADDRESS_INCREMENT[0])))
    }
    while (t == 35) {
        // macroblock_escape
        increment += 33
        t = int(plm_buffer_read_vlc(self.buffer, addr(plmpeg_file_all__PLM_VIDEO_MACROBLOCK_ADDRESS_INCREMENT[0])))
    }
    increment += t
    // Process any skipped macroblocks
    if (self.slice_begin != 0) {
        // The first increment of each slice is relative to beginning of the
        // previous row, not the previous macroblock
        self.slice_begin = FALSE
        self.macroblock_address += increment
    } else {
        if (self.macroblock_address + increment >= self.mb_size) {
            // invalid
            return
        }
        if (increment > 1) {
            // Skipped macroblocks reset DC predictors
            self.dc_predictor[0] = 128
            self.dc_predictor[1] = 128
            self.dc_predictor[2] = 128
            // Skipped macroblocks in P-pictures reset motion vectors
            if (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_PREDICTIVE) {
                self.motion_forward.h = 0
                self.motion_forward.v = 0
            }
        }
        // Predict skipped macroblocks
        while (increment > 1) {
            self.macroblock_address++
            self.mb_row = self.macroblock_address / self.mb_width
            self.mb_col = self.macroblock_address % self.mb_width
            plm_video_predict_macroblock(self)
            increment--
        }
        self.macroblock_address++
    }
    self.mb_row = self.macroblock_address / self.mb_width
    self.mb_col = self.macroblock_address % self.mb_width
    if (self.mb_col >= self.mb_width || self.mb_row >= self.mb_height) {
        // corrupt stream;
        return
    }
    // Process the current macroblock
    var _c_table : plm_vlc_t? = plmpeg_file_all__PLM_VIDEO_MACROBLOCK_TYPE[self.picture_type]
    self.macroblock_type = int(plm_buffer_read_vlc(self.buffer, _c_table))
    self.macroblock_intra = self.macroblock_type & 1
    self.motion_forward.is_set = self.macroblock_type & 8
    self.motion_backward.is_set = self.macroblock_type & 4
    // Quantizer scale
    if ((self.macroblock_type & 16) != 0) {
        self.quantizer_scale = plm_buffer_read(self.buffer, 5)
    }
    if (self.macroblock_intra != 0) {
        // Intra-coded macroblocks reset motion vectors
        self.motion_forward.h = 0
        self.motion_backward.h = self.motion_forward.h
        self.motion_forward.v = 0
        self.motion_backward.v = self.motion_forward.v
    } else {
        // Non-intra macroblocks reset DC predictors
        self.dc_predictor[0] = 128
        self.dc_predictor[1] = 128
        self.dc_predictor[2] = 128
        plm_video_decode_motion_vectors(self)
        plm_video_predict_macroblock(self)
    }
    // Decode blocks
    var cbp : int = (self.macroblock_type & 2) != 0 ? int(plm_buffer_read_vlc(self.buffer, addr(plmpeg_file_all__PLM_VIDEO_CODE_BLOCK_PATTERN[0]))) : (self.macroblock_intra != 0 ? 63 : 0)
    {
        var _c_block : int = 0
        var mask : int = 32
        while (_c_block < 6) {
            if ((cbp & mask) != 0) {
                plm_video_decode_block(self, _c_block)
            }
            mask >>= 1
            _c_block++
        }
    }
}

def plm_video_decode_motion_vectors(var self : plm_video_t?) {
    // Forward
    if (self.motion_forward.is_set != 0) {
        var r_size : int = self.motion_forward.r_size
        self.motion_forward.h = plm_video_decode_motion_vector(self, r_size, self.motion_forward.h)
        self.motion_forward.v = plm_video_decode_motion_vector(self, r_size, self.motion_forward.v)
    } elif (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_PREDICTIVE) {
        // No motion information in P-picture, reset vectors
        self.motion_forward.h = 0
        self.motion_forward.v = 0
    }
    if (self.motion_backward.is_set != 0) {
        var r_size : int = self.motion_backward.r_size
        self.motion_backward.h = plm_video_decode_motion_vector(self, r_size, self.motion_backward.h)
        self.motion_backward.v = plm_video_decode_motion_vector(self, r_size, self.motion_backward.v)
    }
}

[c_function]
def plm_video_decode_motion_vector(var self : plm_video_t?; r_size : int; var motion : int) : int {
    var fscale : int = 1 << r_size
    var m_code : int = int(plm_buffer_read_vlc(self.buffer, addr(plmpeg_file_all__PLM_VIDEO_MOTION[0])))
    var r : int = 0
    var d : int
    if (m_code != 0 && fscale != 1) {
        r = plm_buffer_read(self.buffer, r_size)
        d = (plmpeg_abs(m_code) - 1 << r_size) + r + 1
        if (m_code < 0) {
            d = -d
        }
    } else {
        d = m_code
    }
    motion += d
    if (motion > (fscale << 4) - 1) {
        motion -= fscale << 5
    } elif (motion < int(uint(-fscale) << 4u)) {
        motion += fscale << 5
    }
    return motion
}

[c_function]
def plm_video_predict_macroblock(var self : plm_video_t?) {
    var fw_h : int = self.motion_forward.h
    var fw_v : int = self.motion_forward.v
    if (self.motion_forward.full_px != 0) {
        fw_h <<= 1
        fw_v <<= 1
    }
    if (self.picture_type == plmpeg_file_all__PLM_VIDEO_PICTURE_TYPE_B) {
        var bw_h : int = self.motion_backward.h
        var bw_v : int = self.motion_backward.v
        if (self.motion_backward.full_px != 0) {
            bw_h <<= 1
            bw_v <<= 1
        }
        if (self.motion_forward.is_set != 0) {
            plm_video_copy_macroblock(self, addr(self.frame_forward), fw_h, fw_v)
            if (self.motion_backward.is_set != 0) {
                plm_video_interpolate_macroblock(self, addr(self.frame_backward), bw_h, bw_v)
            }
        } else {
            plm_video_copy_macroblock(self, addr(self.frame_backward), bw_h, bw_v)
        }
    } else {
        plm_video_copy_macroblock(self, addr(self.frame_forward), fw_h, fw_v)
    }
}

[c_function]
def plm_video_copy_macroblock(var self : plm_video_t?; var s : plm_frame_t?; motion_h : int; motion_v : int) {
    var d : plm_frame_t? = addr(self.frame_current)
    plm_video_process_macroblock(self, s.y.data, d.y.data, motion_h, motion_v, 16, FALSE)
    plm_video_process_macroblock(self, s.cr.data, d.cr.data, motion_h / 2, motion_v / 2, 8, FALSE)
    plm_video_process_macroblock(self, s.cb.data, d.cb.data, motion_h / 2, motion_v / 2, 8, FALSE)
}

[c_function]
def plm_video_interpolate_macroblock(var self : plm_video_t?; var s : plm_frame_t?; motion_h : int; motion_v : int) {
    var d : plm_frame_t? = addr(self.frame_current)
    plm_video_process_macroblock(self, s.y.data, d.y.data, motion_h, motion_v, 16, TRUE)
    plm_video_process_macroblock(self, s.cr.data, d.cr.data, motion_h / 2, motion_v / 2, 8, TRUE)
    plm_video_process_macroblock(self, s.cb.data, d.cb.data, motion_h / 2, motion_v / 2, 8, TRUE)
}

[c_function]
def plm_video_process_macroblock(var self : plm_video_t?; var s : uint8?; var d : uint8?; motion_h : int; motion_v : int; block_size : int; interpolate : int) {
    var dw : int = self.mb_width * block_size
    var hp : int = motion_h >> 1
    var vp : int = motion_v >> 1
    var odd_h : int = (motion_h & 1) == 1 ? 1 : 0
    var odd_v : int = (motion_v & 1) == 1 ? 1 : 0
    var si : uint = uint((self.mb_row * block_size + vp) * dw + self.mb_col * block_size + hp)
    var di : uint = uint((self.mb_row * dw + self.mb_col) * block_size)
    var max_address : uint = uint(dw * (self.mb_height * block_size - block_size + 1) - block_size)
    if (si > max_address || di > max_address) {
        // corrupt video
        return
    }
    let _cond = interpolate << 2 | odd_h << 1 | odd_v
    if (_cond == 0) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = deref(s + si)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    } elif (_cond == 1) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = uint8(int(deref(s + si)) + int(deref(s + (si + uint(dw)))) + 1 >> 1)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    } elif (_cond == 2) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = uint8(int(deref(s + si)) + int(deref(s + (si + uint(1)))) + 1 >> 1)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    } elif (_cond == 3) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = uint8(int(deref(s + si)) + int(deref(s + (si + uint(1)))) + int(deref(s + (si + uint(dw)))) + int(deref(s + (si + uint(dw) + uint(1)))) + 2 >> 2)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    } elif (_cond == 4) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = uint8(int(deref(d + di)) + int(deref(s + si)) + 1 >> 1)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    } elif (_cond == 5) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = uint8(int(deref(d + di)) + (int(deref(s + si)) + int(deref(s + (si + uint(dw)))) + 1 >> 1) + 1 >> 1)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    } elif (_cond == 6) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = uint8(int(deref(d + di)) + (int(deref(s + si)) + int(deref(s + (si + uint(1)))) + 1 >> 1) + 1 >> 1)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    } elif (_cond == 7) {
        {
            var dest_scan : int = dw - block_size
            var source_scan : int = dw - block_size
            for (y in range(block_size)) {
                for (x in range(block_size)) {
                    deref(d + di) = uint8(int(deref(d + di)) + (int(deref(s + si)) + int(deref(s + (si + uint(1)))) + int(deref(s + (si + uint(dw)))) + int(deref(s + (si + uint(dw) + uint(1)))) + 2 >> 2) + 1 >> 1)
                    si++
                    di++
                }
                si += uint(source_scan)
                di += uint(dest_scan)
            }
        }
    }
}

[c_function]
def plm_video_decode_block(var self : plm_video_t?; _c_block : int) {
    var n : int = 0
    var quant_matrix : uint8?
    // Decode DC coefficient of intra-coded blocks
    if (self.macroblock_intra != 0) {
        var predictor : int
        var dct_size : int
        // DC prediction
        var plane_index : int = _c_block > 3 ? _c_block - 3 : 0
        predictor = self.dc_predictor[plane_index]
        dct_size = int(plm_buffer_read_vlc(self.buffer, plmpeg_file_all__PLM_VIDEO_DCT_SIZE[plane_index]))
        // Read DC coeff
        if (dct_size > 0) {
            var differential : int = plm_buffer_read(self.buffer, dct_size)
            if ((differential & 1 << dct_size - 1) != 0) {
                self.block_data[0] = predictor + differential
            } else {
                self.block_data[0] = predictor + (-(1 << dct_size) | differential + 1)
            }
        } else {
            self.block_data[0] = predictor
        }
        // Save predictor value
        self.dc_predictor[plane_index] = self.block_data[0]
        // Dequantize + premultiply
        self.block_data[0] <<= 3 + 5
        quant_matrix = addr(self.intra_quant_matrix[0])
        n = 1
    } else {
        quant_matrix = addr(self.non_intra_quant_matrix[0])
    }
    // Decode AC coefficients (+DC for non-intra)
    var level : int = 0
    while (TRUE != 0) {
        var run : int = 0
        var coeff : uint16 = plm_buffer_read_vlc_uint(self.buffer, addr(plmpeg_file_all__PLM_VIDEO_DCT_COEFF[0]))
        if (int(coeff) == 1 && n > 0 && plm_buffer_read(self.buffer, 1) == 0) {
            // end_of_block
            break
        }
        if (int(coeff) == 65535) {
            // escape
            run = plm_buffer_read(self.buffer, 6)
            level = plm_buffer_read(self.buffer, 8)
            if (level == 0) {
                level = plm_buffer_read(self.buffer, 8)
            } elif (level == 128) {
                level = plm_buffer_read(self.buffer, 8) - 256
            } elif (level > 128) {
                level -= 256
            }
        } else {
            run = int(coeff) >> 8
            level = int(coeff) & 255
            if (plm_buffer_read(self.buffer, 1) != 0) {
                level = -level
            }
        }
        n += run
        if (n < 0 || n >= 64) {
            // invalid
            return
        }
        var de_zig_zagged : int = int(plmpeg_file_all__PLM_VIDEO_ZIG_ZAG[n])
        n++
        // Dequantize, oddify, clip
        level = int(uint(level) << 1u)
        if (!(self.macroblock_intra != 0)) {
            level += level < 0 ? -1 : 1
        }
        level = level * self.quantizer_scale * int(deref(quant_matrix + de_zig_zagged)) >> 4
        if ((level & 1) == 0) {
            level -= level > 0 ? 1 : -1
        }
        if (level > 2047) {
            level = 2047
        } elif (level < -2048) {
            level = -2048
        }
        // Save premultiplied coefficient
        self.block_data[de_zig_zagged] = level * int(plmpeg_file_all__PLM_VIDEO_PREMULTIPLIER_MATRIX[de_zig_zagged])
    }
    // Move block to its place
    var d : uint8?
    var dw : int
    var di : int
    if (_c_block < 4) {
        d = self.frame_current.y.data
        dw = self.luma_width
        di = self.mb_row * self.luma_width + self.mb_col << 4
        if ((_c_block & 1) != 0) {
            di += 8
        }
        if ((_c_block & 2) != 0) {
            di += self.luma_width << 3
        }
    } else {
        d = _c_block == 4 ? self.frame_current.cb.data : self.frame_current.cr.data
        dw = self.chroma_width
        di = (self.mb_row * self.luma_width << 2) + (self.mb_col << 3)
    }
    var s : int? = addr(self.block_data[0])
    var si : int = 0
    if (self.macroblock_intra != 0) {
        // Overwrite (no prediction)
        if (n == 1) {
            var clamped : int = int(plmpeg_file_all__plm_clamp(deref(s + 0) + 128 >> 8))
            {
                var dest_scan : int = dw - 8
                var source_scan : int = 8 - 8
                for (y in range(8)) {
                    for (x in range(8)) {
                        deref(d + di) = uint8(clamped)
                        si++
                        di++
                    }
                    si += source_scan
                    di += dest_scan
                }
            }
            deref(s + 0) = 0
        } else {
            plm_video_idct(s)
            {
                var dest_scan : int = dw - 8
                var source_scan : int = 8 - 8
                for (y in range(8)) {
                    for (x in range(8)) {
                        deref(d + di) = plmpeg_file_all__plm_clamp(deref(s + si))
                        si++
                        di++
                    }
                    si += source_scan
                    di += dest_scan
                }
            }
            crt::memset(reinterpret<void?>(addr(self.block_data[0])), 0, uint64(typeinfo sizeof(type<int[64]>)))
        }
    } else {
        // Add data to the predicted macroblock
        if (n == 1) {
            var value : int = deref(s + 0) + 128 >> 8
            {
                var dest_scan : int = dw - 8
                var source_scan : int = 8 - 8
                for (y in range(8)) {
                    for (x in range(8)) {
                        deref(d + di) = plmpeg_file_all__plm_clamp(int(deref(d + di)) + value)
                        si++
                        di++
                    }
                    si += source_scan
                    di += dest_scan
                }
            }
            deref(s + 0) = 0
        } else {
            plm_video_idct(s)
            {
                var dest_scan : int = dw - 8
                var source_scan : int = 8 - 8
                for (y in range(8)) {
                    for (x in range(8)) {
                        deref(d + di) = plmpeg_file_all__plm_clamp(int(deref(d + di)) + deref(s + si))
                        si++
                        di++
                    }
                    si += source_scan
                    di += dest_scan
                }
            }
            crt::memset(reinterpret<void?>(addr(self.block_data[0])), 0, uint64(typeinfo sizeof(type<int[64]>)))
        }
    }
}

[c_function]
def plm_video_idct(var _c_block : int?) {
    var b1 : int
    var b3 : int
    var b4 : int
    var b6 : int
    var b7 : int
    var tmp1 : int
    var tmp2 : int
    var m0 : int
    var x0 : int
    var x1 : int
    var x2 : int
    var x3 : int
    var x4 : int
    var y3 : int
    var y4 : int
    var y5 : int
    var y6 : int
    var y7 : int
    // Transform columns
    for (i in range(8)) {
        b1 = deref(_c_block + (4 * 8 + i))
        b3 = deref(_c_block + (2 * 8 + i)) + deref(_c_block + (6 * 8 + i))
        b4 = deref(_c_block + (5 * 8 + i)) - deref(_c_block + (3 * 8 + i))
        tmp1 = deref(_c_block + (1 * 8 + i)) + deref(_c_block + (7 * 8 + i))
        tmp2 = deref(_c_block + (3 * 8 + i)) + deref(_c_block + (5 * 8 + i))
        b6 = deref(_c_block + (1 * 8 + i)) - deref(_c_block + (7 * 8 + i))
        b7 = tmp1 + tmp2
        m0 = deref(_c_block + (0 * 8 + i))
        x4 = (b6 * 473 - b4 * 196 + 128 >> 8) - b7
        x0 = x4 - ((tmp1 - tmp2) * 362 + 128 >> 8)
        x1 = m0 - b1
        x2 = ((deref(_c_block + (2 * 8 + i)) - deref(_c_block + (6 * 8 + i))) * 362 + 128 >> 8) - b3
        x3 = m0 + b1
        y3 = x1 + x2
        y4 = x3 + b3
        y5 = x1 - x2
        y6 = x3 - b3
        y7 = -x0 - (b4 * 473 + b6 * 196 + 128 >> 8)
        deref(_c_block + (0 * 8 + i)) = b7 + y4
        deref(_c_block + (1 * 8 + i)) = x4 + y3
        deref(_c_block + (2 * 8 + i)) = y5 - x0
        deref(_c_block + (3 * 8 + i)) = y6 - y7
        deref(_c_block + (4 * 8 + i)) = y6 + y7
        deref(_c_block + (5 * 8 + i)) = x0 + y5
        deref(_c_block + (6 * 8 + i)) = y3 - x4
        deref(_c_block + (7 * 8 + i)) = y4 - b7
    }
    // Transform rows
    {
        var i : int = 0
        while (i < 64) {
            b1 = deref(_c_block + (4 + i))
            b3 = deref(_c_block + (2 + i)) + deref(_c_block + (6 + i))
            b4 = deref(_c_block + (5 + i)) - deref(_c_block + (3 + i))
            tmp1 = deref(_c_block + (1 + i)) + deref(_c_block + (7 + i))
            tmp2 = deref(_c_block + (3 + i)) + deref(_c_block + (5 + i))
            b6 = deref(_c_block + (1 + i)) - deref(_c_block + (7 + i))
            b7 = tmp1 + tmp2
            m0 = deref(_c_block + (0 + i))
            x4 = (b6 * 473 - b4 * 196 + 128 >> 8) - b7
            x0 = x4 - ((tmp1 - tmp2) * 362 + 128 >> 8)
            x1 = m0 - b1
            x2 = ((deref(_c_block + (2 + i)) - deref(_c_block + (6 + i))) * 362 + 128 >> 8) - b3
            x3 = m0 + b1
            y3 = x1 + x2
            y4 = x3 + b3
            y5 = x1 - x2
            y6 = x3 - b3
            y7 = -x0 - (b4 * 473 + b6 * 196 + 128 >> 8)
            deref(_c_block + (0 + i)) = b7 + y4 + 128 >> 8
            deref(_c_block + (1 + i)) = x4 + y3 + 128 >> 8
            deref(_c_block + (2 + i)) = y5 - x0 + 128 >> 8
            deref(_c_block + (3 + i)) = y6 - y7 + 128 >> 8
            deref(_c_block + (4 + i)) = y6 + y7 + 128 >> 8
            deref(_c_block + (5 + i)) = x0 + y5 + 128 >> 8
            deref(_c_block + (6 + i)) = y3 - x4 + 128 >> 8
            deref(_c_block + (7 + i)) = y4 - b7 + 128 >> 8
            i += 8
        }
    }
}

[c_function]
def plm_frame_to_rgb(var frame : plm_frame_t?; var dest : uint8?; stride : int) {
    var cols : int = int(frame.width >> 1u)
    var rows : int = int(frame.height >> 1u)
    var yw : int = int(frame.y.width)
    var cw : int = int(frame.cb.width)
    for (row in range(rows)) {
        var c_index : int = row * cw
        var y_index : int = row * 2 * yw
        var d_index : int = row * 2 * stride
        for (col in range(cols)) {
            var y : int
            var cr : int = int(deref(frame.cr.data + c_index)) - 128
            var cb : int = int(deref(frame.cb.data + c_index)) - 128
            var r : int = cr * 104597 >> 16
            var g : int = cb * 25674 + cr * 53278 >> 16
            var b : int = cb * 132201 >> 16
            y = (int(deref(frame.y.data + (y_index + 0))) - 16) * 76309 >> 16
            deref(dest + (d_index + 0 + 0)) = plmpeg_file_all__plm_clamp(y + r)
            deref(dest + (d_index + 0 + 1)) = plmpeg_file_all__plm_clamp(y - g)
            deref(dest + (d_index + 0 + 2)) = plmpeg_file_all__plm_clamp(y + b)
            y = (int(deref(frame.y.data + (y_index + 1))) - 16) * 76309 >> 16
            deref(dest + (d_index + 3 + 0)) = plmpeg_file_all__plm_clamp(y + r)
            deref(dest + (d_index + 3 + 1)) = plmpeg_file_all__plm_clamp(y - g)
            deref(dest + (d_index + 3 + 2)) = plmpeg_file_all__plm_clamp(y + b)
            y = (int(deref(frame.y.data + (y_index + yw))) - 16) * 76309 >> 16
            deref(dest + (d_index + stride + 0)) = plmpeg_file_all__plm_clamp(y + r)
            deref(dest + (d_index + stride + 1)) = plmpeg_file_all__plm_clamp(y - g)
            deref(dest + (d_index + stride + 2)) = plmpeg_file_all__plm_clamp(y + b)
            y = (int(deref(frame.y.data + (y_index + yw + 1))) - 16) * 76309 >> 16
            deref(dest + (d_index + stride + 3 + 0)) = plmpeg_file_all__plm_clamp(y + r)
            deref(dest + (d_index + stride + 3 + 1)) = plmpeg_file_all__plm_clamp(y - g)
            deref(dest + (d_index + stride + 3 + 2)) = plmpeg_file_all__plm_clamp(y + b)
            c_index += 1
            y_index += 2
            d_index += 2 * 3
        }
    }
}

[c_function]
def plm_frame_to_bgr(var frame : plm_frame_t?; var dest : uint8?; stride : int) {
    var cols : int = int(frame.width >> 1u)
    var rows : int = int(frame.height >> 1u)
    var yw : int = int(frame.y.width)
    var cw : int = int(frame.cb.width)
    for (row in range(rows)) {
        var c_index : int = row * cw
        var y_index : int = row * 2 * yw
        var d_index : int = row * 2 * stride
        for (col in range(cols)) {
            var y : int
            var cr : int = int(deref(frame.cr.data + c_index)) - 128
            var cb : int = int(deref(frame.cb.data + c_index)) - 128
            var r : int = cr * 104597 >> 16
            var g : int = cb * 25674 + cr * 53278 >> 16
            var b : int = cb * 132201 >> 16
            y = (int(deref(frame.y.data + (y_index + 0))) - 16) * 76309 >> 16
            deref(dest + (d_index + 0 + 2)) = plmpeg_file_all__plm_clamp(y + r)
            deref(dest + (d_index + 0 + 1)) = plmpeg_file_all__plm_clamp(y - g)
            deref(dest + (d_index + 0 + 0)) = plmpeg_file_all__plm_clamp(y + b)
            y = (int(deref(frame.y.data + (y_index + 1))) - 16) * 76309 >> 16
            deref(dest + (d_index + 3 + 2)) = plmpeg_file_all__plm_clamp(y + r)
            deref(dest + (d_index + 3 + 1)) = plmpeg_file_all__plm_clamp(y - g)
