def private plmpeg_file_all__rotl32(value : uint; shift : uint) : uint {
    return value << shift | value >> 32u - shift
}

[c_function]
def private plmpeg_file_all__fold_bytes(var bytes : uint8?; length : int) : uint {
    var hash : uint = 2166136261u
    for (index in range(length)) {
        hash ^= uint(deref(bytes + index))
        hash *= 16777619u
        hash = plmpeg_file_all__rotl32(hash, 5u)
    }
    return hash
}

// pl_mpeg treats the memory handed to plm_buffer_create_with_memory as its
// own working buffer: plm_video_decode calls plm_buffer_discard_read_bytes,
// which memmove()s the unread tail to the front of that very memory. The
// embedded sample is `static const`, so every decode session must work on a
// fresh heap copy: in C the original lives in read-only storage (writing it
// is a segfault), and in either graph a second session would otherwise see a
// stream the first one already shifted.
[c_function]
def private plmpeg_file_all__sample_copy : uint8? {
    var copy : uint8? = reinterpret<uint8?>(crt::malloc(uint64(plmpeg_file_all__sample_mpg_len)))
    if (!(copy != null)) {
        return null
    }
    crt::memcpy(reinterpret<void?>(copy), reinterpret<void?>(addr(plmpeg_file_all__sample_mpg_bytes[0])), uint64(plmpeg_file_all__sample_mpg_len))
    return copy
}

def private plmpeg_file_all__create_decoder(var bytes : uint8?; length : uint64) : plm_video_t? {
    var buffer : plm_buffer_t? = plm_buffer_create_with_memory(bytes, length, 0)
    var video : plm_video_t? = null
    if (!(buffer != null)) {
        return null
    }
    video = plm_video_create_with_buffer(buffer, 1)
    if (!(video != null)) {
        plm_buffer_destroy(buffer)
        return null
    }
    plm_video_set_no_delay(video, 1)
    return video
}

[c_function]
def private plmpeg_file_all__decode_summary(var bytes : uint8?; length : uint64; frame_limit : int; var summary : DecodeSummary?) : int {
    var video : plm_video_t? = plmpeg_file_all__create_decoder(bytes, length)
    var rgb_size : int = 0
    var rgb : uint8? = null
    var frame_index : int = 0
    if (!(video != null)) {
        return 0
    }
    summary.combined_hash = 2166136261u
    summary.first_hash = 0u
    summary.last_hash = 0u
    summary.frame_count = 0
    summary.width = plm_video_get_width(video)
    summary.height = plm_video_get_height(video)
    if (summary.width <= 0 || summary.height <= 0) {
        plm_video_destroy(video)
        return 0
    }
    rgb_size = summary.width * summary.height * 3
    rgb = reinterpret<uint8?>(crt::malloc(uint64(rgb_size)))
    if (!(rgb != null)) {
        plm_video_destroy(video)
        return 0
    }
    while (1 != 0) {
        var frame : plm_frame_t? = plm_video_decode(video)
        var frame_hash : uint = 0u
        if (!(frame != null)) {
            break
        }
        plm_frame_to_rgb(frame, rgb, summary.width * 3)
        frame_hash = plmpeg_file_all__fold_bytes(rgb, rgb_size)
        if (frame_index == 0) {
            summary.first_hash = frame_hash
        }
        summary.last_hash = frame_hash
        summary.combined_hash ^= frame_hash + uint(frame_index) * 2654435769u
        summary.combined_hash = plmpeg_file_all__rotl32(summary.combined_hash, 7u)
        summary.combined_hash += 2135587861u
        summary.frame_count = frame_index + 1
        frame_index += 1
        if (frame_limit > 0 && frame_index >= frame_limit) {
            break
        }
    }
    summary.combined_hash ^= uint(summary.width)
    summary.combined_hash = plmpeg_file_all__rotl32(summary.combined_hash, 3u)
    summary.combined_hash ^= uint(summary.height)
    summary.combined_hash = plmpeg_file_all__rotl32(summary.combined_hash, 3u)
    summary.combined_hash ^= uint(summary.frame_count)
    plm_video_destroy(video)
    return 1
}

[c_function]
def private plmpeg_file_all__decode_frame_rgb(var bytes : uint8?; length : uint64; frame_index : int; var rgb_ptr : uint8 ??; var rgb_size : int?; var width : int?; var height : int?) : int {
    var video : plm_video_t? = plmpeg_file_all__create_decoder(bytes, length)
    var rgb : uint8? = null
    var local_width : int = 0
    var local_height : int = 0
    var local_size : int = 0
    var current : int = 0
    if (!(video != null)) {
        return 0
    }
    local_width = plm_video_get_width(video)
    local_height = plm_video_get_height(video)
    if (local_width <= 0 || local_height <= 0) {
        plm_video_destroy(video)
        return 0
    }
    local_size = local_width * local_height * 3
    rgb = reinterpret<uint8?>(crt::malloc(uint64(local_size)))
    if (!(rgb != null)) {
        plm_video_destroy(video)
        return 0
    }
    while (1 != 0) {
        var frame : plm_frame_t? = plm_video_decode(video)
        if (!(frame != null)) {
            plm_video_destroy(video)
            return 0
        }
        if (current == frame_index) {
            plm_frame_to_rgb(frame, rgb, local_width * 3)
            deref(rgb_ptr) = rgb
            deref(rgb_size) = local_size
            deref(width) = local_width
            deref(height) = local_height
            plm_video_destroy(video)
            return 1
        }
        current += 1
    }
    return 0
}

def private plmpeg_file_all__host_stream_end_internal {
    if (plmpeg_file_all__host_stream_video != null) {
        plm_video_destroy(plmpeg_file_all__host_stream_video)
    }
    plmpeg_file_all__host_stream_video = null
    plmpeg_file_all__host_stream_rgb = null
    plmpeg_file_all__host_stream_rgb_size = 0
    plmpeg_file_all__host_stream_width = 0
    plmpeg_file_all__host_stream_height = 0
    plmpeg_file_all__host_stream_frame_index = -1
}

// Fresh runtime, fresh sample copy, one full decode session.
def private plmpeg_file_all__sample_summary(frame_limit : int; var summary : DecodeSummary?) : int {
    var bytes : uint8? = null
    bytes = plmpeg_file_all__sample_copy()
    if (!(bytes != null)) {
        return 0
    }
    return plmpeg_file_all__decode_summary(bytes, uint64(plmpeg_file_all__sample_mpg_len), frame_limit, summary)
}

[c_function]
def plmpeg_decode_hash(frame_limit : int) : int {
    var summary : DecodeSummary
    if (!(plmpeg_file_all__sample_summary(frame_limit, addr(summary)) != 0)) {
        return -1
    }
    return int(summary.combined_hash)
}

[c_function]
def plmpeg_probe_width : int {
    var summary : DecodeSummary
    if (!(plmpeg_file_all__sample_summary(1, addr(summary)) != 0)) {
        return -1
    }
    return summary.width
}

[c_function]
def plmpeg_probe_height : int {
    var summary : DecodeSummary
    if (!(plmpeg_file_all__sample_summary(1, addr(summary)) != 0)) {
        return -1
    }
    return summary.height
}

[c_function]
def plmpeg_probe_frame_count(frame_limit : int) : int {
    var summary : DecodeSummary
    if (!(plmpeg_file_all__sample_summary(frame_limit, addr(summary)) != 0)) {
        return -1
    }
    return summary.frame_count
}

[c_function]
def plmpeg_probe_first_frame_hash : int {
    var summary : DecodeSummary
    if (!(plmpeg_file_all__sample_summary(1, addr(summary)) != 0)) {
        return -1
    }
    return int(summary.first_hash)
}

[c_function]
def plmpeg_probe_last_frame_hash(frame_limit : int) : int {
    var summary : DecodeSummary
    if (!(plmpeg_file_all__sample_summary(frame_limit, addr(summary)) != 0)) {
        return -1
    }
    return int(summary.last_hash)
}

def plmpeg_probe_sequence_start_code : int {
    var buffer : plm_buffer_t? = null
    var code : int = -1
    var bytes : uint8? = null
    bytes = plmpeg_file_all__sample_copy()
    if (!(bytes != null)) {
        return -3
    }
    buffer = plm_buffer_create_with_memory(bytes, uint64(plmpeg_file_all__sample_mpg_len), 0)
    if (!(buffer != null)) {
        return -2
    }
    code = plm_buffer_find_start_code(buffer, plmpeg_file_all__PLMPEG_START_SEQUENCE)
    plm_buffer_destroy(buffer)
    return code
}

def plmpeg_probe_video_has_header : int {
    var video : plm_video_t? = null
    var result : int = 0
    var bytes : uint8? = null
    bytes = plmpeg_file_all__sample_copy()
    if (!(bytes != null)) {
        return -3
    }
    video = plmpeg_file_all__create_decoder(bytes, uint64(plmpeg_file_all__sample_mpg_len))
    if (!(video != null)) {
        return -1
    }
    result = plm_video_has_header(video)
    plm_video_destroy(video)
    return result
}

[c_function]
def plmpeg_host_alloc(size : int) : int {
    var result : void? = null
    if (size <= 0) {
        return 0
    }
    result = crt::malloc(uint64(size))
    return int(int64(intptr(result)))
}

[c_function]
def plmpeg_host_load(bytes_ptr : int; bytes_len : int) : int {
    if (bytes_ptr == 0 || bytes_len <= 0) {
        return 0
    }
    plmpeg_file_all__host_bytes = reinterpret<uint8?>(uint64(int64(bytes_ptr)))
    plmpeg_file_all__host_length = bytes_len
    plmpeg_file_all__host_rgb = null
    plmpeg_file_all__host_rgb_size = 0
    plmpeg_file_all__host_width = 0
    plmpeg_file_all__host_height = 0
    plmpeg_file_all__host_stream_end_internal()
    return 1
}

[c_function]
def plmpeg_host_decode_frame(frame_index : int) : int {
    var rgb : uint8? = null
    var rgb_size : int = 0
    var width : int = 0
    var height : int = 0
    if (!(plmpeg_file_all__host_bytes != null) || plmpeg_file_all__host_length <= 0 || frame_index < 0) {
        return 0
    }
    if (!(plmpeg_file_all__decode_frame_rgb(plmpeg_file_all__host_bytes, uint64(plmpeg_file_all__host_length), frame_index, addr(rgb), addr(rgb_size), addr(width), addr(height)) != 0)) {
        return 0
    }
    plmpeg_file_all__host_rgb = rgb
    plmpeg_file_all__host_rgb_size = rgb_size
    plmpeg_file_all__host_width = width
    plmpeg_file_all__host_height = height
    return 1
}

def plmpeg_host_get_rgb_ptr : int {
    return int(int64(intptr(plmpeg_file_all__host_rgb)))
}

def plmpeg_host_get_rgb_size : int {
    return plmpeg_file_all__host_rgb_size
}

def plmpeg_host_get_width : int {
    return plmpeg_file_all__host_width
}

def plmpeg_host_get_height : int {
    return plmpeg_file_all__host_height
}

[c_function]
def plmpeg_host_stream_begin : int {
    var width : int = 0
    var height : int = 0
    var rgb_size : int = 0
    var rgb : uint8? = null
    if (!(plmpeg_file_all__host_bytes != null) || plmpeg_file_all__host_length <= 0) {
        return 0
    }
    plmpeg_file_all__host_stream_end_internal()
    plmpeg_file_all__host_stream_video = plmpeg_file_all__create_decoder(plmpeg_file_all__host_bytes, uint64(plmpeg_file_all__host_length))
    if (!(plmpeg_file_all__host_stream_video != null)) {
        return 0
    }
    width = plm_video_get_width(plmpeg_file_all__host_stream_video)
    height = plm_video_get_height(plmpeg_file_all__host_stream_video)
    if (width <= 0 || height <= 0) {
        plmpeg_file_all__host_stream_end_internal()
        return 0
    }
    rgb_size = width * height * 3
    rgb = reinterpret<uint8?>(crt::malloc(uint64(rgb_size)))
    if (!(rgb != null)) {
        plmpeg_file_all__host_stream_end_internal()
        return 0
    }
    plmpeg_file_all__host_stream_rgb = rgb
    plmpeg_file_all__host_stream_rgb_size = rgb_size
    plmpeg_file_all__host_stream_width = width
    plmpeg_file_all__host_stream_height = height
    plmpeg_file_all__host_stream_frame_index = -1
    return 1
}

def plmpeg_host_stream_decode_next : int {
    var frame : plm_frame_t? = null
    if (!(plmpeg_file_all__host_stream_video != null) || !(plmpeg_file_all__host_stream_rgb != null)) {
        return 0
    }
    frame = plm_video_decode(plmpeg_file_all__host_stream_video)
    if (!(frame != null)) {
        return 0
    }
    plm_frame_to_rgb(frame, plmpeg_file_all__host_stream_rgb, plmpeg_file_all__host_stream_width * 3)
    plmpeg_file_all__host_stream_frame_index += 1
    plmpeg_file_all__host_rgb = plmpeg_file_all__host_stream_rgb
    plmpeg_file_all__host_rgb_size = plmpeg_file_all__host_stream_rgb_size
    plmpeg_file_all__host_width = plmpeg_file_all__host_stream_width
    plmpeg_file_all__host_height = plmpeg_file_all__host_stream_height
    return 1
}

def plmpeg_host_stream_end : int {
    plmpeg_file_all__host_stream_end_internal()
    return 1
}

def plmpeg_host_stream_get_frame_index : int {
    return plmpeg_file_all__host_stream_frame_index
}

def plmpeg_host_probe_video_has_header : int {
    var video : plm_video_t? = null
    var result : int = 0
    if (!(plmpeg_file_all__host_bytes != null) || plmpeg_file_all__host_length <= 0) {
        return -1
    }
    video = plmpeg_file_all__create_decoder(plmpeg_file_all__host_bytes, uint64(plmpeg_file_all__host_length))
    if (!(video != null)) {
        return -2
    }
    result = plm_video_has_header(video)
    plm_video_destroy(video)
    return result
}

def plmpeg_host_probe_width : int {
    var video : plm_video_t? = null
    var result : int = 0
    if (!(plmpeg_file_all__host_bytes != null) || plmpeg_file_all__host_length <= 0) {
        return -1
    }
    video = plmpeg_file_all__create_decoder(plmpeg_file_all__host_bytes, uint64(plmpeg_file_all__host_length))
    if (!(video != null)) {
        return -2
    }
    result = plm_video_get_width(video)
    plm_video_destroy(video)
    return result
}

def plmpeg_host_probe_height : int {
    var video : plm_video_t? = null
    var result : int = 0
    if (!(plmpeg_file_all__host_bytes != null) || plmpeg_file_all__host_length <= 0) {
        return -1
    }
    video = plmpeg_file_all__create_decoder(plmpeg_file_all__host_bytes, uint64(plmpeg_file_all__host_length))
    if (!(video != null)) {
        return -2
    }
    result = plm_video_get_height(video)
    plm_video_destroy(video)
    return result
}

def private plmpeg_file_all__frames_release {
    if (plmpeg_file_all__frames_video != null) {
        plm_video_destroy(plmpeg_file_all__frames_video)
    }
    plmpeg_file_all__frames_video = null
    plmpeg_file_all__frames_rgb = null
    plmpeg_file_all__frames_rgb_size = 0
    plmpeg_file_all__frames_width = 0
    plmpeg_file_all__frames_height = 0
    plmpeg_file_all__frames_index = -1
    plmpeg_file_all__frames_hash = 0u
}

// Open a session over caller-owned bytes (an entry that read a fixture file).
// The caller's buffer must not live in the fixture heap: c2da_rt_reset()
// rewinds that heap and the working copy taken here would overlap it.
[c_function]
def plmpeg_frames_begin_bytes(var source : uint8?; length : int) : int {
    var bytes : uint8? = null
    plmpeg_file_all__frames_release()
    if (!(source != null) || length <= 0) {
        return 0
    }
    bytes = reinterpret<uint8?>(crt::malloc(uint64(length)))
    if (!(bytes != null)) {
        return 0
    }
    crt::memcpy(reinterpret<void?>(bytes), reinterpret<void?>(source), uint64(length))
    plmpeg_file_all__frames_video = plmpeg_file_all__create_decoder(bytes, uint64(length))
    if (!(plmpeg_file_all__frames_video != null)) {
        return 0
    }
    plmpeg_file_all__frames_width = plm_video_get_width(plmpeg_file_all__frames_video)
    plmpeg_file_all__frames_height = plm_video_get_height(plmpeg_file_all__frames_video)
    if (plmpeg_file_all__frames_width <= 0 || plmpeg_file_all__frames_height <= 0) {
        plmpeg_file_all__frames_release()
        return 0
    }
    plmpeg_file_all__frames_rgb_size = plmpeg_file_all__frames_width * plmpeg_file_all__frames_height * 3
    plmpeg_file_all__frames_rgb = reinterpret<uint8?>(crt::malloc(uint64(plmpeg_file_all__frames_rgb_size)))
    if (!(plmpeg_file_all__frames_rgb != null)) {
        plmpeg_file_all__frames_release()
        return 0
    }
    return 1
}

[c_function]
def plmpeg_frames_begin : int {
    return plmpeg_frames_begin_bytes(addr(plmpeg_file_all__sample_mpg_bytes[0]), int(plmpeg_file_all__sample_mpg_len))
}

def plmpeg_frames_next : int {
    var frame : plm_frame_t? = null
    if (!(plmpeg_file_all__frames_video != null) || !(plmpeg_file_all__frames_rgb != null)) {
        return 0
    }
    frame = plm_video_decode(plmpeg_file_all__frames_video)
    if (!(frame != null)) {
        return 0
    }
    plm_frame_to_rgb(frame, plmpeg_file_all__frames_rgb, plmpeg_file_all__frames_width * 3)
    plmpeg_file_all__frames_hash = plmpeg_file_all__fold_bytes(plmpeg_file_all__frames_rgb, plmpeg_file_all__frames_rgb_size)
    plmpeg_file_all__frames_index += 1
    return 1
}

def plmpeg_frames_hash : int {
    return int(plmpeg_file_all__frames_hash)
}

def plmpeg_frames_index : int {
    return plmpeg_file_all__frames_index
}

def plmpeg_frames_width : int {
    return plmpeg_file_all__frames_width
}

def plmpeg_frames_height : int {
    return plmpeg_file_all__frames_height
}

def plmpeg_frames_end : int {
    plmpeg_file_all__frames_release()
    return 1
}

[c_function]
def private plmpeg_file_all__load_last_argument(argc : int; var argv : uint8 ??) : int {
    var f : FILE? = null
    var got : uint64 = uint64(0)
    if (argc < 2) {
        return 0
    }
    f = reinterpret<FILE?>(crt::fopen(deref(argv + (argc - 1)), reinterpret<uint8?>("rb")))
    if (!(f != null)) {
        return 0
    }
    got = crt::fread(reinterpret<void?>(addr(plmpeg_file_all__file_bytes[0])), uint64(1), uint64(MAX_FILE_BYTES), reinterpret<void?>(f))
    crt::fclose(reinterpret<void?>(f))
    return int(got)
}

[c_function]
def c_main(argc : int; var argv : uint8 ??) : int {
    var frames : int = 0
    var length : int = 0
    crt::setvbuf(crt::c_stdout(), null, _IONBF, uint64(0))
    length = plmpeg_file_all__load_last_argument(argc, argv)
    if (length <= 0) {
        printf(reinterpret<uint8?>("load=0\n"))
        return 2
    }
    printf(reinterpret<uint8?>("bytes=%d\n"), length)
    if (!(plmpeg_frames_begin_bytes(addr(plmpeg_file_all__file_bytes[0]), length) != 0)) {
        printf(reinterpret<uint8?>("frames_begin=0\n"))
        return 1
    }
    printf(reinterpret<uint8?>("width=%d\n"), plmpeg_frames_width())
    printf(reinterpret<uint8?>("height=%d\n"), plmpeg_frames_height())
    while (plmpeg_frames_next() != 0) {
        printf(reinterpret<uint8?>("frame[%d]=%d\n"), plmpeg_frames_index(), plmpeg_frames_hash())
        frames += 1
    }
    plmpeg_frames_end()
    printf(reinterpret<uint8?>("frames=%d\n"), frames)
    return frames > 0 ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("plmpeg_file_all")
    return c_main(c_argc(), c_argv())
}
