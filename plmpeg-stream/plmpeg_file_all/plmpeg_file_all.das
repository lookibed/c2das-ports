        // Decode grouped samples
        val = plm_buffer_read(self.buffer, int(q.bits))
        deref(sample + 0) = val % adj
        val /= adj
        deref(sample + 1) = val % adj
        deref(sample + 2) = val / adj
    } else {
        // Decode direct samples
        deref(sample + 0) = plm_buffer_read(self.buffer, int(q.bits))
        deref(sample + 1) = plm_buffer_read(self.buffer, int(q.bits))
        deref(sample + 2) = plm_buffer_read(self.buffer, int(q.bits))
    }
    // Postmultiply samples
    var scale : int = 65536 / (adj + 1)
    adj = (adj + 1 >> 1) - 1
    val = (adj - deref(sample + 0)) * scale
    deref(sample + 0) = val * (sf >> 12) + (val * (sf & 4095) + 2048 >> 12) >> 12
    val = (adj - deref(sample + 1)) * scale
    deref(sample + 1) = val * (sf >> 12) + (val * (sf & 4095) + 2048 >> 12) >> 12
    val = (adj - deref(sample + 2)) * scale
    deref(sample + 2) = val * (sf >> 12) + (val * (sf & 4095) + 2048 >> 12) >> 12
}

