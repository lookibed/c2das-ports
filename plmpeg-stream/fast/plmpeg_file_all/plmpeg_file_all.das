// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
options strict_aliasing = false
require c_runtime/c_args
require c_runtime/c_bounds
require c_runtime/c_do_while
require c_runtime/c_exit
require c_runtime/c_function
require c_runtime/c_macro
require c_runtime/c_switch
require c_runtime/cstr
require c_runtime/int_of
require c_runtime/printf
require crt

[init]
def private c2das_dialect {
    c_long_bits = 64
}

enum plm_buffer_mode {
    PLM_BUFFER_MODE_FILE
    PLM_BUFFER_MODE_FIXED_MEM
    PLM_BUFFER_MODE_RING
    PLM_BUFFER_MODE_APPEND
}

struct FILE {}

struct plm_packet_t {
    _c_type : int
    pts : double
    length : uint64
    data : uint8?
}

struct plm_plane_t {
    width, height : uint
    data : uint8?
}

struct plm_frame_t {
    time : double
    width, height : uint
    y, cr, cb : plm_plane_t
}

struct plm_samples_t {
    time : double
    count : uint
    interleaved : float[2304]
}

struct plm_t {
    demux : plm_demux_t?
    time : double
    has_ended, loop, has_decoders, video_enabled, video_packet_type : int
    video_buffer : plm_buffer_t?
    video_decoder : plm_video_t?
    audio_enabled, audio_stream_index, audio_packet_type : int
    audio_lead_time : double
    audio_buffer : plm_buffer_t?
    audio_decoder : plm_audio_t?
    video_decode_callback : function<(var a0 : plm_t?; var a1 : plm_frame_t?; var a2 : void?) : void>
    video_decode_callback_user_data : void?
    audio_decode_callback : function<(var a0 : plm_t?; var a1 : plm_samples_t?; var a2 : void?) : void>
    audio_decode_callback_user_data : void?
}

struct plm_buffer_t {
    bit_index, capacity, length, total_size : uint64
    discard_read_bytes, has_ended, free_when_done : int
    load_callback : function<(var a0 : plm_buffer_t?; var a1 : void?) : void>
    seek_callback : function<(var a0 : plm_buffer_t?; a1 : uint64; var a2 : void?) : void>
    tell_callback : function<(var a0 : plm_buffer_t?; var a1 : void?) : uint64>
    load_callback_user_data : void?
    bytes : uint8?
    mode : plm_buffer_mode
}

struct plm_vlc_t {
    index, value : int16
}

struct plm_vlc_uint_t {
    index : int16
    value : uint16
}

struct plm_demux_t {
    buffer : plm_buffer_t?
    destroy_buffer_when_done : int
    system_clock_ref : double
    last_file_size : uint64
    last_decoded_pts, start_time, duration : double
    start_code, has_pack_header, has_system_header, has_headers, num_audio_streams, num_video_streams : int
    current_packet, next_packet : plm_packet_t
}

struct plm_video_motion_t {
    full_px, is_set, r_size, h, v : int
}

struct plm_video_t {
    framerate, pixel_aspect_ratio, time : double
    frames_decoded, width, height, mb_width, mb_height, mb_size, luma_width, luma_height, chroma_width, chroma_height, start_code, picture_type : int
    motion_forward, motion_backward : plm_video_motion_t
    has_sequence_header, quantizer_scale, slice_begin, macroblock_address, mb_row, mb_col, macroblock_type, macroblock_intra : int
    dc_predictor : int[3]
    buffer : plm_buffer_t?
    destroy_buffer_when_done : int
    frame_current, frame_forward, frame_backward : plm_frame_t
    frames_data : uint8?
    block_data : int[64]
    intra_quant_matrix, non_intra_quant_matrix : uint8[64]
    has_reference_frame, assume_no_b_frames : int
}

struct plm_quantizer_spec_t {
    levels : uint16
    group, bits : uint8
}

struct plm_audio_t {
    time : double
    samples_decoded, samplerate_index, bitrate_index, version, layer, mode, bound, v_pos, next_frame_data_size, has_header : int
    buffer : plm_buffer_t?
    destroy_buffer_when_done : int
    allocation : plm_quantizer_spec_t? [2][32]
    scale_factor_info : uint8[2][32]
    scale_factor, sample : int[2][32][3]
    samples : plm_samples_t
    D : float[1024]
    V : float[2][1024]
    U : float[32]
}

struct DecodeSummary {
    combined_hash, first_hash, last_hash : uint
    frame_count, width, height : int
}

