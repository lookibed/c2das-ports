            y = (int(frame.y.data[y_index + yw + 1]) - 16) * 76309 >> 16
            dest[d_index + stride + 4 + 2] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + stride + 4 + 1] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + stride + 4 + 0] = plmpeg_file_all__plm_clamp(y + b)
            c_index += 1
            y_index += 2
            d_index += 2 * 4
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_frame_to_argb(var frame : plm_frame_t?; var dest : uint8?; stride : int) {
    let cols : int = int(frame.width >> 1u)
    let rows : int = int(frame.height >> 1u)
    let yw : int = int(frame.y.width)
    let cw : int = int(frame.cb.width)
    for (row in range(rows)) {
        var c_index : int = row * cw
        var y_index : int = row * 2 * yw
        var d_index : int = row * 2 * stride
        for (col in range(cols)) {
            var y : int
            let cr : int = int(frame.cr.data[c_index]) - 128
            let cb : int = int(frame.cb.data[c_index]) - 128
            let r : int = cr * 104597 >> 16
            let g : int = cb * 25674 + cr * 53278 >> 16
            let b : int = cb * 132201 >> 16
            y = (int(frame.y.data[y_index + 0]) - 16) * 76309 >> 16
            dest[d_index + 0 + 1] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + 0 + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + 0 + 3] = plmpeg_file_all__plm_clamp(y + b)
            y = (int(frame.y.data[y_index + 1]) - 16) * 76309 >> 16
            dest[d_index + 4 + 1] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + 4 + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + 4 + 3] = plmpeg_file_all__plm_clamp(y + b)
            y = (int(frame.y.data[y_index + yw]) - 16) * 76309 >> 16
            dest[d_index + stride + 1] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + stride + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + stride + 3] = plmpeg_file_all__plm_clamp(y + b)
            y = (int(frame.y.data[y_index + yw + 1]) - 16) * 76309 >> 16
            dest[d_index + stride + 4 + 1] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + stride + 4 + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + stride + 4 + 3] = plmpeg_file_all__plm_clamp(y + b)
            c_index += 1
            y_index += 2
            d_index += 2 * 4
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_frame_to_abgr(var frame : plm_frame_t?; var dest : uint8?; stride : int) {
    let cols : int = int(frame.width >> 1u)
    let rows : int = int(frame.height >> 1u)
    let yw : int = int(frame.y.width)
    let cw : int = int(frame.cb.width)
    for (row in range(rows)) {
        var c_index : int = row * cw
        var y_index : int = row * 2 * yw
        var d_index : int = row * 2 * stride
        for (col in range(cols)) {
            var y : int
            let cr : int = int(frame.cr.data[c_index]) - 128
            let cb : int = int(frame.cb.data[c_index]) - 128
            let r : int = cr * 104597 >> 16
            let g : int = cb * 25674 + cr * 53278 >> 16
            let b : int = cb * 132201 >> 16
            y = (int(frame.y.data[y_index + 0]) - 16) * 76309 >> 16
            dest[d_index + 0 + 3] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + 0 + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + 0 + 1] = plmpeg_file_all__plm_clamp(y + b)
            y = (int(frame.y.data[y_index + 1]) - 16) * 76309 >> 16
            dest[d_index + 4 + 3] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + 4 + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + 4 + 1] = plmpeg_file_all__plm_clamp(y + b)
            y = (int(frame.y.data[y_index + yw]) - 16) * 76309 >> 16
            dest[d_index + stride + 3] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + stride + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + stride + 1] = plmpeg_file_all__plm_clamp(y + b)
            y = (int(frame.y.data[y_index + yw + 1]) - 16) * 76309 >> 16
            dest[d_index + stride + 4 + 3] = plmpeg_file_all__plm_clamp(y + r)
            dest[d_index + stride + 4 + 2] = plmpeg_file_all__plm_clamp(y - g)
            dest[d_index + stride + 4 + 1] = plmpeg_file_all__plm_clamp(y + b)
            c_index += 1
            y_index += 2
            d_index += 2 * 4
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_audio_create_with_buffer(var buffer : plm_buffer_t?; destroy_when_done : int) : plm_audio_t? {
    var self : plm_audio_t? = reinterpret<plm_audio_t?>(PLM_MALLOC(uint64(typeinfo sizeof(type<plm_audio_t>))))
    crt::memset(reinterpret<void?>(self), 0, uint64(typeinfo sizeof(type<plm_audio_t>)))
    self.samples.count = uint(PLM_AUDIO_SAMPLES_PER_FRAME)
    self.buffer = buffer
    self.destroy_buffer_when_done = destroy_when_done
    // Indicates 0
    self.samplerate_index = 3
    crt::memcpy(reinterpret<void?>(addr(self.D[0])), reinterpret<void?>(addr(plmpeg_file_all__PLM_AUDIO_SYNTHESIS_WINDOW[0])),
            512ul * uint64(typeinfo sizeof(type<float>)))
    crt::memcpy(reinterpret<void?>(addr(self.D[0]) + 512), reinterpret<void?>(addr(plmpeg_file_all__PLM_AUDIO_SYNTHESIS_WINDOW[0])),
            512ul * uint64(typeinfo sizeof(type<float>)))
    // Attempt to decode first header
    self.next_frame_data_size = plm_audio_decode_header(self)
    return self
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_destroy(var self : plm_audio_t?) {
    if (self.destroy_buffer_when_done != 0) {
        plm_buffer_destroy(self.buffer)
    }
    PLM_FREE(self)
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_has_header(var self : plm_audio_t?) : int {
    if (self.has_header != 0) {
        return TRUE
    }
    self.next_frame_data_size = plm_audio_decode_header(self)
    return self.has_header
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_get_samplerate(var self : plm_audio_t?) : int {
    return plm_audio_has_header(self) != 0 ? int(plmpeg_file_all__PLM_AUDIO_SAMPLE_RATE[self.samplerate_index]) : 0
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_get_time(var self : plm_audio_t?) : double {
    return self.time
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_set_time(var self : plm_audio_t?; time : double) {
    self.samples_decoded = int(time * double(plmpeg_file_all__PLM_AUDIO_SAMPLE_RATE[self.samplerate_index]))
    self.time = time
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_rewind(var self : plm_audio_t?) {
    plm_buffer_rewind(self.buffer)
    self.time = 0.0lf
    self.samples_decoded = 0
    self.next_frame_data_size = 0
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_has_ended(var self : plm_audio_t?) : int {
    return plm_buffer_has_ended(self.buffer)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_audio_decode(var self : plm_audio_t?) : plm_samples_t? {
    // Do we have at least enough information to decode the frame header?
    if (self.next_frame_data_size == 0) {
        if (plm_buffer_has(self.buffer, 48ul) == 0) {
            return null
        }
        self.next_frame_data_size = plm_audio_decode_header(self)
    }
    if (self.next_frame_data_size == 0 || plm_buffer_has(self.buffer, uint64(self.next_frame_data_size << 3)) == 0) {
        return null
    }
    plm_audio_decode_frame(self)
    self.next_frame_data_size = 0
    self.samples.time = self.time
    self.samples_decoded += PLM_AUDIO_SAMPLES_PER_FRAME
    self.time = double(self.samples_decoded) / double(plmpeg_file_all__PLM_AUDIO_SAMPLE_RATE[self.samplerate_index])
    return addr(self.samples)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_audio_find_frame_sync(var self : plm_audio_t?) : int {
    var i : uint64
    i = self.buffer.bit_index >> 3ul
    while (i < self.buffer.length - 1ul) {
        if (self.buffer.bytes[i] == 255 && (int(self.buffer.bytes[i + 1ul]) & 254) == 252) {
            self.buffer.bit_index = ((i + 1ul) << 3ul) + 3ul
            return TRUE
        }
        i++
    }
    self.buffer.bit_index = (i + 1ul) << 3ul
    return FALSE
}

[unsafe_deref, hint(unsafe_range_check)]
def plm_audio_decode_header(var self : plm_audio_t?) : int {
    if (plm_buffer_has(self.buffer, 48ul) == 0) {
        return 0
    }
    plm_buffer_skip_bytes(self.buffer, 0u8)
    let sync : int = plm_buffer_read(self.buffer, 11)
    // Attempt to resync if no syncword was found. This sucks balls. The MP2
    // stream contains a syncword just before every frame (11 bits set to 1).
    // However, this syncword is not guaranteed to not occur elsewhere in the
    // stream. So, if we have to resync, we also have to check if the header
    // (samplerate, bitrate) differs from the one we had before. This all
    // may still lead to garbage data being decoded :
    if (sync != plmpeg_file_all__PLM_AUDIO_FRAME_SYNC && plm_audio_find_frame_sync(self) == 0) {
        return 0
    }
    self.version = plm_buffer_read(self.buffer, 2)
    self.layer = plm_buffer_read(self.buffer, 2)
    let hasCRC : int = int_of(plm_buffer_read(self.buffer, 1) == 0)
    if (self.version != plmpeg_file_all__PLM_AUDIO_MPEG_1 || self.layer != plmpeg_file_all__PLM_AUDIO_LAYER_II) {
        return 0
    }
    let bitrate_index : int = plm_buffer_read(self.buffer, 4) - 1
    if (bitrate_index > 13) {
        return 0
    }
    let samplerate_index : int = plm_buffer_read(self.buffer, 2)
    if (samplerate_index == 3) {
        return 0
    }
    let padding : int = plm_buffer_read(self.buffer, 1)
    // f_private
    plm_buffer_skip(self.buffer, 1ul)
    let mode : int = plm_buffer_read(self.buffer, 2)
    // If we already have a header, make sure the samplerate, bitrate and mode
    // are still the same, otherwise we might have missed sync.
    if (self.has_header != 0 && (self.bitrate_index != bitrate_index || self.samplerate_index != samplerate_index || self.mode != mode)) {
        return 0
    }
    self.bitrate_index = bitrate_index
    self.samplerate_index = samplerate_index
    self.mode = mode
    self.has_header = TRUE
    // Parse the mode_extension, set up the stereo bound
    if (mode == plmpeg_file_all__PLM_AUDIO_MODE_JOINT_STEREO) {
        self.bound = (plm_buffer_read(self.buffer, 2) + 1) << 2
    } else {
        plm_buffer_skip(self.buffer, 2ul)
        self.bound = (mode == plmpeg_file_all__PLM_AUDIO_MODE_MONO) ? 0 : 32
    }
    // Discard the last 4 bits of the header and the CRC value, if present
    // copyright(1), original(1), emphasis(2)
    plm_buffer_skip(self.buffer, 4ul)
    if (hasCRC != 0) {
        plm_buffer_skip(self.buffer, 16ul)
    }
    // Compute frame size, check if we have enough data to decode the whole
    // frame.
    let bitrate : int = int(plmpeg_file_all__PLM_AUDIO_BIT_RATE[self.bitrate_index])
    let samplerate : int = int(plmpeg_file_all__PLM_AUDIO_SAMPLE_RATE[self.samplerate_index])
    let frame_size : int = (144000 * bitrate / samplerate) + padding
    return frame_size - (hasCRC != 0 ? 6 : 4)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_audio_decode_frame(var self : plm_audio_t?) {
    // Prepare the quantizer table lookups
    var tab3 : int = 0
    var sblimit : int = 0
    let tab1 : int = (self.mode == plmpeg_file_all__PLM_AUDIO_MODE_MONO) ? 0 : 1
    let tab2 : int = int(plmpeg_file_all__PLM_AUDIO_QUANT_LUT_STEP_1[tab1][self.bitrate_index])
    tab3 = int(plmpeg_file_all__QUANT_LUT_STEP_2[tab2][self.samplerate_index])
    sblimit = tab3 & 63
    tab3 >>= 6
    if (self.bound > sblimit) {
        self.bound = sblimit
    }
    // Read the allocation information
    {
        var sb : int = 0
        while (sb < self.bound) {
            self.allocation[0][sb] = plm_audio_read_allocation(self, sb, tab3)
            self.allocation[1][sb] = plm_audio_read_allocation(self, sb, tab3)
            sb++
        }
    }
    for (sb in range(self.bound, sblimit)) {
        self.allocation[1][sb] = plm_audio_read_allocation(self, sb, tab3)
        self.allocation[0][sb] = self.allocation[1][sb]
    }
    // Read scale factor selector information
    let channels : int = (self.mode == plmpeg_file_all__PLM_AUDIO_MODE_MONO) ? 1 : 2
    for (sb in range(sblimit)) {
        for (ch in range(channels)) {
            if (self.allocation[ch][sb] != null) {
                self.scale_factor_info[ch][sb] = uint8(plm_buffer_read(self.buffer, 2))
            }
        }
        if (self.mode == plmpeg_file_all__PLM_AUDIO_MODE_MONO) {
            self.scale_factor_info[1][sb] = self.scale_factor_info[0][sb]
        }
    }
    // Read scale factors
    for (sb in range(sblimit)) {
        for (ch in range(channels)) {
            if (self.allocation[ch][sb] != null) {
                var sf : int? = addr(self.scale_factor[ch][sb][0])
                c_switch(int(self.scale_factor_info[ch][sb])) {
                    case(0) {
                        sf[0] = plm_buffer_read(self.buffer, 6)
                        sf[1] = plm_buffer_read(self.buffer, 6)
                        sf[2] = plm_buffer_read(self.buffer, 6)
                        break
                    }
                    case(1) {
                        sf[1] = plm_buffer_read(self.buffer, 6)
                        sf[0] = sf[1]
                        sf[2] = plm_buffer_read(self.buffer, 6)
                        break
                    }
                    case(2) {
                        sf[2] = plm_buffer_read(self.buffer, 6)
                        sf[1] = sf[2]
                        sf[0] = sf[1]
                        break
                    }
                    case(3) {
                        sf[0] = plm_buffer_read(self.buffer, 6)
                        sf[2] = plm_buffer_read(self.buffer, 6)
                        sf[1] = sf[2]
                        break
                    }
                }
            }
        }
        if (self.mode == plmpeg_file_all__PLM_AUDIO_MODE_MONO) {
            self.scale_factor[1][sb][0] = self.scale_factor[0][sb][0]
            self.scale_factor[1][sb][1] = self.scale_factor[0][sb][1]
            self.scale_factor[1][sb][2] = self.scale_factor[0][sb][2]
        }
    }
    // Coefficient input and reconstruction
    var out_pos : int = 0
    for (part in range(3)) {
        for (granule in range(4)) {
            // Read the samples
            {
                var sb : int = 0
                while (sb < self.bound) {
                    plm_audio_read_samples(self, 0, sb, part)
                    plm_audio_read_samples(self, 1, sb, part)
                    sb++
                }
            }
            for (sb in range(self.bound, sblimit)) {
                plm_audio_read_samples(self, 0, sb, part)
                self.sample[1][sb][0] = self.sample[0][sb][0]
                self.sample[1][sb][1] = self.sample[0][sb][1]
                self.sample[1][sb][2] = self.sample[0][sb][2]
            }
            for (sb in range(sblimit, 32)) {
                self.sample[0][sb][0] = 0
                self.sample[0][sb][1] = 0
                self.sample[0][sb][2] = 0
                self.sample[1][sb][0] = 0
                self.sample[1][sb][1] = 0
                self.sample[1][sb][2] = 0
            }
            // Synthesis loop
            for (p in range(3)) {
                // Shifting step
                self.v_pos = (self.v_pos - 64) & 1023
                for (ch in range(2)) {
                    plm_audio_idct36(addr(self.sample[ch][0]), p, addr(self.V[ch][0]), self.v_pos)
                    // Build U, windowing, calculate output
                    crt::memset(reinterpret<void?>(addr(self.U[0])), 0, uint64(typeinfo sizeof(type<float[32]>)))
                    var d_index : int = 512 - (self.v_pos >> 1)
                    var v_index : int = (self.v_pos % 128) >> 1
                    while (v_index < 1024) {
                        for (i in range(32)) {
                            let _t0 = d_index
                            d_index++
                            let _t1 = v_index
                            v_index++
                            self.U[i] += self.D[_t0] * self.V[ch][_t1]
                        }
                        v_index += 128 - 32
                        d_index += 64 - 32
                    }
                    d_index -= 512 - 32
                    v_index = (128 - 32 + 1024) - v_index
                    while (v_index < 1024) {
                        for (i in range(32)) {
                            let _t2 = d_index
                            d_index++
                            let _t3 = v_index
                            v_index++
                            self.U[i] += self.D[_t2] * self.V[ch][_t3]
                        }
                        v_index += 128 - 32
                        d_index += 64 - 32
                    }
                    // Output samples
                    for (j in range(32)) {
                        self.samples.interleaved[((out_pos + j) << 1) + ch] = self.U[j] / -1090519000f
                    }
                }
                // End of synthesis channel loop
                out_pos += 32
            }
        }
    }
    // End of synthesis sub-block loop
    // Decoding of the granule finished
    plm_buffer_align(self.buffer)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_audio_read_allocation(var self : plm_audio_t?; sb : int; tab3 : int) : plm_quantizer_spec_t? {
    let tab4 : int = int(plmpeg_file_all__PLM_AUDIO_QUANT_LUT_STEP_3[tab3][sb])
    let qtab : int = int(plmpeg_file_all__PLM_AUDIO_QUANT_LUT_STEP_4[tab4 & 15][plm_buffer_read(self.buffer, tab4 >> 4)])
    return qtab != 0 ? (addr(plmpeg_file_all__PLM_AUDIO_QUANT_TAB[0]) + end_index(qtab - 1, 17)) : null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_audio_read_samples(var self : plm_audio_t?; ch : int; sb : int; part : int) {
    var q : plm_quantizer_spec_t? = self.allocation[ch][sb]
    var sf : int = self.scale_factor[ch][sb][part]
    var sample : int? = addr(self.sample[ch][sb][0])
    var val : int = 0
    if (q == null) {
        // No bits allocated for this subband
        sample[2] = 0
        sample[1] = sample[2]
        sample[0] = sample[1]
        return
    }
    // Resolve scalefactor
    if (sf == 63) {
        sf = 0
    } else {
        let shift : int = (sf / 3) | 0
        sf = (plmpeg_file_all__PLM_AUDIO_SCALEFACTOR_BASE[sf % 3] + ((1 << shift) >> 1)) >> shift
    }
    // Decode samples
    var adj : int = int(q.levels)
    if (q.group != 0) {
        // Decode grouped samples
        val = plm_buffer_read(self.buffer, int(q.bits))
        sample[0] = val % adj
        val /= adj
        sample[1] = val % adj
        sample[2] = val / adj
    } else {
        // Decode direct samples
        sample[0] = plm_buffer_read(self.buffer, int(q.bits))
        sample[1] = plm_buffer_read(self.buffer, int(q.bits))
        sample[2] = plm_buffer_read(self.buffer, int(q.bits))
    }
    // Postmultiply samples
    let scale : int = 65536 / (adj + 1)
    adj = ((adj + 1) >> 1) - 1
    val = (adj - sample[0]) * scale
    sample[0] = (val * (sf >> 12) + ((val * (sf & 4095) + 2048) >> 12)) >> 12
    val = (adj - sample[1]) * scale
    sample[1] = (val * (sf >> 12) + ((val * (sf & 4095) + 2048) >> 12)) >> 12
    val = (adj - sample[2]) * scale
    sample[2] = (val * (sf >> 12) + ((val * (sf & 4095) + 2048) >> 12)) >> 12
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plm_audio_idct36(var s : int[3]?; ss : int; var d : float?; dp : int) {
    var t01 : float
    var t02 : float
    var t03 : float
    var t04 : float
    var t05 : float
    var t06 : float
    var t07 : float
    var t08 : float
    var t09 : float
    var t10 : float
    var t11 : float
    var t12 : float
    var t13 : float
    var t14 : float
    var t15 : float
    var t16 : float
    var t17 : float
    var t18 : float
    var t19 : float
    var t20 : float
    var t21 : float
    var t22 : float
    var t23 : float
    var t24 : float
    var t25 : float
    var t26 : float
    var t27 : float
    var t28 : float
    var t29 : float
    var t30 : float
    var t31 : float
    var t32 : float
    var t33 : float
    t01 = float(s[0][ss] + s[31][ss])
    t02 = float(s[0][ss] - s[31][ss]) * 0.500603f
    t03 = float(s[1][ss] + s[30][ss])
    t04 = float(s[1][ss] - s[30][ss]) * 0.50547093f
    t05 = float(s[2][ss] + s[29][ss])
    t06 = float(s[2][ss] - s[29][ss]) * 0.5154473f
    t07 = float(s[3][ss] + s[28][ss])
    t08 = float(s[3][ss] - s[28][ss]) * 0.5310426f
    t09 = float(s[4][ss] + s[27][ss])
    t10 = float(s[4][ss] - s[27][ss]) * 0.5531039f
    t11 = float(s[5][ss] + s[26][ss])
    t12 = float(s[5][ss] - s[26][ss]) * 0.582935f
    t13 = float(s[6][ss] + s[25][ss])
    t14 = float(s[6][ss] - s[25][ss]) * 0.6225041f
    t15 = float(s[7][ss] + s[24][ss])
    t16 = float(s[7][ss] - s[24][ss]) * 0.6748083f
    t17 = float(s[8][ss] + s[23][ss])
