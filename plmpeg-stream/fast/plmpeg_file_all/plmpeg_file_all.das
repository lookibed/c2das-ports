[unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__frames_release {
    if (plmpeg_file_all__frames_video != null) {
        plm_video_destroy(plmpeg_file_all__frames_video)
    }
    plmpeg_file_all__frames_video = null
    plmpeg_file_all__frames_rgb = null
    plmpeg_file_all__frames_rgb_size = 0
    plmpeg_file_all__frames_width = 0
    plmpeg_file_all__frames_height = 0
    plmpeg_file_all__frames_index = -1
    plmpeg_file_all__frames_hash = 0u
}

// Open a session over caller-owned bytes (an entry that read a fixture file).
// The caller's buffer must not live in the fixture heap: c2da_rt_reset()
// rewinds that heap and the working copy taken here would overlap it.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_begin_bytes(var source : uint8?; length : int) : int {
    var bytes : uint8? = null
    plmpeg_file_all__frames_release()
    if (source == null || length <= 0) {
        return 0
    }
    bytes = reinterpret<uint8?>(crt::malloc(uint64(length)))
    if (bytes == null) {
        return 0
    }
    crt::memcpy(reinterpret<void?>(bytes), reinterpret<void?>(source), uint64(length))
    plmpeg_file_all__frames_video = plmpeg_file_all__create_decoder(bytes, uint64(length))
    if (plmpeg_file_all__frames_video == null) {
        return 0
    }
    plmpeg_file_all__frames_width = plm_video_get_width(plmpeg_file_all__frames_video)
    plmpeg_file_all__frames_height = plm_video_get_height(plmpeg_file_all__frames_video)
    if (plmpeg_file_all__frames_width <= 0 || plmpeg_file_all__frames_height <= 0) {
        plmpeg_file_all__frames_release()
        return 0
    }
    plmpeg_file_all__frames_rgb_size = plmpeg_file_all__frames_width * plmpeg_file_all__frames_height * 3
    plmpeg_file_all__frames_rgb = reinterpret<uint8?>(crt::malloc(uint64(plmpeg_file_all__frames_rgb_size)))
    if (plmpeg_file_all__frames_rgb == null) {
        plmpeg_file_all__frames_release()
        return 0
    }
    return 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_begin : int {
    return plmpeg_frames_begin_bytes(addr(plmpeg_file_all__sample_mpg_bytes[0]), int(plmpeg_file_all__sample_mpg_len))
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_next : int {
    var frame : plm_frame_t? = null
    if (plmpeg_file_all__frames_video == null || plmpeg_file_all__frames_rgb == null) {
        return 0
    }
    frame = plm_video_decode(plmpeg_file_all__frames_video)
    if (frame == null) {
        return 0
    }
    plm_frame_to_rgb(frame, plmpeg_file_all__frames_rgb, plmpeg_file_all__frames_width * 3)
    plmpeg_file_all__frames_hash = plmpeg_file_all__fold_bytes(plmpeg_file_all__frames_rgb, plmpeg_file_all__frames_rgb_size)
    plmpeg_file_all__frames_index += 1
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_hash : int {
    return int(plmpeg_file_all__frames_hash)
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_index : int {
    return plmpeg_file_all__frames_index
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_width : int {
    return plmpeg_file_all__frames_width
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_height : int {
    return plmpeg_file_all__frames_height
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_frames_end : int {
    plmpeg_file_all__frames_release()
    return 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__load_last_argument(argc : int; var argv : uint8 ??) : int {
    var f : FILE? = null
    var got : uint64 = 0ul
    if (argc < 2) {
        return 0
    }
    f = reinterpret<FILE?>(crt::fopen(argv[argc - 1], cstr("rb")))
    if (f == null) {
        return 0
    }
    got = crt::fread(reinterpret<void?>(addr(plmpeg_file_all__file_bytes[0])), 1ul, uint64(MAX_FILE_BYTES), reinterpret<void?>(f))
    crt::fclose(reinterpret<void?>(f))
    return int(got)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def c_main(argc : int; var argv : uint8 ??) : int {
    var frames : int = 0
    var length : int = 0
    crt::setvbuf(crt::c_stdout(), null, _IONBF, 0ul)
    length = plmpeg_file_all__load_last_argument(argc, argv)
    if (length <= 0) {
        printf(cstr("load=0\n"))
        return 2
    }
    printf(cstr("bytes=%d\n"), length)
    if (plmpeg_frames_begin_bytes(addr(plmpeg_file_all__file_bytes[0]), length) == 0) {
        printf(cstr("frames_begin=0\n"))
        return 1
    }
    printf(cstr("width=%d\n"), plmpeg_frames_width())
    printf(cstr("height=%d\n"), plmpeg_frames_height())
    while (plmpeg_frames_next() != 0) {
        printf(cstr("frame[%d]=%d\n"), plmpeg_frames_index(), plmpeg_frames_hash())
        frames += 1
    }
    plmpeg_frames_end()
    printf(cstr("frames=%d\n"), frames)
    return frames > 0 ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("plmpeg_file_all")
    return c_main(c_argc(), c_argv())
}
