    }
    plmpeg_file_all__host_stream_rgb = rgb
    plmpeg_file_all__host_stream_rgb_size = rgb_size
    plmpeg_file_all__host_stream_width = width
    plmpeg_file_all__host_stream_height = height
    plmpeg_file_all__host_stream_frame_index = -1
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_host_stream_decode_next : int {
    var frame : plm_frame_t? = null
    if (plmpeg_file_all__host_stream_video == null || plmpeg_file_all__host_stream_rgb == null) {
        return 0
    }
    frame = plm_video_decode(plmpeg_file_all__host_stream_video)
    if (frame == null) {
        return 0
    }
    plm_frame_to_rgb(frame, plmpeg_file_all__host_stream_rgb, plmpeg_file_all__host_stream_width * 3)
    plmpeg_file_all__host_stream_frame_index += 1
    plmpeg_file_all__host_rgb = plmpeg_file_all__host_stream_rgb
    plmpeg_file_all__host_rgb_size = plmpeg_file_all__host_stream_rgb_size
    plmpeg_file_all__host_width = plmpeg_file_all__host_stream_width
    plmpeg_file_all__host_height = plmpeg_file_all__host_stream_height
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_host_stream_end : int {
    plmpeg_file_all__host_stream_end_internal()
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_host_stream_get_frame_index : int {
    return plmpeg_file_all__host_stream_frame_index
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_host_probe_video_has_header : int {
    var video : plm_video_t? = null
    var result : int = 0
    if (plmpeg_file_all__host_bytes == null || plmpeg_file_all__host_length <= 0) {
        return -1
    }
    video = plmpeg_file_all__create_decoder(plmpeg_file_all__host_bytes, uint64(plmpeg_file_all__host_length))
    if (video == null) {
        return -2
    }
    result = plm_video_has_header(video)
    plm_video_destroy(video)
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def plmpeg_host_probe_width : int {
    var video : plm_video_t? = null
    var result : int = 0
    if (plmpeg_file_all__host_bytes == null || plmpeg_file_all__host_length <= 0) {
