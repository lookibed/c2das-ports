[unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__rotl32(value : uint; shift : uint) : uint {
    return (value << shift) | (value >> (32u - shift))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__fold_bytes(var bytes : uint8?; length : int) : uint {
    var hash : uint = 2166136261u
    for (index in range(length)) {
        hash ^= uint(bytes[index])
        hash *= 16777619u
        hash = plmpeg_file_all__rotl32(hash, 5u)
    }
    return hash
}

// pl_mpeg treats the memory handed to plm_buffer_create_with_memory as its
// own working buffer: plm_video_decode calls plm_buffer_discard_read_bytes,
// which memmove()s the unread tail to the front of that very memory. The
// embedded sample is `static const`, so every decode session must work on a
// fresh heap copy: in C the original lives in read-only storage (writing it
// is a segfault), and in either graph a second session would otherwise see a
// stream the first one already shifted.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__sample_copy : uint8? {
    var copy : uint8? = reinterpret<uint8?>(crt::malloc(uint64(plmpeg_file_all__sample_mpg_len)))
    if (copy == null) {
        return null
    }
    crt::memcpy(reinterpret<void?>(copy), reinterpret<void?>(addr(plmpeg_file_all__sample_mpg_bytes[0])), uint64(plmpeg_file_all__sample_mpg_len))
    return copy
}

[unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__create_decoder(var bytes : uint8?; length : uint64) : plm_video_t? {
    var buffer : plm_buffer_t? = plm_buffer_create_with_memory(bytes, length, 0)
    var video : plm_video_t? = null
    if (buffer == null) {
        return null
    }
    video = plm_video_create_with_buffer(buffer, 1)
    if (video == null) {
        plm_buffer_destroy(buffer)
        return null
    }
    plm_video_set_no_delay(video, 1)
    return video
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__decode_summary(var bytes : uint8?; length : uint64; frame_limit : int; var summary : DecodeSummary?) : int {
    var video : plm_video_t? = plmpeg_file_all__create_decoder(bytes, length)
    var rgb_size : int = 0
    var rgb : uint8? = null
    var frame_index : int = 0
    if (video == null) {
        return 0
    }
    summary.combined_hash = 2166136261u
    summary.first_hash = 0u
    summary.last_hash = 0u
    summary.frame_count = 0
    summary.width = plm_video_get_width(video)
    summary.height = plm_video_get_height(video)
    if (summary.width <= 0 || summary.height <= 0) {
        plm_video_destroy(video)
        return 0
    }
    rgb_size = summary.width * summary.height * 3
    rgb = reinterpret<uint8?>(crt::malloc(uint64(rgb_size)))
    if (rgb == null) {
        plm_video_destroy(video)
        return 0
    }
    while (1 != 0) {
        var frame : plm_frame_t? = plm_video_decode(video)
        var frame_hash : uint = 0u
        if (frame == null) {
            break
        }
        plm_frame_to_rgb(frame, rgb, summary.width * 3)
        frame_hash = plmpeg_file_all__fold_bytes(rgb, rgb_size)
        if (frame_index == 0) {
            summary.first_hash = frame_hash
        }
        summary.last_hash = frame_hash
        summary.combined_hash ^= frame_hash + (uint(frame_index) * 2654435769u)
        summary.combined_hash = plmpeg_file_all__rotl32(summary.combined_hash, 7u)
        summary.combined_hash += 2135587861u
        summary.frame_count = frame_index + 1
        frame_index += 1
        if (frame_limit > 0 && frame_index >= frame_limit) {
            break
        }
    }
    summary.combined_hash ^= uint(summary.width)
    summary.combined_hash = plmpeg_file_all__rotl32(summary.combined_hash, 3u)
    summary.combined_hash ^= uint(summary.height)
    summary.combined_hash = plmpeg_file_all__rotl32(summary.combined_hash, 3u)
    summary.combined_hash ^= uint(summary.frame_count)
    plm_video_destroy(video)
    return 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__decode_frame_rgb(var bytes : uint8?; length : uint64; frame_index : int; var rgb_ptr : uint8 ??; var rgb_size : int?;
                                              var width : int?; var height : int?) : int {
    var video : plm_video_t? = plmpeg_file_all__create_decoder(bytes, length)
    var rgb : uint8? = null
    var local_width : int = 0
    var local_height : int = 0
    var local_size : int = 0
    var current : int = 0
    if (video == null) {
        return 0
    }
    local_width = plm_video_get_width(video)
    local_height = plm_video_get_height(video)
    if (local_width <= 0 || local_height <= 0) {
        plm_video_destroy(video)
        return 0
    }
    local_size = local_width * local_height * 3
    rgb = reinterpret<uint8?>(crt::malloc(uint64(local_size)))
    if (rgb == null) {
        plm_video_destroy(video)
        return 0
    }
    while (1 != 0) {
        var frame : plm_frame_t? = plm_video_decode(video)
        if (frame == null) {
            plm_video_destroy(video)
            return 0
        }
        if (current == frame_index) {
            plm_frame_to_rgb(frame, rgb, local_width * 3)
            *rgb_ptr = rgb
            *rgb_size = local_size
            *width = local_width
            *height = local_height
            plm_video_destroy(video)
            return 1
        }
        current += 1
    }
    return 0
}

[unsafe_deref, hint(unsafe_range_check)]
def private plmpeg_file_all__host_stream_end_internal {
