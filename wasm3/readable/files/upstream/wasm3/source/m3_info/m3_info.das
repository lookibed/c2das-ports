var private m3_info__c_waTypes : uint8? [10] = fixed_array<uint8?>(cstr("nil"), cstr("i32"), cstr("i64"), cstr("f32"), cstr("f64"), cstr("v128"),
        cstr("funcref"), cstr("externref"), cstr("exnref"), cstr("unknown"))
var private m3_info__c_waCompactTypes : uint8? [10] = fixed_array<uint8?>(cstr("_"), cstr("i"), cstr("I"), cstr("f"), cstr("F"), cstr("V"), cstr("r"),
        cstr("R"), cstr("e"), cstr("?"))
var private m3_info__c_m3RegisterUnallocated : uint16 = uint16(0)
var private m3_info__c_slotUnused : uint16 = uint16(65535)

let private d_m3Reg0SlotAlias = 60000
let private d_m3Fp0SlotAlias = d_m3Reg0SlotAlias + 2
let private d_m3DefaultMemPageSize = 65536

def private m3_info__BaseTypeOf(i_type : uint8) : uint8 {
    return i_type
}

def private m3_info__IsSubTypeOf(i_sub : uint8; i_super : uint8) : bool {
    return i_sub == i_super
}

def private m3_info__IsSpelledRefType(i_type : uint8) : bool {
    return 0 != 0
}

def private m3_info__IsNullableRef(i_type : uint8) : bool {
    return 1 != 0
}

[c_function]
def private m3_info__RunCode(var _pc : void ??; var _sp : uint?; var _mem : M3MemoryHeader?; _r0 : int64; _fp0 : double) : void? {
    return invoke(reinterpret<function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64; a4 : double) : void?>>(*_pc), _pc + 1, _sp, _mem,
            _r0, _fp0)
}

// The function that actually runs when this one is called: an import linked to
// another module resolves to that module's function, everything else to itself.
def private m3_info__Function_Implementation(var i_function : M3Function?) : M3Function? {
    return i_function.resolved != null ? i_function.resolved : i_function
}

def private m3_info__IsRegisterAllocated(var o : M3Compilation?; i_register : uint) : bool {
    return o.regStackIndexPlusOne[i_register] != m3_info__c_m3RegisterUnallocated
}

def private m3_info__IsStackPolymorphic(var o : M3Compilation?) : bool {
    return o._c_block.isPolymorphic
}

def private m3_info__IsRegisterSlotAlias(i_slot : uint16) : bool {
    return int(i_slot) >= d_m3Reg0SlotAlias && i_slot != m3_info__c_slotUnused
}

def private m3_info__IsFpRegisterSlotAlias(i_slot : uint16) : bool {
    return int(i_slot) == d_m3Fp0SlotAlias
}

def private m3_info__IsIntRegisterSlotAlias(i_slot : uint16) : bool {
    return int(i_slot) == d_m3Reg0SlotAlias
}

// The value type a memory's addresses, page counts and lengths are expressed
// in. Every instruction naming the memory takes and returns that type.
def private m3_info__Memory_AddrType(var i_memory : M3Memory?) : uint8 {
    return uint8(i_memory.isMemory64 ? int(M3ValueType.c_m3Type_i64) : int(M3ValueType.c_m3Type_i32))
}

// A module that declares no custom page size means the default one. The parser
// leaves that as zero, and InitMemory only fills it in when it allocates, so a
// memory has to be asked rather than read directly until then.
def private m3_info__Memory_PageSize(var i_memory : M3Memory?) : uint {
    return i_memory.pageSize != 0 ? i_memory.pageSize : uint(d_m3DefaultMemPageSize)
}

// The value type a table's indexes and sizes are expressed in - table64 is the
// same choice as memory64, made per table.
def private m3_info__Table_AddrType(var i_table : M3Table?) : uint8 {
    return uint8(i_table.isTable64 ? int(M3ValueType.c_m3Type_i64) : int(M3ValueType.c_m3Type_i32))
}

// Memory 0 of a module - the one the interpreter's _mem register tracks while
// that module's code is running. Never NULL once the module has been loaded.
def private m3_info__Module_Memory0(var i_module : M3Module?) : M3Memory? {
    return i_module.memory0
}

def private m3_info__Module_MemoryHeader(var i_module : M3Module?) : M3MemoryHeader? {
    return i_module.memory0.mallocated
}

def m3_PrintProfilerInfo {
}

