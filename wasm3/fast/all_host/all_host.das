// A memory op is only valid if the memory it names is in the module's index
// space; for a module that declares none, every index is out of range.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_has_memory_idx(var v : ValCtx?; i_memoryIdx : uint) : bool {
    return v._c_module != null && i_memoryIdx < v._c_module.numMemories
}

// The type of the addresses, sizes and page counts a memory instruction takes:
// whichever the memory it names was declared with. Only ever called after
// v_has_memory_idx has said the index is in range.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_memory_addrtype(var v : ValCtx?; i_memoryIdx : uint) : uint8 {
    return all_host__Memory_AddrType(v._c_module.memories[i_memoryIdx])
}

// Spec: the static offset of a memory access must be in range of the address
// type, so anything at all for a 64-bit memory and below 2^32 for a 32-bit one.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_offset_in_range(var v : ValCtx?; i_memoryIdx : uint; i_offset : uint64) : bool {
    return int(all_host__v_memory_addrtype(v, i_memoryIdx)) == int(M3ValueType.c_m3Type_i64) || i_offset <= 4294967295ul
}

// The type a table's indexes and sizes are given in - table64 is the same
// choice as memory64, made per table. Only ever called once the table index has
// been checked against the module's index space.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_table_addrtype(var v : ValCtx?; i_tableIdx : uint) : uint8 {
    return all_host__Table_AddrType(v._c_module.tables[i_tableIdx])
}

// Spec: the alignment immediate of a memory access must not be larger than the
// natural alignment of the operation. Natural alignment: 8-bit=0, 16-bit=1,
// 32-bit=2, 64-bit=3.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_max_align(opcode : uint16) : uint {
    c_switch(int(opcode)) {
        case(44, 45, 48, 49, 58, 60) {
            // i32.load8_s, i32.load8_u
            // i64.load8_s, i64.load8_u
            // i32.store8
            // i64.store8
            return 0u
        }
        case(46, 47, 50, 51, 59, 61) {
            // i32.load16_s, i32.load16_u
            // i64.load16_s, i64.load16_u
            // i32.store16
            // i64.store16
            return 1u
        }
        case(41, 43, 55, 57) {
            // i64.load
            // f64.load
            // i64.store
            // f64.store
            return 3u
        }
        case(_) {
            // 32-bit accesses, and a safe fallback
            return 2u
        }
    }
}

