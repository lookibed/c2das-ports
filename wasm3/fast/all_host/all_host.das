// The function that actually runs when this one is called: an import linked to
// another module resolves to that module's function, everything else to itself.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Function_Implementation(var i_function : M3Function?) : M3Function? {
    return i_function.resolved != null ? i_function.resolved : i_function
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsRegisterAllocated(var o : M3Compilation?; i_register : uint) : bool {
    return o.regStackIndexPlusOne[i_register] != all_host__c_m3RegisterUnallocated
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsStackPolymorphic(var o : M3Compilation?) : bool {
    return o._c_block.isPolymorphic
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsRegisterSlotAlias(i_slot : uint16) : bool {
    return int(i_slot) >= d_m3Reg0SlotAlias && i_slot != all_host__c_slotUnused
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsFpRegisterSlotAlias(i_slot : uint16) : bool {
    return int(i_slot) == d_m3Fp0SlotAlias
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsIntRegisterSlotAlias(i_slot : uint16) : bool {
    return int(i_slot) == d_m3Reg0SlotAlias
}

// The value type a memory's addresses, page counts and lengths are expressed
// in. Every instruction naming the memory takes and returns that type.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Memory_AddrType(var i_memory : M3Memory?) : uint8 {
    return uint8(i_memory.isMemory64 ? int(M3ValueType.c_m3Type_i64) : int(M3ValueType.c_m3Type_i32))
}

// A module that declares no custom page size means the default one. The parser
// leaves that as zero, and InitMemory only fills it in when it allocates, so a
// memory has to be asked rather than read directly until then.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Memory_PageSize(var i_memory : M3Memory?) : uint {
    return i_memory.pageSize != 0 ? i_memory.pageSize : uint(d_m3DefaultMemPageSize)
}

// The value type a table's indexes and sizes are expressed in - table64 is the
// same choice as memory64, made per table.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Table_AddrType(var i_table : M3Table?) : uint8 {
    return uint8(i_table.isTable64 ? int(M3ValueType.c_m3Type_i64) : int(M3ValueType.c_m3Type_i32))
}

// Memory 0 of a module - the one the interpreter's _mem register tracks while
// that module's code is running. Never NULL once the module has been loaded.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Module_Memory0(var i_module : M3Module?) : M3Memory? {
    return i_module.memory0
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Module_MemoryHeader(var i_module : M3Module?) : M3MemoryHeader? {
    return i_module.memory0.mallocated
}

[unsafe_deref, hint(unsafe_range_check)]
def ConvertTypeCharToTypeId(i_code : uint8) : uint8 {
    c_switch(int(i_code)) {
        case('v') {
            return uint8(M3ValueType.c_m3Type_none)
        }
        case('i') {
            return uint8(M3ValueType.c_m3Type_i32)
        }
        case('I') {
            return uint8(M3ValueType.c_m3Type_i64)
        }
        case('f') {
            return uint8(M3ValueType.c_m3Type_f32)
        }
        case('F') {
            return uint8(M3ValueType.c_m3Type_f64)
        }
        case('*') {
            return uint8(M3ValueType.c_m3Type_i32)
        }
        case('r') {
            // same letters c_waCompactTypes uses for the reference types
            return uint8(M3ValueType.c_m3Type_funcref)
        }
        case('R') {
            return uint8(M3ValueType.c_m3Type_externref)
        }
    }
    return uint8(M3ValueType.c_m3Type_unknown)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def SignatureToFuncType(var o_functionType : M3FuncType ??; var i_signature : uint8?) : uint8? {
    var funcType : M3FuncType? = null
    var result : uint8? = m3Err_none
    {
        if (o_functionType == null) {
            result = cstr("null function type")
            goto label 1
        }
        if (i_signature == null) {
            result = cstr("null function signature")
            goto label 1
        }
        var sig : uint8? = i_signature
        var maxNumTypes : uint64 = crt::strlen(i_signature)
        // assume min signature is "()"
        if (maxNumTypes < 2ul) {
            result = m3Err_malformedFunctionSignature
            goto label 1
        }
        maxNumTypes -= 2ul
        if (maxNumTypes > uint64(d_m3MaxSaneFunctionArgRetCount)) {
            result = m3Err_tooManyArgsRets
            goto label 1
        }
        result = AllocFuncType(addr(funcType), uint(maxNumTypes))
        if (result != null) {
            goto label 1
        }
        var typelist : uint8? = reinterpret<uint8?>(reinterpret<uint8?>(funcType) + 14)
        var parsingRets : bool = 1 != 0
        while (*sig != 0) {
            var _t0 = sig
            sig++
            let typeChar : uint8 = *_t0
            if (typeChar == '(') {
                parsingRets = 0 != 0
                continue
            } elif (typeChar == ' ') {
                continue
            } elif (typeChar == ')') {
                break
            }
            let _c_type : uint8 = ConvertTypeCharToTypeId(typeChar)
            if (int(M3ValueType.c_m3Type_unknown) == int(_c_type)) {
                result = cstr("unknown argument type char")
                goto label 1
            }
            if (int(_c_type) == int(M3ValueType.c_m3Type_none)) {
                continue
            }
            if (parsingRets) {
                if (uint64(funcType.numRets) >= maxNumTypes) {
                    result = cstr("malformed signature; return count overflow")
                    goto label 1
                }
                funcType.numRets = uint16(uint(funcType.numRets) + 1)
                var _t1 = typelist
                typelist++
                *_t1 = _c_type
            } else {
                if (uint64(uint(funcType.numRets) + uint(funcType.numArgs)) >= maxNumTypes) {
                    result = cstr("malformed signature; arg count overflow")
                    goto label 1
                }
                funcType.numArgs = uint16(uint(funcType.numArgs) + 1)
                var _t2 = typelist
                typelist++
                *_t2 = _c_type
            }
        }
    }
    label 1:  // _catch
    if (result != null) {
        while (true) {
            m3_Free_Impl(reinterpret<void?>(funcType))
            funcType = null
            break
        }
    }
    *o_functionType = funcType
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__ValidateSignature(var i_function : M3Function?; var i_linkingSignature : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    var ftype : M3FuncType? = null
    result = SignatureToFuncType(addr(ftype), i_linkingSignature)
    if (result != null) {
        goto label 1
    }
    if (!AreFuncTypesEqual(ftype, i_function.funcType)) {
        result = m3Err_functionSignatureMismatch
        goto label 1
    }
    label 1:  // _catch
    while (true) {
        m3_Free_Impl(reinterpret<void?>(ftype))
        ftype = null
        break
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def FindAndLinkFunction(var io_module : M3Module?; var i_moduleName : uint8?; var i_functionName : uint8?; var i_signature : uint8?; var i_function : void?;
                        var i_userdata : void?) : uint8? {
    var result : uint8? = m3Err_none
    {
        if (io_module.runtime == null) {
            result = m3Err_moduleNotLinked
            goto label 1
        }
        let wildcardModule : bool = crt::strcmp(i_moduleName, cstr("*")) == 0
        result = m3Err_functionLookupFailed
        {
            var i : uint = 0u
            while (i < io_module.numFunctions) {
                var f : M3Function? = addr(io_module.functions[i])
                if (f.import.moduleUtf8 != null && f.import.fieldUtf8 != null) {
                    if (crt::strcmp(f.import.fieldUtf8, i_functionName) == 0 && (wildcardModule || crt::strcmp(f.import.moduleUtf8, i_moduleName) == 0)) {
                        if (i_signature != null) {
                            result = all_host__ValidateSignature(f, i_signature)
                            if (result != null) {
                                goto label 1
                            }
                        }
                        result = CompileRawFunction(io_module, f, i_function, i_userdata)
                        if (result != null) {
                            goto label 1
                        }
                    }
                }
                i++
            }
        }
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_LinkRawFunctionEx(var io_module : M3Module?; var i_moduleName : uint8?; var i_functionName : uint8?; var i_signature : uint8?;
                         i_function : function<(var a0 : M3Runtime?; var a1 : M3ImportContext?; var a2 : uint64?; var a3 : void?) : void?>; var i_userdata : void?) : uint8? {
    return FindAndLinkFunction(io_module, i_moduleName, i_functionName, i_signature, reinterpret<void?>(i_function), i_userdata)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_LinkRawFunction(var io_module : M3Module?; var i_moduleName : uint8?; var i_functionName : uint8?; var i_signature : uint8?;
                       i_function : function<(var a0 : M3Runtime?; var a1 : M3ImportContext?; var a2 : uint64?; var a3 : void?) : void?>) : uint8? {
    return FindAndLinkFunction(io_module, i_moduleName, i_functionName, i_signature, reinterpret<void?>(i_function), null)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def NewCodePage(var i_runtime : M3Runtime?; i_minNumLines : uint) : M3CodePage? {
    var page : M3CodePage?
    // check multiplication overflow
    if (uint64(i_minNumLines) > uint64(2147483647u * 2u + 1u) / uint64(typeinfo sizeof(type<void?>))) {
        return null
    }
    var pageSize : uint = uint(uint64(typeinfo sizeof(type<M3CodePageHeader>)) + uint64(typeinfo sizeof(type<void?>)) * uint64(i_minNumLines))
    // check addition overflow
    if (uint64(pageSize) < uint64(typeinfo sizeof(type<M3CodePageHeader>))) {
        return null
    }
    // align
    pageSize = (pageSize + uint(d_m3CodePageAlignSize - 1)) & uint(~(d_m3CodePageAlignSize - 1))
    // check alignment overflow
    if (pageSize == 0u) {
        return null
    }
    page = reinterpret<M3CodePage?>(m3_Malloc_Impl(uint64(pageSize)))
    if (page != null) {
        i_runtime.newCodePageSequence++
        page.info.sequence = i_runtime.newCodePageSequence
        page.info.numLines = uint((uint64(pageSize) - uint64(typeinfo sizeof(type<M3CodePageHeader>))) / uint64(typeinfo sizeof(type<void?>)))
        // d_m3RecordBacktraces
    }
    return page
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def FreeCodePages(var io_list : M3CodePage ??) {
    var page : M3CodePage? = *io_list
    while (page != null) {
        var next : M3CodePage? = page.info.next
        // d_m3RecordBacktraces
        m3_Free(page)
        page = next
    }
    *io_list = null
}

[unsafe_deref, hint(unsafe_range_check)]
def NumFreeLines(var i_page : M3CodePage?) : uint {
    return i_page.info.numLines - i_page.info.lineIndex
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def EmitWord_impl(var i_page : M3CodePage?; var i_word : void?) {
    let _t0 = i_page.info.lineIndex
    i_page.info.lineIndex++
    addr(i_page.code[0])[_t0] = i_word
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def EmitWord32(var i_page : M3CodePage?; var i_word : uint) {
    let _t0 = i_page.info.lineIndex
    i_page.info.lineIndex++
    crt::memcpy(reinterpret<void?>(addr(addr(i_page.code[0])[_t0])), reinterpret<void?>(addr(i_word)), uint64(typeinfo sizeof(type<uint>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def EmitWord64(var i_page : M3CodePage?; var i_word : uint64) {
    crt::memcpy(reinterpret<void?>(addr(addr(i_page.code[0])[i_page.info.lineIndex])), reinterpret<void?>(addr(i_word)), uint64(typeinfo sizeof(type<uint64>)))
    i_page.info.lineIndex += 1u
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetPageStartPC(var i_page : M3CodePage?) : void ?? {
    return addr(addr(i_page.code[0])[0])
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetPagePC(var i_page : M3CodePage?) : void ?? {
    if (i_page != null) {
        return addr(addr(i_page.code[0])[i_page.info.lineIndex])
    } else {
        return null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def PushCodePage(var i_list : M3CodePage ??; var i_codePage : M3CodePage?) {
    var next : M3CodePage? = *i_list
    i_codePage.info.next = next
    *i_list = i_codePage
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def PopCodePage(var i_list : M3CodePage ??) : M3CodePage? {
    var page : M3CodePage? = *i_list
    *i_list = page.info.next
    page.info.next = null
    return page
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def FindCodePageEnd(var i_list : M3CodePage?; var o_end : M3CodePage ??) : uint {
    var numPages : uint = 0u
    *o_end = null
    while (i_list != null) {
        *o_end = i_list
        numPages++
        i_list = i_list.info.next
    }
    return numPages
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def CountCodePages(var i_list : M3CodePage?) : uint {
    var unused : M3CodePage?
    return FindCodePageEnd(i_list, addr(unused))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetEndCodePage(var i_list : M3CodePage?) : M3CodePage? {
    var end : M3CodePage?
    FindCodePageEnd(i_list, addr(end))
    return end
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__rotl32(n : uint; var c : uint) : uint {
    let mask : uint = uint(8ul * uint64(typeinfo sizeof(type<uint>)) - 1ul)
    c &= mask & 31u
    return (n << c) | (n >> ((32u - c) & mask))
}

