[c_function, unsafe_deref, hint(unsafe_range_check)]
def ParseSection_Start(var io_module : M3Module?; var i_bytes : uint8?; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    var startFuncIndex : uint
    result = ReadLEB_u32(addr(startFuncIndex), addr(i_bytes), i_end)
    if (result != null) {
