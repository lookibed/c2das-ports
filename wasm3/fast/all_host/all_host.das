        // Spec: validate that the branch index operand is i32
        if (!all_host__IsStackPolymorphic(o)) {
            let indexType : uint8 = all_host__GetStackTopType(o)
            if (int(indexType) != int(M3ValueType.c_m3Type_none) && int(indexType) != int(M3ValueType.c_m3Type_i32)) {
                result = m3Err_typeMismatch
                goto label 1
            }
        }
