            case(188) {
                // i32.reinterpret/f32
                r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_f32), uint8(M3ValueType.c_m3Type_i32))
                break
            }
            case(189) {
                // i64.reinterpret/f64
                r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_f64), uint8(M3ValueType.c_m3Type_i64))
                break
            }
            case(190) {
                // f32.reinterpret/i32
                r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_i32), uint8(M3ValueType.c_m3Type_f32))
                break
            }
            case(191) {
                // f64.reinterpret/i64
                r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_i64), uint8(M3ValueType.c_m3Type_f64))
                break
            }
            case(192, 193) {
                // ---- Sign-extension (MVP post) ----
                // i32.extend8_s, i32.extend16_s
                r = all_host__v_unop(v, uint8(M3ValueType.c_m3Type_i32), uint8(M3ValueType.c_m3Type_i32))
                break
            }
            case(194, 195, 196) {
                // i64.extend8/16/32_s
                r = all_host__v_unop(v, uint8(M3ValueType.c_m3Type_i64), uint8(M3ValueType.c_m3Type_i64))
                break
            }
            case(252) {
                {
                    // ---- 0xFC prefix (saturating truncations + bulk memory) ----
                    var sub : uint
                    r = ReadLEB_u32(addr(sub), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    c_switch(sub) {
                        case(0u, 1u) {
                            // i32.trunc_sat_f32_s/u
                            r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_f32), uint8(M3ValueType.c_m3Type_i32))
                            break
                        }
                        case(2u, 3u) {
                            // i32.trunc_sat_f64_s/u
                            r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_f64), uint8(M3ValueType.c_m3Type_i32))
                            break
                        }
                        case(4u, 5u) {
                            // i64.trunc_sat_f32_s/u
                            r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_f32), uint8(M3ValueType.c_m3Type_i64))
                            break
                        }
                        case(6u, 7u) {
                            // i64.trunc_sat_f64_s/u
                            r = all_host__v_cvtop(v, uint8(M3ValueType.c_m3Type_f64), uint8(M3ValueType.c_m3Type_i64))
                            break
                        }
                        case(8u) {
                            {
                                // memory.init
                                var dataidx : uint
                                var memidx : uint
                                r = ReadLEB_u32(addr(dataidx), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                r = ReadLEB_u32(addr(memidx), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                if (!all_host__v_has_memory_idx(v, memidx)) {
                                    return m3Err_unknownMemory
                                }
                                // the segments must have been declared up front by a data count section
                                if (!v._c_module.hasDataCount) {
                                    return m3Err_dataCountRequired
                                }
                                if (dataidx >= v._c_module.numDataSegments) {
                                    return m3Err_unknownDataSegment
                                }
                                // the segment is indexed as an i32 no matter how the memory is
                                // addressed; only the destination follows the address type
                                // n
                                r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                                if (r != null) {
                                    return r
                                }
                                // src
                                r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                                if (r != null) {
                                    return r
                                }
                                // dst
                                r = all_host__v_pop_expect(v, all_host__v_memory_addrtype(v, memidx), addr(a))
                                if (r != null) {
                                    return r
                                }
                                break
                            }
                        }
                        case(9u) {
                            {
                                // data.drop
                                var dataidx : uint
                                r = ReadLEB_u32(addr(dataidx), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                // needs the segment, but not a memory
                                if (!v._c_module.hasDataCount) {
                                    return m3Err_dataCountRequired
                                }
                                if (dataidx >= v._c_module.numDataSegments) {
                                    return m3Err_unknownDataSegment
                                }
                                break
                            }
                        }
                        case(12u, 14u) {
                            {
                                // table.init
                                // table.copy
                                var a1 : uint
                                var a2 : uint
                                r = ReadLEB_u32(addr(a1), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                r = ReadLEB_u32(addr(a2), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                // elemidx, tableidx
                                if (sub == 12u) {
                                    // the immediates are encoded elem-then-table, but the spec's
                                    // rule requires the table to be defined before the segment
                                    if (a2 >= v._c_module.numTables) {
                                        return m3Err_unknownTable
                                    }
                                    if (a1 >= v._c_module.numElementSegments) {
                                        return m3Err_unknownElemSegment
                                    }
                                    if (v._c_module.elementSegments[a1]._c_type != v._c_module.tables[a2]._c_type) {
                                        return m3Err_typeMismatch
                                    }
                                } else {
                                    // dst, src
                                    if (a1 >= v._c_module.numTables) {
                                        return m3Err_unknownTable
                                    }
                                    if (a2 >= v._c_module.numTables) {
                                        return m3Err_unknownTable
                                    }
                                    if (v._c_module.tables[a1]._c_type != v._c_module.tables[a2]._c_type) {
                                        return m3Err_typeMismatch
                                    }
                                }
                                if (sub == 12u) {
                                    // table.init indexes the segment as an i32 whatever the
                                    // table is; only the destination follows the table
                                    // n
                                    r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    // s
                                    r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    // d
                                    r = all_host__v_pop_expect(v, all_host__v_table_addrtype(v, a2), addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                } else {
                                    // table.copy: each index follows its own table, and the
                                    // length the narrower of the two
                                    let dType : uint8 = all_host__v_table_addrtype(v, a1)
                                    let sType : uint8 = all_host__v_table_addrtype(v, a2)
                                    let nType : uint8 = uint8((int(dType) == int(M3ValueType.c_m3Type_i64) && int(sType) == int(M3ValueType.c_m3Type_i64)) ?
                                            int(M3ValueType.c_m3Type_i64) : int(M3ValueType.c_m3Type_i32))
                                    // n
                                    r = all_host__v_pop_expect(v, nType, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    // s
                                    r = all_host__v_pop_expect(v, sType, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    // d
                                    r = all_host__v_pop_expect(v, dType, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                }
                                break
                            }
                        }
                        case(13u) {
                            {
                                // elem.drop
                                var elemIdx : uint
                                r = ReadLEB_u32(addr(elemIdx), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                if (elemIdx >= v._c_module.numElementSegments) {
                                    return m3Err_unknownElemSegment
                                }
                                break
                            }
                        }
                        case(15u, 16u, 17u) {
                            {
                                // table.grow
                                // table.size
                                // table.fill
                                var tableIdx : uint
                                r = ReadLEB_u32(addr(tableIdx), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                if (tableIdx >= v._c_module.numTables) {
                                    return m3Err_unknownTable
                                }
                                let t : uint8 = all_host__BaseTypeOf(v._c_module.tables[tableIdx]._c_type)
                                let at : uint8 = all_host__v_table_addrtype(v, tableIdx)
                                // table.size
                                if (sub == 16u) {
                                    r = all_host__v_push(v, at)
                                    if (r != null) {
                                        return r
                                    }
                                } elif (sub == 15u) {
                                    // table.grow
                                    // n
                                    r = all_host__v_pop_expect(v, at, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    // init
                                    r = all_host__v_pop_expect(v, t, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    r = all_host__v_push(v, at)
                                    if (r != null) {
                                        return r
                                    }
                                } else {
                                    // table.fill
                                    // n
                                    r = all_host__v_pop_expect(v, at, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    // val
                                    r = all_host__v_pop_expect(v, t, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                    // i
                                    r = all_host__v_pop_expect(v, at, addr(a))
                                    if (r != null) {
                                        return r
                                    }
                                }
                                break
                            }
                        }
                        case(10u) {
                            {
                                // memory.copy
                                var dst : uint
                                var src : uint
                                r = ReadLEB_u32(addr(dst), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                r = ReadLEB_u32(addr(src), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                if (!all_host__v_has_memory_idx(v, dst) || !all_host__v_has_memory_idx(v, src)) {
                                    return m3Err_unknownMemory
                                }
                                // Spec: each address follows its own memory, and the length is
                                // typed by the narrower of the two - so copying between an i32
                                // and an i64 memory takes an i32 length.
                                let dstType : uint8 = all_host__v_memory_addrtype(v, dst)
                                let srcType : uint8 = all_host__v_memory_addrtype(v, src)
                                let lenType : uint8 = uint8((int(dstType) == int(M3ValueType.c_m3Type_i64) && int(srcType) == int(M3ValueType.c_m3Type_i64)) ?
                                        int(M3ValueType.c_m3Type_i64) : int(M3ValueType.c_m3Type_i32))
                                // n
                                r = all_host__v_pop_expect(v, lenType, addr(a))
                                if (r != null) {
                                    return r
                                }
                                // src
                                r = all_host__v_pop_expect(v, srcType, addr(a))
                                if (r != null) {
                                    return r
                                }
                                // dst
                                r = all_host__v_pop_expect(v, dstType, addr(a))
                                if (r != null) {
                                    return r
                                }
                                break
                            }
                        }
                        case(11u) {
                            {
                                // memory.fill
                                var memidx : uint
                                r = ReadLEB_u32(addr(memidx), addr(v.wasm), v.wasmEnd)
                                if (r != null) {
                                    return r
                                }
                                if (!all_host__v_has_memory_idx(v, memidx)) {
                                    return m3Err_unknownMemory
                                }
                                let addrType : uint8 = all_host__v_memory_addrtype(v, memidx)
                                // n
                                r = all_host__v_pop_expect(v, addrType, addr(a))
                                if (r != null) {
                                    return r
                                }
                                // val
                                r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                                if (r != null) {
                                    return r
                                }
                                // dst
                                r = all_host__v_pop_expect(v, addrType, addr(a))
                                if (r != null) {
                                    return r
                                }
                                break
                            }
                        }
                        case(_) {
                            // Unknown FC sub-opcode: skip validation (allow forward compat)
                            break
                        }
                    }
                    break
                }
            }
            case(_) {
                // Unknown opcode - skip rather than fail for forward compat
                // (the compiler will reject truly unsupported ops later)
                break
            }
        }
        // switch
        if (r != null) {
            return r
        }
    }
    // while
    // If we ran out of bytes without hitting the final end
    return m3Err_wasmMalformed
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ValidateFunction(var i_function : M3Function?) : uint8? {
    if (i_function.wasm == null) {
        return m3Err_none
    }
    var funcType : M3FuncType? = i_function.funcType
    var _c_module : M3Module? = i_function._c_module
    var runtime : M3Runtime? = _c_module.runtime
    var v : ValCtx? = runtime.validator
    if (v == null) {
        v = reinterpret<ValCtx?>(m3_Malloc_Impl(uint64(typeinfo sizeof(type<ValCtx>))))
        if (v == null) {
            return m3Err_mallocFailed
        }
        runtime.validator = v
    }
    crt::memset(reinterpret<void?>(v), 0, uint64(typeinfo sizeof(type<ValCtx>)))
    v._c_module = _c_module
    v._c_function = i_function
    v.wasm = i_function.wasm
    v.wasmEnd = i_function.wasmEnd
    // Skip code size LEB
    var size : uint
    var r : uint8? = ReadLEB_u32(addr(size), addr(v.wasm), v.wasmEnd)
    if (r != null) {
        return r
    }
    // Parse locals
    var numLocalBlocks : uint
    r = ReadLEB_u32(addr(numLocalBlocks), addr(v.wasm), v.wasmEnd)
    if (r != null) {
        return r
    }
    // First: params. Running out of room has to be an error, not a truncation:
    // a short localTypes would make later local.get indices read as unknown
    let numParams : uint16 = uint16(funcType != null ? int(funcType.numArgs) : 0)
    if (int(numParams) > d_m3ValStack) {
        return m3Err_functionStackOverflow
    }
    {
        var i : uint16 = uint16(0)
        while (int(i) < int(numParams)) {
            let _t0 = v.numLocals
            v.numLocals = uint16(uint(v.numLocals) + 1)
            v.localTypes[int(_t0)] = all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(funcType) + 14)[int(funcType.numRets) + int(i)])
            i = uint16(uint(i) + 1)
        }
    }
    // Then: declared locals
    for (b in urange(numLocalBlocks)) {
        var count : uint
        r = ReadLEB_u32(addr(count), addr(v.wasm), v.wasmEnd)
        if (r != null) {
            return r
        }
        var localType : uint8
        r = ParseValueType(v._c_module, addr(localType), addr(v.wasm), v.wasmEnd)
        if (r != null) {
            return r
        }
        let normalized : uint8 = all_host__BaseTypeOf(localType)
        if (count > uint(d_m3ValStack - int(v.numLocals))) {
            return m3Err_functionStackOverflow
        }
        for (c in urange(count)) {
            let _t1 = v.numLocals
            v.numLocals = uint16(uint(v.numLocals) + 1)
            v.localTypes[int(_t1)] = normalized
        }
    }
    // Push the function-level control frame
    // opcode 0x00 marks function frame
    r = all_host__v_push_ctrl(v, uint16(0), funcType)
    if (r != null) {
        return r
    }
    // Push params onto operand stack (they're part of the function body's initial stack)
    // Actually per the spec, locals are indexed but not on the operand stack.
    // The function frame's params are NOT pushed to the operand stack.
    // Only block params would be pushed (and for the function frame there are no block params
    // since the function body's "block type" has results = function returns, params = 0).
    // The function frame's label_types = results (since it's not a loop).
    // Validate the body
    r = all_host__v_validate_body(v)
    if (r != null) {
        return r
    }
    // After validation, control stack should be empty and all declared bytes consumed
    if (v.ctrlTop != 0) {
        return m3Err_wasmMalformed
    }
    if (intptr(v.wasm) != intptr(v.wasmEnd)) {
        return m3Err_wasmSectionUnderrun
    }
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__load_last_argument(argc : int; var argv : uint8 ??) : int {
    var f : FILE? = null
    var got : uint64 = 0ul
    if (argc < 2) {
        return 0
    }
    f = reinterpret<FILE?>(crt::fopen(argv[argc - 1], cstr("rb")))
    if (f == null) {
        return 0
    }
    got = crt::fread(reinterpret<void?>(addr(all_host__wasm_bytes[0])), 1ul, uint64(MAX_WASM_BYTES), reinterpret<void?>(f))
    crt::fclose(reinterpret<void?>(f))
    return int(got)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__call_fib(var fib : M3Function?; n : int; var out : int64?) : uint8? {
    var result : uint8? = m3Err_none
    if (m3_GetArgType(fib, 0u) == M3ValueType.c_m3Type_i64) {
        var value : uint64 = 0ul
        result = m3_CallV`va(fib, (uint64(n),))
        if (result != null) {
            return result
        }
        result = m3_GetResultsV`va(fib, (addr(value),))
        *out = int64(value)
    } else {
        var value : uint = 0u
        result = m3_CallV`va(fib, (uint(n),))
        if (result != null) {
            return result
        }
        result = m3_GetResultsV`va(fib, (addr(value),))
        *out = int64(value)
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def c_main(argc : int; var argv : uint8 ??) : int {
    var env : M3Environment? = null
    var runtime : M3Runtime? = null
    var _c_module : M3Module? = null
    var fib : M3Function? = null
    var result : uint8? = m3Err_none
    var length : int = 0
    var count : int = 0
    var i : int = 0
    crt::setvbuf(crt::c_stdout(), null, _IONBF, 0ul)
    length = all_host__load_last_argument(argc, argv)
    if (length <= 0) {
        printf(cstr("load=0\n"))
        return 2
    }
    printf(cstr("bytes=%d\n"), length)
    env = m3_NewEnvironment()
    if (env == null) {
        printf(cstr("error=environment\n"))
        return 1
    }
    runtime = m3_NewRuntime(env, uint(M3_STACK_BYTES), null)
    if (runtime == null) {
        printf(cstr("error=runtime\n"))
        return 1
    }
    result = m3_ParseModule(env, addr(_c_module), addr(all_host__wasm_bytes[0]), uint(length))
    if (result != null) {
        printf(cstr("error=%s\n"), result)
        return 1
    }
    result = m3_LoadModule(runtime, _c_module)
    if (result != null) {
        printf(cstr("error=%s\n"), result)
        return 1
    }
    result = m3_FindFunction(addr(fib), runtime, cstr("fib"))
    if (result != null) {
        printf(cstr("error=%s\n"), result)
        return 1
    }
    i = 0
    while (i < FIB_INPUT_COUNT) {
        var value : int64 = 0l
        result = all_host__call_fib(fib, all_host__fib_inputs[i], addr(value))
        if (result != null) {
            printf(cstr("error=%s\n"), result)
            return 1
        }
        printf(cstr("fib[%d]=%lld\n"), all_host__fib_inputs[i], value)
        count += 1
        i++
    }
    printf(cstr("count=%d\n"), count)
    m3_FreeRuntime(runtime)
    m3_FreeEnvironment(env)
    return count == FIB_INPUT_COUNT ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("all_host")
    return c_main(c_argc(), c_argv())
}
