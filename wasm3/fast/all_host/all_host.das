[c_function, unsafe_deref, hint(unsafe_range_check)]
def ParseSection_Code(var io_module : M3Module?; var i_bytes : uint8?; var i_end : uint8?) : uint8? {
    var result : uint8?
    var numFunctions : uint
    result = ReadLEB_u32(addr(numFunctions), addr(i_bytes), i_end)
    if (result != null) {
        goto label 1
    }
    if (numFunctions != io_module.numFunctions - io_module.numFuncImports) {
        result = cstr("mismatched function count in code section")
        goto label 1
    }
    for (f in urange(numFunctions)) {
        var start : uint8? = i_bytes
        var size : uint
        result = ReadLEB_u32(addr(size), addr(i_bytes), i_end)
        if (result != null) {
            goto label 1
        }
        if (size != 0) {
            i_bytes += size
            if (intptr(i_bytes) <= intptr(i_end)) {
                // const u8 * ptr = i_bytes - size;
                // u32 numLocalBlocks;
                // _ (ReadLEB_u32 (& numLocalBlocks, & ptr, i_end)); m3log (parse, " code size: %-4d", size);
                // u32 numLocals = 0;
                // for (u32 l = 0; l < numLocalBlocks; ++l)
                // {
                // u32 varCount;
                // i8 wasmType;
                // u8 normalType;
                // _ (ReadLEB_u32 (& varCount, & ptr, i_end));
                // _ (ReadLEB_i7 (& wasmType, & ptr, i_end));
                // _ (NormalizeType (& normalType, wasmType));
                // numLocals += varCount; m3log (parse, " %2d locals; type: '%s'", varCount, c_waTypes [normalType]);
                // }
                var func : M3Function? = Module_GetFunction(io_module, f + io_module.numFuncImports)
                func._c_module = io_module
                func.wasm = start
                func.wasmEnd = i_bytes
            } else {
                // func->ownsWasmCode = io_module->hasWasmCodeCopy;
                // func->numLocals = numLocals;
                result = m3Err_wasmSectionOverrun
                goto label 1
            }
        }
