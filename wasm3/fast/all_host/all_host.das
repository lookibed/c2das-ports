    label 1:  // _catch
    if (result == null && intptr(i_bytes) != intptr(i_end)) {
        result = m3Err_wasmSectionUnderrun
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ParseSection_Data(var io_module : M3Module?; var i_bytes : uint8?; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    var numDataSegments : uint
    result = ReadLEB_u32(addr(numDataSegments), addr(i_bytes), i_end)
    if (result != null) {
        goto label 1
    }
    if (numDataSegments > uint(d_m3MaxSaneDataSegments)) {
        result = cstr("too many data segments")
        goto label 1
    }
    io_module.dataSegments = reinterpret<M3DataSegment?>(m3_Malloc_Impl(uint64(typeinfo sizeof(type<M3DataSegment>)) * uint64(numDataSegments)))
    if (io_module.dataSegments == null) {
        result = m3Err_mallocFailed
        goto label 1
    }
    io_module.numDataSegments = numDataSegments
    for (i in urange(numDataSegments)) {
        var segment : M3DataSegment? = addr(io_module.dataSegments[i])
        // 0: active in memory 0, 1: passive, 2: active with an explicit memory index
        var flags : uint
        result = ReadLEB_u32(addr(flags), addr(i_bytes), i_end)
        if (result != null) {
            goto label 1
        }
        if (flags > 2u) {
            result = m3Err_wasmMalformed
            goto label 1
        }
        segment.isPassive = flags == 1u
        if (flags == 2u) {
            result = ReadLEB_u32(addr(segment.memoryRegion), addr(i_bytes), i_end)
            if (result != null) {
                goto label 1
            }
        }
        if (!segment.isPassive) {
            // The segment names the memory it initializes; only multi-memory
            // lets that be anything other than 0.
            if (segment.memoryRegion >= io_module.numMemories) {
                result = m3Err_wasmMalformed
                goto label 1
            }
            segment.initExpr = i_bytes
            result = Parse_InitExpr(io_module, addr(i_bytes), i_end)
            if (result != null) {
                goto label 1
            }
            segment.initExprSize = uint(int64(i_bytes - segment.initExpr))
            if (segment.initExprSize <= 1u) {
                result = m3Err_wasmMissingInitExpr
                goto label 1
            }
        }
        result = ReadLEB_u32(addr(segment.size), addr(i_bytes), i_end)
        if (result != null) {
            goto label 1
        }
        segment.data = i_bytes
        i_bytes += segment.size
        if (intptr(i_bytes) > intptr(i_end)) {
            result = cstr("data segment underflow")
            goto label 1
        }
    }
    // section size mismatch
    if (intptr(i_bytes) != intptr(i_end)) {
        result = m3Err_wasmMalformed
        goto label 1
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ParseSection_DataCount(var io_module : M3Module?; var i_bytes : uint8?; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_none
