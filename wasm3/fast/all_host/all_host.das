            result = all_host__PreserveRegisterIfOccupied(o, opInfo._c_type)
            if (result != null) {
                goto label 1
            }
            // _r
            op = opInfo.operations[1]
        }
    } else {
        if (all_host__IsStackTopInRegister(o)) {
            // _rs
            op = opInfo.operations[0]
            if (all_host__IsStackTopMinus1InRegister(o)) {
                // _rr for fp.store
                op = opInfo.operations[3]
            }
        } elif (all_host__IsStackTopMinus1InRegister(o)) {
            // _sr
            op = opInfo.operations[1]
            // must be commutative, then
            if (op == null) {
                op = opInfo.operations[0]
            }
        } else {
            // _ss
            result = all_host__PreserveRegisterIfOccupied(o, opInfo._c_type)
            if (result != null) {
                goto label 1
            }
            op = opInfo.operations[2]
        }
    }
    if (op != null) {
        result = all_host__EmitOp(o, op)
        if (result != null) {
            goto label 1
        }
        // the op word just written (EmitOp may have bridged pages); NULL in the page-less compile-walk mode
        var patchPC : void ?? = o.page != null ? all_host__GetPC(o) + -(1) : null
        result = all_host__EmitSlotNumOfStackTopAndPop(o)
        if (result != null) {
            goto label 1
        }
        if (int(opInfo.stackOffset) < 0) {
            result = all_host__EmitSlotNumOfStackTopAndPop(o)
            if (result != null) {
                goto label 1
            }
        }
        if (int(opInfo._c_type) != int(M3ValueType.c_m3Type_none)) {
            result = all_host__PushRegister(o, opInfo._c_type)
            if (result != null) {
                goto label 1
            }
            // record this op as a fold candidate for an immediately following local.set;
            // the operand-form index is recovered by matching against the variant table
            if (patchPC != null) {
                {
                    var form : uint8 = 0u8
                    while (int(form) < 4) {
                        if (opInfo.operations[int(form)] == op) {
                            o.foldPatchPC = patchPC
                            o.foldOpcode = i_opcode
                            o.foldForm = form
                            o.foldStackIndex = uint16(all_host__GetStackTopIndex(o))
                            break
                        }
                        form = uint8(uint(form) + 1)
                    }
                }
            }
        }
    } else {
        result = cstr("no operation found for opcode")
        result = result
        goto label 1
    }
