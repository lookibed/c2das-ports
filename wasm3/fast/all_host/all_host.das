                        if (result != null) {
                            goto label 1
                        }
                        result = all_host__EmitOp(o, @@all_host__op_Return)
                        if (result != null) {
                            goto label 1
                        }
                    } else {
                        result = all_host__EmitPopTryFrames(o, numTryFrames)
                        if (result != null) {
                            goto label 1
