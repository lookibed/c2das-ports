            result = all_host__EmitSetMemory(o, 0u)
            if (result != null) {
                goto label 1
            }
        }
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def CompileRawFunction(var io_module : M3Module?; var io_function : M3Function?; var i_function : void?; var i_userdata : void?) : uint8? {
    var page : M3CodePage? = AcquireCodePageWithCapacity(io_module.runtime, 4u)
    if (page != null) {
        io_function.compiled = GetPagePC(page)
        io_function._c_module = io_module
        // Unless a host module's ABI names a memory (m3_BindImportMemory), a
        // host function addresses memory 0 - what a bare i32 guest pointer means
        io_function.hostMemory = io_module.memory0
        EmitWord_impl(page, reinterpret<void?>(@@all_host__op_CallRawFunction))
        EmitWord_impl(page, i_function)
        EmitWord(page, io_function)
        EmitWord_impl(page, i_userdata)
        ReleaseCodePage(io_module.runtime, page)
        return m3Err_none
    } else {
        return m3Err_mallocFailedCodePage
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetCompiler(var i_opInfo : M3OpInfo?) : function<(var a0 : M3Compilation?; a1 : uint16) : uint8?> {
    return all_host__c_compilers[int(i_opInfo.compiler)]
}

// Opcodes the spec reserves leave zeroed holes in the tables above: no compiler
// and no operations. Every implemented op has at least one of the two.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsImplementedOp(var i_info : M3OpInfo?) : bool {
    return int(i_info.compiler) != int(anon_598.c_cc_NULL) || i_info.operations[0] != null
}

// Maps one of the sparse opcodes above c_waOp_lastCore onto c_operationsHigh,
// or -1 for anything else in that range.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetHighOpIndex(opcode : uint16) : int {
    c_switch(int(opcode)) {
        case(208) {
            return int(anon_603.c_opHigh_refNull)
        }
        case(209) {
            return int(anon_603.c_opHigh_refIsNull)
        }
        case(210) {
            return int(anon_603.c_opHigh_refFunc)
        }
        case(252) {
            return int(anon_603.c_opHigh_extended)
        }
        case(_) {
            return -1
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetOpInfo(var opcode : uint16) : M3OpInfo? {
    var info : M3OpInfo? = null
    c_switch(int(opcode) >> 8) {
        case(0) {
            // c_operations is indexed by opcode only up to c_waOp_lastCore; past that
            // it holds internal operations (DEBUG builds), unreachable by opcode.
            if (int(opcode) <= int(anon_315.c_waOp_lastCore)) {
                info = addr(c_operations[0]) + end_index(int(opcode), 197)
            } else {
                let high : int = all_host__GetHighOpIndex(opcode)
                if (high >= 0) {
                    info = addr(all_host__c_operationsHigh[0]) + end_index(high, 4)
                }
            }
            break
        }
        case(252) {
            opcode = uint16(int(opcode) & 255)
            if (int(opcode) <= int(anon_315.c_waOp_lastExtended)) {
                info = addr(c_operationsFC[0]) + end_index(int(opcode), 18)
            }
            break
        }
    }
    return (info != null && all_host__IsImplementedOp(info)) ? info : null
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetGasCost(i_opcode : uint16) : uint {
    c_switch(int(i_opcode)) {
        case(0, 1, 2, 3, 4, 31, 208, 210) {
            // unreachable
            // nop
            // a block that also installs handlers
            // a constant, by another name
            return uint(anon_609.c_gasNominal)
        }
        case(11) {
            // the one control instruction the table prices at nothing
            return 0u
        }
        case(5, 12, 13, 15, 16, 18, 8, 10) {
            return uint(anon_609.c_gasBranch)
        }
        case(14, 26, 27, 28) {
            // drop
            // select
            return uint(anon_609.c_gasAccess)
        }
        case(17, 19, 20, 21, 64520, 64522, 64523, 64524, 64526, 64527, 64529, 64) {
            // memory.grow
            return uint(anon_609.c_gasHeavy)
        }
        case(64521, 64525, 64528, 63) {
            // memory.size
            return uint(anon_609.c_gasMemSize)
        }
        case(209, 212) {
            return uint(anon_609.c_gasArith)
        }
        case(_) {
            break
        }
    }
    // The two integer arithmetic runs are priced by position, i32 at 0x6a and
    // i64 at 0x7c, the table giving both the same shape
    if ((int(i_opcode) >= 106 && int(i_opcode) <= 120) || (int(i_opcode) >= 124 && int(i_opcode) <= 138)) {
        // clang-format off
        // add, sub, mul
        // div_s, div_u, rem_s, rem_u
        // and, or, xor
        // shl, shr_s, shr_u
        // rotl, rotr
        // clang-format on
        return uint(GetGasCost_c_arithmeticCosts[int(i_opcode) - (int(i_opcode) <= 120 ? 106 : 124)])
    }
    if (int(i_opcode) >= 32 && int(i_opcode) <= 62) {
        // locals, globals, table accesses, loads and stores
        return uint(anon_609.c_gasAccess)
    }
    if (int(i_opcode) >= 65 && int(i_opcode) <= 68) {
        // i32/i64/f32/f64.const
        return uint(anon_609.c_gasNominal)
    }
    if (int(i_opcode) >= 139 && int(i_opcode) <= 166) {
        // the float run, priced as integer arithmetic except where it divides
        // f32.sqrt, f32.div
        let divides : bool = i_opcode == 145 || i_opcode == 149 || i_opcode == 159 || i_opcode == 163
        // f64.sqrt, f64.div
        return uint(divides ? int(anon_609.c_gasDivide) : int(anon_609.c_gasArith))
    }
    // comparisons and clz/ctz/popcnt (0x45..0x69, 0x79..0x7b), the conversions
    // and sign extensions (0xa7..0xc4), the saturating truncations, and anything
    // else that reaches here: plain arithmetic
    return uint(anon_609.c_gasArith)
}

// The instructions ewasm's design segments a body at. A segment runs up to and
// including the next one of these, so every cycle a body can execute - a loop's
// back edge, a branch out of a block, falling off the end of a function - passes
// through at least one, and no path can run unmetered however it is entered.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsGasSegmentEnd(i_opcode : uint16) : bool {
    c_switch(int(i_opcode)) {
        case(3, 4, 5, 11, 12, 13, 14, 15, 18, 19, 21) {
            return 1 != 0
        }
        case(_) {
            return 0 != 0
        }
    }
}

// Ends the open segment by writing what it accumulated into the immediate its
// op_UseGas is still waiting on. Emitting onto a later code page does not move
// an earlier one, so the reservation is still where it was left.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__CloseGasSegment(var o : M3Compilation?) {
    if (o.gasPatch != null) {
        var cost : uint = o.gasCost
        crt::memcpy(o.gasPatch, reinterpret<void?>(addr(cost)), uint64(typeinfo sizeof(type<uint>)))
        o.gasPatch = null
        o.gasCost = 0u
    }
}

// Charges one instruction to the segment being compiled, opening a segment at
// this point in the code stream if none is open, and settling the segment when
// the instruction is one that ends it. Called before the instruction is
// compiled, which is what both halves need: the op_UseGas lands ahead of what it
// pays for, and the cost is final before a block-structured instruction - loop,
// if, else - compiles its body from inside its own compiler. The body then opens
// a segment of its own, inside the loop or the arm, where it is charged on every
// pass rather than once on the way in.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__MeterOpcode(var o : M3Compilation?; var i_opcode : uint16) : uint8? {
    var result : uint8? = m3Err_none
    // constant expressions are not metered: they run once at instantiation,
    // before the module is anything a gas budget was handed out for
    if (o._c_function != null && o.page != null && o.runtime.gasLimit != 0) {
        // only the 0xFC prefix has been read so far; the instruction it names is
        // the LEB128 u32 the compiler is about to take. Peek it without consuming.
        // Anything the tables do not cover leaves the prefix priced on its own,
        // which is moot - the compile fails on it a moment later.
        if (int(i_opcode) == int(anon_315.c_waOp_extended)) {
