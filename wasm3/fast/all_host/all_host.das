                while (int(i) < int(numParams)) {
                    let _c_type : uint8 = GetFuncTypeParamType(i_blockType, uint16(int(numParams) - 1 - int(i)))
                    result = all_host__PopType(o, _c_type)
                    if (result != null) {
                        goto label 1
                    }
                    i = uint16(uint(i) + 1)
                }
            }
        } else {
            if (all_host__IsStackPolymorphic(o) && int(o._c_block.blockStackIndex) + int(numParams) > int(o.stackIndex)) {
                o.stackIndex = o._c_block.blockStackIndex
            } else {
                o.stackIndex = uint16(int(o.stackIndex) - int(numParams))
            }
        }
        let paramIndex : uint16 = o.stackIndex
        // consume the params at block exit
        _c_block.exitStackIndex = paramIndex
        // keep copies of param slots in the stack
        o.stackIndex = stackIndex
        // find slots for the results ----------------------------
        result = all_host__PushBlockResults(o)
        if (result != null) {
            goto label 1
        }
        stackIndex = o.stackIndex
        // dealloc but keep record of the result slots in the stack
        var numResults : uint16 = GetFuncTypeNumResults(i_blockType)
        while (true) {
            let _t0 = numResults
            numResults = uint16(uint(numResults) - 1)
            if (_t0 == 0) {
                break
            }
            all_host__Pop(o)
        }
        o.stackIndex = stackIndex
        _c_block.blockStackIndex = o.stackIndex
        // push the params back onto the stack -------------------
        {
            var i : uint16 = uint16(0)
            while (int(i) < int(numParams)) {
                let _c_type : uint8 = GetFuncTypeParamType(i_blockType, i)
                let slot : uint16 = all_host__GetSlotForStackIndex(o, uint16(int(paramIndex) + int(i)))
                all_host__Push(o, _c_type, slot)
                if (int(slot) >= int(o.slotFirstDynamicIndex) && slot != all_host__c_slotUnused) {
                    result = all_host__MarkSlotsAllocatedByType(o, slot, _c_type)
                    if (result != null) {
                        goto label 1
                    }
                }
                i = uint16(uint(i) + 1)
            }
        }
        // --------------------------------------------------------
        // with the scope pushed and the params back on, a catch label of 0 names
        // this block - which is what the proposal says it should
        if (int(i_blockOpcode) == int(anon_315.c_waOp_tryTable)) {
            result = all_host__EmitCatchStubs(o)
            if (result != null) {
                goto label 1
            }
        }
        result = CompileBlockStatements(o)
        if (result != null) {
            goto label 1
        }
        result = all_host__ValidateBlockEnd(o)
        if (result != null) {
            goto label 1
        }
        // skip for expressions
        if (o._c_function != null) {
            if (!all_host__IsStackPolymorphic(o)) {
                // isBranch:
                result = all_host__ResolveBlockResults(o, addr(o._c_block), 0 != 0)
                if (result != null) {
                    goto label 1
                }
            }
            // Falling out of the end of a try region retires its handler. This sits
            // ahead of PatchBranches so branches into the block's exit land past it:
            // a branch out of the try popped its own handler at the branch site.
            if (int(i_blockOpcode) == int(anon_315.c_waOp_tryTable)) {
                result = all_host__EmitOp(o, @@all_host__op_PopHandlers)
                if (result != null) {
                    goto label 1
                }
                all_host__EmitConstant32(o, 1u)
            }
            result = all_host__UnwindBlockStack(o)
            if (result != null) {
                goto label 1
            }
            if (!((int(i_blockOpcode) == int(anon_315.c_waOp_if) && numResults != 0) || int(o.previousOpcode) == int(anon_315.c_waOp_else))) {
                o.stackIndex = o._c_block.exitStackIndex
                result = all_host__PushBlockResults(o)
                if (result != null) {
                    goto label 1
                }
            }
        }
        all_host__PatchBranches(o)
        o._c_block = outerScope
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__CompileLocals(var o : M3Compilation?) : uint8? {
    var result : uint8?
    var numLocals : uint = 0u
    var numLocalBlocks : uint
    result = ReadLEB_u32(addr(numLocalBlocks), addr(o.wasm), o.wasmEnd)
    if (result != null) {
        goto label 1
    }
    for (l in urange(numLocalBlocks)) {
        var varCount : uint
        var localType : uint8
        result = ReadLEB_u32(addr(varCount), addr(o.wasm), o.wasmEnd)
        if (result != null) {
            goto label 1
        }
        result = ParseValueType(o._c_module, addr(localType), addr(o.wasm), o.wasmEnd)
        if (result != null) {
            goto label 1
        }
        numLocals += varCount
        while (true) {
            let _t0 = varCount
            varCount--
            if (_t0 == 0) {
                break
            }
            result = all_host__PushAllocatedSlot(o, localType)
            if (result != null) {
                goto label 1
            }
        }
    }
    if (o._c_function != null) {
        o._c_function.numLocals = uint16(numLocals)
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__ReserveConstants(var o : M3Compilation?) : uint8? {
    var result : uint8? = m3Err_none
    // in the interest of speed, this blindly scans the Wasm code looking for any byte
    // that looks like an const opcode.
    var numConstantSlots : uint16 = uint16(0)
    var wa : uint8? = o.wasm
    while (intptr(wa) < intptr(o.wasmEnd)) {
        var _t0 = wa
        wa++
        let code : uint8 = *_t0
        var addSlots : uint16 = uint16(0)
        if (int(code) == int(anon_315.c_waOp_i32_const) || int(code) == int(anon_315.c_waOp_f32_const)) {
            addSlots = uint16(1)
        } elif (int(code) == int(anon_315.c_waOp_i64_const) || int(code) == int(anon_315.c_waOp_f64_const)) {
            addSlots = all_host__GetTypeNumSlots(uint8(M3ValueType.c_m3Type_i64))
        }
        if (int(numConstantSlots) + int(addSlots) >= d_m3MaxConstantTableSize) {
            break
        }
        numConstantSlots = uint16(int(numConstantSlots) + int(addSlots))
    }
    // if constants overflow their reserved stack space, the compiler simply emits op_Const
    // operations as needed. Compiled expressions (global inits) don't pass through this
    // ReserveConstants function and thus always produce inline constants.
    all_host__AlignSlotToType(addr(numConstantSlots), uint8(M3ValueType.c_m3Type_i64))
    o.slotFirstDynamicIndex = uint16(int(o.slotFirstConstIndex) + int(numConstantSlots))
    if (int(o.slotFirstDynamicIndex) >= d_m3MaxFunctionSlots) {
        result = m3Err_functionStackOverflow
        goto label 1
    }
    label 1:  // _catch
    return result
}

// A constant expression compiles like a miniature function root block: no args,
// no locals and a single result, which Compile_End copies down into slot 0 for
// EvaluateExpression to read back.
[unsafe_deref, hint(unsafe_range_check)]
def CompileExpression(var o : M3Compilation?; var i_resultType : M3FuncType?) : uint8? {
    var result : uint8? = m3Err_none
    o._c_block._c_type = i_resultType
    let numRetSlots : uint16 = uint16(int(GetFuncTypeNumResults(i_resultType)) * int(all_host__c_ioSlotCount))
    {
        var i : uint16 = uint16(0)
        while (int(i) < int(numRetSlots)) {
            all_host__MarkSlotAllocated(o, i)
            i = uint16(uint(i) + 1)
        }
    }
    o.slotFirstDynamicIndex = numRetSlots
    o.slotMaxAllocatedIndexPlusOne = o.slotFirstDynamicIndex
    o.maxStackSlots = o.slotMaxAllocatedIndexPlusOne
    result = CompileBlockStatements(o)
    if (result != null) {
        goto label 1
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def CompileFunction(var io_function : M3Function?) : uint8? {
    if (io_function.wasm == null) {
        // An import. Either linking pointed it at another module's function -
        // in which case that one carries the body - or a host function was
        // bound to it, or it is simply unsatisfied.
        var impl : M3Function? = all_host__Function_Implementation(io_function)
        if (intptr(impl) != intptr(io_function)) {
            if (impl.compiled == null) {
                var r : uint8? = CompileFunction(impl)
                if (r != null) {
                    return r
                }
            }
            // keep the placeholder callable too, for anything still holding it
            io_function.compiled = impl.compiled
            return m3Err_none
        }
        if (io_function.compiled != null) {
            return m3Err_none
        }
        return m3Err_functionImportMissing
    }
    if (!io_function._c_module.runtime.skipValidation) {
        var vr : uint8? = ValidateFunction(io_function)
        if (vr != null) {
            return vr
        }
    }
    var funcType : M3FuncType? = io_function.funcType
    var runtime : M3Runtime? = io_function._c_module.runtime
    // need twice as many slots in 32-bit mode
    var o : M3Compilation? = addr(runtime.compilation)
    crt::memset(reinterpret<void?>(o), 0, uint64(typeinfo sizeof(type<M3Compilation>)))
    o.runtime = runtime
    o._c_module = io_function._c_module
    o._c_function = io_function
    o.wasm = io_function.wasm
    o.wasmEnd = io_function.wasmEnd
    o._c_block._c_type = funcType
    var result : uint8? = m3Err_none
    {
        // skip over code size. the end was already calculated during parse phase
        var size : uint
        result = ReadLEB_u32(addr(size), addr(o.wasm), o.wasmEnd)
        if (result != null) {
            goto label 1
        }
        result = all_host__AcquireCompilationCodePage(o, addr(o.page))
        if (result != null) {
            goto label 1
        }
        var pc : void ?? = GetPagePC(o.page)
        let numRetSlots : uint16 = uint16(int(GetFunctionNumReturns(o._c_function)) * int(all_host__c_ioSlotCount))
        {
            var i : uint16 = uint16(0)
            while (int(i) < int(numRetSlots)) {
                all_host__MarkSlotAllocated(o, i)
                i = uint16(uint(i) + 1)
            }
        }
        o.slotFirstDynamicIndex = numRetSlots
        o._c_function.numRetSlots = o.slotFirstDynamicIndex
        let numArgs : uint16 = GetFunctionNumArgs(o._c_function)
        // push the arg types to the type stack
        {
            var i : uint16 = uint16(0)
            while (int(i) < int(numArgs)) {
                let _c_type : uint8 = GetFunctionArgType(o._c_function, uint(i))
                result = all_host__PushAllocatedSlot(o, _c_type)
                if (result != null) {
                    goto label 1
                }
                // prevent allocator fill-in
                o.slotFirstDynamicIndex = uint16(int(o.slotFirstDynamicIndex) + int(all_host__c_ioSlotCount))
                i = uint16(uint(i) + 1)
            }
        }
        o.slotFirstLocalIndex = o.slotFirstDynamicIndex
        o._c_function.numRetAndArgSlots = o.slotFirstLocalIndex
        o.slotMaxAllocatedIndexPlusOne = o._c_function.numRetAndArgSlots
        result = all_host__CompileLocals(o)
        if (result != null) {
            goto label 1
        }
        // the table charges for a function's locals as well as for its instructions.
        // op_Entry is what sets them up, so the charge rides on the body's first
        // segment, which is emitted right after it
        o.gasCost = uint(int(o._c_function.numLocals) * int(anon_609.c_gasLocal))
        let maxSlot : uint16 = GetMaxUsedSlotPlusOne(o)
        o._c_function.numLocalBytes = uint(uint64(int(maxSlot) - int(o.slotFirstLocalIndex)) * uint64(typeinfo sizeof(type<uint>)))
        o.slotMaxConstIndex = maxSlot
        o.slotFirstConstIndex = o.slotMaxConstIndex
        // ReserveConstants initializes o->firstDynamicSlotNumber
        result = all_host__ReserveConstants(o)
        if (result != null) {
            goto label 1
        }
        // start tracking the max stack used (Push() also updates this value) so that op_Entry can precisely detect stack overflow
        o.slotMaxAllocatedIndexPlusOne = o.slotFirstDynamicIndex
        o.maxStackSlots = o.slotMaxAllocatedIndexPlusOne
        o.stackFirstDynamicIndex = o.stackIndex
        o._c_block.blockStackIndex = o.stackFirstDynamicIndex
        result = all_host__EmitOp(o, @@all_host__op_Entry)
        if (result != null) {
            goto label 1
        }
        all_host__EmitPointer(o, reinterpret<void?>(io_function))
        result = CompileBlockStatements(o)
        if (result != null) {
            goto label 1
        }
        if (int(o.previousOpcode) != int(anon_315.c_waOp_end)) {
            result = m3Err_wasmMalformed
            goto label 1
        }
        io_function.compiled = pc
        io_function.maxStackSlots = o.maxStackSlots
        let numConstantSlots : uint16 = uint16(int(o.slotMaxConstIndex) - int(o.slotFirstConstIndex))
        io_function.numConstantBytes = uint16(uint64(numConstantSlots) * uint64(typeinfo sizeof(type<uint>)))
        if (numConstantSlots != 0) {
            io_function.constants = m3_CopyMem(reinterpret<void?>(reinterpret<uint8?>(addr(o.constants[0]))), uint64(io_function.numConstantBytes))
            if (io_function.constants == null) {
                result = m3Err_mallocFailed
                goto label 1
            }
        }
    }
    label 1:  // _catch
    all_host__ReleaseCompilationCodePage(o)
    return result
}

// The reading half on its own: what each m3_HostMapFile falls back to, and the whole
// of what a system with no mapping does. The same on every system, so it is here
// rather than in any of them - and inline, so that a translation unit which never
// calls it is not the one that drags stdio's FILE machinery into the link.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__m3_HostReadFile(var i_path : uint8?; i_maxBytes : uint64; var o_file : M3HostFile?) : bool {
    var f : FILE? = reinterpret<FILE?>(crt::fopen(i_path, cstr("rb")))
    if (f == null) {
        return 0 != 0
    }
    // The size is taken before anything is allocated, so that a file too big to be
    // wanted is refused rather than read
    crt::fseek(reinterpret<void?>(f), 0l, SEEK_END)
    let tell : int64 = crt::ftell(reinterpret<void?>(f))
    crt::fseek(reinterpret<void?>(f), 0l, SEEK_SET)
    if (tell < 0l || (i_maxBytes != 0 && uint64(tell) > i_maxBytes)) {
        crt::fclose(reinterpret<void?>(f))
        return 0 != 0
    }
    let size : uint64 = uint64(tell)
    var data : void? = m3_Malloc_Impl(size != 0 ? size : 1ul)
    if (data == null) {
        crt::fclose(reinterpret<void?>(f))
        return 0 != 0
    }
    let read : bool = crt::fread(data, 1ul, size, reinterpret<void?>(f)) == size
    crt::fclose(reinterpret<void?>(f))
    if (!read) {
        {
            m3_Free_Impl(data)
            data = null
        }
        return 0 != 0
    }
    o_file.data = data
    o_file.size = size
    o_file.handle = d_m3HostNoHandle
    o_file.mapped = 0 != 0
    return 1 != 0
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_HostStackBase : void? {
    return null
}

// No mmap here, so the module's bytes are read directly onto the heap
[unsafe_deref, hint(unsafe_range_check)]
def m3_HostMapFile(var i_path : uint8?; i_maxBytes : uint64; var o_file : M3HostFile?) : bool {
    return all_host__m3_HostReadFile(i_path, i_maxBytes, o_file)
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_HostUnmapFile(var io_file : M3HostFile?) {
    {
        m3_Free_Impl(io_file.data)
        io_file.data = null
    }
    io_file.size = 0ul
    io_file.handle = d_m3HostNoHandle
    io_file.mapped = 0 != 0
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_Abort(var message : uint8?) {
    c_abort()
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_Yield : uint8? {
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_Malloc_Impl(i_size : uint64) : void? {
    return crt::calloc(i_size, 1ul)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_Free_Impl(var io_ptr : void?) {
    crt::free(io_ptr)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_Realloc_Impl(var i_ptr : void?; i_newSize : uint64; i_oldSize : uint64) : void? {
    if (i_newSize == i_oldSize) {
        return i_ptr
    }
    var newPtr : void? = crt::realloc(i_ptr, i_newSize)
    if (newPtr != null) {
        if (i_newSize > i_oldSize) {
            crt::memset(reinterpret<void?>(reinterpret<uint8?>(newPtr) + i_oldSize), 0, i_newSize - i_oldSize)
        }
        return newPtr
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_CopyMem(var i_from : void?; i_size : uint64) : void? {
    var ptr : void? = m3_Malloc_Impl(i_size)
    if (ptr != null) {
        crt::memcpy(ptr, i_from, i_size)
    }
    return ptr
}

// Value types arrive as signed 7-bit LEBs, so the encoding negates: 0x7f (i32)
// reads as -1, 0x7b (v128) as -5, 0x70 (funcref) as -16, 0x6f (externref) as -17.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def NormalizeType(var o_type : uint8?; i_convolutedWasmType : int8) : uint8? {
    var result : uint8? = m3Err_none
    var _c_type : uint8 = uint8(-int(i_convolutedWasmType))
    if (_c_type == 64) {
        _c_type = uint8(M3ValueType.c_m3Type_none)
    } elif (int(_c_type) == d_waType_funcref) {
        // always recognised: funcref names the element type of an MVP table even
        // when the reference types proposal is compiled out
        _c_type = uint8(M3ValueType.c_m3Type_funcref)
    } elif (int(_c_type) == d_waType_externref) {
        _c_type = uint8(M3ValueType.c_m3Type_externref)
    } elif (int(_c_type) == d_waType_exnref) {
        _c_type = uint8(M3ValueType.c_m3Type_exnref)
    } elif (int(_c_type) < int(M3ValueType.c_m3Type_i32) || int(_c_type) > int(M3ValueType.c_m3Type_v128)) {
        // Accept v128 (wasm-encoded as 0x7b → -i_convolutedWasmType == 5)
        // as an opaque slot so modules with v128 in signatures or local
        // declarations parse. Actual v128 opcodes still hit
        // m3Err_unknownOpcode at compile time - we just stop refusing
        // unused SIMD slots that auto-vectorization emits.
        result = m3Err_invalidTypeId
    }
    *o_type = _c_type
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def IsFpType(i_type : uint8) : bool {
    let i_m3Type : uint8 = all_host__BaseTypeOf(i_type)
    return int(i_m3Type) == int(M3ValueType.c_m3Type_f32) || int(i_m3Type) == int(M3ValueType.c_m3Type_f64)
}

[unsafe_deref, hint(unsafe_range_check)]
def IsRefType(i_type : uint8) : bool {
    let i_m3Type : uint8 = all_host__BaseTypeOf(i_type)
    return int(i_m3Type) == int(M3ValueType.c_m3Type_funcref) || int(i_m3Type) == int(M3ValueType.c_m3Type_externref) || int(i_m3Type) == int(M3ValueType.c_m3Type_exnref)
}

[unsafe_deref, hint(unsafe_range_check)]
def IsIntType(i_type : uint8) : bool {
    let i_m3Type : uint8 = all_host__BaseTypeOf(i_type)
    return int(i_m3Type) == int(M3ValueType.c_m3Type_i32) || int(i_m3Type) == int(M3ValueType.c_m3Type_i64)
}

[unsafe_deref, hint(unsafe_range_check)]
def Is64BitType(i_type : uint8) : bool {
    let i_m3Type : uint8 = all_host__BaseTypeOf(i_type)
    if (int(i_m3Type) == int(M3ValueType.c_m3Type_i64) || int(i_m3Type) == int(M3ValueType.c_m3Type_f64)) {
        return 1 != 0
    } elif (int(i_m3Type) == int(M3ValueType.c_m3Type_i32) || int(i_m3Type) == int(M3ValueType.c_m3Type_f32) ||
            int(i_m3Type) == int(M3ValueType.c_m3Type_none)) {
        return 0 != 0
    } else {
        // all other cases are pointers
        return uint64(typeinfo sizeof(type<void?>)) == 8ul
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def SizeOfType(i_type : uint8) : uint {
    let i_m3Type : uint8 = all_host__BaseTypeOf(i_type)
    if (int(i_m3Type) == int(M3ValueType.c_m3Type_i32) || int(i_m3Type) == int(M3ValueType.c_m3Type_f32)) {
        return uint(uint64(typeinfo sizeof(type<int>)))
    }
    if (IsRefType(i_m3Type)) {
        return uint(uint64(typeinfo sizeof(type<void?>)))
    }
    return uint(uint64(typeinfo sizeof(type<int64>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Read_u64(var o_value : uint64?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var ptr : uint8? = *io_bytes
    ptr += uint64(typeinfo sizeof(type<uint64>))
    if (intptr(ptr) <= intptr(i_end)) {
        crt::memcpy(reinterpret<void?>(o_value), reinterpret<void?>(*io_bytes), uint64(typeinfo sizeof(type<uint64>)))
        *io_bytes = ptr
        return m3Err_none
    } else {
        return m3Err_wasmUnderrun
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Read_u32(var o_value : uint?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var ptr : uint8? = *io_bytes
    ptr += uint64(typeinfo sizeof(type<uint>))
    if (intptr(ptr) <= intptr(i_end)) {
        crt::memcpy(reinterpret<void?>(o_value), reinterpret<void?>(*io_bytes), uint64(typeinfo sizeof(type<uint>)))
        *io_bytes = ptr
        return m3Err_none
    } else {
        return m3Err_wasmUnderrun
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Read_f64(var o_value : double?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var ptr : uint8? = *io_bytes
    ptr += uint64(typeinfo sizeof(type<double>))
    if (intptr(ptr) <= intptr(i_end)) {
        crt::memcpy(reinterpret<void?>(o_value), reinterpret<void?>(*io_bytes), uint64(typeinfo sizeof(type<double>)))
        *io_bytes = ptr
        return m3Err_none
    } else {
        return m3Err_wasmUnderrun
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Read_f32(var o_value : float?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var ptr : uint8? = *io_bytes
    ptr += uint64(typeinfo sizeof(type<float>))
    if (intptr(ptr) <= intptr(i_end)) {
        crt::memcpy(reinterpret<void?>(o_value), reinterpret<void?>(*io_bytes), uint64(typeinfo sizeof(type<float>)))
        *io_bytes = ptr
        return m3Err_none
    } else {
        return m3Err_wasmUnderrun
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Read_u8(var o_value : uint8?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var ptr : uint8? = *io_bytes
    if (intptr(ptr) < intptr(i_end)) {
        *o_value = *ptr
        *io_bytes = ptr + 1
        return m3Err_none
    } else {
        return m3Err_wasmUnderrun
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Read_opcode(var o_value : uint16?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var ptr : uint8? = *io_bytes
    if (intptr(ptr) < intptr(i_end)) {
        // 0xFC is returned as the bare prefix: its sub-opcode is a LEB128 u32, which
        // only the callers - Compile_ExtendedOpcode and the validator - can read.
        var _t0 = ptr
        ptr++
        let opcode : uint16 = uint16(*_t0)
        *o_value = opcode
        *io_bytes = ptr
        return m3Err_none
    } else {
        return m3Err_wasmUnderrun
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ReadLebUnsigned(var o_value : uint64?; i_maxNumBits : uint; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_wasmUnderrun
    var value : uint64 = 0ul
    var shift : uint = 0u
    var ptr : uint8? = *io_bytes
    while (intptr(ptr) < intptr(i_end)) {
        var _t0 = ptr
        ptr++
        let byte : uint64 = uint64(*_t0)
        value |= (byte & 127ul) << uint64(shift)
        shift += 7u
        if ((byte & 128ul) == 0ul) {
            result = m3Err_none
            // The last byte must not carry bits past i_maxNumBits
            if (shift > i_maxNumBits) {
                let numUsedBits : uint = i_maxNumBits + 7u - shift
                if (byte >> uint64(numUsedBits) != 0) {
                    result = m3Err_lebOverflow
                }
            }
            break
        }
        if (shift >= i_maxNumBits) {
            result = m3Err_lebOverflow
            break
        }
    }
    *o_value = value
    *io_bytes = ptr
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ReadLebSigned(var o_value : int64?; i_maxNumBits : uint; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_wasmUnderrun
    var value : int64 = 0l
    var shift : uint = 0u
    var ptr : uint8? = *io_bytes
    while (intptr(ptr) < intptr(i_end)) {
        var _t0 = ptr
        ptr++
        let byte : uint64 = uint64(*_t0)
        value = int64(uint64(value) | ((byte & 127ul) << uint64(shift)))
        shift += 7u
        if ((byte & 128ul) == 0ul) {
            result = m3Err_none
            // The bits of the last byte past i_maxNumBits must all repeat the
            // sign bit, otherwise the value doesn't fit
            if (shift > i_maxNumBits) {
                let numUsedBits : uint = i_maxNumBits + 7u - shift
                let signBits : uint8 = uint8((127 << int(numUsedBits - 1u)) & 127)
                let bits : uint8 = uint8(byte & uint64(signBits))
                if (bits != 0 && bits != signBits) {
                    result = m3Err_lebOverflow
                }
            }
            // do sign extension
            if ((byte & 64ul) != 0 && (shift < 64u)) {
                let extend : uint64 = 0ul
                value = int64(uint64(value) | (~extend << uint64(shift)))
            }
            break
        }
        if (shift >= i_maxNumBits) {
            result = m3Err_lebOverflow
            break
        }
    }
    *o_value = value
    *io_bytes = ptr
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
