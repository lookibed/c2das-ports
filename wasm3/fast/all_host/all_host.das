// when the pending fold candidate is a compare whose result sits on top in _r0, return the fused
// variant that absorbs an immediately following br_if (i_isIf false) or if (i_isIf true)
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetBranchFusionOp(var o : M3Compilation?;
                                        i_isIf : bool) : function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?> {
    if (o.foldPatchPC != null && int(o.foldForm) < 4 && all_host__IsStackTopInRegister(o) && all_host__GetStackTopIndex(o) == int16(o.foldStackIndex)) {
        var ops : M3FusedCmpOps? = all_host__GetFusedCmpOps(o.foldOpcode)
        if (ops != null) {
            return i_isIf ? ops.ifOp[int(o.foldForm)] : ops.branchIf[int(o.foldForm)]
        }
    }
    return default<function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>>
