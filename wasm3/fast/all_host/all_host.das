                i++
            }
            _f2 = true
            if (!(i < io_module.numElementSegments)) {
                break
            }
            var segment : M3ElementSegment? = addr(io_module.elementSegments[i])
            // Declarative segments only make their functions referenceable, and
            // passive ones wait for table.init, so neither is written out here.
            if (int(segment.mode) == int(M3ElementMode.c_m3Elem_declarative)) {
                segment.dropped = 1 != 0
                continue
            }
            if (int(segment.mode) == int(M3ElementMode.c_m3Elem_passive)) {
                if (segment.numElements != 0) {
                    segment.resolved = reinterpret<void ??>(m3_Malloc_Impl(uint64(typeinfo sizeof(type<void?>)) * uint64(segment.numElements)))
                    if (segment.resolved == null) {
                        result = m3Err_mallocFailed
                        goto label 1
                    }
                    result = all_host__ResolveElements(io_module, segment, segment.resolved)
                    if (result != null) {
                        goto label 1
                    }
                }
                continue
            }
            _c_table = io_module.tables[segment.tableIndex]
            // The offset expression has the table's index type, and is unsigned:
            // an i32 offset of -1 is 4294967295, out of bounds rather than negative.
            var offset : uint64 = 0ul
            var expr : uint8? = segment.initExpr
            if (_c_table.isTable64) {
                result = EvaluateExpression(io_module, reinterpret<void?>(addr(offset)), uint8(M3ValueType.c_m3Type_i64), addr(expr), end)
                if (result != null) {
                    goto label 1
                }
            } else {
                var offset32 : uint
                result = EvaluateExpression(io_module, reinterpret<void?>(addr(offset32)), uint8(M3ValueType.c_m3Type_i32), addr(expr), end)
                if (result != null) {
                    goto label 1
                }
                offset = uint64(offset32)
            }
            if (offset > uint64(_c_table.size) || uint64(segment.numElements) > uint64(_c_table.size) - offset) {
                result = cstr("out of bounds table access")
                goto label 1
            }
            result = all_host__ResolveElements(io_module, segment, _c_table.elements + offset)
            if (result != null) {
                goto label 1
            }
            segment.dropped = 1 != 0
        }
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_CompileModule(var io_module : M3Module?) : uint8? {
    var result : uint8? = m3Err_none
    {
        var i : uint = 0u
        while (i < io_module.numFunctions) {
            var f : M3Function? = addr(io_module.functions[i])
            if (f.wasm != null && f.compiled == null) {
                result = CompileFunction(f)
                if (result != null) {
                    goto label 1
                }
            }
            i++
        }
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def NewException(var io_runtime : M3Runtime?; var i_tag : M3Tag?; i_numArgs : uint) : M3Exception? {
    var exception : M3Exception? = reinterpret<M3Exception?>(m3_Malloc_Impl(uint64(typeinfo sizeof(type<M3Exception>)) + uint64(i_numArgs) *
            uint64(typeinfo sizeof(type<uint64>))))
    if (exception != null) {
        exception.tag = i_tag
        exception.numArgs = i_numArgs
        exception.reified = 0 != 0
        exception.prev = null
        exception.next = io_runtime.exceptions
        if (exception.next != null) {
            exception.next.prev = exception
        }
        io_runtime.exceptions = exception
    }
    return exception
}

// Releases one exception ahead of the rest. The caller has to know nothing can
// still name it: no exnref was ever taken of it, and its payload has already
// been copied out.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def FreeException(var io_runtime : M3Runtime?; var i_exception : M3Exception?) {
    if (i_exception.prev != null) {
        i_exception.prev.next = i_exception.next
    } else {
        io_runtime.exceptions = i_exception.next
    }
    if (i_exception.next != null) {
        i_exception.next.prev = i_exception.prev
    }
    if (intptr(io_runtime.pendingException) == intptr(i_exception)) {
        io_runtime.pendingException = null
    }
    m3_Free_Impl(reinterpret<void?>(i_exception))
}

// Releases every exception the runtime still holds. Only safe once the Wasm
// stack is empty, which is why the outermost RunCodeChecked() is the one that
// calls it.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def FreeExceptions(var io_runtime : M3Runtime?) {
    var exception : M3Exception? = io_runtime.exceptions
    io_runtime.exceptions = null
    io_runtime.pendingException = null
    while (exception != null) {
        var next : M3Exception? = exception.next
        m3_Free_Impl(reinterpret<void?>(exception))
        exception = next
    }
}

// Run compiled code on the runtime's stack, bounding native recursion for the
// duration of the call. The outermost invocation establishes the stack limit;
// nested ones (an imported function calling back into Wasm) inherit it.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__RunCodeChecked(var i_runtime : M3Runtime?; var i_function : M3Function?) : uint8? {
    var i_pc : void ?? = i_function.compiled
    // execution runs against the memory of the module the entry point belongs
    // to, not against some runtime-wide one
    var _mem : M3MemoryHeader? = all_host__Module_MemoryHeader(i_function._c_module)
    // handler stacks don't nest across a call boundary: a host function calling
    // back into Wasm cannot be caught by a try_table its own caller entered
    let savedTryDepth : uint = i_runtime.tryDepth
    i_runtime.tryDepth = 0u
    i_runtime.exceptionNesting++
    var result : uint8? = reinterpret<uint8?>(all_host__RunCode(i_pc, reinterpret<uint?>(i_runtime.stack), _mem, int64(d_m3OpDefaultArgs)))
    i_runtime.tryDepth = savedTryDepth
    // an exception that reached the bottom of the call stack found no handler
    if (intptr(result) == intptr(m3Err_pendingException)) {
        result = m3Err_trapUncaughtException
    }
    i_runtime.exceptionNesting--
    if (i_runtime.exceptionNesting == 0u) {
        FreeExceptions(i_runtime)
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_RunStart(var io_module : M3Module?) : uint8? {
    // Execution disabled for fuzzing builds
    var result : uint8? = m3Err_none
    var startFunctionTmp : int = -1
    if (io_module != null && io_module.startFunction >= 0) {
        var _c_function : M3Function? = addr(io_module.functions[io_module.startFunction])
        if (_c_function.compiled == null) {
            result = CompileFunction(_c_function)
            if (result != null) {
                goto label 1
            }
        }
        var ftype : M3FuncType? = _c_function.funcType
        if (ftype.numArgs != 0 || ftype.numRets != 0) {
            result = m3Err_argumentCountMismatch
            goto label 1
        }
        var _c_module : M3Module? = _c_function._c_module
        var runtime : M3Runtime? = _c_module.runtime
        startFunctionTmp = io_module.startFunction
        io_module.startFunction = -1
        result = all_host__RunCodeChecked(runtime, _c_function)
        if (result != null) {
            io_module.startFunction = startFunctionTmp
            goto label 1
        }
    }
    label 1:  // _catch
    return result
}

// TODO: deal with main + side-modules loading efforcement
[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_LoadModule(var io_runtime : M3Runtime?; var io_module : M3Module?) : uint8? {
    var result : uint8? = m3Err_none
    if (io_module.runtime != null) {
        return m3Err_moduleAlreadyLinked
    }
    io_module.runtime = io_runtime
    // linking first: a memory import has to be resolved before InitMemory would
    // give it pages of its own, and a global import before an initializer reads it
    result = all_host__LinkImports(io_runtime, io_module)
    if (result != null) {
        goto label 1
    }
    result = InitMemory(io_runtime, io_module)
    if (result != null) {
        goto label 1
    }
    result = InitGlobals(io_module)
    if (result != null) {
        goto label 1
    }
    // Spec order: element segments are applied before data segments. It matters
    // when one of them traps - whatever ran before the trap stays done.
    result = InitTableAndElements(io_module)
    if (result != null) {
        goto label 1
    }
    result = InitDataSegments(io_module)
    if (result != null) {
        goto label 1
    }
    // Start func might use imported functions, which are not liked here yet,
    // so it will be called before a function call is attempted (in m3_FindFunction)
    io_module.next = io_runtime.modules
    io_runtime.modules = io_module
    // ok
    return result
    label 1:  // _catch
    // The runtime owns the module either way. Instantiation may already have
    // written this module's functions into a table another module owns, and the
    // spec keeps whatever it managed to do before the trap, so those entries
    // stay callable - retaining the module is what stops them dangling.
    // It goes on the tail of the list rather than the head: it is not a module
    // anyone should find by name, only one whose functions may still be
    // reachable through someone else's table.
    io_module.next = null
    var tail : M3Module ?? = addr(io_runtime.modules)
    while (*tail != null) {
        tail = addr((*tail).next)
    }
    *tail = io_module
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_FindGlobal(var io_module : M3Module?; var i_globalName : uint8?) : M3Global? {
    // Search exports
    for (i in urange(io_module.numGlobals)) {
        var g : M3Global? = addr(io_module.globals[i])
        if (g.name != null && crt::strcmp(g.name, i_globalName) == 0) {
            // a re-exported global is the one that was imported, so reads and
            // writes have to reach the cell that actually holds the value
            return g.resolved != null ? g.resolved : g
        }
    }
    // Search imports
    for (i in urange(io_module.numGlobals)) {
        var g : M3Global? = addr(io_module.globals[i])
        if (g.import.moduleUtf8 != null && g.import.fieldUtf8 != null) {
            if (crt::strcmp(g.import.fieldUtf8, i_globalName) == 0) {
                return g.resolved != null ? g.resolved : g
            }
        }
    }
    return null
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetGlobal(var i_global : M3Global?; var o_value : M3TaggedValue?) : uint8? {
    if (i_global == null) {
        return m3Err_globalLookupFailed
    }
    c_switch(int(i_global._c_type)) {
        case(1) {
            o_value.value.i32 = uint(i_global._anon2.i32Value)
            break
        }
        case(2) {
            o_value.value.i64 = uint64(i_global._anon2.i64Value)
            break
        }
        case(_) {
            return m3Err_invalidTypeId
        }
    }
    o_value._c_type = enum_from_int(type<M3ValueType>, int(i_global._c_type))
    return m3Err_none
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_SetGlobal(var i_global : M3Global?; var i_value : M3TaggedValue?) : uint8? {
    if (i_global == null) {
        return m3Err_globalLookupFailed
    }
    if (!i_global.isMutable) {
        return m3Err_globalNotMutable
    }
    if (uint(i_global._c_type) != uint(i_value._c_type)) {
        return m3Err_globalTypeMismatch
    }
    c_switch(i_value._c_type) {
        case(M3ValueType.c_m3Type_i32) {
            i_global._anon2.i32Value = int(i_value.value.i32)
            break
        }
        case(M3ValueType.c_m3Type_i64) {
            i_global._anon2.i64Value = int64(i_value.value.i64)
            break
        }
        case(_) {
            return m3Err_invalidTypeId
        }
    }
    return m3Err_none
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetGlobalType(var i_global : M3Global?) : M3ValueType {
    return i_global != null ? enum_from_int(type<M3ValueType>, int(i_global._c_type)) : M3ValueType.c_m3Type_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def v_FindFunction(var i_module : M3Module?; var i_info : void?) : void? {
    var i_name : uint8? = reinterpret<uint8?>(i_info)
    // Prefer exported functions
    for (i in urange(i_module.numFunctions)) {
        var f : M3Function? = addr(i_module.functions[i])
        if (f.export_name != null && crt::strcmp(f.export_name, i_name) == 0) {
            // A module that re-exports an import names the placeholder here.
            // Resolve to the function that actually runs, or a host-side call
            // would run it against the importing module's memory.
            return reinterpret<void?>(all_host__Function_Implementation(f))
        }
    }
    // Search internal functions
    for (i in urange(i_module.numFunctions)) {
        var f : M3Function? = addr(i_module.functions[i])
        let isImported : bool = f.import.moduleUtf8 != null || f.import.fieldUtf8 != null
        if (isImported) {
            continue
        }
        for (j in range(int(f.numNames))) {
            if (f.names[j] != null && crt::strcmp(f.names[j], i_name) == 0) {
                return reinterpret<void?>(f)
            }
        }
    }
    return null
}

// Shared tail of the two lookups: a function is only usable once it has code.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__PrepareFoundFunction(var o_function : M3Function ??; var i_function : M3Function?) : uint8? {
    var result : uint8? = m3Err_none
    if (i_function.compiled == null) {
        result = CompileFunction(i_function)
        if (result != null) {
            goto label 1
        }
    }
    label 1:  // _catch
    *o_function = result != null ? default<M3Function?> : i_function
    return result
}

// Searches every module in the runtime, most recently loaded first. That is a
// guess once more than one module is loaded and two of them export the same
// name - m3_FindFunctionIn says which module is meant.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_FindFunction(var o_function : M3Function ??; var i_runtime : M3Runtime?; var i_functionName : uint8?) : uint8? {
    var _c_function : M3Function? = null
    if (i_runtime.modules == null) {
        *o_function = null
        return cstr("no modules loaded")
    }
    _c_function = reinterpret<M3Function?>(ForEachModule(i_runtime, @@v_FindFunction, reinterpret<void?>(i_functionName)))
    if (_c_function == null) {
        *o_function = null
        return m3Err_functionLookupFailed
    }
    return all_host__PrepareFoundFunction(o_function, _c_function)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_FindModule(var i_runtime : M3Runtime?; var i_moduleName : uint8?) : M3Module? {
    if (i_runtime == null || i_moduleName == null) {
        return null
    }
    // the list is newest-first, so a name registered twice names the newer one
    {
        var m : M3Module? = i_runtime.modules
        while (m != null) {
            if (m.name != null && crt::strcmp(m.name, i_moduleName) == 0) {
                return m
            }
            m = m.next
        }
    }
    return null
}

// Searches one module's exports, which is what naming a module means.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_FindFunctionIn(var o_function : M3Function ??; var i_module : M3Module?; var i_functionName : uint8?) : uint8? {
    if (i_module == null) {
        *o_function = null
        // ErrorModule would deref it
        return m3Err_functionLookupFailed
    }
    var _c_function : M3Function? = reinterpret<M3Function?>(v_FindFunction(i_module, reinterpret<void?>(i_functionName)))
    if (_c_function == null) {
        *o_function = null
        return m3Err_functionLookupFailed
    }
    return all_host__PrepareFoundFunction(o_function, _c_function)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetTableFunction(var o_function : M3Function ??; var i_module : M3Module?; i_index : uint) : uint8? {
    var result : uint8? = m3Err_none
    {
        var _c_table : M3Table?
        var _c_function : M3Function?
        if (i_module.numTables == 0u) {
            result = cstr("no table")
            goto label 1
        }
        _c_table = i_module.tables[0]
        if (i_index >= _c_table.size) {
            result = cstr("function index out of range")
            goto label 1
        }
        _c_function = reinterpret<M3Function?>(_c_table.elements[i_index])
        if (_c_function != null) {
            if (_c_function.compiled == null) {
                result = CompileFunction(_c_function)
                if (result != null) {
                    goto label 1
                }
            }
        }
        *o_function = _c_function
    }
    label 1:  // _catch
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__checkStartFunction(var i_module : M3Module?) : uint8? {
    var result : uint8? = m3Err_none
    // Check if start function needs to be called
    if (i_module.startFunction >= 0) {
        result = m3_RunStart(i_module)
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetArgCount(var i_function : M3Function?) : uint {
    if (i_function != null) {
        var ft : M3FuncType? = i_function.funcType
        if (ft != null) {
            return uint(ft.numArgs)
        }
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetRetCount(var i_function : M3Function?) : uint {
    if (i_function != null) {
        var ft : M3FuncType? = i_function.funcType
        if (ft != null) {
            return uint(ft.numRets)
        }
    }
    return 0u
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetArgType(var i_function : M3Function?; index : uint) : M3ValueType {
    if (i_function != null) {
        var ft : M3FuncType? = i_function.funcType
        if (ft != null && index < uint(ft.numArgs)) {
            return enum_from_int(type<M3ValueType>, int(all_host__BaseTypeOf(d_FuncArgType(ft, index))))
        }
    }
    return M3ValueType.c_m3Type_none
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetRetType(var i_function : M3Function?; index : uint) : M3ValueType {
    if (i_function != null) {
        var ft : M3FuncType? = i_function.funcType
        if (ft != null && index < uint(ft.numRets)) {
            return enum_from_int(type<M3ValueType>, int(all_host__BaseTypeOf(d_FuncRetType(ft, index))))
        }
    }
    return M3ValueType.c_m3Type_none
}

// The call APIs marshal their arguments into the runtime stack before any
// compiled code runs, so op_Entry's overflow check comes too late to cover those
// writes - and for a host function or an import linked to another module there
// is no op_Entry of our own to reach at all. Bound the area about to be written
// here instead: results and arguments each take a u64 at this boundary, however
// wide the slot is inside. Every caller goes through this, so none of them can
// be the one that forgets.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetStackPointerForArgs(var i_function : M3Function?; var o_stack : uint8 ??) : uint8? {
    var runtime : M3Runtime? = i_function._c_module.runtime
    var ftype : M3FuncType? = i_function.funcType
    let needed : uint64 = (uint64(ftype.numRets) + uint64(ftype.numArgs)) * uint64(typeinfo sizeof(type<uint64>))
    let available : uint64 = uint64(runtime.numStackSlots) * uint64(typeinfo sizeof(type<uint>))
    if (needed > available) {
        return m3Err_trapStackOverflow
    }
    var stack : uint64? = reinterpret<uint64?>(runtime.stack)
    stack += int(ftype.numRets)
    *o_stack = reinterpret<uint8?>(stack)
    return m3Err_none
}

[unsafe_deref, hint(unsafe_range_check), variadic]
def m3_CallV(var i_function : M3Function?; va : va_args) : uint8? {
    var ap : CVaCursor
    ap = va_begin(va)
    var r : uint8? = m3_CallVL(i_function, ap)
    return r
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__ReportNativeStackUsage {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_CallVL(var i_function : M3Function?; var i_args : CVaCursor) : uint8? {
    var runtime : M3Runtime? = i_function._c_module.runtime
    var ftype : M3FuncType? = i_function.funcType
    var result : uint8? = m3Err_none
    var s : uint8? = null
    if (i_function.compiled == null) {
        return m3Err_missingCompiledCode
    }
    result = all_host__checkStartFunction(i_function._c_module)
    if (result != null) {
        goto label 1
    }
    result = all_host__GetStackPointerForArgs(i_function, addr(s))
    if (result != null) {
        goto label 1
    }
    {
        var i : uint = 0u
        while (i < uint(ftype.numArgs)) {
            c_switch(int(d_FuncArgType(ftype, i))) {
                case(1) {
                    *reinterpret<int?>(s) = int(va_i(i_args))
                    s += 8
                    break
                }
                case(2) {
                    *reinterpret<int64?>(s) = va_i(i_args)
                    s += 8
                    break
                }
                case(6, 7, 8) {
                    *reinterpret<uint64?>(s) = uint64(va_i(i_args))
                    s += 8
                    break
                }
                case(_) {
                    // f32 is passed as f64
                    return cstr("unknown argument type")
                }
            }
            i++
        }
    }
    result = all_host__RunCodeChecked(runtime, i_function)
    all_host__ReportNativeStackUsage()
    runtime.lastCalled = result != null ? default<M3Function?> : i_function
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_Call(var i_function : M3Function?; i_argc : uint; var i_argptrs : void ??) : uint8? {
    var runtime : M3Runtime? = i_function._c_module.runtime
    var ftype : M3FuncType? = i_function.funcType
    var result : uint8? = m3Err_none
    var s : uint8? = null
    if (i_argc != uint(ftype.numArgs)) {
        return m3Err_argumentCountMismatch
    }
    if (i_function.compiled == null) {
        return m3Err_missingCompiledCode
    }
    result = all_host__checkStartFunction(i_function._c_module)
    if (result != null) {
        goto label 1
    }
    result = all_host__GetStackPointerForArgs(i_function, addr(s))
    if (result != null) {
        goto label 1
    }
    {
        var i : uint = 0u
        while (i < uint(ftype.numArgs)) {
            c_switch(int(d_FuncArgType(ftype, i))) {
                case(1) {
                    *reinterpret<int?>(s) = *reinterpret<int?>(i_argptrs[i])
                    s += 8
                    break
                }
                case(2) {
                    *reinterpret<int64?>(s) = *reinterpret<int64?>(i_argptrs[i])
                    s += 8
                    break
                }
                case(6, 7, 8) {
                    *reinterpret<uint64?>(s) = *reinterpret<uint64?>(i_argptrs[i])
                    s += 8
                    break
                }
                case(_) {
                    return cstr("unknown argument type")
                }
            }
            i++
        }
    }
    result = all_host__RunCodeChecked(runtime, i_function)
    all_host__ReportNativeStackUsage()
    runtime.lastCalled = result != null ? default<M3Function?> : i_function
    label 1:  // _catch
    return result
}

// Argument parsing for m3_CallArgv. Strict on purpose: the whole string has to
// be consumed, so "12abc" is rejected rather than read as 12, and an empty or
// unparsable argument is an error rather than the zero that strtoul with a
// NULL end pointer used to hand back. See wasm3/wasm3#367.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__ParseArgInteger(var i_arg : uint8?; i_numBits : uint; var o_value : uint64?) : uint8? {
    if (i_arg == null || *i_arg == 0) {
        return cstr("empty argument")
    }
    // strtoull would skip leading space, but trailing space is rejected below;
    // accepting one and not the other would just be confusing
    if (crt::isspace(int(*i_arg)) != 0) {
        return cstr("argument is not a number")
    }
    var end : uint8? = null
    var value : uint64
    *crt::c_errno_location() = 0
    // an argument may be spelled signed or unsigned: -1 and 4294967295 name the
    // same i32
    if (*i_arg == '-') {
        let signedValue : int64 = crt::strtoll(i_arg, addr(end), 10)
        if (i_numBits == 32u && (signedValue < int64(-2147483647 - 1) || signedValue > 2147483647l)) {
            return cstr("argument out of range")
        }
        value = uint64(signedValue)
    } else {
        value = crt::strtoull(i_arg, addr(end), 10)
        if (i_numBits == 32u && value > uint64(4294967295u)) {
            return cstr("argument out of range")
        }
    }
    if (*crt::c_errno_location() == 34) {
        return cstr("argument out of range")
    }
    if (intptr(end) == intptr(reinterpret<uint8?>(i_arg)) || *end != 0) {
        return cstr("argument is not a number")
    }
    *o_value = value
    return m3Err_none
}

// A reference argument is either the null reference or a host handle written as
// an integer.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__ParseArgReference(var i_arg : uint8?; var o_value : uint64?) : uint8? {
    if (i_arg != null && crt::strcmp(i_arg, cstr("null")) == 0) {
        *o_value = 0ul
        return m3Err_none
    }
    return all_host__ParseArgInteger(i_arg, 64u, o_value)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_CallArgv(var i_function : M3Function?; i_argc : uint; var i_argv : uint8 ??) : uint8? {
    var ftype : M3FuncType? = i_function.funcType
    var runtime : M3Runtime? = i_function._c_module.runtime
    var result : uint8? = m3Err_none
    var s : uint8? = null
    if (i_argc != uint(ftype.numArgs)) {
        return m3Err_argumentCountMismatch
    }
    if (i_function.compiled == null) {
        return m3Err_missingCompiledCode
    }
    result = all_host__checkStartFunction(i_function._c_module)
    if (result != null) {
        goto label 1
    }
    result = all_host__GetStackPointerForArgs(i_function, addr(s))
    if (result != null) {
        goto label 1
    }
    {
        var i : uint = 0u
        while (i < uint(ftype.numArgs)) {
            var value : uint64 = 0ul
            c_switch(int(d_FuncArgType(ftype, i))) {
                case(1) {
                    result = all_host__ParseArgInteger(i_argv[i], 32u, addr(value))
                    if (result != null) {
                        goto label 1
                    }
                    *reinterpret<int?>(s) = int(value)
                    s += 8
                    break
                }
                case(2) {
                    result = all_host__ParseArgInteger(i_argv[i], 64u, addr(value))
                    if (result != null) {
                        goto label 1
                    }
                    *reinterpret<int64?>(s) = int64(value)
                    s += 8
                    break
                }
                case(6, 7, 8) {
                    result = all_host__ParseArgReference(i_argv[i], addr(value))
                    if (result != null) {
                        goto label 1
                    }
                    *reinterpret<uint64?>(s) = value
                    s += 8
                    break
                }
                case(_) {
                    // strtof would be less portable
                    result = cstr("unknown argument type")
                    goto label 1
                }
            }
            i++
        }
    }
    result = all_host__RunCodeChecked(runtime, i_function)
    all_host__ReportNativeStackUsage()
    runtime.lastCalled = result != null ? default<M3Function?> : i_function
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetResults(var i_function : M3Function?; i_retc : uint; var o_retptrs : void ??) : uint8? {
    var ftype : M3FuncType? = i_function.funcType
    var runtime : M3Runtime? = i_function._c_module.runtime
    if (i_retc != uint(ftype.numRets)) {
        return m3Err_argumentCountMismatch
    }
    if (intptr(i_function) != intptr(runtime.lastCalled)) {
        return cstr("function not called")
    }
    var s : uint8? = reinterpret<uint8?>(runtime.stack)
    {
        var i : uint = 0u
        while (i < uint(ftype.numRets)) {
            c_switch(int(d_FuncRetType(ftype, i))) {
                case(1) {
                    *reinterpret<int?>(o_retptrs[i]) = *reinterpret<int?>(s)
                    s += 8
                    break
                }
                case(2) {
                    *reinterpret<int64?>(o_retptrs[i]) = *reinterpret<int64?>(s)
                    s += 8
                    break
                }
                case(6, 7, 8) {
                    *reinterpret<uint64?>(o_retptrs[i]) = *reinterpret<uint64?>(s)
                    s += 8
                    break
                }
                case(_) {
                    return cstr("unknown return type")
                }
            }
            i++
        }
    }
    return m3Err_none
}

[unsafe_deref, hint(unsafe_range_check), variadic]
def m3_GetResultsV(var i_function : M3Function?; va : va_args) : uint8? {
    var ap : CVaCursor
    ap = va_begin(va)
    var r : uint8? = m3_GetResultsVL(i_function, ap)
    return r
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetResultsVL(var i_function : M3Function?; var o_rets : CVaCursor) : uint8? {
    var runtime : M3Runtime? = i_function._c_module.runtime
    var ftype : M3FuncType? = i_function.funcType
    if (intptr(i_function) != intptr(runtime.lastCalled)) {
        return cstr("function not called")
    }
    var s : uint8? = reinterpret<uint8?>(runtime.stack)
    {
        var i : uint = 0u
        while (i < uint(ftype.numRets)) {
            c_switch(int(d_FuncRetType(ftype, i))) {
                case(1) {
                    *reinterpret<int?>(va_p(o_rets)) = *reinterpret<int?>(s)
                    s += 8
                    break
                }
                case(2) {
                    *reinterpret<int64?>(va_p(o_rets)) = *reinterpret<int64?>(s)
                    s += 8
                    break
                }
                case(6, 7, 8) {
                    *reinterpret<uint64?>(va_p(o_rets)) = *reinterpret<uint64?>(s)
                    s += 8
                    break
                }
                case(_) {
                    return cstr("unknown argument type")
                }
            }
            i++
        }
    }
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ReleaseCodePageNoTrack(var i_runtime : M3Runtime?; var i_codePage : M3CodePage?) {
    if (i_codePage != null) {
        var list : M3CodePage ??
        let pageFull : bool = NumFreeLines(i_codePage) < uint(d_m3CodePageFreeLinesThreshold)
        if (pageFull) {
            list = addr(i_runtime.pagesFull)
        } else {
            list = addr(i_runtime.pagesOpen)
        }
        PushCodePage(list, i_codePage)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AcquireCodePageWithCapacity(var i_runtime : M3Runtime?; i_minLineCount : uint) : M3CodePage? {
    var page : M3CodePage? = RemoveCodePageOfCapacity(addr(i_runtime.pagesOpen), i_minLineCount)
    if (page == null) {
        page = Environment_AcquireCodePage(i_runtime.environment, i_minLineCount)
        if (page == null) {
            page = NewCodePage(i_runtime, i_minLineCount)
        }
        if (page != null) {
            i_runtime.numCodePages++
        }
    }
    if (page != null) {
        i_runtime.numActiveCodePages++
    }
    return page
}

[unsafe_deref, hint(unsafe_range_check)]
def AcquireCodePage(var i_runtime : M3Runtime?) : M3CodePage? {
    return AcquireCodePageWithCapacity(i_runtime, uint(d_m3CodePageFreeLinesThreshold))
}

[unsafe_deref, hint(unsafe_range_check)]
def ReleaseCodePage(var i_runtime : M3Runtime?; var i_codePage : M3CodePage?) {
    if (i_codePage != null) {
        ReleaseCodePageNoTrack(i_runtime, i_codePage)
        i_runtime.numActiveCodePages--
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetErrorInfo(var i_runtime : M3Runtime?; var o_info : M3ErrorInfo?) {
    if (i_runtime != null) {
        *o_info = i_runtime.error
        m3_ResetErrorInfo(i_runtime)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_ResetErrorInfo(var i_runtime : M3Runtime?) {
    if (i_runtime != null) {
        crt::memset(reinterpret<void?>(addr(i_runtime.error)), 0, uint64(typeinfo sizeof(type<M3ErrorInfo>)))
        i_runtime.error.message = addr(c2das_empty[0])
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetMemory(var i_module : M3Module?; var o_memorySizeInBytes : uint64?; i_memoryIndex : uint) : uint8? {
    var memory : uint8? = null
    var size : uint64 = 0ul
    if (i_module != null && i_memoryIndex < i_module.numMemories) {
        var mem : M3Memory? = i_module.memories[i_memoryIndex]
        if (mem.mallocated != null) {
            size = mem.mallocated.length
            if (size != 0) {
                memory = reinterpret<uint8?>(mem.mallocated + 1)
            }
        }
    }
    if (o_memorySizeInBytes != null) {
        *o_memorySizeInBytes = size
    }
    return memory
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetMemorySize(var i_module : M3Module?; i_memoryIndex : uint) : uint64 {
    if (i_module == null || i_memoryIndex >= i_module.numMemories) {
        return 0ul
    }
    var mem : M3Memory? = i_module.memories[i_memoryIndex]
    return mem.mallocated != null ? mem.mallocated.length : 0ul
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetMemorySizeAt(var i_memory : void?) : uint64 {
    if (i_memory == null) {
        return 0ul
    }
    // the header sits immediately before the data it describes
    var header : M3MemoryHeader? = reinterpret<M3MemoryHeader?>(i_memory) + -(1)
    return header.length
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_FindExportedMemory(var i_module : M3Module?; var i_name : uint8?; var o_memoryIndex : uint?) : uint8? {
    if (i_module == null || i_name == null || o_memoryIndex == null) {
        return m3Err_unknownMemory
    }
    {
        var i : uint = 0u
        while (i < i_module.numMemories) {
            var memory : M3Memory? = i_module.memories[i]
            if (memory.exportName != null && crt::strcmp(memory.exportName, i_name) == 0) {
                *o_memoryIndex = i
                return m3Err_none
            }
            i++
        }
    }
    return m3Err_unknownMemory
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Module_HasLinkedHostImport(var i_module : M3Module?; var i_importModule : uint8?) : bool {
    for (i in urange(i_module.numFunctions)) {
        var f : M3Function? = addr(i_module.functions[i])
        // hostMemory is set when a host function is bound to the import, so it
        // is also the mark of one - see CompileRawFunction
        if (f.hostMemory == null || f.wasm != null || f.resolved != null) {
            continue
        }
        if (f.import.moduleUtf8 != null && crt::strcmp(f.import.moduleUtf8, i_importModule) == 0) {
            return 1 != 0
        }
    }
    return 0 != 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_BindImportMemory(var io_module : M3Module?; var i_importModule : uint8?; i_memoryIndex : uint) : uint8? {
    if (io_module == null || i_importModule == null) {
        return m3Err_moduleNotLinked
    }
    if (i_memoryIndex >= io_module.numMemories) {
        return m3Err_unknownMemory
    }
    // the memory itself, not the index: linking may have pointed this slot at
    // another module's memory, and growing one reallocates behind it
    var memory : M3Memory? = io_module.memories[i_memoryIndex]
    let wildcardModule : bool = crt::strcmp(i_importModule, cstr("*")) == 0
    {
        var i : uint = 0u
        while (i < io_module.numFunctions) {
            {
                var f : M3Function? = addr(io_module.functions[i])
                // only an import that a host function was bound to has a memory to
                // pin: one with a body of its own reads memory through the interpreter,
                // and one resolved to another module's export runs that module's code
                if (f.hostMemory == null || f.wasm != null || f.resolved != null) {
                    continue
                }
                if (wildcardModule || (f.import.moduleUtf8 != null && crt::strcmp(f.import.moduleUtf8, i_importModule) == 0)) {
                    f.hostMemory = memory
                }
            } finally {
                i++
            }
        }
    }
    return m3Err_none
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetBacktrace(var i_runtime : M3Runtime?) : M3BacktraceInfo? {
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AllocFuncType(var o_functionType : M3FuncType ??; i_numTypes : uint) : uint8? {
    *o_functionType = reinterpret<M3FuncType?>(m3_Malloc_Impl(uint64(typeinfo sizeof(type<M3FuncType>)) + uint64(i_numTypes) *
            uint64(typeinfo sizeof(type<uint8>))))
    return (*o_functionType) != null ? m3Err_none : m3Err_mallocFailed
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def AreFuncTypesEqual(var i_typeA : M3FuncType?; var i_typeB : M3FuncType?) : bool {
    if (i_typeA.numRets == i_typeB.numRets && i_typeA.numArgs == i_typeB.numArgs) {
        return crt::memcmp(reinterpret<void?>(reinterpret<uint8?>(reinterpret<uint8?>(i_typeA) + 14)),
                reinterpret<void?>(reinterpret<uint8?>(reinterpret<uint8?>(i_typeB) + 14)),
                uint64(int(i_typeA.numRets) + int(i_typeA.numArgs)) * uint64(typeinfo sizeof(type<uint8>))) == 0
    }
    return 0 != 0
}

[unsafe_deref, hint(unsafe_range_check)]
def GetFuncTypeNumParams(var i_funcType : M3FuncType?) : uint16 {
    return uint16(i_funcType != null ? int(i_funcType.numArgs) : 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetFuncTypeParamType(var i_funcType : M3FuncType?; i_index : uint16) : uint8 {
    var _c_type : uint8 = uint8(M3ValueType.c_m3Type_unknown)
    if (i_funcType != null) {
        if (int(i_index) < int(i_funcType.numArgs)) {
            _c_type = reinterpret<uint8?>(reinterpret<uint8?>(i_funcType) + 14)[int(i_funcType.numRets) + int(i_index)]
        }
    }
    return _c_type
}

[unsafe_deref, hint(unsafe_range_check)]
def GetFuncTypeNumResults(var i_funcType : M3FuncType?) : uint16 {
    return uint16(i_funcType != null ? int(i_funcType.numRets) : 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetFuncTypeResultType(var i_funcType : M3FuncType?; i_index : uint16) : uint8 {
    var _c_type : uint8 = uint8(M3ValueType.c_m3Type_unknown)
    if (i_funcType != null) {
        if (int(i_index) < int(i_funcType.numRets)) {
            _c_type = reinterpret<uint8?>(reinterpret<uint8?>(i_funcType) + 14)[int(i_index)]
        }
    }
    return _c_type
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def FreeImportInfo(var i_info : M3ImportInfo?) {
    {
        m3_Free_Impl(reinterpret<void?>(i_info.moduleUtf8))
        i_info.moduleUtf8 = null
    }
    {
        m3_Free_Impl(reinterpret<void?>(i_info.fieldUtf8))
        i_info.fieldUtf8 = null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Function_Release(var i_function : M3Function?) {
    {
        m3_Free_Impl(i_function.constants)
        i_function.constants = null
    }
    {
        var i : int = 0
        while (i < int(i_function.numNames)) {
            // name can be an alias of fieldUtf8
            if (intptr(i_function.names[i]) != intptr(i_function.import.fieldUtf8)) {
                {
                    m3_Free_Impl(reinterpret<void?>(i_function.names[i]))
                    i_function.names[i] = null
                }
            }
            i++
        }
    }
    FreeImportInfo(addr(i_function.import))
    if (i_function.ownsWasmCode) {
        {
            m3_Free_Impl(reinterpret<void?>(i_function.wasm))
            i_function.wasm = null
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def Function_FreeCompiledCode(var i_function : M3Function?) {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_GetFunctionName(var i_function : M3Function?) : uint8? {
    var numNames : uint16 = uint16(0)
    var names : uint8 ?? = GetFunctionNames(i_function, addr(numNames))
    if (int(numNames) > 0) {
        return names[0]
    } else {
        return cstr("<unnamed>")
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetFunctionModule(var i_function : M3Function?) : M3Module? {
    return i_function != null ? i_function._c_module : null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetFunctionNames(var i_function : M3Function?; var o_numNames : uint16?) : uint8 ?? {
    if (i_function == null || o_numNames == null) {
        return null
    }
    if (i_function.import.fieldUtf8 != null) {
        *o_numNames = uint16(1)
        return addr(i_function.import.fieldUtf8)
    } else {
        *o_numNames = i_function.numNames
        return addr(i_function.names[0])
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetFunctionImportModuleName(var i_function : M3Function?) : uint8? {
    return i_function.import.moduleUtf8 != null ? i_function.import.moduleUtf8 : reinterpret<uint8?>(addr(c2das_empty[0]))
}

[unsafe_deref, hint(unsafe_range_check)]
def GetFunctionNumArgs(var i_function : M3Function?) : uint16 {
    var numArgs : uint16 = uint16(0)
    if (i_function != null) {
        if (i_function.funcType != null) {
            numArgs = i_function.funcType.numArgs
        }
    }
    return numArgs
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def GetFunctionArgType(var i_function : M3Function?; i_index : uint) : uint8 {
    var _c_type : uint8 = uint8(M3ValueType.c_m3Type_none)
    if (i_index < uint(GetFunctionNumArgs(i_function))) {
        let numReturns : uint = uint(i_function.funcType.numRets)
        _c_type = reinterpret<uint8?>(reinterpret<uint8?>(i_function.funcType) + 14)[numReturns + i_index]
    }
    return _c_type
}

[unsafe_deref, hint(unsafe_range_check)]
def GetFunctionNumReturns(var i_function : M3Function?) : uint16 {
    var numReturns : uint16 = uint16(0)
    if (i_function != null) {
        if (i_function.funcType != null) {
            numReturns = i_function.funcType.numRets
        }
    }
    return numReturns
}

[unsafe_deref, hint(unsafe_range_check)]
def GetFunctionReturnType(var i_function : M3Function?; i_index : uint16) : uint8 {
    return uint8(i_function != null ? int(GetFuncTypeResultType(i_function.funcType, i_index)) : int(M3ValueType.c_m3Type_unknown))
}

[unsafe_deref, hint(unsafe_range_check)]
def GetFunctionNumArgsAndLocals(var i_function : M3Function?) : uint {
    if (i_function != null) {
        return uint(int(i_function.numLocals) + int(GetFunctionNumArgs(i_function)))
    } else {
        return 0u
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_PrintProfilerInfo {
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Module_FreeFunctions(var i_module : M3Module?) {
    {
        var i : uint = 0u
        while (i < i_module.numFunctions) {
            var func : M3Function? = addr(i_module.functions[i])
            Function_Release(func)
            i++
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_FreeModule(var i_module : M3Module?) {
    if (i_module != null) {
        Module_FreeFunctions(i_module)
        {
            m3_Free_Impl(reinterpret<void?>(i_module.functions))
            i_module.functions = null
        }
        // m3_Free (i_module->imports);
        {
            m3_Free_Impl(reinterpret<void?>(i_module.funcTypes))
            i_module.funcTypes = null
        }
        {
            m3_Free_Impl(reinterpret<void?>(i_module.dataSegments))
            i_module.dataSegments = null
        }
        {
            var i : uint = 0u
            while (i < i_module.numTables) {
                {
                    var _c_table : M3Table? = i_module.tables[i]
                    // a slot may point at a table another module owns; that module
                    // frees it
                    if (_c_table == null || intptr(_c_table.owner) != intptr(i_module)) {
                        continue
                    }
                    {
                        m3_Free_Impl(reinterpret<void?>(_c_table.elements))
                        _c_table.elements = null
                    }
                    {
                        m3_Free_Impl(reinterpret<void?>(_c_table.exportName))
                        _c_table.exportName = null
                    }
                    FreeImportInfo(addr(_c_table.import))
                    m3_Free(_c_table)
                } finally {
                    i++
                }
            }
        }
        {
            m3_Free_Impl(reinterpret<void?>(i_module.tables))
            i_module.tables = null
        }
        {
            var i : uint = 0u
            while (i < i_module.numElementSegments) {
                {
                    m3_Free_Impl(reinterpret<void?>(i_module.elementSegments[i].resolved))
                    i_module.elementSegments[i].resolved = null
                }
                i++
            }
        }
        {
            m3_Free_Impl(reinterpret<void?>(i_module.elementSegments))
            i_module.elementSegments = null
        }
        {
            m3_Free_Impl(reinterpret<void?>(i_module.declaredFuncs))
            i_module.declaredFuncs = null
        }
        {
            var i : uint = 0u
            while (i < i_module.numGlobals) {
                {
                    m3_Free_Impl(reinterpret<void?>(i_module.globals[i].name))
                    i_module.globals[i].name = null
                }
                FreeImportInfo(addr(i_module.globals[i].import))
                i++
            }
        }
        {
            m3_Free_Impl(reinterpret<void?>(i_module.globals))
            i_module.globals = null
        }
        {
            var i : uint = 0u
            while (i < i_module.numTags) {
                {
                    m3_Free_Impl(reinterpret<void?>(i_module.tags[i].name))
                    i_module.tags[i].name = null
                }
                FreeImportInfo(addr(i_module.tags[i].import))
                i++
            }
        }
        {
            m3_Free_Impl(reinterpret<void?>(i_module.tags))
            i_module.tags = null
        }
        {
            var i : uint = 0u
            while (i < i_module.numMemories) {
                {
                    var memory : M3Memory? = i_module.memories[i]
                    // a slot may point at a memory another module owns; that module
                    // frees it
                    if (memory == null || intptr(memory.owner) != intptr(i_module)) {
                        continue
                    }
                    FreeMemoryBlock(memory)
                    {
                        m3_Free_Impl(reinterpret<void?>(memory.exportName))
                        memory.exportName = null
                    }
                    FreeImportInfo(addr(memory.import))
                    m3_Free(memory)
