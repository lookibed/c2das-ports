    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ParseSection_Name(var io_module : M3Module?; var i_bytes : uint8?; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    var name : uint8? = null
    while (intptr(i_bytes) < intptr(i_end)) {
        var nameType : uint8
        var payloadLength : uint
        result = ReadLEB_u7(addr(nameType), addr(i_bytes), i_end)
        if (result != null) {
            goto label 1
        }
        result = ReadLEB_u32(addr(payloadLength), addr(i_bytes), i_end)
        if (result != null) {
            goto label 1
        }
        var start : uint8? = i_bytes
        if (uint64(payloadLength) > uint64(int64(i_end - start))) {
            result = m3Err_wasmSectionOverrun
            goto label 1
        }
        if (nameType == 1) {
            var numNames : uint
            result = ReadLEB_u32(addr(numNames), addr(i_bytes), i_end)
            if (result != null) {
                goto label 1
            }
            if (numNames > uint(d_m3MaxSaneFunctionsCount)) {
                result = cstr("too many names")
                goto label 1
            }
            for (i in urange(numNames)) {
                var index : uint
                result = ReadLEB_u32(addr(index), addr(i_bytes), i_end)
                if (result != null) {
                    goto label 1
                }
                result = Read_utf8(addr(name), addr(i_bytes), i_end)
                if (result != null) {
                    goto label 1
                }
                if (index < io_module.numFunctions) {
                    var func : M3Function? = addr(io_module.functions[index])
                    if (func.numNames == 0) {
                        func.names[0] = name
                        func.numNames = uint16(1)
                        // transfer ownership
                        name = null
                    }
                }
