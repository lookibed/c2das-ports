// m3_core.h:374: #define m3_Free(P) do { m3_Free_Impl ((void*)(P)); (P) = NULL; } while(0)
[c_macro, c_function, unsafe_deref, hint(unsafe_range_check)]
def private m3_Free(var P : auto&) {
    m3_Free_Impl(reinterpret<void?>(P))
    P = null
}

