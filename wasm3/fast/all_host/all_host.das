    *io_bytes = o.wasm
    return result
}

// Whether an exporting memory or table satisfies what an import asks for. The
// exporter's *current* size is its minimum - one that has been grown satisfies
// a larger import than its declaration would - and it may be no less bounded.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__LimitsSatisfy(i_exportedSize : uint64; i_exportedHasMax : bool; i_exportedMax : uint64; i_importMin : uint64; i_importHasMax : bool;
                                    i_importMax : uint64) : bool {
    if (i_exportedSize < i_importMin) {
        return 0 != 0
    }
    if (i_importHasMax && (!i_exportedHasMax || i_exportedMax > i_importMax)) {
        return 0 != 0
    }
    return 1 != 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__Module_FindExportedFunction(var i_module : M3Module?; var i_name : uint8?) : M3Function? {
    for (i in urange(i_module.numFunctions)) {
        var f : M3Function? = addr(i_module.functions[i])
        if (f.export_name != null && crt::strcmp(f.export_name, i_name) == 0) {
            // A module that re-exports an import names the placeholder here.
            // Resolve to the function that actually runs, or a host-side call
            // would run it against the importing module's memory.
            return all_host__Function_Implementation(f)
        }
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__Module_FindExportedMemory(var i_module : M3Module?; var i_name : uint8?) : M3Memory? {
    for (i in urange(i_module.numMemories)) {
        var memory : M3Memory? = i_module.memories[i]
        if (memory.exportName != null && crt::strcmp(memory.exportName, i_name) == 0) {
            return memory
        }
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__Module_FindExportedTable(var i_module : M3Module?; var i_name : uint8?) : M3Table? {
