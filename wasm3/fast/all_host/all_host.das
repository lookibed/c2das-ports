// Replaces the 64-bit address operand of a load or store with the checked
// 32-bit effective address op_CheckAddr64 leaves behind, so that the access
// itself compiles exactly as it would against a 32-bit memory: one slot to read
// the address from, and an offset of zero folded in already.
// For a store the address sits under the value, so it is rewritten where it
// stands rather than popped - its stack entry is repointed at the scratch slot
// and retyped, and the slot it used to occupy released.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__EmitCheckAddr64(var o : M3Compilation?; i_offset : uint64; i_isStore : bool) : uint8? {
    var result : uint8? = m3Err_none
    let numOperands : uint16 = uint16(i_isStore ? 2 : 1)
    // The address has to be in a slot for op_CheckAddr64 to read it. Spilling
    // r0 wholesale also keeps the value of a store out of it, which is what
    // leaves the address as the one operand still in a register to worry about.
    result = all_host__PreserveRegisterIfOccupied(o, uint8(M3ValueType.c_m3Type_i64))
    if (result != null) {
        goto label 1
    }
    // unreachable code: the operands the instruction names may not be there
    if (int(o.stackIndex) < int(o._c_block.blockStackIndex) + int(numOperands)) {
        return result
    }
    {
        let stackIndex : uint16 = uint16(int(o.stackIndex) - int(numOperands))
        let srcSlot : uint16 = o.wasmStack[int(stackIndex)]
        let srcType : uint8 = o.typeStack[int(stackIndex)]
        var dstSlot : uint16 = all_host__c_slotUnused
        // Checked here rather than left to the validator, which a build may
        // have switched off: reading a slot as an i64 that only holds an i32
        // would reach past what was allocated for it.
        if (int(all_host__BaseTypeOf(srcType)) != int(M3ValueType.c_m3Type_i64)) {
            result = m3Err_typeMismatch
            goto label 1
        }
        // an address is an integer, so nothing should be left in a register
        // once r0 has been preserved
        if (all_host__IsRegisterSlotAlias(srcSlot)) {
            result = m3Err_typeMismatch
            goto label 1
        }
        if (int(srcSlot) >= int(o.slotMaxAllocatedIndexPlusOne)) {
            result = m3Err_functionStackUnderrun
            goto label 1
        }
        // allocated before the source is released, so the two cannot be the
        // same slot - op_CheckAddr64 reads one and writes the other
        result = all_host__AllocateSlots(o, addr(dstSlot), uint8(M3ValueType.c_m3Type_i32))
        if (result != null) {
            goto label 1
        }
        result = all_host__EmitOp(o, @@all_host__op_CheckAddr64)
        if (result != null) {
            goto label 1
        }
        all_host__EmitSlotOffset(o, int(srcSlot))
        all_host__EmitSlotOffset(o, int(dstSlot))
        all_host__EmitConstant64(o, i_offset)
        o.wasmStack[int(stackIndex)] = dstSlot
        o.typeStack[int(stackIndex)] = uint8(M3ValueType.c_m3Type_i32)
        // locals and the constant table outlive the instruction; a dynamic
        // slot the address was computed into does not
        if (int(srcSlot) >= int(o.slotFirstDynamicIndex)) {
            all_host__DeallocateSlot(o, int16(srcSlot), srcType)
        }
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__Compile_Load_Store(var o : M3Compilation?; i_opcode : uint16) : uint8? {
    var result : uint8? = m3Err_none
    {
        var alignHint : uint
        var memoryIdx : uint
        var memoryOffset : uint64
        // alignHint is checked by the validator
        result = ReadMemoryArg(addr(alignHint), addr(memoryIdx), addr(memoryOffset), addr(o.wasm), o.wasmEnd)
        if (result != null) {
            goto label 1
        }
        if (memoryIdx >= o._c_module.numMemories) {
            result = m3Err_unknownMemory
            goto label 1
        }
        var opInfo : M3OpInfo? = GetOpInfo(i_opcode)
        if (opInfo == null) {
            result = m3Err_unknownOpcode
            goto label 1
        }
        let isMemory64 : bool = o._c_module.memories[memoryIdx].isMemory64
        // Spec: the static offset has to be in range of the address type. Checked
        // here as well as in the validator, so that a build without one still
        // refuses the module rather than silently truncating the offset.
        if (!isMemory64 && memoryOffset > 4294967295ul) {
            result = m3Err_wasmMalformed
            goto label 1
        }
        if (IsFpType(opInfo._c_type)) {
            result = all_host__PreserveRegisterIfOccupied(o, uint8(M3ValueType.c_m3Type_f64))
            if (result != null) {
                goto label 1
            }
        }
        if (memoryIdx != 0) {
            result = all_host__EmitSetMemory(o, memoryIdx)
            if (result != null) {
                goto label 1
            }
        }
        if (isMemory64) {
            // An offset this far out puts every address out of bounds, so rather
            // than carrying it, clamp it to the limit: op_CheckAddr64 then traps
            // on whatever address it is given, which is the outcome either way.
            if (memoryOffset > d_m3AddressLimit) {
                memoryOffset = d_m3AddressLimit
