// OPTZ: currently all stack slot indices take up a full word, but
// dual stack source operands could be packed together
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__Compile_Operator(var o : M3Compilation?; i_opcode : uint16) : uint8? {
    var result : uint8?
    // Declared before the first throw below, which jumps past this point to
    // _catch and so must not skip an initialization.
    var op : function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?> = default<function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>>
    var opInfo : M3OpInfo? = GetOpInfo(i_opcode)
    if (opInfo == null) {
        result = m3Err_unknownOpcode
        goto label 1
    }
    // Spec: validate operand types for load/store operations
    if (!all_host__IsStackPolymorphic(o)) {
        // For load ops (stackOffset == 0, unary), the operand is always i32 (address)
        if (int(i_opcode) >= 40 && int(i_opcode) <= 53) {
            let topType : uint8 = all_host__GetStackTopType(o)
            if (int(topType) != int(M3ValueType.c_m3Type_none) && int(topType) != int(M3ValueType.c_m3Type_i32)) {
                result = m3Err_typeMismatch
                goto label 1
            }
        }
        // For store ops (stackOffset == -2), the address operand must be i32
        if (int(i_opcode) >= 54 && int(i_opcode) <= 62) {
            let addrType : uint8 = all_host__GetStackTypeFromTop(o, uint16(1))
            if (int(addrType) != int(M3ValueType.c_m3Type_none) && int(addrType) != int(M3ValueType.c_m3Type_i32)) {
                result = m3Err_typeMismatch
                goto label 1
            }
        }
    }
    // This preserve is for for FP compare operations.
    // either need additional slot destination operations or the
    // easy fix, move _r0 out of the way.
    // moving out the way might be the optimal solution most often?
    // otherwise, the _r0 reg can get buried down in the stack
    // and be idle & wasted for a moment.
    if (IsFpType(all_host__GetStackTopType(o)) && IsIntType(opInfo._c_type)) {
        result = all_host__PreserveRegisterIfOccupied(o, opInfo._c_type)
        if (result != null) {
            goto label 1
        }
    }
    if (opInfo.stackOffset == 0) {
        if (all_host__IsStackTopInRegister(o)) {
