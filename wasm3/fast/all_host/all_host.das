            // ownership transferred to M3Global
            utf8 = null
        } elif (int(exportKind) == d_externalKind_memory) {
            if (index >= io_module.numMemories) {
                result = m3Err_wasmMalformed
                goto label 1
            }
            var memory : M3Memory? = io_module.memories[index]
            while (true) {
                m3_Free_Impl(reinterpret<void?>(memory.exportName))
