                while (true) {
                    m3_Free_Impl(reinterpret<void?>(name))
                    name = null
                    break
                }
            }
        }
        i_bytes = start + payloadLength
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ParseSection_Custom(var io_module : M3Module?; var i_bytes : uint8?; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    var name : uint8? = null
    result = Read_utf8(addr(name), addr(i_bytes), i_end)
    if (result != null) {
