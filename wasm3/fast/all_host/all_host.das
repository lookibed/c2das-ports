[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetPC(var o : M3Compilation?) : void ?? {
    return GetPagePC(o.page)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__EnsureCodePageNumLines(var o : M3Compilation?; var i_numLines : uint) : uint8? {
    var result : uint8? = m3Err_none
    // room for Bridge
    i_numLines += 2u
    if (NumFreeLines(o.page) < i_numLines) {
        var page : M3CodePage? = AcquireCodePageWithCapacity(o.runtime, i_numLines)
        if (page != null) {
            EmitWord_impl(o.page, reinterpret<void?>(@@all_host__op_Branch))
            EmitWord_impl(o.page, reinterpret<void?>(GetPagePC(page)))
            ReleaseCodePage(o.runtime, o.page)
            o.page = page
        } else {
            result = m3Err_mallocFailedCodePage
        }
    }
    return result
}

// invalidate the pending local.set fold candidate; called wherever code is emitted or a
// branch target captures the current pc (a fold appends an immediate, moving that position)
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__InvalidateFold(var o : M3Compilation?) {
    o.foldPatchPC = null
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__EmitOp(var o : M3Compilation?;
                             i_operation : function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>) : uint8? {
    var result : uint8? = m3Err_none
    all_host__InvalidateFold(o)
    // it's OK for page to be null; when compile-walking the bytecode without emitting
    if (o.page != null) {
        // have execution jump to a new page if slots are critically low
        result = all_host__EnsureCodePageNumLines(o, uint(d_m3CodePageFreeLinesThreshold))
        if (result == null) {
            if (d_m3LogEmit != 0) {
            }
            // d_m3RecordBacktraces
            EmitWord(o.page, i_operation)
        }
    }
    return result
}

// Push an immediate constant into the M3 codestream
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__EmitConstant32(var o : M3Compilation?; i_immediate : uint) {
    if (o.page != null) {
        EmitWord32(o.page, i_immediate)
    }
}

// Takes two lines of the code page where a pointer is 32 bits, so whatever
// reads it back has to step _pc by the same amount - see op_Const64.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__EmitConstant64(var o : M3Compilation?; i_immediate : uint64) {
    if (o.page != null) {
        EmitWord64(o.page, i_immediate)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__EmitSlotOffset(var o : M3Compilation?; i_offset : int) {
    if (o.page != null) {
        EmitWord32(o.page, uint(i_offset))
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__EmitPointer(var o : M3Compilation?; var i_pointer : void?) : void ?? {
    var ptr : void ?? = GetPagePC(o.page)
    if (o.page != null) {
        EmitWord_impl(o.page, i_pointer)
    }
    return ptr
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__ReservePointer(var o : M3Compilation?) : void? {
    var ptr : void ?? = GetPagePC(o.page)
    all_host__EmitPointer(o, null)
    return reinterpret<void?>(ptr)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetFoldOp(i_opcode : uint16; i_form : uint8) : function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?> {
    if (int(i_form) >= 4) {
        return default<function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>>
    }
    c_switch(int(i_opcode)) {
        case(106) {
            // i32.add
            return all_host__c_fold_i32_Add[int(i_form)]
        }
        case(107) {
            // i32.sub
            return all_host__c_fold_i32_Subtract[int(i_form)]
        }
        case(108) {
            // i32.mul
            return all_host__c_fold_i32_Multiply[int(i_form)]
        }
        case(113) {
            // i32.and
            return all_host__c_fold_u32_And[int(i_form)]
        }
        case(114) {
            // i32.or
            return all_host__c_fold_u32_Or[int(i_form)]
        }
        case(115) {
            // i32.xor
            return all_host__c_fold_u32_Xor[int(i_form)]
        }
        case(116) {
            // i32.shl
            return all_host__c_fold_u32_ShiftLeft[int(i_form)]
        }
        case(117) {
            // i32.shr_s
            return all_host__c_fold_i32_ShiftRight[int(i_form)]
        }
        case(118) {
            // i32.shr_u
            return all_host__c_fold_u32_ShiftRight[int(i_form)]
        }
        case(124) {
            // i64.add
            return all_host__c_fold_i64_Add[int(i_form)]
        }
        case(125) {
            // i64.sub
            return all_host__c_fold_i64_Subtract[int(i_form)]
        }
        case(126) {
            // i64.mul
            return all_host__c_fold_i64_Multiply[int(i_form)]
        }
        case(131) {
            // i64.and
            return all_host__c_fold_u64_And[int(i_form)]
        }
        case(132) {
            // i64.or
            return all_host__c_fold_u64_Or[int(i_form)]
        }
        case(133) {
            // i64.xor
            return all_host__c_fold_u64_Xor[int(i_form)]
        }
        case(134) {
            // i64.shl
            return all_host__c_fold_u64_ShiftLeft[int(i_form)]
        }
        case(135) {
            // i64.shr_s
            return all_host__c_fold_i64_ShiftRight[int(i_form)]
        }
        case(136) {
            // i64.shr_u
            return all_host__c_fold_u64_ShiftRight[int(i_form)]
        }
        case(40) {
            // f32.add
            // f32.sub
            // f32.mul
            // f32.div
            // f64.add
            // f64.sub
            // f64.mul
            // f64.div
            // i32.load
            return all_host__c_fold_i32_Load_i32[int(i_form)]
        }
        case(44) {
            // i32.load8_s
            return all_host__c_fold_i32_Load_i8[int(i_form)]
        }
        case(45) {
            // i32.load8_u
            return all_host__c_fold_i32_Load_u8[int(i_form)]
        }
        case(46) {
            // i32.load16_s
            return all_host__c_fold_i32_Load_i16[int(i_form)]
        }
        case(47) {
            // i32.load16_u
            return all_host__c_fold_i32_Load_u16[int(i_form)]
        }
        case(41) {
            // i64.load
            return all_host__c_fold_i64_Load_i64[int(i_form)]
        }
        case(48) {
            // i64.load8_s
            return all_host__c_fold_i64_Load_i8[int(i_form)]
        }
        case(49) {
            // i64.load8_u
            return all_host__c_fold_i64_Load_u8[int(i_form)]
        }
        case(50) {
            // i64.load16_s
            return all_host__c_fold_i64_Load_i16[int(i_form)]
        }
        case(51) {
            // i64.load16_u
            return all_host__c_fold_i64_Load_u16[int(i_form)]
        }
        case(52) {
            // i64.load32_s
            return all_host__c_fold_i64_Load_i32[int(i_form)]
        }
        case(53) {
            // i64.load32_u
            return all_host__c_fold_i64_Load_u32[int(i_form)]
        }
        case(_) {
            // f32.load
            // f64.load
            return default<function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>>
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetFusedCmpOps(i_opcode : uint16) : M3FusedCmpOps? {
    c_switch(int(i_opcode)) {
        case(69) {
            // i32.eqz
            return addr(all_host__c_fuse_i32_Eqz)
        }
        case(70) {
            // i32.eq
            return addr(all_host__c_fuse_i32_Equal)
        }
        case(71) {
            // i32.ne
            return addr(all_host__c_fuse_i32_NotEqual)
        }
        case(72) {
            // i32.lt_s
            return addr(all_host__c_fuse_i32_LessThan)
        }
        case(73) {
            // i32.lt_u
            return addr(all_host__c_fuse_u32_LessThan)
        }
        case(74) {
            // i32.gt_s
            return addr(all_host__c_fuse_i32_GreaterThan)
        }
        case(75) {
            // i32.gt_u
            return addr(all_host__c_fuse_u32_GreaterThan)
        }
        case(76) {
            // i32.le_s
            return addr(all_host__c_fuse_i32_LessThanOrEqual)
        }
        case(77) {
            // i32.le_u
            return addr(all_host__c_fuse_u32_LessThanOrEqual)
        }
        case(78) {
            // i32.ge_s
            return addr(all_host__c_fuse_i32_GreaterThanOrEqual)
        }
        case(79) {
            // i32.ge_u
            return addr(all_host__c_fuse_u32_GreaterThanOrEqual)
        }
        case(_) {
            return null
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__AcquireCompilationCodePage(var o : M3Compilation?; var o_codePage : M3CodePage ??) : uint8? {
    var result : uint8? = m3Err_none
    var page : M3CodePage? = AcquireCodePage(o.runtime)
    if (page != null) {
    } else {
        result = m3Err_mallocFailedCodePage
        goto label 1
    }
    label 1:  // _catch
    *o_codePage = page
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__ReleaseCompilationCodePage(var o : M3Compilation?) {
    ReleaseCodePage(o.runtime, o.page)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetTypeNumSlots(var i_type : uint8) : uint16 {
    i_type = all_host__BaseTypeOf(i_type)
    // v128 is 16 bytes - 4 slots in 32-bit-slot mode, 2 in 64-bit.
    // (Slot-allocator only; no v128 ops execute.)
    if (int(i_type) == int(M3ValueType.c_m3Type_v128)) {
        return uint16(4)
    }
    return uint16(Is64BitType(i_type) ? 2 : 1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__AlignSlotToType(var io_slot : uint16?; i_type : uint8) {
    // align 64-bit words to even slots (if d_m3Use32BitSlots)
    let numSlots : uint16 = all_host__GetTypeNumSlots(i_type)
    let mask : uint16 = uint16(int(numSlots) - 1)
    *io_slot = uint16((int(*io_slot) + int(mask)) & ~int(mask))
}

// Deliberately unchecked. Validation rejects an empty operand stack before compilation.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetStackTopIndex(var o : M3Compilation?) : int16 {
    return int16(int(o.stackIndex) - 1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetStackTopIndexThrows(var o : M3Compilation?; var o_stackIndex : int16?) : uint8? {
    *o_stackIndex = int16(int(o.stackIndex) - 1)
    if (int(o.stackIndex) > int(o.stackFirstDynamicIndex) || all_host__IsStackPolymorphic(o)) {
        return m3Err_none
    } else {
        return m3Err_functionStackUnderrun
    }
}

// Items in the static portion of the stack (args/locals) are hidden from GetStackTypeFromTop ()
// In other words, only "real" Wasm stack items can be inspected. This is important when
// returning values, etc. and you need an accurate wasm-view of the stack.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetStackTypeFromTop(var o : M3Compilation?; var i_offset : uint16) : uint8 {
    var _c_type : uint8 = uint8(M3ValueType.c_m3Type_none)
    i_offset = uint16(uint(i_offset) + 1)
    if (int(o.stackIndex) >= int(i_offset)) {
        let index : uint16 = uint16(int(o.stackIndex) - int(i_offset))
        if (int(index) >= int(o.stackFirstDynamicIndex)) {
            _c_type = o.typeStack[int(index)]
        }
    }
    return _c_type
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetStackTopType(var o : M3Compilation?) : uint8 {
    return all_host__GetStackTypeFromTop(o, uint16(0))
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetStackTypeFromBottom(var o : M3Compilation?; i_offset : uint16) : uint8 {
    var _c_type : uint8 = uint8(M3ValueType.c_m3Type_none)
    if (int(i_offset) < int(o.stackIndex)) {
        _c_type = o.typeStack[int(i_offset)]
    }
    return _c_type
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsConstantSlot(var o : M3Compilation?; i_slot : uint16) : bool {
    return int(i_slot) >= int(o.slotFirstConstIndex) && int(i_slot) < int(o.slotMaxConstIndex)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsSlotAllocated(var o : M3Compilation?; i_slot : uint16) : bool {
    return o.m3Slots[int(i_slot)] != 0
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsStackIndexInRegister(var o : M3Compilation?; i_stackIndex : int) : bool {
    if (i_stackIndex >= 0 && i_stackIndex < int(o.stackIndex)) {
        return int(o.wasmStack[i_stackIndex]) >= d_m3Reg0SlotAlias
    } else {
        return 0 != 0
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetNumBlockValuesOnStack(var o : M3Compilation?) : uint16 {
    return uint16(int(o.stackIndex) - int(o._c_block.blockStackIndex))
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsStackTopInRegister(var o : M3Compilation?) : bool {
    return all_host__IsStackIndexInRegister(o, int(all_host__GetStackTopIndex(o)))
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsStackTopMinus1InRegister(var o : M3Compilation?) : bool {
    return all_host__IsStackIndexInRegister(o, int(all_host__GetStackTopIndex(o)) - 1)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsStackTopMinus2InRegister(var o : M3Compilation?) : bool {
    return all_host__IsStackIndexInRegister(o, int(all_host__GetStackTopIndex(o)) - 2)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsStackTopInSlot(var o : M3Compilation?) : bool {
    return !all_host__IsStackTopInRegister(o)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsValidSlot(i_slot : uint16) : bool {
    return int(i_slot) < d_m3MaxFunctionSlots
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetStackTopSlotNumber(var o : M3Compilation?) : uint16 {
    let i : int16 = all_host__GetStackTopIndex(o)
    var slot : uint16 = all_host__c_slotUnused
    if (int(i) >= 0) {
        slot = o.wasmStack[int(i)]
    }
    return slot
}

// from bottom
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetSlotForStackIndex(var o : M3Compilation?; i_stackIndex : uint16) : uint16 {
    var slot : uint16 = all_host__c_slotUnused
    if (int(i_stackIndex) < int(o.stackIndex)) {
        slot = o.wasmStack[int(i_stackIndex)]
    }
    return slot
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetExtraSlotForStackIndex(var o : M3Compilation?; i_stackIndex : uint16) : uint16 {
    var baseSlot : uint16 = all_host__GetSlotForStackIndex(o, i_stackIndex)
    if (baseSlot != all_host__c_slotUnused) {
        let extraSlot : uint16 = uint16(int(all_host__GetTypeNumSlots(all_host__GetStackTypeFromBottom(o, i_stackIndex))) - 1)
        baseSlot = uint16(int(baseSlot) + int(extraSlot))
    }
    return baseSlot
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__TouchSlot(var o : M3Compilation?; i_slot : uint16) {
    // op_Entry uses this value to track and detect stack overflow
    o.maxStackSlots = uint16(int(o.maxStackSlots) > int(i_slot) + 1 ? int(o.maxStackSlots) : int(i_slot) + 1)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__MarkSlotAllocated(var o : M3Compilation?; i_slot : uint16) {
    // shouldn't be already allocated
    o.m3Slots[int(i_slot)] = 1u8
    o.slotMaxAllocatedIndexPlusOne = uint16(int(o.slotMaxAllocatedIndexPlusOne) > int(i_slot) + 1 ? int(o.slotMaxAllocatedIndexPlusOne) : int(i_slot) + 1)
    all_host__TouchSlot(o, i_slot)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__MarkSlotsAllocated(var o : M3Compilation?; var i_slot : uint16; var i_numSlots : uint16) : uint8? {
    if (int(i_slot) + int(i_numSlots) > d_m3MaxFunctionSlots) {
        return m3Err_functionStackOverflow
    }
    while (true) {
        let _t0 = i_numSlots
        i_numSlots = uint16(uint(i_numSlots) - 1)
        if (_t0 == 0) {
            break
        }
        let _t1 = i_slot
        i_slot = uint16(uint(i_slot) + 1)
        all_host__MarkSlotAllocated(o, _t1)
    }
    return m3Err_none
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__MarkSlotsAllocatedByType(var o : M3Compilation?; i_slot : uint16; i_type : uint8) : uint8? {
    let numSlots : uint16 = all_host__GetTypeNumSlots(i_type)
    return all_host__MarkSlotsAllocated(o, i_slot, numSlots)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__AllocateSlotsWithinRange(var o : M3Compilation?; var o_slot : uint16?; i_type : uint8; var i_startSlot : uint16;
                                               i_endSlot : uint16) : uint8? {
    var result : uint8? = m3Err_functionStackOverflow
    let numSlots : uint16 = all_host__GetTypeNumSlots(i_type)
    let searchOffset : uint16 = uint16(int(numSlots) - 1)
    all_host__AlignSlotToType(addr(i_startSlot), i_type)
    // search for 1 or 2 consecutive slots in the execution stack
    var i : uint16 = i_startSlot
    while (int(i) + int(searchOffset) < int(i_endSlot)) {
        if (int(i) + int(searchOffset) < d_m3MaxFunctionSlots && o.m3Slots[int(i)] == 0 && o.m3Slots[int(i) + int(searchOffset)] == 0) {
            all_host__MarkSlotsAllocated(o, i, numSlots)
            *o_slot = i
            result = m3Err_none
            break
        }
        // keep 2-slot allocations even-aligned
        i = uint16(int(i) + int(numSlots))
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__AllocateSlots(var o : M3Compilation?; var o_slot : uint16?; i_type : uint8) : uint8? {
    return all_host__AllocateSlotsWithinRange(o, o_slot, i_type, o.slotFirstDynamicIndex, uint16(d_m3MaxFunctionSlots))
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__AllocateConstantSlots(var o : M3Compilation?; var o_slot : uint16?; i_type : uint8) : uint8? {
    let maxTableIndex : uint16 = uint16(int(o.slotFirstConstIndex) + d_m3MaxConstantTableSize)
    return all_host__AllocateSlotsWithinRange(o, o_slot, i_type, o.slotFirstConstIndex,
            uint16(int(o.slotFirstDynamicIndex) < int(maxTableIndex) ? int(o.slotFirstDynamicIndex) : int(maxTableIndex)))
}

// TOQUE: this usage count system could be eliminated. real world code doesn't frequently trigger it. just copy to multiple
// unique slots.
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IncrementSlotUsageCount(var o : M3Compilation?; i_slot : uint16) : uint8? {
    var result : uint8? = m3Err_none
    // OPTZ (memory): 'm3Slots' could still be fused with 'typeStack' if 4 bits were used to indicate: [0,1,2,many]. The many-case
    // would scan 'wasmStack' to determine the actual usage count
    if (int(o.m3Slots[int(i_slot)]) < 255) {
        o.m3Slots[int(i_slot)] = uint8(uint(o.m3Slots[int(i_slot)]) + 1)
    } else {
        result = cstr("slot usage count overflow")
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__DeallocateSlot(var o : M3Compilation?; var i_slot : int16; i_type : uint8) {
    {
        var i : uint16 = uint16(0)
        while (int(i) < int(all_host__GetTypeNumSlots(i_type))) {
            o.m3Slots[int(i_slot)] = uint8(uint(o.m3Slots[int(i_slot)]) - 1)
            i = uint16(uint(i) + 1)
            i_slot = int16(int(i_slot) + 1)
        }
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsRegisterTypeAllocated(var o : M3Compilation?; i_type : uint8) : bool {
    return all_host__IsRegisterAllocated(o, uint(int_of(IsFpType(i_type))))
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__AllocateRegister(var o : M3Compilation?; i_register : uint; i_stackIndex : uint16) {
    o.regStackIndexPlusOne[i_register] = uint16(int(i_stackIndex) + 1)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__DeallocateRegister(var o : M3Compilation?; i_register : uint) {
    o.regStackIndexPlusOne[i_register] = all_host__c_m3RegisterUnallocated
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__GetRegisterStackIndex(var o : M3Compilation?; i_register : uint) : uint16 {
    return uint16(int(o.regStackIndexPlusOne[i_register]) - 1)
}

[unsafe_deref, hint(unsafe_range_check)]
def GetMaxUsedSlotPlusOne(var o : M3Compilation?) : uint16 {
    while (int(o.slotMaxAllocatedIndexPlusOne) > int(o.slotFirstDynamicIndex)) {
        if (all_host__IsSlotAllocated(o, uint16(int(o.slotMaxAllocatedIndexPlusOne) - 1))) {
            break
        }
        o.slotMaxAllocatedIndexPlusOne = uint16(uint(o.slotMaxAllocatedIndexPlusOne) - 1)
    }
    return o.slotMaxAllocatedIndexPlusOne
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__PreserveRegisterIfOccupied(var o : M3Compilation?; i_registerType : uint8) : uint8? {
    var result : uint8? = m3Err_none
    let regSelect : uint = uint(int_of(IsFpType(i_registerType)))
    if (all_host__IsRegisterAllocated(o, regSelect)) {
        let stackIndex : uint16 = all_host__GetRegisterStackIndex(o, regSelect)
        all_host__DeallocateRegister(o, regSelect)
        let _c_type : uint8 = all_host__GetStackTypeFromBottom(o, stackIndex)
        // and point to a exec slot
        var slot : uint16 = all_host__c_slotUnused
        result = all_host__AllocateSlots(o, addr(slot), _c_type)
        if (result != null) {
            goto label 1
        }
        o.wasmStack[int(stackIndex)] = slot
        // Ensure type is within the valid range
        if (int(all_host__BaseTypeOf(_c_type)) < int(M3ValueType.c_m3Type_count)) {
            result = all_host__EmitOp(o, all_host__c_setSetOps[int(all_host__BaseTypeOf(_c_type))])
            if (result != null) {
                goto label 1
            }
        } else {
            result = m3Err_unknownType
            goto label 1
        }
        all_host__EmitSlotOffset(o, int(slot))
    }
    label 1:  // _catch
    return result
}

// all values must be in slots before entering loop, if, and else blocks
// otherwise they'd end up preserve-copied in the block to probably different locations (if/else)
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__PreserveRegisters(var o : M3Compilation?) : uint8? {
    var result : uint8?
    result = all_host__PreserveRegisterIfOccupied(o, uint8(M3ValueType.c_m3Type_f64))
    if (result != null) {
        goto label 1
    }
    result = all_host__PreserveRegisterIfOccupied(o, uint8(M3ValueType.c_m3Type_i64))
    if (result != null) {
        goto label 1
    }
    label 1:  // _catch
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__PreserveNonTopRegisters(var o : M3Compilation?) : uint8? {
    var result : uint8? = m3Err_none
    let stackTop : int16 = all_host__GetStackTopIndex(o)
    if (int(stackTop) >= 0) {
        // r0
        if (all_host__IsRegisterAllocated(o, 0u)) {
            if (int(all_host__GetRegisterStackIndex(o, 0u)) != int(stackTop)) {
                result = all_host__PreserveRegisterIfOccupied(o, uint8(M3ValueType.c_m3Type_i64))
                if (result != null) {
                    goto label 1
                }
            }
        }
        // fp0
        if (all_host__IsRegisterAllocated(o, 1u)) {
            if (int(all_host__GetRegisterStackIndex(o, 1u)) != int(stackTop)) {
                result = all_host__PreserveRegisterIfOccupied(o, uint8(M3ValueType.c_m3Type_f64))
                if (result != null) {
                    goto label 1
                }
            }
        }
    }
    label 1:  // _catch
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Push(var o : M3Compilation?; i_type : uint8; i_slot : uint16) : uint8? {
    var result : uint8? = m3Err_none
    if (int(i_type) == int(M3ValueType.c_m3Type_f32) || int(i_type) == int(M3ValueType.c_m3Type_f64)) {
        return m3Err_unknownOpcode
    }
    if (int(o.stackIndex) >= d_m3MaxFunctionStackHeight) {
        return m3Err_functionStackOverflow
    }
    // printf ("push: %d\n", (i32) i);
    let _t0 = o.stackIndex
    o.stackIndex = uint16(uint(o.stackIndex) + 1)
    let stackIndex : uint16 = _t0
    o.wasmStack[int(stackIndex)] = i_slot
    o.typeStack[int(stackIndex)] = i_type
    if (all_host__IsRegisterSlotAlias(i_slot)) {
        let regSelect : uint = uint(int_of(all_host__IsFpRegisterSlotAlias(i_slot)))
        all_host__AllocateRegister(o, regSelect, stackIndex)
    }
    if (d_m3LogWasmStack != 0) {
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__PushRegister(var o : M3Compilation?; i_type : uint8) : uint8? {
    var result : uint8? = m3Err_none
    let slot : uint16 = uint16(IsFpType(i_type) ? d_m3Fp0SlotAlias : d_m3Reg0SlotAlias)
    result = all_host__Push(o, i_type, slot)
    if (result != null) {
        goto label 1
    }
    label 1:  // _catch
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Pop(var o : M3Compilation?) : uint8? {
    var result : uint8? = m3Err_none
    if (int(o.stackIndex) > int(o._c_block.blockStackIndex)) {
        // printf ("pop: %d\n", (i32) o->stackIndex);
        o.stackIndex = uint16(uint(o.stackIndex) - 1)
        let slot : uint16 = o.wasmStack[int(o.stackIndex)]
        let _c_type : uint8 = o.typeStack[int(o.stackIndex)]
        if (all_host__IsRegisterSlotAlias(slot)) {
            let regSelect : uint = uint(int_of(all_host__IsFpRegisterSlotAlias(slot)))
            all_host__DeallocateRegister(o, regSelect)
        } elif (int(slot) >= int(o.slotMaxAllocatedIndexPlusOne)) {
            // Return error for invalid slot indices
            return m3Err_functionStackUnderrun
        } elif (int(slot) >= int(o.slotFirstDynamicIndex)) {
            all_host__DeallocateSlot(o, int16(slot), _c_type)
        }
    } elif (!all_host__IsStackPolymorphic(o)) {
        result = m3Err_functionStackUnderrun
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__PopType(var o : M3Compilation?; i_type : uint8) : uint8? {
    var result : uint8? = m3Err_none
    let topType : uint8 = all_host__GetStackTopType(o)
    if (all_host__IsSubTypeOf(topType, i_type) || o._c_block.isPolymorphic) {
        result = all_host__Pop(o)
        if (result != null) {
            goto label 1
        }
    } else {
        result = m3Err_typeMismatch
        goto label 1
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host___PushAllocatedSlotAndEmit(var o : M3Compilation?; i_type : uint8; i_doEmit : bool) : uint8? {
    var result : uint8? = m3Err_none
    var slot : uint16 = all_host__c_slotUnused
    result = all_host__AllocateSlots(o, addr(slot), i_type)
    if (result != null) {
        goto label 1
    }
    result = all_host__Push(o, i_type, slot)
    if (result != null) {
        goto label 1
    }
    if (i_doEmit) {
        all_host__EmitSlotOffset(o, int(slot))
    }
    label 1:  // _catch
    // printf ("push: %d\n", (u32) slot);
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__PushAllocatedSlotAndEmit(var o : M3Compilation?; i_type : uint8) : uint8? {
    return all_host___PushAllocatedSlotAndEmit(o, i_type, 1 != 0)
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__PushAllocatedSlot(var o : M3Compilation?; i_type : uint8) : uint8? {
    return all_host___PushAllocatedSlotAndEmit(o, i_type, 0 != 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__PushConst(var o : M3Compilation?; var i_word : uint64; i_type : uint8) : uint8? {
    var result : uint8? = m3Err_none
    // When compile-walking a constant expression without emitting there is no
    // constant table to place the value in, but the type still has to land on
    // the stack: extended-const arithmetic downstream consumes it.
    if (o.page == null) {
        return all_host__PushAllocatedSlot(o, i_type)
    }
    var matchFound : bool = 0 != 0
    let is64BitType : bool = Is64BitType(i_type)
    let numRequiredSlots : uint16 = all_host__GetTypeNumSlots(i_type)
    let numUsedConstSlots : uint16 = uint16(int(o.slotMaxConstIndex) - int(o.slotFirstConstIndex))
    // search for duplicate matching constant slot to reuse
    if (numRequiredSlots == 2 && int(numUsedConstSlots) >= 2) {
        var firstConstSlot : uint16 = o.slotFirstConstIndex
        all_host__AlignSlotToType(addr(firstConstSlot), uint8(M3ValueType.c_m3Type_i64))
        {
            var slot : uint16 = firstConstSlot
            while (int(slot) < int(o.slotMaxConstIndex) - 1) {
                if (all_host__IsSlotAllocated(o, slot) && all_host__IsSlotAllocated(o, uint16(int(slot) + 1))) {
                    var constant : uint64
                    crt::memcpy(reinterpret<void?>(addr(constant)),
                            reinterpret<void?>(addr(o.constants[0]) + end_index(int(slot) - int(o.slotFirstConstIndex), 120)),
                            uint64(typeinfo sizeof(type<uint64>)))
                    if (constant == i_word) {
                        matchFound = 1 != 0
                        result = all_host__Push(o, i_type, slot)
                        if (result != null) {
                            goto label 1
                        }
                        break
                    }
                }
                slot = uint16(int(slot) + 2)
            }
        }
    } elif (numRequiredSlots == 1) {
        {
            var i : uint16 = uint16(0)
            while (int(i) < int(numUsedConstSlots)) {
                let slot : uint16 = uint16(int(o.slotFirstConstIndex) + int(i))
                if (all_host__IsSlotAllocated(o, slot)) {
                    var matches : bool
                    if (is64BitType) {
                        var constant : uint64
                        crt::memcpy(reinterpret<void?>(addr(constant)), reinterpret<void?>(addr(o.constants[0]) + end_index(int(i), 120)),
                                uint64(typeinfo sizeof(type<uint64>)))
                        matches = constant == i_word
                    } else {
                        var constant : uint
                        crt::memcpy(reinterpret<void?>(addr(constant)), reinterpret<void?>(addr(o.constants[0]) + end_index(int(i), 120)),
                                uint64(typeinfo sizeof(type<uint>)))
                        matches = uint64(constant) == i_word
                    }
                    if (matches) {
                        matchFound = 1 != 0
                        result = all_host__Push(o, i_type, slot)
                        if (result != null) {
                            goto label 1
                        }
                        break
                    }
                }
                i = uint16(uint(i) + 1)
            }
        }
    }
    if (!matchFound) {
        var slot : uint16 = all_host__c_slotUnused
        result = all_host__AllocateConstantSlots(o, addr(slot), i_type)
        // no more constant table space; use inline constants
        if (result != null || slot == all_host__c_slotUnused) {
            result = m3Err_none
            if (is64BitType) {
                result = all_host__EmitOp(o, @@all_host__op_Const64)
                if (result != null) {
                    goto label 1
                }
                EmitWord64(o.page, i_word)
            } else {
                result = all_host__EmitOp(o, @@all_host__op_Const32)
                if (result != null) {
                    goto label 1
                }
                EmitWord32(o.page, uint(i_word))
            }
            result = all_host__PushAllocatedSlotAndEmit(o, i_type)
            if (result != null) {
                goto label 1
            }
        } else {
            let constTableIndex : uint16 = uint16(int(slot) - int(o.slotFirstConstIndex))
            if (is64BitType) {
                crt::memcpy(reinterpret<void?>(addr(o.constants[0]) + end_index(int(constTableIndex), 120)), reinterpret<void?>(addr(i_word)),
                        uint64(typeinfo sizeof(type<uint64>)))
            } else {
                var word32 : uint = uint(i_word)
                crt::memcpy(reinterpret<void?>(addr(o.constants[0]) + end_index(int(constTableIndex), 120)), reinterpret<void?>(addr(word32)),
                        uint64(typeinfo sizeof(type<uint>)))
            }
            result = all_host__Push(o, i_type, slot)
            if (result != null) {
                goto label 1
            }
            o.slotMaxConstIndex = uint16(int(slot) + int(numRequiredSlots) > int(o.slotMaxConstIndex) ? int(slot) + int(numRequiredSlots) :
                    int(o.slotMaxConstIndex))
        }
    }
    label 1:  // _catch
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__EmitSlotNumOfStackTopAndPop(var o : M3Compilation?) : uint8? {
    // no emit if value is in register
    if (all_host__IsStackTopInSlot(o)) {
        all_host__EmitSlotOffset(o, int(all_host__GetStackTopSlotNumber(o)))
    }
    return all_host__Pop(o)
}

// Or, maybe: EmitTrappingOp
[unsafe_deref, hint(unsafe_range_check)]
def AddTrapRecord(var o : M3Compilation?) : uint8? {
    var result : uint8? = m3Err_none
    if (o._c_function != null) {
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__UnwindBlockStack(var o : M3Compilation?) : uint8? {
    var result : uint8? = m3Err_none
    var popCount : uint = 0u
    while (int(o.stackIndex) > int(o._c_block.blockStackIndex)) {
