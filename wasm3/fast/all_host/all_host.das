// Validate that a byte sequence is well-formed UTF-8 per the Unicode spec.
// Returns true if valid, false otherwise.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__IsValidUtf8(var i_data : uint8?; i_length : uint) : bool {
    var ptr : uint8? = i_data
    var end : uint8? = i_data + i_length
    while (intptr(ptr) < intptr(end)) {
        var _t0 = ptr
        ptr++
        let b0 : uint8 = *_t0
        if (int(b0) < 128) {
            // single-byte: 0xxxxxxx
            continue
        } elif ((int(b0) & 224) == 192) {
            // two-byte: 110xxxxx 10xxxxxx
            if (int(b0) < 194) {
                // overlong
                return 0 != 0
            }
            if (intptr(ptr) >= intptr(end)) {
                return 0 != 0
            }
            var _t1 = ptr
            ptr++
            let b1 : uint8 = *_t1
            if ((int(b1) & 192) != 128) {
                return 0 != 0
            }
        } elif ((int(b0) & 240) == 224) {
            // three-byte: 1110xxxx 10xxxxxx 10xxxxxx
            if (intptr(ptr + 1) >= intptr(end)) {
                return 0 != 0
            }
            var _t2 = ptr
            ptr++
            let b1 : uint8 = *_t2
            var _t3 = ptr
            ptr++
            let b2 : uint8 = *_t3
            if ((int(b1) & 192) != 128) {
                return 0 != 0
            }
            if ((int(b2) & 192) != 128) {
                return 0 != 0
            }
            // reject overlong
            if (b0 == 224 && int(b1) < 160) {
                return 0 != 0
            }
            // reject surrogates U+D800..U+DFFF
            if (b0 == 237 && int(b1) >= 160) {
                return 0 != 0
            }
        } elif ((int(b0) & 248) == 240) {
            // four-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
            if (int(b0) > 244) {
                // above U+10FFFF
                return 0 != 0
            }
            if (intptr(ptr + 2) >= intptr(end)) {
                return 0 != 0
            }
            var _t4 = ptr
            ptr++
            let b1 : uint8 = *_t4
            var _t5 = ptr
            ptr++
            let b2 : uint8 = *_t5
            var _t6 = ptr
            ptr++
            let b3 : uint8 = *_t6
            if ((int(b1) & 192) != 128) {
                return 0 != 0
            }
            if ((int(b2) & 192) != 128) {
                return 0 != 0
            }
            if ((int(b3) & 192) != 128) {
                return 0 != 0
            }
            // reject overlong
            if (b0 == 240 && int(b1) < 144) {
                return 0 != 0
            }
            // reject above U+10FFFF
            if (b0 == 244 && int(b1) > 143) {
                return 0 != 0
            }
        } else {
            // invalid leading byte (0x80..0xBF or 0xF5..0xFF)
            return 0 != 0
        }
    }
    return 1 != 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Read_utf8(var o_utf8 : uint8 ??; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    *o_utf8 = null
    var utf8Length : uint
    var result : uint8? = ReadLEB_u32(addr(utf8Length), io_bytes, i_end)
    if (result == null) {
        if (utf8Length <= uint(d_m3MaxSaneUtf8Length)) {
            var ptr : uint8? = *io_bytes
            var end : uint8? = ptr + utf8Length
            if (intptr(end) <= intptr(i_end)) {
                if (!all_host__IsValidUtf8(ptr, utf8Length)) {
                    *io_bytes = end
                    return m3Err_wasmMalformed
                }
                // d_m3EnableValidation
                var utf8 : uint8? = reinterpret<uint8?>(m3_Malloc_Impl(uint64(utf8Length + 1u)))
                if (utf8 != null) {
                    crt::memcpy(reinterpret<void?>(utf8), reinterpret<void?>(ptr), uint64(utf8Length))
                    utf8[utf8Length] = 0u8
                    *o_utf8 = utf8
                } else {
                    // callers dereference the name; don't hand back NULL as success
                    result = m3Err_mallocFailed
                }
                *io_bytes = end
            } else {
                result = m3Err_wasmUnderrun
            }
        } else {
            result = m3Err_missingUTF8
        }
    }
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_NewEnvironment : M3Environment? {
    var env : M3Environment? = reinterpret<M3Environment?>(m3_Malloc_Impl(uint64(typeinfo sizeof(type<M3Environment>))))
    if (env != null) {
        var result : uint8? = m3Err_none
        // create FuncTypes for all simple block return ValueTypes.
        // v128 is skipped: it parses as a slot but has no operations.
        {
            var t : uint8 = uint8(M3ValueType.c_m3Type_none)
            var _f = false
            while (true) {
                if (_f) {
                    t = uint8(uint(t) + 1)
                }
                _f = true
                if (!(int(t) < int(M3ValueType.c_m3Type_count))) {
                    break
                }
                if (int(t) == int(M3ValueType.c_m3Type_v128)) {
                    continue
                }
                var ftype : M3FuncType?
                result = AllocFuncType(addr(ftype), 1u)
                if (result != null) {
                    goto label 1
                }
                ftype.numArgs = uint16(0)
                ftype.numRets = uint16((int(t) == int(M3ValueType.c_m3Type_none)) ? 0 : 1)
                reinterpret<uint8?>(reinterpret<uint8?>(ftype) + 14)[0] = t
                Environment_AddFuncType(env, addr(ftype))
                env.retFuncTypes[int(t)] = ftype
            }
        }
        label 1:  // _catch
        if (result != null) {
            m3_FreeEnvironment(env)
            env = null
        }
    }
    return env
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Environment_Release(var i_environment : M3Environment?) {
    var ftype : M3FuncType? = i_environment.funcTypes
    while (ftype != null) {
        var next : M3FuncType? = ftype.next
        m3_Free(ftype)
        ftype = next
    }
    FreeCodePages(addr(i_environment.pagesReleased))
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_FreeEnvironment(var i_environment : M3Environment?) {
    if (i_environment != null) {
        Environment_Release(i_environment)
        m3_Free(i_environment)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_SetCustomSectionHandler(var i_environment : M3Environment?;
                               i_handler : function<(var a0 : M3Module?; var a1 : uint8?; var a2 : uint8?; var a3 : uint8?) : uint8?>) {
    if (i_environment != null) {
        i_environment.customSectionHandler = i_handler
    }
}

// returns the same io_funcType or replaces it with an equivalent that's already in the type linked list
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Environment_AddFuncType(var i_environment : M3Environment?; var io_funcType : M3FuncType ??) : uint8? {
    var addType : M3FuncType? = *io_funcType
    var newType : M3FuncType? = i_environment.funcTypes
    while (newType != null) {
        if (AreFuncTypesEqual(newType, addType)) {
            m3_Free(addType)
            break
        }
        newType = newType.next
    }
    if (newType == null) {
        // a type index has to fit in the heap type field of an m3type_t
        if (int(i_environment.numFuncTypes) >= d_m3MaxSaneTypesCount) {
            m3_Free(addType)
            *io_funcType = null
            return cstr("too many distinct function types")
        }
        newType = addType
        let _t0 = i_environment.numFuncTypes
        i_environment.numFuncTypes = uint16(uint(i_environment.numFuncTypes) + 1)
        newType.canonicalIndex = _t0
        newType.next = i_environment.funcTypes
        i_environment.funcTypes = newType
    }
    *io_funcType = newType
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def RemoveCodePageOfCapacity(var io_list : M3CodePage ??; i_minimumLineCount : uint) : M3CodePage? {
    var prev : M3CodePage? = null
    var page : M3CodePage? = *io_list
    while (page != null) {
        if (NumFreeLines(page) >= i_minimumLineCount) {
            var next : M3CodePage? = page.info.next
            if (prev != null) {
                // mid-list
                prev.info.next = next
            } else {
                // front of list
                *io_list = next
            }
            break
        }
        prev = page
        page = page.info.next
    }
    return page
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Environment_AcquireCodePage(var i_environment : M3Environment?; i_minimumLineCount : uint) : M3CodePage? {
    return RemoveCodePageOfCapacity(addr(i_environment.pagesReleased), i_minimumLineCount)
}

[unsafe_deref, hint(unsafe_range_check)]
def Environment_ReleaseCodePages(var i_environment : M3Environment?; var i_codePageList : M3CodePage?) {
    var end : M3CodePage? = i_codePageList
    while (end != null) {
        // reset page
        end.info.lineIndex = 0u
        // d_m3RecordBacktraces
        var next : M3CodePage? = end.info.next
        if (next == null) {
            break
        }
        end = next
    }
    if (end != null) {
        // push list to front
        end.info.next = i_environment.pagesReleased
        i_environment.pagesReleased = i_codePageList
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def m3_NewRuntime(var i_environment : M3Environment?; i_stackSizeInBytes : uint; var i_userdata : void?) : M3Runtime? {
    var runtime : M3Runtime? = reinterpret<M3Runtime?>(m3_Malloc_Impl(uint64(typeinfo sizeof(type<M3Runtime>))))
    if (runtime != null) {
        m3_ResetErrorInfo(runtime)
        runtime.environment = i_environment
        runtime.userdata = i_userdata
        {
        }
        // TODO: more precise stack checks
        runtime.originStack = m3_Malloc_Impl(uint64(i_stackSizeInBytes) + 4ul * uint64(typeinfo sizeof(type<uint>)))
        if (runtime.originStack != null) {
            runtime.stack = runtime.originStack
            runtime.numStackSlots = uint(uint64(i_stackSizeInBytes) / uint64(typeinfo sizeof(type<uint>)))
        } else {
            m3_Free(runtime)
        }
    }
    return runtime
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_SetValidation(var i_runtime : M3Runtime?; i_enable : bool) {
