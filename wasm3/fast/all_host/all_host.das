                    result = all_host__ResolveBlockResults(o, scope, 1 != 0)
                    if (result != null) {
                        goto label 1
                    }
                }
                result = all_host__EmitOp(o, @@all_host__op_ContinueLoop)
                if (result != null) {
                    goto label 1
                }
                all_host__EmitPointer(o, reinterpret<void?>(scope.pc))
            } else {
