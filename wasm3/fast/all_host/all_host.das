    if (f.opcode == 3) {
        // params
        return all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(f._c_type) + 14)[int(f._c_type.numRets) + int(i)])
    }
    // results
    return all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(f._c_type) + 14)[int(i)])
}

// The operand i_depth below the top, without popping. Anything at or below the
// current frame's height is implicitly bottom in an unreachable frame; reporting
// unknown there defers a genuine underrun to the pop that follows.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_peek(var v : ValCtx?; i_depth : uint16) : uint8 {
    var f : ValCtrlFrame? = addr(v.ctrl[0]) + end_index(int(v.ctrlTop) - 1, 2000)
    if (int(v.opdTop) <= int(i_depth) || int(uint16(int(v.opdTop) - int(i_depth) - 1)) < int(f.height)) {
        return uint8(c_valBottom)
    }
    return v.opd[int(v.opdTop) - int(i_depth) - 1]
}

// Pop label types for branch target
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_pop_labels(var v : ValCtx?; var tgt : ValCtrlFrame?) : uint8? {
    let n : uint16 = all_host__v_label_n(tgt)
    {
        var i : uint16 = n
        while (int(i) > 0) {
            var a : uint8
            var r : uint8? = all_host__v_pop_expect(v, all_host__v_label_t(tgt, uint16(int(i) - 1)), addr(a))
            if (r != null) {
                return r
            }
            i = uint16(uint(i) - 1)
        }
    }
    return m3Err_none
}

// Push label types back
[unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_push_labels(var v : ValCtx?; var tgt : ValCtrlFrame?) : uint8? {
    let n : uint16 = all_host__v_label_n(tgt)
    {
        var i : uint16 = uint16(0)
        while (int(i) < int(n)) {
            var r : uint8? = all_host__v_push(v, all_host__v_label_t(tgt, i))
            if (r != null) {
                return r
            }
            i = uint16(uint(i) + 1)
        }
    }
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_read_blocktype(var v : ValCtx?; var o_type : M3FuncType ??) : uint8? {
    if (intptr(v.wasm) >= intptr(v.wasmEnd)) {
        return m3Err_wasmUnderrun
    }
    var _c_type : int64
    var r : uint8? = ReadLebSigned(addr(_c_type), 33u, addr(v.wasm), v.wasmEnd)
    if (r != null) {
        return r
    }
    if (_c_type < 0l) {
        if (_c_type < -64l) {
            return m3Err_invalidTypeId
        }
        var valtype : uint8
        r = NormalizeType(addr(valtype), int8(_c_type))
        if (r != null) {
            return r
        }
        var env : M3Environment? = v._c_module.environment
        *o_type = env.retFuncTypes[int(valtype)]
    } else {
        if (uint(_c_type) >= v._c_module.numFuncTypes) {
            return m3Err_unknownType
        }
        *o_type = v._c_module.funcTypes[uint(_c_type)]
    }
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_unop(var v : ValCtx?; _c_in : uint8; out : uint8) : uint8? {
    var a : uint8
    var r : uint8? = all_host__v_pop_expect(v, _c_in, addr(a))
    if (r != null) {
        return r
    }
    return all_host__v_push(v, out)
}

// return_call/return_call_indirect return the callee's results straight to the enclosing
// function's caller, so the callee's result types must be the enclosing function's
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_check_tail_results(var v : ValCtx?; var i_calleeType : M3FuncType?) : uint8? {
    var ft : M3FuncType? = v._c_function != null ? v._c_function.funcType : null
    let numCalleeRets : uint16 = uint16(i_calleeType != null ? int(i_calleeType.numRets) : 0)
    let numFuncRets : uint16 = uint16(ft != null ? int(ft.numRets) : 0)
    if (numCalleeRets != numFuncRets) {
        return m3Err_typeMismatch
    }
    {
        var i : uint16 = uint16(0)
        while (int(i) < int(numCalleeRets)) {
            if (reinterpret<uint8?>(reinterpret<uint8?>(i_calleeType) + 14)[int(i)] != reinterpret<uint8?>(reinterpret<uint8?>(ft) + 14)[int(i)]) {
                return m3Err_typeMismatch
            }
            i = uint16(uint(i) + 1)
        }
    }
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_binop(var v : ValCtx?; t : uint8) : uint8? {
    var a : uint8
    var r : uint8?
    r = all_host__v_pop_expect(v, t, addr(a))
    if (r != null) {
        return r
    }
    r = all_host__v_pop_expect(v, t, addr(a))
    if (r != null) {
        return r
    }
    return all_host__v_push(v, t)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_relop(var v : ValCtx?; t : uint8) : uint8? {
    var a : uint8
    var r : uint8?
    r = all_host__v_pop_expect(v, t, addr(a))
    if (r != null) {
        return r
    }
    r = all_host__v_pop_expect(v, t, addr(a))
    if (r != null) {
        return r
    }
    return all_host__v_push(v, uint8(M3ValueType.c_m3Type_i32))
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_testop(var v : ValCtx?; t : uint8) : uint8? {
    return all_host__v_unop(v, t, uint8(M3ValueType.c_m3Type_i32))
}

[unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_cvtop(var v : ValCtx?; _c_in : uint8; out : uint8) : uint8? {
    return all_host__v_unop(v, _c_in, out)
}

// One catch clause of a try_table. The label is resolved in the context the
// try_table itself appears in - the spec checks the clauses against C, not
// against C extended with the block's own label - so depth 0 names the block
// enclosing the try, not the try. What the clause hands the label is the tag's
// payload, optionally followed by the exnref that reifies the caught exception.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_catch_clause(var v : ValCtx?) : uint8? {
    var kind : uint8
    var r : uint8? = Read_u8(addr(kind), addr(v.wasm), v.wasmEnd)
    if (r != null) {
        return r
    }
    if (int(kind) > 3) {
        return m3Err_wasmMalformed
    }
    let hasTag : bool = kind == 0 || kind == 1
    let hasRef : bool = kind == 1 || kind == 3
    var tagType : M3FuncType? = null
    if (hasTag) {
        var tagIndex : uint
        r = ReadLEB_u32(addr(tagIndex), addr(v.wasm), v.wasmEnd)
        if (r != null) {
            return r
        }
        if (v._c_module == null || tagIndex >= v._c_module.numTags) {
            return m3Err_unknownTag
        }
        tagType = v._c_module.tags[tagIndex]._c_type
    }
    var depth : uint
    r = ReadLEB_u32(addr(depth), addr(v.wasm), v.wasmEnd)
    if (r != null) {
        return r
    }
    if (depth >= uint(v.ctrlTop)) {
        return m3Err_unknownLabel
    }
    var tgt : ValCtrlFrame? = addr(v.ctrl[0]) + end_index(uint(int(v.ctrlTop) - 1) - depth, 2000)
    let numPayload : uint16 = uint16(tagType != null ? int(tagType.numArgs) : 0)
    let numLabel : uint16 = all_host__v_label_n(tgt)
    if (uint(numLabel) != uint(numPayload) + (hasRef ? 1u : 0u)) {
        return m3Err_typeCountMismatch
    }
    {
        var i : uint16 = uint16(0)
        while (int(i) < int(numPayload)) {
            if (all_host__v_label_t(tgt, i) != all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(tagType) + 14)[int(tagType.numRets) + int(i)])) {
                return m3Err_typeMismatch
            }
            i = uint16(uint(i) + 1)
        }
    }
    if (hasRef && int(all_host__v_label_t(tgt, numPayload)) != int(M3ValueType.c_m3Type_exnref)) {
        return m3Err_typeMismatch
    }
    return m3Err_none
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private all_host__v_validate_body(var v : ValCtx?) : uint8? {
    var r : uint8? = m3Err_none
    var a : uint8 = uint8(c_valBottom)
    while (intptr(v.wasm) < intptr(v.wasmEnd)) {
        var opcode : uint16
        r = Read_opcode(addr(opcode), addr(v.wasm), v.wasmEnd)
        if (r != null) {
            return r
        }
        c_switch(int(opcode)) {
            case(0) {
                // ---- Control ----
                // unreachable
                all_host__v_unreachable(v)
                break
            }
            case(1) {
                // nop
                break
            }
            case(2, 3, 4) {
                {
                    // block
                    // loop
                    // if
                    var bt : M3FuncType? = null
                    r = all_host__v_read_blocktype(v, addr(bt))
                    if (r != null) {
                        return r
                    }
                    if (opcode == 4) {
                        r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                        if (r != null) {
                            return r
                        }
                    }
                    // Pop block params from caller stack
                    if (bt != null) {
                        {
                            var i : uint16 = bt.numArgs
                            while (int(i) > 0) {
                                r = all_host__v_pop_expect(v,
                                        all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(bt) + 14)[int(bt.numRets) + int(i) - 1]), addr(a))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) - 1)
                            }
                        }
                    }
                    r = all_host__v_push_ctrl(v, opcode, bt)
                    if (r != null) {
                        return r
                    }
                    // Push params inside block
                    if (bt != null) {
                        {
                            var i : uint16 = uint16(0)
                            while (int(i) < int(bt.numArgs)) {
                                r = all_host__v_push(v, all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(bt) + 14)[int(bt.numRets) + int(i)]))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) + 1)
                            }
                        }
                    }
                    break
                }
            }
            case(31) {
                {
                    // try_table
                    var bt : M3FuncType? = null
                    r = all_host__v_read_blocktype(v, addr(bt))
                    if (r != null) {
                        return r
                    }
                    if (bt != null) {
                        {
                            var i : uint16 = bt.numArgs
                            while (int(i) > 0) {
                                r = all_host__v_pop_expect(v,
                                        all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(bt) + 14)[int(bt.numRets) + int(i) - 1]), addr(a))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) - 1)
                            }
                        }
                    }
                    // the clauses are checked before the frame goes on, so their
                    // labels count from outside the try block
                    var numCatch : uint
                    r = ReadLEB_u32(addr(numCatch), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    for (i in urange(numCatch)) {
                        r = all_host__v_catch_clause(v)
                        if (r != null) {
                            return r
                        }
                    }
                    r = all_host__v_push_ctrl(v, opcode, bt)
                    if (r != null) {
                        return r
                    }
                    if (bt != null) {
                        {
                            var i : uint16 = uint16(0)
                            while (int(i) < int(bt.numArgs)) {
                                r = all_host__v_push(v, all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(bt) + 14)[int(bt.numRets) + int(i)]))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) + 1)
                            }
                        }
                    }
                    break
                }
            }
            case(8) {
                {
                    // throw
                    var tagIndex : uint
                    r = ReadLEB_u32(addr(tagIndex), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    if (v._c_module == null || tagIndex >= v._c_module.numTags) {
                        return m3Err_unknownTag
                    }
                    var tt : M3FuncType? = v._c_module.tags[tagIndex]._c_type
                    if (tt != null) {
                        {
                            var i : uint16 = tt.numArgs
                            while (int(i) > 0) {
                                r = all_host__v_pop_expect(v,
                                        all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(tt) + 14)[int(tt.numRets) + int(i) - 1]), addr(a))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) - 1)
                            }
                        }
                    }
                    all_host__v_unreachable(v)
                    break
                }
            }
            case(10) {
                // throw_ref
                r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_exnref), addr(a))
                if (r != null) {
                    return r
                }
                all_host__v_unreachable(v)
                break
            }
            case(5) {
                {
                    // d_m3HasExceptionHandling
                    // else
                    var frame : ValCtrlFrame
                    r = all_host__v_pop_ctrl(v, addr(frame))
                    if (r != null) {
                        return r
                    }
                    if (frame.opcode != 4) {
                        return m3Err_wasmMalformed
                    }
                    r = all_host__v_push_ctrl(v, uint16(5), frame._c_type)
                    if (r != null) {
                        return r
                    }
                    if (frame._c_type != null) {
                        {
                            var i : uint16 = uint16(0)
                            while (int(i) < int(frame._c_type.numArgs)) {
                                r = all_host__v_push(v,
                                        all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(frame._c_type) + 14)[int(frame._c_type.numRets) + int(i)]))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) + 1)
                            }
                        }
                    }
                    break
                }
            }
            case(11) {
                {
                    // end
                    var frame : ValCtrlFrame
                    r = all_host__v_pop_ctrl(v, addr(frame))
                    if (r != null) {
                        return r
                    }
                    // Push results
                    if (frame._c_type != null) {
                        {
                            var i : uint16 = uint16(0)
                            while (int(i) < int(frame.result_count)) {
                                r = all_host__v_push(v, all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(frame._c_type) + 14)[int(i)]))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) + 1)
                            }
                        }
                    }
                    // If this was the outermost frame, we're done
                    if (v.ctrlTop == 0) {
                        return m3Err_none
                    }
                    break
                }
            }
            case(12) {
                {
                    // br
                    var depth : uint
                    r = ReadLEB_u32(addr(depth), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    if (depth >= uint(v.ctrlTop)) {
                        return m3Err_unknownLabel
                    }
                    var tgt : ValCtrlFrame? = addr(v.ctrl[0]) + end_index(uint(int(v.ctrlTop) - 1) - depth, 2000)
                    r = all_host__v_pop_labels(v, tgt)
                    if (r != null) {
                        return r
                    }
                    all_host__v_unreachable(v)
                    break
                }
            }
            case(13) {
                {
                    // br_if
                    var depth : uint
                    r = ReadLEB_u32(addr(depth), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    if (depth >= uint(v.ctrlTop)) {
                        return m3Err_unknownLabel
                    }
                    r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                    if (r != null) {
                        return r
                    }
                    var tgt : ValCtrlFrame? = addr(v.ctrl[0]) + end_index(uint(int(v.ctrlTop) - 1) - depth, 2000)
                    r = all_host__v_pop_labels(v, tgt)
                    if (r != null) {
                        return r
                    }
                    r = all_host__v_push_labels(v, tgt)
                    if (r != null) {
                        return r
                    }
                    break
                }
            }
            case(14) {
                {
                    // br_table
                    var count : uint
                    r = ReadLEB_u32(addr(count), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    var defDepth : uint = 0u
                    var arity : uint16 = uint16(0)
                    // First pass: read all depths and validate arity + types match default
                    var savedPos : uint8? = v.wasm
                    // Read all targets to find the default (last one)
                    {
                        var i : uint = 0u
                        while (i <= count) {
                            var d : uint
                            r = ReadLEB_u32(addr(d), addr(v.wasm), v.wasmEnd)
                            if (r != null) {
                                return r
                            }
                            if (d >= uint(v.ctrlTop)) {
                                return m3Err_unknownLabel
                            }
                            if (i == count) {
                                defDepth = d
                            }
                            i++
                        }
                    }
                    // Now validate all labels match the default's types
                    var defTgt : ValCtrlFrame? = addr(v.ctrl[0]) + end_index(uint(int(v.ctrlTop) - 1) - defDepth, 2000)
                    arity = all_host__v_label_n(defTgt)
                    v.wasm = savedPos
                    // the index, before the labels are inspected
                    r = all_host__v_pop_expect(v, uint8(M3ValueType.c_m3Type_i32), addr(a))
                    if (r != null) {
                        return r
                    }
                    {
                        var i : uint = 0u
                        while (i <= count) {
                            var d : uint
                            r = ReadLEB_u32(addr(d), addr(v.wasm), v.wasmEnd)
                            if (r != null) {
                                return r
                            }
                            var t : ValCtrlFrame? = addr(v.ctrl[0]) + end_index(uint(int(v.ctrlTop) - 1) - d, 2000)
                            let n : uint16 = all_host__v_label_n(t)
                            if (n != arity) {
                                return m3Err_typeCountMismatch
                            }
                            // Spec: each target's types must be compatible with the operand
                            // stack, not identical to the default's. In unreachable code the
                            // operands are bottom, so the targets may legitimately differ.
                            {
                                var j : uint16 = uint16(0)
                                while (int(j) < int(n)) {
                                    let want : uint8 = all_host__v_label_t(t, uint16(int(n) - 1 - int(j)))
                                    let have : uint8 = all_host__v_peek(v, j)
                                    if (int(want) != c_valBottom && int(have) != c_valBottom && want != have) {
                                        return m3Err_typeMismatch
                                    }
                                    j = uint16(uint(j) + 1)
                                }
                            }
                            i++
                        }
                    }
                    var dt : ValCtrlFrame? = addr(v.ctrl[0]) + end_index(uint(int(v.ctrlTop) - 1) - defDepth, 2000)
                    r = all_host__v_pop_labels(v, dt)
                    if (r != null) {
                        return r
                    }
                    all_host__v_unreachable(v)
                    break
                }
            }
            case(15) {
                {
                    // return
                    var ft : M3FuncType? = v._c_function.funcType
                    if (ft != null) {
                        {
                            var i : uint16 = ft.numRets
                            while (int(i) > 0) {
                                r = all_host__v_pop_expect(v, all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(ft) + 14)[int(i) - 1]), addr(a))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) - 1)
                            }
                        }
                    }
                    all_host__v_unreachable(v)
                    break
                }
            }
            case(16) {
                {
                    // ---- Call ----
                    // call
                    var idx : uint
                    r = ReadLEB_u32(addr(idx), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    if (idx >= v._c_module.numFunctions) {
                        return m3Err_unknownFunction
                    }
                    var ft : M3FuncType? = v._c_module.functions[idx].funcType
                    if (ft != null) {
                        {
                            var i : uint16 = ft.numArgs
                            while (int(i) > 0) {
                                r = all_host__v_pop_expect(v,
                                        all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(ft) + 14)[int(ft.numRets) + int(i) - 1]), addr(a))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) - 1)
                            }
                        }
                        {
                            var i : uint16 = uint16(0)
                            while (int(i) < int(ft.numRets)) {
                                r = all_host__v_push(v, all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(ft) + 14)[int(i)]))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) + 1)
                            }
                        }
                    }
                    break
                }
            }
            case(17) {
                {
                    // call_indirect
                    var typeIdx : uint
                    r = ReadLEB_u32(addr(typeIdx), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    var tableIdx : uint
                    r = ReadLEB_u32(addr(tableIdx), addr(v.wasm), v.wasmEnd)
                    if (r != null) {
                        return r
                    }
                    if (typeIdx >= v._c_module.numFuncTypes) {
                        return m3Err_unknownType
                    }
                    // the table must exist and hold funcrefs
                    if (tableIdx >= v._c_module.numTables) {
                        return m3Err_unknownTable
                    }
                    if (int(v._c_module.tables[tableIdx]._c_type) != int(M3ValueType.c_m3Type_funcref)) {
                        return m3Err_typeMismatch
                    }
                    var ft : M3FuncType? = v._c_module.funcTypes[typeIdx]
                    // table index operand
                    r = all_host__v_pop_expect(v, all_host__v_table_addrtype(v, tableIdx), addr(a))
                    if (r != null) {
                        return r
                    }
                    if (ft != null) {
                        {
                            var i : uint16 = ft.numArgs
                            while (int(i) > 0) {
                                r = all_host__v_pop_expect(v,
                                        all_host__BaseTypeOf(reinterpret<uint8?>(reinterpret<uint8?>(ft) + 14)[int(ft.numRets) + int(i) - 1]), addr(a))
                                if (r != null) {
                                    return r
                                }
                                i = uint16(uint(i) - 1)
                            }
                        }
                        {
                            var i : uint16 = uint16(0)
                            while (int(i) < int(ft.numRets)) {
