struct FILE {}

struct M3ErrorInfo {
    result : uint8?
    runtime : M3Runtime?
    _c_module : M3Module?
    _c_function : M3Function?
    file : uint8?
    line : uint
    message : uint8?
}

struct M3BacktraceFrame {
    moduleOffset : uint
    _c_function : M3Function?
    next : M3BacktraceFrame?
}

struct M3BacktraceInfo {
    frames, lastFrame : M3BacktraceFrame?
}

[c_union]
struct M3ValueUnion {
    i32 : uint
    i64 : uint64
    f32 : float
    f64 : double
    ref : void?
}

struct M3TaggedValue {
    _c_type : M3ValueType
    value : M3ValueUnion
}

struct M3ImportInfo {
    moduleUtf8, fieldUtf8 : uint8?
}

struct M3ImportContext {
    userdata : void?
    _c_function : M3Function?
}

struct M3MemoryHeader {
    runtime : M3Runtime?
    maxStack : void?
    length : uint64
    memory : M3Memory?
}

struct M3CodePageHeader {
    next : M3CodePage?
    lineIndex, numLines, sequence, usageCount : uint
}

struct M3CodePage {
    info : M3CodePageHeader
    code : void? [1]
}

struct M3FuncType {
    next : M3FuncType?
    numRets, numArgs, canonicalIndex : uint16
}

struct M3Function {
    _c_module : M3Module?
    import : M3ImportInfo
    hostMemory : M3Memory?
    resolved : M3Function?
    wasm, wasmEnd : uint8?
    names : uint8? [3]
    export_name : uint8?
    numNames : uint16
    funcType : M3FuncType?
    compiled : void ??
    maxStackSlots, numRetSlots, numRetAndArgSlots, numLocals : uint16
    numLocalBytes : uint
    ownsWasmCode : bool
    numConstantBytes : uint16
    constants : void?
}

struct M3CompilationScope {
    outer : M3CompilationScope?
    pc, patches : void ??
    depth : int
    exitStackIndex, blockStackIndex : uint16
    _c_type : M3FuncType?
    opcode : uint16
    isPolymorphic : bool
}

struct M3CatchClause {
    tag : M3Tag?
    stubSlot : void?
    labelDepth : uint
    hasRef : bool
}

struct M3Compilation {
    runtime : M3Runtime?
    _c_module : M3Module?
    wasm, wasmEnd, lastOpcodeStart : uint8?
    _c_block : M3CompilationScope
    _c_function : M3Function?
    page : M3CodePage?
    stackFirstDynamicIndex, stackIndex, slotFirstConstIndex, slotMaxConstIndex, slotFirstLocalIndex, slotFirstDynamicIndex, maxStackSlots : uint16
    constants : uint[120]
    wasmStack : uint16[8000]
    typeStack : uint8[8000]
    m3Slots : uint8[16000]
    slotMaxAllocatedIndexPlusOne : uint16
    regStackIndexPlusOne : uint16[2]
    previousOpcode : uint16
    tryClauses : M3CatchClause?
    numTryClauses : uint
    isInitExpr : bool
    gasPatch : void?
    gasCost : uint
    foldPatchPC : void ??
    foldOpcode, foldStackIndex : uint16
    foldForm : uint8
}

struct M3OpInfo {
    stackOffset : int8
    _c_type, compiler : uint8
    operations : function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>[4]
}

struct M3MemoryInfo {
    initPages, maxPages : uint64
    pageSize : uint
    hasMax, isMemory64 : bool
}

struct M3Memory {
    mallocated : M3MemoryHeader?
    numPages, maxPages, initPages : uint64
    pageSize : uint
    hasMax, isMemory64 : bool
    owner : M3Module?
    import : M3ImportInfo
    exportName : uint8?
    imported : bool
}

struct M3TableInfo {
    elemType : uint8
    initSize, maxSize : uint
    hasMax, isTable64 : bool
}

struct M3Table {
    elements : void ??
    size, maxSize : uint
    _c_type : uint8
    initExpr : uint8?
    initExprSize, initSize : uint
    hasMax, isTable64 : bool
    owner : M3Module?
    import : M3ImportInfo
    exportName : uint8?
    imported : bool
}

struct M3ElementSegment {
    initExpr, elements : uint8?
    resolved : void ??
    initExprSize, numElements, tableIndex : uint
    _c_type, mode : uint8
    isExpr, dropped : bool
}

struct M3DataSegment {
    initExpr, data : uint8?
    initExprSize, memoryRegion, size : uint
    isPassive, dropped : bool
}

[c_union]
struct anon_75 {
    i32Value : int
    i64Value : int64
    refValue : void?
}

struct M3Global {
    import : M3ImportInfo
    resolved : M3Global?
    _anon2 : anon_75
    name, initExpr : uint8?
    initExprSize : uint
    _c_type : uint8
    imported, isMutable : bool
}

struct M3Tag {
    import : M3ImportInfo
    _c_type : M3FuncType?
    name : uint8?
    imported : bool
}

struct M3Exception {
    next, prev : M3Exception?
    tag : M3Tag?
    numArgs : uint
    reified : bool
}

struct M3Module {
    runtime : M3Runtime?
    environment : M3Environment?
    wasmStart, wasmEnd, name : uint8?
    numFuncTypes : uint
    funcTypes : M3FuncType ??
    numFuncImports, numFunctions, allFunctions : uint
    functions : M3Function?
    startFunction : int
    numDataSegments : uint
    dataSegments : M3DataSegment?
    dataCount : uint
    hasDataCount : bool
    declaredFuncs : uint8?
    numGlobals : uint
    globals : M3Global?
    numTags : uint
    tags : M3Tag?
    numElementSegments : uint
    elementSegments : M3ElementSegment?
    elementSectionEnd : uint8?
    tables : M3Table ??
    numTables : uint
    memories : M3Memory ??
    numMemories : uint
    emptyMemory : M3Memory
    memory0 : M3Memory?
    next : M3Module?
}

struct M3Environment {
    funcTypes : M3FuncType?
    retFuncTypes : M3FuncType? [int(M3ValueType.c_m3Type_count)]
    numFuncTypes : uint16
    pagesReleased : M3CodePage?
    customSectionHandler : function<(var a0 : M3Module?; var a1 : uint8?; var a2 : uint8?; var a3 : uint8?) : uint8?>
}

struct M3Runtime {
    compilation : M3Compilation
    environment : M3Environment?
    pagesOpen, pagesFull : M3CodePage?
    numCodePages, numActiveCodePages : uint
    modules : M3Module?
    stack, originStack : void?
    stackSize, numStackSlots : uint
    stackLimit : void?
    lastCalled : M3Function?
    userdata : void?
    memoryLimit : uint
    skipValidation : bool
    validator : ValCtx?
    gasLimit, gasRemaining : int64
    tryDepth : uint
    pendingException, exceptions : M3Exception?
    exceptionNesting : uint
    error : M3ErrorInfo
    newCodePageSequence : uint
}

struct M3FusedCmpOps {
    branchIf, ifOp : function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>[4]
}

[c_union]
struct anon_533 {
    u : uint
    f : float
}

[c_union]
struct anon_535 {
    u : uint64
    f : double
}

struct M3HostFile {
    data : void?
    size : uint64
    handle : int64
    mapped : bool
}

struct M3ImportDesc {
    kind : uint8
    typeIndex : uint
    _c_type, isMutable : uint8
    _c_table : M3TableInfo
    memory : M3MemoryInfo
}

struct ExportName {
    ptr : uint8?
    len : uint16
}

struct ValCtrlFrame {
    opcode, height, param_count, result_count : uint16
    _c_type : M3FuncType?
    is_unreachable : bool
}

struct ValCtx {
    wasm, wasmEnd : uint8?
    _c_module : M3Module?
    _c_function : M3Function?
    opd : uint8[8000]
    opdTop : uint16
    ctrl : ValCtrlFrame[2000]
    ctrlTop : uint16
    localTypes : uint8[8000]
    numLocals : uint16
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<M3ErrorInfo>) == 56 && typeinfo alignof(type<M3ErrorInfo>) == 8, "M3ErrorInfo: clang lays it out as size 56, align 8")
    static_assert(typeinfo offsetof < result > (type<M3ErrorInfo>) == 0, "M3ErrorInfo.result: clang puts it at 0")
    static_assert(typeinfo offsetof < runtime > (type<M3ErrorInfo>) == 8, "M3ErrorInfo.runtime: clang puts it at 8")
    static_assert(typeinfo offsetof < _c_module > (type<M3ErrorInfo>) == 16, "M3ErrorInfo._c_module: clang puts it at 16")
    static_assert(typeinfo offsetof < _c_function > (type<M3ErrorInfo>) == 24, "M3ErrorInfo._c_function: clang puts it at 24")
    static_assert(typeinfo offsetof < file > (type<M3ErrorInfo>) == 32, "M3ErrorInfo.file: clang puts it at 32")
    static_assert(typeinfo offsetof < line > (type<M3ErrorInfo>) == 40, "M3ErrorInfo.line: clang puts it at 40")
    static_assert(typeinfo offsetof < message > (type<M3ErrorInfo>) == 48, "M3ErrorInfo.message: clang puts it at 48")
    static_assert(typeinfo sizeof(type<M3BacktraceFrame>) == 24 && typeinfo alignof(type<M3BacktraceFrame>) == 8,
            "M3BacktraceFrame: clang lays it out as size 24, align 8")
    static_assert(typeinfo offsetof < moduleOffset > (type<M3BacktraceFrame>) == 0, "M3BacktraceFrame.moduleOffset: clang puts it at 0")
    static_assert(typeinfo offsetof < _c_function > (type<M3BacktraceFrame>) == 8, "M3BacktraceFrame._c_function: clang puts it at 8")
    static_assert(typeinfo offsetof < next > (type<M3BacktraceFrame>) == 16, "M3BacktraceFrame.next: clang puts it at 16")
    static_assert(typeinfo sizeof(type<M3BacktraceInfo>) == 16 && typeinfo alignof(type<M3BacktraceInfo>) == 8,
            "M3BacktraceInfo: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < frames > (type<M3BacktraceInfo>) == 0, "M3BacktraceInfo.frames: clang puts it at 0")
    static_assert(typeinfo offsetof < lastFrame > (type<M3BacktraceInfo>) == 8, "M3BacktraceInfo.lastFrame: clang puts it at 8")
    static_assert(typeinfo sizeof(type<M3ValueUnion>) == 8 && typeinfo alignof(type<M3ValueUnion>) == 8, "M3ValueUnion: clang lays it out as size 8, align 8")
    static_assert(typeinfo offsetof < _storage > (type<M3ValueUnion>) == 0, "M3ValueUnion: every member sits at 0")
    static_assert(typeinfo sizeof(type<M3TaggedValue>) == 16 && typeinfo alignof(type<M3TaggedValue>) == 8,
            "M3TaggedValue: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < _c_type > (type<M3TaggedValue>) == 0, "M3TaggedValue._c_type: clang puts it at 0")
    static_assert(typeinfo offsetof < value > (type<M3TaggedValue>) == 8, "M3TaggedValue.value: clang puts it at 8")
    static_assert(typeinfo sizeof(type<M3ImportInfo>) == 16 && typeinfo alignof(type<M3ImportInfo>) == 8, "M3ImportInfo: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < moduleUtf8 > (type<M3ImportInfo>) == 0, "M3ImportInfo.moduleUtf8: clang puts it at 0")
    static_assert(typeinfo offsetof < fieldUtf8 > (type<M3ImportInfo>) == 8, "M3ImportInfo.fieldUtf8: clang puts it at 8")
    static_assert(typeinfo sizeof(type<M3ImportContext>) == 16 && typeinfo alignof(type<M3ImportContext>) == 8,
            "M3ImportContext: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < userdata > (type<M3ImportContext>) == 0, "M3ImportContext.userdata: clang puts it at 0")
    static_assert(typeinfo offsetof < _c_function > (type<M3ImportContext>) == 8, "M3ImportContext._c_function: clang puts it at 8")
    static_assert(typeinfo sizeof(type<M3MemoryHeader>) == 32 && typeinfo alignof(type<M3MemoryHeader>) == 8,
            "M3MemoryHeader: clang lays it out as size 32, align 8")
    static_assert(typeinfo offsetof < runtime > (type<M3MemoryHeader>) == 0, "M3MemoryHeader.runtime: clang puts it at 0")
    static_assert(typeinfo offsetof < maxStack > (type<M3MemoryHeader>) == 8, "M3MemoryHeader.maxStack: clang puts it at 8")
    static_assert(typeinfo offsetof < length > (type<M3MemoryHeader>) == 16, "M3MemoryHeader.length: clang puts it at 16")
    static_assert(typeinfo offsetof < memory > (type<M3MemoryHeader>) == 24, "M3MemoryHeader.memory: clang puts it at 24")
    static_assert(typeinfo sizeof(type<M3CodePageHeader>) == 24 && typeinfo alignof(type<M3CodePageHeader>) == 8,
            "M3CodePageHeader: clang lays it out as size 24, align 8")
    static_assert(typeinfo offsetof < next > (type<M3CodePageHeader>) == 0, "M3CodePageHeader.next: clang puts it at 0")
    static_assert(typeinfo offsetof < lineIndex > (type<M3CodePageHeader>) == 8, "M3CodePageHeader.lineIndex: clang puts it at 8")
    static_assert(typeinfo offsetof < numLines > (type<M3CodePageHeader>) == 12, "M3CodePageHeader.numLines: clang puts it at 12")
    static_assert(typeinfo offsetof < sequence > (type<M3CodePageHeader>) == 16, "M3CodePageHeader.sequence: clang puts it at 16")
    static_assert(typeinfo offsetof < usageCount > (type<M3CodePageHeader>) == 20, "M3CodePageHeader.usageCount: clang puts it at 20")
    static_assert(typeinfo sizeof(type<M3CodePage>) == 32 && typeinfo alignof(type<M3CodePage>) == 8, "M3CodePage: clang lays it out as size 32, align 8")
    static_assert(typeinfo offsetof < info > (type<M3CodePage>) == 0, "M3CodePage.info: clang puts it at 0")
    static_assert(typeinfo offsetof < code > (type<M3CodePage>) == 24, "M3CodePage.code: clang puts it at 24")
    static_assert(typeinfo sizeof(type<M3FuncType>) == 16 && typeinfo alignof(type<M3FuncType>) == 8, "M3FuncType: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < next > (type<M3FuncType>) == 0, "M3FuncType.next: clang puts it at 0")
    static_assert(typeinfo offsetof < numRets > (type<M3FuncType>) == 8, "M3FuncType.numRets: clang puts it at 8")
    static_assert(typeinfo offsetof < numArgs > (type<M3FuncType>) == 10, "M3FuncType.numArgs: clang puts it at 10")
    static_assert(typeinfo offsetof < canonicalIndex > (type<M3FuncType>) == 12, "M3FuncType.canonicalIndex: clang puts it at 12")
    static_assert(typeinfo sizeof(type<M3Function>) == 136 && typeinfo alignof(type<M3Function>) == 8, "M3Function: clang lays it out as size 136, align 8")
    static_assert(typeinfo offsetof < _c_module > (type<M3Function>) == 0, "M3Function._c_module: clang puts it at 0")
    static_assert(typeinfo offsetof < import > (type<M3Function>) == 8, "M3Function.import: clang puts it at 8")
    static_assert(typeinfo offsetof < hostMemory > (type<M3Function>) == 24, "M3Function.hostMemory: clang puts it at 24")
    static_assert(typeinfo offsetof < resolved > (type<M3Function>) == 32, "M3Function.resolved: clang puts it at 32")
    static_assert(typeinfo offsetof < wasm > (type<M3Function>) == 40, "M3Function.wasm: clang puts it at 40")
    static_assert(typeinfo offsetof < wasmEnd > (type<M3Function>) == 48, "M3Function.wasmEnd: clang puts it at 48")
    static_assert(typeinfo offsetof < names > (type<M3Function>) == 56, "M3Function.names: clang puts it at 56")
    static_assert(typeinfo offsetof < export_name > (type<M3Function>) == 80, "M3Function.export_name: clang puts it at 80")
    static_assert(typeinfo offsetof < numNames > (type<M3Function>) == 88, "M3Function.numNames: clang puts it at 88")
    static_assert(typeinfo offsetof < funcType > (type<M3Function>) == 96, "M3Function.funcType: clang puts it at 96")
    static_assert(typeinfo offsetof < compiled > (type<M3Function>) == 104, "M3Function.compiled: clang puts it at 104")
    static_assert(typeinfo offsetof < maxStackSlots > (type<M3Function>) == 112, "M3Function.maxStackSlots: clang puts it at 112")
    static_assert(typeinfo offsetof < numRetSlots > (type<M3Function>) == 114, "M3Function.numRetSlots: clang puts it at 114")
    static_assert(typeinfo offsetof < numRetAndArgSlots > (type<M3Function>) == 116, "M3Function.numRetAndArgSlots: clang puts it at 116")
    static_assert(typeinfo offsetof < numLocals > (type<M3Function>) == 118, "M3Function.numLocals: clang puts it at 118")
    static_assert(typeinfo offsetof < numLocalBytes > (type<M3Function>) == 120, "M3Function.numLocalBytes: clang puts it at 120")
    static_assert(typeinfo offsetof < ownsWasmCode > (type<M3Function>) == 124, "M3Function.ownsWasmCode: clang puts it at 124")
    static_assert(typeinfo offsetof < numConstantBytes > (type<M3Function>) == 126, "M3Function.numConstantBytes: clang puts it at 126")
    static_assert(typeinfo offsetof < constants > (type<M3Function>) == 128, "M3Function.constants: clang puts it at 128")
    static_assert(typeinfo sizeof(type<M3CompilationScope>) == 48 && typeinfo alignof(type<M3CompilationScope>) == 8,
            "M3CompilationScope: clang lays it out as size 48, align 8")
    static_assert(typeinfo offsetof < outer > (type<M3CompilationScope>) == 0, "M3CompilationScope.outer: clang puts it at 0")
    static_assert(typeinfo offsetof < pc > (type<M3CompilationScope>) == 8, "M3CompilationScope.pc: clang puts it at 8")
    static_assert(typeinfo offsetof < patches > (type<M3CompilationScope>) == 16, "M3CompilationScope.patches: clang puts it at 16")
    static_assert(typeinfo offsetof < depth > (type<M3CompilationScope>) == 24, "M3CompilationScope.depth: clang puts it at 24")
    static_assert(typeinfo offsetof < exitStackIndex > (type<M3CompilationScope>) == 28, "M3CompilationScope.exitStackIndex: clang puts it at 28")
    static_assert(typeinfo offsetof < blockStackIndex > (type<M3CompilationScope>) == 30, "M3CompilationScope.blockStackIndex: clang puts it at 30")
    static_assert(typeinfo offsetof < _c_type > (type<M3CompilationScope>) == 32, "M3CompilationScope._c_type: clang puts it at 32")
    static_assert(typeinfo offsetof < opcode > (type<M3CompilationScope>) == 40, "M3CompilationScope.opcode: clang puts it at 40")
    static_assert(typeinfo offsetof < isPolymorphic > (type<M3CompilationScope>) == 42, "M3CompilationScope.isPolymorphic: clang puts it at 42")
    static_assert(typeinfo sizeof(type<M3CatchClause>) == 24 && typeinfo alignof(type<M3CatchClause>) == 8,
            "M3CatchClause: clang lays it out as size 24, align 8")
    static_assert(typeinfo offsetof < tag > (type<M3CatchClause>) == 0, "M3CatchClause.tag: clang puts it at 0")
    static_assert(typeinfo offsetof < stubSlot > (type<M3CatchClause>) == 8, "M3CatchClause.stubSlot: clang puts it at 8")
    static_assert(typeinfo offsetof < labelDepth > (type<M3CatchClause>) == 16, "M3CatchClause.labelDepth: clang puts it at 16")
    static_assert(typeinfo offsetof < hasRef > (type<M3CatchClause>) == 20, "M3CatchClause.hasRef: clang puts it at 20")
    static_assert(typeinfo sizeof(type<M3Compilation>) == 40656 && typeinfo alignof(type<M3Compilation>) == 8,
            "M3Compilation: clang lays it out as size 40656, align 8")
