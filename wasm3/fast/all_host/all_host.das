[unsafe_deref, hint(unsafe_range_check)]
def private all_host__PushBlockResults(var o : M3Compilation?) : uint8? {
    var result : uint8? = m3Err_none
    let numResults : uint16 = GetFuncTypeNumResults(o._c_block._c_type)
    {
        var i : uint16 = uint16(0)
        while (int(i) < int(numResults)) {
            let _c_type : uint8 = GetFuncTypeResultType(o._c_block._c_type, i)
            if (int(i) == int(numResults) - 1 && IsFpType(_c_type)) {
                result = all_host__PushRegister(o, _c_type)
                if (result != null) {
                    goto label 1
                }
            } else {
                result = all_host__PushAllocatedSlot(o, _c_type)
                if (result != null) {
                    goto label 1
                }
            }
            i = uint16(uint(i) + 1)
        }
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def CompileBlock(var o : M3Compilation?; var i_blockType : M3FuncType?; i_blockOpcode : uint16) : uint8? {
    all_host__InvalidateFold(o)
    var outerScope : M3CompilationScope = o._c_block
    var _c_block : M3CompilationScope? = addr(o._c_block)
    _c_block.outer = addr(outerScope)
    _c_block.pc = GetPagePC(o.page)
    _c_block.patches = null
    _c_block._c_type = i_blockType
    _c_block.opcode = i_blockOpcode
    _c_block.depth++
    // The block stack frame is a little strange but for good reasons. Because blocks need to be restarted to
    // compile different pathways (if/else), the incoming params must be saved. The parameters are popped
    // and validated. But, then the stack top is readjusted so they aren't subsequently overwritten.
    // Next, the result are preallocated to find destination slots. But again these are immediately popped
    // (deallocated) and the stack top is readjusted to keep these records in pace. This allows branch instructions
    // to find their result landing pads. Finally, the params are copied from the "dead" records and pushed back
    // onto the stack as active stack items for the CompileBlockStatements () call.
    // [ block ]
    // [ params ]
    // ------------------
    // [ result ] <---- blockStackIndex
    // [ slots ]
    // ------------------
    // [ saved param ]
    // [ records ]
    // <----- exitStackIndex
    var result : uint8? = m3Err_none
    {
        // validate and dealloc params ----------------------------
        var stackIndex : uint16 = o.stackIndex
        let numParams : uint16 = GetFuncTypeNumParams(i_blockType)
        if (int(i_blockOpcode) != int(anon_315.c_waOp_else)) {
            {
