        if (o.gasPatch != null && o.gasCost > d_m3MaxSegmentGas - cost) {
            all_host__CloseGasSegment(o)
        }
        if (o.gasPatch == null) {
            result = all_host__EmitOp(o, @@all_host__op_UseGas)
            if (result != null) {
                goto label 1
            }
            o.gasPatch = reinterpret<void?>(GetPagePC(o.page))
            all_host__EmitConstant32(o, 0u)
        }
        o.gasCost += cost
        if (all_host__IsGasSegmentEnd(i_opcode)) {
            all_host__CloseGasSegment(o)
        }
    }
    label 1:  // _catch
    return result
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
