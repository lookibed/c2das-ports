[unsafe_deref, hint(unsafe_range_check)]
def private all_host__Compile_Select(var o : M3Compilation?; i_opcode : uint16) : uint8? {
    var result : uint8? = m3Err_none
    var slots : uint16[3] = fixed_array(all_host__c_slotUnused, all_host__c_slotUnused, all_host__c_slotUnused)
    var op : function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?> = default<function<(var a0 : void ??; var a1 : uint?; var a2 : M3MemoryHeader?; a3 : int64) : void?>>
    // get type of selection
    let _c_type : uint8 = all_host__GetStackTypeFromTop(o, uint16(1))
    if (!all_host__IsStackPolymorphic(o)) {
