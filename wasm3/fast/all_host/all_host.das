// o_type, when asked for, reports what the expression leaves on the stack, so
// the caller can check it against the type the expression is initializing.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def Parse_InitExprTyped(var io_module : M3Module?; var io_bytes : uint8 ??; var i_end : uint8?; var o_type : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    // this doesn't generate code pages. just walks the wasm bytecode to find the end
    var compilation : M3Compilation
    compilation = M3Compilation(runtime = null, _c_module = io_module, wasm = *io_bytes, wasmEnd = i_end, isInitExpr = 1 != 0)
    result = CompileBlockStatements(addr(compilation))
    *io_bytes = compilation.wasm
    if (o_type != null) {
        *o_type = uint8(compilation.stackIndex != 0 ? int(compilation.typeStack[int(compilation.stackIndex) - 1]) : int(uint8(M3ValueType.c_m3Type_none)))
    }
    return result
}

[unsafe_deref, hint(unsafe_range_check)]
def Parse_InitExpr(var io_module : M3Module?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    return Parse_InitExprTyped(io_module, io_bytes, i_end, null)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def ParseSection_Element(var io_module : M3Module?; var i_bytes : uint8?; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    var numSegments : uint
    var pos : uint8?
    result = ReadLEB_u32(addr(numSegments), addr(i_bytes), i_end)
