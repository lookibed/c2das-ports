    }
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_SetGasLimit(var i_runtime : M3Runtime?; i_gas : double) {
    if (i_runtime != null) {
        // A budget bigger than the counter can hold is the same as no ceiling
        // worth speaking of, so it saturates rather than wrapping
        let maxGas : double = double(9223372036854775807l) / double(d_m3GasUnitsPerGas)
        var units : int64
        if (i_gas >= maxGas) {
            units = 9223372036854775807l
        } elif (i_gas > 0.0lf) {
            units = int64(i_gas * double(d_m3GasUnitsPerGas))
        } else {
            units = 0l
        }
        i_runtime.gasRemaining = units
        i_runtime.gasLimit = i_runtime.gasRemaining
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetGasLimit(var i_runtime : M3Runtime?) : double {
    if (i_runtime != null) {
        return double(i_runtime.gasLimit) / double(d_m3GasUnitsPerGas)
    }
    return 0.0lf
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetGasUsed(var i_runtime : M3Runtime?) : double {
    if (i_runtime != null) {
        return double(i_runtime.gasLimit - i_runtime.gasRemaining) / double(d_m3GasUnitsPerGas)
    }
    return 0.0lf
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_GetUserData(var i_runtime : M3Runtime?) : void? {
    return i_runtime != null ? i_runtime.userdata : null
}

[unsafe_deref, hint(unsafe_range_check)]
def ForEachModule(var i_runtime : M3Runtime?; i_visitor : function<(var a0 : M3Module?; var a1 : void?) : void?>; var i_info : void?) : void? {
    var r : void? = null
    var _c_module : M3Module? = i_runtime.modules
    while (_c_module != null) {
        var next : M3Module? = _c_module.next
        r = invoke(i_visitor, _c_module, i_info)
        if (r != null) {
            break
        }
        _c_module = next
    }
    return r
}

[unsafe_deref, hint(unsafe_range_check)]
def _FreeModule(var i_module : M3Module?; var i_info : void?) : void? {
    m3_FreeModule(i_module)
    return null
}

// A module's memory and table index spaces hold borrowed pointers: linking
// repoints an imported slot at the memory or table the exporting module owns.
// m3_FreeModule tells a borrowed slot from an owned one by reading that owner,
// which only holds while the object is still allocated - and the free walk
// below visits modules in load order, with no ordering between an owner and
// the modules borrowing from it. So clear the borrowed slots first, in a pass
// that frees nothing; the walk then skips them on the NULL check it already
// does, instead of reading a memory some earlier module has freed.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def _ReleaseBorrowedSlots(var i_module : M3Module?; var i_info : void?) : void? {
    {
        var i : uint = 0u
        while (i < i_module.numMemories) {
            var memory : M3Memory? = i_module.memories[i]
            if (memory != null && intptr(memory.owner) != intptr(i_module)) {
                i_module.memories[i] = null
            }
            i++
        }
    }
    {
        var i : uint = 0u
        while (i < i_module.numTables) {
            var _c_table : M3Table? = i_module.tables[i]
            if (_c_table != null && intptr(_c_table.owner) != intptr(i_module)) {
                i_module.tables[i] = null
            }
            i++
        }
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def Runtime_Release(var i_runtime : M3Runtime?) {
    ForEachModule(i_runtime, @@_ReleaseBorrowedSlots, null)
    ForEachModule(i_runtime, @@_FreeModule, null)
    Environment_ReleaseCodePages(i_runtime.environment, i_runtime.pagesOpen)
    Environment_ReleaseCodePages(i_runtime.environment, i_runtime.pagesFull)
    {
        m3_Free_Impl(i_runtime.originStack)
        i_runtime.originStack = null
    }
    {
        m3_Free_Impl(reinterpret<void?>(i_runtime.validator))
        i_runtime.validator = null
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def m3_FreeRuntime(var i_runtime : M3Runtime?) {
    if (i_runtime != null) {
        m3_PrintProfilerInfo()
        Runtime_Release(i_runtime)
        m3_Free(i_runtime)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def EvaluateExpression(var i_module : M3Module?; var o_expressed : void?; i_type : uint8; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
    var result : uint8? = m3Err_none
    // OPTZ: use a simplified interpreter for expressions
    // create a temporary runtime context
    var runtime : M3Runtime
    crt::memset(reinterpret<void?>(addr(runtime)), 0, uint64(typeinfo sizeof(type<M3Runtime>)))
    runtime.environment = i_module.runtime.environment
    runtime.numStackSlots = i_module.runtime.numStackSlots
    runtime.stack = i_module.runtime.stack
    var stack : uint? = reinterpret<uint?>(runtime.stack)
    var savedRuntime : M3Runtime? = i_module.runtime
    i_module.runtime = addr(runtime)
    var o : M3Compilation? = addr(runtime.compilation)
    o.runtime = addr(runtime)
    o._c_module = i_module
    o.wasm = *io_bytes
    o.wasmEnd = i_end
    o.lastOpcodeStart = o.wasm
    // Borrowed for the length of this expression only. Runtime_Release below hands it
    // to Environment_ReleaseCodePages, which resets lineIndex, so the page comes back
    // empty and the next expression reuses it rather than burning fresh lines.
    o.page = AcquireCodePage(addr(runtime))
    if (o.page != null) {
        var ftype : M3FuncType? = runtime.environment.retFuncTypes[int(all_host__BaseTypeOf(i_type))]
        var m3code : void ?? = GetPagePC(o.page)
        result = CompileExpression(o, ftype)
        if (result == null && uint(o.maxStackSlots) >= runtime.numStackSlots) {
            result = m3Err_trapStackOverflow
        }
        if (result == null) {
            var r : void? = all_host__RunCode(m3code, stack, null, int64(d_m3OpDefaultArgs))
            if (r == null) {
                if (uint64(SizeOfType(all_host__BaseTypeOf(i_type))) == uint64(typeinfo sizeof(type<uint>))) {
                    *reinterpret<uint?>(o_expressed) = *stack
                } else {
                    *reinterpret<uint64?>(o_expressed) = *reinterpret<uint64?>(stack)
                }
            }
        }
        ReleaseCodePage(addr(runtime), o.page)
    } else {
        result = m3Err_mallocFailedCodePage
    }
