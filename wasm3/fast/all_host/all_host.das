[c_function, unsafe_deref, hint(unsafe_range_check)]
def ReadMemoryArg(var o_align : uint?; var o_memoryIdx : uint?; var o_offset : uint64?; var io_bytes : uint8 ??; var i_end : uint8?) : uint8? {
