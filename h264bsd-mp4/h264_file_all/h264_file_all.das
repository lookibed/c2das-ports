    var j : uint
    var hor : uint
    var ver : uint
    var mbNum : uint
    var width : uint
    var height : uint
    var mbPos : uint8?
    var data : uint8[384]
    var pData : uint8?
    var tmp : int
    var firstPhase : int[16]
