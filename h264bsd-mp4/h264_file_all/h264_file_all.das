    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pFullFrameFreeze.fullFrameFreezeRepetitionPeriod > uint(16384)) {
        return uint(HANTRO_NOK)
    }
    return uint(HANTRO_OK)
}

