    return addr(h264_file_all__N_D_4x4B[0]) + blockIndex
}

[c_function]
def h264bsdIsNeighbourAvailable(var pMb : mbStorage?; var pNeighbour : mbStorage?) : uint {
    // Variables
    // Code
    if (pNeighbour == null || pMb.sliceId != pNeighbour.sliceId) {
        return uint(HANTRO_FALSE)
    } else {
        return uint(HANTRO_TRUE)
    }
}

[c_function]
def h264bsdDecodePicOrderCnt(var poc : pocStorage_t?; var sps : seqParamSet_t?; var pSliceHeader : sliceHeader_t?; var pNalUnit : nalUnit_t?) : int {
    // Variables
    var i : uint
    var picOrderCnt : int
    var frameNumOffset : uint
    var absFrameNum : uint
    var picOrderCntCycleCnt : uint
    var frameNumInPicOrderCntCycle : uint
    var expectedDeltaPicOrderCntCycle : int
    var containsMmco5 : uint
    // Code
    // JanSa: I don't think this is necessary, don't see any reason to
    // increment prevFrameNum one by one instead of one big increment.
    // However, standard specifies that this should be done -> if someone
    // figures out any case when the outcome would be different for step by
    // step increment, this part of the code should be enabled
    // if there was a gap in frame numbering and picOrderCntType is 1 or 2 ->
    // "compute" pic order counts for non-existing frames. These are not
    // actually computed, but process needs to be done to update the
    // prevFrameNum and prevFrameNumOffset
    // use variable i for unUsedShortTermFrameNum
    // check if current slice includes mmco equal to 5
    containsMmco5 = uint(HANTRO_FALSE)
    if (pSliceHeader.decRefPicMarking.adaptiveRefPicMarkingModeFlag != 0) {
        i = uint(0)
        while (pSliceHeader.decRefPicMarking.operation[i].memoryManagementControlOperation != 0) {
            if (pSliceHeader.decRefPicMarking.operation[i].memoryManagementControlOperation == uint(5)) {
                containsMmco5 = uint(HANTRO_TRUE)
                break
            }
            i++
        }
    }
    let _cond = sps.picOrderCntType
    if (_cond == 0u) {
        // set prevPicOrderCnt values for IDR frame
        if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
            poc.prevPicOrderCntMsb = 0
            poc.prevPicOrderCntLsb = uint(0)
        }
        // compute picOrderCntMsb (stored in picOrderCnt variable)
        if (pSliceHeader.picOrderCntLsb < poc.prevPicOrderCntLsb && poc.prevPicOrderCntLsb - pSliceHeader.picOrderCntLsb >= sps.maxPicOrderCntLsb / uint(2)) {
            picOrderCnt = poc.prevPicOrderCntMsb + int(sps.maxPicOrderCntLsb)
        } elif (pSliceHeader.picOrderCntLsb > poc.prevPicOrderCntLsb && pSliceHeader.picOrderCntLsb - poc.prevPicOrderCntLsb > sps.maxPicOrderCntLsb / uint(2)) {
            picOrderCnt = poc.prevPicOrderCntMsb - int(sps.maxPicOrderCntLsb)
        } else {
            picOrderCnt = poc.prevPicOrderCntMsb
        }
        // standard specifies that prevPicOrderCntMsb is from previous
        // rererence frame -> replace old value only if current frame is
        // rererence frame
        if (pNalUnit.nalRefIdc != 0) {
            poc.prevPicOrderCntMsb = picOrderCnt
        }
        // compute top field order cnt (stored in picOrderCnt)
        picOrderCnt += int(pSliceHeader.picOrderCntLsb)
        // if delta for bottom field is negative -> bottom will be the
        // minimum pic order count
        if (pSliceHeader.deltaPicOrderCntBottom < 0) {
            picOrderCnt += pSliceHeader.deltaPicOrderCntBottom
        }
        // standard specifies that prevPicOrderCntLsb is from previous
        // rererence frame -> replace old value only if current frame is
        // rererence frame
        if (pNalUnit.nalRefIdc != 0) {
            // if current frame contains mmco5 -> modify values to be
            // stored
            if (containsMmco5 != 0) {
                poc.prevPicOrderCntMsb = 0
                // prevPicOrderCntLsb should be the top field picOrderCnt
                // if previous frame included mmco5. Top field picOrderCnt
                // for frames containing mmco5 is obtained by subtracting
                // the picOrderCnt from original top field order count ->
                // value is zero if top field was the minimum, i.e. delta
                // for bottom was positive, otherwise value is
                // -deltaPicOrderCntBottom
                if (pSliceHeader.deltaPicOrderCntBottom < 0) {
                    poc.prevPicOrderCntLsb = uint(-pSliceHeader.deltaPicOrderCntBottom)
                } else {
                    poc.prevPicOrderCntLsb = uint(0)
                }
                picOrderCnt = 0
            } else {
                poc.prevPicOrderCntLsb = pSliceHeader.picOrderCntLsb
            }
        }
    } elif (_cond == 1u) {
        // step 1 (in the description in the standard)
        if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
            frameNumOffset = uint(0)
        } elif (poc.prevFrameNum > pSliceHeader.frameNum) {
            frameNumOffset = poc.prevFrameNumOffset + sps.maxFrameNum
        } else {
            frameNumOffset = poc.prevFrameNumOffset
        }
        // step 2
        if (sps.numRefFramesInPicOrderCntCycle != 0) {
            absFrameNum = frameNumOffset + pSliceHeader.frameNum
        } else {
            absFrameNum = uint(0)
        }
        if (pNalUnit.nalRefIdc == uint(0) && absFrameNum > uint(0)) {
            absFrameNum -= uint(1)
        }
        // step 3
        if (absFrameNum > uint(0)) {
            picOrderCntCycleCnt = (absFrameNum - uint(1)) / sps.numRefFramesInPicOrderCntCycle
            frameNumInPicOrderCntCycle = (absFrameNum - uint(1)) % sps.numRefFramesInPicOrderCntCycle
        }
        // step 4
        expectedDeltaPicOrderCntCycle = 0
        {
            i = uint(0)
            while (i < sps.numRefFramesInPicOrderCntCycle) {
                expectedDeltaPicOrderCntCycle += deref(sps.offsetForRefFrame + i)
                i++
            }
        }
        // step 5 (picOrderCnt used to store expectedPicOrderCnt)
        // lint -esym(644,picOrderCntCycleCnt) always initialized
        // lint -esym(644,frameNumInPicOrderCntCycle) always initialized
        if (absFrameNum > uint(0)) {
            picOrderCnt = int(picOrderCntCycleCnt) * expectedDeltaPicOrderCntCycle
            {
                i = uint(0)
                while (i <= frameNumInPicOrderCntCycle) {
                    picOrderCnt += deref(sps.offsetForRefFrame + i)
                    i++
                }
            }
        } else {
            picOrderCnt = 0
        }
        if (pNalUnit.nalRefIdc == uint(0)) {
            picOrderCnt += sps.offsetForNonRefPic
        }
        // step 6 (picOrderCnt is top field order cnt if delta for bottom
        // is positive, otherwise it is bottom field order cnt)
        picOrderCnt += pSliceHeader.deltaPicOrderCnt[0]
        if (sps.offsetForTopToBottomField + pSliceHeader.deltaPicOrderCnt[1] < 0) {
            picOrderCnt += sps.offsetForTopToBottomField + pSliceHeader.deltaPicOrderCnt[1]
        }
        // if current picture contains mmco5 -> set prevFrameNumOffset and
        // prevFrameNum to 0 for computation of picOrderCnt of next
        // frame, otherwise store frameNum and frameNumOffset to poc
        // structure
        if (!(containsMmco5 != 0)) {
            poc.prevFrameNumOffset = frameNumOffset
            poc.prevFrameNum = pSliceHeader.frameNum
        } else {
            poc.prevFrameNumOffset = uint(0)
            poc.prevFrameNum = uint(0)
            picOrderCnt = 0
        }
    } else {
        // case 2
        // derive frameNumOffset
        if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
            frameNumOffset = uint(0)
        } elif (poc.prevFrameNum > pSliceHeader.frameNum) {
            frameNumOffset = poc.prevFrameNumOffset + sps.maxFrameNum
        } else {
            frameNumOffset = poc.prevFrameNumOffset
        }
        // derive picOrderCnt (type 2 has same value for top and bottom
        // field order cnts)
        if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
            picOrderCnt = 0
        } elif (pNalUnit.nalRefIdc == uint(0)) {
            picOrderCnt = 2 * int(frameNumOffset + pSliceHeader.frameNum) - 1
        } else {
            picOrderCnt = 2 * int(frameNumOffset + pSliceHeader.frameNum)
        }
        // if current picture contains mmco5 -> set prevFrameNumOffset and
        // prevFrameNum to 0 for computation of picOrderCnt of next
        // frame, otherwise store frameNum and frameNumOffset to poc
        // structure
        if (!(containsMmco5 != 0)) {
            poc.prevFrameNumOffset = frameNumOffset
            poc.prevFrameNum = pSliceHeader.frameNum
        } else {
            poc.prevFrameNumOffset = uint(0)
            poc.prevFrameNum = uint(0)
            picOrderCnt = 0
        }
    }
    // lint -esym(644,picOrderCnt) always initialized
    return picOrderCnt
}

[c_function]
def h264bsdDecodePicParamSet(var pStrmData : strmData_t?; var pPicParamSet : picParamSet_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var value : uint
    var itmp : int
    // Code
    memset1(reinterpret<void?>(pPicParamSet), 0, uint64(typeinfo sizeof(type<picParamSet_t>)))
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPicParamSet.picParameterSetId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pPicParamSet.picParameterSetId >= uint(MAX_NUM_PIC_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPicParamSet.seqParameterSetId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pPicParamSet.seqParameterSetId >= uint(MAX_NUM_SEQ_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    // entropy_coding_mode_flag, shall be 0 for baseline profile
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp != 0) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.picOrderPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    // num_slice_groups_minus1
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pPicParamSet.numSliceGroups = value + uint(1)
    if (pPicParamSet.numSliceGroups > uint(MAX_NUM_SLICE_GROUPS)) {
        return uint(HANTRO_NOK)
    }
    // decode slice group mapping information if more than one slice groups
    if (pPicParamSet.numSliceGroups > uint(1)) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPicParamSet.sliceGroupMapType))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pPicParamSet.sliceGroupMapType > uint(6)) {
            return uint(HANTRO_NOK)
        }
        if (pPicParamSet.sliceGroupMapType == uint(0)) {
            {
                pPicParamSet.runLength = reinterpret<uint?>(malloc1(uint64(pPicParamSet.numSliceGroups) * uint64(typeinfo sizeof(type<uint>))))
            }
            if (pPicParamSet.runLength == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            {
                i = uint(0)
                while (i < pPicParamSet.numSliceGroups) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    deref(pPicParamSet.runLength + i) = value + uint(1)
                    i++
                }
            }
        } elif (pPicParamSet.sliceGroupMapType == uint(2)) {
            {
                // param values checked in CheckPps()
                pPicParamSet.topLeft = reinterpret<uint?>(malloc1(uint64(pPicParamSet.numSliceGroups - uint(1)) * uint64(typeinfo sizeof(type<uint>))))
            }
            {
                pPicParamSet.bottomRight = reinterpret<uint?>(malloc1(uint64(pPicParamSet.numSliceGroups - uint(1)) * uint64(typeinfo sizeof(type<uint>))))
            }
            if (pPicParamSet.topLeft == null || pPicParamSet.bottomRight == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            {
                i = uint(0)
                while (i < pPicParamSet.numSliceGroups - uint(1)) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    deref(pPicParamSet.topLeft + i) = value
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    deref(pPicParamSet.bottomRight + i) = value
                    i++
                }
            }
        } elif (pPicParamSet.sliceGroupMapType == uint(3) || pPicParamSet.sliceGroupMapType == uint(4) || pPicParamSet.sliceGroupMapType == uint(5)) {
            // param values checked in CheckPps()
            tmp = h264bsdGetBits(pStrmData, uint(1))
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pPicParamSet.sliceGroupChangeDirectionFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pPicParamSet.sliceGroupChangeRate = value + uint(1)
        } elif (pPicParamSet.sliceGroupMapType == uint(6)) {
            // param value checked in CheckPps()
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pPicParamSet.picSizeInMapUnits = value + uint(1)
            {
                pPicParamSet.sliceGroupId = reinterpret<uint?>(malloc1(uint64(pPicParamSet.picSizeInMapUnits) * uint64(typeinfo sizeof(type<uint>))))
            }
            if (pPicParamSet.sliceGroupId == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            // determine number of bits needed to represent range
            // [0, numSliceGroups)
            tmp = h264_file_all__CeilLog2NumSliceGroups[pPicParamSet.numSliceGroups - uint(1)]
            {
                i = uint(0)
                while (i < pPicParamSet.picSizeInMapUnits) {
                    deref(pPicParamSet.sliceGroupId + i) = h264bsdGetBits(pStrmData, tmp)
                    if (deref(pPicParamSet.sliceGroupId + i) >= pPicParamSet.numSliceGroups) {
                        return uint(HANTRO_NOK)
                    }
                    i++
                }
            }
        }
    }
    // num_ref_idx_l0_active_minus1
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > uint(31)) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.numRefIdxL0Active = value + uint(1)
    // num_ref_idx_l1_active_minus1
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > uint(31)) {
        return uint(HANTRO_NOK)
    }
    // weighted_pred_flag, this shall be 0 for baseline profile
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp != 0) {
        return uint(HANTRO_NOK)
    }
    // weighted_bipred_idc
    tmp = h264bsdGetBits(pStrmData, uint(2))
    if (tmp > uint(2)) {
        return uint(HANTRO_NOK)
    }
    // pic_init_qp_minus26
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (itmp < -26 || itmp > 25) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.picInitQp = uint(itmp + 26)
    // pic_init_qs_minus26
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (itmp < -26 || itmp > 25) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (itmp < -12 || itmp > 12) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.chromaQpIndexOffset = itmp
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.deblockingFilterControlPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.constrainedIntraPredFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.redundantPicCntPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdRbspTrailingBits(pStrmData)
    // ignore possible errors in trailing bits of parameters sets
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdInterpolateChromaHor
// Functional description:
// This function performs chroma interpolation in horizontal direction.
// Overfilling is done only if needed. Reference image (pRef) is
// read at correct position and the predicted part is written to
// macroblock's chrominance (predPartChroma)
// Inputs:
// pRef pointer to reference frame Cb top-left corner
// x0 integer x-coordinate for prediction
// y0 integer y-coordinate for prediction
// width width of the reference frame chrominance in pixels
// height height of the reference frame chrominance in pixels
// xFrac horizontal fraction for prediction in 1/8 pixels
// chromaPartWidth width of the predicted part in pixels
// chromaPartHeight height of the predicted part in pixels
// Outputs:
// predPartChroma pointer where predicted part is written
// ------------------------------------------------------------------------------
[c_function]
def h264bsdInterpolateChromaHor(var pRef : uint8?; var predPartChroma : uint8?; var x0 : int; var y0 : int; var width : uint; var height : uint; xFrac : uint; chromaPartWidth : uint; chromaPartHeight : uint) {
    // Variables
    var x : uint
    var y : uint
    var tmp1 : uint
    var tmp2 : uint
    var tmp3 : uint
    var tmp4 : uint
    var c : uint
    var val : uint
    var ptrA : uint8?
    var cbr : uint8?
    var comp : uint
    var _c_block : uint8[144]
    // Code
    if (x0 < 0 || uint(x0) + chromaPartWidth + uint(1) > width || y0 < 0 || uint(y0) + chromaPartHeight > height) {
        h264bsdFillBlock(pRef, addr(_c_block[0]), x0, y0, width, height, chromaPartWidth + uint(1), chromaPartHeight, chromaPartWidth + uint(1))
        pRef = pRef + width * height
        h264bsdFillBlock(pRef, addr(_c_block[0]) + (chromaPartWidth + uint(1)) * chromaPartHeight, x0, y0, width, height, chromaPartWidth + uint(1), chromaPartHeight, chromaPartWidth + uint(1))
        pRef = addr(_c_block[0])
        x0 = 0
        y0 = 0
        width = chromaPartWidth + uint(1)
        height = chromaPartHeight
    }
    val = uint(8) - xFrac
    {
        comp = uint(0)
        while (comp <= uint(1)) {
            ptrA = pRef + (comp * height + uint(y0)) * width + x0
            cbr = predPartChroma + comp * uint(8) * uint(8)
            // 2x2 pels per iteration
            // bilinear horizontal interpolation
            {
                y = chromaPartHeight >> 1u
                while (y != 0) {
                    {
                        x = chromaPartWidth >> 1u
                        while (x != 0) {
                            tmp1 = uint(deref(ptrA + width))
                            var _t0 = ptrA
                            ptrA = ptrA + 1
                            tmp2 = uint(deref(_t0))
                            tmp3 = uint(deref(ptrA + width))
                            var _t1 = ptrA
                            ptrA = ptrA + 1
                            tmp4 = uint(deref(_t1))
                            c = (val * tmp1 + xFrac * tmp3 << 3u) + uint(32)
                            c >>= 6u
                            deref(cbr + 8) = uint8(c)
                            c = (val * tmp2 + xFrac * tmp4 << 3u) + uint(32)
                            c >>= 6u
                            var _t2 = cbr
                            cbr = cbr + 1
                            deref(_t2) = uint8(c)
                            tmp1 = uint(deref(ptrA + width))
                            tmp2 = uint(deref(ptrA))
                            c = (val * tmp3 + xFrac * tmp1 << 3u) + uint(32)
                            c >>= 6u
                            deref(cbr + 8) = uint8(c)
                            c = (val * tmp4 + xFrac * tmp2 << 3u) + uint(32)
                            c >>= 6u
                            var _t3 = cbr
                            cbr = cbr + 1
                            deref(_t3) = uint8(c)
                            x--
                        }
                    }
                    cbr = cbr + (uint(2 * 8) - chromaPartWidth)
                    ptrA = ptrA + (uint(2) * width - chromaPartWidth)
                    y--
                }
            }
            comp++
        }
    }
}

[c_function]
def h264bsdInterpolateChromaVer(var pRef : uint8?; var predPartChroma : uint8?; var x0 : int; var y0 : int; var width : uint; var height : uint; yFrac : uint; chromaPartWidth : uint; chromaPartHeight : uint) {
    // Variables
    var x : uint
    var y : uint
    var tmp1 : uint
    var tmp2 : uint
    var tmp3 : uint
    var c : uint
    var val : uint
    var ptrA : uint8?
    var cbr : uint8?
    var comp : uint
    var _c_block : uint8[144]
    // Code
    if (x0 < 0 || uint(x0) + chromaPartWidth > width || y0 < 0 || uint(y0) + chromaPartHeight + uint(1) > height) {
        h264bsdFillBlock(pRef, addr(_c_block[0]), x0, y0, width, height, chromaPartWidth, chromaPartHeight + uint(1), chromaPartWidth)
        pRef = pRef + width * height
        h264bsdFillBlock(pRef, addr(_c_block[0]) + chromaPartWidth * (chromaPartHeight + uint(1)), x0, y0, width, height, chromaPartWidth, chromaPartHeight + uint(1), chromaPartWidth)
        pRef = addr(_c_block[0])
        x0 = 0
        y0 = 0
        width = chromaPartWidth
        height = chromaPartHeight + uint(1)
    }
    val = uint(8) - yFrac
    {
        comp = uint(0)
        while (comp <= uint(1)) {
            ptrA = pRef + (comp * height + uint(y0)) * width + x0
            cbr = predPartChroma + comp * uint(8) * uint(8)
            // 2x2 pels per iteration
            // bilinear vertical interpolation
            {
                y = chromaPartHeight >> 1u
                while (y != 0) {
                    {
                        x = chromaPartWidth >> 1u
                        while (x != 0) {
                            tmp3 = uint(deref(ptrA + width * uint(2)))
                            tmp2 = uint(deref(ptrA + width))
                            var _t0 = ptrA
                            ptrA = ptrA + 1
                            tmp1 = uint(deref(_t0))
                            c = (val * tmp2 + yFrac * tmp3 << 3u) + uint(32)
                            c >>= 6u
                            deref(cbr + 8) = uint8(c)
                            c = (val * tmp1 + yFrac * tmp2 << 3u) + uint(32)
                            c >>= 6u
                            var _t1 = cbr
                            cbr = cbr + 1
                            deref(_t1) = uint8(c)
                            tmp3 = uint(deref(ptrA + width * uint(2)))
                            tmp2 = uint(deref(ptrA + width))
                            var _t2 = ptrA
                            ptrA = ptrA + 1
                            tmp1 = uint(deref(_t2))
                            c = (val * tmp2 + yFrac * tmp3 << 3u) + uint(32)
                            c >>= 6u
                            deref(cbr + 8) = uint8(c)
                            c = (val * tmp1 + yFrac * tmp2 << 3u) + uint(32)
                            c >>= 6u
                            var _t3 = cbr
                            cbr = cbr + 1
                            deref(_t3) = uint8(c)
                            x--
                        }
                    }
                    cbr = cbr + (uint(2 * 8) - chromaPartWidth)
                    ptrA = ptrA + (uint(2) * width - chromaPartWidth)
                    y--
                }
            }
            comp++
        }
    }
}

[c_function]
def h264bsdInterpolateChromaHorVer(var ref : uint8?; var predPartChroma : uint8?; var x0 : int; var y0 : int; var width : uint; var height : uint; xFrac : uint; yFrac : uint; chromaPartWidth : uint; chromaPartHeight : uint) {
    var _c_block : uint8[162]
    var x : uint
    var y : uint
    var tmp1 : uint
    var tmp2 : uint
    var tmp3 : uint
    var tmp4 : uint
    var tmp5 : uint
    var tmp6 : uint
    var valX : uint
    var valY : uint
    var plus32 : uint = uint(32)
    var comp : uint
    var ptrA : uint8?
    var cbr : uint8?
    // Code
    if (x0 < 0 || uint(x0) + chromaPartWidth + uint(1) > width || y0 < 0 || uint(y0) + chromaPartHeight + uint(1) > height) {
        h264bsdFillBlock(ref, addr(_c_block[0]), x0, y0, width, height, chromaPartWidth + uint(1), chromaPartHeight + uint(1), chromaPartWidth + uint(1))
        ref = ref + width * height
        h264bsdFillBlock(ref, addr(_c_block[0]) + (chromaPartWidth + uint(1)) * (chromaPartHeight + uint(1)), x0, y0, width, height, chromaPartWidth + uint(1), chromaPartHeight + uint(1), chromaPartWidth + uint(1))
        ref = addr(_c_block[0])
        x0 = 0
        y0 = 0
        width = chromaPartWidth + uint(1)
        height = chromaPartHeight + uint(1)
    }
    valX = uint(8) - xFrac
    valY = uint(8) - yFrac
    {
        comp = uint(0)
        while (comp <= uint(1)) {
            ptrA = ref + (comp * height + uint(y0)) * width + x0
            cbr = predPartChroma + comp * uint(8) * uint(8)
            // 2x2 pels per iteration
            // bilinear vertical and horizontal interpolation
            {
                y = chromaPartHeight >> 1u
                while (y != 0) {
                    tmp1 = uint(deref(ptrA))
                    tmp3 = uint(deref(ptrA + width))
                    tmp5 = uint(deref(ptrA + width * uint(2)))
                    tmp1 *= valY
                    tmp1 += tmp3 * yFrac
                    tmp3 *= valY
                    tmp3 += tmp5 * yFrac
                    {
                        x = chromaPartWidth >> 1u
                        while (x != 0) {
                            ptrA = ptrA + 1
                            tmp2 = uint(deref(ptrA))
                            tmp4 = uint(deref(ptrA + width))
                            tmp6 = uint(deref(ptrA + width * uint(2)))
                            tmp2 *= valY
                            tmp2 += tmp4 * yFrac
                            tmp4 *= valY
                            tmp4 += tmp6 * yFrac
                            tmp1 = tmp1 * valX + plus32
                            tmp3 = tmp3 * valX + plus32
                            tmp1 += tmp2 * xFrac
                            tmp1 >>= 6u
                            tmp3 += tmp4 * xFrac
                            tmp3 >>= 6u
                            deref(cbr + 8) = uint8(tmp3)
                            var _t0 = cbr
                            cbr = cbr + 1
                            deref(_t0) = uint8(tmp1)
                            ptrA = ptrA + 1
                            tmp1 = uint(deref(ptrA))
                            tmp3 = uint(deref(ptrA + width))
                            tmp5 = uint(deref(ptrA + width * uint(2)))
                            tmp1 *= valY
                            tmp1 += tmp3 * yFrac
                            tmp3 *= valY
                            tmp3 += tmp5 * yFrac
                            tmp2 = tmp2 * valX + plus32
                            tmp4 = tmp4 * valX + plus32
                            tmp2 += tmp1 * xFrac
                            tmp2 >>= 6u
                            tmp4 += tmp3 * xFrac
                            tmp4 >>= 6u
                            deref(cbr + 8) = uint8(tmp4)
                            var _t1 = cbr
                            cbr = cbr + 1
                            deref(_t1) = uint8(tmp2)
                            x--
                        }
                    }
                    cbr = cbr + (uint(2 * 8) - chromaPartWidth)
                    ptrA = ptrA + (uint(2) * width - chromaPartWidth)
                    y--
                }
            }
            comp++
        }
    }
}

[c_function]
def private h264_file_all__PredictChroma(var mbPartChroma : uint8?; xAL : uint; yAL : uint; partWidth : uint; partHeight : uint; var mv : mv_t?; var refPic : image_t?) {
    // Variables
    var xFrac : uint
    var yFrac : uint
    var width : uint
    var height : uint
    var chromaPartWidth : uint
    var chromaPartHeight : uint
    var xInt : int
    var yInt : int
    var ref : uint8?
    // Code
    width = uint(8) * refPic.width
    height = uint(8) * refPic.height
    xInt = int((xAL >> 1u) + uint(int(mv.hor) >> 3))
    yInt = int((yAL >> 1u) + uint(int(mv.ver) >> 3))
    xFrac = uint(int(mv.hor) & 7)
    yFrac = uint(int(mv.ver) & 7)
    chromaPartWidth = partWidth >> 1u
    chromaPartHeight = partHeight >> 1u
    ref = refPic.data + uint(256) * refPic.width * refPic.height
    if (xFrac != 0 && yFrac != 0) {
        h264bsdInterpolateChromaHorVer(ref, mbPartChroma, xInt, yInt, width, height, xFrac, yFrac, chromaPartWidth, chromaPartHeight)
    } elif (xFrac != 0) {
        h264bsdInterpolateChromaHor(ref, mbPartChroma, xInt, yInt, width, height, xFrac, chromaPartWidth, chromaPartHeight)
    } elif (yFrac != 0) {
        h264bsdInterpolateChromaVer(ref, mbPartChroma, xInt, yInt, width, height, yFrac, chromaPartWidth, chromaPartHeight)
    } else {
        h264bsdFillBlock(ref, mbPartChroma, xInt, yInt, width, height, chromaPartWidth, chromaPartHeight, uint(8))
        ref = ref + width * height
        h264bsdFillBlock(ref, mbPartChroma + 8 * 8, xInt, yInt, width, height, chromaPartWidth, chromaPartHeight, uint(8))
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdInterpolateVerHalf
// Functional description:
// Function to perform vertical interpolation of pixel position 'h'
// for a block. Overfilling is done only if needed. Reference
// image (ref) is read at correct position and the predicted part
// is written to macroblock array (mb)
// ------------------------------------------------------------------------------
[c_function]
def h264bsdInterpolateVerHalf(var ref : uint8?; var mb : uint8?; var x0 : int; var y0 : int; var width : uint; height : uint; partWidth : uint; partHeight : uint) {
    var p1 : uint[111]
    var i : uint
    var j : uint
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var tmp5 : int
    var tmp6 : int
    var tmp7 : int
    var ptrC : uint8?
    var ptrV : uint8?
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if (x0 < 0 || uint(x0) + partWidth > width || y0 < 0 || uint(y0) + partHeight + uint(5) > height) {
        h264bsdFillBlock(ref, reinterpret<uint8?>(addr(p1[0])), x0, y0, width, height, partWidth, partHeight + uint(5), partWidth)
        x0 = 0
        y0 = 0
        ref = reinterpret<uint8?>(addr(p1[0]))
        width = partWidth
    }
    ref = ref + (uint(y0) * width + uint(x0))
    ptrC = ref + width
    ptrV = ptrC + uint(5) * width
    // 4 pixels per iteration, interpolate using 5 vertical samples
    {
        i = partHeight >> 2u
        while (i != 0) {
            // h1 = (16 + A + 16(G+M) + 4(G+M) - 4(C+R) - (C+R) + T) >> 5
            {
                j = partWidth
                while (j != 0) {
                    tmp4 = int(deref(ptrV + -int(width) * 2))
                    tmp5 = int(deref(ptrV + -int(width)))
                    tmp1 = int(deref(ptrV + width))
                    tmp2 = int(deref(ptrV + width * uint(2)))
                    var _t0 = ptrV
                    ptrV = ptrV + 1
                    tmp6 = int(deref(_t0))
                    tmp7 = tmp4 + tmp1
                    tmp2 -= tmp7 << 2
                    tmp2 -= tmp7
                    tmp2 += 16
                    tmp7 = tmp5 + tmp6
                    tmp3 = int(deref(ptrC + width * uint(2)))
                    tmp2 += tmp7 << 4
                    tmp2 += tmp7 << 2
                    tmp2 += tmp3
                    tmp2 = int(deref(clp + (tmp2 >> 5)))
                    tmp1 += 16
                    deref(mb + 48) = uint8(tmp2)
                    tmp7 = tmp3 + tmp6
                    tmp1 -= tmp7 << 2
                    tmp1 -= tmp7
                    tmp7 = tmp4 + tmp5
                    tmp2 = int(deref(ptrC + width))
                    tmp1 += tmp7 << 4
                    tmp1 += tmp7 << 2
                    tmp1 += tmp2
                    tmp1 = int(deref(clp + (tmp1 >> 5)))
                    tmp6 += 16
                    deref(mb + 32) = uint8(tmp1)
                    tmp7 = tmp2 + tmp5
                    tmp6 -= tmp7 << 2
