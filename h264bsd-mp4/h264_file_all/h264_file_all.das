[c_function]
def private h264_file_all__IntraChromaPlanePrediction(var data : uint8?; var above : uint8?; var left : uint8?) {
    // Variables
    var i : uint
    var a : int
    var b : int
    var c : int
    var tmp : int
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    a = 16 * (int(deref(above + 7)) + int(deref(left + 7)))
    b = int(deref(above + 4)) - int(deref(above + 2)) + 2 * (int(deref(above + 5)) - int(deref(above + 1))) + 3 * (int(deref(above + 6)) - int(deref(above + 0))) + 4 * (int(deref(above + 7)) - int(deref(above + -1)))
    b = 17 * b + 16 >> 5
    // p[-1,-1] has to be accessed through above pointer
    c = int(deref(left + 4)) - int(deref(left + 2)) + 2 * (int(deref(left + 5)) - int(deref(left + 1))) + 3 * (int(deref(left + 6)) - int(deref(left + 0))) + 4 * (int(deref(left + 7)) - int(deref(above + -1)))
    c = 17 * c + 16 >> 5
    // a += 16;
    a = a - 3 * c + 16
    {
        i = uint(8)
        while (true) {
            let _t0 = i
            i--
            if (!(_t0 != 0)) {
                break
            }
            tmp = a - 3 * b
            var _t1 = data
            data = data + 1
            deref(_t1) = deref(clp + (tmp >> 5))
            tmp += b
            var _t2 = data
            data = data + 1
            deref(_t2) = deref(clp + (tmp >> 5))
            tmp += b
            var _t3 = data
            data = data + 1
            deref(_t3) = deref(clp + (tmp >> 5))
            tmp += b
            var _t4 = data
            data = data + 1
            deref(_t4) = deref(clp + (tmp >> 5))
            tmp += b
            var _t5 = data
            data = data + 1
            deref(_t5) = deref(clp + (tmp >> 5))
            tmp += b
            var _t6 = data
            data = data + 1
            deref(_t6) = deref(clp + (tmp >> 5))
            tmp += b
            var _t7 = data
            data = data + 1
            deref(_t7) = deref(clp + (tmp >> 5))
            tmp += b
            var _t8 = data
            data = data + 1
            deref(_t8) = deref(clp + (tmp >> 5))
            a += c
        }
    }
}

[c_function]
def private h264_file_all__Get4x4NeighbourPels(var a : uint8?; var l : uint8?; var data : uint8?; var above : uint8?; var left : uint8?; blockNum : uint) {
    // Variables
    var x : uint
    var y : uint
    var t1 : uint8
    var t2 : uint8
    // Code
    x = h264bsdBlockX[blockNum]
    y = h264bsdBlockY[blockNum]
    // A and D
    if (x == uint(0)) {
        t1 = deref(left + y)
        t2 = deref(left + (y + uint(1)))
        deref(l + 1) = t1
        deref(l + 2) = t2
        t1 = deref(left + (y + uint(2)))
        t2 = deref(left + (y + uint(3)))
        deref(l + 3) = t1
        deref(l + 4) = t2
    } else {
        t1 = deref(data + (y * uint(16) + x - uint(1)))
        t2 = deref(data + (y * uint(16) + x - uint(1) + uint(16)))
        deref(l + 1) = t1
        deref(l + 2) = t2
        t1 = deref(data + (y * uint(16) + x - uint(1) + uint(32)))
        t2 = deref(data + (y * uint(16) + x - uint(1) + uint(48)))
        deref(l + 3) = t1
        deref(l + 4) = t2
    }
    // B, C and D
    if (y == uint(0)) {
        t1 = deref(above + x)
        t2 = deref(above + x)
        deref(l + 0) = t1
        deref(a + 0) = t2
        t1 = deref(above + (x + uint(1)))
        t2 = deref(above + (x + uint(2)))
        deref(a + 1) = t1
        deref(a + 2) = t2
        t1 = deref(above + (x + uint(3)))
        t2 = deref(above + (x + uint(4)))
        deref(a + 3) = t1
        deref(a + 4) = t2
        t1 = deref(above + (x + uint(5)))
        t2 = deref(above + (x + uint(6)))
        deref(a + 5) = t1
        deref(a + 6) = t2
        t1 = deref(above + (x + uint(7)))
        t2 = deref(above + (x + uint(8)))
        deref(a + 7) = t1
        deref(a + 8) = t2
    } else {
        t1 = deref(data + ((y - uint(1)) * uint(16) + x))
        t2 = deref(data + ((y - uint(1)) * uint(16) + x + uint(1)))
        deref(a + 1) = t1
        deref(a + 2) = t2
        t1 = deref(data + ((y - uint(1)) * uint(16) + x + uint(2)))
        t2 = deref(data + ((y - uint(1)) * uint(16) + x + uint(3)))
        deref(a + 3) = t1
        deref(a + 4) = t2
        t1 = deref(data + ((y - uint(1)) * uint(16) + x + uint(4)))
        t2 = deref(data + ((y - uint(1)) * uint(16) + x + uint(5)))
        deref(a + 5) = t1
        deref(a + 6) = t2
        t1 = deref(data + ((y - uint(1)) * uint(16) + x + uint(6)))
        t2 = deref(data + ((y - uint(1)) * uint(16) + x + uint(7)))
        deref(a + 7) = t1
        deref(a + 8) = t2
        if (x == uint(0)) {
            deref(a + 0) = deref(left + (y - uint(1)))
            deref(l + 0) = deref(a + 0)
        } else {
            deref(a + 0) = deref(data + ((y - uint(1)) * uint(16) + x - uint(1)))
            deref(l + 0) = deref(a + 0)
        }
    }
}

