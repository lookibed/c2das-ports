            payload_bytes = box_bytes - uint64(8)
            // 64-bit sizes
            if (box_bytes == uint64(1)) {
                box_bytes = uint64(h264_file_all__minimp4_read(mp4, 4, addr(eof_flag)))
                if (box_bytes != 0) {
                    if (!(depth != 0)) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                box_bytes = uint64(h264_file_all__minimp4_read(mp4, 4, addr(eof_flag)))
                if (box_bytes < uint64(16)) {
                    if (!(depth != 0)) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
