                    var k : uint = uint(0)
                    var ts : uint = uint(0)
                    var ts_count : uint = count
                    tr.timestamp = reinterpret<uint?>(malloc1(uint64(ts_count * uint(4))))
                    if (!(tr.timestamp != null)) {
                        if (!(depth != 0)) {
                            break
                        } else {
                            MP4D_close(mp4)
                            return 0
