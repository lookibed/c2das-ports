// ------------------------------------------------------------------------------
// Function: h264bsdInterPrediction
// Functional description:
// Processes one inter macroblock. Performs motion vector prediction
// and reconstructs prediction macroblock. Writes the final macroblock
// (prediction + residual) into the output image (currImage)
// Inputs:
// pMb pointer to macroblock specific information
// pMbLayer pointer to current macroblock data from stream
// dpb pointer to decoded picture buffer
// mbNum current macroblock number
// currImage pointer to output image
// data pointer where predicted macroblock will be stored
// Outputs:
// pMb structure is updated with current macroblock
// currImage current macroblock is written into image
// data prediction is stored here
// Returns:
// HANTRO_OK success
// HANTRO_NOK error in motion vector prediction
// ------------------------------------------------------------------------------
[c_function]
def h264bsdInterPrediction(var pMb : mbStorage?; var pMbLayer : macroblockLayer_t?; var dpb : dpbStorage_t?; mbNum : uint; var currImage : image_t?; var data : uint8?) : uint {
    // Variables
    var i : uint
    var x : uint
    var y : uint
    var row : uint
    var col : uint
    var subPartMode : subMbPartMode_e
    var refImage : image_t
    // Code
    row = mbNum / currImage.width
    col = mbNum - row * currImage.width
    row *= uint(16)
    col *= uint(16)
    refImage.width = currImage.width
    refImage.height = currImage.height
    let _cond = pMb.mbType
    if (_cond == mbType_e.P_Skip || _cond == mbType_e.P_L0_16x16) {
        if (h264_file_all__MvPrediction16x16(pMb, addr(pMbLayer.mbPred), dpb) != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        refImage.data = pMb.refAddr[0]
        h264bsdPredictSamples(data, addr(pMb.mv[0]), addr(refImage), col, row, uint(0), uint(0), uint(16), uint(16))
    } elif (_cond == mbType_e.P_L0_L0_16x8) {
        if (h264_file_all__MvPrediction16x8(pMb, addr(pMbLayer.mbPred), dpb) != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        refImage.data = pMb.refAddr[0]
        h264bsdPredictSamples(data, addr(pMb.mv[0]), addr(refImage), col, row, uint(0), uint(0), uint(16), uint(8))
        refImage.data = pMb.refAddr[2]
        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 8, addr(refImage), col, row, uint(0), uint(8), uint(16), uint(8))
    } elif (_cond == mbType_e.P_L0_L0_8x16) {
        if (h264_file_all__MvPrediction8x16(pMb, addr(pMbLayer.mbPred), dpb) != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        refImage.data = pMb.refAddr[0]
        h264bsdPredictSamples(data, addr(pMb.mv[0]), addr(refImage), col, row, uint(0), uint(0), uint(8), uint(16))
        refImage.data = pMb.refAddr[1]
        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4, addr(refImage), col, row, uint(8), uint(0), uint(8), uint(16))
    } else {
        // P_8x8 and P_8x8ref0
        if (h264_file_all__MvPrediction8x8(pMb, addr(pMbLayer.subMbPred), dpb) != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        {
            i = uint(0)
            while (i < uint(4)) {
                refImage.data = pMb.refAddr[i]
                subPartMode = h264bsdSubMbPartMode(pMbLayer.subMbPred.subMbType[i])
                x = uint((i & uint(1)) != 0 ? 8 : 0)
                y = uint(i < uint(2) ? 0 : 8)
                let _cond2 = subPartMode
                if (_cond2 == subMbPartMode_e.MB_SP_8x8) {
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i, addr(refImage), col, row, x, y, uint(8), uint(8))
                } elif (_cond2 == subMbPartMode_e.MB_SP_8x4) {
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i, addr(refImage), col, row, x, y, uint(8), uint(4))
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i + 2, addr(refImage), col, row, x, y + uint(4), uint(8), uint(4))
                } elif (_cond2 == subMbPartMode_e.MB_SP_4x8) {
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i, addr(refImage), col, row, x, y, uint(4), uint(8))
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i + 1, addr(refImage), col, row, x + uint(4), y, uint(4), uint(8))
                } else {
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i, addr(refImage), col, row, x, y, uint(4), uint(4))
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i + 1, addr(refImage), col, row, x + uint(4), y, uint(4), uint(4))
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i + 2, addr(refImage), col, row, x, y + uint(4), uint(4), uint(4))
                    h264bsdPredictSamples(data, addr(pMb.mv[0]) + uint(4) * i + 3, addr(refImage), col, row, x + uint(4), y + uint(4), uint(4), uint(4))
                }
                i++
            }
        }
    }
    // if decoded flag > 1 -> mb has already been successfully decoded and
    // written to output -> do not write again
    if (pMb.decoded > uint(1)) {
        return uint(HANTRO_OK)
    }
    if (pMb.mbType != mbType_e.P_Skip) {
        h264bsdWriteOutputBlocks(currImage, mbNum, data, addr(pMbLayer.residual.level[0]))
    } else {
        h264bsdWriteMacroblock(currImage, data)
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction16x16(var pMb : mbStorage?; var mbPred : mbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    // A, B, C
    var a : interNeighbour_t[3]
    var refIndex : uint
    var tmp : uint8?
    var tmpMv1 : uint?
    var tmpMv2 : uint?
    // Code
    refIndex = mbPred.refIdxL0[0]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), uint(5))
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, uint(10))
    // lint --e(740) Unusual pointer cast (incompatible indirect types)
    // we test just that both MVs are zero
    tmpMv1 = reinterpret<uint?>(addr(a[0].mv))
    // lint --e(740)
    // i.e. a[0].mv.hor == 0 && a[0].mv.ver == 0
    tmpMv2 = reinterpret<uint?>(addr(a[1].mv))
    if (pMb.mbType == mbType_e.P_Skip && (!(a[0].available != 0) || !(a[1].available != 0) || a[0].refIndex == uint(0) && deref(tmpMv1) == uint(0) || a[1].refIndex == uint(0) && deref(tmpMv2) == uint(0))) {
        mv.ver = int16(0)
        mv.hor = mv.ver
    } else {
        mv = mbPred.mvdL0[0]
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbC, addr(a[0]) + 2, uint(10))
        if (!(a[2].available != 0)) {
            h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbD, addr(a[0]) + 2, uint(15))
        }
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
        mv.hor = int16(int(mv.hor) + int(mvPred.hor))
        mv.ver = int16(int(mv.ver) + int(mvPred.ver))
        // horizontal motion vector range [-2048, 2047.75]
        if (uint(int(mv.hor) + 8192) >= uint(16384)) {
            return uint(HANTRO_NOK)
        }
        // vertical motion vector range [-512, 511.75]
        // (smaller for low levels)
        if (uint(int(mv.ver) + 2048) >= uint(4096)) {
            return uint(HANTRO_NOK)
        }
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[15] = mv
    pMb.mv[14] = pMb.mv[15]
    pMb.mv[13] = pMb.mv[14]
    pMb.mv[12] = pMb.mv[13]
    pMb.mv[11] = pMb.mv[12]
    pMb.mv[10] = pMb.mv[11]
    pMb.mv[9] = pMb.mv[10]
    pMb.mv[8] = pMb.mv[9]
    pMb.mv[7] = pMb.mv[8]
    pMb.mv[6] = pMb.mv[7]
    pMb.mv[5] = pMb.mv[6]
    pMb.mv[4] = pMb.mv[5]
    pMb.mv[3] = pMb.mv[4]
    pMb.mv[2] = pMb.mv[3]
    pMb.mv[1] = pMb.mv[2]
    pMb.mv[0] = pMb.mv[1]
    pMb.refPic[0] = refIndex
    pMb.refPic[1] = refIndex
    pMb.refPic[2] = refIndex
    pMb.refPic[3] = refIndex
    pMb.refAddr[0] = tmp
    pMb.refAddr[1] = tmp
    pMb.refAddr[2] = tmp
    pMb.refAddr[3] = tmp
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction16x8(var pMb : mbStorage?; var mbPred : mbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    // A, B, C
    var a : interNeighbour_t[3]
    var refIndex : uint
    var tmp : uint8?
    // Code
    mv = mbPred.mvdL0[0]
    refIndex = mbPred.refIdxL0[0]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, uint(10))
    if (a[1].refIndex == refIndex) {
        mvPred = a[1].mv
    } else {
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), uint(5))
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbC, addr(a[0]) + 2, uint(10))
        if (!(a[2].available != 0)) {
            h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbD, addr(a[0]) + 2, uint(15))
        }
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= uint(16384)) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= uint(4096)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[7] = mv
    pMb.mv[6] = pMb.mv[7]
    pMb.mv[5] = pMb.mv[6]
    pMb.mv[4] = pMb.mv[5]
    pMb.mv[3] = pMb.mv[4]
    pMb.mv[2] = pMb.mv[3]
    pMb.mv[1] = pMb.mv[2]
    pMb.mv[0] = pMb.mv[1]
    pMb.refPic[0] = refIndex
    pMb.refPic[1] = refIndex
    pMb.refAddr[0] = tmp
    pMb.refAddr[1] = tmp
    mv = mbPred.mvdL0[1]
    refIndex = mbPred.refIdxL0[1]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), uint(13))
    if (a[0].refIndex == refIndex) {
        mvPred = a[0].mv
    } else {
        a[1].available = uint(HANTRO_TRUE)
        a[1].refIndex = pMb.refPic[0]
        a[1].mv = pMb.mv[0]
        // c is not available
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]) + 2, uint(7))
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= uint(16384)) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= uint(4096)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[15] = mv
    pMb.mv[14] = pMb.mv[15]
    pMb.mv[13] = pMb.mv[14]
    pMb.mv[12] = pMb.mv[13]
    pMb.mv[11] = pMb.mv[12]
    pMb.mv[10] = pMb.mv[11]
    pMb.mv[9] = pMb.mv[10]
    pMb.mv[8] = pMb.mv[9]
    pMb.refPic[2] = refIndex
    pMb.refPic[3] = refIndex
    pMb.refAddr[2] = tmp
    pMb.refAddr[3] = tmp
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction8x16(var pMb : mbStorage?; var mbPred : mbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    // A, B, C
    var a : interNeighbour_t[3]
    var refIndex : uint
    var tmp : uint8?
    // Code
    mv = mbPred.mvdL0[0]
    refIndex = mbPred.refIdxL0[0]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), uint(5))
    if (a[0].refIndex == refIndex) {
        mvPred = a[0].mv
    } else {
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, uint(10))
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 2, uint(14))
        if (!(a[2].available != 0)) {
            h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbD, addr(a[0]) + 2, uint(15))
        }
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= uint(16384)) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= uint(4096)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[11] = mv
    pMb.mv[10] = pMb.mv[11]
    pMb.mv[9] = pMb.mv[10]
    pMb.mv[8] = pMb.mv[9]
    pMb.mv[3] = pMb.mv[8]
    pMb.mv[2] = pMb.mv[3]
    pMb.mv[1] = pMb.mv[2]
    pMb.mv[0] = pMb.mv[1]
    pMb.refPic[0] = refIndex
    pMb.refPic[2] = refIndex
    pMb.refAddr[0] = tmp
    pMb.refAddr[2] = tmp
    mv = mbPred.mvdL0[1]
    refIndex = mbPred.refIdxL0[1]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbC, addr(a[0]) + 2, uint(10))
    if (!(a[2].available != 0)) {
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 2, uint(11))
    }
    if (a[2].refIndex == refIndex) {
        mvPred = a[2].mv
    } else {
        a[0].available = uint(HANTRO_TRUE)
        a[0].refIndex = pMb.refPic[0]
        a[0].mv = pMb.mv[0]
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, uint(14))
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= uint(16384)) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= uint(4096)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[15] = mv
    pMb.mv[14] = pMb.mv[15]
    pMb.mv[13] = pMb.mv[14]
    pMb.mv[12] = pMb.mv[13]
    pMb.mv[7] = pMb.mv[12]
    pMb.mv[6] = pMb.mv[7]
    pMb.mv[5] = pMb.mv[6]
    pMb.mv[4] = pMb.mv[5]
    pMb.refPic[1] = refIndex
    pMb.refPic[3] = refIndex
    pMb.refAddr[1] = tmp
    pMb.refAddr[3] = tmp
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction8x8(var pMb : mbStorage?; var subMbPred : subMbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var numSubMbPart : uint
    // Code
    for (i in urange(uint(4))) {
        numSubMbPart = h264bsdNumSubMbPart(subMbPred.subMbType[i])
        pMb.refPic[i] = subMbPred.refIdxL0[i]
        pMb.refAddr[i] = h264bsdGetRefPicData(dpb, subMbPred.refIdxL0[i])
        if (pMb.refAddr[i] == null) {
            return uint(HANTRO_NOK)
        }
        for (j in urange(numSubMbPart)) {
            if (h264_file_all__MvPrediction(pMb, subMbPred, i, j) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction(var pMb : mbStorage?; var subMbPred : subMbPred_t?; mbPartIdx : uint; subMbPartIdx : uint) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    var refIndex : uint
    var subMbPartMode : subMbPartMode_e
    var n : neighbour_t?
    var nMb : mbStorage?
    // A, B, C
    var a : interNeighbour_t[3]
    // Code
    mv = subMbPred.mvdL0[mbPartIdx][subMbPartIdx]
    subMbPartMode = h264bsdSubMbPartMode(subMbPred.subMbType[mbPartIdx])
    refIndex = subMbPred.refIdxL0[mbPartIdx]
    n = addr(h264_file_all__N_A_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
    nMb = h264bsdGetNeighbourMb(pMb, n.mb)
    h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]), uint(n.index))
    n = addr(h264_file_all__N_B_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
    nMb = h264bsdGetNeighbourMb(pMb, n.mb)
    h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]) + 1, uint(n.index))
    n = addr(h264_file_all__N_C_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
    nMb = h264bsdGetNeighbourMb(pMb, n.mb)
    h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]) + 2, uint(n.index))
    if (!(a[2].available != 0)) {
        n = addr(h264_file_all__N_D_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
        nMb = h264bsdGetNeighbourMb(pMb, n.mb)
        h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]) + 2, uint(n.index))
    }
    h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= uint(16384)) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= uint(4096)) {
        return uint(HANTRO_NOK)
    }
    let _cond = subMbPartMode
    if (_cond == subMbPartMode_e.MB_SP_8x8) {
        pMb.mv[uint(4) * mbPartIdx] = mv
        pMb.mv[uint(4) * mbPartIdx + uint(1)] = mv
        pMb.mv[uint(4) * mbPartIdx + uint(2)] = mv
        pMb.mv[uint(4) * mbPartIdx + uint(3)] = mv
    } elif (_cond == subMbPartMode_e.MB_SP_8x4) {
        pMb.mv[uint(4) * mbPartIdx + uint(2) * subMbPartIdx] = mv
        pMb.mv[uint(4) * mbPartIdx + uint(2) * subMbPartIdx + uint(1)] = mv
    } elif (_cond == subMbPartMode_e.MB_SP_4x8) {
        pMb.mv[uint(4) * mbPartIdx + subMbPartIdx] = mv
        pMb.mv[uint(4) * mbPartIdx + subMbPartIdx + uint(2)] = mv
    } elif (_cond == subMbPartMode_e.MB_SP_4x4) {
        pMb.mv[uint(4) * mbPartIdx + subMbPartIdx] = mv
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__MedianFilter(a : int; b : int; c : int) : int {
    // Variables
    var max : int
    var min : int
    var med : int
    // Code
    med = a
    min = med
    max = min
    if (b > max) {
        max = b
    } elif (b < min) {
        min = b
    }
    if (c > max) {
        med = max
    } elif (c < min) {
        med = min
    } else {
        med = c
    }
    return med
}

def private h264_file_all__GetInterNeighbour(sliceId : uint; var nMb : mbStorage?; var n : interNeighbour_t?; index : uint) {
    n.available = uint(HANTRO_FALSE)
    n.refIndex = 4294967295u
    n.mv.ver = int16(0)
    n.mv.hor = n.mv.ver
    if (nMb != null && sliceId == nMb.sliceId) {
        var tmp : uint
        var tmpMv : mv_t
        tmp = uint(int(nMb.mbType))
        n.available = uint(HANTRO_TRUE)
        // MbPartPredMode "inlined"
        if (tmp <= uint(int(mbType_e.P_8x8ref0))) {
            tmpMv = nMb.mv[index]
            tmp = nMb.refPic[index >> 2u]
            n.refIndex = tmp
            n.mv = tmpMv
        }
    }
}

[c_function]
def private h264_file_all__GetPredictionMv(var mv : mv_t?; var a : interNeighbour_t?; refIndex : uint) {
    if (deref(a + 1).available != 0 || deref(a + 2).available != 0 || !(deref(a + 0).available != 0)) {
        var isA : uint
        var isB : uint
        var isC : uint
        isA = uint(deref(a + 0).refIndex == refIndex ? HANTRO_TRUE : HANTRO_FALSE)
        isB = uint(deref(a + 1).refIndex == refIndex ? HANTRO_TRUE : HANTRO_FALSE)
        isC = uint(deref(a + 2).refIndex == refIndex ? HANTRO_TRUE : HANTRO_FALSE)
        if (isA + isB + isC != uint(1)) {
            mv.hor = int16(h264_file_all__MedianFilter(int(deref(a + 0).mv.hor), int(deref(a + 1).mv.hor), int(deref(a + 2).mv.hor)))
            mv.ver = int16(h264_file_all__MedianFilter(int(deref(a + 0).mv.ver), int(deref(a + 1).mv.ver), int(deref(a + 2).mv.ver)))
        } elif (isA != 0) {
            deref(mv) = deref(a + 0).mv
        } elif (isB != 0) {
            deref(mv) = deref(a + 1).mv
        } else {
            deref(mv) = deref(a + 2).mv
        }
    } else {
        deref(mv) = deref(a + 0).mv
    }
}

[c_function]
def get_h264bsdClip : uint8? {
    return addr(h264bsdClip[0])
}

// ------------------------------------------------------------------------------
// Function: h264bsdIntraPrediction
// Functional description:
// Processes one intra macroblock. Performs intra prediction using
// specified prediction mode. Writes the final macroblock
// (prediction + residual) into the output image (image)
// Inputs:
// pMb pointer to macroblock specific information
// mbLayer pointer to current macroblock data from stream
// image pointer to output image
// mbNum current macroblock number
// constrainedIntraPred flag specifying if neighbouring inter
// macroblocks are used in intra prediction
// data pointer where output macroblock will be stored
// Outputs:
// pMb structure is updated with current macroblock
// image current macroblock is written into image
// data current macroblock is stored here
// Returns:
// HANTRO_OK success
// HANTRO_NOK error in intra prediction
// ------------------------------------------------------------------------------
[c_function]
def h264bsdIntraPrediction(var pMb : mbStorage?; var mbLayer : macroblockLayer_t?; var image : image_t?; mbNum : uint; constrainedIntraPred : uint; var data : uint8?) : uint {
    // Variables
    // pelAbove and pelLeft contain samples above and left to the current
    // macroblock. Above array contains also sample above-left to the current
    // mb as well as 4 samples above-right to the current mb (latter only for
    // luma)
    // lumD + lumB + lumC + cbD + cbB + crD + crB
    var pelAbove : uint8[39]
    // lumA + cbA + crA
    var pelLeft : uint8[32]
    var tmp : uint
    // Code
    h264bsdGetNeighbourPels(image, addr(pelAbove[0]), addr(pelLeft[0]), mbNum)
    if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA16x16) {
        tmp = h264bsdIntra16x16Prediction(pMb, data, addr(mbLayer.residual.level[0]), addr(pelAbove[0]), addr(pelLeft[0]), constrainedIntraPred)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        tmp = h264bsdIntra4x4Prediction(pMb, data, mbLayer, addr(pelAbove[0]), addr(pelLeft[0]), constrainedIntraPred)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    tmp = h264bsdIntraChromaPrediction(pMb, data + 256, addr(mbLayer.residual.level[0]) + 16, addr(pelAbove[0]) + 21, addr(pelLeft[0]) + 16, mbLayer.mbPred.intraChromaPredMode, constrainedIntraPred)
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // if decoded flag > 1 -> mb has already been successfully decoded and
    // written to output -> do not write again
    if (pMb.decoded > uint(1)) {
        return uint(HANTRO_OK)
    }
    h264bsdWriteMacroblock(image, data)
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdGetNeighbourPels(var image : image_t?; var above : uint8?; var left : uint8?; mbNum : uint) {
    // Variables
    var i : uint
    var width : uint
    var picSize : uint
    var ptr : uint8?
    var tmp : uint8?
    var row : uint
    var col : uint
    // Code
    if (!(mbNum != 0)) {
        return
    }
    width = image.width
    picSize = width * image.height
    row = mbNum / width
    col = mbNum - row * width
    width *= uint(16)
    ptr = image.data + row * uint(16) * width + col * uint(16)
    // note that luma samples above-right to current macroblock do not make
    // sense when current mb is the right-most mb in a row. Same applies to
    // sample above-left if col is zero. However, usage of pels in prediction
    // is controlled by neighbour availability information in actual prediction
    // process
    if (row != 0) {
        tmp = ptr - (width + uint(1))
        {
            i = uint(21)
            while (true) {
                let _t0 = i
                i--
                if (!(_t0 != 0)) {
                    break
                }
                var _t1 = above
                above = above + 1
                var _t2 = tmp
                tmp = tmp + 1
                deref(_t1) = deref(_t2)
            }
        }
    }
    if (col != 0) {
        ptr = ptr - 1
        {
            i = uint(16)
            while (true) {
                let _t3 = i
                i--
                if (!(_t3 != 0)) {
                    break
                }
                var _t4 = left
                left = left + 1
                deref(_t4) = deref(ptr)
                ptr = ptr + width
            }
        }
    }
    width >>= 1u
    ptr = image.data + picSize * uint(256) + row * uint(8) * width + col * uint(8)
    if (row != 0) {
        tmp = ptr - (width + uint(1))
        {
            i = uint(9)
            while (true) {
                let _t5 = i
                i--
                if (!(_t5 != 0)) {
                    break
                }
                var _t6 = above
                above = above + 1
                var _t7 = tmp
                tmp = tmp + 1
                deref(_t6) = deref(_t7)
            }
        }
        tmp = tmp + (picSize * uint(64) - uint(9))
        {
            i = uint(9)
            while (true) {
                let _t8 = i
                i--
                if (!(_t8 != 0)) {
                    break
                }
                var _t9 = above
                above = above + 1
                var _t10 = tmp
                tmp = tmp + 1
                deref(_t9) = deref(_t10)
            }
        }
    }
    if (col != 0) {
        ptr = ptr - 1
        {
            i = uint(8)
            while (true) {
                let _t11 = i
                i--
                if (!(_t11 != 0)) {
                    break
                }
                var _t12 = left
                left = left + 1
                deref(_t12) = deref(ptr)
                ptr = ptr + width
            }
        }
        ptr = ptr + (picSize * uint(64) - uint(8) * width)
        {
            i = uint(8)
            while (true) {
                let _t13 = i
                i--
                if (!(_t13 != 0)) {
                    break
                }
                var _t14 = left
                left = left + 1
                deref(_t14) = deref(ptr)
                ptr = ptr + width
            }
        }
    }
}

[c_function]
def h264bsdIntra16x16Prediction(var pMb : mbStorage?; var data : uint8?; var residual : int[16]?; var above : uint8?; var left : uint8?; constrainedIntraPred : uint) : uint {
    // Variables
    var availableA : uint
    var availableB : uint
    var availableD : uint
    // Code
    availableA = h264bsdIsNeighbourAvailable(pMb, pMb.mbA)
    if (availableA != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(pMb.mbA.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
        availableA = uint(HANTRO_FALSE)
    }
    availableB = h264bsdIsNeighbourAvailable(pMb, pMb.mbB)
    if (availableB != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(pMb.mbB.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
        availableB = uint(HANTRO_FALSE)
    }
    availableD = h264bsdIsNeighbourAvailable(pMb, pMb.mbD)
    if (availableD != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(pMb.mbD.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
        availableD = uint(HANTRO_FALSE)
    }
    let _cond = h264bsdPredModeIntra16x16(pMb.mbType)
    if (_cond == 0u) {
        // Intra_16x16_Vertical
        if (!(availableB != 0)) {
            return uint(HANTRO_NOK)
        }
        h264_file_all__Intra16x16VerticalPrediction(data, above + 1)
    } elif (_cond == 1u) {
        // Intra_16x16_Horizontal
        if (!(availableA != 0)) {
            return uint(HANTRO_NOK)
        }
        h264_file_all__Intra16x16HorizontalPrediction(data, left)
    } elif (_cond == 2u) {
        // Intra_16x16_DC
        h264_file_all__Intra16x16DcPrediction(data, above + 1, left, availableA, availableB)
    } else {
        // case 3: Intra_16x16_Plane
        if (!(availableA != 0) || !(availableB != 0) || !(availableD != 0)) {
            return uint(HANTRO_NOK)
        }
        h264_file_all__Intra16x16PlanePrediction(data, above + 1, left)
    }
    // add residual
    for (i in urange(uint(16))) {
        h264bsdAddResidual(data, addr(deref(residual + i)[0]), i)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdIntra4x4Prediction(var pMb : mbStorage?; var data : uint8?; var mbLayer : macroblockLayer_t?; var above : uint8?; var left : uint8?; constrainedIntraPred : uint) : uint {
    // Variables
    var mode : uint
    var neighbour : neighbour_t
    var neighbourB : neighbour_t
    var nMb : mbStorage?
    var nMb2 : mbStorage?
    var a : uint8[9]
    var l : uint8[5]
    var data4x4 : uint[4]
    var availableA : uint
    var availableB : uint
    var availableC : uint
    var availableD : uint
    // Code
    for (_c_block in urange(uint(16))) {
        neighbour = deref(h264bsdNeighbour4x4BlockA(_c_block))
        nMb = h264bsdGetNeighbourMb(pMb, neighbour.mb)
        availableA = h264bsdIsNeighbourAvailable(pMb, nMb)
        if (availableA != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(nMb.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
            availableA = uint(HANTRO_FALSE)
        }
        neighbourB = deref(h264bsdNeighbour4x4BlockB(_c_block))
        nMb2 = h264bsdGetNeighbourMb(pMb, neighbourB.mb)
        availableB = h264bsdIsNeighbourAvailable(pMb, nMb2)
        if (availableB != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(nMb2.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
            availableB = uint(HANTRO_FALSE)
        }
        mode = h264_file_all__DetermineIntra4x4PredMode(mbLayer, uint(availableA != 0 && availableB != 0 ? 1 : 0), addr(neighbour), addr(neighbourB), _c_block, nMb, nMb2)
        pMb.intra4x4PredMode[_c_block] = uint8(mode)
        neighbour = deref(h264bsdNeighbour4x4BlockC(_c_block))
        nMb = h264bsdGetNeighbourMb(pMb, neighbour.mb)
        availableC = h264bsdIsNeighbourAvailable(pMb, nMb)
        if (availableC != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(nMb.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
            availableC = uint(HANTRO_FALSE)
        }
        neighbour = deref(h264bsdNeighbour4x4BlockD(_c_block))
        nMb = h264bsdGetNeighbourMb(pMb, neighbour.mb)
        availableD = h264bsdIsNeighbourAvailable(pMb, nMb)
        if (availableD != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(nMb.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
            availableD = uint(HANTRO_FALSE)
        }
        h264_file_all__Get4x4NeighbourPels(addr(a[0]), addr(l[0]), data, above, left, _c_block)
        let _cond = mode
        if (_cond == 0u) {
            // Intra_4x4_Vertical
            if (!(availableB != 0)) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra4x4VerticalPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1)
        } elif (_cond == 1u) {
            // Intra_4x4_Horizontal
            if (!(availableA != 0)) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra4x4HorizontalPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(l[0]) + 1)
        } elif (_cond == 2u) {
            // Intra_4x4_DC
            h264_file_all__Intra4x4DcPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1, availableA, availableB)
        } elif (_cond == 3u) {
            // Intra_4x4_Diagonal_Down_Left
            if (!(availableB != 0)) {
                return uint(HANTRO_NOK)
            }
            if (!(availableC != 0)) {
                a[8] = a[4]
                a[7] = a[8]
                a[6] = a[7]
                a[5] = a[6]
            }
            h264_file_all__Intra4x4DiagonalDownLeftPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1)
        } elif (_cond == 4u) {
            // Intra_4x4_Diagonal_Down_Right
            if (!(availableA != 0) || !(availableB != 0) || !(availableD != 0)) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra4x4DiagonalDownRightPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1)
        } elif (_cond == 5u) {
            // Intra_4x4_Vertical_Right
            if (!(availableA != 0) || !(availableB != 0) || !(availableD != 0)) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra4x4VerticalRightPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1)
        } elif (_cond == 6u) {
            // Intra_4x4_Horizontal_Down
            if (!(availableA != 0) || !(availableB != 0) || !(availableD != 0)) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra4x4HorizontalDownPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1)
        } elif (_cond == 7u) {
            // Intra_4x4_Vertical_Left
            if (!(availableB != 0)) {
                return uint(HANTRO_NOK)
            }
            if (!(availableC != 0)) {
                a[8] = a[4]
                a[7] = a[8]
                a[6] = a[7]
                a[5] = a[6]
            }
            h264_file_all__Intra4x4VerticalLeftPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1)
        } else {
            // case 8 Intra_4x4_Horizontal_Up
            if (!(availableA != 0)) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra4x4HorizontalUpPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(l[0]) + 1)
        }
        h264_file_all__Write4x4To16x16(data, reinterpret<uint8?>(addr(data4x4[0])), _c_block)
        h264bsdAddResidual(data, addr(mbLayer.residual.level[_c_block][0]), _c_block)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdIntraChromaPrediction(var pMb : mbStorage?; var data : uint8?; var residual : int[16]?; var above : uint8?; var left : uint8?; predMode : uint; constrainedIntraPred : uint) : uint {
    // Variables
    var i : uint
    var comp : uint
    var _c_block : uint
    var availableA : uint
    var availableB : uint
    var availableD : uint
    // Code
    availableA = h264bsdIsNeighbourAvailable(pMb, pMb.mbA)
    if (availableA != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(pMb.mbA.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
        availableA = uint(HANTRO_FALSE)
    }
    availableB = h264bsdIsNeighbourAvailable(pMb, pMb.mbB)
    if (availableB != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(pMb.mbB.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
        availableB = uint(HANTRO_FALSE)
    }
    availableD = h264bsdIsNeighbourAvailable(pMb, pMb.mbD)
    if (availableD != 0 && constrainedIntraPred != 0 && h264bsdMbPartPredMode(pMb.mbD.mbType) == mbPartPredMode_e.PRED_MODE_INTER) {
        availableD = uint(HANTRO_FALSE)
    }
    {
        comp = uint(0)
        _c_block = uint(16)
        while (comp < uint(2)) {
            let _cond = predMode
            if (_cond == 0u) {
                // Intra_Chroma_DC
                h264_file_all__IntraChromaDcPrediction(data, above + 1, left, availableA, availableB)
            } elif (_cond == 1u) {
                // Intra_Chroma_Horizontal
                if (!(availableA != 0)) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__IntraChromaHorizontalPrediction(data, left)
            } elif (_cond == 2u) {
                // Intra_Chroma_Vertical
                if (!(availableB != 0)) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__IntraChromaVerticalPrediction(data, above + 1)
            } else {
                // case 3: Intra_Chroma_Plane
                if (!(availableA != 0) || !(availableB != 0) || !(availableD != 0)) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__IntraChromaPlanePrediction(data, above + 1, left)
            }
            {
                i = uint(0)
                while (i < uint(4)) {
                    h264bsdAddResidual(data, addr(deref(residual + i)[0]), _c_block)
                    i++
                    _c_block++
                }
            }
            // advance pointers
            data = data + 64
            above = above + 9
            left = left + 8
            residual = residual + 4
            comp++
        }
    }
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdAddResidual
// Functional description:
// Add residual of a block into prediction in macroblock array 'data'.
// The result (residual + prediction) is stored in 'data'.
// ------------------------------------------------------------------------------
[c_function]
def h264bsdAddResidual(var data : uint8?; var residual : int?; blockNum : uint) {
    // Variables
    var i : uint
    var x : uint
    var y : uint
    var width : uint
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var tmp : uint8?
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if (deref(residual + 0) == 16777215) {
        return
    }
    if (blockNum < uint(16)) {
        width = uint(16)
        x = h264bsdBlockX[blockNum]
        y = h264bsdBlockY[blockNum]
    } else {
        width = uint(8)
        x = h264bsdBlockX[blockNum & uint(3)]
        y = h264bsdBlockY[blockNum & uint(3)]
    }
    tmp = data + y * width + x
    {
        i = uint(4)
        while (i != 0) {
            var _t0 = residual
            residual = residual + 1
            tmp1 = deref(_t0)
            tmp2 = int(deref(tmp + 0))
            var _t1 = residual
            residual = residual + 1
            tmp3 = deref(_t1)
            tmp4 = int(deref(tmp + 1))
            deref(tmp + 0) = deref(clp + (tmp1 + tmp2))
            var _t2 = residual
            residual = residual + 1
            tmp1 = deref(_t2)
            tmp2 = int(deref(tmp + 2))
            deref(tmp + 1) = deref(clp + (tmp3 + tmp4))
            var _t3 = residual
            residual = residual + 1
            tmp3 = deref(_t3)
            tmp4 = int(deref(tmp + 3))
            tmp1 = int(deref(clp + (tmp1 + tmp2)))
            tmp3 = int(deref(clp + (tmp3 + tmp4)))
            deref(tmp + 2) = uint8(tmp1)
            deref(tmp + 3) = uint8(tmp3)
            tmp = tmp + width
            i--
        }
    }
}

[c_function]
def private h264_file_all__Intra16x16VerticalPrediction(var data : uint8?; var above : uint8?) {
    // Variables
    // Code
    for (i in urange(uint(16))) {
        for (j in urange(uint(16))) {
            var _t0 = data
            data = data + 1
            deref(_t0) = deref(above + j)
        }
    }
}

[c_function]
def private h264_file_all__Intra16x16HorizontalPrediction(var data : uint8?; var left : uint8?) {
    // Variables
    // Code
    for (i in urange(uint(16))) {
        for (j in urange(uint(16))) {
            var _t0 = data
            data = data + 1
            deref(_t0) = deref(left + i)
        }
    }
}

[c_function]
def private h264_file_all__Intra16x16DcPrediction(var data : uint8?; var above : uint8?; var left : uint8?; availableA : uint; availableB : uint) {
    // Variables
    var i : uint
    var tmp : uint
    // Code
    if (availableA != 0 && availableB != 0) {
        {
            i = uint(0)
            tmp = uint(0)
            while (i < uint(16)) {
                tmp += uint(int(deref(above + i)) + int(deref(left + i)))
                i++
            }
        }
        tmp = tmp + uint(16) >> 5u
    } elif (availableA != 0) {
        {
            i = uint(0)
            tmp = uint(0)
            while (i < uint(16)) {
                tmp += uint(deref(left + i))
                i++
            }
        }
        tmp = tmp + uint(8) >> 4u
    } elif (availableB != 0) {
        {
            i = uint(0)
            tmp = uint(0)
            while (i < uint(16)) {
                tmp += uint(deref(above + i))
                i++
            }
        }
        tmp = tmp + uint(8) >> 4u
    } else {
        // neither A nor B available
        tmp = uint(128)
    }
    for (i1 in urange(uint(256))) {
        deref(data + i1) = uint8(tmp)
    }
}

[c_function]
def private h264_file_all__Intra16x16PlanePrediction(var data : uint8?; var above : uint8?; var left : uint8?) {
    // Variables
    var i : int
    var a : int
    var b : int
    var c : int
    var tmp : int
    // Code
    a = 16 * (int(deref(above + 15)) + int(deref(left + 15)))
    {
        i = 0
        b = 0
        while (i < 8) {
            b += (i + 1) * (int(deref(above + (8 + i))) - int(deref(above + (6 - i))))
            i++
        }
    }
    b = 5 * b + 32 >> 6
    {
        i = 0
        c = 0
        while (i < 7) {
            c += (i + 1) * (int(deref(left + (8 + i))) - int(deref(left + (6 - i))))
            i++
        }
    }
    // p[-1,-1] has to be accessed through above pointer
    c += (i + 1) * (int(deref(left + (8 + i))) - int(deref(above + -1)))
    c = 5 * c + 32 >> 6
    for (i1 in range(16)) {
        for (j in range(16)) {
            tmp = a + b * (j - 7) + c * (i1 - 7) + 16 >> 5
            deref(data + (i1 * 16 + j)) = uint8(tmp < 0 ? 0 : (tmp > 255 ? 255 : tmp))
        }
    }
}

[c_function]
def private h264_file_all__IntraChromaDcPrediction(var data : uint8?; var above : uint8?; var left : uint8?; availableA : uint; availableB : uint) {
    // Variables
    var i : uint
    var tmp1 : uint
    var tmp2 : uint
    // Code
    // y = 0..3
    if (availableA != 0 && availableB != 0) {
        tmp1 = uint(int(deref(above + 0)) + int(deref(above + 1)) + int(deref(above + 2)) + int(deref(above + 3)) + int(deref(left + 0)) + int(deref(left + 1)) + int(deref(left + 2)) + int(deref(left + 3)))
        tmp1 = tmp1 + uint(4) >> 3u
        tmp2 = uint(int(deref(above + 4)) + int(deref(above + 5)) + int(deref(above + 6)) + int(deref(above + 7)) + 2 >> 2)
    } elif (availableB != 0) {
        tmp1 = uint(int(deref(above + 0)) + int(deref(above + 1)) + int(deref(above + 2)) + int(deref(above + 3)) + 2 >> 2)
        tmp2 = uint(int(deref(above + 4)) + int(deref(above + 5)) + int(deref(above + 6)) + int(deref(above + 7)) + 2 >> 2)
    } elif (availableA != 0) {
        tmp1 = uint(int(deref(left + 0)) + int(deref(left + 1)) + int(deref(left + 2)) + int(deref(left + 3)) + 2 >> 2)
        tmp2 = tmp1
    } else {
        // neither A nor B available
        tmp2 = uint(128)
        tmp1 = tmp2
    }
    {
        i = uint(4)
        while (true) {
            let _t0 = i
            i--
            if (!(_t0 != 0)) {
                break
            }
            var _t1 = data
            data = data + 1
            deref(_t1) = uint8(tmp1)
            var _t2 = data
            data = data + 1
            deref(_t2) = uint8(tmp1)
            var _t3 = data
            data = data + 1
            deref(_t3) = uint8(tmp1)
            var _t4 = data
            data = data + 1
            deref(_t4) = uint8(tmp1)
            var _t5 = data
            data = data + 1
            deref(_t5) = uint8(tmp2)
            var _t6 = data
            data = data + 1
            deref(_t6) = uint8(tmp2)
            var _t7 = data
            data = data + 1
            deref(_t7) = uint8(tmp2)
            var _t8 = data
            data = data + 1
            deref(_t8) = uint8(tmp2)
        }
    }
    // y = 4...7
    if (availableA != 0) {
        tmp1 = uint(int(deref(left + 4)) + int(deref(left + 5)) + int(deref(left + 6)) + int(deref(left + 7)) + 2 >> 2)
        if (availableB != 0) {
            tmp2 = uint(int(deref(above + 4)) + int(deref(above + 5)) + int(deref(above + 6)) + int(deref(above + 7)) + int(deref(left + 4)) + int(deref(left + 5)) + int(deref(left + 6)) + int(deref(left + 7)))
            tmp2 = tmp2 + uint(4) >> 3u
        } else {
            tmp2 = tmp1
        }
    } elif (availableB != 0) {
        tmp1 = uint(int(deref(above + 0)) + int(deref(above + 1)) + int(deref(above + 2)) + int(deref(above + 3)) + 2 >> 2)
        tmp2 = uint(int(deref(above + 4)) + int(deref(above + 5)) + int(deref(above + 6)) + int(deref(above + 7)) + 2 >> 2)
    } else {
        tmp2 = uint(128)
        tmp1 = tmp2
    }
    {
        i = uint(4)
        while (true) {
            let _t9 = i
            i--
            if (!(_t9 != 0)) {
                break
            }
            var _t10 = data
            data = data + 1
            deref(_t10) = uint8(tmp1)
            var _t11 = data
            data = data + 1
            deref(_t11) = uint8(tmp1)
            var _t12 = data
            data = data + 1
            deref(_t12) = uint8(tmp1)
            var _t13 = data
            data = data + 1
            deref(_t13) = uint8(tmp1)
            var _t14 = data
            data = data + 1
            deref(_t14) = uint8(tmp2)
            var _t15 = data
            data = data + 1
            deref(_t15) = uint8(tmp2)
            var _t16 = data
            data = data + 1
            deref(_t16) = uint8(tmp2)
            var _t17 = data
            data = data + 1
            deref(_t17) = uint8(tmp2)
        }
    }
}

