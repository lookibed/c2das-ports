    if (dpb.noReordering != 0) {
        return uint(HANTRO_NOK)
    }
    tmp = h264_file_all__FindSmallestPicOrderCnt(dpb)
    // no pictures to be displayed
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    deref(dpb.outBuf + dpb.numOut).data = tmp.data
    deref(dpb.outBuf + dpb.numOut).isIdr = tmp.isIdr
    deref(dpb.outBuf + dpb.numOut).picId = tmp.picId
    deref(dpb.outBuf + dpb.numOut).numErrMbs = tmp.numErrMbs
    dpb.numOut++
    tmp.toBeDisplayed = uint(HANTRO_FALSE)
    if (!(int(tmp.status) != 0)) {
        dpb.fullness--
    }
    return uint(HANTRO_OK)
}

