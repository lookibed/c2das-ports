        if (picture_ready != 0) {
            var picture_bytes : int = h264_file_all__frames.state.width * h264_file_all__frames.state.height * 3 / 2
            h264_file_all__frames.hash = h264_file_all__fold_bytes(h264_file_all__frames.state.picture, picture_bytes)
            h264_file_all__frames.frame_index += 1
            return 1
        }
    }
    return 0
}

def h264mp4_frames_hash : int {
    return h264_file_all__frames != null ? int(h264_file_all__frames.hash) : 0
}

def h264mp4_frames_index : int {
    return h264_file_all__frames != null ? h264_file_all__frames.frame_index : -1
}

def h264mp4_frames_width : int {
    return h264_file_all__frames != null ? h264_file_all__frames.state.width : 0
}

def h264mp4_frames_height : int {
    return h264_file_all__frames != null ? h264_file_all__frames.state.height : 0
}

def h264mp4_frames_end : int {
    h264_file_all__frames_release()
    return 1
}

[c_function]
def private h264_file_all__load_last_argument(argc : int; var argv : uint8 ??) : int {
    var f : FILE? = null
    var got : uint64 = uint64(0)
    if (argc < 2) {
        return 0
    }
    f = reinterpret<FILE?>(crt::fopen(deref(argv + (argc - 1)), reinterpret<uint8?>("rb")))
    if (!(f != null)) {
        return 0
    }
    got = crt::fread(reinterpret<void?>(addr(h264_file_all__file_bytes[0])), uint64(1), uint64(MAX_FILE_BYTES), reinterpret<void?>(f))
    crt::fclose(reinterpret<void?>(f))
    return int(got)
}

[c_function]
def c_main(argc : int; var argv : uint8 ??) : int {
    var frames : int = 0
    var length : int = 0
    crt::setvbuf(crt::c_stdout(), null, _IONBF, uint64(0))
    length = h264_file_all__load_last_argument(argc, argv)
    if (length <= 0) {
        printf(reinterpret<uint8?>("load=0\n"))
        return 2
    }
    printf(reinterpret<uint8?>("bytes=%d\n"), length)
    if (!(h264mp4_frames_begin_bytes(addr(h264_file_all__file_bytes[0]), length) != 0)) {
        printf(reinterpret<uint8?>("frames_begin=0\n"))
        return 1
    }
    while (h264mp4_frames_next() != 0) {
        printf(reinterpret<uint8?>("frame[%d]=%d\n"), h264mp4_frames_index(), h264mp4_frames_hash())
        frames += 1
    }
    printf(reinterpret<uint8?>("width=%d\n"), h264mp4_frames_width())
    printf(reinterpret<uint8?>("height=%d\n"), h264mp4_frames_height())
    h264mp4_frames_end()
    printf(reinterpret<uint8?>("frames=%d\n"), frames)
    return frames > 0 ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("h264_file_all")
    return c_main(c_argc(), c_argv())
}
