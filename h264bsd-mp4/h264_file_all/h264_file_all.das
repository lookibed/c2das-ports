[c_function]
def private h264_file_all__SlidingWindowRefPicMarking(var dpb : dpbStorage_t?) : uint {
    // Variables
    var index : int
    var picNum : int
    var i : uint
    // Code
    if (dpb.numRefFrames < dpb.maxRefFrames) {
        return uint(HANTRO_OK)
    } else {
        index = -1
        picNum = 0
        // find the oldest short term picture
        {
            i = uint(0)
            while (i < dpb.numRefFrames) {
                if (deref(dpb.buffer + i).status == dpbPictureStatus_e.NON_EXISTING || deref(dpb.buffer + i).status == dpbPictureStatus_e.SHORT_TERM) {
                    if (deref(dpb.buffer + i).picNum < picNum || index == -1) {
                        index = int(i)
                        picNum = deref(dpb.buffer + i).picNum
                    }
                }
                i++
            }
        }
        if (index >= 0) {
            deref(dpb.buffer + index).status = dpbPictureStatus_e.UNUSED
            dpb.numRefFrames--
            if (!(deref(dpb.buffer + index).toBeDisplayed != 0)) {
                dpb.fullness--
            }
            return uint(HANTRO_OK)
        }
    }
    return uint(HANTRO_NOK)
}

[c_function]
def h264bsdInitDpb(var dpb : dpbStorage_t?; picSizeInMbs : uint; dpbSize : uint; maxRefFrames : uint; maxFrameNum : uint; noReordering : uint) : uint {
    // Variables
    var i : uint
    // Code
    dpb.maxLongTermFrameIdx = uint(int(anon_105.NO_LONG_TERM_FRAME_INDICES))
    dpb.maxRefFrames = maxRefFrames > uint(1) ? maxRefFrames : uint(1)
    if (noReordering != 0) {
