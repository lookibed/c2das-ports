                return uint(MEMORY_ALLOCATION_ERROR)
            }
            deref(dpb.buffer + i).data = deref(dpb.buffer + i).pAllocatedData + (uint64(16) - uint64(intptr(deref(dpb.buffer + i).pAllocatedData)) & uint64(16 - 1)) / uint64(typeinfo sizeof(type<uint8>))
            i++
        }
    }
    {
        dpb.list = reinterpret<dpbPicture_t ??>(malloc1(uint64(16 + 1) * uint64(typeinfo sizeof(type<dpbPicture_t?>))))
    }
    {
        dpb.outBuf = reinterpret<dpbOutPicture_t?>(malloc1(uint64(dpb.dpbSize + uint(1)) * uint64(typeinfo sizeof(type<dpbOutPicture_t>))))
    }
    if (dpb.list == null || dpb.outBuf == null) {
        return uint(MEMORY_ALLOCATION_ERROR)
    }
    memset1(reinterpret<void?>(dpb.list), 0, uint64(MAX_NUM_REF_IDX_L0_ACTIVE + 1) * uint64(typeinfo sizeof(type<dpbPicture_t?>)))
    dpb.outIndex = uint(0)
    dpb.numOut = dpb.outIndex
    return uint(HANTRO_OK)
}

def h264bsdResetDpb(var dpb : dpbStorage_t?; picSizeInMbs : uint; dpbSize : uint; maxRefFrames : uint; maxFrameNum : uint; noReordering : uint) : uint {
