// NULL if no pictures available for display
// ------------------------------------------------------------------------------
[c_function]
def h264bsdNextOutputPictureYCbCrA(var pStorage : storage?; var picId : uint?; var isIdrPic : uint?; var numErrMbs : uint?) : uint? {
    var width : uint = h264bsdPicWidth(pStorage) * uint(16)
    var height : uint = h264bsdPicHeight(pStorage) * uint(16)
    var data : uint8? = h264bsdNextOutputPicture(pStorage, picId, isIdrPic, numErrMbs)
    var rgbSize : uint64 = uint64(typeinfo sizeof(type<uint>)) * uint64(width) * uint64(height)
    if (data == null) {
        return null
    }
    if (pStorage.conversionBufferSize < rgbSize) {
        if (pStorage.conversionBuffer != null) {
            free1(reinterpret<void?>(pStorage.conversionBuffer))
        }
        pStorage.conversionBufferSize = rgbSize
        pStorage.conversionBuffer = reinterpret<uint?>(malloc1(rgbSize))
    }
    h264bsdConvertToYCbCrA(width, height, data, pStorage.conversionBuffer)
    return pStorage.conversionBuffer
}

def h264bsdPicWidth(var pStorage : storage?) : uint {
    // Variables
    // Code
    if (pStorage.activeSps != null) {
        return pStorage.activeSps.picWidthInMbs
    } else {
        return uint(0)
    }
}

def h264bsdPicHeight(var pStorage : storage?) : uint {
    // Variables
    // Code
    if (pStorage.activeSps != null) {
        return pStorage.activeSps.picHeightInMbs
    } else {
        return uint(0)
    }
}

[c_function]
def h264bsdFlushBuffer(var pStorage : storage?) {
    // Variables
    // Code
    h264bsdFlushDpb(addr(pStorage.dpb[0]))
}

def h264bsdCheckValidParamSets(var pStorage : storage?) : uint {
    // Variables
    // Code
    return uint(h264bsdValidParamSets(pStorage) == uint(HANTRO_OK) ? 1 : 0)
}

def h264bsdVideoRange(var pStorage : storage?) : uint {
    // Variables
    // Code
    if (pStorage.activeSps != null && pStorage.activeSps.vuiParametersPresentFlag != 0 && pStorage.activeSps.vuiParameters != null && pStorage.activeSps.vuiParameters.videoSignalTypePresentFlag != 0 && pStorage.activeSps.vuiParameters.videoFullRangeFlag != 0) {
        return uint(1)
    } else {
        // default value of video_full_range_flag is 0
        return uint(0)
    }
}

def h264bsdMatrixCoefficients(var pStorage : storage?) : uint {
    // Variables
    // Code
    if (pStorage.activeSps != null && pStorage.activeSps.vuiParametersPresentFlag != 0 && pStorage.activeSps.vuiParameters != null && pStorage.activeSps.vuiParameters.videoSignalTypePresentFlag != 0 && pStorage.activeSps.vuiParameters.colourDescriptionPresentFlag != 0) {
        return pStorage.activeSps.vuiParameters.matrixCoefficients
    } else {
        // default unspecified
        return uint(2)
    }
}

[c_function]
def h264bsdCroppingParams(var pStorage : storage?; var croppingFlag : uint?; var leftOffset : uint?; var width : uint?; var topOffset : uint?; var height : uint?) {
    // Variables
    // Code
    if (pStorage.activeSps != null && pStorage.activeSps.frameCroppingFlag != 0) {
        deref(croppingFlag) = uint(1)
        deref(leftOffset) = uint(2) * pStorage.activeSps.frameCropLeftOffset
        deref(width) = uint(16) * pStorage.activeSps.picWidthInMbs - uint(2) * (pStorage.activeSps.frameCropLeftOffset + pStorage.activeSps.frameCropRightOffset)
        deref(topOffset) = uint(2) * pStorage.activeSps.frameCropTopOffset
        deref(height) = uint(16) * pStorage.activeSps.picHeightInMbs - uint(2) * (pStorage.activeSps.frameCropTopOffset + pStorage.activeSps.frameCropBottomOffset)
    } else {
        deref(croppingFlag) = uint(0)
        deref(leftOffset) = uint(0)
        deref(width) = uint(0)
        deref(topOffset) = uint(0)
        deref(height) = uint(0)
    }
}

[c_function]
def h264bsdSampleAspectRatio(var pStorage : storage?; var sarWidth : uint?; var sarHeight : uint?) {
    // Variables
    var w : uint = uint(1)
    var h : uint = uint(1)
    // Code
    if (pStorage.activeSps != null && pStorage.activeSps.vuiParametersPresentFlag != 0 && pStorage.activeSps.vuiParameters != null && pStorage.activeSps.vuiParameters.aspectRatioPresentFlag != 0) {
        let _cond = pStorage.activeSps.vuiParameters.aspectRatioIdc
        if (_cond == 0u) {
            w = uint(0)
            h = uint(0)
        } elif (_cond == 1u) {
            w = uint(1)
            h = uint(1)
        } elif (_cond == 2u) {
            w = uint(12)
            h = uint(11)
        } elif (_cond == 3u) {
            w = uint(10)
            h = uint(11)
        } elif (_cond == 4u) {
            w = uint(16)
            h = uint(11)
        } elif (_cond == 5u) {
            w = uint(40)
            h = uint(33)
        } elif (_cond == 6u) {
            w = uint(24)
            h = uint(11)
        } elif (_cond == 7u) {
            w = uint(20)
            h = uint(11)
        } elif (_cond == 8u) {
            w = uint(32)
            h = uint(11)
        } elif (_cond == 9u) {
            w = uint(80)
            h = uint(33)
        } elif (_cond == 10u) {
            w = uint(18)
            h = uint(11)
        } elif (_cond == 11u) {
            w = uint(15)
            h = uint(11)
        } elif (_cond == 12u) {
            w = uint(64)
            h = uint(33)
        } elif (_cond == 13u) {
            w = uint(160)
            h = uint(99)
        } elif (_cond == 255u) {
            w = pStorage.activeSps.vuiParameters.sarWidth
            h = pStorage.activeSps.vuiParameters.sarHeight
            if (w == uint(0) || h == uint(0)) {
                h = uint(0)
                w = h
            }
        } else {
            w = uint(0)
            h = uint(0)
        }
    }
    // set aspect ratio
    deref(sarWidth) = w
    deref(sarHeight) = h
}

// ------------------------------------------------------------------------------
// Function: h264bsdProfile
// Functional description:
// Get profile information from active SPS
// Inputs:
// pStorage pointer to storage structure
// Outputs:
// profile current profile
// ------------------------------------------------------------------------------
def h264bsdProfile(var pStorage : storage?) : uint {
    if (pStorage.activeSps != null) {
        return pStorage.activeSps.profileIdc
    } else {
        return uint(0)
    }
}

[c_function]
def h264bsdAlloc : storage? {
    return reinterpret<storage?>(malloc1(uint64(typeinfo sizeof(type<storage>))))
}

[c_function]
def h264bsdFree(var pStorage : storage?) {
    free1(reinterpret<void?>(pStorage))
}

[c_function]
def h264bsdConvertToRGBA(width : uint; height : uint; var data : uint8?; var pOutput : uint?) {
    var w : int = int(width)
    var h : int = int(height)
    var x : int = 0
    var y : int = 0
    var ySize : uint64 = uint64(w * h)
    var cbSize : uint64 = uint64(w / 2 * h / 2)
    var luma : uint8? = data
    var cb : uint8? = data + ySize
    var cr : uint8? = data + ySize + cbSize
    var rgba : uint? = pOutput
    while (y < h) {
        var c : int = int(deref(luma)) - 16
        var d : int = int(deref(cb)) - 128
        var e : int = int(deref(cr)) - 128
        var r : uint = uint(298 * c + 409 * e + 128 >> 8 < 0 ? 0 : (298 * c + 409 * e + 128 >> 8 > 255 ? 255 : 298 * c + 409 * e + 128 >> 8))
        var g : uint = uint(298 * c - 100 * d - 208 * e + 128 >> 8 < 0 ? 0 : (298 * c - 100 * d - 208 * e + 128 >> 8 > 255 ? 255 : 298 * c - 100 * d - 208 * e + 128 >> 8))
        var b : uint = uint(298 * c + 516 * d + 128 >> 8 < 0 ? 0 : (298 * c + 516 * d + 128 >> 8 > 255 ? 255 : 298 * c + 516 * d + 128 >> 8))
        var pixel : uint = uint(255)
        pixel = (pixel << 8u) + b
        pixel = (pixel << 8u) + g
        pixel = (pixel << 8u) + r
        deref(rgba) = pixel
        x++
        rgba = rgba + 1
        luma = luma + 1
        if (!((x & 1) != 0)) {
            cb = cb + 1
            cr = cr + 1
        }
        if (x < w) {
            continue
        }
        x = 0
        y++
        if ((y & 1) != 0) {
            cb = cb - w / 2
            cr = cr - w / 2
        }
    }
}

[c_function]
def h264bsdConvertToBGRA(width : uint; height : uint; var data : uint8?; var pOutput : uint?) {
    var w : int = int(width)
    var h : int = int(height)
    var x : int = 0
    var y : int = 0
    var ySize : uint64 = uint64(w * h)
    var cbSize : uint64 = uint64(w / 2 * h / 2)
    var luma : uint8? = data
    var cb : uint8? = data + ySize
    var cr : uint8? = data + ySize + cbSize
    var bgra : uint? = pOutput
    while (y < h) {
        var c : int = int(deref(luma)) - 16
        var d : int = int(deref(cb)) - 128
        var e : int = int(deref(cr)) - 128
        var r : uint = uint(298 * c + 409 * e + 128 >> 8 < 0 ? 0 : (298 * c + 409 * e + 128 >> 8 > 255 ? 255 : 298 * c + 409 * e + 128 >> 8))
        var g : uint = uint(298 * c - 100 * d - 208 * e + 128 >> 8 < 0 ? 0 : (298 * c - 100 * d - 208 * e + 128 >> 8 > 255 ? 255 : 298 * c - 100 * d - 208 * e + 128 >> 8))
        var b : uint = uint(298 * c + 516 * d + 128 >> 8 < 0 ? 0 : (298 * c + 516 * d + 128 >> 8 > 255 ? 255 : 298 * c + 516 * d + 128 >> 8))
        var pixel : uint = uint(255)
        pixel = (pixel << 8u) + r
        pixel = (pixel << 8u) + g
        pixel = (pixel << 8u) + b
        deref(bgra) = pixel
        x++
        bgra = bgra + 1
        luma = luma + 1
        if (!((x & 1) != 0)) {
            cb = cb + 1
            cr = cr + 1
        }
        if (x < w) {
            continue
        }
        x = 0
        y++
        if ((y & 1) != 0) {
            cb = cb - w / 2
            cr = cr - w / 2
        }
    }
}

[c_function]
def h264bsdConvertToYCbCrA(width : uint; height : uint; var data : uint8?; var pOutput : uint?) {
    var w : int = int(width)
    var h : int = int(height)
    var x : int = 0
    var y : int = 0
    var ySize : uint64 = uint64(w * h)
    var cbSize : uint64 = uint64(w / 2 * h / 2)
    var luma : uint8? = data
    var cb : uint8? = data + ySize
    var cr : uint8? = data + ySize + cbSize
    var yCbCr : uint? = pOutput
    while (y < h) {
        var pixel : uint = uint(255)
        pixel = (pixel << 8u) + uint(deref(cr))
        pixel = (pixel << 8u) + uint(deref(cb))
        pixel = (pixel << 8u) + uint(deref(luma))
        deref(yCbCr) = pixel
        x++
        yCbCr = yCbCr + 1
        luma = luma + 1
        if (!((x & 1) != 0)) {
            cb = cb + 1
            cr = cr + 1
        }
        if (x < w) {
            continue
        }
        x = 0
        y++
        if ((y & 1) != 0) {
            cb = cb - w / 2
            cr = cr - w / 2
        }
    }
}

[c_function]
def private h264_file_all__ComparePictures(var ptr1 : void?; var ptr2 : void?) : int {
    // Variables
    var pic1 : dpbPicture_t?
    var pic2 : dpbPicture_t?
    // Code
    pic1 = reinterpret<dpbPicture_t?>(ptr1)
    pic2 = reinterpret<dpbPicture_t?>(ptr2)
    // both are non-reference pictures, check if needed for display
    if (!(int(pic1.status) != 0) && !(int(pic2.status) != 0)) {
        if (pic1.toBeDisplayed != 0 && !(pic2.toBeDisplayed != 0)) {
            return -1
        } elif (!(pic1.toBeDisplayed != 0) && pic2.toBeDisplayed != 0) {
            return 1
        } else {
            return 0
        }
    } elif (!(int(pic2.status) != 0)) {
        // only pic 1 needed for reference -> greater
        return -1
    } elif (!(int(pic1.status) != 0)) {
        // only pic 2 needed for reference -> greater
        return 1
    } elif ((pic1.status == dpbPictureStatus_e.NON_EXISTING || pic1.status == dpbPictureStatus_e.SHORT_TERM) && (pic2.status == dpbPictureStatus_e.NON_EXISTING || pic2.status == dpbPictureStatus_e.SHORT_TERM)) {
        // both are short term reference pictures -> check picNum
        if (pic1.picNum > pic2.picNum) {
            return -1
        } elif (pic1.picNum < pic2.picNum) {
            return 1
        } else {
            return 0
        }
    } elif (pic1.status == dpbPictureStatus_e.NON_EXISTING || pic1.status == dpbPictureStatus_e.SHORT_TERM) {
        // only pic 1 is short term -> greater
        return -1
    } elif (pic2.status == dpbPictureStatus_e.NON_EXISTING || pic2.status == dpbPictureStatus_e.SHORT_TERM) {
        // only pic 2 is short term -> greater
        return 1
    } else {
        // both are long term reference pictures -> check picNum (contains the
        // longTermPicNum
        if (pic1.picNum > pic2.picNum) {
            return 1
        } elif (pic1.picNum < pic2.picNum) {
            return -1
        } else {
            return 0
        }
    }
}

[c_function]
def h264bsdReorderRefPicList(var dpb : dpbStorage_t?; var order : refPicListReordering_t?; currFrameNum : uint; numRefIdxActive : uint) : uint {
    // Variables
    var i : uint
    var j : uint
    var k : uint
    var picNumPred : uint
    var refIdx : uint
    var picNum : int
    var picNumNoWrap : int
    var index : int
    var isShortTerm : uint
    // Code
    // set dpb picture numbers for sorting
    h264_file_all__SetPicNums(dpb, currFrameNum)
    if (!(order.refPicListReorderingFlagL0 != 0)) {
        return uint(HANTRO_OK)
    }
    refIdx = uint(0)
    picNumPred = currFrameNum
    i = uint(0)
    while (order.command[i].reorderingOfPicNumsIdc < uint(3)) {
        // short term
        if (order.command[i].reorderingOfPicNumsIdc < uint(2)) {
            if (order.command[i].reorderingOfPicNumsIdc == uint(0)) {
                picNumNoWrap = int(picNumPred) - int(order.command[i].absDiffPicNum)
                if (picNumNoWrap < 0) {
                    picNumNoWrap += int(dpb.maxFrameNum)
                }
            } else {
                picNumNoWrap = int(picNumPred + order.command[i].absDiffPicNum)
                if (picNumNoWrap >= int(dpb.maxFrameNum)) {
                    picNumNoWrap -= int(dpb.maxFrameNum)
                }
            }
            picNumPred = uint(picNumNoWrap)
            picNum = picNumNoWrap
            if (uint(picNumNoWrap) > currFrameNum) {
                picNum -= int(dpb.maxFrameNum)
            }
            isShortTerm = uint(HANTRO_TRUE)
        } else {
            // long term
            picNum = int(order.command[i].longTermPicNum)
            isShortTerm = uint(HANTRO_FALSE)
        }
        // find corresponding picture from dpb
        index = h264_file_all__FindDpbPic(dpb, picNum, isShortTerm)
        if (index < 0 || !(uint(int(deref(dpb.buffer + index).status)) > uint(int(dpbPictureStatus_e.NON_EXISTING)))) {
            return uint(HANTRO_NOK)
        }
        // shift pictures
        {
            j = numRefIdxActive
            while (j > refIdx) {
                deref(dpb.list + j) = deref(dpb.list + (j - uint(1)))
                j--
            }
        }
        // put picture into the list
        let _t0 = refIdx
        refIdx++
        deref(dpb.list + _t0) = addr(deref(dpb.buffer + index))
        // remove later references to the same picture
        {
            k = refIdx
            j = k
            while (j <= numRefIdxActive) {
                if (intptr(deref(dpb.list + j)) != intptr(addr(deref(dpb.buffer + index)))) {
                    let _t1 = k
                    k++
                    deref(dpb.list + _t1) = deref(dpb.list + j)
                }
                j++
            }
        }
        i++
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop1(var dpb : dpbStorage_t?; currPicNum : uint; differenceOfPicNums : uint) : uint {
    // Variables
    var index : int
    var picNum : int
    // Code
    picNum = int(currPicNum) - int(differenceOfPicNums)
    index = h264_file_all__FindDpbPic(dpb, picNum, uint(HANTRO_TRUE))
    if (index < 0) {
        return uint(HANTRO_NOK)
    }
    deref(dpb.buffer + index).status = dpbPictureStatus_e.UNUSED
    dpb.numRefFrames--
    if (!(deref(dpb.buffer + index).toBeDisplayed != 0)) {
        dpb.fullness--
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop2(var dpb : dpbStorage_t?; longTermPicNum : uint) : uint {
    // Variables
    var index : int
    // Code
    index = h264_file_all__FindDpbPic(dpb, int(longTermPicNum), uint(HANTRO_FALSE))
    if (index < 0) {
        return uint(HANTRO_NOK)
    }
    deref(dpb.buffer + index).status = dpbPictureStatus_e.UNUSED
    dpb.numRefFrames--
    if (!(deref(dpb.buffer + index).toBeDisplayed != 0)) {
        dpb.fullness--
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop3(var dpb : dpbStorage_t?; currPicNum : uint; differenceOfPicNums : uint; longTermFrameIdx : uint) : uint {
    // Variables
    var index : int
    var picNum : int
    var i : uint
    // Code
    if (dpb.maxLongTermFrameIdx == uint(int(anon_105.NO_LONG_TERM_FRAME_INDICES)) || longTermFrameIdx > dpb.maxLongTermFrameIdx) {
        return uint(HANTRO_NOK)
    }
    // check if a long term picture with the same longTermFrameIdx already
    // exist and remove it if necessary
    {
        i = uint(0)
        while (i < dpb.maxRefFrames) {
            if (deref(dpb.buffer + i).status == dpbPictureStatus_e.LONG_TERM && uint(deref(dpb.buffer + i).picNum) == longTermFrameIdx) {
                deref(dpb.buffer + i).status = dpbPictureStatus_e.UNUSED
                dpb.numRefFrames--
                if (!(deref(dpb.buffer + i).toBeDisplayed != 0)) {
                    dpb.fullness--
                }
                break
            }
            i++
        }
    }
    picNum = int(currPicNum) - int(differenceOfPicNums)
    index = h264_file_all__FindDpbPic(dpb, picNum, uint(HANTRO_TRUE))
    if (index < 0) {
        return uint(HANTRO_NOK)
    }
    if (!(uint(int(deref(dpb.buffer + index).status)) > uint(int(dpbPictureStatus_e.NON_EXISTING)))) {
        return uint(HANTRO_NOK)
    }
    deref(dpb.buffer + index).status = dpbPictureStatus_e.LONG_TERM
    deref(dpb.buffer + index).picNum = int(longTermFrameIdx)
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop4(var dpb : dpbStorage_t?; maxLongTermFrameIdx : uint) : uint {
    // Variables
    var i : uint
    // Code
    dpb.maxLongTermFrameIdx = maxLongTermFrameIdx
    {
        i = uint(0)
        while (i < dpb.maxRefFrames) {
            if (deref(dpb.buffer + i).status == dpbPictureStatus_e.LONG_TERM && (uint(deref(dpb.buffer + i).picNum) > maxLongTermFrameIdx || dpb.maxLongTermFrameIdx == uint(int(anon_105.NO_LONG_TERM_FRAME_INDICES)))) {
                deref(dpb.buffer + i).status = dpbPictureStatus_e.UNUSED
                dpb.numRefFrames--
                if (!(deref(dpb.buffer + i).toBeDisplayed != 0)) {
                    dpb.fullness--
                }
            }
            i++
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop5(var dpb : dpbStorage_t?) : uint {
    // Variables
    // Code
    for (i in urange(uint(16))) {
        if (int(deref(dpb.buffer + i).status) != 0) {
            deref(dpb.buffer + i).status = dpbPictureStatus_e.UNUSED
            if (!(deref(dpb.buffer + i).toBeDisplayed != 0)) {
                dpb.fullness--
            }
        }
    }
    // output all pictures
    while (h264_file_all__OutputPicture(dpb) == uint(HANTRO_OK)) {
    }
    dpb.numRefFrames = uint(0)
    dpb.maxLongTermFrameIdx = uint(int(anon_105.NO_LONG_TERM_FRAME_INDICES))
    dpb.prevRefFrameNum = uint(0)
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop6(var dpb : dpbStorage_t?; frameNum : uint; picOrderCnt : int; longTermFrameIdx : uint) : uint {
    // Variables
    var i : uint
    // Code
    if (dpb.maxLongTermFrameIdx == uint(int(anon_105.NO_LONG_TERM_FRAME_INDICES)) || longTermFrameIdx > dpb.maxLongTermFrameIdx) {
        return uint(HANTRO_NOK)
    }
    // check if a long term picture with the same longTermFrameIdx already
    // exist and remove it if necessary
    {
        i = uint(0)
        while (i < dpb.maxRefFrames) {
            if (deref(dpb.buffer + i).status == dpbPictureStatus_e.LONG_TERM && uint(deref(dpb.buffer + i).picNum) == longTermFrameIdx) {
                deref(dpb.buffer + i).status = dpbPictureStatus_e.UNUSED
                dpb.numRefFrames--
                if (!(deref(dpb.buffer + i).toBeDisplayed != 0)) {
                    dpb.fullness--
                }
                break
            }
            i++
        }
    }
    if (dpb.numRefFrames < dpb.maxRefFrames) {
        dpb.currentOut.frameNum = frameNum
        dpb.currentOut.picNum = int(longTermFrameIdx)
        dpb.currentOut.picOrderCnt = picOrderCnt
        dpb.currentOut.status = dpbPictureStatus_e.LONG_TERM
        if (dpb.noReordering != 0) {
            dpb.currentOut.toBeDisplayed = uint(HANTRO_FALSE)
        } else {
            dpb.currentOut.toBeDisplayed = uint(HANTRO_TRUE)
        }
        dpb.numRefFrames++
        dpb.fullness++
        return uint(HANTRO_OK)
    } else {
        // if there is no room, return an error
        return uint(HANTRO_NOK)
    }
}

[c_function]
def h264bsdMarkDecRefPic(var dpb : dpbStorage_t?; var mark : decRefPicMarking_t?; var image : image_t?; var frameNum : uint; picOrderCnt : int; isIdr : uint; currentPicId : uint; numErrMbs : uint) : uint {
    // Variables
    var i : uint
    var status : uint
    var markedAsLongTerm : uint
    var toBeDisplayed : uint
    // Code
    if (intptr(image.data) != intptr(dpb.currentOut.data)) {
        return uint(HANTRO_NOK)
    }
    dpb.lastContainsMmco5 = uint(HANTRO_FALSE)
    status = uint(HANTRO_OK)
    toBeDisplayed = uint(dpb.noReordering != 0 ? HANTRO_FALSE : HANTRO_TRUE)
    // non-reference picture, stored for display reordering purposes
    if (mark == null) {
        dpb.currentOut.status = dpbPictureStatus_e.UNUSED
        dpb.currentOut.frameNum = frameNum
        dpb.currentOut.picNum = int(frameNum)
        dpb.currentOut.picOrderCnt = picOrderCnt
        dpb.currentOut.toBeDisplayed = toBeDisplayed
        if (!(dpb.noReordering != 0)) {
            dpb.fullness++
        }
    } elif (isIdr != 0) {
        // IDR picture
        // h264bsdCheckGapsInFrameNum not called for IDR pictures -> have to
        // reset numOut and outIndex here
        dpb.outIndex = uint(0)
        dpb.numOut = dpb.outIndex
        // flush the buffer
        h264_file_all__Mmcop5(dpb)
        // if noOutputOfPriorPicsFlag was set -> the pictures preceding the
        // IDR picture shall not be output -> set output buffer empty
        if (mark.noOutputOfPriorPicsFlag != 0 || dpb.noReordering != 0) {
            dpb.numOut = uint(0)
            dpb.outIndex = uint(0)
        }
        if (mark.longTermReferenceFlag != 0) {
            dpb.currentOut.status = dpbPictureStatus_e.LONG_TERM
            dpb.maxLongTermFrameIdx = uint(0)
        } else {
            dpb.currentOut.status = dpbPictureStatus_e.SHORT_TERM
            dpb.maxLongTermFrameIdx = uint(int(anon_105.NO_LONG_TERM_FRAME_INDICES))
        }
        dpb.currentOut.frameNum = uint(0)
        dpb.currentOut.picNum = 0
        dpb.currentOut.picOrderCnt = 0
        dpb.currentOut.toBeDisplayed = toBeDisplayed
        dpb.fullness = uint(1)
        dpb.numRefFrames = uint(1)
    } else {
        // reference picture
        markedAsLongTerm = uint(HANTRO_FALSE)
        if (mark.adaptiveRefPicMarkingModeFlag != 0) {
            i = uint(0)
            while (mark.operation[i].memoryManagementControlOperation != 0) {
                let _cond = mark.operation[i].memoryManagementControlOperation
                if (_cond == 1u) {
                    status = h264_file_all__Mmcop1(dpb, frameNum, mark.operation[i].differenceOfPicNums)
                } elif (_cond == 2u) {
                    status = h264_file_all__Mmcop2(dpb, mark.operation[i].longTermPicNum)
                } elif (_cond == 3u) {
                    status = h264_file_all__Mmcop3(dpb, frameNum, mark.operation[i].differenceOfPicNums, mark.operation[i].longTermFrameIdx)
                } elif (_cond == 4u) {
                    status = h264_file_all__Mmcop4(dpb, mark.operation[i].maxLongTermFrameIdx)
                } elif (_cond == 5u) {
                    status = h264_file_all__Mmcop5(dpb)
                    dpb.lastContainsMmco5 = uint(HANTRO_TRUE)
                    frameNum = uint(0)
                } elif (_cond == 6u) {
                    status = h264_file_all__Mmcop6(dpb, frameNum, picOrderCnt, mark.operation[i].longTermFrameIdx)
                    if (status == uint(HANTRO_OK)) {
                        markedAsLongTerm = uint(HANTRO_TRUE)
                    }
                } else {
                    // invalid memory management control operation
                    status = uint(HANTRO_NOK)
                }
                if (status != uint(HANTRO_OK)) {
                    break
                }
                i++
            }
        } else {
            status = h264_file_all__SlidingWindowRefPicMarking(dpb)
        }
        // if current picture was not marked as long-term reference by
        // memory management control operation 6 -> mark current as short
        // term and insert it into dpb (if there is room)
        if (!(markedAsLongTerm != 0)) {
            if (dpb.numRefFrames < dpb.maxRefFrames) {
                dpb.currentOut.frameNum = frameNum
                dpb.currentOut.picNum = int(frameNum)
                dpb.currentOut.picOrderCnt = picOrderCnt
                dpb.currentOut.status = dpbPictureStatus_e.SHORT_TERM
                dpb.currentOut.toBeDisplayed = toBeDisplayed
                dpb.fullness++
                dpb.numRefFrames++
            } else {
                // no room
                status = uint(HANTRO_NOK)
            }
        }
    }
    dpb.currentOut.isIdr = isIdr
    dpb.currentOut.picId = currentPicId
    dpb.currentOut.numErrMbs = numErrMbs
    // dpb was initialized to not to reorder the pictures -> output current
    // picture immediately
    if (dpb.noReordering != 0) {
        deref(dpb.outBuf + dpb.numOut).data = dpb.currentOut.data
        deref(dpb.outBuf + dpb.numOut).isIdr = dpb.currentOut.isIdr
        deref(dpb.outBuf + dpb.numOut).picId = dpb.currentOut.picId
        deref(dpb.outBuf + dpb.numOut).numErrMbs = dpb.currentOut.numErrMbs
        dpb.numOut++
    } else {
        // output pictures if buffer full
        while (dpb.fullness > dpb.dpbSize) {
            i = h264_file_all__OutputPicture(dpb)
        }
    }
    // sort dpb
    h264_file_all__ShellSort(dpb.buffer, dpb.dpbSize + uint(1))
