            ptr = ptr + 1
            tmp1 = deref(_t12)
            var _t13 = ptr
            ptr = ptr + 1
            tmp2 = deref(_t13)
            var _t14 = cr
            cr = cr + 1
            deref(_t14) = tmp1
            var _t15 = cr
