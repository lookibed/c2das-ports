def shim_reset_heap {
    h264_file_all__heap_offset = uint64(8)
}

[c_function]
def malloc1(size : uint64) : void? {
    var aligned_header : uint64 = uint64(typeinfo sizeof(type<HeapHeader>)) + uint64(7u) & ~uint64(7u)
    var aligned_size : uint64 = size + uint64(7u) & ~uint64(7u)
    var total : uint64 = aligned_header + aligned_size
    var header : HeapHeader? = null
    if (h264_file_all__heap_offset + total > uint64(typeinfo sizeof(type<uint8[33554432]>))) {
        return null
    }
    header = reinterpret<HeapHeader?>(addr(h264_file_all__heap[0]) + h264_file_all__heap_offset)
    header.size = size
    h264_file_all__heap_offset += total
    return reinterpret<void?>(reinterpret<uint8?>(header) + aligned_header)
}

def free1(var ptr : void?) {
}

[c_function]
def realloc1(var ptr : void?; size : uint64) : void? {
    var result : void? = malloc1(size)
    var old_size : uint64 = uint64(0)
    var copy_size : uint64 = uint64(0)
    var aligned_header : uint64 = uint64(typeinfo sizeof(type<HeapHeader>)) + uint64(7u) & ~uint64(7u)
    if (!(result != null)) {
        return null
    }
    if (ptr != null) {
        var dst : uint8? = reinterpret<uint8?>(result)
        var src : uint8? = reinterpret<uint8?>(ptr)
        var header : HeapHeader? = reinterpret<HeapHeader?>(src - aligned_header)
        old_size = header.size
        copy_size = old_size < size ? old_size : size
        for (i in urange64(copy_size)) {
            deref(dst + i) = deref(src + i)
        }
    }
    return result
}

[c_function]
def calloc1(count : uint64; size : uint64) : void? {
    var total : uint64 = count * size
    var result : void? = malloc1(total)
    if (!(result != null)) {
        return null
    }
    for (i in urange64(total)) {
        deref(reinterpret<uint8?>(result) + i) = uint8(0)
    }
    return result
}

[c_function]
def memset1(var dest : void?; value : int; count : uint64) : void? {
    var bytes : uint8? = reinterpret<uint8?>(dest)
    for (i in urange64(count)) {
        deref(bytes + i) = uint8(value)
    }
    return dest
}

[c_function]
def memcpy1(var dest : void?; var src : void?; count : uint64) : void? {
    var out : uint8? = reinterpret<uint8?>(dest)
    var _c_in : uint8? = reinterpret<uint8?>(src)
    for (i in urange64(count)) {
        deref(out + i) = deref(_c_in + i)
    }
    return dest
}

[c_function]
def memmove1(var dest : void?; var src : void?; count : uint64) : void? {
    var out : uint8? = reinterpret<uint8?>(dest)
    var _c_in : uint8? = reinterpret<uint8?>(src)
    var i : uint64 = uint64(0)
    if (intptr(out) == intptr(reinterpret<uint8?>(_c_in)) || count == uint64(0)) {
        return dest
    }
    if (intptr(out) < intptr(reinterpret<uint8?>(_c_in))) {
        for (i1 in urange64(count)) {
            deref(out + i1) = deref(_c_in + i1)
        }
    } else {
        {
            i = count
            while (i > uint64(0)) {
                deref(out + (i - uint64(1))) = deref(_c_in + (i - uint64(1)))
                i--
            }
        }
    }
    return dest
}

[c_function]
def memcmp1(var lhs : void?; var rhs : void?; count : uint64) : int {
    var left : uint8? = reinterpret<uint8?>(lhs)
    var right : uint8? = reinterpret<uint8?>(rhs)
    for (i in urange64(count)) {
        if (int(deref(left + i)) != int(deref(right + i))) {
            return int(deref(left + i)) - int(deref(right + i))
        }
    }
    return 0
}

[c_function]
def memchr1(var src : void?; value : int; count : uint64) : void? {
    var bytes : uint8? = reinterpret<uint8?>(src)
    for (i in urange64(count)) {
        if (int(deref(bytes + i)) == int(uint8(value))) {
            return reinterpret<void?>(bytes + i)
        }
    }
    return null
}

[c_function]
def strlen1(var src : uint8?) : uint64 {
    var count : uint64 = uint64(0)
    while (int(deref(src + count)) != '\0') {
        count += uint64(1)
    }
    return count
}

[c_function]
def strdup(var src : uint8?) : uint8? {
    var length : uint64 = strlen1(src)
    var copy : uint8? = reinterpret<uint8?>(malloc1(length + uint64(1u)))
    if (!(copy != null)) {
        return null
    }
    for (index in urange64(length)) {
        deref(copy + index) = deref(src + index)
    }
    deref(copy + length) = uint8('\0')
    return copy
}

def mallocz(size : uint64) : void? {
    return calloc1(uint64(1u), size)
}

[c_function]
def h264bsdExtractNalUnit(var pByteStream : uint8?; len : uint; var pStrmData : strmData_t?; var readBytes : uint?) : uint {
    // Variables
    var i : uint
    var tmp : uint
    var byteCount : uint
    var initByteCount : uint
    var zeroCount : uint
    var byte : uint8
    var hasEmulation : uint = uint(HANTRO_FALSE)
    var invalidStream : uint = uint(HANTRO_FALSE)
    var readPtr : uint8?
    var writePtr : uint8?
    // Code
    // byte stream format if starts with 0x000001 or 0x000000
    if (len > uint(3) && int(deref(pByteStream + 0)) == 0 && int(deref(pByteStream + 1)) == 0 && (int(deref(pByteStream + 2)) & 254) == 0) {
        // search for NAL unit start point, i.e. point after first start code
        // prefix in the stream
        byteCount = uint(2)
        zeroCount = byteCount
        readPtr = pByteStream + 2
        // lint -e(716) while(1) used consciously
        while (1 != 0) {
            var _t0 = readPtr
            readPtr = readPtr + 1
            byte = deref(_t0)
            byteCount++
            if (byteCount == len) {
                // no start code prefix found -> error
                deref(readBytes) = len
                return uint(HANTRO_NOK)
            }
            if (!(byte != 0)) {
                zeroCount++
            } elif (int(byte) == 1 && zeroCount >= uint(2)) {
                break
            } else {
                zeroCount = uint(0)
            }
        }
        initByteCount = byteCount
        // determine size of the NAL unit. Search for next start code prefix
        // or end of stream and ignore possible trailing zero bytes
        zeroCount = uint(0)
        // lint -e(716) while(1) used consciously
        while (1 != 0) {
            var _t1 = readPtr
            readPtr = readPtr + 1
            byte = deref(_t1)
            byteCount++
            if (!(byte != 0)) {
                zeroCount++
            }
            if (int(byte) == 3 && zeroCount == uint(2)) {
                hasEmulation = uint(HANTRO_TRUE)
            }
            if (int(byte) == 1 && zeroCount >= uint(2)) {
                pStrmData.strmBuffSize = byteCount - initByteCount - zeroCount - uint(1)
                zeroCount -= zeroCount < uint(3) ? zeroCount : uint(3)
                break
            } elif (byte != 0) {
                if (zeroCount >= uint(3)) {
                    invalidStream = uint(HANTRO_TRUE)
                }
                zeroCount = uint(0)
            }
            if (byteCount == len) {
                pStrmData.strmBuffSize = byteCount - initByteCount - zeroCount
                break
            }
        }
    } else {
        // separate NAL units as input -> just set stream params
        initByteCount = uint(0)
        zeroCount = uint(0)
        pStrmData.strmBuffSize = len
        hasEmulation = uint(HANTRO_TRUE)
    }
    pStrmData.pStrmBuffStart = pByteStream + initByteCount
    pStrmData.pStrmCurrPos = pStrmData.pStrmBuffStart
    pStrmData.bitPosInWord = uint(0)
    pStrmData.strmBuffReadBits = uint(0)
    // return number of bytes "consumed"
    deref(readBytes) = pStrmData.strmBuffSize + initByteCount + zeroCount
    if (invalidStream != 0) {
        return uint(HANTRO_NOK)
    }
    // remove emulation prevention bytes before rbsp processing
    if (hasEmulation != 0) {
        tmp = pStrmData.strmBuffSize
        writePtr = pStrmData.pStrmBuffStart
        readPtr = writePtr
        zeroCount = uint(0)
        {
            i = tmp
            while (true) {
                let _t2 = i
                i--
                if (!(_t2 != 0)) {
                    break
                }
                if (zeroCount == uint(2) && int(deref(readPtr)) == 3) {
                    // emulation prevention byte shall be followed by one of the
                    // following bytes: 0x00, 0x01, 0x02, 0x03. This implies that
                    // emulation prevention 0x03 byte shall not be the last byte
                    // of the stream.
                    if (i == uint(0) || int(deref(readPtr + 1)) > 3) {
                        return uint(HANTRO_NOK)
                    }
                    // do not write emulation prevention byte
                    readPtr = readPtr + 1
                    zeroCount = uint(0)
                } else {
                    // NAL unit shall not contain byte sequences 0x000000,
                    // 0x000001 or 0x000002
                    if (zeroCount == uint(2) && int(deref(readPtr)) <= 2) {
                        return uint(HANTRO_NOK)
                    }
                    if (int(deref(readPtr)) == 0) {
                        zeroCount++
                    } else {
                        zeroCount = uint(0)
                    }
                    var _t3 = writePtr
                    writePtr = writePtr + 1
                    var _t4 = readPtr
                    readPtr = readPtr + 1
                    deref(_t3) = deref(_t4)
                }
            }
        }
        // (readPtr - writePtr) indicates number of "removed" emulation
        // prevention bytes -> subtract from stream buffer size
        pStrmData.strmBuffSize -= uint(int64(readPtr - writePtr))
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__DecodeCoeffToken(bits : uint; nc : uint) : uint {
    // Variables
    var value : uint
    // Code
    // standard defines that nc for decoding of chroma dc coefficients is -1,
    // represented by u32 here -> -1 maps to 2^32 - 1
    if (nc < uint(2)) {
        if (bits >= uint(32768)) {
            value = uint(1)
        } elif (bits >= uint(3072)) {
            value = uint(h264_file_all__coeffToken0_0[bits >> 10u])
        } elif (bits >= uint(256)) {
            value = uint(h264_file_all__coeffToken0_1[bits >> 6u])
        } elif (bits >= uint(32)) {
            value = uint(h264_file_all__coeffToken0_2[(bits >> 2u) - uint(8)])
        } else {
            value = uint(h264_file_all__coeffToken0_3[bits])
        }
    } elif (nc < uint(4)) {
        if (bits >= uint(32768)) {
            value = uint((bits & uint(16384)) != 0 ? 2 : 2082)
        } elif (bits >= uint(4096)) {
            value = uint(h264_file_all__coeffToken2_0[bits >> 10u])
        } elif (bits >= uint(512)) {
            value = uint(h264_file_all__coeffToken2_1[bits >> 7u])
        } else {
            value = uint(h264_file_all__coeffToken2_2[bits >> 2u])
        }
    } elif (nc < uint(8)) {
        value = uint(h264_file_all__coeffToken4_0[bits >> 10u])
        if (!(value != 0)) {
            value = uint(h264_file_all__coeffToken4_1[bits >> 6u])
        }
    } elif (nc <= uint(16)) {
        value = uint(h264_file_all__coeffToken8[bits >> 10u])
    } else {
        value = uint(h264_file_all__coeffTokenMinus1_0[bits >> 13u])
        if (!(value != 0)) {
            value = uint(h264_file_all__coeffTokenMinus1_1[bits >> 8u])
        }
    }
    return value
}

def private h264_file_all__DecodeLevelPrefix(bits : uint) : uint {
    // Variables
    var numZeros : uint
    // Code
    if (bits >= uint(32768)) {
        numZeros = uint(0)
    } elif (bits >= uint(16384)) {
        numZeros = uint(1)
    } elif (bits >= uint(8192)) {
        numZeros = uint(2)
    } elif (bits >= uint(4096)) {
        numZeros = uint(3)
    } elif (bits >= uint(2048)) {
        numZeros = uint(4)
    } elif (bits >= uint(1024)) {
        numZeros = uint(5)
    } elif (bits >= uint(512)) {
        numZeros = uint(6)
    } elif (bits >= uint(256)) {
        numZeros = uint(7)
    } elif (bits >= uint(128)) {
        numZeros = uint(8)
    } elif (bits >= uint(64)) {
        numZeros = uint(9)
    } elif (bits >= uint(32)) {
        numZeros = uint(10)
    } elif (bits >= uint(16)) {
        numZeros = uint(11)
    } elif (bits >= uint(8)) {
        numZeros = uint(12)
    } elif (bits >= uint(4)) {
        numZeros = uint(13)
    } elif (bits >= uint(2)) {
        numZeros = uint(14)
    } elif (bits >= uint(1)) {
        numZeros = uint(15)
    } else {
        // more than 15 zeros encountered which is an error
        return VLC_NOT_FOUND
    }
    return numZeros
}

def private h264_file_all__DecodeTotalZeros(var bits : uint; totalCoeff : uint; isChromaDC : uint) : uint {
    // Variables
    var value : uint = uint(0)
    // Code
    if (!(isChromaDC != 0)) {
        let _cond = totalCoeff
        if (_cond == 1u) {
            value = uint(h264_file_all__totalZeros_1_0[bits >> 4u])
            if (!(value != 0)) {
                value = uint(h264_file_all__totalZeros_1_1[bits])
            }
        } elif (_cond == 2u) {
            value = uint(h264_file_all__totalZeros_2[bits >> 3u])
        } elif (_cond == 3u) {
            value = uint(h264_file_all__totalZeros_3[bits >> 3u])
        } elif (_cond == 4u) {
            value = uint(h264_file_all__totalZeros_4[bits >> 4u])
        } elif (_cond == 5u) {
            value = uint(h264_file_all__totalZeros_5[bits >> 4u])
        } elif (_cond == 6u) {
            value = uint(h264_file_all__totalZeros_6[bits >> 3u])
        } elif (_cond == 7u) {
            value = uint(h264_file_all__totalZeros_7[bits >> 3u])
        } elif (_cond == 8u) {
            value = uint(h264_file_all__totalZeros_8[bits >> 3u])
        } elif (_cond == 9u) {
            value = uint(h264_file_all__totalZeros_9[bits >> 3u])
        } elif (_cond == 10u) {
            value = uint(h264_file_all__totalZeros_10[bits >> 4u])
        } elif (_cond == 11u) {
            value = uint(h264_file_all__totalZeros_11[bits >> 5u])
        } elif (_cond == 12u) {
            value = uint(h264_file_all__totalZeros_12[bits >> 5u])
        } elif (_cond == 13u) {
            value = uint(h264_file_all__totalZeros_13[bits >> 6u])
        } elif (_cond == 14u) {
            value = uint(h264_file_all__totalZeros_14[bits >> 7u])
        } else {
            // case 15
            value = uint(bits >> 8u != 0 ? 17 : 1)
        }
    } else {
        bits >>= 6u
        if (bits > uint(3)) {
            value = uint(1)
        } else {
            if (totalCoeff == uint(3)) {
                value = uint(17)
            } elif (bits > uint(1)) {
                value = uint(18)
            } elif (totalCoeff == uint(2)) {
                value = uint(34)
            } elif (bits != 0) {
                value = uint(35)
            } else {
                value = uint(51)
            }
        }
    }
    return value
}

def private h264_file_all__DecodeRunBefore(bits : uint; zerosLeft : uint) : uint {
    // Variables
    var value : uint = uint(0)
    // Code
    let _cond = zerosLeft
    if (_cond == 1u) {
        value = uint(h264_file_all__runBefore_1[bits >> 10u])
    } elif (_cond == 2u) {
        value = uint(h264_file_all__runBefore_2[bits >> 9u])
    } elif (_cond == 3u) {
        value = uint(h264_file_all__runBefore_3[bits >> 9u])
    } elif (_cond == 4u) {
        value = uint(h264_file_all__runBefore_4[bits >> 8u])
    } elif (_cond == 5u) {
        value = uint(h264_file_all__runBefore_5[bits >> 8u])
    } elif (_cond == 6u) {
        value = uint(h264_file_all__runBefore_6[bits >> 8u])
    } else {
        if (bits >= uint(256)) {
            value = (uint(7) - (bits >> 8u) << 4u) + uint(3)
        } elif (bits >= uint(128)) {
            value = uint(116)
        } elif (bits >= uint(64)) {
            value = uint(133)
        } elif (bits >= uint(32)) {
            value = uint(150)
        } elif (bits >= uint(16)) {
            value = uint(167)
        } elif (bits >= uint(8)) {
            value = uint(184)
        } elif (bits >= uint(4)) {
            value = uint(201)
        } elif (bits >= uint(2)) {
            value = uint(218)
        } elif (bits != 0) {
            value = uint(235)
        }
        if ((value >> 4u & uint(15)) > zerosLeft) {
            value = uint(0)
        }
    }
    return value
}

[c_function]
def h264bsdDecodeResidualBlockCavlc(var pStrmData : strmData_t?; var coeffLevel : int?; nc : int; maxNumCoeff : uint) : uint {
    // Variables
    var i : uint
    var tmp : uint
    var totalCoeff : uint
    var trailingOnes : uint
    var suffixLength : uint
    var levelPrefix : uint
    var levelSuffix : uint
    var zerosLeft : uint
    var bit : uint
    var level : int[16]
    var run : uint[16]
    // stream "cache"
    var bufferValue : uint
    var bufferBits : uint
    // Code
    {
        // assume that coeffLevel array has been "cleaned" by caller
        bufferBits = uint(32)
        bufferValue = h264bsdShowBits32(pStrmData)
    }
    {
        // lint -e774 disable lint warning on always false comparison
        if (bufferBits < uint(16)) {
            if (h264bsdFlushBits(pStrmData, uint(32) - bufferBits) == 4294967295u) {
                return uint(1)
            }
            bufferValue = h264bsdShowBits32(pStrmData)
            bufferBits = uint(32)
        }
        bit = bufferValue >> uint(32 - 16)
    }
    // lint +e774
    tmp = h264_file_all__DecodeCoeffToken(bit, uint(nc))
    if (!(tmp != 0)) {
        return uint(HANTRO_NOK)
    }
    {
        bufferValue <<= tmp & uint(31)
        bufferBits -= tmp & uint(31)
    }
    totalCoeff = tmp >> 11u & uint(31)
    if (totalCoeff > maxNumCoeff) {
        return uint(HANTRO_NOK)
    }
    trailingOnes = tmp >> 5u & uint(63)
    if (totalCoeff != uint(0)) {
        i = uint(0)
        // nonzero coefficients: +/- 1
        if (trailingOnes != 0) {
            {
                if (bufferBits < trailingOnes) {
                    if (h264bsdFlushBits(pStrmData, uint(32) - bufferBits) == 4294967295u) {
                        return uint(1)
                    }
                    bufferValue = h264bsdShowBits32(pStrmData)
                    bufferBits = uint(32)
                }
                bit = bufferValue >> uint(32) - trailingOnes
                bufferValue <<= trailingOnes
                bufferBits -= trailingOnes
            }
            tmp = uint(1 << int(trailingOnes - uint(1)))
            {
                while (tmp != 0) {
                    level[i] = (bit & tmp) != 0 ? -1 : 1
                    tmp >>= 1u
                    i++
                }
            }
        }
        // other levels
        if (totalCoeff > uint(10) && trailingOnes < uint(3)) {
            suffixLength = uint(1)
        } else {
            suffixLength = uint(0)
        }
        {
            while (i < totalCoeff) {
                {
                    if (bufferBits < uint(16)) {
                        if (h264bsdFlushBits(pStrmData, uint(32) - bufferBits) == 4294967295u) {
                            return uint(1)
                        }
                        bufferValue = h264bsdShowBits32(pStrmData)
                        bufferBits = uint(32)
                    }
                    bit = bufferValue >> uint(32 - 16)
                }
                levelPrefix = h264_file_all__DecodeLevelPrefix(bit)
                if (levelPrefix == VLC_NOT_FOUND) {
                    return uint(HANTRO_NOK)
                }
                {
                    bufferValue <<= levelPrefix + uint(1)
                    bufferBits -= levelPrefix + uint(1)
                }
                if (levelPrefix < uint(14)) {
                    tmp = suffixLength
                } elif (levelPrefix == uint(14)) {
                    tmp = suffixLength != 0 ? suffixLength : uint(4)
                } else {
                    // setting suffixLength to 1 here corresponds to adding 15
                    // to levelCode value if levelPrefix == 15 and
                    // suffixLength == 0
                    if (!(suffixLength != 0)) {
                        suffixLength = uint(1)
                    }
                    tmp = uint(12)
                }
                if (suffixLength != 0) {
                    levelPrefix <<= suffixLength
                }
                if (tmp != 0) {
                    {
                        if (bufferBits < tmp) {
                            if (h264bsdFlushBits(pStrmData, uint(32) - bufferBits) == 4294967295u) {
                                return uint(1)
                            }
                            bufferValue = h264bsdShowBits32(pStrmData)
                            bufferBits = uint(32)
                        }
                        levelSuffix = bufferValue >> uint(32) - tmp
                        bufferValue <<= tmp
                        bufferBits -= tmp
                    }
                    levelPrefix += levelSuffix
                }
                tmp = levelPrefix
                if (i == trailingOnes && trailingOnes < uint(3)) {
                    tmp += uint(2)
                }
                level[i] = int(tmp + uint(2) >> 1u)
                if (suffixLength == uint(0)) {
                    suffixLength = uint(1)
                }
                if (level[i] > 3 << int(suffixLength - uint(1)) && suffixLength < uint(6)) {
                    suffixLength++
                }
                if ((tmp & uint(1)) != 0) {
                    level[i] = -level[i]
                }
                i++
            }
        }
        // zero runs
        if (totalCoeff < maxNumCoeff) {
            {
                if (bufferBits < uint(9)) {
                    if (h264bsdFlushBits(pStrmData, uint(32) - bufferBits) == 4294967295u) {
                        return uint(1)
                    }
                    bufferValue = h264bsdShowBits32(pStrmData)
                    bufferBits = uint(32)
                }
                bit = bufferValue >> uint(32 - 9)
            }
            zerosLeft = h264_file_all__DecodeTotalZeros(bit, totalCoeff, uint(maxNumCoeff == uint(4) ? 1 : 0))
            if (!(zerosLeft != 0)) {
                return uint(HANTRO_NOK)
            }
            {
                bufferValue <<= zerosLeft & uint(15)
                bufferBits -= zerosLeft & uint(15)
            }
            zerosLeft = zerosLeft >> 4u & uint(15)
        } else {
            zerosLeft = uint(0)
        }
        for (i1 in urange(totalCoeff - uint(1))) {
            if (zerosLeft > uint(0)) {
                {
                    if (bufferBits < uint(11)) {
                        if (h264bsdFlushBits(pStrmData, uint(32) - bufferBits) == 4294967295u) {
                            return uint(1)
                        }
                        bufferValue = h264bsdShowBits32(pStrmData)
                        bufferBits = uint(32)
                    }
                    bit = bufferValue >> uint(32 - 11)
                }
                tmp = h264_file_all__DecodeRunBefore(bit, zerosLeft)
                if (!(tmp != 0)) {
                    return uint(HANTRO_NOK)
                }
                {
                    bufferValue <<= tmp & uint(15)
                    bufferBits -= tmp & uint(15)
                }
                run[i1] = tmp >> 4u & uint(15)
                let _t0 = run[i1]
                run[i1]++
                zerosLeft -= _t0
            } else {
                run[i1] = uint(1)
            }
        }
        // combining level and run, levelSuffix variable used to hold coeffMap,
        // i.e. bit map indicating which coefficients had non-zero value.
        // lint -esym(771,level,run) level and run are always initialized
        tmp = zerosLeft
        deref(coeffLevel + tmp) = level[totalCoeff - uint(1)]
        levelSuffix = uint(1 << int(tmp))
        {
            i = totalCoeff - uint(1)
            while (true) {
                let _t1 = i
                i--
                if (!(_t1 != 0)) {
                    break
                }
                tmp += run[i]
                levelSuffix |= uint(1 << int(tmp))
                deref(coeffLevel + tmp) = level[i]
            }
        }
    } else {
        levelSuffix = uint(0)
    }
    if (h264bsdFlushBits(pStrmData, uint(32) - bufferBits) != uint(HANTRO_OK)) {
        return uint(HANTRO_NOK)
    }
    return totalCoeff << 4u | levelSuffix << 16u
}

[c_function]
def h264bsdConceal(var pStorage : storage?; var currImage : image_t?; sliceType : uint) : uint {
    // Variables
    var i : uint
    var j : uint
    var row : uint
    var col : uint
    var width : uint
    var height : uint
    var refData : uint8?
    var mb : mbStorage?
    // Code
    width = currImage.width
    height = currImage.height
    refData = null
    // use reference picture with smallest available index
    if (sliceType == uint(int(anon_104.P_SLICE)) || sliceType == uint(int(anon_104.P_SLICE) + 5) || pStorage.intraConcealmentFlag != uint(0)) {
        i = uint(0)
        while (true) {
            refData = h264bsdGetRefPicData(addr(pStorage.dpb[0]), i)
            i++
            if (i >= uint(16)) {
                break
            }
            if (!(refData == null)) {
                break
            }
        }
    }
    col = uint(0)
    row = col
    i = row
    // find first properly decoded macroblock -> start point for concealment
    while (i < pStorage.picSizeInMbs && !(deref(pStorage.mb + i).decoded != 0)) {
        i++
        col++
        if (col == width) {
            row++
            col = uint(0)
        }
    }
    // whole picture lost -> copy previous or set grey
    if (i == pStorage.picSizeInMbs) {
        if ((sliceType == uint(int(anon_104.I_SLICE)) || sliceType == uint(int(anon_104.I_SLICE) + 5)) && pStorage.intraConcealmentFlag == uint(0) || refData == null) {
            memset1(reinterpret<void?>(currImage.data), 128, uint64(width * height * uint(384)))
        } else {
            memcpy1(reinterpret<void?>(currImage.data), reinterpret<void?>(refData), uint64(width * height * uint(384)))
        }
        pStorage.numConcealedMbs = pStorage.picSizeInMbs
        // no filtering if whole picture concealed
        {
            i = uint(0)
            while (i < pStorage.picSizeInMbs) {
                deref(pStorage.mb + i).disableDeblockingFilterIdc = uint(1)
                i++
            }
        }
        return uint(HANTRO_OK)
    }
    // start from the row containing the first correct macroblock, conceal the
    // row in question, all rows above that row and then continue downwards
    mb = pStorage.mb + row * width
    {
        j = col
        while (true) {
            let _t0 = j
            j--
            if (!(_t0 != 0)) {
                break
            }
            h264_file_all__ConcealMb(mb + j, currImage, row, j, sliceType, refData)
            deref(mb + j).decoded = uint(1)
            pStorage.numConcealedMbs++
        }
    }
    for (j1 in urange(col + uint(1), width)) {
        if (!(deref(mb + j1).decoded != 0)) {
            h264_file_all__ConcealMb(mb + j1, currImage, row, j1, sliceType, refData)
            deref(mb + j1).decoded = uint(1)
            pStorage.numConcealedMbs++
        }
    }
    // if previous row(s) could not be concealed -> conceal them now
    if (row != 0) {
        for (j1 in urange(width)) {
            i = row - uint(1)
            mb = pStorage.mb + i * width + j1
            while (true) {
                h264_file_all__ConcealMb(mb, currImage, i, j1, sliceType, refData)
                mb.decoded = uint(1)
                pStorage.numConcealedMbs++
                mb = mb - width
                let _t1 = i
                i--
                if (!(_t1 != 0)) {
                    break
                }
            }
        }
    }
    // process rows below the one containing the first correct macroblock
    for (i1 in urange(row + uint(1), height)) {
        mb = pStorage.mb + i1 * width
        for (j1 in urange(width)) {
            if (!(deref(mb + j1).decoded != 0)) {
                h264_file_all__ConcealMb(mb + j1, currImage, i1, j1, sliceType, refData)
                deref(mb + j1).decoded = uint(1)
                pStorage.numConcealedMbs++
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__ConcealMb(var pMb : mbStorage?; var currImage : image_t?; row : uint; col : uint; sliceType : uint; var refData : uint8?) : uint {
