[c_function]
def private h264_file_all__Write4x4To16x16(var data : uint8?; var data4x4 : uint8?; blockNum : uint) {
    // Variables
    var x : uint
    var y : uint
    var in32 : uint?
    var out32 : uint?
    // Code
    x = h264bsdBlockX[blockNum]
    y = h264bsdBlockY[blockNum]
    data = data + (y * uint(16) + x)
    // lint --e(826)
    out32 = reinterpret<uint?>(data)
    // lint --e(826)
    in32 = reinterpret<uint?>(data4x4)
    var _t0 = in32
    in32 = in32 + 1
    deref(out32 + 0) = deref(_t0)
    var _t1 = in32
    in32 = in32 + 1
    deref(out32 + 4) = deref(_t1)
    var _t2 = in32
    in32 = in32 + 1
    deref(out32 + 8) = deref(_t2)
    var _t3 = in32
    in32 = in32 + 1
    deref(out32 + 12) = deref(_t3)
}

def private h264_file_all__DetermineIntra4x4PredMode(var pMbLayer : macroblockLayer_t?; available : uint; var nA : neighbour_t?; var nB : neighbour_t?; index : uint; var nMbA : mbStorage?; var nMbB : mbStorage?) : uint {
    // Variables
    var mode1 : uint
    var mode2 : uint
    var pMb : mbStorage?
    // Code
    // dc only prediction?
    if (!(available != 0)) {
        mode1 = uint(2)
    } else {
        pMb = nMbA
        if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA4x4) {
            mode1 = uint(pMb.intra4x4PredMode[int(nA.index)])
        } else {
            mode1 = uint(2)
        }
        pMb = nMbB
        if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA4x4) {
            mode2 = uint(pMb.intra4x4PredMode[int(nB.index)])
        } else {
            mode2 = uint(2)
        }
        mode1 = mode1 < mode2 ? mode1 : mode2
    }
    if (!(pMbLayer.mbPred.prevIntra4x4PredModeFlag[index] != 0)) {
        if (pMbLayer.mbPred.remIntra4x4PredMode[index] < mode1) {
            mode1 = pMbLayer.mbPred.remIntra4x4PredMode[index]
        } else {
            mode1 = pMbLayer.mbPred.remIntra4x4PredMode[index] + uint(1)
        }
    }
    return mode1
}

[c_function]
def h264bsdDecodeMacroblockLayer(var pStrmData : strmData_t?; var pMbLayer : macroblockLayer_t?; var pMb : mbStorage?; sliceType : uint; numRefIdxActive : uint) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var itmp : int
    var partMode : mbPartPredMode_e
    // Code
    memset1(reinterpret<void?>(pMbLayer), 0, uint64(typeinfo sizeof(type<macroblockLayer_t>)))
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (sliceType == uint(int(anon_104.I_SLICE)) || sliceType == uint(int(anon_104.I_SLICE) + 5)) {
        if (value + uint(6) > uint(31) || tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        pMbLayer.mbType = enum_from_int(type<mbType_e>, int(value + uint(6)))
    } else {
        if (value + uint(1) > uint(31) || tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        pMbLayer.mbType = enum_from_int(type<mbType_e>, int(value + uint(1)))
    }
    if (pMbLayer.mbType == mbType_e.I_PCM) {
        var level : int?
        while (!(h264bsdIsByteAligned(pStrmData) != 0)) {
            // pcm_alignment_zero_bit
            tmp = h264bsdGetBits(pStrmData, uint(1))
            if (tmp != 0) {
                return uint(HANTRO_NOK)
            }
        }
        level = addr(pMbLayer.residual.level[0][0])
        for (i in urange(uint(384))) {
            value = h264bsdGetBits(pStrmData, uint(8))
            if (value == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            var _t0 = level
            level = level + 1
            deref(_t0) = int(value)
        }
    } else {
        partMode = h264bsdMbPartPredMode(pMbLayer.mbType)
        if (partMode == mbPartPredMode_e.PRED_MODE_INTER && h264bsdNumMbPart(pMbLayer.mbType) == uint(4)) {
            tmp = h264_file_all__DecodeSubMbPred(pStrmData, addr(pMbLayer.subMbPred), pMbLayer.mbType, numRefIdxActive)
        } else {
            tmp = h264_file_all__DecodeMbPred(pStrmData, addr(pMbLayer.mbPred), pMbLayer.mbType, numRefIdxActive)
        }
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (partMode != mbPartPredMode_e.PRED_MODE_INTRA16x16) {
            tmp = h264bsdDecodeExpGolombMapped(pStrmData, addr(value), uint(partMode == mbPartPredMode_e.PRED_MODE_INTRA4x4 ? 1 : 0))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pMbLayer.codedBlockPattern = value
        } else {
            pMbLayer.codedBlockPattern = h264_file_all__CbpIntra16x16(pMbLayer.mbType)
        }
        if (pMbLayer.codedBlockPattern != 0 || partMode == mbPartPredMode_e.PRED_MODE_INTRA16x16) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK) || itmp < -26 || itmp > 25) {
                return uint(HANTRO_NOK)
            }
            pMbLayer.mbQpDelta = itmp
            tmp = h264_file_all__DecodeResidual(pStrmData, addr(pMbLayer.residual), pMb, pMbLayer.mbType, pMbLayer.codedBlockPattern)
            pStrmData.strmBuffReadBits = uint(int64(pStrmData.pStrmCurrPos - pStrmData.pStrmBuffStart)) * uint(8) + pStrmData.bitPosInWord
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    return uint(HANTRO_OK)
}

def h264bsdMbPartPredMode(mbType : mbType_e) : mbPartPredMode_e {
    // Variables
    // Code
    if (uint(int(mbType)) <= uint(int(mbType_e.P_8x8ref0))) {
        return mbPartPredMode_e.PRED_MODE_INTER
    } elif (mbType == mbType_e.I_4x4) {
        return mbPartPredMode_e.PRED_MODE_INTRA4x4
    } else {
        return mbPartPredMode_e.PRED_MODE_INTRA16x16
    }
}

def h264bsdNumMbPart(mbType : mbType_e) : uint {
    // Variables
    // Code
    let _cond = mbType
    if (_cond == mbType_e.P_L0_16x16 || _cond == mbType_e.P_Skip) {
        return uint(1)
    } elif (_cond == mbType_e.P_L0_L0_16x8 || _cond == mbType_e.P_L0_L0_8x16) {
        return uint(2)
    } else {
        // P_8x8 or P_8x8ref0
        return uint(4)
    }
    return uint(0)
}

def h264bsdNumSubMbPart(subMbType : subMbType_e) : uint {
    // Variables
    // Code
    let _cond = subMbType
    if (_cond == subMbType_e.P_L0_8x8) {
        return uint(1)
    } elif (_cond == subMbType_e.P_L0_8x4 || _cond == subMbType_e.P_L0_4x8) {
        return uint(2)
    } else {
        // P_L0_4x4
        return uint(4)
    }
    return uint(0)
}

[c_function]
def private h264_file_all__DecodeMbPred(var pStrmData : strmData_t?; var pMbPred : mbPred_t?; mbType : mbType_e; numRefIdxActive : uint) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var j : uint
    var value : uint
    var itmp : int
    // Code
    let _cond = h264bsdMbPartPredMode(mbType)
    while (true) {
        var _flag = false
        if (_cond == mbPartPredMode_e.PRED_MODE_INTER) {
            // PRED_MODE_INTER
            if (numRefIdxActive > uint(1)) {
                {
                    i = h264bsdNumMbPart(mbType)
                    j = uint(0)
                    while (true) {
                        let _t0 = i
                        i--
                        if (!(_t0 != 0)) {
                            break
                        }
                        tmp = h264bsdDecodeExpGolombTruncated(pStrmData, addr(value), uint(numRefIdxActive > uint(2) ? 1 : 0))
                        if (tmp != uint(HANTRO_OK) || value >= numRefIdxActive) {
                            return uint(HANTRO_NOK)
                        }
                        pMbPred.refIdxL0[j] = value
                        j++
                    }
                }
            }
            {
                i = h264bsdNumMbPart(mbType)
                j = uint(0)
                while (true) {
                    let _t1 = i
                    i--
                    if (!(_t1 != 0)) {
                        break
                    }
                    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pMbPred.mvdL0[j].hor = int16(itmp)
                    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pMbPred.mvdL0[j].ver = int16(itmp)
                    j++
                }
            }
            break
        }
        _flag ||= _cond == mbPartPredMode_e.PRED_MODE_INTRA4x4
        if (_flag) {
            {
                itmp = 0
                i = uint(0)
                while (itmp < 2) {
                    value = h264bsdShowBits32(pStrmData)
                    tmp = uint(0)
                    {
                        j = uint(8)
                        while (true) {
                            let _t2 = j
                            j--
                            if (!(_t2 != 0)) {
                                break
                            }
                            pMbPred.prevIntra4x4PredModeFlag[i] = uint((value & 2147483648u) != 0 ? HANTRO_TRUE : HANTRO_FALSE)
                            value <<= 1u
                            if (!(pMbPred.prevIntra4x4PredModeFlag[i] != 0)) {
                                pMbPred.remIntra4x4PredMode[i] = value >> 29u
                                value <<= 3u
                                tmp++
                            }
                            i++
                        }
                    }
                    if (h264bsdFlushBits(pStrmData, uint(8) + uint(3) * tmp) == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    itmp++
                }
            }
        }
        _flag ||= _cond == mbPartPredMode_e.PRED_MODE_INTRA16x16
        if (_flag) {
            // fall-through
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK) || value > uint(3)) {
                return uint(HANTRO_NOK)
            }
            pMbPred.intraChromaPredMode = value
            break
        }
        break
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeSubMbPred(var pStrmData : strmData_t?; var pSubMbPred : subMbPred_t?; mbType : mbType_e; numRefIdxActive : uint) : uint {
    // Variables
    var tmp : uint
    var j : uint
    var value : uint
    var itmp : int
    // Code
    for (i in urange(uint(4))) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK) || value > uint(3)) {
            return uint(HANTRO_NOK)
        }
        pSubMbPred.subMbType[i] = enum_from_int(type<subMbType_e>, int(value))
    }
    if (numRefIdxActive > uint(1) && mbType != mbType_e.P_8x8ref0) {
        for (i in urange(uint(4))) {
            tmp = h264bsdDecodeExpGolombTruncated(pStrmData, addr(value), uint(numRefIdxActive > uint(2) ? 1 : 0))
            if (tmp != uint(HANTRO_OK) || value >= numRefIdxActive) {
                return uint(HANTRO_NOK)
            }
            pSubMbPred.refIdxL0[i] = value
        }
    }
    for (i in urange(uint(4))) {
        j = uint(0)
        {
            value = h264bsdNumSubMbPart(pSubMbPred.subMbType[i])
            while (true) {
                let _t0 = value
                value--
                if (!(_t0 != 0)) {
                    break
                }
                tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pSubMbPred.mvdL0[i][j].hor = int16(itmp)
                tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pSubMbPred.mvdL0[i][j].ver = int16(itmp)
                j++
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeResidual(var pStrmData : strmData_t?; var pResidual : residual_t?; var pMb : mbStorage?; mbType : mbType_e; var codedBlockPattern : uint) : uint {
    // Variables
    var i : uint
    var j : uint
    var tmp : uint
    var nc : int
    var blockCoded : uint
    var blockIndex : uint
    var is16x16 : uint
    var level : int[16]?
    // Code
    level = addr(pResidual.level[0])
    // luma DC is at index 24
    if (h264bsdMbPartPredMode(mbType) == mbPartPredMode_e.PRED_MODE_INTRA16x16) {
        nc = int(h264_file_all__DetermineNc(pMb, uint(0), addr(pResidual.totalCoeff[0])))
        tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(deref(level + 24)[0]), nc, uint(16))
        if ((tmp & uint(15)) != uint(HANTRO_OK)) {
            return tmp
        }
        pResidual.totalCoeff[24] = int16(tmp >> 4u & uint(255))
        is16x16 = uint(HANTRO_TRUE)
    } else {
        is16x16 = uint(HANTRO_FALSE)
    }
    {
        i = uint(4)
        blockIndex = uint(0)
        while (true) {
            let _t0 = i
            i--
            if (!(_t0 != 0)) {
                break
            }
            // luma cbp in bits 0-3
            blockCoded = codedBlockPattern & uint(1)
            codedBlockPattern >>= 1u
            if (blockCoded != 0) {
                {
                    j = uint(4)
                    while (true) {
                        let _t1 = j
                        j--
                        if (!(_t1 != 0)) {
                            break
                        }
                        nc = int(h264_file_all__DetermineNc(pMb, blockIndex, addr(pResidual.totalCoeff[0])))
                        if (is16x16 != 0) {
                            tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(deref(level + blockIndex)[0]) + 1, nc, uint(15))
                            pResidual.coeffMap[blockIndex] = tmp >> 15u
                        } else {
                            tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(deref(level + blockIndex)[0]), nc, uint(16))
                            pResidual.coeffMap[blockIndex] = tmp >> 16u
                        }
                        if ((tmp & uint(15)) != uint(HANTRO_OK)) {
                            return tmp
                        }
                        pResidual.totalCoeff[blockIndex] = int16(tmp >> 4u & uint(255))
                        blockIndex++
                    }
                }
            } else {
                blockIndex += uint(4)
            }
        }
    }
    // chroma DC block are at indices 25 and 26
    blockCoded = codedBlockPattern & uint(3)
    if (blockCoded != 0) {
        tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(deref(level + 25)[0]), -1, uint(4))
        if ((tmp & uint(15)) != uint(HANTRO_OK)) {
            return tmp
        }
        pResidual.totalCoeff[25] = int16(tmp >> 4u & uint(255))
        tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(deref(level + 25)[0]) + 4, -1, uint(4))
        if ((tmp & uint(15)) != uint(HANTRO_OK)) {
            return tmp
        }
        pResidual.totalCoeff[26] = int16(tmp >> 4u & uint(255))
    }
    // chroma AC
    blockCoded = codedBlockPattern & uint(2)
    if (blockCoded != 0) {
        {
            i = uint(8)
            while (true) {
                let _t2 = i
                i--
                if (!(_t2 != 0)) {
                    break
                }
                nc = int(h264_file_all__DetermineNc(pMb, blockIndex, addr(pResidual.totalCoeff[0])))
                tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(deref(level + blockIndex)[0]) + 1, nc, uint(15))
                if ((tmp & uint(15)) != uint(HANTRO_OK)) {
                    return tmp
                }
                pResidual.totalCoeff[blockIndex] = int16(tmp >> 4u & uint(255))
                pResidual.coeffMap[blockIndex] = tmp >> 15u
                blockIndex++
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DetermineNc(var pMb : mbStorage?; blockIndex : uint; var pTotalCoeff : int16?) : uint {
    // lint -e702
    // Variables
    var tmp : uint
    var n : int
    var neighbourA : neighbour_t?
    var neighbourB : neighbour_t?
    var neighbourAindex : uint8
    var neighbourBindex : uint8
    // Code
    // if neighbour block belongs to current macroblock totalCoeff array
    // mbStorage has not been set/updated yet -> use pTotalCoeff
    neighbourA = h264bsdNeighbour4x4BlockA(blockIndex)
    neighbourB = h264bsdNeighbour4x4BlockB(blockIndex)
    neighbourAindex = neighbourA.index
    neighbourBindex = neighbourB.index
    if (neighbourA.mb == neighbourMb_e.MB_CURR && neighbourB.mb == neighbourMb_e.MB_CURR) {
        n = int(deref(pTotalCoeff + int(neighbourAindex))) + int(deref(pTotalCoeff + int(neighbourBindex))) + 1 >> 1
    } elif (neighbourA.mb == neighbourMb_e.MB_CURR) {
        n = int(deref(pTotalCoeff + int(neighbourAindex)))
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbB) != 0) {
            n = n + int(pMb.mbB.totalCoeff[int(neighbourBindex)]) + 1 >> 1
        }
    } elif (neighbourB.mb == neighbourMb_e.MB_CURR) {
        n = int(deref(pTotalCoeff + int(neighbourBindex)))
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbA) != 0) {
            n = n + int(pMb.mbA.totalCoeff[int(neighbourAindex)]) + 1 >> 1
        }
    } else {
        tmp = uint(0)
        n = int(tmp)
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbA) != 0) {
            n = int(pMb.mbA.totalCoeff[int(neighbourAindex)])
            tmp = uint(1)
        }
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbB) != 0) {
            if (tmp != 0) {
                n = n + int(pMb.mbB.totalCoeff[int(neighbourBindex)]) + 1 >> 1
            } else {
                n = int(pMb.mbB.totalCoeff[int(neighbourBindex)])
            }
        }
    }
    return uint(n)
}

def private h264_file_all__CbpIntra16x16(mbType : mbType_e) : uint {
    // Variables
    var cbp : uint
    var tmp : uint
    // Code
    if (uint(int(mbType)) >= uint(int(mbType_e.I_16x16_0_0_1))) {
        cbp = uint(15)
    } else {
        cbp = uint(0)
    }
    // tmp is 0 for I_16x16_0_0_0 mb type
    // ignore lint warning on arithmetic on enum's
    // lint -e(656)
    tmp = uint(int(mbType)) - uint(int(mbType_e.I_16x16_0_0_0)) >> 2u
    if (tmp > uint(2)) {
        tmp -= uint(3)
    }
    cbp += tmp << 4u
    return cbp
}

def h264bsdPredModeIntra16x16(mbType : mbType_e) : uint {
    // Variables
    var tmp : uint
    // Code
    // tmp is 0 for I_16x16_0_0_0 mb type
    // ignore lint warning on arithmetic on enum's
    // lint -e(656)
    tmp = uint(int(mbType)) - uint(int(mbType_e.I_16x16_0_0_0))
    return tmp & uint(3)
}

[c_function]
def h264bsdDecodeMacroblock(var pMb : mbStorage?; var pMbLayer : macroblockLayer_t?; var currImage : image_t?; var dpb : dpbStorage_t?; var qpY : int?; mbNum : uint; constrainedIntraPredFlag : uint; var data : uint8?) : uint {
    // Variables
    var i : uint
    var tmp : uint
    var mbType : mbType_e
    // Code
    mbType = pMbLayer.mbType
    pMb.mbType = mbType
    pMb.decoded++
    h264bsdSetCurrImageMbPointers(currImage, mbNum)
    if (mbType == mbType_e.I_PCM) {
        var pData : uint8? = data
        var tot : int16? = addr(pMb.totalCoeff[0])
        var lev : int? = addr(pMbLayer.residual.level[0][0])
        pMb.qpY = uint(0)
        // if decoded flag > 1 -> mb has already been successfully decoded and
        // written to output -> do not write again
        if (pMb.decoded > uint(1)) {
            {
                i = uint(24)
                while (true) {
                    let _t0 = i
                    i--
                    if (!(_t0 != 0)) {
                        break
                    }
                    var _t1 = tot
                    tot = tot + 1
                    deref(_t1) = int16(16)
                }
            }
            return uint(HANTRO_OK)
        }
        {
            i = uint(24)
            while (true) {
                let _t2 = i
                i--
                if (!(_t2 != 0)) {
                    break
                }
                var _t3 = tot
                tot = tot + 1
                deref(_t3) = int16(16)
                {
                    tmp = uint(16)
                    while (true) {
                        let _t4 = tmp
                        tmp--
                        if (!(_t4 != 0)) {
                            break
                        }
                        var _t5 = pData
                        pData = pData + 1
                        var _t6 = lev
                        lev = lev + 1
                        deref(_t5) = uint8(deref(_t6))
                    }
                }
            }
        }
        h264bsdWriteMacroblock(currImage, data)
        return uint(HANTRO_OK)
    } else {
        if (mbType != mbType_e.P_Skip) {
            memcpy1(reinterpret<void?>(addr(pMb.totalCoeff[0])), reinterpret<void?>(addr(pMbLayer.residual.totalCoeff[0])), uint64(27) * uint64(typeinfo sizeof(type<int16>)))
            // update qpY
            if (pMbLayer.mbQpDelta != 0) {
                deref(qpY) += pMbLayer.mbQpDelta
                if (deref(qpY) < 0) {
                    deref(qpY) += 52
                } elif (deref(qpY) >= 52) {
                    deref(qpY) -= 52
                }
            }
            pMb.qpY = uint(deref(qpY))
            tmp = h264_file_all__ProcessResidual(pMb, addr(pMbLayer.residual.level[0]), addr(pMbLayer.residual.coeffMap[0]))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        } else {
            memset1(reinterpret<void?>(addr(pMb.totalCoeff[0])), 0, uint64(27) * uint64(typeinfo sizeof(type<int16>)))
            pMb.qpY = uint(deref(qpY))
        }
        // if decoded flag > 1 -> mb has already been successfully decoded and
        // written to output -> do not write again
        if (h264bsdMbPartPredMode(mbType) != mbPartPredMode_e.PRED_MODE_INTER) {
            tmp = h264bsdIntraPrediction(pMb, pMbLayer, currImage, mbNum, constrainedIntraPredFlag, data)
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        } else {
            tmp = h264bsdInterPrediction(pMb, pMbLayer, dpb, mbNum, currImage, data)
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__ProcessResidual(var pMb : mbStorage?; var residualLevel : int[16]?; var coeffMap : uint?) : uint {
    // Variables
    var i : uint
    var chromaQp : uint
    var blockData : int[16]?
    var blockDc : int[16]?
    var totalCoeff : int16?
    var chromaDc : int?
    var dcCoeffIdx : uint?
    // Code
    // set pointers to DC coefficient blocks
    blockDc = residualLevel + 24
    blockData = residualLevel
    totalCoeff = addr(pMb.totalCoeff[0])
    if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA16x16) {
        if (deref(totalCoeff + 24) != 0) {
            h264bsdProcessLumaDc(addr(deref(blockDc)[0]), pMb.qpY)
        }
        dcCoeffIdx = addr(h264_file_all__dcCoeffIndex[0])
        {
            i = uint(16)
            while (true) {
                let _t0 = i
                i--
                if (!(_t0 != 0)) {
                    break
                }
                // set dc coefficient of luma block
                var _t1 = dcCoeffIdx
                dcCoeffIdx = dcCoeffIdx + 1
                deref(blockData)[0] = deref(blockDc)[deref(_t1)]
                if (deref(blockData)[0] != 0 || deref(totalCoeff) != 0) {
                    if (h264bsdProcessBlock(addr(deref(blockData)[0]), pMb.qpY, uint(1), deref(coeffMap)) != uint(HANTRO_OK)) {
                        return uint(HANTRO_NOK)
                    }
                } else {
                    deref(blockData)[0] = 16777215
                }
                blockData = blockData + 1
                totalCoeff = totalCoeff + 1
                coeffMap = coeffMap + 1
            }
        }
    } else {
        {
            i = uint(16)
            while (true) {
                let _t2 = i
                i--
                if (!(_t2 != 0)) {
                    break
                }
                if (deref(totalCoeff) != 0) {
                    if (h264bsdProcessBlock(addr(deref(blockData)[0]), pMb.qpY, uint(0), deref(coeffMap)) != uint(HANTRO_OK)) {
                        return uint(HANTRO_NOK)
                    }
                } else {
                    deref(blockData)[0] = 16777215
                }
                blockData = blockData + 1
                totalCoeff = totalCoeff + 1
                coeffMap = coeffMap + 1
            }
        }
    }
    // chroma DC processing. First chroma dc block is block with index 25
    chromaQp = h264bsdQpC[int(pMb.qpY) + pMb.chromaQpIndexOffset < 0 ? 0 : (int(pMb.qpY) + pMb.chromaQpIndexOffset > 51 ? 51 : int(pMb.qpY) + pMb.chromaQpIndexOffset)]
    if (pMb.totalCoeff[25] != 0 || pMb.totalCoeff[26] != 0) {
        h264bsdProcessChromaDc(addr(deref(residualLevel + 25)[0]), chromaQp)
    }
    chromaDc = addr(deref(residualLevel + 25)[0])
    {
        i = uint(8)
        while (true) {
            let _t3 = i
            i--
            if (!(_t3 != 0)) {
                break
            }
            // set dc coefficient of chroma block
            var _t4 = chromaDc
            chromaDc = chromaDc + 1
            deref(blockData)[0] = deref(_t4)
            if (deref(blockData)[0] != 0 || deref(totalCoeff) != 0) {
                if (h264bsdProcessBlock(addr(deref(blockData)[0]), chromaQp, uint(1), deref(coeffMap)) != uint(HANTRO_OK)) {
                    return uint(HANTRO_NOK)
                }
            } else {
                deref(blockData)[0] = 16777215
            }
            blockData = blockData + 1
            totalCoeff = totalCoeff + 1
            coeffMap = coeffMap + 1
        }
    }
    return uint(HANTRO_OK)
}

def h264bsdSubMbPartMode(subMbType : subMbType_e) : subMbPartMode_e {
    // Variables
    // Code
    return enum_from_int(type<subMbPartMode_e>, int(subMbType))
}

def h264bsdDecodeNalUnit(var pStrmData : strmData_t?; var pNalUnit : nalUnit_t?) : uint {
    // Variables
    var tmp : uint
    // Code
    // forbidden_zero_bit (not checked to be zero, errors ignored)
    tmp = h264bsdGetBits(pStrmData, uint(1))
    // Assuming that NAL unit starts from byte boundary ­> don't have to check
    // following 7 bits for END_OF_STREAM
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, uint(2))
    pNalUnit.nalRefIdc = tmp
    tmp = h264bsdGetBits(pStrmData, uint(5))
    pNalUnit.nalUnitType = enum_from_int(type<nalUnitType_e>, int(tmp))
    // data partitioning NAL units not supported
    if (tmp == uint(2) || tmp == uint(3) || tmp == uint(4)) {
        return uint(HANTRO_NOK)
    }
    // nal_ref_idc shall not be zero for these nal_unit_types
    if ((tmp == uint(int(nalUnitType_e.NAL_SEQ_PARAM_SET)) || tmp == uint(int(nalUnitType_e.NAL_PIC_PARAM_SET)) || tmp == uint(int(nalUnitType_e.NAL_CODED_SLICE_IDR))) && pNalUnit.nalRefIdc == uint(0)) {
        return uint(HANTRO_NOK)
    } elif ((tmp == uint(int(nalUnitType_e.NAL_SEI)) || tmp == uint(int(nalUnitType_e.NAL_ACCESS_UNIT_DELIMITER)) || tmp == uint(int(nalUnitType_e.NAL_END_OF_SEQUENCE)) || tmp == uint(int(nalUnitType_e.NAL_END_OF_STREAM)) || tmp == uint(int(nalUnitType_e.NAL_FILLER_DATA))) && pNalUnit.nalRefIdc != uint(0)) {
        // nal_ref_idc shall be zero for these nal_unit_types
        return uint(HANTRO_NOK)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdInitMbNeighbours(var pMbStorage : mbStorage?; picWidth : uint; picSizeInMbs : uint) {
    // Variables
    var row : uint
    var col : uint
    // Code
    col = uint(0)
    row = col
    for (i in urange(picSizeInMbs)) {
        if (col != 0) {
            deref(pMbStorage + i).mbA = pMbStorage + i + -(1)
        } else {
            deref(pMbStorage + i).mbA = null
        }
        if (row != 0) {
            deref(pMbStorage + i).mbB = pMbStorage + i + -int64(picWidth)
        } else {
            deref(pMbStorage + i).mbB = null
        }
        if (row != 0 && col < picWidth - uint(1)) {
            deref(pMbStorage + i).mbC = pMbStorage + i + -int64(picWidth - uint(1))
        } else {
            deref(pMbStorage + i).mbC = null
        }
        if (row != 0 && col != 0) {
            deref(pMbStorage + i).mbD = pMbStorage + i + -int64(picWidth + uint(1))
        } else {
            deref(pMbStorage + i).mbD = null
        }
        col++
        if (col == picWidth) {
            col = uint(0)
            row++
        }
    }
}

def h264bsdGetNeighbourMb(var pMb : mbStorage?; neighbour : neighbourMb_e) : mbStorage? {
    // Variables
    // Code
    if (neighbour == neighbourMb_e.MB_A) {
        return pMb.mbA
    } elif (neighbour == neighbourMb_e.MB_B) {
        return pMb.mbB
    } elif (neighbour == neighbourMb_e.MB_C) {
        return pMb.mbC
    } elif (neighbour == neighbourMb_e.MB_D) {
        return pMb.mbD
    } elif (neighbour == neighbourMb_e.MB_CURR) {
        return pMb
    } else {
        return null
    }
}

