            ptr = ptr + 1
            tmp1 = deref(_t8)
            var _t9 = ptr
            ptr = ptr + 1
            tmp2 = deref(_t9)
            var _t10 = cb
            cb = cb + 1
            deref(_t10) = tmp1
            var _t11 = cb
            cb = cb + 1
            deref(_t11) = tmp2
            cb = cb + (width - uint(2))
            i--
        }
    }
    {
