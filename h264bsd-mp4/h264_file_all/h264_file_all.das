[c_function]
def private h264_file_all__DecodeMotionConstrainedSliceGroupSet(var pStrmData : strmData_t?; var pMotionConstrainedSliceGroupSet : seiMotionConstrainedSliceGroupSet_t?; numSliceGroups : uint) : uint {
    // Variables
    var tmp : uint
    var i : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pMotionConstrainedSliceGroupSet.numSliceGroupsInSet))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pMotionConstrainedSliceGroupSet.numSliceGroupsInSet++
    if (pMotionConstrainedSliceGroupSet.numSliceGroupsInSet > numSliceGroups) {
        return uint(HANTRO_NOK)
    }
    {
        i = uint(0)
        while (i < pMotionConstrainedSliceGroupSet.numSliceGroupsInSet) {
            tmp = h264bsdGetBits(pStrmData, h264_file_all__ceilLog2NumSliceGroups[numSliceGroups])
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pMotionConstrainedSliceGroupSet.sliceGroupId[i] = tmp
            if (pMotionConstrainedSliceGroupSet.sliceGroupId[i] > pMotionConstrainedSliceGroupSet.numSliceGroupsInSet - uint(1)) {
                return uint(HANTRO_NOK)
            }
            i++
        }
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pMotionConstrainedSliceGroupSet.exactSampleValueMatchFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pMotionConstrainedSliceGroupSet.panScanRectFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pMotionConstrainedSliceGroupSet.panScanRectFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pMotionConstrainedSliceGroupSet.panScanRectId))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeReservedSeiMessage(var pStrmData : strmData_t?; var pReservedSeiMessage : seiReservedSeiMessage_t?; payloadSize : uint) : uint {
    // Variables
    var tmp : uint
    // Code
    {
        // where corresponding FREE() ???
        pReservedSeiMessage.reservedSeiMessagePayloadByte = reinterpret<uint8?>(malloc1(uint64(payloadSize) * uint64(typeinfo sizeof(type<uint8>))))
    }
    if (pReservedSeiMessage.reservedSeiMessagePayloadByte == null) {
        return uint(MEMORY_ALLOCATION_ERROR)
    }
    pReservedSeiMessage.numPayloadBytes = payloadSize
    for (i in urange(payloadSize)) {
        tmp = h264bsdGetBits(pStrmData, uint(8))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        deref(pReservedSeiMessage.reservedSeiMessagePayloadByte + i) = uint8(tmp)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDecodeSeqParamSet(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var value : uint
    // Code
    memset1(reinterpret<void?>(pSeqParamSet), 0, uint64(typeinfo sizeof(type<seqParamSet_t>)))
    // profile_idc
    tmp = h264bsdGetBits(pStrmData, uint(8))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (tmp != uint(66)) {
    }
    pSeqParamSet.profileIdc = tmp
    // constrained_set0_flag
    tmp = h264bsdGetBits(pStrmData, uint(1))
    // constrained_set1_flag
    tmp = h264bsdGetBits(pStrmData, uint(1))
    // constrained_set2_flag
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // reserved_zero_5bits, values of these bits shall be ignored
    tmp = h264bsdGetBits(pStrmData, uint(5))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, uint(8))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.levelIdc = tmp
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.seqParameterSetId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSeqParamSet.seqParameterSetId >= uint(MAX_NUM_SEQ_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    // log2_max_frame_num_minus4
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > uint(12)) {
        return uint(HANTRO_NOK)
    }
    // maxFrameNum = 2^(log2_max_frame_num_minus4 + 4)
    pSeqParamSet.maxFrameNum = uint(1 << int(value + uint(4)))
    // valid POC types are 0, 1 and 2
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > uint(2)) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.picOrderCntType = value
    if (pSeqParamSet.picOrderCntType == uint(0)) {
        // log2_max_pic_order_cnt_lsb_minus4
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (value > uint(12)) {
            return uint(HANTRO_NOK)
        }
        // maxPicOrderCntLsb = 2^(log2_max_pic_order_cnt_lsb_minus4 + 4)
        pSeqParamSet.maxPicOrderCntLsb = uint(1 << int(value + uint(4)))
    } elif (pSeqParamSet.picOrderCntType == uint(1)) {
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSeqParamSet.deltaPicOrderAlwaysZeroFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pSeqParamSet.offsetForNonRefPic))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pSeqParamSet.offsetForTopToBottomField))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.numRefFramesInPicOrderCntCycle))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pSeqParamSet.numRefFramesInPicOrderCntCycle > uint(255)) {
            return uint(HANTRO_NOK)
        }
        if (pSeqParamSet.numRefFramesInPicOrderCntCycle != 0) {
            {
                // NOTE: This has to be freed somewhere!
                pSeqParamSet.offsetForRefFrame = reinterpret<int?>(malloc1(uint64(pSeqParamSet.numRefFramesInPicOrderCntCycle) * uint64(typeinfo sizeof(type<int>))))
            }
            if (pSeqParamSet.offsetForRefFrame == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            {
                i = uint(0)
                while (i < pSeqParamSet.numRefFramesInPicOrderCntCycle) {
                    tmp = h264bsdDecodeExpGolombSigned(pStrmData, pSeqParamSet.offsetForRefFrame + i)
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    i++
                }
            }
        } else {
            pSeqParamSet.offsetForRefFrame = null
        }
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.numRefFrames))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSeqParamSet.numRefFrames > uint(MAX_NUM_REF_PICS)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.gapsInFrameNumValueAllowedFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSeqParamSet.picWidthInMbs = value + uint(1)
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSeqParamSet.picHeightInMbs = value + uint(1)
    // frame_mbs_only_flag, shall be 1 for baseline profile
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (!(tmp != 0)) {
        return uint(HANTRO_NOK)
    }
    // direct_8x8_inference_flag
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.frameCroppingFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pSeqParamSet.frameCroppingFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropLeftOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropRightOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropTopOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropBottomOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // check that frame cropping params are valid, parameters shall
        // specify non-negative area within the original picture
        if (int(pSeqParamSet.frameCropLeftOffset) > 8 * int(pSeqParamSet.picWidthInMbs) - (int(pSeqParamSet.frameCropRightOffset) + 1) || int(pSeqParamSet.frameCropTopOffset) > 8 * int(pSeqParamSet.picHeightInMbs) - (int(pSeqParamSet.frameCropBottomOffset) + 1)) {
            return uint(HANTRO_NOK)
        }
    }
    // check that image dimensions and levelIdc match
    tmp = pSeqParamSet.picWidthInMbs * pSeqParamSet.picHeightInMbs
    value = h264_file_all__GetDpbSize(tmp, pSeqParamSet.levelIdc)
    if (value == uint(int(anon_544.INVALID_DPB_SIZE)) || pSeqParamSet.numRefFrames > value) {
        value = pSeqParamSet.numRefFrames
    }
    pSeqParamSet.maxDpbSize = value
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.vuiParametersPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    // VUI
    if (pSeqParamSet.vuiParametersPresentFlag != 0) {
        {
            pSeqParamSet.vuiParameters = reinterpret<vuiParameters_t?>(malloc1(uint64(1) * uint64(typeinfo sizeof(type<vuiParameters_t>))))
        }
        if (pSeqParamSet.vuiParameters == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
        tmp = h264bsdDecodeVuiParameters(pStrmData, pSeqParamSet.vuiParameters)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // check numReorderFrames and maxDecFrameBuffering
        if (pSeqParamSet.vuiParameters.bitstreamRestrictionFlag != 0) {
            if (pSeqParamSet.vuiParameters.numReorderFrames > pSeqParamSet.vuiParameters.maxDecFrameBuffering || pSeqParamSet.vuiParameters.maxDecFrameBuffering < pSeqParamSet.numRefFrames || pSeqParamSet.vuiParameters.maxDecFrameBuffering > pSeqParamSet.maxDpbSize) {
                return uint(HANTRO_NOK)
            }
            // standard says that "the sequence shall not require a DPB with
            // size of more than max(1, maxDecFrameBuffering)
            pSeqParamSet.maxDpbSize = uint(1) > pSeqParamSet.vuiParameters.maxDecFrameBuffering ? uint(1) : pSeqParamSet.vuiParameters.maxDecFrameBuffering
        }
    }
    tmp = h264bsdRbspTrailingBits(pStrmData)
    // ignore possible errors in trailing bits of parameters sets
    return uint(HANTRO_OK)
}

def private h264_file_all__GetDpbSize(picSizeInMbs : uint; levelIdc : uint) : uint {
    // Variables
    var tmp : uint
    var maxPicSizeInMbs : uint
    // Code
    // use tmp as the size of the DPB in bytes, computes as 1024 * MaxDPB
    // (from table A-1 in Annex A)
    let _cond = levelIdc
    if (_cond == 10u) {
        tmp = uint(152064)
        maxPicSizeInMbs = uint(99)
    } elif (_cond == 11u) {
        tmp = uint(345600)
        maxPicSizeInMbs = uint(396)
    } elif (_cond == 12u) {
        tmp = uint(912384)
        maxPicSizeInMbs = uint(396)
    } elif (_cond == 13u) {
        tmp = uint(912384)
        maxPicSizeInMbs = uint(396)
    } elif (_cond == 20u) {
        tmp = uint(912384)
        maxPicSizeInMbs = uint(396)
    } elif (_cond == 21u) {
        tmp = uint(1824768)
        maxPicSizeInMbs = uint(792)
    } elif (_cond == 22u) {
        tmp = uint(3110400)
        maxPicSizeInMbs = uint(1620)
    } elif (_cond == 30u) {
        tmp = uint(3110400)
        maxPicSizeInMbs = uint(1620)
    } elif (_cond == 31u) {
        tmp = uint(6912000)
        maxPicSizeInMbs = uint(3600)
    } elif (_cond == 32u) {
        tmp = uint(7864320)
        maxPicSizeInMbs = uint(5120)
    } elif (_cond == 40u) {
        tmp = uint(12582912)
        maxPicSizeInMbs = uint(8192)
    } elif (_cond == 41u) {
        tmp = uint(12582912)
        maxPicSizeInMbs = uint(8192)
    } elif (_cond == 42u) {
        tmp = uint(34816 * 384)
        maxPicSizeInMbs = uint(8704)
    } elif (_cond == 50u) {
        // standard says 42301440 here, but corrigendum "corrects" this to
        // 42393600
        tmp = uint(42393600)
        maxPicSizeInMbs = uint(22080)
    } elif (_cond == 51u) {
        tmp = uint(70778880)
        maxPicSizeInMbs = uint(36864)
    } else {
        return uint(int(anon_544.INVALID_DPB_SIZE))
    }
    // this is not "correct" return value! However, it results in error in
    // decoding and this was easiest place to check picture size
    if (picSizeInMbs > maxPicSizeInMbs) {
        return uint(int(anon_544.INVALID_DPB_SIZE))
    }
    tmp /= picSizeInMbs * uint(384)
    return tmp < uint(16) ? tmp : uint(16)
}

[c_function]
def h264bsdCompareSeqParamSets(var pSps1 : seqParamSet_t?; var pSps2 : seqParamSet_t?) : uint {
    // Variables
    var i : uint
    // Code
    // first compare parameters whose existence does not depend on other
    // parameters and only compare the rest of the params if these are equal
    if (pSps1.profileIdc == pSps2.profileIdc && pSps1.levelIdc == pSps2.levelIdc && pSps1.maxFrameNum == pSps2.maxFrameNum && pSps1.picOrderCntType == pSps2.picOrderCntType && pSps1.numRefFrames == pSps2.numRefFrames && pSps1.gapsInFrameNumValueAllowedFlag == pSps2.gapsInFrameNumValueAllowedFlag && pSps1.picWidthInMbs == pSps2.picWidthInMbs && pSps1.picHeightInMbs == pSps2.picHeightInMbs && pSps1.frameCroppingFlag == pSps2.frameCroppingFlag && pSps1.vuiParametersPresentFlag == pSps2.vuiParametersPresentFlag) {
        if (pSps1.picOrderCntType == uint(0)) {
            if (pSps1.maxPicOrderCntLsb != pSps2.maxPicOrderCntLsb) {
                return uint(1)
            }
        } elif (pSps1.picOrderCntType == uint(1)) {
            if (pSps1.deltaPicOrderAlwaysZeroFlag != pSps2.deltaPicOrderAlwaysZeroFlag || pSps1.offsetForNonRefPic != pSps2.offsetForNonRefPic || pSps1.offsetForTopToBottomField != pSps2.offsetForTopToBottomField || pSps1.numRefFramesInPicOrderCntCycle != pSps2.numRefFramesInPicOrderCntCycle) {
                return uint(1)
            } else {
                {
                    i = uint(0)
                    while (i < pSps1.numRefFramesInPicOrderCntCycle) {
                        if (deref(pSps1.offsetForRefFrame + i) != deref(pSps2.offsetForRefFrame + i)) {
                            return uint(1)
                        }
                        i++
                    }
                }
            }
        }
        if (pSps1.frameCroppingFlag != 0) {
            if (pSps1.frameCropLeftOffset != pSps2.frameCropLeftOffset || pSps1.frameCropRightOffset != pSps2.frameCropRightOffset || pSps1.frameCropTopOffset != pSps2.frameCropTopOffset || pSps1.frameCropBottomOffset != pSps2.frameCropBottomOffset) {
                return uint(1)
            }
        }
        return uint(0)
    }
    return uint(1)
}

[c_function]
def h264bsdDecodeSliceData(var pStrmData : strmData_t?; var pStorage : storage?; var currImage : image_t?; var pSliceHeader : sliceHeader_t?) : uint {
    // Variables
    var mbData : uint8[431]
    var data : uint8?
    var tmp : uint
    var skipRun : uint
    var prevSkipped : uint
    var currMbAddr : uint
    var moreMbs : uint
    var mbCount : uint
    var qpY : int
    var mbLayer : macroblockLayer_t?
    // Code
    // ensure 16-byte alignment
    data = addr(mbData[0]) + (uint64(16) - uint64(intptr(addr(mbData[0]))) & uint64(16 - 1)) / uint64(typeinfo sizeof(type<uint8>))
    mbLayer = pStorage.mbLayer
    currMbAddr = pSliceHeader.firstMbInSlice
    skipRun = uint(0)
    prevSkipped = uint(HANTRO_FALSE)
    // increment slice index, will be one for decoding of the first slice of
    // the picture
    addr(pStorage.slice[0]).sliceId++
    // lastMbAddr stores address of the macroblock that was last successfully
    // decoded, needed for error handling
    addr(pStorage.slice[0]).lastMbAddr = uint(0)
    mbCount = uint(0)
    // initial quantization parameter for the slice is obtained as the sum of
    // initial QP for the picture and sliceQpDelta for the current slice
    qpY = int(pStorage.activePps.picInitQp) + pSliceHeader.sliceQpDelta
    while (true) {
        // primary picture and already decoded macroblock -> error
        if (!(pSliceHeader.redundantPicCnt != 0) && deref(pStorage.mb + currMbAddr).decoded != 0) {
            return uint(HANTRO_NOK)
        }
        h264_file_all__SetMbParams(pStorage.mb + currMbAddr, pSliceHeader, addr(pStorage.slice[0]).sliceId, pStorage.activePps.chromaQpIndexOffset)
        if (!(pSliceHeader.sliceType == uint(int(anon_104.I_SLICE)) || pSliceHeader.sliceType == uint(int(anon_104.I_SLICE) + 5))) {
            if (!(prevSkipped != 0)) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(skipRun))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                // skip_run shall be less than or equal to number of
                // macroblocks left
                if (skipRun > pStorage.picSizeInMbs - currMbAddr) {
                    return uint(HANTRO_NOK)
                }
                if (skipRun != 0) {
                    prevSkipped = uint(HANTRO_TRUE)
                    memset1(reinterpret<void?>(addr(mbLayer.mbPred)), 0, uint64(typeinfo sizeof(type<mbPred_t>)))
                    // mark current macroblock skipped
                    mbLayer.mbType = mbType_e.P_Skip
                }
            }
        }
        if (skipRun != 0) {
            skipRun--
        } else {
            prevSkipped = uint(HANTRO_FALSE)
            tmp = h264bsdDecodeMacroblockLayer(pStrmData, mbLayer, pStorage.mb + currMbAddr, pSliceHeader.sliceType, pSliceHeader.numRefIdxL0Active)
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
        tmp = h264bsdDecodeMacroblock(pStorage.mb + currMbAddr, mbLayer, currImage, addr(pStorage.dpb[0]), addr(qpY), currMbAddr, pStorage.activePps.constrainedIntraPredFlag, data)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // increment macroblock count only for macroblocks that were decoded
        // for the first time (redundant slices)
        if (deref(pStorage.mb + currMbAddr).decoded == uint(1)) {
            mbCount++
        }
        // keep on processing as long as there is stream data left or
        // processing of macroblocks to be skipped based on the last skipRun is
        // not finished
        moreMbs = uint(h264bsdMoreRbspData(pStrmData) != 0 || skipRun != 0 ? HANTRO_TRUE : HANTRO_FALSE)
        // lastMbAddr is only updated for intra slices (all macroblocks of
        // inter slices will be lost in case of an error)
        if (pSliceHeader.sliceType == uint(int(anon_104.I_SLICE)) || pSliceHeader.sliceType == uint(int(anon_104.I_SLICE) + 5)) {
            addr(pStorage.slice[0]).lastMbAddr = currMbAddr
        }
        currMbAddr = h264bsdNextMbAddress(pStorage.sliceGroupMap, pStorage.picSizeInMbs, currMbAddr)
        // data left in the buffer but no more macroblocks for current slice
        // group -> error
        if (moreMbs != 0 && !(currMbAddr != 0)) {
            return uint(HANTRO_NOK)
        }
        if (!(moreMbs != 0)) {
            break
        }
    }
    if (addr(pStorage.slice[0]).numDecodedMbs + mbCount > pStorage.picSizeInMbs) {
        return uint(HANTRO_NOK)
    }
    addr(pStorage.slice[0]).numDecodedMbs += mbCount
    return uint(HANTRO_OK)
}

def private h264_file_all__SetMbParams(var pMb : mbStorage?; var pSlice : sliceHeader_t?; sliceId : uint; chromaQpIndexOffset : int) {
    // Variables
    var tmp1 : uint
    var tmp2 : int
    var tmp3 : int
    // Code
    tmp1 = pSlice.disableDeblockingFilterIdc
    tmp2 = pSlice.sliceAlphaC0Offset
    tmp3 = pSlice.sliceBetaOffset
    pMb.sliceId = sliceId
    pMb.disableDeblockingFilterIdc = tmp1
    pMb.filterOffsetA = tmp2
    pMb.filterOffsetB = tmp3
    pMb.chromaQpIndexOffset = chromaQpIndexOffset
}

[c_function]
def h264bsdMarkSliceCorrupted(var pStorage : storage?; firstMbInSlice : uint) {
    // Variables
    var tmp : uint
    var i : uint
    var sliceId : uint
    var currMbAddr : uint
    // Code
    currMbAddr = firstMbInSlice
    sliceId = addr(pStorage.slice[0]).sliceId
    // DecodeSliceData sets lastMbAddr for I slices -> if it was set, go back
    // MAX(picWidthInMbs, 10) macroblocks and start marking from there
    if (addr(pStorage.slice[0]).lastMbAddr != 0) {
        i = addr(pStorage.slice[0]).lastMbAddr - uint(1)
        tmp = uint(0)
        while (i > currMbAddr) {
            if (deref(pStorage.mb + i).sliceId == sliceId) {
                tmp++
                if (tmp >= (pStorage.activeSps.picWidthInMbs > uint(10) ? pStorage.activeSps.picWidthInMbs : uint(10))) {
                    break
                }
            }
            i--
        }
        currMbAddr = i
    }
    while (true) {
        if (deref(pStorage.mb + currMbAddr).sliceId == sliceId && deref(pStorage.mb + currMbAddr).decoded != 0) {
            deref(pStorage.mb + currMbAddr).decoded--
        } else {
            break
        }
        currMbAddr = h264bsdNextMbAddress(pStorage.sliceGroupMap, pStorage.picSizeInMbs, currMbAddr)
        if (!(currMbAddr != 0)) {
            break
        }
    }
}

[c_function]
def private h264_file_all__DecodeInterleavedMap(var map : uint?; numSliceGroups : uint; var runLength : uint?; picSize : uint) {
    // Variables
    var i : uint
    var j : uint
    var group : uint
    // Code
    i = uint(0)
    while (true) {
        {
            group = uint(0)
            while (group < numSliceGroups && i < picSize) {
                {
                    j = uint(0)
                    while (j < deref(runLength + group) && i + j < picSize) {
                        deref(map + (i + j)) = group
                        j++
                    }
                }
                let _t0 = group
                group++
                i += deref(runLength + _t0)
            }
        }
        if (!(i < picSize)) {
            break
        }
    }
}

[c_function]
def private h264_file_all__DecodeDispersedMap(var map : uint?; numSliceGroups : uint; picWidth : uint; picHeight : uint) {
    // Variables
    var picSize : uint
    // Code
    picSize = picWidth * picHeight
    for (i in urange(picSize)) {
        deref(map + i) = (i % picWidth + (i / picWidth * numSliceGroups >> 1u)) % numSliceGroups
    }
}

[c_function]
def private h264_file_all__DecodeForegroundLeftOverMap(var map : uint?; numSliceGroups : uint; var topLeft : uint?; var bottomRight : uint?; picWidth : uint; picHeight : uint) {
    // Variables
    var y : uint
    var x : uint
    var yTopLeft : uint
    var yBottomRight : uint
    var xTopLeft : uint
    var xBottomRight : uint
    var picSize : uint
    var group : uint
    // Code
    picSize = picWidth * picHeight
    for (i in urange(picSize)) {
        deref(map + i) = numSliceGroups - uint(1)
    }
    {
        group = numSliceGroups - uint(1)
        while (true) {
            let _t0 = group
            group--
            if (!(_t0 != 0)) {
                break
            }
            yTopLeft = deref(topLeft + group) / picWidth
            xTopLeft = deref(topLeft + group) % picWidth
            yBottomRight = deref(bottomRight + group) / picWidth
            xBottomRight = deref(bottomRight + group) % picWidth
            {
                y = yTopLeft
                while (y <= yBottomRight) {
                    {
                        x = xTopLeft
                        while (x <= xBottomRight) {
                            deref(map + (y * picWidth + x)) = group
                            x++
                        }
                    }
                    y++
                }
            }
        }
    }
}

[c_function]
def private h264_file_all__DecodeBoxOutMap(var map : uint?; sliceGroupChangeDirectionFlag : uint; unitsInSliceGroup0 : uint; picWidth : uint; picHeight : uint) {
    // Variables
    var k : uint
    var picSize : uint
    var x : int
    var y : int
    var xDir : int
    var yDir : int
    var leftBound : int
    var topBound : int
    var rightBound : int
    var bottomBound : int
    var mapUnitVacant : uint
    // Code
    picSize = picWidth * picHeight
    for (i in urange(picSize)) {
        deref(map + i) = uint(1)
    }
    x = int(picWidth - sliceGroupChangeDirectionFlag >> 1u)
    y = int(picHeight - sliceGroupChangeDirectionFlag >> 1u)
    leftBound = x
    topBound = y
    rightBound = x
    bottomBound = y
    xDir = int(sliceGroupChangeDirectionFlag) - 1
    yDir = int(sliceGroupChangeDirectionFlag)
    {
        k = uint(0)
        while (k < unitsInSliceGroup0) {
            mapUnitVacant = uint(deref(map + (uint(y) * picWidth + uint(x))) == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
            if (mapUnitVacant != 0) {
                deref(map + (uint(y) * picWidth + uint(x))) = uint(0)
            }
            if (xDir == -1 && x == leftBound) {
                leftBound = leftBound - 1 > 0 ? leftBound - 1 : 0
                x = leftBound
                xDir = 0
                yDir = 2 * int(sliceGroupChangeDirectionFlag) - 1
            } elif (xDir == 1 && x == rightBound) {
                rightBound = rightBound + 1 < int(picWidth) - 1 ? rightBound + 1 : int(picWidth) - 1
                x = rightBound
                xDir = 0
                yDir = 1 - 2 * int(sliceGroupChangeDirectionFlag)
            } elif (yDir == -1 && y == topBound) {
                topBound = topBound - 1 > 0 ? topBound - 1 : 0
                y = topBound
                xDir = 1 - 2 * int(sliceGroupChangeDirectionFlag)
                yDir = 0
            } elif (yDir == 1 && y == bottomBound) {
                bottomBound = bottomBound + 1 < int(picHeight) - 1 ? bottomBound + 1 : int(picHeight) - 1
                y = bottomBound
                xDir = 2 * int(sliceGroupChangeDirectionFlag) - 1
                yDir = 0
            } else {
                x += xDir
                y += yDir
            }
            k += uint(mapUnitVacant != 0 ? 1 : 0)
        }
    }
}

[c_function]
def private h264_file_all__DecodeRasterScanMap(var map : uint?; sliceGroupChangeDirectionFlag : uint; sizeOfUpperLeftGroup : uint; picSize : uint) {
    // Variables
    // Code
    for (i in urange(picSize)) {
        if (i < sizeOfUpperLeftGroup) {
            deref(map + i) = sliceGroupChangeDirectionFlag
        } else {
            deref(map + i) = uint(1) - sliceGroupChangeDirectionFlag
        }
    }
}

[c_function]
def private h264_file_all__DecodeWipeMap(var map : uint?; sliceGroupChangeDirectionFlag : uint; sizeOfUpperLeftGroup : uint; picWidth : uint; picHeight : uint) {
    // Variables
    var k : uint
    // Code
    k = uint(0)
    for (j in urange(picWidth)) {
        for (i in urange(picHeight)) {
            let _t0 = k
            k++
            if (_t0 < sizeOfUpperLeftGroup) {
                deref(map + (i * picWidth + j)) = sliceGroupChangeDirectionFlag
            } else {
                deref(map + (i * picWidth + j)) = uint(1) - sliceGroupChangeDirectionFlag
            }
        }
    }
}

[c_function]
def h264bsdDecodeSliceGroupMap(var map : uint?; var pps : picParamSet_t?; sliceGroupChangeCycle : uint; picWidth : uint; picHeight : uint) {
    // Variables
    var i : uint
    var picSize : uint
    var unitsInSliceGroup0 : uint = uint(0)
    var sizeOfUpperLeftGroup : uint = uint(0)
    // Code
    picSize = picWidth * picHeight
    // just one slice group -> all macroblocks belong to group 0
    if (pps.numSliceGroups == uint(1)) {
        memset1(reinterpret<void?>(map), 0, uint64(picSize) * uint64(typeinfo sizeof(type<uint>)))
        return
    }
    if (pps.sliceGroupMapType > uint(2) && pps.sliceGroupMapType < uint(6)) {
        unitsInSliceGroup0 = sliceGroupChangeCycle * pps.sliceGroupChangeRate < picSize ? sliceGroupChangeCycle * pps.sliceGroupChangeRate : picSize
        if (pps.sliceGroupMapType == uint(4) || pps.sliceGroupMapType == uint(5)) {
            sizeOfUpperLeftGroup = pps.sliceGroupChangeDirectionFlag != 0 ? picSize - unitsInSliceGroup0 : unitsInSliceGroup0
        }
    }
    let _cond = pps.sliceGroupMapType
    if (_cond == 0u) {
        h264_file_all__DecodeInterleavedMap(map, pps.numSliceGroups, pps.runLength, picSize)
    } elif (_cond == 1u) {
        h264_file_all__DecodeDispersedMap(map, pps.numSliceGroups, picWidth, picHeight)
    } elif (_cond == 2u) {
        h264_file_all__DecodeForegroundLeftOverMap(map, pps.numSliceGroups, pps.topLeft, pps.bottomRight, picWidth, picHeight)
    } elif (_cond == 3u) {
        h264_file_all__DecodeBoxOutMap(map, pps.sliceGroupChangeDirectionFlag, unitsInSliceGroup0, picWidth, picHeight)
    } elif (_cond == 4u) {
        h264_file_all__DecodeRasterScanMap(map, pps.sliceGroupChangeDirectionFlag, sizeOfUpperLeftGroup, picSize)
    } elif (_cond == 5u) {
        h264_file_all__DecodeWipeMap(map, pps.sliceGroupChangeDirectionFlag, sizeOfUpperLeftGroup, picWidth, picHeight)
    } else {
        {
            i = uint(0)
            while (i < picSize) {
                deref(map + i) = deref(pps.sliceGroupId + i)
                i++
            }
        }
    }
}

[c_function]
def h264bsdDecodeSliceHeader(var pStrmData : strmData_t?; var pSliceHeader : sliceHeader_t?; var pSeqParamSet : seqParamSet_t?; var pPicParamSet : picParamSet_t?; var pNalUnit : nalUnit_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var value : uint
    var itmp : int
    var picSizeInMbs : uint
    // Code
    memset1(reinterpret<void?>(pSliceHeader), 0, uint64(typeinfo sizeof(type<sliceHeader_t>)))
    picSizeInMbs = pSeqParamSet.picWidthInMbs * pSeqParamSet.picHeightInMbs
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.firstMbInSlice = value
    if (value >= picSizeInMbs) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.sliceType = value
    // slice type has to be either I or P slice. P slice is not allowed when
    // current NAL unit is an IDR NAL unit or num_ref_frames is 0
    if (!(pSliceHeader.sliceType == uint(int(anon_104.I_SLICE)) || pSliceHeader.sliceType == uint(int(anon_104.I_SLICE) + 5)) && (!(pSliceHeader.sliceType == uint(int(anon_104.P_SLICE)) || pSliceHeader.sliceType == uint(int(anon_104.P_SLICE) + 5)) || pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR || !(pSeqParamSet.numRefFrames != 0))) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.picParameterSetId = value
    if (pSliceHeader.picParameterSetId != pPicParamSet.picParameterSetId) {
        return uint(HANTRO_NOK)
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    tmp = h264bsdGetBits(pStrmData, i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR && tmp != uint(0)) {
        return uint(HANTRO_NOK)
    }
    pSliceHeader.frameNum = tmp
    if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.idrPicId = value
        if (value > uint(65535)) {
            return uint(HANTRO_NOK)
        }
    }
    if (pSeqParamSet.picOrderCntType == uint(0)) {
        // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
        i = uint(0)
        while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
            i++
        }
        i--
        tmp = h264bsdGetBits(pStrmData, i)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSliceHeader.picOrderCntLsb = tmp
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pSliceHeader.deltaPicOrderCntBottom = itmp
        }
        // check that picOrderCnt for IDR picture will be zero. See
        // DecodePicOrderCnt function to understand the logic here
        if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR && (pSliceHeader.picOrderCntLsb > pSeqParamSet.maxPicOrderCntLsb / uint(2) || (int(pSliceHeader.picOrderCntLsb) < int(pSliceHeader.picOrderCntLsb) + pSliceHeader.deltaPicOrderCntBottom ? int(pSliceHeader.picOrderCntLsb) : int(pSliceHeader.picOrderCntLsb) + pSliceHeader.deltaPicOrderCntBottom) != 0)) {
            return uint(HANTRO_NOK)
        }
    }
    if (pSeqParamSet.picOrderCntType == uint(1) && !(pSeqParamSet.deltaPicOrderAlwaysZeroFlag != 0)) {
        tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.deltaPicOrderCnt[0] = itmp
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pSliceHeader.deltaPicOrderCnt[1] = itmp
        }
        // check that picOrderCnt for IDR picture will be zero. See
        // DecodePicOrderCnt function to understand the logic here
        if (pNalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR && (pSliceHeader.deltaPicOrderCnt[0] < pSliceHeader.deltaPicOrderCnt[0] + pSeqParamSet.offsetForTopToBottomField + pSliceHeader.deltaPicOrderCnt[1] ? pSliceHeader.deltaPicOrderCnt[0] : pSliceHeader.deltaPicOrderCnt[0] + pSeqParamSet.offsetForTopToBottomField + pSliceHeader.deltaPicOrderCnt[1]) != 0) {
            return uint(HANTRO_NOK)
        }
    }
    if (pPicParamSet.redundantPicCntPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.redundantPicCnt = value
        if (value > uint(127)) {
            return uint(HANTRO_NOK)
        }
    }
    if (pSliceHeader.sliceType == uint(int(anon_104.P_SLICE)) || pSliceHeader.sliceType == uint(int(anon_104.P_SLICE) + 5)) {
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSliceHeader.numRefIdxActiveOverrideFlag = tmp
        if (pSliceHeader.numRefIdxActiveOverrideFlag != 0) {
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (value > uint(15)) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.numRefIdxL0Active = value + uint(1)
        } else {
            // set numRefIdxL0Active from pic param set
            // if value (minus1) in picture parameter set exceeds 15 it should
            // have been overridden here
            if (pPicParamSet.numRefIdxL0Active > uint(16)) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.numRefIdxL0Active = pPicParamSet.numRefIdxL0Active
        }
    }
    if (pSliceHeader.sliceType == uint(int(anon_104.P_SLICE)) || pSliceHeader.sliceType == uint(int(anon_104.P_SLICE) + 5)) {
        tmp = h264_file_all__RefPicListReordering(pStrmData, addr(pSliceHeader.refPicListReordering), pSliceHeader.numRefIdxL0Active, pSeqParamSet.maxFrameNum)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    if (pNalUnit.nalRefIdc != uint(0)) {
        tmp = h264_file_all__DecRefPicMarking(pStrmData, addr(pSliceHeader.decRefPicMarking), pNalUnit.nalUnitType, pSeqParamSet.numRefFrames)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    // decode sliceQpDelta and check that initial QP for the slice will be on
    // the range [0, 51]
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.sliceQpDelta = itmp
    itmp += int(pPicParamSet.picInitQp)
    if (itmp < 0 || itmp > 51) {
        return uint(HANTRO_NOK)
    }
    if (pPicParamSet.deblockingFilterControlPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.disableDeblockingFilterIdc = value
        if (pSliceHeader.disableDeblockingFilterIdc > uint(2)) {
            return uint(HANTRO_NOK)
        }
        if (pSliceHeader.disableDeblockingFilterIdc != uint(1)) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (itmp < -6 || itmp > 6) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.sliceAlphaC0Offset = itmp * 2
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (itmp < -6 || itmp > 6) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.sliceBetaOffset = itmp * 2
        }
    }
    if (pPicParamSet.numSliceGroups > uint(1) && pPicParamSet.sliceGroupMapType >= uint(3) && pPicParamSet.sliceGroupMapType <= uint(5)) {
        // set tmp to number of bits used to represent slice_group_change_cycle
        // in the stream
        tmp = h264_file_all__NumSliceGroupChangeCycleBits(picSizeInMbs, pPicParamSet.sliceGroupChangeRate)
        value = h264bsdGetBits(pStrmData, tmp)
        if (value == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSliceHeader.sliceGroupChangeCycle = value
        // corresponds to tmp = Ceil(picSizeInMbs / sliceGroupChangeRate)
        tmp = (picSizeInMbs + pPicParamSet.sliceGroupChangeRate - uint(1)) / pPicParamSet.sliceGroupChangeRate
        if (pSliceHeader.sliceGroupChangeCycle > tmp) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__NumSliceGroupChangeCycleBits(picSizeInMbs : uint; sliceGroupChangeRate : uint) : uint {
    // Variables
    var tmp : uint
    var numBits : uint
    var mask : uint
    // Code
    // compute (picSizeInMbs / sliceGroupChangeRate + 1), rounded up
    if (picSizeInMbs % sliceGroupChangeRate != 0) {
        tmp = uint(2) + picSizeInMbs / sliceGroupChangeRate
    } else {
        tmp = uint(1) + picSizeInMbs / sliceGroupChangeRate
    }
    numBits = uint(0)
    mask = ~0u
    // set numBits to position of right-most non-zero bit
    while (true) {
        numBits++
        if (!((tmp & mask << numBits) != 0)) {
            break
        }
    }
    numBits--
    // add one more bit if value greater than 2^numBits
    if ((tmp & uint((1 << int(numBits)) - 1)) != 0) {
        numBits++
    }
    return numBits
}

[c_function]
def private h264_file_all__RefPicListReordering(var pStrmData : strmData_t?; var pRefPicListReordering : refPicListReordering_t?; numRefIdxActive : uint; maxPicNum : uint) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var command : uint
    // Code
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pRefPicListReordering.refPicListReorderingFlagL0 = tmp
    if (pRefPicListReordering.refPicListReorderingFlagL0 != 0) {
        i = uint(0)
        while (true) {
            if (i > numRefIdxActive) {
                return uint(HANTRO_NOK)
            }
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(command))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (command > uint(3)) {
                return uint(HANTRO_NOK)
            }
            pRefPicListReordering.command[i].reorderingOfPicNumsIdc = command
            if (command == uint(0) || command == uint(1)) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                if (value >= maxPicNum) {
                    return uint(HANTRO_NOK)
                }
                pRefPicListReordering.command[i].absDiffPicNum = value + uint(1)
            } elif (command == uint(2)) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pRefPicListReordering.command[i].longTermPicNum = value
            }
            i++
            if (!(command != uint(3))) {
                break
            }
        }
        // there shall be at least one reordering command if
        // refPicListReorderingFlagL0 was set
        if (i == uint(1)) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecRefPicMarking(var pStrmData : strmData_t?; var pDecRefPicMarking : decRefPicMarking_t?; nalUnitType : nalUnitType_e; numRefFrames : uint) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var operation : uint
    // variables for error checking purposes, store number of memory
    // management operations of certain type
    var num4 : uint = uint(0)
    var num5 : uint = uint(0)
    var num6 : uint = uint(0)
    var num1to3 : uint = uint(0)
    // Code
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pDecRefPicMarking.noOutputOfPriorPicsFlag = tmp
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pDecRefPicMarking.longTermReferenceFlag = tmp
        if (!(numRefFrames != 0) && pDecRefPicMarking.longTermReferenceFlag != 0) {
            return uint(HANTRO_NOK)
        }
    } else {
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pDecRefPicMarking.adaptiveRefPicMarkingModeFlag = tmp
        if (pDecRefPicMarking.adaptiveRefPicMarkingModeFlag != 0) {
            i = uint(0)
            while (true) {
                // see explanation of the MAX_NUM_MMC_OPERATIONS in
                // slice_header.h
                if (i > uint(2) * numRefFrames + uint(2)) {
                    return uint(HANTRO_NOK)
                }
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(operation))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                if (operation > uint(6)) {
                    return uint(HANTRO_NOK)
                }
                pDecRefPicMarking.operation[i].memoryManagementControlOperation = operation
                if (operation == uint(1) || operation == uint(3)) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pDecRefPicMarking.operation[i].differenceOfPicNums = value + uint(1)
                }
                if (operation == uint(2)) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pDecRefPicMarking.operation[i].longTermPicNum = value
                }
                if (operation == uint(3) || operation == uint(6)) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pDecRefPicMarking.operation[i].longTermFrameIdx = value
                }
                if (operation == uint(4)) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    // value shall be in range [0, numRefFrames]
                    if (value > numRefFrames) {
                        return uint(HANTRO_NOK)
                    }
                    if (value == uint(0)) {
                        pDecRefPicMarking.operation[i].maxLongTermFrameIdx = uint(int(anon_105.NO_LONG_TERM_FRAME_INDICES))
                    } else {
                        pDecRefPicMarking.operation[i].maxLongTermFrameIdx = value - uint(1)
                    }
                    num4++
                }
                if (operation == uint(5)) {
                    num5++
                }
                if (operation != 0 && operation <= uint(3)) {
                    num1to3++
                }
                if (operation == uint(6)) {
                    num6++
                }
                i++
                if (!(operation != uint(0))) {
                    break
                }
            }
            // error checking
            if (num4 > uint(1) || num5 > uint(1) || num6 > uint(1) || num1to3 != 0 && num5 != 0) {
                return uint(HANTRO_NOK)
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckPpsId(var pStrmData : strmData_t?; var picParamSetId : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value >= uint(MAX_NUM_PIC_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    deref(picParamSetId) = value
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckFrameNum(var pStrmData : strmData_t?; maxFrameNum : uint; var frameNum : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (maxFrameNum >> i != 0) {
        i++
    }
    i--
    // frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    deref(frameNum) = tmp
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckIdrPicId(var pStrmData : strmData_t?; maxFrameNum : uint; nalUnitType : nalUnitType_e; var idrPicId : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // nalUnitType must be equal to 5 because otherwise idrPicId is not
    // present
    if (nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR) {
        return uint(HANTRO_NOK)
    }
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // idr_pic_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), idrPicId)
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckPicOrderCntLsb(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?; nalUnitType : nalUnitType_e; var picOrderCntLsb : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // picOrderCntType must be equal to 0
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id when necessary
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
    i = uint(0)
    while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
        i++
    }
    i--
    // pic_order_cnt_lsb
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    deref(picOrderCntLsb) = tmp
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckDeltaPicOrderCntBottom(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?; nalUnitType : nalUnitType_e; var deltaPicOrderCntBottom : int?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // picOrderCntType must be equal to 0 and picOrderPresentFlag must be TRUE
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id when necessary
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
    i = uint(0)
    while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
        i++
    }
    i--
    // skip pic_order_cnt_lsb
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // delta_pic_order_cnt_bottom
    tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), deltaPicOrderCntBottom)
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckDeltaPicOrderCnt(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?; nalUnitType : nalUnitType_e; picOrderPresentFlag : uint; var deltaPicOrderCnt : int?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // picOrderCntType must be equal to 1 and deltaPicOrderAlwaysZeroFlag must
    // be FALSE
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id when necessary
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    // delta_pic_order_cnt[0]
    tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(deref(deltaPicOrderCnt + 0)))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // delta_pic_order_cnt[1] if present
    if (picOrderPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(deref(deltaPicOrderCnt + 1)))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckRedundantPicCnt(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?; var pPicParamSet : picParamSet_t?; nalUnitType : nalUnitType_e; var redundantPicCnt : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var ivalue : int
    var tmpStrmData : strmData_t[1]
    // Code
    // redundant_pic_cnt_flag must be TRUE
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id when necessary
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    if (pSeqParamSet.picOrderCntType == uint(0)) {
        // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
        i = uint(0)
        while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
            i++
        }
        i--
        // pic_order_cnt_lsb
        tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (pPicParamSet.picOrderPresentFlag != 0) {
            // skip delta_pic_order_cnt_bottom
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    if (pSeqParamSet.picOrderCntType == uint(1) && !(pSeqParamSet.deltaPicOrderAlwaysZeroFlag != 0)) {
        // delta_pic_order_cnt[0]
        tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // delta_pic_order_cnt[1] if present
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    // redundant_pic_cnt
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), redundantPicCnt)
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdCheckPriorPicsFlag
// Functional description:
// Peek value of no_output_of_prior_pics_flag from the slice header.
// Function does not modify current stream positions but copies
// the stream data structure to tmp structure which is used while
// accessing stream data.
// Inputs:
// pStrmData pointer to stream data structure
// pSeqParamSet pointer to active SPS
// pPicParamSet pointer to active PPS
// nalUnitType type of the current NAL unit
// Outputs:
// noOutputOfPriorPicsFlag value is stored here
// Returns:
// HANTRO_OK success
// HANTRO_NOK invalid stream data
// ------------------------------------------------------------------------------
// lint -e715 disable lint info nalUnitType not referenced
[c_function]
def h264bsdCheckPriorPicsFlag(var noOutputOfPriorPicsFlag : uint?; var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?; var pPicParamSet : picParamSet_t?; nalUnitType : nalUnitType_e) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var ivalue : int
    var tmpStrmData : strmData_t[1]
    // Code
    // must be IDR lsice
    // don't touch original stream position params
    deref(addr(tmpStrmData[0])) = deref(pStrmData)
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = uint(0)
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSeqParamSet.picOrderCntType == uint(0)) {
        // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
        i = uint(0)
        while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
            i++
        }
        i--
        // skip pic_order_cnt_lsb
        tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (pPicParamSet.picOrderPresentFlag != 0) {
            // skip delta_pic_order_cnt_bottom
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    if (pSeqParamSet.picOrderCntType == uint(1) && !(pSeqParamSet.deltaPicOrderAlwaysZeroFlag != 0)) {
        // skip delta_pic_order_cnt[0]
        tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // skip delta_pic_order_cnt[1] if present
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    // skip redundant_pic_cnt
    if (pPicParamSet.redundantPicCntPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    deref(noOutputOfPriorPicsFlag) = h264bsdGetBits(addr(tmpStrmData[0]), uint(1))
    if (deref(noOutputOfPriorPicsFlag) == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdInitStorage(var pStorage : storage?) {
    // Variables
    // Code
    memset1(reinterpret<void?>(pStorage), 0, uint64(typeinfo sizeof(type<storage>)))
    pStorage.activeSpsId = uint(MAX_NUM_SEQ_PARAM_SETS)
    pStorage.activePpsId = uint(MAX_NUM_PIC_PARAM_SETS)
    addr(pStorage.aub[0]).firstCallFlag = uint(HANTRO_TRUE)
}

[c_function]
def h264bsdStoreSeqParamSet(var pStorage : storage?; var pSeqParamSet : seqParamSet_t?) : uint {
    // Variables
    var id : uint
    // Code
    id = pSeqParamSet.seqParameterSetId
    // seq parameter set with id not used before -> allocate memory
    if (pStorage.sps[id] == null) {
        {
            pStorage.sps[id] = reinterpret<seqParamSet_t?>(malloc1(uint64(1) * uint64(typeinfo sizeof(type<seqParamSet_t>))))
        }
        if (pStorage.sps[id] == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
    } elif (id == pStorage.activeSpsId) {
        // sequence parameter set with id equal to id of active sps
        // if seq parameter set contents changes
        // -> overwrite and re-activate when next IDR picture decoded
        // ids of active param sets set to invalid values to force
        // re-activation. Memories allocated for old sps freed
        // otherwise free memeries allocated for just decoded sps and
        // continue
        if (h264bsdCompareSeqParamSets(pSeqParamSet, pStorage.activeSps) != uint(0)) {
            {
                free1(reinterpret<void?>(pStorage.sps[id].offsetForRefFrame))
                pStorage.sps[id].offsetForRefFrame = null
            }
            {
                free1(reinterpret<void?>(pStorage.sps[id].vuiParameters))
                pStorage.sps[id].vuiParameters = null
            }
            pStorage.activeSpsId = uint(MAX_NUM_SEQ_PARAM_SETS + 1)
            pStorage.activePpsId = uint(MAX_NUM_PIC_PARAM_SETS + 1)
            pStorage.activeSps = null
            pStorage.activePps = null
        } else {
            {
                free1(reinterpret<void?>(pSeqParamSet.offsetForRefFrame))
                pSeqParamSet.offsetForRefFrame = null
            }
            {
                free1(reinterpret<void?>(pSeqParamSet.vuiParameters))
                pSeqParamSet.vuiParameters = null
            }
            return uint(HANTRO_OK)
        }
    } else {
        {
            // overwrite seq param set other than active one -> free memories
            // allocated for old param set
            free1(reinterpret<void?>(pStorage.sps[id].offsetForRefFrame))
            pStorage.sps[id].offsetForRefFrame = null
        }
        {
            free1(reinterpret<void?>(pStorage.sps[id].vuiParameters))
            pStorage.sps[id].vuiParameters = null
        }
    }
    deref(pStorage.sps[id]) = deref(pSeqParamSet)
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdStorePicParamSet(var pStorage : storage?; var pPicParamSet : picParamSet_t?) : uint {
    // Variables
    var id : uint
    // Code
    id = pPicParamSet.picParameterSetId
    // pic parameter set with id not used before -> allocate memory
    if (pStorage.pps[id] == null) {
        {
            pStorage.pps[id] = reinterpret<picParamSet_t?>(malloc1(uint64(1) * uint64(typeinfo sizeof(type<picParamSet_t>))))
        }
        if (pStorage.pps[id] == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
    } elif (id == pStorage.activePpsId) {
        // picture parameter set with id equal to id of active pps
        // check whether seq param set changes, force re-activation of
        // param set if it does. Set activeSpsId to invalid value to
        // accomplish this
        if (pPicParamSet.seqParameterSetId != pStorage.activeSpsId) {
            pStorage.activePpsId = uint(MAX_NUM_PIC_PARAM_SETS + 1)
        }
        {
            // free memories allocated for old param set
            free1(reinterpret<void?>(pStorage.pps[id].runLength))
            pStorage.pps[id].runLength = null
        }
        {
            free1(reinterpret<void?>(pStorage.pps[id].topLeft))
            pStorage.pps[id].topLeft = null
        }
        {
            free1(reinterpret<void?>(pStorage.pps[id].bottomRight))
            pStorage.pps[id].bottomRight = null
        }
        {
            free1(reinterpret<void?>(pStorage.pps[id].sliceGroupId))
            pStorage.pps[id].sliceGroupId = null
        }
    } else {
        {
            // overwrite pic param set other than active one -> free memories
            // allocated for old param set
            free1(reinterpret<void?>(pStorage.pps[id].runLength))
            pStorage.pps[id].runLength = null
        }
        {
            free1(reinterpret<void?>(pStorage.pps[id].topLeft))
            pStorage.pps[id].topLeft = null
        }
        {
            free1(reinterpret<void?>(pStorage.pps[id].bottomRight))
            pStorage.pps[id].bottomRight = null
        }
        {
            free1(reinterpret<void?>(pStorage.pps[id].sliceGroupId))
            pStorage.pps[id].sliceGroupId = null
        }
    }
    deref(pStorage.pps[id]) = deref(pPicParamSet)
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdActivateParamSets(var pStorage : storage?; ppsId : uint; isIdr : uint) : uint {
    // Variables
    var tmp : uint
    var flag : uint
    // Code
    // check that pps and corresponding sps exist
    if (pStorage.pps[ppsId] == null || pStorage.sps[pStorage.pps[ppsId].seqParameterSetId] == null) {
        return uint(HANTRO_NOK)
    }
    // check that pps parameters do not violate picture size constraints
    tmp = h264_file_all__CheckPps(pStorage.pps[ppsId], pStorage.sps[pStorage.pps[ppsId].seqParameterSetId])
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // first activation part1
    if (pStorage.activePpsId == uint(MAX_NUM_PIC_PARAM_SETS)) {
        pStorage.activePpsId = ppsId
        pStorage.activePps = pStorage.pps[ppsId]
        pStorage.activeSpsId = pStorage.activePps.seqParameterSetId
        pStorage.activeSps = pStorage.sps[pStorage.activeSpsId]
        pStorage.picSizeInMbs = pStorage.activeSps.picWidthInMbs * pStorage.activeSps.picHeightInMbs
        addr(pStorage.currImage[0]).width = pStorage.activeSps.picWidthInMbs
        addr(pStorage.currImage[0]).height = pStorage.activeSps.picHeightInMbs
        pStorage.pendingActivation = uint(HANTRO_TRUE)
    } elif (pStorage.pendingActivation != 0) {
        // first activation part2
        pStorage.pendingActivation = uint(HANTRO_FALSE)
        {
            free1(reinterpret<void?>(pStorage.mb))
            pStorage.mb = null
        }
        {
            free1(reinterpret<void?>(pStorage.sliceGroupMap))
            pStorage.sliceGroupMap = null
        }
        {
            pStorage.mb = reinterpret<mbStorage?>(malloc1(uint64(pStorage.picSizeInMbs) * uint64(typeinfo sizeof(type<mbStorage>))))
        }
        {
            pStorage.sliceGroupMap = reinterpret<uint?>(malloc1(uint64(pStorage.picSizeInMbs) * uint64(typeinfo sizeof(type<uint>))))
        }
        if (pStorage.mb == null || pStorage.sliceGroupMap == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
        memset1(reinterpret<void?>(pStorage.mb), 0, uint64(pStorage.picSizeInMbs) * uint64(typeinfo sizeof(type<mbStorage>)))
        h264bsdInitMbNeighbours(pStorage.mb, pStorage.activeSps.picWidthInMbs, pStorage.picSizeInMbs)
        // dpb output reordering disabled if
        // 1) application set noReordering flag
        // 2) POC type equal to 2
        // 3) num_reorder_frames in vui equal to 0
        if (pStorage.noReordering != 0 || pStorage.activeSps.picOrderCntType == uint(2) || pStorage.activeSps.vuiParametersPresentFlag != 0 && pStorage.activeSps.vuiParameters.bitstreamRestrictionFlag != 0 && !(pStorage.activeSps.vuiParameters.numReorderFrames != 0)) {
            flag = uint(HANTRO_TRUE)
        } else {
            flag = uint(HANTRO_FALSE)
        }
        tmp = h264bsdResetDpb(addr(pStorage.dpb[0]), pStorage.activeSps.picWidthInMbs * pStorage.activeSps.picHeightInMbs, pStorage.activeSps.maxDpbSize, pStorage.activeSps.numRefFrames, pStorage.activeSps.maxFrameNum, flag)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } elif (ppsId != pStorage.activePpsId) {
        // sequence parameter set shall not change but before an IDR picture
        if (pStorage.pps[ppsId].seqParameterSetId != pStorage.activeSpsId) {
            if (isIdr != 0) {
                pStorage.activePpsId = ppsId
                pStorage.activePps = pStorage.pps[ppsId]
                pStorage.activeSpsId = pStorage.activePps.seqParameterSetId
                pStorage.activeSps = pStorage.sps[pStorage.activeSpsId]
                pStorage.picSizeInMbs = pStorage.activeSps.picWidthInMbs * pStorage.activeSps.picHeightInMbs
                addr(pStorage.currImage[0]).width = pStorage.activeSps.picWidthInMbs
                addr(pStorage.currImage[0]).height = pStorage.activeSps.picHeightInMbs
                pStorage.pendingActivation = uint(HANTRO_TRUE)
            } else {
                return uint(HANTRO_NOK)
            }
        } else {
            pStorage.activePpsId = ppsId
            pStorage.activePps = pStorage.pps[ppsId]
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdResetStorage(var pStorage : storage?) {
    // Variables
    var i : uint
    // Code
    addr(pStorage.slice[0]).numDecodedMbs = uint(0)
    addr(pStorage.slice[0]).sliceId = uint(0)
    {
        i = uint(0)
        while (i < pStorage.picSizeInMbs) {
            deref(pStorage.mb + i).sliceId = uint(0)
            deref(pStorage.mb + i).decoded = uint(0)
            i++
        }
    }
}

def h264bsdIsStartOfPicture(var pStorage : storage?) : uint {
    // Variables
    // Code
    if (pStorage.validSliceInAccessUnit == uint(HANTRO_FALSE)) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

[c_function]
def h264bsdIsEndOfPicture(var pStorage : storage?) : uint {
    // Variables
    var i : uint
    var tmp : uint
    // Code
    // primary picture
    if (!(pStorage.sliceHeader[0].redundantPicCnt != 0)) {
        if (addr(pStorage.slice[0]).numDecodedMbs == pStorage.picSizeInMbs) {
            return uint(HANTRO_TRUE)
        }
    } else {
        {
            i = uint(0)
            tmp = uint(0)
            while (i < pStorage.picSizeInMbs) {
                tmp += uint(deref(pStorage.mb + i).decoded != 0 ? 1 : 0)
                i++
            }
        }
        if (tmp == pStorage.picSizeInMbs) {
            return uint(HANTRO_TRUE)
        }
    }
    return uint(HANTRO_FALSE)
}

def h264bsdComputeSliceGroupMap(var pStorage : storage?; sliceGroupChangeCycle : uint) {
    // Variables
    // Code
    h264bsdDecodeSliceGroupMap(pStorage.sliceGroupMap, pStorage.activePps, sliceGroupChangeCycle, pStorage.activeSps.picWidthInMbs, pStorage.activeSps.picHeightInMbs)
}

[c_function]
def h264bsdCheckAccessUnitBoundary(var strm : strmData_t?; var nuNext : nalUnit_t?; var storage : storage?; var accessUnitBoundaryFlag : uint?) : uint {
    // Variables
    var tmp : uint
    var ppsId : uint
    var frameNum : uint
    var idrPicId : uint
    var picOrderCntLsb : uint
    var deltaPicOrderCntBottom : int
    var deltaPicOrderCnt : int[2]
    var sps : seqParamSet_t?
    var pps : picParamSet_t?
    // Code
    // initialize default output to FALSE
    deref(accessUnitBoundaryFlag) = uint(HANTRO_FALSE)
    if (uint(int(nuNext.nalUnitType)) > uint(5) && uint(int(nuNext.nalUnitType)) < uint(12) || uint(int(nuNext.nalUnitType)) > uint(12) && uint(int(nuNext.nalUnitType)) <= uint(18)) {
        deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
        return uint(HANTRO_OK)
    } elif (nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE && nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR) {
        return uint(HANTRO_OK)
    }
    // check if this is the very first call to this function
    if (addr(storage.aub[0]).firstCallFlag != 0) {
        deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
        addr(storage.aub[0]).firstCallFlag = uint(HANTRO_FALSE)
    }
    // get picture parameter set id
    tmp = h264bsdCheckPpsId(strm, addr(ppsId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // store sps and pps in separate pointers just to make names shorter
    pps = storage.pps[ppsId]
    if (pps == null || storage.sps[pps.seqParameterSetId] == null || storage.activeSpsId != uint(MAX_NUM_SEQ_PARAM_SETS) && pps.seqParameterSetId != storage.activeSpsId && nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR) {
        return uint(PARAM_SET_ERROR)
    }
    sps = storage.sps[pps.seqParameterSetId]
    if (addr(addr(storage.aub[0]).nuPrev[0]).nalRefIdc != nuNext.nalRefIdc && (addr(addr(storage.aub[0]).nuPrev[0]).nalRefIdc == uint(0) || nuNext.nalRefIdc == uint(0))) {
        deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
    }
    if (addr(addr(storage.aub[0]).nuPrev[0]).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR && nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR || addr(addr(storage.aub[0]).nuPrev[0]).nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR && nuNext.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
    }
    tmp = h264bsdCheckFrameNum(strm, sps.maxFrameNum, addr(frameNum))
    if (tmp != uint(HANTRO_OK)) {
        return uint(HANTRO_NOK)
    }
    if (addr(storage.aub[0]).prevFrameNum != frameNum) {
        addr(storage.aub[0]).prevFrameNum = frameNum
        deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
    }
    if (nuNext.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdCheckIdrPicId(strm, sps.maxFrameNum, nuNext.nalUnitType, addr(idrPicId))
        if (tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        if (addr(addr(storage.aub[0]).nuPrev[0]).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR && addr(storage.aub[0]).prevIdrPicId != idrPicId) {
            deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
        }
        addr(storage.aub[0]).prevIdrPicId = idrPicId
    }
    if (sps.picOrderCntType == uint(0)) {
        tmp = h264bsdCheckPicOrderCntLsb(strm, sps, nuNext.nalUnitType, addr(picOrderCntLsb))
        if (tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        if (addr(storage.aub[0]).prevPicOrderCntLsb != picOrderCntLsb) {
            addr(storage.aub[0]).prevPicOrderCntLsb = picOrderCntLsb
            deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
        }
        if (pps.picOrderPresentFlag != 0) {
            tmp = h264bsdCheckDeltaPicOrderCntBottom(strm, sps, nuNext.nalUnitType, addr(deltaPicOrderCntBottom))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (addr(storage.aub[0]).prevDeltaPicOrderCntBottom != deltaPicOrderCntBottom) {
                addr(storage.aub[0]).prevDeltaPicOrderCntBottom = deltaPicOrderCntBottom
                deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
            }
        }
    } elif (sps.picOrderCntType == uint(1) && !(sps.deltaPicOrderAlwaysZeroFlag != 0)) {
        tmp = h264bsdCheckDeltaPicOrderCnt(strm, sps, nuNext.nalUnitType, pps.picOrderPresentFlag, addr(deltaPicOrderCnt[0]))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (addr(storage.aub[0]).prevDeltaPicOrderCnt[0] != deltaPicOrderCnt[0]) {
            addr(storage.aub[0]).prevDeltaPicOrderCnt[0] = deltaPicOrderCnt[0]
            deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
        }
        if (pps.picOrderPresentFlag != 0) {
            if (addr(storage.aub[0]).prevDeltaPicOrderCnt[1] != deltaPicOrderCnt[1]) {
                addr(storage.aub[0]).prevDeltaPicOrderCnt[1] = deltaPicOrderCnt[1]
                deref(accessUnitBoundaryFlag) = uint(HANTRO_TRUE)
            }
        }
    }
    deref(addr(addr(storage.aub[0]).nuPrev[0])) = deref(nuNext)
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: CheckPps
// Functional description:
// Check picture parameter set. Contents of the picture parameter
// set information that depends on the image dimensions is checked
// against the dimensions in the sps.
// Inputs:
// pps pointer to picture paramter set
// sps pointer to sequence parameter set
// Outputs:
// none
// Returns:
// HANTRO_OK everything ok
// HANTRO_NOK invalid data in picture parameter set
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__CheckPps(var pps : picParamSet_t?; var sps : seqParamSet_t?) : uint {
    var i : uint
    var picSize : uint
    picSize = sps.picWidthInMbs * sps.picHeightInMbs
    // check slice group params
    if (pps.numSliceGroups > uint(1)) {
        if (pps.sliceGroupMapType == uint(0)) {
            {
                i = uint(0)
                while (i < pps.numSliceGroups) {
                    if (deref(pps.runLength + i) > picSize) {
                        return uint(HANTRO_NOK)
                    }
                    i++
                }
            }
        } elif (pps.sliceGroupMapType == uint(2)) {
            {
                i = uint(0)
                while (i < pps.numSliceGroups - uint(1)) {
                    if (deref(pps.topLeft + i) > deref(pps.bottomRight + i) || deref(pps.bottomRight + i) >= picSize) {
                        return uint(HANTRO_NOK)
                    }
                    if (deref(pps.topLeft + i) % sps.picWidthInMbs > deref(pps.bottomRight + i) % sps.picWidthInMbs) {
                        return uint(HANTRO_NOK)
                    }
                    i++
                }
            }
        } elif (pps.sliceGroupMapType > uint(2) && pps.sliceGroupMapType < uint(6)) {
            if (pps.sliceGroupChangeRate > picSize) {
                return uint(HANTRO_NOK)
            }
        } elif (pps.sliceGroupMapType == uint(6) && pps.picSizeInMapUnits < picSize) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

def h264bsdValidParamSets(var pStorage : storage?) : uint {
    // Variables
    // Code
    for (i in urange(uint(MAX_NUM_PIC_PARAM_SETS))) {
        if (pStorage.pps[i] != null && pStorage.sps[pStorage.pps[i].seqParameterSetId] != null && h264_file_all__CheckPps(pStorage.pps[i], pStorage.sps[pStorage.pps[i].seqParameterSetId]) == uint(HANTRO_OK)) {
            return uint(HANTRO_OK)
        }
    }
    return uint(HANTRO_NOK)
}

def h264bsdGetBits(var pStrmData : strmData_t?; numBits : uint) : uint {
    var out : uint
    out = h264bsdShowBits32(pStrmData) >> uint(32) - numBits
    if (h264bsdFlushBits(pStrmData, numBits) == uint(HANTRO_OK)) {
        return out
    } else {
        return END_OF_STREAM
    }
}

[c_function]
def h264bsdShowBits32(var pStrmData : strmData_t?) : uint {
    var bits : int
    var shift : int
    var out : uint
    var pStrm : uint8?
    pStrm = pStrmData.pStrmCurrPos
    // number of bits left in the buffer
    bits = int(pStrmData.strmBuffSize) * 8 - int(pStrmData.strmBuffReadBits)
    // at least 32-bits in the buffer
    if (bits >= 32) {
        var bitPosInWord : uint = pStrmData.bitPosInWord
        out = uint(deref(pStrm + 0)) << 24u | uint(deref(pStrm + 1)) << 16u | uint(deref(pStrm + 2)) << 8u | uint(deref(pStrm + 3))
        if (bitPosInWord != 0) {
            var byte : uint = uint(deref(pStrm + 4))
            var tmp : uint = uint(8) - bitPosInWord
            out <<= bitPosInWord
            out |= byte >> tmp
        }
        return out
    } elif (bits > 0) {
        // at least one bit in the buffer
        shift = int(uint(24) + pStrmData.bitPosInWord)
        var _t0 = pStrm
        pStrm = pStrm + 1
        out = uint(deref(_t0)) << uint(shift)
        bits -= int(uint(8) - pStrmData.bitPosInWord)
        while (bits > 0) {
            shift -= 8
            var _t1 = pStrm
            pStrm = pStrm + 1
            out |= uint(deref(_t1)) << uint(shift)
            bits -= 8
        }
        return out
    } else {
        return uint(0)
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdFlushBits
// Functional description:
// Remove bits from the stream buffer
// Input:
// pStrmData pointer to stream data structure
// numBits number of bits to remove
// Output:
// none
// Returns:
// HANTRO_OK success
// END_OF_STREAM not enough bits left
// ------------------------------------------------------------------------------
[c_function]
def h264bsdFlushBits(var pStrmData : strmData_t?; numBits : uint) : uint {
    pStrmData.strmBuffReadBits += numBits
    pStrmData.bitPosInWord = pStrmData.strmBuffReadBits & uint(7)
    if (pStrmData.strmBuffReadBits <= uint(8) * pStrmData.strmBuffSize) {
        pStrmData.pStrmCurrPos = pStrmData.pStrmBuffStart + (pStrmData.strmBuffReadBits >> 3u)
        return uint(HANTRO_OK)
    } else {
        return END_OF_STREAM
    }
}

def h264bsdIsByteAligned(var pStrmData : strmData_t?) : uint {
    // Variables
    // Code
    if (!(pStrmData.bitPosInWord != 0)) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdProcessBlock
// Functional description:
// Function performs inverse zig-zag scan, inverse scaling and
// inverse transform for a luma or a chroma residual block
// Inputs:
// data pointer to data to be processed
// qp quantization parameter
// skip skip processing of data[0], set to non-zero value
// if dc coeff hanled separately
// coeffMap 16 lsb's indicate which coeffs are non-zero,
// bit 0 (lsb) for coeff 0, bit 1 for coeff 1 etc.
// Outputs:
// data processed data
// Returns:
// HANTRO_OK success
// HANTRO_NOK processed data not in valid range [-512, 511]
// ------------------------------------------------------------------------------
[c_function]
def h264bsdProcessBlock(var data : int?; qp : uint; skip : uint; coeffMap : uint) : uint {
    // Variables
    var tmp0 : int
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var d1 : int
    var d2 : int
    var d3 : int
    var row : uint
    var col : uint
    var qpDiv : uint
    var ptr : int?
    // Code
    qpDiv = uint(h264_file_all__qpDiv6[qp])
    tmp1 = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][0] << int(qpDiv)
    tmp2 = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][1] << int(qpDiv)
    tmp3 = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][2] << int(qpDiv)
    if (!(skip != 0)) {
        deref(data + 0) *= tmp1
    }
    // at least one of the rows 1, 2 or 3 contain non-zero coeffs, mask takes
    // the scanning order into account
    if ((coeffMap & uint(65436)) != 0) {
        // do the zig-zag scan and inverse quantization
        d1 = deref(data + 1)
        d2 = deref(data + 14)
        d3 = deref(data + 15)
        deref(data + 1) = d1 * tmp2
        deref(data + 14) = d2 * tmp2
        deref(data + 15) = d3 * tmp3
        d1 = deref(data + 2)
        d2 = deref(data + 5)
        d3 = deref(data + 4)
        deref(data + 4) = d1 * tmp2
        deref(data + 2) = d2 * tmp1
        deref(data + 5) = d3 * tmp3
        d1 = deref(data + 8)
        d2 = deref(data + 3)
        d3 = deref(data + 6)
        tmp0 = d1 * tmp2
        deref(data + 8) = d2 * tmp1
        deref(data + 3) = d3 * tmp2
        d1 = deref(data + 7)
        d2 = deref(data + 12)
        d3 = deref(data + 9)
        deref(data + 6) = d1 * tmp2
        deref(data + 7) = d2 * tmp3
        deref(data + 12) = d3 * tmp2
        deref(data + 9) = tmp0
        d1 = deref(data + 10)
        d2 = deref(data + 11)
        d3 = deref(data + 13)
        deref(data + 13) = d1 * tmp3
        deref(data + 10) = d2 * tmp1
        deref(data + 11) = d3 * tmp2
        // horizontal transform
        {
            row = uint(4)
            ptr = data
            while (true) {
                let _t0 = row
                row--
                if (!(_t0 != 0)) {
                    break
                }
                tmp0 = deref(ptr + 0) + deref(ptr + 2)
                tmp1 = deref(ptr + 0) - deref(ptr + 2)
                tmp2 = (deref(ptr + 1) >> 1) - deref(ptr + 3)
                tmp3 = deref(ptr + 1) + (deref(ptr + 3) >> 1)
                deref(ptr + 0) = tmp0 + tmp3
                deref(ptr + 1) = tmp1 + tmp2
                deref(ptr + 2) = tmp1 - tmp2
                deref(ptr + 3) = tmp0 - tmp3
                ptr = ptr + 4
            }
        }
        // lint +e661 +e662
        // then vertical transform
        {
            col = uint(4)
            while (true) {
                let _t1 = col
                col--
                if (!(_t1 != 0)) {
                    break
                }
                tmp0 = deref(data + 0) + deref(data + 8)
                tmp1 = deref(data + 0) - deref(data + 8)
                tmp2 = (deref(data + 4) >> 1) - deref(data + 12)
                tmp3 = deref(data + 4) + (deref(data + 12) >> 1)
                deref(data + 0) = tmp0 + tmp3 + 32 >> 6
                deref(data + 4) = tmp1 + tmp2 + 32 >> 6
                deref(data + 8) = tmp1 - tmp2 + 32 >> 6
                deref(data + 12) = tmp0 - tmp3 + 32 >> 6
                // check that each value is in the range [-512,511]
                if (uint(deref(data + 0) + 512) > uint(1023) || uint(deref(data + 4) + 512) > uint(1023) || uint(deref(data + 8) + 512) > uint(1023) || uint(deref(data + 12) + 512) > uint(1023)) {
                    return uint(HANTRO_NOK)
                }
                data = data + 1
            }
        }
    } else {
        // rows 1, 2 and 3 are zero
        // only dc-coeff is non-zero, i.e. coeffs at original positions
        // 1, 5 and 6 are zero
        if ((coeffMap & uint(98)) == uint(0)) {
            tmp0 = deref(data + 0) + 32 >> 6
            // check that value is in the range [-512,511]
            if (uint(tmp0 + 512) > uint(1023)) {
                return uint(HANTRO_NOK)
            }
            deref(data + 15) = tmp0
            deref(data + 14) = deref(data + 15)
            deref(data + 13) = deref(data + 14)
            deref(data + 12) = deref(data + 13)
            deref(data + 11) = deref(data + 12)
            deref(data + 10) = deref(data + 11)
            deref(data + 9) = deref(data + 10)
            deref(data + 8) = deref(data + 9)
            deref(data + 7) = deref(data + 8)
            deref(data + 6) = deref(data + 7)
            deref(data + 5) = deref(data + 6)
            deref(data + 4) = deref(data + 5)
            deref(data + 3) = deref(data + 4)
            deref(data + 2) = deref(data + 3)
            deref(data + 1) = deref(data + 2)
            deref(data + 0) = deref(data + 1)
        } else {
            // at least one of the coeffs 1, 5 or 6 is non-zero
            deref(data + 1) *= tmp2
            deref(data + 2) = deref(data + 5) * tmp1
            deref(data + 3) = deref(data + 6) * tmp2
            tmp0 = deref(data + 0) + deref(data + 2)
            tmp1 = deref(data + 0) - deref(data + 2)
            tmp2 = (deref(data + 1) >> 1) - deref(data + 3)
            tmp3 = deref(data + 1) + (deref(data + 3) >> 1)
            deref(data + 0) = tmp0 + tmp3 + 32 >> 6
            deref(data + 1) = tmp1 + tmp2 + 32 >> 6
            deref(data + 2) = tmp1 - tmp2 + 32 >> 6
            deref(data + 3) = tmp0 - tmp3 + 32 >> 6
            deref(data + 12) = deref(data + 0)
            deref(data + 8) = deref(data + 12)
            deref(data + 4) = deref(data + 8)
            deref(data + 13) = deref(data + 1)
            deref(data + 9) = deref(data + 13)
            deref(data + 5) = deref(data + 9)
            deref(data + 14) = deref(data + 2)
            deref(data + 10) = deref(data + 14)
            deref(data + 6) = deref(data + 10)
            deref(data + 15) = deref(data + 3)
            deref(data + 11) = deref(data + 15)
            deref(data + 7) = deref(data + 11)
            // check that each value is in the range [-512,511]
            if (uint(deref(data + 0) + 512) > uint(1023) || uint(deref(data + 1) + 512) > uint(1023) || uint(deref(data + 2) + 512) > uint(1023) || uint(deref(data + 3) + 512) > uint(1023)) {
                return uint(HANTRO_NOK)
            }
        }
    }
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdProcessLumaDc
// Functional description:
// Function performs inverse zig-zag scan, inverse transform and
// inverse scaling for a luma DC coefficients block
// Inputs:
// data pointer to data to be processed
// qp quantization parameter
// Outputs:
// data processed data
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdProcessLumaDc(var data : int?; qp : uint) {
    // Variables
    var tmp0 : int
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var row : uint
    var col : uint
    var qpMod : uint
    var qpDiv : uint
    var levScale : int
    var ptr : int?
    // Code
    qpMod = uint(h264_file_all__qpMod6[qp])
    qpDiv = uint(h264_file_all__qpDiv6[qp])
    // zig-zag scan
    tmp0 = deref(data + 2)
    deref(data + 2) = deref(data + 5)
    deref(data + 5) = deref(data + 4)
    deref(data + 4) = tmp0
    tmp0 = deref(data + 8)
    deref(data + 8) = deref(data + 3)
    deref(data + 3) = deref(data + 6)
    deref(data + 6) = deref(data + 7)
    deref(data + 7) = deref(data + 12)
    deref(data + 12) = deref(data + 9)
    deref(data + 9) = tmp0
    tmp0 = deref(data + 10)
    deref(data + 10) = deref(data + 11)
    deref(data + 11) = deref(data + 13)
    deref(data + 13) = tmp0
    // horizontal transform
    {
        row = uint(4)
        ptr = data
        while (true) {
            let _t0 = row
            row--
            if (!(_t0 != 0)) {
                break
            }
            tmp0 = deref(ptr + 0) + deref(ptr + 2)
            tmp1 = deref(ptr + 0) - deref(ptr + 2)
            tmp2 = deref(ptr + 1) - deref(ptr + 3)
            tmp3 = deref(ptr + 1) + deref(ptr + 3)
            deref(ptr + 0) = tmp0 + tmp3
            deref(ptr + 1) = tmp1 + tmp2
            deref(ptr + 2) = tmp1 - tmp2
            deref(ptr + 3) = tmp0 - tmp3
            ptr = ptr + 4
        }
    }
    // lint +e661 +e662
    // then vertical transform and inverse scaling
    levScale = h264_file_all__levelScale[qpMod][0]
    if (qp >= uint(12)) {
        levScale <<= int(qpDiv - uint(2))
        {
            col = uint(4)
            while (true) {
                let _t1 = col
                col--
                if (!(_t1 != 0)) {
                    break
                }
                tmp0 = deref(data + 0) + deref(data + 8)
                tmp1 = deref(data + 0) - deref(data + 8)
                tmp2 = deref(data + 4) - deref(data + 12)
                tmp3 = deref(data + 4) + deref(data + 12)
                deref(data + 0) = (tmp0 + tmp3) * levScale
                deref(data + 4) = (tmp1 + tmp2) * levScale
                deref(data + 8) = (tmp1 - tmp2) * levScale
                deref(data + 12) = (tmp0 - tmp3) * levScale
                data = data + 1
            }
        }
    } else {
        var tmp : int
        tmp = uint(1) - qpDiv == uint(0) ? 1 : 2
        {
            col = uint(4)
            while (true) {
                let _t2 = col
                col--
                if (!(_t2 != 0)) {
                    break
                }
                tmp0 = deref(data + 0) + deref(data + 8)
                tmp1 = deref(data + 0) - deref(data + 8)
                tmp2 = deref(data + 4) - deref(data + 12)
                tmp3 = deref(data + 4) + deref(data + 12)
                deref(data + 0) = (tmp0 + tmp3) * levScale + tmp >> int(uint(2) - qpDiv)
                deref(data + 4) = (tmp1 + tmp2) * levScale + tmp >> int(uint(2) - qpDiv)
                deref(data + 8) = (tmp1 - tmp2) * levScale + tmp >> int(uint(2) - qpDiv)
                deref(data + 12) = (tmp0 - tmp3) * levScale + tmp >> int(uint(2) - qpDiv)
                data = data + 1
            }
        }
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdProcessChromaDc
// Functional description:
// Function performs inverse transform and inverse scaling for a
// chroma DC coefficients block
// Inputs:
// data pointer to data to be processed
// qp quantization parameter
// Outputs:
// data processed data
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdProcessChromaDc(var data : int?; qp : uint) {
    // Variables
    var tmp0 : int
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var qpDiv : uint
    var levScale : int
    var levShift : uint
    // Code
    qpDiv = uint(h264_file_all__qpDiv6[qp])
    levScale = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][0]
    if (qp >= uint(6)) {
        levScale <<= int(qpDiv - uint(1))
        levShift = uint(0)
    } else {
        levShift = uint(1)
    }
    tmp0 = deref(data + 0) + deref(data + 2)
    tmp1 = deref(data + 0) - deref(data + 2)
    tmp2 = deref(data + 1) - deref(data + 3)
    tmp3 = deref(data + 1) + deref(data + 3)
    deref(data + 0) = (tmp0 + tmp3) * levScale >> int(levShift)
    deref(data + 1) = (tmp0 - tmp3) * levScale >> int(levShift)
    deref(data + 2) = (tmp1 + tmp2) * levScale >> int(levShift)
    deref(data + 3) = (tmp1 - tmp2) * levScale >> int(levShift)
    tmp0 = deref(data + 4) + deref(data + 6)
    tmp1 = deref(data + 4) - deref(data + 6)
    tmp2 = deref(data + 5) - deref(data + 7)
    tmp3 = deref(data + 5) + deref(data + 7)
    deref(data + 4) = (tmp0 + tmp3) * levScale >> int(levShift)
    deref(data + 5) = (tmp0 - tmp3) * levScale >> int(levShift)
    deref(data + 6) = (tmp1 + tmp2) * levScale >> int(levShift)
    deref(data + 7) = (tmp1 - tmp2) * levScale >> int(levShift)
}

// ------------------------------------------------------------------------------
// 5.1 Function: h264bsdCountLeadingZeros
// Functional description:
// Count leading zeros in a code word. Code word is assumed to be
// right-aligned, last bit of the code word in the lsb of the value.
// Inputs:
// value code word
// length number of bits in the code word
// Outputs:
// none
// Returns:
// number of leading zeros in the code word
// ------------------------------------------------------------------------------
def h264bsdCountLeadingZeros(value : uint; length : uint) : uint {
    // Variables
    var zeros : uint = uint(0)
    var mask : uint = uint(1 << int(length - uint(1)))
    // Code
    while (mask != 0 && !((value & mask) != 0)) {
        zeros++
        mask >>= 1u
    }
    return zeros
}

def h264bsdRbspTrailingBits(var pStrmData : strmData_t?) : uint {
    // Variables
    var stuffing : uint
    var stuffingLength : uint
    // Code
    stuffingLength = uint(8) - pStrmData.bitPosInWord
    stuffing = h264bsdGetBits(pStrmData, stuffingLength)
    if (stuffing == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (stuffing != h264_file_all__stuffingTable[stuffingLength - uint(1)]) {
        return uint(HANTRO_NOK)
    } else {
        return uint(HANTRO_OK)
    }
}

def h264bsdMoreRbspData(var pStrmData : strmData_t?) : uint {
    // Variables
    var bits : uint
    // Code
    bits = pStrmData.strmBuffSize * uint(8) - pStrmData.strmBuffReadBits
    if (bits == uint(0)) {
        return uint(HANTRO_FALSE)
    }
    if (bits > uint(8) || uint64(h264bsdShowBits32(pStrmData) >> uint(32) - bits) != 1ul << uint64(bits - uint(1))) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

[c_function]
def h264bsdNextMbAddress(var pSliceGroupMap : uint?; picSizeInMbs : uint; currMbAddr : uint) : uint {
    // Variables
    var i : uint
    var sliceGroup : uint
    // Code
    sliceGroup = deref(pSliceGroupMap + currMbAddr)
    i = currMbAddr + uint(1)
    while (i < picSizeInMbs && deref(pSliceGroupMap + i) != sliceGroup) {
        i++
    }
    if (i == picSizeInMbs) {
        i = uint(0)
    }
    return i
}

// ------------------------------------------------------------------------------
// 5.5 Function: h264bsdSetCurrImageMbPointers
// Functional description:
// Set luma and chroma pointers in image_t for current MB
// Inputs:
// image Current image
// mbNum number of current MB
// Outputs:
// none
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdSetCurrImageMbPointers(var image : image_t?; mbNum : uint) {
    var width : uint
    var height : uint
    var picSize : uint
    var row : uint
    var col : uint
    var tmp : uint
    width = image.width
    height = image.height
    row = mbNum / width
    col = mbNum % width
    tmp = row * width
    picSize = width * height
    image.luma = image.data + col * uint(16) + tmp * uint(256)
    image.cb = image.data + picSize * uint(256) + tmp * uint(64) + col * uint(8)
    image.cr = image.cb + picSize * uint(64)
}

[c_function]
def h264bsdDecodeExpGolombUnsigned(var pStrmData : strmData_t?; var codeNum : uint?) : uint {
    // Variables
    var bits : uint
    var numZeros : uint
    // Code
    bits = h264bsdShowBits32(pStrmData)
    // first bit is 1 -> code length 1
    if (bits >= 2147483648u) {
        h264bsdFlushBits(pStrmData, uint(1))
        deref(codeNum) = uint(0)
        return uint(HANTRO_OK)
    } elif (bits >= uint(1073741824)) {
        // second bit is 1 -> code length 3
        if (h264bsdFlushBits(pStrmData, uint(3)) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        deref(codeNum) = uint(1) + (bits >> 29u & uint(1))
        return uint(HANTRO_OK)
    } elif (bits >= uint(536870912)) {
        // third bit is 1 -> code length 5
        if (h264bsdFlushBits(pStrmData, uint(5)) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        deref(codeNum) = uint(3) + (bits >> 27u & uint(3))
        return uint(HANTRO_OK)
    } elif (bits >= uint(268435456)) {
        // fourth bit is 1 -> code length 7
        if (h264bsdFlushBits(pStrmData, uint(7)) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        deref(codeNum) = uint(7) + (bits >> 25u & uint(7))
        return uint(HANTRO_OK)
    } else {
        // other code lengths
        numZeros = uint(4) + h264bsdCountLeadingZeros(bits, uint(28))
        // all 32 bits are zero
        if (numZeros == uint(32)) {
            deref(codeNum) = uint(0)
            h264bsdFlushBits(pStrmData, uint(32))
            bits = h264bsdGetBits(pStrmData, uint(1))
            // check 33rd bit, must be 1
            if (bits == uint(1)) {
                // cannot use h264bsdGetBits, limited to 31 bits
                bits = h264bsdShowBits32(pStrmData)
                if (h264bsdFlushBits(pStrmData, uint(32)) == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                // code num 2^32 - 1, needed for unsigned mapping
                if (bits == uint(0)) {
                    deref(codeNum) = BIG_CODE_NUM
                    return uint(HANTRO_OK)
                } elif (bits == uint(1)) {
                    // code num 2^32, needed for unsigned mapping
                    // (results in -2^31)
                    deref(codeNum) = BIG_CODE_NUM
                    return uint(HANTRO_NOK)
                }
            }
            // if more zeros than 32, it is an error
            return uint(HANTRO_NOK)
        } else {
            h264bsdFlushBits(pStrmData, numZeros + uint(1))
        }
        bits = h264bsdGetBits(pStrmData, numZeros)
        if (bits == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        deref(codeNum) = uint((1 << int(numZeros)) - 1) + bits
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDecodeExpGolombSigned(var pStrmData : strmData_t?; var value : int?) : uint {
    // Variables
    var status : uint
    var codeNum : uint = uint(0)
    // Code
    status = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(codeNum))
    if (codeNum == BIG_CODE_NUM) {
        // BIG_CODE_NUM and HANTRO_OK status means codeNum 2^32-1 which would
        // result in signed integer valued 2^31 (i.e. out of 32-bit signed
        // integer range)
        if (status == uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        } else {
            // BIG_CODE_NUM and HANTRO_NOK status means codeNum 2^32 which results
            // in signed integer valued -2^31
            deref(value) = int(2147483648u)
            return uint(HANTRO_OK)
        }
    } elif (status == uint(HANTRO_OK)) {
        // (-1)^(codeNum+1) results in positive sign if codeNum is odd,
        // negative when it is even. (codeNum+1)/2 is obtained as
        // (codeNum+1)>>1 when value is positive and as (-codeNum)>>1 for
        // negative value
        // lint -e702
        deref(value) = (codeNum & uint(1)) != 0 ? int(codeNum + uint(1) >> 1u) : -int(codeNum + uint(1) >> 1u)
        // lint +e702
        return uint(HANTRO_OK)
    }
    return uint(HANTRO_NOK)
}

[c_function]
def h264bsdDecodeExpGolombMapped(var pStrmData : strmData_t?; var value : uint?; isIntra : uint) : uint {
    // Variables
    var status : uint
    var codeNum : uint
    // Code
    status = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(codeNum))
    if (status != uint(HANTRO_OK)) {
        return uint(HANTRO_NOK)
    } else {
        // range of valid codeNums [0,47]
        if (codeNum > uint(47)) {
            return uint(HANTRO_NOK)
        }
        if (isIntra != 0) {
            deref(value) = uint(h264_file_all__codedBlockPatternIntra4x4[codeNum])
        } else {
            deref(value) = uint(h264_file_all__codedBlockPatternInter[codeNum])
        }
        return uint(HANTRO_OK)
    }
}

[c_function]
def h264bsdDecodeExpGolombTruncated(var pStrmData : strmData_t?; var value : uint?; greaterThanOne : uint) : uint {
    // Variables
    // Code
    if (greaterThanOne != 0) {
        return h264bsdDecodeExpGolombUnsigned(pStrmData, value)
    } else {
        deref(value) = h264bsdGetBits(pStrmData, uint(1))
        if (deref(value) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        deref(value) ^= uint(1)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDecodeVuiParameters(var pStrmData : strmData_t?; var pVuiParameters : vuiParameters_t?) : uint {
    // Variables
    var tmp : uint
    // Code
    memset1(reinterpret<void?>(pVuiParameters), 0, uint64(typeinfo sizeof(type<vuiParameters_t>)))
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.aspectRatioPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.aspectRatioPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, uint(8))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.aspectRatioIdc = tmp
        if (pVuiParameters.aspectRatioIdc == uint(int(anon_81.ASPECT_RATIO_EXTENDED_SAR))) {
            tmp = h264bsdGetBits(pStrmData, uint(16))
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.sarWidth = tmp
            tmp = h264bsdGetBits(pStrmData, uint(16))
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.sarHeight = tmp
        }
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.overscanInfoPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.overscanInfoPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.overscanAppropriateFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.videoSignalTypePresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.videoSignalTypePresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, uint(3))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.videoFormat = tmp
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.videoFullRangeFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.colourDescriptionPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
        if (pVuiParameters.colourDescriptionPresentFlag != 0) {
            tmp = h264bsdGetBits(pStrmData, uint(8))
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.colourPrimaries = tmp
            tmp = h264bsdGetBits(pStrmData, uint(8))
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.transferCharacteristics = tmp
            tmp = h264bsdGetBits(pStrmData, uint(8))
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.matrixCoefficients = tmp
        } else {
            pVuiParameters.colourPrimaries = uint(2)
            pVuiParameters.transferCharacteristics = uint(2)
            pVuiParameters.matrixCoefficients = uint(2)
        }
    } else {
        pVuiParameters.videoFormat = uint(5)
        pVuiParameters.colourPrimaries = uint(2)
        pVuiParameters.transferCharacteristics = uint(2)
        pVuiParameters.matrixCoefficients = uint(2)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.chromaLocInfoPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.chromaLocInfoPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.chromaSampleLocTypeTopField))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.chromaSampleLocTypeTopField > uint(5)) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.chromaSampleLocTypeBottomField))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.chromaSampleLocTypeBottomField > uint(5)) {
            return uint(HANTRO_NOK)
        }
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.timingInfoPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.timingInfoPresentFlag != 0) {
        tmp = h264bsdShowBits32(pStrmData)
        if (h264bsdFlushBits(pStrmData, uint(32)) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (tmp == uint(0)) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.numUnitsInTick = tmp
        tmp = h264bsdShowBits32(pStrmData)
        if (h264bsdFlushBits(pStrmData, uint(32)) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (tmp == uint(0)) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.timeScale = tmp
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.fixedFrameRateFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.nalHrdParametersPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.nalHrdParametersPresentFlag != 0) {
        tmp = h264_file_all__DecodeHrdParameters(pStrmData, addr(pVuiParameters.nalHrdParameters))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        pVuiParameters.nalHrdParameters.cpbCnt = uint(1)
        // MaxBR and MaxCPB should be the values correspondig to the levelIdc
        // in the SPS containing these VUI parameters. However, these values
        // are not used anywhere and maximum for any level will be used here
        pVuiParameters.nalHrdParameters.bitRateValue[0] = uint(1200 * MAX_BR + 1)
        pVuiParameters.nalHrdParameters.cpbSizeValue[0] = uint(1200 * MAX_CPB + 1)
        pVuiParameters.nalHrdParameters.initialCpbRemovalDelayLength = uint(24)
        pVuiParameters.nalHrdParameters.cpbRemovalDelayLength = uint(24)
        pVuiParameters.nalHrdParameters.dpbOutputDelayLength = uint(24)
        pVuiParameters.nalHrdParameters.timeOffsetLength = uint(24)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.vclHrdParametersPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.vclHrdParametersPresentFlag != 0) {
        tmp = h264_file_all__DecodeHrdParameters(pStrmData, addr(pVuiParameters.vclHrdParameters))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        pVuiParameters.vclHrdParameters.cpbCnt = uint(1)
        // MaxBR and MaxCPB should be the values correspondig to the levelIdc
        // in the SPS containing these VUI parameters. However, these values
        // are not used anywhere and maximum for any level will be used here
        pVuiParameters.vclHrdParameters.bitRateValue[0] = uint(1000 * MAX_BR + 1)
        pVuiParameters.vclHrdParameters.cpbSizeValue[0] = uint(1000 * MAX_CPB + 1)
        pVuiParameters.vclHrdParameters.initialCpbRemovalDelayLength = uint(24)
        pVuiParameters.vclHrdParameters.cpbRemovalDelayLength = uint(24)
        pVuiParameters.vclHrdParameters.dpbOutputDelayLength = uint(24)
        pVuiParameters.vclHrdParameters.timeOffsetLength = uint(24)
    }
    if (pVuiParameters.nalHrdParametersPresentFlag != 0 || pVuiParameters.vclHrdParametersPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.lowDelayHrdFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    }
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.picStructPresentFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, uint(1))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.bitstreamRestrictionFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.bitstreamRestrictionFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, uint(1))
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.motionVectorsOverPicBoundariesFlag = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.maxBytesPerPicDenom))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.maxBytesPerPicDenom > uint(16)) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.maxBitsPerMbDenom))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.maxBitsPerMbDenom > uint(16)) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.log2MaxMvLengthHorizontal))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.log2MaxMvLengthHorizontal > uint(16)) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.log2MaxMvLengthVertical))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.log2MaxMvLengthVertical > uint(16)) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.numReorderFrames))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.maxDecFrameBuffering))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        pVuiParameters.motionVectorsOverPicBoundariesFlag = uint(HANTRO_TRUE)
        pVuiParameters.maxBytesPerPicDenom = uint(2)
        pVuiParameters.maxBitsPerMbDenom = uint(1)
        pVuiParameters.log2MaxMvLengthHorizontal = uint(16)
        pVuiParameters.log2MaxMvLengthVertical = uint(16)
        pVuiParameters.numReorderFrames = uint(MAX_DPB_SIZE)
        pVuiParameters.maxDecFrameBuffering = uint(MAX_DPB_SIZE)
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeHrdParameters(var pStrmData : strmData_t?; var pHrdParameters : hrdParameters_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pHrdParameters.cpbCnt))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // cpbCount = cpb_cnt_minus1 + 1
    pHrdParameters.cpbCnt++
    if (pHrdParameters.cpbCnt > uint(MAX_CPB_CNT)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, uint(4))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pHrdParameters.bitRateScale = tmp
    tmp = h264bsdGetBits(pStrmData, uint(4))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pHrdParameters.cpbSizeScale = tmp
    {
        i = uint(0)
        while (i < pHrdParameters.cpbCnt) {
            // bit_rate_value_minus1 in the range [0, 2^32 - 2]
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pHrdParameters.bitRateValue[0]) + end_index(i, 32))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (pHrdParameters.bitRateValue[i] > 4294967294u) {
                return uint(HANTRO_NOK)
            }
            pHrdParameters.bitRateValue[i]++
            // this may result in overflow, but this value is not used for
            // anything
            pHrdParameters.bitRateValue[i] *= uint(1 << int(uint(6) + pHrdParameters.bitRateScale))
            // cpb_size_value_minus1 in the range [0, 2^32 - 2]
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pHrdParameters.cpbSizeValue[0]) + end_index(i, 32))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (pHrdParameters.cpbSizeValue[i] > 4294967294u) {
                return uint(HANTRO_NOK)
            }
            pHrdParameters.cpbSizeValue[i]++
            // this may result in overflow, but this value is not used for
            // anything
            pHrdParameters.cpbSizeValue[i] *= uint(1 << int(uint(4) + pHrdParameters.cpbSizeScale))
            tmp = h264bsdGetBits(pStrmData, uint(1))
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pHrdParameters.cbrFlag[i] = uint(tmp == uint(1) ? HANTRO_TRUE : HANTRO_FALSE)
            i++
        }
    }
    tmp = h264bsdGetBits(pStrmData, uint(5))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pHrdParameters.initialCpbRemovalDelayLength = tmp + uint(1)
    tmp = h264bsdGetBits(pStrmData, uint(5))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pHrdParameters.cpbRemovalDelayLength = tmp + uint(1)
    tmp = h264bsdGetBits(pStrmData, uint(5))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pHrdParameters.dpbOutputDelayLength = tmp + uint(1)
    tmp = h264bsdGetBits(pStrmData, uint(5))
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pHrdParameters.timeOffsetLength = tmp
    return uint(HANTRO_OK)
}

// Allocate vector with given size, return 1 on success, 0 on fail
[c_function]
def private h264_file_all__minimp4_vector_init(var h : minimp4_vector_t?; capacity : int) : int {
    h.bytes = 0
    h.capacity = capacity
    h.data = capacity != 0 ? reinterpret<uint8?>(malloc1(uint64(capacity))) : null
    return !(capacity != 0) || !!(h.data != null) ? 1 : 0
}

// Deallocates vector memory
[c_function]
def private h264_file_all__minimp4_vector_reset(var h : minimp4_vector_t?) {
    if (h.data != null) {
        free1(reinterpret<void?>(h.data))
    }
    memset1(reinterpret<void?>(h), 0, uint64(typeinfo sizeof(type<minimp4_vector_t>)))
}

// Reallocate vector memory to the given size
[c_function]
def private h264_file_all__minimp4_vector_grow(var h : minimp4_vector_t?; bytes : int) : int {
    var p : void?
    var new_size : int = h.capacity * 2 + 1024
    if (new_size < h.capacity + bytes) {
        new_size = h.capacity + bytes + 1024
    }
    p = realloc1(reinterpret<void?>(h.data), uint64(new_size))
    if (!(p != null)) {
        return 0
    }
    h.data = reinterpret<uint8?>(p)
    h.capacity = new_size
    return 1
}

// Allocates given number of bytes at the end of vector data, increasing
// vector memory if necessary.
// Return allocated memory.
[c_function]
def private h264_file_all__minimp4_vector_alloc_tail(var h : minimp4_vector_t?; bytes : int) : uint8? {
    var p : uint8?
    if (!(h.data != null) && !(h264_file_all__minimp4_vector_init(h, 2 * bytes + 1024) != 0)) {
        return null
    }
    if (h.capacity - h.bytes < bytes && !(h264_file_all__minimp4_vector_grow(h, bytes) != 0)) {
        return null
    }
    let _t0 = h.data
    let _t1 = h.capacity - h.bytes >= bytes
    p = h.data + h.bytes
    h.bytes += bytes
    return p
}

// Append data to the end of the vector (accumulate ot enqueue)
[c_function]
def private h264_file_all__minimp4_vector_put(var h : minimp4_vector_t?; var buf : void?; bytes : int) : uint8? {
    var tail : uint8? = h264_file_all__minimp4_vector_alloc_tail(h, bytes)
    if (tail != null) {
        memcpy1(reinterpret<void?>(tail), buf, uint64(bytes))
