    deref(data + 7) = uint8(int(deref(above + 1)) + 2 * int(deref(above + 2)) + int(deref(above + 3)) + 2 >> 2)
    deref(data + 3) = uint8(int(deref(above + 2)) + int(deref(above + 3)) + 1 >> 1)
    deref(data + 8) = uint8(int(deref(left + 1)) + 2 * int(deref(left + 0)) + int(deref(left + -1)) + 2 >> 2)
    deref(data + 12) = uint8(int(deref(left + 2)) + 2 * int(deref(left + 1)) + int(deref(left + 0)) + 2 >> 2)
}

