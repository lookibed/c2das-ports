[c_function]
def private h264_file_all__FindDpbPic(var dpb : dpbStorage_t?; picNum : int; isShortTerm : uint) : int {
    // Variables
    var i : uint = uint(0)
    var found : uint = uint(HANTRO_FALSE)
    // Code
    if (isShortTerm != 0) {
        while (i < dpb.maxRefFrames && !(found != 0)) {
            if ((deref(dpb.buffer + i).status == dpbPictureStatus_e.NON_EXISTING || deref(dpb.buffer + i).status == dpbPictureStatus_e.SHORT_TERM) && deref(dpb.buffer + i).picNum == picNum) {
                found = uint(HANTRO_TRUE)
            } else {
                i++
            }
        }
    } else {
        while (i < dpb.maxRefFrames && !(found != 0)) {
            if (deref(dpb.buffer + i).status == dpbPictureStatus_e.LONG_TERM && deref(dpb.buffer + i).picNum == picNum) {
                found = uint(HANTRO_TRUE)
            } else {
                i++
            }
        }
    }
    if (found != 0) {
        return int(i)
    } else {
        return -1
    }
}

[c_function]
def private h264_file_all__SetPicNums(var dpb : dpbStorage_t?; currFrameNum : uint) {
    // Variables
    var i : uint
    var frameNumWrap : int
    // Code
    {
        i = uint(0)
        while (i < dpb.numRefFrames) {
            if (deref(dpb.buffer + i).status == dpbPictureStatus_e.NON_EXISTING || deref(dpb.buffer + i).status == dpbPictureStatus_e.SHORT_TERM) {
                if (deref(dpb.buffer + i).frameNum > currFrameNum) {
                    frameNumWrap = int(deref(dpb.buffer + i).frameNum) - int(dpb.maxFrameNum)
                } else {
                    frameNumWrap = int(deref(dpb.buffer + i).frameNum)
                }
                deref(dpb.buffer + i).picNum = frameNumWrap
            }
            i++
        }
    }
}

[c_function]
def h264bsdCheckGapsInFrameNum(var dpb : dpbStorage_t?; frameNum : uint; isRefPic : uint; gapsAllowed : uint) : uint {
    // Variables
    var unUsedShortTermFrameNum : uint
    var tmp : uint8?
    // Code
    dpb.numOut = uint(0)
    dpb.outIndex = uint(0)
    if (!(gapsAllowed != 0)) {
        return uint(HANTRO_OK)
    }
    if (frameNum != dpb.prevRefFrameNum && frameNum != (dpb.prevRefFrameNum + uint(1)) % dpb.maxFrameNum) {
        unUsedShortTermFrameNum = (dpb.prevRefFrameNum + uint(1)) % dpb.maxFrameNum
        // store data pointer of last buffer position to be used as next
        // "allocated" data pointer if last buffer position after this process
        // contains data pointer located in outBuf (buffer placed in the output
        // shall not be overwritten by the current picture)
        tmp = deref(dpb.buffer + dpb.dpbSize).data
        while (true) {
            h264_file_all__SetPicNums(dpb, unUsedShortTermFrameNum)
            if (h264_file_all__SlidingWindowRefPicMarking(dpb) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
            // output pictures if buffer full
            while (dpb.fullness >= dpb.dpbSize) {
                h264_file_all__OutputPicture(dpb)
            }
            // add to end of list
            deref(dpb.buffer + dpb.dpbSize).status = dpbPictureStatus_e.NON_EXISTING
            deref(dpb.buffer + dpb.dpbSize).frameNum = unUsedShortTermFrameNum
            deref(dpb.buffer + dpb.dpbSize).picNum = int(unUsedShortTermFrameNum)
            deref(dpb.buffer + dpb.dpbSize).picOrderCnt = 0
            deref(dpb.buffer + dpb.dpbSize).toBeDisplayed = uint(HANTRO_FALSE)
            dpb.fullness++
            dpb.numRefFrames++
            // sort the buffer
            h264_file_all__ShellSort(dpb.buffer, dpb.dpbSize + uint(1))
            unUsedShortTermFrameNum = (unUsedShortTermFrameNum + uint(1)) % dpb.maxFrameNum
            if (!(unUsedShortTermFrameNum != frameNum)) {
                break
            }
        }
        // pictures placed in output buffer -> check that 'data' in
        // buffer position dpbSize is not in the output buffer (this will be
        // "allocated" by h264bsdAllocateDpbImage). If it is -> exchange data
        // pointer with the one stored in the beginning
        if (dpb.numOut != 0) {
            var i : uint
            {
                i = uint(0)
                while (i < dpb.numOut) {
                    if (intptr(deref(dpb.outBuf + i).data) == intptr(deref(dpb.buffer + dpb.dpbSize).data)) {
                        // find buffer position containing data pointer stored in
                        // tmp
                        {
                            i = uint(0)
                            while (i < dpb.dpbSize) {
                                if (intptr(deref(dpb.buffer + i).data) == intptr(tmp)) {
                                    deref(dpb.buffer + i).data = deref(dpb.buffer + dpb.dpbSize).data
                                    deref(dpb.buffer + dpb.dpbSize).data = tmp
                                    break
                                }
                                i++
                            }
                        }
                        break
                    }
                    i++
                }
            }
        }
    } elif (isRefPic != 0 && frameNum == dpb.prevRefFrameNum) {
        // frameNum for reference pictures shall not be the same as for previous
        // reference picture, otherwise accesses to pictures in the buffer cannot
        // be solved unambiguously
        return uint(HANTRO_NOK)
    }
    // save current frame_num in prevRefFrameNum. For non-reference frame
    // prevFrameNum is set to frame number of last non-existing frame above
    if (isRefPic != 0) {
        dpb.prevRefFrameNum = frameNum
    } elif (frameNum != dpb.prevRefFrameNum) {
        dpb.prevRefFrameNum = (frameNum + dpb.maxFrameNum - uint(1)) % dpb.maxFrameNum
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__FindSmallestPicOrderCnt(var dpb : dpbStorage_t?) : dpbPicture_t? {
