        r[1] += int(deref(pData + uint(48) * width))
        pData = pData + uint(64) * width
        r[2] = int(deref(pData + 0))
        r[2] += int(deref(pData + uint(16) * width))
        r[2] += int(deref(pData + uint(32) * width))
        r[2] += int(deref(pData + uint(48) * width))
        pData = pData + uint(64) * width
        r[3] = int(deref(pData + 0))
        r[3] += int(deref(pData + uint(16) * width))
        r[3] += int(deref(pData + uint(32) * width))
        r[3] += int(deref(pData + uint(48) * width))
        j++
        ver++
        firstPhase[0] += r[0] + r[1] + r[2] + r[3]
        firstPhase[4] += r[0] + r[1] - r[2] - r[3]
    }
    // at least one properly decoded neighbour available
    // lint -esym(644,l,r,a,b) variable initialized above
    if (!(hor != 0) && L != 0 && R != 0) {
        firstPhase[1] = l[0] + l[1] + l[2] + l[3] - r[0] - r[1] - r[2] - r[3] >> 5
    } elif (hor != 0) {
        firstPhase[1] >>= int(uint(3) + hor)
    }
    if (!(ver != 0) && A != 0 && B != 0) {
        firstPhase[4] = a[0] + a[1] + a[2] + a[3] - b[0] - b[1] - b[2] - b[3] >> 5
    } elif (ver != 0) {
        firstPhase[4] >>= int(uint(3) + ver)
    }
    let _cond = j
    if (_cond == 1u) {
        firstPhase[0] >>= 4
    } elif (_cond == 2u) {
        firstPhase[0] >>= 5
    } elif (_cond == 3u) {
        // approximate (firstPhase[0]*4/3)>>6
        firstPhase[0] = 21 * firstPhase[0] >> 10
    } else {
        // 4
        firstPhase[0] >>= 6
    }
    h264_file_all__Transform(addr(firstPhase[0]))
    {
        i = uint(0)
        pData = addr(data[0])
        pTmp = addr(firstPhase[0])
        while (i < uint(256)) {
            tmp = deref(pTmp + ((i & uint(15)) >> 2u))
            // lint -e734 CLIP1 macro results in value that fits into 8 bits
            var _t32 = pData
            pData = pData + 1
            deref(_t32) = uint8(tmp < 0 ? 0 : (tmp > 255 ? 255 : tmp))
            // lint +e734
            i++
            if (!((i & uint(63)) != 0)) {
                pTmp = pTmp + 4
            }
        }
    }
    // chroma components
    mbPos = currImage.data + width * height * uint(256) + row * uint(8) * width * uint(8) + col * uint(8)
    for (comp in urange(uint(2))) {
        memset1(reinterpret<void?>(addr(firstPhase[0])), 0, uint64(typeinfo sizeof(type<int[16]>)))
        // counter for number of neighbours used
        j = uint(0)
        ver = uint(0)
        hor = ver
        if (A != 0) {
            pData = mbPos - width * uint(8)
            var _t33 = pData
            pData = pData + 1
            a[0] = int(deref(_t33))
            var _t34 = pData
            pData = pData + 1
            a[0] += int(deref(_t34))
            var _t35 = pData
            pData = pData + 1
            a[1] = int(deref(_t35))
            var _t36 = pData
            pData = pData + 1
            a[1] += int(deref(_t36))
            var _t37 = pData
            pData = pData + 1
            a[2] = int(deref(_t37))
            var _t38 = pData
            pData = pData + 1
            a[2] += int(deref(_t38))
            var _t39 = pData
            pData = pData + 1
            a[3] = int(deref(_t39))
            var _t40 = pData
            pData = pData + 1
            a[3] += int(deref(_t40))
            j++
            hor++
            firstPhase[0] += a[0] + a[1] + a[2] + a[3]
            firstPhase[1] += a[0] + a[1] - a[2] - a[3]
        }
        if (B != 0) {
            pData = mbPos + uint(8) * width * uint(8)
            var _t41 = pData
            pData = pData + 1
            b[0] = int(deref(_t41))
            var _t42 = pData
            pData = pData + 1
            b[0] += int(deref(_t42))
            var _t43 = pData
            pData = pData + 1
            b[1] = int(deref(_t43))
            var _t44 = pData
            pData = pData + 1
            b[1] += int(deref(_t44))
            var _t45 = pData
            pData = pData + 1
            b[2] = int(deref(_t45))
            var _t46 = pData
            pData = pData + 1
            b[2] += int(deref(_t46))
            var _t47 = pData
            pData = pData + 1
            b[3] = int(deref(_t47))
            var _t48 = pData
            pData = pData + 1
            b[3] += int(deref(_t48))
            j++
            hor++
            firstPhase[0] += b[0] + b[1] + b[2] + b[3]
            firstPhase[1] += b[0] + b[1] - b[2] - b[3]
        }
        if (L != 0) {
            pData = mbPos - 1
            l[0] = int(deref(pData + 0))
            l[0] += int(deref(pData + uint(8) * width))
            pData = pData + uint(16) * width
            l[1] = int(deref(pData + 0))
            l[1] += int(deref(pData + uint(8) * width))
            pData = pData + uint(16) * width
            l[2] = int(deref(pData + 0))
            l[2] += int(deref(pData + uint(8) * width))
            pData = pData + uint(16) * width
            l[3] = int(deref(pData + 0))
            l[3] += int(deref(pData + uint(8) * width))
            j++
            ver++
            firstPhase[0] += l[0] + l[1] + l[2] + l[3]
            firstPhase[4] += l[0] + l[1] - l[2] - l[3]
        }
        if (R != 0) {
            pData = mbPos + 8
            r[0] = int(deref(pData + 0))
            r[0] += int(deref(pData + uint(8) * width))
            pData = pData + uint(16) * width
            r[1] = int(deref(pData + 0))
            r[1] += int(deref(pData + uint(8) * width))
            pData = pData + uint(16) * width
            r[2] = int(deref(pData + 0))
            r[2] += int(deref(pData + uint(8) * width))
            pData = pData + uint(16) * width
            r[3] = int(deref(pData + 0))
            r[3] += int(deref(pData + uint(8) * width))
            j++
            ver++
            firstPhase[0] += r[0] + r[1] + r[2] + r[3]
            firstPhase[4] += r[0] + r[1] - r[2] - r[3]
        }
        if (!(hor != 0) && L != 0 && R != 0) {
            firstPhase[1] = l[0] + l[1] + l[2] + l[3] - r[0] - r[1] - r[2] - r[3] >> 4
        } elif (hor != 0) {
            firstPhase[1] >>= int(uint(2) + hor)
        }
        if (!(ver != 0) && A != 0 && B != 0) {
            firstPhase[4] = a[0] + a[1] + a[2] + a[3] - b[0] - b[1] - b[2] - b[3] >> 4
        } elif (ver != 0) {
            firstPhase[4] >>= int(uint(2) + ver)
        }
        let _cond2 = j
        if (_cond2 == 1u) {
            firstPhase[0] >>= 3
        } elif (_cond2 == 2u) {
            firstPhase[0] >>= 4
        } elif (_cond2 == 3u) {
            // approximate (firstPhase[0]*4/3)>>5
            firstPhase[0] = 21 * firstPhase[0] >> 9
        } else {
            // 4
            firstPhase[0] >>= 5
        }
        h264_file_all__Transform(addr(firstPhase[0]))
        pData = addr(data[0]) + 256 + comp * uint(64)
        {
            i = uint(0)
            pTmp = addr(firstPhase[0])
            while (i < uint(64)) {
                tmp = deref(pTmp + ((i & uint(7)) >> 1u))
                // lint -e734 CLIP1 macro results in value that fits into 8 bits
                var _t49 = pData
                pData = pData + 1
                deref(_t49) = uint8(tmp < 0 ? 0 : (tmp > 255 ? 255 : tmp))
                // lint +e734
                i++
                if (!((i & uint(15)) != 0)) {
                    pTmp = pTmp + 4
                }
            }
        }
        // increment pointers for cr
        mbPos = mbPos + width * height * uint(64)
    }
    h264bsdWriteMacroblock(currImage, addr(data[0]))
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Transform(var data : int?) {
    var col : uint
    var tmp0 : int
    var tmp1 : int
    if (!(deref(data + 1) != 0) && !(deref(data + 4) != 0)) {
        deref(data + 15) = deref(data + 0)
        deref(data + 14) = deref(data + 15)
        deref(data + 13) = deref(data + 14)
        deref(data + 12) = deref(data + 13)
        deref(data + 11) = deref(data + 12)
        deref(data + 10) = deref(data + 11)
        deref(data + 9) = deref(data + 10)
        deref(data + 8) = deref(data + 9)
        deref(data + 7) = deref(data + 8)
        deref(data + 6) = deref(data + 7)
        deref(data + 5) = deref(data + 6)
        deref(data + 4) = deref(data + 5)
        deref(data + 3) = deref(data + 4)
        deref(data + 2) = deref(data + 3)
        deref(data + 1) = deref(data + 2)
        return
    }
    // first horizontal transform for rows 0 and 1
    tmp0 = deref(data + 0)
    tmp1 = deref(data + 1)
    deref(data + 0) = tmp0 + tmp1
    deref(data + 1) = tmp0 + (tmp1 >> 1)
    deref(data + 2) = tmp0 - (tmp1 >> 1)
    deref(data + 3) = tmp0 - tmp1
    tmp0 = deref(data + 4)
    deref(data + 5) = tmp0
    deref(data + 6) = tmp0
    deref(data + 7) = tmp0
    // then vertical transform
    {
        col = uint(4)
        while (true) {
            let _t0 = col
            col--
            if (!(_t0 != 0)) {
                break
            }
            tmp0 = deref(data + 0)
            tmp1 = deref(data + 4)
            deref(data + 0) = tmp0 + tmp1
            deref(data + 4) = tmp0 + (tmp1 >> 1)
            deref(data + 8) = tmp0 - (tmp1 >> 1)
            deref(data + 12) = tmp0 - tmp1
            data = data + 1
        }
    }
}

// ------------------------------------------------------------------------------
// Function: IsSliceBoundaryOnLeft
// Functional description:
// Function to determine if there is a slice boundary on the left side
// of a macroblock.
// ------------------------------------------------------------------------------
def private h264_file_all__IsSliceBoundaryOnLeft(var mb : mbStorage?) : uint {
    // Variables
    // Code
    if (mb.sliceId != mb.mbA.sliceId) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

// ------------------------------------------------------------------------------
// Function: IsSliceBoundaryOnTop
// Functional description:
// Function to determine if there is a slice boundary above the
// current macroblock.
// ------------------------------------------------------------------------------
def private h264_file_all__IsSliceBoundaryOnTop(var mb : mbStorage?) : uint {
    // Variables
    // Code
    if (mb.sliceId != mb.mbB.sliceId) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

// ------------------------------------------------------------------------------
// Function: GetMbFilteringFlags
// Functional description:
// Function to determine which edges of a macroblock has to be
// filtered. Output is a bit-wise OR of FILTER_LEFT_EDGE,
// FILTER_TOP_EDGE and FILTER_INNER_EDGE, depending on which edges
// shall be filtered.
// ------------------------------------------------------------------------------
def private h264_file_all__GetMbFilteringFlags(var mb : mbStorage?) : uint {
    // Variables
    var flags : uint = uint(0)
    // Code
    // nothing will be filtered if disableDeblockingFilterIdc == 1
    if (mb.disableDeblockingFilterIdc != uint(1)) {
        flags |= uint(FILTER_INNER_EDGE)
        // filterLeftMbEdgeFlag, left mb is MB_A
        if (mb.mbA != null && (mb.disableDeblockingFilterIdc != uint(2) || !(h264_file_all__IsSliceBoundaryOnLeft(mb) != 0))) {
            flags |= uint(FILTER_LEFT_EDGE)
        }
        // filterTopMbEdgeFlag
        if (mb.mbB != null && (mb.disableDeblockingFilterIdc != uint(2) || !(h264_file_all__IsSliceBoundaryOnTop(mb) != 0))) {
            flags |= uint(FILTER_TOP_EDGE)
        }
    }
    return flags
}

// ------------------------------------------------------------------------------
// Function: InnerBoundaryStrength
// Functional description:
// Function to calculate boundary strength value bs for an inner
// edge of a macroblock. Macroblock type is checked before this is
// called -> no intra mb condition here.
// ------------------------------------------------------------------------------
def private h264_file_all__InnerBoundaryStrength(var mb1 : mbStorage?; ind1 : uint; ind2 : uint) : uint {
    var tmp1 : int
    var tmp2 : int
    var mv1 : int
    var mv2 : int
    var mv3 : int
    var mv4 : int
    tmp1 = int(mb1.totalCoeff[ind1])
    tmp2 = int(mb1.totalCoeff[ind2])
    mv1 = int(mb1.mv[ind1].hor)
    mv2 = int(mb1.mv[ind2].hor)
    mv3 = int(mb1.mv[ind1].ver)
    mv4 = int(mb1.mv[ind2].ver)
    if (tmp1 != 0 || tmp2 != 0) {
        return uint(2)
    } elif (uint(mv1 - mv2 < 0 ? -(mv1 - mv2) : mv1 - mv2) >= uint(4) || uint(mv3 - mv4 < 0 ? -(mv3 - mv4) : mv3 - mv4) >= uint(4) || intptr(mb1.refAddr[ind1 >> 2u]) != intptr(mb1.refAddr[ind2 >> 2u])) {
        return uint(1)
    } else {
        return uint(0)
    }
}

// ------------------------------------------------------------------------------
// Function: InnerBoundaryStrength2
// Functional description:
// Function to calculate boundary strength value bs for an inner
// edge of a macroblock. The function is the same as
// InnerBoundaryStrength but without checking totalCoeff.
// ------------------------------------------------------------------------------
def InnerBoundaryStrength2(var mb1 : mbStorage?; ind1 : uint; ind2 : uint) : uint {
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    tmp1 = int(mb1.mv[ind1].hor)
    tmp2 = int(mb1.mv[ind2].hor)
    tmp3 = int(mb1.mv[ind1].ver)
    tmp4 = int(mb1.mv[ind2].ver)
    if (uint(tmp1 - tmp2 < 0 ? -(tmp1 - tmp2) : tmp1 - tmp2) >= uint(4) || uint(tmp3 - tmp4 < 0 ? -(tmp3 - tmp4) : tmp3 - tmp4) >= uint(4) || intptr(mb1.refAddr[ind1 >> 2u]) != intptr(mb1.refAddr[ind2 >> 2u])) {
        return uint(1)
    } else {
        return uint(0)
    }
}

// ------------------------------------------------------------------------------
// Function: EdgeBoundaryStrength
// Functional description:
// Function to calculate boundary strength value bs for left- or
// top-most edge of a macroblock. Macroblock types are checked
// before this is called -> no intra mb conditions here.
// ------------------------------------------------------------------------------
def private h264_file_all__EdgeBoundaryStrength(var mb1 : mbStorage?; var mb2 : mbStorage?; ind1 : uint; ind2 : uint) : uint {
    if (mb1.totalCoeff[ind1] != 0 || mb2.totalCoeff[ind2] != 0) {
        return uint(2)
    } elif (intptr(mb1.refAddr[ind1 >> 2u]) != intptr(mb2.refAddr[ind2 >> 2u]) || uint(int(mb1.mv[ind1].hor) - int(mb2.mv[ind2].hor) < 0 ? -(int(mb1.mv[ind1].hor) - int(mb2.mv[ind2].hor)) : int(mb1.mv[ind1].hor) - int(mb2.mv[ind2].hor)) >= uint(4) || uint(int(mb1.mv[ind1].ver) - int(mb2.mv[ind2].ver) < 0 ? -(int(mb1.mv[ind1].ver) - int(mb2.mv[ind2].ver)) : int(mb1.mv[ind1].ver) - int(mb2.mv[ind2].ver)) >= uint(4)) {
        return uint(1)
    } else {
        return uint(0)
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdFilterPicture
// Functional description:
// Perform deblocking filtering for a picture. Filter does not copy
// the original picture anywhere but filtering is performed directly
// on the original image. Parameters controlling the filtering process
// are computed based on information in macroblock structures of the
// filtered macroblock, macroblock above and macroblock on the left of
// the filtered one.
// Inputs:
// image pointer to image to be filtered
// mb pointer to macroblock data structure of the top-left
// macroblock of the picture
// Outputs:
// image filtered image stored here
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdFilterPicture(var image : image_t?; var mb : mbStorage?) {
    // Variables
    var flags : uint
    var picSizeInMbs : uint
    var mbRow : uint
    var mbCol : uint
    var picWidthInMbs : uint
    var data : uint8?
    var pMb : mbStorage?
    var bS : bS_t[16]
    var thresholds : edgeThreshold_t[3]
    // Code
    picWidthInMbs = image.width
    data = image.data
    picSizeInMbs = picWidthInMbs * image.height
    pMb = mb
    {
        mbRow = uint(0)
        mbCol = uint(0)
        while (mbRow < image.height) {
            flags = h264_file_all__GetMbFilteringFlags(pMb)
            if (flags != 0) {
                // GetBoundaryStrengths function returns non-zero value if any of
                // the bS values for the macroblock being processed was non-zero
                if (h264_file_all__GetBoundaryStrengths(pMb, addr(bS[0]), flags) != 0) {
                    // luma
                    h264_file_all__GetLumaEdgeThresholds(addr(thresholds[0]), pMb, flags)
                    data = image.data + mbRow * picWidthInMbs * uint(256) + mbCol * uint(16)
                    h264_file_all__FilterLuma(data, addr(bS[0]), addr(thresholds[0]), picWidthInMbs * uint(16))
                    // chroma
                    h264_file_all__GetChromaEdgeThresholds(addr(thresholds[0]), pMb, flags, pMb.chromaQpIndexOffset)
                    data = image.data + picSizeInMbs * uint(256) + mbRow * picWidthInMbs * uint(64) + mbCol * uint(8)
                    h264_file_all__FilterChroma(data, data + uint(64) * picSizeInMbs, addr(bS[0]), addr(thresholds[0]), picWidthInMbs * uint(8))
                }
            }
            mbCol++
            if (mbCol == picWidthInMbs) {
                mbCol = uint(0)
                mbRow++
            }
            pMb = pMb + 1
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterVerLumaEdge
// Functional description:
// Filter one vertical 4-pixel luma edge.
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterVerLumaEdge(var data : uint8?; bS : uint; var thresholds : edgeThreshold_t?; imageWidth : uint) {
    // Variables
    var delta : int
    var tc : int
    var tmp : int
    var i : uint
    var p0 : int
    var q0 : int
    var p1 : int
    var q1 : int
    var p2 : int
    var q2 : int
    var tmpFlag : uint
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    var alpha : uint = thresholds.alpha
    var beta : uint = thresholds.beta
    var val : int
    // Code
    if (bS < uint(4)) {
        tc = int(deref(thresholds.tc0 + (bS - uint(1))))
        tmp = tc
        {
            i = uint(4)
            while (i != 0) {
                p1 = int(deref(data + -2))
                p0 = int(deref(data + -1))
                q0 = int(deref(data + 0))
                q1 = int(deref(data + 1))
                if (uint(p0 - q0 < 0 ? -(p0 - q0) : p0 - q0) < alpha && uint(p1 - p0 < 0 ? -(p1 - p0) : p1 - p0) < beta && uint(q1 - q0 < 0 ? -(q1 - q0) : q1 - q0) < beta) {
                    p2 = int(deref(data + -3))
                    q2 = int(deref(data + 2))
                    if (uint(p2 - p0 < 0 ? -(p2 - p0) : p2 - p0) < beta) {
                        val = p2 + (p0 + q0 + 1 >> 1) - (p1 << 1) >> 1
                        deref(data + -2) = uint8(p1 + (val < -tc ? -tc : (val > tc ? tc : val)))
                        tmp++
                    }
                    if (uint(q2 - q0 < 0 ? -(q2 - q0) : q2 - q0) < beta) {
                        val = q2 + (p0 + q0 + 1 >> 1) - (q1 << 1) >> 1
                        deref(data + 1) = uint8(q1 + (val < -tc ? -tc : (val > tc ? tc : val)))
                        tmp++
                    }
                    val = (q0 - p0 << 2) + (p1 - q1) + 4 >> 3
                    delta = val < -tmp ? -tmp : (val > tmp ? tmp : val)
                    p0 = int(deref(clp + (p0 + delta)))
                    q0 = int(deref(clp + (q0 - delta)))
                    tmp = tc
                    deref(data + -1) = uint8(p0)
                    deref(data + 0) = uint8(q0)
                }
                i--
                data = data + imageWidth
            }
        }
    } else {
        // hashA += data[-2] + data[-1] + data[0] + data[1];
        {
            i = uint(4)
            while (i != 0) {
                p1 = int(deref(data + -2))
                p0 = int(deref(data + -1))
                q0 = int(deref(data + 0))
                q1 = int(deref(data + 1))
                if (uint(p0 - q0 < 0 ? -(p0 - q0) : p0 - q0) < alpha && uint(p1 - p0 < 0 ? -(p1 - p0) : p1 - p0) < beta && uint(q1 - q0 < 0 ? -(q1 - q0) : q1 - q0) < beta) {
                    tmpFlag = uint(uint(p0 - q0 < 0 ? -(p0 - q0) : p0 - q0) < (alpha >> 2u) + uint(2) ? HANTRO_TRUE : HANTRO_FALSE)
                    p2 = int(deref(data + -3))
                    q2 = int(deref(data + 2))
                    if (tmpFlag != 0 && uint(p2 - p0 < 0 ? -(p2 - p0) : p2 - p0) < beta) {
                        tmp = p1 + p0 + q0
                        deref(data + -1) = uint8(p2 + 2 * tmp + q1 + 4 >> 3)
                        deref(data + -2) = uint8(p2 + tmp + 2 >> 2)
                        deref(data + -3) = uint8(2 * int(deref(data + -4)) + 3 * p2 + tmp + 4 >> 3)
                    } else {
                        deref(data + -1) = uint8(2 * p1 + p0 + q1 + 2 >> 2)
                    }
                    if (tmpFlag != 0 && uint(q2 - q0 < 0 ? -(q2 - q0) : q2 - q0) < beta) {
                        tmp = p0 + q0 + q1
                        deref(data + 0) = uint8(p1 + 2 * tmp + q2 + 4 >> 3)
                        deref(data + 1) = uint8(tmp + q2 + 2 >> 2)
                        deref(data + 2) = uint8(2 * int(deref(data + 3)) + 3 * q2 + tmp + 4 >> 3)
                    } else {
                        deref(data + 0) = uint8(2 * q1 + q0 + p1 + 2 >> 2)
                    }
                }
                i--
                data = data + imageWidth
            }
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterHorLumaEdge
// Functional description:
// Filter one horizontal 4-pixel luma edge
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterHorLumaEdge(var data : uint8?; bS : uint; var thresholds : edgeThreshold_t?; imageWidth : int) {
    // Variables
    var delta : int
    var tc : int
    var tmp : int
    var i : uint
    var p0 : uint8
    var q0 : uint8
    var p1 : uint8
    var q1 : uint8
    var p2 : uint8
    var q2 : uint8
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    var val : int
    // Code
    // if (sample ++ % (1024 * 128) == 0) {
    // printf("Hash A: %d, Hash B: %d\n", hashA, hashB);
    // }
    tc = int(deref(thresholds.tc0 + (bS - uint(1))))
    tmp = tc
    {
        i = uint(4)
        while (i != 0) {
            p1 = deref(data + -imageWidth * 2)
            p0 = deref(data + -imageWidth)
            q0 = deref(data + 0)
            q1 = deref(data + imageWidth)
            if (uint(int(p0) - int(q0) < 0 ? -(int(p0) - int(q0)) : int(p0) - int(q0)) < thresholds.alpha && uint(int(p1) - int(p0) < 0 ? -(int(p1) - int(p0)) : int(p1) - int(p0)) < thresholds.beta && uint(int(q1) - int(q0) < 0 ? -(int(q1) - int(q0)) : int(q1) - int(q0)) < thresholds.beta) {
                p2 = deref(data + -imageWidth * 3)
                if (uint(int(p2) - int(p0) < 0 ? -(int(p2) - int(p0)) : int(p2) - int(p0)) < thresholds.beta) {
                    val = int(p2) + (int(p0) + int(q0) + 1 >> 1) - (int(p1) << 1) >> 1
                    deref(data + -imageWidth * 2) = uint8(int(p1) + (val < -tc ? -tc : (val > tc ? tc : val)))
                    tmp++
                }
                q2 = deref(data + imageWidth * 2)
                if (uint(int(q2) - int(q0) < 0 ? -(int(q2) - int(q0)) : int(q2) - int(q0)) < thresholds.beta) {
                    val = int(q2) + (int(p0) + int(q0) + 1 >> 1) - (int(q1) << 1) >> 1
                    deref(data + imageWidth) = uint8(int(q1) + (val < -tc ? -tc : (val > tc ? tc : val)))
                    tmp++
                }
                val = (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3
                delta = val < -tmp ? -tmp : (val > tmp ? tmp : val)
                p0 = deref(clp + (int(p0) + delta))
                q0 = deref(clp + (int(q0) - delta))
                tmp = tc
                deref(data + -imageWidth) = p0
                deref(data + 0) = q0
            }
            i--
            data = data + 1
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterHorLuma
// Functional description:
// Filter all four successive horizontal 4-pixel luma edges. This can
// be done when bS is equal to all four edges.
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterHorLuma(var data : uint8?; bS : uint; var thresholds : edgeThreshold_t?; imageWidth : int) {
    // Variables
    var delta : int
    var tc : int
    var tmp : int
    var i : uint
    var p0 : int
    var q0 : int
    var p1 : int
    var q1 : int
    var p2 : int
    var q2 : int
    var tmpFlag : uint
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    var alpha : uint = thresholds.alpha
    var beta : uint = thresholds.beta
    var val : int
    // Code
    // if (sample ++ % (1024 * 64) == 0) {
    // printf("Hash A: %d, Hash B: %d\n", hashA, hashB);
    // }
    if (bS < uint(4)) {
        tc = int(deref(thresholds.tc0 + (bS - uint(1))))
        tmp = tc
        {
            i = uint(16)
            while (i != 0) {
                p1 = int(deref(data + -imageWidth * 2))
                p0 = int(deref(data + -imageWidth))
                q0 = int(deref(data + 0))
                q1 = int(deref(data + imageWidth))
                if (uint(p0 - q0 < 0 ? -(p0 - q0) : p0 - q0) < alpha && uint(p1 - p0 < 0 ? -(p1 - p0) : p1 - p0) < beta && uint(q1 - q0 < 0 ? -(q1 - q0) : q1 - q0) < beta) {
                    p2 = int(deref(data + -imageWidth * 3))
                    if (uint(p2 - p0 < 0 ? -(p2 - p0) : p2 - p0) < beta) {
                        val = p2 + (p0 + q0 + 1 >> 1) - (p1 << 1) >> 1
                        deref(data + -imageWidth * 2) = uint8(p1 + (val < -tc ? -tc : (val > tc ? tc : val)))
                        tmp++
                    }
                    q2 = int(deref(data + imageWidth * 2))
                    if (uint(q2 - q0 < 0 ? -(q2 - q0) : q2 - q0) < beta) {
                        val = q2 + (p0 + q0 + 1 >> 1) - (q1 << 1) >> 1
                        deref(data + imageWidth) = uint8(q1 + (val < -tc ? -tc : (val > tc ? tc : val)))
                        tmp++
                    }
                    val = (q0 - p0 << 2) + (p1 - q1) + 4 >> 3
                    delta = val < -tmp ? -tmp : (val > tmp ? tmp : val)
                    p0 = int(deref(clp + (p0 + delta)))
                    q0 = int(deref(clp + (q0 - delta)))
                    tmp = tc
                    deref(data + -imageWidth) = uint8(p0)
                    deref(data + 0) = uint8(q0)
                }
                i--
                data = data + 1
            }
        }
    } else {
        {
            i = uint(16)
            while (i != 0) {
                p1 = int(deref(data + -imageWidth * 2))
                p0 = int(deref(data + -imageWidth))
                q0 = int(deref(data + 0))
                q1 = int(deref(data + imageWidth))
                if (uint(p0 - q0 < 0 ? -(p0 - q0) : p0 - q0) < alpha && uint(p1 - p0 < 0 ? -(p1 - p0) : p1 - p0) < beta && uint(q1 - q0 < 0 ? -(q1 - q0) : q1 - q0) < beta) {
                    tmpFlag = uint(uint(p0 - q0 < 0 ? -(p0 - q0) : p0 - q0) < (alpha >> 2u) + uint(2) ? HANTRO_TRUE : HANTRO_FALSE)
                    p2 = int(deref(data + -imageWidth * 3))
                    q2 = int(deref(data + imageWidth * 2))
                    if (tmpFlag != 0 && uint(p2 - p0 < 0 ? -(p2 - p0) : p2 - p0) < beta) {
                        tmp = p1 + p0 + q0
                        deref(data + -imageWidth) = uint8(p2 + 2 * tmp + q1 + 4 >> 3)
                        deref(data + -imageWidth * 2) = uint8(p2 + tmp + 2 >> 2)
                        deref(data + -imageWidth * 3) = uint8(2 * int(deref(data + -imageWidth * 4)) + 3 * p2 + tmp + 4 >> 3)
                    } else {
                        deref(data + -imageWidth) = uint8(2 * p1 + p0 + q1 + 2 >> 2)
                    }
                    if (tmpFlag != 0 && uint(q2 - q0 < 0 ? -(q2 - q0) : q2 - q0) < beta) {
                        tmp = p0 + q0 + q1
                        deref(data + 0) = uint8(p1 + 2 * tmp + q2 + 4 >> 3)
                        deref(data + imageWidth) = uint8(tmp + q2 + 2 >> 2)
                        deref(data + imageWidth * 2) = uint8(2 * int(deref(data + imageWidth * 3)) + 3 * q2 + tmp + 4 >> 3)
                    } else {
                        deref(data + 0) = uint8(2 * q1 + q0 + p1 + 2 >> 2)
                    }
                }
                i--
                data = data + 1
            }
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterVerChromaEdge
// Functional description:
// Filter one vertical 2-pixel chroma edge
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterVerChromaEdge(var data : uint8?; bS : uint; var thresholds : edgeThreshold_t?; width : uint) {
    // Variables
    var delta : int
    var tc : int
    var p0 : uint8
    var q0 : uint8
    var p1 : uint8
    var q1 : uint8
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    p1 = deref(data + -2)
    p0 = deref(data + -1)
    q0 = deref(data + 0)
    q1 = deref(data + 1)
    if (uint(int(p0) - int(q0) < 0 ? -(int(p0) - int(q0)) : int(p0) - int(q0)) < thresholds.alpha && uint(int(p1) - int(p0) < 0 ? -(int(p1) - int(p0)) : int(p1) - int(p0)) < thresholds.beta && uint(int(q1) - int(q0) < 0 ? -(int(q1) - int(q0)) : int(q1) - int(q0)) < thresholds.beta) {
        if (bS < uint(4)) {
            tc = int(deref(thresholds.tc0 + (bS - uint(1)))) + 1
            delta = (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 < -tc ? -tc : ((int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 > tc ? tc : (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3)
            p0 = deref(clp + (int(p0) + delta))
            q0 = deref(clp + (int(q0) - delta))
            deref(data + -1) = p0
            deref(data + 0) = q0
        } else {
            deref(data + -1) = uint8(2 * int(p1) + int(p0) + int(q1) + 2 >> 2)
            deref(data + 0) = uint8(2 * int(q1) + int(q0) + int(p1) + 2 >> 2)
        }
    }
    data = data + width
    p1 = deref(data + -2)
    p0 = deref(data + -1)
    q0 = deref(data + 0)
    q1 = deref(data + 1)
    if (uint(int(p0) - int(q0) < 0 ? -(int(p0) - int(q0)) : int(p0) - int(q0)) < thresholds.alpha && uint(int(p1) - int(p0) < 0 ? -(int(p1) - int(p0)) : int(p1) - int(p0)) < thresholds.beta && uint(int(q1) - int(q0) < 0 ? -(int(q1) - int(q0)) : int(q1) - int(q0)) < thresholds.beta) {
        if (bS < uint(4)) {
            tc = int(deref(thresholds.tc0 + (bS - uint(1)))) + 1
            delta = (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 < -tc ? -tc : ((int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 > tc ? tc : (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3)
            p0 = deref(clp + (int(p0) + delta))
            q0 = deref(clp + (int(q0) - delta))
            deref(data + -1) = p0
            deref(data + 0) = q0
        } else {
            deref(data + -1) = uint8(2 * int(p1) + int(p0) + int(q1) + 2 >> 2)
            deref(data + 0) = uint8(2 * int(q1) + int(q0) + int(p1) + 2 >> 2)
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterHorChromaEdge
// Functional description:
// Filter one horizontal 2-pixel chroma edge
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterHorChromaEdge(var data : uint8?; bS : uint; var thresholds : edgeThreshold_t?; width : int) {
    // Variables
    var delta : int
    var tc : int
    var i : uint
    var p0 : uint8
    var q0 : uint8
    var p1 : uint8
    var q1 : uint8
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    tc = int(deref(thresholds.tc0 + (bS - uint(1)))) + 1
    {
        i = uint(2)
        while (i != 0) {
            p1 = deref(data + -width * 2)
            p0 = deref(data + -width)
            q0 = deref(data + 0)
            q1 = deref(data + width)
            if (uint(int(p0) - int(q0) < 0 ? -(int(p0) - int(q0)) : int(p0) - int(q0)) < thresholds.alpha && uint(int(p1) - int(p0) < 0 ? -(int(p1) - int(p0)) : int(p1) - int(p0)) < thresholds.beta && uint(int(q1) - int(q0) < 0 ? -(int(q1) - int(q0)) : int(q1) - int(q0)) < thresholds.beta) {
                delta = (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 < -tc ? -tc : ((int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 > tc ? tc : (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3)
                p0 = deref(clp + (int(p0) + delta))
                q0 = deref(clp + (int(q0) - delta))
                deref(data + -width) = p0
                deref(data + 0) = q0
            }
            i--
            data = data + 1
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterHorChroma
// Functional description:
// Filter all four successive horizontal 2-pixel chroma edges. This
// can be done if bS is equal for all four edges.
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterHorChroma(var data : uint8?; bS : uint; var thresholds : edgeThreshold_t?; width : int) {
    // Variables
    var delta : int
    var tc : int
    var i : uint
    var p0 : uint8
    var q0 : uint8
    var p1 : uint8
    var q1 : uint8
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if (bS < uint(4)) {
        tc = int(deref(thresholds.tc0 + (bS - uint(1)))) + 1
        {
            i = uint(8)
            while (i != 0) {
                p1 = deref(data + -width * 2)
                p0 = deref(data + -width)
                q0 = deref(data + 0)
                q1 = deref(data + width)
                if (uint(int(p0) - int(q0) < 0 ? -(int(p0) - int(q0)) : int(p0) - int(q0)) < thresholds.alpha && uint(int(p1) - int(p0) < 0 ? -(int(p1) - int(p0)) : int(p1) - int(p0)) < thresholds.beta && uint(int(q1) - int(q0) < 0 ? -(int(q1) - int(q0)) : int(q1) - int(q0)) < thresholds.beta) {
                    delta = (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 < -tc ? -tc : ((int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3 > tc ? tc : (int(q0) - int(p0) << 2) + (int(p1) - int(q1)) + 4 >> 3)
                    p0 = deref(clp + (int(p0) + delta))
                    q0 = deref(clp + (int(q0) - delta))
                    deref(data + -width) = p0
                    deref(data + 0) = q0
                }
                i--
                data = data + 1
            }
        }
    } else {
        {
            i = uint(8)
            while (i != 0) {
                p1 = deref(data + -width * 2)
                p0 = deref(data + -width)
                q0 = deref(data + 0)
                q1 = deref(data + width)
                if (uint(int(p0) - int(q0) < 0 ? -(int(p0) - int(q0)) : int(p0) - int(q0)) < thresholds.alpha && uint(int(p1) - int(p0) < 0 ? -(int(p1) - int(p0)) : int(p1) - int(p0)) < thresholds.beta && uint(int(q1) - int(q0) < 0 ? -(int(q1) - int(q0)) : int(q1) - int(q0)) < thresholds.beta) {
                    deref(data + -width) = uint8(2 * int(p1) + int(p0) + int(q1) + 2 >> 2)
                    deref(data + 0) = uint8(2 * int(q1) + int(q0) + int(p1) + 2 >> 2)
                }
                i--
                data = data + 1
            }
        }
    }
}

[c_function]
def GetBoundaryStrengthsA(var mb : mbStorage?; var bS : bS_t?) {
    deref(bS + 4).top = uint(mb.totalCoeff[2] != 0 || mb.totalCoeff[0] != 0 ? 2 : 0)
    deref(bS + 5).top = uint(mb.totalCoeff[3] != 0 || mb.totalCoeff[1] != 0 ? 2 : 0)
    deref(bS + 6).top = uint(mb.totalCoeff[6] != 0 || mb.totalCoeff[4] != 0 ? 2 : 0)
    deref(bS + 7).top = uint(mb.totalCoeff[7] != 0 || mb.totalCoeff[5] != 0 ? 2 : 0)
    deref(bS + 8).top = uint(mb.totalCoeff[8] != 0 || mb.totalCoeff[2] != 0 ? 2 : 0)
    deref(bS + 9).top = uint(mb.totalCoeff[9] != 0 || mb.totalCoeff[3] != 0 ? 2 : 0)
    deref(bS + 10).top = uint(mb.totalCoeff[12] != 0 || mb.totalCoeff[6] != 0 ? 2 : 0)
    deref(bS + 11).top = uint(mb.totalCoeff[13] != 0 || mb.totalCoeff[7] != 0 ? 2 : 0)
    deref(bS + 12).top = uint(mb.totalCoeff[10] != 0 || mb.totalCoeff[8] != 0 ? 2 : 0)
    deref(bS + 13).top = uint(mb.totalCoeff[11] != 0 || mb.totalCoeff[9] != 0 ? 2 : 0)
    deref(bS + 14).top = uint(mb.totalCoeff[14] != 0 || mb.totalCoeff[12] != 0 ? 2 : 0)
    deref(bS + 15).top = uint(mb.totalCoeff[15] != 0 || mb.totalCoeff[13] != 0 ? 2 : 0)
    deref(bS + 1).left = uint(mb.totalCoeff[1] != 0 || mb.totalCoeff[0] != 0 ? 2 : 0)
    deref(bS + 2).left = uint(mb.totalCoeff[4] != 0 || mb.totalCoeff[1] != 0 ? 2 : 0)
    deref(bS + 3).left = uint(mb.totalCoeff[5] != 0 || mb.totalCoeff[4] != 0 ? 2 : 0)
    deref(bS + 5).left = uint(mb.totalCoeff[3] != 0 || mb.totalCoeff[2] != 0 ? 2 : 0)
    deref(bS + 6).left = uint(mb.totalCoeff[6] != 0 || mb.totalCoeff[3] != 0 ? 2 : 0)
    deref(bS + 7).left = uint(mb.totalCoeff[7] != 0 || mb.totalCoeff[6] != 0 ? 2 : 0)
    deref(bS + 9).left = uint(mb.totalCoeff[9] != 0 || mb.totalCoeff[8] != 0 ? 2 : 0)
    deref(bS + 10).left = uint(mb.totalCoeff[12] != 0 || mb.totalCoeff[9] != 0 ? 2 : 0)
    deref(bS + 11).left = uint(mb.totalCoeff[13] != 0 || mb.totalCoeff[12] != 0 ? 2 : 0)
    deref(bS + 13).left = uint(mb.totalCoeff[11] != 0 || mb.totalCoeff[10] != 0 ? 2 : 0)
    deref(bS + 14).left = uint(mb.totalCoeff[14] != 0 || mb.totalCoeff[11] != 0 ? 2 : 0)
    deref(bS + 15).left = uint(mb.totalCoeff[15] != 0 || mb.totalCoeff[14] != 0 ? 2 : 0)
}

// ------------------------------------------------------------------------------
// Function: GetBoundaryStrengths
// Functional description:
// Function to calculate boundary strengths for all edges of a
// macroblock. Function returns HANTRO_TRUE if any of the bS values for
// the macroblock had non-zero value, HANTRO_FALSE otherwise.
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__GetBoundaryStrengths(var mb : mbStorage?; var bS : bS_t?; flags : uint) : uint {
    // Variables
    // this flag is set HANTRO_TRUE as soon as any boundary strength value is
    // non-zero
    var nonZeroBs : uint = uint(HANTRO_FALSE)
    // Code
    // if (sample ++ % (1024 * 128) == 0) {
    // printf("Hash A: %d, Hash B: %d, Hash C: %d, Hash D: %d\n", hashA, hashB, hashC, hashD);
    // }
    // top edges
    if ((flags & uint(FILTER_TOP_EDGE)) != 0) {
        if (uint(int(mb.mbType)) > uint(5) || uint(int(mb.mbB.mbType)) > uint(5)) {
            deref(bS + 3).top = uint(4)
            deref(bS + 2).top = deref(bS + 3).top
            deref(bS + 1).top = deref(bS + 2).top
            deref(bS + 0).top = deref(bS + 1).top
            nonZeroBs = uint(HANTRO_TRUE)
        } else {
            deref(bS + 0).top = h264_file_all__EdgeBoundaryStrength(mb, mb.mbB, uint(0), uint(10))
            deref(bS + 1).top = h264_file_all__EdgeBoundaryStrength(mb, mb.mbB, uint(1), uint(11))
            deref(bS + 2).top = h264_file_all__EdgeBoundaryStrength(mb, mb.mbB, uint(4), uint(14))
            deref(bS + 3).top = h264_file_all__EdgeBoundaryStrength(mb, mb.mbB, uint(5), uint(15))
            if (deref(bS + 0).top != 0 || deref(bS + 1).top != 0 || deref(bS + 2).top != 0 || deref(bS + 3).top != 0) {
                nonZeroBs = uint(HANTRO_TRUE)
            }
        }
    } else {
        deref(bS + 3).top = uint(0)
        deref(bS + 2).top = deref(bS + 3).top
        deref(bS + 1).top = deref(bS + 2).top
        deref(bS + 0).top = deref(bS + 1).top
    }
    // left edges
    if ((flags & uint(FILTER_LEFT_EDGE)) != 0) {
        if (uint(int(mb.mbType)) > uint(5) || uint(int(mb.mbA.mbType)) > uint(5)) {
            deref(bS + 12).left = uint(4)
            deref(bS + 8).left = deref(bS + 12).left
            deref(bS + 4).left = deref(bS + 8).left
            deref(bS + 0).left = deref(bS + 4).left
            nonZeroBs = uint(HANTRO_TRUE)
        } else {
            deref(bS + 0).left = h264_file_all__EdgeBoundaryStrength(mb, mb.mbA, uint(0), uint(5))
            deref(bS + 4).left = h264_file_all__EdgeBoundaryStrength(mb, mb.mbA, uint(2), uint(7))
            deref(bS + 8).left = h264_file_all__EdgeBoundaryStrength(mb, mb.mbA, uint(8), uint(13))
            deref(bS + 12).left = h264_file_all__EdgeBoundaryStrength(mb, mb.mbA, uint(10), uint(15))
            if (!(nonZeroBs != 0) && (deref(bS + 0).left != 0 || deref(bS + 4).left != 0 || deref(bS + 8).left != 0 || deref(bS + 12).left != 0)) {
                nonZeroBs = uint(HANTRO_TRUE)
            }
        }
    } else {
        deref(bS + 12).left = uint(0)
        deref(bS + 8).left = deref(bS + 12).left
        deref(bS + 4).left = deref(bS + 8).left
        deref(bS + 0).left = deref(bS + 4).left
    }
    // inner edges
    if (uint(int(mb.mbType)) > uint(5)) {
        deref(bS + 15).top = uint(3)
        deref(bS + 14).top = deref(bS + 15).top
        deref(bS + 13).top = deref(bS + 14).top
        deref(bS + 12).top = deref(bS + 13).top
        deref(bS + 11).top = deref(bS + 12).top
        deref(bS + 10).top = deref(bS + 11).top
        deref(bS + 9).top = deref(bS + 10).top
        deref(bS + 8).top = deref(bS + 9).top
        deref(bS + 7).top = deref(bS + 8).top
        deref(bS + 6).top = deref(bS + 7).top
        deref(bS + 5).top = deref(bS + 6).top
        deref(bS + 4).top = deref(bS + 5).top
        deref(bS + 15).left = uint(3)
        deref(bS + 14).left = deref(bS + 15).left
        deref(bS + 13).left = deref(bS + 14).left
        deref(bS + 11).left = deref(bS + 13).left
        deref(bS + 10).left = deref(bS + 11).left
        deref(bS + 9).left = deref(bS + 10).left
        deref(bS + 7).left = deref(bS + 9).left
        deref(bS + 6).left = deref(bS + 7).left
        deref(bS + 5).left = deref(bS + 6).left
        deref(bS + 3).left = deref(bS + 5).left
        deref(bS + 2).left = deref(bS + 3).left
        deref(bS + 1).left = deref(bS + 2).left
        nonZeroBs = uint(HANTRO_TRUE)
    } else {
        // 16x16 inter mb -> ref addresses or motion vectors cannot differ,
        // only check if either of the blocks contain coefficients
        if (h264bsdNumMbPart(mb.mbType) == uint(1)) {
            GetBoundaryStrengthsA(mb, bS)
        } elif (mb.mbType == mbType_e.P_L0_L0_16x8) {
            // 16x8 inter mb -> ref addresses and motion vectors can be different
            // only for the middle horizontal edge, for the other top edges it is
            // enough to check whether the blocks contain coefficients or not. The
            // same applies to all internal left edges.
            deref(bS + 4).top = uint(mb.totalCoeff[2] != 0 || mb.totalCoeff[0] != 0 ? 2 : 0)
            deref(bS + 5).top = uint(mb.totalCoeff[3] != 0 || mb.totalCoeff[1] != 0 ? 2 : 0)
            deref(bS + 6).top = uint(mb.totalCoeff[6] != 0 || mb.totalCoeff[4] != 0 ? 2 : 0)
            deref(bS + 7).top = uint(mb.totalCoeff[7] != 0 || mb.totalCoeff[5] != 0 ? 2 : 0)
            deref(bS + 12).top = uint(mb.totalCoeff[10] != 0 || mb.totalCoeff[8] != 0 ? 2 : 0)
            deref(bS + 13).top = uint(mb.totalCoeff[11] != 0 || mb.totalCoeff[9] != 0 ? 2 : 0)
            deref(bS + 14).top = uint(mb.totalCoeff[14] != 0 || mb.totalCoeff[12] != 0 ? 2 : 0)
            deref(bS + 15).top = uint(mb.totalCoeff[15] != 0 || mb.totalCoeff[13] != 0 ? 2 : 0)
            deref(bS + 8).top = h264_file_all__InnerBoundaryStrength(mb, uint(8), uint(2))
            deref(bS + 9).top = h264_file_all__InnerBoundaryStrength(mb, uint(9), uint(3))
            deref(bS + 10).top = h264_file_all__InnerBoundaryStrength(mb, uint(12), uint(6))
            deref(bS + 11).top = h264_file_all__InnerBoundaryStrength(mb, uint(13), uint(7))
            deref(bS + 1).left = uint(mb.totalCoeff[1] != 0 || mb.totalCoeff[0] != 0 ? 2 : 0)
            deref(bS + 2).left = uint(mb.totalCoeff[4] != 0 || mb.totalCoeff[1] != 0 ? 2 : 0)
            deref(bS + 3).left = uint(mb.totalCoeff[5] != 0 || mb.totalCoeff[4] != 0 ? 2 : 0)
            deref(bS + 5).left = uint(mb.totalCoeff[3] != 0 || mb.totalCoeff[2] != 0 ? 2 : 0)
            deref(bS + 6).left = uint(mb.totalCoeff[6] != 0 || mb.totalCoeff[3] != 0 ? 2 : 0)
            deref(bS + 7).left = uint(mb.totalCoeff[7] != 0 || mb.totalCoeff[6] != 0 ? 2 : 0)
            deref(bS + 9).left = uint(mb.totalCoeff[9] != 0 || mb.totalCoeff[8] != 0 ? 2 : 0)
            deref(bS + 10).left = uint(mb.totalCoeff[12] != 0 || mb.totalCoeff[9] != 0 ? 2 : 0)
            deref(bS + 11).left = uint(mb.totalCoeff[13] != 0 || mb.totalCoeff[12] != 0 ? 2 : 0)
            deref(bS + 13).left = uint(mb.totalCoeff[11] != 0 || mb.totalCoeff[10] != 0 ? 2 : 0)
            deref(bS + 14).left = uint(mb.totalCoeff[14] != 0 || mb.totalCoeff[11] != 0 ? 2 : 0)
            deref(bS + 15).left = uint(mb.totalCoeff[15] != 0 || mb.totalCoeff[14] != 0 ? 2 : 0)
        } elif (mb.mbType == mbType_e.P_L0_L0_8x16) {
            // 8x16 inter mb -> ref addresses and motion vectors can be different
            // only for the middle vertical edge, for the other left edges it is
            // enough to check whether the blocks contain coefficients or not. The
            // same applies to all internal top edges.
            deref(bS + 4).top = uint(mb.totalCoeff[2] != 0 || mb.totalCoeff[0] != 0 ? 2 : 0)
            deref(bS + 5).top = uint(mb.totalCoeff[3] != 0 || mb.totalCoeff[1] != 0 ? 2 : 0)
            deref(bS + 6).top = uint(mb.totalCoeff[6] != 0 || mb.totalCoeff[4] != 0 ? 2 : 0)
            deref(bS + 7).top = uint(mb.totalCoeff[7] != 0 || mb.totalCoeff[5] != 0 ? 2 : 0)
            deref(bS + 8).top = uint(mb.totalCoeff[8] != 0 || mb.totalCoeff[2] != 0 ? 2 : 0)
            deref(bS + 9).top = uint(mb.totalCoeff[9] != 0 || mb.totalCoeff[3] != 0 ? 2 : 0)
            deref(bS + 10).top = uint(mb.totalCoeff[12] != 0 || mb.totalCoeff[6] != 0 ? 2 : 0)
            deref(bS + 11).top = uint(mb.totalCoeff[13] != 0 || mb.totalCoeff[7] != 0 ? 2 : 0)
            deref(bS + 12).top = uint(mb.totalCoeff[10] != 0 || mb.totalCoeff[8] != 0 ? 2 : 0)
            deref(bS + 13).top = uint(mb.totalCoeff[11] != 0 || mb.totalCoeff[9] != 0 ? 2 : 0)
            deref(bS + 14).top = uint(mb.totalCoeff[14] != 0 || mb.totalCoeff[12] != 0 ? 2 : 0)
            deref(bS + 15).top = uint(mb.totalCoeff[15] != 0 || mb.totalCoeff[13] != 0 ? 2 : 0)
            deref(bS + 1).left = uint(mb.totalCoeff[1] != 0 || mb.totalCoeff[0] != 0 ? 2 : 0)
            deref(bS + 3).left = uint(mb.totalCoeff[5] != 0 || mb.totalCoeff[4] != 0 ? 2 : 0)
            deref(bS + 5).left = uint(mb.totalCoeff[3] != 0 || mb.totalCoeff[2] != 0 ? 2 : 0)
            deref(bS + 7).left = uint(mb.totalCoeff[7] != 0 || mb.totalCoeff[6] != 0 ? 2 : 0)
            deref(bS + 9).left = uint(mb.totalCoeff[9] != 0 || mb.totalCoeff[8] != 0 ? 2 : 0)
            deref(bS + 11).left = uint(mb.totalCoeff[13] != 0 || mb.totalCoeff[12] != 0 ? 2 : 0)
            deref(bS + 13).left = uint(mb.totalCoeff[11] != 0 || mb.totalCoeff[10] != 0 ? 2 : 0)
            deref(bS + 15).left = uint(mb.totalCoeff[15] != 0 || mb.totalCoeff[14] != 0 ? 2 : 0)
            deref(bS + 2).left = h264_file_all__InnerBoundaryStrength(mb, uint(4), uint(1))
            deref(bS + 6).left = h264_file_all__InnerBoundaryStrength(mb, uint(6), uint(3))
            deref(bS + 10).left = h264_file_all__InnerBoundaryStrength(mb, uint(12), uint(9))
            deref(bS + 14).left = h264_file_all__InnerBoundaryStrength(mb, uint(14), uint(11))
        } else {
            deref(bS + 4).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[4], h264_file_all__mb4x4Index[0])
            deref(bS + 5).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[5], h264_file_all__mb4x4Index[1])
            deref(bS + 6).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[6], h264_file_all__mb4x4Index[2])
            deref(bS + 7).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[7], h264_file_all__mb4x4Index[3])
            deref(bS + 8).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[8], h264_file_all__mb4x4Index[4])
            deref(bS + 9).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[9], h264_file_all__mb4x4Index[5])
            deref(bS + 10).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[10], h264_file_all__mb4x4Index[6])
            deref(bS + 11).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[11], h264_file_all__mb4x4Index[7])
            deref(bS + 12).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[12], h264_file_all__mb4x4Index[8])
            deref(bS + 13).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[13], h264_file_all__mb4x4Index[9])
            deref(bS + 14).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[14], h264_file_all__mb4x4Index[10])
            deref(bS + 15).top = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[15], h264_file_all__mb4x4Index[11])
            deref(bS + 1).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[1], h264_file_all__mb4x4Index[0])
            deref(bS + 2).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[2], h264_file_all__mb4x4Index[1])
            deref(bS + 3).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[3], h264_file_all__mb4x4Index[2])
            deref(bS + 5).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[5], h264_file_all__mb4x4Index[4])
            deref(bS + 6).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[6], h264_file_all__mb4x4Index[5])
            deref(bS + 7).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[7], h264_file_all__mb4x4Index[6])
            deref(bS + 9).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[9], h264_file_all__mb4x4Index[8])
            deref(bS + 10).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[10], h264_file_all__mb4x4Index[9])
            deref(bS + 11).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[11], h264_file_all__mb4x4Index[10])
            deref(bS + 13).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[13], h264_file_all__mb4x4Index[12])
            deref(bS + 14).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[14], h264_file_all__mb4x4Index[13])
            deref(bS + 15).left = h264_file_all__InnerBoundaryStrength(mb, h264_file_all__mb4x4Index[15], h264_file_all__mb4x4Index[14])
        }
        if (!(nonZeroBs != 0) && (deref(bS + 4).top != 0 || deref(bS + 5).top != 0 || deref(bS + 6).top != 0 || deref(bS + 7).top != 0 || deref(bS + 8).top != 0 || deref(bS + 9).top != 0 || deref(bS + 10).top != 0 || deref(bS + 11).top != 0 || deref(bS + 12).top != 0 || deref(bS + 13).top != 0 || deref(bS + 14).top != 0 || deref(bS + 15).top != 0 || deref(bS + 1).left != 0 || deref(bS + 2).left != 0 || deref(bS + 3).left != 0 || deref(bS + 5).left != 0 || deref(bS + 6).left != 0 || deref(bS + 7).left != 0 || deref(bS + 9).left != 0 || deref(bS + 10).left != 0 || deref(bS + 11).left != 0 || deref(bS + 13).left != 0 || deref(bS + 14).left != 0 || deref(bS + 15).left != 0)) {
            nonZeroBs = uint(HANTRO_TRUE)
        }
    }
    return nonZeroBs
}

// ------------------------------------------------------------------------------
// Function: GetLumaEdgeThresholds
// Functional description:
// Compute alpha, beta and tc0 thresholds for inner, left and top
// luma edges of a macroblock.
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__GetLumaEdgeThresholds(var thresholds : edgeThreshold_t?; var mb : mbStorage?; filteringFlags : uint) {
    // Variables
    var indexA : uint
    var indexB : uint
    var qpAv : uint
    var qp : uint
    var qpTmp : uint
    // Code
    qp = mb.qpY
    indexA = uint(int(qp) + mb.filterOffsetA < 0 ? 0 : (int(qp) + mb.filterOffsetA > 51 ? 51 : int(qp) + mb.filterOffsetA))
    indexB = uint(int(qp) + mb.filterOffsetB < 0 ? 0 : (int(qp) + mb.filterOffsetB > 51 ? 51 : int(qp) + mb.filterOffsetB))
    deref(thresholds + int(anon_245.INNER)).alpha = uint(h264_file_all__alphas[indexA])
    deref(thresholds + int(anon_245.INNER)).beta = uint(h264_file_all__betas[indexB])
    deref(thresholds + int(anon_245.INNER)).tc0 = addr(h264_file_all__tc0[indexA][0])
    if ((filteringFlags & uint(FILTER_TOP_EDGE)) != 0) {
        qpTmp = mb.mbB.qpY
        if (qpTmp != qp) {
            qpAv = qp + qpTmp + uint(1) >> 1u
            indexA = uint(int(qpAv) + mb.filterOffsetA < 0 ? 0 : (int(qpAv) + mb.filterOffsetA > 51 ? 51 : int(qpAv) + mb.filterOffsetA))
            indexB = uint(int(qpAv) + mb.filterOffsetB < 0 ? 0 : (int(qpAv) + mb.filterOffsetB > 51 ? 51 : int(qpAv) + mb.filterOffsetB))
            deref(thresholds + int(anon_245.TOP)).alpha = uint(h264_file_all__alphas[indexA])
            deref(thresholds + int(anon_245.TOP)).beta = uint(h264_file_all__betas[indexB])
            deref(thresholds + int(anon_245.TOP)).tc0 = addr(h264_file_all__tc0[indexA][0])
        } else {
            deref(thresholds + int(anon_245.TOP)).alpha = deref(thresholds + int(anon_245.INNER)).alpha
            deref(thresholds + int(anon_245.TOP)).beta = deref(thresholds + int(anon_245.INNER)).beta
            deref(thresholds + int(anon_245.TOP)).tc0 = deref(thresholds + int(anon_245.INNER)).tc0
        }
    }
    if ((filteringFlags & uint(FILTER_LEFT_EDGE)) != 0) {
        qpTmp = mb.mbA.qpY
        if (qpTmp != qp) {
            qpAv = qp + qpTmp + uint(1) >> 1u
            indexA = uint(int(qpAv) + mb.filterOffsetA < 0 ? 0 : (int(qpAv) + mb.filterOffsetA > 51 ? 51 : int(qpAv) + mb.filterOffsetA))
            indexB = uint(int(qpAv) + mb.filterOffsetB < 0 ? 0 : (int(qpAv) + mb.filterOffsetB > 51 ? 51 : int(qpAv) + mb.filterOffsetB))
            deref(thresholds + int(anon_245.LEFT)).alpha = uint(h264_file_all__alphas[indexA])
            deref(thresholds + int(anon_245.LEFT)).beta = uint(h264_file_all__betas[indexB])
            deref(thresholds + int(anon_245.LEFT)).tc0 = addr(h264_file_all__tc0[indexA][0])
        } else {
            deref(thresholds + int(anon_245.LEFT)).alpha = deref(thresholds + int(anon_245.INNER)).alpha
            deref(thresholds + int(anon_245.LEFT)).beta = deref(thresholds + int(anon_245.INNER)).beta
            deref(thresholds + int(anon_245.LEFT)).tc0 = deref(thresholds + int(anon_245.INNER)).tc0
        }
    }
}

// ------------------------------------------------------------------------------
// Function: GetChromaEdgeThresholds
// Functional description:
// Compute alpha, beta and tc0 thresholds for inner, left and top
// chroma edges of a macroblock.
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__GetChromaEdgeThresholds(var thresholds : edgeThreshold_t?; var mb : mbStorage?; filteringFlags : uint; chromaQpIndexOffset : int) {
    // Variables
    var indexA : uint
    var indexB : uint
    var qpAv : uint
    var qp : uint
    var qpTmp : uint
    // Code
    qp = mb.qpY
    qp = h264bsdQpC[int(qp) + chromaQpIndexOffset < 0 ? 0 : (int(qp) + chromaQpIndexOffset > 51 ? 51 : int(qp) + chromaQpIndexOffset)]
    indexA = uint(int(qp) + mb.filterOffsetA < 0 ? 0 : (int(qp) + mb.filterOffsetA > 51 ? 51 : int(qp) + mb.filterOffsetA))
    indexB = uint(int(qp) + mb.filterOffsetB < 0 ? 0 : (int(qp) + mb.filterOffsetB > 51 ? 51 : int(qp) + mb.filterOffsetB))
    deref(thresholds + int(anon_245.INNER)).alpha = uint(h264_file_all__alphas[indexA])
    deref(thresholds + int(anon_245.INNER)).beta = uint(h264_file_all__betas[indexB])
    deref(thresholds + int(anon_245.INNER)).tc0 = addr(h264_file_all__tc0[indexA][0])
    if ((filteringFlags & uint(FILTER_TOP_EDGE)) != 0) {
        qpTmp = mb.mbB.qpY
        if (qpTmp != mb.qpY) {
            qpTmp = h264bsdQpC[int(qpTmp) + chromaQpIndexOffset < 0 ? 0 : (int(qpTmp) + chromaQpIndexOffset > 51 ? 51 : int(qpTmp) + chromaQpIndexOffset)]
            qpAv = qp + qpTmp + uint(1) >> 1u
            indexA = uint(int(qpAv) + mb.filterOffsetA < 0 ? 0 : (int(qpAv) + mb.filterOffsetA > 51 ? 51 : int(qpAv) + mb.filterOffsetA))
            indexB = uint(int(qpAv) + mb.filterOffsetB < 0 ? 0 : (int(qpAv) + mb.filterOffsetB > 51 ? 51 : int(qpAv) + mb.filterOffsetB))
            deref(thresholds + int(anon_245.TOP)).alpha = uint(h264_file_all__alphas[indexA])
            deref(thresholds + int(anon_245.TOP)).beta = uint(h264_file_all__betas[indexB])
            deref(thresholds + int(anon_245.TOP)).tc0 = addr(h264_file_all__tc0[indexA][0])
        } else {
            deref(thresholds + int(anon_245.TOP)).alpha = deref(thresholds + int(anon_245.INNER)).alpha
            deref(thresholds + int(anon_245.TOP)).beta = deref(thresholds + int(anon_245.INNER)).beta
            deref(thresholds + int(anon_245.TOP)).tc0 = deref(thresholds + int(anon_245.INNER)).tc0
        }
    }
    if ((filteringFlags & uint(FILTER_LEFT_EDGE)) != 0) {
        qpTmp = mb.mbA.qpY
        if (qpTmp != mb.qpY) {
            qpTmp = h264bsdQpC[int(qpTmp) + chromaQpIndexOffset < 0 ? 0 : (int(qpTmp) + chromaQpIndexOffset > 51 ? 51 : int(qpTmp) + chromaQpIndexOffset)]
            qpAv = qp + qpTmp + uint(1) >> 1u
            indexA = uint(int(qpAv) + mb.filterOffsetA < 0 ? 0 : (int(qpAv) + mb.filterOffsetA > 51 ? 51 : int(qpAv) + mb.filterOffsetA))
            indexB = uint(int(qpAv) + mb.filterOffsetB < 0 ? 0 : (int(qpAv) + mb.filterOffsetB > 51 ? 51 : int(qpAv) + mb.filterOffsetB))
            deref(thresholds + int(anon_245.LEFT)).alpha = uint(h264_file_all__alphas[indexA])
            deref(thresholds + int(anon_245.LEFT)).beta = uint(h264_file_all__betas[indexB])
            deref(thresholds + int(anon_245.LEFT)).tc0 = addr(h264_file_all__tc0[indexA][0])
        } else {
            deref(thresholds + int(anon_245.LEFT)).alpha = deref(thresholds + int(anon_245.INNER)).alpha
            deref(thresholds + int(anon_245.LEFT)).beta = deref(thresholds + int(anon_245.INNER)).beta
            deref(thresholds + int(anon_245.LEFT)).tc0 = deref(thresholds + int(anon_245.INNER)).tc0
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterLuma
// Functional description:
// Function to filter all luma edges of a macroblock
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterLuma(var data : uint8?; var bS : bS_t?; var thresholds : edgeThreshold_t?; width : uint) {
    // Variables
    var vblock : uint
    var tmp : bS_t?
    var ptr : uint8?
    var offset : uint
    // Code
    ptr = data
    tmp = bS
    offset = uint(int(anon_245.TOP))
    // loop block rows, perform filtering for all vertical edges of the block
    // row first, then filter each horizontal edge of the row
    {
        vblock = uint(4)
        while (true) {
            let _t0 = vblock
            vblock--
            if (!(_t0 != 0)) {
                break
            }
            // only perform filtering if bS is non-zero, first of the four
            // FilterVerLumaEdge handles the left edge of the macroblock, others
            // filter inner edges
            if (deref(tmp + 0).left != 0) {
                h264_file_all__FilterVerLumaEdge(ptr, deref(tmp + 0).left, thresholds + int(anon_245.LEFT), width)
            }
            if (deref(tmp + 1).left != 0) {
                h264_file_all__FilterVerLumaEdge(ptr + 4, deref(tmp + 1).left, thresholds + int(anon_245.INNER), width)
            }
            if (deref(tmp + 2).left != 0) {
                h264_file_all__FilterVerLumaEdge(ptr + 8, deref(tmp + 2).left, thresholds + int(anon_245.INNER), width)
            }
            if (deref(tmp + 3).left != 0) {
                h264_file_all__FilterVerLumaEdge(ptr + 12, deref(tmp + 3).left, thresholds + int(anon_245.INNER), width)
            }
            // if bS is equal for all horizontal edges of the row -> perform
            // filtering with FilterHorLuma, otherwise use FilterHorLumaEdge for
            // each edge separately. offset variable indicates top macroblock edge
            // on the first loop round, inner edge for the other rounds
            if (deref(tmp + 0).top == deref(tmp + 1).top && deref(tmp + 1).top == deref(tmp + 2).top && deref(tmp + 2).top == deref(tmp + 3).top) {
                if (deref(tmp + 0).top != 0) {
                    h264_file_all__FilterHorLuma(ptr, deref(tmp + 0).top, thresholds + offset, int(width))
                }
            } else {
                if (deref(tmp + 0).top != 0) {
                    h264_file_all__FilterHorLumaEdge(ptr, deref(tmp + 0).top, thresholds + offset, int(width))
                }
                if (deref(tmp + 1).top != 0) {
                    h264_file_all__FilterHorLumaEdge(ptr + 4, deref(tmp + 1).top, thresholds + offset, int(width))
                }
                if (deref(tmp + 2).top != 0) {
                    h264_file_all__FilterHorLumaEdge(ptr + 8, deref(tmp + 2).top, thresholds + offset, int(width))
                }
                if (deref(tmp + 3).top != 0) {
                    h264_file_all__FilterHorLumaEdge(ptr + 12, deref(tmp + 3).top, thresholds + offset, int(width))
                }
            }
            // four pixel rows ahead, i.e. next row of 4x4-blocks
            ptr = ptr + width * uint(4)
            tmp = tmp + 4
            offset = uint(int(anon_245.INNER))
        }
    }
}

// ------------------------------------------------------------------------------
// Function: FilterChroma
// Functional description:
// Function to filter all chroma edges of a macroblock
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__FilterChroma(var dataCb : uint8?; var dataCr : uint8?; var bS : bS_t?; var thresholds : edgeThreshold_t?; width : uint) {
    // Variables
    var tmp : bS_t?
    var offset : uint
    // Code
    tmp = bS
    offset = uint(int(anon_245.TOP))
    // loop block rows, perform filtering for all vertical edges of the block
    // row first, then filter each horizontal edge of the row
    for (vblock in urange(uint(2))) {
        // only perform filtering if bS is non-zero, first two of the four
        // FilterVerChromaEdge calls handle the left edge of the macroblock,
        // others filter the inner edge. Note that as chroma uses bS values
        // determined for luma edges, each bS is used only for 2 pixels of
        // a 4-pixel edge
        if (deref(tmp + 0).left != 0) {
            h264_file_all__FilterVerChromaEdge(dataCb, deref(tmp + 0).left, thresholds + int(anon_245.LEFT), width)
            h264_file_all__FilterVerChromaEdge(dataCr, deref(tmp + 0).left, thresholds + int(anon_245.LEFT), width)
        }
        if (deref(tmp + 4).left != 0) {
            h264_file_all__FilterVerChromaEdge(dataCb + uint(2) * width, deref(tmp + 4).left, thresholds + int(anon_245.LEFT), width)
            h264_file_all__FilterVerChromaEdge(dataCr + uint(2) * width, deref(tmp + 4).left, thresholds + int(anon_245.LEFT), width)
        }
        if (deref(tmp + 2).left != 0) {
            h264_file_all__FilterVerChromaEdge(dataCb + 4, deref(tmp + 2).left, thresholds + int(anon_245.INNER), width)
            h264_file_all__FilterVerChromaEdge(dataCr + 4, deref(tmp + 2).left, thresholds + int(anon_245.INNER), width)
        }
        if (deref(tmp + 6).left != 0) {
            h264_file_all__FilterVerChromaEdge(dataCb + uint(2) * width + 4, deref(tmp + 6).left, thresholds + int(anon_245.INNER), width)
            h264_file_all__FilterVerChromaEdge(dataCr + uint(2) * width + 4, deref(tmp + 6).left, thresholds + int(anon_245.INNER), width)
        }
        // if bS is equal for all horizontal edges of the row -> perform
        // filtering with FilterHorChroma, otherwise use FilterHorChromaEdge
        // for each edge separately. offset variable indicates top macroblock
        // edge on the first loop round, inner edge for the second
        if (deref(tmp + 0).top == deref(tmp + 1).top && deref(tmp + 1).top == deref(tmp + 2).top && deref(tmp + 2).top == deref(tmp + 3).top) {
            if (deref(tmp + 0).top != 0) {
                h264_file_all__FilterHorChroma(dataCb, deref(tmp + 0).top, thresholds + offset, int(width))
                h264_file_all__FilterHorChroma(dataCr, deref(tmp + 0).top, thresholds + offset, int(width))
            }
        } else {
            if (deref(tmp + 0).top != 0) {
                h264_file_all__FilterHorChromaEdge(dataCb, deref(tmp + 0).top, thresholds + offset, int(width))
                h264_file_all__FilterHorChromaEdge(dataCr, deref(tmp + 0).top, thresholds + offset, int(width))
            }
            if (deref(tmp + 1).top != 0) {
                h264_file_all__FilterHorChromaEdge(dataCb + 2, deref(tmp + 1).top, thresholds + offset, int(width))
                h264_file_all__FilterHorChromaEdge(dataCr + 2, deref(tmp + 1).top, thresholds + offset, int(width))
            }
            if (deref(tmp + 2).top != 0) {
                h264_file_all__FilterHorChromaEdge(dataCb + 4, deref(tmp + 2).top, thresholds + offset, int(width))
                h264_file_all__FilterHorChromaEdge(dataCr + 4, deref(tmp + 2).top, thresholds + offset, int(width))
            }
            if (deref(tmp + 3).top != 0) {
                h264_file_all__FilterHorChromaEdge(dataCb + 6, deref(tmp + 3).top, thresholds + offset, int(width))
                h264_file_all__FilterHorChromaEdge(dataCr + 6, deref(tmp + 3).top, thresholds + offset, int(width))
            }
        }
        tmp = tmp + 8
        dataCb = dataCb + width * uint(4)
        dataCr = dataCr + width * uint(4)
        offset = uint(int(anon_245.INNER))
    }
}

[c_function]
def h264bsdInit(var pStorage : storage?; noOutputReordering : uint) : uint {
    // Variables
    var size : uint
    // Code
    h264bsdInitStorage(pStorage)
    // allocate mbLayer to be next multiple of 64 to enable use of
    // specific NEON optimized "memset" for clearing the structure
    size = uint(uint64(typeinfo sizeof(type<macroblockLayer_t>)) + uint64(63) & uint64(~63))
    pStorage.mbLayer = reinterpret<macroblockLayer_t?>(malloc1(uint64(size)))
    if (!(pStorage.mbLayer != null)) {
        return uint(HANTRO_NOK)
    }
    if (noOutputReordering != 0) {
        pStorage.noReordering = uint(HANTRO_TRUE)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDecode(var pStorage : storage?; var byteStrm : uint8?; len : uint; picId : uint; var readBytes : uint?) : uint {
    // Variables
    var tmp : uint
    var ppsId : uint
    var spsId : uint
    var picOrderCnt : int
    var nalUnit : nalUnit_t
    var seqParamSet : seqParamSet_t
    var picParamSet : picParamSet_t
    var strm : strmData_t
    var accessUnitBoundaryFlag : uint = uint(HANTRO_FALSE)
    var picReady : uint = uint(HANTRO_FALSE)
    // Code
    // if previous buffer was not finished and same pointer given -> skip NAL
    // unit extraction
    if (pStorage.prevBufNotFinished != 0 && intptr(byteStrm) == intptr(pStorage.prevBufPointer)) {
        strm = pStorage.strm[0]
        strm.pStrmCurrPos = strm.pStrmBuffStart
        strm.bitPosInWord = uint(0)
        strm.strmBuffReadBits = strm.bitPosInWord
        deref(readBytes) = pStorage.prevBytesConsumed
    } else {
        tmp = h264bsdExtractNalUnit(byteStrm, len, addr(strm), readBytes)
        if (tmp != uint(HANTRO_OK)) {
            return uint(int(anon_277.H264BSD_ERROR))
        }
        // store stream
        pStorage.strm[0] = strm
        pStorage.prevBytesConsumed = deref(readBytes)
        pStorage.prevBufPointer = byteStrm
    }
    pStorage.prevBufNotFinished = uint(HANTRO_FALSE)
    tmp = h264bsdDecodeNalUnit(addr(strm), addr(nalUnit))
    if (tmp != uint(HANTRO_OK)) {
        return uint(int(anon_277.H264BSD_ERROR))
    }
    // Discard unspecified, reserved, SPS extension and auxiliary picture slices
    if (uint(int(nalUnit.nalUnitType)) == uint(0) || uint(int(nalUnit.nalUnitType)) >= uint(13)) {
        return uint(int(anon_277.H264BSD_RDY))
    }
    tmp = h264bsdCheckAccessUnitBoundary(addr(strm), addr(nalUnit), pStorage, addr(accessUnitBoundaryFlag))
    if (tmp != uint(HANTRO_OK)) {
        if (tmp == uint(PARAM_SET_ERROR)) {
            return uint(int(anon_277.H264BSD_PARAM_SET_ERROR))
        } else {
            return uint(int(anon_277.H264BSD_ERROR))
        }
    }
    if (accessUnitBoundaryFlag != 0) {
        // conceal if picture started and param sets activated
        if (pStorage.picStarted != 0 && pStorage.activeSps != null) {
            // return error if second phase of
            // initialization is not completed
            if (pStorage.pendingActivation != 0) {
                return uint(int(anon_277.H264BSD_ERROR))
            }
            if (!(pStorage.validSliceInAccessUnit != 0)) {
                addr(pStorage.currImage[0]).data = h264bsdAllocateDpbImage(addr(pStorage.dpb[0]))
                h264bsdInitRefPicList(addr(pStorage.dpb[0]))
                tmp = h264bsdConceal(pStorage, addr(pStorage.currImage[0]), uint(int(anon_104.P_SLICE)))
            } else {
                tmp = h264bsdConceal(pStorage, addr(pStorage.currImage[0]), addr(pStorage.sliceHeader[0]).sliceType)
            }
            picReady = uint(HANTRO_TRUE)
            // current NAL unit should be decoded on next activation -> set
            // readBytes to 0
            deref(readBytes) = uint(0)
            pStorage.prevBufNotFinished = uint(HANTRO_TRUE)
        } else {
            pStorage.validSliceInAccessUnit = uint(HANTRO_FALSE)
        }
        pStorage.skipRedundantSlices = uint(HANTRO_FALSE)
    }
    if (!(picReady != 0)) {
        let _cond = nalUnit.nalUnitType
        if (_cond == nalUnitType_e.NAL_SEQ_PARAM_SET) {
            tmp = h264bsdDecodeSeqParamSet(addr(strm), addr(seqParamSet))
            if (tmp != uint(HANTRO_OK)) {
                {
                    free1(reinterpret<void?>(seqParamSet.offsetForRefFrame))
                    seqParamSet.offsetForRefFrame = null
                }
                {
                    free1(reinterpret<void?>(seqParamSet.vuiParameters))
                    seqParamSet.vuiParameters = null
                }
                return uint(int(anon_277.H264BSD_ERROR))
            }
            tmp = h264bsdStoreSeqParamSet(pStorage, addr(seqParamSet))
        } elif (_cond == nalUnitType_e.NAL_PIC_PARAM_SET) {
            tmp = h264bsdDecodePicParamSet(addr(strm), addr(picParamSet))
            if (tmp != uint(HANTRO_OK)) {
                {
                    free1(reinterpret<void?>(picParamSet.runLength))
                    picParamSet.runLength = null
                }
                {
                    free1(reinterpret<void?>(picParamSet.topLeft))
                    picParamSet.topLeft = null
                }
                {
                    free1(reinterpret<void?>(picParamSet.bottomRight))
                    picParamSet.bottomRight = null
                }
                {
                    free1(reinterpret<void?>(picParamSet.sliceGroupId))
                    picParamSet.sliceGroupId = null
                }
                return uint(int(anon_277.H264BSD_ERROR))
            }
            tmp = h264bsdStorePicParamSet(pStorage, addr(picParamSet))
        } elif (_cond == nalUnitType_e.NAL_CODED_SLICE_IDR || _cond == nalUnitType_e.NAL_CODED_SLICE) {
            // fall through
            // picture successfully finished and still decoding same old
            // access unit -> no need to decode redundant slices
            if (pStorage.skipRedundantSlices != 0) {
                return uint(int(anon_277.H264BSD_RDY))
            }
            pStorage.picStarted = uint(HANTRO_TRUE)
            if (h264bsdIsStartOfPicture(pStorage) != 0) {
                pStorage.numConcealedMbs = uint(0)
                pStorage.currentPicId = picId
                tmp = h264bsdCheckPpsId(addr(strm), addr(ppsId))
                // store old activeSpsId and return headers ready
                // indication if activeSps changes
                spsId = pStorage.activeSpsId
                tmp = h264bsdActivateParamSets(pStorage, ppsId, uint(addr(nalUnit).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR ? HANTRO_TRUE : HANTRO_FALSE))
                if (tmp != uint(HANTRO_OK)) {
                    pStorage.activePpsId = uint(MAX_NUM_PIC_PARAM_SETS)
                    pStorage.activePps = null
                    pStorage.activeSpsId = uint(MAX_NUM_SEQ_PARAM_SETS)
                    pStorage.activeSps = null
                    pStorage.pendingActivation = uint(HANTRO_FALSE)
                    if (tmp == uint(MEMORY_ALLOCATION_ERROR)) {
                        return uint(int(anon_277.H264BSD_MEMALLOC_ERROR))
                    } else {
                        return uint(int(anon_277.H264BSD_PARAM_SET_ERROR))
                    }
                }
                if (spsId != pStorage.activeSpsId) {
                    var oldSPS : seqParamSet_t? = null
                    var newSPS : seqParamSet_t? = pStorage.activeSps
                    var noOutputOfPriorPicsFlag : uint = uint(1)
                    if (pStorage.oldSpsId < uint(MAX_NUM_SEQ_PARAM_SETS)) {
                        oldSPS = pStorage.sps[pStorage.oldSpsId]
                    }
                    deref(readBytes) = uint(0)
                    pStorage.prevBufNotFinished = uint(HANTRO_TRUE)
                    if (nalUnit.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
                        tmp = h264bsdCheckPriorPicsFlag(addr(noOutputOfPriorPicsFlag), addr(strm), newSPS, pStorage.activePps, nalUnit.nalUnitType)
                    } else {
                        tmp = uint(HANTRO_NOK)
                    }
                    if (tmp != uint(HANTRO_OK) || noOutputOfPriorPicsFlag != uint(0) || addr(pStorage.dpb[0]).noReordering != 0 || oldSPS == null || oldSPS.picWidthInMbs != newSPS.picWidthInMbs || oldSPS.picHeightInMbs != newSPS.picHeightInMbs || oldSPS.maxDpbSize != newSPS.maxDpbSize) {
                        addr(pStorage.dpb[0]).flushed = uint(0)
                    } else {
                        h264bsdFlushDpb(addr(pStorage.dpb[0]))
                    }
                    pStorage.oldSpsId = pStorage.activeSpsId
                    return uint(int(anon_277.H264BSD_HDRS_RDY))
                }
            }
            // return error if second phase of
            // initialization is not completed
            if (pStorage.pendingActivation != 0) {
                return uint(int(anon_277.H264BSD_ERROR))
            }
            tmp = h264bsdDecodeSliceHeader(addr(strm), addr(pStorage.sliceHeader[0]) + 1, pStorage.activeSps, pStorage.activePps, addr(nalUnit))
            if (tmp != uint(HANTRO_OK)) {
                return uint(int(anon_277.H264BSD_ERROR))
            }
            if (h264bsdIsStartOfPicture(pStorage) != 0) {
                if (!(addr(nalUnit).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR)) {
                    tmp = h264bsdCheckGapsInFrameNum(addr(pStorage.dpb[0]), pStorage.sliceHeader[1].frameNum, uint(nalUnit.nalRefIdc != uint(0) ? HANTRO_TRUE : HANTRO_FALSE), pStorage.activeSps.gapsInFrameNumValueAllowedFlag)
                    if (tmp != uint(HANTRO_OK)) {
                        return uint(int(anon_277.H264BSD_ERROR))
                    }
                }
                addr(pStorage.currImage[0]).data = h264bsdAllocateDpbImage(addr(pStorage.dpb[0]))
            }
            // store slice header to storage if successfully decoded
            pStorage.sliceHeader[0] = pStorage.sliceHeader[1]
            pStorage.validSliceInAccessUnit = uint(HANTRO_TRUE)
            pStorage.prevNalUnit[0] = nalUnit
            h264bsdComputeSliceGroupMap(pStorage, addr(pStorage.sliceHeader[0]).sliceGroupChangeCycle)
            h264bsdInitRefPicList(addr(pStorage.dpb[0]))
            tmp = h264bsdReorderRefPicList(addr(pStorage.dpb[0]), addr(addr(pStorage.sliceHeader[0]).refPicListReordering), addr(pStorage.sliceHeader[0]).frameNum, addr(pStorage.sliceHeader[0]).numRefIdxL0Active)
            if (tmp != uint(HANTRO_OK)) {
                return uint(int(anon_277.H264BSD_ERROR))
            }
            tmp = h264bsdDecodeSliceData(addr(strm), pStorage, addr(pStorage.currImage[0]), addr(pStorage.sliceHeader[0]))
            if (tmp != uint(HANTRO_OK)) {
                h264bsdMarkSliceCorrupted(pStorage, addr(pStorage.sliceHeader[0]).firstMbInSlice)
                return uint(int(anon_277.H264BSD_ERROR))
            }
            if (h264bsdIsEndOfPicture(pStorage) != 0) {
                picReady = uint(HANTRO_TRUE)
                pStorage.skipRedundantSlices = uint(HANTRO_TRUE)
            }
        } elif (_cond == nalUnitType_e.NAL_SEI) {
        } else {
        }
    }
    if (picReady != 0) {
        h264bsdFilterPicture(addr(pStorage.currImage[0]), pStorage.mb)
        h264bsdResetStorage(pStorage)
        picOrderCnt = h264bsdDecodePicOrderCnt(addr(pStorage.poc[0]), pStorage.activeSps, addr(pStorage.sliceHeader[0]), addr(pStorage.prevNalUnit[0]))
        if (pStorage.validSliceInAccessUnit != 0) {
            if (addr(pStorage.prevNalUnit[0]).nalRefIdc != 0) {
                tmp = h264bsdMarkDecRefPic(addr(pStorage.dpb[0]), addr(addr(pStorage.sliceHeader[0]).decRefPicMarking), addr(pStorage.currImage[0]), addr(pStorage.sliceHeader[0]).frameNum, picOrderCnt, uint(addr(pStorage.prevNalUnit[0]).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR ? HANTRO_TRUE : HANTRO_FALSE), pStorage.currentPicId, pStorage.numConcealedMbs)
            } else {
                // non-reference picture, just store for possible display
                // reordering
                tmp = h264bsdMarkDecRefPic(addr(pStorage.dpb[0]), null, addr(pStorage.currImage[0]), addr(pStorage.sliceHeader[0]).frameNum, picOrderCnt, uint(addr(pStorage.prevNalUnit[0]).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR ? HANTRO_TRUE : HANTRO_FALSE), pStorage.currentPicId, pStorage.numConcealedMbs)
            }
        }
        pStorage.picStarted = uint(HANTRO_FALSE)
        pStorage.validSliceInAccessUnit = uint(HANTRO_FALSE)
        return uint(int(anon_277.H264BSD_PIC_RDY))
    } else {
        return uint(int(anon_277.H264BSD_RDY))
    }
}

[c_function]
def h264bsdShutdown(var pStorage : storage?) {
    // Variables
    // Code
    for (i in urange(uint(MAX_NUM_SEQ_PARAM_SETS))) {
        if (pStorage.sps[i] != null) {
            {
                free1(reinterpret<void?>(pStorage.sps[i].offsetForRefFrame))
                pStorage.sps[i].offsetForRefFrame = null
            }
            {
                free1(reinterpret<void?>(pStorage.sps[i].vuiParameters))
                pStorage.sps[i].vuiParameters = null
            }
            {
                free1(reinterpret<void?>(pStorage.sps[i]))
                pStorage.sps[i] = null
            }
        }
    }
    for (i in urange(uint(MAX_NUM_PIC_PARAM_SETS))) {
        if (pStorage.pps[i] != null) {
            {
                free1(reinterpret<void?>(pStorage.pps[i].runLength))
                pStorage.pps[i].runLength = null
            }
            {
                free1(reinterpret<void?>(pStorage.pps[i].topLeft))
                pStorage.pps[i].topLeft = null
            }
            {
                free1(reinterpret<void?>(pStorage.pps[i].bottomRight))
                pStorage.pps[i].bottomRight = null
            }
            {
                free1(reinterpret<void?>(pStorage.pps[i].sliceGroupId))
                pStorage.pps[i].sliceGroupId = null
            }
            {
                free1(reinterpret<void?>(pStorage.pps[i]))
                pStorage.pps[i] = null
            }
        }
    }
    {
        free1(reinterpret<void?>(pStorage.mbLayer))
        pStorage.mbLayer = null
    }
    {
        free1(reinterpret<void?>(pStorage.mb))
        pStorage.mb = null
    }
    {
        free1(reinterpret<void?>(pStorage.sliceGroupMap))
        pStorage.sliceGroupMap = null
    }
    if (pStorage.conversionBuffer != null) {
        free1(reinterpret<void?>(pStorage.conversionBuffer))
        pStorage.conversionBuffer = null
    }
    h264bsdFreeDpb(addr(pStorage.dpb[0]))
}

[c_function]
def h264bsdNextOutputPicture(var pStorage : storage?; var picId : uint?; var isIdrPic : uint?; var numErrMbs : uint?) : uint8? {
    // Variables
    var pOut : dpbOutPicture_t?
    // Code
    pOut = h264bsdDpbOutputPicture(addr(pStorage.dpb[0]))
    if (pOut != null) {
        deref(picId) = pOut.picId
        deref(isIdrPic) = pOut.isIdr
        deref(numErrMbs) = pOut.numErrMbs
        return pOut.data
    } else {
        return null
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdNextOutputPictureRGBA
// Functional description:
// Get next output picture in display order, converted to RGBA.
// RGBA is the color format most commonly used by OpenGL.
// Inputs:
// pStorage pointer to storage data structure
// Outputs:
// picId identifier of the picture will be stored here
// isIdrPic IDR flag of the picture will be stored here
// numErrMbs number of concealed macroblocks in the picture
// will be stored here
// Returns:
// pointer to the picture data
// NULL if no pictures available for display
// ------------------------------------------------------------------------------
[c_function]
def h264bsdNextOutputPictureRGBA(var pStorage : storage?; var picId : uint?; var isIdrPic : uint?; var numErrMbs : uint?) : uint? {
    var width : uint = h264bsdPicWidth(pStorage) * uint(16)
    var height : uint = h264bsdPicHeight(pStorage) * uint(16)
    var data : uint8? = h264bsdNextOutputPicture(pStorage, picId, isIdrPic, numErrMbs)
    var rgbSize : uint64 = uint64(typeinfo sizeof(type<uint>)) * uint64(width) * uint64(height)
    if (data == null) {
        return null
    }
    if (pStorage.conversionBufferSize < rgbSize) {
        if (pStorage.conversionBuffer != null) {
            free1(reinterpret<void?>(pStorage.conversionBuffer))
        }
        pStorage.conversionBufferSize = rgbSize
        pStorage.conversionBuffer = reinterpret<uint?>(malloc1(rgbSize))
    }
    h264bsdConvertToRGBA(width, height, data, pStorage.conversionBuffer)
    return pStorage.conversionBuffer
}

// ------------------------------------------------------------------------------
// Function: h264bsdNextOutputPictureRGBA
// Functional description:
// Get next output picture in display order, converted to BGRA.
// BGRA is the color format most commonly used by Windows.
// Inputs:
