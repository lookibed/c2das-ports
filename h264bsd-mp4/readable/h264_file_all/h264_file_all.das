[c_function]
def private h264_file_all__DecodeMotionConstrainedSliceGroupSet(var pStrmData : strmData_t?;
                                                                var pMotionConstrainedSliceGroupSet : seiMotionConstrainedSliceGroupSet_t?; numSliceGroups : uint) : uint {
    // Variables
    var tmp : uint
    var i : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pMotionConstrainedSliceGroupSet.numSliceGroupsInSet))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pMotionConstrainedSliceGroupSet.numSliceGroupsInSet++
    if (pMotionConstrainedSliceGroupSet.numSliceGroupsInSet > numSliceGroups) {
        return uint(HANTRO_NOK)
    }
    i = 0u
    while (i < pMotionConstrainedSliceGroupSet.numSliceGroupsInSet) {
        tmp = h264bsdGetBits(pStrmData, h264_file_all__ceilLog2NumSliceGroups[numSliceGroups])
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pMotionConstrainedSliceGroupSet.sliceGroupId[i] = tmp
        if (pMotionConstrainedSliceGroupSet.sliceGroupId[i] > pMotionConstrainedSliceGroupSet.numSliceGroupsInSet - 1u) {
            return uint(HANTRO_NOK)
        }
        i++
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pMotionConstrainedSliceGroupSet.exactSampleValueMatchFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pMotionConstrainedSliceGroupSet.panScanRectFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    if (pMotionConstrainedSliceGroupSet.panScanRectFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pMotionConstrainedSliceGroupSet.panScanRectId))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeReservedSeiMessage(var pStrmData : strmData_t?; var pReservedSeiMessage : seiReservedSeiMessage_t?;
                                                    payloadSize : uint) : uint {
    // Variables
    var tmp : uint
    // Code
    // where corresponding FREE() ???
    pReservedSeiMessage.reservedSeiMessagePayloadByte = reinterpret<uint8?>(malloc1(uint64(payloadSize) * uint64(typeinfo sizeof(type<uint8>))))
    if (pReservedSeiMessage.reservedSeiMessagePayloadByte == null) {
        return uint(MEMORY_ALLOCATION_ERROR)
    }
    pReservedSeiMessage.numPayloadBytes = payloadSize
    for (i in urange(payloadSize)) {
        tmp = h264bsdGetBits(pStrmData, 8u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pReservedSeiMessage.reservedSeiMessagePayloadByte[i] = uint8(tmp)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDecodeSeqParamSet(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var value : uint
    // Code
    memset1(reinterpret<void?>(pSeqParamSet), 0, uint64(typeinfo sizeof(type<seqParamSet_t>)))
    // profile_idc
    tmp = h264bsdGetBits(pStrmData, 8u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (tmp != 66u) {
    }
    pSeqParamSet.profileIdc = tmp
    // constrained_set0_flag
    tmp = h264bsdGetBits(pStrmData, 1u)
    // constrained_set1_flag
    tmp = h264bsdGetBits(pStrmData, 1u)
    // constrained_set2_flag
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // reserved_zero_5bits, values of these bits shall be ignored
    tmp = h264bsdGetBits(pStrmData, 5u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 8u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.levelIdc = tmp
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.seqParameterSetId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSeqParamSet.seqParameterSetId >= uint(MAX_NUM_SEQ_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    // log2_max_frame_num_minus4
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > 12u) {
        return uint(HANTRO_NOK)
    }
    // maxFrameNum = 2^(log2_max_frame_num_minus4 + 4)
    pSeqParamSet.maxFrameNum = uint(1 << int(value + 4u))
    // valid POC types are 0, 1 and 2
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > 2u) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.picOrderCntType = value
    if (pSeqParamSet.picOrderCntType == 0u) {
        // log2_max_pic_order_cnt_lsb_minus4
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (value > 12u) {
            return uint(HANTRO_NOK)
        }
        // maxPicOrderCntLsb = 2^(log2_max_pic_order_cnt_lsb_minus4 + 4)
        pSeqParamSet.maxPicOrderCntLsb = uint(1 << int(value + 4u))
    } elif (pSeqParamSet.picOrderCntType == 1u) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSeqParamSet.deltaPicOrderAlwaysZeroFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pSeqParamSet.offsetForNonRefPic))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pSeqParamSet.offsetForTopToBottomField))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.numRefFramesInPicOrderCntCycle))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pSeqParamSet.numRefFramesInPicOrderCntCycle > 255u) {
            return uint(HANTRO_NOK)
        }
        if (pSeqParamSet.numRefFramesInPicOrderCntCycle != 0) {
            // NOTE: This has to be freed somewhere!
            pSeqParamSet.offsetForRefFrame = reinterpret<int?>(malloc1(uint64(pSeqParamSet.numRefFramesInPicOrderCntCycle) *
                    uint64(typeinfo sizeof(type<int>))))
            if (pSeqParamSet.offsetForRefFrame == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            i = 0u
            while (i < pSeqParamSet.numRefFramesInPicOrderCntCycle) {
                tmp = h264bsdDecodeExpGolombSigned(pStrmData, pSeqParamSet.offsetForRefFrame + i)
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                i++
            }
        } else {
            pSeqParamSet.offsetForRefFrame = null
        }
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.numRefFrames))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSeqParamSet.numRefFrames > uint(MAX_NUM_REF_PICS)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.gapsInFrameNumValueAllowedFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSeqParamSet.picWidthInMbs = value + 1u
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSeqParamSet.picHeightInMbs = value + 1u
    // frame_mbs_only_flag, shall be 1 for baseline profile
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (tmp == 0) {
        return uint(HANTRO_NOK)
    }
    // direct_8x8_inference_flag
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.frameCroppingFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pSeqParamSet.frameCroppingFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropLeftOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropRightOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropTopOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSeqParamSet.frameCropBottomOffset))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // check that frame cropping params are valid, parameters shall
        // specify non-negative area within the original picture
        if ((int(pSeqParamSet.frameCropLeftOffset) > (8 * int(pSeqParamSet.picWidthInMbs) - (int(pSeqParamSet.frameCropRightOffset) + 1))) ||
                (int(pSeqParamSet.frameCropTopOffset) > (8 * int(pSeqParamSet.picHeightInMbs) - (int(pSeqParamSet.frameCropBottomOffset) + 1)))) {
            return uint(HANTRO_NOK)
        }
    }
    // check that image dimensions and levelIdc match
    tmp = pSeqParamSet.picWidthInMbs * pSeqParamSet.picHeightInMbs
    value = h264_file_all__GetDpbSize(tmp, pSeqParamSet.levelIdc)
    if (value == uint(anon_544.INVALID_DPB_SIZE) || pSeqParamSet.numRefFrames > value) {
        value = pSeqParamSet.numRefFrames
    }
    pSeqParamSet.maxDpbSize = value
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSeqParamSet.vuiParametersPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    // VUI
    if (pSeqParamSet.vuiParametersPresentFlag != 0) {
        pSeqParamSet.vuiParameters = reinterpret<vuiParameters_t?>(malloc1(1ul * uint64(typeinfo sizeof(type<vuiParameters_t>))))
        if (pSeqParamSet.vuiParameters == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
        tmp = h264bsdDecodeVuiParameters(pStrmData, pSeqParamSet.vuiParameters)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // check numReorderFrames and maxDecFrameBuffering
        if (pSeqParamSet.vuiParameters.bitstreamRestrictionFlag != 0) {
            if (pSeqParamSet.vuiParameters.numReorderFrames > pSeqParamSet.vuiParameters.maxDecFrameBuffering ||
                    pSeqParamSet.vuiParameters.maxDecFrameBuffering < pSeqParamSet.numRefFrames ||
                    pSeqParamSet.vuiParameters.maxDecFrameBuffering > pSeqParamSet.maxDpbSize) {
                return uint(HANTRO_NOK)
            }
            // standard says that "the sequence shall not require a DPB with
            // size of more than max(1, maxDecFrameBuffering)
            pSeqParamSet.maxDpbSize = 1u > pSeqParamSet.vuiParameters.maxDecFrameBuffering ? 1u : pSeqParamSet.vuiParameters.maxDecFrameBuffering
        }
    }
    tmp = h264bsdRbspTrailingBits(pStrmData)
    // ignore possible errors in trailing bits of parameters sets
    return uint(HANTRO_OK)
}

def private h264_file_all__GetDpbSize(picSizeInMbs : uint; levelIdc : uint) : uint {
    // Variables
    var tmp : uint
    var maxPicSizeInMbs : uint
    // Code
    // use tmp as the size of the DPB in bytes, computes as 1024 * MaxDPB
    // (from table A-1 in Annex A)
    c_switch(levelIdc) {
        case(10u) {
            tmp = 152064u
            maxPicSizeInMbs = 99u
            break
        }
        case(11u) {
            tmp = 345600u
            maxPicSizeInMbs = 396u
            break
        }
        case(12u) {
            tmp = 912384u
            maxPicSizeInMbs = 396u
            break
        }
        case(13u) {
            tmp = 912384u
            maxPicSizeInMbs = 396u
            break
        }
        case(20u) {
            tmp = 912384u
            maxPicSizeInMbs = 396u
            break
        }
        case(21u) {
            tmp = 1824768u
            maxPicSizeInMbs = 792u
            break
        }
        case(22u) {
            tmp = 3110400u
            maxPicSizeInMbs = 1620u
            break
        }
        case(30u) {
            tmp = 3110400u
            maxPicSizeInMbs = 1620u
            break
        }
        case(31u) {
            tmp = 6912000u
            maxPicSizeInMbs = 3600u
            break
        }
        case(32u) {
            tmp = 7864320u
            maxPicSizeInMbs = 5120u
            break
        }
        case(40u) {
            tmp = 12582912u
            maxPicSizeInMbs = 8192u
            break
        }
        case(41u) {
            tmp = 12582912u
            maxPicSizeInMbs = 8192u
            break
        }
        case(42u) {
            tmp = uint(34816 * 384)
            maxPicSizeInMbs = 8704u
            break
        }
        case(50u) {
            // standard says 42301440 here, but corrigendum "corrects" this to
            // 42393600
            tmp = 42393600u
            maxPicSizeInMbs = 22080u
            break
        }
        case(51u) {
            tmp = 70778880u
            maxPicSizeInMbs = 36864u
            break
        }
        case(_) {
            return uint(anon_544.INVALID_DPB_SIZE)
        }
    }
    // this is not "correct" return value! However, it results in error in
    // decoding and this was easiest place to check picture size
    if (picSizeInMbs > maxPicSizeInMbs) {
        return uint(anon_544.INVALID_DPB_SIZE)
    }
    tmp /= picSizeInMbs * 384u
    return MIN(tmp, 16)
}

[c_function]
def h264bsdCompareSeqParamSets(var pSps1 : seqParamSet_t?; var pSps2 : seqParamSet_t?) : uint {
    // Variables
    // Code
    // first compare parameters whose existence does not depend on other
    // parameters and only compare the rest of the params if these are equal
    if (pSps1.profileIdc == pSps2.profileIdc && pSps1.levelIdc == pSps2.levelIdc && pSps1.maxFrameNum == pSps2.maxFrameNum &&
            pSps1.picOrderCntType == pSps2.picOrderCntType && pSps1.numRefFrames == pSps2.numRefFrames &&
            pSps1.gapsInFrameNumValueAllowedFlag == pSps2.gapsInFrameNumValueAllowedFlag && pSps1.picWidthInMbs == pSps2.picWidthInMbs &&
            pSps1.picHeightInMbs == pSps2.picHeightInMbs && pSps1.frameCroppingFlag == pSps2.frameCroppingFlag &&
            pSps1.vuiParametersPresentFlag == pSps2.vuiParametersPresentFlag) {
        if (pSps1.picOrderCntType == 0u) {
            if (pSps1.maxPicOrderCntLsb != pSps2.maxPicOrderCntLsb) {
                return 1u
            }
        } elif (pSps1.picOrderCntType == 1u) {
            if (pSps1.deltaPicOrderAlwaysZeroFlag != pSps2.deltaPicOrderAlwaysZeroFlag || pSps1.offsetForNonRefPic != pSps2.offsetForNonRefPic ||
                    pSps1.offsetForTopToBottomField != pSps2.offsetForTopToBottomField ||
                    pSps1.numRefFramesInPicOrderCntCycle != pSps2.numRefFramesInPicOrderCntCycle) {
                return 1u
            } else {
                for (i in urange(pSps1.numRefFramesInPicOrderCntCycle)) {
                    if (pSps1.offsetForRefFrame[i] != pSps2.offsetForRefFrame[i]) {
                        return 1u
                    }
                }
            }
        }
        if (pSps1.frameCroppingFlag != 0) {
            if (pSps1.frameCropLeftOffset != pSps2.frameCropLeftOffset || pSps1.frameCropRightOffset != pSps2.frameCropRightOffset ||
                    pSps1.frameCropTopOffset != pSps2.frameCropTopOffset || pSps1.frameCropBottomOffset != pSps2.frameCropBottomOffset) {
                return 1u
            }
        }
        return 0u
    }
    return 1u
}

[c_function]
def h264bsdDecodeSliceData(var pStrmData : strmData_t?; var pStorage : storage?; var currImage : image_t?; var pSliceHeader : sliceHeader_t?) : uint {
    // Variables
    var mbData : uint8[431]
    var data : uint8?
    var tmp : uint
    var skipRun : uint
    var prevSkipped : uint
    var currMbAddr : uint
    var moreMbs : uint
    var mbCount : uint
    var qpY : int
    var mbLayer : macroblockLayer_t?
    // Code
    // ensure 16-byte alignment
    data = addr(mbData[0]) + (16ul - uint64(intptr(addr(mbData[0]))) & uint64(16 - 1)) / uint64(typeinfo sizeof(type<uint8>))
    mbLayer = pStorage.mbLayer
    currMbAddr = pSliceHeader.firstMbInSlice
    skipRun = 0u
    prevSkipped = uint(HANTRO_FALSE)
    // increment slice index, will be one for decoding of the first slice of
    // the picture
    addr(pStorage.slice[0]).sliceId++
    // lastMbAddr stores address of the macroblock that was last successfully
    // decoded, needed for error handling
    addr(pStorage.slice[0]).lastMbAddr = 0u
    mbCount = 0u
    // initial quantization parameter for the slice is obtained as the sum of
    // initial QP for the picture and sliceQpDelta for the current slice
    qpY = int(pStorage.activePps.picInitQp) + pSliceHeader.sliceQpDelta
    c_do_while(moreMbs != 0) {
        // primary picture and already decoded macroblock -> error
        if (pSliceHeader.redundantPicCnt == 0 && pStorage.mb[currMbAddr].decoded != 0) {
            return uint(HANTRO_NOK)
        }
        h264_file_all__SetMbParams(pStorage.mb + currMbAddr, pSliceHeader, addr(pStorage.slice[0]).sliceId, pStorage.activePps.chromaQpIndexOffset)
        if (!(pSliceHeader.sliceType == uint(anon_104.I_SLICE) || pSliceHeader.sliceType == uint(int(anon_104.I_SLICE) + 5))) {
            if (prevSkipped == 0) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(skipRun))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                // skip_run shall be less than or equal to number of
                // macroblocks left
                if (skipRun > (pStorage.picSizeInMbs - currMbAddr)) {
                    return uint(HANTRO_NOK)
                }
                if (skipRun != 0) {
                    prevSkipped = uint(HANTRO_TRUE)
                    memset1(reinterpret<void?>(addr(mbLayer.mbPred)), 0, uint64(typeinfo sizeof(type<mbPred_t>)))
                    // mark current macroblock skipped
                    mbLayer.mbType = mbType_e.P_Skip
                }
            }
        }
        if (skipRun != 0) {
            skipRun--
        } else {
            prevSkipped = uint(HANTRO_FALSE)
            tmp = h264bsdDecodeMacroblockLayer(pStrmData, mbLayer, pStorage.mb + currMbAddr, pSliceHeader.sliceType, pSliceHeader.numRefIdxL0Active)
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
        tmp = h264bsdDecodeMacroblock(pStorage.mb + currMbAddr, mbLayer, currImage, addr(pStorage.dpb[0]), addr(qpY), currMbAddr,
                pStorage.activePps.constrainedIntraPredFlag, data)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // increment macroblock count only for macroblocks that were decoded
        // for the first time (redundant slices)
        if (pStorage.mb[currMbAddr].decoded == 1u) {
            mbCount++
        }
        // keep on processing as long as there is stream data left or
        // processing of macroblocks to be skipped based on the last skipRun is
        // not finished
        moreMbs = uint((h264bsdMoreRbspData(pStrmData) != 0 || skipRun != 0) ? HANTRO_TRUE : HANTRO_FALSE)
        // lastMbAddr is only updated for intra slices (all macroblocks of
        // inter slices will be lost in case of an error)
        if (pSliceHeader.sliceType == uint(anon_104.I_SLICE) || pSliceHeader.sliceType == uint(int(anon_104.I_SLICE) + 5)) {
            addr(pStorage.slice[0]).lastMbAddr = currMbAddr
        }
        currMbAddr = h264bsdNextMbAddress(pStorage.sliceGroupMap, pStorage.picSizeInMbs, currMbAddr)
        // data left in the buffer but no more macroblocks for current slice
        // group -> error
        if (moreMbs != 0 && currMbAddr == 0) {
            return uint(HANTRO_NOK)
        }
    }
    if ((addr(pStorage.slice[0]).numDecodedMbs + mbCount) > pStorage.picSizeInMbs) {
        return uint(HANTRO_NOK)
    }
    addr(pStorage.slice[0]).numDecodedMbs += mbCount
    return uint(HANTRO_OK)
}

def private h264_file_all__SetMbParams(var pMb : mbStorage?; var pSlice : sliceHeader_t?; sliceId : uint; chromaQpIndexOffset : int) {
    // Variables
    var tmp1 : uint
    var tmp2 : int
    var tmp3 : int
    // Code
    tmp1 = pSlice.disableDeblockingFilterIdc
    tmp2 = pSlice.sliceAlphaC0Offset
    tmp3 = pSlice.sliceBetaOffset
    pMb.sliceId = sliceId
    pMb.disableDeblockingFilterIdc = tmp1
    pMb.filterOffsetA = tmp2
    pMb.filterOffsetB = tmp3
    pMb.chromaQpIndexOffset = chromaQpIndexOffset
}

[c_function]
def h264bsdMarkSliceCorrupted(var pStorage : storage?; firstMbInSlice : uint) {
    // Variables
    var tmp : uint
    var i : uint
    var sliceId : uint
    var currMbAddr : uint
    // Code
    currMbAddr = firstMbInSlice
    sliceId = addr(pStorage.slice[0]).sliceId
    // DecodeSliceData sets lastMbAddr for I slices -> if it was set, go back
    // MAX(picWidthInMbs, 10) macroblocks and start marking from there
    if (addr(pStorage.slice[0]).lastMbAddr != 0) {
        i = addr(pStorage.slice[0]).lastMbAddr - 1u
        tmp = 0u
        while (i > currMbAddr) {
            if (pStorage.mb[i].sliceId == sliceId) {
                tmp++
                if (tmp >= (pStorage.activeSps.picWidthInMbs > 10u ? pStorage.activeSps.picWidthInMbs : 10u)) {
                    break
                }
            }
            i--
        }
        currMbAddr = i
    }
    c_do_while(currMbAddr != 0) {
        if ((pStorage.mb[currMbAddr].sliceId == sliceId) && pStorage.mb[currMbAddr].decoded != 0) {
            pStorage.mb[currMbAddr].decoded--
        } else {
            break
        }
        currMbAddr = h264bsdNextMbAddress(pStorage.sliceGroupMap, pStorage.picSizeInMbs, currMbAddr)
    }
}

[c_function]
def private h264_file_all__DecodeInterleavedMap(var map : uint?; numSliceGroups : uint; var runLength : uint?; picSize : uint) {
    // Variables
    var i : uint
    var j : uint
    var group : uint
    // Code
    i = 0u
    c_do_while(i < picSize) {
        group = 0u
        while (group < numSliceGroups && i < picSize) {
            j = 0u
            while (j < runLength[group] && i + j < picSize) {
                map[i + j] = group
                j++
            }
            let _t0 = group
            group++
            i += runLength[_t0]
        }
    }
}

[c_function]
def private h264_file_all__DecodeDispersedMap(var map : uint?; numSliceGroups : uint; picWidth : uint; picHeight : uint) {
    // Variables
    var picSize : uint
    // Code
    picSize = picWidth * picHeight
    for (i in urange(picSize)) {
        map[i] = ((i % picWidth) + (((i / picWidth) * numSliceGroups) >> 1u)) % numSliceGroups
    }
}

[c_function]
def private h264_file_all__DecodeForegroundLeftOverMap(var map : uint?; numSliceGroups : uint; var topLeft : uint?; var bottomRight : uint?; picWidth : uint;
                                                       picHeight : uint) {
    // Variables
    var y : uint
    var x : uint
    var yTopLeft : uint
    var yBottomRight : uint
    var xTopLeft : uint
    var xBottomRight : uint
    var picSize : uint
    var group : uint
    // Code
    picSize = picWidth * picHeight
    for (i in urange(picSize)) {
        map[i] = numSliceGroups - 1u
    }
    group = numSliceGroups - 1u
    while (true) {
        let _t0 = group
        group--
        if (_t0 == 0) {
            break
        }
        yTopLeft = topLeft[group] / picWidth
        xTopLeft = topLeft[group] % picWidth
        yBottomRight = bottomRight[group] / picWidth
        xBottomRight = bottomRight[group] % picWidth
        y = yTopLeft
        while (y <= yBottomRight) {
            x = xTopLeft
            while (x <= xBottomRight) {
                map[y * picWidth + x] = group
                x++
            }
            y++
        }
    }
}

[c_function]
def private h264_file_all__DecodeBoxOutMap(var map : uint?; sliceGroupChangeDirectionFlag : uint; unitsInSliceGroup0 : uint; picWidth : uint;
                                           picHeight : uint) {
    // Variables
    var k : uint
    var picSize : uint
    var x : int
    var y : int
    var xDir : int
    var yDir : int
    var leftBound : int
    var topBound : int
    var rightBound : int
    var bottomBound : int
    var mapUnitVacant : uint
    // Code
    picSize = picWidth * picHeight
    for (i in urange(picSize)) {
        map[i] = 1u
    }
    x = int((picWidth - sliceGroupChangeDirectionFlag) >> 1u)
    y = int((picHeight - sliceGroupChangeDirectionFlag) >> 1u)
    leftBound = x
    topBound = y
    rightBound = x
    bottomBound = y
    xDir = int(sliceGroupChangeDirectionFlag) - 1
    yDir = int(sliceGroupChangeDirectionFlag)
    k = 0u
    while (k < unitsInSliceGroup0) {
        mapUnitVacant = uint((map[uint(y) * picWidth + uint(x)] == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
        if (mapUnitVacant != 0) {
            map[uint(y) * picWidth + uint(x)] = 0u
        }
        if (xDir == -1 && x == leftBound) {
            leftBound = MAX(leftBound - 1, 0)
            x = leftBound
            xDir = 0
            yDir = 2 * int(sliceGroupChangeDirectionFlag) - 1
        } elif (xDir == 1 && x == rightBound) {
            rightBound = MIN(rightBound + 1, int(picWidth) - 1)
            x = rightBound
            xDir = 0
            yDir = 1 - 2 * int(sliceGroupChangeDirectionFlag)
        } elif (yDir == -1 && y == topBound) {
            topBound = MAX(topBound - 1, 0)
            y = topBound
            xDir = 1 - 2 * int(sliceGroupChangeDirectionFlag)
            yDir = 0
        } elif (yDir == 1 && y == bottomBound) {
            bottomBound = MIN(bottomBound + 1, int(picHeight) - 1)
            y = bottomBound
            xDir = 2 * int(sliceGroupChangeDirectionFlag) - 1
            yDir = 0
        } else {
            x += xDir
            y += yDir
        }
        k += uint(mapUnitVacant != 0 ? 1 : 0)
    }
}

[c_function]
def private h264_file_all__DecodeRasterScanMap(var map : uint?; sliceGroupChangeDirectionFlag : uint; sizeOfUpperLeftGroup : uint; picSize : uint) {
    // Variables
    // Code
    for (i in urange(picSize)) {
        if (i < sizeOfUpperLeftGroup) {
            map[i] = sliceGroupChangeDirectionFlag
        } else {
            map[i] = 1u - sliceGroupChangeDirectionFlag
        }
    }
}

[c_function]
def private h264_file_all__DecodeWipeMap(var map : uint?; sliceGroupChangeDirectionFlag : uint; sizeOfUpperLeftGroup : uint; picWidth : uint;
                                         picHeight : uint) {
    // Variables
    var k : uint
    // Code
    k = 0u
    for (j in urange(picWidth)) {
        for (i in urange(picHeight)) {
            let _t0 = k
            k++
            if (_t0 < sizeOfUpperLeftGroup) {
                map[i * picWidth + j] = sliceGroupChangeDirectionFlag
            } else {
                map[i * picWidth + j] = 1u - sliceGroupChangeDirectionFlag
            }
        }
    }
}

[c_function]
def h264bsdDecodeSliceGroupMap(var map : uint?; var pps : picParamSet_t?; sliceGroupChangeCycle : uint; picWidth : uint; picHeight : uint) {
    // Variables
    var i : uint
    var picSize : uint
    var unitsInSliceGroup0 : uint = 0u
    var sizeOfUpperLeftGroup : uint = 0u
    // Code
    picSize = picWidth * picHeight
    // just one slice group -> all macroblocks belong to group 0
    if (pps.numSliceGroups == 1u) {
        memset1(reinterpret<void?>(map), 0, uint64(picSize) * uint64(typeinfo sizeof(type<uint>)))
        return
    }
    if (pps.sliceGroupMapType > 2u && pps.sliceGroupMapType < 6u) {
        unitsInSliceGroup0 = sliceGroupChangeCycle * pps.sliceGroupChangeRate < picSize ? sliceGroupChangeCycle * pps.sliceGroupChangeRate : picSize
        if (pps.sliceGroupMapType == 4u || pps.sliceGroupMapType == 5u) {
            sizeOfUpperLeftGroup = pps.sliceGroupChangeDirectionFlag != 0 ? (picSize - unitsInSliceGroup0) : unitsInSliceGroup0
        }
    }
    c_switch(pps.sliceGroupMapType) {
        case(0u) {
            h264_file_all__DecodeInterleavedMap(map, pps.numSliceGroups, pps.runLength, picSize)
            break
        }
        case(1u) {
            h264_file_all__DecodeDispersedMap(map, pps.numSliceGroups, picWidth, picHeight)
            break
        }
        case(2u) {
            h264_file_all__DecodeForegroundLeftOverMap(map, pps.numSliceGroups, pps.topLeft, pps.bottomRight, picWidth, picHeight)
            break
        }
        case(3u) {
            h264_file_all__DecodeBoxOutMap(map, pps.sliceGroupChangeDirectionFlag, unitsInSliceGroup0, picWidth, picHeight)
            break
        }
        case(4u) {
            h264_file_all__DecodeRasterScanMap(map, pps.sliceGroupChangeDirectionFlag, sizeOfUpperLeftGroup, picSize)
            break
        }
        case(5u) {
            h264_file_all__DecodeWipeMap(map, pps.sliceGroupChangeDirectionFlag, sizeOfUpperLeftGroup, picWidth, picHeight)
            break
        }
        case(_) {
            i = 0u
            while (i < picSize) {
                map[i] = pps.sliceGroupId[i]
                i++
            }
            break
        }
    }
}

[c_function]
def h264bsdDecodeSliceHeader(var pStrmData : strmData_t?; var pSliceHeader : sliceHeader_t?; var pSeqParamSet : seqParamSet_t?;
                             var pPicParamSet : picParamSet_t?; var pNalUnit : nalUnit_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var value : uint
    var itmp : int
    var picSizeInMbs : uint
    // Code
    memset1(reinterpret<void?>(pSliceHeader), 0, uint64(typeinfo sizeof(type<sliceHeader_t>)))
    picSizeInMbs = pSeqParamSet.picWidthInMbs * pSeqParamSet.picHeightInMbs
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.firstMbInSlice = value
    if (value >= picSizeInMbs) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.sliceType = value
    // slice type has to be either I or P slice. P slice is not allowed when
    // current NAL unit is an IDR NAL unit or num_ref_frames is 0
    if (!(pSliceHeader.sliceType == uint(anon_104.I_SLICE) || pSliceHeader.sliceType == uint(int(anon_104.I_SLICE) + 5)) &&
            (!(pSliceHeader.sliceType == uint(anon_104.P_SLICE) || pSliceHeader.sliceType == uint(int(anon_104.P_SLICE) + 5)) || IS_IDR_NAL_UNIT(pNalUnit) ||
                pSeqParamSet.numRefFrames == 0)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.picParameterSetId = value
    if (pSliceHeader.picParameterSetId != pPicParamSet.picParameterSetId) {
        return uint(HANTRO_NOK)
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = 0u
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    tmp = h264bsdGetBits(pStrmData, i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (IS_IDR_NAL_UNIT(pNalUnit) && tmp != 0u) {
        return uint(HANTRO_NOK)
    }
    pSliceHeader.frameNum = tmp
    if (IS_IDR_NAL_UNIT(pNalUnit)) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.idrPicId = value
        if (value > 65535u) {
            return uint(HANTRO_NOK)
        }
    }
    if (pSeqParamSet.picOrderCntType == 0u) {
        // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
        i = 0u
        while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
            i++
        }
        i--
        tmp = h264bsdGetBits(pStrmData, i)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSliceHeader.picOrderCntLsb = tmp
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pSliceHeader.deltaPicOrderCntBottom = itmp
        }
        // check that picOrderCnt for IDR picture will be zero. See
        // DecodePicOrderCnt function to understand the logic here
        if (IS_IDR_NAL_UNIT(pNalUnit) &&
                ((pSliceHeader.picOrderCntLsb > pSeqParamSet.maxPicOrderCntLsb / 2u) ||
                    (int(pSliceHeader.picOrderCntLsb) < int(pSliceHeader.picOrderCntLsb) + pSliceHeader.deltaPicOrderCntBottom ?
                            int(pSliceHeader.picOrderCntLsb) : int(pSliceHeader.picOrderCntLsb) + pSliceHeader.deltaPicOrderCntBottom) !=
                        0)) {
            return uint(HANTRO_NOK)
        }
    }
    if ((pSeqParamSet.picOrderCntType == 1u) && pSeqParamSet.deltaPicOrderAlwaysZeroFlag == 0) {
        tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.deltaPicOrderCnt[0] = itmp
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pSliceHeader.deltaPicOrderCnt[1] = itmp
        }
        // check that picOrderCnt for IDR picture will be zero. See
        // DecodePicOrderCnt function to understand the logic here
        if (IS_IDR_NAL_UNIT(pNalUnit) &&
                (pSliceHeader.deltaPicOrderCnt[0] < pSliceHeader.deltaPicOrderCnt[0] + pSeqParamSet.offsetForTopToBottomField +
                            pSliceHeader.deltaPicOrderCnt[1] ?
                        pSliceHeader.deltaPicOrderCnt[0] :
                        pSliceHeader.deltaPicOrderCnt[0] + pSeqParamSet.offsetForTopToBottomField + pSliceHeader.deltaPicOrderCnt[1]) !=
                    0) {
            return uint(HANTRO_NOK)
        }
    }
    if (pPicParamSet.redundantPicCntPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.redundantPicCnt = value
        if (value > 127u) {
            return uint(HANTRO_NOK)
        }
    }
    if (pSliceHeader.sliceType == uint(anon_104.P_SLICE) || pSliceHeader.sliceType == uint(int(anon_104.P_SLICE) + 5)) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSliceHeader.numRefIdxActiveOverrideFlag = tmp
        if (pSliceHeader.numRefIdxActiveOverrideFlag != 0) {
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (value > 15u) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.numRefIdxL0Active = value + 1u
        } else {
            // set numRefIdxL0Active from pic param set
            // if value (minus1) in picture parameter set exceeds 15 it should
            // have been overridden here
            if (pPicParamSet.numRefIdxL0Active > 16u) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.numRefIdxL0Active = pPicParamSet.numRefIdxL0Active
        }
    }
    if (pSliceHeader.sliceType == uint(anon_104.P_SLICE) || pSliceHeader.sliceType == uint(int(anon_104.P_SLICE) + 5)) {
        tmp = h264_file_all__RefPicListReordering(pStrmData, addr(pSliceHeader.refPicListReordering), pSliceHeader.numRefIdxL0Active, pSeqParamSet.maxFrameNum)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    if (pNalUnit.nalRefIdc != 0u) {
        tmp = h264_file_all__DecRefPicMarking(pStrmData, addr(pSliceHeader.decRefPicMarking), pNalUnit.nalUnitType, pSeqParamSet.numRefFrames)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    // decode sliceQpDelta and check that initial QP for the slice will be on
    // the range [0, 51]
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSliceHeader.sliceQpDelta = itmp
    itmp += int(pPicParamSet.picInitQp)
    if ((itmp < 0) || (itmp > 51)) {
        return uint(HANTRO_NOK)
    }
    if (pPicParamSet.deblockingFilterControlPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        pSliceHeader.disableDeblockingFilterIdc = value
        if (pSliceHeader.disableDeblockingFilterIdc > 2u) {
            return uint(HANTRO_NOK)
        }
        if (pSliceHeader.disableDeblockingFilterIdc != 1u) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if ((itmp < -6) || (itmp > 6)) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.sliceAlphaC0Offset = itmp * 2
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if ((itmp < -6) || (itmp > 6)) {
                return uint(HANTRO_NOK)
            }
            pSliceHeader.sliceBetaOffset = itmp * 2
        }
    }
    if ((pPicParamSet.numSliceGroups > 1u) && (pPicParamSet.sliceGroupMapType >= 3u) && (pPicParamSet.sliceGroupMapType <= 5u)) {
        // set tmp to number of bits used to represent slice_group_change_cycle
        // in the stream
        tmp = h264_file_all__NumSliceGroupChangeCycleBits(picSizeInMbs, pPicParamSet.sliceGroupChangeRate)
        value = h264bsdGetBits(pStrmData, tmp)
        if (value == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSliceHeader.sliceGroupChangeCycle = value
        // corresponds to tmp = Ceil(picSizeInMbs / sliceGroupChangeRate)
        tmp = (picSizeInMbs + pPicParamSet.sliceGroupChangeRate - 1u) / pPicParamSet.sliceGroupChangeRate
        if (pSliceHeader.sliceGroupChangeCycle > tmp) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__NumSliceGroupChangeCycleBits(picSizeInMbs : uint; sliceGroupChangeRate : uint) : uint {
    // Variables
    var tmp : uint
    var numBits : uint
    var mask : uint
    // Code
    // compute (picSizeInMbs / sliceGroupChangeRate + 1), rounded up
    if (picSizeInMbs % sliceGroupChangeRate != 0) {
        tmp = 2u + picSizeInMbs / sliceGroupChangeRate
    } else {
        tmp = 1u + picSizeInMbs / sliceGroupChangeRate
    }
    numBits = 0u
    mask = ~0u
    // set numBits to position of right-most non-zero bit
    while (true) {
        numBits++
        if ((tmp & (mask << numBits)) == 0) {
            break
        }
    }
    numBits--
    // add one more bit if value greater than 2^numBits
    if ((tmp & uint((1 << int(numBits)) - 1)) != 0) {
        numBits++
    }
    return numBits
}

[c_function]
def private h264_file_all__RefPicListReordering(var pStrmData : strmData_t?; var pRefPicListReordering : refPicListReordering_t?; numRefIdxActive : uint;
                                                maxPicNum : uint) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var command : uint
    // Code
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pRefPicListReordering.refPicListReorderingFlagL0 = tmp
    if (pRefPicListReordering.refPicListReorderingFlagL0 != 0) {
        i = 0u
        c_do_while(command != 3u) {
            if (i > numRefIdxActive) {
                return uint(HANTRO_NOK)
            }
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(command))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (command > 3u) {
                return uint(HANTRO_NOK)
            }
            pRefPicListReordering.command[i].reorderingOfPicNumsIdc = command
            if ((command == 0u) || (command == 1u)) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                if (value >= maxPicNum) {
                    return uint(HANTRO_NOK)
                }
                pRefPicListReordering.command[i].absDiffPicNum = value + 1u
            } elif (command == 2u) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pRefPicListReordering.command[i].longTermPicNum = value
            }
            i++
        }
        // there shall be at least one reordering command if
        // refPicListReorderingFlagL0 was set
        if (i == 1u) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecRefPicMarking(var pStrmData : strmData_t?; var pDecRefPicMarking : decRefPicMarking_t?; nalUnitType : nalUnitType_e;
                                            numRefFrames : uint) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var operation : uint
    // variables for error checking purposes, store number of memory
    // management operations of certain type
    var num4 : uint = 0u
    var num5 : uint = 0u
    var num6 : uint = 0u
    var num1to3 : uint = 0u
    // Code
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pDecRefPicMarking.noOutputOfPriorPicsFlag = tmp
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pDecRefPicMarking.longTermReferenceFlag = tmp
        if (numRefFrames == 0 && pDecRefPicMarking.longTermReferenceFlag != 0) {
            return uint(HANTRO_NOK)
        }
    } else {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pDecRefPicMarking.adaptiveRefPicMarkingModeFlag = tmp
        if (pDecRefPicMarking.adaptiveRefPicMarkingModeFlag != 0) {
            i = 0u
            c_do_while(operation != 0u) {
                // see explanation of the MAX_NUM_MMC_OPERATIONS in
                // slice_header.h
                if (i > (2u * numRefFrames + 2u)) {
                    return uint(HANTRO_NOK)
                }
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(operation))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                if (operation > 6u) {
                    return uint(HANTRO_NOK)
                }
                pDecRefPicMarking.operation[i].memoryManagementControlOperation = operation
                if ((operation == 1u) || (operation == 3u)) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pDecRefPicMarking.operation[i].differenceOfPicNums = value + 1u
                }
                if (operation == 2u) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pDecRefPicMarking.operation[i].longTermPicNum = value
                }
                if ((operation == 3u) || (operation == 6u)) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    pDecRefPicMarking.operation[i].longTermFrameIdx = value
                }
                if (operation == 4u) {
                    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                    if (tmp != uint(HANTRO_OK)) {
                        return tmp
                    }
                    // value shall be in range [0, numRefFrames]
                    if (value > numRefFrames) {
                        return uint(HANTRO_NOK)
                    }
                    if (value == 0u) {
                        pDecRefPicMarking.operation[i].maxLongTermFrameIdx = uint(anon_105.NO_LONG_TERM_FRAME_INDICES)
                    } else {
                        pDecRefPicMarking.operation[i].maxLongTermFrameIdx = value - 1u
                    }
                    num4++
                }
                if (operation == 5u) {
                    num5++
                }
                if (operation != 0 && operation <= 3u) {
                    num1to3++
                }
                if (operation == 6u) {
                    num6++
                }
                i++
            }
            // error checking
            if (num4 > 1u || num5 > 1u || num6 > 1u || (num1to3 != 0 && num5 != 0)) {
                return uint(HANTRO_NOK)
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckPpsId(var pStrmData : strmData_t?; var picParamSetId : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // don't touch original stream position params
    *addr(tmpStrmData[0]) = *pStrmData
    // first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value >= uint(MAX_NUM_PIC_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    *picParamSetId = value
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckFrameNum(var pStrmData : strmData_t?; maxFrameNum : uint; var frameNum : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var tmpStrmData : strmData_t[1]
    // Code
    // don't touch original stream position params
    *addr(tmpStrmData[0]) = *pStrmData
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = 0u
    while (maxFrameNum >> i != 0) {
        i++
    }
    i--
    // frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    *frameNum = tmp
    return uint(HANTRO_OK)
}

