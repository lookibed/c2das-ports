            // default_sample_size
            var _t814 = p
            p++
            *_t814 = uint8(0 >> 8 * 3)
            var _t815 = p
            p++
            *_t815 = uint8(0 >> 8 * 2)
            var _t816 = p
            p++
            *_t816 = uint8(0 >> 8 * 1)
            var _t817 = p
            p++
            *_t817 = uint8(0 >> 8 * 0)
            // default_sample_flags
            var _t818 = p
            p++
            *_t818 = uint8(0 >> 8 * 3)
            var _t819 = p
            p++
            *_t819 = uint8(0 >> 8 * 2)
            var _t820 = p
            p++
            *_t820 = uint8(0 >> 8 * 1)
            var _t821 = p
            p++
            *_t821 = uint8(0 >> 8 * 0)
            stack--
            (*stack)[0] = uint8(int64(p - *stack) >> int64(8 * 3))
            (*stack)[1] = uint8(int64(p - *stack) >> int64(8 * 2))
            (*stack)[2] = uint8(int64(p - *stack) >> int64(8 * 1))
            (*stack)[3] = uint8(int64(p - *stack))
        }
        stack--
        (*stack)[0] = uint8(int64(p - *stack) >> int64(8 * 3))
        (*stack)[1] = uint8(int64(p - *stack) >> int64(8 * 2))
        (*stack)[2] = uint8(int64(p - *stack) >> int64(8 * 1))
        (*stack)[3] = uint8(int64(p - *stack))
    }
    // moov atom
    stack--
    (*stack)[0] = uint8(int64(p - *stack) >> int64(8 * 3))
    (*stack)[1] = uint8(int64(p - *stack) >> int64(8 * 2))
    (*stack)[2] = uint8(int64(p - *stack) >> int64(8 * 1))
    (*stack)[3] = uint8(int64(p - *stack))
    let _t822 = uint(int64(p - base)) <= index_bytes
    err = invoke(mux.write_callback, mux.write_pos, reinterpret<void?>(base), uint64(int64(p - base)), mux.token)
    mux.write_pos += int64(p - base)
    free1(reinterpret<void?>(base))
    return err
}

[c_function]
def MP4E_close(var mux : MP4E_mux_tag?) : int {
    var err : int = MP4E_STATUS_OK
    var ntracks : uint
    if (mux == null) {
        return MP4E_STATUS_BAD_ARGUMENTS
    }
    if (mux.enable_fragmentation == 0) {
        err = h264_file_all__mp4e_flush_index(mux)
    }
    if (mux.text_comment != null) {
        free1(reinterpret<void?>(mux.text_comment))
    }
    ntracks = uint(uint64(mux.tracks.bytes) / uint64(typeinfo sizeof(type<track_t>)))
    for (ntr in urange(ntracks)) {
        var tr : track_t? = reinterpret<track_t?>(mux.tracks.data) + ntr
        h264_file_all__minimp4_vector_reset(addr(tr.vsps))
        h264_file_all__minimp4_vector_reset(addr(tr.vpps))
        h264_file_all__minimp4_vector_reset(addr(tr.smpl))
        h264_file_all__minimp4_vector_reset(addr(tr.pending_sample))
    }
    h264_file_all__minimp4_vector_reset(addr(mux.tracks))
    free1(reinterpret<void?>(mux))
    return err
}

def private h264_file_all__show_bits(var bs : bit_reader_t?; n : int) : uint {
    var retval : uint
    let _t0 = n > 0 && n <= 16
    retval = bs.cache >> uint(32 - n)
    return retval
}

[c_function]
def private h264_file_all__flush_bits(var bs : bit_reader_t?; n : int) {
    let _t0 = n >= 0 && n <= 16
    bs.cache <<= uint(n)
    bs.cache_free_bits += n
    if (bs.cache_free_bits >= 0) {
        bs.cache |= uint(int(uint16(int(*bs.buf) << 8)) | (int(*bs.buf) >> 8)) << uint(bs.cache_free_bits)
        bs.buf++
        bs.cache_free_bits -= 16
    }
}

def private h264_file_all__get_bits(var bs : bit_reader_t?; n : int) : uint {
    let retval : uint = h264_file_all__show_bits(bs, n)
    h264_file_all__flush_bits(bs, n)
    return retval
}

[c_function]
def private h264_file_all__set_pos_bits(var bs : bit_reader_t?; pos_bits : uint) {
    let _t0 = int(pos_bits) >= 0
    bs.buf = bs.origin + pos_bits / 16u
    bs.cache = 0u
    bs.cache_free_bits = 16
    h264_file_all__flush_bits(bs, 0)
    h264_file_all__flush_bits(bs, int(pos_bits & 15u))
}

[c_function]
def private h264_file_all__get_pos_bits(var bs : bit_reader_t?) : uint {
    // Current bitbuffer position =
    // position of next wobits in the internal buffer
    // minus bs, available in bit cache wobits
    var pos_bits : uint = uint(int64(bs.buf - bs.origin)) * 16u
    pos_bits -= uint(16 - bs.cache_free_bits)
    let _t0 = int(pos_bits) >= 0
    return pos_bits
}

def private h264_file_all__remaining_bits(var bs : bit_reader_t?) : int {
    return int(bs.origin_bytes * 8u - h264_file_all__get_pos_bits(bs))
}

[c_function]
def private h264_file_all__init_bits(var bs : bit_reader_t?; var data : void?; data_bytes : uint) {
    bs.origin = reinterpret<uint16?>(data)
    bs.origin_bytes = data_bytes
    h264_file_all__set_pos_bits(bs, 0u)
}

// Unsigned Golomb code
def private h264_file_all__ue_bits(var bs : bit_reader_t?) : int {
    var clz : int
    var val : int
    clz = 0
    while (h264_file_all__get_bits(bs, 1) == 0) {
        clz++
    }
    // get_bits(bs, clz + 1);
    val = int(uint((1 << clz) - 1) + (clz != 0 ? h264_file_all__get_bits(bs, clz) : 0u))
    return val
}

[c_function]
def private h264_file_all__h264e_bs_put_bits(var bs : bs_t?; n : uint; val : uint) {
    let _t0 = (val >> n) == 0
    bs.shift = int(uint(bs.shift) - n)
    let _t1 = n <= 32u
    if (bs.shift < 0) {
        let _t2 = -bs.shift < 32
        bs.cache |= val >> uint(-bs.shift)
        var _t3 = bs.buf
        bs.buf++
        *_t3 = ((bs.cache >> 24u) & 255u) | ((bs.cache >> 8u) & 65280u) | ((bs.cache << 8u) & 16711680u) | ((bs.cache & 255u) << 24u)
        bs.shift = 32 + bs.shift
        bs.cache = 0u
    }
    bs.cache |= val << uint(bs.shift)
}

[c_function]
def private h264_file_all__h264e_bs_flush(var bs : bs_t?) {
    *bs.buf = ((bs.cache >> 24u) & 255u) | ((bs.cache >> 8u) & 65280u) | ((bs.cache << 8u) & 16711680u) | ((bs.cache & 255u) << 24u)
}

[c_function]
def private h264_file_all__h264e_bs_get_pos_bits(var bs : bs_t?) : uint {
    var pos_bits : uint = uint(int64(bs.buf - bs.origin) * int64(BS_BITS))
    pos_bits += uint(BS_BITS - bs.shift)
    let _t0 = int(pos_bits) >= 0
    return pos_bits
}

def private h264_file_all__h264e_bs_byte_align(var bs : bs_t?) : uint {
    let pos : int = int(h264_file_all__h264e_bs_get_pos_bits(bs))
    h264_file_all__h264e_bs_put_bits(bs, uint(-pos & 7), 0u)
    return uint(pos + (-pos & 7))
}

// Golomb code
// 0 => 1
// 1 => 01 0
// 2 => 01 1
// 3 => 001 00
// 4 => 001 01
// [0] => 1
// [1..2] => 01x
// [3..6] => 001xx
// [7..14] => 0001xxx
def private h264_file_all__h264e_bs_put_golomb(var bs : bs_t?; val : uint) {
    var size : int = 0
    var t : uint = val + 1u
    while (true) {
        size++
        t >>= 1u
        if (t == 0) {
            break
        }
    }
    h264_file_all__h264e_bs_put_bits(bs, uint(2 * size - 1), val + 1u)
}

[c_function]
def private h264_file_all__h264e_bs_init_bits(var bs : bs_t?; var data : void?) {
    bs.origin = reinterpret<uint?>(data)
    bs.buf = bs.origin
    bs.shift = BS_BITS
    bs.cache = 0u
}

[c_function]
def private h264_file_all__find_mem_cache(var cache : void ??; var cache_bytes : int?; cache_size : int; var mem : void?; bytes : int) : int {
    if (bytes == 0) {
        return -1
    }
    for (i in range(cache_size)) {
        if (cache_bytes[i] == bytes && memcmp1(mem, cache[i], uint64(bytes)) == 0) {
            // found
            return i
        }
    }
    for (i in range(cache_size)) {
        if (cache_bytes[i] == 0) {
            cache[i] = malloc1(uint64(bytes))
            if (cache[i] != null) {
                memcpy1(cache[i], mem, uint64(bytes))
                cache_bytes[i] = bytes
            }
            // put in
            return i
        }
    }
    // no room
    return -1
}

// 7.4.1.1. "Encapsulation of an SODB within an RBSP"
[c_function]
def private h264_file_all__remove_nal_escapes(var dst : uint8?; var src : uint8?; h264_data_bytes : int) : int {
    var i : int = 0
    var j : int = 0
    var zero_cnt : int = 0
    j = 0
    while (j < h264_data_bytes) {
        if (zero_cnt == 2 && int(src[j]) <= 3) {
            if (src[j] == 3) {
                if (j == h264_data_bytes - 1) {
                } elif (int(src[j + 1]) <= 3) {
                    // cabac_zero_word: no action
                    j++
                    zero_cnt = 0
                } else {
                }
            } else {
                // TODO: assume end-of-nal
                // return 0;
                return 0
            }
        }
        let _t0 = i
        i++
        dst[_t0] = src[j]
        if (src[j] != 0) {
            zero_cnt = 0
        } else {
            zero_cnt++
        }
        j++
    }
    // while (--j > i) src[j] = 0;
    return i
}

// Put NAL escape codes to the output bitstream
[c_function]
def private h264_file_all__nal_put_esc(var d : uint8?; var s : uint8?; n : int) : int {
    var j : int = 4
    var cntz : int = 0
    // start code
    d[2] = 0u8
    d[1] = d[2]
    d[0] = d[1]
    d[3] = 1u8
    for (i in range(n)) {
        var _t0 = s
        s++
        let byte : uint8 = *_t0
        if (cntz == 2 && int(byte) <= 3) {
            let _t1 = j
            j++
            d[_t1] = 3u8
            cntz = 0
        }
        if (byte != 0) {
            cntz = 0
        } else {
            cntz++
        }
        let _t2 = j
        j++
        d[_t2] = byte
    }
    return j
}

def private h264_file_all__copy_bits(var bs : bit_reader_t?; var bd : bs_t?) {
    var cb : uint
    var bits : uint
    var bit_count : int = h264_file_all__remaining_bits(bs)
    while (bit_count > 7) {
        cb = uint(MINIMP4_MIN(bit_count - 7, 8))
        bits = h264_file_all__get_bits(bs, int(cb))
        h264_file_all__h264e_bs_put_bits(bd, cb, bits)
        bit_count = int(uint(bit_count) - cb)
    }
    // cut extra zeros after stop-bit
    bits = h264_file_all__get_bits(bs, bit_count)
    while (bit_count != 0 && (~bits & 1u) != 0) {
        bits >>= 1u
        bit_count--
    }
    if (bit_count != 0) {
        h264_file_all__h264e_bs_put_bits(bd, uint(bit_count), bits)
    }
}

[c_function]
def private h264_file_all__change_sps_id(var bs : bit_reader_t?; var bd : bs_t?; new_id : int; var old_id : int?) : int {
    var bits : uint
    var sps_id : uint
    var bytes : uint
    for (i in urange(3u)) {
        bits = h264_file_all__get_bits(bs, 8)
        h264_file_all__h264e_bs_put_bits(bd, 8u, bits)
    }
    // max = 31
    sps_id = uint(h264_file_all__ue_bits(bs))
    *old_id = int(sps_id)
    sps_id = uint(new_id)
    let _t0 = sps_id <= 31u
    h264_file_all__h264e_bs_put_golomb(bd, sps_id)
    h264_file_all__copy_bits(bs, bd)
    bytes = h264_file_all__h264e_bs_byte_align(bd) / 8u
    h264_file_all__h264e_bs_flush(bd)
    return int(bytes)
}

[c_function]
def private h264_file_all__patch_pps(var h : h264_sps_id_patcher_t?; var bs : bit_reader_t?; var bd : bs_t?; new_pps_id : int; var old_id : int?) : int {
    var bytes : int
    // max = 255
    var pps_id : uint = uint(h264_file_all__ue_bits(bs))
    // max = 31
    var sps_id : uint = uint(h264_file_all__ue_bits(bs))
    *old_id = int(pps_id)
    sps_id = uint(h.map_sps[sps_id])
    pps_id = uint(new_pps_id)
    let _t0 = sps_id <= 31u
    let _t1 = pps_id <= 255u
    h264_file_all__h264e_bs_put_golomb(bd, pps_id)
    h264_file_all__h264e_bs_put_golomb(bd, sps_id)
    h264_file_all__copy_bits(bs, bd)
    bytes = int(h264_file_all__h264e_bs_byte_align(bd) / 8u)
    h264_file_all__h264e_bs_flush(bd)
    return bytes
}

def private h264_file_all__patch_slice_header(var h : h264_sps_id_patcher_t?; var bs : bit_reader_t?; var bd : bs_t?) {
    let first_mb_in_slice : uint = uint(h264_file_all__ue_bits(bs))
    let slice_type : uint = uint(h264_file_all__ue_bits(bs))
    var pps_id : uint = uint(h264_file_all__ue_bits(bs))
    pps_id = uint(h.map_pps[pps_id])
    let _t0 = pps_id <= 255u
    h264_file_all__h264e_bs_put_golomb(bd, first_mb_in_slice)
    h264_file_all__h264e_bs_put_golomb(bd, slice_type)
    h264_file_all__h264e_bs_put_golomb(bd, pps_id)
    h264_file_all__copy_bits(bs, bd)
}

[c_function]
def private h264_file_all__transcode_nalu(var h : h264_sps_id_patcher_t?; var src : uint8?; var nalu_bytes : int; var dst : uint8?) : int {
    var old_id : int
    var bst : bit_reader_t[1]
    var bdt : bs_t[1]
    var bs : bit_reader_t[1]
    var bd : bs_t[1]
    let payload_type : int = int(src[0]) & 31
    *dst = *src
    h264_file_all__h264e_bs_init_bits(addr(bd[0]), reinterpret<void?>(dst + 1))
    h264_file_all__init_bits(addr(bs[0]), reinterpret<void?>(src + 1), uint(nalu_bytes - 1))
    h264_file_all__h264e_bs_init_bits(addr(bdt[0]), reinterpret<void?>(dst + 1))
    h264_file_all__init_bits(addr(bst[0]), reinterpret<void?>(src + 1), uint(nalu_bytes - 1))
    c_switch(payload_type) {
        case(7) {
            {
                let cb : int = h264_file_all__change_sps_id(addr(bst[0]), addr(bdt[0]), 0, addr(old_id))
                let id : int = h264_file_all__find_mem_cache(addr(h.sps_cache[0]), addr(h.sps_bytes[0]), MINIMP4_MAX_SPS, reinterpret<void?>(dst + 1), cb)
                if (id == -1) {
                    return 0
                }
                h.map_sps[old_id] = id
                h264_file_all__change_sps_id(addr(bs[0]), addr(bd[0]), id, addr(old_id))
            }
            break
        }
        case(8) {
            {
                let cb : int = h264_file_all__patch_pps(h, addr(bst[0]), addr(bdt[0]), 0, addr(old_id))
                let id : int = h264_file_all__find_mem_cache(addr(h.pps_cache[0]), addr(h.pps_bytes[0]), MINIMP4_MAX_PPS, reinterpret<void?>(dst + 1), cb)
                if (id == -1) {
                    return 0
                }
                h.map_pps[old_id] = id
                h264_file_all__patch_pps(h, addr(bs[0]), addr(bd[0]), id, addr(old_id))
            }
            break
        }
        case(1, 2, 5) {
            h264_file_all__patch_slice_header(h, addr(bs[0]), addr(bd[0]))
            break
        }
        case(_) {
            memcpy1(reinterpret<void?>(dst), reinterpret<void?>(src), uint64(nalu_bytes))
            return nalu_bytes
        }
    }
    nalu_bytes = int(1u + h264_file_all__h264e_bs_byte_align(addr(bd[0])) / 8u)
    h264_file_all__h264e_bs_flush(addr(bd[0]))
    return nalu_bytes
}

// Set pointer just after start code (00 .. 00 01), or to EOF if not found:
// NZ NZ ... NZ 00 00 00 00 01 xx xx ... xx (EOF)
// ^ ^
// non-zero head.............. here ....... or here if no start code found
[c_function]
def private h264_file_all__find_start_code(var h264_data : uint8?; h264_data_bytes : int; var zcount : int?) : uint8? {
    var eof : uint8? = h264_data + h264_data_bytes
    var p : uint8? = h264_data
    c_do_while(reinterpret<uint64>(p) < reinterpret<uint64>(eof)) {
        var zero_cnt : int = 1
        var found : uint8? = reinterpret<uint8?>(memchr1(reinterpret<void?>(p), 0, uint64(int64(eof - p))))
        p = found != null ? found : eof
        while (reinterpret<uint64>(p + zero_cnt) < reinterpret<uint64>(eof) && p[zero_cnt] == 0) {
            zero_cnt++
        }
        if (zero_cnt >= 2 && p[zero_cnt] == 1) {
            *zcount = zero_cnt + 1
            return p + zero_cnt + 1
        }
        p += zero_cnt
    }
    *zcount = 0
    return eof
}

// Locate NAL unit in given buffer, and calculate it's length
[c_function]
def private h264_file_all__find_nal_unit(var h264_data : uint8?; h264_data_bytes : int; var pnal_unit_bytes : int?) : uint8? {
    var eof : uint8? = h264_data + h264_data_bytes
    var zcount : int
    var start : uint8? = h264_file_all__find_start_code(h264_data, h264_data_bytes, addr(zcount))
    var stop : uint8? = start
    if (start != null) {
        stop = h264_file_all__find_start_code(start, int(int64(eof - start)), addr(zcount))
        while (reinterpret<uint64>(stop) > reinterpret<uint64>(start) && stop[-1] == 0) {
            stop--
        }
    }
    *pnal_unit_bytes = int(int64(stop - start) - int64(zcount))
    return start
}

[c_function]
def mp4_h26x_write_init(var h : mp4_h26x_writer_tag?; var mux : MP4E_mux_tag?; width : int; height : int; is_hevc : int) : int {
    var tr : MP4E_track_t
    tr.track_media_kind = track_media_kind_t.e_video
    tr.language[0] = uint8('u')
    tr.language[1] = uint8('n')
    tr.language[2] = uint8('d')
    tr.language[3] = 0u8
    tr.object_type_indication = uint(is_hevc != 0 ? MP4_OBJECT_TYPE_HEVC : MP4_OBJECT_TYPE_AVC)
    tr.time_scale = 90000u
    tr.default_duration = 0u
    tr.u.v.width = width
    tr.u.v.height = height
    h.mux_track_id = MP4E_add_track(mux, addr(tr))
    h.mux = mux
    h.is_hevc = is_hevc
    h.need_vps = is_hevc
    h.need_sps = 1
    h.need_pps = 1
    h.need_idr = 1
    memset1(reinterpret<void?>(addr(h.sps_patcher)), 0, uint64(typeinfo sizeof(type<h264_sps_id_patcher_t>)))
    return MP4E_STATUS_OK
}

[c_function]
def mp4_h26x_write_close(var h : mp4_h26x_writer_tag?) {
    var p : h264_sps_id_patcher_t? = addr(h.sps_patcher)
    for (i in range(MINIMP4_MAX_SPS)) {
        if (p.sps_cache[i] != null) {
            free1(p.sps_cache[i])
        }
    }
    for (i in range(MINIMP4_MAX_PPS)) {
        if (p.pps_cache[i] != null) {
            free1(p.pps_cache[i])
        }
    }
    memset1(reinterpret<void?>(h), 0, uint64(typeinfo sizeof(type<mp4_h26x_writer_tag>)))
}

[c_function]
def private h264_file_all__mp4_h265_write_nal(var h : mp4_h26x_writer_tag?; var nal : uint8?; sizeof_nal : int; timeStamp90kHz_next : uint) : int {
    let payload_type : int = (int(nal[0]) >> 1) & 63
    let is_intra : int = int_of(payload_type >= HEVC_NAL_BLA_W_LP && payload_type <= HEVC_NAL_CRA_NUT)
    var err : int = MP4E_STATUS_OK
    // printf("payload_type=%d, intra=%d\n", payload_type, is_intra);
    if (is_intra != 0 && h.need_sps == 0 && h.need_pps == 0 && h.need_vps == 0) {
        h.need_idr = 0
    }
    c_switch(payload_type) {
        case(32) {
            MP4E_set_vps(h.mux, h.mux_track_id, reinterpret<void?>(nal), sizeof_nal)
            h.need_vps = 0
            break
        }
        case(33) {
            MP4E_set_sps(h.mux, h.mux_track_id, reinterpret<void?>(nal), sizeof_nal)
            h.need_sps = 0
            break
        }
        case(34) {
            MP4E_set_pps(h.mux, h.mux_track_id, reinterpret<void?>(nal), sizeof_nal)
            h.need_pps = 0
            break
        }
        case(_) {
            if (h.need_vps != 0 || h.need_sps != 0 || h.need_pps != 0 || h.need_idr != 0) {
                return MP4E_STATUS_BAD_ARGUMENTS
            }
            {
                var tmp : uint8? = reinterpret<uint8?>(malloc1(uint64(4 + sizeof_nal)))
                if (tmp == null) {
                    return MP4E_STATUS_NO_MEMORY
                }
                var sample_kind : int = MP4E_SAMPLE_DEFAULT
                tmp[0] = uint8(sizeof_nal >> 24)
                tmp[1] = uint8(sizeof_nal >> 16)
                tmp[2] = uint8(sizeof_nal >> 8)
                tmp[3] = uint8(sizeof_nal)
                memcpy1(reinterpret<void?>(tmp + 4), reinterpret<void?>(nal), uint64(sizeof_nal))
                if (is_intra != 0) {
                    sample_kind = MP4E_SAMPLE_RANDOM_ACCESS
                }
                err = MP4E_put_sample(h.mux, h.mux_track_id, reinterpret<void?>(tmp), 4 + sizeof_nal, int(timeStamp90kHz_next), sample_kind)
                free1(reinterpret<void?>(tmp))
            }
            break
        }
    }
    return err
}

[c_function]
def mp4_h26x_write_nal(var h : mp4_h26x_writer_tag?; var nal : uint8?; length : int; timeStamp90kHz_next : uint) : int {
    var eof : uint8? = nal + length
    var payload_type : int
    var sizeof_nal : int
    var err : int = MP4E_STATUS_OK
    {
        var _f = false
        while (true) {
            if (_f) {
                nal++
            }
            _f = true
            var nal1 : uint8?
            var nal2 : uint8?
            nal = h264_file_all__find_nal_unit(nal, int(int64(eof - nal)), addr(sizeof_nal))
            if (sizeof_nal == 0) {
                break
            }
            if (h.is_hevc != 0) {
                {
                    let err1 : int = h264_file_all__mp4_h265_write_nal(h, nal, sizeof_nal, timeStamp90kHz_next)
                    if (err1 != 0) {
                        return err1
                    }
                }
                continue
            }
            payload_type = int(nal[0]) & 31
            if (9 == payload_type) {
                // access unit delimiter, nothing to be done
                continue
            }
            // Transcode SPS, PPS and slice headers, reassigning ID's for SPS and PPS:
            // - assign unique ID's to different SPS and PPS
            // - assign same ID's to equal (except ID) SPS and PPS
            // - save all different SPS and PPS
            nal1 = reinterpret<uint8?>(malloc1(uint64(sizeof_nal * 17 / 16 + 32)))
            if (nal1 == null) {
                return MP4E_STATUS_NO_MEMORY
            }
            nal2 = reinterpret<uint8?>(malloc1(uint64(sizeof_nal * 17 / 16 + 32)))
            if (nal2 == null) {
                free1(reinterpret<void?>(nal1))
                return MP4E_STATUS_NO_MEMORY
            }
            sizeof_nal = h264_file_all__remove_nal_escapes(nal2, nal, sizeof_nal)
            if (sizeof_nal != 0) {
                goto label 2
            }
            label 1:  // exit_with_free
            free1(reinterpret<void?>(nal1))
            free1(reinterpret<void?>(nal2))
            return MP4E_STATUS_BAD_ARGUMENTS
            label 2:  // end if
            sizeof_nal = h264_file_all__transcode_nalu(addr(h.sps_patcher), nal2, sizeof_nal, nal1)
            sizeof_nal = h264_file_all__nal_put_esc(nal2, nal1, sizeof_nal)
            c_switch(payload_type) {
                case(7) {
                    MP4E_set_sps(h.mux, h.mux_track_id, reinterpret<void?>(nal2 + 4), sizeof_nal - 4)
                    h.need_sps = 0
                    break
                }
                case(8) {
                    if (h.need_sps != 0) {
                        goto label 1
                    }
                    MP4E_set_pps(h.mux, h.mux_track_id, reinterpret<void?>(nal2 + 4), sizeof_nal - 4)
                    h.need_pps = 0
                    break
                }
                case(5) {
                    if (h.need_sps != 0) {
                        goto label 1
                    }
                    h.need_idr = 0
                }
                case(_) {
                    // flow through
                    if (h.need_sps != 0) {
                        goto label 1
                    }
                    if (h.need_pps == 0 && h.need_idr == 0) {
                        var bs : bit_reader_t[1]
                        h264_file_all__init_bits(addr(bs[0]), reinterpret<void?>(nal + 1), uint(sizeof_nal - 4 - 1))
                        let first_mb_in_slice : uint = uint(h264_file_all__ue_bits(addr(bs[0])))
                        // unsigned slice_type = ue_bits(bs);
                        var sample_kind : int = MP4E_SAMPLE_DEFAULT
                        nal2[0] = uint8((sizeof_nal - 4) >> 24)
                        nal2[1] = uint8((sizeof_nal - 4) >> 16)
                        nal2[2] = uint8((sizeof_nal - 4) >> 8)
                        nal2[3] = uint8(sizeof_nal - 4)
                        if (first_mb_in_slice != 0) {
                            sample_kind = MP4E_SAMPLE_CONTINUATION
                        } elif (payload_type == 5) {
                            sample_kind = MP4E_SAMPLE_RANDOM_ACCESS
                        }
                        err = MP4E_put_sample(h.mux, h.mux_track_id, reinterpret<void?>(nal2), sizeof_nal, int(timeStamp90kHz_next), sample_kind)
                    }
                    break
                }
            }
            free1(reinterpret<void?>(nal1))
            free1(reinterpret<void?>(nal2))
            // No SPS/PPS transcoding
            // This branch assumes that encoder use correct SPS/PPS ID's
            // flow through
            if (err != 0) {
                break
            }
        }
    }
    return err
}

[c_function]
def private h264_file_all__minimp4_fgets(var mp4 : MP4D_demux_tag?) : int {
    var c : uint8
    if (invoke(mp4.read_callback, mp4.read_pos, reinterpret<void?>(addr(c)), 1ul, mp4.token) != 0) {
        return -1
    }
    mp4.read_pos++
    return int(c)
}

// Read given number of bytes from input stream
// Used to read box headers
[c_function]
def private h264_file_all__minimp4_read(var mp4 : MP4D_demux_tag?; nb : int; var eof_flag : int?) : uint {
    var v : uint = 0u
    var last_byte : int
    c_switch(nb) {
        case(4) {
            v = (v << 8u) | uint(h264_file_all__minimp4_fgets(mp4))
        }
        case(3) {
            v = (v << 8u) | uint(h264_file_all__minimp4_fgets(mp4))
        }
        case(2) {
            v = (v << 8u) | uint(h264_file_all__minimp4_fgets(mp4))
        }
        case(1, _) {
            last_byte = h264_file_all__minimp4_fgets(mp4)
            v = (v << 8u) | uint(last_byte)
        }
    }
    if (last_byte < 0) {
        *eof_flag = 1
    }
    return v
}

// Read given number of bytes, but no more than *payload_bytes specifies...
// Used to read box payload
[c_function]
def private h264_file_all__read_payload(var mp4 : MP4D_demux_tag?; var nb : uint; var payload_bytes : uint64?; var eof_flag : int?) : uint {
    if (*payload_bytes < uint64(nb)) {
        *eof_flag = 1
        nb = uint(int(*payload_bytes))
    }
    *payload_bytes -= uint64(nb)
    return h264_file_all__minimp4_read(mp4, int(nb), eof_flag)
}

// Skips given number of bytes.
// Avoid math operations with fpos_t
[c_function]
def private h264_file_all__my_fseek(var mp4 : MP4D_demux_tag?; pos : uint64; var eof_flag : int?) {
    mp4.read_pos = int64(uint64(mp4.read_pos) + pos)
    if (mp4.read_pos >= mp4.read_size) {
        *eof_flag = 1
    }
}

[c_function]
def MP4D_open(var mp4 : MP4D_demux_tag?; read_callback : function<(a0 : int64; var a1 : void?; a2 : uint64; var a3 : void?) : int>; var token : void?;
              file_size : int64) : int {
    // box stack size
    var depth : int = 0
    // remaining bytes for box in the stack
    // kind of box children's: OD chunks handled in the same manner as name chunks
    var stack : anon_748[64]
    // path of current element: List0/List1/... etc
    var eof_flag : int = 0
    var i : uint
    var tr : MP4D_track_t? = null
    if (mp4 == null || read_callback == null) {
        return 0
    }
    memset1(reinterpret<void?>(mp4), 0, uint64(typeinfo sizeof(type<MP4D_demux_tag>)))
    mp4.read_callback = read_callback
    mp4.token = token
    mp4.read_size = file_size
    // start with atom box
    stack[0].format = boxtype_t.BOX_ATOM
    // never accessed
    stack[0].bytes = 0ul
    c_do_while(eof_flag == 0) {
        // List of boxes, derived from 'FullBox'
        // ~~~~~~~~~~~~~~~~~~~~~
        // need read version field and check version for these boxes
        // Android can produce meta box without 'FullBox' field, comment this line to simulate the bug
        // esds does not use track, but switches to OD mode. Check here, to avoid OD check
        // List of boxes, which contains other boxes ('envelopes')
        // Parser will descend down for boxes in this list, otherwise parsing will proceed to
        // the next sibling box
        // OD boxes handled in the same way as atom boxes...
        // TODO: BOX_esds can be used for both audio and video, but this code supports audio only!
        // {BOX_moof, BOX_ATOM},
        // {BOX_avc2, BOX_ATOM},
        // {BOX_svc1, BOX_ATOM},
        var FullAtomVersionAndFlags : uint = 0u
        var payload_bytes : uint64
        var box_bytes : uint64
        var box_name : uint
        var ptag : uint8 ?? = null
        var read_bytes : int = 0
        // Read header box type and it's length
        if (stack[depth].format == boxtype_t.BOX_ATOM) {
            box_bytes = uint64(h264_file_all__minimp4_read(mp4, 4, addr(eof_flag)))
            label 1:  // broken_android_meta_hack
            if (eof_flag != 0) {
                // normal exit
                break
            }
            if (box_bytes >= 2ul && box_bytes < 8ul) {
                if (depth == 0) {
                    break
                } else {
                    MP4D_close(mp4)
                    return 0
                }
            }
            box_name = h264_file_all__minimp4_read(mp4, 4, addr(eof_flag))
            read_bytes = 8
            // Decode box size
            // standard indication of 'till eof' size
            if (box_bytes == 0ul || box_bytes == uint64(4294967295u)) {
                // some files uses non-standard 'till eof' signaling
                box_bytes = ~0ul
            }
            payload_bytes = box_bytes - 8ul
            // 64-bit sizes
            if (box_bytes == 1ul) {
                box_bytes = uint64(h264_file_all__minimp4_read(mp4, 4, addr(eof_flag)))
                if (box_bytes != 0) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                box_bytes = uint64(h264_file_all__minimp4_read(mp4, 4, addr(eof_flag)))
                if (box_bytes < 16ul) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                payload_bytes = box_bytes - 16ul
            }
            // Read and check box version for some boxes
            i = 0u
            while (uint64(i) < uint64(typeinfo sizeof(type<anon_751[13]>)) / uint64(typeinfo sizeof(type<anon_751>))) {
                if (box_name == MP4D_open_g_fullbox[i].name) {
                    FullAtomVersionAndFlags = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                    read_bytes += 4
                    // Fix invalid BOX_meta, found in some Android-produced MP4
                    // This branch is optional: bad box would be skipped
                    if (box_name == uint(anon_644.BOX_meta)) {
                        if (FullAtomVersionAndFlags >= 8u && uint64(FullAtomVersionAndFlags) < payload_bytes) {
                            if (box_bytes > stack[depth].bytes) {
                                if (depth == 0) {
                                    break
                                } else {
                                    MP4D_close(mp4)
                                    return 0
                                }
                            }
                            stack[depth].bytes -= box_bytes
                            depth++
                            // +4 need for missing header
                            stack[depth].bytes = payload_bytes + 4ul
                            stack[depth].format = boxtype_t.BOX_ATOM
                            box_bytes = uint64(FullAtomVersionAndFlags)
                            goto label 1
                        }
                    }
                    // FIX_BAD_ANDROID_META_BOX
                    if ((FullAtomVersionAndFlags >> 24u) > MP4D_open_g_fullbox[i].max_version) {
                        if (depth == 0) {
                            break
                        } else {
                            MP4D_close(mp4)
                            return 0
                        }
                    }
                    if (MP4D_open_g_fullbox[i].use_track_flag != 0 && tr == null) {
                        if (depth == 0) {
                            break
                        } else {
                            MP4D_close(mp4)
                            return 0
                        }
                    }
                }
                i++
            }
        } else {
            // stack[depth].format == BOX_OD
            var val : int
            // 1-byte box type
            box_name = uint(anon_644.OD_BASE) + h264_file_all__minimp4_read(mp4, 1, addr(eof_flag))
            read_bytes += 1
            if (eof_flag != 0) {
                break
            }
            payload_bytes = 0ul
            box_bytes = 1ul
            c_do_while((val & 128) != 0) {
                val = int(h264_file_all__minimp4_read(mp4, 1, addr(eof_flag)))
                read_bytes += 1
                if (eof_flag != 0) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                payload_bytes = (payload_bytes << 7ul) | uint64(val & 127)
                box_bytes++
            }
            box_bytes += payload_bytes
        }
        // Check that box size <= parent size
        if (depth != 0) {
            // Skip box with bad size
            let _t0 = box_bytes > 0ul
            if (box_bytes > stack[depth].bytes) {
                box_bytes = stack[depth].bytes
                box_name = 0u
                payload_bytes = box_bytes - uint64(read_bytes)
            }
            stack[depth].bytes -= box_bytes
        }
        // Read box header
        c_switch(box_name) {
            case(1937013298u, 1937011578u) {
                {
                    // ISO/IEC 14496-1 Page 38. Section 8.17.2 - Sample Size Box.
                    var size : int = 0
                    let sample_size : uint = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                    tr.sample_count = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                    tr.entry_size = reinterpret<uint?>(malloc1(uint64(tr.sample_count * 4u)))
                    if (tr.entry_size == null) {
                        if (depth == 0) {
                            break
                        } else {
                            MP4D_close(mp4)
                            return 0
                        }
                    }
                    i = 0u
                    while (i < tr.sample_count) {
                        if (box_name == uint(anon_644.BOX_stsz)) {
                            tr.entry_size[i] = sample_size != 0 ? sample_size : h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                        } else {
                            c_switch(sample_size & 255u) {
                                case(16u) {
                                    tr.entry_size[i] = h264_file_all__read_payload(mp4, 2u, addr(payload_bytes), addr(eof_flag))
                                    break
                                }
                                case(8u) {
                                    tr.entry_size[i] = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                                    break
                                }
                                case(4u) {
                                    if ((i & 1u) != 0) {
                                        tr.entry_size[i] = uint(size & 15)
                                    } else {
                                        size = int(h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag)))
                                        tr.entry_size[i] = uint(size >> 4)
                                    }
                                    break
                                }
                            }
                        }
                        i++
                    }
                }
                break
            }
            case(1937011555u) {
                // ISO/IEC 14496-12 Page 38. Section 8.18 - Sample To Chunk Box.
                tr.sample_to_chunk_count = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                tr.sample_to_chunk = reinterpret<MP4D_sample_to_chunk_t_tag?>(malloc1(uint64(tr.sample_to_chunk_count) *
                        uint64(typeinfo sizeof(type<MP4D_sample_to_chunk_t_tag>))))
                if (tr.sample_to_chunk == null) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                i = 0u
                while (i < tr.sample_to_chunk_count) {
                    tr.sample_to_chunk[i].first_chunk = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                    tr.sample_to_chunk[i].samples_per_chunk = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                    {
                        // sample_description_index
                        let t : uint64 = MINIMP4_MIN(payload_bytes, 4)
                        h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                        payload_bytes -= t
                    }
                    i++
                }
                break
            }
            case(1937011827u) {
                {
                    let count : uint = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                    var j : uint
                    var k : uint = 0u
                    var ts : uint = 0u
                    var ts_count : uint = count
                    tr.timestamp = reinterpret<uint?>(malloc1(uint64(ts_count * 4u)))
                    if (tr.timestamp == null) {
                        if (depth == 0) {
                            break
                        } else {
                            MP4D_close(mp4)
                            return 0
                        }
                    }
                    tr.duration = reinterpret<uint?>(malloc1(uint64(ts_count * 4u)))
                    if (tr.duration == null) {
                        if (depth == 0) {
                            break
                        } else {
                            MP4D_close(mp4)
                            return 0
                        }
                    }
                    i = 0u
                    while (i < count) {
                        let sc : uint = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                        let d : int = int(h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)))
                        if (k + sc > ts_count) {
                            ts_count = k + sc
                            tr.timestamp = reinterpret<uint?>(realloc1(reinterpret<void?>(tr.timestamp),
                                    uint64(ts_count) * uint64(typeinfo sizeof(type<uint>))))
                            tr.duration = reinterpret<uint?>(realloc1(reinterpret<void?>(tr.duration), uint64(ts_count) * uint64(typeinfo sizeof(type<uint>))))
                        }
                        j = 0u
                        while (j < sc) {
                            tr.duration[k] = uint(d)
                            let _t1 = k
                            k++
                            tr.timestamp[_t1] = ts
                            ts += uint(d)
                            j++
                        }
                        i++
                    }
                }
                break
            }
            case(1668576371u) {
                {
                    let count : uint = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                    i = 0u
                    while (i < count) {
                        let sc : int = int(h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)))
                        let d : int = int(h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)))
                        i++
                    }
                }
                break
            }
            case(1937007471u, 1668232756u) {
                // ISO/IEC 14496-12 Page 39. Section 8.19 - Chunk Offset Box.
                tr.chunk_count = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                tr.chunk_offset = reinterpret<uint64?>(malloc1(uint64(tr.chunk_count) * uint64(typeinfo sizeof(type<uint64>))))
                if (tr.chunk_offset == null) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                i = 0u
                while (i < tr.chunk_count) {
                    tr.chunk_offset[i] = uint64(h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)))
                    if (box_name == uint(anon_644.BOX_co64)) {
                        if (tr.chunk_offset[i] != 0) {
                            if (depth == 0) {
                                break
                            } else {
                                MP4D_close(mp4)
                                return 0
                            }
                        }
                        tr.chunk_offset[i] <<= 32ul
                        tr.chunk_offset[i] |= uint64(h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)))
                    }
                    i++
                }
                break
            }
            case(1836476516u) {
                {
                    let t : uint64 = MINIMP4_MIN(payload_bytes, (FullAtomVersionAndFlags >> 24u) == 1u ? 8 + 8 : 4 + 4)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                mp4.timescale = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                mp4.duration_hi = ((FullAtomVersionAndFlags >> 24u) == 1u) ? h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)) : 0u
                mp4.duration_lo = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                {
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 4 + 2 + 2 + 4 * 2 + 4 * 9 + 4 * 6 + 4)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                break
            }
            case(1835296868u) {
                {
                    let t : uint64 = MINIMP4_MIN(payload_bytes, (FullAtomVersionAndFlags >> 24u) == 1u ? 8 + 8 : 4 + 4)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                tr.timescale = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                tr.duration_hi = ((FullAtomVersionAndFlags >> 24u) == 1u) ? h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)) : 0u
                tr.duration_lo = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                {
                    var ISO_639_2_T : int = int(h264_file_all__read_payload(mp4, 2u, addr(payload_bytes), addr(eof_flag)))
                    tr.language[2] = uint8((ISO_639_2_T & 31) + 96)
                    ISO_639_2_T >>= 5
                    tr.language[1] = uint8((ISO_639_2_T & 31) + 96)
                    ISO_639_2_T >>= 5
                    tr.language[0] = uint8((ISO_639_2_T & 31) + 96)
                }
                // the rest of this box is skipped by default ...
                break
            }
            case(1751411826u) {
                // When this box is within 'meta' box, the track may not be avaialable
                if (tr != null) {
                    {
                        // pre_defined
                        let t : uint64 = MINIMP4_MIN(payload_bytes, 4)
                        h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                        payload_bytes -= t
                    }
                    tr.handler_type = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
