    data[1] = uint8((int(left[0]) + 2 * int(left[1]) + int(left[2]) + 2) >> 2)
    data[2] = uint8((int(left[1]) + int(left[2]) + 1) >> 1)
    data[3] = uint8((int(left[1]) + 2 * int(left[2]) + int(left[3]) + 2) >> 2)
    data[4] = uint8((int(left[1]) + int(left[2]) + 1) >> 1)
    data[5] = uint8((int(left[1]) + 2 * int(left[2]) + int(left[3]) + 2) >> 2)
    data[6] = uint8((int(left[2]) + int(left[3]) + 1) >> 1)
    data[7] = uint8((int(left[2]) + 3 * int(left[3]) + 2) >> 2)
    data[8] = uint8((int(left[2]) + int(left[3]) + 1) >> 1)
    data[9] = uint8((int(left[2]) + 3 * int(left[3]) + 2) >> 2)
    data[10] = left[3]
    data[11] = left[3]
    data[12] = left[3]
    data[13] = left[3]
    data[14] = left[3]
    data[15] = left[3]
}

[c_function]
def private h264_file_all__Write4x4To16x16(var data : uint8?; var data4x4 : uint8?; blockNum : uint) {
    // Variables
    var x : uint
    var y : uint
    var in32 : uint?
    var out32 : uint?
    // Code
    x = h264bsdBlockX[blockNum]
    y = h264bsdBlockY[blockNum]
    data += y * 16u + x
    // lint --e(826)
    out32 = reinterpret<uint?>(data)
    // lint --e(826)
    in32 = reinterpret<uint?>(data4x4)
    var _t0 = in32
    in32++
    out32[0] = *_t0
    var _t1 = in32
    in32++
    out32[4] = *_t1
    var _t2 = in32
    in32++
    out32[8] = *_t2
    var _t3 = in32
    in32++
    out32[12] = *_t3
}

def private h264_file_all__DetermineIntra4x4PredMode(var pMbLayer : macroblockLayer_t?; available : uint; var nA : neighbour_t?; var nB : neighbour_t?;
                                                     index : uint; var nMbA : mbStorage?; var nMbB : mbStorage?) : uint {
    // Variables
    var mode1 : uint
    var mode2 : uint
    var pMb : mbStorage?
    // Code
    // dc only prediction?
    if (available == 0) {
        mode1 = 2u
    } else {
        pMb = nMbA
        if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA4x4) {
            mode1 = uint(pMb.intra4x4PredMode[int(nA.index)])
        } else {
            mode1 = 2u
        }
        pMb = nMbB
        if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA4x4) {
            mode2 = uint(pMb.intra4x4PredMode[int(nB.index)])
        } else {
            mode2 = 2u
        }
        mode1 = MIN(mode1, mode2)
    }
    if (pMbLayer.mbPred.prevIntra4x4PredModeFlag[index] == 0) {
        if (pMbLayer.mbPred.remIntra4x4PredMode[index] < mode1) {
            mode1 = pMbLayer.mbPred.remIntra4x4PredMode[index]
        } else {
            mode1 = pMbLayer.mbPred.remIntra4x4PredMode[index] + 1u
        }
    }
    return mode1
}

[c_function]
def h264bsdDecodeMacroblockLayer(var pStrmData : strmData_t?; var pMbLayer : macroblockLayer_t?; var pMb : mbStorage?; sliceType : uint;
                                 numRefIdxActive : uint) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var itmp : int
    var partMode : mbPartPredMode_e
    // Code
    memset1(reinterpret<void?>(pMbLayer), 0, uint64(typeinfo sizeof(type<macroblockLayer_t>)))
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (IS_I_SLICE(sliceType)) {
        if ((value + 6u) > 31u || tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        pMbLayer.mbType = enum_from_int(type<mbType_e>, int(value + 6u))
    } else {
        if ((value + 1u) > 31u || tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        pMbLayer.mbType = enum_from_int(type<mbType_e>, int(value + 1u))
    }
    if (pMbLayer.mbType == mbType_e.I_PCM) {
        var level : int?
        while (h264bsdIsByteAligned(pStrmData) == 0) {
            // pcm_alignment_zero_bit
            tmp = h264bsdGetBits(pStrmData, 1u)
            if (tmp != 0) {
                return uint(HANTRO_NOK)
            }
        }
        level = addr(pMbLayer.residual.level[0][0])
        for (i in urange(384u)) {
            value = h264bsdGetBits(pStrmData, 8u)
            if (value == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            var _t0 = level
            level++
            *_t0 = int(value)
        }
    } else {
        partMode = h264bsdMbPartPredMode(pMbLayer.mbType)
        if ((partMode == mbPartPredMode_e.PRED_MODE_INTER) && (h264bsdNumMbPart(pMbLayer.mbType) == 4u)) {
            tmp = h264_file_all__DecodeSubMbPred(pStrmData, addr(pMbLayer.subMbPred), pMbLayer.mbType, numRefIdxActive)
        } else {
            tmp = h264_file_all__DecodeMbPred(pStrmData, addr(pMbLayer.mbPred), pMbLayer.mbType, numRefIdxActive)
        }
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (partMode != mbPartPredMode_e.PRED_MODE_INTRA16x16) {
            tmp = h264bsdDecodeExpGolombMapped(pStrmData, addr(value), uint(int_of(partMode == mbPartPredMode_e.PRED_MODE_INTRA4x4)))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pMbLayer.codedBlockPattern = value
        } else {
            pMbLayer.codedBlockPattern = h264_file_all__CbpIntra16x16(pMbLayer.mbType)
        }
        if (pMbLayer.codedBlockPattern != 0 || (partMode == mbPartPredMode_e.PRED_MODE_INTRA16x16)) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK) || (itmp < -26) || (itmp > 25)) {
                return uint(HANTRO_NOK)
            }
            pMbLayer.mbQpDelta = itmp
            tmp = h264_file_all__DecodeResidual(pStrmData, addr(pMbLayer.residual), pMb, pMbLayer.mbType, pMbLayer.codedBlockPattern)
            pStrmData.strmBuffReadBits = uint(int64(pStrmData.pStrmCurrPos - pStrmData.pStrmBuffStart)) * 8u + pStrmData.bitPosInWord
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    return uint(HANTRO_OK)
}

def h264bsdMbPartPredMode(mbType : mbType_e) : mbPartPredMode_e {
    // Variables
    // Code
    if (uint(mbType) <= uint(mbType_e.P_8x8ref0)) {
        return mbPartPredMode_e.PRED_MODE_INTER
    } elif (mbType == mbType_e.I_4x4) {
        return mbPartPredMode_e.PRED_MODE_INTRA4x4
    } else {
        return mbPartPredMode_e.PRED_MODE_INTRA16x16
    }
}

def h264bsdNumMbPart(mbType : mbType_e) : uint {
    // Variables
    // Code
    c_switch(mbType) {
        case(mbType_e.P_L0_16x16, mbType_e.P_Skip) {
            return 1u
        }
        case(mbType_e.P_L0_L0_16x8, mbType_e.P_L0_L0_8x16) {
            return 2u
        }
        case(_) {
            // P_8x8 or P_8x8ref0
            return 4u
        }
    }
}

def h264bsdNumSubMbPart(subMbType : subMbType_e) : uint {
    // Variables
    // Code
    c_switch(subMbType) {
        case(subMbType_e.P_L0_8x8) {
            return 1u
        }
        case(subMbType_e.P_L0_8x4, subMbType_e.P_L0_4x8) {
            return 2u
        }
        case(_) {
            // P_L0_4x4
            return 4u
        }
    }
}

[c_function]
def private h264_file_all__DecodeMbPred(var pStrmData : strmData_t?; var pMbPred : mbPred_t?; mbType : mbType_e; numRefIdxActive : uint) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var j : uint
    var value : uint
    var itmp : int
    // Code
    c_switch(h264bsdMbPartPredMode(mbType)) {
        case(mbPartPredMode_e.PRED_MODE_INTER) {
            // PRED_MODE_INTER
            if (numRefIdxActive > 1u) {
                i = h264bsdNumMbPart(mbType)
                j = 0u
                while (true) {
                    let _t0 = i
                    i--
                    if (_t0 == 0) {
                        break
                    }
                    tmp = h264bsdDecodeExpGolombTruncated(pStrmData, addr(value), uint(int_of(numRefIdxActive > 2u)))
                    if (tmp != uint(HANTRO_OK) || value >= numRefIdxActive) {
                        return uint(HANTRO_NOK)
                    }
                    pMbPred.refIdxL0[j] = value
                    j++
                }
            }
            i = h264bsdNumMbPart(mbType)
            j = 0u
            while (true) {
                let _t1 = i
                i--
                if (_t1 == 0) {
                    break
                }
                tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pMbPred.mvdL0[j].hor = int16(itmp)
                tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pMbPred.mvdL0[j].ver = int16(itmp)
                j++
            }
            break
        }
        case(mbPartPredMode_e.PRED_MODE_INTRA4x4) {
            itmp = 0
            i = 0u
            while (itmp < 2) {
                value = h264bsdShowBits32(pStrmData)
                tmp = 0u
                j = 8u
                while (true) {
                    let _t2 = j
                    j--
                    if (_t2 == 0) {
                        break
                    }
                    pMbPred.prevIntra4x4PredModeFlag[i] = uint((value & 2147483648u) != 0 ? HANTRO_TRUE : HANTRO_FALSE)
                    value <<= 1u
                    if (pMbPred.prevIntra4x4PredModeFlag[i] == 0) {
                        pMbPred.remIntra4x4PredMode[i] = value >> 29u
                        value <<= 3u
                        tmp++
                    }
                    i++
                }
                if (h264bsdFlushBits(pStrmData, 8u + 3u * tmp) == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                itmp++
            }
        }
        case(mbPartPredMode_e.PRED_MODE_INTRA16x16) {
            // fall-through
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK) || value > 3u) {
                return uint(HANTRO_NOK)
            }
            pMbPred.intraChromaPredMode = value
            break
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeSubMbPred(var pStrmData : strmData_t?; var pSubMbPred : subMbPred_t?; mbType : mbType_e; numRefIdxActive : uint) : uint {
    // Variables
    var tmp : uint
    var j : uint
    var value : uint
    var itmp : int
    // Code
    for (i in urange(4u)) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
        if (tmp != uint(HANTRO_OK) || value > 3u) {
            return uint(HANTRO_NOK)
        }
        pSubMbPred.subMbType[i] = enum_from_int(type<subMbType_e>, int(value))
    }
    if ((numRefIdxActive > 1u) && (mbType != mbType_e.P_8x8ref0)) {
        for (i in urange(4u)) {
            tmp = h264bsdDecodeExpGolombTruncated(pStrmData, addr(value), uint(int_of(numRefIdxActive > 2u)))
            if (tmp != uint(HANTRO_OK) || value >= numRefIdxActive) {
                return uint(HANTRO_NOK)
            }
            pSubMbPred.refIdxL0[i] = value
        }
    }
    for (i in urange(4u)) {
        j = 0u
        value = h264bsdNumSubMbPart(pSubMbPred.subMbType[i])
        while (true) {
            let _t0 = value
            value--
            if (_t0 == 0) {
                break
            }
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pSubMbPred.mvdL0[i][j].hor = int16(itmp)
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pSubMbPred.mvdL0[i][j].ver = int16(itmp)
            j++
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeResidual(var pStrmData : strmData_t?; var pResidual : residual_t?; var pMb : mbStorage?; mbType : mbType_e;
                                          var codedBlockPattern : uint) : uint {
    // Variables
    var i : uint
    var j : uint
    var tmp : uint
    var nc : int
    var blockCoded : uint
    var blockIndex : uint
    var is16x16 : uint
    var level : int[16]?
    // Code
    level = addr(pResidual.level[0])
    // luma DC is at index 24
    if (h264bsdMbPartPredMode(mbType) == mbPartPredMode_e.PRED_MODE_INTRA16x16) {
        nc = int(h264_file_all__DetermineNc(pMb, 0u, addr(pResidual.totalCoeff[0])))
        tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(level[24][0]), nc, 16u)
        if ((tmp & 15u) != uint(HANTRO_OK)) {
            return tmp
        }
        pResidual.totalCoeff[24] = int16((tmp >> 4u) & 255u)
        is16x16 = uint(HANTRO_TRUE)
    } else {
        is16x16 = uint(HANTRO_FALSE)
    }
    i = 4u
    blockIndex = 0u
    while (true) {
        let _t0 = i
        i--
        if (_t0 == 0) {
            break
        }
        // luma cbp in bits 0-3
        blockCoded = codedBlockPattern & 1u
        codedBlockPattern >>= 1u
        if (blockCoded != 0) {
            j = 4u
            while (true) {
                let _t1 = j
                j--
                if (_t1 == 0) {
                    break
                }
                nc = int(h264_file_all__DetermineNc(pMb, blockIndex, addr(pResidual.totalCoeff[0])))
                if (is16x16 != 0) {
                    tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(level[blockIndex][0]) + 1, nc, 15u)
                    pResidual.coeffMap[blockIndex] = tmp >> 15u
                } else {
                    tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(level[blockIndex][0]), nc, 16u)
                    pResidual.coeffMap[blockIndex] = tmp >> 16u
                }
                if ((tmp & 15u) != uint(HANTRO_OK)) {
                    return tmp
                }
                pResidual.totalCoeff[blockIndex] = int16((tmp >> 4u) & 255u)
                blockIndex++
            }
        } else {
            blockIndex += 4u
        }
    }
    // chroma DC block are at indices 25 and 26
    blockCoded = codedBlockPattern & 3u
    if (blockCoded != 0) {
        tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(level[25][0]), -1, 4u)
        if ((tmp & 15u) != uint(HANTRO_OK)) {
            return tmp
        }
        pResidual.totalCoeff[25] = int16((tmp >> 4u) & 255u)
        tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(level[25][0]) + 4, -1, 4u)
        if ((tmp & 15u) != uint(HANTRO_OK)) {
            return tmp
        }
        pResidual.totalCoeff[26] = int16((tmp >> 4u) & 255u)
    }
    // chroma AC
    blockCoded = codedBlockPattern & 2u
    if (blockCoded != 0) {
        i = 8u
        while (true) {
            let _t2 = i
            i--
            if (_t2 == 0) {
                break
            }
            nc = int(h264_file_all__DetermineNc(pMb, blockIndex, addr(pResidual.totalCoeff[0])))
            tmp = h264bsdDecodeResidualBlockCavlc(pStrmData, addr(level[blockIndex][0]) + 1, nc, 15u)
            if ((tmp & 15u) != uint(HANTRO_OK)) {
                return tmp
            }
            pResidual.totalCoeff[blockIndex] = int16((tmp >> 4u) & 255u)
            pResidual.coeffMap[blockIndex] = tmp >> 15u
            blockIndex++
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DetermineNc(var pMb : mbStorage?; blockIndex : uint; var pTotalCoeff : int16?) : uint {
    // lint -e702
    // Variables
    var tmp : uint
    var n : int
    var neighbourA : neighbour_t?
    var neighbourB : neighbour_t?
    var neighbourAindex : uint8
    var neighbourBindex : uint8
    // Code
    // if neighbour block belongs to current macroblock totalCoeff array
    // mbStorage has not been set/updated yet -> use pTotalCoeff
    neighbourA = h264bsdNeighbour4x4BlockA(blockIndex)
    neighbourB = h264bsdNeighbour4x4BlockB(blockIndex)
    neighbourAindex = neighbourA.index
    neighbourBindex = neighbourB.index
    if (neighbourA.mb == neighbourMb_e.MB_CURR && neighbourB.mb == neighbourMb_e.MB_CURR) {
        n = (int(pTotalCoeff[int(neighbourAindex)]) + int(pTotalCoeff[int(neighbourBindex)]) + 1) >> 1
    } elif (neighbourA.mb == neighbourMb_e.MB_CURR) {
        n = int(pTotalCoeff[int(neighbourAindex)])
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbB) != 0) {
            n = (n + int(pMb.mbB.totalCoeff[int(neighbourBindex)]) + 1) >> 1
        }
    } elif (neighbourB.mb == neighbourMb_e.MB_CURR) {
        n = int(pTotalCoeff[int(neighbourBindex)])
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbA) != 0) {
            n = (n + int(pMb.mbA.totalCoeff[int(neighbourAindex)]) + 1) >> 1
        }
    } else {
        tmp = 0u
        n = int(tmp)
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbA) != 0) {
            n = int(pMb.mbA.totalCoeff[int(neighbourAindex)])
            tmp = 1u
        }
        if (h264bsdIsNeighbourAvailable(pMb, pMb.mbB) != 0) {
            if (tmp != 0) {
                n = (n + int(pMb.mbB.totalCoeff[int(neighbourBindex)]) + 1) >> 1
            } else {
                n = int(pMb.mbB.totalCoeff[int(neighbourBindex)])
            }
        }
    }
    return uint(n)
}

def private h264_file_all__CbpIntra16x16(mbType : mbType_e) : uint {
    // Variables
    var cbp : uint
    var tmp : uint
    // Code
    if (uint(mbType) >= uint(mbType_e.I_16x16_0_0_1)) {
        cbp = 15u
    } else {
        cbp = 0u
    }
    // tmp is 0 for I_16x16_0_0_0 mb type
    // ignore lint warning on arithmetic on enum's
    // lint -e(656)
    tmp = (uint(mbType) - uint(mbType_e.I_16x16_0_0_0)) >> 2u
    if (tmp > 2u) {
        tmp -= 3u
    }
    cbp += tmp << 4u
    return cbp
}

def h264bsdPredModeIntra16x16(mbType : mbType_e) : uint {
    // Variables
    var tmp : uint
    // Code
    // tmp is 0 for I_16x16_0_0_0 mb type
    // ignore lint warning on arithmetic on enum's
    // lint -e(656)
    tmp = uint(mbType) - uint(mbType_e.I_16x16_0_0_0)
    return tmp & 3u
}

[c_function]
def h264bsdDecodeMacroblock(var pMb : mbStorage?; var pMbLayer : macroblockLayer_t?; var currImage : image_t?; var dpb : dpbStorage_t?; var qpY : int?;
                            mbNum : uint; constrainedIntraPredFlag : uint; var data : uint8?) : uint {
    // Variables
    var i : uint
    var tmp : uint
    var mbType : mbType_e
    // Code
    mbType = pMbLayer.mbType
    pMb.mbType = mbType
    pMb.decoded++
    h264bsdSetCurrImageMbPointers(currImage, mbNum)
    if (mbType == mbType_e.I_PCM) {
        var pData : uint8? = data
        var tot : int16? = addr(pMb.totalCoeff[0])
        var lev : int? = addr(pMbLayer.residual.level[0][0])
        pMb.qpY = 0u
        // if decoded flag > 1 -> mb has already been successfully decoded and
        // written to output -> do not write again
        if (pMb.decoded > 1u) {
            i = 24u
            while (true) {
                let _t0 = i
                i--
                if (_t0 == 0) {
                    break
                }
                var _t1 = tot
                tot++
                *_t1 = int16(16)
            }
            return uint(HANTRO_OK)
        }
        i = 24u
        while (true) {
            let _t2 = i
            i--
            if (_t2 == 0) {
                break
            }
            var _t3 = tot
            tot++
            *_t3 = int16(16)
            tmp = 16u
            while (true) {
                let _t4 = tmp
                tmp--
                if (_t4 == 0) {
                    break
                }
                var _t5 = pData
                pData++
                var _t6 = lev
                lev++
                *_t5 = uint8(*_t6)
            }
        }
        h264bsdWriteMacroblock(currImage, data)
        return uint(HANTRO_OK)
    } else {
        if (mbType != mbType_e.P_Skip) {
            memcpy1(reinterpret<void?>(addr(pMb.totalCoeff[0])), reinterpret<void?>(addr(pMbLayer.residual.totalCoeff[0])),
                    27ul * uint64(typeinfo sizeof(type<int16>)))
            // update qpY
            if (pMbLayer.mbQpDelta != 0) {
                *qpY += pMbLayer.mbQpDelta
                if (*qpY < 0) {
                    *qpY += 52
                } elif (*qpY >= 52) {
                    *qpY -= 52
                }
            }
            pMb.qpY = uint(*qpY)
            tmp = h264_file_all__ProcessResidual(pMb, addr(pMbLayer.residual.level[0]), addr(pMbLayer.residual.coeffMap[0]))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        } else {
            memset1(reinterpret<void?>(addr(pMb.totalCoeff[0])), 0, 27ul * uint64(typeinfo sizeof(type<int16>)))
            pMb.qpY = uint(*qpY)
        }
        // if decoded flag > 1 -> mb has already been successfully decoded and
        // written to output -> do not write again
        if (h264bsdMbPartPredMode(mbType) != mbPartPredMode_e.PRED_MODE_INTER) {
            tmp = h264bsdIntraPrediction(pMb, pMbLayer, currImage, mbNum, constrainedIntraPredFlag, data)
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        } else {
            tmp = h264bsdInterPrediction(pMb, pMbLayer, dpb, mbNum, currImage, data)
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__ProcessResidual(var pMb : mbStorage?; var residualLevel : int[16]?; var coeffMap : uint?) : uint {
    // Variables
    var i : uint
    var chromaQp : uint
    var blockData : int[16]?
    var blockDc : int[16]?
    var totalCoeff : int16?
    var chromaDc : int?
    var dcCoeffIdx : uint?
    // Code
    // set pointers to DC coefficient blocks
    blockDc = residualLevel + 24
    blockData = residualLevel
    totalCoeff = addr(pMb.totalCoeff[0])
    if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA16x16) {
        if (totalCoeff[24] != 0) {
            h264bsdProcessLumaDc(addr((*blockDc)[0]), pMb.qpY)
        }
        dcCoeffIdx = addr(h264_file_all__dcCoeffIndex[0])
        i = 16u
        while (true) {
            let _t0 = i
            i--
            if (_t0 == 0) {
                break
            }
            // set dc coefficient of luma block
            var _t1 = dcCoeffIdx
            dcCoeffIdx++
            (*blockData)[0] = (*blockDc)[*_t1]
            if ((*blockData)[0] != 0 || *totalCoeff != 0) {
                if (h264bsdProcessBlock(addr((*blockData)[0]), pMb.qpY, 1u, *coeffMap) != uint(HANTRO_OK)) {
                    return uint(HANTRO_NOK)
                }
            } else {
                (*blockData)[0] = EMPTY_RESIDUAL_INDICATOR
            }
            blockData++
            totalCoeff++
            coeffMap++
        }
    } else {
        i = 16u
        while (true) {
            let _t2 = i
            i--
            if (_t2 == 0) {
                break
            }
            if (*totalCoeff != 0) {
                if (h264bsdProcessBlock(addr((*blockData)[0]), pMb.qpY, 0u, *coeffMap) != uint(HANTRO_OK)) {
                    return uint(HANTRO_NOK)
                }
            } else {
                (*blockData)[0] = EMPTY_RESIDUAL_INDICATOR
            }
            blockData++
            totalCoeff++
            coeffMap++
        }
    }
    // chroma DC processing. First chroma dc block is block with index 25
    chromaQp = h264bsdQpC[int(pMb.qpY) + pMb.chromaQpIndexOffset < 0 ? 0 : (int(pMb.qpY) + pMb.chromaQpIndexOffset > 51 ? 51 :
            int(pMb.qpY) + pMb.chromaQpIndexOffset)]
    if (pMb.totalCoeff[25] != 0 || pMb.totalCoeff[26] != 0) {
        h264bsdProcessChromaDc(addr(residualLevel[25][0]), chromaQp)
    }
    chromaDc = addr(residualLevel[25][0])
    i = 8u
    while (true) {
        let _t3 = i
        i--
        if (_t3 == 0) {
            break
        }
        // set dc coefficient of chroma block
        var _t4 = chromaDc
        chromaDc++
        (*blockData)[0] = *_t4
        if ((*blockData)[0] != 0 || *totalCoeff != 0) {
            if (h264bsdProcessBlock(addr((*blockData)[0]), chromaQp, 1u, *coeffMap) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
        } else {
            (*blockData)[0] = EMPTY_RESIDUAL_INDICATOR
        }
        blockData++
        totalCoeff++
        coeffMap++
    }
    return uint(HANTRO_OK)
}

def h264bsdSubMbPartMode(subMbType : subMbType_e) : subMbPartMode_e {
    // Variables
    // Code
    return enum_from_int(type<subMbPartMode_e>, int(subMbType))
}

def h264bsdDecodeNalUnit(var pStrmData : strmData_t?; var pNalUnit : nalUnit_t?) : uint {
    // Variables
    var tmp : uint
    // Code
    // forbidden_zero_bit (not checked to be zero, errors ignored)
    tmp = h264bsdGetBits(pStrmData, 1u)
    // Assuming that NAL unit starts from byte boundary ­> don't have to check
    // following 7 bits for END_OF_STREAM
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 2u)
    pNalUnit.nalRefIdc = tmp
    tmp = h264bsdGetBits(pStrmData, 5u)
    pNalUnit.nalUnitType = enum_from_int(type<nalUnitType_e>, int(tmp))
    // data partitioning NAL units not supported
    if ((tmp == 2u) || (tmp == 3u) || (tmp == 4u)) {
        return uint(HANTRO_NOK)
    }
    // nal_ref_idc shall not be zero for these nal_unit_types
    if (((tmp == uint(nalUnitType_e.NAL_SEQ_PARAM_SET)) || (tmp == uint(nalUnitType_e.NAL_PIC_PARAM_SET)) ||
                (tmp == uint(nalUnitType_e.NAL_CODED_SLICE_IDR))) &&
            (pNalUnit.nalRefIdc == 0u)) {
        return uint(HANTRO_NOK)
    } elif (((tmp == uint(nalUnitType_e.NAL_SEI)) || (tmp == uint(nalUnitType_e.NAL_ACCESS_UNIT_DELIMITER)) ||
                (tmp == uint(nalUnitType_e.NAL_END_OF_SEQUENCE)) || (tmp == uint(nalUnitType_e.NAL_END_OF_STREAM)) ||
                (tmp == uint(nalUnitType_e.NAL_FILLER_DATA))) &&
            (pNalUnit.nalRefIdc != 0u)) {
        // nal_ref_idc shall be zero for these nal_unit_types
        return uint(HANTRO_NOK)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdInitMbNeighbours(var pMbStorage : mbStorage?; picWidth : uint; picSizeInMbs : uint) {
    // Variables
    var row : uint
    var col : uint
    // Code
    col = 0u
    row = col
    for (i in urange(picSizeInMbs)) {
        if (col != 0) {
            pMbStorage[i].mbA = pMbStorage + i + -(1)
        } else {
            pMbStorage[i].mbA = null
        }
        if (row != 0) {
            pMbStorage[i].mbB = pMbStorage + i + -int64(picWidth)
        } else {
            pMbStorage[i].mbB = null
        }
        if (row != 0 && (col < picWidth - 1u)) {
            pMbStorage[i].mbC = pMbStorage + i + -int64(picWidth - 1u)
        } else {
            pMbStorage[i].mbC = null
        }
        if (row != 0 && col != 0) {
            pMbStorage[i].mbD = pMbStorage + i + -int64(picWidth + 1u)
        } else {
            pMbStorage[i].mbD = null
        }
        col++
        if (col == picWidth) {
            col = 0u
            row++
        }
    }
}

def h264bsdGetNeighbourMb(var pMb : mbStorage?; neighbour : neighbourMb_e) : mbStorage? {
    // Variables
    // Code
    if (neighbour == neighbourMb_e.MB_A) {
        return pMb.mbA
    } elif (neighbour == neighbourMb_e.MB_B) {
        return pMb.mbB
    } elif (neighbour == neighbourMb_e.MB_C) {
        return pMb.mbC
    } elif (neighbour == neighbourMb_e.MB_D) {
        return pMb.mbD
    } elif (neighbour == neighbourMb_e.MB_CURR) {
        return pMb
    } else {
        return null
    }
}

[c_function]
def h264bsdNeighbour4x4BlockA(blockIndex : uint) : neighbour_t? {
    // Variables
    // Code
    return addr(h264_file_all__N_A_4x4B[0]) + blockIndex
}

[c_function]
def h264bsdNeighbour4x4BlockB(blockIndex : uint) : neighbour_t? {
    // Variables
    // Code
    return addr(h264_file_all__N_B_4x4B[0]) + blockIndex
}

[c_function]
def h264bsdNeighbour4x4BlockC(blockIndex : uint) : neighbour_t? {
    // Variables
    // Code
    return addr(h264_file_all__N_C_4x4B[0]) + blockIndex
}

[c_function]
def h264bsdNeighbour4x4BlockD(blockIndex : uint) : neighbour_t? {
    // Variables
    // Code
    return addr(h264_file_all__N_D_4x4B[0]) + blockIndex
}

[c_function]
def h264bsdIsNeighbourAvailable(var pMb : mbStorage?; var pNeighbour : mbStorage?) : uint {
    // Variables
    // Code
    if ((pNeighbour == null) || (pMb.sliceId != pNeighbour.sliceId)) {
        return uint(HANTRO_FALSE)
    } else {
        return uint(HANTRO_TRUE)
    }
}

[c_function]
def h264bsdDecodePicOrderCnt(var poc : pocStorage_t?; var sps : seqParamSet_t?; var pSliceHeader : sliceHeader_t?; var pNalUnit : nalUnit_t?) : int {
    // Variables
    var i : uint
    var picOrderCnt : int
    var frameNumOffset : uint
    var absFrameNum : uint
    var picOrderCntCycleCnt : uint
    var frameNumInPicOrderCntCycle : uint
    var expectedDeltaPicOrderCntCycle : int
    var containsMmco5 : uint
    // Code
    // JanSa: I don't think this is necessary, don't see any reason to
    // increment prevFrameNum one by one instead of one big increment.
    // However, standard specifies that this should be done -> if someone
    // figures out any case when the outcome would be different for step by
    // step increment, this part of the code should be enabled
    // if there was a gap in frame numbering and picOrderCntType is 1 or 2 ->
    // "compute" pic order counts for non-existing frames. These are not
    // actually computed, but process needs to be done to update the
    // prevFrameNum and prevFrameNumOffset
    // use variable i for unUsedShortTermFrameNum
    // check if current slice includes mmco equal to 5
    containsMmco5 = uint(HANTRO_FALSE)
    if (pSliceHeader.decRefPicMarking.adaptiveRefPicMarkingModeFlag != 0) {
        i = 0u
        while (pSliceHeader.decRefPicMarking.operation[i].memoryManagementControlOperation != 0) {
            if (pSliceHeader.decRefPicMarking.operation[i].memoryManagementControlOperation == 5u) {
                containsMmco5 = uint(HANTRO_TRUE)
                break
            }
            i++
        }
    }
    c_switch(sps.picOrderCntType) {
        case(0u) {
            // set prevPicOrderCnt values for IDR frame
            if (IS_IDR_NAL_UNIT(pNalUnit)) {
                poc.prevPicOrderCntMsb = 0
                poc.prevPicOrderCntLsb = 0u
            }
            // compute picOrderCntMsb (stored in picOrderCnt variable)
            if ((pSliceHeader.picOrderCntLsb < poc.prevPicOrderCntLsb) &&
                    ((poc.prevPicOrderCntLsb - pSliceHeader.picOrderCntLsb) >= sps.maxPicOrderCntLsb / 2u)) {
                picOrderCnt = poc.prevPicOrderCntMsb + int(sps.maxPicOrderCntLsb)
            } elif ((pSliceHeader.picOrderCntLsb > poc.prevPicOrderCntLsb) &&
                    ((pSliceHeader.picOrderCntLsb - poc.prevPicOrderCntLsb) > sps.maxPicOrderCntLsb / 2u)) {
                picOrderCnt = poc.prevPicOrderCntMsb - int(sps.maxPicOrderCntLsb)
            } else {
                picOrderCnt = poc.prevPicOrderCntMsb
            }
            // standard specifies that prevPicOrderCntMsb is from previous
            // rererence frame -> replace old value only if current frame is
            // rererence frame
            if (pNalUnit.nalRefIdc != 0) {
                poc.prevPicOrderCntMsb = picOrderCnt
            }
            // compute top field order cnt (stored in picOrderCnt)
            picOrderCnt += int(pSliceHeader.picOrderCntLsb)
            // if delta for bottom field is negative -> bottom will be the
            // minimum pic order count
            if (pSliceHeader.deltaPicOrderCntBottom < 0) {
                picOrderCnt += pSliceHeader.deltaPicOrderCntBottom
            }
            // standard specifies that prevPicOrderCntLsb is from previous
            // rererence frame -> replace old value only if current frame is
            // rererence frame
            if (pNalUnit.nalRefIdc != 0) {
                // if current frame contains mmco5 -> modify values to be
                // stored
                if (containsMmco5 != 0) {
                    poc.prevPicOrderCntMsb = 0
                    // prevPicOrderCntLsb should be the top field picOrderCnt
                    // if previous frame included mmco5. Top field picOrderCnt
                    // for frames containing mmco5 is obtained by subtracting
                    // the picOrderCnt from original top field order count ->
                    // value is zero if top field was the minimum, i.e. delta
                    // for bottom was positive, otherwise value is
                    // -deltaPicOrderCntBottom
                    if (pSliceHeader.deltaPicOrderCntBottom < 0) {
                        poc.prevPicOrderCntLsb = uint(-pSliceHeader.deltaPicOrderCntBottom)
                    } else {
                        poc.prevPicOrderCntLsb = 0u
                    }
                    picOrderCnt = 0
                } else {
                    poc.prevPicOrderCntLsb = pSliceHeader.picOrderCntLsb
                }
            }
            break
        }
        case(1u) {
            // step 1 (in the description in the standard)
            if (IS_IDR_NAL_UNIT(pNalUnit)) {
                frameNumOffset = 0u
            } elif (poc.prevFrameNum > pSliceHeader.frameNum) {
                frameNumOffset = poc.prevFrameNumOffset + sps.maxFrameNum
            } else {
                frameNumOffset = poc.prevFrameNumOffset
            }
            // step 2
            if (sps.numRefFramesInPicOrderCntCycle != 0) {
                absFrameNum = frameNumOffset + pSliceHeader.frameNum
            } else {
                absFrameNum = 0u
            }
            if (pNalUnit.nalRefIdc == 0u && absFrameNum > 0u) {
                absFrameNum -= 1u
            }
            // step 3
            if (absFrameNum > 0u) {
                picOrderCntCycleCnt = (absFrameNum - 1u) / sps.numRefFramesInPicOrderCntCycle
                frameNumInPicOrderCntCycle = (absFrameNum - 1u) % sps.numRefFramesInPicOrderCntCycle
            }
            // step 4
            expectedDeltaPicOrderCntCycle = 0
            i = 0u
            while (i < sps.numRefFramesInPicOrderCntCycle) {
                expectedDeltaPicOrderCntCycle += sps.offsetForRefFrame[i]
                i++
            }
            // step 5 (picOrderCnt used to store expectedPicOrderCnt)
            // lint -esym(644,picOrderCntCycleCnt) always initialized
            // lint -esym(644,frameNumInPicOrderCntCycle) always initialized
            if (absFrameNum > 0u) {
                picOrderCnt = int(picOrderCntCycleCnt) * expectedDeltaPicOrderCntCycle
                i = 0u
                while (i <= frameNumInPicOrderCntCycle) {
                    picOrderCnt += sps.offsetForRefFrame[i]
                    i++
                }
            } else {
                picOrderCnt = 0
            }
            if (pNalUnit.nalRefIdc == 0u) {
                picOrderCnt += sps.offsetForNonRefPic
            }
            // step 6 (picOrderCnt is top field order cnt if delta for bottom
            // is positive, otherwise it is bottom field order cnt)
            picOrderCnt += pSliceHeader.deltaPicOrderCnt[0]
            if ((sps.offsetForTopToBottomField + pSliceHeader.deltaPicOrderCnt[1]) < 0) {
                picOrderCnt += sps.offsetForTopToBottomField + pSliceHeader.deltaPicOrderCnt[1]
            }
            // if current picture contains mmco5 -> set prevFrameNumOffset and
            // prevFrameNum to 0 for computation of picOrderCnt of next
            // frame, otherwise store frameNum and frameNumOffset to poc
            // structure
            if (containsMmco5 == 0) {
                poc.prevFrameNumOffset = frameNumOffset
                poc.prevFrameNum = pSliceHeader.frameNum
            } else {
                poc.prevFrameNumOffset = 0u
                poc.prevFrameNum = 0u
                picOrderCnt = 0
            }
            break
        }
        case(_) {
            // case 2
            // derive frameNumOffset
            if (IS_IDR_NAL_UNIT(pNalUnit)) {
                frameNumOffset = 0u
            } elif (poc.prevFrameNum > pSliceHeader.frameNum) {
                frameNumOffset = poc.prevFrameNumOffset + sps.maxFrameNum
            } else {
                frameNumOffset = poc.prevFrameNumOffset
            }
            // derive picOrderCnt (type 2 has same value for top and bottom
            // field order cnts)
            if (IS_IDR_NAL_UNIT(pNalUnit)) {
                picOrderCnt = 0
            } elif (pNalUnit.nalRefIdc == 0u) {
                picOrderCnt = 2 * int(frameNumOffset + pSliceHeader.frameNum) - 1
            } else {
                picOrderCnt = 2 * int(frameNumOffset + pSliceHeader.frameNum)
            }
            // if current picture contains mmco5 -> set prevFrameNumOffset and
            // prevFrameNum to 0 for computation of picOrderCnt of next
            // frame, otherwise store frameNum and frameNumOffset to poc
            // structure
            if (containsMmco5 == 0) {
                poc.prevFrameNumOffset = frameNumOffset
                poc.prevFrameNum = pSliceHeader.frameNum
            } else {
                poc.prevFrameNumOffset = 0u
                poc.prevFrameNum = 0u
                picOrderCnt = 0
            }
            break
        }
    }
    // lint -esym(644,picOrderCnt) always initialized
    return picOrderCnt
}

[c_function]
def h264bsdDecodePicParamSet(var pStrmData : strmData_t?; var pPicParamSet : picParamSet_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var value : uint
    var itmp : int
    // Code
    memset1(reinterpret<void?>(pPicParamSet), 0, uint64(typeinfo sizeof(type<picParamSet_t>)))
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPicParamSet.picParameterSetId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pPicParamSet.picParameterSetId >= uint(MAX_NUM_PIC_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPicParamSet.seqParameterSetId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pPicParamSet.seqParameterSetId >= uint(MAX_NUM_SEQ_PARAM_SETS)) {
        return uint(HANTRO_NOK)
    }
    // entropy_coding_mode_flag, shall be 0 for baseline profile
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp != 0) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.picOrderPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    // num_slice_groups_minus1
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pPicParamSet.numSliceGroups = value + 1u
    if (pPicParamSet.numSliceGroups > uint(MAX_NUM_SLICE_GROUPS)) {
        return uint(HANTRO_NOK)
    }
    // decode slice group mapping information if more than one slice groups
    if (pPicParamSet.numSliceGroups > 1u) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPicParamSet.sliceGroupMapType))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pPicParamSet.sliceGroupMapType > 6u) {
            return uint(HANTRO_NOK)
        }
        if (pPicParamSet.sliceGroupMapType == 0u) {
            pPicParamSet.runLength = reinterpret<uint?>(malloc1(uint64(pPicParamSet.numSliceGroups) * uint64(typeinfo sizeof(type<uint>))))
            if (pPicParamSet.runLength == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            i = 0u
            while (i < pPicParamSet.numSliceGroups) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pPicParamSet.runLength[i] = value + 1u
                i++
            }
        } elif (pPicParamSet.sliceGroupMapType == 2u) {
            // param values checked in CheckPps()
            pPicParamSet.topLeft = reinterpret<uint?>(malloc1(uint64(pPicParamSet.numSliceGroups - 1u) * uint64(typeinfo sizeof(type<uint>))))
            pPicParamSet.bottomRight = reinterpret<uint?>(malloc1(uint64(pPicParamSet.numSliceGroups - 1u) * uint64(typeinfo sizeof(type<uint>))))
            if (pPicParamSet.topLeft == null || pPicParamSet.bottomRight == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            i = 0u
            while (i < pPicParamSet.numSliceGroups - 1u) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pPicParamSet.topLeft[i] = value
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                pPicParamSet.bottomRight[i] = value
                i++
            }
        } elif ((pPicParamSet.sliceGroupMapType == 3u) || (pPicParamSet.sliceGroupMapType == 4u) || (pPicParamSet.sliceGroupMapType == 5u)) {
            // param values checked in CheckPps()
            tmp = h264bsdGetBits(pStrmData, 1u)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pPicParamSet.sliceGroupChangeDirectionFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pPicParamSet.sliceGroupChangeRate = value + 1u
        } elif (pPicParamSet.sliceGroupMapType == 6u) {
            // param value checked in CheckPps()
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            pPicParamSet.picSizeInMapUnits = value + 1u
            pPicParamSet.sliceGroupId = reinterpret<uint?>(malloc1(uint64(pPicParamSet.picSizeInMapUnits) * uint64(typeinfo sizeof(type<uint>))))
            if (pPicParamSet.sliceGroupId == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            // determine number of bits needed to represent range
            // [0, numSliceGroups)
            tmp = h264_file_all__CeilLog2NumSliceGroups[pPicParamSet.numSliceGroups - 1u]
            i = 0u
            while (i < pPicParamSet.picSizeInMapUnits) {
                pPicParamSet.sliceGroupId[i] = h264bsdGetBits(pStrmData, tmp)
                if (pPicParamSet.sliceGroupId[i] >= pPicParamSet.numSliceGroups) {
                    return uint(HANTRO_NOK)
                }
                i++
            }
        }
    }
    // num_ref_idx_l0_active_minus1
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > 31u) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.numRefIdxL0Active = value + 1u
    // num_ref_idx_l1_active_minus1
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (value > 31u) {
        return uint(HANTRO_NOK)
    }
    // weighted_pred_flag, this shall be 0 for baseline profile
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp != 0) {
        return uint(HANTRO_NOK)
    }
    // weighted_bipred_idc
    tmp = h264bsdGetBits(pStrmData, 2u)
    if (tmp > 2u) {
        return uint(HANTRO_NOK)
    }
    // pic_init_qp_minus26
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if ((itmp < -26) || (itmp > 25)) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.picInitQp = uint(itmp + 26)
    // pic_init_qs_minus26
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if ((itmp < -26) || (itmp > 25)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(itmp))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if ((itmp < -12) || (itmp > 12)) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.chromaQpIndexOffset = itmp
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.deblockingFilterControlPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.constrainedIntraPredFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPicParamSet.redundantPicCntPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdRbspTrailingBits(pStrmData)
    // ignore possible errors in trailing bits of parameters sets
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdInterpolateChromaHor
// Functional description:
// This function performs chroma interpolation in horizontal direction.
// Overfilling is done only if needed. Reference image (pRef) is
// read at correct position and the predicted part is written to
// macroblock's chrominance (predPartChroma)
// Inputs:
// pRef pointer to reference frame Cb top-left corner
// x0 integer x-coordinate for prediction
// y0 integer y-coordinate for prediction
// width width of the reference frame chrominance in pixels
// height height of the reference frame chrominance in pixels
// xFrac horizontal fraction for prediction in 1/8 pixels
// chromaPartWidth width of the predicted part in pixels
// chromaPartHeight height of the predicted part in pixels
// Outputs:
// predPartChroma pointer where predicted part is written
// ------------------------------------------------------------------------------
[c_function]
def h264bsdInterpolateChromaHor(var pRef : uint8?; var predPartChroma : uint8?; var x0 : int; var y0 : int; var width : uint; var height : uint; xFrac : uint;
                                chromaPartWidth : uint; chromaPartHeight : uint) {
    // Variables
    var x : uint
    var y : uint
    var tmp1 : uint
    var tmp2 : uint
    var tmp3 : uint
    var tmp4 : uint
    var c : uint
    var val : uint
    var ptrA : uint8?
    var cbr : uint8?
    var _c_block : uint8[144]
    // Code
    if ((x0 < 0) || (uint(x0) + chromaPartWidth + 1u > width) || (y0 < 0) || (uint(y0) + chromaPartHeight > height)) {
        h264bsdFillBlock(pRef, addr(_c_block[0]), x0, y0, width, height, chromaPartWidth + 1u, chromaPartHeight, chromaPartWidth + 1u)
        pRef += width * height
        h264bsdFillBlock(pRef, addr(_c_block[0]) + (chromaPartWidth + 1u) * chromaPartHeight, x0, y0, width, height, chromaPartWidth + 1u, chromaPartHeight,
                chromaPartWidth + 1u)
        pRef = addr(_c_block[0])
        x0 = 0
        y0 = 0
        width = chromaPartWidth + 1u
        height = chromaPartHeight
    }
    val = 8u - xFrac
    for (comp in urange(2u)) {
        ptrA = pRef + (comp * height + uint(y0)) * width + x0
        cbr = predPartChroma + comp * 8u * 8u
        // 2x2 pels per iteration
        // bilinear horizontal interpolation
        y = chromaPartHeight >> 1u
        while (y != 0) {
            x = chromaPartWidth >> 1u
            while (x != 0) {
                tmp1 = uint(ptrA[width])
                var _t0 = ptrA
                ptrA++
                tmp2 = uint(*_t0)
                tmp3 = uint(ptrA[width])
                var _t1 = ptrA
                ptrA++
                tmp4 = uint(*_t1)
                c = ((val * tmp1 + xFrac * tmp3) << 3u) + 32u
                c >>= 6u
                cbr[8] = uint8(c)
                c = ((val * tmp2 + xFrac * tmp4) << 3u) + 32u
                c >>= 6u
                var _t2 = cbr
                cbr++
                *_t2 = uint8(c)
                tmp1 = uint(ptrA[width])
                tmp2 = uint(*ptrA)
                c = ((val * tmp3 + xFrac * tmp1) << 3u) + 32u
                c >>= 6u
                cbr[8] = uint8(c)
                c = ((val * tmp4 + xFrac * tmp2) << 3u) + 32u
                c >>= 6u
                var _t3 = cbr
                cbr++
                *_t3 = uint8(c)
                x--
            }
            cbr += uint(2 * 8) - chromaPartWidth
            ptrA += 2u * width - chromaPartWidth
            y--
        }
    }
}

[c_function]
def h264bsdInterpolateChromaVer(var pRef : uint8?; var predPartChroma : uint8?; var x0 : int; var y0 : int; var width : uint; var height : uint; yFrac : uint;
                                chromaPartWidth : uint; chromaPartHeight : uint) {
    // Variables
    var x : uint
    var y : uint
    var tmp1 : uint
    var tmp2 : uint
    var tmp3 : uint
    var c : uint
    var val : uint
    var ptrA : uint8?
    var cbr : uint8?
    var _c_block : uint8[144]
    // Code
    if ((x0 < 0) || (uint(x0) + chromaPartWidth > width) || (y0 < 0) || (uint(y0) + chromaPartHeight + 1u > height)) {
        h264bsdFillBlock(pRef, addr(_c_block[0]), x0, y0, width, height, chromaPartWidth, chromaPartHeight + 1u, chromaPartWidth)
        pRef += width * height
        h264bsdFillBlock(pRef, addr(_c_block[0]) + chromaPartWidth * (chromaPartHeight + 1u), x0, y0, width, height, chromaPartWidth, chromaPartHeight + 1u,
                chromaPartWidth)
        pRef = addr(_c_block[0])
        x0 = 0
        y0 = 0
        width = chromaPartWidth
        height = chromaPartHeight + 1u
    }
    val = 8u - yFrac
    for (comp in urange(2u)) {
        ptrA = pRef + (comp * height + uint(y0)) * width + x0
        cbr = predPartChroma + comp * 8u * 8u
        // 2x2 pels per iteration
        // bilinear vertical interpolation
        y = chromaPartHeight >> 1u
        while (y != 0) {
            x = chromaPartWidth >> 1u
            while (x != 0) {
                tmp3 = uint(ptrA[width * 2u])
                tmp2 = uint(ptrA[width])
                var _t0 = ptrA
                ptrA++
                tmp1 = uint(*_t0)
                c = ((val * tmp2 + yFrac * tmp3) << 3u) + 32u
                c >>= 6u
                cbr[8] = uint8(c)
                c = ((val * tmp1 + yFrac * tmp2) << 3u) + 32u
                c >>= 6u
                var _t1 = cbr
                cbr++
                *_t1 = uint8(c)
                tmp3 = uint(ptrA[width * 2u])
                tmp2 = uint(ptrA[width])
                var _t2 = ptrA
                ptrA++
                tmp1 = uint(*_t2)
                c = ((val * tmp2 + yFrac * tmp3) << 3u) + 32u
                c >>= 6u
                cbr[8] = uint8(c)
                c = ((val * tmp1 + yFrac * tmp2) << 3u) + 32u
                c >>= 6u
                var _t3 = cbr
                cbr++
                *_t3 = uint8(c)
                x--
            }
            cbr += uint(2 * 8) - chromaPartWidth
            ptrA += 2u * width - chromaPartWidth
            y--
        }
    }
}

[c_function]
def h264bsdInterpolateChromaHorVer(var ref : uint8?; var predPartChroma : uint8?; var x0 : int; var y0 : int; var width : uint; var height : uint; xFrac : uint;
                                   yFrac : uint; chromaPartWidth : uint; chromaPartHeight : uint) {
    var _c_block : uint8[162]
    var x : uint
    var y : uint
    var tmp1 : uint
    var tmp2 : uint
    var tmp3 : uint
    var tmp4 : uint
    var tmp5 : uint
    var tmp6 : uint
    var valX : uint
    var valY : uint
    let plus32 : uint = 32u
    var ptrA : uint8?
    var cbr : uint8?
    // Code
    if ((x0 < 0) || (uint(x0) + chromaPartWidth + 1u > width) || (y0 < 0) || (uint(y0) + chromaPartHeight + 1u > height)) {
        h264bsdFillBlock(ref, addr(_c_block[0]), x0, y0, width, height, chromaPartWidth + 1u, chromaPartHeight + 1u, chromaPartWidth + 1u)
        ref += width * height
        h264bsdFillBlock(ref, addr(_c_block[0]) + (chromaPartWidth + 1u) * (chromaPartHeight + 1u), x0, y0, width, height, chromaPartWidth + 1u,
                chromaPartHeight + 1u, chromaPartWidth + 1u)
        ref = addr(_c_block[0])
        x0 = 0
        y0 = 0
        width = chromaPartWidth + 1u
        height = chromaPartHeight + 1u
    }
    valX = 8u - xFrac
    valY = 8u - yFrac
    for (comp in urange(2u)) {
        ptrA = ref + (comp * height + uint(y0)) * width + x0
        cbr = predPartChroma + comp * 8u * 8u
        // 2x2 pels per iteration
        // bilinear vertical and horizontal interpolation
        y = chromaPartHeight >> 1u
        while (y != 0) {
            tmp1 = uint(*ptrA)
            tmp3 = uint(ptrA[width])
            tmp5 = uint(ptrA[width * 2u])
            tmp1 *= valY
            tmp1 += tmp3 * yFrac
            tmp3 *= valY
            tmp3 += tmp5 * yFrac
            x = chromaPartWidth >> 1u
            while (x != 0) {
                ptrA++
                tmp2 = uint(*ptrA)
                tmp4 = uint(ptrA[width])
                tmp6 = uint(ptrA[width * 2u])
                tmp2 *= valY
                tmp2 += tmp4 * yFrac
                tmp4 *= valY
                tmp4 += tmp6 * yFrac
                tmp1 = tmp1 * valX + plus32
                tmp3 = tmp3 * valX + plus32
                tmp1 += tmp2 * xFrac
                tmp1 >>= 6u
                tmp3 += tmp4 * xFrac
                tmp3 >>= 6u
                cbr[8] = uint8(tmp3)
                var _t0 = cbr
                cbr++
                *_t0 = uint8(tmp1)
                ptrA++
                tmp1 = uint(*ptrA)
                tmp3 = uint(ptrA[width])
                tmp5 = uint(ptrA[width * 2u])
                tmp1 *= valY
                tmp1 += tmp3 * yFrac
                tmp3 *= valY
                tmp3 += tmp5 * yFrac
                tmp2 = tmp2 * valX + plus32
                tmp4 = tmp4 * valX + plus32
                tmp2 += tmp1 * xFrac
                tmp2 >>= 6u
                tmp4 += tmp3 * xFrac
                tmp4 >>= 6u
                cbr[8] = uint8(tmp4)
                var _t1 = cbr
                cbr++
                *_t1 = uint8(tmp2)
                x--
            }
            cbr += uint(2 * 8) - chromaPartWidth
            ptrA += 2u * width - chromaPartWidth
            y--
        }
    }
}

[c_function]
def private h264_file_all__PredictChroma(var mbPartChroma : uint8?; xAL : uint; yAL : uint; partWidth : uint; partHeight : uint; var mv : mv_t?;
                                         var refPic : image_t?) {
    // Variables
    var xFrac : uint
    var yFrac : uint
    var width : uint
    var height : uint
    var chromaPartWidth : uint
    var chromaPartHeight : uint
    var xInt : int
    var yInt : int
    var ref : uint8?
    // Code
    width = 8u * refPic.width
    height = 8u * refPic.height
    xInt = int((xAL >> 1u) + uint(int(mv.hor) >> 3))
    yInt = int((yAL >> 1u) + uint(int(mv.ver) >> 3))
    xFrac = uint(int(mv.hor) & 7)
    yFrac = uint(int(mv.ver) & 7)
    chromaPartWidth = partWidth >> 1u
    chromaPartHeight = partHeight >> 1u
    ref = refPic.data + 256u * refPic.width * refPic.height
    if (xFrac != 0 && yFrac != 0) {
        h264bsdInterpolateChromaHorVer(ref, mbPartChroma, xInt, yInt, width, height, xFrac, yFrac, chromaPartWidth, chromaPartHeight)
    } elif (xFrac != 0) {
        h264bsdInterpolateChromaHor(ref, mbPartChroma, xInt, yInt, width, height, xFrac, chromaPartWidth, chromaPartHeight)
    } elif (yFrac != 0) {
        h264bsdInterpolateChromaVer(ref, mbPartChroma, xInt, yInt, width, height, yFrac, chromaPartWidth, chromaPartHeight)
    } else {
        h264bsdFillBlock(ref, mbPartChroma, xInt, yInt, width, height, chromaPartWidth, chromaPartHeight, 8u)
        ref += width * height
        h264bsdFillBlock(ref, mbPartChroma + 8 * 8, xInt, yInt, width, height, chromaPartWidth, chromaPartHeight, 8u)
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdInterpolateVerHalf
// Functional description:
// Function to perform vertical interpolation of pixel position 'h'
// for a block. Overfilling is done only if needed. Reference
// image (ref) is read at correct position and the predicted part
// is written to macroblock array (mb)
// ------------------------------------------------------------------------------
[c_function]
def h264bsdInterpolateVerHalf(var ref : uint8?; var mb : uint8?; var x0 : int; var y0 : int; var width : uint; height : uint; partWidth : uint;
                              partHeight : uint) {
    var p1 : uint[111]
    var i : uint
    var j : uint
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var tmp5 : int
    var tmp6 : int
    var tmp7 : int
    var ptrC : uint8?
    var ptrV : uint8?
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if ((x0 < 0) || (uint(x0) + partWidth > width) || (y0 < 0) || (uint(y0) + partHeight + 5u > height)) {
        h264bsdFillBlock(ref, reinterpret<uint8?>(addr(p1[0])), x0, y0, width, height, partWidth, partHeight + 5u, partWidth)
        x0 = 0
        y0 = 0
        ref = reinterpret<uint8?>(addr(p1[0]))
        width = partWidth
    }
    ref += uint(y0) * width + uint(x0)
    ptrC = ref + width
    ptrV = ptrC + 5u * width
    // 4 pixels per iteration, interpolate using 5 vertical samples
    i = partHeight >> 2u
    while (i != 0) {
        // h1 = (16 + A + 16(G+M) + 4(G+M) - 4(C+R) - (C+R) + T) >> 5
        j = partWidth
        while (j != 0) {
            tmp4 = int(ptrV[-int(width) * 2])
            tmp5 = int(ptrV[-int(width)])
            tmp1 = int(ptrV[width])
            tmp2 = int(ptrV[width * 2u])
            var _t0 = ptrV
            ptrV++
            tmp6 = int(*_t0)
            tmp7 = tmp4 + tmp1
            tmp2 -= tmp7 << 2
            tmp2 -= tmp7
            tmp2 += 16
            tmp7 = tmp5 + tmp6
            tmp3 = int(ptrC[width * 2u])
            tmp2 += tmp7 << 4
            tmp2 += tmp7 << 2
            tmp2 += tmp3
            tmp2 = int(clp[tmp2 >> 5])
            tmp1 += 16
            mb[48] = uint8(tmp2)
            tmp7 = tmp3 + tmp6
            tmp1 -= tmp7 << 2
            tmp1 -= tmp7
            tmp7 = tmp4 + tmp5
            tmp2 = int(ptrC[width])
            tmp1 += tmp7 << 4
            tmp1 += tmp7 << 2
            tmp1 += tmp2
            tmp1 = int(clp[tmp1 >> 5])
            tmp6 += 16
            mb[32] = uint8(tmp1)
            tmp7 = tmp2 + tmp5
            tmp6 -= tmp7 << 2
            tmp6 -= tmp7
            tmp7 = tmp4 + tmp3
            tmp1 = int(*ptrC)
            tmp6 += tmp7 << 4
            tmp6 += tmp7 << 2
            tmp6 += tmp1
            tmp6 = int(clp[tmp6 >> 5])
            tmp5 += 16
            mb[16] = uint8(tmp6)
            tmp1 += tmp4
            tmp5 -= tmp1 << 2
            tmp5 -= tmp1
            tmp3 += tmp2
            tmp6 = int(ptrC[-int(width)])
            tmp5 += tmp3 << 4
            tmp5 += tmp3 << 2
            tmp5 += tmp6
            tmp5 = int(clp[tmp5 >> 5])
            var _t1 = mb
            mb++
            *_t1 = uint8(tmp5)
            ptrC++
            j--
        }
        ptrC += 4u * width - partWidth
        ptrV += 4u * width - partWidth
        mb += uint(4 * 16) - partWidth
        i--
    }
}

[c_function]
def h264bsdInterpolateVerQuarter(var ref : uint8?; var mb : uint8?; var x0 : int; var y0 : int; var width : uint; height : uint; partWidth : uint;
                                 partHeight : uint; verOffset : uint) {
    // 0 for pixel d, 1 for pixel n
    var p1 : uint[111]
    var i : uint
    var j : uint
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var tmp5 : int
    var tmp6 : int
    var tmp7 : int
    var ptrC : uint8?
    var ptrV : uint8?
    var ptrInt : uint8?
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if ((x0 < 0) || (uint(x0) + partWidth > width) || (y0 < 0) || (uint(y0) + partHeight + 5u > height)) {
        h264bsdFillBlock(ref, reinterpret<uint8?>(addr(p1[0])), x0, y0, width, height, partWidth, partHeight + 5u, partWidth)
        x0 = 0
        y0 = 0
        ref = reinterpret<uint8?>(addr(p1[0]))
        width = partWidth
    }
    ref += uint(y0) * width + uint(x0)
    ptrC = ref + width
    ptrV = ptrC + 5u * width
    // Pointer to integer sample position, either M or R
    ptrInt = ptrC + (2u + verOffset) * width
    // 4 pixels per iteration
    // interpolate using 5 vertical samples and average between
    // interpolated value and integer sample value
    i = partHeight >> 2u
    while (i != 0) {
        // h1 = (16 + A + 16(G+M) + 4(G+M) - 4(C+R) - (C+R) + T) >> 5
        j = partWidth
        while (j != 0) {
            tmp4 = int(ptrV[-int(width) * 2])
            tmp5 = int(ptrV[-int(width)])
            tmp1 = int(ptrV[width])
            tmp2 = int(ptrV[width * 2u])
            var _t0 = ptrV
            ptrV++
            tmp6 = int(*_t0)
            tmp7 = tmp4 + tmp1
            tmp2 -= tmp7 << 2
            tmp2 -= tmp7
            tmp2 += 16
            tmp7 = tmp5 + tmp6
            tmp3 = int(ptrC[width * 2u])
            tmp2 += tmp7 << 4
            tmp2 += tmp7 << 2
            tmp2 += tmp3
            tmp2 = int(clp[tmp2 >> 5])
            tmp7 = int(ptrInt[width * 2u])
            tmp1 += 16
            tmp2++
            mb[48] = uint8((tmp2 + tmp7) >> 1)
            tmp7 = tmp3 + tmp6
            tmp1 -= tmp7 << 2
            tmp1 -= tmp7
            tmp7 = tmp4 + tmp5
            tmp2 = int(ptrC[width])
            tmp1 += tmp7 << 4
            tmp1 += tmp7 << 2
            tmp1 += tmp2
            tmp1 = int(clp[tmp1 >> 5])
            tmp7 = int(ptrInt[width])
            tmp6 += 16
            tmp1++
            mb[32] = uint8((tmp1 + tmp7) >> 1)
            tmp7 = tmp2 + tmp5
            tmp6 -= tmp7 << 2
            tmp6 -= tmp7
            tmp7 = tmp4 + tmp3
            tmp1 = int(*ptrC)
            tmp6 += tmp7 << 4
            tmp6 += tmp7 << 2
            tmp6 += tmp1
            tmp6 = int(clp[tmp6 >> 5])
            tmp7 = int(*ptrInt)
            tmp5 += 16
            tmp6++
            mb[16] = uint8((tmp6 + tmp7) >> 1)
            tmp1 += tmp4
            tmp5 -= tmp1 << 2
            tmp5 -= tmp1
            tmp3 += tmp2
            tmp6 = int(ptrC[-int(width)])
            tmp5 += tmp3 << 4
            tmp5 += tmp3 << 2
            tmp5 += tmp6
            tmp5 = int(clp[tmp5 >> 5])
            tmp7 = int(ptrInt[-int(width)])
            tmp5++
            var _t1 = mb
            mb++
            *_t1 = uint8((tmp5 + tmp7) >> 1)
            ptrC++
            ptrInt++
            j--
        }
        ptrC += 4u * width - partWidth
        ptrV += 4u * width - partWidth
        ptrInt += 4u * width - partWidth
        mb += uint(4 * 16) - partWidth
        i--
    }
}

[c_function]
def h264bsdInterpolateHorHalf(var ref : uint8?; var mb : uint8?; var x0 : int; var y0 : int; var width : uint; height : uint; partWidth : uint;
                              partHeight : uint) {
    var p1 : uint[111]
    var ptrJ : uint8?
    var x : uint
    var y : uint
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var tmp5 : int
    var tmp6 : int
    var tmp7 : int
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if ((x0 < 0) || (uint(x0) + partWidth + 5u > width) || (y0 < 0) || (uint(y0) + partHeight > height)) {
        h264bsdFillBlock(ref, reinterpret<uint8?>(addr(p1[0])), x0, y0, width, height, partWidth + 5u, partHeight, partWidth + 5u)
        x0 = 0
        y0 = 0
        ref = reinterpret<uint8?>(addr(p1[0]))
        width = partWidth + 5u
    }
    ref += uint(y0) * width + uint(x0)
    ptrJ = ref + 5
    y = partHeight
    while (y != 0) {
        tmp6 = int(*(ptrJ - 5))
        tmp5 = int(*(ptrJ - 4))
        tmp4 = int(*(ptrJ - 3))
        tmp3 = int(*(ptrJ - 2))
        tmp2 = int(*(ptrJ - 1))
        // calculate 4 pels per iteration
        x = partWidth >> 2u
        while (x != 0) {
            // First pixel
            tmp6 += 16
            tmp7 = tmp3 + tmp4
            tmp6 += tmp7 << 4
            tmp6 += tmp7 << 2
            tmp7 = tmp2 + tmp5
            var _t0 = ptrJ
            ptrJ++
            tmp1 = int(*_t0)
            tmp6 -= tmp7 << 2
            tmp6 -= tmp7
            tmp6 += tmp1
            tmp6 = int(clp[tmp6 >> 5])
            // Second pixel
            tmp5 += 16
            tmp7 = tmp2 + tmp3
            var _t1 = mb
            mb++
            *_t1 = uint8(tmp6)
            tmp5 += tmp7 << 4
            tmp5 += tmp7 << 2
            tmp7 = tmp1 + tmp4
            var _t2 = ptrJ
            ptrJ++
            tmp6 = int(*_t2)
            tmp5 -= tmp7 << 2
            tmp5 -= tmp7
            tmp5 += tmp6
            tmp5 = int(clp[tmp5 >> 5])
            // Third pixel
            tmp4 += 16
            tmp7 = tmp1 + tmp2
            var _t3 = mb
            mb++
            *_t3 = uint8(tmp5)
            tmp4 += tmp7 << 4
            tmp4 += tmp7 << 2
            tmp7 = tmp6 + tmp3
            var _t4 = ptrJ
            ptrJ++
            tmp5 = int(*_t4)
            tmp4 -= tmp7 << 2
            tmp4 -= tmp7
            tmp4 += tmp5
            tmp4 = int(clp[tmp4 >> 5])
            // Fourth pixel
            tmp3 += 16
            tmp7 = tmp6 + tmp1
            var _t5 = mb
            mb++
            *_t5 = uint8(tmp4)
            tmp3 += tmp7 << 4
            tmp3 += tmp7 << 2
            tmp7 = tmp5 + tmp2
            var _t6 = ptrJ
            ptrJ++
            tmp4 = int(*_t6)
            tmp3 -= tmp7 << 2
            tmp3 -= tmp7
            tmp3 += tmp4
            tmp3 = int(clp[tmp3 >> 5])
            tmp7 = tmp4
            tmp4 = tmp6
            tmp6 = tmp2
            tmp2 = tmp7
            var _t7 = mb
            mb++
            *_t7 = uint8(tmp3)
            tmp3 = tmp5
            tmp5 = tmp1
            x--
        }
        ptrJ += width - partWidth
        mb += 16u - partWidth
        y--
    }
}

[c_function]
def h264bsdInterpolateHorQuarter(var ref : uint8?; var mb : uint8?; var x0 : int; var y0 : int; var width : uint; height : uint; partWidth : uint;
                                 partHeight : uint; horOffset : uint) {
    // 0 for pixel a, 1 for pixel c
    var p1 : uint[111]
    var ptrJ : uint8?
    var x : uint
    var y : uint
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var tmp5 : int
    var tmp6 : int
    var tmp7 : int
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if ((x0 < 0) || (uint(x0) + partWidth + 5u > width) || (y0 < 0) || (uint(y0) + partHeight > height)) {
        h264bsdFillBlock(ref, reinterpret<uint8?>(addr(p1[0])), x0, y0, width, height, partWidth + 5u, partHeight, partWidth + 5u)
        x0 = 0
        y0 = 0
        ref = reinterpret<uint8?>(addr(p1[0]))
        width = partWidth + 5u
    }
    ref += uint(y0) * width + uint(x0)
    ptrJ = ref + 5
    y = partHeight
    while (y != 0) {
        tmp6 = int(*(ptrJ - 5))
        tmp5 = int(*(ptrJ - 4))
