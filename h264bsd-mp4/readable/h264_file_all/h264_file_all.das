    y = partHeight
    while (y != 0) {
        tmp6 = *(ptrJ - 5)
        tmp5 = *(ptrJ - 4)
        tmp4 = *(ptrJ - 3)
        tmp3 = *(ptrJ - 2)
        tmp2 = *(ptrJ - 1)
        x = partWidth >> 2u
        while (x != 0) {
            // First pixel
            tmp6 += 512
            tmp7 = tmp3 + tmp4
            tmp6 += tmp7 << 4
            tmp6 += tmp7 << 2
            tmp7 = tmp2 + tmp5
            var _t1 = ptrJ
            ptrJ++
            tmp1 = *_t1
            tmp6 -= tmp7 << 2
            tmp6 -= tmp7
            var _t2 = ptrInt
            ptrInt++
            tmp7 = *_t2
            tmp6 += tmp1
            tmp6 = int(clp[tmp6 >> 10])
            tmp7 += 16
            tmp7 = int(clp[tmp7 >> 5])
            tmp5 += 512
            tmp6++
            var _t3 = mb
            mb++
            *_t3 = uint8((tmp6 + tmp7) >> 1)
            // Second pixel
            tmp7 = tmp2 + tmp3
            tmp5 += tmp7 << 4
            tmp5 += tmp7 << 2
            tmp7 = tmp1 + tmp4
            var _t4 = ptrJ
            ptrJ++
            tmp6 = *_t4
            tmp5 -= tmp7 << 2
            tmp5 -= tmp7
            var _t5 = ptrInt
            ptrInt++
            tmp7 = *_t5
            tmp5 += tmp6
            tmp5 = int(clp[tmp5 >> 10])
            tmp7 += 16
            tmp7 = int(clp[tmp7 >> 5])
            tmp4 += 512
            tmp5++
            var _t6 = mb
            mb++
            *_t6 = uint8((tmp5 + tmp7) >> 1)
            // Third pixel
            tmp7 = tmp1 + tmp2
            tmp4 += tmp7 << 4
            tmp4 += tmp7 << 2
            tmp7 = tmp6 + tmp3
            var _t7 = ptrJ
            ptrJ++
            tmp5 = *_t7
            tmp4 -= tmp7 << 2
            tmp4 -= tmp7
            var _t8 = ptrInt
            ptrInt++
            tmp7 = *_t8
            tmp4 += tmp5
            tmp4 = int(clp[tmp4 >> 10])
            tmp7 += 16
            tmp7 = int(clp[tmp7 >> 5])
            tmp3 += 512
            tmp4++
            var _t9 = mb
            mb++
            *_t9 = uint8((tmp4 + tmp7) >> 1)
            // Fourth pixel
            tmp7 = tmp6 + tmp1
            tmp3 += tmp7 << 4
            tmp3 += tmp7 << 2
            tmp7 = tmp5 + tmp2
            var _t10 = ptrJ
            ptrJ++
            tmp4 = *_t10
            tmp3 -= tmp7 << 2
            tmp3 -= tmp7
            var _t11 = ptrInt
            ptrInt++
            tmp7 = *_t11
            tmp3 += tmp4
            tmp3 = int(clp[tmp3 >> 10])
            tmp7 += 16
            tmp7 = int(clp[tmp7 >> 5])
            tmp3++
            var _t12 = mb
            mb++
            *_t12 = uint8((tmp3 + tmp7) >> 1)
            tmp3 = tmp5
            tmp5 = tmp1
            tmp7 = tmp4
            tmp4 = tmp6
            tmp6 = tmp2
            tmp2 = tmp7
            x--
        }
        ptrJ += 5
        ptrInt += 5
        mb += 16u - partWidth
        y--
    }
}

[c_function]
def h264bsdPredictSamples(var data : uint8?; var mv : mv_t?; var refPic : image_t?; xA : uint; yA : uint; partX : uint; partY : uint; partWidth : uint;
                          partHeight : uint) {
    // Variables
    var xFrac : uint
    var yFrac : uint
    var width : uint
    var height : uint
    var xInt : int
    var yInt : int
    var lumaPartData : uint8?
    // Code
    // luma
    lumaPartData = data + 16u * partY + partX
    xFrac = uint(int(mv.hor) & 3)
    yFrac = uint(int(mv.ver) & 3)
    width = 16u * refPic.width
    height = 16u * refPic.height
    xInt = int(xA) + int(partX) + (int(mv.hor) >> 2)
    yInt = int(yA) + int(partY) + (int(mv.ver) >> 2)
    c_switch(h264_file_all__lumaFracPos[xFrac][yFrac]) {
        case(0u) {
            // G
            h264bsdFillBlock(refPic.data, lumaPartData, xInt, yInt, width, height, partWidth, partHeight, 16u)
            break
        }
        case(1u) {
            // d
            h264bsdInterpolateVerQuarter(refPic.data, lumaPartData, xInt, yInt - 2, width, height, partWidth, partHeight, 0u)
            break
        }
        case(2u) {
            // h
            h264bsdInterpolateVerHalf(refPic.data, lumaPartData, xInt, yInt - 2, width, height, partWidth, partHeight)
            break
        }
        case(3u) {
            // n
            h264bsdInterpolateVerQuarter(refPic.data, lumaPartData, xInt, yInt - 2, width, height, partWidth, partHeight, 1u)
            break
        }
        case(4u) {
            // a
            h264bsdInterpolateHorQuarter(refPic.data, lumaPartData, xInt - 2, yInt, width, height, partWidth, partHeight, 0u)
            break
        }
        case(5u) {
            // e
            h264bsdInterpolateHorVerQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 0u)
            break
        }
        case(6u) {
            // i
            h264bsdInterpolateMidHorQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 0u)
            break
        }
        case(7u) {
            // p
            h264bsdInterpolateHorVerQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 2u)
            break
        }
        case(8u) {
            // b
            h264bsdInterpolateHorHalf(refPic.data, lumaPartData, xInt - 2, yInt, width, height, partWidth, partHeight)
            break
        }
        case(9u) {
            // f
            h264bsdInterpolateMidVerQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 0u)
            break
        }
        case(10u) {
            // j
            h264bsdInterpolateMidHalf(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight)
            break
        }
        case(11u) {
            // q
            h264bsdInterpolateMidVerQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 1u)
            break
        }
        case(12u) {
            // c
            h264bsdInterpolateHorQuarter(refPic.data, lumaPartData, xInt - 2, yInt, width, height, partWidth, partHeight, 1u)
            break
        }
        case(13u) {
            // g
            h264bsdInterpolateHorVerQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 1u)
            break
        }
        case(14u) {
            // k
            h264bsdInterpolateMidHorQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 1u)
            break
        }
        case(_) {
            // case 15, r
            h264bsdInterpolateHorVerQuarter(refPic.data, lumaPartData, xInt - 2, yInt - 2, width, height, partWidth, partHeight, 3u)
            break
        }
    }
    // chroma
    h264_file_all__PredictChroma(data + 16 * 16 + (partY >> 1u) * 8u + (partX >> 1u), xA + partX, yA + partY, partWidth, partHeight, mv, refPic)
}

[c_function]
def private h264_file_all__FillRow1(var ref : uint8?; var fill : uint8?; left : int; center : int; right : int) {
    memcpy1(reinterpret<void?>(fill), reinterpret<void?>(ref), uint64(center))
}

// ------------------------------------------------------------------------------
// Function: h264bsdFillRow7
// Functional description:
// This function gets a row of reference pels when horizontal coordinate
// is partly negative or partly greater than reference picture width
// (overfilling some pels on left and/or right edge).
// Inputs:
// ref pointer to reference samples
// left amount of pixels to overfill on left-edge
// center amount of pixels to copy
// right amount of pixels to overfill on right-edge
// Outputs:
// fill pointer where samples are stored
// ------------------------------------------------------------------------------
[c_function]
def h264bsdFillRow7(var ref : uint8?; var fill : uint8?; var left : int; var center : int; var right : int) {
    var tmp : uint8 = uint8('\0')
    if (left != 0) {
        tmp = *ref
    }
    while (left != 0) {
        // lint -esym(644,tmp) tmp is initialized if used
        var _t0 = fill
        fill++
        *_t0 = tmp
        left--
    }
    while (center != 0) {
        var _t1 = fill
        fill++
        var _t2 = ref
        ref++
        *_t1 = *_t2
        center--
    }
    if (right != 0) {
        tmp = ref[-1]
    }
    while (right != 0) {
        // lint -esym(644,tmp) tmp is initialized if used
        var _t3 = fill
        fill++
        *_t3 = tmp
        right--
    }
}

[c_function]
def h264bsdFillBlock(var ref : uint8?; var fill : uint8?; var x0 : int; var y0 : int; width : uint; height : uint; blockWidth : uint; blockHeight : uint;
                     fillScanLength : uint) {
    // Variables
    var xstop : int
    var ystop : int
    var fp : function<(var a0 : uint8?; var a1 : uint8?; a2 : int; a3 : int; a4 : int) : void>
    var left : int
    var x : int
    var right : int
    var top : int
    var y : int
    var bottom : int
    // Code
    xstop = x0 + int(blockWidth)
    ystop = y0 + int(blockHeight)
    // Choose correct function whether overfilling on left-edge or right-edge
    // is needed or not
    if (x0 >= 0 && xstop <= int(width)) {
        fp = @@h264_file_all__FillRow1
    } else {
        fp = @@h264bsdFillRow7
    }
    if (ystop < 0) {
        y0 = -int(blockHeight)
    }
    if (xstop < 0) {
        x0 = -int(blockWidth)
    }
    if (y0 > int(height)) {
        y0 = int(height)
    }
    if (x0 > int(width)) {
        x0 = int(width)
    }
    xstop = x0 + int(blockWidth)
    ystop = y0 + int(blockHeight)
    if (x0 > 0) {
        ref += x0
    }
    if (y0 > 0) {
        ref += y0 * int(width)
    }
    left = x0 < 0 ? -x0 : 0
    right = xstop > int(width) ? xstop - int(width) : 0
    x = int(blockWidth) - left - right
    top = y0 < 0 ? -y0 : 0
    bottom = ystop > int(height) ? ystop - int(height) : 0
    y = int(blockHeight) - top - bottom
    if (x0 >= 0 && xstop <= int(width)) {
        while (top != 0) {
            h264_file_all__FillRow1(ref, fill, left, x, right)
            fill += fillScanLength
            top--
        }
        while (top != 0) {
            h264_file_all__FillRow1(ref, fill, left, x, right)
            top--
        }
        while (y != 0) {
            h264_file_all__FillRow1(ref, fill, left, x, right)
            ref += width
            fill += fillScanLength
            y--
        }
    } else {
        while (top != 0) {
            h264bsdFillRow7(ref, fill, left, x, right)
            fill += fillScanLength
            top--
        }
        while (top != 0) {
            h264bsdFillRow7(ref, fill, left, x, right)
            top--
        }
        while (y != 0) {
            h264bsdFillRow7(ref, fill, left, x, right)
            ref += width
            fill += fillScanLength
            y--
        }
    }
    // Top-overfilling
    // Lines inside reference image
    ref -= width
    // Bottom-overfilling
    while (bottom != 0) {
        // (*fp)(ref, fill, left, x, right);
        if (x0 >= 0 && xstop <= int(width)) {
            h264_file_all__FillRow1(ref, fill, left, x, right)
        } else {
            h264bsdFillRow7(ref, fill, left, x, right)
        }
        fill += fillScanLength
        bottom--
    }
}

[c_function]
def h264bsdDecodeSeiMessage(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?; var pSeiMessage : seiMessage_t?; numSliceGroups : uint) : uint {
    // Variables
    var tmp : uint
    var payloadType : uint
    var payloadSize : uint
    var status : uint
    // Code
    memset1(reinterpret<void?>(pSeiMessage), 0, uint64(typeinfo sizeof(type<seiMessage_t>)))
    c_do_while(h264bsdMoreRbspData(pStrmData) != 0) {
        payloadType = 0u
        while (true) {
            tmp = h264bsdGetBits(pStrmData, 8u)
            if (!(tmp == 255u)) {
                break
            }
            payloadType += 255u
        }
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        payloadType += tmp
        payloadSize = 0u
        while (true) {
            tmp = h264bsdGetBits(pStrmData, 8u)
            if (!(tmp == 255u)) {
                break
            }
            payloadSize += 255u
        }
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        payloadSize += tmp
        pSeiMessage.payloadType = payloadType
        c_switch(payloadType) {
            case(0u) {
                status = h264_file_all__DecodeBufferingPeriod(pStrmData, addr(pSeiMessage.bufferingPeriod), pSeqParamSet.vuiParameters.vclHrdParameters.cpbCnt,
                        pSeqParamSet.vuiParameters.vclHrdParameters.initialCpbRemovalDelayLength, pSeqParamSet.vuiParameters.nalHrdParametersPresentFlag,
                        pSeqParamSet.vuiParameters.vclHrdParametersPresentFlag)
                break
            }
            case(1u) {
                status = h264_file_all__DecodePictureTiming(pStrmData, addr(pSeiMessage.picTiming),
                        pSeqParamSet.vuiParameters.vclHrdParameters.cpbRemovalDelayLength, pSeqParamSet.vuiParameters.vclHrdParameters.dpbOutputDelayLength,
                        pSeqParamSet.vuiParameters.vclHrdParameters.timeOffsetLength,
                        uint(pSeqParamSet.vuiParameters.nalHrdParametersPresentFlag != 0 || pSeqParamSet.vuiParameters.vclHrdParametersPresentFlag != 0 ?
                            HANTRO_TRUE : HANTRO_FALSE),
                        pSeqParamSet.vuiParameters.picStructPresentFlag)
                break
            }
            case(2u) {
                status = h264_file_all__DecodePanScanRectangle(pStrmData, addr(pSeiMessage.panScanRect))
                break
            }
            case(3u) {
                status = h264_file_all__DecodeFillerPayload(pStrmData, payloadSize)
                break
            }
            case(4u) {
                status = h264_file_all__DecodeUserDataRegisteredITuTT35(pStrmData, addr(pSeiMessage.userDataRegisteredItuTT35), payloadSize)
                break
            }
            case(5u) {
                status = h264_file_all__DecodeUserDataUnregistered(pStrmData, addr(pSeiMessage.userDataUnregistered), payloadSize)
                break
            }
            case(6u) {
                status = h264_file_all__DecodeRecoveryPoint(pStrmData, addr(pSeiMessage.recoveryPoint))
                break
            }
            case(7u) {
                status = h264_file_all__DecodeDecRefPicMarkingRepetition(pStrmData, addr(pSeiMessage.decRefPicMarkingRepetition), pSeqParamSet.numRefFrames)
                break
            }
            case(8u) {
                status = h264_file_all__DecodeSparePic(pStrmData, addr(pSeiMessage.sparePic), pSeqParamSet.picWidthInMbs * pSeqParamSet.picHeightInMbs)
                break
            }
            case(9u) {
                status = h264_file_all__DecodeSceneInfo(pStrmData, addr(pSeiMessage.sceneInfo))
                break
            }
            case(10u) {
                status = h264_file_all__DecodeSubSeqInfo(pStrmData, addr(pSeiMessage.subSeqInfo))
                break
            }
            case(11u) {
                status = h264_file_all__DecodeSubSeqLayerCharacteristics(pStrmData, addr(pSeiMessage.subSeqLayerCharacteristics))
                break
            }
            case(12u) {
                status = h264_file_all__DecodeSubSeqCharacteristics(pStrmData, addr(pSeiMessage.subSeqCharacteristics))
                break
            }
            case(13u) {
                status = h264_file_all__DecodeFullFrameFreeze(pStrmData, addr(pSeiMessage.fullFrameFreeze))
                break
            }
            case(14u) {
                // This SEI does not contain data, what to do ???
                status = uint(HANTRO_OK)
                break
            }
            case(15u) {
                status = h264_file_all__DecodeFullFrameSnapshot(pStrmData, addr(pSeiMessage.fullFrameSnapshot))
                break
            }
            case(16u) {
                status = h264_file_all__DecodeProgressiveRefinementSegmentStart(pStrmData, addr(pSeiMessage.progressiveRefinementSegmentStart))
                break
            }
            case(17u) {
                status = h264_file_all__DecodeProgressiveRefinementSegmentEnd(pStrmData, addr(pSeiMessage.progressiveRefinementSegmentEnd))
                break
            }
            case(18u) {
                status = h264_file_all__DecodeMotionConstrainedSliceGroupSet(pStrmData, addr(pSeiMessage.motionConstrainedSliceGroupSet), numSliceGroups)
                break
            }
            case(_) {
                status = h264_file_all__DecodeReservedSeiMessage(pStrmData, addr(pSeiMessage.reservedSeiMessage), payloadSize)
                break
            }
        }
        if (status != uint(HANTRO_OK)) {
            return status
        }
        while (h264bsdIsByteAligned(pStrmData) == 0) {
            if (h264bsdGetBits(pStrmData, 1u) != 1u) {
                return uint(HANTRO_NOK)
            }
            while (h264bsdIsByteAligned(pStrmData) == 0) {
                if (h264bsdGetBits(pStrmData, 1u) != 0u) {
                    return uint(HANTRO_NOK)
                }
            }
        }
    }
    return h264bsdRbspTrailingBits(pStrmData)
}

[c_function]
def private h264_file_all__DecodeBufferingPeriod(var pStrmData : strmData_t?; var pBufferingPeriod : seiBufferingPeriod_t?; cpbCnt : uint;
                                                 initialCpbRemovalDelayLength : uint; nalHrdBpPresentFlag : uint; vclHrdBpPresentFlag : uint) : uint {
    // Variables
    var tmp : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pBufferingPeriod.seqParameterSetId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pBufferingPeriod.seqParameterSetId > 31u) {
        return uint(HANTRO_NOK)
    }
    if (nalHrdBpPresentFlag != 0) {
        for (i in urange(cpbCnt)) {
            tmp = h264bsdGetBits(pStrmData, initialCpbRemovalDelayLength)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            if (tmp == 0u) {
                return uint(HANTRO_NOK)
            }
            pBufferingPeriod.initialCpbRemovalDelay[i] = tmp
            tmp = h264bsdGetBits(pStrmData, initialCpbRemovalDelayLength)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pBufferingPeriod.initialCpbRemovalDelayOffset[i] = tmp
        }
    }
    if (vclHrdBpPresentFlag != 0) {
        for (i in urange(cpbCnt)) {
            tmp = h264bsdGetBits(pStrmData, initialCpbRemovalDelayLength)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pBufferingPeriod.initialCpbRemovalDelay[i] = tmp
            tmp = h264bsdGetBits(pStrmData, initialCpbRemovalDelayLength)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pBufferingPeriod.initialCpbRemovalDelayOffset[i] = tmp
        }
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__DecodePictureTiming(var pStrmData : strmData_t?; var pPicTiming : seiPicTiming_t?; cpbRemovalDelayLength : uint;
                                               dpbOutputDelayLength : uint; timeOffsetLength : uint; cpbDpbDelaysPresentFlag : uint; picStructPresentFlag : uint) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var itmp : int
    // Code
    if (cpbDpbDelaysPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, cpbRemovalDelayLength)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pPicTiming.cpbRemovalDelay = tmp
        tmp = h264bsdGetBits(pStrmData, dpbOutputDelayLength)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pPicTiming.dpbOutputDelay = tmp
    }
    if (picStructPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, 4u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (tmp > 8u) {
            return uint(HANTRO_NOK)
        }
        pPicTiming.picStruct = tmp
        i = 0u
        while (i < h264_file_all__numClockTS[pPicTiming.picStruct]) {
            tmp = h264bsdGetBits(pStrmData, 1u)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pPicTiming.clockTimeStampFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
            if (pPicTiming.clockTimeStampFlag[i] != 0) {
                tmp = h264bsdGetBits(pStrmData, 2u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                pPicTiming.ctType[i] = tmp
                tmp = h264bsdGetBits(pStrmData, 1u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                pPicTiming.nuitFieldBasedFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                tmp = h264bsdGetBits(pStrmData, 5u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                if (tmp > 6u) {
                    return uint(HANTRO_NOK)
                }
                pPicTiming.countingType[i] = tmp
                tmp = h264bsdGetBits(pStrmData, 1u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                pPicTiming.fullTimeStampFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                tmp = h264bsdGetBits(pStrmData, 1u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                pPicTiming.discontinuityFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                tmp = h264bsdGetBits(pStrmData, 1u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                pPicTiming.cntDroppedFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                tmp = h264bsdGetBits(pStrmData, 8u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                pPicTiming.nFrames[i] = tmp
                if (pPicTiming.fullTimeStampFlag[i] != 0) {
                    tmp = h264bsdGetBits(pStrmData, 6u)
                    if (tmp == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    if (tmp > 59u) {
                        return uint(HANTRO_NOK)
                    }
                    pPicTiming.secondsValue[i] = tmp
                    tmp = h264bsdGetBits(pStrmData, 6u)
                    if (tmp == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    if (tmp > 59u) {
                        return uint(HANTRO_NOK)
                    }
                    pPicTiming.minutesValue[i] = tmp
                    tmp = h264bsdGetBits(pStrmData, 5u)
                    if (tmp == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    if (tmp > 23u) {
                        return uint(HANTRO_NOK)
                    }
                    pPicTiming.hoursValue[i] = tmp
                } else {
                    tmp = h264bsdGetBits(pStrmData, 1u)
                    if (tmp == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    pPicTiming.secondsFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                    if (pPicTiming.secondsFlag[i] != 0) {
                        tmp = h264bsdGetBits(pStrmData, 6u)
                        if (tmp == END_OF_STREAM) {
                            return uint(HANTRO_NOK)
                        }
                        if (tmp > 59u) {
                            return uint(HANTRO_NOK)
                        }
                        pPicTiming.secondsValue[i] = tmp
                        tmp = h264bsdGetBits(pStrmData, 1u)
                        if (tmp == END_OF_STREAM) {
                            return uint(HANTRO_NOK)
                        }
                        pPicTiming.minutesFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                        if (pPicTiming.minutesFlag[i] != 0) {
                            tmp = h264bsdGetBits(pStrmData, 6u)
                            if (tmp == END_OF_STREAM) {
                                return uint(HANTRO_NOK)
                            }
                            if (tmp > 59u) {
                                return uint(HANTRO_NOK)
                            }
                            pPicTiming.minutesValue[i] = tmp
                            tmp = h264bsdGetBits(pStrmData, 1u)
                            if (tmp == END_OF_STREAM) {
                                return uint(HANTRO_NOK)
                            }
                            pPicTiming.hoursFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                            if (pPicTiming.hoursFlag[i] != 0) {
                                tmp = h264bsdGetBits(pStrmData, 5u)
                                if (tmp == END_OF_STREAM) {
                                    return uint(HANTRO_NOK)
                                }
                                if (tmp > 23u) {
                                    return uint(HANTRO_NOK)
                                }
                                pPicTiming.hoursValue[i] = tmp
                            }
                        }
                    }
                }
                if (timeOffsetLength != 0) {
                    tmp = h264bsdGetBits(pStrmData, timeOffsetLength)
                    if (tmp == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    itmp = int(tmp)
                    // following "converts" timeOffsetLength-bit signed
                    // integer into i32
                    // lint -save -e701 -e702
                    itmp <<= int(32u - timeOffsetLength)
                    itmp >>= int(32u - timeOffsetLength)
                    // lint -restore
                    pPicTiming.timeOffset[i] = itmp
                } else {
                    pPicTiming.timeOffset[i] = 0
                }
            }
            i++
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodePanScanRectangle(var pStrmData : strmData_t?; var pPanScanRectangle : seiPanScanRect_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPanScanRectangle.panScanRectId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pPanScanRectangle.panScanRectCancelFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    if (pPanScanRectangle.panScanRectCancelFlag == 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPanScanRectangle.panScanCnt))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pPanScanRectangle.panScanCnt > 2u) {
            return uint(HANTRO_NOK)
        }
        pPanScanRectangle.panScanCnt++
        i = 0u
        while (i < pPanScanRectangle.panScanCnt) {
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pPanScanRectangle.panScanRectLeftOffset[0]) + end_index(i, 32))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pPanScanRectangle.panScanRectRightOffset[0]) + end_index(i, 32))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pPanScanRectangle.panScanRectTopOffset[0]) + end_index(i, 32))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            tmp = h264bsdDecodeExpGolombSigned(pStrmData, addr(pPanScanRectangle.panScanRectBottomOffset[0]) + end_index(i, 32))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            i++
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pPanScanRectangle.panScanRectRepetitionPeriod))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pPanScanRectangle.panScanRectRepetitionPeriod > 16384u) {
            return uint(HANTRO_NOK)
        }
        if (pPanScanRectangle.panScanCnt > 1u && pPanScanRectangle.panScanRectRepetitionPeriod > 1u) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__DecodeFillerPayload(var pStrmData : strmData_t?; payloadSize : uint) : uint {
    // Variables
    // Code
    if (payloadSize != 0) {
        if (h264bsdFlushBits(pStrmData, 8u * payloadSize) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeUserDataRegisteredITuTT35(var pStrmData : strmData_t?; var pUserDataRegisteredItuTT35 : seiUserDataRegisteredItuTT35_t?;
                                                           payloadSize : uint) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var j : uint
    // Code
    tmp = h264bsdGetBits(pStrmData, 8u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pUserDataRegisteredItuTT35.ituTT35CountryCode = tmp
    if (pUserDataRegisteredItuTT35.ituTT35CountryCode != 255u) {
        i = 1u
    } else {
        tmp = h264bsdGetBits(pStrmData, 8u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pUserDataRegisteredItuTT35.ituTT35CountryCodeExtensionByte = tmp
        i = 2u
    }
    // where corresponding FREE() ???
    pUserDataRegisteredItuTT35.ituTT35PayloadByte = reinterpret<uint8?>(malloc1(uint64(payloadSize - i) * uint64(typeinfo sizeof(type<uint8>))))
    pUserDataRegisteredItuTT35.numPayloadBytes = payloadSize - i
    if (pUserDataRegisteredItuTT35.ituTT35PayloadByte == null) {
        return uint(MEMORY_ALLOCATION_ERROR)
    }
    j = 0u
    c_do_while(i < payloadSize) {
        tmp = h264bsdGetBits(pStrmData, 8u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pUserDataRegisteredItuTT35.ituTT35PayloadByte[j] = uint8(tmp)
        i++
        j++
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeUserDataUnregistered(var pStrmData : strmData_t?; var pUserDataUnregistered : seiUserDataUnregistered_t?;
                                                      payloadSize : uint) : uint {
    // Variables
    var tmp : uint
    // Code
    for (i in urange(4u)) {
        pUserDataUnregistered.uuidIsoIec11578[i] = h264bsdShowBits32(pStrmData)
        if (h264bsdFlushBits(pStrmData, 32u) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
    }
    // where corresponding FREE() ???
    pUserDataUnregistered.userDataPayloadByte = reinterpret<uint8?>(malloc1(uint64(payloadSize - 16u) * uint64(typeinfo sizeof(type<uint8>))))
    if (pUserDataUnregistered.userDataPayloadByte == null) {
        return uint(MEMORY_ALLOCATION_ERROR)
    }
    pUserDataUnregistered.numPayloadBytes = payloadSize - 16u
    for (i in urange(payloadSize - 16u)) {
        tmp = h264bsdGetBits(pStrmData, 8u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pUserDataUnregistered.userDataPayloadByte[i] = uint8(tmp)
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeRecoveryPoint(var pStrmData : strmData_t?; var pRecoveryPoint : seiRecoveryPoint_t?) : uint {
    // Variables
    var tmp : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pRecoveryPoint.recoveryFrameCnt))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pRecoveryPoint.exactMatchFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pRecoveryPoint.brokenLinkFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 2u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (tmp > 2u) {
        return uint(HANTRO_NOK)
    }
    pRecoveryPoint.changingSliceGroupIdc = tmp
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeDecRefPicMarkingRepetition(var pStrmData : strmData_t?; var pDecRefPicMarkingRepetition : seiDecRefPicMarkingRepetition_t?;
                                                            numRefFrames : uint) : uint {
    // Variables
    var tmp : uint
    // Code
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pDecRefPicMarkingRepetition.originalIdrFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pDecRefPicMarkingRepetition.originalFrameNum))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // frame_mbs_only_flag assumed always true so some field related syntax
    // elements are skipped, see H.264 standard
    // tmp = h264bsdDecRefPicMarking(pStrmData,
    // &pDecRefPicMarkingRepetition->decRefPicMarking, NAL_SEI, numRefFrames);
    return uint(HANTRO_NOK)
    return tmp
}

[c_function]
def private h264_file_all__DecodeSparePic(var pStrmData : strmData_t?; var pSparePic : seiSparePic_t?; picSizeInMapUnits : uint) : uint {
    // Variables
    var tmp : uint
    var i : uint
    var j : uint
    var mapUnitCnt : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSparePic.targetFrameNum))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSparePic.spareFieldFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    // do not accept fields
    if (pSparePic.spareFieldFlag != 0) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSparePic.numSparePics))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSparePic.numSparePics++
    if (pSparePic.numSparePics > uint(MAX_NUM_SPARE_PICS)) {
        return uint(HANTRO_NOK)
    }
    i = 0u
    while (i < pSparePic.numSparePics) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSparePic.deltaSpareFrameNum[0]) + end_index(i, 16))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSparePic.spareAreaIdc[0]) + end_index(i, 16))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pSparePic.spareAreaIdc[i] > 2u) {
            return uint(HANTRO_NOK)
        }
        if (pSparePic.spareAreaIdc[i] == 1u) {
            // where corresponding FREE() ???
            pSparePic.spareUnitFlag[i] = reinterpret<uint?>(malloc1(uint64(picSizeInMapUnits) * uint64(typeinfo sizeof(type<uint>))))
            if (pSparePic.spareUnitFlag[i] == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            pSparePic.zeroRunLength[i] = null
            j = 0u
            while (j < picSizeInMapUnits) {
                tmp = h264bsdGetBits(pStrmData, 1u)
                if (tmp == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                pSparePic.spareUnitFlag[i][j] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
                j++
            }
        } elif (pSparePic.spareAreaIdc[i] == 2u) {
            // where corresponding FREE() ???
            pSparePic.zeroRunLength[i] = reinterpret<uint?>(malloc1(uint64(picSizeInMapUnits) * uint64(typeinfo sizeof(type<uint>))))
            if (pSparePic.zeroRunLength[i] == null) {
                return uint(MEMORY_ALLOCATION_ERROR)
            }
            pSparePic.spareUnitFlag[i] = null
            j = 0u
            mapUnitCnt = 0u
            while (mapUnitCnt < picSizeInMapUnits) {
                tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSparePic.zeroRunLength[i][j]))
                if (tmp != uint(HANTRO_OK)) {
                    return tmp
                }
                mapUnitCnt += pSparePic.zeroRunLength[i][j] + 1u
                j++
            }
        }
        i++
    }
    // set rest to null
    for (i1 in urange(pSparePic.numSparePics, uint(MAX_NUM_SPARE_PICS))) {
        pSparePic.spareUnitFlag[i1] = null
        pSparePic.zeroRunLength[i1] = null
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeSceneInfo(var pStrmData : strmData_t?; var pSceneInfo : seiSceneInfo_t?) : uint {
    // Variables
    var tmp : uint
    // Code
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSceneInfo.sceneInfoPresentFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    if (pSceneInfo.sceneInfoPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSceneInfo.sceneId))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSceneInfo.sceneTransitionType))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pSceneInfo.sceneTransitionType > 6u) {
            return uint(HANTRO_NOK)
        }
        if (pSceneInfo.sceneTransitionType != 0) {
            tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSceneInfo.secondSceneId))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeSubSeqInfo(var pStrmData : strmData_t?; var pSubSeqInfo : seiSubSeqInfo_t?) : uint {
    // Variables
    var tmp : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqInfo.subSeqLayerNum))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSubSeqInfo.subSeqLayerNum > 255u) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqInfo.subSeqId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSubSeqInfo.subSeqId > 65535u) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSubSeqInfo.firstRefPicFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSubSeqInfo.leadingNonRefPicFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSubSeqInfo.lastPicFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSubSeqInfo.subSeqFrameNumFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    if (pSubSeqInfo.subSeqFrameNumFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqInfo.subSeqFrameNum))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeSubSeqLayerCharacteristics(var pStrmData : strmData_t?;
                                                            var pSubSeqLayerCharacteristics : seiSubSeqLayerCharacteristics_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqLayerCharacteristics.numSubSeqLayers))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    pSubSeqLayerCharacteristics.numSubSeqLayers++
    if (pSubSeqLayerCharacteristics.numSubSeqLayers > uint(MAX_NUM_SUB_SEQ_LAYERS)) {
        return uint(HANTRO_NOK)
    }
    i = 0u
    while (i < pSubSeqLayerCharacteristics.numSubSeqLayers) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSubSeqLayerCharacteristics.accurateStatisticsFlag[i] = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdGetBits(pStrmData, 16u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSubSeqLayerCharacteristics.averageBitRate[i] = tmp
        tmp = h264bsdGetBits(pStrmData, 16u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSubSeqLayerCharacteristics.averageFrameRate[i] = tmp
        i++
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeSubSeqCharacteristics(var pStrmData : strmData_t?; var pSubSeqCharacteristics : seiSubSeqCharacteristics_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqCharacteristics.subSeqLayerNum))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSubSeqCharacteristics.subSeqLayerNum > uint(MAX_NUM_SUB_SEQ_LAYERS - 1)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqCharacteristics.subSeqId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSubSeqCharacteristics.subSeqId > 65535u) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSubSeqCharacteristics.durationFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    if (pSubSeqCharacteristics.durationFlag != 0) {
        pSubSeqCharacteristics.subSeqDuration = h264bsdShowBits32(pStrmData)
        if (h264bsdFlushBits(pStrmData, 32u) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pSubSeqCharacteristics.averageRateFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
    if (pSubSeqCharacteristics.averageRateFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSubSeqCharacteristics.accurateStatisticsFlag = uint(tmp == 1u ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdGetBits(pStrmData, 16u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSubSeqCharacteristics.averageBitRate = tmp
        tmp = h264bsdGetBits(pStrmData, 16u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSubSeqCharacteristics.averageFrameRate = tmp
    }
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqCharacteristics.numReferencedSubseqs))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSubSeqCharacteristics.numReferencedSubseqs > uint(MAX_NUM_SUB_SEQ_LAYERS - 1)) {
        return uint(HANTRO_NOK)
    }
    i = 0u
    while (i < pSubSeqCharacteristics.numReferencedSubseqs) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqCharacteristics.refSubSeqLayerNum[0]) + end_index(i, 256))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pSubSeqCharacteristics.refSubSeqId[0]) + end_index(i, 256))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pSubSeqCharacteristics.refSubSeqDirection[i] = tmp
        i++
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeFullFrameFreeze(var pStrmData : strmData_t?; var pFullFrameFreeze : seiFullFrameFreeze_t?) : uint {
