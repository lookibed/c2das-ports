    h264_file_all__frames.input.bytes = source
    h264_file_all__frames.input.length = length
    h264_file_all__frames.frame_index = -1
    if (MP4D_open(addr(h264_file_all__frames.mp4), @@h264_file_all__memory_read_callback, reinterpret<void?>(addr(h264_file_all__frames.input)),
                int64(length)) ==
            0) {
        h264_file_all__frames = null
        return 0
    }
    h264_file_all__frames.track_index = h264_file_all__find_avc_track(addr(h264_file_all__frames.mp4))
    if (h264_file_all__frames.track_index < 0) {
        h264_file_all__frames_release()
        return 0
    }
    h264_file_all__frames.track_length_size = h264_file_all__detect_track_length_size(addr(h264_file_all__frames.mp4), h264_file_all__frames.track_index,
            h264_file_all__frames.input.bytes, h264_file_all__frames.input.length)
    if (h264_file_all__frames.track_length_size <= 0) {
        h264_file_all__frames_release()
        return 0
    }
    h264_file_all__frames.prefix_bytes = h264_file_all__header_annexb_size(addr(h264_file_all__frames.mp4), h264_file_all__frames.track_index)
    sample_index = 0
    while (sample_index < int(h264_file_all__frames.mp4.track[h264_file_all__frames.track_index].sample_count)) {
        var frame_bytes : uint = 0u
        let offset : uint64 = MP4D_frame_offset(addr(h264_file_all__frames.mp4), uint(h264_file_all__frames.track_index), uint(sample_index), addr(frame_bytes),
                null, null)
        var annexb_bytes : int = 0
        if ((offset + uint64(frame_bytes)) > uint64(uint(h264_file_all__frames.input.length))) {
            h264_file_all__frames_release()
            return 0
        }
        annexb_bytes = h264_file_all__sample_annexb_size(h264_file_all__frames.input.bytes + offset, int(frame_bytes), h264_file_all__frames.track_length_size)
        if (annexb_bytes < 0) {
            h264_file_all__frames_release()
            return 0
        }
        if ((annexb_bytes + h264_file_all__frames.prefix_bytes) > h264_file_all__frames.max_sample_bytes) {
            h264_file_all__frames.max_sample_bytes = annexb_bytes + h264_file_all__frames.prefix_bytes
        }
        sample_index++
    }
    h264_file_all__frames.scratch = reinterpret<uint8?>(malloc1(uint64(h264_file_all__frames.max_sample_bytes)))
    if (h264_file_all__frames.scratch == null) {
        h264_file_all__frames_release()
        return 0
    }
    h264_file_all__frames.state.storage = h264bsdAlloc()
    if (h264_file_all__frames.state.storage == null) {
        h264_file_all__frames_release()
        return 0
    }
    if (h264bsdInit(h264_file_all__frames.state.storage, 0u) != uint(anon_277.H264BSD_RDY)) {
        h264bsdFree(h264_file_all__frames.state.storage)
        h264_file_all__frames_release()
        return 0
    }
    h264_file_all__frames.decoder_ready = 1
    return 1
}

[c_function]
def h264mp4_frames_begin : int {
    return h264mp4_frames_begin_bytes(addr(h264_file_all__sample_mp4_bytes[0]), int(h264_file_all__sample_mp4_len))
}

[c_function]
def h264mp4_frames_next : int {
    if (h264_file_all__frames == null || h264_file_all__frames.decoder_ready == 0) {
        return 0
    }
    while (h264_file_all__frames.sample_index < int(h264_file_all__frames.mp4.track[h264_file_all__frames.track_index].sample_count)) {
        var frame_bytes : uint = 0u
        let offset : uint64 = MP4D_frame_offset(addr(h264_file_all__frames.mp4), uint(h264_file_all__frames.track_index),
                uint(h264_file_all__frames.sample_index), addr(frame_bytes), null, null)
        let sample_length : int = h264_file_all__build_annexb_sample(addr(h264_file_all__frames.mp4), h264_file_all__frames.track_index,
                h264_file_all__frames.input.bytes + offset, int(frame_bytes), int_of(h264_file_all__frames.sample_index == 0), h264_file_all__frames.scratch,
                h264_file_all__frames.max_sample_bytes, h264_file_all__frames.track_length_size)
        var picture_ready : int = 0
        h264_file_all__frames.sample_index += 1
        if (sample_length < 0) {
            return 0
        }
        if (h264_file_all__decode_access_unit(addr(h264_file_all__frames.state), h264_file_all__frames.scratch, sample_length, addr(picture_ready)) == 0) {
            return 0
        }
        if (picture_ready != 0) {
            let picture_bytes : int = (h264_file_all__frames.state.width * h264_file_all__frames.state.height * 3) / 2
            h264_file_all__frames.hash = h264_file_all__fold_bytes(h264_file_all__frames.state.picture, picture_bytes)
            h264_file_all__frames.frame_index += 1
            return 1
        }
    }
    return 0
}

def h264mp4_frames_hash : int {
    return h264_file_all__frames != null ? int(h264_file_all__frames.hash) : 0
}

def h264mp4_frames_index : int {
    return h264_file_all__frames != null ? h264_file_all__frames.frame_index : -1
}

def h264mp4_frames_width : int {
    return h264_file_all__frames != null ? h264_file_all__frames.state.width : 0
}

def h264mp4_frames_height : int {
    return h264_file_all__frames != null ? h264_file_all__frames.state.height : 0
}

def h264mp4_frames_end : int {
    h264_file_all__frames_release()
    return 1
}

[c_function]
def private h264_file_all__load_last_argument(argc : int; var argv : uint8 ??) : int {
    var f : FILE? = null
    var got : uint64 = 0ul
    if (argc < 2) {
        return 0
    }
    f = reinterpret<FILE?>(crt::fopen(argv[argc - 1], cstr("rb")))
    if (f == null) {
        return 0
    }
    got = crt::fread(reinterpret<void?>(addr(h264_file_all__file_bytes[0])), 1ul, uint64(MAX_FILE_BYTES), reinterpret<void?>(f))
    crt::fclose(reinterpret<void?>(f))
    return int(got)
}

[c_function]
def c_main(argc : int; var argv : uint8 ??) : int {
    var frames : int = 0
    var length : int = 0
    crt::setvbuf(crt::c_stdout(), null, _IONBF, 0ul)
    length = h264_file_all__load_last_argument(argc, argv)
    if (length <= 0) {
        printf(cstr("load=0\n"))
        return 2
    }
    printf(cstr("bytes=%d\n"), length)
    if (h264mp4_frames_begin_bytes(addr(h264_file_all__file_bytes[0]), length) == 0) {
        printf(cstr("frames_begin=0\n"))
        return 1
    }
    while (h264mp4_frames_next() != 0) {
        printf(cstr("frame[%d]=%d\n"), h264mp4_frames_index(), h264mp4_frames_hash())
        frames += 1
    }
    printf(cstr("width=%d\n"), h264mp4_frames_width())
    printf(cstr("height=%d\n"), h264mp4_frames_height())
    h264mp4_frames_end()
    printf(cstr("frames=%d\n"), frames)
    return frames > 0 ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("h264_file_all")
    return c_main(c_argc(), c_argv())
}
