    h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag))
    payload_bytes = box_bytes - 8ul
    h264_file_all__my_fseek(addr(mp4), payload_bytes, addr(eof_flag))
    h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag))
    return int(h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag)))
}

[c_function]
