    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = 0u
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id when necessary
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    // delta_pic_order_cnt[0]
    tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(deltaPicOrderCnt[0]))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // delta_pic_order_cnt[1] if present
    if (picOrderPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(deltaPicOrderCnt[1]))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdCheckRedundantPicCnt(var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?; var pPicParamSet : picParamSet_t?; nalUnitType : nalUnitType_e;
                                var redundantPicCnt : uint?) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var ivalue : int
    var tmpStrmData : strmData_t[1]
    // Code
    // redundant_pic_cnt_flag must be TRUE
    // don't touch original stream position params
    *addr(tmpStrmData[0]) = *pStrmData
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = 0u
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id when necessary
    if (nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    if (pSeqParamSet.picOrderCntType == 0u) {
        // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
        i = 0u
        while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
            i++
        }
        i--
        // pic_order_cnt_lsb
        tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (pPicParamSet.picOrderPresentFlag != 0) {
            // skip delta_pic_order_cnt_bottom
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    if (pSeqParamSet.picOrderCntType == 1u && pSeqParamSet.deltaPicOrderAlwaysZeroFlag == 0) {
        // delta_pic_order_cnt[0]
        tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // delta_pic_order_cnt[1] if present
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    // redundant_pic_cnt
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), redundantPicCnt)
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdCheckPriorPicsFlag
// Functional description:
// Peek value of no_output_of_prior_pics_flag from the slice header.
// Function does not modify current stream positions but copies
// the stream data structure to tmp structure which is used while
// accessing stream data.
// Inputs:
// pStrmData pointer to stream data structure
// pSeqParamSet pointer to active SPS
// pPicParamSet pointer to active PPS
// nalUnitType type of the current NAL unit
// Outputs:
// noOutputOfPriorPicsFlag value is stored here
// Returns:
// HANTRO_OK success
// HANTRO_NOK invalid stream data
// ------------------------------------------------------------------------------
// lint -e715 disable lint info nalUnitType not referenced
[c_function]
def h264bsdCheckPriorPicsFlag(var noOutputOfPriorPicsFlag : uint?; var pStrmData : strmData_t?; var pSeqParamSet : seqParamSet_t?;
                              var pPicParamSet : picParamSet_t?; nalUnitType : nalUnitType_e) : uint {
    // Variables
    var tmp : uint
    var value : uint
    var i : uint
    var ivalue : int
    var tmpStrmData : strmData_t[1]
    // Code
    // must be IDR lsice
    // don't touch original stream position params
    *addr(tmpStrmData[0]) = *pStrmData
    // skip first_mb_in_slice
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // slice_type
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // skip pic_parameter_set_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // log2(maxFrameNum) -> num bits to represent frame_num
    i = 0u
    while (pSeqParamSet.maxFrameNum >> i != 0) {
        i++
    }
    i--
    // skip frame_num
    tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    // skip idr_pic_id
    tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    if (pSeqParamSet.picOrderCntType == 0u) {
        // log2(maxPicOrderCntLsb) -> num bits to represent pic_order_cnt_lsb
        i = 0u
        while (pSeqParamSet.maxPicOrderCntLsb >> i != 0) {
            i++
        }
        i--
        // skip pic_order_cnt_lsb
        tmp = h264bsdGetBits(addr(tmpStrmData[0]), i)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (pPicParamSet.picOrderPresentFlag != 0) {
            // skip delta_pic_order_cnt_bottom
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    if (pSeqParamSet.picOrderCntType == 1u && pSeqParamSet.deltaPicOrderAlwaysZeroFlag == 0) {
        // skip delta_pic_order_cnt[0]
        tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        // skip delta_pic_order_cnt[1] if present
        if (pPicParamSet.picOrderPresentFlag != 0) {
            tmp = h264bsdDecodeExpGolombSigned(addr(tmpStrmData[0]), addr(ivalue))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
        }
    }
    // skip redundant_pic_cnt
    if (pPicParamSet.redundantPicCntPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(addr(tmpStrmData[0]), addr(value))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    *noOutputOfPriorPicsFlag = h264bsdGetBits(addr(tmpStrmData[0]), 1u)
    if (*noOutputOfPriorPicsFlag == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdInitStorage(var pStorage : storage?) {
    // Variables
    // Code
    memset1(reinterpret<void?>(pStorage), 0, uint64(typeinfo sizeof(type<storage>)))
    pStorage.activeSpsId = uint(MAX_NUM_SEQ_PARAM_SETS)
    pStorage.activePpsId = uint(MAX_NUM_PIC_PARAM_SETS)
    addr(pStorage.aub[0]).firstCallFlag = uint(HANTRO_TRUE)
}

[c_function]
def h264bsdStoreSeqParamSet(var pStorage : storage?; var pSeqParamSet : seqParamSet_t?) : uint {
    // Variables
    var id : uint
    // Code
    id = pSeqParamSet.seqParameterSetId
    // seq parameter set with id not used before -> allocate memory
    if (pStorage.sps[id] == null) {
        pStorage.sps[id] = reinterpret<seqParamSet_t?>(malloc1(1ul * uint64(typeinfo sizeof(type<seqParamSet_t>))))
        if (pStorage.sps[id] == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
    } elif (id == pStorage.activeSpsId) {
        // sequence parameter set with id equal to id of active sps
        // if seq parameter set contents changes
        // -> overwrite and re-activate when next IDR picture decoded
        // ids of active param sets set to invalid values to force
        // re-activation. Memories allocated for old sps freed
        // otherwise free memeries allocated for just decoded sps and
        // continue
        if (h264bsdCompareSeqParamSets(pSeqParamSet, pStorage.activeSps) != 0u) {
            free1(reinterpret<void?>(pStorage.sps[id].offsetForRefFrame))
            pStorage.sps[id].offsetForRefFrame = null
            free1(reinterpret<void?>(pStorage.sps[id].vuiParameters))
            pStorage.sps[id].vuiParameters = null
            pStorage.activeSpsId = uint(MAX_NUM_SEQ_PARAM_SETS + 1)
            pStorage.activePpsId = uint(MAX_NUM_PIC_PARAM_SETS + 1)
            pStorage.activeSps = null
            pStorage.activePps = null
        } else {
            free1(reinterpret<void?>(pSeqParamSet.offsetForRefFrame))
            pSeqParamSet.offsetForRefFrame = null
            free1(reinterpret<void?>(pSeqParamSet.vuiParameters))
            pSeqParamSet.vuiParameters = null
            return uint(HANTRO_OK)
        }
    } else {
        // overwrite seq param set other than active one -> free memories
        // allocated for old param set
        free1(reinterpret<void?>(pStorage.sps[id].offsetForRefFrame))
        pStorage.sps[id].offsetForRefFrame = null
        free1(reinterpret<void?>(pStorage.sps[id].vuiParameters))
        pStorage.sps[id].vuiParameters = null
    }
    *pStorage.sps[id] = *pSeqParamSet
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdStorePicParamSet(var pStorage : storage?; var pPicParamSet : picParamSet_t?) : uint {
    // Variables
    var id : uint
    // Code
    id = pPicParamSet.picParameterSetId
    // pic parameter set with id not used before -> allocate memory
    if (pStorage.pps[id] == null) {
        pStorage.pps[id] = reinterpret<picParamSet_t?>(malloc1(1ul * uint64(typeinfo sizeof(type<picParamSet_t>))))
        if (pStorage.pps[id] == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
    } elif (id == pStorage.activePpsId) {
        // picture parameter set with id equal to id of active pps
        // check whether seq param set changes, force re-activation of
        // param set if it does. Set activeSpsId to invalid value to
        // accomplish this
        if (pPicParamSet.seqParameterSetId != pStorage.activeSpsId) {
            pStorage.activePpsId = uint(MAX_NUM_PIC_PARAM_SETS + 1)
        }
        // free memories allocated for old param set
        free1(reinterpret<void?>(pStorage.pps[id].runLength))
        pStorage.pps[id].runLength = null
        free1(reinterpret<void?>(pStorage.pps[id].topLeft))
        pStorage.pps[id].topLeft = null
        free1(reinterpret<void?>(pStorage.pps[id].bottomRight))
        pStorage.pps[id].bottomRight = null
        free1(reinterpret<void?>(pStorage.pps[id].sliceGroupId))
        pStorage.pps[id].sliceGroupId = null
    } else {
        // overwrite pic param set other than active one -> free memories
        // allocated for old param set
        free1(reinterpret<void?>(pStorage.pps[id].runLength))
        pStorage.pps[id].runLength = null
        free1(reinterpret<void?>(pStorage.pps[id].topLeft))
        pStorage.pps[id].topLeft = null
        free1(reinterpret<void?>(pStorage.pps[id].bottomRight))
        pStorage.pps[id].bottomRight = null
        free1(reinterpret<void?>(pStorage.pps[id].sliceGroupId))
        pStorage.pps[id].sliceGroupId = null
    }
    *pStorage.pps[id] = *pPicParamSet
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdActivateParamSets(var pStorage : storage?; ppsId : uint; isIdr : uint) : uint {
    // Variables
    var tmp : uint
    var flag : uint
    // Code
    // check that pps and corresponding sps exist
    if ((pStorage.pps[ppsId] == null) || (pStorage.sps[pStorage.pps[ppsId].seqParameterSetId] == null)) {
        return uint(HANTRO_NOK)
    }
    // check that pps parameters do not violate picture size constraints
    tmp = h264_file_all__CheckPps(pStorage.pps[ppsId], pStorage.sps[pStorage.pps[ppsId].seqParameterSetId])
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // first activation part1
    if (pStorage.activePpsId == uint(MAX_NUM_PIC_PARAM_SETS)) {
        pStorage.activePpsId = ppsId
        pStorage.activePps = pStorage.pps[ppsId]
        pStorage.activeSpsId = pStorage.activePps.seqParameterSetId
        pStorage.activeSps = pStorage.sps[pStorage.activeSpsId]
        pStorage.picSizeInMbs = pStorage.activeSps.picWidthInMbs * pStorage.activeSps.picHeightInMbs
        addr(pStorage.currImage[0]).width = pStorage.activeSps.picWidthInMbs
        addr(pStorage.currImage[0]).height = pStorage.activeSps.picHeightInMbs
        pStorage.pendingActivation = uint(HANTRO_TRUE)
    } elif (pStorage.pendingActivation != 0) {
        // first activation part2
        pStorage.pendingActivation = uint(HANTRO_FALSE)
        free1(reinterpret<void?>(pStorage.mb))
        pStorage.mb = null
        free1(reinterpret<void?>(pStorage.sliceGroupMap))
        pStorage.sliceGroupMap = null
        pStorage.mb = reinterpret<mbStorage?>(malloc1(uint64(pStorage.picSizeInMbs) * uint64(typeinfo sizeof(type<mbStorage>))))
        pStorage.sliceGroupMap = reinterpret<uint?>(malloc1(uint64(pStorage.picSizeInMbs) * uint64(typeinfo sizeof(type<uint>))))
        if (pStorage.mb == null || pStorage.sliceGroupMap == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
        memset1(reinterpret<void?>(pStorage.mb), 0, uint64(pStorage.picSizeInMbs) * uint64(typeinfo sizeof(type<mbStorage>)))
        h264bsdInitMbNeighbours(pStorage.mb, pStorage.activeSps.picWidthInMbs, pStorage.picSizeInMbs)
        // dpb output reordering disabled if
        // 1) application set noReordering flag
        // 2) POC type equal to 2
        // 3) num_reorder_frames in vui equal to 0
        if (pStorage.noReordering != 0 || pStorage.activeSps.picOrderCntType == 2u ||
                (pStorage.activeSps.vuiParametersPresentFlag != 0 && pStorage.activeSps.vuiParameters.bitstreamRestrictionFlag != 0 &&
                    pStorage.activeSps.vuiParameters.numReorderFrames == 0)) {
            flag = uint(HANTRO_TRUE)
        } else {
            flag = uint(HANTRO_FALSE)
        }
        tmp = h264bsdResetDpb(addr(pStorage.dpb[0]), pStorage.activeSps.picWidthInMbs * pStorage.activeSps.picHeightInMbs, pStorage.activeSps.maxDpbSize,
                pStorage.activeSps.numRefFrames, pStorage.activeSps.maxFrameNum, flag)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } elif (ppsId != pStorage.activePpsId) {
        // sequence parameter set shall not change but before an IDR picture
        if (pStorage.pps[ppsId].seqParameterSetId != pStorage.activeSpsId) {
            if (isIdr != 0) {
                pStorage.activePpsId = ppsId
                pStorage.activePps = pStorage.pps[ppsId]
                pStorage.activeSpsId = pStorage.activePps.seqParameterSetId
                pStorage.activeSps = pStorage.sps[pStorage.activeSpsId]
                pStorage.picSizeInMbs = pStorage.activeSps.picWidthInMbs * pStorage.activeSps.picHeightInMbs
                addr(pStorage.currImage[0]).width = pStorage.activeSps.picWidthInMbs
                addr(pStorage.currImage[0]).height = pStorage.activeSps.picHeightInMbs
                pStorage.pendingActivation = uint(HANTRO_TRUE)
            } else {
                return uint(HANTRO_NOK)
            }
        } else {
            pStorage.activePpsId = ppsId
            pStorage.activePps = pStorage.pps[ppsId]
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdResetStorage(var pStorage : storage?) {
    // Variables
    var i : uint
    // Code
    addr(pStorage.slice[0]).numDecodedMbs = 0u
    addr(pStorage.slice[0]).sliceId = 0u
    i = 0u
    while (i < pStorage.picSizeInMbs) {
        pStorage.mb[i].sliceId = 0u
        pStorage.mb[i].decoded = 0u
        i++
    }
}

def h264bsdIsStartOfPicture(var pStorage : storage?) : uint {
    // Variables
    // Code
    if (pStorage.validSliceInAccessUnit == uint(HANTRO_FALSE)) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

[c_function]
def h264bsdIsEndOfPicture(var pStorage : storage?) : uint {
    // Variables
    var i : uint
    var tmp : uint
    // Code
    // primary picture
    if (pStorage.sliceHeader[0].redundantPicCnt == 0) {
        if (addr(pStorage.slice[0]).numDecodedMbs == pStorage.picSizeInMbs) {
            return uint(HANTRO_TRUE)
        }
    } else {
        i = 0u
        tmp = 0u
        while (i < pStorage.picSizeInMbs) {
            tmp += uint(pStorage.mb[i].decoded != 0 ? 1 : 0)
            i++
        }
        if (tmp == pStorage.picSizeInMbs) {
            return uint(HANTRO_TRUE)
        }
    }
    return uint(HANTRO_FALSE)
}

def h264bsdComputeSliceGroupMap(var pStorage : storage?; sliceGroupChangeCycle : uint) {
    // Variables
    // Code
    h264bsdDecodeSliceGroupMap(pStorage.sliceGroupMap, pStorage.activePps, sliceGroupChangeCycle, pStorage.activeSps.picWidthInMbs,
            pStorage.activeSps.picHeightInMbs)
}

[c_function]
def h264bsdCheckAccessUnitBoundary(var strm : strmData_t?; var nuNext : nalUnit_t?; var storage : storage?; var accessUnitBoundaryFlag : uint?) : uint {
    // Variables
    var tmp : uint
    var ppsId : uint
    var frameNum : uint
    var idrPicId : uint
    var picOrderCntLsb : uint
    var deltaPicOrderCntBottom : int
    var deltaPicOrderCnt : int[2]
    var sps : seqParamSet_t?
    var pps : picParamSet_t?
    // Code
    // initialize default output to FALSE
    *accessUnitBoundaryFlag = uint(HANTRO_FALSE)
    if (((uint(nuNext.nalUnitType) > 5u) && (uint(nuNext.nalUnitType) < 12u)) || ((uint(nuNext.nalUnitType) > 12u) && (uint(nuNext.nalUnitType) <= 18u))) {
        *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
        return uint(HANTRO_OK)
    } elif (nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE && nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR) {
        return uint(HANTRO_OK)
    }
    // check if this is the very first call to this function
    if (addr(storage.aub[0]).firstCallFlag != 0) {
        *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
        addr(storage.aub[0]).firstCallFlag = uint(HANTRO_FALSE)
    }
    // get picture parameter set id
    tmp = h264bsdCheckPpsId(strm, addr(ppsId))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // store sps and pps in separate pointers just to make names shorter
    pps = storage.pps[ppsId]
    if (pps == null || storage.sps[pps.seqParameterSetId] == null ||
            (storage.activeSpsId != uint(MAX_NUM_SEQ_PARAM_SETS) && pps.seqParameterSetId != storage.activeSpsId &&
                nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR)) {
        return uint(PARAM_SET_ERROR)
    }
    sps = storage.sps[pps.seqParameterSetId]
    if (addr(addr(storage.aub[0]).nuPrev[0]).nalRefIdc != nuNext.nalRefIdc &&
            (addr(addr(storage.aub[0]).nuPrev[0]).nalRefIdc == 0u || nuNext.nalRefIdc == 0u)) {
        *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
    }
    if ((addr(addr(storage.aub[0]).nuPrev[0]).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR && nuNext.nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR) ||
            (addr(addr(storage.aub[0]).nuPrev[0]).nalUnitType != nalUnitType_e.NAL_CODED_SLICE_IDR &&
                nuNext.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR)) {
        *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
    }
    tmp = h264bsdCheckFrameNum(strm, sps.maxFrameNum, addr(frameNum))
    if (tmp != uint(HANTRO_OK)) {
        return uint(HANTRO_NOK)
    }
    if (addr(storage.aub[0]).prevFrameNum != frameNum) {
        addr(storage.aub[0]).prevFrameNum = frameNum
        *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
    }
    if (nuNext.nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR) {
        tmp = h264bsdCheckIdrPicId(strm, sps.maxFrameNum, nuNext.nalUnitType, addr(idrPicId))
        if (tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        if (addr(addr(storage.aub[0]).nuPrev[0]).nalUnitType == nalUnitType_e.NAL_CODED_SLICE_IDR && addr(storage.aub[0]).prevIdrPicId != idrPicId) {
            *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
        }
        addr(storage.aub[0]).prevIdrPicId = idrPicId
    }
    if (sps.picOrderCntType == 0u) {
        tmp = h264bsdCheckPicOrderCntLsb(strm, sps, nuNext.nalUnitType, addr(picOrderCntLsb))
        if (tmp != uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        }
        if (addr(storage.aub[0]).prevPicOrderCntLsb != picOrderCntLsb) {
            addr(storage.aub[0]).prevPicOrderCntLsb = picOrderCntLsb
            *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
        }
        if (pps.picOrderPresentFlag != 0) {
            tmp = h264bsdCheckDeltaPicOrderCntBottom(strm, sps, nuNext.nalUnitType, addr(deltaPicOrderCntBottom))
            if (tmp != uint(HANTRO_OK)) {
                return tmp
            }
            if (addr(storage.aub[0]).prevDeltaPicOrderCntBottom != deltaPicOrderCntBottom) {
                addr(storage.aub[0]).prevDeltaPicOrderCntBottom = deltaPicOrderCntBottom
                *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
            }
        }
    } elif (sps.picOrderCntType == 1u && sps.deltaPicOrderAlwaysZeroFlag == 0) {
        tmp = h264bsdCheckDeltaPicOrderCnt(strm, sps, nuNext.nalUnitType, pps.picOrderPresentFlag, addr(deltaPicOrderCnt[0]))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (addr(storage.aub[0]).prevDeltaPicOrderCnt[0] != deltaPicOrderCnt[0]) {
            addr(storage.aub[0]).prevDeltaPicOrderCnt[0] = deltaPicOrderCnt[0]
            *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
        }
        if (pps.picOrderPresentFlag != 0) {
            if (addr(storage.aub[0]).prevDeltaPicOrderCnt[1] != deltaPicOrderCnt[1]) {
                addr(storage.aub[0]).prevDeltaPicOrderCnt[1] = deltaPicOrderCnt[1]
                *accessUnitBoundaryFlag = uint(HANTRO_TRUE)
            }
        }
    }
    *addr(addr(storage.aub[0]).nuPrev[0]) = *nuNext
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: CheckPps
// Functional description:
// Check picture parameter set. Contents of the picture parameter
// set information that depends on the image dimensions is checked
// against the dimensions in the sps.
// Inputs:
// pps pointer to picture paramter set
// sps pointer to sequence parameter set
// Outputs:
// none
// Returns:
// HANTRO_OK everything ok
// HANTRO_NOK invalid data in picture parameter set
// ------------------------------------------------------------------------------
[c_function]
def private h264_file_all__CheckPps(var pps : picParamSet_t?; var sps : seqParamSet_t?) : uint {
    var picSize : uint
    picSize = sps.picWidthInMbs * sps.picHeightInMbs
    // check slice group params
    if (pps.numSliceGroups > 1u) {
        if (pps.sliceGroupMapType == 0u) {
            for (i in urange(pps.numSliceGroups)) {
                if (pps.runLength[i] > picSize) {
                    return uint(HANTRO_NOK)
                }
            }
        } elif (pps.sliceGroupMapType == 2u) {
            for (i in urange(pps.numSliceGroups - 1u)) {
                if (pps.topLeft[i] > pps.bottomRight[i] || pps.bottomRight[i] >= picSize) {
                    return uint(HANTRO_NOK)
                }
                if ((pps.topLeft[i] % sps.picWidthInMbs) > (pps.bottomRight[i] % sps.picWidthInMbs)) {
                    return uint(HANTRO_NOK)
                }
            }
        } elif (pps.sliceGroupMapType > 2u && pps.sliceGroupMapType < 6u) {
            if (pps.sliceGroupChangeRate > picSize) {
                return uint(HANTRO_NOK)
            }
        } elif (pps.sliceGroupMapType == 6u && pps.picSizeInMapUnits < picSize) {
            return uint(HANTRO_NOK)
        }
    }
    return uint(HANTRO_OK)
}

def h264bsdValidParamSets(var pStorage : storage?) : uint {
    // Variables
    // Code
    for (i in urange(uint(MAX_NUM_PIC_PARAM_SETS))) {
        if (pStorage.pps[i] != null && pStorage.sps[pStorage.pps[i].seqParameterSetId] != null &&
                h264_file_all__CheckPps(pStorage.pps[i], pStorage.sps[pStorage.pps[i].seqParameterSetId]) == uint(HANTRO_OK)) {
            return uint(HANTRO_OK)
        }
    }
    return uint(HANTRO_NOK)
}

def h264bsdGetBits(var pStrmData : strmData_t?; numBits : uint) : uint {
    var out : uint
    out = h264bsdShowBits32(pStrmData) >> (32u - numBits)
    if (h264bsdFlushBits(pStrmData, numBits) == uint(HANTRO_OK)) {
        return out
    } else {
        return END_OF_STREAM
    }
}

[c_function]
def h264bsdShowBits32(var pStrmData : strmData_t?) : uint {
    var bits : int
    var shift : int
    var out : uint
    var pStrm : uint8?
    pStrm = pStrmData.pStrmCurrPos
    // number of bits left in the buffer
    bits = int(pStrmData.strmBuffSize) * 8 - int(pStrmData.strmBuffReadBits)
    // at least 32-bits in the buffer
    if (bits >= 32) {
        let bitPosInWord : uint = pStrmData.bitPosInWord
        out = (uint(pStrm[0]) << 24u) | (uint(pStrm[1]) << 16u) | (uint(pStrm[2]) << 8u) | uint(pStrm[3])
        if (bitPosInWord != 0) {
            let byte : uint = uint(pStrm[4])
            let tmp : uint = 8u - bitPosInWord
            out <<= bitPosInWord
            out |= byte >> tmp
        }
        return out
    } elif (bits > 0) {
        // at least one bit in the buffer
        shift = int(24u + pStrmData.bitPosInWord)
        var _t0 = pStrm
        pStrm++
        out = uint(*_t0) << uint(shift)
        bits -= int(8u - pStrmData.bitPosInWord)
        while (bits > 0) {
            shift -= 8
            var _t1 = pStrm
            pStrm++
            out |= uint(*_t1) << uint(shift)
            bits -= 8
        }
        return out
    } else {
        return 0u
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdFlushBits
// Functional description:
// Remove bits from the stream buffer
// Input:
// pStrmData pointer to stream data structure
// numBits number of bits to remove
// Output:
// none
// Returns:
// HANTRO_OK success
// END_OF_STREAM not enough bits left
// ------------------------------------------------------------------------------
[c_function]
def h264bsdFlushBits(var pStrmData : strmData_t?; numBits : uint) : uint {
    pStrmData.strmBuffReadBits += numBits
    pStrmData.bitPosInWord = pStrmData.strmBuffReadBits & 7u
    if (pStrmData.strmBuffReadBits <= (8u * pStrmData.strmBuffSize)) {
        pStrmData.pStrmCurrPos = pStrmData.pStrmBuffStart + (pStrmData.strmBuffReadBits >> 3u)
        return uint(HANTRO_OK)
    } else {
        return END_OF_STREAM
    }
}

def h264bsdIsByteAligned(var pStrmData : strmData_t?) : uint {
    // Variables
    // Code
    if (pStrmData.bitPosInWord == 0) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdProcessBlock
// Functional description:
// Function performs inverse zig-zag scan, inverse scaling and
// inverse transform for a luma or a chroma residual block
// Inputs:
// data pointer to data to be processed
// qp quantization parameter
// skip skip processing of data[0], set to non-zero value
// if dc coeff hanled separately
// coeffMap 16 lsb's indicate which coeffs are non-zero,
// bit 0 (lsb) for coeff 0, bit 1 for coeff 1 etc.
// Outputs:
// data processed data
// Returns:
// HANTRO_OK success
// HANTRO_NOK processed data not in valid range [-512, 511]
// ------------------------------------------------------------------------------
[c_function]
def h264bsdProcessBlock(var data : int?; qp : uint; skip : uint; coeffMap : uint) : uint {
    // Variables
    var tmp0 : int
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var d1 : int
    var d2 : int
    var d3 : int
    var row : uint
    var col : uint
    var qpDiv : uint
    var ptr : int?
    // Code
    qpDiv = uint(h264_file_all__qpDiv6[qp])
    tmp1 = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][0] << int(qpDiv)
    tmp2 = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][1] << int(qpDiv)
    tmp3 = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][2] << int(qpDiv)
    if (skip == 0) {
        data[0] *= tmp1
    }
    // at least one of the rows 1, 2 or 3 contain non-zero coeffs, mask takes
    // the scanning order into account
    if ((coeffMap & 65436u) != 0) {
        // do the zig-zag scan and inverse quantization
        d1 = data[1]
        d2 = data[14]
        d3 = data[15]
        data[1] = d1 * tmp2
        data[14] = d2 * tmp2
        data[15] = d3 * tmp3
        d1 = data[2]
        d2 = data[5]
        d3 = data[4]
        data[4] = d1 * tmp2
        data[2] = d2 * tmp1
        data[5] = d3 * tmp3
        d1 = data[8]
        d2 = data[3]
        d3 = data[6]
        tmp0 = d1 * tmp2
        data[8] = d2 * tmp1
        data[3] = d3 * tmp2
        d1 = data[7]
        d2 = data[12]
        d3 = data[9]
        data[6] = d1 * tmp2
        data[7] = d2 * tmp3
        data[12] = d3 * tmp2
        data[9] = tmp0
        d1 = data[10]
        d2 = data[11]
        d3 = data[13]
        data[13] = d1 * tmp3
        data[10] = d2 * tmp1
        data[11] = d3 * tmp2
        // horizontal transform
        row = 4u
        ptr = data
        while (true) {
            let _t0 = row
            row--
            if (_t0 == 0) {
                break
            }
            tmp0 = ptr[0] + ptr[2]
            tmp1 = ptr[0] - ptr[2]
            tmp2 = (ptr[1] >> 1) - ptr[3]
            tmp3 = ptr[1] + (ptr[3] >> 1)
            ptr[0] = tmp0 + tmp3
            ptr[1] = tmp1 + tmp2
            ptr[2] = tmp1 - tmp2
            ptr[3] = tmp0 - tmp3
            ptr += 4
        }
        // lint +e661 +e662
        // then vertical transform
        col = 4u
        while (true) {
            let _t1 = col
            col--
            if (_t1 == 0) {
                break
            }
            tmp0 = data[0] + data[8]
            tmp1 = data[0] - data[8]
            tmp2 = (data[4] >> 1) - data[12]
            tmp3 = data[4] + (data[12] >> 1)
            data[0] = (tmp0 + tmp3 + 32) >> 6
            data[4] = (tmp1 + tmp2 + 32) >> 6
            data[8] = (tmp1 - tmp2 + 32) >> 6
            data[12] = (tmp0 - tmp3 + 32) >> 6
            // check that each value is in the range [-512,511]
            if ((uint(data[0] + 512) > 1023u) || (uint(data[4] + 512) > 1023u) || (uint(data[8] + 512) > 1023u) || (uint(data[12] + 512) > 1023u)) {
                return uint(HANTRO_NOK)
            }
            data++
        }
    } else {
        // rows 1, 2 and 3 are zero
        // only dc-coeff is non-zero, i.e. coeffs at original positions
        // 1, 5 and 6 are zero
        if ((coeffMap & 98u) == 0u) {
            tmp0 = (data[0] + 32) >> 6
            // check that value is in the range [-512,511]
            if (uint(tmp0 + 512) > 1023u) {
                return uint(HANTRO_NOK)
            }
            data[15] = tmp0
            data[14] = data[15]
            data[13] = data[14]
            data[12] = data[13]
            data[11] = data[12]
            data[10] = data[11]
            data[9] = data[10]
            data[8] = data[9]
            data[7] = data[8]
            data[6] = data[7]
            data[5] = data[6]
            data[4] = data[5]
            data[3] = data[4]
            data[2] = data[3]
            data[1] = data[2]
            data[0] = data[1]
        } else {
            // at least one of the coeffs 1, 5 or 6 is non-zero
            data[1] *= tmp2
            data[2] = data[5] * tmp1
            data[3] = data[6] * tmp2
            tmp0 = data[0] + data[2]
            tmp1 = data[0] - data[2]
            tmp2 = (data[1] >> 1) - data[3]
            tmp3 = data[1] + (data[3] >> 1)
            data[0] = (tmp0 + tmp3 + 32) >> 6
            data[1] = (tmp1 + tmp2 + 32) >> 6
            data[2] = (tmp1 - tmp2 + 32) >> 6
            data[3] = (tmp0 - tmp3 + 32) >> 6
            data[12] = data[0]
            data[8] = data[12]
            data[4] = data[8]
            data[13] = data[1]
            data[9] = data[13]
            data[5] = data[9]
            data[14] = data[2]
            data[10] = data[14]
            data[6] = data[10]
            data[15] = data[3]
            data[11] = data[15]
            data[7] = data[11]
            // check that each value is in the range [-512,511]
            if ((uint(data[0] + 512) > 1023u) || (uint(data[1] + 512) > 1023u) || (uint(data[2] + 512) > 1023u) || (uint(data[3] + 512) > 1023u)) {
                return uint(HANTRO_NOK)
            }
        }
    }
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdProcessLumaDc
// Functional description:
// Function performs inverse zig-zag scan, inverse transform and
// inverse scaling for a luma DC coefficients block
// Inputs:
// data pointer to data to be processed
// qp quantization parameter
// Outputs:
// data processed data
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdProcessLumaDc(var data : int?; qp : uint) {
    // Variables
    var tmp0 : int
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var row : uint
    var col : uint
    var qpMod : uint
    var qpDiv : uint
    var levScale : int
    var ptr : int?
    // Code
    qpMod = uint(h264_file_all__qpMod6[qp])
    qpDiv = uint(h264_file_all__qpDiv6[qp])
    // zig-zag scan
    tmp0 = data[2]
    data[2] = data[5]
    data[5] = data[4]
    data[4] = tmp0
    tmp0 = data[8]
    data[8] = data[3]
    data[3] = data[6]
    data[6] = data[7]
    data[7] = data[12]
    data[12] = data[9]
    data[9] = tmp0
    tmp0 = data[10]
    data[10] = data[11]
    data[11] = data[13]
    data[13] = tmp0
    // horizontal transform
    row = 4u
    ptr = data
    while (true) {
        let _t0 = row
        row--
        if (_t0 == 0) {
            break
        }
        tmp0 = ptr[0] + ptr[2]
        tmp1 = ptr[0] - ptr[2]
        tmp2 = ptr[1] - ptr[3]
        tmp3 = ptr[1] + ptr[3]
        ptr[0] = tmp0 + tmp3
        ptr[1] = tmp1 + tmp2
        ptr[2] = tmp1 - tmp2
        ptr[3] = tmp0 - tmp3
        ptr += 4
    }
    // lint +e661 +e662
    // then vertical transform and inverse scaling
    levScale = h264_file_all__levelScale[qpMod][0]
    if (qp >= 12u) {
        levScale <<= int(qpDiv - 2u)
        col = 4u
        while (true) {
            let _t1 = col
            col--
            if (_t1 == 0) {
                break
            }
            tmp0 = data[0] + data[8]
            tmp1 = data[0] - data[8]
            tmp2 = data[4] - data[12]
            tmp3 = data[4] + data[12]
            data[0] = (tmp0 + tmp3) * levScale
            data[4] = (tmp1 + tmp2) * levScale
            data[8] = (tmp1 - tmp2) * levScale
            data[12] = (tmp0 - tmp3) * levScale
            data++
        }
    } else {
        var tmp : int
        tmp = ((1u - qpDiv) == 0u) ? 1 : 2
        col = 4u
        while (true) {
            let _t2 = col
            col--
            if (_t2 == 0) {
                break
            }
            tmp0 = data[0] + data[8]
            tmp1 = data[0] - data[8]
            tmp2 = data[4] - data[12]
            tmp3 = data[4] + data[12]
            data[0] = ((tmp0 + tmp3) * levScale + tmp) >> int(2u - qpDiv)
            data[4] = ((tmp1 + tmp2) * levScale + tmp) >> int(2u - qpDiv)
            data[8] = ((tmp1 - tmp2) * levScale + tmp) >> int(2u - qpDiv)
            data[12] = ((tmp0 - tmp3) * levScale + tmp) >> int(2u - qpDiv)
            data++
        }
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdProcessChromaDc
// Functional description:
// Function performs inverse transform and inverse scaling for a
// chroma DC coefficients block
// Inputs:
// data pointer to data to be processed
// qp quantization parameter
// Outputs:
// data processed data
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdProcessChromaDc(var data : int?; qp : uint) {
    // Variables
    var tmp0 : int
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var qpDiv : uint
    var levScale : int
    var levShift : uint
    // Code
    qpDiv = uint(h264_file_all__qpDiv6[qp])
    levScale = h264_file_all__levelScale[int(h264_file_all__qpMod6[qp])][0]
    if (qp >= 6u) {
        levScale <<= int(qpDiv - 1u)
        levShift = 0u
    } else {
        levShift = 1u
    }
    tmp0 = data[0] + data[2]
    tmp1 = data[0] - data[2]
    tmp2 = data[1] - data[3]
    tmp3 = data[1] + data[3]
    data[0] = ((tmp0 + tmp3) * levScale) >> int(levShift)
    data[1] = ((tmp0 - tmp3) * levScale) >> int(levShift)
    data[2] = ((tmp1 + tmp2) * levScale) >> int(levShift)
    data[3] = ((tmp1 - tmp2) * levScale) >> int(levShift)
    tmp0 = data[4] + data[6]
    tmp1 = data[4] - data[6]
    tmp2 = data[5] - data[7]
    tmp3 = data[5] + data[7]
    data[4] = ((tmp0 + tmp3) * levScale) >> int(levShift)
    data[5] = ((tmp0 - tmp3) * levScale) >> int(levShift)
    data[6] = ((tmp1 + tmp2) * levScale) >> int(levShift)
    data[7] = ((tmp1 - tmp2) * levScale) >> int(levShift)
}

// ------------------------------------------------------------------------------
// 5.1 Function: h264bsdCountLeadingZeros
// Functional description:
// Count leading zeros in a code word. Code word is assumed to be
// right-aligned, last bit of the code word in the lsb of the value.
// Inputs:
// value code word
// length number of bits in the code word
// Outputs:
// none
// Returns:
// number of leading zeros in the code word
// ------------------------------------------------------------------------------
def h264bsdCountLeadingZeros(value : uint; length : uint) : uint {
    // Variables
    var zeros : uint = 0u
    var mask : uint = uint(1 << int(length - 1u))
    // Code
    while (mask != 0 && (value & mask) == 0) {
        zeros++
        mask >>= 1u
    }
    return zeros
}

def h264bsdRbspTrailingBits(var pStrmData : strmData_t?) : uint {
    // Variables
    var stuffing : uint
    var stuffingLength : uint
    // Code
    stuffingLength = 8u - pStrmData.bitPosInWord
    stuffing = h264bsdGetBits(pStrmData, stuffingLength)
    if (stuffing == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    if (stuffing != h264_file_all__stuffingTable[stuffingLength - 1u]) {
        return uint(HANTRO_NOK)
    } else {
        return uint(HANTRO_OK)
    }
}

def h264bsdMoreRbspData(var pStrmData : strmData_t?) : uint {
    // Variables
    var bits : uint
    // Code
    bits = pStrmData.strmBuffSize * 8u - pStrmData.strmBuffReadBits
    if (bits == 0u) {
        return uint(HANTRO_FALSE)
    }
    if ((bits > 8u) || (uint64(h264bsdShowBits32(pStrmData) >> (32u - bits)) != (1ul << uint64(bits - 1u)))) {
        return uint(HANTRO_TRUE)
    } else {
        return uint(HANTRO_FALSE)
    }
}

[c_function]
def h264bsdNextMbAddress(var pSliceGroupMap : uint?; picSizeInMbs : uint; currMbAddr : uint) : uint {
    // Variables
    var i : uint
    var sliceGroup : uint
    // Code
    sliceGroup = pSliceGroupMap[currMbAddr]
    i = currMbAddr + 1u
    while ((i < picSizeInMbs) && (pSliceGroupMap[i] != sliceGroup)) {
        i++
    }
    if (i == picSizeInMbs) {
        i = 0u
    }
    return i
}

// ------------------------------------------------------------------------------
// 5.5 Function: h264bsdSetCurrImageMbPointers
// Functional description:
// Set luma and chroma pointers in image_t for current MB
// Inputs:
// image Current image
// mbNum number of current MB
// Outputs:
// none
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdSetCurrImageMbPointers(var image : image_t?; mbNum : uint) {
    var width : uint
    var height : uint
    var picSize : uint
    var row : uint
    var col : uint
    var tmp : uint
    width = image.width
    height = image.height
    row = mbNum / width
    col = mbNum % width
    tmp = row * width
    picSize = width * height
    image.luma = image.data + col * 16u + tmp * 256u
    image.cb = image.data + picSize * 256u + tmp * 64u + col * 8u
    image.cr = image.cb + picSize * 64u
}

[c_function]
def h264bsdDecodeExpGolombUnsigned(var pStrmData : strmData_t?; var codeNum : uint?) : uint {
    // Variables
    var bits : uint
    var numZeros : uint
    // Code
    bits = h264bsdShowBits32(pStrmData)
    // first bit is 1 -> code length 1
    if (bits >= 2147483648u) {
        h264bsdFlushBits(pStrmData, 1u)
        *codeNum = 0u
        return uint(HANTRO_OK)
    } elif (bits >= 1073741824u) {
        // second bit is 1 -> code length 3
        if (h264bsdFlushBits(pStrmData, 3u) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        *codeNum = 1u + ((bits >> 29u) & 1u)
        return uint(HANTRO_OK)
    } elif (bits >= 536870912u) {
        // third bit is 1 -> code length 5
        if (h264bsdFlushBits(pStrmData, 5u) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        *codeNum = 3u + ((bits >> 27u) & 3u)
        return uint(HANTRO_OK)
    } elif (bits >= 268435456u) {
        // fourth bit is 1 -> code length 7
        if (h264bsdFlushBits(pStrmData, 7u) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        *codeNum = 7u + ((bits >> 25u) & 7u)
        return uint(HANTRO_OK)
    } else {
        // other code lengths
        numZeros = 4u + h264bsdCountLeadingZeros(bits, 28u)
        // all 32 bits are zero
        if (numZeros == 32u) {
            *codeNum = 0u
            h264bsdFlushBits(pStrmData, 32u)
            bits = h264bsdGetBits(pStrmData, 1u)
            // check 33rd bit, must be 1
            if (bits == 1u) {
                // cannot use h264bsdGetBits, limited to 31 bits
                bits = h264bsdShowBits32(pStrmData)
                if (h264bsdFlushBits(pStrmData, 32u) == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                // code num 2^32 - 1, needed for unsigned mapping
                if (bits == 0u) {
                    *codeNum = BIG_CODE_NUM
                    return uint(HANTRO_OK)
                } elif (bits == 1u) {
                    // code num 2^32, needed for unsigned mapping
                    // (results in -2^31)
                    *codeNum = BIG_CODE_NUM
                    return uint(HANTRO_NOK)
                }
            }
            // if more zeros than 32, it is an error
            return uint(HANTRO_NOK)
        } else {
            h264bsdFlushBits(pStrmData, numZeros + 1u)
        }
        bits = h264bsdGetBits(pStrmData, numZeros)
        if (bits == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        *codeNum = uint((1 << int(numZeros)) - 1) + bits
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDecodeExpGolombSigned(var pStrmData : strmData_t?; var value : int?) : uint {
    // Variables
    var status : uint
    var codeNum : uint = 0u
    // Code
    status = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(codeNum))
    if (codeNum == BIG_CODE_NUM) {
        // BIG_CODE_NUM and HANTRO_OK status means codeNum 2^32-1 which would
        // result in signed integer valued 2^31 (i.e. out of 32-bit signed
        // integer range)
        if (status == uint(HANTRO_OK)) {
            return uint(HANTRO_NOK)
        } else {
            // BIG_CODE_NUM and HANTRO_NOK status means codeNum 2^32 which results
            // in signed integer valued -2^31
            *value = int(2147483648u)
            return uint(HANTRO_OK)
        }
    } elif (status == uint(HANTRO_OK)) {
        // (-1)^(codeNum+1) results in positive sign if codeNum is odd,
        // negative when it is even. (codeNum+1)/2 is obtained as
        // (codeNum+1)>>1 when value is positive and as (-codeNum)>>1 for
        // negative value
        // lint -e702
        *value = (codeNum & 1u) != 0 ? int((codeNum + 1u) >> 1u) : -int((codeNum + 1u) >> 1u)
        // lint +e702
        return uint(HANTRO_OK)
    }
    return uint(HANTRO_NOK)
}

[c_function]
def h264bsdDecodeExpGolombMapped(var pStrmData : strmData_t?; var value : uint?; isIntra : uint) : uint {
    // Variables
    var status : uint
    var codeNum : uint
    // Code
    status = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(codeNum))
    if (status != uint(HANTRO_OK)) {
        return uint(HANTRO_NOK)
    } else {
        // range of valid codeNums [0,47]
        if (codeNum > 47u) {
            return uint(HANTRO_NOK)
        }
        if (isIntra != 0) {
            *value = uint(h264_file_all__codedBlockPatternIntra4x4[codeNum])
        } else {
            *value = uint(h264_file_all__codedBlockPatternInter[codeNum])
        }
        return uint(HANTRO_OK)
    }
}

[c_function]
def h264bsdDecodeExpGolombTruncated(var pStrmData : strmData_t?; var value : uint?; greaterThanOne : uint) : uint {
    // Variables
    // Code
    if (greaterThanOne != 0) {
        return h264bsdDecodeExpGolombUnsigned(pStrmData, value)
    } else {
        *value = h264bsdGetBits(pStrmData, 1u)
        if (*value == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        *value ^= 1u
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDecodeVuiParameters(var pStrmData : strmData_t?; var pVuiParameters : vuiParameters_t?) : uint {
    // Variables
    var tmp : uint
    // Code
    memset1(reinterpret<void?>(pVuiParameters), 0, uint64(typeinfo sizeof(type<vuiParameters_t>)))
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.aspectRatioPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.aspectRatioPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, 8u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.aspectRatioIdc = tmp
        if (pVuiParameters.aspectRatioIdc == uint(anon_81.ASPECT_RATIO_EXTENDED_SAR)) {
            tmp = h264bsdGetBits(pStrmData, 16u)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.sarWidth = tmp
            tmp = h264bsdGetBits(pStrmData, 16u)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.sarHeight = tmp
        }
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.overscanInfoPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.overscanInfoPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.overscanAppropriateFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.videoSignalTypePresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.videoSignalTypePresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, 3u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.videoFormat = tmp
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.videoFullRangeFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.colourDescriptionPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
        if (pVuiParameters.colourDescriptionPresentFlag != 0) {
            tmp = h264bsdGetBits(pStrmData, 8u)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.colourPrimaries = tmp
            tmp = h264bsdGetBits(pStrmData, 8u)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.transferCharacteristics = tmp
            tmp = h264bsdGetBits(pStrmData, 8u)
            if (tmp == END_OF_STREAM) {
                return uint(HANTRO_NOK)
            }
            pVuiParameters.matrixCoefficients = tmp
        } else {
            pVuiParameters.colourPrimaries = 2u
            pVuiParameters.transferCharacteristics = 2u
            pVuiParameters.matrixCoefficients = 2u
        }
    } else {
        pVuiParameters.videoFormat = 5u
        pVuiParameters.colourPrimaries = 2u
        pVuiParameters.transferCharacteristics = 2u
        pVuiParameters.matrixCoefficients = 2u
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.chromaLocInfoPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.chromaLocInfoPresentFlag != 0) {
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.chromaSampleLocTypeTopField))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.chromaSampleLocTypeTopField > 5u) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.chromaSampleLocTypeBottomField))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.chromaSampleLocTypeBottomField > 5u) {
            return uint(HANTRO_NOK)
        }
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.timingInfoPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.timingInfoPresentFlag != 0) {
        tmp = h264bsdShowBits32(pStrmData)
        if (h264bsdFlushBits(pStrmData, 32u) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (tmp == 0u) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.numUnitsInTick = tmp
        tmp = h264bsdShowBits32(pStrmData)
        if (h264bsdFlushBits(pStrmData, 32u) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        if (tmp == 0u) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.timeScale = tmp
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.fixedFrameRateFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.nalHrdParametersPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.nalHrdParametersPresentFlag != 0) {
        tmp = h264_file_all__DecodeHrdParameters(pStrmData, addr(pVuiParameters.nalHrdParameters))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        pVuiParameters.nalHrdParameters.cpbCnt = 1u
        // MaxBR and MaxCPB should be the values correspondig to the levelIdc
        // in the SPS containing these VUI parameters. However, these values
        // are not used anywhere and maximum for any level will be used here
        pVuiParameters.nalHrdParameters.bitRateValue[0] = uint(1200 * MAX_BR + 1)
        pVuiParameters.nalHrdParameters.cpbSizeValue[0] = uint(1200 * MAX_CPB + 1)
        pVuiParameters.nalHrdParameters.initialCpbRemovalDelayLength = 24u
        pVuiParameters.nalHrdParameters.cpbRemovalDelayLength = 24u
        pVuiParameters.nalHrdParameters.dpbOutputDelayLength = 24u
        pVuiParameters.nalHrdParameters.timeOffsetLength = 24u
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.vclHrdParametersPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.vclHrdParametersPresentFlag != 0) {
        tmp = h264_file_all__DecodeHrdParameters(pStrmData, addr(pVuiParameters.vclHrdParameters))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        pVuiParameters.vclHrdParameters.cpbCnt = 1u
        // MaxBR and MaxCPB should be the values correspondig to the levelIdc
        // in the SPS containing these VUI parameters. However, these values
        // are not used anywhere and maximum for any level will be used here
        pVuiParameters.vclHrdParameters.bitRateValue[0] = uint(1000 * MAX_BR + 1)
        pVuiParameters.vclHrdParameters.cpbSizeValue[0] = uint(1000 * MAX_CPB + 1)
        pVuiParameters.vclHrdParameters.initialCpbRemovalDelayLength = 24u
        pVuiParameters.vclHrdParameters.cpbRemovalDelayLength = 24u
        pVuiParameters.vclHrdParameters.dpbOutputDelayLength = 24u
        pVuiParameters.vclHrdParameters.timeOffsetLength = 24u
    }
    if (pVuiParameters.nalHrdParametersPresentFlag != 0 || pVuiParameters.vclHrdParametersPresentFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.lowDelayHrdFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    }
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.picStructPresentFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    tmp = h264bsdGetBits(pStrmData, 1u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pVuiParameters.bitstreamRestrictionFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
    if (pVuiParameters.bitstreamRestrictionFlag != 0) {
        tmp = h264bsdGetBits(pStrmData, 1u)
        if (tmp == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        pVuiParameters.motionVectorsOverPicBoundariesFlag = uint((tmp == 1u) ? HANTRO_TRUE : HANTRO_FALSE)
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.maxBytesPerPicDenom))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.maxBytesPerPicDenom > 16u) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.maxBitsPerMbDenom))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.maxBitsPerMbDenom > 16u) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.log2MaxMvLengthHorizontal))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.log2MaxMvLengthHorizontal > 16u) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.log2MaxMvLengthVertical))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        if (pVuiParameters.log2MaxMvLengthVertical > 16u) {
            return uint(HANTRO_NOK)
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.numReorderFrames))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
        tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pVuiParameters.maxDecFrameBuffering))
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        pVuiParameters.motionVectorsOverPicBoundariesFlag = uint(HANTRO_TRUE)
        pVuiParameters.maxBytesPerPicDenom = 2u
        pVuiParameters.maxBitsPerMbDenom = 1u
        pVuiParameters.log2MaxMvLengthHorizontal = 16u
        pVuiParameters.log2MaxMvLengthVertical = 16u
        pVuiParameters.numReorderFrames = uint(MAX_DPB_SIZE)
        pVuiParameters.maxDecFrameBuffering = uint(MAX_DPB_SIZE)
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__DecodeHrdParameters(var pStrmData : strmData_t?; var pHrdParameters : hrdParameters_t?) : uint {
    // Variables
    var tmp : uint
    var i : uint
    // Code
    tmp = h264bsdDecodeExpGolombUnsigned(pStrmData, addr(pHrdParameters.cpbCnt))
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // cpbCount = cpb_cnt_minus1 + 1
    pHrdParameters.cpbCnt++
    if (pHrdParameters.cpbCnt > uint(MAX_CPB_CNT)) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetBits(pStrmData, 4u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
    pHrdParameters.bitRateScale = tmp
    tmp = h264bsdGetBits(pStrmData, 4u)
    if (tmp == END_OF_STREAM) {
        return uint(HANTRO_NOK)
    }
