// Add new sample to specified track
[c_function]
def MP4E_put_sample(var mux : MP4E_mux_tag?; track_num : int; var data : void?; data_bytes : int; duration : int; kind : int) : int {
    var tr : track_t?
    if (mux == null || data == null) {
        return MP4E_STATUS_BAD_ARGUMENTS
    }
    tr = reinterpret<track_t?>(mux.tracks.data) + track_num
    if (mux.enable_fragmentation != 0) {
        // NOTE: assume a constant `duration` to calculate current timestamp
        let _t0 = mux.fragments_count
        mux.fragments_count++
        if (_t0 == 0) {
            // write file headers before 1st sample
            let err : int = h264_file_all__mp4e_flush_index(mux)
            if (err != 0) {
                return err
            }
        }
        {
            // write MOOF + MDAT + sample data
            let err : int = h264_file_all__mp4e_write_fragment_header(mux, track_num, data_bytes, duration, kind)
            if (err != 0) {
                return err
            }
        }
        {
            // write MDAT box for each sample
            let err : int = h264_file_all__mp4e_write_mdat_box(mux, uint(data_bytes + 8))
            if (err != 0) {
                return err
            }
        }
        {
            let err : int = invoke(mux.write_callback, mux.write_pos, data, uint64(data_bytes), mux.token)
            if (err != 0) {
                return err
            }
        }
        mux.write_pos += int64(data_bytes)
        return MP4E_STATUS_OK
    }
    if (kind != MP4E_SAMPLE_CONTINUATION) {
        if (mux.sequential_mode_flag != 0) {
            let err : int = h264_file_all__write_pending_data(mux, tr)
            if (err != 0) {
                return err
            }
        }
        if (h264_file_all__add_sample_descriptor(mux, tr, data_bytes, duration, kind) == 0) {
            return MP4E_STATUS_NO_MEMORY
        }
    } else {
        if (mux.sequential_mode_flag == 0) {
            var smpl_desc : sample_t?
            if (uint64(tr.smpl.bytes) < uint64(typeinfo sizeof(type<sample_t>))) {
                // write continuation, but there are no samples in the index
                return MP4E_STATUS_NO_MEMORY
            }
            // Accumulate size of the continuation in the sample descriptor
            smpl_desc = reinterpret<sample_t?>(tr.smpl.data + tr.smpl.bytes) + -(1)
            smpl_desc.size += uint64(data_bytes)
        }
    }
    if (mux.sequential_mode_flag != 0) {
        if (h264_file_all__minimp4_vector_put(addr(tr.pending_sample), data, data_bytes) == null) {
            return MP4E_STATUS_NO_MEMORY
        }
    } else {
        {
            let err : int = invoke(mux.write_callback, mux.write_pos, data, uint64(data_bytes), mux.token)
            if (err != 0) {
                return err
            }
        }
        mux.write_pos += int64(data_bytes)
    }
    return MP4E_STATUS_OK
}

// calculate size of length field of OD box
def private h264_file_all__od_size_of_size(size : int) : int {
    var i : int
    var size_of_size : int = 1
    i = size
    while (i > 127) {
        size_of_size++
        i -= 127
    }
    return size_of_size
}

// Add or remove MP4 file text comment according to Apple specs:
// https://developer.apple.com/library/mac/documentation/QuickTime/QTFF/Metadata/Metadata.html#//apple_ref/doc/uid/TP40000939-CH1-SW1
// http://atomicparsley.sourceforge.net/mpeg-4files.html
// note that ISO did not specify comment format.
[c_function]
def MP4E_set_text_comment(var mux : MP4E_mux_tag?; var comment : uint8?) : int {
    if (mux == null || comment == null) {
        return MP4E_STATUS_BAD_ARGUMENTS
    }
    if (mux.text_comment != null) {
        free1(reinterpret<void?>(mux.text_comment))
    }
    mux.text_comment = strdup1(comment)
    if (mux.text_comment == null) {
        return MP4E_STATUS_NO_MEMORY
    }
    return MP4E_STATUS_OK
}

