                // typically hdlr box does not contain any useful info.
                // the rest of this box is skipped by default ...
                break
            }
            case(1651798644u) {
                if (tr == null) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                {
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 4 + 4)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                tr.avg_bitrate_bps = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                break
            }
            case(2841734242u) {
                // Set pointer to tag to be read...
                ptag = addr(mp4.tag.album)
                break
            }
            case(2839630420u) {
                ptag = addr(mp4.tag.artist)
                break
            }
            case(2842583405u) {
                ptag = addr(mp4.tag.title)
                break
            }
            case(2841928057u) {
                ptag = addr(mp4.tag.year)
                break
            }
            case(2841865588u) {
                ptag = addr(mp4.tag.comment)
                break
            }
            case(2842125678u) {
                ptag = addr(mp4.tag.genre)
                break
            }
            case(1937011556u) {
                {
                    // entry_count, BOX_mp4a & BOX_mp4v boxes follows immediately
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 4)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                break
            }
            case(1836070003u) {
                // private stream
                if (tr == null) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                {
                    // Base SampleEntry
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 6 * 1 + 2)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                break
            }
            case(1836069985u) {
                if (tr == null) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                {
                    // Base SampleEntry
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 6 * 1 + 2 + 4 * 2)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                tr.SampleDescription.audio.channelcount = h264_file_all__read_payload(mp4, 2u, addr(payload_bytes), addr(eof_flag))
                {
                    // samplesize
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 2 + 2 + 2)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                tr.SampleDescription.audio.samplerate_hz = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag)) >> 16u
                break
            }
            case(1635148593u, 1836070006u) {
                // AVCSampleEntry extends VisualSampleEntry
                // case BOX_avc2: - no test
                // case BOX_svc1: - no test
                if (tr == null) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                {
                    // Base SampleEntry
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 6 * 1 + 2 + 2 + 2 + 4 * 3)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                tr.SampleDescription.video.width = h264_file_all__read_payload(mp4, 2u, addr(payload_bytes), addr(eof_flag))
                tr.SampleDescription.video.height = h264_file_all__read_payload(mp4, 2u, addr(payload_bytes), addr(eof_flag))
                {
                    // frame_count is always 1
                    // compressorname is rarely set..
                    // frame_count compressorname
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 4 + 4 + 4 + 2 + 32 + 2 + 2)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                // ^^^ end of VisualSampleEntry
                // now follows for BOX_avc1:
                // BOX_avcC
                // BOX_btrt (optional)
                // BOX_m4ds (optional)
                // for BOX_mp4v:
                // BOX_esds
                break
            }
            case(1635148611u) {
                // AVCDecoderConfigurationRecord()
                // hack: AAC-specific DSI field reused (for it have same purpoose as sps/pps)
                // TODO: check this hack if BOX_esds co-exist with BOX_avcC
                tr.object_type_indication = uint(MP4_OBJECT_TYPE_AVC)
                tr.dsi = reinterpret<uint8?>(malloc1(box_bytes))
                tr.dsi_bytes = uint(box_bytes)
                {
                    var spspps : int
                    var p : uint8? = tr.dsi
                    let configurationVersion : uint = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                    let AVCProfileIndication : uint = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                    let profile_compatibility : uint = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                    let AVCLevelIndication : uint = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                    // bit(6) reserved =
                    let lengthSizeMinusOne : uint = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag)) & 3u
                    spspps = 0
                    while (spspps < 2) {
                        var numOfSequenceParameterSets : uint = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                        if (spspps == 0) {
                            // clears 3 msb for SPS
                            numOfSequenceParameterSets &= 31u
                        }
                        var _t2 = p
                        p++
                        *_t2 = uint8(numOfSequenceParameterSets)
                        i = 0u
                        while (i < numOfSequenceParameterSets) {
                            var k : uint
                            let sequenceParameterSetLength : uint = h264_file_all__read_payload(mp4, 2u, addr(payload_bytes), addr(eof_flag))
                            var _t3 = p
                            p++
                            *_t3 = uint8(sequenceParameterSetLength >> 8u)
                            var _t4 = p
                            p++
                            *_t4 = uint8(sequenceParameterSetLength)
                            k = 0u
                            while (k < sequenceParameterSetLength) {
                                var _t5 = p
                                p++
                                *_t5 = uint8(h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag)))
                                k++
                            }
                            i++
                        }
                        spspps++
                    }
                }
                break
            }
            case(606348339u) {
                {
                    // MP4D_AVC_SUPPORTED
                    // ES_ID(2) + flags(1)
                    let flags : uint = h264_file_all__read_payload(mp4, 3u, addr(payload_bytes), addr(eof_flag))
                    // steamdependflag
                    if ((flags & 128u) != 0) {
                        {
                            // dependsOnESID
                            let t : uint64 = MINIMP4_MIN(payload_bytes, 2)
                            h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                            payload_bytes -= t
                        }
                    }
                    // urlflag
                    if ((flags & 64u) != 0) {
                        let bytecount : uint = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                        {
                            // skip URL
                            let t : uint64 = MINIMP4_MIN(payload_bytes, bytecount)
                            h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                            payload_bytes -= t
                        }
                    }
                    // ocrflag (was reserved in MPEG-4 v.1)
                    if ((flags & 32u) != 0) {
                        {
                            // OCRESID
                            let t : uint64 = MINIMP4_MIN(payload_bytes, 2)
                            h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                            payload_bytes -= t
                        }
                    }
                    break
                }
            }
            case(606348340u) {
                // ISO/IEC 14496-1 Page 28. Section 8.6.5 - DecoderConfigDescriptor.
                // ensured by g_fullbox[] check
                tr.object_type_indication = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag))
                tr.stream_type = h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag)) >> 2u
                {
                    // bufferSizeDB maxBitrate
                    let t : uint64 = MINIMP4_MIN(payload_bytes, 3 + 4)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
                tr.avg_bitrate_bps = h264_file_all__read_payload(mp4, 4u, addr(payload_bytes), addr(eof_flag))
                break
            }
            case(606348341u) {
                // ISO/IEC 14496-1 Page 28. Section 8.6.5 - DecoderConfigDescriptor.
                // ensured by g_fullbox[] check
                if (tr.dsi == null && payload_bytes != 0) {
                    tr.dsi = reinterpret<uint8?>(malloc1(uint64(int(payload_bytes))))
                    if (tr.dsi == null) {
                        if (depth == 0) {
                            break
                        } else {
                            MP4D_close(mp4)
                            return 0
                        }
                    }
                    i = 0u
                    while (uint64(i) < payload_bytes) {
                        // These bytes available due to check above
                        tr.dsi[i] = uint8(h264_file_all__minimp4_read(mp4, 1, addr(eof_flag)))
                        i++
                    }
                    tr.dsi_bytes = i
                    payload_bytes -= uint64(i)
                    break
                }
            }
            case(_) {
            }
        }
        // Read tag is tag pointer is set
        if (ptag != null && *ptag == null && payload_bytes > 16ul) {
            {
                let t : uint64 = MINIMP4_MIN(payload_bytes, 4 + 4 + 4 + 4)
                h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                payload_bytes -= t
            }
            *ptag = reinterpret<uint8?>(malloc1(uint64(uint(payload_bytes) + 1u)))
            if (*ptag == null) {
                if (depth == 0) {
                    break
                } else {
                    MP4D_close(mp4)
                    return 0
                }
            }
            i = 0u
            while (payload_bytes != 0ul) {
                (*ptag)[i] = uint8(h264_file_all__read_payload(mp4, 1u, addr(payload_bytes), addr(eof_flag)))
                i++
            }
            // zero-terminated string
            (*ptag)[i] = 0u8
        }
        if (box_name == uint(anon_644.BOX_trak)) {
            // New track found: allocate memory using realloc()
            // Typically there are 1 audio track for AAC audio file,
            // 4 tracks for movie file,
            // 3-5 tracks for scalable audio (CELP+AAC)
            // and up to 50 tracks for BSAC scalable audio
            var mem : void? = realloc1(reinterpret<void?>(mp4.track), uint64(mp4.track_count + 1u) * uint64(typeinfo sizeof(type<MP4D_track_t>)))
            if (mem == null) {
                // if realloc fails, it does not deallocate old pointer!
                if (depth == 0) {
                    break
                } else {
                    MP4D_close(mp4)
                    return 0
                }
            }
            mp4.track = reinterpret<MP4D_track_t?>(mem)
            let _t6 = mp4.track_count
            mp4.track_count++
            tr = mp4.track + _t6
            memset1(reinterpret<void?>(tr), 0, uint64(typeinfo sizeof(type<MP4D_track_t>)))
        } elif (box_name == uint(anon_644.BOX_meta)) {
            // Avoid update of 'hdlr' box, which may contains in the 'meta' box
            tr = null
        }
        // If this box is envelope, save it's size in box stack
        i = 0u
        while (uint64(i) < uint64(typeinfo sizeof(type<anon_753[20]>)) / uint64(typeinfo sizeof(type<anon_753>))) {
            if (box_name == MP4D_open_g_envelope_box[i].name) {
                depth++
                if (depth >= MAX_CHUNKS_DEPTH) {
                    if (depth == 0) {
                        break
                    } else {
                        MP4D_close(mp4)
                        return 0
                    }
                }
                stack[depth].bytes = payload_bytes
                stack[depth].format = MP4D_open_g_envelope_box[i]._c_type
                break
            }
            i++
        }
        // if box is not envelope, just skip it
        if (uint64(i) == uint64(typeinfo sizeof(type<anon_753[20]>)) / uint64(typeinfo sizeof(type<anon_753>))) {
            if (payload_bytes > uint64(file_size)) {
                eof_flag = 1
            } else {
                {
                    let t : uint64 = MINIMP4_MIN(payload_bytes, payload_bytes)
                    h264_file_all__my_fseek(mp4, t, addr(eof_flag))
                    payload_bytes -= t
                }
            }
        }
        // remove empty boxes from stack
        // don't touch box with index 0 (which indicates whole file)
        while (depth > 0 && stack[depth].bytes == 0) {
            depth--
        }
    }
    if (mp4.track_count == 0) {
        MP4D_close(mp4)
        return 0
    }
    return 1
}

// Find chunk, containing given sample.
// Returns chunk number, and first sample in this chunk.
[c_function]
def private h264_file_all__sample_to_chunk(var tr : MP4D_track_t?; nsample : uint; var nfirst_sample_in_chunk : uint?) : int {
    var chunk_group : uint = 0u
    var nc : uint
    var sum : uint = 0u
    *nfirst_sample_in_chunk = 0u
    if (tr.chunk_count <= 1u) {
        return 0
    }
    nc = 0u
    while (nc < tr.chunk_count) {
        // stuck at last entry till EOF
        if (chunk_group + 1u < tr.sample_to_chunk_count && nc + 1u == tr.sample_to_chunk[chunk_group + 1u].first_chunk) {
            // Chunks counted starting with '1'
            // next group?
            chunk_group++
        }
        sum += tr.sample_to_chunk[chunk_group].samples_per_chunk
        if (nsample < sum) {
            return int(nc)
        }
        // TODO: this can be calculated once per file
        *nfirst_sample_in_chunk = sum
        nc++
    }
    return -1
}

// Exported API function
[c_function]
def MP4D_frame_offset(var mp4 : MP4D_demux_tag?; ntrack : uint; nsample : uint; var frame_bytes : uint?; var timestamp : uint?; var duration : uint?) : uint64 {
    var tr : MP4D_track_t? = mp4.track + ntrack
    var ns : uint
    let nchunk : int = h264_file_all__sample_to_chunk(tr, nsample, addr(ns))
    var offset : uint64
    if (nchunk < 0) {
        *frame_bytes = 0u
        return 0ul
    }
    offset = tr.chunk_offset[nchunk]
    while (ns < nsample) {
        offset += uint64(tr.entry_size[ns])
        ns++
    }
    *frame_bytes = tr.entry_size[ns]
    if (timestamp != null) {
        *timestamp = tr.timestamp[ns]
    }
    if (duration != null) {
        *duration = tr.duration[ns]
    }
    return offset
}

// Exported API function
[c_function]
def MP4D_close(var mp4 : MP4D_demux_tag?) {
    while (mp4.track_count != 0) {
        mp4.track_count--
        var tr : MP4D_track_t? = mp4.track + mp4.track_count
        if (tr.entry_size != null) {
            free1(reinterpret<void?>(tr.entry_size))
            tr.entry_size = null
        }
        if (tr.timestamp != null) {
            free1(reinterpret<void?>(tr.timestamp))
            tr.timestamp = null
        }
        if (tr.duration != null) {
            free1(reinterpret<void?>(tr.duration))
            tr.duration = null
        }
        if (tr.sample_to_chunk != null) {
            free1(reinterpret<void?>(tr.sample_to_chunk))
            tr.sample_to_chunk = null
        }
        if (tr.chunk_offset != null) {
            free1(reinterpret<void?>(tr.chunk_offset))
            tr.chunk_offset = null
        }
        if (tr.dsi != null) {
            free1(reinterpret<void?>(tr.dsi))
            tr.dsi = null
        }
    }
    if (mp4.track != null) {
        free1(reinterpret<void?>(mp4.track))
        mp4.track = null
    }
    if (mp4.tag.title != null) {
        free1(reinterpret<void?>(mp4.tag.title))
        mp4.tag.title = null
    }
    if (mp4.tag.artist != null) {
        free1(reinterpret<void?>(mp4.tag.artist))
        mp4.tag.artist = null
    }
    if (mp4.tag.album != null) {
        free1(reinterpret<void?>(mp4.tag.album))
        mp4.tag.album = null
    }
    if (mp4.tag.year != null) {
        free1(reinterpret<void?>(mp4.tag.year))
        mp4.tag.year = null
    }
    if (mp4.tag.comment != null) {
        free1(reinterpret<void?>(mp4.tag.comment))
        mp4.tag.comment = null
    }
    if (mp4.tag.genre != null) {
        free1(reinterpret<void?>(mp4.tag.genre))
        mp4.tag.genre = null
    }
}

[c_function]
def private h264_file_all__skip_spspps(var p : uint8?; nbytes : int; nskip : int) : int {
    var k : int = 0
    for (i in range(nskip)) {
        var segmbytes : uint
        if (k > nbytes - 2) {
            return -1
        }
        segmbytes = uint(int(p[k]) * 256 + int(p[k + 1]))
        k = int(uint(k) + (2u + segmbytes))
    }
    return k
}

[c_function]
def private h264_file_all__MP4D_read_spspps(var mp4 : MP4D_demux_tag?; ntrack : uint; pps_flag : int; nsps : int; var sps_bytes : int?) : void? {
    var sps_count : int
    var skip_bytes : int
    var bytepos : int = 0
    var p : uint8? = mp4.track[ntrack].dsi
    if (ntrack >= mp4.track_count) {
        return null
    }
    if (mp4.track[ntrack].object_type_indication != uint(MP4_OBJECT_TYPE_AVC)) {
        // SPS/PPS are specific for AVC format only
        return null
    }
    if (pps_flag != 0) {
        // Skip all SPS
        let _t0 = bytepos
        bytepos++
        sps_count = int(p[_t0])
        skip_bytes = h264_file_all__skip_spspps(p + bytepos, int(mp4.track[ntrack].dsi_bytes - uint(bytepos)), sps_count)
        if (skip_bytes < 0) {
            return null
        }
        bytepos += skip_bytes
    }
    // Skip sps/pps before the given target
    let _t1 = bytepos
    bytepos++
    sps_count = int(p[_t1])
    if (nsps >= sps_count) {
        return null
    }
    skip_bytes = h264_file_all__skip_spspps(p + bytepos, int(mp4.track[ntrack].dsi_bytes - uint(bytepos)), nsps)
    if (skip_bytes < 0) {
        return null
    }
    bytepos += skip_bytes
    *sps_bytes = int(p[bytepos]) * 256 + int(p[bytepos + 1])
    return reinterpret<void?>(p + bytepos + 2)
}

def MP4D_read_sps(var mp4 : MP4D_demux_tag?; ntrack : uint; nsps : int; var sps_bytes : int?) : void? {
    return h264_file_all__MP4D_read_spspps(mp4, ntrack, 0, nsps, sps_bytes)
}

def MP4D_read_pps(var mp4 : MP4D_demux_tag?; ntrack : uint; npps : int; var pps_bytes : int?) : void? {
    return h264_file_all__MP4D_read_spspps(mp4, ntrack, 1, npps, pps_bytes)
}

[c_function]
def c2da_probe_minimp4_read4(read_callback : function<(a0 : int64; var a1 : void?; a2 : uint64; var a3 : void?) : int>; var token : void?;
                             file_size : int64) : int {
    var mp4 : MP4D_demux_tag
    var eof_flag : int = 0
    memset1(reinterpret<void?>(addr(mp4)), 0, uint64(typeinfo sizeof(type<MP4D_demux_tag>)))
    mp4.read_callback = read_callback
    mp4.token = token
    mp4.read_size = file_size
    return int(h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag)))
}

[c_function]
