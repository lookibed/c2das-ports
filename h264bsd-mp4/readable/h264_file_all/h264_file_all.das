def shim_reset_heap {
    h264_file_all__heap_offset = 8ul
}

[c_function]
def malloc1(size : uint64) : void? {
    let aligned_header : uint64 = (uint64(typeinfo sizeof(type<HeapHeader>)) + uint64(7u)) & ~uint64(7u)
    let aligned_size : uint64 = (size + uint64(7u)) & ~uint64(7u)
    let total : uint64 = aligned_header + aligned_size
    var header : HeapHeader? = null
    if ((h264_file_all__heap_offset + total) > uint64(typeinfo sizeof(type<uint8[33554432]>))) {
        return null
    }
    header = reinterpret<HeapHeader?>(addr(h264_file_all__heap[0]) + h264_file_all__heap_offset)
    header.size = size
    h264_file_all__heap_offset += total
    return reinterpret<void?>(reinterpret<uint8?>(header) + aligned_header)
}

def free1(var ptr : void?) {
}

[c_function]
def realloc1(var ptr : void?; size : uint64) : void? {
    var result : void? = malloc1(size)
    var old_size : uint64 = 0ul
    var copy_size : uint64 = 0ul
    let aligned_header : uint64 = (uint64(typeinfo sizeof(type<HeapHeader>)) + uint64(7u)) & ~uint64(7u)
    if (result == null) {
        return null
    }
    if (ptr != null) {
        var dst : uint8? = reinterpret<uint8?>(result)
        var src : uint8? = reinterpret<uint8?>(ptr)
        var header : HeapHeader? = reinterpret<HeapHeader?>(src - aligned_header)
        old_size = header.size
        copy_size = old_size < size ? old_size : size
        for (i in urange64(copy_size)) {
            dst[i] = src[i]
        }
    }
    return result
}

[c_function]
def calloc1(count : uint64; size : uint64) : void? {
    let total : uint64 = count * size
    var result : void? = malloc1(total)
    if (result == null) {
        return null
    }
    for (i in urange64(total)) {
        reinterpret<uint8?>(result)[i] = 0u8
    }
    return result
}

[c_function]
def memset1(var dest : void?; value : int; count : uint64) : void? {
    var bytes : uint8? = reinterpret<uint8?>(dest)
    for (i in urange64(count)) {
        bytes[i] = uint8(value)
    }
    return dest
}

[c_function]
def memcpy1(var dest : void?; var src : void?; count : uint64) : void? {
    var out : uint8? = reinterpret<uint8?>(dest)
    var _c_in : uint8? = reinterpret<uint8?>(src)
    for (i in urange64(count)) {
        out[i] = _c_in[i]
    }
    return dest
}

[c_function]
def memmove1(var dest : void?; var src : void?; count : uint64) : void? {
    var out : uint8? = reinterpret<uint8?>(dest)
    var _c_in : uint8? = reinterpret<uint8?>(src)
    var i : uint64 = 0ul
    if (out == reinterpret<uint8?>(_c_in) || count == 0ul) {
        return dest
    }
    if (reinterpret<uint64>(out) < reinterpret<uint64>(_c_in)) {
        for (i1 in urange64(count)) {
            out[i1] = _c_in[i1]
        }
    } else {
        i = count
        while (i > 0ul) {
            out[i - 1ul] = _c_in[i - 1ul]
            i--
        }
    }
    return dest
}

[c_function]
def memcmp1(var lhs : void?; var rhs : void?; count : uint64) : int {
    var left : uint8? = reinterpret<uint8?>(lhs)
    var right : uint8? = reinterpret<uint8?>(rhs)
    for (i in urange64(count)) {
        if (left[i] != right[i]) {
            return int(left[i]) - int(right[i])
        }
    }
    return 0
}

[c_function]
def memchr1(var src : void?; value : int; count : uint64) : void? {
    var bytes : uint8? = reinterpret<uint8?>(src)
    for (i in urange64(count)) {
        if (bytes[i] == uint8(value)) {
            return reinterpret<void?>(bytes + i)
        }
    }
    return null
}

[c_function]
def strlen1(var src : uint8?) : uint64 {
    var count : uint64 = 0ul
    while (src[count] != '\0') {
        count += 1ul
    }
    return count
}

[c_function]
def strdup1(var src : uint8?) : uint8? {
    let length : uint64 = strlen1(src)
    var copy : uint8? = reinterpret<uint8?>(malloc1(length + uint64(1u)))
    if (copy == null) {
        return null
    }
    for (index in urange64(length)) {
        copy[index] = src[index]
    }
    copy[length] = uint8('\0')
    return copy
}

def mallocz(size : uint64) : void? {
    return calloc1(uint64(1u), size)
}

[c_function]
def h264bsdExtractNalUnit(var pByteStream : uint8?; len : uint; var pStrmData : strmData_t?; var readBytes : uint?) : uint {
    // Variables
    var i : uint
    var tmp : uint
    var byteCount : uint
    var initByteCount : uint
    var zeroCount : uint
    var byte : uint8
    var hasEmulation : uint = uint(HANTRO_FALSE)
    var invalidStream : uint = uint(HANTRO_FALSE)
    var readPtr : uint8?
    var writePtr : uint8?
    // Code
    // byte stream format if starts with 0x000001 or 0x000000
    if (len > 3u && pByteStream[0] == 0 && pByteStream[1] == 0 && (int(pByteStream[2]) & 254) == 0) {
        // search for NAL unit start point, i.e. point after first start code
        // prefix in the stream
        byteCount = 2u
        zeroCount = byteCount
        readPtr = pByteStream + 2
        // lint -e(716) while(1) used consciously
        while (1 != 0) {
            var _t0 = readPtr
            readPtr++
            byte = *_t0
            byteCount++
            if (byteCount == len) {
                // no start code prefix found -> error
                *readBytes = len
                return uint(HANTRO_NOK)
            }
            if (byte == 0) {
                zeroCount++
            } elif ((byte == 1) && (zeroCount >= 2u)) {
                break
            } else {
                zeroCount = 0u
            }
        }
        initByteCount = byteCount
        // determine size of the NAL unit. Search for next start code prefix
        // or end of stream and ignore possible trailing zero bytes
        zeroCount = 0u
        // lint -e(716) while(1) used consciously
        while (1 != 0) {
            var _t1 = readPtr
            readPtr++
            byte = *_t1
            byteCount++
            if (byte == 0) {
                zeroCount++
            }
            if ((byte == 3) && (zeroCount == 2u)) {
                hasEmulation = uint(HANTRO_TRUE)
            }
            if ((byte == 1) && (zeroCount >= 2u)) {
                pStrmData.strmBuffSize = byteCount - initByteCount - zeroCount - 1u
                zeroCount -= MIN(zeroCount, 3)
                break
            } elif (byte != 0) {
                if (zeroCount >= 3u) {
                    invalidStream = uint(HANTRO_TRUE)
                }
                zeroCount = 0u
            }
            if (byteCount == len) {
                pStrmData.strmBuffSize = byteCount - initByteCount - zeroCount
                break
            }
        }
    } else {
        // separate NAL units as input -> just set stream params
        initByteCount = 0u
        zeroCount = 0u
        pStrmData.strmBuffSize = len
        hasEmulation = uint(HANTRO_TRUE)
    }
    pStrmData.pStrmBuffStart = pByteStream + initByteCount
    pStrmData.pStrmCurrPos = pStrmData.pStrmBuffStart
    pStrmData.bitPosInWord = 0u
    pStrmData.strmBuffReadBits = 0u
    // return number of bytes "consumed"
    *readBytes = pStrmData.strmBuffSize + initByteCount + zeroCount
    if (invalidStream != 0) {
        return uint(HANTRO_NOK)
    }
    // remove emulation prevention bytes before rbsp processing
    if (hasEmulation != 0) {
        tmp = pStrmData.strmBuffSize
        writePtr = pStrmData.pStrmBuffStart
        readPtr = writePtr
        zeroCount = 0u
        i = tmp
        while (true) {
            let _t2 = i
            i--
            if (_t2 == 0) {
                break
            }
            if ((zeroCount == 2u) && (*readPtr == 3)) {
                // emulation prevention byte shall be followed by one of the
                // following bytes: 0x00, 0x01, 0x02, 0x03. This implies that
                // emulation prevention 0x03 byte shall not be the last byte
                // of the stream.
                if ((i == 0u) || (int(readPtr[1]) > 3)) {
                    return uint(HANTRO_NOK)
                }
                // do not write emulation prevention byte
                readPtr++
                zeroCount = 0u
            } else {
                // NAL unit shall not contain byte sequences 0x000000,
                // 0x000001 or 0x000002
                if ((zeroCount == 2u) && (int(*readPtr) <= 2)) {
                    return uint(HANTRO_NOK)
                }
                if (*readPtr == 0) {
                    zeroCount++
                } else {
                    zeroCount = 0u
                }
                var _t3 = writePtr
                writePtr++
                var _t4 = readPtr
                readPtr++
                *_t3 = *_t4
            }
        }
        // (readPtr - writePtr) indicates number of "removed" emulation
        // prevention bytes -> subtract from stream buffer size
        pStrmData.strmBuffSize -= uint(int64(readPtr - writePtr))
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__DecodeCoeffToken(bits : uint; nc : uint) : uint {
    // Variables
    var value : uint
    // Code
    // standard defines that nc for decoding of chroma dc coefficients is -1,
    // represented by u32 here -> -1 maps to 2^32 - 1
    if (nc < 2u) {
        if (bits >= 32768u) {
            value = 1u
        } elif (bits >= 3072u) {
            value = uint(h264_file_all__coeffToken0_0[bits >> 10u])
        } elif (bits >= 256u) {
            value = uint(h264_file_all__coeffToken0_1[bits >> 6u])
        } elif (bits >= 32u) {
            value = uint(h264_file_all__coeffToken0_2[(bits >> 2u) - 8u])
        } else {
            value = uint(h264_file_all__coeffToken0_3[bits])
        }
    } elif (nc < 4u) {
        if (bits >= 32768u) {
            value = uint((bits & 16384u) != 0 ? 2 : 2082)
        } elif (bits >= 4096u) {
            value = uint(h264_file_all__coeffToken2_0[bits >> 10u])
        } elif (bits >= 512u) {
            value = uint(h264_file_all__coeffToken2_1[bits >> 7u])
        } else {
            value = uint(h264_file_all__coeffToken2_2[bits >> 2u])
        }
    } elif (nc < 8u) {
        value = uint(h264_file_all__coeffToken4_0[bits >> 10u])
        if (value == 0) {
            value = uint(h264_file_all__coeffToken4_1[bits >> 6u])
        }
    } elif (nc <= 16u) {
        value = uint(h264_file_all__coeffToken8[bits >> 10u])
    } else {
        value = uint(h264_file_all__coeffTokenMinus1_0[bits >> 13u])
        if (value == 0) {
            value = uint(h264_file_all__coeffTokenMinus1_1[bits >> 8u])
        }
    }
    return value
}

def private h264_file_all__DecodeLevelPrefix(bits : uint) : uint {
    // Variables
    var numZeros : uint
    // Code
    if (bits >= 32768u) {
        numZeros = 0u
    } elif (bits >= 16384u) {
        numZeros = 1u
    } elif (bits >= 8192u) {
        numZeros = 2u
    } elif (bits >= 4096u) {
        numZeros = 3u
    } elif (bits >= 2048u) {
        numZeros = 4u
    } elif (bits >= 1024u) {
        numZeros = 5u
    } elif (bits >= 512u) {
        numZeros = 6u
    } elif (bits >= 256u) {
        numZeros = 7u
    } elif (bits >= 128u) {
        numZeros = 8u
    } elif (bits >= 64u) {
        numZeros = 9u
    } elif (bits >= 32u) {
        numZeros = 10u
    } elif (bits >= 16u) {
        numZeros = 11u
    } elif (bits >= 8u) {
        numZeros = 12u
    } elif (bits >= 4u) {
        numZeros = 13u
    } elif (bits >= 2u) {
        numZeros = 14u
    } elif (bits >= 1u) {
        numZeros = 15u
    } else {
        // more than 15 zeros encountered which is an error
        return VLC_NOT_FOUND
    }
    return numZeros
}

def private h264_file_all__DecodeTotalZeros(var bits : uint; totalCoeff : uint; isChromaDC : uint) : uint {
    // Variables
    var value : uint = 0u
    // Code
    if (isChromaDC == 0) {
        c_switch(totalCoeff) {
            case(1u) {
                value = uint(h264_file_all__totalZeros_1_0[bits >> 4u])
                if (value == 0) {
                    value = uint(h264_file_all__totalZeros_1_1[bits])
                }
                break
            }
            case(2u) {
                value = uint(h264_file_all__totalZeros_2[bits >> 3u])
                break
            }
            case(3u) {
                value = uint(h264_file_all__totalZeros_3[bits >> 3u])
                break
            }
            case(4u) {
                value = uint(h264_file_all__totalZeros_4[bits >> 4u])
                break
            }
            case(5u) {
                value = uint(h264_file_all__totalZeros_5[bits >> 4u])
                break
            }
            case(6u) {
                value = uint(h264_file_all__totalZeros_6[bits >> 3u])
                break
            }
            case(7u) {
                value = uint(h264_file_all__totalZeros_7[bits >> 3u])
                break
            }
            case(8u) {
                value = uint(h264_file_all__totalZeros_8[bits >> 3u])
                break
            }
            case(9u) {
                value = uint(h264_file_all__totalZeros_9[bits >> 3u])
                break
            }
            case(10u) {
                value = uint(h264_file_all__totalZeros_10[bits >> 4u])
                break
            }
            case(11u) {
                value = uint(h264_file_all__totalZeros_11[bits >> 5u])
                break
            }
            case(12u) {
                value = uint(h264_file_all__totalZeros_12[bits >> 5u])
                break
            }
            case(13u) {
                value = uint(h264_file_all__totalZeros_13[bits >> 6u])
                break
            }
            case(14u) {
                value = uint(h264_file_all__totalZeros_14[bits >> 7u])
                break
            }
            case(_) {
                // case 15
                value = uint((bits >> 8u) != 0 ? 17 : 1)
                break
            }
        }
    } else {
        bits >>= 6u
        if (bits > 3u) {
            value = 1u
        } else {
            if (totalCoeff == 3u) {
                value = 17u
            } elif (bits > 1u) {
                value = 18u
            } elif (totalCoeff == 2u) {
                value = 34u
            } elif (bits != 0) {
                value = 35u
            } else {
                value = 51u
            }
        }
    }
    return value
}

def private h264_file_all__DecodeRunBefore(bits : uint; zerosLeft : uint) : uint {
    // Variables
    var value : uint = 0u
    // Code
    c_switch(zerosLeft) {
        case(1u) {
            value = uint(h264_file_all__runBefore_1[bits >> 10u])
            break
        }
        case(2u) {
            value = uint(h264_file_all__runBefore_2[bits >> 9u])
            break
        }
        case(3u) {
            value = uint(h264_file_all__runBefore_3[bits >> 9u])
            break
        }
        case(4u) {
            value = uint(h264_file_all__runBefore_4[bits >> 8u])
            break
        }
        case(5u) {
            value = uint(h264_file_all__runBefore_5[bits >> 8u])
            break
        }
        case(6u) {
            value = uint(h264_file_all__runBefore_6[bits >> 8u])
            break
        }
        case(_) {
            if (bits >= 256u) {
                value = ((7u - (bits >> 8u)) << 4u) + 3u
            } elif (bits >= 128u) {
                value = 116u
            } elif (bits >= 64u) {
                value = 133u
            } elif (bits >= 32u) {
                value = 150u
            } elif (bits >= 16u) {
                value = 167u
            } elif (bits >= 8u) {
                value = 184u
            } elif (bits >= 4u) {
                value = 201u
            } elif (bits >= 2u) {
                value = 218u
            } elif (bits != 0) {
                value = 235u
            }
            if (INFO(value) > zerosLeft) {
                value = 0u
            }
            break
        }
    }
    return value
}

[c_function]
def h264bsdDecodeResidualBlockCavlc(var pStrmData : strmData_t?; var coeffLevel : int?; nc : int; maxNumCoeff : uint) : uint {
    // Variables
    var i : uint
    var tmp : uint
    var totalCoeff : uint
    var trailingOnes : uint
    var suffixLength : uint
    var levelPrefix : uint
    var levelSuffix : uint
    var zerosLeft : uint
    var bit : uint
    var level : int[16]
    var run : uint[16]
    // stream "cache"
    var bufferValue : uint
    var bufferBits : uint
    // Code
    // assume that coeffLevel array has been "cleaned" by caller
    bufferBits = 32u
    bufferValue = h264bsdShowBits32(pStrmData)
    // lint -e774 disable lint warning on always false comparison
    if (bufferBits < 16u) {
        if (h264bsdFlushBits(pStrmData, 32u - bufferBits) == END_OF_STREAM) {
            return uint(HANTRO_NOK)
        }
        bufferValue = h264bsdShowBits32(pStrmData)
        bufferBits = 32u
    }
    bit = bufferValue >> uint(32 - 16)
    // lint +e774
    tmp = h264_file_all__DecodeCoeffToken(bit, uint(nc))
    if (tmp == 0) {
        return uint(HANTRO_NOK)
    }
    bufferValue <<= tmp & 31u
    bufferBits -= tmp & 31u
    totalCoeff = TOTAL_COEFF(tmp)
    if (totalCoeff > maxNumCoeff) {
        return uint(HANTRO_NOK)
    }
    trailingOnes = TRAILING_ONES(tmp)
    if (totalCoeff != 0u) {
        i = 0u
        // nonzero coefficients: +/- 1
        if (trailingOnes != 0) {
            if (bufferBits < trailingOnes) {
                if (h264bsdFlushBits(pStrmData, 32u - bufferBits) == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                bufferValue = h264bsdShowBits32(pStrmData)
                bufferBits = 32u
            }
            bit = bufferValue >> 32u - trailingOnes
            bufferValue <<= trailingOnes
            bufferBits -= trailingOnes
            tmp = uint(1 << int(trailingOnes - 1u))
            while (tmp != 0) {
                level[i] = (bit & tmp) != 0 ? -1 : 1
                tmp >>= 1u
                i++
            }
        }
        // other levels
        if (totalCoeff > 10u && trailingOnes < 3u) {
            suffixLength = 1u
        } else {
            suffixLength = 0u
        }
        while (i < totalCoeff) {
            if (bufferBits < 16u) {
                if (h264bsdFlushBits(pStrmData, 32u - bufferBits) == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                bufferValue = h264bsdShowBits32(pStrmData)
                bufferBits = 32u
            }
            bit = bufferValue >> uint(32 - 16)
            levelPrefix = h264_file_all__DecodeLevelPrefix(bit)
            if (levelPrefix == VLC_NOT_FOUND) {
                return uint(HANTRO_NOK)
            }
            bufferValue <<= levelPrefix + 1u
            bufferBits -= levelPrefix + 1u
            if (levelPrefix < 14u) {
                tmp = suffixLength
            } elif (levelPrefix == 14u) {
                tmp = suffixLength != 0 ? suffixLength : 4u
            } else {
                // setting suffixLength to 1 here corresponds to adding 15
                // to levelCode value if levelPrefix == 15 and
                // suffixLength == 0
                if (suffixLength == 0) {
                    suffixLength = 1u
                }
                tmp = 12u
            }
            if (suffixLength != 0) {
                levelPrefix <<= suffixLength
            }
            if (tmp != 0) {
                if (bufferBits < tmp) {
                    if (h264bsdFlushBits(pStrmData, 32u - bufferBits) == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    bufferValue = h264bsdShowBits32(pStrmData)
                    bufferBits = 32u
                }
                levelSuffix = bufferValue >> 32u - tmp
                bufferValue <<= tmp
                bufferBits -= tmp
                levelPrefix += levelSuffix
            }
            tmp = levelPrefix
            if (i == trailingOnes && trailingOnes < 3u) {
                tmp += 2u
            }
            level[i] = int((tmp + 2u) >> 1u)
            if (suffixLength == 0u) {
                suffixLength = 1u
            }
            if ((level[i] > (3 << int(suffixLength - 1u))) && suffixLength < 6u) {
                suffixLength++
            }
            if ((tmp & 1u) != 0) {
                level[i] = -level[i]
            }
            i++
        }
        // zero runs
        if (totalCoeff < maxNumCoeff) {
            if (bufferBits < 9u) {
                if (h264bsdFlushBits(pStrmData, 32u - bufferBits) == END_OF_STREAM) {
                    return uint(HANTRO_NOK)
                }
                bufferValue = h264bsdShowBits32(pStrmData)
                bufferBits = 32u
            }
            bit = bufferValue >> uint(32 - 9)
            zerosLeft = h264_file_all__DecodeTotalZeros(bit, totalCoeff, uint(int_of(maxNumCoeff == 4u)))
            if (zerosLeft == 0) {
                return uint(HANTRO_NOK)
            }
            bufferValue <<= zerosLeft & 15u
            bufferBits -= zerosLeft & 15u
            zerosLeft = INFO(zerosLeft)
        } else {
            zerosLeft = 0u
        }
        for (i1 in urange(totalCoeff - 1u)) {
            if (zerosLeft > 0u) {
                if (bufferBits < 11u) {
                    if (h264bsdFlushBits(pStrmData, 32u - bufferBits) == END_OF_STREAM) {
                        return uint(HANTRO_NOK)
                    }
                    bufferValue = h264bsdShowBits32(pStrmData)
                    bufferBits = 32u
                }
                bit = bufferValue >> uint(32 - 11)
                tmp = h264_file_all__DecodeRunBefore(bit, zerosLeft)
                if (tmp == 0) {
                    return uint(HANTRO_NOK)
                }
                bufferValue <<= tmp & 15u
                bufferBits -= tmp & 15u
                run[i1] = INFO(tmp)
                let _t0 = run[i1]
                run[i1]++
                zerosLeft -= _t0
            } else {
                run[i1] = 1u
            }
        }
        // combining level and run, levelSuffix variable used to hold coeffMap,
        // i.e. bit map indicating which coefficients had non-zero value.
        // lint -esym(771,level,run) level and run are always initialized
        tmp = zerosLeft
        coeffLevel[tmp] = level[totalCoeff - 1u]
        levelSuffix = uint(1 << int(tmp))
        i = totalCoeff - 1u
        while (true) {
            let _t1 = i
            i--
            if (_t1 == 0) {
                break
            }
            tmp += run[i]
            levelSuffix |= uint(1 << int(tmp))
            coeffLevel[tmp] = level[i]
        }
    } else {
        levelSuffix = 0u
    }
    if (h264bsdFlushBits(pStrmData, 32u - bufferBits) != uint(HANTRO_OK)) {
        return uint(HANTRO_NOK)
    }
    return (totalCoeff << 4u) | (levelSuffix << 16u)
}

[c_function]
def h264bsdConceal(var pStorage : storage?; var currImage : image_t?; sliceType : uint) : uint {
    // Variables
    var i : uint
    var j : uint
    var row : uint
    var col : uint
    var width : uint
    var height : uint
    var refData : uint8?
    var mb : mbStorage?
    // Code
    width = currImage.width
    height = currImage.height
    refData = null
    // use reference picture with smallest available index
    if (IS_P_SLICE(sliceType) || (pStorage.intraConcealmentFlag != 0u)) {
        i = 0u
        c_do_while(refData == null) {
            refData = h264bsdGetRefPicData(addr(pStorage.dpb[0]), i)
            i++
            if (i >= 16u) {
                break
            }
        }
    }
    col = 0u
    row = col
    i = row
    // find first properly decoded macroblock -> start point for concealment
    while (i < pStorage.picSizeInMbs && pStorage.mb[i].decoded == 0) {
        i++
        col++
        if (col == width) {
            row++
            col = 0u
        }
    }
    // whole picture lost -> copy previous or set grey
    if (i == pStorage.picSizeInMbs) {
        if ((IS_I_SLICE(sliceType) && (pStorage.intraConcealmentFlag == 0u)) || refData == null) {
            memset1(reinterpret<void?>(currImage.data), 128, uint64(width * height * 384u))
        } else {
            memcpy1(reinterpret<void?>(currImage.data), reinterpret<void?>(refData), uint64(width * height * 384u))
        }
        pStorage.numConcealedMbs = pStorage.picSizeInMbs
        // no filtering if whole picture concealed
        i = 0u
        while (i < pStorage.picSizeInMbs) {
            pStorage.mb[i].disableDeblockingFilterIdc = 1u
            i++
        }
        return uint(HANTRO_OK)
    }
    // start from the row containing the first correct macroblock, conceal the
    // row in question, all rows above that row and then continue downwards
    mb = pStorage.mb + row * width
    j = col
    while (true) {
        let _t0 = j
        j--
        if (_t0 == 0) {
            break
        }
        h264_file_all__ConcealMb(mb + j, currImage, row, j, sliceType, refData)
        mb[j].decoded = 1u
        pStorage.numConcealedMbs++
    }
    for (j1 in urange(col + 1u, width)) {
        if (mb[j1].decoded == 0) {
            h264_file_all__ConcealMb(mb + j1, currImage, row, j1, sliceType, refData)
            mb[j1].decoded = 1u
            pStorage.numConcealedMbs++
        }
    }
    // if previous row(s) could not be concealed -> conceal them now
    if (row != 0) {
        for (j1 in urange(width)) {
            i = row - 1u
            mb = pStorage.mb + i * width + j1
            while (true) {
                h264_file_all__ConcealMb(mb, currImage, i, j1, sliceType, refData)
                mb.decoded = 1u
                pStorage.numConcealedMbs++
                mb -= width
                let _t1 = i
                i--
                if (_t1 == 0) {
                    break
                }
            }
        }
    }
    // process rows below the one containing the first correct macroblock
    for (i1 in urange(row + 1u, height)) {
        mb = pStorage.mb + i1 * width
        for (j1 in urange(width)) {
            if (mb[j1].decoded == 0) {
                h264_file_all__ConcealMb(mb + j1, currImage, i1, j1, sliceType, refData)
                mb[j1].decoded = 1u
                pStorage.numConcealedMbs++
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__ConcealMb(var pMb : mbStorage?; var currImage : image_t?; row : uint; col : uint; sliceType : uint; var refData : uint8?) : uint {
    // Variables
    var i : uint
    var j : uint
    var hor : uint
    var ver : uint
    var mbNum : uint
    var width : uint
    var height : uint
    var mbPos : uint8?
    var data : uint8[384]
    var pData : uint8?
    var tmp : int
    var firstPhase : int[16]
    var pTmp : int?
    // neighbours above, below, left and right
    var a : int[4] = fixed_array(0, 0, 0, 0)
    var b : int[4]
    var l : int[4] = fixed_array(0, 0, 0, 0)
    var r : int[4]
    var A : uint
    var B : uint
    var L : uint
    var R : uint
    // Code
    width = currImage.width
    height = currImage.height
    mbNum = row * width + col
    h264bsdSetCurrImageMbPointers(currImage, mbNum)
    mbPos = currImage.data + row * 16u * width * 16u + col * 16u
    R = uint(HANTRO_FALSE)
    L = R
    B = L
    A = B
    // set qpY to 40 to enable some filtering in deblocking (stetson value)
    pMb.qpY = 40u
    pMb.disableDeblockingFilterIdc = 0u
    // mbType set to intra to perform filtering despite the values of other
    // boundary strength determination fields
    pMb.mbType = mbType_e.I_4x4
    pMb.filterOffsetA = 0
    pMb.filterOffsetB = 0
    pMb.chromaQpIndexOffset = 0
    if (IS_I_SLICE(sliceType)) {
        memset1(reinterpret<void?>(addr(data[0])), 0, uint64(typeinfo sizeof(type<uint8[384]>)))
    } else {
        var mv : mv_t = mv_t(hor = int16(0), ver = int16(0))
        var refImage : image_t
        refImage.width = width
        refImage.height = height
        refImage.data = refData
        if (refImage.data != null) {
            h264bsdPredictSamples(addr(data[0]), addr(mv), addr(refImage), col * 16u, row * 16u, 0u, 0u, 16u, 16u)
            h264bsdWriteMacroblock(currImage, addr(data[0]))
            return uint(HANTRO_OK)
        } else {
            memset1(reinterpret<void?>(addr(data[0])), 0, uint64(typeinfo sizeof(type<uint8[384]>)))
        }
    }
    memset1(reinterpret<void?>(addr(firstPhase[0])), 0, uint64(typeinfo sizeof(type<int[16]>)))
    // counter for number of neighbours used
    j = 0u
    ver = 0u
    hor = ver
    if (row != 0 && (pMb - width).decoded != 0) {
        A = uint(HANTRO_TRUE)
        pData = mbPos - width * 16u
        var _t0 = pData
        pData++
        a[0] = int(*_t0)
        var _t1 = pData
        pData++
        a[0] += int(*_t1)
        var _t2 = pData
        pData++
        a[0] += int(*_t2)
        var _t3 = pData
        pData++
        a[0] += int(*_t3)
        var _t4 = pData
        pData++
        a[1] = int(*_t4)
        var _t5 = pData
        pData++
        a[1] += int(*_t5)
        var _t6 = pData
        pData++
        a[1] += int(*_t6)
        var _t7 = pData
        pData++
        a[1] += int(*_t7)
        var _t8 = pData
        pData++
        a[2] = int(*_t8)
        var _t9 = pData
        pData++
        a[2] += int(*_t9)
        var _t10 = pData
        pData++
        a[2] += int(*_t10)
        var _t11 = pData
        pData++
        a[2] += int(*_t11)
        var _t12 = pData
        pData++
        a[3] = int(*_t12)
        var _t13 = pData
        pData++
        a[3] += int(*_t13)
        var _t14 = pData
        pData++
        a[3] += int(*_t14)
        var _t15 = pData
        pData++
        a[3] += int(*_t15)
        j++
        hor++
        firstPhase[0] += a[0] + a[1] + a[2] + a[3]
        firstPhase[1] += a[0] + a[1] - a[2] - a[3]
    }
    if ((row != height - 1u) && (pMb + width).decoded != 0) {
        B = uint(HANTRO_TRUE)
        pData = mbPos + 16u * width * 16u
        var _t16 = pData
        pData++
        b[0] = int(*_t16)
        var _t17 = pData
        pData++
        b[0] += int(*_t17)
        var _t18 = pData
        pData++
        b[0] += int(*_t18)
        var _t19 = pData
        pData++
        b[0] += int(*_t19)
        var _t20 = pData
        pData++
        b[1] = int(*_t20)
        var _t21 = pData
        pData++
        b[1] += int(*_t21)
        var _t22 = pData
        pData++
        b[1] += int(*_t22)
        var _t23 = pData
        pData++
        b[1] += int(*_t23)
        var _t24 = pData
        pData++
        b[2] = int(*_t24)
        var _t25 = pData
        pData++
        b[2] += int(*_t25)
        var _t26 = pData
        pData++
        b[2] += int(*_t26)
        var _t27 = pData
        pData++
        b[2] += int(*_t27)
        var _t28 = pData
        pData++
        b[3] = int(*_t28)
        var _t29 = pData
        pData++
        b[3] += int(*_t29)
        var _t30 = pData
        pData++
        b[3] += int(*_t30)
        var _t31 = pData
        pData++
        b[3] += int(*_t31)
        j++
        hor++
        firstPhase[0] += b[0] + b[1] + b[2] + b[3]
        firstPhase[1] += b[0] + b[1] - b[2] - b[3]
    }
    if (col != 0 && (pMb - 1).decoded != 0) {
        L = uint(HANTRO_TRUE)
        pData = mbPos - 1
        l[0] = int(pData[0])
        l[0] += int(pData[16u * width])
        l[0] += int(pData[32u * width])
        l[0] += int(pData[48u * width])
        pData += 64u * width
        l[1] = int(pData[0])
        l[1] += int(pData[16u * width])
        l[1] += int(pData[32u * width])
        l[1] += int(pData[48u * width])
        pData += 64u * width
        l[2] = int(pData[0])
        l[2] += int(pData[16u * width])
        l[2] += int(pData[32u * width])
        l[2] += int(pData[48u * width])
        pData += 64u * width
        l[3] = int(pData[0])
        l[3] += int(pData[16u * width])
        l[3] += int(pData[32u * width])
        l[3] += int(pData[48u * width])
        j++
        ver++
        firstPhase[0] += l[0] + l[1] + l[2] + l[3]
        firstPhase[4] += l[0] + l[1] - l[2] - l[3]
    }
    if ((col != width - 1u) && (pMb + 1).decoded != 0) {
        R = uint(HANTRO_TRUE)
        pData = mbPos + 16
        r[0] = int(pData[0])
        r[0] += int(pData[16u * width])
        r[0] += int(pData[32u * width])
        r[0] += int(pData[48u * width])
        pData += 64u * width
        r[1] = int(pData[0])
        r[1] += int(pData[16u * width])
        r[1] += int(pData[32u * width])
        r[1] += int(pData[48u * width])
        pData += 64u * width
        r[2] = int(pData[0])
        r[2] += int(pData[16u * width])
        r[2] += int(pData[32u * width])
        r[2] += int(pData[48u * width])
        pData += 64u * width
        r[3] = int(pData[0])
        r[3] += int(pData[16u * width])
        r[3] += int(pData[32u * width])
        r[3] += int(pData[48u * width])
        j++
        ver++
        firstPhase[0] += r[0] + r[1] + r[2] + r[3]
        firstPhase[4] += r[0] + r[1] - r[2] - r[3]
    }
    // at least one properly decoded neighbour available
    // lint -esym(644,l,r,a,b) variable initialized above
    if (hor == 0 && L != 0 && R != 0) {
        firstPhase[1] = (l[0] + l[1] + l[2] + l[3] - r[0] - r[1] - r[2] - r[3]) >> 5
    } elif (hor != 0) {
        firstPhase[1] >>= int(3u + hor)
    }
    if (ver == 0 && A != 0 && B != 0) {
        firstPhase[4] = (a[0] + a[1] + a[2] + a[3] - b[0] - b[1] - b[2] - b[3]) >> 5
    } elif (ver != 0) {
        firstPhase[4] >>= int(3u + ver)
    }
    c_switch(j) {
        case(1u) {
            firstPhase[0] >>= 4
            break
        }
        case(2u) {
            firstPhase[0] >>= 5
            break
        }
        case(3u) {
            // approximate (firstPhase[0]*4/3)>>6
            firstPhase[0] = (21 * firstPhase[0]) >> 10
            break
        }
        case(_) {
            // 4
            firstPhase[0] >>= 6
            break
        }
    }
    h264_file_all__Transform(addr(firstPhase[0]))
    i = 0u
    pData = addr(data[0])
    pTmp = addr(firstPhase[0])
    while (i < 256u) {
        tmp = pTmp[(i & 15u) >> 2u]
        // lint -e734 CLIP1 macro results in value that fits into 8 bits
        var _t32 = pData
        pData++
        *_t32 = uint8(CLIP1(tmp))
        // lint +e734
        i++
        if ((i & 63u) == 0) {
            pTmp += 4
        }
    }
