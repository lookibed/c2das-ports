        let e : int = int(*cr) - 128
        let r : uint = uint(CLIP1(298 * c + 409 * e + 128 >> 8))
        let g : uint = uint(CLIP1(298 * c - 100 * d - 208 * e + 128 >> 8))
        let b : uint = uint(CLIP1(298 * c + 516 * d + 128 >> 8))
        var pixel : uint = 255u
        pixel = (pixel << 8u) + r
        pixel = (pixel << 8u) + g
        pixel = (pixel << 8u) + b
        *bgra = pixel
        x++
        bgra++
