    mp4.read_size = file_size
    box_bytes = uint64(h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag)))
    h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag))
    payload_bytes = box_bytes - 8ul
    h264_file_all__my_fseek(addr(mp4), payload_bytes, addr(eof_flag))
    h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag))
    h264_file_all__minimp4_read(addr(mp4), 4, addr(eof_flag))
    return int(mp4.read_pos)
}

[c_function]
def c2da_probe_mp4d_open_read_pos(read_callback : function<(a0 : int64; var a1 : void?; a2 : uint64; var a3 : void?) : int>; var token : void?;
                                  file_size : int64) : int {
    var mp4 : MP4D_demux_tag
    if (MP4D_open(addr(mp4), read_callback, token, file_size) != 0) {
        MP4D_close(addr(mp4))
        return -1
    }
    return int(mp4.read_pos)
}

[c_function]
def c2da_probe_mp4d_open_track_count(read_callback : function<(a0 : int64; var a1 : void?; a2 : uint64; var a3 : void?) : int>; var token : void?;
                                     file_size : int64) : int {
    var mp4 : MP4D_demux_tag
    if (MP4D_open(addr(mp4), read_callback, token, file_size) == 0) {
        return -1
    }
    MP4D_close(addr(mp4))
    return int(mp4.track_count)
}

def private h264_file_all__rotl32(value : uint; shift : uint) : uint {
    return (value << shift) | (value >> (32u - shift))
}

[c_function]
