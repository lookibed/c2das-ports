[c_function]
def h264bsdConvertToYCbCrA(width : uint; height : uint; var data : uint8?; var pOutput : uint?) {
    let w : int = int(width)
    let h : int = int(height)
    var x : int = 0
    var y : int = 0
    let ySize : uint64 = uint64(w * h)
    let cbSize : uint64 = uint64(w / 2 * h / 2)
    var luma : uint8? = data
    var cb : uint8? = data + ySize
    var cr : uint8? = data + ySize + cbSize
    var yCbCr : uint? = pOutput
    while (y < h) {
        var pixel : uint = 255u
        pixel = (pixel << 8u) + uint(*cr)
        pixel = (pixel << 8u) + uint(*cb)
        pixel = (pixel << 8u) + uint(*luma)
        *yCbCr = pixel
        x++
        yCbCr++
        luma++
        if ((x & 1) == 0) {
            cb++
            cr++
        }
        if (x < w) {
            continue
        }
        x = 0
        y++
        if ((y & 1) != 0) {
            cb -= w / 2
            cr -= w / 2
        }
    }
}

[c_function]
def private h264_file_all__ComparePictures(var ptr1 : void?; var ptr2 : void?) : int {
    // Variables
    var pic1 : dpbPicture_t?
    var pic2 : dpbPicture_t?
    // Code
    pic1 = reinterpret<dpbPicture_t?>(ptr1)
    pic2 = reinterpret<dpbPicture_t?>(ptr2)
    // both are non-reference pictures, check if needed for display
    if (int(pic1.status) == 0 && int(pic2.status) == 0) {
        if (pic1.toBeDisplayed != 0 && pic2.toBeDisplayed == 0) {
            return -1
        } elif (pic1.toBeDisplayed == 0 && pic2.toBeDisplayed != 0) {
            return 1
        } else {
            return 0
        }
    } elif (int(pic2.status) == 0) {
        // only pic 1 needed for reference -> greater
        return -1
    } elif (int(pic1.status) == 0) {
        // only pic 2 needed for reference -> greater
        return 1
    } elif ((pic1.status == dpbPictureStatus_e.NON_EXISTING || pic1.status == dpbPictureStatus_e.SHORT_TERM) &&
            (pic2.status == dpbPictureStatus_e.NON_EXISTING || pic2.status == dpbPictureStatus_e.SHORT_TERM)) {
        // both are short term reference pictures -> check picNum
        if (pic1.picNum > pic2.picNum) {
            return -1
        } elif (pic1.picNum < pic2.picNum) {
            return 1
        } else {
            return 0
        }
    } elif (pic1.status == dpbPictureStatus_e.NON_EXISTING || pic1.status == dpbPictureStatus_e.SHORT_TERM) {
        // only pic 1 is short term -> greater
        return -1
    } elif (pic2.status == dpbPictureStatus_e.NON_EXISTING || pic2.status == dpbPictureStatus_e.SHORT_TERM) {
        // only pic 2 is short term -> greater
        return 1
    } else {
        // both are long term reference pictures -> check picNum (contains the
        // longTermPicNum
        if (pic1.picNum > pic2.picNum) {
            return 1
        } elif (pic1.picNum < pic2.picNum) {
            return -1
        } else {
            return 0
        }
    }
}

[c_function]
def h264bsdReorderRefPicList(var dpb : dpbStorage_t?; var order : refPicListReordering_t?; currFrameNum : uint; numRefIdxActive : uint) : uint {
    // Variables
    var i : uint
    var j : uint
    var k : uint
    var picNumPred : uint
    var refIdx : uint
    var picNum : int
    var picNumNoWrap : int
    var index : int
    var isShortTerm : uint
    // Code
    // set dpb picture numbers for sorting
    h264_file_all__SetPicNums(dpb, currFrameNum)
    if (order.refPicListReorderingFlagL0 == 0) {
        return uint(HANTRO_OK)
    }
    refIdx = 0u
    picNumPred = currFrameNum
    i = 0u
    while (order.command[i].reorderingOfPicNumsIdc < 3u) {
        // short term
        if (order.command[i].reorderingOfPicNumsIdc < 2u) {
            if (order.command[i].reorderingOfPicNumsIdc == 0u) {
                picNumNoWrap = int(picNumPred) - int(order.command[i].absDiffPicNum)
                if (picNumNoWrap < 0) {
                    picNumNoWrap += int(dpb.maxFrameNum)
                }
            } else {
                picNumNoWrap = int(picNumPred + order.command[i].absDiffPicNum)
                if (picNumNoWrap >= int(dpb.maxFrameNum)) {
                    picNumNoWrap -= int(dpb.maxFrameNum)
                }
            }
            picNumPred = uint(picNumNoWrap)
            picNum = picNumNoWrap
            if (uint(picNumNoWrap) > currFrameNum) {
                picNum -= int(dpb.maxFrameNum)
            }
            isShortTerm = uint(HANTRO_TRUE)
        } else {
            // long term
            picNum = int(order.command[i].longTermPicNum)
            isShortTerm = uint(HANTRO_FALSE)
        }
        // find corresponding picture from dpb
        index = h264_file_all__FindDpbPic(dpb, picNum, isShortTerm)
        if (index < 0 || !(uint(dpb.buffer[index].status) > uint(dpbPictureStatus_e.NON_EXISTING))) {
            return uint(HANTRO_NOK)
        }
        // shift pictures
        j = numRefIdxActive
        while (j > refIdx) {
            dpb.list[j] = dpb.list[j - 1u]
            j--
        }
        // put picture into the list
        let _t0 = refIdx
        refIdx++
        dpb.list[_t0] = addr(dpb.buffer[index])
        // remove later references to the same picture
        k = refIdx
        j = k
        while (j <= numRefIdxActive) {
            if (dpb.list[j] != addr(dpb.buffer[index])) {
                let _t1 = k
                k++
                dpb.list[_t1] = dpb.list[j]
            }
            j++
        }
        i++
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop1(var dpb : dpbStorage_t?; currPicNum : uint; differenceOfPicNums : uint) : uint {
    // Variables
    var index : int
    var picNum : int
    // Code
    picNum = int(currPicNum) - int(differenceOfPicNums)
    index = h264_file_all__FindDpbPic(dpb, picNum, uint(HANTRO_TRUE))
    if (index < 0) {
        return uint(HANTRO_NOK)
    }
    dpb.buffer[index].status = dpbPictureStatus_e.UNUSED
    dpb.numRefFrames--
    if (dpb.buffer[index].toBeDisplayed == 0) {
        dpb.fullness--
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop2(var dpb : dpbStorage_t?; longTermPicNum : uint) : uint {
    // Variables
    var index : int
    // Code
    index = h264_file_all__FindDpbPic(dpb, int(longTermPicNum), uint(HANTRO_FALSE))
    if (index < 0) {
        return uint(HANTRO_NOK)
    }
    dpb.buffer[index].status = dpbPictureStatus_e.UNUSED
    dpb.numRefFrames--
    if (dpb.buffer[index].toBeDisplayed == 0) {
        dpb.fullness--
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop3(var dpb : dpbStorage_t?; currPicNum : uint; differenceOfPicNums : uint; longTermFrameIdx : uint) : uint {
    // Variables
    var index : int
    var picNum : int
    var i : uint
    // Code
    if ((dpb.maxLongTermFrameIdx == uint(anon_105.NO_LONG_TERM_FRAME_INDICES)) || (longTermFrameIdx > dpb.maxLongTermFrameIdx)) {
        return uint(HANTRO_NOK)
    }
    // check if a long term picture with the same longTermFrameIdx already
    // exist and remove it if necessary
    i = 0u
    while (i < dpb.maxRefFrames) {
        if (dpb.buffer[i].status == dpbPictureStatus_e.LONG_TERM && uint(dpb.buffer[i].picNum) == longTermFrameIdx) {
            dpb.buffer[i].status = dpbPictureStatus_e.UNUSED
            dpb.numRefFrames--
            if (dpb.buffer[i].toBeDisplayed == 0) {
                dpb.fullness--
            }
            break
        }
        i++
    }
    picNum = int(currPicNum) - int(differenceOfPicNums)
    index = h264_file_all__FindDpbPic(dpb, picNum, uint(HANTRO_TRUE))
    if (index < 0) {
        return uint(HANTRO_NOK)
    }
    if (!(uint(dpb.buffer[index].status) > uint(dpbPictureStatus_e.NON_EXISTING))) {
        return uint(HANTRO_NOK)
    }
    dpb.buffer[index].status = dpbPictureStatus_e.LONG_TERM
    dpb.buffer[index].picNum = int(longTermFrameIdx)
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop4(var dpb : dpbStorage_t?; maxLongTermFrameIdx : uint) : uint {
    // Variables
    var i : uint
    // Code
    dpb.maxLongTermFrameIdx = maxLongTermFrameIdx
    i = 0u
    while (i < dpb.maxRefFrames) {
        if (dpb.buffer[i].status == dpbPictureStatus_e.LONG_TERM &&
                ((uint(dpb.buffer[i].picNum) > maxLongTermFrameIdx) || (dpb.maxLongTermFrameIdx == uint(anon_105.NO_LONG_TERM_FRAME_INDICES)))) {
            dpb.buffer[i].status = dpbPictureStatus_e.UNUSED
            dpb.numRefFrames--
            if (dpb.buffer[i].toBeDisplayed == 0) {
                dpb.fullness--
            }
        }
        i++
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop5(var dpb : dpbStorage_t?) : uint {
    // Variables
    // Code
    for (i in urange(16u)) {
        if (int(dpb.buffer[i].status) != 0) {
            dpb.buffer[i].status = dpbPictureStatus_e.UNUSED
            if (dpb.buffer[i].toBeDisplayed == 0) {
                dpb.fullness--
            }
        }
    }
    // output all pictures
    while (h264_file_all__OutputPicture(dpb) == uint(HANTRO_OK)) {
    }
    dpb.numRefFrames = 0u
    dpb.maxLongTermFrameIdx = uint(anon_105.NO_LONG_TERM_FRAME_INDICES)
    dpb.prevRefFrameNum = 0u
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__Mmcop6(var dpb : dpbStorage_t?; frameNum : uint; picOrderCnt : int; longTermFrameIdx : uint) : uint {
    // Variables
    var i : uint
    // Code
    if ((dpb.maxLongTermFrameIdx == uint(anon_105.NO_LONG_TERM_FRAME_INDICES)) || (longTermFrameIdx > dpb.maxLongTermFrameIdx)) {
        return uint(HANTRO_NOK)
    }
    // check if a long term picture with the same longTermFrameIdx already
    // exist and remove it if necessary
    i = 0u
    while (i < dpb.maxRefFrames) {
        if (dpb.buffer[i].status == dpbPictureStatus_e.LONG_TERM && uint(dpb.buffer[i].picNum) == longTermFrameIdx) {
            dpb.buffer[i].status = dpbPictureStatus_e.UNUSED
            dpb.numRefFrames--
            if (dpb.buffer[i].toBeDisplayed == 0) {
                dpb.fullness--
            }
            break
        }
        i++
    }
    if (dpb.numRefFrames < dpb.maxRefFrames) {
        dpb.currentOut.frameNum = frameNum
        dpb.currentOut.picNum = int(longTermFrameIdx)
        dpb.currentOut.picOrderCnt = picOrderCnt
        dpb.currentOut.status = dpbPictureStatus_e.LONG_TERM
        if (dpb.noReordering != 0) {
            dpb.currentOut.toBeDisplayed = uint(HANTRO_FALSE)
        } else {
            dpb.currentOut.toBeDisplayed = uint(HANTRO_TRUE)
        }
        dpb.numRefFrames++
        dpb.fullness++
        return uint(HANTRO_OK)
    } else {
        // if there is no room, return an error
        return uint(HANTRO_NOK)
    }
}

[c_function]
def h264bsdMarkDecRefPic(var dpb : dpbStorage_t?; var mark : decRefPicMarking_t?; var image : image_t?; var frameNum : uint; picOrderCnt : int; isIdr : uint;
                         currentPicId : uint; numErrMbs : uint) : uint {
    // Variables
    var i : uint
    var status : uint
    var markedAsLongTerm : uint
    var toBeDisplayed : uint
    // Code
    if (image.data != dpb.currentOut.data) {
        return uint(HANTRO_NOK)
    }
    dpb.lastContainsMmco5 = uint(HANTRO_FALSE)
    status = uint(HANTRO_OK)
    toBeDisplayed = uint(dpb.noReordering != 0 ? HANTRO_FALSE : HANTRO_TRUE)
    // non-reference picture, stored for display reordering purposes
    if (mark == null) {
        dpb.currentOut.status = dpbPictureStatus_e.UNUSED
        dpb.currentOut.frameNum = frameNum
        dpb.currentOut.picNum = int(frameNum)
        dpb.currentOut.picOrderCnt = picOrderCnt
        dpb.currentOut.toBeDisplayed = toBeDisplayed
        if (dpb.noReordering == 0) {
            dpb.fullness++
        }
    } elif (isIdr != 0) {
        // IDR picture
        // h264bsdCheckGapsInFrameNum not called for IDR pictures -> have to
        // reset numOut and outIndex here
        dpb.outIndex = 0u
        dpb.numOut = dpb.outIndex
        // flush the buffer
        h264_file_all__Mmcop5(dpb)
        // if noOutputOfPriorPicsFlag was set -> the pictures preceding the
        // IDR picture shall not be output -> set output buffer empty
        if (mark.noOutputOfPriorPicsFlag != 0 || dpb.noReordering != 0) {
            dpb.numOut = 0u
            dpb.outIndex = 0u
        }
        if (mark.longTermReferenceFlag != 0) {
            dpb.currentOut.status = dpbPictureStatus_e.LONG_TERM
            dpb.maxLongTermFrameIdx = 0u
        } else {
            dpb.currentOut.status = dpbPictureStatus_e.SHORT_TERM
            dpb.maxLongTermFrameIdx = uint(anon_105.NO_LONG_TERM_FRAME_INDICES)
        }
        dpb.currentOut.frameNum = 0u
        dpb.currentOut.picNum = 0
        dpb.currentOut.picOrderCnt = 0
        dpb.currentOut.toBeDisplayed = toBeDisplayed
        dpb.fullness = 1u
        dpb.numRefFrames = 1u
    } else {
        // reference picture
        markedAsLongTerm = uint(HANTRO_FALSE)
        if (mark.adaptiveRefPicMarkingModeFlag != 0) {
            i = 0u
            while (mark.operation[i].memoryManagementControlOperation != 0) {
                c_switch(mark.operation[i].memoryManagementControlOperation) {
                    case(1u) {
                        status = h264_file_all__Mmcop1(dpb, frameNum, mark.operation[i].differenceOfPicNums)
                        break
                    }
                    case(2u) {
                        status = h264_file_all__Mmcop2(dpb, mark.operation[i].longTermPicNum)
                        break
                    }
                    case(3u) {
                        status = h264_file_all__Mmcop3(dpb, frameNum, mark.operation[i].differenceOfPicNums, mark.operation[i].longTermFrameIdx)
                        break
                    }
                    case(4u) {
                        status = h264_file_all__Mmcop4(dpb, mark.operation[i].maxLongTermFrameIdx)
                        break
                    }
                    case(5u) {
                        status = h264_file_all__Mmcop5(dpb)
                        dpb.lastContainsMmco5 = uint(HANTRO_TRUE)
                        frameNum = 0u
                        break
                    }
                    case(6u) {
                        status = h264_file_all__Mmcop6(dpb, frameNum, picOrderCnt, mark.operation[i].longTermFrameIdx)
                        if (status == uint(HANTRO_OK)) {
                            markedAsLongTerm = uint(HANTRO_TRUE)
                        }
                        break
                    }
                    case(_) {
                        // invalid memory management control operation
                        status = uint(HANTRO_NOK)
                        break
                    }
                }
                if (status != uint(HANTRO_OK)) {
                    break
                }
                i++
            }
        } else {
            status = h264_file_all__SlidingWindowRefPicMarking(dpb)
        }
        // if current picture was not marked as long-term reference by
        // memory management control operation 6 -> mark current as short
        // term and insert it into dpb (if there is room)
        if (markedAsLongTerm == 0) {
            if (dpb.numRefFrames < dpb.maxRefFrames) {
                dpb.currentOut.frameNum = frameNum
                dpb.currentOut.picNum = int(frameNum)
                dpb.currentOut.picOrderCnt = picOrderCnt
                dpb.currentOut.status = dpbPictureStatus_e.SHORT_TERM
                dpb.currentOut.toBeDisplayed = toBeDisplayed
                dpb.fullness++
                dpb.numRefFrames++
            } else {
                // no room
                status = uint(HANTRO_NOK)
            }
        }
    }
    dpb.currentOut.isIdr = isIdr
    dpb.currentOut.picId = currentPicId
    dpb.currentOut.numErrMbs = numErrMbs
    // dpb was initialized to not to reorder the pictures -> output current
    // picture immediately
    if (dpb.noReordering != 0) {
        dpb.outBuf[dpb.numOut].data = dpb.currentOut.data
        dpb.outBuf[dpb.numOut].isIdr = dpb.currentOut.isIdr
        dpb.outBuf[dpb.numOut].picId = dpb.currentOut.picId
        dpb.outBuf[dpb.numOut].numErrMbs = dpb.currentOut.numErrMbs
        dpb.numOut++
    } else {
        // output pictures if buffer full
        while (dpb.fullness > dpb.dpbSize) {
            i = h264_file_all__OutputPicture(dpb)
        }
    }
    // sort dpb
    h264_file_all__ShellSort(dpb.buffer, dpb.dpbSize + 1u)
    return status
}

[c_function]
def h264bsdGetRefPicData(var dpb : dpbStorage_t?; index : uint) : uint8? {
    // Variables
    // Code
    if (index > 16u || dpb.list[index] == null) {
        return null
    } elif (!(uint(dpb.list[index].status) > uint(dpbPictureStatus_e.NON_EXISTING))) {
        return null
    } else {
        return dpb.list[index].data
    }
}

[c_function]
def h264bsdAllocateDpbImage(var dpb : dpbStorage_t?) : uint8? {
    // Variables
    // Code
    dpb.currentOut = dpb.buffer + dpb.dpbSize
    return dpb.currentOut.data
}

[c_function]
def private h264_file_all__SlidingWindowRefPicMarking(var dpb : dpbStorage_t?) : uint {
    // Variables
    var index : int
    var picNum : int
    // Code
    if (dpb.numRefFrames < dpb.maxRefFrames) {
        return uint(HANTRO_OK)
    } else {
        index = -1
        picNum = 0
        // find the oldest short term picture
        for (i in urange(dpb.numRefFrames)) {
            if (dpb.buffer[i].status == dpbPictureStatus_e.NON_EXISTING || dpb.buffer[i].status == dpbPictureStatus_e.SHORT_TERM) {
                if (dpb.buffer[i].picNum < picNum || index == -1) {
                    index = int(i)
                    picNum = dpb.buffer[i].picNum
                }
            }
        }
        if (index >= 0) {
            dpb.buffer[index].status = dpbPictureStatus_e.UNUSED
            dpb.numRefFrames--
            if (dpb.buffer[index].toBeDisplayed == 0) {
                dpb.fullness--
            }
            return uint(HANTRO_OK)
        }
    }
    return uint(HANTRO_NOK)
}

[c_function]
def h264bsdInitDpb(var dpb : dpbStorage_t?; picSizeInMbs : uint; dpbSize : uint; maxRefFrames : uint; maxFrameNum : uint; noReordering : uint) : uint {
    // Variables
    var i : uint
    // Code
    dpb.maxLongTermFrameIdx = uint(anon_105.NO_LONG_TERM_FRAME_INDICES)
    dpb.maxRefFrames = MAX(maxRefFrames, 1)
    if (noReordering != 0) {
        dpb.dpbSize = dpb.maxRefFrames
    } else {
        dpb.dpbSize = dpbSize
    }
    dpb.maxFrameNum = maxFrameNum
    dpb.noReordering = noReordering
    dpb.fullness = 0u
    dpb.numRefFrames = 0u
    dpb.prevRefFrameNum = 0u
    dpb.buffer = reinterpret<dpbPicture_t?>(malloc1(uint64(MAX_NUM_REF_IDX_L0_ACTIVE + 1) * uint64(typeinfo sizeof(type<dpbPicture_t>))))
    if (dpb.buffer == null) {
        return uint(MEMORY_ALLOCATION_ERROR)
    }
    memset1(reinterpret<void?>(dpb.buffer), 0, uint64(MAX_NUM_REF_IDX_L0_ACTIVE + 1) * uint64(typeinfo sizeof(type<dpbPicture_t>)))
    i = 0u
    while (i < dpb.dpbSize + 1u) {
        // Allocate needed amount of memory, which is:
        // image size + 32 + 15, where 32 cames from the fact that in ARM OpenMax
        // DL implementation Functions may read beyond the end of an array,
        // by a maximum of 32 bytes. And +15 cames for the need to align memory
        // to 16-byte boundary
        dpb.buffer[i].pAllocatedData = reinterpret<uint8?>(malloc1(uint64(picSizeInMbs * 384u + 32u + 15u) * uint64(typeinfo sizeof(type<uint8>))))
        if (dpb.buffer[i].pAllocatedData == null) {
            return uint(MEMORY_ALLOCATION_ERROR)
        }
        dpb.buffer[i].data = dpb.buffer[i].pAllocatedData + (16ul - uint64(intptr(dpb.buffer[i].pAllocatedData)) &
                uint64(16 - 1)) / uint64(typeinfo sizeof(type<uint8>))
        i++
    }
    dpb.list = reinterpret<dpbPicture_t ??>(malloc1(uint64(MAX_NUM_REF_IDX_L0_ACTIVE + 1) * uint64(typeinfo sizeof(type<dpbPicture_t?>))))
    dpb.outBuf = reinterpret<dpbOutPicture_t?>(malloc1(uint64(dpb.dpbSize + 1u) * uint64(typeinfo sizeof(type<dpbOutPicture_t>))))
    if (dpb.list == null || dpb.outBuf == null) {
        return uint(MEMORY_ALLOCATION_ERROR)
    }
    memset1(reinterpret<void?>(dpb.list), 0, uint64(MAX_NUM_REF_IDX_L0_ACTIVE + 1) * uint64(typeinfo sizeof(type<dpbPicture_t?>)))
    dpb.outIndex = 0u
    dpb.numOut = dpb.outIndex
    return uint(HANTRO_OK)
}

def h264bsdResetDpb(var dpb : dpbStorage_t?; picSizeInMbs : uint; dpbSize : uint; maxRefFrames : uint; maxFrameNum : uint; noReordering : uint) : uint {
    // Code
    h264bsdFreeDpb(dpb)
    return h264bsdInitDpb(dpb, picSizeInMbs, dpbSize, maxRefFrames, maxFrameNum, noReordering)
}

[c_function]
def h264bsdInitRefPicList(var dpb : dpbStorage_t?) {
    // Variables
    var i : uint
    // Code
    i = 0u
    while (i < dpb.numRefFrames) {
        dpb.list[i] = addr(dpb.buffer[i])
        i++
    }
}

[c_function]
def private h264_file_all__FindDpbPic(var dpb : dpbStorage_t?; picNum : int; isShortTerm : uint) : int {
    // Variables
    var i : uint = 0u
    var found : uint = uint(HANTRO_FALSE)
    // Code
    if (isShortTerm != 0) {
        while (i < dpb.maxRefFrames && found == 0) {
            if ((dpb.buffer[i].status == dpbPictureStatus_e.NON_EXISTING || dpb.buffer[i].status == dpbPictureStatus_e.SHORT_TERM) &&
                    dpb.buffer[i].picNum == picNum) {
                found = uint(HANTRO_TRUE)
            } else {
                i++
            }
        }
    } else {
        while (i < dpb.maxRefFrames && found == 0) {
            if (dpb.buffer[i].status == dpbPictureStatus_e.LONG_TERM && dpb.buffer[i].picNum == picNum) {
                found = uint(HANTRO_TRUE)
            } else {
                i++
            }
        }
    }
    if (found != 0) {
        return int(i)
    } else {
        return -1
    }
}

[c_function]
def private h264_file_all__SetPicNums(var dpb : dpbStorage_t?; currFrameNum : uint) {
    // Variables
    var i : uint
    var frameNumWrap : int
    // Code
    i = 0u
    while (i < dpb.numRefFrames) {
        if (dpb.buffer[i].status == dpbPictureStatus_e.NON_EXISTING || dpb.buffer[i].status == dpbPictureStatus_e.SHORT_TERM) {
            if (dpb.buffer[i].frameNum > currFrameNum) {
                frameNumWrap = int(dpb.buffer[i].frameNum) - int(dpb.maxFrameNum)
            } else {
                frameNumWrap = int(dpb.buffer[i].frameNum)
            }
            dpb.buffer[i].picNum = frameNumWrap
        }
        i++
    }
}

[c_function]
def h264bsdCheckGapsInFrameNum(var dpb : dpbStorage_t?; frameNum : uint; isRefPic : uint; gapsAllowed : uint) : uint {
    // Variables
    var unUsedShortTermFrameNum : uint
    var tmp : uint8?
    // Code
    dpb.numOut = 0u
    dpb.outIndex = 0u
    if (gapsAllowed == 0) {
        return uint(HANTRO_OK)
    }
    if ((frameNum != dpb.prevRefFrameNum) && (frameNum != ((dpb.prevRefFrameNum + 1u) % dpb.maxFrameNum))) {
        unUsedShortTermFrameNum = (dpb.prevRefFrameNum + 1u) % dpb.maxFrameNum
        // store data pointer of last buffer position to be used as next
        // "allocated" data pointer if last buffer position after this process
        // contains data pointer located in outBuf (buffer placed in the output
        // shall not be overwritten by the current picture)
        tmp = dpb.buffer[dpb.dpbSize].data
        c_do_while(unUsedShortTermFrameNum != frameNum) {
            h264_file_all__SetPicNums(dpb, unUsedShortTermFrameNum)
            if (h264_file_all__SlidingWindowRefPicMarking(dpb) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
            // output pictures if buffer full
            while (dpb.fullness >= dpb.dpbSize) {
                h264_file_all__OutputPicture(dpb)
            }
            // add to end of list
            dpb.buffer[dpb.dpbSize].status = dpbPictureStatus_e.NON_EXISTING
            dpb.buffer[dpb.dpbSize].frameNum = unUsedShortTermFrameNum
            dpb.buffer[dpb.dpbSize].picNum = int(unUsedShortTermFrameNum)
            dpb.buffer[dpb.dpbSize].picOrderCnt = 0
            dpb.buffer[dpb.dpbSize].toBeDisplayed = uint(HANTRO_FALSE)
            dpb.fullness++
            dpb.numRefFrames++
            // sort the buffer
            h264_file_all__ShellSort(dpb.buffer, dpb.dpbSize + 1u)
            unUsedShortTermFrameNum = (unUsedShortTermFrameNum + 1u) % dpb.maxFrameNum
        }
        // pictures placed in output buffer -> check that 'data' in
        // buffer position dpbSize is not in the output buffer (this will be
        // "allocated" by h264bsdAllocateDpbImage). If it is -> exchange data
        // pointer with the one stored in the beginning
        if (dpb.numOut != 0) {
            var i : uint
            i = 0u
            while (i < dpb.numOut) {
                if (dpb.outBuf[i].data == dpb.buffer[dpb.dpbSize].data) {
                    // find buffer position containing data pointer stored in
                    // tmp
                    i = 0u
                    while (i < dpb.dpbSize) {
                        if (dpb.buffer[i].data == tmp) {
                            dpb.buffer[i].data = dpb.buffer[dpb.dpbSize].data
                            dpb.buffer[dpb.dpbSize].data = tmp
                            break
                        }
                        i++
                    }
                    break
                }
                i++
            }
        }
    } elif (isRefPic != 0 && frameNum == dpb.prevRefFrameNum) {
        // frameNum for reference pictures shall not be the same as for previous
        // reference picture, otherwise accesses to pictures in the buffer cannot
        // be solved unambiguously
        return uint(HANTRO_NOK)
    }
    // save current frame_num in prevRefFrameNum. For non-reference frame
    // prevFrameNum is set to frame number of last non-existing frame above
    if (isRefPic != 0) {
        dpb.prevRefFrameNum = frameNum
    } elif (frameNum != dpb.prevRefFrameNum) {
        dpb.prevRefFrameNum = (frameNum + dpb.maxFrameNum - 1u) % dpb.maxFrameNum
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__FindSmallestPicOrderCnt(var dpb : dpbStorage_t?) : dpbPicture_t? {
    // Variables
    var i : uint
    var picOrderCnt : int
    var tmp : dpbPicture_t?
    // Code
    picOrderCnt = 2147483647
    tmp = null
    i = 0u
    while (i <= dpb.dpbSize) {
        if (dpb.buffer[i].toBeDisplayed != 0 && (dpb.buffer[i].picOrderCnt < picOrderCnt)) {
            tmp = dpb.buffer + i
            picOrderCnt = dpb.buffer[i].picOrderCnt
        }
        i++
    }
    return tmp
}

[c_function]
def private h264_file_all__OutputPicture(var dpb : dpbStorage_t?) : uint {
    // Variables
    var tmp : dpbPicture_t?
    // Code
    if (dpb.noReordering != 0) {
        return uint(HANTRO_NOK)
    }
    tmp = h264_file_all__FindSmallestPicOrderCnt(dpb)
    // no pictures to be displayed
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    dpb.outBuf[dpb.numOut].data = tmp.data
    dpb.outBuf[dpb.numOut].isIdr = tmp.isIdr
    dpb.outBuf[dpb.numOut].picId = tmp.picId
    dpb.outBuf[dpb.numOut].numErrMbs = tmp.numErrMbs
    dpb.numOut++
    tmp.toBeDisplayed = uint(HANTRO_FALSE)
    if (int(tmp.status) == 0) {
        dpb.fullness--
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdDpbOutputPicture(var dpb : dpbStorage_t?) : dpbOutPicture_t? {
    // Variables
    // Code
    if (dpb.outIndex < dpb.numOut) {
        let _t0 = dpb.outIndex
        dpb.outIndex++
        return dpb.outBuf + _t0
    } else {
        return null
    }
}

def h264bsdFlushDpb(var dpb : dpbStorage_t?) {
    // don't do anything if buffer not reserved
    if (dpb.buffer != null) {
        dpb.flushed = 1u
        // output all pictures
        while (h264_file_all__OutputPicture(dpb) == uint(HANTRO_OK)) {
        }
    }
}

[c_function]
def h264bsdFreeDpb(var dpb : dpbStorage_t?) {
    // Variables
    var i : uint
    // Code
    if (dpb.buffer != null) {
        i = 0u
        while (i < dpb.dpbSize + 1u) {
            free1(reinterpret<void?>(dpb.buffer[i].pAllocatedData))
            dpb.buffer[i].pAllocatedData = null
            i++
        }
    }
    free1(reinterpret<void?>(dpb.buffer))
    dpb.buffer = null
    free1(reinterpret<void?>(dpb.list))
    dpb.list = null
    free1(reinterpret<void?>(dpb.outBuf))
    dpb.outBuf = null
}

[c_function]
def private h264_file_all__ShellSort(var pPic : dpbPicture_t?; num : uint) {
    var j : uint
    var step : uint
    var tmpPic : dpbPicture_t
    step = 7u
    while (step != 0) {
        for (i in urange(step, num)) {
            tmpPic = pPic[i]
            j = i
            while (j >= step && h264_file_all__ComparePictures(reinterpret<void?>(pPic + j + -int64(step)), reinterpret<void?>(addr(tmpPic))) > 0) {
                pPic[j] = pPic[j - step]
                j -= step
            }
            pPic[j] = tmpPic
        }
        step >>= 1u
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdWriteMacroblock
// Functional description:
// Write one macroblock into the image. Both luma and chroma
// components will be written at the same time.
// Inputs:
// data pointer to macroblock data to be written, 256 values for
// luma followed by 64 values for both chroma components
// Outputs:
// image pointer to the image where the macroblock will be written
// Returns:
// none
// ------------------------------------------------------------------------------
[c_function]
def h264bsdWriteMacroblock(var image : image_t?; var data : uint8?) {
    // Variables
    var i : uint
    var width : uint
    var lum : uint?
    var cb : uint?
    var cr : uint?
    var ptr : uint?
    var tmp1 : uint
    var tmp2 : uint
    // Code
    width = image.width
    // lint -save -e826 lum, cb and cr used to copy 4 bytes at the time, disable
    // "area too small" info message
    lum = reinterpret<uint?>(image.luma)
    cb = reinterpret<uint?>(image.cb)
    cr = reinterpret<uint?>(image.cr)
    ptr = reinterpret<uint?>(data)
    width *= 4u
    i = 16u
    while (i != 0) {
        var _t0 = ptr
        ptr++
        tmp1 = *_t0
        var _t1 = ptr
        ptr++
        tmp2 = *_t1
        var _t2 = lum
        lum++
        *_t2 = tmp1
        var _t3 = lum
        lum++
        *_t3 = tmp2
        var _t4 = ptr
        ptr++
        tmp1 = *_t4
        var _t5 = ptr
        ptr++
        tmp2 = *_t5
        var _t6 = lum
        lum++
        *_t6 = tmp1
        var _t7 = lum
        lum++
        *_t7 = tmp2
        lum += width - 4u
        i--
    }
    width >>= 1u
    i = 8u
    while (i != 0) {
        var _t8 = ptr
        ptr++
        tmp1 = *_t8
        var _t9 = ptr
        ptr++
        tmp2 = *_t9
        var _t10 = cb
        cb++
        *_t10 = tmp1
        var _t11 = cb
        cb++
        *_t11 = tmp2
        cb += width - 2u
        i--
    }
    i = 8u
    while (i != 0) {
        var _t12 = ptr
        ptr++
        tmp1 = *_t12
        var _t13 = ptr
        ptr++
        tmp2 = *_t13
        var _t14 = cr
        cr++
        *_t14 = tmp1
        var _t15 = cr
        cr++
        *_t15 = tmp2
        cr += width - 2u
        i--
    }
}

[c_function]
def h264bsdWriteOutputBlocks(var image : image_t?; mbNum : uint; var data : uint8?; var residual : int[16]?) {
    // Variables
    var i : uint
    var picWidth : uint
    var picSize : uint
    var lum : uint8?
    var cb : uint8?
    var cr : uint8?
    var imageBlock : uint8?
    var tmp : uint8?
    var row : uint
    var col : uint
    var x : uint
    var y : uint
    var pRes : int?
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    // Image size in macroblocks
    picWidth = image.width
    picSize = picWidth * image.height
    row = mbNum / picWidth
    col = mbNum % picWidth
    // Output macroblock position in output picture
    lum = image.data + row * picWidth * 256u + col * 16u
    cb = image.data + picSize * 256u + row * picWidth * 64u + col * 8u
    cr = cb + picSize * 64u
    picWidth *= 16u
    for (_c_block in urange(16u)) {
        x = h264bsdBlockX[_c_block]
        y = h264bsdBlockY[_c_block]
        pRes = addr(residual[_c_block][0])
        tmp = data + y * 16u + x
        imageBlock = lum + y * picWidth + x
        if (IS_RESIDUAL_EMPTY(pRes)) {
            // lint -e826
            var in32 : int? = reinterpret<int?>(tmp)
            var out32 : int? = reinterpret<int?>(imageBlock)
            // Residual is zero => copy prediction block to output
            tmp1 = *in32
            in32 += 4
            tmp2 = *in32
            in32 += 4
            *out32 = tmp1
            out32 += picWidth / 4u
            *out32 = tmp2
            out32 += picWidth / 4u
            tmp1 = *in32
            in32 += 4
            tmp2 = *in32
            *out32 = tmp1
            out32 += picWidth / 4u
            *out32 = tmp2
        } else {
            // Calculate image = prediction + residual
            // Process four pixels in a loop
            i = 4u
            while (i != 0) {
                tmp1 = int(tmp[0])
                var _t0 = pRes
                pRes++
                tmp2 = *_t0
                tmp3 = int(tmp[1])
                tmp1 = int(clp[tmp1 + tmp2])
                var _t1 = pRes
                pRes++
                tmp4 = *_t1
                imageBlock[0] = uint8(tmp1)
                tmp3 = int(clp[tmp3 + tmp4])
                tmp1 = int(tmp[2])
                var _t2 = pRes
                pRes++
                tmp2 = *_t2
                imageBlock[1] = uint8(tmp3)
                tmp1 = int(clp[tmp1 + tmp2])
                tmp3 = int(tmp[3])
                var _t3 = pRes
                pRes++
                tmp4 = *_t3
                imageBlock[2] = uint8(tmp1)
                tmp3 = int(clp[tmp3 + tmp4])
                tmp += 16
                imageBlock[3] = uint8(tmp3)
                imageBlock += picWidth
                i--
            }
        }
    }
    picWidth /= 2u
    for (_c_block in urange(16u, 24u)) {
        x = h264bsdBlockX[_c_block & 3u]
        y = h264bsdBlockY[_c_block & 3u]
        pRes = addr(residual[_c_block][0])
        tmp = data + 256
        imageBlock = cb
        if (_c_block >= 20u) {
            imageBlock = cr
            tmp += 64
        }
        tmp += y * 8u + x
        imageBlock += y * picWidth + x
        if (IS_RESIDUAL_EMPTY(pRes)) {
            // lint -e826
            var in32 : int? = reinterpret<int?>(tmp)
            var out32 : int? = reinterpret<int?>(imageBlock)
            // Residual is zero => copy prediction block to output
            tmp1 = *in32
            in32 += 2
            tmp2 = *in32
            in32 += 2
            *out32 = tmp1
            out32 += picWidth / 4u
            *out32 = tmp2
            out32 += picWidth / 4u
            tmp1 = *in32
            in32 += 2
            tmp2 = *in32
            *out32 = tmp1
            out32 += picWidth / 4u
            *out32 = tmp2
        } else {
            i = 4u
            while (i != 0) {
                tmp1 = int(tmp[0])
                var _t4 = pRes
                pRes++
                tmp2 = *_t4
                tmp3 = int(tmp[1])
                tmp1 = int(clp[tmp1 + tmp2])
                var _t5 = pRes
                pRes++
                tmp4 = *_t5
                imageBlock[0] = uint8(tmp1)
                tmp3 = int(clp[tmp3 + tmp4])
                tmp1 = int(tmp[2])
                var _t6 = pRes
                pRes++
                tmp2 = *_t6
                imageBlock[1] = uint8(tmp3)
                tmp1 = int(clp[tmp1 + tmp2])
                tmp3 = int(tmp[3])
                var _t7 = pRes
                pRes++
                tmp4 = *_t7
                imageBlock[2] = uint8(tmp1)
                tmp3 = int(clp[tmp3 + tmp4])
                tmp += 8
                imageBlock[3] = uint8(tmp3)
                imageBlock += picWidth
                i--
            }
        }
    }
}

// ------------------------------------------------------------------------------
// Function: h264bsdInterPrediction
// Functional description:
// Processes one inter macroblock. Performs motion vector prediction
// and reconstructs prediction macroblock. Writes the final macroblock
// (prediction + residual) into the output image (currImage)
// Inputs:
// pMb pointer to macroblock specific information
// pMbLayer pointer to current macroblock data from stream
// dpb pointer to decoded picture buffer
// mbNum current macroblock number
// currImage pointer to output image
// data pointer where predicted macroblock will be stored
// Outputs:
// pMb structure is updated with current macroblock
// currImage current macroblock is written into image
// data prediction is stored here
// Returns:
// HANTRO_OK success
// HANTRO_NOK error in motion vector prediction
// ------------------------------------------------------------------------------
[c_function]
def h264bsdInterPrediction(var pMb : mbStorage?; var pMbLayer : macroblockLayer_t?; var dpb : dpbStorage_t?; mbNum : uint; var currImage : image_t?;
                           var data : uint8?) : uint {
    // Variables
    var i : uint
    var x : uint
    var y : uint
    var row : uint
    var col : uint
    var subPartMode : subMbPartMode_e
    var refImage : image_t
    // Code
    row = mbNum / currImage.width
    col = mbNum - row * currImage.width
    row *= 16u
    col *= 16u
    refImage.width = currImage.width
    refImage.height = currImage.height
    c_switch(pMb.mbType) {
        case(mbType_e.P_Skip, mbType_e.P_L0_16x16) {
            if (h264_file_all__MvPrediction16x16(pMb, addr(pMbLayer.mbPred), dpb) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
            refImage.data = pMb.refAddr[0]
            h264bsdPredictSamples(data, addr(pMb.mv[0]), addr(refImage), col, row, 0u, 0u, 16u, 16u)
            break
        }
        case(mbType_e.P_L0_L0_16x8) {
            if (h264_file_all__MvPrediction16x8(pMb, addr(pMbLayer.mbPred), dpb) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
            refImage.data = pMb.refAddr[0]
            h264bsdPredictSamples(data, addr(pMb.mv[0]), addr(refImage), col, row, 0u, 0u, 16u, 8u)
            refImage.data = pMb.refAddr[2]
            h264bsdPredictSamples(data, addr(pMb.mv[0]) + 8, addr(refImage), col, row, 0u, 8u, 16u, 8u)
            break
        }
        case(mbType_e.P_L0_L0_8x16) {
            if (h264_file_all__MvPrediction8x16(pMb, addr(pMbLayer.mbPred), dpb) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
            refImage.data = pMb.refAddr[0]
            h264bsdPredictSamples(data, addr(pMb.mv[0]), addr(refImage), col, row, 0u, 0u, 8u, 16u)
            refImage.data = pMb.refAddr[1]
            h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4, addr(refImage), col, row, 8u, 0u, 8u, 16u)
            break
        }
        case(_) {
            // P_8x8 and P_8x8ref0
            if (h264_file_all__MvPrediction8x8(pMb, addr(pMbLayer.subMbPred), dpb) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
            i = 0u
            while (i < 4u) {
                refImage.data = pMb.refAddr[i]
                subPartMode = h264bsdSubMbPartMode(pMbLayer.subMbPred.subMbType[i])
                x = uint((i & 1u) != 0 ? 8 : 0)
                y = uint(i < 2u ? 0 : 8)
                c_switch(subPartMode) {
                    case(subMbPartMode_e.MB_SP_8x8) {
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i, addr(refImage), col, row, x, y, 8u, 8u)
                        break
                    }
                    case(subMbPartMode_e.MB_SP_8x4) {
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i, addr(refImage), col, row, x, y, 8u, 4u)
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i + 2, addr(refImage), col, row, x, y + 4u, 8u, 4u)
                        break
                    }
                    case(subMbPartMode_e.MB_SP_4x8) {
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i, addr(refImage), col, row, x, y, 4u, 8u)
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i + 1, addr(refImage), col, row, x + 4u, y, 4u, 8u)
                        break
                    }
                    case(_) {
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i, addr(refImage), col, row, x, y, 4u, 4u)
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i + 1, addr(refImage), col, row, x + 4u, y, 4u, 4u)
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i + 2, addr(refImage), col, row, x, y + 4u, 4u, 4u)
                        h264bsdPredictSamples(data, addr(pMb.mv[0]) + 4u * i + 3, addr(refImage), col, row, x + 4u, y + 4u, 4u, 4u)
                        break
                    }
                }
                i++
            }
            break
        }
    }
    // if decoded flag > 1 -> mb has already been successfully decoded and
    // written to output -> do not write again
    if (pMb.decoded > 1u) {
        return uint(HANTRO_OK)
    }
    if (pMb.mbType != mbType_e.P_Skip) {
        h264bsdWriteOutputBlocks(currImage, mbNum, data, addr(pMbLayer.residual.level[0]))
    } else {
        h264bsdWriteMacroblock(currImage, data)
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction16x16(var pMb : mbStorage?; var mbPred : mbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    // A, B, C
    var a : interNeighbour_t[3]
    var refIndex : uint
    var tmp : uint8?
    var tmpMv1 : uint?
    var tmpMv2 : uint?
    // Code
    refIndex = mbPred.refIdxL0[0]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), 5u)
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, 10u)
    // lint --e(740) Unusual pointer cast (incompatible indirect types)
    // we test just that both MVs are zero
    tmpMv1 = reinterpret<uint?>(addr(a[0].mv))
    // lint --e(740)
    // i.e. a[0].mv.hor == 0 && a[0].mv.ver == 0
    tmpMv2 = reinterpret<uint?>(addr(a[1].mv))
    if (pMb.mbType == mbType_e.P_Skip &&
            (a[0].available == 0 || a[1].available == 0 || (a[0].refIndex == 0u && ((*tmpMv1) == 0u)) || (a[1].refIndex == 0u && ((*tmpMv2) == 0u)))) {
        mv.ver = int16(0)
        mv.hor = mv.ver
    } else {
        mv = mbPred.mvdL0[0]
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbC, addr(a[0]) + 2, 10u)
        if (a[2].available == 0) {
            h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbD, addr(a[0]) + 2, 15u)
        }
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
        mv.hor = int16(int(mv.hor) + int(mvPred.hor))
        mv.ver = int16(int(mv.ver) + int(mvPred.ver))
        // horizontal motion vector range [-2048, 2047.75]
        if (uint(int(mv.hor) + 8192) >= 16384u) {
            return uint(HANTRO_NOK)
        }
        // vertical motion vector range [-512, 511.75]
        // (smaller for low levels)
        if (uint(int(mv.ver) + 2048) >= 4096u) {
            return uint(HANTRO_NOK)
        }
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[15] = mv
    pMb.mv[14] = pMb.mv[15]
    pMb.mv[13] = pMb.mv[14]
    pMb.mv[12] = pMb.mv[13]
    pMb.mv[11] = pMb.mv[12]
    pMb.mv[10] = pMb.mv[11]
    pMb.mv[9] = pMb.mv[10]
    pMb.mv[8] = pMb.mv[9]
    pMb.mv[7] = pMb.mv[8]
    pMb.mv[6] = pMb.mv[7]
    pMb.mv[5] = pMb.mv[6]
    pMb.mv[4] = pMb.mv[5]
    pMb.mv[3] = pMb.mv[4]
    pMb.mv[2] = pMb.mv[3]
    pMb.mv[1] = pMb.mv[2]
    pMb.mv[0] = pMb.mv[1]
    pMb.refPic[0] = refIndex
    pMb.refPic[1] = refIndex
    pMb.refPic[2] = refIndex
    pMb.refPic[3] = refIndex
    pMb.refAddr[0] = tmp
    pMb.refAddr[1] = tmp
    pMb.refAddr[2] = tmp
    pMb.refAddr[3] = tmp
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction16x8(var pMb : mbStorage?; var mbPred : mbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    // A, B, C
    var a : interNeighbour_t[3]
    var refIndex : uint
    var tmp : uint8?
    // Code
    mv = mbPred.mvdL0[0]
    refIndex = mbPred.refIdxL0[0]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, 10u)
    if (a[1].refIndex == refIndex) {
        mvPred = a[1].mv
    } else {
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), 5u)
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbC, addr(a[0]) + 2, 10u)
        if (a[2].available == 0) {
            h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbD, addr(a[0]) + 2, 15u)
        }
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= 16384u) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= 4096u) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[7] = mv
    pMb.mv[6] = pMb.mv[7]
    pMb.mv[5] = pMb.mv[6]
    pMb.mv[4] = pMb.mv[5]
    pMb.mv[3] = pMb.mv[4]
    pMb.mv[2] = pMb.mv[3]
    pMb.mv[1] = pMb.mv[2]
    pMb.mv[0] = pMb.mv[1]
    pMb.refPic[0] = refIndex
    pMb.refPic[1] = refIndex
    pMb.refAddr[0] = tmp
    pMb.refAddr[1] = tmp
    mv = mbPred.mvdL0[1]
    refIndex = mbPred.refIdxL0[1]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), 13u)
    if (a[0].refIndex == refIndex) {
        mvPred = a[0].mv
    } else {
        a[1].available = uint(HANTRO_TRUE)
        a[1].refIndex = pMb.refPic[0]
        a[1].mv = pMb.mv[0]
        // c is not available
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]) + 2, 7u)
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= 16384u) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= 4096u) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[15] = mv
    pMb.mv[14] = pMb.mv[15]
    pMb.mv[13] = pMb.mv[14]
    pMb.mv[12] = pMb.mv[13]
    pMb.mv[11] = pMb.mv[12]
    pMb.mv[10] = pMb.mv[11]
    pMb.mv[9] = pMb.mv[10]
    pMb.mv[8] = pMb.mv[9]
    pMb.refPic[2] = refIndex
    pMb.refPic[3] = refIndex
    pMb.refAddr[2] = tmp
    pMb.refAddr[3] = tmp
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction8x16(var pMb : mbStorage?; var mbPred : mbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    // A, B, C
    var a : interNeighbour_t[3]
    var refIndex : uint
    var tmp : uint8?
    // Code
    mv = mbPred.mvdL0[0]
    refIndex = mbPred.refIdxL0[0]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbA, addr(a[0]), 5u)
    if (a[0].refIndex == refIndex) {
        mvPred = a[0].mv
    } else {
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, 10u)
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 2, 14u)
        if (a[2].available == 0) {
            h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbD, addr(a[0]) + 2, 15u)
        }
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= 16384u) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= 4096u) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[11] = mv
    pMb.mv[10] = pMb.mv[11]
    pMb.mv[9] = pMb.mv[10]
    pMb.mv[8] = pMb.mv[9]
    pMb.mv[3] = pMb.mv[8]
    pMb.mv[2] = pMb.mv[3]
    pMb.mv[1] = pMb.mv[2]
    pMb.mv[0] = pMb.mv[1]
    pMb.refPic[0] = refIndex
    pMb.refPic[2] = refIndex
    pMb.refAddr[0] = tmp
    pMb.refAddr[2] = tmp
    mv = mbPred.mvdL0[1]
    refIndex = mbPred.refIdxL0[1]
    h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbC, addr(a[0]) + 2, 10u)
    if (a[2].available == 0) {
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 2, 11u)
    }
    if (a[2].refIndex == refIndex) {
        mvPred = a[2].mv
    } else {
        a[0].available = uint(HANTRO_TRUE)
        a[0].refIndex = pMb.refPic[0]
        a[0].mv = pMb.mv[0]
        h264_file_all__GetInterNeighbour(pMb.sliceId, pMb.mbB, addr(a[0]) + 1, 14u)
        h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    }
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= 16384u) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= 4096u) {
        return uint(HANTRO_NOK)
    }
    tmp = h264bsdGetRefPicData(dpb, refIndex)
    if (tmp == null) {
        return uint(HANTRO_NOK)
    }
    pMb.mv[15] = mv
    pMb.mv[14] = pMb.mv[15]
    pMb.mv[13] = pMb.mv[14]
    pMb.mv[12] = pMb.mv[13]
    pMb.mv[7] = pMb.mv[12]
    pMb.mv[6] = pMb.mv[7]
    pMb.mv[5] = pMb.mv[6]
    pMb.mv[4] = pMb.mv[5]
    pMb.refPic[1] = refIndex
    pMb.refPic[3] = refIndex
    pMb.refAddr[1] = tmp
    pMb.refAddr[3] = tmp
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction8x8(var pMb : mbStorage?; var subMbPred : subMbPred_t?; var dpb : dpbStorage_t?) : uint {
    // Variables
    var numSubMbPart : uint
    // Code
    for (i in urange(4u)) {
        numSubMbPart = h264bsdNumSubMbPart(subMbPred.subMbType[i])
        pMb.refPic[i] = subMbPred.refIdxL0[i]
        pMb.refAddr[i] = h264bsdGetRefPicData(dpb, subMbPred.refIdxL0[i])
        if (pMb.refAddr[i] == null) {
            return uint(HANTRO_NOK)
        }
        for (j in urange(numSubMbPart)) {
            if (h264_file_all__MvPrediction(pMb, subMbPred, i, j) != uint(HANTRO_OK)) {
                return uint(HANTRO_NOK)
            }
        }
    }
    return uint(HANTRO_OK)
}

[c_function]
def private h264_file_all__MvPrediction(var pMb : mbStorage?; var subMbPred : subMbPred_t?; mbPartIdx : uint; subMbPartIdx : uint) : uint {
    // Variables
    var mv : mv_t
    var mvPred : mv_t
    var refIndex : uint
    var subMbPartMode : subMbPartMode_e
    var n : neighbour_t?
    var nMb : mbStorage?
    // A, B, C
    var a : interNeighbour_t[3]
    // Code
    mv = subMbPred.mvdL0[mbPartIdx][subMbPartIdx]
    subMbPartMode = h264bsdSubMbPartMode(subMbPred.subMbType[mbPartIdx])
    refIndex = subMbPred.refIdxL0[mbPartIdx]
    n = addr(h264_file_all__N_A_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
    nMb = h264bsdGetNeighbourMb(pMb, n.mb)
    h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]), uint(n.index))
    n = addr(h264_file_all__N_B_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
    nMb = h264bsdGetNeighbourMb(pMb, n.mb)
    h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]) + 1, uint(n.index))
    n = addr(h264_file_all__N_C_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
    nMb = h264bsdGetNeighbourMb(pMb, n.mb)
    h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]) + 2, uint(n.index))
    if (a[2].available == 0) {
        n = addr(h264_file_all__N_D_SUB_PART[mbPartIdx][int(subMbPartMode)][0]) + subMbPartIdx
        nMb = h264bsdGetNeighbourMb(pMb, n.mb)
        h264_file_all__GetInterNeighbour(pMb.sliceId, nMb, addr(a[0]) + 2, uint(n.index))
    }
    h264_file_all__GetPredictionMv(addr(mvPred), addr(a[0]), refIndex)
    mv.hor = int16(int(mv.hor) + int(mvPred.hor))
    mv.ver = int16(int(mv.ver) + int(mvPred.ver))
    // horizontal motion vector range [-2048, 2047.75]
    if (uint(int(mv.hor) + 8192) >= 16384u) {
        return uint(HANTRO_NOK)
    }
    // vertical motion vector range [-512, 511.75] (smaller for low levels)
    if (uint(int(mv.ver) + 2048) >= 4096u) {
        return uint(HANTRO_NOK)
    }
    c_switch(subMbPartMode) {
        case(subMbPartMode_e.MB_SP_8x8) {
            pMb.mv[4u * mbPartIdx] = mv
            pMb.mv[4u * mbPartIdx + 1u] = mv
            pMb.mv[4u * mbPartIdx + 2u] = mv
            pMb.mv[4u * mbPartIdx + 3u] = mv
            break
        }
        case(subMbPartMode_e.MB_SP_8x4) {
            pMb.mv[4u * mbPartIdx + 2u * subMbPartIdx] = mv
            pMb.mv[4u * mbPartIdx + 2u * subMbPartIdx + 1u] = mv
            break
        }
        case(subMbPartMode_e.MB_SP_4x8) {
            pMb.mv[4u * mbPartIdx + subMbPartIdx] = mv
            pMb.mv[4u * mbPartIdx + subMbPartIdx + 2u] = mv
            break
        }
        case(subMbPartMode_e.MB_SP_4x4) {
            pMb.mv[4u * mbPartIdx + subMbPartIdx] = mv
            break
        }
    }
    return uint(HANTRO_OK)
}

def private h264_file_all__MedianFilter(a : int; b : int; c : int) : int {
    // Variables
    var max : int
    var min : int
    var med : int
    // Code
    med = a
    min = med
    max = min
    if (b > max) {
        max = b
    } elif (b < min) {
        min = b
    }
    if (c > max) {
        med = max
    } elif (c < min) {
        med = min
    } else {
        med = c
    }
    return med
}

def private h264_file_all__GetInterNeighbour(sliceId : uint; var nMb : mbStorage?; var n : interNeighbour_t?; index : uint) {
    n.available = uint(HANTRO_FALSE)
    n.refIndex = 4294967295u
    n.mv.ver = int16(0)
    n.mv.hor = n.mv.ver
    if (nMb != null && (sliceId == nMb.sliceId)) {
        var tmp : uint
        var tmpMv : mv_t
        tmp = uint(nMb.mbType)
        n.available = uint(HANTRO_TRUE)
        // MbPartPredMode "inlined"
        if (tmp <= uint(mbType_e.P_8x8ref0)) {
            tmpMv = nMb.mv[index]
            tmp = nMb.refPic[index >> 2u]
            n.refIndex = tmp
            n.mv = tmpMv
        }
    }
}

[c_function]
def private h264_file_all__GetPredictionMv(var mv : mv_t?; var a : interNeighbour_t?; refIndex : uint) {
    if (a[1].available != 0 || a[2].available != 0 || a[0].available == 0) {
        var isA : uint
        var isB : uint
        var isC : uint
        isA = uint((a[0].refIndex == refIndex) ? HANTRO_TRUE : HANTRO_FALSE)
        isB = uint((a[1].refIndex == refIndex) ? HANTRO_TRUE : HANTRO_FALSE)
        isC = uint((a[2].refIndex == refIndex) ? HANTRO_TRUE : HANTRO_FALSE)
        if ((isA + isB + isC) != 1u) {
            mv.hor = int16(h264_file_all__MedianFilter(int(a[0].mv.hor), int(a[1].mv.hor), int(a[2].mv.hor)))
            mv.ver = int16(h264_file_all__MedianFilter(int(a[0].mv.ver), int(a[1].mv.ver), int(a[2].mv.ver)))
        } elif (isA != 0) {
            *mv = a[0].mv
        } elif (isB != 0) {
            *mv = a[1].mv
        } else {
            *mv = a[2].mv
        }
    } else {
        *mv = a[0].mv
    }
}

[c_function]
def get_h264bsdClip : uint8? {
    return addr(h264bsdClip[0])
}

// ------------------------------------------------------------------------------
// Function: h264bsdIntraPrediction
// Functional description:
// Processes one intra macroblock. Performs intra prediction using
// specified prediction mode. Writes the final macroblock
// (prediction + residual) into the output image (image)
// Inputs:
// pMb pointer to macroblock specific information
// mbLayer pointer to current macroblock data from stream
// image pointer to output image
// mbNum current macroblock number
// constrainedIntraPred flag specifying if neighbouring inter
// macroblocks are used in intra prediction
// data pointer where output macroblock will be stored
// Outputs:
// pMb structure is updated with current macroblock
// image current macroblock is written into image
// data current macroblock is stored here
// Returns:
// HANTRO_OK success
// HANTRO_NOK error in intra prediction
// ------------------------------------------------------------------------------
[c_function]
def h264bsdIntraPrediction(var pMb : mbStorage?; var mbLayer : macroblockLayer_t?; var image : image_t?; mbNum : uint; constrainedIntraPred : uint;
                           var data : uint8?) : uint {
    // Variables
    // pelAbove and pelLeft contain samples above and left to the current
    // macroblock. Above array contains also sample above-left to the current
    // mb as well as 4 samples above-right to the current mb (latter only for
    // luma)
    // lumD + lumB + lumC + cbD + cbB + crD + crB
    var pelAbove : uint8[39]
    // lumA + cbA + crA
    var pelLeft : uint8[32]
    var tmp : uint
    // Code
    h264bsdGetNeighbourPels(image, addr(pelAbove[0]), addr(pelLeft[0]), mbNum)
    if (h264bsdMbPartPredMode(pMb.mbType) == mbPartPredMode_e.PRED_MODE_INTRA16x16) {
        tmp = h264bsdIntra16x16Prediction(pMb, data, addr(mbLayer.residual.level[0]), addr(pelAbove[0]), addr(pelLeft[0]), constrainedIntraPred)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    } else {
        tmp = h264bsdIntra4x4Prediction(pMb, data, mbLayer, addr(pelAbove[0]), addr(pelLeft[0]), constrainedIntraPred)
        if (tmp != uint(HANTRO_OK)) {
            return tmp
        }
    }
    tmp = h264bsdIntraChromaPrediction(pMb, data + 256, addr(mbLayer.residual.level[0]) + 16, addr(pelAbove[0]) + 21, addr(pelLeft[0]) + 16,
            mbLayer.mbPred.intraChromaPredMode, constrainedIntraPred)
    if (tmp != uint(HANTRO_OK)) {
        return tmp
    }
    // if decoded flag > 1 -> mb has already been successfully decoded and
    // written to output -> do not write again
    if (pMb.decoded > 1u) {
        return uint(HANTRO_OK)
    }
    h264bsdWriteMacroblock(image, data)
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdGetNeighbourPels(var image : image_t?; var above : uint8?; var left : uint8?; mbNum : uint) {
    // Variables
    var i : uint
    var width : uint
    var picSize : uint
    var ptr : uint8?
    var tmp : uint8?
    var row : uint
    var col : uint
    // Code
    if (mbNum == 0) {
        return
    }
    width = image.width
    picSize = width * image.height
    row = mbNum / width
    col = mbNum - row * width
    width *= 16u
    ptr = image.data + row * 16u * width + col * 16u
    // note that luma samples above-right to current macroblock do not make
    // sense when current mb is the right-most mb in a row. Same applies to
    // sample above-left if col is zero. However, usage of pels in prediction
    // is controlled by neighbour availability information in actual prediction
    // process
    if (row != 0) {
        tmp = ptr - (width + 1u)
        i = 21u
        while (true) {
            let _t0 = i
            i--
            if (_t0 == 0) {
                break
            }
            var _t1 = above
            above++
            var _t2 = tmp
            tmp++
            *_t1 = *_t2
        }
    }
    if (col != 0) {
        ptr--
        i = 16u
        while (true) {
            let _t3 = i
            i--
            if (_t3 == 0) {
                break
            }
            var _t4 = left
            left++
            *_t4 = *ptr
            ptr += width
        }
    }
    width >>= 1u
    ptr = image.data + picSize * 256u + row * 8u * width + col * 8u
    if (row != 0) {
        tmp = ptr - (width + 1u)
        i = 9u
        while (true) {
            let _t5 = i
            i--
            if (_t5 == 0) {
                break
            }
            var _t6 = above
            above++
            var _t7 = tmp
            tmp++
            *_t6 = *_t7
        }
        tmp += (picSize * 64u) - 9u
        i = 9u
        while (true) {
            let _t8 = i
            i--
            if (_t8 == 0) {
                break
            }
            var _t9 = above
            above++
            var _t10 = tmp
            tmp++
            *_t9 = *_t10
        }
    }
    if (col != 0) {
        ptr--
        i = 8u
        while (true) {
            let _t11 = i
            i--
            if (_t11 == 0) {
                break
            }
            var _t12 = left
            left++
            *_t12 = *ptr
            ptr += width
        }
        ptr += (picSize * 64u) - 8u * width
        i = 8u
        while (true) {
            let _t13 = i
            i--
            if (_t13 == 0) {
                break
            }
            var _t14 = left
            left++
            *_t14 = *ptr
            ptr += width
        }
    }
}

[c_function]
def h264bsdIntra16x16Prediction(var pMb : mbStorage?; var data : uint8?; var residual : int[16]?; var above : uint8?; var left : uint8?;
                                constrainedIntraPred : uint) : uint {
    // Variables
    var availableA : uint
    var availableB : uint
    var availableD : uint
    // Code
    availableA = h264bsdIsNeighbourAvailable(pMb, pMb.mbA)
    if (availableA != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(pMb.mbA.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
        availableA = uint(HANTRO_FALSE)
    }
    availableB = h264bsdIsNeighbourAvailable(pMb, pMb.mbB)
    if (availableB != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(pMb.mbB.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
        availableB = uint(HANTRO_FALSE)
    }
    availableD = h264bsdIsNeighbourAvailable(pMb, pMb.mbD)
    if (availableD != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(pMb.mbD.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
        availableD = uint(HANTRO_FALSE)
    }
    c_switch(h264bsdPredModeIntra16x16(pMb.mbType)) {
        case(0u) {
            // Intra_16x16_Vertical
            if (availableB == 0) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra16x16VerticalPrediction(data, above + 1)
            break
        }
        case(1u) {
            // Intra_16x16_Horizontal
            if (availableA == 0) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra16x16HorizontalPrediction(data, left)
            break
        }
        case(2u) {
            // Intra_16x16_DC
            h264_file_all__Intra16x16DcPrediction(data, above + 1, left, availableA, availableB)
            break
        }
        case(_) {
            // case 3: Intra_16x16_Plane
            if (availableA == 0 || availableB == 0 || availableD == 0) {
                return uint(HANTRO_NOK)
            }
            h264_file_all__Intra16x16PlanePrediction(data, above + 1, left)
            break
        }
    }
    // add residual
    for (i in urange(16u)) {
        h264bsdAddResidual(data, addr(residual[i][0]), i)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdIntra4x4Prediction(var pMb : mbStorage?; var data : uint8?; var mbLayer : macroblockLayer_t?; var above : uint8?; var left : uint8?;
                              constrainedIntraPred : uint) : uint {
    // Variables
    var mode : uint
    var neighbour : neighbour_t
    var neighbourB : neighbour_t
    var nMb : mbStorage?
    var nMb2 : mbStorage?
    var a : uint8[9]
    var l : uint8[5]
    var data4x4 : uint[4]
    var availableA : uint
    var availableB : uint
    var availableC : uint
    var availableD : uint
    // Code
    for (_c_block in urange(16u)) {
        neighbour = *h264bsdNeighbour4x4BlockA(_c_block)
        nMb = h264bsdGetNeighbourMb(pMb, neighbour.mb)
        availableA = h264bsdIsNeighbourAvailable(pMb, nMb)
        if (availableA != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(nMb.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
            availableA = uint(HANTRO_FALSE)
        }
        neighbourB = *h264bsdNeighbour4x4BlockB(_c_block)
        nMb2 = h264bsdGetNeighbourMb(pMb, neighbourB.mb)
        availableB = h264bsdIsNeighbourAvailable(pMb, nMb2)
        if (availableB != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(nMb2.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
            availableB = uint(HANTRO_FALSE)
        }
        mode = h264_file_all__DetermineIntra4x4PredMode(mbLayer, uint(int_of(availableA != 0 && availableB != 0)), addr(neighbour), addr(neighbourB), _c_block,
                nMb, nMb2)
        pMb.intra4x4PredMode[_c_block] = uint8(mode)
        neighbour = *h264bsdNeighbour4x4BlockC(_c_block)
        nMb = h264bsdGetNeighbourMb(pMb, neighbour.mb)
        availableC = h264bsdIsNeighbourAvailable(pMb, nMb)
        if (availableC != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(nMb.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
            availableC = uint(HANTRO_FALSE)
        }
        neighbour = *h264bsdNeighbour4x4BlockD(_c_block)
        nMb = h264bsdGetNeighbourMb(pMb, neighbour.mb)
        availableD = h264bsdIsNeighbourAvailable(pMb, nMb)
        if (availableD != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(nMb.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
            availableD = uint(HANTRO_FALSE)
        }
        h264_file_all__Get4x4NeighbourPels(addr(a[0]), addr(l[0]), data, above, left, _c_block)
        c_switch(mode) {
            case(0u) {
                // Intra_4x4_Vertical
                if (availableB == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__Intra4x4VerticalPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1)
                break
            }
            case(1u) {
                // Intra_4x4_Horizontal
                if (availableA == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__Intra4x4HorizontalPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(l[0]) + 1)
                break
            }
            case(2u) {
                // Intra_4x4_DC
                h264_file_all__Intra4x4DcPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1, availableA, availableB)
                break
            }
            case(3u) {
                // Intra_4x4_Diagonal_Down_Left
                if (availableB == 0) {
                    return uint(HANTRO_NOK)
                }
                if (availableC == 0) {
                    a[8] = a[4]
                    a[7] = a[8]
                    a[6] = a[7]
                    a[5] = a[6]
                }
                h264_file_all__Intra4x4DiagonalDownLeftPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1)
                break
            }
            case(4u) {
                // Intra_4x4_Diagonal_Down_Right
                if (availableA == 0 || availableB == 0 || availableD == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__Intra4x4DiagonalDownRightPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1)
                break
            }
            case(5u) {
                // Intra_4x4_Vertical_Right
                if (availableA == 0 || availableB == 0 || availableD == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__Intra4x4VerticalRightPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1)
                break
            }
            case(6u) {
                // Intra_4x4_Horizontal_Down
                if (availableA == 0 || availableB == 0 || availableD == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__Intra4x4HorizontalDownPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1, addr(l[0]) + 1)
                break
            }
            case(7u) {
                // Intra_4x4_Vertical_Left
                if (availableB == 0) {
                    return uint(HANTRO_NOK)
                }
                if (availableC == 0) {
                    a[8] = a[4]
                    a[7] = a[8]
                    a[6] = a[7]
                    a[5] = a[6]
                }
                h264_file_all__Intra4x4VerticalLeftPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(a[0]) + 1)
                break
            }
            case(_) {
                // case 8 Intra_4x4_Horizontal_Up
                if (availableA == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__Intra4x4HorizontalUpPrediction(reinterpret<uint8?>(addr(data4x4[0])), addr(l[0]) + 1)
                break
            }
        }
        h264_file_all__Write4x4To16x16(data, reinterpret<uint8?>(addr(data4x4[0])), _c_block)
        h264bsdAddResidual(data, addr(mbLayer.residual.level[_c_block][0]), _c_block)
    }
    return uint(HANTRO_OK)
}

[c_function]
def h264bsdIntraChromaPrediction(var pMb : mbStorage?; var data : uint8?; var residual : int[16]?; var above : uint8?; var left : uint8?; predMode : uint;
                                 constrainedIntraPred : uint) : uint {
    // Variables
    var i : uint
    var comp : uint
    var _c_block : uint
    var availableA : uint
    var availableB : uint
    var availableD : uint
    // Code
    availableA = h264bsdIsNeighbourAvailable(pMb, pMb.mbA)
    if (availableA != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(pMb.mbA.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
        availableA = uint(HANTRO_FALSE)
    }
    availableB = h264bsdIsNeighbourAvailable(pMb, pMb.mbB)
    if (availableB != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(pMb.mbB.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
        availableB = uint(HANTRO_FALSE)
    }
    availableD = h264bsdIsNeighbourAvailable(pMb, pMb.mbD)
    if (availableD != 0 && constrainedIntraPred != 0 && (h264bsdMbPartPredMode(pMb.mbD.mbType) == mbPartPredMode_e.PRED_MODE_INTER)) {
        availableD = uint(HANTRO_FALSE)
    }
    comp = 0u
    _c_block = 16u
    while (comp < 2u) {
        c_switch(predMode) {
            case(0u) {
                // Intra_Chroma_DC
                h264_file_all__IntraChromaDcPrediction(data, above + 1, left, availableA, availableB)
                break
            }
            case(1u) {
                // Intra_Chroma_Horizontal
                if (availableA == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__IntraChromaHorizontalPrediction(data, left)
                break
            }
            case(2u) {
                // Intra_Chroma_Vertical
                if (availableB == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__IntraChromaVerticalPrediction(data, above + 1)
                break
            }
            case(_) {
                // case 3: Intra_Chroma_Plane
                if (availableA == 0 || availableB == 0 || availableD == 0) {
                    return uint(HANTRO_NOK)
                }
                h264_file_all__IntraChromaPlanePrediction(data, above + 1, left)
                break
            }
        }
        i = 0u
        while (i < 4u) {
            h264bsdAddResidual(data, addr(residual[i][0]), _c_block)
            i++
            _c_block++
        }
        // advance pointers
        data += 64
        above += 9
        left += 8
        residual += 4
        comp++
    }
    return uint(HANTRO_OK)
}

// ------------------------------------------------------------------------------
// Function: h264bsdAddResidual
// Functional description:
// Add residual of a block into prediction in macroblock array 'data'.
// The result (residual + prediction) is stored in 'data'.
// ------------------------------------------------------------------------------
[c_function]
def h264bsdAddResidual(var data : uint8?; var residual : int?; blockNum : uint) {
    // Variables
    var i : uint
    var x : uint
    var y : uint
    var width : uint
    var tmp1 : int
    var tmp2 : int
    var tmp3 : int
    var tmp4 : int
    var tmp : uint8?
    var clp : uint8? = addr(h264bsdClip[0]) + 512
    // Code
    if (IS_RESIDUAL_EMPTY(residual)) {
        return
    }
    if (blockNum < 16u) {
        width = 16u
        x = h264bsdBlockX[blockNum]
        y = h264bsdBlockY[blockNum]
    } else {
        width = 8u
        x = h264bsdBlockX[blockNum & 3u]
        y = h264bsdBlockY[blockNum & 3u]
    }
    tmp = data + y * width + x
    i = 4u
    while (i != 0) {
        var _t0 = residual
        residual++
        tmp1 = *_t0
        tmp2 = int(tmp[0])
        var _t1 = residual
        residual++
        tmp3 = *_t1
        tmp4 = int(tmp[1])
        tmp[0] = clp[tmp1 + tmp2]
        var _t2 = residual
        residual++
        tmp1 = *_t2
        tmp2 = int(tmp[2])
        tmp[1] = clp[tmp3 + tmp4]
        var _t3 = residual
        residual++
        tmp3 = *_t3
        tmp4 = int(tmp[3])
        tmp1 = int(clp[tmp1 + tmp2])
        tmp3 = int(clp[tmp3 + tmp4])
        tmp[2] = uint8(tmp1)
        tmp[3] = uint8(tmp3)
        tmp += width
        i--
    }
}

[c_function]
def private h264_file_all__Intra16x16VerticalPrediction(var data : uint8?; var above : uint8?) {
    // Variables
    // Code
    for (i in urange(16u)) {
        for (j in urange(16u)) {
            var _t0 = data
            data++
            *_t0 = above[j]
        }
    }
}

[c_function]
def private h264_file_all__Intra16x16HorizontalPrediction(var data : uint8?; var left : uint8?) {
    // Variables
    // Code
    for (i in urange(16u)) {
        for (j in urange(16u)) {
            var _t0 = data
            data++
            *_t0 = left[i]
        }
    }
}

[c_function]
def private h264_file_all__Intra16x16DcPrediction(var data : uint8?; var above : uint8?; var left : uint8?; availableA : uint; availableB : uint) {
    // Variables
    var i : uint
    var tmp : uint
    // Code
    if (availableA != 0 && availableB != 0) {
        i = 0u
        tmp = 0u
        while (i < 16u) {
            tmp += uint(int(above[i]) + int(left[i]))
            i++
        }
        tmp = (tmp + 16u) >> 5u
    } elif (availableA != 0) {
        i = 0u
        tmp = 0u
        while (i < 16u) {
            tmp += uint(left[i])
            i++
        }
        tmp = (tmp + 8u) >> 4u
    } elif (availableB != 0) {
        i = 0u
        tmp = 0u
        while (i < 16u) {
            tmp += uint(above[i])
            i++
        }
        tmp = (tmp + 8u) >> 4u
    } else {
        // neither A nor B available
        tmp = 128u
    }
    for (i1 in urange(256u)) {
        data[i1] = uint8(tmp)
    }
}

[c_function]
def private h264_file_all__Intra16x16PlanePrediction(var data : uint8?; var above : uint8?; var left : uint8?) {
    // Variables
    var i : int
    var a : int
    var b : int
    var c : int
    var tmp : int
    // Code
    a = 16 * (int(above[15]) + int(left[15]))
    i = 0
    b = 0
    while (i < 8) {
        b += (i + 1) * (int(above[8 + i]) - int(above[6 - i]))
        i++
    }
    b = (5 * b + 32) >> 6
    i = 0
    c = 0
    while (i < 7) {
        c += (i + 1) * (int(left[8 + i]) - int(left[6 - i]))
        i++
    }
    // p[-1,-1] has to be accessed through above pointer
    c += (i + 1) * (int(left[8 + i]) - int(above[-1]))
