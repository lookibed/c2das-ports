[c_function]
def ST_initData {
    st_firsttime = doom_boolean._c_true
    plyr = addr(players[0]) + end_index(consoleplayer, 4)
    st_clock = uint(0)
    st_chatstate = st_chatstateenum_t.StartChatState
    st_gamestate = st_stateenum_t.FirstPersonState
    st_statusbaron = doom_boolean._c_true
    st_chat = doom_boolean._c_false
    st_oldchat = st_chat
    st_cursoron = doom_boolean._c_false
    st_faceindex = 0
    st_palette = -1
    st_oldhealth = -1
    for (i in range(int(weapontype_t.NUMWEAPONS))) {
        oldweaponsowned[i] = plyr.weaponowned[i]
    }
    for (i in range(3)) {
        keyboxes[i] = -1
    }
    STlib_init()
}

[c_function]
def ST_createWidgets {
    // ready weapon ammo
    STlib_initNum(addr(w_ready), ST_AMMOX, ST_AMMOY, addr(tallnum[0]), addr(plyr.ammo[0]) + end_index(int(weaponinfo[int(plyr.readyweapon)].ammo), 4), addr(st_statusbaron), ST_AMMOWIDTH)
    // the last weapon type
    w_ready.data = int(plyr.readyweapon)
    // health percentage
    STlib_initPercent(addr(w_health), ST_HEALTHX, ST_HEALTHY, addr(tallnum[0]), addr(plyr.health), addr(st_statusbaron), tallpercent)
    // arms background
    STlib_initBinIcon(addr(w_armsbg), ST_ARMSBGX, ST_ARMSBGY, armsbg, addr(st_notdeathmatch), addr(st_statusbaron))
    // weapons owned
    for (i in range(6)) {
        STlib_initMultIcon(addr(w_arms[0]) + end_index(i, 6), ST_ARMSX + i % 3 * ST_ARMSXSPACE, ST_ARMSY + i / 3 * ST_ARMSYSPACE, addr(arms[i][0]), reinterpret<int?>(addr(plyr.weaponowned[0]) + end_index(i + 1, 9)), addr(st_armson))
    }
    // frags sum
    STlib_initNum(addr(w_frags), ST_FRAGSX, ST_FRAGSY, addr(tallnum[0]), addr(st_fragscount), addr(st_fragson), ST_FRAGSWIDTH)
    // faces
    STlib_initMultIcon(addr(w_faces), ST_FACESX, ST_FACESY, addr(faces[0]), addr(st_faceindex), addr(st_statusbaron))
    // armor percentage - should be colored later
    STlib_initPercent(addr(w_armor), ST_ARMORX, ST_ARMORY, addr(tallnum[0]), addr(plyr.armorpoints), addr(st_statusbaron), tallpercent)
    // keyboxes 0-2
    STlib_initMultIcon(addr(w_keyboxes[0]), ST_KEY0X, ST_KEY0Y, addr(keys[0]), addr(keyboxes[0]), addr(st_statusbaron))
    STlib_initMultIcon(addr(w_keyboxes[1]), ST_KEY1X, ST_KEY1Y, addr(keys[0]), addr(keyboxes[1]), addr(st_statusbaron))
    STlib_initMultIcon(addr(w_keyboxes[2]), ST_KEY2X, ST_KEY2Y, addr(keys[0]), addr(keyboxes[2]), addr(st_statusbaron))
    // ammo count (all four kinds)
    STlib_initNum(addr(w_ammo[0]), ST_AMMO0X, ST_AMMO0Y, addr(shortnum[0]), addr(plyr.ammo[0]), addr(st_statusbaron), ST_AMMO0WIDTH)
    STlib_initNum(addr(w_ammo[1]), ST_AMMO1X, ST_AMMO1Y, addr(shortnum[0]), addr(plyr.ammo[1]), addr(st_statusbaron), ST_AMMO1WIDTH)
    STlib_initNum(addr(w_ammo[2]), ST_AMMO2X, ST_AMMO2Y, addr(shortnum[0]), addr(plyr.ammo[2]), addr(st_statusbaron), ST_AMMO2WIDTH)
    STlib_initNum(addr(w_ammo[3]), ST_AMMO3X, ST_AMMO3Y, addr(shortnum[0]), addr(plyr.ammo[3]), addr(st_statusbaron), ST_AMMO3WIDTH)
    // max ammo count (all four kinds)
    STlib_initNum(addr(w_maxammo[0]), ST_MAXAMMO0X, ST_MAXAMMO0Y, addr(shortnum[0]), addr(plyr.maxammo[0]), addr(st_statusbaron), ST_MAXAMMO0WIDTH)
    STlib_initNum(addr(w_maxammo[1]), ST_MAXAMMO1X, ST_MAXAMMO1Y, addr(shortnum[0]), addr(plyr.maxammo[1]), addr(st_statusbaron), ST_MAXAMMO1WIDTH)
    STlib_initNum(addr(w_maxammo[2]), ST_MAXAMMO2X, ST_MAXAMMO2Y, addr(shortnum[0]), addr(plyr.maxammo[2]), addr(st_statusbaron), ST_MAXAMMO2WIDTH)
    STlib_initNum(addr(w_maxammo[3]), ST_MAXAMMO3X, ST_MAXAMMO3Y, addr(shortnum[0]), addr(plyr.maxammo[3]), addr(st_statusbaron), ST_MAXAMMO3WIDTH)
}

def ST_Start {
    if (!(int(st_stopped) != 0)) {
        ST_Stop()
    }
    ST_initData()
    ST_createWidgets()
    st_stopped = doom_boolean._c_false
}

[c_function]
def ST_Stop {
    if (int(st_stopped) != 0) {
        return
    }
    I_SetPalette(reinterpret<uint8?>(W_CacheLumpNum(lu_palette, PU_CACHE)))
    st_stopped = doom_boolean._c_true
}

[c_function]
def ST_Init {
    veryfirsttime = 0
    ST_loadData()
    screens[4] = reinterpret<uint8?>(Z_Malloc(320 * ST_HEIGHT, PU_STATIC, null))
}

