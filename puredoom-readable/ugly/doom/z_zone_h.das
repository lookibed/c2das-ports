    static_assert(typeinfo offsetof < size > (type<memblock_s>) == 0, "memblock_s.size: clang puts it at 0")
    static_assert(typeinfo offsetof < user > (type<memblock_s>) == 8, "memblock_s.user: clang puts it at 8")
    static_assert(typeinfo offsetof < tag > (type<memblock_s>) == 16, "memblock_s.tag: clang puts it at 16")
    static_assert(typeinfo offsetof < id > (type<memblock_s>) == 20, "memblock_s.id: clang puts it at 20")
    static_assert(typeinfo offsetof < next > (type<memblock_s>) == 24, "memblock_s.next: clang puts it at 24")
    static_assert(typeinfo offsetof < prev > (type<memblock_s>) == 32, "memblock_s.prev: clang puts it at 32")
}

