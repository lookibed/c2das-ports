// generated by c2das - regenerate, never edit
options gen2
options indenting = 4
options solid_context
options stack = 8388608

struct default_t {
    name : uint8?
    location : int?
    defaultvalue, scantranslate, untranslated : int
    text_location : uint8 ??
    default_text_value : uint8?
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<default_t>) == 48 && typeinfo alignof(type<default_t>) == 8, "default_t: clang lays it out as size 48, align 8")
    static_assert(typeinfo offsetof < name > (type<default_t>) == 0, "default_t.name: clang puts it at 0")
    static_assert(typeinfo offsetof < location > (type<default_t>) == 8, "default_t.location: clang puts it at 8")
    static_assert(typeinfo offsetof < defaultvalue > (type<default_t>) == 16, "default_t.defaultvalue: clang puts it at 16")
    static_assert(typeinfo offsetof < scantranslate > (type<default_t>) == 20, "default_t.scantranslate: clang puts it at 20")
    static_assert(typeinfo offsetof < untranslated > (type<default_t>) == 24, "default_t.untranslated: clang puts it at 24")
    static_assert(typeinfo offsetof < text_location > (type<default_t>) == 32, "default_t.text_location: clang puts it at 32")
    static_assert(typeinfo offsetof < default_text_value > (type<default_t>) == 40, "default_t.default_text_value: clang puts it at 40")
}

