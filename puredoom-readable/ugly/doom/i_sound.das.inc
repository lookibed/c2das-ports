// This function loads the sound data from the WAD lump,
// for single sound.
[c_function]
def getsfx(var sfxname : uint8?; var len : int?) : void? {
    var sfx : uint8?
    var paddedsfx : uint8?
    var size : int
    var paddedsize : int
    var name : uint8[20]
    var sfxlump : int
    // Get the sound data from the WAD, allocate lump
    // in zone memory.
    // doom_sprintf(name, "ds%s", sfxname);
    doom_strcpy(addr(name[0]), reinterpret<uint8?>("ds"))
    doom_concat(addr(name[0]), sfxname)
    // Now, there is a severe problem with the
    // sound handling, in it is not (yet/anymore)
    // gamemode aware. That means, sounds from
    // DOOM II will be requested even with DOOM
    // shareware.
    // The sound list is wired into sounds.c,
    // which sets the external variable.
    // I do not do runtime patches to that
    // variable. Instead, we will use a
    // default sound for replacement.
    if (W_CheckNumForName(addr(name[0])) == -1) {
        sfxlump = W_GetNumForName(reinterpret<uint8?>("dspistol"))
    } else {
        sfxlump = W_GetNumForName(addr(name[0]))
    }
    size = W_LumpLength(sfxlump)
    sfx = reinterpret<uint8?>(W_CacheLumpNum(sfxlump, PU_STATIC))
    // Pads the sound effect out to the mixing buffer size.
    // The original realloc would interfere with zone memory.
    paddedsize = (size - 8 + (SAMPLECOUNT - 1)) / SAMPLECOUNT * SAMPLECOUNT
    // Allocate from zone memory.
    paddedsfx = reinterpret<uint8?>(Z_Malloc(paddedsize + 8, PU_STATIC, null))
    // ddt: (unsigned char *) realloc(sfx, paddedsize+8);
    // This should interfere with zone memory handling,
    // which does not kick in in the soundserver.
    // Now copy and pad.
    doom_memcpy(reinterpret<void?>(paddedsfx), reinterpret<void?>(sfx), size)
    for (i in range(size, paddedsize + 8)) {
        deref(paddedsfx + i) = uint8(128)
    }
    // Remove the cached lump.
    Z_Free(reinterpret<void?>(sfx))
    // Preserve padded length.
    deref(len) = paddedsize
    // Return allocated padded data.
    return reinterpret<void?>(paddedsfx + 8)
}

// This function adds a sound to the
// list of currently active sounds,
// which is maintained as a given number
// (eight, usually) of internal channels.
// Returns a handle.
[c_function]
def addsfx(sfxid : int; volume : int; step : int; var seperation : int) : int {
    var i : int
    var rc : int = -1
    var oldest : int = gametic
    var oldestnum : int = 0
    var slot : int
    var rightvol : int
    var leftvol : int
    // Chainsaw troubles.
    // Play these sound effects only one at a time.
    if (sfxid == int(sfxenum_t.sfx_sawup) || sfxid == int(sfxenum_t.sfx_sawidl) || sfxid == int(sfxenum_t.sfx_sawful) || sfxid == int(sfxenum_t.sfx_sawhit) || sfxid == int(sfxenum_t.sfx_stnmov) || sfxid == int(sfxenum_t.sfx_pistol)) {
        // Loop all channels, check.
        for (i1 in range(NUM_CHANNELS)) {
            // Active, and using the same SFX?
            if (channels[i1] != null && channelids[i1] == sfxid) {
                // Reset.
                channels[i1] = null
                // We are sure that iff,
                // there will only be one.
                break
            }
        }
    }
    // Loop all channels to find oldest SFX.
    {
        i = 0
        while (i < NUM_CHANNELS && channels[i] != null) {
            if (channelstart[i] < oldest) {
                oldestnum = i
                oldest = channelstart[i]
            }
            i++
        }
    }
    // Tales from the cryptic.
    // If we found a channel, fine.
    // If not, we simply overwrite the first one, 0.
    // Probably only happens at startup.
    if (i == NUM_CHANNELS) {
        slot = oldestnum
    } else {
        slot = i
    }
    // Okay, in the less recent channel,
    // we will handle the new SFX.
    // Set pointer to raw data.
    channels[slot] = reinterpret<uint8?>(S_sfx[sfxid].data)
    // Set pointer to end of raw data.
    channelsend[slot] = channels[slot] + lengths[sfxid]
    // Reset current handle number, limited to 0..100.
    if (!(addsfx_handlenums != 0)) {
        addsfx_handlenums = uint16(100)
    }
    // Assign current handle number.
    // Preserved so sounds could be stopped (unused).
    let _t0 = addsfx_handlenums
    addsfx_handlenums = uint16(uint(addsfx_handlenums) + 1)
    rc = int(_t0)
    channelhandles[slot] = rc
    // Set stepping???
    // Kinda getting the impression this is never used.
    channelstep[slot] = uint(step)
    // ???
    channelstepremainder[slot] = uint(0)
    // Should be gametic, I presume.
    channelstart[slot] = gametic
    // Separation, that is, orientation/stereo.
    // range is: 1 - 256
    seperation += 1
    // Per left/right channel.
    // x^2 seperation,
    // adjust volume properly.
    leftvol = volume - (volume * seperation * seperation >> 16)
    // (256*256);
    seperation -= 257
    rightvol = volume - (volume * seperation * seperation >> 16)
    // Sanity check, clamp volume.
    if (rightvol < 0 || rightvol > 127) {
        I_Error(reinterpret<uint8?>("Error: rightvol out of bounds"))
    }
    if (leftvol < 0 || leftvol > 127) {
        I_Error(reinterpret<uint8?>("Error: leftvol out of bounds"))
    }
    // Get the proper lookup table piece
    // for this volume level???
    channelleftvol_lookup[slot] = addr(vol_lookup[0]) + end_index(leftvol * 256, 32768)
    channelrightvol_lookup[slot] = addr(vol_lookup[0]) + end_index(rightvol * 256, 32768)
    // Preserve sound SFX id,
    // e.g. for avoiding duplicates of chainsaw.
    channelids[slot] = sfxid
    // You tell me.
    return rc
}

