def private reset_all_channels {
    for (i in range(16)) {
        let _t0 = queue_midi_tail
        queue_midi_tail++
        queued_midi_msgs[_t0 % MAX_QUEUED_MIDI_MSGS] = uint64(176 | i | 123 << 8)
    }
}

