// P_LoadVertexes
[c_function]
def P_LoadVertexes(lump : int) {
    var data : uint8?
    var i : int
    var ml : uint8?
    var li : vertex_t?
    // Determine number of lumps:
    // total lump length / vertex record length.
    numvertexes = int(uint64(W_LumpLength(lump)) / uint64(4))
    // Allocate zone memory for buffer.
    vertexes = reinterpret<vertex_t?>(Z_Malloc(int(uint64(numvertexes) * uint64(typeinfo sizeof(type<vertex_t>))), PU_LEVEL, null))
    // Load data into cache.
    data = reinterpret<uint8?>(W_CacheLumpNum(lump, PU_STATIC))
    ml = reinterpret<uint8?>(data)
    li = vertexes
    // Copy and convert vertex coordinates,
    // internal representation as fixed.
    {
        i = 0
        while (i < numvertexes) {
            li.x = int(read_mapvertex_t_x(ml, 0)) << FRACBITS
            li.y = int(read_mapvertex_t_y(ml, 0)) << FRACBITS
            i++
            li = li + 1
            ml = ml + 4
        }
    }
    // Free buffer memory.
    Z_Free(reinterpret<void?>(data))
}

