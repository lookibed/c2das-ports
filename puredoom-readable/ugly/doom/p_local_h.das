// generated by c2das - regenerate, never edit
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_union
require d_player_h_cluster
require doomtype_h

struct divline_t {
    x, y, dx, dy : int
}

[c_union]
struct anon_359 {
    thing : mobj_s?
    line : line_s?
}

struct intercept_t {
    frac : int
    isaline : doom_boolean
    d : anon_359
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<divline_t>) == 16 && typeinfo alignof(type<divline_t>) == 4, "divline_t: clang lays it out as size 16, align 4")
    static_assert(typeinfo offsetof < x > (type<divline_t>) == 0, "divline_t.x: clang puts it at 0")
    static_assert(typeinfo offsetof < y > (type<divline_t>) == 4, "divline_t.y: clang puts it at 4")
    static_assert(typeinfo offsetof < dx > (type<divline_t>) == 8, "divline_t.dx: clang puts it at 8")
    static_assert(typeinfo offsetof < dy > (type<divline_t>) == 12, "divline_t.dy: clang puts it at 12")
    static_assert(typeinfo sizeof(type<anon_359>) == 8 && typeinfo alignof(type<anon_359>) == 8, "anon_359: clang lays it out as size 8, align 8")
    static_assert(typeinfo offsetof < _storage > (type<anon_359>) == 0, "anon_359: every member sits at 0")
    static_assert(typeinfo sizeof(type<intercept_t>) == 16 && typeinfo alignof(type<intercept_t>) == 8, "intercept_t: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < frac > (type<intercept_t>) == 0, "intercept_t.frac: clang puts it at 0")
    static_assert(typeinfo offsetof < isaline > (type<intercept_t>) == 4, "intercept_t.isaline: clang puts it at 4")
    static_assert(typeinfo offsetof < d > (type<intercept_t>) == 8, "intercept_t.d: clang puts it at 8")
}

