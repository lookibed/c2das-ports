        V_MarkRect(x, y, int(read_patch_t_width(patch, 0)), int(read_patch_t_height(patch, 0)))
    }
    col = 0
    desttop = screens[scrn] + y * SCREENWIDTH + x
    w = int(read_patch_t_width(patch, 0))
    {
        while (col < w) {
            column = reinterpret<uint8?>(reinterpret<uint8?>(patch) + deref(ptr_patch_t_columnofs(patch, 0) + (w - 1 - col)))
            // step through the posts in a column
            while (int(read_post_t_topdelta(column, 0)) != 255) {
                source = reinterpret<uint8?>(column) + 3
                dest = desttop + int(read_post_t_topdelta(column, 0)) * SCREENWIDTH
                count = int(read_post_t_length(column, 0))
                while (true) {
                    let _t0 = count
                    count--
                    if (!(_t0 != 0)) {
                        break
                    }
                    var _t1 = source
                    source = source + 1
                    deref(dest) = deref(_t1)
                    dest = dest + SCREENWIDTH
                }
                column = reinterpret<uint8?>(reinterpret<uint8?>(column) + int(read_post_t_length(column, 0)) + 4)
            }
            x++
            col++
            desttop = desttop + 1
        }
    }
}

[c_function]
def V_DrawPatchRectDirect(var x : int; var y : int; scrn : int; var patch : uint8?; src_x : int; src_w : int) {
    var count : int
    var col : int
    var column : uint8?
    var desttop : uint8?
    var dest : uint8?
    var source : uint8?
    var w : int
    y -= int(read_patch_t_topoffset(patch, 0))
    x -= int(read_patch_t_leftoffset(patch, 0))
    if (x < 0 || x + src_w > SCREENWIDTH || y < 0 || y + int(read_patch_t_height(patch, 0)) > SCREENHEIGHT || uint(scrn) > uint(4)) {
        // doom_print("Patch at %d,%d exceeds LFB\n", x, y);
        invoke(doom_print, reinterpret<uint8?>("Patch at "))
        invoke(doom_print, doom_itoa(x, 10))
        invoke(doom_print, reinterpret<uint8?>(","))
        invoke(doom_print, doom_itoa(y, 10))
        invoke(doom_print, reinterpret<uint8?>(" exceeds LFB\n"))
        // No I_Error abort - what is up with TNT.WAD?
        invoke(doom_print, reinterpret<uint8?>("V_DrawPatch: bad patch (ignored)\n"))
        return
    }
    if (!(scrn != 0)) {
        V_MarkRect(x, y, src_w, int(read_patch_t_height(patch, 0)))
    }
    col = 0
    desttop = screens[scrn] + y * SCREENWIDTH + x
    w = src_w
    {
        while (col < w) {
            column = reinterpret<uint8?>(reinterpret<uint8?>(patch) + deref(ptr_patch_t_columnofs(patch, 0) + (col + src_x)))
            // step through the posts in a column
            while (int(read_post_t_topdelta(column, 0)) != 255) {
                source = reinterpret<uint8?>(column) + 3
                dest = desttop + int(read_post_t_topdelta(column, 0)) * SCREENWIDTH
                count = int(read_post_t_length(column, 0))
                while (true) {
                    let _t0 = count
                    count--
                    if (!(_t0 != 0)) {
                        break
                    }
                    var _t1 = source
                    source = source + 1
                    deref(dest) = deref(_t1)
                    dest = dest + SCREENWIDTH
                }
                column = reinterpret<uint8?>(reinterpret<uint8?>(column) + int(read_post_t_length(column, 0)) + 4)
            }
            x++
            col++
            desttop = desttop + 1
        }
    }
}

// V_DrawPatchDirect
// Draws directly to the screen on the pc.
def V_DrawPatchDirect(x : int; y : int; scrn : int; var patch : uint8?) {
    V_DrawPatch(x, y, scrn, patch)
}

// V_DrawBlock
// Draw a linear block of pixels into the view buffer.
[c_function]
def V_DrawBlock(x : int; y : int; scrn : int; width : int; var height : int; var src : uint8?) {
    var dest : uint8?
    if (x < 0 || x + width > SCREENWIDTH || y < 0 || y + height > SCREENHEIGHT || uint(scrn) > uint(4)) {
        I_Error(reinterpret<uint8?>("Error: Bad V_DrawBlock"))
    }
    V_MarkRect(x, y, width, height)
    dest = screens[scrn] + y * SCREENWIDTH + x
    while (true) {
        let _t0 = height
        height--
        if (!(_t0 != 0)) {
            break
        }
        doom_memcpy(reinterpret<void?>(dest), reinterpret<void?>(src), width)
        src = src + width
        dest = dest + SCREENWIDTH
    }
}

// V_GetBlock
// Gets a linear block of pixels from the view buffer.
[c_function]
def V_GetBlock(x : int; y : int; scrn : int; width : int; var height : int; var dest : uint8?) {
    var src : uint8?
    if (x < 0 || x + width > SCREENWIDTH || y < 0 || y + height > SCREENHEIGHT || uint(scrn) > uint(4)) {
        I_Error(reinterpret<uint8?>("Error: Bad V_DrawBlock"))
    }
    src = screens[scrn] + y * SCREENWIDTH + x
    while (true) {
        let _t0 = height
        height--
        if (!(_t0 != 0)) {
            break
        }
        doom_memcpy(reinterpret<void?>(dest), reinterpret<void?>(src), width)
        src = src + SCREENWIDTH
        dest = dest + width
    }
}

// V_Init
[c_function]
def V_Init {
    var base : uint8?
    // stick these in low dos memory on PCs
    base = I_AllocLow(SCREENWIDTH * SCREENHEIGHT * 4)
    for (i in range(4)) {
        screens[i] = base + i * SCREENWIDTH * SCREENHEIGHT
    }
}

