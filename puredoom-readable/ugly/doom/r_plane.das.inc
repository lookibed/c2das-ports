// BASIC PRIMITIVE
[c_function]
def R_MapPlane(y : int; x1 : int; x2 : int) {
    var angle : uint
    var distance : int
    var length : int
    var index : uint
    if (x2 < x1 || x1 < 0 || x2 >= viewwidth || uint(y) > uint(viewheight)) {
        // I_Error("Error: R_MapPlane: %i, %i at %i", x1, x2, y);
        doom_strcpy(addr(error_buf[0]), reinterpret<uint8?>("Error: R_MapPlane: "))
        doom_concat(addr(error_buf[0]), doom_itoa(x1, 10))
        doom_concat(addr(error_buf[0]), reinterpret<uint8?>(", "))
        doom_concat(addr(error_buf[0]), doom_itoa(x2, 10))
        doom_concat(addr(error_buf[0]), reinterpret<uint8?>(" at "))
        doom_concat(addr(error_buf[0]), doom_itoa(y, 10))
        I_Error(addr(error_buf[0]))
    }
    if (planeheight != cachedheight[y]) {
        cachedheight[y] = planeheight
        cacheddistance[y] = FixedMul(planeheight, yslope[y])
        distance = cacheddistance[y]
        cachedxstep[y] = FixedMul(distance, basexscale)
        ds_xstep = cachedxstep[y]
        cachedystep[y] = FixedMul(distance, baseyscale)
        ds_ystep = cachedystep[y]
    } else {
        distance = cacheddistance[y]
        ds_xstep = cachedxstep[y]
        ds_ystep = cachedystep[y]
    }
    length = FixedMul(distance, distscale[x1])
    angle = viewangle + xtoviewangle[x1] >> 19u
    ds_xfrac = viewx + FixedMul(deref(finecosine + angle), length)
    ds_yfrac = -viewy - FixedMul(finesine[angle], length)
    if (fixedcolormap != null) {
        ds_colormap = fixedcolormap
    } else {
        index = uint(distance >> LIGHTZSHIFT)
        if (index >= uint(MAXLIGHTZ)) {
            index = uint(MAXLIGHTZ - 1)
        }
        ds_colormap = deref(planezlight + index)
    }
    ds_y = y
    ds_x1 = x1
    ds_x2 = x2
    // high or low detail
    invoke(spanfunc)
}

// R_ClearPlanes
// At begining of frame.
[c_function]
def R_ClearPlanes {
    var i : int
    var angle : uint
    // opening / clipping determination
    {
        i = 0
        while (i < viewwidth) {
            floorclip[i] = int16(viewheight)
            ceilingclip[i] = int16(-1)
            i++
        }
    }
    lastvisplane = addr(visplanes[0])
    lastopening = addr(openings[0])
    // texture calculation
    doom_memset(reinterpret<void?>(addr(cachedheight[0])), 0, int(uint64(typeinfo sizeof(type<int[200]>))))
    // left to right mapping
    angle = viewangle - uint(ANG90) >> 19u
    // scale will be unit scale at SCREENWIDTH/2 distance
    basexscale = FixedDiv(deref(finecosine + angle), centerxfrac)
    baseyscale = -FixedDiv(finesine[angle], centerxfrac)
}

// R_FindPlane
[c_function]
def R_FindPlane(var height : int; picnum : int; var lightlevel : int) : visplane_t? {
    var check : visplane_t?
    if (picnum == skyflatnum) {
        // all skys map together
        height = 0
        lightlevel = 0
    }
    {
        check = addr(visplanes[0])
        while (intptr(check) < intptr(lastvisplane)) {
            if (height == check.height && picnum == check.picnum && lightlevel == check.lightlevel) {
                break
            }
            check = check + 1
        }
    }
    if (intptr(check) < intptr(lastvisplane)) {
        return check
    }
    if (int64(lastvisplane - addr(visplanes[0])) == int64(MAXVISPLANES)) {
        I_Error(reinterpret<uint8?>("Error: R_FindPlane: no more visplanes"))
    }
    lastvisplane = lastvisplane + 1
    check.height = height
    check.picnum = picnum
    check.lightlevel = lightlevel
    check.minx = SCREENWIDTH
    check.maxx = -1
    doom_memset(reinterpret<void?>(addr(check.top[0])), 255, int(uint64(typeinfo sizeof(type<uint8[320]>))))
    return check
}

// R_CheckPlane
[c_function]
def R_CheckPlane(var pl : visplane_t?; start : int; stop : int) : visplane_t? {
    var intrl : int
    var intrh : int
    var unionl : int
    var unionh : int
    var x : int
    if (start < pl.minx) {
        intrl = pl.minx
        unionl = start
    } else {
        unionl = pl.minx
        intrl = start
    }
    if (stop > pl.maxx) {
        intrh = pl.maxx
        unionh = stop
    } else {
        unionh = pl.maxx
        intrh = stop
    }
    {
        x = intrl
        while (x <= intrh) {
            if (int(deref(addr(pl.top[0]) + x)) != 255) {
                break
            }
            x++
        }
    }
    if (x > intrh) {
        pl.minx = unionl
        pl.maxx = unionh
        // use the same one
        return pl
    }
    // make a new visplane
    lastvisplane.height = pl.height
    lastvisplane.picnum = pl.picnum
    lastvisplane.lightlevel = pl.lightlevel
    var _t0 = lastvisplane
    lastvisplane = lastvisplane + 1
    pl = _t0
    pl.minx = start
    pl.maxx = stop
    doom_memset(reinterpret<void?>(addr(pl.top[0])), 255, int(uint64(typeinfo sizeof(type<uint8[320]>))))
    return pl
}

// R_MakeSpans
def R_MakeSpans(x : int; var t1 : int; var b1 : int; var t2 : int; var b2 : int) {
    while (t1 < t2 && t1 <= b1) {
        R_MapPlane(t1, spanstart[t1], x - 1)
        t1++
    }
    while (b1 > b2 && b1 >= t1) {
        R_MapPlane(b1, spanstart[b1], x - 1)
        b1--
    }
    while (t2 < t1 && t2 <= b2) {
        spanstart[t2] = x
        t2++
    }
    while (b2 > b1 && b2 >= t2) {
        spanstart[b2] = x
        b2--
    }
}

