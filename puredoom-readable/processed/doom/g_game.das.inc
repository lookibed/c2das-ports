def G_InitNew(var skill : skill_t; var episode : int; var map : int) {
    if (int(paused) != 0) {
        paused = doom_boolean._c_false
        S_ResumeSound()
    }
    if (uint(skill) > uint(skill_t.sk_nightmare)) {
        skill = skill_t.sk_nightmare
    }
    // This was quite messy with SPECIAL and commented parts.
    // Supposedly hacks to make the latest edition work.
    // It might not work properly.
    if (episode < 1) {
        episode = 1
    }
    if (gamemode == GameMode_t.retail) {
        if (episode > 4) {
            episode = 4
        }
    } elif (gamemode == GameMode_t.shareware) {
        if (episode > 1) {
            // only start episode 1 on shareware
            episode = 1
        }
    } else {
        if (episode > 3) {
            episode = 3
        }
    }
    if (map < 1) {
        map = 1
    }
    if ((map > 9) && (gamemode != GameMode_t.commercial)) {
        map = 9
    }
    M_ClearRandom()
    if (skill == skill_t.sk_nightmare || uint(respawnparm) != 0) {
        respawnmonsters = doom_boolean._c_true
    } else {
        respawnmonsters = doom_boolean._c_false
    }
    if (uint(fastparm) != 0 || (skill == skill_t.sk_nightmare && gameskill != skill_t.sk_nightmare)) {
        for (i in range(int(statenum_t.S_SARG_RUN1), int(statenum_t.S_SARG_PAIN2) + 1)) {
            states[i].tics >>= 1l
        }
        mobjinfo[int(mobjtype_t.MT_BRUISERSHOT)].speed = 20 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_HEADSHOT)].speed = 20 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_TROOPSHOT)].speed = 20 * FRACUNIT
    } elif (skill != skill_t.sk_nightmare && gameskill == skill_t.sk_nightmare) {
        for (i in range(int(statenum_t.S_SARG_RUN1), int(statenum_t.S_SARG_PAIN2) + 1)) {
            states[i].tics <<= 1l
        }
        mobjinfo[int(mobjtype_t.MT_BRUISERSHOT)].speed = 15 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_HEADSHOT)].speed = 10 * FRACUNIT
        mobjinfo[int(mobjtype_t.MT_TROOPSHOT)].speed = 10 * FRACUNIT
    }
    // force players to be initialized upon first level load
    for (i in range(MAXPLAYERS)) {
        players[i].playerstate = playerstate_t.PST_REBORN
    }
    // will be set false if a demo
    usergame = doom_boolean._c_true
    paused = doom_boolean._c_false
    demoplayback = doom_boolean._c_false
    automapactive = doom_boolean._c_false
    viewactive = doom_boolean._c_true
    gameepisode = episode
    gamemap = map
    gameskill = skill
    viewactive = doom_boolean._c_true
    // set the sky map for the episode
    if (gamemode == GameMode_t.commercial) {
        skytexture = R_TextureNumForName(cstr("SKY3"))
        if (gamemap < 12) {
            skytexture = R_TextureNumForName(cstr("SKY1"))
        } elif (gamemap < 21) {
            skytexture = R_TextureNumForName(cstr("SKY2"))
        }
    } else {
        c_switch(episode) {
            case(1) {
                skytexture = R_TextureNumForName(cstr("SKY1"))
                break
            }
            case(2) {
                skytexture = R_TextureNumForName(cstr("SKY2"))
                break
            }
            case(3) {
                skytexture = R_TextureNumForName(cstr("SKY3"))
                break
            }
            case(4) {
                // Special Edition sky
                skytexture = R_TextureNumForName(cstr("SKY4"))
                break
            }
        }
    }
    G_DoLoadLevel()
}

[c_function]
def G_ReadDemoTiccmd(var cmd : ticcmd_t?) {
    if (int(*demo_p) == DEMOMARKER) {
        // end of demo data stream
        G_CheckDemoStatus()
        return
    }
    var _t0 = demo_p
    demo_p++
    cmd.forwardmove = int8(*_t0)
    var _t1 = demo_p
    demo_p++
    cmd.sidemove = int8(*_t1)
    var _t2 = demo_p
    demo_p++
    cmd.angleturn = int16(int(*_t2) << 8)
    var _t3 = demo_p
    demo_p++
    cmd.buttons = *_t3
}

[c_function]
def G_WriteDemoTiccmd(var cmd : ticcmd_t?) {
    // press q to end demo recording
    if (int(gamekeydown['q']) != 0) {
        G_CheckDemoStatus()
    }
    var _t0 = demo_p
    demo_p++
    *_t0 = uint8(cmd.forwardmove)
    var _t1 = demo_p
    demo_p++
    *_t1 = uint8(cmd.sidemove)
    var _t2 = demo_p
    demo_p++
    *_t2 = uint8((int(cmd.angleturn) + 128) >> 8)
    var _t3 = demo_p
    demo_p++
    *_t3 = cmd.buttons
    demo_p -= 4
    if (intptr(demo_p) > intptr(demoend - 16)) {
        // no more space
        G_CheckDemoStatus()
        return
    }
    // make SURE it is exactly the same
    G_ReadDemoTiccmd(cmd)
}

