        }
        if (reinterpret<memblock_s?>(demobuffer + -int64(uint64(typeinfo sizeof(type<memblock_s>)))).id != 1919505) {
            var buf : uint8[260]
            doom_strcpy(addr(buf[0]), cstr("Error: Z_CT at /root/wt-pdr-proc/doom/work/src/g_game.c:"))
            doom_concat(addr(buf[0]), doom_itoa(1689, 10))
            I_Error(addr(buf[0]))
        }
        Z_ChangeTag2(reinterpret<void?>(demobuffer), PU_CACHE)
        demoplayback = doom_boolean._c_false
        netdemo = doom_boolean._c_false
        netgame = doom_boolean._c_false
        deathmatch = doom_boolean._c_false
        playeringame[3] = doom_boolean._c_false
        playeringame[2] = playeringame[3]
        playeringame[1] = playeringame[2]
        respawnparm = doom_boolean._c_false
        fastparm = doom_boolean._c_false
        nomonsters = doom_boolean._c_false
        consoleplayer = 0
        D_AdvanceDemo()
        return doom_boolean._c_true
    }
    if (int(demorecording) != 0) {
        var _t0 = demo_p
        demo_p++
        *_t0 = uint8(DEMOMARKER)
        M_WriteFile(addr(demoname[0]), reinterpret<void?>(demobuffer), int(int64(demo_p - demobuffer)))
        Z_Free(reinterpret<void?>(demobuffer))
        demorecording = doom_boolean._c_false
        // I_Error("Error: Demo %s recorded", demoname);
        doom_strcpy(addr(error_buf[0]), cstr("Error: Demo "))
