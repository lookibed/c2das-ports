[c_function]
def G_DoCompleted {
    var i : int
    gameaction = gameaction_t.ga_nothing
    i = 0
    while (i < MAXPLAYERS) {
        if (int(playeringame[i]) != 0) {
            // take away cards and stuff
            G_PlayerFinishLevel(i)
        }
        i++
    }
    if (int(automapactive) != 0) {
        AM_Stop()
    }
    if (gamemode != GameMode_t.commercial) {
        c_switch(gamemap) {
            case(8) {
                gameaction = gameaction_t.ga_victory
                return
            }
            case(9) {
                i = 0
                while (i < MAXPLAYERS) {
                    players[i].didsecret = doom_boolean._c_true
                    i++
                }
                break
            }
        }
    }
    if ((gamemap == 8) && (gamemode != GameMode_t.commercial)) {
        // victory
        gameaction = gameaction_t.ga_victory
        return
    }
    if ((gamemap == 9) && (gamemode != GameMode_t.commercial)) {
        // exit secret level
        for (i1 in range(MAXPLAYERS)) {
            players[i1].didsecret = doom_boolean._c_true
        }
    }
    wminfo.didsecret = players[consoleplayer].didsecret
    wminfo.epsd = gameepisode - 1
    wminfo.last = gamemap - 1
    // wminfo.next is 0 biased, unlike gamemap
    if (gamemode == GameMode_t.commercial) {
        if (int(secretexit) != 0) {
            c_switch(gamemap) {
                case(15) {
                    wminfo.next = 30
                    break
                }
                case(31) {
                    wminfo.next = 31
                    break
                }
            }
        } else {
            c_switch(gamemap) {
                case(31, 32) {
                    wminfo.next = 15
                    break
                }
                case(_) {
                    wminfo.next = gamemap
                }
            }
        }
    } else {
        if (int(secretexit) != 0) {
            // go to secret level
            wminfo.next = 8
        } elif (gamemap == 9) {
            // returning from secret level
            c_switch(gameepisode) {
                case(1) {
                    wminfo.next = 3
                    break
                }
                case(2) {
                    wminfo.next = 5
                    break
                }
                case(3) {
                    wminfo.next = 6
                    break
                }
                case(4) {
                    wminfo.next = 2
                    break
                }
            }
        } else {
            // go to next level
            wminfo.next = gamemap
        }
    }
    wminfo.maxkills = totalkills
    wminfo.maxitems = totalitems
    wminfo.maxsecret = totalsecret
    wminfo.maxfrags = 0
    if (gamemode == GameMode_t.commercial) {
        wminfo.partime = 35 * cpars[gamemap - 1]
    } else {
        wminfo.partime = 35 * pars[gameepisode][gamemap]
    }
    wminfo.pnum = consoleplayer
    for (i1 in range(MAXPLAYERS)) {
        wminfo.plyr[i1]._c_in = playeringame[i1]
        wminfo.plyr[i1].skills = players[i1].killcount
        wminfo.plyr[i1].sitems = players[i1].itemcount
        wminfo.plyr[i1].ssecret = players[i1].secretcount
        wminfo.plyr[i1].stime = leveltime
        doom_memcpy(reinterpret<void?>(addr(wminfo.plyr[i1].frags[0])), reinterpret<void?>(addr(players[i1].frags[0])), typeinfo sizeof(type<int[4]>))
    }
    gamestate = gamestate_t.GS_INTERMISSION
    viewactive = doom_boolean._c_false
    automapactive = doom_boolean._c_false
    if (statcopy != null) {
        doom_memcpy(statcopy, reinterpret<void?>(addr(wminfo)), typeinfo sizeof(type<wbstartstruct_t>))
    }
    WI_Start(addr(wminfo))
}

