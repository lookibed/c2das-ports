            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_LAUN) {
            if (int(P_GiveWeapon(player, weapontype_t.wp_missile, doom_boolean._c_false)) == 0) {
                return
            }
            player.message = cstr("You got the rocket launcher!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_PLAS) {
            if (int(P_GiveWeapon(player, weapontype_t.wp_plasma, doom_boolean._c_false)) == 0) {
                return
            }
            player.message = cstr("You got the plasma gun!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_SHOT) {
            if (int(P_GiveWeapon(player, weapontype_t.wp_shotgun, enum_from_int(type<doom_boolean>, special.flags & int(mobjflag_t.MF_DROPPED)))) == 0) {
                return
            }
            player.message = cstr("You got the shotgun!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(spritenum_t.SPR_SGN2) {
            if (int(P_GiveWeapon(player, weapontype_t.wp_supershotgun, enum_from_int(type<doom_boolean>, special.flags & int(mobjflag_t.MF_DROPPED)))) == 0) {
                return
            }
            player.message = cstr("You got the super shotgun!")
            sound = int(sfxenum_t.sfx_wpnup)
            break
        }
        case(_) {
            I_Error(cstr("P_SpecialThing: Unknown gettable thing"))
        }
    }
    if ((special.flags & int(mobjflag_t.MF_COUNTITEM)) != 0) {
        player.itemcount++
    }
    P_RemoveMobj(special)
    player.bonuscount += BONUSADD
    if (intptr(player) == intptr(addr(players[0]) + end_index(consoleplayer, 4))) {
        S_StartSound(null, sound)
    }
}

// KillMobj
[c_function]
def P_KillMobj(var source : mobj_s?; var target : mobj_s?) {
    var item : mobjtype_t
    var mo : mobj_s?
    target.flags &= ~(int(mobjflag_t.MF_SHOOTABLE) | int(mobjflag_t.MF_FLOAT) | int(mobjflag_t.MF_SKULLFLY))
    if (target._c_type != mobjtype_t.MT_SKULL) {
        target.flags &= ~int(mobjflag_t.MF_NOGRAVITY)
    }
    target.flags |= int(mobjflag_t.MF_CORPSE) | int(mobjflag_t.MF_DROPOFF)
    target.height >>= 2
    if (source != null && source.player != null) {
        // count for intermission
        if ((target.flags & int(mobjflag_t.MF_COUNTKILL)) != 0) {
            source.player.killcount++
        }
        if (target.player != null) {
            source.player.frags[int64(target.player - addr(players[0]))]++
        }
    } elif (int(netgame) == 0 && (target.flags & int(mobjflag_t.MF_COUNTKILL)) != 0) {
        // count all monster deaths,
        // even those caused by other monsters
        players[0].killcount++
    }
    if (target.player != null) {
        // count environment kills against you
        if (source == null) {
            target.player.frags[int64(target.player - addr(players[0]))]++
        }
        target.flags &= ~int(mobjflag_t.MF_SOLID)
        target.player.playerstate = playerstate_t.PST_DEAD
        P_DropWeapon(target.player)
        if (intptr(target.player) == intptr(addr(players[0]) + end_index(consoleplayer, 4)) && uint(automapactive) != 0) {
            // don't die in auto map,
            // switch view prior to dying
            AM_Stop()
        }
    }
    if (target.health < -target.info.spawnhealth && target.info.xdeathstate != 0) {
        P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.xdeathstate))
    } else {
        P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.deathstate))
    }
    target.tics -= P_Random() & 3
    if (target.tics < 1) {
        target.tics = 1
    }
    // I_StartSound (&actor->r, actor->info->deathsound);
    // Drop stuff.
    // This determines the kind of object spawned
    // during the death frame of a thing.
    c_switch(target._c_type) {
        case(mobjtype_t.MT_WOLFSS, mobjtype_t.MT_POSSESSED) {
            item = mobjtype_t.MT_CLIP
            break
        }
        case(mobjtype_t.MT_SHOTGUY) {
            item = mobjtype_t.MT_SHOTGUN
            break
        }
        case(mobjtype_t.MT_CHAINGUY) {
            item = mobjtype_t.MT_CHAINGUN
            break
        }
        case(_) {
            return
        }
    }
    mo = P_SpawnMobj(target.x, target.y, ONFLOORZ, item)
    // special versions of items
    mo.flags |= int(mobjflag_t.MF_DROPPED)
}

// P_DamageMobj
// Damages both enemies and players
// "inflictor" is the thing that caused the damage
// creature or missile, can be 0 (slime, etc)
// "source" is the thing to target after taking damage
// creature or 0
// Source and inflictor are the same for melee attacks.
// Source can be 0 for slime, barrel explosions
// and other environmental stuff.
[c_function]
def P_DamageMobj(var target : mobj_s?; var inflictor : mobj_s?; var source : mobj_s?; var damage : int) {
    var ang : uint
    var saved : int
    var player : player_s?
    var thrust : int
    var temp : int
    if ((target.flags & int(mobjflag_t.MF_SHOOTABLE)) == 0) {
        // shouldn't happen...
        return
    }
    if (target.health <= 0) {
        return
    }
    if ((target.flags & int(mobjflag_t.MF_SKULLFLY)) != 0) {
        target.momz = 0
        target.momy = target.momz
        target.momx = target.momy
    }
    player = target.player
    if (player != null && gameskill == skill_t.sk_baby) {
        // take half damage in trainer mode
        damage >>= 1
    }
    // Some close combat weapons should not
    // inflict thrust and push the victim out of reach,
    // thus kick away unless using the chainsaw.
    if (inflictor != null && (target.flags & int(mobjflag_t.MF_NOCLIP)) == 0 &&
            (source == null || source.player == null || source.player.readyweapon != weapontype_t.wp_chainsaw)) {
        ang = R_PointToAngle2(inflictor.x, inflictor.y, target.x, target.y)
        thrust = damage * (FRACUNIT >> 3) * 100 / target.info.mass
        // make fall forwards sometimes
        if (damage < 40 && damage > target.health && target.z - inflictor.z > 64 * FRACUNIT && (P_Random() & 1) != 0) {
            ang += ANG180
            thrust *= 4
        }
        ang >>= uint(ANGLETOFINESHIFT)
        target.momx += FixedMul(thrust, finecosine[ang])
        target.momy += FixedMul(thrust, finesine[ang])
    }
    // player specific
    if (player != null) {
        // end of game hell hack
        if (target.subsector.sector.special == 11 && damage >= target.health) {
            damage = target.health - 1
        }
        // Below certain threshold,
        // ignore damage in GOD mode, or with INVUL power.
        if (damage < 1000 && ((player.cheats & int(cheat_t.CF_GODMODE)) != 0 || player.powers[int(powertype_t.pw_invulnerability)] != 0)) {
            return
        }
        if (player.armortype != 0) {
            if (player.armortype == 1) {
                saved = damage / 3
            } else {
                saved = damage / 2
            }
            if (player.armorpoints <= saved) {
                // armor is used up
                saved = player.armorpoints
                player.armortype = 0
            }
            player.armorpoints -= saved
            damage -= saved
        }
        // mirror mobj health here for Dave
        player.health -= damage
        if (player.health < 0) {
            player.health = 0
        }
        player.attacker = source
        // add damage after armor / invuln
        player.damagecount += damage
        if (player.damagecount > 100) {
            // teleport stomp does 10k points...
            player.damagecount = 100
        }
        temp = damage < 100 ? damage : 100
        if (intptr(player) == intptr(addr(players[0]) + end_index(consoleplayer, 4))) {
            I_Tactile(40, 10, 40 + temp * 2)
        }
    }
    // do the damage
    target.health -= damage
    if (target.health <= 0) {
        P_KillMobj(source, target)
        return
    }
    if ((P_Random() < target.info.painchance) && (target.flags & int(mobjflag_t.MF_SKULLFLY)) == 0) {
        // fight back!
        target.flags |= int(mobjflag_t.MF_JUSTHIT)
        P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.painstate))
    }
    // we're awake now...
    target.reactiontime = 0
    if ((target.threshold == 0 || target._c_type == mobjtype_t.MT_VILE) && source != null && intptr(source) != intptr(target) &&
            source._c_type != mobjtype_t.MT_VILE) {
        // if not intent on another player,
        // chase after this one
        target.target = source
        target.threshold = BASETHRESHOLD
        if (intptr(target.state) == intptr(addr(states[0]) + end_index(target.info.spawnstate, 967)) && target.info.seestate != int(statenum_t.S_NULL)) {
            P_SetMobjState(target, enum_from_int(type<statenum_t>, target.info.seestate))
        }
    }
}

