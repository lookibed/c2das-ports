// generated by c2das - regenerate, never edit
var maxammo : int[int(ammotype_t.NUMAMMO)] = fixed_array(200, 50, 300, 50)
var clipammo : int[int(ammotype_t.NUMAMMO)] = fixed_array(10, 4, 20, 1)

[c_function]
def P_GiveAmmo(var player : player_s?; ammo : ammotype_t; var num : int) : doom_boolean {
    var oldammo : int
    if (ammo == ammotype_t.am_noammo) {
        return doom_boolean._c_false
    }
    if (uint(ammo) < 0u || uint(ammo) > uint(ammotype_t.NUMAMMO)) {
        // I_Error ("P_GiveAmmo: bad type %i", ammo);
        doom_strcpy(addr(error_buf[0]), cstr("P_GiveAmmo: bad type "))
        doom_concat(addr(error_buf[0]), doom_itoa(int(ammo), 10))
        I_Error(addr(error_buf[0]))
    }
    if (player.ammo[int(ammo)] == player.maxammo[int(ammo)]) {
        return doom_boolean._c_false
    }
    if (num != 0) {
        num *= clipammo[int(ammo)]
    } else {
        num = clipammo[int(ammo)] / 2
    }
    if (gameskill == skill_t.sk_baby || gameskill == skill_t.sk_nightmare) {
        // give double ammo in trainer mode,
        // you'll need in nightmare
        num <<= 1
    }
    oldammo = player.ammo[int(ammo)]
    player.ammo[int(ammo)] += num
    if (player.ammo[int(ammo)] > player.maxammo[int(ammo)]) {
        player.ammo[int(ammo)] = player.maxammo[int(ammo)]
    }
    // If non zero ammo,
    // don't change up weapons,
    // player was lower on purpose.
    if (oldammo != 0) {
        return doom_boolean._c_true
    }
    // We were down to zero,
    // so select a new weapon.
    // Preferences are not user selectable.
    c_switch(ammo) {
        case(ammotype_t.am_clip) {
            if (player.readyweapon == weapontype_t.wp_fist) {
                if (int(player.weaponowned[int(weapontype_t.wp_chaingun)]) != 0) {
                    player.pendingweapon = weapontype_t.wp_chaingun
                } else {
                    player.pendingweapon = weapontype_t.wp_pistol
                }
            }
            break
        }
        case(ammotype_t.am_shell) {
            if (player.readyweapon == weapontype_t.wp_fist || player.readyweapon == weapontype_t.wp_pistol) {
                if (int(player.weaponowned[int(weapontype_t.wp_shotgun)]) != 0) {
                    player.pendingweapon = weapontype_t.wp_shotgun
                }
            }
            break
        }
        case(ammotype_t.am_cell) {
            if (player.readyweapon == weapontype_t.wp_fist || player.readyweapon == weapontype_t.wp_pistol) {
                if (int(player.weaponowned[int(weapontype_t.wp_plasma)]) != 0) {
                    player.pendingweapon = weapontype_t.wp_plasma
                }
            }
            break
        }
        case(ammotype_t.am_misl) {
            if (player.readyweapon == weapontype_t.wp_fist) {
                if (int(player.weaponowned[int(weapontype_t.wp_missile)]) != 0) {
                    player.pendingweapon = weapontype_t.wp_missile
                }
            }
        }
        case(_) {
            break
        }
    }
    return doom_boolean._c_true
}

// P_GiveWeapon
// The weapon name may have a MF_DROPPED flag ored in.
[c_function]
def P_GiveWeapon(var player : player_s?; weapon : weapontype_t; dropped : doom_boolean) : doom_boolean {
    var gaveammo : doom_boolean
    var gaveweapon : doom_boolean
    if (uint(netgame) != 0 && (uint(deathmatch) != 2u) && int(dropped) == 0) {
        // leave placed weapons forever on net games
        if (int(player.weaponowned[int(weapon)]) != 0) {
            return doom_boolean._c_false
        }
        player.bonuscount += BONUSADD
        player.weaponowned[int(weapon)] = doom_boolean._c_true
        if (int(deathmatch) != 0) {
            P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 5)
        } else {
            P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 2)
        }
        player.pendingweapon = weapon
        if (intptr(player) == intptr(addr(players[0]) + end_index(consoleplayer, 4))) {
            S_StartSound(null, int(sfxenum_t.sfx_wpnup))
        }
        return doom_boolean._c_false
    }
    if (weaponinfo[int(weapon)].ammo != ammotype_t.am_noammo) {
        // give one clip with a dropped weapon,
        // two clips with a found weapon
        if (int(dropped) != 0) {
            gaveammo = P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 1)
        } else {
            gaveammo = P_GiveAmmo(player, weaponinfo[int(weapon)].ammo, 2)
        }
    } else {
        gaveammo = doom_boolean._c_false
    }
    if (int(player.weaponowned[int(weapon)]) != 0) {
        gaveweapon = doom_boolean._c_false
    } else {
        gaveweapon = doom_boolean._c_true
        player.weaponowned[int(weapon)] = doom_boolean._c_true
        player.pendingweapon = weapon
    }
    return enum_from_int(type<doom_boolean>, int_of(uint(gaveweapon) != 0 || uint(gaveammo) != 0))
}

// P_GiveBody
// Returns false if the body isn't needed at all
def P_GiveBody(var player : player_s?; num : int) : doom_boolean {
    if (player.health >= MAXHEALTH) {
        return doom_boolean._c_false
    }
    player.health += num
    if (player.health > MAXHEALTH) {
        player.health = MAXHEALTH
    }
    player.mo.health = player.health
    return doom_boolean._c_true
}

// P_GiveArmor
// Returns false if the armor is worse
// than the current armor.
def P_GiveArmor(var player : player_s?; armortype : int) : doom_boolean {
    var hits : int
    hits = armortype * 100
    if (player.armorpoints >= hits) {
        // don't pick up
        return doom_boolean._c_false
    }
    player.armortype = armortype
    player.armorpoints = hits
    return doom_boolean._c_true
}

// P_GiveCard
def P_GiveCard(var player : player_s?; card : card_t) {
    if (int(player.cards[int(card)]) != 0) {
        return
    }
    player.bonuscount = BONUSADD
    player.cards[int(card)] = doom_boolean._c_true
}

// P_GivePower
def P_GivePower(var player : player_s?; power : int) : doom_boolean {
    // powertype_t
    if (power == int(powertype_t.pw_invulnerability)) {
        player.powers[power] = int(powerduration_t.INVULNTICS)
        return doom_boolean._c_true
    }
    if (power == int(powertype_t.pw_invisibility)) {
        player.powers[power] = int(powerduration_t.INVISTICS)
        player.mo.flags |= int(mobjflag_t.MF_SHADOW)
        return doom_boolean._c_true
    }
    if (power == int(powertype_t.pw_infrared)) {
        player.powers[power] = int(powerduration_t.INFRATICS)
        return doom_boolean._c_true
    }
    if (power == int(powertype_t.pw_ironfeet)) {
        player.powers[power] = int(powerduration_t.IRONTICS)
        return doom_boolean._c_true
    }
    if (power == int(powertype_t.pw_strength)) {
        P_GiveBody(player, 100)
        player.powers[power] = 1
        return doom_boolean._c_true
    }
    if (player.powers[power] != 0) {
        // already got it
        return doom_boolean._c_false
    }
    player.powers[power] = 1
    return doom_boolean._c_true
}

// P_TouchSpecialThing
[c_function]
def P_TouchSpecialThing(var special : mobj_s?; var toucher : mobj_s?) {
    var player : player_s?
    var i : int
    var delta : int
    var sound : int
    delta = special.z - toucher.z
    if (delta > toucher.height || delta < -8 * FRACUNIT) {
        // out of reach
        return
    }
    sound = int(sfxenum_t.sfx_itemup)
    player = toucher.player
    // Dead thing touching.
    // Can happen with a sliding player corpse.
    if (toucher.health <= 0) {
        return
    }
    // Identify by sprite.
    c_switch(special.sprite) {
        case(spritenum_t.SPR_ARM1) {
            // armor
            if (int(P_GiveArmor(player, 1)) == 0) {
                return
            }
            player.message = cstr("Picked up the armor.")
            break
        }
        case(spritenum_t.SPR_ARM2) {
            if (int(P_GiveArmor(player, 2)) == 0) {
                return
            }
            player.message = cstr("Picked up the MegaArmor!")
            break
        }
        case(spritenum_t.SPR_BON1) {
            // bonus items
            // can go over 100%
            player.health++
            if (player.health > 200) {
                player.health = 200
            }
            player.mo.health = player.health
            player.message = cstr("Picked up a health bonus.")
            break
        }
        case(spritenum_t.SPR_BON2) {
            // can go over 100%
            player.armorpoints++
            if (player.armorpoints > 200) {
                player.armorpoints = 200
            }
            if (player.armortype == 0) {
                player.armortype = 1
            }
            player.message = cstr("Picked up an armor bonus.")
            break
        }
        case(spritenum_t.SPR_SOUL) {
            player.health += 100
            if (player.health > 200) {
                player.health = 200
            }
            player.mo.health = player.health
            player.message = cstr("Supercharge!")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_MEGA) {
            if (gamemode != GameMode_t.commercial) {
                return
            }
            player.health = 200
            player.mo.health = player.health
            P_GiveArmor(player, 2)
            player.message = cstr("MegaSphere!")
            sound = int(sfxenum_t.sfx_getpow)
            break
        }
        case(spritenum_t.SPR_BKEY) {
            // cards
            // leave cards for everyone
            if (int(player.cards[int(card_t.it_bluecard)]) == 0) {
                player.message = cstr("Picked up a blue keycard.")
            }
            P_GiveCard(player, card_t.it_bluecard)
            if (int(netgame) == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_YKEY) {
            if (int(player.cards[int(card_t.it_yellowcard)]) == 0) {
                player.message = cstr("Picked up a yellow keycard.")
            }
            P_GiveCard(player, card_t.it_yellowcard)
            if (int(netgame) == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_RKEY) {
            if (int(player.cards[int(card_t.it_redcard)]) == 0) {
                player.message = cstr("Picked up a red keycard.")
            }
            P_GiveCard(player, card_t.it_redcard)
            if (int(netgame) == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_BSKU) {
            if (int(player.cards[int(card_t.it_blueskull)]) == 0) {
                player.message = cstr("Picked up a blue skull key.")
            }
            P_GiveCard(player, card_t.it_blueskull)
            if (int(netgame) == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_YSKU) {
            if (int(player.cards[int(card_t.it_yellowskull)]) == 0) {
                player.message = cstr("Picked up a yellow skull key.")
            }
            P_GiveCard(player, card_t.it_yellowskull)
            if (int(netgame) == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_RSKU) {
            if (int(player.cards[int(card_t.it_redskull)]) == 0) {
                player.message = cstr("Picked up a red skull key.")
            }
            P_GiveCard(player, card_t.it_redskull)
            if (int(netgame) == 0) {
                break
            }
            return
        }
        case(spritenum_t.SPR_STIM) {
            // medikits, heals
            if (int(P_GiveBody(player, 10)) == 0) {
                return
            }
            player.message = cstr("Picked up a stimpack.")
            break
        }
        case(spritenum_t.SPR_MEDI) {
            if (int(P_GiveBody(player, 25)) == 0) {
                return
            }
            if (player.health < 25) {
                player.message = cstr("Picked up a medikit that you REALLY need!")
            } else {
                player.message = cstr("Picked up a medikit.")
            }
            break
        }
        case(spritenum_t.SPR_PINV) {
            // power ups
            if (int(P_GivePower(player, int(powertype_t.pw_invulnerability))) == 0) {
