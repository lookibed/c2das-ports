// [c2das] "<key><8 hex digits>" through doom_print.
[c_function]
def private D_PrintHex(var key : uint8?; value : uint) {
    var digits : uint8[9]
    for (i in range(8)) {
        digits[i] = D_PrintHex_hex[(value >> uint(28 - 4 * i)) & 15u]
    }
    digits[8] = 0u8
    invoke(doom_print, key)
    invoke(doom_print, addr(digits[0]))
}

// D_TicChecksums
// [c2das] One line per game tic once D_Display has drawn it, "tic=<gametic> cs=<8 hex digits>
// fb=<8 hex digits>": G_Ticker's checksum of the tic, then the same FNV-1a over the bytes of
// screens[0] as D_Display leaves it (at a wipe's start, the screen the melt starts from).
[c_function]
def private D_TicChecksums {
    var fb : uint = 2166136261u
    if (tic_checksum_tic < 0) {
        return
    }
    for (i in range(SCREENWIDTH * SCREENHEIGHT)) {
        fb ^= uint(screens[0][i])
        fb *= 16777619u
    }
    invoke(doom_print, cstr("tic="))
    invoke(doom_print, doom_itoa(tic_checksum_tic, 10))
    D_PrintHex(cstr(" cs="), tic_checksum_cs)
    D_PrintHex(cstr(" fb="), fb)
    invoke(doom_print, cstr("\n"))
    tic_checksum_tic = -1
}

[c_function]
def D_DoomLoop {
    // [pd] Moved to D_DoomMain()
    // doom_sprintf(filename, "debug%i.txt", consoleplayer);
    // while (1)
    // frame syncronous IO operations
    I_StartFrame()
    // process one or more tics
    if (int(singletics) != 0) {
        I_StartTic()
        D_ProcessEvents()
        G_BuildTiccmd(addr(netcmds[consoleplayer][0]) + end_index(maketic % BACKUPTICS, 12))
        if (int(advancedemo) != 0) {
            D_DoAdvanceDemo()
        }
        M_Ticker()
        G_Ticker()
        gametic++
        maketic++
    } else {
        // will run at least one tic
        TryRunTics()
    }
    // move positional sounds
    S_UpdateSounds(reinterpret<void?>(players[consoleplayer].mo))
    // Update display, next frame, with current state.
    D_Display()
    D_TicChecksums()
}

