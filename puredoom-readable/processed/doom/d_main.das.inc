    var p : int
    var file : uint8[256]
    FindResponseFile()
    IdentifyVersion()
    modifiedgame = doom_boolean._c_false
    nomonsters = enum_from_int(type<doom_boolean>, M_CheckParm(cstr("-nomonsters")))
