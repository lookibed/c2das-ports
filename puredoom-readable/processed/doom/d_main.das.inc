// D_PostEvent
// Called by the I/O functions when input is detected
[c_function]
def D_PostEvent(var ev : event_t?) {
    events[eventhead] = *ev
    eventhead++
    eventhead &= (MAXEVENTS - 1)
}

// D_ProcessEvents
// Send all the events of the given timestamp down the responder chain
[c_function]
def D_ProcessEvents {
    var ev : event_t?
    // IF STORE DEMO, DO NOT ACCEPT INPUT
    if ((gamemode == GameMode_t.commercial) && (W_CheckNumForName(cstr("map01")) < 0)) {
        return
    }
    while (eventtail != eventhead) {
        ev = addr(events[0]) + end_index(eventtail, 4096)
        if (int(M_Responder(ev)) == 0) {
            G_Responder(ev)
        }
        // else menu ate the event
        eventtail++
        eventtail &= (MAXEVENTS - 1)
    }
}

// D_Display
// draw current display, possibly wiping it from the previous
[c_function]
def D_Display {
    var wipestart : int
    var y : int
    var wipe : doom_boolean
    var redrawsbar : doom_boolean
    if (int(nodrawers) != 0) {
        // for comparative timing / profiling
        return
    }
    redrawsbar = doom_boolean._c_false
    // change the view size if needed
    if (int(setsizeneeded) != 0) {
        R_ExecuteSetViewSize()
        // force background redraw
        D_Display_oldgamestate = enum_from_int(type<gamestate_t>, -1)
        D_Display_borderdrawcount = 3
    }
    // save the current screen if about to wipe
    if (gamestate != wipegamestate) {
        wipe = doom_boolean._c_true
        wipe_StartScreen(0, 0, SCREENWIDTH, SCREENHEIGHT)
    } else {
        wipe = doom_boolean._c_false
    }
    if (gamestate == gamestate_t.GS_LEVEL && gametic != 0) {
        HU_Erase()
    }
    // do buffered drawing
    c_switch(gamestate) {
        case(gamestate_t.GS_LEVEL) {
            if (gametic == 0) {
                break
            }
            if (int(automapactive) != 0) {
                AM_Drawer()
            }
            if (uint(wipe) != 0 || (viewheight != 200 && uint(D_Display_fullscreen) != 0)) {
                redrawsbar = doom_boolean._c_true
            }
            if (uint(D_Display_inhelpscreensstate) != 0 && int(inhelpscreens) == 0) {
                // just put away the help screen
                redrawsbar = doom_boolean._c_true
            }
            ST_Drawer(enum_from_int(type<doom_boolean>, int_of(viewheight == 200)), redrawsbar)
            D_Display_fullscreen = enum_from_int(type<doom_boolean>, int_of(viewheight == 200))
            break
        }
        case(gamestate_t.GS_INTERMISSION) {
            WI_Drawer()
            break
        }
        case(gamestate_t.GS_FINALE) {
            F_Drawer()
            break
        }
        case(gamestate_t.GS_DEMOSCREEN) {
            D_PageDrawer()
            break
        }
    }
    // draw buffered stuff to screen
    I_UpdateNoBlit()
    // draw the view directly
    if (gamestate == gamestate_t.GS_LEVEL && int(automapactive) == 0 && gametic != 0) {
        R_RenderPlayerView(addr(players[0]) + end_index(displayplayer, 4))
    }
    if (gamestate == gamestate_t.GS_LEVEL && gametic != 0) {
        HU_Drawer()
    }
    // clean up border stuff
    if (gamestate != D_Display_oldgamestate && gamestate != gamestate_t.GS_LEVEL) {
        I_SetPalette(reinterpret<uint8?>(W_CacheLumpName(cstr("PLAYPAL"), PU_CACHE)))
    }
    // see if the border needs to be initially drawn
    if (gamestate == gamestate_t.GS_LEVEL && D_Display_oldgamestate != gamestate_t.GS_LEVEL) {
        // view was not active
        D_Display_viewactivestate = doom_boolean._c_false
        // draw the pattern into the back screen
        R_FillBackScreen()
    }
    // see if the border needs to be updated to the screen
    if (gamestate == gamestate_t.GS_LEVEL && int(automapactive) == 0 && scaledviewwidth != 320) {
        if (uint(menuactive) != 0 || uint(D_Display_menuactivestate) != 0 || int(D_Display_viewactivestate) == 0) {
            D_Display_borderdrawcount = 3
        }
        if (D_Display_borderdrawcount != 0) {
            // erase old menu stuff
            R_DrawViewBorder()
            D_Display_borderdrawcount--
        }
    }
    D_Display_menuactivestate = menuactive
    D_Display_viewactivestate = viewactive
    D_Display_inhelpscreensstate = inhelpscreens
    wipegamestate = gamestate
    D_Display_oldgamestate = wipegamestate
    // draw pause pic
    if (int(paused) != 0) {
        if (int(automapactive) != 0) {
            y = 4
        } else {
            y = viewwindowy + 4
        }
        V_DrawPatchDirect(viewwindowx + (scaledviewwidth - 68) / 2, y, 0, reinterpret<uint8?>(W_CacheLumpName(cstr("M_PAUSE"), PU_CACHE)))
    }
    // menus go directly to the screen
    // menu is drawn even on top of everything
    M_Drawer()
    // send out any new accumulation
    NetUpdate()
    // normal update
    is_wiping_screen = wipe
    if (int(wipe) == 0) {
        // page flip or blit buffer
        I_FinishUpdate()
        return
    }
    // wipe update
    wipe_EndScreen(0, 0, SCREENWIDTH, SCREENHEIGHT)
    wipestart = I_GetTime() - 1
}

