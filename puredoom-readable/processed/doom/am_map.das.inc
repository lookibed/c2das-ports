// Calculates the slope and slope according to the x-axis of a line
// segment in map coordinates (with the upright y-axis n' all) so
// that it can be used with the brain-dead drawing stuff.
def AM_getIslope(var ml : mline_t?; var _c_is : islope_t?) {
    var dx : int
    var dy : int
    dy = ml.a.y - ml.b.y
    dx = ml.b.x - ml.a.x
    if (dy == 0) {
        _c_is.islp = dx < 0 ? -DOOM_MAXINT : DOOM_MAXINT
    } else {
        _c_is.islp = FixedDiv(dx, dy)
    }
    if (dx == 0) {
        _c_is.slp = dy < 0 ? -DOOM_MAXINT : DOOM_MAXINT
    } else {
        _c_is.slp = FixedDiv(dy, dx)
    }
}

def AM_activateNewScale {
    m_x += m_w / 2
    m_y += m_h / 2
    m_w = FTOM(f_w)
    m_h = FTOM(f_h)
    m_x -= m_w / 2
    m_y -= m_h / 2
    m_x2 = m_x + m_w
    m_y2 = m_y + m_h
}

def AM_saveScaleAndLoc {
    old_m_x = m_x
    old_m_y = m_y
    old_m_w = m_w
    old_m_h = m_h
}

def AM_restoreScaleAndLoc {
    m_w = old_m_w
    m_h = old_m_h
    if (followplayer == 0) {
        m_x = old_m_x
        m_y = old_m_y
    } else {
        m_x = am_map_plr.mo.x - m_w / 2
        m_y = am_map_plr.mo.y - m_h / 2
    }
    m_x2 = m_x + m_w
    m_y2 = m_y + m_h
    // Change the scaling multipliers
    scale_mtof = FixedDiv(f_w << FRACBITS, m_w)
    scale_ftom = FixedDiv(FRACUNIT, scale_mtof)
}

// adds a marker at the current location
def AM_addMark {
    markpoints[markpointnum].x = m_x + m_w / 2
    markpoints[markpointnum].y = m_y + m_h / 2
    markpointnum = (markpointnum + 1) % AM_NUMMARKPOINTS
}

// Determines bounding box of all vertices,
// sets global variables controlling zoom range.
[c_function]
def AM_findMinMaxBoundaries {
    var a : int
    var b : int
    min_y = DOOM_MAXINT
    min_x = min_y
    max_y = -DOOM_MAXINT
    max_x = max_y
    for (i in range(numvertexes)) {
        if (vertexes[i].x < min_x) {
            min_x = vertexes[i].x
        } elif (vertexes[i].x > max_x) {
            max_x = vertexes[i].x
        }
        if (vertexes[i].y < min_y) {
            min_y = vertexes[i].y
        } elif (vertexes[i].y > max_y) {
            max_y = vertexes[i].y
        }
    }
    max_w = max_x - min_x
    max_h = max_y - min_y
    // const? never changed?
    min_w = 2 * 16 * FRACUNIT
    min_h = 2 * 16 * FRACUNIT
    a = FixedDiv(f_w << FRACBITS, max_w)
    b = FixedDiv(f_h << FRACBITS, max_h)
    min_scale_mtof = a < b ? a : b
    max_scale_mtof = FixedDiv(f_h << FRACBITS, 2 * 16 * FRACUNIT)
}

def AM_changeWindowLoc {
    if (m_paninc.x != 0 || m_paninc.y != 0) {
        followplayer = 0
        f_oldloc.x = DOOM_MAXINT
    }
    m_x += m_paninc.x
    m_y += m_paninc.y
    if (m_x + m_w / 2 > max_x) {
        m_x = max_x - m_w / 2
    } elif (m_x + m_w / 2 < min_x) {
        m_x = min_x - m_w / 2
    }
    if (m_y + m_h / 2 > max_y) {
        m_y = max_y - m_h / 2
    } elif (m_y + m_h / 2 < min_y) {
        m_y = min_y - m_h / 2
    }
    m_x2 = m_x + m_w
    m_y2 = m_y + m_h
}

[c_function]
def AM_initVariables {
    var pnum : int
    automapactive = doom_boolean._c_true
    fb = screens[0]
    f_oldloc.x = DOOM_MAXINT
    amclock = 0
    lightlev = 0
    m_paninc.y = 0
    m_paninc.x = m_paninc.y
    ftom_zoommul = FRACUNIT
    mtof_zoommul = FRACUNIT
    m_w = FTOM(f_w)
    m_h = FTOM(f_h)
    // find player to center on initially
    pnum = consoleplayer
    if (int(playeringame[pnum]) == 0) {
        pnum = 0
        while (pnum < MAXPLAYERS) {
            if (int(playeringame[pnum]) != 0) {
                break
            }
            pnum++
        }
    }
    am_map_plr = addr(players[0]) + end_index(pnum, 4)
    m_x = am_map_plr.mo.x - m_w / 2
    m_y = am_map_plr.mo.y - m_h / 2
    AM_changeWindowLoc()
    // for saving & restoring
    old_m_x = m_x
    old_m_y = m_y
    old_m_w = m_w
    old_m_h = m_h
    // inform the status bar of the change
    ST_Responder(addr(AM_initVariables_st_notify))
}

[c_function]
def AM_loadPics {
    var namebuf : uint8[9]
    for (i in range(10)) {
        doom_concat(doom_strcpy(addr(namebuf[0]), cstr("AMMNUM")), doom_itoa(i, 10))
        marknums[i] = reinterpret<uint8?>(W_CacheLumpName(addr(namebuf[0]), PU_STATIC))
    }
}

[c_function]
def AM_unloadPics {
    for (i in range(10)) {
        if (reinterpret<memblock_s?>(reinterpret<uint8?>(marknums[i]) + -int64(uint64(typeinfo sizeof(type<memblock_s>)))).id != 1919505) {
            var buf : uint8[260]
            doom_strcpy(addr(buf[0]), cstr("Error: Z_CT at /root/wt-pdr-proc/doom/work/src/am_map.c:"))
            doom_concat(addr(buf[0]), doom_itoa(509, 10))
            I_Error(addr(buf[0]))
        }
        Z_ChangeTag2(reinterpret<void?>(marknums[i]), PU_CACHE)
    }
}

def AM_clearMarks {
    for (i in range(AM_NUMMARKPOINTS)) {
        // means empty
        markpoints[i].x = -1
    }
    markpointnum = 0
}

// should be called at the start of every level
// right now, i figure it out myself
def AM_LevelInit {
    leveljuststarted = 0
    f_y = 0
    f_x = f_y
    f_w = finit_width
    f_h = finit_height
    AM_clearMarks()
    AM_findMinMaxBoundaries()
    scale_mtof = FixedDiv(min_scale_mtof, int(0.7lf * double(FRACUNIT)))
    if (scale_mtof > max_scale_mtof) {
        scale_mtof = min_scale_mtof
    }
    scale_ftom = FixedDiv(FRACUNIT, scale_mtof)
}

[c_function]
def AM_Stop {
    AM_unloadPics()
    automapactive = doom_boolean._c_false
    ST_Responder(addr(AM_Stop_st_notify))
    stopped = doom_boolean._c_true
}

def AM_Start {
    if (int(stopped) == 0) {
        AM_Stop()
    }
    stopped = doom_boolean._c_false
    if (AM_Start_lastlevel != gamemap || AM_Start_lastepisode != gameepisode) {
        AM_LevelInit()
        AM_Start_lastlevel = gamemap
        AM_Start_lastepisode = gameepisode
    }
    AM_initVariables()
    AM_loadPics()
}

// set the window scale to the maximum size
def AM_minOutWindowScale {
    scale_mtof = min_scale_mtof
    scale_ftom = FixedDiv(FRACUNIT, scale_mtof)
    AM_activateNewScale()
}

// set the window scale to the minimum size
def AM_maxOutWindowScale {
    scale_mtof = max_scale_mtof
    scale_ftom = FixedDiv(FRACUNIT, scale_mtof)
    AM_activateNewScale()
}

// Handle events (user inputs) in automap mode
[c_function]
def AM_Responder(var ev : event_t?) : doom_boolean {
    var rc : int
    rc = int(doom_boolean._c_false)
    if (int(automapactive) == 0) {
        if (ev._c_type == evtype_t.ev_keydown && ev.data1 == AM_STARTKEY) {
            AM_Start()
            viewactive = doom_boolean._c_false
            rc = int(doom_boolean._c_true)
        }
    } elif (ev._c_type == evtype_t.ev_keydown) {
        rc = int(doom_boolean._c_true)
        c_switch(ev.data1) {
            case(174) {
                // pan right
                if (followplayer == 0) {
                    m_paninc.x = FixedMul(F_PANINC << 16, scale_ftom)
                } else {
                    rc = int(doom_boolean._c_false)
                }
                break
            }
            case(172) {
                // pan left
                if (followplayer == 0) {
                    m_paninc.x = -FTOM(F_PANINC)
                } else {
                    rc = int(doom_boolean._c_false)
                }
                break
            }
            case(173) {
                // pan up
                if (followplayer == 0) {
                    m_paninc.y = FTOM(F_PANINC)
                } else {
                    rc = int(doom_boolean._c_false)
                }
                break
            }
            case(175) {
                // pan down
                if (followplayer == 0) {
                    m_paninc.y = -FTOM(F_PANINC)
                } else {
                    rc = int(doom_boolean._c_false)
                }
                break
            }
            case('-') {
                // zoom out
                mtof_zoommul = M_ZOOMOUT
                ftom_zoommul = M_ZOOMIN
                break
            }
            case('=') {
                // zoom in
                mtof_zoommul = M_ZOOMIN
                ftom_zoommul = M_ZOOMOUT
                break
            }
            case(9) {
                AM_Responder_bigstate = 0
                viewactive = doom_boolean._c_true
                AM_Stop()
                break
            }
            case('0') {
                AM_Responder_bigstate = int_of(AM_Responder_bigstate == 0)
                if (AM_Responder_bigstate != 0) {
                    AM_saveScaleAndLoc()
                    AM_minOutWindowScale()
                } else {
                    AM_restoreScaleAndLoc()
                }
                break
            }
            case('f') {
                followplayer = int_of(followplayer == 0)
                f_oldloc.x = DOOM_MAXINT
                am_map_plr.message = followplayer != 0 ? cstr("Follow Mode ON") : cstr("Follow Mode OFF")
                break
            }
            case('g') {
                grid = int_of(grid == 0)
                am_map_plr.message = grid != 0 ? cstr("Grid ON") : cstr("Grid OFF")
                break
            }
            case('m') {
                doom_strcpy(addr(AM_Responder_buffer[0]), cstr("Marked Spot"))
                doom_concat(addr(AM_Responder_buffer[0]), cstr(" "))
                doom_concat(addr(AM_Responder_buffer[0]), doom_itoa(markpointnum, 10))
                // doom_sprintf(buffer, "%s %d", AMSTR_MARKEDSPOT, markpointnum);
                am_map_plr.message = addr(AM_Responder_buffer[0])
                AM_addMark()
                break
            }
            case('c') {
                AM_clearMarks()
                am_map_plr.message = cstr("All Marks Cleared")
                break
            }
            case(_) {
                AM_Responder_cheatstate = 0
                rc = int(doom_boolean._c_false)
            }
        }
        if (int(deathmatch) == 0 && cht_CheckCheat(addr(cheat_amap), uint8(ev.data1)) != 0) {
            rc = int(doom_boolean._c_false)
            cheating = (cheating + 1) % 3
        }
    } elif (ev._c_type == evtype_t.ev_keyup) {
        rc = int(doom_boolean._c_false)
        c_switch(ev.data1) {
            case(174) {
                if (followplayer == 0) {
                    m_paninc.x = 0
                }
                break
            }
            case(172) {
                if (followplayer == 0) {
                    m_paninc.x = 0
                }
                break
            }
            case(173) {
                if (followplayer == 0) {
                    m_paninc.y = 0
                }
                break
            }
            case(175) {
                if (followplayer == 0) {
                    m_paninc.y = 0
                }
                break
            }
            case('-', '=') {
                mtof_zoommul = FRACUNIT
                ftom_zoommul = FRACUNIT
                break
            }
        }
    }
    return enum_from_int(type<doom_boolean>, rc)
}

// Zooming
def AM_changeWindowScale {
    // Change the scaling multipliers
    scale_mtof = FixedMul(scale_mtof, mtof_zoommul)
    scale_ftom = FixedDiv(FRACUNIT, scale_mtof)
    if (scale_mtof < min_scale_mtof) {
        AM_minOutWindowScale()
    } elif (scale_mtof > max_scale_mtof) {
        AM_maxOutWindowScale()
    } else {
        AM_activateNewScale()
    }
}

def AM_doFollowPlayer {
    if (f_oldloc.x != am_map_plr.mo.x || f_oldloc.y != am_map_plr.mo.y) {
        m_x = FTOM(MTOF(am_map_plr.mo.x)) - m_w / 2
        m_y = FTOM(MTOF(am_map_plr.mo.y)) - m_h / 2
        m_x2 = m_x + m_w
        m_y2 = m_y + m_h
        f_oldloc.x = am_map_plr.mo.x
        f_oldloc.y = am_map_plr.mo.y
    }
}

def AM_updateLightLev {
    // static int litelevels[] = { 0, 3, 5, 6, 6, 7, 7, 7 };
    // Change light level
    if (amclock > AM_updateLightLev_nexttic) {
        let _t0 = AM_updateLightLev_litelevelscnt
        AM_updateLightLev_litelevelscnt++
        lightlev = AM_updateLightLev_litelevels[_t0]
        if (uint64(AM_updateLightLev_litelevelscnt) == uint64(typeinfo sizeof(type<int[8]>)) / uint64(typeinfo sizeof(type<int>))) {
            AM_updateLightLev_litelevelscnt = 0
        }
        AM_updateLightLev_nexttic = amclock + 6 - (amclock % 6)
    }
}

// Updates on Game Tick
def AM_Ticker {
    if (int(automapactive) == 0) {
        return
    }
    amclock++
    if (followplayer != 0) {
        AM_doFollowPlayer()
    }
    // Change the zoom if necessary
    if (ftom_zoommul != FRACUNIT) {
        AM_changeWindowScale()
    }
    // Change x,y location
    if (m_paninc.x != 0 || m_paninc.y != 0) {
        AM_changeWindowLoc()
    }
}

// Clear automap frame buffer.
[c_function]
def AM_clearFB(color : int) {
    doom_memset(reinterpret<void?>(fb), color, f_w * f_h)
}

// Automap clipping of lines.
// Based on Cohen-Sutherland clipping algorithm but with a slightly
// faster reject and precalculated slopes. If the speed is needed,
// use a hash algorithm to handle the common cases.
def AM_clipMline(var ml : mline_t?; var fl : fline_t?) : doom_boolean {
    var outcode1 : int = 0
    var outcode2 : int = 0
    var outside : int
    var tmp : fpoint_t
    var dx : int
    var dy : int
    // do trivial rejects and outcodes
    if (ml.a.y > m_y2) {
        outcode1 = int(anon_545.TOP)
    } elif (ml.a.y < m_y) {
        outcode1 = int(anon_545.BOTTOM)
    }
    if (ml.b.y > m_y2) {
        outcode2 = int(anon_545.TOP)
    } elif (ml.b.y < m_y) {
        outcode2 = int(anon_545.BOTTOM)
    }
    if ((outcode1 & outcode2) != 0) {
        // trivially outside
        return doom_boolean._c_false
    }
    if (ml.a.x < m_x) {
        outcode1 |= int(anon_545.LEFT)
    } elif (ml.a.x > m_x2) {
        outcode1 |= int(anon_545.RIGHT)
    }
    if (ml.b.x < m_x) {
        outcode2 |= int(anon_545.LEFT)
    } elif (ml.b.x > m_x2) {
        outcode2 |= int(anon_545.RIGHT)
    }
    if ((outcode1 & outcode2) != 0) {
        // trivially outside
        return doom_boolean._c_false
    }
    // transform to frame-buffer coordinates.
    fl.a.x = CXMTOF(ml.a.x)
    fl.a.y = CYMTOF(ml.a.y)
    fl.b.x = CXMTOF(ml.b.x)
    fl.b.y = CYMTOF(ml.b.y)
    outcode1 = 0
    if (fl.a.y < 0) {
        outcode1 |= int(anon_545.TOP)
    } elif (fl.a.y >= f_h) {
        outcode1 |= int(anon_545.BOTTOM)
    }
    if (fl.a.x < 0) {
        outcode1 |= int(anon_545.LEFT)
    } elif (fl.a.x >= f_w) {
        outcode1 |= int(anon_545.RIGHT)
    }
    outcode2 = 0
    if (fl.b.y < 0) {
        outcode2 |= int(anon_545.TOP)
    } elif (fl.b.y >= f_h) {
        outcode2 |= int(anon_545.BOTTOM)
    }
    if (fl.b.x < 0) {
        outcode2 |= int(anon_545.LEFT)
    } elif (fl.b.x >= f_w) {
        outcode2 |= int(anon_545.RIGHT)
    }
    if ((outcode1 & outcode2) != 0) {
        return doom_boolean._c_false
    }
    while ((outcode1 | outcode2) != 0) {
        // may be partially inside box
        // find an outside point
        if (outcode1 != 0) {
            outside = outcode1
        } else {
            outside = outcode2
        }
        // clip to each side
        if ((outside & int(anon_545.TOP)) != 0) {
            dy = fl.a.y - fl.b.y
            dx = fl.b.x - fl.a.x
            tmp.x = fl.a.x + (dx * fl.a.y) / dy
            tmp.y = 0
        } elif ((outside & int(anon_545.BOTTOM)) != 0) {
            dy = fl.a.y - fl.b.y
            dx = fl.b.x - fl.a.x
            tmp.x = fl.a.x + (dx * (fl.a.y - f_h)) / dy
            tmp.y = f_h - 1
        } elif ((outside & int(anon_545.RIGHT)) != 0) {
            dy = fl.b.y - fl.a.y
            dx = fl.b.x - fl.a.x
            tmp.y = fl.a.y + (dy * (f_w - 1 - fl.a.x)) / dx
            tmp.x = f_w - 1
        } elif ((outside & int(anon_545.LEFT)) != 0) {
            dy = fl.b.y - fl.a.y
            dx = fl.b.x - fl.a.x
            tmp.y = fl.a.y + (dy * (-fl.a.x)) / dx
            tmp.x = 0
        }
        if (outside == outcode1) {
            fl.a = tmp
            outcode1 = 0
            if (fl.a.y < 0) {
                outcode1 |= int(anon_545.TOP)
            } elif (fl.a.y >= f_h) {
                outcode1 |= int(anon_545.BOTTOM)
            }
            if (fl.a.x < 0) {
                outcode1 |= int(anon_545.LEFT)
            } elif (fl.a.x >= f_w) {
                outcode1 |= int(anon_545.RIGHT)
            }
        } else {
            fl.b = tmp
            outcode2 = 0
            if (fl.b.y < 0) {
                outcode2 |= int(anon_545.TOP)
            } elif (fl.b.y >= f_h) {
                outcode2 |= int(anon_545.BOTTOM)
            }
            if (fl.b.x < 0) {
                outcode2 |= int(anon_545.LEFT)
            } elif (fl.b.x >= f_w) {
                outcode2 |= int(anon_545.RIGHT)
            }
        }
        if ((outcode1 & outcode2) != 0) {
            // trivially outside
            return doom_boolean._c_false
        }
    }
    return doom_boolean._c_true
}

// Classic Bresenham w/ whatever optimizations needed for speed
def AM_drawFline(var fl : fline_t?; color : int) {
    var x : int
    var y : int
    var dx : int
    var dy : int
    var sx : int
    var sy : int
    var ax : int
    var ay : int
    var d : int
    // For debugging only
    // [pd] Don't waste CPU cycles testing this then
    dx = fl.b.x - fl.a.x
    ax = 2 * (dx < 0 ? -dx : dx)
    sx = dx < 0 ? -1 : 1
    dy = fl.b.y - fl.a.y
    ay = 2 * (dy < 0 ? -dy : dy)
    sy = dy < 0 ? -1 : 1
    x = fl.a.x
    y = fl.a.y
    if (ax > ay) {
        d = ay - ax / 2
        while (1 != 0) {
            PUTDOT(x, y, color)
            if (x == fl.b.x) {
                return
            }
            if (d >= 0) {
                y += sy
                d -= ax
            }
            x += sx
            d += ay
        }
    } else {
        d = ax - ay / 2
        while (1 != 0) {
            PUTDOT(x, y, color)
            if (y == fl.b.y) {
                return
            }
            if (d >= 0) {
                x += sx
                d -= ay
            }
            y += sy
            d += ax
        }
    }
}

// Clip lines, draw visible part sof lines.
[c_function]
def AM_drawMline(var ml : mline_t?; color : int) {
    if (int(AM_clipMline(ml, addr(AM_drawMline_fl))) != 0) {
        // draws it on frame buffer using fb coords
        AM_drawFline(addr(AM_drawMline_fl), color)
    }
}

// Draws flat (floor/ceiling tile) aligned grid lines.
[c_function]
def AM_drawGrid(color : int) {
    var x : int
    var y : int
    var start : int
    var end : int
    var ml : mline_t
    // Figure out start of vertical gridlines
    start = m_x
    if ((start - bmaporgx) % (MAPBLOCKUNITS << FRACBITS) != 0) {
        start += (MAPBLOCKUNITS << FRACBITS) - ((start - bmaporgx) % (MAPBLOCKUNITS << FRACBITS))
    }
    end = m_x + m_w
    // draw vertical gridlines
    ml.a.y = m_y
    ml.b.y = m_y + m_h
    x = start
    while (x < end) {
        ml.a.x = x
        ml.b.x = x
        AM_drawMline(addr(ml), color)
        x += MAPBLOCKUNITS << FRACBITS
    }
    // Figure out start of horizontal gridlines
    start = m_y
    if ((start - bmaporgy) % (MAPBLOCKUNITS << FRACBITS) != 0) {
        start += (MAPBLOCKUNITS << FRACBITS) - ((start - bmaporgy) % (MAPBLOCKUNITS << FRACBITS))
    }
    end = m_y + m_h
    // draw horizontal gridlines
    ml.a.x = m_x
    ml.b.x = m_x + m_w
    y = start
    while (y < end) {
        ml.a.y = y
        ml.b.y = y
        AM_drawMline(addr(ml), color)
        y += MAPBLOCKUNITS << FRACBITS
    }
}

// Determines visible lines, draws them.
// This is LineDef based, not LineSeg based.
[c_function]
def AM_drawWalls {
    for (i in range(numlines)) {
        AM_drawWalls_l.a.x = lines[i].v1.x
        AM_drawWalls_l.a.y = lines[i].v1.y
        AM_drawWalls_l.b.x = lines[i].v2.x
        AM_drawWalls_l.b.y = lines[i].v2.y
        if (cheating != 0 || (int(lines[i].flags) & ML_MAPPED) != 0) {
            if ((int(lines[i].flags) & LINE_NEVERSEE) != 0 && cheating == 0) {
                continue
            }
            if (lines[i].backsector == null) {
                AM_drawMline(addr(AM_drawWalls_l), WALLCOLORS + lightlev)
            } else {
                if (lines[i].special == 39) {
                    // teleporters
                    AM_drawMline(addr(AM_drawWalls_l), WALLCOLORS + WALLRANGE / 2)
                } elif ((int(lines[i].flags) & ML_SECRET) != 0) {
                    // secret door
                    if (cheating != 0) {
                        AM_drawMline(addr(AM_drawWalls_l), SECRETWALLCOLORS + lightlev)
                    } else {
                        AM_drawMline(addr(AM_drawWalls_l), WALLCOLORS + lightlev)
                    }
                } elif (lines[i].backsector.floorheight != lines[i].frontsector.floorheight) {
                    // floor level change
                    AM_drawMline(addr(AM_drawWalls_l), FDWALLCOLORS + lightlev)
                } elif (lines[i].backsector.ceilingheight != lines[i].frontsector.ceilingheight) {
                    // ceiling level change
                    AM_drawMline(addr(AM_drawWalls_l), CDWALLCOLORS + lightlev)
                } elif (cheating != 0) {
                    AM_drawMline(addr(AM_drawWalls_l), TSWALLCOLORS + lightlev)
                }
            }
        } elif (am_map_plr.powers[int(powertype_t.pw_allmap)] != 0) {
            if ((int(lines[i].flags) & LINE_NEVERSEE) == 0) {
                AM_drawMline(addr(AM_drawWalls_l), GRAYS + 3)
            }
        }
    }
}

// Rotation in 2D.
// Used to rotate player arrow line character.
[c_function]
def AM_rotate(var x : int?; var y : int?; a : uint) {
    var tmpx : int
    tmpx = FixedMul(*x, finecosine[a >> uint(ANGLETOFINESHIFT)]) - FixedMul(*y, finesine[a >> uint(ANGLETOFINESHIFT)])
    *y = FixedMul(*x, finesine[a >> uint(ANGLETOFINESHIFT)]) + FixedMul(*y, finecosine[a >> uint(ANGLETOFINESHIFT)])
    *x = tmpx
}

[c_function]
def AM_drawLineCharacter(var lineguy : mline_t?; lineguylines : int; scale : int; angle : uint; color : int; x : int; y : int) {
    var l : mline_t
    for (i in range(lineguylines)) {
        l.a.x = lineguy[i].a.x
        l.a.y = lineguy[i].a.y
        if (scale != 0) {
            l.a.x = FixedMul(scale, l.a.x)
            l.a.y = FixedMul(scale, l.a.y)
        }
        if (angle != 0) {
            AM_rotate(addr(l.a.x), addr(l.a.y), angle)
        }
        l.a.x += x
        l.a.y += y
        l.b.x = lineguy[i].b.x
        l.b.y = lineguy[i].b.y
        if (scale != 0) {
            l.b.x = FixedMul(scale, l.b.x)
            l.b.y = FixedMul(scale, l.b.y)
        }
        if (angle != 0) {
            AM_rotate(addr(l.b.x), addr(l.b.y), angle)
        }
        l.b.x += x
        l.b.y += y
        AM_drawMline(addr(l), color)
    }
}

[c_function]
def AM_drawPlayers {
    var p : player_s?
    var their_color : int = -1
    var color : int
    if (int(netgame) == 0) {
        if (cheating != 0) {
            AM_drawLineCharacter(addr(cheat_player_arrow[0]), int(NUMCHEATPLYRLINES), 0, am_map_plr.mo.angle, WHITE, am_map_plr.mo.x, am_map_plr.mo.y)
        } else {
            AM_drawLineCharacter(addr(player_arrow[0]), int(NUMPLYRLINES), 0, am_map_plr.mo.angle, WHITE, am_map_plr.mo.x, am_map_plr.mo.y)
        }
        return
    }
    for (i in range(MAXPLAYERS)) {
        their_color++
        p = addr(players[0]) + end_index(i, 4)
        if ((uint(deathmatch) != 0 && int(singledemo) == 0) && intptr(p) != intptr(am_map_plr)) {
            continue
        }
        if (int(playeringame[i]) == 0) {
            continue
        }
        if (p.powers[int(powertype_t.pw_invisibility)] != 0) {
            // close* to black
            color = 246
        } else {
            color = AM_drawPlayers_their_colors[their_color]
        }
        AM_drawLineCharacter(addr(player_arrow[0]), int(NUMPLYRLINES), 0, p.mo.angle, color, p.mo.x, p.mo.y)
    }
}

[c_function]
def AM_drawThings(colors : int; colorrange : int) {
    var t : mobj_s?
    for (i in range(numsectors)) {
        t = sectors[i].thinglist
        while (t != null) {
            AM_drawLineCharacter(addr(thintriangle_guy[0]), int(NUMTHINTRIANGLEGUYLINES), 16 << FRACBITS, t.angle, colors + lightlev, t.x, t.y)
            t = t.snext
        }
    }
}

def AM_drawMarks {
    var fx : int
    var fy : int
    var w : int
    var h : int
    for (i in range(AM_NUMMARKPOINTS)) {
        if (markpoints[i].x != -1) {
            // w = SHORT(marknums[i]->width);
            // h = SHORT(marknums[i]->height);
            // because something's wrong with the wad, i guess
            w = 5
            // because something's wrong with the wad, i guess
            h = 6
            fx = CXMTOF(markpoints[i].x)
            fy = CYMTOF(markpoints[i].y)
            if (fx >= f_x && fx <= f_w - w && fy >= f_y && fy <= f_h - h) {
                V_DrawPatch(fx, fy, FB, marknums[i])
            }
        }
    }
}

[c_function]
def AM_drawCrosshair(color : int) {
    // single point for now
    fb[(f_w * (f_h + 1)) / 2] = uint8(color)
}

def AM_Drawer {
    if (int(automapactive) == 0) {
        return
    }
    AM_clearFB(BACKGROUND)
    if (grid != 0) {
        AM_drawGrid(GRIDCOLORS)
    }
    AM_drawWalls()
    AM_drawPlayers()
    if (cheating == 2) {
        AM_drawThings(THINGCOLORS, THINGRANGE)
    }
    AM_drawCrosshair(XHAIRCOLORS)
    AM_drawMarks()
    V_MarkRect(f_x, f_y, f_w, f_h)
}

