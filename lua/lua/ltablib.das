// Quicksort algorithm (recursive function)
def private auxsort(var L : lua_State?; var lo : uint; var up : uint; var rnd : uint) {
    // loop for tail recursion
    while (lo < up) {
        // Pivot index
        var p : uint
        // to be used later
        var n : uint
        // sort elements 'lo', 'p', and 'up'
