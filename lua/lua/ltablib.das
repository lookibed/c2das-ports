            // swap a[lo] - a[up]
            set2(L, lo, up)
        } else {
            // remove both values
            lua_settop(L, -2 - 1)
        }
        // only 2 elements?
        if (up - lo == 1u) {
            // already sorted
            return
        }
        // small interval or no randomize?
