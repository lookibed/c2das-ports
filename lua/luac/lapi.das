    } elif (_cond == 6) {
        {
            var data : int = int(va_i(argp))
            res = int(g.gcpause) * 4
            g.gcpause = uint8(data / 4)
        }
    } elif (_cond == 7) {
        {
            var data : int = int(va_i(argp))
            res = int(g.gcstepmul) * 4
            g.gcstepmul = uint8(data / 4)
        }
    } elif (_cond == 9) {
        {
            res = int(g.gcstp) == 0 ? 1 : 0
        }
    } elif (_cond == 10) {
        {
            var minormul : int = int(va_i(argp))
            var majormul : int = int(va_i(argp))
            res = int(g.gckind) == 1 || g.lastatomic != uint64(0) ? 10 : 11
            if (minormul != 0) {
                g.genminormul = uint8(minormul)
            }
            if (majormul != 0) {
                g.genmajormul = uint8(majormul / 4)
            }
            luaC_changemode(L, 1)
        }
    } elif (_cond == 11) {
        {
            var pause : int = int(va_i(argp))
            var stepmul : int = int(va_i(argp))
            var stepsize : int = int(va_i(argp))
            res = int(g.gckind) == 1 || g.lastatomic != uint64(0) ? 10 : 11
            if (pause != 0) {
                g.gcpause = uint8(pause / 4)
            }
            if (stepmul != 0) {
                g.gcstepmul = uint8(stepmul / 4)
            }
            if (stepsize != 0) {
                g.gcstepsize = uint8(stepsize)
            }
            luaC_changemode(L, 0)
        }
    } else {
        res = -1
    }
    return res
}

[c_function]
def lua_error(var L : lua_State?) : int {
    var errobj : TValue?
    errobj = addr((L.top.p - 1).val)
    if (int(errobj.tt_) == (4 | 0 << 4 | 1 << 6) && intptr(addr(reinterpret<GCUnion?>(errobj.value_.gc).ts)) == intptr(L.l_G.memerrmsg)) {
        luaD_throw(L, 4)
    } else {
        luaG_errormsg(L)
    }
    return 0
}

[c_function]
def lua_next(var L : lua_State?; idx : int) : int {
    var t : Table?
    var more : int
    t = gettable(L, idx)
    more = luaH_next(L, t, L.top.p - 1)
    if (more != 0) {
        {
            L.top.p = L.top.p + 1
        }
    } else {
        L.top.p = L.top.p - 1
    }
    return more
}

def lua_toclose(var L : lua_State?; idx : int) {
    var nresults : int
    var o : StackValue?
    o = index2stack(L, idx)
    nresults = int(L.ci.nresults)
    luaF_newtbcupval(L, o)
    if (!(nresults < -1)) {
        L.ci.nresults = int16(-nresults - 3)
    }
}

[c_function]
def lua_concat(var L : lua_State?; n : int) {
    if (n > 0) {
        luaV_concat(L, n)
    } else {
        {
            var io : TValue? = addr(L.top.p.val)
            var x_ : TString? = luaS_newlstr(L, addr(c2das_empty[0]), uint64(0))
            io.value_.gc = addr(reinterpret<GCUnion?>(x_).gc)
            io.tt_ = uint8(int(x_.tt) | 1 << 6)
        }
        {
            L.top.p = L.top.p + 1
        }
    }
    {
        if (L.l_G.GCdebt > int64(0)) {
            luaC_step(L)
        }
    }
}

[c_function]
def lua_len(var L : lua_State?; idx : int) {
    var t : TValue?
    t = index2value(L, idx)
    luaV_objlen(L, L.top.p, t)
    {
        L.top.p = L.top.p + 1
    }
}

[c_function]
def lua_getallocf(var L : lua_State?; var ud : void ??) : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?> {
    var f : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?>
    if (ud != null) {
        deref(ud) = L.l_G.ud
    }
    f = L.l_G.frealloc
    return f
}

def lua_setallocf(var L : lua_State?; f : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?>; var ud : void?) {
    L.l_G.ud = ud
    L.l_G.frealloc = f
}

def lua_setwarnf(var L : lua_State?; f : function<(var a0 : void?; var a1 : uint8?; a2 : int) : void>; var ud : void?) {
    L.l_G.ud_warn = ud
    L.l_G.warnf = f
