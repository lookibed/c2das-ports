            res = int(uint64(g.totalbytes + g.GCdebt) & uint64(1023))
        }
    } elif (_cond == 5) {
        {
            var data : int = int(va_i(argp))
            var debt : int64 = int64(1)
            var oldstp : uint8 = g.gcstp
            g.gcstp = uint8(0)
            if (data == 0) {
