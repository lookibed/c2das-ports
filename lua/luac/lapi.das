def lua_warning(var L : lua_State?; var msg : uint8?; tocont : int) {
    luaE_warning(L, msg, tocont)
}

[c_function]
def lua_newuserdatauv(var L : lua_State?; size : uint64; nuvalue : int) : void? {
    var u : Udata?
    u = luaS_newudata(L, size, nuvalue)
    {
        var io : TValue? = addr(L.top.p.val)
        var x_ : Udata? = u
        io.value_.gc = addr(reinterpret<GCUnion?>(x_).gc)
        io.tt_ = uint8(7 | 0 << 4 | 1 << 6)
    }
    {
        L.top.p = L.top.p + 1
    }
    {
        if (L.l_G.GCdebt > int64(0)) {
            luaC_step(L)
        }
    }
    return reinterpret<void?>(reinterpret<uint8?>(u) + (int(u.nuvalue) == 0 ? uint64(typeinfo offsetof < bindata > (type<Udata0>)) : uint64(typeinfo offsetof < uv > (type<Udata>)) + uint64(typeinfo sizeof(type<UValue>)) * uint64(u.nuvalue)))
}

[c_function]
def private aux_upvalue(var fi : TValue?; n : int; var val : TValue ??; var owner : GCObject ??) : uint8? {
    let _cond = int(fi.tt_) & 63
    if (_cond == 38) {
        {
            var f : CClosure? = addr(reinterpret<GCUnion?>(fi.value_.gc).cl.c)
            if (!(uint(n) - 1u < uint(f.nupvalues))) {
                return null
            }
            deref(val) = addr(deref(addr(f.upvalue[0]) + (n - 1)))
            if (owner != null) {
                deref(owner) = addr(reinterpret<GCUnion?>(f).gc)
            }
            return addr(c2das_empty[0])
        }
    } elif (_cond == 6) {
        {
            var f : LClosure? = addr(reinterpret<GCUnion?>(fi.value_.gc).cl.l)
            var name : TString?
            var p : Proto? = f.p
            if (!(uint(n) - 1u < uint(p.sizeupvalues))) {
                return null
            }
            deref(val) = deref(addr(f.upvals[0]) + (n - 1)).v.p
            if (owner != null) {
                deref(owner) = addr(reinterpret<GCUnion?>(deref(addr(f.upvals[0]) + (n - 1))).gc)
            }
            name = deref(p.upvalues + (n - 1)).name
            return name == null ? reinterpret<uint8?>("(no name)") : addr(name.contents[0])
        }
    } else {
        return null
    }
    return null
}

[c_function]
def lua_getupvalue(var L : lua_State?; funcindex : int; n : int) : uint8? {
    var name : uint8?
    var val : TValue? = null
    name = aux_upvalue(index2value(L, funcindex), n, addr(val), null)
    if (name != null) {
        {
            var io1 : TValue? = addr(L.top.p.val)
            var io2 : TValue? = val
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        {
            L.top.p = L.top.p + 1
        }
    }
    return name
}

[c_function]
def lua_setupvalue(var L : lua_State?; funcindex : int; n : int) : uint8? {
    var name : uint8?
    var val : TValue? = null
    var owner : GCObject? = null
    var fi : TValue?
    fi = index2value(L, funcindex)
    name = aux_upvalue(fi, n, addr(val), addr(owner))
    if (name != null) {
        L.top.p = L.top.p - 1
        {
            var io1 : TValue? = val
            var io2 : TValue? = addr(L.top.p.val)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        if ((int(val.tt_) & 1 << 6) != 0) {
            if ((int(owner.marked) & 1 << 5) != 0 && (int(val.value_.gc.marked) & (1 << 3 | 1 << 4)) != 0) {
                luaC_barrier_(L, addr(reinterpret<GCUnion?>(owner).gc), addr(reinterpret<GCUnion?>(val.value_.gc).gc))
            }
        }
    }
    return name
}

[c_function]
def private getupvalref(var L : lua_State?; fidx : int; n : int; var pf : LClosure ??) : UpVal ?? {
    var f : LClosure?
    var fi : TValue? = index2value(L, fidx)
    f = addr(reinterpret<GCUnion?>(fi.value_.gc).cl.l)
    if (pf != null) {
        deref(pf) = f
    }
    if (1 <= n && n <= f.p.sizeupvalues) {
        return addr(deref(addr(f.upvals[0]) + (n - 1)))
    } else {
        return addr(getupvalref_nullup)
    }
}

[c_function]
def lua_upvalueid(var L : lua_State?; fidx : int; n : int) : void? {
    var fi : TValue? = index2value(L, fidx)
    let _cond = int(fi.tt_) & 63
    while (true) {
        var _flag = false
        _flag ||= _cond == 6
        if (_flag) {
            {
                return reinterpret<void?>(deref(getupvalref(L, fidx, n, null)))
            }
        }
        _flag ||= _cond == 38
        if (_flag) {
            {
                var f : CClosure? = addr(reinterpret<GCUnion?>(fi.value_.gc).cl.c)
                if (1 <= n && n <= int(f.nupvalues)) {
                    return reinterpret<void?>(addr(deref(addr(f.upvalue[0]) + (n - 1))))
                }
            }
        }
        _flag ||= _cond == 22
        if (_flag) {
            return null
        }
        _flag ||= !(_cond == 6 || _cond == 38 || _cond == 22)
        if (_flag) {
            {
                return null
            }
        }
        break
    }
    return null
}

[c_function]
def lua_upvaluejoin(var L : lua_State?; fidx1 : int; n1 : int; fidx2 : int; n2 : int) {
    var f1 : LClosure?
    var up1 : UpVal ?? = getupvalref(L, fidx1, n1, addr(f1))
    var up2 : UpVal ?? = getupvalref(L, fidx2, n2, null)
    deref(up1) = deref(up2)
    if ((int(f1.marked) & 1 << 5) != 0 && (int(deref(up1).marked) & (1 << 3 | 1 << 4)) != 0) {
        luaC_barrier_(L, addr(reinterpret<GCUnion?>(f1).gc), addr(reinterpret<GCUnion?>(deref(up1)).gc))
    }
}

