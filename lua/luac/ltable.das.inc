            *f = *mp
            if (gnext(mp) != 0) {
                // correct 'next'
                f.u.next += int(int64(mp - f))
                // now 'mp' is free
                mp.u.next = 0
            }
            setempty(gval(mp))
        } else {
            // colliding node is in its own main position
            // new node will go into free position
            if (gnext(mp) != 0) {
                // chain new position
                f.u.next = int(int64(mp + gnext(mp) - f))
            } else {
            }
            mp.u.next = int(int64(f - mp))
            mp = f
        }
    }
    {
        var n_ : Node? = mp
        var io_ : TValue? = key
        n_.u.key_val = io_.value_
        n_.u.key_tt = io_.tt_
    }
    if ((int(key.tt_) & BIT_ISCOLLECTABLE) != 0) {
        if ((int(addr(reinterpret<GCUnion?>(t).gc).marked) & (1 << BLACKBIT)) != 0 &&
                (int(key.value_.gc.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
            luaC_barrierback_(L, addr(reinterpret<GCUnion?>(t).gc))
        }
    }
    {
        var io1 : TValue? = addr(mp.i_val)
        var io2 : TValue? = value
        io1.value_ = io2.value_
        io1.tt_ = io2.tt_
    }
}

// Search function for integers. If integer is inside 'alimit', get it
// directly from the array part. Otherwise, if 'alimit' is not
// the real size of the array, the key still can be in the array part.
// In this case, do the "Xmilia trick" to check whether 'key-1' is
// smaller than the real size.
// The trick works as follow: let 'p' be an integer such that
// '2^(p+1) >= alimit > 2^p', or '2^(p+1) > alimit-1 >= 2^p'.
// That is, 2^(p+1) is the real size of the array, and 'p' is the highest
// bit on in 'alimit-1'. What we have to check becomes 'key-1 < 2^(p+1)'.
// We compute '(key-1) & ~(alimit-1)', which we call 'res'; it will
// have the 'p' bit cleared. If the key is outside the array, that is,
// 'key-1 >= 2^(p+1)', then 'res' will have some bit on higher than 'p',
// therefore it will be larger or equal to 'alimit', and the check
// will fail. If 'key-1 < 2^(p+1)', then 'res' has no bit on higher than
// 'p', and as the bit 'p' itself was cleared, 'res' will be smaller
// than 2^p, therefore smaller than 'alimit', and the check succeeds.
// As special cases, when 'alimit' is 0 the condition is trivially false,
// and when 'alimit' is 1 the condition simplifies to 'key-1 < alimit'.
// If key is 0 or negative, 'res' will have its higher bit on, so that
// if cannot be smaller than alimit.
[c_function]
def luaH_getint(var t : Table?; key : int64) : TValue? {
    let alimit : uint64 = uint64(t.alimit)
    // 'key' in [1, t->alimit]?
    if (uint64(key) - uint64(1u) < alimit) {
        return addr(t._c_array[key - 1l])
    } elif ((int(t.flags) & BITRAS) != 0 && (((uint64(key) - uint64(1u)) & ~(alimit - uint64(1u))) < alimit)) {
        // key still may be in the array part?
        // probably '#t' is here now
        t.alimit = uint(key)
        return addr(t._c_array[key - 1l])
    } else {
        // key is not in the array part; check the hash
        var n : Node? = hashint(t, key)
        // check whether 'key' is somewhere in the chain
        while (true) {
            if (keyisinteger(n) && keyival(n) == key) {
                // that's it
                return gval(n)
            } else {
                let nx : int = gnext(n)
                if (nx == 0) {
                    break
                }
                n += nx
            }
        }
        return addr(absentkey)
    }
}

// search function for short strings
[c_function]
def luaH_getshortstr(var t : Table?; var key : TString?) : TValue? {
    var n : Node? = hashstr(t, key)
    // check whether 'key' is somewhere in the chain
    while (true) {
        if (keyisshrstr(n) && eqshrstr(keystrval(n), key)) {
            // that's it
            return gval(n)
        } else {
            let nx : int = gnext(n)
            if (nx == 0) {
                // not found
                return addr(absentkey)
            }
            n += nx
        }
    }
    return null
}

[c_function]
def luaH_getstr(var t : Table?; var key : TString?) : TValue? {
    if (int(key.tt) == LUA_VSHRSTR) {
        return luaH_getshortstr(t, key)
    } else {
        // for long strings, use generic case
        var ko : TValue
        {
            var io : TValue? = addr(ko)
            var x_ : TString? = key
            io.value_.gc = addr(reinterpret<GCUnion?>(x_).gc)
            io.tt_ = uint8(int(x_.tt) | BIT_ISCOLLECTABLE)
            let _t0 = reinterpret<lua_State?>(null)
        }
        return getgeneric(t, addr(ko), 0)
    }
}

// main search function
[c_function]
def luaH_get(var t : Table?; var key : TValue?) : TValue? {
    c_switch(ttypetag(key)) {
        case(4) {
            return luaH_getshortstr(t, tsvalue(key))
        }
        case(3) {
            return luaH_getint(t, ivalue(key))
        }
        case(0) {
            return addr(absentkey)
        }
        case(19) {
            {
                var k : int64
                // integral index?
                if (luaV_flttointeger(fltvalue(key), addr(k), F2Imod.F2Ieq) != 0) {
                    // use specialized version
                    return luaH_getint(t, k)
                }
            }
        }
        case(_) {
            // else...
            // FALLTHROUGH
            return getgeneric(t, key, 0)
        }
    }
    return null
}

// Finish a raw "set table" operation, where 'slot' is where the value
// should have been (the result of a previous "get table").
// Beware: when using this function you probably need to check a GC
// barrier and invalidate the TM cache.
def luaH_finishset(var L : lua_State?; var t : Table?; var key : TValue?; var slot : TValue?; var value : TValue?) {
    if (isabstkey(slot)) {
        luaH_newkey(L, t, key, value)
    } else {
        var io1 : TValue? = slot
        var io2 : TValue? = value
        io1.value_ = io2.value_
        io1.tt_ = io2.tt_
    }
}

// beware: when using this function you probably need to check a GC
// barrier and invalidate the TM cache.
def luaH_set(var L : lua_State?; var t : Table?; var key : TValue?; var value : TValue?) {
    var slot : TValue? = luaH_get(t, key)
    luaH_finishset(L, t, key, slot, value)
}

[c_function]
def luaH_setint(var L : lua_State?; var t : Table?; key : int64; var value : TValue?) {
    var p : TValue? = luaH_getint(t, key)
    if (isabstkey(p)) {
        var k : TValue
        setivalue(addr(k), key)
        luaH_newkey(L, t, addr(k), value)
    } else {
        var io1 : TValue? = p
        var io2 : TValue? = value
        io1.value_ = io2.value_
        io1.tt_ = io2.tt_
    }
}

// Try to find a boundary in the hash part of table 't'. From the
// caller, we know that 'j' is zero or present and that 'j + 1' is
// present. We want to find a larger key that is absent from the
// table, so that we can do a binary search between the two keys to
// find a boundary. We keep doubling 'j' until we get an absent index.
// If the doubling would overflow, we try LUA_MAXINTEGER. If it is
// absent, we are ready for the binary search. ('j', being max integer,
// is larger or equal to 'i', but it cannot be equal because it is
// absent while 'i' is present; so 'j > i'.) Otherwise, 'j' is a
// boundary. ('j + 1' cannot be a present integer key because it is
// not a valid integer in Lua.)
def private hash_search(var t : Table?; var j : uint64) : uint64 {
    var i : uint64
    // the caller ensures 'j + 1' is present
    if (j == 0ul) {
        j++
    }
    c_do_while(!((int(luaH_getint(t, int64(j)).tt_) & 15) == LUA_TNIL)) {
        // 'i' is a present index
        i = j
        if (j <= uint64(9223372036854775807l) / 2ul) {
            j *= 2ul
        } else {
            j = uint64(9223372036854775807l)
            // t[j] not present?
            if ((int(luaH_getint(t, int64(j)).tt_) & 15) == LUA_TNIL) {
                // 'j' now is an absent index
                break
            } else {
                // weird case
                // well, max integer is a boundary...
                return j
            }
        }
    }
    // repeat until an absent t[j]
    // i < j && t[i] present && t[j] absent
    // do a binary search between them
    while (j - i > uint64(1u)) {
        let m : uint64 = (i + j) / 2ul
        if ((int(luaH_getint(t, int64(m)).tt_) & 15) == LUA_TNIL) {
            j = m
        } else {
            i = m
        }
    }
    return i
}

[c_function]
def private binsearch(var _c_array : TValue?; var i : uint; var j : uint) : uint {
    // binary search
    while (j - i > 1u) {
        let m : uint = (i + j) / 2u
        if (isempty(addr(_c_array[m - 1u]))) {
            j = m
        } else {
            i = m
        }
    }
    return i
}

// Try to find a boundary in table 't'. (A 'boundary' is an integer index
// such that t[i] is present and t[i+1] is absent, or 0 if t[1] is absent
// and 'maxinteger' if t[maxinteger] is present.)
// (In the next explanation, we use Lua indices, that is, with base 1.
// The code itself uses base 0 when indexing the array part of the table.)
// The code starts with 'limit = t->alimit', a position in the array
// part that may be a boundary.
// (1) If 't[limit]' is empty, there must be a boundary before it.
// As a common case (e.g., after 't[#t]=nil'), check whether 'limit-1'
// is present. If so, it is a boundary. Otherwise, do a binary search
// between 0 and limit to find a boundary. In both cases, try to
// use this boundary as the new 'alimit', as a hint for the next call.
// (2) If 't[limit]' is not empty and the array has more elements
// after 'limit', try to find a boundary there. Again, try first
// the special case (which should be quite frequent) where 'limit+1'
// is empty, so that 'limit' is a boundary. Otherwise, check the
// last element of the array part. If it is empty, there must be a
// boundary between the old limit (present) and the last element
// (absent), which is found with a binary search. (This boundary always
// can be a new limit.)
// (3) The last case is when there are no elements in the array part
// (limit == 0) or its last element (the new limit) is present.
// In this case, must check the hash part. If there is no hash part
// or 'limit+1' is absent, 'limit' is a boundary. Otherwise, call
// 'hash_search' to find a boundary in the hash part of the table.
// (In those cases, the boundary is not inside the array part, and
// therefore cannot be used as a new limit.)
[c_function]
def luaH_getn(var t : Table?) : uint64 {
    var limit : uint = t.alimit
    // (1)?
    if (limit > 0u && ttype(addr(t._c_array[limit - 1u])) == LUA_TNIL) {
        // there must be a boundary before 'limit'
        if (limit >= 2u && !(ttype(addr(t._c_array[limit - 2u])) == LUA_TNIL)) {
            // 'limit - 1' is a boundary; can it be a new limit?
            if (ispow2realasize(t) != 0 && !ispow2(limit - 1u)) {
                t.alimit = limit - 1u
                // now 'alimit' is not the real size
                setnorealasize(t)
            }
            return uint64(limit - 1u)
        } else {
            // must search for a boundary in [0, limit]
            let boundary : uint = binsearch(t._c_array, 0u, limit)
            // can this boundary represent the real size of the array?
            if (ispow2realasize(t) != 0 && boundary > luaH_realasize(t) / 2u) {
                // use it as the new limit
                t.alimit = boundary
                setnorealasize(t)
            }
            return uint64(boundary)
        }
    }
    // 'limit' is zero or present in table
    // (2)?
    if (!limitequalsasize(t)) {
        // 'limit' > 0 and array has more elements after 'limit'
        // 'limit + 1' is empty?
        if (ttype(addr(t._c_array[limit])) == LUA_TNIL) {
            // this is the boundary
            return uint64(limit)
        }
        // else, try last element in the array
        limit = luaH_realasize(t)
        // empty?
        if (ttype(addr(t._c_array[limit - 1u])) == LUA_TNIL) {
            // there must be a boundary in the array after old limit,
            // and it must be a valid new limit
            let boundary : uint = binsearch(t._c_array, t.alimit, limit)
            t.alimit = boundary
            return uint64(boundary)
        }
    }
    // else, new limit is present in the table; check the hash part
    // (3) 'limit' is the last element and either is zero or present in table
    if (isdummy(t) || (int(luaH_getint(t, int64(limit + 1u)).tt_) & 15) == LUA_TNIL) {
        // 'limit + 1' is absent
        return uint64(limit)
    } else {
        // 'limit + 1' is also present
        return hash_search(t, uint64(limit))
    }
}

