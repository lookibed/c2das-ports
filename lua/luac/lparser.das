def private block_follow(var ls : LexState?; withuntil : int) : int {
    let _cond = ls.t.token
    if (_cond == 259 || _cond == 260 || _cond == 261 || _cond == 288) {
        return 1
    } elif (_cond == 276) {
        return withuntil
    } else {
        return 0
    }
    return 0
