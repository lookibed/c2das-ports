    f.abslineinfo = reinterpret<AbsLineInfo?>(luaM_shrinkvector_(L, reinterpret<void?>(f.abslineinfo), addr(f.sizeabslineinfo), fs.nabslineinfo, int(uint64(typeinfo sizeof(type<AbsLineInfo>)))))
