    fs.prev = ls.fs
    fs.ls = ls
    ls.fs = fs
    fs.pc = 0
    fs.previousline = f.linedefined
    fs.iwthabs = uint8(0)
    fs.lasttarget = 0
    fs.freereg = uint8(0)
    fs.nk = 0
    fs.nabslineinfo = 0
    fs.np = 0
    fs.nups = uint8(0)
    fs.ndebugvars = int16(0)
    fs.nactvar = uint8(0)
    fs.needclose = uint8(0)
    fs.firstlocal = ls.dyd.actvar.n
    fs.firstlabel = ls.dyd._c_label.n
