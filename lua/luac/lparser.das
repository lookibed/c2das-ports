[c_function]
def private constructor(var ls : LexState?; var t : expdesc?) {
    var fs : FuncState? = ls.fs
    var line : int = ls.linenumber
    var pc : int = luaK_codeABCk(fs, OpCode.OP_NEWTABLE, 0, 0, 0, 0)
