    if (lua_all__tonumeral(e1, null) != 0) {
        lua_all__swapexps(e1, e2)
        flip = 1
    }
    if (op == BinOpr.OPR_ADD && lua_all__isSCint(e2) != 0) {
        lua_all__codebini(fs, OpCode.OP_ADDI, e1, e2, flip, line, TMS.TM_ADD)
