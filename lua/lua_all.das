def luaK_exp2nextreg(var fs : FuncState?; var e : expdesc?) {
    luaK_dischargevars(fs, e)
    lua_all__freeexp(fs, e)
    luaK_reserveregs(fs, 1)
    lua_all__exp2reg(fs, e, int(fs.freereg) - 1)
