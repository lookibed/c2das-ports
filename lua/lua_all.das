def private lua_all__codenot(var fs : FuncState?; var e : expdesc?) {
    let _cond = e.k
    if (_cond == expkind.VNIL || _cond == expkind.VFALSE) {
        {
            e.k = expkind.VTRUE
        }
    } elif (_cond == expkind.VK || _cond == expkind.VKFLT || _cond == expkind.VKINT || _cond == expkind.VKSTR || _cond == expkind.VTRUE) {
        {
            e.k = expkind.VFALSE
        }
    } elif (_cond == expkind.VJMP) {
        {
            lua_all__negatecondition(fs, e)
        }
    } elif (_cond == expkind.VRELOC || _cond == expkind.VNONRELOC) {
        {
            lua_all__discharge2anyreg(fs, e)
            lua_all__freeexp(fs, e)
            e.u.info = luaK_codeABCk(fs, OpCode.OP_NOT, 0, e.u.info, 0, 0)
            e.k = expkind.VRELOC
        }
    } else {
    }
    {
        var temp : int = e.f
        e.f = e.t
        e.t = temp
    }
    lua_all__removevalues(fs, e.f)
    lua_all__removevalues(fs, e.t)
}

[c_function]
def private lua_all__isKstr(var fs : FuncState?; var e : expdesc?) : int {
    return e.k == expkind.VK && !(e.t != e.f) && e.u.info <= (1 << 8) - 1 && int(addr(deref(fs.f.k + e.u.info)).tt_) == (4 | 0 << 4 | 1 << 6) ? 1 : 0
}

def private lua_all__isKint(var e : expdesc?) : int {
    return e.k == expkind.VKINT && !(e.t != e.f) ? 1 : 0
}

def private lua_all__isCint(var e : expdesc?) : int {
    return lua_all__isKint(e) != 0 && uint64(e.u.ival) <= uint64((1 << 8) - 1) ? 1 : 0
}

def private lua_all__isSCint(var e : expdesc?) : int {
    return lua_all__isKint(e) != 0 && lua_all__fitsC(e.u.ival) != 0 ? 1 : 0
}

[c_function]
def private lua_all__isSCnumber(var e : expdesc?; var pi : int?; var isfloat : int?) : int {
    var i : int64
    if (e.k == expkind.VKINT) {
        i = e.u.ival
    } elif (e.k == expkind.VKFLT && luaV_flttointeger(e.u.nval, addr(i), F2Imod.F2Ieq) != 0) {
        deref(isfloat) = 1
    } else {
        return 0
    }
    if (!(e.t != e.f) && lua_all__fitsC(i) != 0) {
        deref(pi) = int(i) + ((1 << 8) - 1 >> 1)
        return 1
    } else {
        return 0
    }
}

def luaK_indexed(var fs : FuncState?; var t : expdesc?; var k : expdesc?) {
    if (k.k == expkind.VKSTR) {
        lua_all__str2K(fs, k)
    }
    if (t.k == expkind.VUPVAL && !(lua_all__isKstr(fs, k) != 0)) {
        luaK_exp2anyreg(fs, t)
    }
    if (t.k == expkind.VUPVAL) {
        var temp : int = t.u.info
        t.u.ind.t = uint8(temp)
        t.u.ind.idx = int16(k.u.info)
        t.k = expkind.VINDEXUP
    } else {
        t.u.ind.t = uint8(t.k == expkind.VLOCAL ? int(t.u._c_var.ridx) : t.u.info)
        if (lua_all__isKstr(fs, k) != 0) {
            t.u.ind.idx = int16(k.u.info)
            t.k = expkind.VINDEXSTR
        } elif (lua_all__isCint(k) != 0) {
            t.u.ind.idx = int16(int(k.u.ival))
            t.k = expkind.VINDEXI
        } else {
            t.u.ind.idx = int16(luaK_exp2anyreg(fs, k))
            t.k = expkind.VINDEXED
        }
    }
}

[c_function]
def private lua_all__validop(op : int; var v1 : TValue?; var v2 : TValue?) : int {
    let _cond = op
    if (_cond == 7 || _cond == 8 || _cond == 9 || _cond == 10 || _cond == 11 || _cond == 13) {
        {
            var i : int64
            return luaV_tointegerns(v1, addr(i), F2Imod.F2Ieq) != 0 && luaV_tointegerns(v2, addr(i), F2Imod.F2Ieq) != 0 ? 1 : 0
        }
    } elif (_cond == 5 || _cond == 6 || _cond == 3) {
        return (int(v2.tt_) == (3 | 0 << 4) ? double(v2.value_.i) : v2.value_.n) != double(0) ? 1 : 0
    } else {
        return 1
    }
    return 0
}

[c_function]
def private lua_all__constfolding(var fs : FuncState?; op : int; var e1 : expdesc?; var e2 : expdesc?) : int {
    var v1 : TValue
    var v2 : TValue
    var res : TValue
    if (!(lua_all__tonumeral(e1, addr(v1)) != 0) || !(lua_all__tonumeral(e2, addr(v2)) != 0) || !(lua_all__validop(op, addr(v1), addr(v2)) != 0)) {
        return 0
    }
    luaO_rawarith(fs.ls.L, op, addr(v1), addr(v2), addr(res))
    if (int(addr(res).tt_) == (3 | 0 << 4)) {
        e1.k = expkind.VKINT
        e1.u.ival = addr(res).value_.i
    } else {
        var n : double = addr(res).value_.n
        if (!(n == n) || n == double(0)) {
            return 0
        }
        e1.k = expkind.VKFLT
        e1.u.nval = n
    }
    return 1
}

def private lua_all__binopr2op(opr : BinOpr; baser : BinOpr; base : OpCode) : OpCode {
    return enum_from_int(type<OpCode>, int(opr) - int(baser) + int(base))
}

def private lua_all__unopr2op(opr : UnOpr) : OpCode {
    return enum_from_int(type<OpCode>, int(opr) - int(UnOpr.OPR_MINUS) + int(OpCode.OP_UNM))
}

def private lua_all__binopr2TM(opr : BinOpr) : TMS {
    return enum_from_int(type<TMS>, int(opr) - int(BinOpr.OPR_ADD) + int(TMS.TM_ADD))
}

def private lua_all__codeunexpval(var fs : FuncState?; op : OpCode; var e : expdesc?; line : int) {
    var r : int = luaK_exp2anyreg(fs, e)
    lua_all__freeexp(fs, e)
    e.u.info = luaK_codeABCk(fs, op, 0, r, 0, 0)
    e.k = expkind.VRELOC
    luaK_fixline(fs, line)
}

def private lua_all__finishbinexpval(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?; op : OpCode; v2 : int; flip : int; line : int; mmop : OpCode; event : TMS) {
    var v1 : int = luaK_exp2anyreg(fs, e1)
    var pc : int = luaK_codeABCk(fs, op, 0, v1, v2, 0)
    lua_all__freeexps(fs, e1, e2)
