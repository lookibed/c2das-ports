def luaK_exp2anyreg(var fs : FuncState?; var e : expdesc?) : int {
    luaK_dischargevars(fs, e)
    if (e.k == expkind.VNONRELOC) {
        if (!(e.t != e.f)) {
            return e.u.info
        }
        if (e.u.info >= luaY_nvarstack(fs)) {
            lua_all__exp2reg(fs, e, e.u.info)
            return e.u.info
        }
    }
    luaK_exp2nextreg(fs, e)
    return e.u.info
}

def luaK_exp2anyregup(var fs : FuncState?; var e : expdesc?) {
    if (e.k != expkind.VUPVAL || e.t != e.f) {
        luaK_exp2anyreg(fs, e)
    }
}

def luaK_exp2val(var fs : FuncState?; var e : expdesc?) {
    if (e.k == expkind.VJMP || e.t != e.f) {
        luaK_exp2anyreg(fs, e)
    } else {
        luaK_dischargevars(fs, e)
    }
}

def private lua_all__luaK_exp2K(var fs : FuncState?; var e : expdesc?) : int {
    if (!(e.t != e.f)) {
        var info : int
        let _cond = e.k
        if (_cond == expkind.VTRUE) {
            info = lua_all__boolT(fs)
        } elif (_cond == expkind.VFALSE) {
            info = lua_all__boolF(fs)
        } elif (_cond == expkind.VNIL) {
            info = lua_all__nilK(fs)
        } elif (_cond == expkind.VKINT) {
            info = lua_all__luaK_intK(fs, e.u.ival)
        } elif (_cond == expkind.VKFLT) {
            info = lua_all__luaK_numberK(fs, e.u.nval)
        } elif (_cond == expkind.VKSTR) {
            info = lua_all__stringK(fs, e.u.strval)
        } elif (_cond == expkind.VK) {
            info = e.u.info
        } else {
            return 0
        }
        if (info <= (1 << 8) - 1) {
            e.k = expkind.VK
            e.u.info = info
            return 1
        }
    }
    return 0
}

def private lua_all__exp2RK(var fs : FuncState?; var e : expdesc?) : int {
    if (lua_all__luaK_exp2K(fs, e) != 0) {
        return 1
    } else {
        luaK_exp2anyreg(fs, e)
        return 0
    }
}

def private lua_all__codeABRK(var fs : FuncState?; o : OpCode; a : int; b : int; var ec : expdesc?) {
    var k : int = lua_all__exp2RK(fs, ec)
    luaK_codeABCk(fs, o, a, b, ec.u.info, k)
}

def luaK_storevar(var fs : FuncState?; var _c_var : expdesc?; var ex : expdesc?) {
    let _cond = _c_var.k
    if (_cond == expkind.VLOCAL) {
        {
            lua_all__freeexp(fs, ex)
            lua_all__exp2reg(fs, ex, int(_c_var.u._c_var.ridx))
            return
        }
    } elif (_cond == expkind.VUPVAL) {
        {
            var e : int = luaK_exp2anyreg(fs, ex)
            luaK_codeABCk(fs, OpCode.OP_SETUPVAL, e, _c_var.u.info, 0, 0)
        }
    } elif (_cond == expkind.VINDEXUP) {
        {
            lua_all__codeABRK(fs, OpCode.OP_SETTABUP, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
        }
    } elif (_cond == expkind.VINDEXI) {
        {
            lua_all__codeABRK(fs, OpCode.OP_SETI, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
        }
    } elif (_cond == expkind.VINDEXSTR) {
        {
            lua_all__codeABRK(fs, OpCode.OP_SETFIELD, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
        }
    } elif (_cond == expkind.VINDEXED) {
        {
            lua_all__codeABRK(fs, OpCode.OP_SETTABLE, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
        }
    } else {
    }
    lua_all__freeexp(fs, ex)
}

def luaK_self(var fs : FuncState?; var e : expdesc?; var key : expdesc?) {
    var ereg : int
    luaK_exp2anyreg(fs, e)
    ereg = e.u.info
    lua_all__freeexp(fs, e)
    e.u.info = int(fs.freereg)
    e.k = expkind.VNONRELOC
    luaK_reserveregs(fs, 2)
    lua_all__codeABRK(fs, OpCode.OP_SELF, e.u.info, ereg, key)
    lua_all__freeexp(fs, key)
}

[c_function]
def private lua_all__negatecondition(var fs : FuncState?; var e : expdesc?) {
    var pc : uint? = lua_all__getjumpcontrol(fs, e.u.info)
    deref(pc) = deref(pc) & ~(~(~uint(0) << 1u) << uint(0 + 7 + 8)) | uint(int(deref(pc) >> uint(0 + 7 + 8) & ~(~uint(0) << 1u) << 0u) ^ 1) << uint(0 + 7 + 8) & ~(~uint(0) << 1u) << uint(0 + 7 + 8)
}

[c_function]
def private lua_all__jumponcond(var fs : FuncState?; var e : expdesc?; cond : int) : int {
    if (e.k == expkind.VRELOC) {
        var ie : uint = deref(fs.f.code + e.u.info)
        if (enum_from_int(type<OpCode>, int(ie >> 0u & ~(~uint(0) << 7u) << 0u)) == OpCode.OP_NOT) {
            lua_all__removelastinstruction(fs)
            return lua_all__condjump(fs, OpCode.OP_TEST, int(ie >> uint(0 + 7 + 8 + 1) & ~(~uint(0) << 8u) << 0u), 0, 0, !(cond != 0) ? 1 : 0)
        }
    }
    lua_all__discharge2anyreg(fs, e)
    lua_all__freeexp(fs, e)
    return lua_all__condjump(fs, OpCode.OP_TESTSET, (1 << 8) - 1, e.u.info, 0, cond)
}

[c_function]
def luaK_goiftrue(var fs : FuncState?; var e : expdesc?) {
    var pc : int
    luaK_dischargevars(fs, e)
    let _cond = e.k
    if (_cond == expkind.VJMP) {
        {
            lua_all__negatecondition(fs, e)
            pc = e.u.info
        }
    } elif (_cond == expkind.VK || _cond == expkind.VKFLT || _cond == expkind.VKINT || _cond == expkind.VKSTR || _cond == expkind.VTRUE) {
        {
            pc = -1
        }
    } else {
        {
            pc = lua_all__jumponcond(fs, e, 0)
        }
    }
    luaK_concat(fs, addr(e.f), pc)
    luaK_patchtohere(fs, e.t)
    e.t = -1
}

[c_function]
def luaK_goiffalse(var fs : FuncState?; var e : expdesc?) {
    var pc : int
    luaK_dischargevars(fs, e)
    let _cond = e.k
    if (_cond == expkind.VJMP) {
        {
            pc = e.u.info
        }
    } elif (_cond == expkind.VNIL || _cond == expkind.VFALSE) {
        {
            pc = -1
        }
    } else {
        {
            pc = lua_all__jumponcond(fs, e, 1)
        }
    }
    luaK_concat(fs, addr(e.t), pc)
    luaK_patchtohere(fs, e.f)
    e.f = -1
