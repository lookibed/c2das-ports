    e1.k = expkind.VRELOC
    luaK_fixline(fs, line)
    luaK_codeABCk(fs, mmop, v1, v2, int(event), flip)
    luaK_fixline(fs, line)
}

def private lua_all__codebinexpval(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var op : OpCode = lua_all__binopr2op(opr, BinOpr.OPR_ADD, OpCode.OP_ADD)
    var v2 : int = luaK_exp2anyreg(fs, e2)
    lua_all__finishbinexpval(fs, e1, e2, op, v2, 0, line, OpCode.OP_MMBIN, lua_all__binopr2TM(opr))
