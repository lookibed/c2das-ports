def private lua_all__codebinK(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    var event : TMS = lua_all__binopr2TM(opr)
    var v2 : int = e2.u.info
    var op : OpCode = lua_all__binopr2op(opr, BinOpr.OPR_ADD, OpCode.OP_ADDK)
    lua_all__finishbinexpval(fs, e1, e2, op, v2, flip, line, OpCode.OP_MMBINK, event)
