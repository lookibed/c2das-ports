    }
    op = lua_all__getbinopr(ls.t.token)
    while (op != BinOpr.OPR_NOBINOPR && int(lua_all__priority[int(op)].left) > limit) {
        var v2 : expdesc
        var nextop : BinOpr
        var line : int = ls.linenumber
        luaX_next(ls)
        luaK_infix(ls.fs, op, v)
        nextop = lua_all__subexpr(ls, addr(v2), int(lua_all__priority[int(op)].right))
        luaK_posfix(ls.fs, op, v, addr(v2), line)
        op = nextop
    }
    ls.L.nCcalls--
    return op
