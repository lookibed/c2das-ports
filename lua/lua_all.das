            if (enum_from_int(type<OpCode>, int(i >> 0u & ~(~uint(0) << 7u) << 0u)) != OpCode.OP_TESTSET) {
                return 1
            }
            list = lua_all__getjump(fs, list)
        }
    }
    return 0
}

[c_function]
def private lua_all__exp2reg(var fs : FuncState?; var e : expdesc?; reg : int) {
    lua_all__discharge2reg(fs, e, reg)
    if (e.k == expkind.VJMP) {
        luaK_concat(fs, addr(e.t), e.u.info)
    }
    if (e.t != e.f) {
        var final : int
        var p_f : int = -1
        var p_t : int = -1
        if (lua_all__need_value(fs, e.t) != 0 || lua_all__need_value(fs, e.f) != 0) {
            var fj : int = e.k == expkind.VJMP ? -1 : luaK_jump(fs)
            p_f = lua_all__code_loadbool(fs, reg, OpCode.OP_LFALSESKIP)
            p_t = lua_all__code_loadbool(fs, reg, OpCode.OP_LOADTRUE)
            luaK_patchtohere(fs, fj)
        }
        final = luaK_getlabel(fs)
        lua_all__patchlistaux(fs, e.f, final, reg, p_f)
        lua_all__patchlistaux(fs, e.t, final, reg, p_t)
