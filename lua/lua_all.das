    }
}

def private lua_all__codebitwise(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var flip : int = 0
    if (e1.k == expkind.VKINT) {
        lua_all__swapexps(e1, e2)
        flip = 1
    }
    if (e2.k == expkind.VKINT && lua_all__luaK_exp2K(fs, e2) != 0) {
        lua_all__codebinK(fs, opr, e1, e2, flip, line)
    } else {
        lua_all__codebinNoK(fs, opr, e1, e2, flip, line)
    }
}

[c_function]
def private lua_all__codeorder(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?) {
