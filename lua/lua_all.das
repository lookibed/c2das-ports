[c_function]
def private lua_all__swapexps(var e1 : expdesc?; var e2 : expdesc?) {
    var temp : expdesc = deref(e1)
    deref(e1) = deref(e2)
    deref(e2) = temp
}

def private lua_all__codebinNoK(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    if (flip != 0) {
        lua_all__swapexps(e1, e2)
    }
    lua_all__codebinexpval(fs, opr, e1, e2, line)
}

def private lua_all__codearith(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    if (lua_all__tonumeral(e2, null) != 0 && lua_all__luaK_exp2K(fs, e2) != 0) {
        lua_all__codebinK(fs, opr, e1, e2, flip, line)
