                }
            } elif (_cond == 116) {
                {
                    ar.istailcall = uint8(ci != null ? int(ci.callstatus) & 1 << 5 : 0)
                }
            } elif (_cond == 110) {
                {
                    ar.namewhat = lua_all__getfuncname(L, ci, addr(ar.name))
                    if (ar.namewhat == null) {
                        ar.namewhat = addr(c2das_empty[0])
                        ar.name = null
                    }
                }
            } elif (_cond == 114) {
                {
                    if (ci == null || !((int(ci.callstatus) & 1 << 8) != 0)) {
                        ar.ntransfer = uint16(0)
                        ar.ftransfer = ar.ntransfer
                    } else {
                        ar.ftransfer = ci.u2.transferinfo.ftransfer
                        ar.ntransfer = ci.u2.transferinfo.ntransfer
                    }
                }
            } elif (_cond == 76 || _cond == 102) {
            } else {
                status = 0
            }
            what = what + 1
        }
    }
    return status
}

[c_function]
def lua_getinfo(var L : lua_State?; var what : uint8?; var ar : lua_Debug?) : int {
    var status : int
    var cl : Closure?
    var ci : CallInfo?
    var func : TValue?
    if (int(deref(what)) == 62) {
        ci = null
        func = addr((L.top.p - 1).val)
        what = what + 1
        L.top.p = L.top.p - 1
    } else {
        ci = ar.i_ci
        func = addr(ci.func.p.val)
    }
    cl = int(func.tt_) == (6 | 0 << 4 | 1 << 6) || int(func.tt_) == (6 | 2 << 4 | 1 << 6) ? addr(reinterpret<GCUnion?>(func.value_.gc).cl) : null
    status = lua_all__auxgetinfo(L, what, ar, cl, ci)
    if (crt::strchr(what, 102) != null) {
        {
            var io1 : TValue? = addr(L.top.p.val)
            var io2 : TValue? = func
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        {
            L.top.p = L.top.p + 1
        }
    }
    if (crt::strchr(what, 76) != null) {
        lua_all__collectvalidlines(L, cl)
    }
    return status
}

def private lua_all__filterpc(pc : int; jmptarget : int) : int {
    if (pc < jmptarget) {
        return -1
    } else {
        return pc
    }
}

[c_function]
def private lua_all__findsetreg(var p : Proto?; var lastpc : int; reg : int) : int {
    var pc : int
    var setreg : int = -1
    var jmptarget : int = 0
    if ((int(luaP_opmodes[int(enum_from_int(type<OpCode>, int(deref(p.code + lastpc) >> 0u & ~(~uint(0) << 7u) << 0u)))]) & 1 << 7) != 0) {
        lastpc--
    }
    {
        pc = 0
        while (pc < lastpc) {
            var i : uint = deref(p.code + pc)
            var op : OpCode = enum_from_int(type<OpCode>, int(i >> 0u & ~(~uint(0) << 7u) << 0u))
            var a : int = int(i >> uint(0 + 7) & ~(~uint(0) << 8u) << 0u)
            var change : int
            let _cond = op
            if (_cond == OpCode.OP_LOADNIL) {
                {
                    var b : int = int(i >> uint(0 + 7 + 8 + 1) & ~(~uint(0) << 8u) << 0u)
                    change = a <= reg && reg <= a + b ? 1 : 0
                }
            } elif (_cond == OpCode.OP_TFORCALL) {
                {
                    change = reg >= a + 2 ? 1 : 0
                }
            } elif (_cond == OpCode.OP_CALL || _cond == OpCode.OP_TAILCALL) {
                {
                    change = reg >= a ? 1 : 0
                }
            } elif (_cond == OpCode.OP_JMP) {
                {
                    var b : int = int(i >> uint(0 + 7) & ~(~uint(0) << uint(8 + 8 + 1 + 8)) << 0u) - ((1 << 8 + 8 + 1 + 8) - 1 >> 1)
                    var dest : int = pc + 1 + b
                    if (dest <= lastpc && dest > jmptarget) {
                        jmptarget = dest
                    }
                    change = 0
                }
            } else {
                change = (int(luaP_opmodes[int(op)]) & 1 << 3) != 0 && reg == a ? 1 : 0
            }
            if (change != 0) {
                setreg = lua_all__filterpc(pc, jmptarget)
            }
            pc++
        }
    }
    return setreg
}

[c_function]
def private lua_all__kname(var p : Proto?; index : int; var name : uint8 ??) : uint8? {
    var kvalue : TValue? = addr(deref(p.k + index))
    if ((int(kvalue.tt_) & 15) == 4) {
        deref(name) = addr(addr(reinterpret<GCUnion?>(kvalue.value_.gc).ts).contents[0])
        return reinterpret<uint8?>("constant")
    } else {
        deref(name) = reinterpret<uint8?>("?")
        return null
    }
}

[c_function]
def private lua_all__basicgetobjname(var p : Proto?; var ppc : int?; reg : int; var name : uint8 ??) : uint8? {
    var pc : int = deref(ppc)
    deref(name) = luaF_getlocalname(p, reg + 1, pc)
    if (deref(name) != null) {
        return addr(lua_all__strlocal[0])
    }
    pc = lua_all__findsetreg(p, pc, reg)
    deref(ppc) = pc
    if (pc != -1) {
        var i : uint = deref(p.code + pc)
        var op : OpCode = enum_from_int(type<OpCode>, int(i >> 0u & ~(~uint(0) << 7u) << 0u))
        let _cond = op
        if (_cond == OpCode.OP_MOVE) {
            {
                var b : int = int(i >> uint(0 + 7 + 8 + 1) & ~(~uint(0) << 8u) << 0u)
                if (b < int(i >> uint(0 + 7) & ~(~uint(0) << 8u) << 0u)) {
                    return lua_all__basicgetobjname(p, ppc, b, name)
                }
            }
        } elif (_cond == OpCode.OP_GETUPVAL) {
            {
                deref(name) = lua_all__upvalname(p, int(i >> uint(0 + 7 + 8 + 1) & ~(~uint(0) << 8u) << 0u))
                return addr(lua_all__strupval[0])
            }
        } elif (_cond == OpCode.OP_LOADK) {
            return lua_all__kname(p, int(i >> uint(0 + 7 + 8) & ~(~uint(0) << uint(8 + 8 + 1)) << 0u), name)
        } elif (_cond == OpCode.OP_LOADKX) {
            return lua_all__kname(p, int(deref(p.code + (pc + 1)) >> uint(0 + 7) & ~(~uint(0) << uint(8 + 8 + 1 + 8)) << 0u), name)
        } else {
        }
    }
    return null
}

[c_function]
def private lua_all__rname(var p : Proto?; var pc : int; c : int; var name : uint8 ??) {
    var what : uint8? = lua_all__basicgetobjname(p, addr(pc), c, name)
    if (!(what != null && int(deref(what)) == 99)) {
        deref(name) = reinterpret<uint8?>("?")
    }
}

def private lua_all__rkname(var p : Proto?; pc : int; i : uint; var name : uint8 ??) {
    var c : int = int(i >> uint(0 + 7 + 8 + 1 + 8) & ~(~uint(0) << 8u) << 0u)
    if (int(i >> uint(0 + 7 + 8) & ~(~uint(0) << 1u) << 0u) != 0) {
        lua_all__kname(p, c, name)
    } else {
        lua_all__rname(p, pc, c, name)
    }
}

[c_function]
def private lua_all__isEnv(var p : Proto?; var pc : int; i : uint; isup : int) : uint8? {
    var t : int = int(i >> uint(0 + 7 + 8 + 1) & ~(~uint(0) << 8u) << 0u)
    var name : uint8?
    if (isup != 0) {
        name = lua_all__upvalname(p, t)
    } else {
        var what : uint8? = lua_all__basicgetobjname(p, addr(pc), t, addr(name))
        if (intptr(what) != intptr(addr(lua_all__strlocal[0])) && intptr(what) != intptr(addr(lua_all__strupval[0]))) {
            name = null
        }
    }
    return name != null && crt::strcmp(name, reinterpret<uint8?>("_ENV")) == 0 ? reinterpret<uint8?>("global") : reinterpret<uint8?>("field")
}

[c_function]
def private lua_all__getobjname(var p : Proto?; var lastpc : int; reg : int; var name : uint8 ??) : uint8? {
    var kind : uint8? = lua_all__basicgetobjname(p, addr(lastpc), reg, name)
    if (kind != null) {
        return kind
    } elif (lastpc != -1) {
        var i : uint = deref(p.code + lastpc)
        var op : OpCode = enum_from_int(type<OpCode>, int(i >> 0u & ~(~uint(0) << 7u) << 0u))
        let _cond = op
        if (_cond == OpCode.OP_GETTABUP) {
            {
                var k : int = int(i >> uint(0 + 7 + 8 + 1 + 8) & ~(~uint(0) << 8u) << 0u)
                lua_all__kname(p, k, name)
                return lua_all__isEnv(p, lastpc, i, 1)
            }
        } elif (_cond == OpCode.OP_GETTABLE) {
            {
                var k : int = int(i >> uint(0 + 7 + 8 + 1 + 8) & ~(~uint(0) << 8u) << 0u)
                lua_all__rname(p, lastpc, k, name)
                return lua_all__isEnv(p, lastpc, i, 0)
            }
        } elif (_cond == OpCode.OP_GETI) {
            {
                deref(name) = reinterpret<uint8?>("integer index")
                return reinterpret<uint8?>("field")
            }
        } elif (_cond == OpCode.OP_GETFIELD) {
            {
                var k : int = int(i >> uint(0 + 7 + 8 + 1 + 8) & ~(~uint(0) << 8u) << 0u)
                lua_all__kname(p, k, name)
                return lua_all__isEnv(p, lastpc, i, 0)
            }
        } elif (_cond == OpCode.OP_SELF) {
            {
                lua_all__rkname(p, lastpc, i, name)
                return reinterpret<uint8?>("method")
            }
        } else {
        }
    }
    return null
}

[c_function]
def private lua_all__funcnamefromcode(var L : lua_State?; var p : Proto?; pc : int; var name : uint8 ??) : uint8? {
    var tm : TMS = TMS.TM_INDEX
    var i : uint = deref(p.code + pc)
    let _cond = enum_from_int(type<OpCode>, int(i >> 0u & ~(~uint(0) << 7u) << 0u))
    if (_cond == OpCode.OP_CALL || _cond == OpCode.OP_TAILCALL) {
        return lua_all__getobjname(p, pc, int(i >> uint(0 + 7) & ~(~uint(0) << 8u) << 0u), name)
    } elif (_cond == OpCode.OP_TFORCALL) {
        {
            deref(name) = reinterpret<uint8?>("for iterator")
            return reinterpret<uint8?>("for iterator")
        }
    } elif (_cond == OpCode.OP_SELF || _cond == OpCode.OP_GETTABUP || _cond == OpCode.OP_GETTABLE || _cond == OpCode.OP_GETI || _cond == OpCode.OP_GETFIELD) {
        tm = TMS.TM_INDEX
    } elif (_cond == OpCode.OP_SETTABUP || _cond == OpCode.OP_SETTABLE || _cond == OpCode.OP_SETI || _cond == OpCode.OP_SETFIELD) {
        tm = TMS.TM_NEWINDEX
    } elif (_cond == OpCode.OP_MMBIN || _cond == OpCode.OP_MMBINI || _cond == OpCode.OP_MMBINK) {
        {
            tm = enum_from_int(type<TMS>, int(i >> uint(0 + 7 + 8 + 1 + 8) & ~(~uint(0) << 8u) << 0u))
        }
    } elif (_cond == OpCode.OP_UNM) {
        tm = TMS.TM_UNM
    } elif (_cond == OpCode.OP_BNOT) {
        tm = TMS.TM_BNOT
    } elif (_cond == OpCode.OP_LEN) {
        tm = TMS.TM_LEN
    } elif (_cond == OpCode.OP_CONCAT) {
        tm = TMS.TM_CONCAT
    } elif (_cond == OpCode.OP_EQ) {
        tm = TMS.TM_EQ
    } elif (_cond == OpCode.OP_LT || _cond == OpCode.OP_LTI || _cond == OpCode.OP_GTI) {
        tm = TMS.TM_LT
    } elif (_cond == OpCode.OP_LE || _cond == OpCode.OP_LEI || _cond == OpCode.OP_GEI) {
        tm = TMS.TM_LE
    } elif (_cond == OpCode.OP_CLOSE || _cond == OpCode.OP_RETURN) {
        tm = TMS.TM_CLOSE
    } else {
        return null
    }
    deref(name) = addr(L.l_G.tmname[int(tm)].contents[0]) + 2
    return reinterpret<uint8?>("metamethod")
}

[c_function]
def private lua_all__funcnamefromcall(var L : lua_State?; var ci : CallInfo?; var name : uint8 ??) : uint8? {
    if ((int(ci.callstatus) & 1 << 3) != 0) {
        deref(name) = reinterpret<uint8?>("?")
        return reinterpret<uint8?>("hook")
    } elif ((int(ci.callstatus) & 1 << 7) != 0) {
        deref(name) = reinterpret<uint8?>("__gc")
        return reinterpret<uint8?>("metamethod")
    } elif (!((int(ci.callstatus) & 1 << 1) != 0)) {
        return lua_all__funcnamefromcode(L, addr(reinterpret<GCUnion?>(addr(ci.func.p.val).value_.gc).cl.l).p, lua_all__currentpc(ci), name)
    } else {
        return null
    }
}

[c_function]
def private lua_all__instack(var ci : CallInfo?; var o : TValue?) : int {
    var pos : int
    var base : StackValue? = ci.func.p + 1
    {
        pos = 0
        while (intptr(base + pos) < intptr(ci.top.p)) {
            if (intptr(o) == intptr(reinterpret<TValue?>(addr((base + pos).val)))) {
                return pos
            }
            pos++
        }
    }
    return -1
}

[c_function]
def private lua_all__getupvalname(var ci : CallInfo?; var o : TValue?; var name : uint8 ??) : uint8? {
    var c : LClosure? = addr(reinterpret<GCUnion?>(addr(ci.func.p.val).value_.gc).cl.l)
    var i : int
    {
        i = 0
        while (i < int(c.nupvalues)) {
            if (intptr(deref(addr(c.upvals[0]) + i).v.p) == intptr(reinterpret<TValue?>(o))) {
                deref(name) = lua_all__upvalname(c.p, i)
                return addr(lua_all__strupval[0])
            }
            i++
        }
    }
    return null
}

[c_function]
def private lua_all__formatvarinfo(var L : lua_State?; var kind : uint8?; var name : uint8?) : uint8? {
    if (kind == null) {
        return addr(c2das_empty[0])
    } else {
        return luaO_pushfstring`va(L, reinterpret<uint8?>(" (%s '%s')"), (kind, name))
    }
}

[c_function]
def private lua_all__varinfo(var L : lua_State?; var o : TValue?) : uint8? {
    var ci : CallInfo? = L.ci
    var name : uint8? = null
    var kind : uint8? = null
    if (!((int(ci.callstatus) & 1 << 1) != 0)) {
        kind = lua_all__getupvalname(ci, o, addr(name))
        if (!(kind != null)) {
            var reg : int = lua_all__instack(ci, o)
            if (reg >= 0) {
                kind = lua_all__getobjname(addr(reinterpret<GCUnion?>(addr(ci.func.p.val).value_.gc).cl.l).p, lua_all__currentpc(ci), reg, addr(name))
            }
        }
    }
    return lua_all__formatvarinfo(L, kind, name)
}

[c_function]
def private lua_all__typeerror(var L : lua_State?; var o : TValue?; var op : uint8?; var extra : uint8?) {
    var t : uint8? = luaT_objtypename(L, o)
    luaG_runerror`va(L, reinterpret<uint8?>("attempt to %s a %s value%s"), (op, t, extra))
}

def luaG_typeerror(var L : lua_State?; var o : TValue?; var op : uint8?) {
    lua_all__typeerror(L, o, op, lua_all__varinfo(L, o))
}

[c_function]
def luaG_callerror(var L : lua_State?; var o : TValue?) {
    var ci : CallInfo? = L.ci
    var name : uint8? = null
    var kind : uint8? = lua_all__funcnamefromcall(L, ci, addr(name))
    var extra : uint8? = kind != null ? lua_all__formatvarinfo(L, kind, name) : lua_all__varinfo(L, o)
    lua_all__typeerror(L, o, reinterpret<uint8?>("call"), extra)
}

[c_function]
def luaG_forerror(var L : lua_State?; var o : TValue?; var what : uint8?) {
    luaG_runerror`va(L, reinterpret<uint8?>("bad 'for' %s (number expected, got %s)"), (what, luaT_objtypename(L, o)))
}

[c_function]
def luaG_concaterror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    if ((int(p1.tt_) & 15) == 4 || (int(p1.tt_) & 15) == 3) {
        p1 = p2
    }
    luaG_typeerror(L, p1, reinterpret<uint8?>("concatenate"))
}

def luaG_opinterror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?; var msg : uint8?) {
    if (!((int(p1.tt_) & 15) == 3)) {
        p2 = p1
    }
    luaG_typeerror(L, p2, msg)
}

[c_function]
def luaG_tointerror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    var temp : int64
    if (!(luaV_tointegerns(p1, addr(temp), F2Imod.F2Ieq) != 0)) {
        p2 = p1
    }
    luaG_runerror`va(L, reinterpret<uint8?>("number%s has no integer representation"), (lua_all__varinfo(L, p2),))
}

[c_function]
def luaG_ordererror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    var t1 : uint8? = luaT_objtypename(L, p1)
    var t2 : uint8? = luaT_objtypename(L, p2)
    if (crt::strcmp(t1, t2) == 0) {
        luaG_runerror`va(L, reinterpret<uint8?>("attempt to compare two %s values"), (t1,))
    } else {
        luaG_runerror`va(L, reinterpret<uint8?>("attempt to compare %s with %s"), (t1, t2))
    }
}

[c_function]
def luaG_addinfo(var L : lua_State?; var msg : uint8?; var src : TString?; line : int) : uint8? {
    var buff : uint8[60]
    if (src != null) {
        luaO_chunkid(addr(buff[0]), addr(src.contents[0]), int(src.shrlen) != 255 ? uint64(src.shrlen) : src.u.lnglen)
    } else {
        buff[0] = uint8(63)
        buff[1] = uint8(0)
    }
    return luaO_pushfstring`va(L, reinterpret<uint8?>("%s:%d: %s"), (addr(buff[0]), line, msg))
}

[c_function]
def luaG_errormsg(var L : lua_State?) {
    if (L.errfunc != int64(0)) {
        var errfunc : StackValue? = reinterpret<StackValue?>(reinterpret<uint8?>(L.stack.p) + L.errfunc)
        {
            var io1 : TValue? = addr(L.top.p.val)
            var io2 : TValue? = addr((L.top.p - 1).val)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        {
            var io1 : TValue? = addr((L.top.p - 1).val)
            var io2 : TValue? = addr(errfunc.val)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        L.top.p = L.top.p + 1
        luaD_callnoyield(L, L.top.p - 2, 1)
    }
    luaD_throw(L, 2)
}

[c_function, variadic]
def luaG_runerror(var L : lua_State?; var fmt : uint8?; va : va_args) {
    var ci : CallInfo? = L.ci
    var msg : uint8?
    var argp : CVaCursor
    {
        if (L.l_G.GCdebt > int64(0)) {
            luaC_step(L)
        }
    }
    argp = va_begin(va)
    msg = luaO_pushvfstring(L, fmt, argp)
    if (!((int(ci.callstatus) & 1 << 1) != 0)) {
        luaG_addinfo(L, msg, addr(reinterpret<GCUnion?>(addr(ci.func.p.val).value_.gc).cl.l).p.source, lua_all__getcurrentline(ci))
        {
            var io1 : TValue? = addr((L.top.p - 2).val)
            var io2 : TValue? = addr((L.top.p - 1).val)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        L.top.p = L.top.p - 1
    }
    luaG_errormsg(L)
}

[c_function]
def private lua_all__changedline(var p : Proto?; oldpc : int; newpc : int) : int {
    if (p.lineinfo == null) {
        return 0
    }
    if (newpc - oldpc < 128 / 2) {
        var delta : int = 0
        var pc : int = oldpc
        {
            while (true) {
                pc++
                var lineinfo : int = int(deref(p.lineinfo + pc))
                if (lineinfo == -128) {
                    break
                }
                delta += lineinfo
                if (pc == newpc) {
                    return delta != 0 ? 1 : 0
                }
            }
        }
    }
    return luaG_getfuncline(p, oldpc) != luaG_getfuncline(p, newpc) ? 1 : 0
}

[c_function]
def luaG_tracecall(var L : lua_State?) : int {
    var ci : CallInfo? = L.ci
    var p : Proto? = addr(reinterpret<GCUnion?>(addr(ci.func.p.val).value_.gc).cl.l).p
    c_volatile_store(ci.u.l.trap, 1)
    if (intptr(ci.u.l.savedpc) == intptr(reinterpret<uint?>(p.code))) {
        if (p.is_vararg != 0) {
            return 0
        } elif (!((int(ci.callstatus) & 1 << 6) != 0)) {
            luaD_hookcall(L, ci)
        }
    }
    return 1
}

[c_function]
def luaG_traceexec(var L : lua_State?; var pc : uint?) : int {
    var ci : CallInfo? = L.ci
    var mask : uint8 = uint8(c_volatile_load(L.hookmask))
    var p : Proto? = addr(reinterpret<GCUnion?>(addr(ci.func.p.val).value_.gc).cl.l).p
    var counthook : int
    if (!((int(mask) & (1 << 2 | 1 << 3)) != 0)) {
        c_volatile_store(ci.u.l.trap, 0)
        return 0
    }
    pc = pc + 1
    ci.u.l.savedpc = pc
    var _t0 = (int(mask) & 1 << 3) != 0
    if (_t0) {
        L.hookcount--
        _t0 = L.hookcount == 0
    }
    counthook = _t0 ? 1 : 0
    if (counthook != 0) {
        L.hookcount = L.basehookcount
    } elif (!((int(mask) & 1 << 2) != 0)) {
        return 1
    }
    if ((int(ci.callstatus) & 1 << 6) != 0) {
        ci.callstatus = uint16(int(ci.callstatus) & ~(1 << 6))
        return 1
    }
    if (!((int(luaP_opmodes[int(enum_from_int(type<OpCode>, int(deref(ci.u.l.savedpc - 1) >> 0u & ~(~uint(0) << 7u) << 0u)))]) & 1 << 5) != 0 && int(deref(ci.u.l.savedpc - 1) >> uint(0 + 7 + 8 + 1) & ~(~uint(0) << 8u) << 0u) == 0)) {
        L.top.p = ci.top.p
    }
    if (counthook != 0) {
        luaD_hook(L, 3, -1, 0, 0)
    }
    if ((int(mask) & 1 << 2) != 0) {
        var oldpc : int = L.oldpc < p.sizecode ? L.oldpc : 0
        var npci : int = int(int64(pc - p.code)) - 1
        if (npci <= oldpc || lua_all__changedline(p, oldpc, npci) != 0) {
            var newline : int = luaG_getfuncline(p, npci)
            luaD_hook(L, 2, newline, 0, 0)
        }
        L.oldpc = npci
    }
    if (int(L.status) == 1) {
        if (counthook != 0) {
