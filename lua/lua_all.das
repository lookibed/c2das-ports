            lua_all__report(L, status)
        }
    }
    lua_settop(L, 0)
    crt::fwrite(reinterpret<void?>(reinterpret<uint8?>("\n")), uint64(typeinfo sizeof(type<uint8>)), uint64(1), crt::c_stdout())
    crt::fflush(crt::c_stdout())
    lua_all__progname = oldprogname
}

[c_function]
def private lua_all__pmain(var L : lua_State?) : int {
    var argc : int = int(lua_tointegerx(L, 1, null))
    var argv : uint8 ?? = reinterpret<uint8 ??>(lua_touserdata(L, 2))
    var script : int
    var args : int = lua_all__collectargs(argv, addr(script))
    var optlim : int = script > 0 ? script : argc
    luaL_checkversion_(L, double(504), uint64(typeinfo sizeof(type<int64>)) * uint64(16) + uint64(typeinfo sizeof(type<double>)))
    if (args == 1) {
        lua_all__print_usage(deref(argv + script))
        return 0
    }
    if ((args & 4) != 0) {
        lua_all__print_version()
    }
    if ((args & 16) != 0) {
        lua_pushboolean(L, 1)
        lua_setfield(L, -1000000 - 1000, reinterpret<uint8?>("LUA_NOENV"))
    }
    luaL_openlibs(L)
    lua_all__createargtable(L, argv, argc, script)
    lua_gc`va(L, 1, VaNone())
    lua_gc`va(L, 10, (0, 0))
    if (!((args & 16) != 0)) {
        if (lua_all__handle_luainit(L) != 0) {
            return 0
        }
    }
    if (!(lua_all__runargs(L, argv, optlim) != 0)) {
        return 0
    }
    if (script > 0) {
        if (lua_all__handle_script(L, argv + script) != 0) {
            return 0
        }
    }
    if ((args & 2) != 0) {
        lua_all__doREPL(L)
    } elif (script < 1 && !((args & (8 | 4)) != 0)) {
        if (1 != 0) {
            lua_all__print_version()
            lua_all__doREPL(L)
        } else {
            lua_all__dofile(L, null)
        }
    }
    lua_pushboolean(L, 1)
    return 1
}

[c_function]
def c_main(argc : int; var argv : uint8 ??) : int {
    var status : int
    var result : int
    var L : lua_State? = luaL_newstate()
    if (L == null) {
        lua_all__l_message(deref(argv + 0), reinterpret<uint8?>("cannot create state: not enough memory"))
        return 1
    }
    lua_gc`va(L, 0, VaNone())
    lua_pushcclosure(L, @@lua_all__pmain, 0)
    lua_pushinteger(L, int64(argc))
    lua_pushlightuserdata(L, reinterpret<void?>(argv))
    status = lua_pcallk(L, 2, 1, 0, int64(0), default<function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>>)
    result = lua_toboolean(L, -1)
    lua_all__report(L, status)
    lua_close(L)
    return result != 0 && status == 0 ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("lua_all")
    return c_main(c_argc(), c_argv())
}
