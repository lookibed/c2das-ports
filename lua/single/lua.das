    return 1
}

[c_function]
def private luaB_collectgarbage(var L : lua_State?) : int {
    let o : int = luaB_collectgarbage_optsnum[luaL_checkoption(L, 1, cstr("collect"), addr(luaB_collectgarbage_opts[0]))]
    c_switch(o) {
        case(3) {
