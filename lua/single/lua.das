// Add current char to buffer (if not out of space) and read next one
def private nextc(var rn : RN?) : int {
    // buffer overflow?
    if (rn.n >= L_MAXLENNUM) {
        // invalidate result
        rn.buff[0] = uint8('\0')
        // fail
        return 0
    } else {
        // save current char
        let _t0 = rn.n
        rn.n++
        rn.buff[_t0] = uint8(rn.c)
        // read next one
        rn.c = l_getc(rn.f)
        return 1
    }
}

