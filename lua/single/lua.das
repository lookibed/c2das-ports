    let l : uint64 = crt::strlen(form)
    let lm : uint64 = crt::strlen(lenmod)
    let spec : uint8 = form[l - 1ul]
    crt::strcpy(form + l + -(1), lenmod)
    form[l + lm - 1ul] = spec
    form[l + lm] = uint8('\0')
}

