        if (t > e || t <= f || (tt != 1 && lua_compare(L, 1, tt, LUA_OPEQ) == 0)) {
            for (i1 in range64(n)) {
                lua_geti(L, 1, f + i1)
                lua_seti(L, tt, t + i1)
            }
        } else {
            i = n - 1l
            while (i >= 0l) {
                lua_geti(L, 1, f + i)
                lua_seti(L, tt, t + i)
                i--
            }
