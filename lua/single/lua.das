def private addfield(var L : lua_State?; var b : luaL_Buffer?; i : int64) {
    lua_geti(L, 1, i)
    if (lua_isstring(L, -1) == 0) {
        luaL_error`va(L, cstr("invalid value (%s) at index %I in table for 'concat'"), (luaL_typename(L, -1), i))
    }
    luaL_addvalue(b)
}

[c_function]
def private tconcat(var L : lua_State?) : int {
    var b : luaL_Buffer
    checktab(L, 1, TAB_R | TAB_L)
    var last : int64 = luaL_len(L, 1)
    var lsep : uint64
    var sep : uint8? = luaL_optlstring(L, 2, addr(c2das_empty[0]), addr(lsep))
    var i : int64 = luaL_optinteger(L, 3, 1l)
    last = luaL_optinteger(L, 4, last)
    luaL_buffinit(L, addr(b))
    while (i < last) {
        addfield(L, addr(b), i)
        luaL_addlstring(addr(b), sep, lsep)
        i++
    }
    // add last value (if interval was not empty)
    if (i == last) {
        addfield(L, addr(b), i)
    }
    luaL_pushresult(addr(b))
    return 1
}

def private tpack(var L : lua_State?) : int {
    var i : int
    // number of elements to pack
    let n : int = lua_gettop(L)
    // create result table
    lua_createtable(L, n, 1)
    // put it at index 1
    lua_insert(L, 1)
    // assign elements
    i = n
    while (i >= 1) {
        lua_seti(L, 1, int64(i))
        i--
    }
    lua_pushinteger(L, int64(n))
    // t.n = number of elements
    lua_setfield(L, 1, cstr("n"))
    // return table
    return 1
}

def private tunpack(var L : lua_State?) : int {
    var n : uint64
    var i : int64 = luaL_optinteger(L, 2, 1l)
    let e : int64 = lua_isnoneornil(L, 3) ? luaL_len(L, 1) : luaL_checkinteger(L, 3)
    // empty range
    if (i > e) {
        return 0
    }
    // number of elements minus 1 (avoid overflows)
    n = uint64(e) - uint64(i)
    var _t0 = n >= uint64(2147483647u)
    if (!_t0) {
        n++
        _t0 = lua_checkstack(L, int(n)) == 0
    }
    if (_t0) {
        return luaL_error`va(L, cstr("too many results to unpack"), VaNone())
    }
    // push arg[i..e - 1] (to avoid overflows)
    while (i < e) {
        lua_geti(L, 1, i)
        i++
    }
    // push last element
    lua_geti(L, 1, e)
    return int(n)
}

// Use 'time' and 'clock' as sources of "randomness". Because we don't
// know the types 'clock_t' and 'time_t', we cannot cast them to
// anything without risking overflows. A safe way to use their values
// is to copy them to an array of a known type and use the array values.
[c_function]
def private l_randomizePivot : uint {
    var c : int64 = crt::clock()
    var t : int64 = crt::time(null)
    var buff : uint[4]
    var i : uint
    var rnd : uint = 0u
    crt::memcpy(reinterpret<void?>(addr(buff[0])), reinterpret<void?>(addr(c)),
            uint64(typeinfo sizeof(type<int64>)) / uint64(typeinfo sizeof(type<uint>)) * uint64(typeinfo sizeof(type<uint>)))
    crt::memcpy(reinterpret<void?>(addr(buff[0]) + uint64(typeinfo sizeof(type<int64>)) / uint64(typeinfo sizeof(type<uint>))), reinterpret<void?>(addr(t)),
            uint64(typeinfo sizeof(type<int64>)) / uint64(typeinfo sizeof(type<uint>)) * uint64(typeinfo sizeof(type<uint>)))
    i = 0u
    while (uint64(i) < uint64(typeinfo sizeof(type<uint[4]>)) / uint64(typeinfo sizeof(type<uint>))) {
        rnd += buff[i]
        i++
    }
    return rnd
}

def private set2(var L : lua_State?; i : uint; j : uint) {
    lua_seti(L, 1, int64(i))
    lua_seti(L, 1, int64(j))
}

// Return true iff value at stack index 'a' is less than the value at
// index 'b' (according to the order of the sort).
def private sort_comp(var L : lua_State?; a : int; b : int) : int {
    // no function?
    if (lua_isnil(L, 2)) {
        // a < b
        return lua_compare(L, a, b, LUA_OPLT)
    } else {
        // function
        var res : int
        // push function
        lua_pushvalue(L, 2)
        // -1 to compensate function
        lua_pushvalue(L, a - 1)
        // -2 to compensate function and 'a'
        lua_pushvalue(L, b - 2)
        // call function
        lua_call(L, 2, 1)
        // get result
        res = lua_toboolean(L, -1)
        // pop result
        lua_pop(L, 1)
        return res
    }
}

// Does the partition: Pivot P is at the top of the stack.
// precondition: a[lo] <= P == a[up-1] <= a[up],
// so it only needs to do the partition from lo + 1 to up - 2.
// Pos-condition: a[lo .. i - 1] <= a[i] == P <= a[i + 1 .. up]
// returns 'i'.
def private partition(var L : lua_State?; lo : uint; up : uint) : uint {
    // will be incremented before first use
    var i : uint = lo
    // will be decremented before first use
    var j : uint = up - 1u
    // loop invariant: a[lo .. i] <= P <= a[j .. up]
    while (true) {
        // next loop: repeat ++i while a[i] < P
        while (true) {
            i++
            lua_geti(L, 1, int64(i))
            if (sort_comp(L, -1, -2) == 0) {
                break
            }
            // a[i] < P but a[up - 1] == P ??
            if (i == up - 1u) {
                luaL_error`va(L, cstr("invalid order function for sorting"), VaNone())
            }
            // remove a[i]
            lua_pop(L, 1)
        }
        // after the loop, a[i] >= P and a[lo .. i - 1] < P
        // next loop: repeat --j while P < a[j]
        while (true) {
            j--
            lua_geti(L, 1, int64(j))
            if (sort_comp(L, -3, -1) == 0) {
                break
            }
            // j < i but a[j] > P ??
            if (j < i) {
                luaL_error`va(L, cstr("invalid order function for sorting"), VaNone())
            }
            // remove a[j]
            lua_pop(L, 1)
        }
        // after the loop, a[j] <= P and a[j + 1 .. up] >= P
        // no elements out of place?
        if (j < i) {
            // a[lo .. i - 1] <= P <= a[j + 1 .. i .. up]
            // pop a[j]
            lua_pop(L, 1)
            // swap pivot (a[up - 1]) with a[i] to satisfy pos-condition
            set2(L, up - 1u, i)
            return i
        }
        // otherwise, swap a[i] - a[j] to restore invariant and repeat
        set2(L, i, j)
    }
    return uint(0)
}

// Choose an element in the middle (2nd-3th quarters) of [lo,up]
// "randomized" by 'rnd'
def private choosePivot(lo : uint; up : uint; rnd : uint) : uint {
    // range/4
    let r4 : uint = (up - lo) / 4u
    let p : uint = rnd % (r4 * 2u) + (lo + r4)
    return p
}

// Quicksort algorithm (recursive function)
def private auxsort(var L : lua_State?; var lo : uint; var up : uint; var rnd : uint) {
    // loop for tail recursion
    while (lo < up) {
        // Pivot index
        var p : uint
        // to be used later
        var n : uint
        // sort elements 'lo', 'p', and 'up'
        lua_geti(L, 1, int64(lo))
        lua_geti(L, 1, int64(up))
        // a[up] < a[lo]?
        if (sort_comp(L, -1, -2) != 0) {
            // swap a[lo] - a[up]
            set2(L, lo, up)
        } else {
            // remove both values
            lua_pop(L, 2)
        }
        // only 2 elements?
        if (up - lo == 1u) {
            // already sorted
            return
        }
        // small interval or no randomize?
        if (up - lo < RANLIMIT || rnd == 0u) {
            // middle element is a good pivot
            p = (lo + up) / 2u
        } else {
            // for larger intervals, it is worth a random pivot
            p = choosePivot(lo, up, rnd)
        }
        lua_geti(L, 1, int64(p))
        lua_geti(L, 1, int64(lo))
        // a[p] < a[lo]?
        if (sort_comp(L, -2, -1) != 0) {
            // swap a[p] - a[lo]
            set2(L, p, lo)
        } else {
            // remove a[lo]
            lua_pop(L, 1)
            lua_geti(L, 1, int64(up))
            // a[up] < a[p]?
            if (sort_comp(L, -1, -2) != 0) {
                // swap a[up] - a[p]
                set2(L, p, up)
            } else {
                lua_pop(L, 2)
            }
        }
        // only 3 elements?
        if (up - lo == 2u) {
            // already sorted
            return
        }
        // get middle element (Pivot)
        lua_geti(L, 1, int64(p))
        // push Pivot
        lua_pushvalue(L, -1)
        // push a[up - 1]
        lua_geti(L, 1, int64(up - 1u))
        // swap Pivot (a[p]) with a[up - 1]
        set2(L, p, up - 1u)
        p = partition(L, lo, up)
        // a[lo .. p - 1] <= a[p] == P <= a[p + 1 .. up]
        // lower interval is smaller?
        if (p - lo < up - p) {
            // call recursively for lower interval
            auxsort(L, lo, p - 1u, rnd)
            // size of smaller interval
            n = p - lo
            // tail call for [p + 1 .. up] (upper interval)
            lo = p + 1u
        } else {
            // call recursively for upper interval
            auxsort(L, p + 1u, up, rnd)
            // size of smaller interval
            n = up - p
            // tail call for [lo .. p - 1] (lower interval)
            up = p - 1u
        }
        // partition too imbalanced?
        if ((up - lo) / 128u > n) {
            // try a new randomization
            rnd = l_randomizePivot()
        }
    }
}

def private sort(var L : lua_State?) : int {
    checktab(L, 1, TAB_RW | TAB_L)
    let n : int64 = luaL_len(L, 1)
    // non-trivial interval?
    if (n > 1l) {
        let _t0 = n < 2147483647l || luaL_argerror(L, 1, cstr("array too big")) != 0
        // is there a 2nd argument?
        if (!lua_isnoneornil(L, 2)) {
            // must be a function
            luaL_checktype(L, 2, LUA_TFUNCTION)
        }
        // make sure there are two arguments
        lua_settop(L, 2)
        auxsort(L, 1u, uint(n), 0u)
    }
    return 0
}

[c_function]
def luaopen_table(var L : lua_State?) : int {
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[8]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(tab_funcs[0]), 0)
    return 1
}

// from strlib
// translate a relative string position: negative means back from end
def private u_posrelat(pos : int64; len : uint64) : int64 {
    if (pos >= 0l) {
        return pos
    } elif (uint64(0u) - uint64(pos) > len) {
        return 0l
    } else {
        return int64(len) + pos + 1l
    }
}

// Decode one UTF-8 sequence, returning NULL if byte sequence is
// invalid. The array 'limits' stores the minimum value for each
// sequence length, to check for overlong representations. Its first
// entry forces an error for non-ascii bytes with no continuation
// bytes (count == 0).
[c_function]
def private utf8_decode(var s : uint8?; var val : uint?; strict : int) : uint8? {
    var c : uint = uint(s[0])
    // final result
    var res : uint = 0u
    // ascii?
    if (c < 128u) {
        res = c
    } else {
        // to count number of continuation bytes
        var count : int = 0
        // while it needs continuation bytes...
        while ((c & 64u) != 0) {
            // read next byte
            count++
            let cc : uint = uint(s[count])
            // not a continuation byte?
            if (!iscont(cc)) {
                // invalid byte sequence
                return null
            }
            // add lower 6 bits from cont. byte
            res = (res << 6u) | (cc & 63u)
            c <<= 1u
        }
        // add first byte
        res |= (c & 127u) << uint(count * 5)
        if (count > 5 || res > MAXUTF || res < utf8_decode_limits[count]) {
            // invalid byte sequence
            return null
        }
        // skip continuation bytes read
        s += count
    }
    if (strict != 0) {
        // check for invalid code points; too large or surrogates
        if (res > MAXUNICODE || (55296u <= res && res <= 57343u)) {
            return null
        }
    }
    if (val != null) {
        *val = res
    }
    // +1 to include first byte
    return s + 1
}

// utf8len(s [, i [, j [, lax]]]) --> number of characters that
// start in the range [i,j], or nil + current position if 's' is not
// well formed in that interval
[c_function]
def private utflen(var L : lua_State?) : int {
    // counter for the number of characters
    var n : int64 = 0l
    // string length in bytes
    var len : uint64
    var s : uint8? = luaL_checklstring(L, 1, addr(len))
    var posi : int64 = u_posrelat(luaL_optinteger(L, 2, 1l), len)
    var posj : int64 = u_posrelat(luaL_optinteger(L, 3, -1l), len)
    let lax : int = lua_toboolean(L, 4)
    var _t0 = 1l <= posi
    if (_t0) {
        posi--
        _t0 = posi <= int64(len)
    }
    let _t1 = _t0 || luaL_argerror(L, 2, cstr("initial position out of bounds")) != 0
    posj--
    let _t2 = posj < int64(len) || luaL_argerror(L, 3, cstr("final position out of bounds")) != 0
    while (posi <= posj) {
        var s1 : uint8? = utf8_decode(s + posi, null, int_of(lax == 0))
        // conversion error?
        if (s1 == null) {
            // return fail ...
            luaL_pushfail(L)
            // ... and current position
            lua_pushinteger(L, posi + 1l)
            return 2
        }
        posi = int64(s1 - s)
        n++
    }
    lua_pushinteger(L, n)
    return 1
}

// codepoint(s, [i, [j [, lax]]]) -> returns codepoints for all
// characters that start in the range [i,j]
[c_function]
def private codepoint(var L : lua_State?) : int {
    var len : uint64
    var s : uint8? = luaL_checklstring(L, 1, addr(len))
    let posi : int64 = u_posrelat(luaL_optinteger(L, 2, 1l), len)
    let pose : int64 = u_posrelat(luaL_optinteger(L, 3, posi), len)
    let lax : int = lua_toboolean(L, 4)
    var n : int
    var se : uint8?
    let _t0 = posi >= 1l || luaL_argerror(L, 2, cstr("out of bounds")) != 0
    let _t1 = pose <= int64(len) || luaL_argerror(L, 3, cstr("out of bounds")) != 0
    // empty interval; return no values
    if (posi > pose) {
        return 0
    }
    // (lua_Integer -> int) overflow?
    if (pose - posi >= 2147483647l) {
        return luaL_error`va(L, cstr("string slice too long"), VaNone())
    }
    // upper bound for number of returns
    n = int(pose - posi) + 1
    luaL_checkstack(L, n, cstr("string slice too long"))
    // count the number of returns
    n = 0
    // string end
    se = s + pose
    s += posi - 1l
    while (intptr(s) < intptr(se)) {
        var code : uint
        s = utf8_decode(s, addr(code), int_of(lax == 0))
        if (s == null) {
            return luaL_error`va(L, cstr("invalid UTF-8 code"), VaNone())
        }
        lua_pushinteger(L, int64(code))
        n++
    }
    return n
}

def private pushutfchar(var L : lua_State?; arg : int) {
    let code : uint64 = uint64(luaL_checkinteger(L, arg))
    let _t0 = code <= uint64(MAXUTF) || luaL_argerror(L, arg, cstr("value out of range")) != 0
    lua_pushfstring`va(L, cstr("%U"), (int64(code),))
}

// utfchar(n1, n2, ...) -> char(n1)..char(n2)...
[c_function]
def private utfchar(var L : lua_State?) : int {
    // number of arguments
    let n : int = lua_gettop(L)
    // optimize common case of single char
    if (n == 1) {
        pushutfchar(L, 1)
    } else {
        var i : int
        var b : luaL_Buffer
        luaL_buffinit(L, addr(b))
        i = 1
        while (i <= n) {
            pushutfchar(L, i)
            luaL_addvalue(addr(b))
            i++
        }
        luaL_pushresult(addr(b))
    }
    return 1
}

// offset(s, n, [i]) -> index where n-th character counting from
// position 'i' starts; 0 means character at 'i'.
[c_function]
def private byteoffset(var L : lua_State?) : int {
    var len : uint64
    var s : uint8? = luaL_checklstring(L, 1, addr(len))
    var n : int64 = luaL_checkinteger(L, 2)
    var posi : int64 = int64((n >= 0l) ? 1ul : len + 1ul)
    posi = u_posrelat(luaL_optinteger(L, 3, posi), len)
    var _t0 = 1l <= posi
    if (_t0) {
        posi--
        _t0 = posi <= int64(len)
    }
    let _t1 = _t0 || luaL_argerror(L, 3, cstr("position out of bounds")) != 0
    if (n == 0l) {
        // find beginning of current byte sequence
        while (posi > 0l && iscont(s[posi])) {
            posi--
        }
    } else {
        if (iscont(s[posi])) {
            return luaL_error`va(L, cstr("initial position is a continuation byte"), VaNone())
        }
        if (n < 0l) {
            // move back
            while (n < 0l && posi > 0l) {
                // find beginning of previous character
                c_do_while(posi > 0l && iscont(s[posi])) {
                    posi--
                }
                n++
            }
        } else {
            // do not move for 1st character
            n--
            while (n > 0l && posi < int64(len)) {
                // find beginning of next character
                c_do_while(iscont(s[posi])) {
                    posi++
                }
                // (cannot pass final '\0')
                n--
            }
        }
    }
    // did it find given character?
    if (n == 0l) {
        lua_pushinteger(L, posi + 1l)
    } else {
        // no such character
        luaL_pushfail(L)
    }
    return 1
}

[c_function]
def private iter_aux(var L : lua_State?; strict : int) : int {
    var len : uint64
    var s : uint8? = luaL_checklstring(L, 1, addr(len))
    var n : uint64 = uint64(lua_tointeger(L, 2))
    if (n < len) {
        // go to next character
        while (iscont(s[n])) {
            n++
        }
    }
    // (also handles original 'n' being negative)
    if (n >= len) {
        // no more codepoints
        return 0
    } else {
        var code : uint
        var next : uint8? = utf8_decode(s + n, addr(code), strict)
        if (next == null || iscontp(next)) {
            return luaL_error`va(L, cstr("invalid UTF-8 code"), VaNone())
        }
        lua_pushinteger(L, int64(n + 1ul))
        lua_pushinteger(L, int64(code))
        return 2
    }
}

def private iter_auxstrict(var L : lua_State?) : int {
    return iter_aux(L, 1)
}

def private iter_auxlax(var L : lua_State?) : int {
    return iter_aux(L, 0)
}

def private iter_codes(var L : lua_State?) : int {
    let lax : int = lua_toboolean(L, 2)
    var s : uint8? = luaL_checkstring(L, 1)
    let _t0 = !iscontp(s) || luaL_argerror(L, 1, cstr("invalid UTF-8 code")) != 0
    lua_pushcfunction(L, lax != 0 ? @@iter_auxlax : @@iter_auxstrict)
    lua_pushvalue(L, 1)
    lua_pushinteger(L, 0l)
    return 3
}

[c_function]
def luaopen_utf8(var L : lua_State?) : int {
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[7]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(funcs[0]), 0)
    lua_pushlstring(L, cstr("[\0-\x7f\xc2-\xfd][\x80-\xbf]*"), uint64(typeinfo sizeof(type<uint8[15]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul)
    lua_setfield(L, -2, cstr("charpattern"))
    return 1
}

[c_function]
def luaL_openlibs(var L : lua_State?) {
    var lib : luaL_Reg?
    // "require" functions from 'loadedlibs' and set results to global table
    lib = addr(loadedlibs[0])
    while (lib.func != null) {
        luaL_requiref(L, lib.name, lib.func, 1)
        // remove lib
        lua_pop(L, 1)
        lib++
    }
}

// Hook set by signal function to stop the interpreter.
def private lstop(var L : lua_State?; var ar : lua_Debug?) {
    // unused arg.
    // reset hook
    lua_sethook(L, default<function<(var a0 : lua_State?; var a1 : lua_Debug?) : void>>, 0, 0)
    luaL_error`va(L, cstr("interrupted!"), VaNone())
}

// Function to be called at a C signal. Because a C signal cannot
// just change a Lua state (as there is no proper synchronization),
// this function only sets a hook that, when called, will stop the
// interpreter.
def private laction(i : int) {
    let flag : int = LUA_MASKCALL | LUA_MASKRET | LUA_MASKLINE | LUA_MASKCOUNT
    // if another SIGINT happens, terminate process
    c_signal(i, default<function<(a0 : int) : void>>)
    lua_sethook(globalL, @@lstop, flag, 1)
}

[c_function]
def private print_usage(var badoption : uint8?) {
    fprintf(crt::c_stderr(), cstr("%s: "), progname)
    crt::fflush(crt::c_stderr())
    if (badoption[1] == 'e' || badoption[1] == 'l') {
        fprintf(crt::c_stderr(), cstr("'%s' needs argument\n"), badoption)
        crt::fflush(crt::c_stderr())
    } else {
        fprintf(crt::c_stderr(), cstr("unrecognized option '%s'\n"), badoption)
        crt::fflush(crt::c_stderr())
    }
    fprintf(crt::c_stderr(),
            cstr("usage: %s [options] [script [args]]\nAvailable options are:\n  -e stat   execute string 'stat'\n  -i        enter interactive mode after executing 'script'\n  -l mod    require library 'mod' into global 'mod'\n  -l g=mod  require library 'mod' into global 'g'\n  -v        show version information\n  -E        ignore environment variables\n  -W        turn warnings on\n  --        stop handling options\n  -         stop handling options and execute stdin\n"),
            progname)
    crt::fflush(crt::c_stderr())
}

// Prints an error message, adding the program name in front of it
// (if present)
[c_function]
def private l_message(var pname : uint8?; var msg : uint8?) {
    if (pname != null) {
        fprintf(crt::c_stderr(), cstr("%s: "), pname)
        crt::fflush(crt::c_stderr())
    }
    fprintf(crt::c_stderr(), cstr("%s\n"), msg)
    crt::fflush(crt::c_stderr())
}

// Check whether 'status' is not OK and, if so, prints the error
// message on the top of the stack.
[c_function]
def private report(var L : lua_State?; status : int) : int {
    if (status != LUA_OK) {
        var msg : uint8? = lua_tostring(L, -1)
        if (msg == null) {
            msg = cstr("(error message not a string)")
        }
        l_message(progname, msg)
        // remove message
        lua_pop(L, 1)
    }
    return status
}

// Message handler used to run all chunks
[c_function]
def private msghandler(var L : lua_State?) : int {
    var msg : uint8? = lua_tostring(L, 1)
    // is error object not a string?
    if (msg == null) {
        // does it have a metamethod
        if (luaL_callmeta(L, 1, cstr("__tostring")) != 0 && lua_type(L, -1) == LUA_TSTRING) {
            // that produces a string?
            // that is the message
            return 1
        } else {
            msg = lua_pushfstring`va(L, cstr("(error object is a %s value)"), (luaL_typename(L, 1),))
        }
    }
    // append a standard traceback
    luaL_traceback(L, L, msg, 1)
    // return the traceback
    return 1
}

// Interface to 'lua_pcall', which sets appropriate message function
// and C-signal handler. Used to run all chunks.
def private docall(var L : lua_State?; narg : int; nres : int) : int {
    var status : int
    // function index
    let base : int = lua_gettop(L) - narg
    // push message handler
    lua_pushcclosure(L, @@msghandler, 0)
    // put it under function and args
    lua_insert(L, base)
    // to be available to 'laction'
    globalL = L
    // set C-signal handler
    c_signal(2, @@laction)
    status = lua_pcall(L, narg, nres, base)
    // reset C-signal handler
    c_signal(2, default<function<(a0 : int) : void>>)
    // remove message handler from the stack
    lua_remove(L, base)
    return status
}

[c_function]
def private print_version {
    crt::fwrite(reinterpret<void?>(cstr("Lua 5.4.8  Copyright (C) 1994-2025 Lua.org, PUC-Rio")), uint64(typeinfo sizeof(type<uint8>)),
            crt::strlen(cstr("Lua 5.4.8  Copyright (C) 1994-2025 Lua.org, PUC-Rio")), crt::c_stdout())
    crt::fwrite(reinterpret<void?>(cstr("\n")), uint64(typeinfo sizeof(type<uint8>)), 1ul, crt::c_stdout())
    crt::fflush(crt::c_stdout())
}

// Create the 'arg' table, which stores all arguments from the
// command line ('argv'). It should be aligned so that, at index 0,
// it has 'argv[script]', which is the script name. The arguments
// to the script (everything after 'script') go to positive indices;
// other arguments (before the script name) go to negative indices.
// If there is no script name, assume interpreter's name as base.
// (If there is no interpreter's name either, 'script' is -1, so
// table sizes are zero.)
[c_function]
def private createargtable(var L : lua_State?; var argv : uint8 ??; argc : int; script : int) {
    var narg : int
    // number of positive indices
    narg = argc - (script + 1)
    lua_createtable(L, narg, script + 1)
    for (i in range(argc)) {
        lua_pushstring(L, argv[i])
        lua_rawseti(L, -2, int64(i - script))
    }
    lua_setglobal(L, cstr("arg"))
}

def private dochunk(var L : lua_State?; var status : int) : int {
    if (status == LUA_OK) {
        status = docall(L, 0, 0)
    }
    return report(L, status)
}

def private dofile(var L : lua_State?; var name : uint8?) : int {
    return dochunk(L, luaL_loadfile(L, name))
}

[c_function]
def private dostring(var L : lua_State?; var s : uint8?; var name : uint8?) : int {
    return dochunk(L, luaL_loadbuffer(L, s, crt::strlen(s), name))
}

// Receives 'globname[=modname]' and runs 'globname = require(modname)'.
// If there is no explicit modname and globname contains a '-', cut
// the suffix after '-' (the "version") to make the global name.
[c_function]
def private dolibrary(var L : lua_State?; var globname : uint8?) : int {
    var status : int
    var suffix : uint8? = null
    var modname : uint8? = crt::strchr(globname, '=')
    // no explicit name?
    if (modname == null) {
        // module name is equal to global name
        modname = globname
        // look for a suffix mark
        suffix = crt::strchr(modname, int(*cstr("-")))
    } else {
        // global name ends here
        *modname = uint8('\0')
        // module name starts after the '='
        modname++
    }
    lua_getglobal(L, cstr("require"))
    lua_pushstring(L, modname)
    // call 'require(modname)'
    status = docall(L, 1, 1)
    if (status == LUA_OK) {
        // is there a suffix mark?
        if (suffix != null) {
            // remove suffix from global name
            *suffix = uint8('\0')
        }
        // globname = require(modname)
        lua_setglobal(L, globname)
    }
    return report(L, status)
}

// Push on the stack the contents of table 'arg' from 1 to #arg
def private pushargs(var L : lua_State?) : int {
    var i : int
    var n : int
    if (lua_getglobal(L, cstr("arg")) != LUA_TTABLE) {
        luaL_error`va(L, cstr("'arg' is not a table"), VaNone())
    }
    n = int(luaL_len(L, -1))
    luaL_checkstack(L, n + 3, cstr("too many arguments to script"))
    i = 1
    while (i <= n) {
        lua_rawgeti(L, -i, int64(i))
        i++
    }
    // remove table from the stack
    lua_remove(L, -i)
    return n
}

[c_function]
def private handle_script(var L : lua_State?; var argv : uint8 ??) : int {
    var status : int
    var fname : uint8? = argv[0]
    if (crt::strcmp(fname, cstr("-")) == 0 && crt::strcmp(argv[-1], cstr("--")) != 0) {
        // stdin
        fname = null
    }
    status = luaL_loadfile(L, fname)
    if (status == LUA_OK) {
        // push arguments to script
        let n : int = pushargs(L)
        status = docall(L, n, LUA_MULTRET)
    }
    return report(L, status)
}

// Traverses all arguments from 'argv', returning a mask with those
// needed before running any Lua code or an error code if it finds any
// invalid argument. In case of error, 'first' is the index of the bad
// argument. Otherwise, 'first' is -1 if there is no program name,
// 0 if there is no script name, or the index of the script name.
[c_function]
def private collectargs(var argv : uint8 ??; var first : int?) : int {
    var args : int = 0
    var i : int
    // is there a program name?
    if (argv[0] != null) {
        // not empty?
        if (argv[0][0] != 0) {
            // save it
            progname = argv[0]
        }
    } else {
        // no program name
        *first = -1
        return 0
    }
    // handle arguments
    i = 1
    while (argv[i] != null) {
        *first = i
        // not an option?
        if (argv[i][0] != '-') {
            // stop handling options
            return args
        }
        // else check option
        c_switch(int(argv[i][1])) {
            case('-') {
                // '--'
                // extra characters after '--'?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                *first = i + 1
                return args
            }
            case('\0') {
                // '-'
                // script "name" is '-'
                return args
            }
            case('E') {
                // extra characters?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                args |= has_E
                break
            }
            case('W') {
                // extra characters?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                break
            }
            case('i') {
                // (-i implies -v) FALLTHROUGH
                args |= has_i
            }
            case('v') {
                // extra characters?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                args |= has_v
                break
            }
            case('e') {
                // FALLTHROUGH
                args |= has_e
            }
            case('l') {
                // both options need an argument
                // no concatenated argument?
                if (argv[i][2] == '\0') {
                    // try next 'argv'
                    i++
                    if (argv[i] == null || argv[i][0] == '-') {
                        // no next argument or it is another option
                        return has_error
                    }
                }
                break
            }
            case(_) {
                // invalid option
                return has_error
            }
        }
        i++
    }
    // no script name
    *first = 0
    return args
}

// Processes options 'e' and 'l', which involve running Lua code, and
// 'W', which also affects the state.
// Returns 0 if some code raises an error.
[c_function]
def private runargs(var L : lua_State?; var argv : uint8 ??; n : int) : int {
    var i : int
    i = 1
    while (i < n) {
        let option : int = int(argv[i][1])
        // already checked
        c_switch(option) {
            case('e', 'l') {
                {
                    var status : int
                    // both options need an argument
                    var extra : uint8? = argv[i] + 2
                    if (*extra == '\0') {
                        i++
                        extra = argv[i]
                    }
                    status = (option == 'e') ? dostring(L, extra, cstr("=(command line)")) : dolibrary(L, extra)
                    if (status != LUA_OK) {
                        return 0
                    }
                    break
                }
            }
            case('W') {
                // warnings on
                lua_warning(L, cstr("@on"), 0)
                break
            }
        }
        i++
    }
    return 1
}

[c_function]
def private handle_luainit(var L : lua_State?) : int {
    var name : uint8? = cstr("=LUA_INIT_5_4")
    var init : uint8? = crt::getenv(name + 1)
    if (init == null) {
        name = cstr("=LUA_INIT")
        // try alternative name
        init = crt::getenv(name + 1)
    }
    if (init == null) {
        return LUA_OK
    } elif (init[0] == '@') {
        return dofile(L, init + 1)
    } else {
        return dostring(L, init, name)
    }
}

// Return the string to be used as a prompt by the interpreter. Leave
// the string (or nil, if using the default value) on the stack, to keep
// it anchored.
def private get_prompt(var L : lua_State?; firstline : int) : uint8? {
    if (lua_getglobal(L, firstline != 0 ? cstr("_PROMPT") : cstr("_PROMPT2")) == LUA_TNIL) {
        // use the default
        return firstline != 0 ? cstr("> ") : cstr(">> ")
    } else {
        // apply 'tostring' over the value
        var p : uint8? = luaL_tolstring(L, -1, null)
        // remove original value
        lua_remove(L, -2)
        return p
    }
}

// Check whether 'status' signals a syntax error and the error
// message at the top of the stack ends with the above mark for
// incomplete statements.
[c_function]
def private incomplete(var L : lua_State?; status : int) : int {
    if (status == LUA_ERRSYNTAX) {
        var lmsg : uint64
        var msg : uint8? = lua_tolstring(L, -1, addr(lmsg))
        if (lmsg >= marklen && crt::strcmp(msg + lmsg + -int64(marklen), cstr("<eof>")) == 0) {
            return 1
        }
    }
    // else...
    return 0
}

// Prompt the user, read a line, and push it into the Lua stack.
[c_function]
def private pushline(var L : lua_State?; firstline : int) : int {
    var buffer : uint8[512]
    var b : uint8? = addr(buffer[0])
    var l : uint64
    var prmt : uint8? = get_prompt(L, firstline)
    crt::fputs(prmt, crt::c_stdout())
    crt::fflush(crt::c_stdout())
    let readstatus : int = int_of(crt::fgets(b, LUA_MAXINPUT, crt::c_stdin()) != null)
    // remove prompt
    lua_pop(L, 1)
    if (readstatus == 0) {
        // no input
        return 0
    }
    l = crt::strlen(b)
    // line ends with newline?
    if (l > 0ul && b[l - 1ul] == '\n') {
        // remove it
        l--
        b[l] = uint8('\0')
    }
    // for compatibility with 5.2, ...
    if (firstline != 0 && b[0] == '=') {
        // change '=' to 'return'
        lua_pushfstring`va(L, cstr("return %s"), (b + 1,))
    } else {
        lua_pushlstring(L, b, l)
    }
    return 1
}

// Try to compile line on the stack as 'return <line>;'; on return, stack
// has either compiled chunk or original line (if compilation failed).
[c_function]
def private addreturn(var L : lua_State?) : int {
    // original line
    var line : uint8? = lua_tostring(L, -1)
    var retline : uint8? = lua_pushfstring`va(L, cstr("return %s;"), (line,))
    let status : int = luaL_loadbufferx(L, retline, crt::strlen(retline), cstr("=stdin"), null)
    if (status == LUA_OK) {
        // remove modified line
        lua_remove(L, -2)
        // non empty?
        if (line[0] != '\0') {
            // keep history
        }
    } else {
        // pop result from 'luaL_loadbuffer' and modified line
        lua_pop(L, 2)
    }
    return status
}

// Read multiple lines until a complete Lua statement
[c_function]
def private multiline(var L : lua_State?) : int {
    // repeat until gets a complete statement
    while (true) {
        var len : uint64
        // get what it has
        var line : uint8? = lua_tolstring(L, 1, addr(len))
        // try it
        let status : int = luaL_loadbufferx(L, line, len, cstr("=stdin"), null)
        if (incomplete(L, status) == 0 || pushline(L, 0) == 0) {
            // keep history
            // should not or cannot try to add continuation line
            return status
        }
        // remove error message (from incomplete line)
        lua_remove(L, -2)
        // add newline...
        lua_pushstring(L, cstr("\n"))
        // ...between the two lines
        lua_insert(L, -2)
        // join them
        lua_concat(L, 3)
    }
    return 0
}

// Read a line and try to load (compile) it first as an expression (by
// adding "return " in front of it) and second as a statement. Return
// the final status of load/call with the resulting function (if any)
// in the top of the stack.
def private loadline(var L : lua_State?) : int {
    var status : int
    lua_settop(L, 0)
    if (pushline(L, 1) == 0) {
        // no input
        return -1
    }
    // 'return ...' did not work?
    status = addreturn(L)
    if (status != LUA_OK) {
        // try as command, maybe with continuation lines
        status = multiline(L)
    }
    // remove line from the stack
    lua_remove(L, 1)
    return status
}

// Prints (calling the Lua 'print' function) any values on the stack
def private l_print(var L : lua_State?) {
    let n : int = lua_gettop(L)
    // any result to be printed?
    if (n > 0) {
        luaL_checkstack(L, LUA_MINSTACK, cstr("too many results to print"))
        lua_getglobal(L, cstr("print"))
        lua_insert(L, 1)
        if (lua_pcall(L, n, 0, 0) != LUA_OK) {
            l_message(progname, lua_pushfstring`va(L, cstr("error calling 'print' (%s)"), (lua_tostring(L, -1),)))
        }
    }
}

// Do the REPL: repeatedly read (load) a line, evaluate (call) it, and
// print any results.
[c_function]
def private doREPL(var L : lua_State?) {
    var status : int
    var oldprogname : uint8? = progname
    // no 'progname' on errors in interactive mode
    progname = null
    while (true) {
        status = loadline(L)
        if (!(status != -1)) {
            break
        }
        if (status == LUA_OK) {
            status = docall(L, 0, LUA_MULTRET)
        }
        if (status == LUA_OK) {
            l_print(L)
        } else {
            report(L, status)
        }
    }
    // clear stack
    lua_settop(L, 0)
    crt::fwrite(reinterpret<void?>(cstr("\n")), uint64(typeinfo sizeof(type<uint8>)), 1ul, crt::c_stdout())
    crt::fflush(crt::c_stdout())
    progname = oldprogname
}

// Main body of stand-alone interpreter (to be called in protected mode).
// Reads the options and handles them all.
[c_function]
def private pmain(var L : lua_State?) : int {
    let argc : int = int(lua_tointeger(L, 1))
    var argv : uint8 ?? = reinterpret<uint8 ??>(lua_touserdata(L, 2))
    var script : int
    let args : int = collectargs(argv, addr(script))
    // first argv not an option
    let optlim : int = (script > 0) ? script : argc
    // check that interpreter has correct version
    luaL_checkversion(L)
    // bad arg?
    if (args == has_error) {
        // 'script' has index of bad arg.
        print_usage(argv[script])
        return 0
    }
    // option '-v'?
    if ((args & has_v) != 0) {
        print_version()
    }
    // option '-E'?
    if ((args & has_E) != 0) {
        // signal for libraries to ignore env. vars.
        lua_pushboolean(L, 1)
        lua_setfield(L, LUA_REGISTRYINDEX, cstr("LUA_NOENV"))
    }
    // open standard libraries
    luaL_openlibs(L)
    // create table 'arg'
    createargtable(L, argv, argc, script)
    // start GC...
    lua_gc`va(L, LUA_GCRESTART, VaNone())
    // ...in generational mode
    lua_gc`va(L, LUA_GCGEN, (0, 0))
    // no option '-E'?
    if ((args & has_E) == 0) {
        // run LUA_INIT
        if (handle_luainit(L) != LUA_OK) {
            // error running LUA_INIT
            return 0
        }
    }
    // execute arguments -e and -l
    if (runargs(L, argv, optlim) == 0) {
        // something failed
        return 0
    }
    // execute main script (if there is one)
    if (script > 0) {
        if (handle_script(L, argv + script) != LUA_OK) {
            // interrupt in case of error
            return 0
        }
    }
    // -i option?
    if ((args & has_i) != 0) {
        // do read-eval-print loop
        doREPL(L)
    } elif (script < 1 && (args & (has_e | has_v)) == 0) {
        // no active option?
        // running in interactive mode?
        if (lua_stdin_is_tty() != 0) {
            print_version()
            // do read-eval-print loop
            doREPL(L)
        } else {
            // executes stdin as a file
            dofile(L, null)
        }
    }
    // signal no errors
    lua_pushboolean(L, 1)
    return 1
}

[c_function]
def c_main(argc : int; var argv : uint8 ??) : int {
    var status : int
    var result : int
    // create state
    var L : lua_State? = luaL_newstate()
    if (L == null) {
        l_message(argv[0], cstr("cannot create state: not enough memory"))
        return 1
    }
    // stop GC while building state
    lua_gc`va(L, LUA_GCSTOP, VaNone())
    // to call 'pmain' in protected mode
    lua_pushcfunction(L, @@pmain)
    // 1st argument
    lua_pushinteger(L, int64(argc))
    // 2nd argument
    lua_pushlightuserdata(L, reinterpret<void?>(argv))
    // do the call
    status = lua_pcall(L, 2, 1, 0)
    // get result
    result = lua_toboolean(L, -1)
    report(L, status)
    lua_close(L)
    return (result != 0 && status == LUA_OK) ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("lua")
    return c_main(c_argc(), c_argv())
}
