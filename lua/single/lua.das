        s = lua_tolstring(L, 1, addr(l))
        let _t0 = 2l <= base && base <= 36l || luaL_argerror(L, 2, cstr("base out of range")) != 0
        if (intptr(b_str2int(s, int(base), addr(n))) == intptr(s + l)) {
            lua_pushinteger(L, n)
            return 1
        }
    }
    // else not a number
    // else not a number
    // not a number
    luaL_pushfail(L)
    return 1
