                let pause : int = int(luaL_optinteger(L, 2, 0l))
                let stepmul : int = int(luaL_optinteger(L, 3, 0l))
                let stepsize : int = int(luaL_optinteger(L, 4, 0l))
                return pushmode(L, lua_gc`va(L, o, (pause, stepmul, stepsize)))
