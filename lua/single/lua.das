// t[k] = value at the top of the stack (where 'k' is a string)
[c_function]
def private auxsetstr(var L : lua_State?; var t : TValue?; var k : uint8?) {
    var slot : TValue?
    var str : TString? = luaS_new(L, k)
    var _t0 : int
    if (!ttistable(t)) {
        slot = null
        _t0 = 0
    } else {
        slot = luaH_getstr(hvalue(t), str)
        _t0 = int_of(!isempty(slot))
    }
    if (_t0 != 0) {
        {
            var io1 : TValue? = slot
            var io2 : TValue? = addr((L.top.p - 1).val)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        if ((int(addr((L.top.p - 1).val).tt_) & BIT_ISCOLLECTABLE) != 0) {
            if ((int(t.value_.gc.marked) & (1 << BLACKBIT)) != 0 &&
                    (int(addr((L.top.p - 1).val).value_.gc.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
                luaC_barrierback_(L, t.value_.gc)
            }
        }
        // pop value
        L.top.p--
    } else {
        {
            // push 'str' (to make it a TValue)
            var io : TValue? = s2v(L.top.p)
            var x_ : TString? = str
            io.value_.gc = obj2gco(x_)
            settt_(io, ctb(x_.tt))
        }
        api_incr_top(L)
        luaV_finishset(L, t, s2v(L.top.p - 1), s2v(L.top.p - 2), slot)
        // pop value and key
        L.top.p -= 2
    }
    // lock done by caller
}

