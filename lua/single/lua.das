        ts.tm_hour = getfield(L, cstr("hour"), 12, 0)
        ts.tm_min = getfield(L, cstr("min"), 0, 0)
        ts.tm_sec = getfield(L, cstr("sec"), 0, 0)
        ts.tm_isdst = getboolfield(L, cstr("isdst"))
