    return 1
}

[c_function]
def private pushnumint(var L : lua_State?; d : double) {
    var n : int64
    // does 'd' fit in an integer?
    var _t0 = d >= double(-9223372036854775807l - 1l) && d < -double(-9223372036854775807l - 1l)
    if (_t0) {
        *addr(n) = int64(d)
        _t0 = 1 != 0
    }
    if (_t0) {
        // result is integer
        lua_pushinteger(L, n)
    } else {
        // result is float
        lua_pushnumber(L, d)
    }
}

def private math_floor(var L : lua_State?) : int {
    if (lua_isinteger(L, 1) != 0) {
        // integer is its own floor
        lua_settop(L, 1)
    } else {
        let d : double = math::floor(luaL_checknumber(L, 1))
        pushnumint(L, d)
    }
    return 1
}

def private math_ceil(var L : lua_State?) : int {
    if (lua_isinteger(L, 1) != 0) {
        // integer is its own ceil
        lua_settop(L, 1)
    } else {
        let d : double = math::ceil(luaL_checknumber(L, 1))
        pushnumint(L, d)
    }
    return 1
}

[c_function]
def private math_fmod(var L : lua_State?) : int {
    if (lua_isinteger(L, 1) != 0 && lua_isinteger(L, 2) != 0) {
        let d : int64 = lua_tointeger(L, 2)
        // special cases: -1 or 0
        if (uint64(d) + uint64(1u) <= uint64(1u)) {
            let _t0 = d != 0l || luaL_argerror(L, 2, cstr("zero")) != 0
            // avoid overflow with 0x80000... / -1
            lua_pushinteger(L, 0l)
        } else {
            lua_pushinteger(L, lua_tointeger(L, 1) % d)
        }
    } else {
        lua_pushnumber(L, crt::fmod(luaL_checknumber(L, 1), luaL_checknumber(L, 2)))
    }
    return 1
}

// next function does not use 'modf', avoiding problems with 'double*'
// (which is not compatible with 'float*') when lua_Number is not
// 'double'.
def private math_modf(var L : lua_State?) : int {
    if (lua_isinteger(L, 1) != 0) {
        // number is its own integer part
        lua_settop(L, 1)
        // no fractional part
        lua_pushnumber(L, 0.0lf)
    } else {
        let n : double = luaL_checknumber(L, 1)
        // integer part (rounds toward zero)
        let ip : double = (n < 0.0lf) ? math::ceil(n) : math::floor(n)
        pushnumint(L, ip)
        // fractional part (test needed for inf/-inf)
        lua_pushnumber(L, (n == ip) ? 0.0lf : (n - ip))
    }
    return 2
}

def private math_sqrt(var L : lua_State?) : int {
    lua_pushnumber(L, math::sqrt(luaL_checknumber(L, 1)))
