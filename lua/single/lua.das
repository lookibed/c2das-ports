[c_function]
def private match_class(c : int; cl : int) : int {
    var res : int
    c_switch(crt::tolower(cl)) {
        case('a') {
            res = crt::isalpha(c)
            break
        }
        case('c') {
            res = crt::iscntrl(c)
            break
        }
        case('d') {
            res = crt::isdigit(c)
            break
        }
        case('g') {
            res = crt::isgraph(c)
            break
        }
        case('l') {
            res = crt::islower(c)
            break
        }
        case('p') {
            res = crt::ispunct(c)
            break
        }
        case('s') {
            res = crt::isspace(c)
            break
        }
        case('u') {
            res = crt::isupper(c)
            break
        }
        case('w') {
            res = crt::isalnum(c)
            break
        }
        case('x') {
            res = crt::isxdigit(c)
            break
        }
        case('z') {
            // deprecated option
            res = int_of(c == 0)
            break
        }
        case(_) {
            return int_of(cl == c)
        }
    }
    return crt::islower(cl) != 0 ? res : int_of(res == 0)
}

[c_function]
def private matchbracketclass(c : int; var p : uint8?; var ec : uint8?) : int {
    var sig : int = 1
    if (p[1] == '^') {
        sig = 0
        // skip the '^'
        p++
    }
    while (true) {
        p++
        if (!(intptr(p) < intptr(ec))) {
            break
        }
        if (int(*p) == L_ESC) {
            p++
            if (match_class(c, int(*p)) != 0) {
                return sig
            }
        } elif ((p[1] == '-') && (intptr(p + 2) < intptr(ec))) {
            p += 2
            if (int(*(p - 2)) <= c && c <= int(*p)) {
                return sig
            }
        } elif (int(*p) == c) {
            return sig
        }
    }
    return int_of(sig == 0)
}

[c_function]
def private singlematch(var ms : MatchState?; var s : uint8?; var p : uint8?; var ep : uint8?) : int {
    if (intptr(s) >= intptr(ms.src_end)) {
        return 0
    } else {
        let c : int = int(*s)
        c_switch(int(*p)) {
            case('.') {
                // matches any char
                return 1
            }
            case('%') {
                return match_class(c, int(p[1]))
            }
            case('[') {
                return matchbracketclass(c, p, ep - 1)
            }
            case(_) {
                return int_of(int(*p) == c)
            }
        }
    }
}

