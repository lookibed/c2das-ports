        let _t1 = i
        i++
        smask[_t1] = uint8('r')
    }
    if ((mask & LUA_MASKLINE) != 0) {
        let _t2 = i
        i++
        smask[_t2] = uint8('l')
    }
    smask[i] = uint8('\0')
