        lua_pushnil(L)
        return 1
    }
}

def private pairscont(var L : lua_State?; status : int; k : int64) : int {
    // unused
    return 3
}

def private luaB_pairs(var L : lua_State?) : int {
    luaL_checkany(L, 1)
    // no metamethod?
    if (luaL_getmetafield(L, 1, cstr("__pairs")) == LUA_TNIL) {
        // will return generator,
        lua_pushcclosure(L, @@luaB_next, 0)
        // state,
        lua_pushvalue(L, 1)
        // and initial value
        lua_pushnil(L)
    } else {
        // argument 'self' to metamethod
        lua_pushvalue(L, 1)
        // get 3 values from metamethod
        lua_callk(L, 1, 3, 0l, @@pairscont)
    }
    return 3
}

// Traversal function for 'ipairs'
def private ipairsaux(var L : lua_State?) : int {
    var i : int64 = luaL_checkinteger(L, 2)
    i += int64(1)
    lua_pushinteger(L, i)
    return (lua_geti(L, 1, i) == LUA_TNIL) ? 1 : 2
}

// 'ipairs' function. Returns 'ipairsaux', given "table", 0.
// (The given "table" may not be a table.)
def private luaB_ipairs(var L : lua_State?) : int {
    luaL_checkany(L, 1)
    // iteration function
    lua_pushcclosure(L, @@ipairsaux, 0)
    // state
    lua_pushvalue(L, 1)
    // initial value
    lua_pushinteger(L, 0l)
    return 3
}

def private load_aux(var L : lua_State?; status : int; envidx : int) : int {
    if (status == LUA_OK) {
        // 'env' parameter?
        if (envidx != 0) {
            // environment for loaded function
            lua_pushvalue(L, envidx)
            // set it as 1st upvalue
            if (lua_setupvalue(L, -2, 1) == null) {
                // remove 'env' if not used by previous call
                lua_pop(L, 1)
            }
        }
        return 1
    } else {
        // error (message is on top of the stack)
        luaL_pushfail(L)
        // put before error message
        lua_insert(L, -2)
        // return fail plus error message
        return 2
    }
}

def private luaB_loadfile(var L : lua_State?) : int {
    var fname : uint8? = luaL_optlstring(L, 1, null, null)
    var mode : uint8? = luaL_optlstring(L, 2, null, null)
    // 'env' index or 0 if no 'env'
    let env : int = !lua_isnone(L, 3) ? 3 : 0
    let status : int = luaL_loadfilex(L, fname, mode)
    return load_aux(L, status, env)
}

// Reader for generic 'load' function: 'lua_load' uses the
// stack for internal stuff, so the reader cannot change the
// stack top. Instead, it keeps its resulting string in a
// reserved slot inside the stack.
[c_function]
def private generic_reader(var L : lua_State?; var ud : void?; var size : uint64?) : uint8? {
    // not used
    luaL_checkstack(L, 2, cstr("too many nested functions"))
    // get function
    lua_pushvalue(L, 1)
    // call it
    lua_call(L, 0, 1)
    if (lua_isnil(L, -1)) {
        // pop result
        lua_pop(L, 1)
        *size = 0ul
        return null
    } elif (lua_isstring(L, -1) == 0) {
        luaL_error`va(L, cstr("reader function must return a string"), VaNone())
    }
    // save string in reserved slot
    lua_copy(L, -1, RESERVEDSLOT)
    lua_settop(L, -1 - 1)
    return lua_tolstring(L, RESERVEDSLOT, size)
}

[c_function]
def private luaB_load(var L : lua_State?) : int {
    var status : int
    var l : uint64
    var s : uint8? = lua_tolstring(L, 1, addr(l))
    var mode : uint8? = luaL_optlstring(L, 3, cstr("bt"), null)
    // 'env' index or 0 if no 'env'
    let env : int = !lua_isnone(L, 4) ? 4 : 0
    // loading a string?
    if (s != null) {
        var chunkname : uint8? = luaL_optstring(L, 2, s)
        status = luaL_loadbufferx(L, s, l, chunkname, mode)
    } else {
        // loading from a reader function
        var chunkname : uint8? = luaL_optlstring(L, 2, cstr("=(load)"), null)
        luaL_checktype(L, 1, LUA_TFUNCTION)
        // create reserved slot
        lua_settop(L, RESERVEDSLOT)
        status = lua_load(L, @@generic_reader, null, chunkname, mode)
    }
    return load_aux(L, status, env)
}

def private dofilecont(var L : lua_State?; d1 : int; d2 : int64) : int {
    // only to match 'lua_Kfunction' prototype
    return lua_gettop(L) - 1
}

def private luaB_dofile(var L : lua_State?) : int {
    var fname : uint8? = luaL_optlstring(L, 1, null, null)
    lua_settop(L, 1)
    if (luaL_loadfile(L, fname) != LUA_OK) {
        return lua_error(L)
    }
    lua_callk(L, 0, LUA_MULTRET, 0l, @@dofilecont)
    return dofilecont(L, 0, 0l)
}

def private luaB_assert(var L : lua_State?) : int {
    // condition is true?
    if (lua_toboolean(L, 1) != 0) {
        // return all arguments
        return lua_gettop(L)
    } else {
        // error
        // there must be a condition
        luaL_checkany(L, 1)
        // remove it
        lua_remove(L, 1)
        // default message
        lua_pushstring(L, cstr("assertion failed!"))
        // leave only message (default if no other one)
        lua_settop(L, 1)
        // call 'error'
        return luaB_error(L)
    }
}

[c_function]
def private luaB_select(var L : lua_State?) : int {
    let n : int = lua_gettop(L)
    if (lua_type(L, 1) == LUA_TSTRING && *lua_tostring(L, 1) == '#') {
        lua_pushinteger(L, int64(n - 1))
        return 1
    } else {
        var i : int64 = luaL_checkinteger(L, 1)
        if (i < 0l) {
            i = int64(n) + i
        } elif (i > int64(n)) {
            i = int64(n)
        }
        let _t0 = 1l <= i || luaL_argerror(L, 1, cstr("index out of range")) != 0
        return n - int(i)
    }
}

// Continuation function for 'pcall' and 'xpcall'. Both functions
// already pushed a 'true' before doing the call, so in case of success
// 'finishpcall' only has to return everything in the stack minus
// 'extra' values (where 'extra' is exactly the number of items to be
// ignored).
def private finishpcall(var L : lua_State?; status : int; extra : int64) : int {
    // error?
    if (status != LUA_OK && status != LUA_YIELD) {
        // first result (false)
        lua_pushboolean(L, 0)
        // error message
        lua_pushvalue(L, -2)
        // return false, msg
        return 2
    } else {
        // return all results
        return lua_gettop(L) - int(extra)
    }
}

def private luaB_pcall(var L : lua_State?) : int {
    var status : int
    luaL_checkany(L, 1)
    // first result if no errors
    lua_pushboolean(L, 1)
    // put it in place
    lua_insert(L, 1)
    status = lua_pcallk(L, lua_gettop(L) - 2, LUA_MULTRET, 0, 0l, @@finishpcall)
    return finishpcall(L, status, 0l)
}

// Do a protected call with error handling. After 'lua_rotate', the
// stack will have <f, err, true, f, [args...]>; so, the function passes
// 2 to 'finishpcall' to skip the 2 first values when returning results.
def private luaB_xpcall(var L : lua_State?) : int {
    var status : int
    let n : int = lua_gettop(L)
    // check error function
    luaL_checktype(L, 2, LUA_TFUNCTION)
    // first result
    lua_pushboolean(L, 1)
    // function
    lua_pushvalue(L, 1)
    // move them below function's arguments
    lua_rotate(L, 3, 2)
    status = lua_pcallk(L, n - 2, LUA_MULTRET, 2, 2l, @@finishpcall)
    return finishpcall(L, status, 2l)
}

def private luaB_tostring(var L : lua_State?) : int {
    luaL_checkany(L, 1)
    luaL_tolstring(L, 1, null)
    return 1
}

[c_function]
def luaopen_base(var L : lua_State?) : int {
    // open lib into global table
    lua_pushglobaltable(L)
    luaL_setfuncs(L, addr(base_funcs[0]), 0)
    // set global _G
    lua_pushvalue(L, -1)
    lua_setfield(L, -2, cstr("_G"))
    // set global _VERSION
    lua_pushstring(L, cstr("Lua 5.4"))
    lua_setfield(L, -2, cstr("_VERSION"))
    return 1
}

def private getco(var L : lua_State?) : lua_State? {
    var co : lua_State? = lua_tothread(L, 1)
    let _t0 = co != null || luaL_typeerror(L, 1, cstr("thread")) != 0
    return co
}

// Resumes a coroutine. Returns the number of results for non-error
// cases or -1 for errors.
[c_function]
def private auxresume(var L : lua_State?; var co : lua_State?; narg : int) : int {
    var status : int
    var nres : int
    if (lua_checkstack(co, narg) == 0) {
        lua_pushstring(L, cstr("too many arguments to resume"))
        // error flag
        return -1
    }
    lua_xmove(L, co, narg)
    status = lua_resume(co, L, narg, addr(nres))
    if (status == LUA_OK || status == LUA_YIELD) {
        if (lua_checkstack(L, nres + 1) == 0) {
            // remove results anyway
            lua_pop(co, nres)
            lua_pushstring(L, cstr("too many results to resume"))
            // error flag
            return -1
        }
        // move yielded values
        lua_xmove(co, L, nres)
        return nres
    } else {
        // move error message
        lua_xmove(co, L, 1)
        // error flag
        return -1
    }
}

def private luaB_coresume(var L : lua_State?) : int {
    var co : lua_State? = getco(L)
    var r : int
    r = auxresume(L, co, lua_gettop(L) - 1)
    if (r < 0) {
        lua_pushboolean(L, 0)
        lua_insert(L, -2)
        // return false + error message
        return 2
    } else {
        lua_pushboolean(L, 1)
        lua_insert(L, -(r + 1))
        // return true + 'resume' returns
        return r + 1
    }
}

def private luaB_auxwrap(var L : lua_State?) : int {
    var co : lua_State? = lua_tothread(L, lua_upvalueindex(1))
    let r : int = auxresume(L, co, lua_gettop(L))
    // error?
    if (r < 0) {
        var stat : int = lua_status(co)
        // error in the coroutine?
        if (stat != LUA_OK && stat != LUA_YIELD) {
            // close its tbc variables
            stat = lua_closethread(co, L)
            // move error message to the caller
            lua_xmove(co, L, 1)
        }
        // not a memory error and ...
        if (stat != LUA_ERRMEM && lua_type(L, -1) == LUA_TSTRING) {
            // ... error object is a string?
            // add extra info, if available
            luaL_where(L, 1)
            lua_insert(L, -2)
            lua_concat(L, 2)
        }
        // propagate error
        return lua_error(L)
    }
    return r
}

def private luaB_cocreate(var L : lua_State?) : int {
    var NL : lua_State?
    luaL_checktype(L, 1, LUA_TFUNCTION)
    NL = lua_newthread(L)
    // move function to top
    lua_pushvalue(L, 1)
    // move function from L to NL
    lua_xmove(L, NL, 1)
    return 1
}

def private luaB_cowrap(var L : lua_State?) : int {
    luaB_cocreate(L)
    lua_pushcclosure(L, @@luaB_auxwrap, 1)
    return 1
}

def private luaB_yield(var L : lua_State?) : int {
    return lua_yield(L, lua_gettop(L))
}

[c_function]
def private auxstatus(var L : lua_State?; var co : lua_State?) : int {
    if (intptr(L) == intptr(co)) {
        return COS_RUN
    } else {
        c_switch(lua_status(co)) {
            case(1) {
                return COS_YIELD
            }
            case(0) {
                {
                    var ar : lua_Debug
                    // does it have frames?
                    if (lua_getstack(co, 0, addr(ar)) != 0) {
                        // it is running
                        return COS_NORM
                    } elif (lua_gettop(co) == 0) {
                        return COS_DEAD
                    } else {
                        // initial state
                        return COS_YIELD
                    }
                }
            }
            case(_) {
                // some error occurred
                return COS_DEAD
            }
        }
    }
    return 0
}

def private luaB_costatus(var L : lua_State?) : int {
    var co : lua_State? = getco(L)
    lua_pushstring(L, statname[auxstatus(L, co)])
    return 1
}

def private luaB_yieldable(var L : lua_State?) : int {
    var co : lua_State? = lua_isnone(L, 1) ? L : getco(L)
    lua_pushboolean(L, lua_isyieldable(co))
    return 1
}

def private luaB_corunning(var L : lua_State?) : int {
    let ismain : int = lua_pushthread(L)
    lua_pushboolean(L, ismain)
    return 2
}

def private luaB_close(var L : lua_State?) : int {
    var co : lua_State? = getco(L)
    var status : int = auxstatus(L, co)
    c_switch(status) {
        case(1, 2) {
            status = lua_closethread(co, L)
            if (status == LUA_OK) {
                lua_pushboolean(L, 1)
                return 1
            } else {
                lua_pushboolean(L, 0)
                // move error message
                lua_xmove(co, L, 1)
                return 2
            }
        }
        case(_) {
            // normal or running coroutine
            return luaL_error`va(L, cstr("cannot close a %s coroutine"), (statname[status],))
        }
    }
    return 0
}

[c_function]
def luaopen_coroutine(var L : lua_State?) : int {
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[9]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(co_funcs[0]), 0)
    return 1
}

// If L1 != L, L1 can be in any state, and therefore there are no
// guarantees about its stack space; any push in L1 must be
// checked.
def private checkstack(var L : lua_State?; var L1 : lua_State?; n : int) {
    if (intptr(L) != intptr(L1) && lua_checkstack(L1, n) == 0) {
        luaL_error`va(L, cstr("stack overflow"), VaNone())
    }
}

def private db_getregistry(var L : lua_State?) : int {
    lua_pushvalue(L, LUA_REGISTRYINDEX)
    return 1
}

def private db_getmetatable(var L : lua_State?) : int {
    luaL_checkany(L, 1)
    if (lua_getmetatable(L, 1) == 0) {
        // no metatable
        lua_pushnil(L)
    }
    return 1
}

def private db_setmetatable(var L : lua_State?) : int {
    let t : int = lua_type(L, 2)
    let _t0 = t == LUA_TNIL || t == LUA_TTABLE || luaL_typeerror(L, 2, cstr("nil or table")) != 0
    lua_settop(L, 2)
    lua_setmetatable(L, 1)
    // return 1st argument
    return 1
}

def private db_getuservalue(var L : lua_State?) : int {
    let n : int = int(luaL_optinteger(L, 2, 1l))
    if (lua_type(L, 1) != LUA_TUSERDATA) {
        luaL_pushfail(L)
    } elif (lua_getiuservalue(L, 1, n) != LUA_TNONE) {
        lua_pushboolean(L, 1)
        return 2
    }
    return 1
}

def private db_setuservalue(var L : lua_State?) : int {
    let n : int = int(luaL_optinteger(L, 3, 1l))
    luaL_checktype(L, 1, LUA_TUSERDATA)
    luaL_checkany(L, 2)
    lua_settop(L, 2)
    if (lua_setiuservalue(L, 1, n) == 0) {
        luaL_pushfail(L)
    }
    return 1
}

// Auxiliary function used by several library functions: check for
// an optional thread as function's first argument and set 'arg' with
// 1 if this argument is present (so that functions can skip it to
// access their other arguments)
[c_function]
def private getthread(var L : lua_State?; var arg : int?) : lua_State? {
    if (lua_isthread(L, 1)) {
        *arg = 1
        return lua_tothread(L, 1)
    } else {
        *arg = 0
        // function will operate over current thread
        return L
    }
}

// Variations of 'lua_settable', used by 'db_getinfo' to put results
// from 'lua_getinfo' into result table. Key is always a string;
// value can be a string, an int, or a boolean.
def private settabss(var L : lua_State?; var k : uint8?; var v : uint8?) {
    lua_pushstring(L, v)
    lua_setfield(L, -2, k)
}

def private settabsi(var L : lua_State?; var k : uint8?; v : int) {
    lua_pushinteger(L, int64(v))
    lua_setfield(L, -2, k)
}

def private settabsb(var L : lua_State?; var k : uint8?; v : int) {
    lua_pushboolean(L, v)
    lua_setfield(L, -2, k)
}

// In function 'db_getinfo', the call to 'lua_getinfo' may push
// results on the stack; later it creates the result table to put
// these objects. Function 'treatstackoption' puts the result from
// 'lua_getinfo' on top of the result table so that it can call
// 'lua_setfield'.
def private treatstackoption(var L : lua_State?; var L1 : lua_State?; var fname : uint8?) {
    if (intptr(L) == intptr(L1)) {
        // exchange object and table
        lua_rotate(L, -2, 1)
    } else {
        // move object to the "main" stack
        lua_xmove(L1, L, 1)
    }
    // put object into table
    lua_setfield(L, -2, fname)
}

// Calls 'lua_getinfo' and collects all results in a new table.
// L1 needs stack space for an optional input (function) plus
// two optional outputs (function and line table) from function
// 'lua_getinfo'.
[c_function]
def private db_getinfo(var L : lua_State?) : int {
    var ar : lua_Debug
    var arg : int
    var L1 : lua_State? = getthread(L, addr(arg))
    var _c_options : uint8? = luaL_optlstring(L, arg + 2, cstr("flnSrtu"), null)
    checkstack(L, L1, 3)
    let _t0 = _c_options[0] != '>' || luaL_argerror(L, arg + 2, cstr("invalid option '>'")) != 0
    // info about a function?
    if (lua_isfunction(L, arg + 1)) {
        // add '>' to 'options'
        _c_options = lua_pushfstring`va(L, cstr(">%s"), (_c_options,))
        // move function to 'L1' stack
        lua_pushvalue(L, arg + 1)
        lua_xmove(L, L1, 1)
    } else {
        // stack level
        if (lua_getstack(L1, int(luaL_checkinteger(L, arg + 1)), addr(ar)) == 0) {
            // level out of range
            luaL_pushfail(L)
            return 1
        }
    }
    if (lua_getinfo(L1, _c_options, addr(ar)) == 0) {
        return luaL_argerror(L, arg + 2, cstr("invalid option"))
    }
    // table to collect results
    lua_newtable(L)
    if (crt::strchr(_c_options, 'S') != null) {
        lua_pushlstring(L, ar.source, ar.srclen)
        lua_setfield(L, -2, cstr("source"))
        settabss(L, cstr("short_src"), addr(ar.short_src[0]))
        settabsi(L, cstr("linedefined"), ar.linedefined)
        settabsi(L, cstr("lastlinedefined"), ar.lastlinedefined)
        settabss(L, cstr("what"), ar.what)
    }
    if (crt::strchr(_c_options, 'l') != null) {
        settabsi(L, cstr("currentline"), ar.currentline)
    }
    if (crt::strchr(_c_options, 'u') != null) {
        settabsi(L, cstr("nups"), int(ar.nups))
        settabsi(L, cstr("nparams"), int(ar.nparams))
        settabsb(L, cstr("isvararg"), int(ar.isvararg))
    }
    if (crt::strchr(_c_options, 'n') != null) {
        settabss(L, cstr("name"), ar.name)
        settabss(L, cstr("namewhat"), ar.namewhat)
    }
    if (crt::strchr(_c_options, 'r') != null) {
        settabsi(L, cstr("ftransfer"), int(ar.ftransfer))
        settabsi(L, cstr("ntransfer"), int(ar.ntransfer))
    }
    if (crt::strchr(_c_options, 't') != null) {
        settabsb(L, cstr("istailcall"), int(ar.istailcall))
    }
    if (crt::strchr(_c_options, 'L') != null) {
        treatstackoption(L, L1, cstr("activelines"))
    }
    if (crt::strchr(_c_options, 'f') != null) {
        treatstackoption(L, L1, cstr("func"))
    }
    // return table
    return 1
}

[c_function]
def private db_getlocal(var L : lua_State?) : int {
    var arg : int
    var L1 : lua_State? = getthread(L, addr(arg))
    // local-variable index
    let nvar : int = int(luaL_checkinteger(L, arg + 2))
    // function argument?
    if (lua_isfunction(L, arg + 1)) {
        // push function
        lua_pushvalue(L, arg + 1)
        // push local name
        lua_pushstring(L, lua_getlocal(L, null, nvar))
        // return only name (there is no value)
        return 1
    } else {
        // stack-level argument
        var ar : lua_Debug
        var name : uint8?
        let level : int = int(luaL_checkinteger(L, arg + 1))
        // out of range?
        if (lua_getstack(L1, level, addr(ar)) == 0) {
            return luaL_argerror(L, arg + 1, cstr("level out of range"))
        }
        checkstack(L, L1, 1)
        name = lua_getlocal(L1, addr(ar), nvar)
        if (name != null) {
            // move local value
            lua_xmove(L1, L, 1)
            // push name
            lua_pushstring(L, name)
            // re-order
            lua_rotate(L, -2, 1)
            return 2
        } else {
            // no name (nor value)
            luaL_pushfail(L)
            return 1
        }
    }
}

[c_function]
def private db_setlocal(var L : lua_State?) : int {
    var arg : int
    var name : uint8?
    var L1 : lua_State? = getthread(L, addr(arg))
    var ar : lua_Debug
    let level : int = int(luaL_checkinteger(L, arg + 1))
    let nvar : int = int(luaL_checkinteger(L, arg + 2))
    // out of range?
    if (lua_getstack(L1, level, addr(ar)) == 0) {
        return luaL_argerror(L, arg + 1, cstr("level out of range"))
    }
    luaL_checkany(L, arg + 3)
    lua_settop(L, arg + 3)
    checkstack(L, L1, 1)
    lua_xmove(L, L1, 1)
    name = lua_setlocal(L1, addr(ar), nvar)
    if (name == null) {
        // pop value (if not popped by 'lua_setlocal')
        lua_pop(L1, 1)
    }
    lua_pushstring(L, name)
    return 1
}

// get (if 'get' is true) or set an upvalue from a closure
[c_function]
def private auxupvalue(var L : lua_State?; get : int) : int {
    var name : uint8?
    // upvalue index
    let n : int = int(luaL_checkinteger(L, 2))
    // closure
    luaL_checktype(L, 1, LUA_TFUNCTION)
    name = get != 0 ? lua_getupvalue(L, 1, n) : lua_setupvalue(L, 1, n)
    if (name == null) {
        return 0
    }
    lua_pushstring(L, name)
    // no-op if get is false
    lua_insert(L, -(get + 1))
    return get + 1
}

