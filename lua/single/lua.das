def private math_log(var L : lua_State?) : int {
    let x : double = luaL_checknumber(L, 1)
    var res : double
    if (lua_isnoneornil(L, 2)) {
        res = math::log(x)
    } else {
        let base : double = luaL_checknumber(L, 2)
        if (base == 2.0lf) {
            res = math::log2(x)
        } elif (base == 10.0lf) {
            res = math::log10(x)
        } else {
            res = math::log(x) / math::log(base)
        }
    }
    lua_pushnumber(L, res)
    return 1
}

def private math_exp(var L : lua_State?) : int {
    lua_pushnumber(L, math::exp(luaL_checknumber(L, 1)))
    return 1
}

def private math_deg(var L : lua_State?) : int {
    lua_pushnumber(L, luaL_checknumber(L, 1) * (180.0lf / 3.141592653589793lf))
    return 1
}

def private math_rad(var L : lua_State?) : int {
