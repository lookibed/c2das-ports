[c_function]
def lua_tolstring(var L : lua_State?; idx : int; var len : uint64?) : uint8? {
    var o : TValue?
    o = index2value(L, idx)
    if (!ttisstring(o)) {
        // not convertible?
        if (!cvt2str(o)) {
            if (len != null) {
                *len = 0ul
            }
            return null
        }
        luaO_tostring(L, o)
        luaC_checkGC(L)
        // previous call may reallocate the stack
        o = index2value(L, idx)
    }
    if (len != null) {
        *len = tsvalue(o).shrlen != 255 ? uint64(tsvalue(o).shrlen) : tsvalue(o).u.lnglen
    }
    return addr(tsvalue(o).contents[0])
}

