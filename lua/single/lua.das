    lua_pushstring(L, addr(c2das_empty[0]))
    // copy table
    lua_pushvalue(L, -2)
    // set table as metatable for strings
    lua_setmetatable(L, -2)
    // pop dummy string
    lua_pop(L, 1)
    // get string library
    lua_pushvalue(L, -2)
    // metatable.__index = string
    lua_setfield(L, -2, cstr("__index"))
    // pop metatable
    lua_pop(L, 1)
}

// Open string library
[c_function]
def luaopen_string(var L : lua_State?) : int {
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[18]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(strlib[0]), 0)
    createmetatable(L)
    return 1
}

def private checkfield(var L : lua_State?; var key : uint8?; n : int) : int {
    lua_pushstring(L, key)
    return int_of(lua_rawget(L, -n) != LUA_TNIL)
}

// Check that 'arg' either is a table or can behave like one (that is,
// has a metatable with the required metamethods)
def private checktab(var L : lua_State?; arg : int; what : int) {
    // is it not a table?
    if (lua_type(L, arg) != LUA_TTABLE) {
        // number of elements to pop
        var n : int = 1
        // must have metatable
        var _t1 = lua_getmetatable(L, arg) != 0
        if (_t1) {
            var _t0 = (what & TAB_R) == 0
            if (!_t0) {
                n++
                _t0 = checkfield(L, cstr("__index"), n) != 0
            }
            _t1 = _t0
        }
        var _t3 = _t1
        if (_t3) {
            var _t2 = (what & TAB_W) == 0
            if (!_t2) {
                n++
                _t2 = checkfield(L, cstr("__newindex"), n) != 0
            }
            _t3 = _t2
        }
        var _t5 = _t3
        if (_t5) {
            var _t4 = (what & TAB_L) == 0
            if (!_t4) {
                n++
                _t4 = checkfield(L, cstr("__len"), n) != 0
            }
            _t5 = _t4
        }
        if (_t5) {
            // pop metatable and tested metamethods
            lua_pop(L, n)
        } else {
            // force an error
            luaL_checktype(L, arg, LUA_TTABLE)
