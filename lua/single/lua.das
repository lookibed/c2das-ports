// Finish a table assignment 't[key] = val'.
// If 'slot' is NULL, 't' is not a table. Otherwise, 'slot' points
// to the entry 't[key]', or to a value with an absent key if there
// is no such entry. (The value at 'slot' must be empty, otherwise
// 'luaV_fastget' would have done the job.)
[c_function]
def luaV_finishset(var L : lua_State?; var t : TValue?; var key : TValue?; var val : TValue?; var slot : TValue?) {
    // counter to avoid infinite loops
    for (loop in range(MAXTAGLOOP)) {
        // '__newindex' metamethod
        var tm : TValue?
        // is 't' a table?
        if (slot != null) {
            // save 't' table
            var h : Table? = gco2t(t.value_.gc)
            // slot must be empty
            // get metamethod
            tm = h.metatable == null ? default<TValue?> : ((uint(h.metatable.flags) & (1u << uint(TMS.TM_NEWINDEX))) != 0 ? default<TValue?> :
                    luaT_gettm(h.metatable, TMS.TM_NEWINDEX, L.l_G.tmname[int(TMS.TM_NEWINDEX)]))
            // no metamethod?
            if (tm == null) {
                {
                    // anchor 't'
                    var io : TValue? = s2v(L.top.p)
                    var x_ : Table? = h
                    io.value_.gc = obj2gco(x_)
                    settt_(io, ctb(LUA_TTABLE | (0 << 4)))
                }
                // assume EXTRA_STACK
                L.top.p++
                // set new value
                luaH_finishset(L, h, key, slot, val)
                L.top.p--
                invalidateTMcache(h)
                if ((int(val.tt_) & BIT_ISCOLLECTABLE) != 0) {
                    if ((int(addr(reinterpret<GCUnion?>(h).gc).marked) & (1 << BLACKBIT)) != 0 &&
