            (!((int(rawtt(o2)) & 15) == LUA_TNIL) || intptr(o2) != intptr(reinterpret<TValue?>(addr(G(L).nilvalue))))) {
        c_switch(op) {
            case(0) {
                i = luaV_equalobj(L, o1, o2)
                break
