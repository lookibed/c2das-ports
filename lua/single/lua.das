        status = luaD_pcall(L, @@f_call, reinterpret<void?>(addr(c)), savestack(L, c.func), func)
    } else {
        // prepare continuation (call is already protected by 'resume')
        var ci : CallInfo? = L.ci
        // save continuation
        ci.u.c.k = k
        // save context
        ci.u.c.ctx = ctx
        // save information for error recovery
        ci.u2.funcidx = int(savestack(L, c.func))
        ci.u.c.old_errfunc = L.errfunc
        L.errfunc = func
        // save value of 'allowhook'
        ci.callstatus = uint16((int(ci.callstatus) & ~CIST_OAH) | int(L.allowhook))
        // function can do error recovery
        ci.callstatus = uint16(int(ci.callstatus) | CIST_YPCALL)
        // do the call
        luaD_call(L, c.func, nresults)
        ci.callstatus = uint16(int(ci.callstatus) & ~CIST_YPCALL)
        L.errfunc = ci.u.c.old_errfunc
        // if it is here, there were no errors
        status = LUA_OK
    }
    adjustresults(L, nresults)
    return status
}

[c_function]
def lua_load(var L : lua_State?; reader : function<(var a0 : lua_State?; var a1 : void?; var a2 : uint64?) : uint8?>; var data : void?; var chunkname : uint8?;
             var mode : uint8?) : int {
    var z : Zio
    var status : int
    if (chunkname == null) {
        chunkname = cstr("?")
    }
    luaZ_init(L, addr(z), reader, data)
    status = luaD_protectedparser(L, addr(z), chunkname, mode)
    // no errors?
    if (status == LUA_OK) {
        // get new function
        var f : LClosure? = clLvalue(s2v(L.top.p - 1))
        // does it have an upvalue?
        if (int(f.nupvalues) >= 1) {
            // get global table from registry
            var gt : TValue? = getGtable(L)
            {
                // set global table as 1st upvalue of 'f' (may be LUA_ENV)
                var io1 : TValue? = addr(f.upvals[0])[0].v.p
                var io2 : TValue? = gt
                io1.value_ = io2.value_
                settt_(io1, io2.tt_)
            }
            if (iscollectable(gt) != 0) {
                if ((int(addr(f.upvals[0])[0].marked) & (1 << BLACKBIT)) != 0 && (int(gcvalue(gt).marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
                    luaC_barrier_(L, addr(reinterpret<GCUnion?>(addr(f.upvals[0])[0]).gc), addr(reinterpret<GCUnion?>(gcvalue(gt)).gc))
                }
            }
        }
    }
    return status
}

[c_function]
def lua_dump(var L : lua_State?; writer : function<(var a0 : lua_State?; var a1 : void?; a2 : uint64; var a3 : void?) : int>; var data : void?;
             strip : int) : int {
    var status : int
    var o : TValue?
    o = s2v(L.top.p - 1)
    if (isLfunction(o)) {
        status = luaU_dump(L, getproto(o), writer, data, strip)
    } else {
        status = 1
    }
    return status
}

def lua_status(var L : lua_State?) : int {
    return int(L.status)
}

// Garbage-collection function
[variadic]
def lua_gc(var L : lua_State?; what : int; va : va_args) : int {
    var argp : CVaCursor
    var res : int = 0
    var g : global_State? = G(L)
    // internal stop?
    if ((int(g.gcstp) & GCSTPGC) != 0) {
        // all options are invalid when stopped
        return -1
    }
    argp = va_begin(va)
    c_switch(what) {
        case(0) {
            // stopped by the user
            g.gcstp = uint8(GCSTPUSR)
            break
        }
        case(1) {
            luaE_setdebt(g, 0l)
            // (GCSTPGC must be already zero here)
            g.gcstp = 0u8
            break
        }
        case(2) {
            luaC_fullgc(L, 0)
            break
        }
        case(3) {
            // GC values are expressed in Kbytes: #bytes/2^10
            res = int(gettotalbytes(g) >> 10ul)
            break
        }
        case(4) {
            res = int(gettotalbytes(g) & 1023ul)
            break
        }
        case(5) {
            {
                let data : int = int(va_i(argp))
                // =1 to signal that it did an actual step
                var debt : int64 = 1l
                let oldstp : uint8 = g.gcstp
                // allow GC to run (GCSTPGC must be zero here)
                g.gcstp = 0u8
                if (data == 0) {
                    // do a basic step
                    luaE_setdebt(g, 0l)
                    luaC_step(L)
                } else {
                    // add 'data' to total debt
                    debt = int64(data) * 1024l + g.GCdebt
                    luaE_setdebt(g, debt)
                    luaC_checkGC(L)
                }
                // restore previous state
                g.gcstp = oldstp
                // end of cycle?
                if (debt > 0l && int(g.gcstate) == GCSpause) {
                    // signal it
                    res = 1
                }
                break
            }
        }
        case(6) {
            {
                let data : int = int(va_i(argp))
                res = getgcparam(g.gcpause)
                g.gcpause = uint8(data / 4)
                break
            }
        }
        case(7) {
            {
                let data : int = int(va_i(argp))
                res = getgcparam(g.gcstepmul)
                g.gcstepmul = uint8(data / 4)
                break
            }
        }
        case(9) {
            res = int_of(gcrunning(g))
            break
        }
        case(10) {
            {
                let minormul : int = int(va_i(argp))
                let majormul : int = int(va_i(argp))
                res = isdecGCmodegen(g) ? LUA_GCGEN : LUA_GCINC
                if (minormul != 0) {
                    g.genminormul = uint8(minormul)
                }
                if (majormul != 0) {
                    g.genmajormul = uint8(majormul / 4)
                }
                luaC_changemode(L, KGC_GEN)
                break
            }
        }
        case(11) {
            {
                let pause : int = int(va_i(argp))
                let stepmul : int = int(va_i(argp))
                let stepsize : int = int(va_i(argp))
                res = isdecGCmodegen(g) ? LUA_GCGEN : LUA_GCINC
                if (pause != 0) {
                    g.gcpause = uint8(pause / 4)
                }
                if (stepmul != 0) {
                    g.gcstepmul = uint8(stepmul / 4)
                }
                if (stepsize != 0) {
                    g.gcstepsize = uint8(stepsize)
                }
                luaC_changemode(L, KGC_INC)
                break
            }
        }
        case(_) {
            // invalid option
            res = -1
        }
    }
    return res
}

[c_function]
def lua_error(var L : lua_State?) : int {
    var errobj : TValue?
    errobj = s2v(L.top.p - 1)
    // error object is the memory error message?
    if (ttisshrstring(errobj) && eqshrstr(tsvalue(errobj), G(L).memerrmsg)) {
        // raise a memory error
        luaM_error(L)
    } else {
        // raise a regular error
        luaG_errormsg(L)
    }
    // code unreachable; will unlock when control actually leaves the kernel
    // to avoid warnings
    return 0
}

[c_function]
def lua_next(var L : lua_State?; idx : int) : int {
    var t : Table?
    var more : int
    t = gettable(L, idx)
    more = luaH_next(L, t, L.top.p - 1)
    if (more != 0) {
        api_incr_top(L)
    } else {
        // no more elements
        // remove key
        L.top.p -= 1
    }
    return more
}

def lua_toclose(var L : lua_State?; idx : int) {
    var nresults : int
    var o : StackValue?
    o = index2stack(L, idx)
    nresults = int(L.ci.nresults)
    // create new to-be-closed upvalue
    luaF_newtbcupval(L, o)
    // function not marked yet?
    if (!hastocloseCfunc(nresults)) {
        // mark it
        L.ci.nresults = int16(codeNresults(nresults))
    }
}

[c_function]
def lua_concat(var L : lua_State?; n : int) {
    if (n > 0) {
        luaV_concat(L, n)
    } else {
        {
            // nothing to concatenate
            // push empty string
            var io : TValue? = s2v(L.top.p)
            var x_ : TString? = luaS_newlstr(L, addr(c2das_empty[0]), 0ul)
            io.value_.gc = obj2gco(x_)
            settt_(io, ctb(x_.tt))
        }
        api_incr_top(L)
    }
    luaC_checkGC(L)
}

def lua_len(var L : lua_State?; idx : int) {
    var t : TValue?
    t = index2value(L, idx)
    luaV_objlen(L, L.top.p, t)
    api_incr_top(L)
}

[c_function]
def lua_getallocf(var L : lua_State?; var ud : void ??) : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?> {
    var f : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?>
    if (ud != null) {
        *ud = G(L).ud
    }
    f = G(L).frealloc
    return f
}

def lua_setallocf(var L : lua_State?; f : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?>; var ud : void?) {
    G(L).ud = ud
    G(L).frealloc = f
}

def lua_setwarnf(var L : lua_State?; f : function<(var a0 : void?; var a1 : uint8?; a2 : int) : void>; var ud : void?) {
    G(L).ud_warn = ud
    G(L).warnf = f
}

def lua_warning(var L : lua_State?; var msg : uint8?; tocont : int) {
    luaE_warning(L, msg, tocont)
}

[c_function]
def lua_newuserdatauv(var L : lua_State?; size : uint64; nuvalue : int) : void? {
    var u : Udata?
    u = luaS_newudata(L, size, nuvalue)
    {
        var io : TValue? = s2v(L.top.p)
        var x_ : Udata? = u
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(LUA_TUSERDATA | (0 << 4)))
    }
    api_incr_top(L)
    luaC_checkGC(L)
    return reinterpret<void?>(reinterpret<uint8?>(u) + (u.nuvalue == 0 ? uint64(typeinfo offsetof < bindata > (type<Udata0>)) :
            uint64(typeinfo offsetof < uv > (type<Udata>)) + uint64(typeinfo sizeof(type<UValue>)) * uint64(u.nuvalue)))
}

[c_function]
def private aux_upvalue(var fi : TValue?; n : int; var val : TValue ??; var owner : GCObject ??) : uint8? {
    c_switch(int(rawtt(fi)) & 63) {
        case(38) {
            {
                // C closure
                var f : CClosure? = clCvalue(fi)
                if (!(uint(n) - 1u < uint(f.nupvalues))) {
                    // 'n' not in [1, f->nupvalues]
                    return null
                }
                *val = addr(addr(f.upvalue[0])[n - 1])
                if (owner != null) {
                    *owner = obj2gco(f)
                }
                return addr(c2das_empty[0])
            }
        }
        case(6) {
            {
                // Lua closure
                var f : LClosure? = clLvalue(fi)
                var name : TString?
                var p : Proto? = f.p
                if (!(uint(n) - 1u < uint(p.sizeupvalues))) {
                    // 'n' not in [1, p->sizeupvalues]
                    return null
                }
                *val = addr(f.upvals[0])[n - 1].v.p
                if (owner != null) {
                    *owner = obj2gco(addr(f.upvals[0])[n - 1])
                }
                name = p.upvalues[n - 1].name
                return (name == null) ? cstr("(no name)") : addr(name.contents[0])
            }
        }
        case(_) {
            // not a closure
            return null
        }
    }
}

[c_function]
def lua_getupvalue(var L : lua_State?; funcindex : int; n : int) : uint8? {
    var name : uint8?
    // to avoid warnings
    var val : TValue? = null
    name = aux_upvalue(index2value(L, funcindex), n, addr(val), null)
    if (name != null) {
        {
            var io1 : TValue? = s2v(L.top.p)
            var io2 : TValue? = val
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        api_incr_top(L)
    }
    return name
}

[c_function]
def lua_setupvalue(var L : lua_State?; funcindex : int; n : int) : uint8? {
    var name : uint8?
    // to avoid warnings
    var val : TValue? = null
    // to avoid warnings
    var owner : GCObject? = null
    var fi : TValue?
    fi = index2value(L, funcindex)
    name = aux_upvalue(fi, n, addr(val), addr(owner))
    if (name != null) {
        L.top.p--
        {
            var io1 : TValue? = val
            var io2 : TValue? = s2v(L.top.p)
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        luaC_barrier(L, owner, val)
    }
    return name
}

[c_function]
def private getupvalref(var L : lua_State?; fidx : int; n : int; var pf : LClosure ??) : UpVal ?? {
    var f : LClosure?
    var fi : TValue? = index2value(L, fidx)
    f = clLvalue(fi)
    if (pf != null) {
        *pf = f
    }
    if (1 <= n && n <= f.p.sizeupvalues) {
        // get its upvalue pointer
        return addr(addr(f.upvals[0])[n - 1])
    } else {
        return addr(getupvalref_nullup)
    }
}

[c_function]
def lua_upvalueid(var L : lua_State?; fidx : int; n : int) : void? {
    var fi : TValue? = index2value(L, fidx)
    c_switch(int(rawtt(fi)) & 63) {
        case(6) {
            // lua closure
            return reinterpret<void?>(*getupvalref(L, fidx, n, null))
        }
        case(38) {
            {
                // C closure
                var f : CClosure? = clCvalue(fi)
                if (1 <= n && n <= int(f.nupvalues)) {
                    return reinterpret<void?>(addr(addr(f.upvalue[0])[n - 1]))
                }
            }
        }
        case(22) {
            // else
            // FALLTHROUGH
            // light C functions have no upvalues
            return null
        }
        case(_) {
            return null
        }
    }
    return null
}

[c_function]
def lua_upvaluejoin(var L : lua_State?; fidx1 : int; n1 : int; fidx2 : int; n2 : int) {
    var f1 : LClosure?
    var up1 : UpVal ?? = getupvalref(L, fidx1, n1, addr(f1))
    var up2 : UpVal ?? = getupvalref(L, fidx2, n2, null)
    *up1 = *up2
    if (isblack(f1) != 0 && iswhite(*up1) != 0) {
        luaC_barrier_(L, obj2gco(f1), obj2gco(*up1))
    }
}

// semantic error
def luaK_semerror(var ls : LexState?; var msg : uint8?) {
    // remove "near <token>" from final message
    ls.t.token = 0
    luaX_syntaxerror(ls, msg)
}

// If expression is a numeric constant, fills 'v' with its value
// and returns 1. Otherwise, returns 0.
def private tonumeral(var e : expdesc?; var v : TValue?) : int {
    if (hasjumps(e)) {
        // not a numeral
        return 0
    }
    c_switch(e.k) {
        case(expkind.VKINT) {
            if (v != null) {
                var io : TValue? = v
                io.value_.i = e.u.ival
                settt_(io, LUA_TNUMBER | (0 << 4))
            }
            return 1
        }
        case(expkind.VKFLT) {
            if (v != null) {
                var io : TValue? = v
                io.value_.n = e.u.nval
                settt_(io, LUA_TNUMBER | (1 << 4))
            }
            return 1
        }
        case(_) {
            return 0
        }
    }
}

// Get the constant value from a constant expression
[c_function]
def private const2val(var fs : FuncState?; var e : expdesc?) : TValue? {
    return addr(fs.ls.dyd.actvar.arr[e.u.info].k)
}

// If expression is a constant, fills 'v' with its value
// and returns 1. Otherwise, returns 0.
def luaK_exp2const(var fs : FuncState?; var e : expdesc?; var v : TValue?) : int {
    if (hasjumps(e)) {
        // not a constant
        return 0
    }
    c_switch(e.k) {
        case(expkind.VFALSE) {
            setbfvalue(v)
            return 1
        }
        case(expkind.VTRUE) {
            setbtvalue(v)
            return 1
        }
        case(expkind.VNIL) {
            setnilvalue(v)
            return 1
        }
        case(expkind.VKSTR) {
            {
                var io : TValue? = v
                var x_ : TString? = e.u.strval
                io.value_.gc = obj2gco(x_)
                settt_(io, ctb(x_.tt))
                let _t0 = fs.ls.L
            }
            return 1
        }
        case(expkind.VCONST) {
            {
                var io1 : TValue? = v
                var io2 : TValue? = const2val(fs, e)
                io1.value_ = io2.value_
                settt_(io1, io2.tt_)
                let _t1 = fs.ls.L
            }
            return 1
        }
        case(_) {
            return tonumeral(e, v)
        }
    }
}

// Return the previous instruction of the current code. If there
// may be a jump target between the current instruction and the
// previous one, return an invalid instruction (to avoid wrong
// optimizations).
[c_function]
def private previousinstruction(var fs : FuncState?) : uint? {
    if (fs.pc > fs.lasttarget) {
        // previous instruction
        return addr(fs.f.code[fs.pc - 1])
    } else {
        return addr(previousinstruction_invalidinstruction)
    }
}

// Create a OP_LOADNIL instruction, but try to optimize: if the previous
// instruction is also OP_LOADNIL and ranges are compatible, adjust
// range of previous instruction instead of emitting a new one. (For
// instance, 'local a; local b' will generate a single opcode.)
[c_function]
def luaK_nil(var fs : FuncState?; var from : int; n : int) {
    // last register to set nil
    var l : int = from + n - 1
    var previous : uint? = previousinstruction(fs)
    // previous is LOADNIL?
    if (GET_OPCODE(*previous) == OpCode.OP_LOADNIL) {
        // get previous range
        let pfrom : int = GETARG_A(*previous)
        let pl : int = pfrom + GETARG_B(*previous)
        if ((pfrom <= from && from <= pl + 1) || (from <= pfrom && pfrom <= l + 1)) {
            // can connect both?
            // from = min(from, pfrom)
            if (pfrom < from) {
                from = pfrom
            }
            // l = max(l, pl)
            if (pl > l) {
                l = pl
            }
            *previous = (*previous & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(from) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
            *previous = (*previous & ~(~(~0u << uint(SIZE_B)) << uint(POS_B))) | ((uint(l - from) << uint(POS_B)) & (~(~0u << uint(SIZE_B)) << uint(POS_B)))
            return
        }
    }
    // else go through
    // else no optimization
    luaK_codeABCk(fs, OpCode.OP_LOADNIL, from, n - 1, 0, 0)
}

// Gets the destination address of a jump instruction. Used to traverse
// a list of jumps.
[c_function]
def private getjump(var fs : FuncState?; pc : int) : int {
    let offset : int = GETARG_sJ(fs.f.code[pc])
    // point to itself represents end of list
    if (offset == NO_JUMP) {
        // end of list
        return NO_JUMP
    } else {
        // turn offset into absolute position
        return (pc + 1) + offset
    }
}

// Fix jump instruction at position 'pc' to jump to 'dest'.
// (Jump addresses are relative in Lua)
[c_function]
def private fixjump(var fs : FuncState?; pc : int; dest : int) {
    var jmp : uint? = addr(fs.f.code[pc])
    let offset : int = dest - (pc + 1)
    if (!(-OFFSET_sJ <= offset && offset <= MAXARG_sJ - OFFSET_sJ)) {
        luaX_syntaxerror(fs.ls, cstr("control structure too long"))
    }
    *jmp = (*jmp & MASK0(SIZE_sJ, POS_A)) | ((uint(offset + OFFSET_sJ) << uint(POS_A)) & MASK1(SIZE_sJ, POS_A))
}

// Concatenate jump-list 'l2' into jump-list 'l1'
[c_function]
def luaK_concat(var fs : FuncState?; var l1 : int?; l2 : int) {
    // nothing to concatenate?
    if (l2 == NO_JUMP) {
        return
    } elif (*l1 == NO_JUMP) {
        // no original list?
        // 'l1' points to 'l2'
        *l1 = l2
    } else {
        var list : int = *l1
        var next : int
        // find last element
        while (true) {
            next = getjump(fs, list)
            if (!(next != NO_JUMP)) {
                break
            }
            list = next
        }
        // last element links to 'l2'
        fixjump(fs, list, l2)
    }
}

// Create a jump instruction and return its position, so its destination
// can be fixed later (with 'fixjump').
def luaK_jump(var fs : FuncState?) : int {
    return codesJ(fs, OpCode.OP_JMP, NO_JUMP, 0)
}

// Code a 'return' instruction
def luaK_ret(var fs : FuncState?; first : int; nret : int) {
    var op : OpCode
    c_switch(nret) {
        case(0) {
            op = OpCode.OP_RETURN0
            break
        }
        case(1) {
            op = OpCode.OP_RETURN1
            break
        }
        case(_) {
            op = OpCode.OP_RETURN
            break
        }
    }
    luaK_codeABC(fs, op, first, nret + 1, 0)
}

// Code a "conditional jump", that is, a test or comparison opcode
// followed by a jump. Return jump position.
def private condjump(var fs : FuncState?; op : OpCode; A : int; B : int; C : int; k : int) : int {
    luaK_codeABCk(fs, op, A, B, C, k)
    return luaK_jump(fs)
}

// returns current 'pc' and marks it as a jump target (to avoid wrong
// optimizations with consecutive instructions not in the same basic block).
def luaK_getlabel(var fs : FuncState?) : int {
    fs.lasttarget = fs.pc
    return fs.pc
}

// Returns the position of the instruction "controlling" a given
// jump (that is, its condition), or the jump itself if it is
// unconditional.
[c_function]
def private getjumpcontrol(var fs : FuncState?; pc : int) : uint? {
    var pi : uint? = addr(fs.f.code[pc])
    if (pc >= 1 && testTMode(GET_OPCODE(*(pi - 1))) != 0) {
        return pi - 1
    } else {
        return pi
    }
}

// Patch destination register for a TESTSET instruction.
// If instruction in position 'node' is not a TESTSET, return 0 ("fails").
// Otherwise, if 'reg' is not 'NO_REG', set it as the destination
// register. Otherwise, change instruction to a simple 'TEST' (produces
// no register value)
[c_function]
def private patchtestreg(var fs : FuncState?; node : int; reg : int) : int {
    var i : uint? = getjumpcontrol(fs, node)
    if (enum_from_int(type<OpCode>, int((*i >> uint(POS_OP)) & (~(~0u << uint(SIZE_OP)) << 0u))) != OpCode.OP_TESTSET) {
        // cannot patch other instructions
        return 0
    }
    if (reg != NO_REG && reg != int((*i >> uint(POS_B)) & (~(~0u << uint(SIZE_B)) << 0u))) {
        *i = (*i & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(reg) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
    } else {
        // no register to put value or register already has the value;
        // change instruction to simple test
        *i = (uint(OpCode.OP_TEST) << uint(POS_OP)) | (uint(int((*i >> uint(POS_B)) & (~(~0u << uint(SIZE_B)) << 0u))) << uint(POS_A)) | (0u <<
                uint(POS_B)) | (0u << uint(POS_C)) | (uint(int((*i >> uint(POS_k)) & (~(~0u << 1u) << 0u))) << uint(POS_k))
    }
    return 1
}

// Traverse a list of tests ensuring no one produces a value
def private removevalues(var fs : FuncState?; var list : int) {
    while (list != NO_JUMP) {
        patchtestreg(fs, list, NO_REG)
        list = getjump(fs, list)
    }
}

// Traverse a list of tests, patching their destination address and
// registers: tests producing values jump to 'vtarget' (and put their
// values in 'reg'), other tests jump to 'dtarget'.
def private patchlistaux(var fs : FuncState?; var list : int; vtarget : int; reg : int; dtarget : int) {
    while (list != NO_JUMP) {
        let next : int = getjump(fs, list)
        if (patchtestreg(fs, list, reg) != 0) {
            fixjump(fs, list, vtarget)
        } else {
            // jump to default target
            fixjump(fs, list, dtarget)
        }
        list = next
    }
}

// Path all jumps in 'list' to jump to 'target'.
// (The assert means that we cannot fix a jump to a forward address
// because we only know addresses once code is generated.)
def luaK_patchlist(var fs : FuncState?; list : int; target : int) {
    patchlistaux(fs, list, target, NO_REG, target)
}

def luaK_patchtohere(var fs : FuncState?; list : int) {
    // mark "here" as a jump target
    let hr : int = luaK_getlabel(fs)
    luaK_patchlist(fs, list, hr)
}

// Save line info for a new instruction. If difference from last line
// does not fit in a byte, of after that many instructions, save a new
// absolute line info; (in that case, the special value 'ABSLINEINFO'
// in 'lineinfo' signals the existence of this absolute information.)
// Otherwise, store the difference from last line in 'lineinfo'.
[c_function]
def private savelineinfo(var fs : FuncState?; var f : Proto?; line : int) {
    var linedif : int = line - fs.previousline
    // last instruction coded
    let pc : int = fs.pc - 1
    var _t1 = crt::abs(linedif) >= LIMLINEDIFF
    if (!_t1) {
        let _t0 = fs.iwthabs
        fs.iwthabs = uint8(uint(fs.iwthabs) + 1)
        _t1 = int(_t0) >= MAXIWTHABS
    }
    if (_t1) {
        f.abslineinfo = reinterpret<AbsLineInfo?>(luaM_growaux_(fs.ls.L, reinterpret<void?>(f.abslineinfo), fs.nabslineinfo, addr(f.sizeabslineinfo),
                typeinfo sizeof(type<AbsLineInfo>),
                int(2147483647ul <= MAX_SIZET / uint64(typeinfo sizeof(type<AbsLineInfo>)) ? 2147483647u :
                    uint(MAX_SIZET / uint64(typeinfo sizeof(type<AbsLineInfo>)))),
                cstr("lines")))
        f.abslineinfo[fs.nabslineinfo].pc = pc
        let _t2 = fs.nabslineinfo
        fs.nabslineinfo++
        f.abslineinfo[_t2].line = line
        // signal that there is absolute information
        linedif = ABSLINEINFO
        // restart counter
        fs.iwthabs = 1u8
    }
    f.lineinfo = reinterpret<int8?>(luaM_growaux_(fs.ls.L, reinterpret<void?>(f.lineinfo), pc, addr(f.sizelineinfo), typeinfo sizeof(type<int8>),
            int(2147483647ul <= MAX_SIZET / uint64(typeinfo sizeof(type<int8>)) ? 2147483647u : uint(MAX_SIZET / uint64(typeinfo sizeof(type<int8>)))),
            cstr("opcodes")))
    f.lineinfo[pc] = int8(linedif)
    // last line saved
    fs.previousline = line
}

// Remove line information from the last instruction.
// If line information for that instruction is absolute, set 'iwthabs'
// above its max to force the new (replacing) instruction to have
// absolute line info, too.
[c_function]
def private removelastlineinfo(var fs : FuncState?) {
    var f : Proto? = fs.f
    // last instruction coded
    let pc : int = fs.pc - 1
    // relative line info?
    if (int(f.lineinfo[pc]) != ABSLINEINFO) {
        // correct last line saved
        fs.previousline -= int(f.lineinfo[pc])
        // undo previous increment
        fs.iwthabs = uint8(uint(fs.iwthabs) - 1)
    } else {
        // absolute line information
        // remove it
        fs.nabslineinfo--
        // force next line info to be absolute
        fs.iwthabs = uint8(MAXIWTHABS + 1)
    }
}

// Remove the last instruction created, correcting line information
// accordingly.
def private removelastinstruction(var fs : FuncState?) {
    removelastlineinfo(fs)
    fs.pc--
}

// Emit instruction 'i', checking for array sizes and saving also its
// line information. Return 'i' position.
[c_function]
def luaK_code(var fs : FuncState?; i : uint) : int {
    var f : Proto? = fs.f
    // put new instruction in code array
    f.code = reinterpret<uint?>(luaM_growaux_(fs.ls.L, reinterpret<void?>(f.code), fs.pc, addr(f.sizecode), typeinfo sizeof(type<uint>),
            int(2147483647ul <= MAX_SIZET / uint64(typeinfo sizeof(type<uint>)) ? 2147483647u : uint(MAX_SIZET / uint64(typeinfo sizeof(type<uint>)))),
            cstr("opcodes")))
    let _t0 = fs.pc
    fs.pc++
    f.code[_t0] = i
    savelineinfo(fs, f, fs.ls.lastline)
    // index of new instruction
    return fs.pc - 1
}

// Format and emit an 'iABC' instruction. (Assertions check consistency
// of parameters versus opcode.)
def luaK_codeABCk(var fs : FuncState?; o : OpCode; a : int; b : int; c : int; k : int) : int {
    return luaK_code(fs, CREATE_ABCk(o, a, b, c, k))
}

// Format and emit an 'iABx' instruction.
def luaK_codeABx(var fs : FuncState?; o : OpCode; a : int; bc : uint) : int {
    return luaK_code(fs, CREATE_ABx(o, a, bc))
}

// Format and emit an 'iAsBx' instruction.
def private codeAsBx(var fs : FuncState?; o : OpCode; a : int; bc : int) : int {
    let b : uint = uint(bc + OFFSET_sBx)
    return luaK_code(fs, CREATE_ABx(o, a, b))
}

// Format and emit an 'isJ' instruction.
def private codesJ(var fs : FuncState?; o : OpCode; sj : int; k : int) : int {
    let j : uint = uint(sj + OFFSET_sJ)
    return luaK_code(fs, CREATE_sJ(o, j, k))
}

// Emit an "extra argument" instruction (format 'iAx')
def private codeextraarg(var fs : FuncState?; a : int) : int {
    return luaK_code(fs, (uint(OpCode.OP_EXTRAARG) << uint(POS_OP)) | (uint(a) << uint(POS_A)))
}

// Emit a "load constant" instruction, using either 'OP_LOADK'
// (if constant index 'k' fits in 18 bits) or an 'OP_LOADKX'
// instruction with "extra argument".
def private luaK_codek(var fs : FuncState?; reg : int; k : int) : int {
    if (k <= MAXARG_Bx) {
        return luaK_codeABx(fs, OpCode.OP_LOADK, reg, uint(k))
    } else {
        let p : int = luaK_codeABx(fs, OpCode.OP_LOADKX, reg, 0u)
        codeextraarg(fs, k)
        return p
    }
}

// Check register-stack level, keeping track of its maximum size
// in field 'maxstacksize'
def luaK_checkstack(var fs : FuncState?; n : int) {
    let newstack : int = int(fs.freereg) + n
    if (newstack > int(fs.f.maxstacksize)) {
        if (newstack >= MAXREGS) {
            luaX_syntaxerror(fs.ls, cstr("function or expression needs too many registers"))
        }
        fs.f.maxstacksize = uint8(newstack)
    }
}

// Reserve 'n' registers in register stack
def luaK_reserveregs(var fs : FuncState?; n : int) {
    luaK_checkstack(fs, n)
    fs.freereg = uint8(int(fs.freereg) + n)
}

// Free register 'reg', if it is neither a constant index nor
// a local variable.
// )
def private freereg(var fs : FuncState?; reg : int) {
    if (reg >= luaY_nvarstack(fs)) {
        fs.freereg = uint8(uint(fs.freereg) - 1)
    }
}

// Free two registers in proper order
def private freeregs(var fs : FuncState?; r1 : int; r2 : int) {
    if (r1 > r2) {
        freereg(fs, r1)
        freereg(fs, r2)
    } else {
        freereg(fs, r2)
        freereg(fs, r1)
    }
}

// Free register used by expression 'e' (if any)
def private freeexp(var fs : FuncState?; var e : expdesc?) {
    if (e.k == expkind.VNONRELOC) {
        freereg(fs, e.u.info)
    }
}

// Free registers used by expressions 'e1' and 'e2' (if any) in proper
// order.
def private freeexps(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?) {
    let r1 : int = (e1.k == expkind.VNONRELOC) ? e1.u.info : -1
    let r2 : int = (e2.k == expkind.VNONRELOC) ? e2.u.info : -1
    freeregs(fs, r1, r2)
}

// Add constant 'v' to prototype's list of constants (field 'k').
// Use scanner's table to cache position of constants in constant list
// and try to reuse constants. Because some values should not be used
// as keys (nil cannot be a key, integer keys can collapse with float
// keys), the caller must provide a useful 'key' for indexing the cache.
// Note that all functions share the same table, so entering or exiting
// a function can make some indices wrong.
[c_function]
def private addk(var fs : FuncState?; var key : TValue?; var v : TValue?) : int {
    var val : TValue
    var L : lua_State? = fs.ls.L
    var f : Proto? = fs.f
    // query scanner table
    var idx : TValue? = luaH_get(fs.ls.h, key)
    var k : int
    var oldsize : int
    // is there an index there?
    if (ttisinteger(idx)) {
        k = int(ivalue(idx))
        // correct value? (warning: must distinguish floats from integers!)
        if (k < fs.nk && (int(rawtt(addr(f.k[k]))) & 63) == (int(rawtt(v)) & 63) && luaV_rawequalobj(addr(f.k[k]), v) != 0) {
            // reuse index
            return k
        }
    }
    // constant not found; create a new entry
    oldsize = f.sizek
    k = fs.nk
    setivalue(addr(val), k)
    // numerical value does not need GC barrier;
    // table has no metatable, so it does not need to invalidate cache
    luaH_finishset(L, fs.ls.h, key, idx, addr(val))
    f.k = reinterpret<TValue?>(luaM_growaux_(L, reinterpret<void?>(f.k), k, addr(f.sizek), typeinfo sizeof(type<TValue>),
            int(uint64(MAXARG_Ax) <= MAX_SIZET / uint64(typeinfo sizeof(type<TValue>)) ? uint(MAXARG_Ax) :
                uint(MAX_SIZET / uint64(typeinfo sizeof(type<TValue>)))),
            cstr("constants")))
    while (oldsize < f.sizek) {
        let _t0 = oldsize
        oldsize++
        addr(f.k[_t0]).tt_ = uint8(LUA_TNIL | (0 << 4))
    }
    {
        var io1 : TValue? = addr(f.k[k])
        var io2 : TValue? = v
        io1.value_ = io2.value_
        settt_(io1, io2.tt_)
    }
    fs.nk++
    luaC_barrier(L, f, v)
    return k
}

// Add a string to list of constants and return its index.
[c_function]
def private stringK(var fs : FuncState?; var s : TString?) : int {
    var o : TValue
    {
        var io : TValue? = addr(o)
        var x_ : TString? = s
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(x_.tt))
        let _t0 = fs.ls.L
    }
    // use string itself as key
    return addk(fs, addr(o), addr(o))
}

// Add an integer to list of constants and return its index.
[c_function]
def private luaK_intK(var fs : FuncState?; n : int64) : int {
    var o : TValue
    setivalue(addr(o), n)
    // use integer itself as key
    return addk(fs, addr(o), addr(o))
}

// Add a float to list of constants and return its index. Floats
// with integral values need a different key, to avoid collision
// with actual integers. To that, we add to the number its smaller
// power-of-two fraction that is still significant in its scale.
// For doubles, that would be 1/2^52.
// (This method is not bulletproof: there may be another float
// with that value, and for floats larger than 2^53 the result is
// still an integer. At worst, this only wastes an entry with
// a duplicate.)
[c_function]
def private luaK_numberK(var fs : FuncState?; r : double) : int {
    var o : TValue
    var ik : int64
    setfltvalue(addr(o), r)
    // not an integral value?
    if (luaV_flttointeger(r, addr(ik), F2Imod.F2Ieq) == 0) {
        // use number itself as key
        return addk(fs, addr(o), addr(o))
    } else {
        // must build an alternative key
        let nbm : int = 53
        let q : double = crt::ldexp(1.0lf, -nbm + 1)
        // new key
        let k : double = (ik == 0l) ? q : r + r * q
        var kv : TValue
        setfltvalue(addr(kv), k)
        // result is not an integral value, unless value is too large
        return addk(fs, addr(kv), addr(o))
    }
}

// Add a false to list of constants and return its index.
[c_function]
def private boolF(var fs : FuncState?) : int {
    var o : TValue
    addr(o).tt_ = uint8(LUA_TBOOLEAN | (0 << 4))
    // use boolean itself as key
    return addk(fs, addr(o), addr(o))
}

// Add a true to list of constants and return its index.
[c_function]
def private boolT(var fs : FuncState?) : int {
    var o : TValue
    addr(o).tt_ = uint8(LUA_TBOOLEAN | (1 << 4))
    // use boolean itself as key
    return addk(fs, addr(o), addr(o))
}

// Add nil to list of constants and return its index.
[c_function]
def private nilK(var fs : FuncState?) : int {
    var k : TValue
    var v : TValue
    setnilvalue(addr(v))
    {
        // cannot use nil as key; instead use table itself to represent nil
        var io : TValue? = addr(k)
        var x_ : Table? = fs.ls.h
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(LUA_TTABLE | (0 << 4)))
        let _t0 = fs.ls.L
    }
    return addk(fs, addr(k), addr(v))
}

// Check whether 'i' can be stored in an 'sC' operand. Equivalent to
// (0 <= int2sC(i) && int2sC(i) <= MAXARG_C) but without risk of
// overflows in the hidden addition inside 'int2sC'.
def private fitsC(i : int64) : int {
    return int_of(uint64(i) + uint64(OFFSET_sC) <= uint64(uint(MAXARG_C)))
}

// Check whether 'i' can be stored in an 'sBx' operand.
def private fitsBx(i : int64) : int {
    return int_of(int64(-OFFSET_sBx) <= i && i <= int64(MAXARG_Bx - OFFSET_sBx))
}

def luaK_int(var fs : FuncState?; reg : int; i : int64) {
    if (fitsBx(i) != 0) {
        codeAsBx(fs, OpCode.OP_LOADI, reg, int(i))
    } else {
        luaK_codek(fs, reg, luaK_intK(fs, i))
    }
}

[c_function]
def private luaK_float(var fs : FuncState?; reg : int; f : double) {
    var fi : int64
    if (luaV_flttointeger(f, addr(fi), F2Imod.F2Ieq) != 0 && fitsBx(fi) != 0) {
        codeAsBx(fs, OpCode.OP_LOADF, reg, int(fi))
    } else {
        luaK_codek(fs, reg, luaK_numberK(fs, f))
    }
}

// Convert a constant in 'v' into an expression description 'e'
def private const2exp(var v : TValue?; var e : expdesc?) {
    c_switch(int(rawtt(v)) & 63) {
        case(3) {
            e.k = expkind.VKINT
            e.u.ival = ivalue(v)
            break
        }
        case(19) {
            e.k = expkind.VKFLT
            e.u.nval = fltvalue(v)
            break
        }
        case(1) {
            e.k = expkind.VFALSE
            break
        }
        case(17) {
            e.k = expkind.VTRUE
            break
        }
        case(0) {
            e.k = expkind.VNIL
            break
        }
        case(4, 20) {
            e.k = expkind.VKSTR
            e.u.strval = gco2ts(v.value_.gc)
            break
        }
        case(_) {
        }
    }
}

// Fix an expression to return the number of results 'nresults'.
// 'e' must be a multi-ret expression (function call or vararg).
[c_function]
def luaK_setreturns(var fs : FuncState?; var e : expdesc?; nresults : int) {
    var pc : uint? = addr(fs.f.code[e.u.info])
    // expression is an open function call?
    if (e.k == expkind.VCALL) {
        *pc = (*pc & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((uint(nresults + 1) << uint(POS_C)) & (~(~0u << uint(SIZE_C)) << uint(POS_C)))
    } else {
        *pc = (*pc & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((uint(nresults + 1) << uint(POS_C)) & (~(~0u << uint(SIZE_C)) << uint(POS_C)))
        *pc = (*pc & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(fs.freereg) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
        luaK_reserveregs(fs, 1)
    }
}

// Convert a VKSTR to a VK
def private str2K(var fs : FuncState?; var e : expdesc?) {
    e.u.info = stringK(fs, e.u.strval)
    e.k = expkind.VK
}

// Fix an expression to return one result.
// If expression is not a multi-ret expression (function call or
// vararg), it already returns one result, so nothing needs to be done.
// Function calls become VNONRELOC expressions (as its result comes
// fixed in the base register of the call), while vararg expressions
// become VRELOC (as OP_VARARG puts its results where it wants).
// (Calls are created returning one result, so that does not need
// to be fixed.)
[c_function]
def luaK_setoneret(var fs : FuncState?; var e : expdesc?) {
    // expression is an open function call?
    if (e.k == expkind.VCALL) {
        // already returns 1 value
        // result has fixed position
        e.k = expkind.VNONRELOC
        e.u.info = GETARG_A(fs.f.code[e.u.info])
    } elif (e.k == expkind.VVARARG) {
        fs.f.code[e.u.info] = (getinstruction(fs, e) & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((2u << uint(POS_C)) &
                (~(~0u << uint(SIZE_C)) << uint(POS_C)))
        // can relocate its simple result
        e.k = expkind.VRELOC
    }
}

// Ensure that expression 'e' is not a variable (nor a <const>).
// (Expression still may have jump lists.)
def luaK_dischargevars(var fs : FuncState?; var e : expdesc?) {
    c_switch(e.k) {
        case(expkind.VCONST) {
            const2exp(const2val(fs, e), e)
            break
        }
        case(expkind.VLOCAL) {
            {
                // already in a register
                let temp : int = int(e.u._c_var.ridx)
                // (can't do a direct assignment; values overlap)
                e.u.info = temp
                // becomes a non-relocatable value
                e.k = expkind.VNONRELOC
                break
            }
        }
        case(expkind.VUPVAL) {
            // move value to some (pending) register
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETUPVAL, 0, e.u.info, 0, 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXUP) {
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETTABUP, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXI) {
            freereg(fs, int(e.u.ind.t))
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETI, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXSTR) {
            freereg(fs, int(e.u.ind.t))
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETFIELD, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXED) {
            freeregs(fs, int(e.u.ind.t), int(e.u.ind.idx))
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETTABLE, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VVARARG, expkind.VCALL) {
            luaK_setoneret(fs, e)
            break
        }
        case(_) {
            // there is one value available (somewhere)
            break
        }
    }
}

// Ensure expression value is in register 'reg', making 'e' a
// non-relocatable expression.
// (Expression still may have jump lists.)
[c_function]
def private discharge2reg(var fs : FuncState?; var e : expdesc?; reg : int) {
    luaK_dischargevars(fs, e)
    c_switch(e.k) {
        case(expkind.VNIL) {
            luaK_nil(fs, reg, 1)
            break
        }
        case(expkind.VFALSE) {
            luaK_codeABCk(fs, OpCode.OP_LOADFALSE, reg, 0, 0, 0)
            break
        }
        case(expkind.VTRUE) {
            luaK_codeABCk(fs, OpCode.OP_LOADTRUE, reg, 0, 0, 0)
            break
        }
        case(expkind.VKSTR) {
            str2K(fs, e)
        }
        case(expkind.VK) {
            // FALLTHROUGH
            luaK_codek(fs, reg, e.u.info)
            break
        }
        case(expkind.VKFLT) {
            luaK_float(fs, reg, e.u.nval)
            break
        }
        case(expkind.VKINT) {
            luaK_int(fs, reg, e.u.ival)
            break
        }
        case(expkind.VRELOC) {
            {
                var pc : uint? = addr(fs.f.code[e.u.info])
                // instruction will put result in 'reg'
                *pc = (*pc & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(reg) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
                break
            }
        }
        case(expkind.VNONRELOC) {
            if (reg != e.u.info) {
                luaK_codeABCk(fs, OpCode.OP_MOVE, reg, e.u.info, 0, 0)
            }
            break
        }
        case(_) {
            // nothing to do...
            return
        }
    }
    e.u.info = reg
    e.k = expkind.VNONRELOC
}

// Ensure expression value is in a register, making 'e' a
// non-relocatable expression.
// (Expression still may have jump lists.)
def private discharge2anyreg(var fs : FuncState?; var e : expdesc?) {
    // no fixed register yet?
    if (e.k != expkind.VNONRELOC) {
        // get a register
        luaK_reserveregs(fs, 1)
        // put value there
        discharge2reg(fs, e, int(fs.freereg) - 1)
    }
}

def private code_loadbool(var fs : FuncState?; A : int; op : OpCode) : int {
    // those instructions may be jump targets
    luaK_getlabel(fs)
    return luaK_codeABCk(fs, op, A, 0, 0, 0)
}

// check whether list has any jump that do not produce a value
// or produce an inverted value
[c_function]
def private need_value(var fs : FuncState?; var list : int) : int {
    while (list != NO_JUMP) {
        let i : uint = *getjumpcontrol(fs, list)
        if (GET_OPCODE(i) != OpCode.OP_TESTSET) {
            return 1
        }
        list = getjump(fs, list)
    }
    // not found
    return 0
}

// Ensures final expression result (which includes results from its
// jump lists) is in register 'reg'.
// If expression has jumps, need to patch these jumps either to
// its final position or to "load" instructions (for those tests
// that do not produce values).
[c_function]
def private exp2reg(var fs : FuncState?; var e : expdesc?; reg : int) {
    discharge2reg(fs, e, reg)
    // expression itself is a test?
    if (e.k == expkind.VJMP) {
        // put this jump in 't' list
        luaK_concat(fs, addr(e.t), e.u.info)
    }
    if (hasjumps(e)) {
        // position after whole expression
        var final : int
        // position of an eventual LOAD false
        var p_f : int = NO_JUMP
        // position of an eventual LOAD true
        var p_t : int = NO_JUMP
        if (need_value(fs, e.t) != 0 || need_value(fs, e.f) != 0) {
            let fj : int = (e.k == expkind.VJMP) ? NO_JUMP : luaK_jump(fs)
            // skip next inst.
            p_f = code_loadbool(fs, reg, OpCode.OP_LFALSESKIP)
            p_t = code_loadbool(fs, reg, OpCode.OP_LOADTRUE)
            // jump around these booleans if 'e' is not a test
            luaK_patchtohere(fs, fj)
        }
        final = luaK_getlabel(fs)
        patchlistaux(fs, e.f, final, reg, p_f)
        patchlistaux(fs, e.t, final, reg, p_t)
    }
    e.t = NO_JUMP
    e.f = e.t
    e.u.info = reg
    e.k = expkind.VNONRELOC
}

// Ensures final expression result is in next available register.
def luaK_exp2nextreg(var fs : FuncState?; var e : expdesc?) {
    luaK_dischargevars(fs, e)
    freeexp(fs, e)
    luaK_reserveregs(fs, 1)
    exp2reg(fs, e, int(fs.freereg) - 1)
}

// Ensures final expression result is in some (any) register
// and return that register.
def luaK_exp2anyreg(var fs : FuncState?; var e : expdesc?) : int {
    luaK_dischargevars(fs, e)
    // expression already has a register?
    if (e.k == expkind.VNONRELOC) {
        // no jumps?
        if (!hasjumps(e)) {
            // result is already in a register
            return e.u.info
        }
        // reg. is not a local?
        if (e.u.info >= luaY_nvarstack(fs)) {
            // put final result in it
            exp2reg(fs, e, e.u.info)
            return e.u.info
        }
    }
    // else expression has jumps and cannot change its register
    // to hold the jump values, because it is a local variable.
    // Go through to the default case.
    // default: use next available register
    luaK_exp2nextreg(fs, e)
    return e.u.info
}

// Ensures final expression result is either in a register
// or in an upvalue.
def luaK_exp2anyregup(var fs : FuncState?; var e : expdesc?) {
    if (e.k != expkind.VUPVAL || hasjumps(e)) {
        luaK_exp2anyreg(fs, e)
    }
}

// Ensures final expression result is either in a register
// or it is a constant.
def luaK_exp2val(var fs : FuncState?; var e : expdesc?) {
    if (e.k == expkind.VJMP || hasjumps(e)) {
        luaK_exp2anyreg(fs, e)
    } else {
        luaK_dischargevars(fs, e)
    }
}

// Try to make 'e' a K expression with an index in the range of R/K
// indices. Return true iff succeeded.
def private luaK_exp2K(var fs : FuncState?; var e : expdesc?) : int {
    if (!hasjumps(e)) {
        var info : int
        // move constants to 'k'
        c_switch(e.k) {
            case(expkind.VTRUE) {
                info = boolT(fs)
                break
            }
            case(expkind.VFALSE) {
                info = boolF(fs)
                break
            }
            case(expkind.VNIL) {
                info = nilK(fs)
                break
            }
            case(expkind.VKINT) {
                info = luaK_intK(fs, e.u.ival)
                break
            }
            case(expkind.VKFLT) {
                info = luaK_numberK(fs, e.u.nval)
                break
            }
            case(expkind.VKSTR) {
                info = stringK(fs, e.u.strval)
                break
            }
            case(expkind.VK) {
                info = e.u.info
                break
            }
            case(_) {
                // not a constant
                return 0
            }
        }
        // does constant fit in 'argC'?
        if (info <= MAXINDEXRK) {
            // make expression a 'K' expression
            e.k = expkind.VK
            e.u.info = info
            return 1
        }
    }
    // else, expression doesn't fit; leave it unchanged
    return 0
}

// Ensures final expression result is in a valid R/K index
// (that is, it is either in a register or in 'k' with an index
// in the range of R/K indices).
// Returns 1 iff expression is K.
def private exp2RK(var fs : FuncState?; var e : expdesc?) : int {
    if (luaK_exp2K(fs, e) != 0) {
        return 1
    } else {
        // not a constant in the right range: put it in a register
        luaK_exp2anyreg(fs, e)
        return 0
    }
}

def private codeABRK(var fs : FuncState?; o : OpCode; a : int; b : int; var ec : expdesc?) {
    let k : int = exp2RK(fs, ec)
    luaK_codeABCk(fs, o, a, b, ec.u.info, k)
}

// Generate code to store result of expression 'ex' into variable 'var'.
def luaK_storevar(var fs : FuncState?; var _c_var : expdesc?; var ex : expdesc?) {
    c_switch(_c_var.k) {
        case(expkind.VLOCAL) {
            freeexp(fs, ex)
            // compute 'ex' into proper place
            exp2reg(fs, ex, int(_c_var.u._c_var.ridx))
            return
        }
        case(expkind.VUPVAL) {
            {
                let e : int = luaK_exp2anyreg(fs, ex)
                luaK_codeABCk(fs, OpCode.OP_SETUPVAL, e, _c_var.u.info, 0, 0)
                break
            }
        }
        case(expkind.VINDEXUP) {
            codeABRK(fs, OpCode.OP_SETTABUP, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(expkind.VINDEXI) {
            codeABRK(fs, OpCode.OP_SETI, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(expkind.VINDEXSTR) {
            codeABRK(fs, OpCode.OP_SETFIELD, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(expkind.VINDEXED) {
            codeABRK(fs, OpCode.OP_SETTABLE, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(_) {
            // invalid var kind to store
        }
    }
    freeexp(fs, ex)
}

// Emit SELF instruction (convert expression 'e' into 'e:key(e,').
def luaK_self(var fs : FuncState?; var e : expdesc?; var key : expdesc?) {
    var ereg : int
    luaK_exp2anyreg(fs, e)
    // register where 'e' was placed
    ereg = e.u.info
    freeexp(fs, e)
    // base register for op_self
    e.u.info = int(fs.freereg)
    // self expression has a fixed register
    e.k = expkind.VNONRELOC
    // function and 'self' produced by op_self
    luaK_reserveregs(fs, 2)
    codeABRK(fs, OpCode.OP_SELF, e.u.info, ereg, key)
    freeexp(fs, key)
}

// Negate condition 'e' (where 'e' is a comparison).
[c_function]
def private negatecondition(var fs : FuncState?; var e : expdesc?) {
    var pc : uint? = getjumpcontrol(fs, e.u.info)
    *pc = (*pc & ~(~(~0u << 1u) << uint(POS_k))) | ((uint(GETARG_k(*pc) ^ 1) << uint(POS_k)) & (~(~0u << 1u) << uint(POS_k)))
}

// Emit instruction to jump if 'e' is 'cond' (that is, if 'cond'
// is true, code will jump if 'e' is true.) Return jump position.
// Optimize when 'e' is 'not' something, inverting the condition
// and removing the 'not'.
def private jumponcond(var fs : FuncState?; var e : expdesc?; cond : int) : int {
    if (e.k == expkind.VRELOC) {
        let ie : uint = getinstruction(fs, e)
        if (GET_OPCODE(ie) == OpCode.OP_NOT) {
            // remove previous OP_NOT
            removelastinstruction(fs)
            return condjump(fs, OpCode.OP_TEST, GETARG_B(ie), 0, 0, int_of(cond == 0))
        }
    }
    // else go through
    discharge2anyreg(fs, e)
    freeexp(fs, e)
    return condjump(fs, OpCode.OP_TESTSET, NO_REG, e.u.info, 0, cond)
}

// Emit code to go through if 'e' is true, jump otherwise.
[c_function]
def luaK_goiftrue(var fs : FuncState?; var e : expdesc?) {
    // pc of new jump
    var pc : int
    luaK_dischargevars(fs, e)
    c_switch(e.k) {
        case(expkind.VJMP) {
            // condition?
            // jump when it is false
            negatecondition(fs, e)
            // save jump position
            pc = e.u.info
            break
        }
        case(expkind.VK, expkind.VKFLT, expkind.VKINT, expkind.VKSTR, expkind.VTRUE) {
            // always true; do nothing
            pc = NO_JUMP
            break
        }
        case(_) {
            // jump when false
            pc = jumponcond(fs, e, 0)
            break
        }
    }
    // insert new jump in false list
    luaK_concat(fs, addr(e.f), pc)
    // true list jumps to here (to go through)
    luaK_patchtohere(fs, e.t)
    e.t = NO_JUMP
}

// Emit code to go through if 'e' is false, jump otherwise.
[c_function]
def luaK_goiffalse(var fs : FuncState?; var e : expdesc?) {
    // pc of new jump
    var pc : int
    luaK_dischargevars(fs, e)
    c_switch(e.k) {
        case(expkind.VJMP) {
            // already jump if true
            pc = e.u.info
            break
        }
        case(expkind.VNIL, expkind.VFALSE) {
            // always false; do nothing
            pc = NO_JUMP
            break
        }
        case(_) {
            // jump if true
            pc = jumponcond(fs, e, 1)
            break
        }
    }
    // insert new jump in 't' list
    luaK_concat(fs, addr(e.t), pc)
    // false list jumps to here (to go through)
    luaK_patchtohere(fs, e.f)
    e.f = NO_JUMP
}

// Code 'not e', doing constant folding.
def private codenot(var fs : FuncState?; var e : expdesc?) {
    c_switch(e.k) {
        case(expkind.VNIL, expkind.VFALSE) {
            // true == not nil == not false
            e.k = expkind.VTRUE
            break
        }
        case(expkind.VK, expkind.VKFLT, expkind.VKINT, expkind.VKSTR, expkind.VTRUE) {
            // false == not "x" == not 0.5 == not 1 == not true
            e.k = expkind.VFALSE
            break
        }
        case(expkind.VJMP) {
            negatecondition(fs, e)
            break
        }
        case(expkind.VRELOC, expkind.VNONRELOC) {
            discharge2anyreg(fs, e)
            freeexp(fs, e)
            e.u.info = luaK_codeABCk(fs, OpCode.OP_NOT, 0, e.u.info, 0, 0)
            e.k = expkind.VRELOC
            break
        }
        case(_) {
            // cannot happen
        }
    }
    {
        // interchange true and false lists
        let temp : int = e.f
        e.f = e.t
        e.t = temp
    }
    // values are useless when negated
    removevalues(fs, e.f)
    removevalues(fs, e.t)
}

// Check whether expression 'e' is a short literal string
[c_function]
def private isKstr(var fs : FuncState?; var e : expdesc?) : int {
    return int_of(e.k == expkind.VK && !hasjumps(e) && e.u.info <= MAXARG_B && ttisshrstring(addr(fs.f.k[e.u.info])))
}

// Check whether expression 'e' is a literal integer.
def private isKint(var e : expdesc?) : int {
    return int_of(e.k == expkind.VKINT && !hasjumps(e))
}

// Check whether expression 'e' is a literal integer in
// proper range to fit in register C
def private isCint(var e : expdesc?) : int {
    return int_of(isKint(e) != 0 && (uint64(e.u.ival) <= uint64(MAXARG_C)))
}

// Check whether expression 'e' is a literal integer in
// proper range to fit in register sC
def private isSCint(var e : expdesc?) : int {
    return int_of(isKint(e) != 0 && fitsC(e.u.ival) != 0)
}

// Check whether expression 'e' is a literal integer or float in
// proper range to fit in a register (sB or sC).
[c_function]
def private isSCnumber(var e : expdesc?; var pi : int?; var isfloat : int?) : int {
    var i : int64
    if (e.k == expkind.VKINT) {
        i = e.u.ival
    } elif (e.k == expkind.VKFLT && luaV_flttointeger(e.u.nval, addr(i), F2Imod.F2Ieq) != 0) {
        *isfloat = 1
    } else {
        // not a number
        return 0
    }
    if (!hasjumps(e) && fitsC(i) != 0) {
        *pi = int(i) + OFFSET_sC
        return 1
    } else {
        return 0
    }
}

// Create expression 't[k]'. 't' must have its final result already in a
// register or upvalue. Upvalues can only be indexed by literal strings.
// Keys can be literal strings in the constant table or arbitrary
// values in registers.
def luaK_indexed(var fs : FuncState?; var t : expdesc?; var k : expdesc?) {
    if (k.k == expkind.VKSTR) {
        str2K(fs, k)
    }
    // upvalue indexed by non 'Kstr'?
    if (t.k == expkind.VUPVAL && isKstr(fs, k) == 0) {
        // put it in a register
        luaK_exp2anyreg(fs, t)
    }
    if (t.k == expkind.VUPVAL) {
        // upvalue index
        let temp : int = t.u.info
        // (can't do a direct assignment; values overlap)
        t.u.ind.t = uint8(temp)
        // literal short string
        t.u.ind.idx = int16(k.u.info)
        t.k = expkind.VINDEXUP
    } else {
        // register index of the table
        t.u.ind.t = uint8((t.k == expkind.VLOCAL) ? int(t.u._c_var.ridx) : t.u.info)
        if (isKstr(fs, k) != 0) {
            // literal short string
            t.u.ind.idx = int16(k.u.info)
            t.k = expkind.VINDEXSTR
        } elif (isCint(k) != 0) {
            // int. constant in proper range
            t.u.ind.idx = int16(int(k.u.ival))
            t.k = expkind.VINDEXI
        } else {
            // register
            t.u.ind.idx = int16(luaK_exp2anyreg(fs, k))
            t.k = expkind.VINDEXED
        }
    }
}

// Return false if folding can raise an error.
// Bitwise operations need operands convertible to integers; division
// operations cannot have 0 as divisor.
[c_function]
def private validop(op : int; var v1 : TValue?; var v2 : TValue?) : int {
    c_switch(op) {
        case(7, 8, 9, 10, 11, 13) {
            {
                // conversion errors
                var i : int64
                return int_of(luaV_tointegerns(v1, addr(i), F2Imod.F2Ieq) != 0 && luaV_tointegerns(v2, addr(i), F2Imod.F2Ieq) != 0)
            }
        }
        case(5, 6, 3) {
            // division by 0
            return int_of(nvalue(v2) != 0.0lf)
        }
        case(_) {
            // everything else is valid
            return 1
        }
    }
}

// Try to "constant-fold" an operation; return 1 iff successful.
// (In this case, 'e1' has the final result.)
[c_function]
def private constfolding(var fs : FuncState?; op : int; var e1 : expdesc?; var e2 : expdesc?) : int {
    var v1 : TValue
    var v2 : TValue
    var res : TValue
    if (tonumeral(e1, addr(v1)) == 0 || tonumeral(e2, addr(v2)) == 0 || validop(op, addr(v1), addr(v2)) == 0) {
        // non-numeric operands or not safe to fold
        return 0
    }
    // does operation
    luaO_rawarith(fs.ls.L, op, addr(v1), addr(v2), addr(res))
    if (ttisinteger(addr(res))) {
        e1.k = expkind.VKINT
        e1.u.ival = ivalue(addr(res))
    } else {
        // folds neither NaN nor 0.0 (to avoid problems with -0.0)
        let n : double = fltvalue(addr(res))
        if (luai_numisnan(n) || n == 0.0lf) {
            return 0
        }
        e1.k = expkind.VKFLT
        e1.u.nval = n
    }
    return 1
}

// Convert a BinOpr to an OpCode (ORDER OPR - ORDER OP)
def private binopr2op(opr : BinOpr; baser : BinOpr; base : OpCode) : OpCode {
    return enum_from_int(type<OpCode>, int(opr) - int(baser) + int(base))
}

// Convert a UnOpr to an OpCode (ORDER OPR - ORDER OP)
def private unopr2op(opr : UnOpr) : OpCode {
    return enum_from_int(type<OpCode>, int(opr) - int(UnOpr.OPR_MINUS) + int(OpCode.OP_UNM))
}

// Convert a BinOpr to a tag method (ORDER OPR - ORDER TM)
def private binopr2TM(opr : BinOpr) : TMS {
    return enum_from_int(type<TMS>, int(opr) - int(BinOpr.OPR_ADD) + int(TMS.TM_ADD))
}

// Emit code for unary expressions that "produce values"
// (everything but 'not').
// Expression to produce final result will be encoded in 'e'.
def private codeunexpval(var fs : FuncState?; op : OpCode; var e : expdesc?; line : int) {
    // opcodes operate only on registers
    let r : int = luaK_exp2anyreg(fs, e)
    freeexp(fs, e)
    // generate opcode
    e.u.info = luaK_codeABCk(fs, op, 0, r, 0, 0)
    // all those operations are relocatable
    e.k = expkind.VRELOC
    luaK_fixline(fs, line)
}

// Emit code for binary expressions that "produce values"
// (everything but logical operators 'and'/'or' and comparison
// operators).
// Expression to produce final result will be encoded in 'e1'.
def private finishbinexpval(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?; op : OpCode; v2 : int; flip : int; line : int; mmop : OpCode;
                            event : TMS) {
    let v1 : int = luaK_exp2anyreg(fs, e1)
    let pc : int = luaK_codeABCk(fs, op, 0, v1, v2, 0)
    freeexps(fs, e1, e2)
    e1.u.info = pc
    // all those operations are relocatable
    e1.k = expkind.VRELOC
    luaK_fixline(fs, line)
    // to call metamethod
    luaK_codeABCk(fs, mmop, v1, v2, int(event), flip)
    luaK_fixline(fs, line)
}

// Emit code for binary expressions that "produce values" over
// two registers.
def private codebinexpval(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    let op : OpCode = binopr2op(opr, BinOpr.OPR_ADD, OpCode.OP_ADD)
    // make sure 'e2' is in a register
    let v2 : int = luaK_exp2anyreg(fs, e2)
    // 'e1' must be already in a register or it is a constant
    finishbinexpval(fs, e1, e2, op, v2, 0, line, OpCode.OP_MMBIN, binopr2TM(opr))
}

// Code binary operators with immediate operands.
def private codebini(var fs : FuncState?; op : OpCode; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int; event : TMS) {
    // immediate operand
    let v2 : int = int2sC(int(e2.u.ival))
    finishbinexpval(fs, e1, e2, op, v2, flip, line, OpCode.OP_MMBINI, event)
}

// Code binary operators with K operand.
def private codebinK(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    let event : TMS = binopr2TM(opr)
    // K index
    let v2 : int = e2.u.info
    let op : OpCode = binopr2op(opr, BinOpr.OPR_ADD, OpCode.OP_ADDK)
    finishbinexpval(fs, e1, e2, op, v2, flip, line, OpCode.OP_MMBINK, event)
}

// Try to code a binary operator negating its second operand.
// For the metamethod, 2nd operand must keep its original value.
[c_function]
def private finishbinexpneg(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?; op : OpCode; line : int; event : TMS) : int {
    if (isKint(e2) == 0) {
        // not an integer constant
        return 0
    } else {
        let i2 : int64 = e2.u.ival
        if (!(fitsC(i2) != 0 && fitsC(-i2) != 0)) {
            // not in the proper range
            return 0
        } else {
            // operating a small integer constant
            let v2 : int = int(i2)
            finishbinexpval(fs, e1, e2, op, int2sC(-v2), 0, line, OpCode.OP_MMBINI, event)
            // correct metamethod argument
            fs.f.code[fs.pc - 1] = (fs.f.code[fs.pc - 1] & ~(~(~0u << uint(SIZE_B)) << uint(POS_B))) | ((uint(int2sC(v2)) << uint(POS_B)) &
                    (~(~0u << uint(SIZE_B)) << uint(POS_B)))
            // successfully coded
            return 1
        }
    }
}

[c_function]
def private swapexps(var e1 : expdesc?; var e2 : expdesc?) {
    // swap 'e1' and 'e2'
    var temp : expdesc = *e1
    *e1 = *e2
    *e2 = temp
}

// Code binary operators with no constant operand.
def private codebinNoK(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    if (flip != 0) {
        // back to original order
        swapexps(e1, e2)
    }
    // use standard operators
    codebinexpval(fs, opr, e1, e2, line)
}

// Code arithmetic operators ('+', '-', ...). If second operand is a
// constant in the proper range, use variant opcodes with K operands.
def private codearith(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    // K operand?
    if (tonumeral(e2, null) != 0 && luaK_exp2K(fs, e2) != 0) {
        codebinK(fs, opr, e1, e2, flip, line)
    } else {
        // 'e2' is neither an immediate nor a K operand
        codebinNoK(fs, opr, e1, e2, flip, line)
    }
}

// Code commutative operators ('+', '*'). If first operand is a
// numeric constant, change order of operands to try to use an
// immediate or K operator.
def private codecommutative(var fs : FuncState?; op : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var flip : int = 0
    // is first operand a numeric constant?
    if (tonumeral(e1, null) != 0) {
        // change order
        swapexps(e1, e2)
        flip = 1
    }
    // immediate operand?
    if (op == BinOpr.OPR_ADD && isSCint(e2) != 0) {
        codebini(fs, OpCode.OP_ADDI, e1, e2, flip, line, TMS.TM_ADD)
    } else {
        codearith(fs, op, e1, e2, flip, line)
    }
}

// Code bitwise operations; they are all commutative, so the function
// tries to put an integer constant as the 2nd operand (a K operand).
def private codebitwise(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var flip : int = 0
    if (e1.k == expkind.VKINT) {
        // 'e2' will be the constant operand
        swapexps(e1, e2)
        flip = 1
    }
    // K operand?
    if (e2.k == expkind.VKINT && luaK_exp2K(fs, e2) != 0) {
        codebinK(fs, opr, e1, e2, flip, line)
    } else {
        // no constants
        codebinNoK(fs, opr, e1, e2, flip, line)
    }
}

// Emit code for order comparisons. When using an immediate operand,
// 'isfloat' tells whether the original value was a float.
[c_function]
def private codeorder(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?) {
    var r1 : int
    var r2 : int
    var im : int
    var isfloat : int = 0
    var op : OpCode
    if (isSCnumber(e2, addr(im), addr(isfloat)) != 0) {
        // use immediate operand
        r1 = luaK_exp2anyreg(fs, e1)
        r2 = im
        op = binopr2op(opr, BinOpr.OPR_LT, OpCode.OP_LTI)
    } elif (isSCnumber(e1, addr(im), addr(isfloat)) != 0) {
        // transform (A < B) to (B > A) and (A <= B) to (B >= A)
        r1 = luaK_exp2anyreg(fs, e2)
        r2 = im
        op = binopr2op(opr, BinOpr.OPR_LT, OpCode.OP_GTI)
    } else {
        // regular case, compare two registers
        r1 = luaK_exp2anyreg(fs, e1)
        r2 = luaK_exp2anyreg(fs, e2)
        op = binopr2op(opr, BinOpr.OPR_LT, OpCode.OP_LT)
    }
    freeexps(fs, e1, e2)
    e1.u.info = condjump(fs, op, r1, r2, isfloat, 1)
    e1.k = expkind.VJMP
}

// Emit code for equality comparisons ('==', '~=').
// 'e1' was already put as RK by 'luaK_infix'.
[c_function]
def private codeeq(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?) {
    var r1 : int
    var r2 : int
    var im : int
    // not needed here, but kept for symmetry
    var isfloat : int = 0
    var op : OpCode
    if (e1.k != expkind.VNONRELOC) {
        swapexps(e1, e2)
    }
    // 1st expression must be in register
    r1 = luaK_exp2anyreg(fs, e1)
    if (isSCnumber(e2, addr(im), addr(isfloat)) != 0) {
        op = OpCode.OP_EQI
        // immediate operand
        r2 = im
    } elif (exp2RK(fs, e2) != 0) {
        // 2nd expression is constant?
        op = OpCode.OP_EQK
        // constant index
        r2 = e2.u.info
    } else {
        // will compare two registers
        op = OpCode.OP_EQ
        r2 = luaK_exp2anyreg(fs, e2)
    }
    freeexps(fs, e1, e2)
    e1.u.info = condjump(fs, op, r1, r2, isfloat, int_of(opr == BinOpr.OPR_EQ))
    e1.k = expkind.VJMP
}

// Apply prefix operation 'op' to expression 'e'.
[c_function]
def luaK_prefix(var fs : FuncState?; opr : UnOpr; var e : expdesc?; line : int) {
    luaK_dischargevars(fs, e)
    c_switch(opr) {
        case(UnOpr.OPR_MINUS, UnOpr.OPR_BNOT) {
            // use 'ef' as fake 2nd operand
            if (constfolding(fs, int(uint(opr) + uint(LUA_OPUNM)), e, addr(luaK_prefix_ef)) != 0) {
                break
            }
        }
        case(UnOpr.OPR_LEN) {
            // else FALLTHROUGH
            codeunexpval(fs, unopr2op(opr), e, line)
            break
        }
        case(UnOpr.OPR_NOT) {
            codenot(fs, e)
            break
        }
        case(_) {
        }
    }
}

// Process 1st operand 'v' of binary operation 'op' before reading
// 2nd operand.
[c_function]
def luaK_infix(var fs : FuncState?; op : BinOpr; var v : expdesc?) {
    luaK_dischargevars(fs, v)
    c_switch(op) {
        case(BinOpr.OPR_AND) {
            // go ahead only if 'v' is true
            luaK_goiftrue(fs, v)
            break
        }
        case(BinOpr.OPR_OR) {
            // go ahead only if 'v' is false
            luaK_goiffalse(fs, v)
            break
        }
        case(BinOpr.OPR_CONCAT) {
            // operand must be on the stack
            luaK_exp2nextreg(fs, v)
            break
        }
        case(BinOpr.OPR_ADD, BinOpr.OPR_SUB, BinOpr.OPR_MUL, BinOpr.OPR_DIV, BinOpr.OPR_IDIV, BinOpr.OPR_MOD, BinOpr.OPR_POW, BinOpr.OPR_BAND, BinOpr.OPR_BOR, BinOpr.OPR_BXOR, BinOpr.OPR_SHL, BinOpr.OPR_SHR) {
            if (tonumeral(v, null) == 0) {
                luaK_exp2anyreg(fs, v)
            }
            // else keep numeral, which may be folded or used as an immediate
            // operand
            break
        }
        case(BinOpr.OPR_EQ, BinOpr.OPR_NE) {
            if (tonumeral(v, null) == 0) {
                exp2RK(fs, v)
            }
            // else keep numeral, which may be an immediate operand
            break
        }
        case(BinOpr.OPR_LT, BinOpr.OPR_LE, BinOpr.OPR_GT, BinOpr.OPR_GE) {
            {
                var dummy : int
                var dummy2 : int
                if (isSCnumber(v, addr(dummy), addr(dummy2)) == 0) {
                    luaK_exp2anyreg(fs, v)
                }
                // else keep numeral, which may be an immediate operand
                break
            }
        }
        case(_) {
        }
    }
}

// Create code for '(e1 .. e2)'.
// For '(e1 .. e2.1 .. e2.2)' (which is '(e1 .. (e2.1 .. e2.2))',
// because concatenation is right associative), merge both CONCATs.
[c_function]
def private codeconcat(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var ie2 : uint? = previousinstruction(fs)
    // is 'e2' a concatenation?
    if (GET_OPCODE(*ie2) == OpCode.OP_CONCAT) {
        // # of elements concatenated in 'e2'
        let n : int = GETARG_B(*ie2)
        freeexp(fs, e2)
        // correct first element ('e1')
        *ie2 = (*ie2 & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(e1.u.info) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
        // will concatenate one more element
        *ie2 = (*ie2 & ~(~(~0u << uint(SIZE_B)) << uint(POS_B))) | ((uint(n + 1) << uint(POS_B)) & (~(~0u << uint(SIZE_B)) << uint(POS_B)))
    } else {
        // 'e2' is not a concatenation
        // new concat opcode
        luaK_codeABCk(fs, OpCode.OP_CONCAT, e1.u.info, 2, 0, 0)
        freeexp(fs, e2)
        luaK_fixline(fs, line)
    }
}

// Finalize code for binary operation, after reading 2nd operand.
[c_function]
def luaK_posfix(var fs : FuncState?; var opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    luaK_dischargevars(fs, e2)
    if (foldbinop(opr) && constfolding(fs, int(uint(opr) + uint(LUA_OPADD)), e1, e2) != 0) {
        // done by folding
        return
    }
    c_switch(opr) {
        case(BinOpr.OPR_AND) {
            // list closed by 'luaK_infix'
            luaK_concat(fs, addr(e2.f), e1.f)
            *e1 = *e2
            break
        }
        case(BinOpr.OPR_OR) {
            // list closed by 'luaK_infix'
            luaK_concat(fs, addr(e2.t), e1.t)
            *e1 = *e2
            break
        }
        case(BinOpr.OPR_CONCAT) {
            // e1 .. e2
            luaK_exp2nextreg(fs, e2)
            codeconcat(fs, e1, e2, line)
            break
        }
        case(BinOpr.OPR_ADD, BinOpr.OPR_MUL) {
            codecommutative(fs, opr, e1, e2, line)
            break
        }
        case(BinOpr.OPR_SUB) {
            if (finishbinexpneg(fs, e1, e2, OpCode.OP_ADDI, line, TMS.TM_SUB) != 0) {
                // coded as (r1 + -I)
                break
            }
        }
        case(BinOpr.OPR_DIV, BinOpr.OPR_IDIV, BinOpr.OPR_MOD, BinOpr.OPR_POW) {
            // ELSE
            // FALLTHROUGH
            codearith(fs, opr, e1, e2, 0, line)
            break
        }
        case(BinOpr.OPR_BAND, BinOpr.OPR_BOR, BinOpr.OPR_BXOR) {
            codebitwise(fs, opr, e1, e2, line)
            break
        }
        case(BinOpr.OPR_SHL) {
            if (isSCint(e1) != 0) {
                swapexps(e1, e2)
                // I << r2
                codebini(fs, OpCode.OP_SHLI, e1, e2, 1, line, TMS.TM_SHL)
            } elif (finishbinexpneg(fs, e1, e2, OpCode.OP_SHRI, line, TMS.TM_SHL) != 0) {
                // coded as (r1 >> -I)
            } else {
                // regular case (two registers)
                codebinexpval(fs, opr, e1, e2, line)
            }
            break
        }
        case(BinOpr.OPR_SHR) {
            if (isSCint(e2) != 0) {
                // r1 >> I
                codebini(fs, OpCode.OP_SHRI, e1, e2, 0, line, TMS.TM_SHR)
            } else {
                // regular case (two registers)
                codebinexpval(fs, opr, e1, e2, line)
            }
            break
        }
        case(BinOpr.OPR_EQ, BinOpr.OPR_NE) {
            codeeq(fs, opr, e1, e2)
            break
        }
        case(BinOpr.OPR_GT, BinOpr.OPR_GE) {
            // '(a > b)' <=> '(b < a)'; '(a >= b)' <=> '(b <= a)'
            swapexps(e1, e2)
            opr = enum_from_int(type<BinOpr>, int(uint(opr) - uint(BinOpr.OPR_GT) + uint(BinOpr.OPR_LT)))
        }
        case(BinOpr.OPR_LT, BinOpr.OPR_LE) {
            // FALLTHROUGH
            codeorder(fs, opr, e1, e2)
            break
        }
        case(_) {
        }
    }
}

// Change line information associated with current position, by removing
// previous info and adding it again with new line.
def luaK_fixline(var fs : FuncState?; line : int) {
    removelastlineinfo(fs)
    savelineinfo(fs, fs.f, line)
}

[c_function]
def luaK_settablesize(var fs : FuncState?; pc : int; ra : int; asize : int; hsize : int) {
    var inst : uint? = addr(fs.f.code[pc])
    // hash size
    let rb : int = (hsize != 0) ? luaO_ceillog2(uint(hsize)) + 1 : 0
    // higher bits of array size
    let extra : int = asize / (MAXARG_C + 1)
    // lower bits of array size
    let rc : int = asize % (MAXARG_C + 1)
    // true iff needs extra argument
    let k : int = int_of(extra > 0)
    *inst = (uint(OpCode.OP_NEWTABLE) << uint(POS_OP)) | (uint(ra) << uint(POS_A)) | (uint(rb) << uint(POS_B)) | (uint(rc) << uint(POS_C)) | (uint(k) <<
            uint(POS_k))
    inst[1] = (uint(OpCode.OP_EXTRAARG) << uint(POS_OP)) | (uint(extra) << uint(POS_A))
}

// Emit a SETLIST instruction.
// 'base' is register that keeps table;
// 'nelems' is #table plus those to be stored now;
// 'tostore' is number of values (in registers 'base + 1',...) to add to
// table (or LUA_MULTRET to add up to stack top).
def luaK_setlist(var fs : FuncState?; base : int; var nelems : int; var tostore : int) {
    if (tostore == LUA_MULTRET) {
        tostore = 0
    }
    if (nelems <= MAXARG_C) {
        luaK_codeABCk(fs, OpCode.OP_SETLIST, base, tostore, nelems, 0)
    } else {
        let extra : int = nelems / (MAXARG_C + 1)
        nelems %= MAXARG_C + 1
        luaK_codeABCk(fs, OpCode.OP_SETLIST, base, tostore, nelems, 1)
        codeextraarg(fs, extra)
    }
    // free registers with list values
    fs.freereg = uint8(base + 1)
}

// return the final target of a jump (skipping jumps to jumps)
[c_function]
def private finaltarget(var code : uint?; var i : int) : int {
    // avoid infinite loops
    for (count in range(100)) {
        let pc : uint = code[i]
        if (GET_OPCODE(pc) != OpCode.OP_JMP) {
            break
        } else {
            i += GETARG_sJ(pc) + 1
        }
    }
    return i
}

// Do a final pass over the code of a function, doing small peephole
// optimizations and adjustments.
[c_function]
def luaK_finish(var fs : FuncState?) {
    var i : int
    var p : Proto? = fs.f
    i = 0
    while (i < fs.pc) {
        var pc : uint? = addr(p.code[i])
        c_switch(GET_OPCODE(*pc)) {
            case(OpCode.OP_RETURN0, OpCode.OP_RETURN1) {
                if (!(fs.needclose != 0 || p.is_vararg != 0)) {
                    // no extra work
                    break
                }
                // else use OP_RETURN to do the extra work
                *pc = (*pc & ~(~(~0u << uint(SIZE_OP)) << uint(POS_OP))) | ((uint(OpCode.OP_RETURN) << uint(POS_OP)) &
                        (~(~0u << uint(SIZE_OP)) << uint(POS_OP)))
            }
            case(OpCode.OP_RETURN, OpCode.OP_TAILCALL) {
                // FALLTHROUGH
                if (fs.needclose != 0) {
                    // signal that it needs to close
                    *pc = (*pc & ~(~(~0u << 1u) << uint(POS_k))) | ((1u << uint(POS_k)) & (~(~0u << 1u) << uint(POS_k)))
                }
                if (p.is_vararg != 0) {
                    // signal that it is vararg
                    *pc = (*pc & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((uint(int(p.numparams) + 1) << uint(POS_C)) &
                            (~(~0u << uint(SIZE_C)) << uint(POS_C)))
                }
                break
            }
            case(OpCode.OP_JMP) {
                {
                    let target : int = finaltarget(p.code, i)
                    fixjump(fs, i, target)
                    break
                }
            }
            case(_) {
                break
            }
        }
        i++
    }
}

def private currentpc(var ci : CallInfo?) : int {
    return pcRel(ci.u.l.savedpc, ci_func(ci).p)
}

// Get a "base line" to find the line corresponding to an instruction.
// Base lines are regularly placed at MAXIWTHABS intervals, so usually
// an integer division gets the right place. When the source file has
// large sequences of empty/comment lines, it may need extra entries,
// so the original estimate needs a correction.
// If the original estimate is -1, the initial 'if' ensures that the
// 'while' will run at least once.
// The assertion that the estimate is a lower bound for the correct base
// is valid as long as the debug info has been generated with the same
// value for MAXIWTHABS or smaller. (Previous releases use a little
// smaller value.)
[c_function]
def private getbaseline(var f : Proto?; pc : int; var basepc : int?) : int {
    if (f.sizeabslineinfo == 0 || pc < f.abslineinfo[0].pc) {
        // start from the beginning
        *basepc = -1
        return f.linedefined
    } else {
        // get an estimate
        var i : int = int(uint(pc) / uint(MAXIWTHABS) - 1u)
        // estimate must be a lower bound of the correct base
        while (i + 1 < f.sizeabslineinfo && pc >= f.abslineinfo[i + 1].pc) {
            // low estimate; adjust it
            i++
        }
        *basepc = f.abslineinfo[i].pc
        return f.abslineinfo[i].line
    }
}

// Get the line corresponding to instruction 'pc' in function 'f';
// first gets a base line and from there does the increments until
// the desired instruction.
[c_function]
def luaG_getfuncline(var f : Proto?; pc : int) : int {
    // no debug information?
    if (f.lineinfo == null) {
        return -1
    } else {
        var basepc : int
        var baseline : int = getbaseline(f, pc, addr(basepc))
        // walk until given instruction
        while (true) {
            let _t0 = basepc
            basepc++
            if (!(_t0 < pc)) {
                break
            }
            // correct line
            baseline += int(f.lineinfo[basepc])
        }
        return baseline
    }
}

def private getcurrentline(var ci : CallInfo?) : int {
    return luaG_getfuncline(ci_func(ci).p, currentpc(ci))
}

// Set 'trap' for all active Lua frames.
// This function can be called during a signal, under "reasonable"
// assumptions. A new 'ci' is completely linked in the list before it
// becomes part of the "active" list, and we assume that pointers are
// atomic; see comment in next function.
// (A compiler doing interprocedural optimizations could, theoretically,
// reorder memory writes in such a way that the list could be
// temporarily broken while inserting a new element. We simply assume it
// has no good reasons to do that.)
[c_function]
def private settraps(var ci : CallInfo?) {
    while (ci != null) {
        if (isLua(ci)) {
            c_volatile_store(ci.u.l.trap, 1)
        }
        ci = ci.previous
    }
}

// This function can be called during a signal, under "reasonable"
// assumptions.
// Fields 'basehookcount' and 'hookcount' (set by 'resethookcount')
// are for debug only, and it is no problem if they get arbitrary
// values (causes at most one wrong hook call). 'hookmask' is an atomic
// value. We assume that pointers are atomic too (e.g., gcc ensures that
// for all platforms where it runs). Moreover, 'hook' is always checked
// before being called (see 'luaD_hook').
def lua_sethook(var L : lua_State?; var func : function<(var a0 : lua_State?; var a1 : lua_Debug?) : void>; var mask : int; count : int) {
    // turn off hooks?
    if (func == null || mask == 0) {
        mask = 0
        func = default<function<(var a0 : lua_State?; var a1 : lua_Debug?) : void>>
    }
    c_volatile_store(L.hook, func)
    L.basehookcount = count
    resethookcount(L)
    c_volatile_store(L.hookmask, int(uint8(mask)))
    if (mask != 0) {
        // to trace inside 'luaV_execute'
        settraps(L.ci)
    }
}

def lua_gethook(var L : lua_State?) : function<(var a0 : lua_State?; var a1 : lua_Debug?) : void> {
    return c_volatile_load(L.hook)
}

def lua_gethookmask(var L : lua_State?) : int {
    return c_volatile_load(L.hookmask)
}

def lua_gethookcount(var L : lua_State?) : int {
    return L.basehookcount
}

[c_function]
def lua_getstack(var L : lua_State?; var level : int; var ar : lua_Debug?) : int {
    var status : int
    var ci : CallInfo?
    // invalid (negative) level
    if (level < 0) {
        return 0
    }
    ci = L.ci
    while (level > 0 && intptr(ci) != intptr(addr(L.base_ci))) {
        level--
        ci = ci.previous
    }
    // level found?
    if (level == 0 && intptr(ci) != intptr(addr(L.base_ci))) {
        status = 1
        ar.i_ci = ci
    } else {
        // no such level
        status = 0
    }
    return status
}

[c_function]
def private upvalname(var p : Proto?; uv : int) : uint8? {
    var s : TString? = p.upvalues[uv].name
    if (s == null) {
        return cstr("?")
    } else {
        return addr(s.contents[0])
    }
}

[c_function]
def private findvararg(var ci : CallInfo?; n : int; var pos : StackValue ??) : uint8? {
    if (clLvalue(s2v(ci.func.p)).p.is_vararg != 0) {
        let nextra : int = ci.u.l.nextraargs
        // 'n' is negative
        if (n >= -nextra) {
            *pos = ci.func.p - nextra + -(n + 1)
            // generic name for any vararg
            return cstr("(vararg)")
        }
    }
    // no such vararg
    return null
}

[c_function]
def luaG_findlocal(var L : lua_State?; var ci : CallInfo?; n : int; var pos : StackValue ??) : uint8? {
    var base : StackValue? = ci.func.p + 1
    var name : uint8? = null
    if (isLua(ci)) {
        // access to vararg values?
        if (n < 0) {
            return findvararg(ci, n, pos)
        } else {
            name = luaF_getlocalname(ci_func(ci).p, n, currentpc(ci))
        }
    }
    // no 'standard' name?
    if (name == null) {
        var limit : StackValue? = (intptr(ci) == intptr(L.ci)) ? L.top.p : ci.next.func.p
        // is 'n' inside 'ci' stack?
        if (int64(limit - base) >= int64(n) && n > 0) {
            // generic name for any valid slot
            name = isLua(ci) ? cstr("(temporary)") : cstr("(C temporary)")
        } else {
            // no name
            return null
        }
    }
    if (pos != null) {
        *pos = base + (n - 1)
    }
    return name
}

[c_function]
def lua_getlocal(var L : lua_State?; var ar : lua_Debug?; n : int) : uint8? {
    var name : uint8?
    // information about non-active function?
    if (ar == null) {
        // not a Lua function?
        if (!isLfunction(s2v(L.top.p - 1))) {
            name = null
        } else {
            // consider live variables at function start (parameters)
            name = luaF_getlocalname(clLvalue(s2v(L.top.p - 1)).p, n, 0)
        }
    } else {
        // active function; get information through 'ar'
        // to avoid warnings
        var pos : StackValue? = null
        name = luaG_findlocal(L, ar.i_ci, n, addr(pos))
        if (name != null) {
            {
                var io1 : TValue? = s2v(L.top.p)
                var io2 : TValue? = s2v(pos)
                io1.value_ = io2.value_
                io1.tt_ = io2.tt_
            }
            api_incr_top(L)
        }
    }
    return name
}

[c_function]
def lua_setlocal(var L : lua_State?; var ar : lua_Debug?; n : int) : uint8? {
    // to avoid warnings
    var pos : StackValue? = null
    var name : uint8?
    name = luaG_findlocal(L, ar.i_ci, n, addr(pos))
    if (name != null) {
        {
            var io1 : TValue? = s2v(pos)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        // pop value
        L.top.p--
    }
    return name
}

[c_function]
def private funcinfo(var ar : lua_Debug?; var cl : Closure?) {
    if (!LuaClosure(cl)) {
        ar.source = cstr("=[C]")
        ar.srclen = uint64(typeinfo sizeof(type<uint8[5]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul
        ar.linedefined = -1
        ar.lastlinedefined = -1
        ar.what = cstr("C")
    } else {
        var p : Proto? = cl.l.p
        if (p.source != null) {
            ar.source = addr(p.source.contents[0])
            ar.srclen = p.source.shrlen != 255 ? uint64(p.source.shrlen) : p.source.u.lnglen
        } else {
            ar.source = cstr("=?")
            ar.srclen = uint64(typeinfo sizeof(type<uint8[3]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul
        }
        ar.linedefined = p.linedefined
        ar.lastlinedefined = p.lastlinedefined
        ar.what = (ar.linedefined == 0) ? cstr("main") : cstr("Lua")
    }
    luaO_chunkid(addr(ar.short_src[0]), ar.source, ar.srclen)
}

[c_function]
def private nextline(var p : Proto?; currentline : int; pc : int) : int {
    if (int(p.lineinfo[pc]) != ABSLINEINFO) {
        return currentline + int(p.lineinfo[pc])
    } else {
        return luaG_getfuncline(p, pc)
    }
}

[c_function]
def private collectvalidlines(var L : lua_State?; var f : Closure?) {
    if (!LuaClosure(f)) {
        setnilvalue(s2v(L.top.p))
        api_incr_top(L)
    } else {
        var p : Proto? = f.l.p
        var currentline : int = p.linedefined
        // new table to store active lines
        var t : Table? = luaH_new(L)
        {
            // push it on stack
            var io : TValue? = s2v(L.top.p)
            var x_ : Table? = t
            io.value_.gc = obj2gco(x_)
            settt_(io, ctb(LUA_TTABLE | (0 << 4)))
        }
        api_incr_top(L)
        // proto with debug information?
        if (p.lineinfo != null) {
            var i : int
            var v : TValue
            // boolean 'true' to be the value of all indices
            setbtvalue(addr(v))
            // regular function?
            if (p.is_vararg == 0) {
                // consider all instructions
                i = 0
            } else {
                // vararg function
                currentline = nextline(p, currentline, 0)
                // skip first instruction (OP_VARARGPREP)
                i = 1
            }
            // for each instruction
            while (i < p.sizelineinfo) {
                // get its line
                currentline = nextline(p, currentline, i)
                // table[line] = true
                luaH_setint(L, t, int64(currentline), addr(v))
                i++
            }
        }
    }
}

[c_function]
def private getfuncname(var L : lua_State?; var ci : CallInfo?; var name : uint8 ??) : uint8? {
    // calling function is a known function?
    if (ci != null && (int(ci.callstatus) & CIST_TAIL) == 0) {
        return funcnamefromcall(L, ci.previous, name)
    } else {
        // no way to find a name
        return null
    }
}

[c_function]
def private auxgetinfo(var L : lua_State?; var what : uint8?; var ar : lua_Debug?; var f : Closure?; var ci : CallInfo?) : int {
    var status : int = 1
    while (*what != 0) {
        c_switch(int(*what)) {
            case('S') {
                funcinfo(ar, f)
                break
            }
            case('l') {
                ar.currentline = (ci != null && isLua(ci)) ? getcurrentline(ci) : -1
                break
            }
            case('u') {
                ar.nups = uint8((f == null) ? 0 : int(f.c.nupvalues))
                if (!LuaClosure(f)) {
                    ar.isvararg = 1u8
                    ar.nparams = 0u8
                } else {
                    ar.isvararg = f.l.p.is_vararg
                    ar.nparams = f.l.p.numparams
                }
                break
            }
            case('t') {
                ar.istailcall = uint8(ci != null ? int(ci.callstatus) & CIST_TAIL : 0)
                break
            }
            case('n') {
                ar.namewhat = getfuncname(L, ci, addr(ar.name))
                if (ar.namewhat == null) {
                    // not found
                    ar.namewhat = addr(c2das_empty[0])
                    ar.name = null
                }
                break
            }
            case('r') {
                if (ci == null || (int(ci.callstatus) & CIST_TRAN) == 0) {
                    ar.ntransfer = uint16(0)
                    ar.ftransfer = ar.ntransfer
                } else {
                    ar.ftransfer = ci.u2.transferinfo.ftransfer
                    ar.ntransfer = ci.u2.transferinfo.ntransfer
                }
                break
            }
            case('L', 'f') {
                // handled by lua_getinfo
                break
            }
            case(_) {
                // invalid option
                status = 0
            }
        }
        what++
    }
    return status
}

[c_function]
def lua_getinfo(var L : lua_State?; var what : uint8?; var ar : lua_Debug?) : int {
    var status : int
    var cl : Closure?
    var ci : CallInfo?
    var func : TValue?
    if (*what == '>') {
        ci = null
        func = s2v(L.top.p - 1)
        // skip the '>'
        what++
        // pop function
        L.top.p--
    } else {
        ci = ar.i_ci
        func = s2v(ci.func.p)
    }
    cl = ttisclosure(func) ? addr(reinterpret<GCUnion?>(func.value_.gc).cl) : null
    status = auxgetinfo(L, what, ar, cl, ci)
    if (crt::strchr(what, 'f') != null) {
        {
            var io1 : TValue? = s2v(L.top.p)
            var io2 : TValue? = func
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        api_incr_top(L)
    }
    if (crt::strchr(what, 'L') != null) {
        collectvalidlines(L, cl)
    }
    return status
}

def private filterpc(pc : int; jmptarget : int) : int {
    // is code conditional (inside a jump)?
    if (pc < jmptarget) {
        // cannot know who sets that register
        return -1
    } else {
        // current position sets that register
        return pc
    }
}

// Try to find last instruction before 'lastpc' that modified register 'reg'.
[c_function]
def private findsetreg(var p : Proto?; var lastpc : int; reg : int) : int {
    // keep last instruction that changed 'reg'
    var setreg : int = -1
    // any code before this address is conditional
    var jmptarget : int = 0
    if (testMMMode(GET_OPCODE(p.code[lastpc])) != 0) {
        // previous instruction was not actually executed
        lastpc--
    }
    for (pc in range(lastpc)) {
        let i : uint = p.code[pc]
        let op : OpCode = GET_OPCODE(i)
        let a : int = GETARG_A(i)
        // true if current instruction changed 'reg'
        var change : int
        c_switch(op) {
            case(OpCode.OP_LOADNIL) {
                {
                    // set registers from 'a' to 'a+b'
                    let b : int = GETARG_B(i)
                    change = int_of(a <= reg && reg <= a + b)
                    break
                }
            }
            case(OpCode.OP_TFORCALL) {
                // affect all regs above its base
                change = int_of(reg >= a + 2)
                break
            }
            case(OpCode.OP_CALL, OpCode.OP_TAILCALL) {
                // affect all registers above base
                change = int_of(reg >= a)
                break
            }
            case(OpCode.OP_JMP) {
                {
                    // doesn't change registers, but changes 'jmptarget'
                    let b : int = GETARG_sJ(i)
                    let dest : int = pc + 1 + b
                    // jump does not skip 'lastpc' and is larger than current one?
                    if (dest <= lastpc && dest > jmptarget) {
                        // update 'jmptarget'
                        jmptarget = dest
                    }
                    change = 0
                    break
                }
            }
            case(_) {
                // any instruction that sets A
                change = int_of(testAMode(op) != 0 && reg == a)
                break
            }
        }
        if (change != 0) {
            setreg = filterpc(pc, jmptarget)
        }
    }
    return setreg
}

// Find a "name" for the constant 'c'.
[c_function]
def private kname(var p : Proto?; index : int; var name : uint8 ??) : uint8? {
    var kvalue : TValue? = addr(p.k[index])
    if ((int(rawtt(kvalue)) & 15) == LUA_TSTRING) {
        *name = addr(tsvalue(kvalue).contents[0])
        return cstr("constant")
    } else {
        *name = cstr("?")
        return null
    }
}

[c_function]
def private basicgetobjname(var p : Proto?; var ppc : int?; reg : int; var name : uint8 ??) : uint8? {
    var pc : int = *ppc
    *name = luaF_getlocalname(p, reg + 1, pc)
    // is a local?
    if (*name != null) {
        return addr(strlocal[0])
    }
    // else try symbolic execution
    pc = findsetreg(p, pc, reg)
    *ppc = pc
    // could find instruction?
    if (pc != -1) {
        let i : uint = p.code[pc]
        let op : OpCode = GET_OPCODE(i)
        c_switch(op) {
            case(OpCode.OP_MOVE) {
                {
                    // move from 'b' to 'a'
                    let b : int = GETARG_B(i)
                    if (b < GETARG_A(i)) {
                        // get name for 'b'
                        return basicgetobjname(p, ppc, b, name)
                    }
                    break
                }
            }
            case(OpCode.OP_GETUPVAL) {
                *name = upvalname(p, GETARG_B(i))
                return addr(strupval[0])
            }
            case(OpCode.OP_LOADK) {
                return kname(p, GETARG_Bx(i), name)
            }
            case(OpCode.OP_LOADKX) {
                return kname(p, GETARG_Ax(p.code[pc + 1]), name)
            }
            case(_) {
                break
            }
        }
    }
    // could not find reasonable name
    return null
}

// Find a "name" for the register 'c'.
[c_function]
def private rname(var p : Proto?; var pc : int; c : int; var name : uint8 ??) {
    // search for 'c'
    var what : uint8? = basicgetobjname(p, addr(pc), c, name)
    // did not find a constant name?
    if (!(what != null && *what == 'c')) {
        *name = cstr("?")
    }
}

// Find a "name" for a 'C' value in an RK instruction.
def private rkname(var p : Proto?; pc : int; i : uint; var name : uint8 ??) {
    // key index
    let c : int = GETARG_C(i)
    // is 'c' a constant?
    if (((i >> uint(POS_k)) & (~(~0u << 1u) << 0u)) != 0) {
        kname(p, c, name)
    } else {
        // 'c' is a register
        rname(p, pc, c, name)
    }
}

// Check whether table being indexed by instruction 'i' is the
// environment '_ENV'. If the table is an upvalue, get its name;
// otherwise, find some "name" for the table and check whether
// that name is the name of a local variable (and not, for instance,
// a string). Then check that, if there is a name, it is '_ENV'.
[c_function]
def private isEnv(var p : Proto?; var pc : int; i : uint; isup : int) : uint8? {
    // table index
    let t : int = GETARG_B(i)
    // name of indexed variable
    var name : uint8?
    // is 't' an upvalue?
    if (isup != 0) {
        name = upvalname(p, t)
    } else {
        // 't' is a register
        var what : uint8? = basicgetobjname(p, addr(pc), t, addr(name))
        if (intptr(what) != intptr(addr(strlocal[0])) && intptr(what) != intptr(addr(strupval[0]))) {
            // cannot be the variable _ENV
            name = null
        }
    }
    return (name != null && crt::strcmp(name, cstr("_ENV")) == 0) ? cstr("global") : cstr("field")
}

// Extend 'basicgetobjname' to handle table accesses
[c_function]
def private getobjname(var p : Proto?; var lastpc : int; reg : int; var name : uint8 ??) : uint8? {
    var kind : uint8? = basicgetobjname(p, addr(lastpc), reg, name)
    if (kind != null) {
        return kind
    } elif (lastpc != -1) {
        // could find instruction?
        let i : uint = p.code[lastpc]
        let op : OpCode = GET_OPCODE(i)
        c_switch(op) {
            case(OpCode.OP_GETTABUP) {
                {
                    // key index
                    let k : int = GETARG_C(i)
                    kname(p, k, name)
                    return isEnv(p, lastpc, i, 1)
                }
            }
            case(OpCode.OP_GETTABLE) {
                {
                    // key index
                    let k : int = GETARG_C(i)
                    rname(p, lastpc, k, name)
                    return isEnv(p, lastpc, i, 0)
                }
            }
            case(OpCode.OP_GETI) {
                *name = cstr("integer index")
                return cstr("field")
            }
            case(OpCode.OP_GETFIELD) {
                {
                    // key index
                    let k : int = GETARG_C(i)
                    kname(p, k, name)
                    return isEnv(p, lastpc, i, 0)
                }
            }
            case(OpCode.OP_SELF) {
                rkname(p, lastpc, i, name)
                return cstr("method")
            }
            case(_) {
                // go through to return NULL
                break
            }
        }
    }
    // could not find reasonable name
    return null
}

// Try to find a name for a function based on the code that called it.
// (Only works when function was called by a Lua function.)
// Returns what the name is (e.g., "for iterator", "method",
// "metamethod") and sets '*name' to point to the name.
[c_function]
def private funcnamefromcode(var L : lua_State?; var p : Proto?; pc : int; var name : uint8 ??) : uint8? {
    // (initial value avoids warnings)
    var tm : TMS = TMS.TM_INDEX
    // calling instruction
    let i : uint = p.code[pc]
    c_switch(GET_OPCODE(i)) {
        case(OpCode.OP_CALL, OpCode.OP_TAILCALL) {
            // get function name
            return getobjname(p, pc, GETARG_A(i), name)
        }
        case(OpCode.OP_TFORCALL) {
            // for iterator
            *name = cstr("for iterator")
            return cstr("for iterator")
        }
        case(OpCode.OP_SELF, OpCode.OP_GETTABUP, OpCode.OP_GETTABLE, OpCode.OP_GETI, OpCode.OP_GETFIELD) {
            // other instructions can do calls through metamethods
            tm = TMS.TM_INDEX
            break
        }
        case(OpCode.OP_SETTABUP, OpCode.OP_SETTABLE, OpCode.OP_SETI, OpCode.OP_SETFIELD) {
            tm = TMS.TM_NEWINDEX
            break
        }
        case(OpCode.OP_MMBIN, OpCode.OP_MMBINI, OpCode.OP_MMBINK) {
            tm = enum_from_int(type<TMS>, GETARG_C(i))
            break
        }
        case(OpCode.OP_UNM) {
            tm = TMS.TM_UNM
            break
        }
        case(OpCode.OP_BNOT) {
            tm = TMS.TM_BNOT
            break
        }
        case(OpCode.OP_LEN) {
            tm = TMS.TM_LEN
            break
        }
        case(OpCode.OP_CONCAT) {
            tm = TMS.TM_CONCAT
            break
        }
        case(OpCode.OP_EQ) {
            tm = TMS.TM_EQ
            break
        }
        case(OpCode.OP_LT, OpCode.OP_LTI, OpCode.OP_GTI) {
            // no cases for OP_EQI and OP_EQK, as they don't call metamethods
            tm = TMS.TM_LT
            break
        }
        case(OpCode.OP_LE, OpCode.OP_LEI, OpCode.OP_GEI) {
            tm = TMS.TM_LE
            break
        }
        case(OpCode.OP_CLOSE, OpCode.OP_RETURN) {
            tm = TMS.TM_CLOSE
            break
        }
        case(_) {
            // cannot find a reasonable name
            return null
        }
    }
    *name = addr(G(L).tmname[int(tm)].contents[0]) + 2
    return cstr("metamethod")
}

// Try to find a name for a function based on how it was called.
[c_function]
def private funcnamefromcall(var L : lua_State?; var ci : CallInfo?; var name : uint8 ??) : uint8? {
    // was it called inside a hook?
    if ((int(ci.callstatus) & CIST_HOOKED) != 0) {
        *name = cstr("?")
        return cstr("hook")
    } elif ((int(ci.callstatus) & CIST_FIN) != 0) {
        // was it called as a finalizer?
        *name = cstr("__gc")
        // report it as such
        return cstr("metamethod")
    } elif (isLua(ci)) {
        return funcnamefromcode(L, ci_func(ci).p, currentpc(ci), name)
    } else {
        return null
    }
}

// Check whether pointer 'o' points to some value in the stack frame of
// the current function and, if so, returns its index. Because 'o' may
// not point to a value in this stack, we cannot compare it with the
// region boundaries (undefined behavior in ISO C).
[c_function]
def private instack(var ci : CallInfo?; var o : TValue?) : int {
    var pos : int
    var base : StackValue? = ci.func.p + 1
    pos = 0
    while (intptr(base + pos) < intptr(ci.top.p)) {
        if (intptr(o) == intptr(reinterpret<TValue?>(s2v(base + pos)))) {
            return pos
        }
        pos++
    }
    // not found
    return -1
}

// Checks whether value 'o' came from an upvalue. (That can only happen
// with instructions OP_GETTABUP/OP_SETTABUP, which operate directly on
// upvalues.)
[c_function]
def private getupvalname(var ci : CallInfo?; var o : TValue?; var name : uint8 ??) : uint8? {
    var c : LClosure? = ci_func(ci)
    var i : int
    i = 0
    while (i < int(c.nupvalues)) {
        if (intptr(addr(c.upvals[0])[i].v.p) == intptr(reinterpret<TValue?>(o))) {
            *name = upvalname(c.p, i)
            return addr(strupval[0])
        }
        i++
    }
    return null
}

[c_function]
def private formatvarinfo(var L : lua_State?; var kind : uint8?; var name : uint8?) : uint8? {
    if (kind == null) {
        // no information
        return addr(c2das_empty[0])
    } else {
        return luaO_pushfstring`va(L, cstr(" (%s '%s')"), (kind, name))
    }
}

// Build a string with a "description" for the value 'o', such as
// "variable 'x'" or "upvalue 'y'".
[c_function]
def private varinfo(var L : lua_State?; var o : TValue?) : uint8? {
    var ci : CallInfo? = L.ci
    // to avoid warnings
    var name : uint8? = null
    var kind : uint8? = null
    if (isLua(ci)) {
        // check whether 'o' is an upvalue
        kind = getupvalname(ci, o, addr(name))
        // not an upvalue?
        if (kind == null) {
            // try a register
            let reg : int = instack(ci, o)
            // is 'o' a register?
            if (reg >= 0) {
                kind = getobjname(ci_func(ci).p, currentpc(ci), reg, addr(name))
            }
        }
    }
    return formatvarinfo(L, kind, name)
}

// Raise a type error
def private typeerror(var L : lua_State?; var o : TValue?; var op : uint8?; var extra : uint8?) {
    var t : uint8? = luaT_objtypename(L, o)
    luaG_runerror`va(L, cstr("attempt to %s a %s value%s"), (op, t, extra))
}

// Raise a type error with "standard" information about the faulty
// object 'o' (using 'varinfo').
def luaG_typeerror(var L : lua_State?; var o : TValue?; var op : uint8?) {
    typeerror(L, o, op, varinfo(L, o))
}

// Raise an error for calling a non-callable object. Try to find a name
// for the object based on how it was called ('funcnamefromcall'); if it
// cannot get a name there, try 'varinfo'.
[c_function]
def luaG_callerror(var L : lua_State?; var o : TValue?) {
    var ci : CallInfo? = L.ci
    // to avoid warnings
    var name : uint8? = null
    var kind : uint8? = funcnamefromcall(L, ci, addr(name))
    var extra : uint8? = kind != null ? formatvarinfo(L, kind, name) : varinfo(L, o)
    typeerror(L, o, cstr("call"), extra)
}

def luaG_forerror(var L : lua_State?; var o : TValue?; var what : uint8?) {
    luaG_runerror`va(L, cstr("bad 'for' %s (number expected, got %s)"), (what, luaT_objtypename(L, o)))
}

def luaG_concaterror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    if ((int(rawtt(p1)) & 15) == LUA_TSTRING || (int(rawtt(p1)) & 15) == LUA_TNUMBER) {
        p1 = p2
    }
    luaG_typeerror(L, p1, cstr("concatenate"))
}

def luaG_opinterror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?; var msg : uint8?) {
    // first operand is wrong?
    if (!((int(rawtt(p1)) & 15) == LUA_TNUMBER)) {
        // now second is wrong
        p2 = p1
    }
    luaG_typeerror(L, p2, msg)
}

// Error when both values are convertible to numbers, but not to integers
[c_function]
def luaG_tointerror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    var temp : int64
    if (luaV_tointegerns(p1, addr(temp), F2Imod.F2Ieq) == 0) {
        p2 = p1
    }
    luaG_runerror`va(L, cstr("number%s has no integer representation"), (varinfo(L, p2),))
}

[c_function]
def luaG_ordererror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    var t1 : uint8? = luaT_objtypename(L, p1)
    var t2 : uint8? = luaT_objtypename(L, p2)
    if (crt::strcmp(t1, t2) == 0) {
        luaG_runerror`va(L, cstr("attempt to compare two %s values"), (t1,))
    } else {
        luaG_runerror`va(L, cstr("attempt to compare %s with %s"), (t1, t2))
    }
}

// add src:line information to 'msg'
[c_function]
def luaG_addinfo(var L : lua_State?; var msg : uint8?; var src : TString?; line : int) : uint8? {
    var buff : uint8[60]
    if (src != null) {
        luaO_chunkid(addr(buff[0]), addr(src.contents[0]), tsslen(src))
    } else {
        // no source available; use "?" instead
        buff[0] = uint8('?')
        buff[1] = uint8('\0')
    }
    return luaO_pushfstring`va(L, cstr("%s:%d: %s"), (addr(buff[0]), line, msg))
}

[c_function]
def luaG_errormsg(var L : lua_State?) {
    // is there an error handling function?
    if (L.errfunc != 0l) {
        var errfunc : StackValue? = restorestack(L, L.errfunc)
        {
            // move argument
            var io1 : TValue? = s2v(L.top.p)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        {
            // push function
            var io1 : TValue? = s2v(L.top.p - 1)
            var io2 : TValue? = s2v(errfunc)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        // assume EXTRA_STACK
        L.top.p++
        // call it
        luaD_callnoyield(L, L.top.p - 2, 1)
    }
    luaD_throw(L, LUA_ERRRUN)
}

[c_function, variadic]
def luaG_runerror(var L : lua_State?; var fmt : uint8?; va : va_args) {
    var ci : CallInfo? = L.ci
    var msg : uint8?
    var argp : CVaCursor
    luaC_checkGC(L)
    // error message uses memory
    argp = va_begin(va)
    // format message
    msg = luaO_pushvfstring(L, fmt, argp)
    // if Lua function, add source:line information
    if (isLua(ci)) {
        luaG_addinfo(L, msg, ci_func(ci).p.source, getcurrentline(ci))
        {
            // remove 'msg'
            var io1 : TValue? = s2v(L.top.p - 2)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        L.top.p--
    }
    luaG_errormsg(L)
}

// Check whether new instruction 'newpc' is in a different line from
// previous instruction 'oldpc'. More often than not, 'newpc' is only
// one or a few instructions after 'oldpc' (it must be after, see
// caller), so try to avoid calling 'luaG_getfuncline'. If they are
// too far apart, there is a good chance of a ABSLINEINFO in the way,
// so it goes directly to 'luaG_getfuncline'.
[c_function]
def private changedline(var p : Proto?; oldpc : int; newpc : int) : int {
    // no debug information?
    if (p.lineinfo == null) {
        return 0
    }
    // not too far apart?
    if (newpc - oldpc < MAXIWTHABS / 2) {
        // line difference
        var delta : int = 0
        var pc : int = oldpc
        while (true) {
            pc++
            let lineinfo : int = int(p.lineinfo[pc])
            if (lineinfo == ABSLINEINFO) {
                // cannot compute delta; fall through
                break
            }
            delta += lineinfo
            if (pc == newpc) {
                // delta computed successfully
                return int_of(delta != 0)
            }
        }
    }
    // either instructions are too far apart or there is an absolute line
    // info in the way; compute line difference explicitly
    return int_of(luaG_getfuncline(p, oldpc) != luaG_getfuncline(p, newpc))
}

// Traces Lua calls. If code is running the first instruction of a function,
// and function is not vararg, and it is not coming from an yield,
// calls 'luaD_hookcall'. (Vararg functions will call 'luaD_hookcall'
// after adjusting its variable arguments; otherwise, they could call
// a line/count hook before the call hook. Functions coming from
// an yield already called 'luaD_hookcall' before yielding.)
[c_function]
def luaG_tracecall(var L : lua_State?) : int {
    var ci : CallInfo? = L.ci
    var p : Proto? = ci_func(ci).p
    // ensure hooks will be checked
    c_volatile_store(ci.u.l.trap, 1)
    // first instruction (not resuming)?
    if (intptr(ci.u.l.savedpc) == intptr(reinterpret<uint?>(p.code))) {
        if (p.is_vararg != 0) {
            // hooks will start at VARARGPREP instruction
            return 0
        } elif ((int(ci.callstatus) & CIST_HOOKYIELD) == 0) {
            // not yieded?
            // check 'call' hook
            luaD_hookcall(L, ci)
        }
    }
    // keep 'trap' on
    return 1
}

// Traces the execution of a Lua function. Called before the execution
// of each opcode, when debug is on. 'L->oldpc' stores the last
// instruction traced, to detect line changes. When entering a new
// function, 'npci' will be zero and will test as a new line whatever
// the value of 'oldpc'. Some exceptional conditions may return to
// a function without setting 'oldpc'. In that case, 'oldpc' may be
// invalid; if so, use zero as a valid value. (A wrong but valid 'oldpc'
// at most causes an extra call to a line hook.)
// This function is not "Protected" when called, so it should correct
// 'L->top.p' before calling anything that can run the GC.
[c_function]
def luaG_traceexec(var L : lua_State?; var pc : uint?) : int {
    var ci : CallInfo? = L.ci
    let mask : uint8 = uint8(c_volatile_load(L.hookmask))
    var p : Proto? = ci_func(ci).p
    var counthook : int
    // no hooks?
    if ((int(mask) & (LUA_MASKLINE | LUA_MASKCOUNT)) == 0) {
        // don't need to stop again
        c_volatile_store(ci.u.l.trap, 0)
        // turn off 'trap'
        return 0
    }
    // reference is always next instruction
    pc++
    // save 'pc'
    ci.u.l.savedpc = pc
    var _t0 = (int(mask) & LUA_MASKCOUNT) != 0
    if (_t0) {
        L.hookcount--
        _t0 = L.hookcount == 0
    }
    counthook = int_of(_t0)
    if (counthook != 0) {
        // reset count
        resethookcount(L)
    } elif ((int(mask) & LUA_MASKLINE) == 0) {
        // no line hook and count != 0; nothing to be done now
        return 1
    }
    // hook yielded last time?
    if ((int(ci.callstatus) & CIST_HOOKYIELD) != 0) {
        // erase mark
        ci.callstatus = uint16(int(ci.callstatus) & ~CIST_HOOKYIELD)
        // do not call hook again (VM yielded, so it did not move)
        return 1
    }
    // top not being used?
    if (!(testITMode(GET_OPCODE(*(ci.u.l.savedpc - 1))) != 0 && GETARG_B(*(ci.u.l.savedpc - 1)) == 0)) {
        // correct top
        L.top.p = ci.top.p
    }
    if (counthook != 0) {
        // call count hook
        luaD_hook(L, LUA_HOOKCOUNT, -1, 0, 0)
    }
    if ((int(mask) & LUA_MASKLINE) != 0) {
        // 'L->oldpc' may be invalid; use zero in this case
        let oldpc : int = (L.oldpc < p.sizecode) ? L.oldpc : 0
        let npci : int = pcRel(pc, p)
        // call hook when jump back (loop),
        if (npci <= oldpc || changedline(p, oldpc, npci) != 0) {
            // or when enter new line
            let newline : int = luaG_getfuncline(p, npci)
            // call line hook
            luaD_hook(L, LUA_HOOKLINE, newline, 0, 0)
        }
        // 'pc' of last call to line hook
        L.oldpc = npci
    }
    // did hook yield?
    if (int(L.status) == LUA_YIELD) {
        if (counthook != 0) {
            // undo decrement to zero
            L.hookcount = 1
        }
        // mark that it yielded
        ci.callstatus = uint16(int(ci.callstatus) | CIST_HOOKYIELD)
        luaD_throw(L, LUA_YIELD)
    }
    // keep 'trap' on
    return 1
}

[c_function]
def luaD_seterrorobj(var L : lua_State?; errcode : int; var oldtop : StackValue?) {
    c_switch(errcode) {
        case(4) {
            {
                // memory error?
                // reuse preregistered msg.
                var io : TValue? = s2v(oldtop)
                var x_ : TString? = G(L).memerrmsg
                io.value_.gc = obj2gco(x_)
                settt_(io, ctb(x_.tt))
            }
            break
        }
        case(0) {
            // special case only for closing upvalues
            // no error message
            setnilvalue(s2v(oldtop))
            break
        }
        case(_) {
            // real error
            {
                // error message on current top
                var io1 : TValue? = s2v(oldtop)
                var io2 : TValue? = s2v(L.top.p - 1)
                io1.value_ = io2.value_
                io1.tt_ = io2.tt_
            }
            break
        }
    }
    L.top.p = oldtop + 1
}

[c_function]
def luaD_throw(var L : lua_State?; var errcode : int) {
    // thread has an error handler?
    if (L.errorJmp != null) {
        // set status
        c_volatile_store(L.errorJmp.status, errcode)
        // jump to it
        c_longjmp(addr(L.errorJmp.b), 1)
    } else {
        // thread has no error handler
        var g : global_State? = G(L)
        // close all upvalues
        errcode = luaE_resetthread(L, errcode)
        L.status = uint8(errcode)
        // main thread has a handler?
        if (g.mainthread.errorJmp != null) {
            {
                // copy error obj.
                var _t0 = g.mainthread.top.p
                g.mainthread.top.p++
                var io1 : TValue? = addr(_t0.val)
                var io2 : TValue? = s2v(L.top.p - 1)
                io1.value_ = io2.value_
                io1.tt_ = io2.tt_
            }
            // re-throw in main thread
            luaD_throw(g.mainthread, errcode)
        } else {
            // no handler at all; abort
            // panic function?
            if (g._c_panic != null) {
                // call panic function (last chance to jump out)
                invoke(g._c_panic, L)
            }
            c_abort()
        }
    }
}

[c_function]
def luaD_rawrunprotected(var L : lua_State?; f : function<(var a0 : lua_State?; var a1 : void?) : void>; var ud : void?) : int {
    let oldnCcalls : uint = L.nCcalls
    var lj : lua_longjmp
    c_volatile_store(lj.status, LUA_OK)
    // chain new error handler
    lj.previous = L.errorJmp
    L.errorJmp = addr(lj)
    try {
        invoke(f, L, ud)
    } recover {
        if (c_jmp_target != addr(addr(lj).b)) {
            panic("longjmp")
        }
        c_jmp_target = null
    }
    // restore old error handler
    L.errorJmp = lj.previous
    L.nCcalls = oldnCcalls
    return c_volatile_load(lj.status)
}

// Change all pointers to the stack into offsets.
[c_function]
def private relstack(var L : lua_State?) {
    var ci : CallInfo?
    var up : UpVal?
    L.top.offset = savestack(L, L.top.p)
    L.tbclist.offset = savestack(L, L.tbclist.p)
    up = L.openupval
    while (up != null) {
        up.v.offset = int64(cast_charp(uplevel(up)) - reinterpret<uint8?>(L.stack.p))
        up = up.u.open.next
    }
    ci = L.ci
    while (ci != null) {
        ci.top.offset = savestack(L, ci.top.p)
        ci.func.offset = savestack(L, ci.func.p)
        ci = ci.previous
    }
}

// Change back all offsets into pointers.
[c_function]
def private correctstack(var L : lua_State?) {
    var ci : CallInfo?
    var up : UpVal?
    L.top.p = restorestack(L, L.top.offset)
    L.tbclist.p = restorestack(L, L.tbclist.offset)
    up = L.openupval
    while (up != null) {
        up.v.p = s2v(restorestack(L, up.v.offset))
        up = up.u.open.next
    }
    ci = L.ci
    while (ci != null) {
        ci.top.p = restorestack(L, ci.top.offset)
        ci.func.p = restorestack(L, ci.func.offset)
        if (isLua(ci)) {
            // signal to update 'trap' in 'luaV_execute'
            c_volatile_store(ci.u.l.trap, 1)
        }
        ci = ci.previous
    }
}

// raise an error while running the message handler
[c_function]
def luaD_errerr(var L : lua_State?) {
    var msg : TString? = luaS_newlstr(L, cstr("error in error handling"), uint64(typeinfo sizeof(type<uint8[24]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul)
    {
        var io : TValue? = s2v(L.top.p)
        var x_ : TString? = msg
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(x_.tt))
    }
    // assume EXTRA_STACK
    L.top.p++
    luaD_throw(L, LUA_ERRERR)
}

// Reallocate the stack to a new size, correcting all pointers into it.
// In ISO C, any pointer use after the pointer has been deallocated is
// undefined behavior. So, before the reallocation, all pointers are
// changed to offsets, and after the reallocation they are changed back
// to pointers. As during the reallocation the pointers are invalid, the
// reallocation cannot run emergency collections.
// In case of allocation error, raise an error or return false according
// to 'raiseerror'.
[c_function]
def luaD_reallocstack(var L : lua_State?; newsize : int; raiseerror : int) : int {
    let oldsize : int = stacksize(L)
    var newstack : StackValue?
    let oldgcstop : int = int(G(L).gcstopem)
    // change pointers to offsets
    relstack(L)
    // stop emergency collection
    G(L).gcstopem = 1u8
    newstack = reinterpret<StackValue?>(luaM_realloc_(L, reinterpret<void?>(L.stack.p),
            uint64(oldsize + EXTRA_STACK) * uint64(typeinfo sizeof(type<StackValue>)),
            uint64(newsize + EXTRA_STACK) * uint64(typeinfo sizeof(type<StackValue>))))
    // restore emergency collection
    G(L).gcstopem = uint8(oldgcstop)
    // reallocation failed?
    if (newstack == null) {
        // change offsets back to pointers
        correctstack(L)
        if (raiseerror != 0) {
            luaM_error(L)
        } else {
            // do not raise an error
            return 0
        }
    }
    L.stack.p = newstack
    // change offsets back to pointers
    correctstack(L)
    L.stack_last.p = L.stack.p + newsize
    for (i in range(oldsize + EXTRA_STACK, newsize + EXTRA_STACK)) {
        // erase new segment
        setnilvalue(s2v(newstack + i))
    }
    return 1
}

// Try to grow the stack by at least 'n' elements. When 'raiseerror'
// is true, raises any error; otherwise, return 0 in case of errors.
[c_function]
def luaD_growstack(var L : lua_State?; n : int; raiseerror : int) : int {
    let size : int = stacksize(L)
    if (size > LUAI_MAXSTACK) {
        // if stack is larger than maximum, thread is already using the
        // extra space reserved for errors, that is, thread is handling
        // a stack error; cannot grow further than that.
        if (raiseerror != 0) {
            // error inside message handler
            luaD_errerr(L)
        }
        // if not 'raiseerror', just signal it
        return 0
    } elif (n < LUAI_MAXSTACK) {
        // avoids arithmetic overflows
        // tentative new size
        var newsize : int = 2 * size
        let needed : int = int(int64(L.top.p - L.stack.p)) + n
        // cannot cross the limit
        if (newsize > LUAI_MAXSTACK) {
            newsize = LUAI_MAXSTACK
        }
        // but must respect what was asked for
        if (newsize < needed) {
            newsize = needed
        }
        if (newsize <= LUAI_MAXSTACK) {
            return luaD_reallocstack(L, newsize, raiseerror)
        }
    }
    // else stack overflow
    // add extra size to be able to handle the error message
    luaD_reallocstack(L, ERRORSTACKSIZE, raiseerror)
    if (raiseerror != 0) {
        luaG_runerror`va(L, cstr("stack overflow"), VaNone())
    }
    return 0
}

// Compute how much of the stack is being used, by computing the
// maximum top of all call frames in the stack and the current top.
[c_function]
def private stackinuse(var L : lua_State?) : int {
    var ci : CallInfo?
    var res : int
    var lim : StackValue? = L.top.p
    ci = L.ci
    while (ci != null) {
        if (intptr(lim) < intptr(ci.top.p)) {
            lim = ci.top.p
        }
        ci = ci.previous
    }
    // part of stack in use
    res = int(int64(lim - L.stack.p)) + 1
    if (res < LUA_MINSTACK) {
        // ensure a minimum size
        res = LUA_MINSTACK
    }
    return res
}

// If stack size is more than 3 times the current use, reduce that size
// to twice the current use. (So, the final stack size is at most 2/3 the
// previous size, and half of its entries are empty.)
// As a particular case, if stack was handling a stack overflow and now
// it is not, 'max' (limited by LUAI_MAXSTACK) will be smaller than
// stacksize (equal to ERRORSTACKSIZE in this case), and so the stack
// will be reduced to a "regular" size.
def luaD_shrinkstack(var L : lua_State?) {
    let inuse : int = stackinuse(L)
    let max : int = (inuse > LUAI_MAXSTACK / 3) ? LUAI_MAXSTACK : inuse * 3
    // if thread is currently not handling a stack overflow and its
    // size is larger than maximum "reasonable" size, shrink it
    if (inuse <= LUAI_MAXSTACK && stacksize(L) > max) {
        let nsize : int = (inuse > LUAI_MAXSTACK / 2) ? LUAI_MAXSTACK : inuse * 2
        // ok if that fails
        luaD_reallocstack(L, nsize, 0)
    } else {
        // don't change stack
        // (change only for debugging)
    }
    // shrink CI list
    luaE_shrinkCI(L)
}

[c_function]
def luaD_inctop(var L : lua_State?) {
    if (int64(L.stack_last.p - L.top.p) <= 1l) {
        luaD_growstack(L, 1, 1)
    } else {
    }
    L.top.p++
}

// Call a hook for the given event. Make sure there is a hook to be
// called. (Both 'L->hook' and 'L->hookmask', which trigger this
// function, can be changed asynchronously by signals.)
[c_function]
def luaD_hook(var L : lua_State?; event : int; line : int; ftransfer : int; ntransfer : int) {
    var hook : function<(var a0 : lua_State?; var a1 : lua_Debug?) : void> = c_volatile_load(L.hook)
    // make sure there is a hook
    if (hook != null && L.allowhook != 0) {
        var mask : int = CIST_HOOKED
        var ci : CallInfo? = L.ci
        // preserve original 'top'
        let top : int64 = savestack(L, L.top.p)
        // idem for 'ci->top'
        let ci_top : int64 = savestack(L, ci.top.p)
        var ar : lua_Debug
        ar.event = event
        ar.currentline = line
        ar.i_ci = ci
        if (ntransfer != 0) {
            // 'ci' has transfer information
            mask |= CIST_TRAN
            ci.u2.transferinfo.ftransfer = uint16(ftransfer)
            ci.u2.transferinfo.ntransfer = uint16(ntransfer)
        }
        if (isLua(ci) && intptr(L.top.p) < intptr(ci.top.p)) {
            // protect entire activation register
            L.top.p = ci.top.p
        }
        // ensure minimum stack size
        if (int64(L.stack_last.p - L.top.p) <= int64(LUA_MINSTACK)) {
            luaD_growstack(L, LUA_MINSTACK, 1)
        } else {
        }
        if (intptr(ci.top.p) < intptr(L.top.p + LUA_MINSTACK)) {
            ci.top.p = L.top.p + LUA_MINSTACK
        }
        // cannot call hooks inside a hook
        L.allowhook = 0u8
        ci.callstatus = uint16(int(ci.callstatus) | mask)
        invoke(hook, L, addr(ar))
        L.allowhook = 1u8
        ci.top.p = restorestack(L, ci_top)
        L.top.p = restorestack(L, top)
        ci.callstatus = uint16(int(ci.callstatus) & ~mask)
    }
}

// Executes a call hook for Lua functions. This function is called
// whenever 'hookmask' is not zero, so it checks whether call hooks are
// active.
[c_function]
def luaD_hookcall(var L : lua_State?; var ci : CallInfo?) {
    // set 'oldpc' for new function
    L.oldpc = 0
    // is call hook on?
    if ((c_volatile_load(L.hookmask) & LUA_MASKCALL) != 0) {
        let event : int = (int(ci.callstatus) & CIST_TAIL) != 0 ? LUA_HOOKTAILCALL : LUA_HOOKCALL
        var p : Proto? = ci_func(ci).p
        // hooks assume 'pc' is already incremented
        ci.u.l.savedpc++
        luaD_hook(L, event, -1, 1, int(p.numparams))
        // correct 'pc'
        ci.u.l.savedpc--
    }
}

// Executes a return hook for Lua and C functions and sets/corrects
// 'oldpc'. (Note that this correction is needed by the line hook, so it
// is done even when return hooks are off.)
[c_function]
def private rethook(var L : lua_State?; var ci : CallInfo?; nres : int) {
    // is return hook on?
    if ((c_volatile_load(L.hookmask) & LUA_MASKRET) != 0) {
        // index of first result
        var firstres : StackValue? = L.top.p - nres
        // correction for vararg functions
        var delta : int = 0
        var ftransfer : int
        if (isLua(ci)) {
            var p : Proto? = ci_func(ci).p
            if (p.is_vararg != 0) {
                delta = ci.u.l.nextraargs + int(p.numparams) + 1
            }
        }
        // if vararg, back to virtual 'func'
        ci.func.p += delta
        ftransfer = int(uint16(int64(firstres - ci.func.p)))
        // call it
        luaD_hook(L, LUA_HOOKRET, -1, ftransfer, nres)
        ci.func.p -= delta
    }
    ci = ci.previous
    if ((int(ci.callstatus) & CIST_C) == 0) {
        // set 'oldpc'
        L.oldpc = pcRel(ci.u.l.savedpc, ci_func(ci).p)
