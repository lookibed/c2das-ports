                p++
            }
            // look for a ']'
            c_do_while(*p != ']') {
                if (intptr(p) == intptr(ms.p_end)) {
                    luaL_error`va(ms.L, cstr("malformed pattern (missing ']')"), VaNone())
                }
                var _t1 = p
                p++
                if (int(*_t1) == L_ESC && intptr(p) < intptr(ms.p_end)) {
                    // skip escapes (e.g. '%]')
                    p++
                }
            }
            return p + 1
        }
        case(_) {
            return p
        }
    }
