// Create a new local variable with the given 'name'. Return its index
// in the function.
[c_function]
def private new_localvar(var ls : LexState?; var name : TString?) : int {
    var L : lua_State? = ls.L
    var fs : FuncState? = ls.fs
    var dyd : Dyndata? = ls.dyd
    var _c_var : Vardesc?
