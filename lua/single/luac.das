        // get previous variable
        var vd : Vardesc? = getlocalvardesc(fs, nvar)
        // is in a register?
        if (int(vd.vd.kind) != RDKCTC) {
            return int(vd.vd.ridx) + 1
        }
    }
    // no variables in registers
    return 0
