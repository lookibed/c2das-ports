            {
                {
                    var io1 : TValue? = slot
                    var io2 : TValue? = val
                    io1.value_ = io2.value_
                    io1.tt_ = io2.tt_
                }
                if ((int(val.tt_) & 1 << 6) != 0) {
                    if ((int(t.value_.gc.marked) & 1 << 5) != 0 && (int(val.value_.gc.marked) & (1 << 3 | 1 << 4)) != 0) {
