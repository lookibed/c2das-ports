                addnum2buff(addr(buff), addr(num))
            }
        } elif (_cond == 'I') {
            {
                // a 'lua_Integer'
                var num : TValue
                {
                    var io : TValue? = addr(num)
                    io.value_.i = va_i(argp)
                    io.tt_ = uint8(3 | 0 << 4)
                }
                addnum2buff(addr(buff), addr(num))
            }
