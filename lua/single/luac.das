    for (loop in range(MAXTAGLOOP)) {
        // 't' is not a table?
        if (slot == null) {
            tm = luaT_gettmbyobj(L, t, TMS.TM_INDEX)
            if ((int(tm.tt_) & 15) == 0) {
                // no metamethod
