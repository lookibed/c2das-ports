                    io.value_.n = va_d(argp)
                    io.tt_ = uint8(3 | 1 << 4)
                }
                addnum2buff(addr(buff), addr(num))
            }
        } elif (_cond == 'p') {
            {
                // a pointer
                // enough space for '%p'
                var sz : int = int(uint64(3) * uint64(typeinfo sizeof(type<void?>)) + uint64(8))
                var bf : uint8? = getbuff(addr(buff), sz)
                var p : void? = reinterpret<void?>(va_p(argp))
