    static_assert(typeinfo offsetof < _storage > (type<StackValue>) == 0, "StackValue: every member sits at 0")
    static_assert(typeinfo sizeof(type<StkIdRel>) == 8 && typeinfo alignof(type<StkIdRel>) == 8, "StkIdRel: clang lays it out as size 8, align 8")
    static_assert(typeinfo offsetof < _storage > (type<StkIdRel>) == 0, "StkIdRel: every member sits at 0")
