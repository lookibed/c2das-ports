}

[c_function]
def private error_expected(var ls : LexState?; token : int) {
    luaX_syntaxerror(ls, luaO_pushfstring`va(ls.L, reinterpret<uint8?>("%s expected"), (luaX_token2str(ls, token),)))
}

[c_function]
def private errorlimit(var fs : FuncState?; limit : int; var what : uint8?) {
    var L : lua_State? = fs.ls.L
    var msg : uint8?
    var line : int = fs.f.linedefined
    var _c_where : uint8? = line == 0 ? reinterpret<uint8?>(reinterpret<uint8?>("main function")) : luaO_pushfstring`va(L, reinterpret<uint8?>("function at line %d"), (line,))
    msg = luaO_pushfstring`va(L, reinterpret<uint8?>("too many %s (limit is %d) in %s"), (what, limit, _c_where))
    luaX_syntaxerror(fs.ls, msg)
}

def private checklimit(var fs : FuncState?; v : int; l : int; var what : uint8?) {
    if (v > l) {
        errorlimit(fs, l, what)
    }
}

// Test whether next token is 'c'; if so, skip it.
def private testnext(var ls : LexState?; c : int) : int {
    if (ls.t.token == c) {
        luaX_next(ls)
        return 1
    } else {
        return 0
    }
}

// Check that next token is 'c'.
def private check(var ls : LexState?; c : int) {
    if (ls.t.token != c) {
        error_expected(ls, c)
    }
}

// Check that next token is 'c' and skip it.
def private checknext(var ls : LexState?; c : int) {
    check(ls, c)
    luaX_next(ls)
}

// Check that next token is 'what' and skip it. In case of error,
// raise an error that the expected 'what' should match a 'who'
// in line 'where' (if that is not the current line).
[c_function]
def private check_match(var ls : LexState?; what : int; who : int; _c_where : int) {
    if (!(testnext(ls, what) != 0)) {
        // all in the same line?
        if (_c_where == ls.linenumber) {
            // do not need a complex message
            error_expected(ls, what)
        } else {
            luaX_syntaxerror(ls, luaO_pushfstring`va(ls.L, reinterpret<uint8?>("%s expected (to close %s at line %d)"), (luaX_token2str(ls, what), luaX_token2str(ls, who), _c_where)))
        }
    }
}

def private str_checkname(var ls : LexState?) : TString? {
    var ts : TString?
    check(ls, int(RESERVED.TK_NAME))
    ts = ls.t.seminfo.ts
    luaX_next(ls)
    return ts
}

def private init_exp(var e : expdesc?; k : expkind; i : int) {
    e.t = NO_JUMP
    e.f = e.t
    e.k = k
    e.u.info = i
}

def private codestring(var e : expdesc?; var s : TString?) {
    e.t = NO_JUMP
    e.f = e.t
    e.k = expkind.VKSTR
    e.u.strval = s
}

def private codename(var ls : LexState?; var e : expdesc?) {
    codestring(e, str_checkname(ls))
}

// Register a new local variable in the active 'Proto' (for debug
// information).
[c_function]
def private registerlocalvar(var ls : LexState?; var fs : FuncState?; var varname : TString?) : int {
