    var lsizenode : uint8 = t1.lsizenode
    var node : Node? = t1.node
    var lastfree : Node? = t1.lastfree
    t1.lsizenode = t2.lsizenode
    t1.node = t2.node
    t1.lastfree = t2.lastfree
    t2.lsizenode = lsizenode
    t2.node = node
    t2.lastfree = lastfree
}

