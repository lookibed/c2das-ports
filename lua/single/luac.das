                var _t0 = L.top.p
                L.top.p = L.top.p + 1
                addr(_t0.val).tt_ = uint8(0 | 0 << 4)
                diff--
            }
        }
    } else {
        // will "subtract" index (as it is negative)
        diff = int64(idx + 1)
    }
    newtop = L.top.p + diff
    if (diff < int64(0) && intptr(L.tbclist.p) >= intptr(newtop)) {
