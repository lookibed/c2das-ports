    buff.pushed = buff.blen
    buff.L = L
    while (true) {
        e = crt::strchr(fmt, '%')
        if (!(e != null)) {
            break
        }
        // add 'fmt' up to '%'
        addstr2buff(addr(buff), fmt, uint64(int64(e - fmt)))
