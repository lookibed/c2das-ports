    var ui : uint64 = uint64(i)
    if (ui <= uint64(uint(2147483647))) {
        return addr(deref(t.node + int(ui) % ((1 << int(t.lsizenode)) - 1 | 1)))
    } else {
        return addr(deref(t.node + ui % uint64((1 << int(t.lsizenode)) - 1 | 1)))
    }
}

[c_function]
