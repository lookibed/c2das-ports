    while (oldsize < f.sizelocvars) {
        let _t0 = oldsize
        oldsize++
        deref(f.locvars + _t0).varname = null
    }
    deref(f.locvars + int(fs.ndebugvars)).varname = varname
    deref(f.locvars + int(fs.ndebugvars)).startpc = fs.pc
