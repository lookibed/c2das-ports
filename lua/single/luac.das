[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<lua_Debug>) == 136 && typeinfo alignof(type<lua_Debug>) == 8, "lua_Debug: clang lays it out as size 136, align 8")
    static_assert(typeinfo offsetof < event > (type<lua_Debug>) == 0, "lua_Debug.event: clang puts it at 0")
    static_assert(typeinfo offsetof < name > (type<lua_Debug>) == 8, "lua_Debug.name: clang puts it at 8")
    static_assert(typeinfo offsetof < namewhat > (type<lua_Debug>) == 16, "lua_Debug.namewhat: clang puts it at 16")
    static_assert(typeinfo offsetof < what > (type<lua_Debug>) == 24, "lua_Debug.what: clang puts it at 24")
    static_assert(typeinfo offsetof < source > (type<lua_Debug>) == 32, "lua_Debug.source: clang puts it at 32")
    static_assert(typeinfo offsetof < srclen > (type<lua_Debug>) == 40, "lua_Debug.srclen: clang puts it at 40")
    static_assert(typeinfo offsetof < currentline > (type<lua_Debug>) == 48, "lua_Debug.currentline: clang puts it at 48")
    static_assert(typeinfo offsetof < linedefined > (type<lua_Debug>) == 52, "lua_Debug.linedefined: clang puts it at 52")
    static_assert(typeinfo offsetof < lastlinedefined > (type<lua_Debug>) == 56, "lua_Debug.lastlinedefined: clang puts it at 56")
    static_assert(typeinfo offsetof < nups > (type<lua_Debug>) == 60, "lua_Debug.nups: clang puts it at 60")
    static_assert(typeinfo offsetof < nparams > (type<lua_Debug>) == 61, "lua_Debug.nparams: clang puts it at 61")
    static_assert(typeinfo offsetof < isvararg > (type<lua_Debug>) == 62, "lua_Debug.isvararg: clang puts it at 62")
    static_assert(typeinfo offsetof < istailcall > (type<lua_Debug>) == 63, "lua_Debug.istailcall: clang puts it at 63")
    static_assert(typeinfo offsetof < ftransfer > (type<lua_Debug>) == 64, "lua_Debug.ftransfer: clang puts it at 64")
    static_assert(typeinfo offsetof < ntransfer > (type<lua_Debug>) == 66, "lua_Debug.ntransfer: clang puts it at 66")
    static_assert(typeinfo offsetof < short_src > (type<lua_Debug>) == 68, "lua_Debug.short_src: clang puts it at 68")
    static_assert(typeinfo offsetof < i_ci > (type<lua_Debug>) == 128, "lua_Debug.i_ci: clang puts it at 128")
    static_assert(typeinfo sizeof(type<Value>) == 8 && typeinfo alignof(type<Value>) == 8, "Value: clang lays it out as size 8, align 8")
    static_assert(typeinfo offsetof < _storage > (type<Value>) == 0, "Value: every member sits at 0")
    static_assert(typeinfo sizeof(type<TValue>) == 16 && typeinfo alignof(type<TValue>) == 8, "TValue: clang lays it out as size 16, align 8")
    static_assert(typeinfo offsetof < value_ > (type<TValue>) == 0, "TValue.value_: clang puts it at 0")
    static_assert(typeinfo offsetof < tt_ > (type<TValue>) == 8, "TValue.tt_: clang puts it at 8")
