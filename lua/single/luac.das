        // update pending gotos to enclosing block
        movegotosout(fs, bl)
    } else {
        // still pending gotos?
        if (bl.firstgoto < ls.dyd.gt.n) {
            // error
            undefgoto(ls, addr(deref(ls.dyd.gt.arr + bl.firstgoto)))
        }
    }
