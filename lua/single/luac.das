[variadic]
def luaO_pushfstring(var L : lua_State?; var fmt : uint8?; va : va_args) : uint8? {
    var msg : uint8?
    var argp : CVaCursor
    argp = va_begin(va)
    msg = luaO_pushvfstring(L, fmt, argp)
    return msg
