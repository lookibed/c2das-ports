    } elif (_cond == 7) {
        return uint64(addr(reinterpret<GCUnion?>(o.value_.gc).u).len)
    } elif (_cond == 5) {
        return luaH_getn(addr(reinterpret<GCUnion?>(o.value_.gc).h))
    } else {
