        var _t0 : int
        if (!(int(t.tt_) == (5 | 0 << 4 | 1 << 6))) {
            slot = null
            _t0 = 0
        } else {
            slot = luaH_get(addr(reinterpret<GCUnion?>(t.value_.gc).h), key)
            _t0 = !((int(slot.tt_) & 15) == 0) ? 1 : 0
        }
        if (_t0 != 0) {
