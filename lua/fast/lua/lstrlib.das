[unsafe_deref, hint(unsafe_range_check)]
def private check_capture(var ms : MatchState?; var l : int) : int {
    l -= '1'
    if (l < 0 || l >= int(ms.level) || ms._c_capture[l].len == int64(CAP_UNFINISHED)) {
        return luaL_error`va(ms.L, cstr("invalid capture index %%%d"), (l + 1,))
    }
    return l
}

[unsafe_deref, hint(unsafe_range_check)]
def private capture_to_close(var ms : MatchState?) : int {
    var level : int = int(ms.level)
    level--
    while (level >= 0) {
        if (ms._c_capture[level].len == int64(CAP_UNFINISHED)) {
            return level
        }
        level--
    }
    return luaL_error`va(ms.L, cstr("invalid pattern capture"), VaNone())
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private classend(var ms : MatchState?; var p : uint8?) : uint8? {
    var _t0 = p
    p++
    c_switch(int(*_t0)) {
        case('%') {
            if (p == ms.p_end) {
                luaL_error`va(ms.L, cstr("malformed pattern (ends with '%%')"), VaNone())
            }
            return p + 1
        }
        case('[') {
            if (*p == '^') {
                p++
            }
            // look for a ']'
            c_do_while(*p != ']') {
                if (p == ms.p_end) {
                    luaL_error`va(ms.L, cstr("malformed pattern (missing ']')"), VaNone())
                }
                var _t1 = p
                p++
                if (int(*_t1) == L_ESC && reinterpret<uint64>(p) < reinterpret<uint64>(ms.p_end)) {
                    // skip escapes (e.g. '%]')
                    p++
                }
            }
            return p + 1
        }
        case(_) {
            return p
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private match_class(c : int; cl : int) : int {
    var res : int
    c_switch(crt::tolower(cl)) {
        case('a') {
            res = crt::isalpha(c)
            break
        }
        case('c') {
            res = crt::iscntrl(c)
            break
        }
        case('d') {
            res = crt::isdigit(c)
            break
        }
        case('g') {
            res = crt::isgraph(c)
            break
        }
        case('l') {
            res = crt::islower(c)
            break
        }
        case('p') {
            res = crt::ispunct(c)
            break
        }
        case('s') {
            res = crt::isspace(c)
            break
        }
        case('u') {
            res = crt::isupper(c)
            break
        }
        case('w') {
            res = crt::isalnum(c)
            break
        }
        case('x') {
            res = crt::isxdigit(c)
            break
        }
        case('z') {
            // deprecated option
            res = int_of(c == 0)
            break
        }
        case(_) {
            return int_of(cl == c)
        }
    }
    return crt::islower(cl) != 0 ? res : int_of(res == 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private matchbracketclass(c : int; var p : uint8?; var ec : uint8?) : int {
    var sig : int = 1
    if (p[1] == '^') {
        sig = 0
        // skip the '^'
        p++
    }
    while (true) {
        p++
        if (!(reinterpret<uint64>(p) < reinterpret<uint64>(ec))) {
            break
        }
        if (int(*p) == L_ESC) {
            p++
            if (match_class(c, int(*p)) != 0) {
                return sig
            }
        } elif ((p[1] == '-') && (reinterpret<uint64>(p + 2) < reinterpret<uint64>(ec))) {
            p += 2
            if (int(*(p - 2)) <= c && c <= int(*p)) {
                return sig
            }
        } elif (int(*p) == c) {
            return sig
        }
    }
    return int_of(sig == 0)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private singlematch(var ms : MatchState?; var s : uint8?; var p : uint8?; var ep : uint8?) : int {
