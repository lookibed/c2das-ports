    }
    luaL_pushresult(addr(b))
    return 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private str_packsize(var L : lua_State?) : int {
    var h : Header
    // format string
    var fmt : uint8? = luaL_checkstring(L, 1)
    // accumulate total size of result
    var totalsize : uint64 = 0ul
    initheader(L, addr(h))
    while (*fmt != '\0') {
        var size : int
        var ntoalign : int
        let opt : KOption = getdetails(addr(h), totalsize, addr(fmt), addr(size), addr(ntoalign))
        let _t0 = opt != KOption.Kstring && opt != KOption.Kzstr || luaL_argerror(L, 1, cstr("variable-length format")) != 0
        // total space used by option
        size += ntoalign
        let _t1 = totalsize <= (uint64(typeinfo sizeof(type<uint64>)) < uint64(typeinfo sizeof(type<int>)) ? MAX_SIZET :
                    2147483647ul) - uint64(size) || luaL_argerror(L,
                1, cstr("format result too large")) != 0
        totalsize += uint64(size)
    }
    lua_pushinteger(L, int64(totalsize))
    return 1
}

// Unpack an integer with 'size' bytes and 'islittle' endianness.
// If size is smaller than the size of a Lua integer and integer
// is signed, must do sign extension (propagating the sign to the
// higher bits); if size is larger than the size of a Lua integer,
// it must check the unread bytes to see whether they do not cause an
// overflow.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private unpackint(var L : lua_State?; var str : uint8?; islittle : int; size : int; issigned : int) : int64 {
    var res : uint64 = 0ul
    var i : int
    let limit : int = (size <= SZINT) ? size : SZINT
    i = limit - 1
    while (i >= 0) {
        res <<= 8ul
        res |= uint64(str[islittle != 0 ? i : size - 1 - i])
        i--
    }
    // real size smaller than lua_Integer?
    if (size < SZINT) {
        // needs sign extension?
        if (issigned != 0) {
            let mask : uint64 = 1ul << uint64(size * 8 - 1)
            // do sign extension
            res = (res ^ mask) - mask
        }
    } elif (size > SZINT) {
        // must check unread bytes
        let mask : int = (issigned == 0 || int64(res) >= 0l) ? 0 : MC
        for (i1 in range(limit, size)) {
            if (int(str[islittle != 0 ? i1 : size - 1 - i1]) != mask) {
                luaL_error`va(L, cstr("%d-byte integer does not fit into Lua Integer"), (size,))
            }
        }
    }
    return int64(res)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private str_unpack(var L : lua_State?) : int {
    var h : Header
    var fmt : uint8? = luaL_checkstring(L, 1)
    var ld : uint64
    var data : uint8? = luaL_checklstring(L, 2, addr(ld))
    var pos : uint64 = posrelatI(luaL_optinteger(L, 3, 1l), ld) - 1ul
    // number of results
    var n : int = 0
    let _t0 = pos <= ld || luaL_argerror(L, 3, cstr("initial position out of string")) != 0
    initheader(L, addr(h))
    while (*fmt != '\0') {
        var size : int
        var ntoalign : int
        let opt : KOption = getdetails(addr(h), pos, addr(fmt), addr(size), addr(ntoalign))
        let _t1 = uint64(ntoalign) + uint64(size) <= ld - pos || luaL_argerror(L, 2, cstr("data string too short")) != 0
        // skip alignment
        pos += uint64(ntoalign)
        // stack space for item + next position
        luaL_checkstack(L, 2, cstr("too many results"))
        n++
        c_switch(opt) {
            case(KOption.Kint, KOption.Kuint) {
                {
                    let res : int64 = unpackint(L, data + pos, h.islittle, size, int_of(opt == KOption.Kint))
                    lua_pushinteger(L, res)
                    break
                }
            }
            case(KOption.Kfloat) {
                {
                    var f : float
                    copywithendian(reinterpret<uint8?>(addr(f)), data + pos, typeinfo sizeof(type<float>), h.islittle)
                    lua_pushnumber(L, double(f))
                    break
                }
            }
            case(KOption.Knumber) {
                {
                    var f : double
                    copywithendian(reinterpret<uint8?>(addr(f)), data + pos, typeinfo sizeof(type<double>), h.islittle)
                    lua_pushnumber(L, f)
                    break
                }
            }
            case(KOption.Kdouble) {
                {
                    var f : double
                    copywithendian(reinterpret<uint8?>(addr(f)), data + pos, typeinfo sizeof(type<double>), h.islittle)
                    lua_pushnumber(L, f)
                    break
                }
            }
            case(KOption.Kchar) {
                lua_pushlstring(L, data + pos, uint64(size))
                break
            }
            case(KOption.Kstring) {
                {
                    let len : uint64 = uint64(unpackint(L, data + pos, h.islittle, size, 0))
                    let _t2 = len <= ld - pos - uint64(size) || luaL_argerror(L, 2, cstr("data string too short")) != 0
                    lua_pushlstring(L, data + pos + size, len)
                    // skip string
                    pos += len
                    break
                }
            }
            case(KOption.Kzstr) {
                {
                    let len : uint64 = crt::strlen(data + pos)
                    let _t3 = pos + len < ld || luaL_argerror(L, 2, cstr("unfinished string for format 'z'")) != 0
                    lua_pushlstring(L, data + pos, len)
                    // skip string plus final '\0'
                    pos += len + 1ul
                    break
                }
            }
            case(KOption.Kpaddalign, KOption.Kpadding, KOption.Knop) {
                // undo increment
                n--
                break
            }
        }
        pos += uint64(size)
    }
    // next position
    lua_pushinteger(L, int64(pos + 1ul))
    return n + 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private createmetatable(var L : lua_State?) {
    // table to be metatable for strings
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[10]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(stringmetamethods[0]), 0)
    // dummy string
    lua_pushstring(L, addr(c2das_empty[0]))
    // copy table
    lua_pushvalue(L, -2)
    // set table as metatable for strings
    lua_setmetatable(L, -2)
    // pop dummy string
    lua_pop(L, 1)
    // get string library
    lua_pushvalue(L, -2)
    // metatable.__index = string
    lua_setfield(L, -2, cstr("__index"))
    // pop metatable
    lua_pop(L, 1)
}

// Open string library
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaopen_string(var L : lua_State?) : int {
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[18]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(strlib[0]), 0)
    createmetatable(L)
    return 1
}

