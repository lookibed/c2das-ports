    } elif (l + lsep < l || l + lsep > (uint64(typeinfo sizeof(type<uint64>)) < uint64(typeinfo sizeof(type<int>)) ? MAX_SIZET : 2147483647ul) / uint64(n)) {
        return luaL_error`va(L, cstr("resulting string too large"), VaNone())
    } else {
        let totallen : uint64 = uint64(n) * l + uint64(n - 1l) * lsep
        var b : luaL_Buffer
        var p : uint8? = luaL_buffinitsize(L, addr(b), totallen)
        // first n-1 copies (followed by separator)
        while (true) {
            let _t0 = n
            n--
            if (!(_t0 > 1l)) {
                break
            }
            crt::memcpy(reinterpret<void?>(p), reinterpret<void?>(s), l * uint64(typeinfo sizeof(type<uint8>)))
            p += l
            // empty 'memcpy' is not that cheap
            if (lsep > 0ul) {
                crt::memcpy(reinterpret<void?>(p), reinterpret<void?>(sep), lsep * uint64(typeinfo sizeof(type<uint8>)))
                p += lsep
            }
        }
        // last copy (not followed by separator)
        crt::memcpy(reinterpret<void?>(p), reinterpret<void?>(s), l * uint64(typeinfo sizeof(type<uint8>)))
        luaL_pushresultsize(addr(b), totallen)
    }
    return 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private str_byte(var L : lua_State?) : int {
    var l : uint64
    var s : uint8? = luaL_checklstring(L, 1, addr(l))
    let pi : int64 = luaL_optinteger(L, 2, 1l)
    let posi : uint64 = posrelatI(pi, l)
    let pose : uint64 = getendpos(L, 3, pi, l)
    var n : int
    // empty interval; return no values
    if (posi > pose) {
        return 0
    }
    // arithmetic overflow?
    if (pose - posi >= 2147483647ul) {
        return luaL_error`va(L, cstr("string slice too long"), VaNone())
    }
    n = int(pose - posi) + 1
    luaL_checkstack(L, n, cstr("string slice too long"))
    for (i in range(n)) {
        lua_pushinteger(L, int64(s[posi + uint64(i) - 1ul]))
    }
    return n
}

