[c_function, unsafe_deref, hint(unsafe_range_check)]
def private tonum(var L : lua_State?; arg : int) : int {
    // already a number?
    if (lua_type(L, arg) == LUA_TNUMBER) {
        lua_pushvalue(L, arg)
        return 1
    } else {
        // check whether it is a numerical string
        var len : uint64
        var s : uint8? = lua_tolstring(L, arg, addr(len))
        return int_of(s != null && lua_stringtonumber(L, s) == len + 1ul)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private trymt(var L : lua_State?; var mtname : uint8?) {
    // back to the original arguments
    lua_settop(L, 2)
    if (lua_type(L, 2) == LUA_TSTRING || luaL_getmetafield(L, 2, mtname) == 0) {
        luaL_error`va(L, cstr("attempt to %s a '%s' with a '%s'"), (mtname + 2, luaL_typename(L, -2), luaL_typename(L, -1)))
    }
    // put metamethod before arguments
    lua_insert(L, -3)
    // call metamethod
    lua_call(L, 2, 1)
}

[unsafe_deref, hint(unsafe_range_check)]
def private arith(var L : lua_State?; op : int; var mtname : uint8?) : int {
    if (tonum(L, 1) != 0 && tonum(L, 2) != 0) {
        // result will be on the top
        lua_arith(L, op)
    } else {
        trymt(L, mtname)
    }
    return 1
}

