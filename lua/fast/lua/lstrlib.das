                let _t13 = addr(b).n < addr(b).size || luaL_prepbuffsize(addr(b), 1ul) != null
                let _t14 = addr(b).n
                addr(b).n++
                addr(b).b[_t14] = uint8(LUAL_PACKPADBYTE)
