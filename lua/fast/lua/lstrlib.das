// translate a relative initial string position
// (negative means back from end): clip result to [1, inf).
// The length of any string in Lua must fit in a lua_Integer,
// so there are no overflows in the casts.
// The inverted comparison avoids a possible overflow
// computing '-pos'.
[unsafe_deref, hint(unsafe_range_check)]
def private posrelatI(pos : int64; len : uint64) : uint64 {
    if (pos > 0l) {
        return uint64(pos)
    } elif (pos == 0l) {
        return 1ul
    } elif (pos < -int64(len)) {
        // inverted comparison
        // clip to 1
        return 1ul
    } else {
        return len + uint64(pos) + 1ul
    }
}

// Gets an optional ending string position from argument 'arg',
// with default value 'def'.
// Negative means back from end: clip result to [0, len]
[unsafe_deref, hint(unsafe_range_check)]
def private getendpos(var L : lua_State?; arg : int; _c_def : int64; len : uint64) : uint64 {
    let pos : int64 = luaL_optinteger(L, arg, _c_def)
    if (pos > int64(len)) {
        return len
    } elif (pos >= 0l) {
        return uint64(pos)
    } elif (pos < -int64(len)) {
        return 0ul
    } else {
        return len + uint64(pos) + 1ul
    }
}

