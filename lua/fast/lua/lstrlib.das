            }
            case(KOption.Kchar) {
                {
                    // fixed-size string
                    var len : uint64
                    var s : uint8? = luaL_checklstring(L, arg, addr(len))
                    let _t5 = len <= uint64(size) || luaL_argerror(L, arg, cstr("string longer than given size")) != 0
                    // add string
                    luaL_addlstring(addr(b), s, len)
                    // pad extra space
                    while (true) {
