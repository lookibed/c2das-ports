                    let _t9 = size >= typeinfo sizeof(type<uint64>) || len < (1ul << uint64(size * 8)) || luaL_argerror(L, arg,
                            cstr("string length does not fit in given size")) != 0
                    // pack length
                    packint(addr(b), len, h.islittle, size, 0)
                    luaL_addlstring(addr(b), s, len)
                    totalsize += len
