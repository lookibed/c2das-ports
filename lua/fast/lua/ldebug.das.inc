// generated by c2das - regenerate, never edit
var private strlocal : uint8[6] = cstr_array("local", 6)
var private strupval : uint8[8] = cstr_array("upvalue", 8)

[unsafe_deref, hint(unsafe_range_check)]
def private currentpc(var ci : CallInfo?) : int {
    return pcRel(ci.u.l.savedpc, ci_func(ci).p)
}

// Get a "base line" to find the line corresponding to an instruction.
// Base lines are regularly placed at MAXIWTHABS intervals, so usually
// an integer division gets the right place. When the source file has
// large sequences of empty/comment lines, it may need extra entries,
// so the original estimate needs a correction.
// If the original estimate is -1, the initial 'if' ensures that the
// 'while' will run at least once.
// The assertion that the estimate is a lower bound for the correct base
// is valid as long as the debug info has been generated with the same
// value for MAXIWTHABS or smaller. (Previous releases use a little
// smaller value.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getbaseline(var f : Proto?; pc : int; var basepc : int?) : int {
    if (f.sizeabslineinfo == 0 || pc < f.abslineinfo[0].pc) {
        // start from the beginning
        *basepc = -1
        return f.linedefined
    } else {
        // get an estimate
        var i : int = int(uint(pc) / uint(MAXIWTHABS) - 1u)
        // estimate must be a lower bound of the correct base
        while (i + 1 < f.sizeabslineinfo && pc >= f.abslineinfo[i + 1].pc) {
            // low estimate; adjust it
            i++
        }
        *basepc = f.abslineinfo[i].pc
        return f.abslineinfo[i].line
    }
}

// Get the line corresponding to instruction 'pc' in function 'f';
// first gets a base line and from there does the increments until
// the desired instruction.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_getfuncline(var f : Proto?; pc : int) : int {
    // no debug information?
    if (f.lineinfo == null) {
        return -1
    } else {
        var basepc : int
        var baseline : int = getbaseline(f, pc, addr(basepc))
        // walk until given instruction
        while (true) {
            let _t0 = basepc
            basepc++
            if (!(_t0 < pc)) {
                break
            }
            // correct line
            baseline += int(f.lineinfo[basepc])
        }
        return baseline
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private getcurrentline(var ci : CallInfo?) : int {
    return luaG_getfuncline(ci_func(ci).p, currentpc(ci))
}

// Set 'trap' for all active Lua frames.
// This function can be called during a signal, under "reasonable"
// assumptions. A new 'ci' is completely linked in the list before it
// becomes part of the "active" list, and we assume that pointers are
// atomic; see comment in next function.
// (A compiler doing interprocedural optimizations could, theoretically,
// reorder memory writes in such a way that the list could be
// temporarily broken while inserting a new element. We simply assume it
// has no good reasons to do that.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private settraps(var ci : CallInfo?) {
    while (ci != null) {
        if (isLua(ci)) {
            c_volatile_store(ci.u.l.trap, 1)
        }
        ci = ci.previous
    }
}

// This function can be called during a signal, under "reasonable"
// assumptions.
// Fields 'basehookcount' and 'hookcount' (set by 'resethookcount')
// are for debug only, and it is no problem if they get arbitrary
// values (causes at most one wrong hook call). 'hookmask' is an atomic
// value. We assume that pointers are atomic too (e.g., gcc ensures that
// for all platforms where it runs). Moreover, 'hook' is always checked
// before being called (see 'luaD_hook').
[unsafe_deref, hint(unsafe_range_check)]
def lua_sethook(var L : lua_State?; var func : function<(var a0 : lua_State?; var a1 : lua_Debug?) : void>; var mask : int; count : int) {
    // turn off hooks?
    if (func == null || mask == 0) {
        mask = 0
        func = default<function<(var a0 : lua_State?; var a1 : lua_Debug?) : void>>
    }
    c_volatile_store(L.hook, func)
    L.basehookcount = count
    resethookcount(L)
    c_volatile_store(L.hookmask, int(uint8(mask)))
    if (mask != 0) {
        // to trace inside 'luaV_execute'
        settraps(L.ci)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_gethook(var L : lua_State?) : function<(var a0 : lua_State?; var a1 : lua_Debug?) : void> {
    return c_volatile_load(L.hook)
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_gethookmask(var L : lua_State?) : int {
    return c_volatile_load(L.hookmask)
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_gethookcount(var L : lua_State?) : int {
    return L.basehookcount
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_getstack(var L : lua_State?; var level : int; var ar : lua_Debug?) : int {
    var status : int
    var ci : CallInfo?
    // invalid (negative) level
    if (level < 0) {
        return 0
    }
    ci = L.ci
    while (level > 0 && ci != addr(L.base_ci)) {
        level--
        ci = ci.previous
    }
    // level found?
    if (level == 0 && ci != addr(L.base_ci)) {
        status = 1
        ar.i_ci = ci
    } else {
        // no such level
        status = 0
    }
    return status
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private upvalname(var p : Proto?; uv : int) : uint8? {
    var s : TString? = p.upvalues[uv].name
    if (s == null) {
        return cstr("?")
    } else {
        return addr(s.contents[0])
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private findvararg(var ci : CallInfo?; n : int; var pos : StackValue ??) : uint8? {
    if (gco2lcl(s2v(ci.func.p).value_.gc).p.is_vararg != 0) {
        let nextra : int = ci.u.l.nextraargs
        // 'n' is negative
        if (n >= -nextra) {
            *pos = ci.func.p - nextra + -(n + 1)
            // generic name for any vararg
            return cstr("(vararg)")
        }
    }
    // no such vararg
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_findlocal(var L : lua_State?; var ci : CallInfo?; n : int; var pos : StackValue ??) : uint8? {
    var base : StackValue? = ci.func.p + 1
    var name : uint8? = null
    if (isLua(ci)) {
        // access to vararg values?
        if (n < 0) {
            return findvararg(ci, n, pos)
        } else {
            name = luaF_getlocalname(ci_func(ci).p, n, currentpc(ci))
        }
    }
    // no 'standard' name?
    if (name == null) {
        var limit : StackValue? = (ci == L.ci) ? L.top.p : ci.next.func.p
        // is 'n' inside 'ci' stack?
        if (int64(limit - base) >= int64(n) && n > 0) {
            // generic name for any valid slot
            name = isLua(ci) ? cstr("(temporary)") : cstr("(C temporary)")
        } else {
            // no name
            return null
        }
    }
    if (pos != null) {
        *pos = base + (n - 1)
    }
    return name
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_getlocal(var L : lua_State?; var ar : lua_Debug?; n : int) : uint8? {
    var name : uint8?
    // information about non-active function?
    if (ar == null) {
        // not a Lua function?
        if (!isLfunction(s2v(L.top.p - 1))) {
            name = null
        } else {
            // consider live variables at function start (parameters)
            name = luaF_getlocalname(gco2lcl(s2v(L.top.p - 1).value_.gc).p, n, 0)
        }
    } else {
        // active function; get information through 'ar'
        // to avoid warnings
        var pos : StackValue? = null
        name = luaG_findlocal(L, ar.i_ci, n, addr(pos))
        if (name != null) {
            {
                var io1 : TValue? = s2v(L.top.p)
                var io2 : TValue? = s2v(pos)
                io1.value_ = io2.value_
                io1.tt_ = io2.tt_
            }
            api_incr_top(L)
        }
    }
    return name
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_setlocal(var L : lua_State?; var ar : lua_Debug?; n : int) : uint8? {
    // to avoid warnings
    var pos : StackValue? = null
    var name : uint8?
    name = luaG_findlocal(L, ar.i_ci, n, addr(pos))
    if (name != null) {
        {
            var io1 : TValue? = s2v(pos)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        // pop value
        L.top.p--
    }
    return name
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private funcinfo(var ar : lua_Debug?; var cl : Closure?) {
    if (!LuaClosure(cl)) {
        ar.source = cstr("=[C]")
        ar.srclen = uint64(typeinfo sizeof(type<uint8[5]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul
        ar.linedefined = -1
        ar.lastlinedefined = -1
        ar.what = cstr("C")
    } else {
        var p : Proto? = cl.l.p
        if (p.source != null) {
            ar.source = addr(p.source.contents[0])
            ar.srclen = p.source.shrlen != 255 ? uint64(p.source.shrlen) : p.source.u.lnglen
        } else {
            ar.source = cstr("=?")
            ar.srclen = uint64(typeinfo sizeof(type<uint8[3]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul
        }
        ar.linedefined = p.linedefined
        ar.lastlinedefined = p.lastlinedefined
        ar.what = (ar.linedefined == 0) ? cstr("main") : cstr("Lua")
    }
    luaO_chunkid(addr(ar.short_src[0]), ar.source, ar.srclen)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private nextline(var p : Proto?; currentline : int; pc : int) : int {
    if (int(p.lineinfo[pc]) != ABSLINEINFO) {
        return currentline + int(p.lineinfo[pc])
    } else {
        return luaG_getfuncline(p, pc)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private collectvalidlines(var L : lua_State?; var f : Closure?) {
    if (!LuaClosure(f)) {
        setnilvalue(s2v(L.top.p))
        api_incr_top(L)
    } else {
        var p : Proto? = f.l.p
        var currentline : int = p.linedefined
        // new table to store active lines
        var t : Table? = luaH_new(L)
        {
            // push it on stack
            var io : TValue? = s2v(L.top.p)
            var x_ : Table? = t
            io.value_.gc = obj2gco(x_)
            settt_(io, ctb(LUA_TTABLE | (0 << 4)))
        }
        api_incr_top(L)
        // proto with debug information?
        if (p.lineinfo != null) {
            var i : int
            var v : TValue
            // boolean 'true' to be the value of all indices
            setbtvalue(addr(v))
            // regular function?
            if (p.is_vararg == 0) {
                // consider all instructions
                i = 0
            } else {
                // vararg function
                currentline = nextline(p, currentline, 0)
                // skip first instruction (OP_VARARGPREP)
                i = 1
            }
            // for each instruction
            while (i < p.sizelineinfo) {
                // get its line
                currentline = nextline(p, currentline, i)
                // table[line] = true
                luaH_setint(L, t, int64(currentline), addr(v))
                i++
            }
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getfuncname(var L : lua_State?; var ci : CallInfo?; var name : uint8 ??) : uint8? {
    // calling function is a known function?
    if (ci != null && (int(ci.callstatus) & CIST_TAIL) == 0) {
        return funcnamefromcall(L, ci.previous, name)
    } else {
        // no way to find a name
        return null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private auxgetinfo(var L : lua_State?; var what : uint8?; var ar : lua_Debug?; var f : Closure?; var ci : CallInfo?) : int {
    var status : int = 1
    while (*what != 0) {
        c_switch(int(*what)) {
            case('S') {
                funcinfo(ar, f)
                break
            }
            case('l') {
                ar.currentline = (ci != null && isLua(ci)) ? getcurrentline(ci) : -1
                break
            }
            case('u') {
                ar.nups = uint8((f == null) ? 0 : int(f.c.nupvalues))
                if (!LuaClosure(f)) {
                    ar.isvararg = 1u8
                    ar.nparams = 0u8
                } else {
                    ar.isvararg = f.l.p.is_vararg
                    ar.nparams = f.l.p.numparams
                }
                break
            }
            case('t') {
                ar.istailcall = uint8(ci != null ? int(ci.callstatus) & CIST_TAIL : 0)
                break
            }
            case('n') {
                ar.namewhat = getfuncname(L, ci, addr(ar.name))
                if (ar.namewhat == null) {
                    // not found
                    ar.namewhat = addr(c2das_empty[0])
                    ar.name = null
                }
                break
            }
            case('r') {
                if (ci == null || (int(ci.callstatus) & CIST_TRAN) == 0) {
                    ar.ntransfer = uint16(0)
                    ar.ftransfer = ar.ntransfer
                } else {
                    ar.ftransfer = ci.u2.transferinfo.ftransfer
                    ar.ntransfer = ci.u2.transferinfo.ntransfer
                }
                break
            }
            case('L', 'f') {
                // handled by lua_getinfo
                break
            }
            case(_) {
                // invalid option
                status = 0
            }
        }
        what++
    }
    return status
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_getinfo(var L : lua_State?; var what : uint8?; var ar : lua_Debug?) : int {
    var status : int
    var cl : Closure?
    var ci : CallInfo?
    var func : TValue?
    if (*what == '>') {
        ci = null
        func = s2v(L.top.p - 1)
        // skip the '>'
        what++
        // pop function
        L.top.p--
    } else {
        ci = ar.i_ci
        func = s2v(ci.func.p)
    }
    cl = ttisclosure(func) ? addr(reinterpret<GCUnion?>(func.value_.gc).cl) : null
    status = auxgetinfo(L, what, ar, cl, ci)
    if (crt::strchr(what, 'f') != null) {
        {
            var io1 : TValue? = s2v(L.top.p)
            var io2 : TValue? = func
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        api_incr_top(L)
    }
    if (crt::strchr(what, 'L') != null) {
        collectvalidlines(L, cl)
    }
    return status
}

[unsafe_deref, hint(unsafe_range_check)]
def private filterpc(pc : int; jmptarget : int) : int {
    // is code conditional (inside a jump)?
    if (pc < jmptarget) {
        // cannot know who sets that register
        return -1
    } else {
        // current position sets that register
        return pc
    }
}

// Try to find last instruction before 'lastpc' that modified register 'reg'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private findsetreg(var p : Proto?; var lastpc : int; reg : int) : int {
    // keep last instruction that changed 'reg'
    var setreg : int = -1
    // any code before this address is conditional
    var jmptarget : int = 0
    if (testMMMode(GET_OPCODE(p.code[lastpc])) != 0) {
        // previous instruction was not actually executed
        lastpc--
    }
    for (pc in range(lastpc)) {
        let i : uint = p.code[pc]
        let op : OpCode = GET_OPCODE(i)
        let a : int = GETARG_A(i)
        // true if current instruction changed 'reg'
        var change : int
        c_switch(op) {
            case(OpCode.OP_LOADNIL) {
                {
                    // set registers from 'a' to 'a+b'
                    let b : int = GETARG_B(i)
                    change = int_of(a <= reg && reg <= a + b)
                    break
                }
            }
            case(OpCode.OP_TFORCALL) {
                // affect all regs above its base
                change = int_of(reg >= a + 2)
                break
            }
            case(OpCode.OP_CALL, OpCode.OP_TAILCALL) {
                // affect all registers above base
                change = int_of(reg >= a)
                break
            }
            case(OpCode.OP_JMP) {
                {
                    // doesn't change registers, but changes 'jmptarget'
                    let b : int = GETARG_sJ(i)
                    let dest : int = pc + 1 + b
                    // jump does not skip 'lastpc' and is larger than current one?
                    if (dest <= lastpc && dest > jmptarget) {
                        // update 'jmptarget'
                        jmptarget = dest
                    }
                    change = 0
                    break
                }
            }
            case(_) {
                // any instruction that sets A
                change = int_of(testAMode(op) != 0 && reg == a)
                break
            }
        }
        if (change != 0) {
            setreg = filterpc(pc, jmptarget)
        }
    }
    return setreg
}

// Find a "name" for the constant 'c'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private kname(var p : Proto?; index : int; var name : uint8 ??) : uint8? {
    var kvalue : TValue? = addr(p.k[index])
    if (ttisstring(kvalue)) {
        *name = addr(tsvalue(kvalue).contents[0])
        return cstr("constant")
    } else {
        *name = cstr("?")
        return null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private basicgetobjname(var p : Proto?; var ppc : int?; reg : int; var name : uint8 ??) : uint8? {
    var pc : int = *ppc
    *name = luaF_getlocalname(p, reg + 1, pc)
    // is a local?
    if (*name != null) {
        return addr(strlocal[0])
    }
    // else try symbolic execution
    pc = findsetreg(p, pc, reg)
    *ppc = pc
    // could find instruction?
    if (pc != -1) {
        let i : uint = p.code[pc]
        let op : OpCode = GET_OPCODE(i)
        c_switch(op) {
            case(OpCode.OP_MOVE) {
                {
                    // move from 'b' to 'a'
                    let b : int = GETARG_B(i)
                    if (b < GETARG_A(i)) {
                        // get name for 'b'
                        return basicgetobjname(p, ppc, b, name)
                    }
                    break
                }
            }
            case(OpCode.OP_GETUPVAL) {
                *name = upvalname(p, GETARG_B(i))
                return addr(strupval[0])
            }
            case(OpCode.OP_LOADK) {
                return kname(p, GETARG_Bx(i), name)
            }
            case(OpCode.OP_LOADKX) {
                return kname(p, GETARG_Ax(p.code[pc + 1]), name)
            }
            case(_) {
                break
            }
        }
    }
    // could not find reasonable name
    return null
}

// Find a "name" for the register 'c'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private rname(var p : Proto?; var pc : int; c : int; var name : uint8 ??) {
    // search for 'c'
    var what : uint8? = basicgetobjname(p, addr(pc), c, name)
    // did not find a constant name?
    if (!(what != null && *what == 'c')) {
        *name = cstr("?")
    }
}

// Find a "name" for a 'C' value in an RK instruction.
[unsafe_deref, hint(unsafe_range_check)]
def private rkname(var p : Proto?; pc : int; i : uint; var name : uint8 ??) {
    // key index
    let c : int = GETARG_C(i)
    // is 'c' a constant?
    if (((i >> uint(POS_k)) & (~(~0u << 1u) << 0u)) != 0) {
        kname(p, c, name)
    } else {
        // 'c' is a register
        rname(p, pc, c, name)
    }
}

// Check whether table being indexed by instruction 'i' is the
// environment '_ENV'. If the table is an upvalue, get its name;
// otherwise, find some "name" for the table and check whether
// that name is the name of a local variable (and not, for instance,
// a string). Then check that, if there is a name, it is '_ENV'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private isEnv(var p : Proto?; var pc : int; i : uint; isup : int) : uint8? {
    // table index
    let t : int = GETARG_B(i)
    // name of indexed variable
    var name : uint8?
    // is 't' an upvalue?
    if (isup != 0) {
        name = upvalname(p, t)
    } else {
        // 't' is a register
        var what : uint8? = basicgetobjname(p, addr(pc), t, addr(name))
        if (what != addr(strlocal[0]) && what != addr(strupval[0])) {
            // cannot be the variable _ENV
            name = null
        }
    }
    return (name != null && crt::strcmp(name, cstr("_ENV")) == 0) ? cstr("global") : cstr("field")
}

// Extend 'basicgetobjname' to handle table accesses
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getobjname(var p : Proto?; var lastpc : int; reg : int; var name : uint8 ??) : uint8? {
    var kind : uint8? = basicgetobjname(p, addr(lastpc), reg, name)
    if (kind != null) {
        return kind
    } elif (lastpc != -1) {
        // could find instruction?
        let i : uint = p.code[lastpc]
        let op : OpCode = GET_OPCODE(i)
        c_switch(op) {
            case(OpCode.OP_GETTABUP) {
                {
                    // key index
                    let k : int = GETARG_C(i)
                    kname(p, k, name)
                    return isEnv(p, lastpc, i, 1)
                }
            }
            case(OpCode.OP_GETTABLE) {
                {
                    // key index
                    let k : int = GETARG_C(i)
                    rname(p, lastpc, k, name)
                    return isEnv(p, lastpc, i, 0)
                }
            }
            case(OpCode.OP_GETI) {
                *name = cstr("integer index")
                return cstr("field")
            }
            case(OpCode.OP_GETFIELD) {
                {
                    // key index
                    let k : int = GETARG_C(i)
                    kname(p, k, name)
                    return isEnv(p, lastpc, i, 0)
                }
            }
            case(OpCode.OP_SELF) {
                rkname(p, lastpc, i, name)
                return cstr("method")
            }
            case(_) {
                // go through to return NULL
                break
            }
        }
    }
    // could not find reasonable name
    return null
}

// Try to find a name for a function based on the code that called it.
// (Only works when function was called by a Lua function.)
// Returns what the name is (e.g., "for iterator", "method",
// "metamethod") and sets '*name' to point to the name.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private funcnamefromcode(var L : lua_State?; var p : Proto?; pc : int; var name : uint8 ??) : uint8? {
    // (initial value avoids warnings)
    var tm : TMS = TMS.TM_INDEX
    // calling instruction
    let i : uint = p.code[pc]
    c_switch(GET_OPCODE(i)) {
        case(OpCode.OP_CALL, OpCode.OP_TAILCALL) {
            // get function name
            return getobjname(p, pc, GETARG_A(i), name)
        }
        case(OpCode.OP_TFORCALL) {
            // for iterator
            *name = cstr("for iterator")
            return cstr("for iterator")
        }
        case(OpCode.OP_SELF, OpCode.OP_GETTABUP, OpCode.OP_GETTABLE, OpCode.OP_GETI, OpCode.OP_GETFIELD) {
            // other instructions can do calls through metamethods
            tm = TMS.TM_INDEX
            break
        }
        case(OpCode.OP_SETTABUP, OpCode.OP_SETTABLE, OpCode.OP_SETI, OpCode.OP_SETFIELD) {
            tm = TMS.TM_NEWINDEX
            break
        }
        case(OpCode.OP_MMBIN, OpCode.OP_MMBINI, OpCode.OP_MMBINK) {
            tm = enum_from_int(type<TMS>, GETARG_C(i))
            break
        }
        case(OpCode.OP_UNM) {
            tm = TMS.TM_UNM
            break
        }
        case(OpCode.OP_BNOT) {
            tm = TMS.TM_BNOT
            break
        }
        case(OpCode.OP_LEN) {
            tm = TMS.TM_LEN
            break
        }
        case(OpCode.OP_CONCAT) {
            tm = TMS.TM_CONCAT
            break
        }
        case(OpCode.OP_EQ) {
            tm = TMS.TM_EQ
            break
        }
        case(OpCode.OP_LT, OpCode.OP_LTI, OpCode.OP_GTI) {
            // no cases for OP_EQI and OP_EQK, as they don't call metamethods
            tm = TMS.TM_LT
            break
        }
        case(OpCode.OP_LE, OpCode.OP_LEI, OpCode.OP_GEI) {
            tm = TMS.TM_LE
            break
        }
        case(OpCode.OP_CLOSE, OpCode.OP_RETURN) {
            tm = TMS.TM_CLOSE
            break
        }
        case(_) {
            // cannot find a reasonable name
            return null
        }
    }
    *name = addr(G(L).tmname[int(tm)].contents[0]) + 2
    return cstr("metamethod")
}

// Try to find a name for a function based on how it was called.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private funcnamefromcall(var L : lua_State?; var ci : CallInfo?; var name : uint8 ??) : uint8? {
    // was it called inside a hook?
    if ((int(ci.callstatus) & CIST_HOOKED) != 0) {
        *name = cstr("?")
        return cstr("hook")
    } elif ((int(ci.callstatus) & CIST_FIN) != 0) {
        // was it called as a finalizer?
        *name = cstr("__gc")
        // report it as such
        return cstr("metamethod")
    } elif (isLua(ci)) {
        return funcnamefromcode(L, ci_func(ci).p, currentpc(ci), name)
    } else {
        return null
    }
}

// Check whether pointer 'o' points to some value in the stack frame of
// the current function and, if so, returns its index. Because 'o' may
// not point to a value in this stack, we cannot compare it with the
// region boundaries (undefined behavior in ISO C).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private instack(var ci : CallInfo?; var o : TValue?) : int {
    var pos : int
    var base : StackValue? = ci.func.p + 1
    pos = 0
    while (reinterpret<uint64>(base + pos) < reinterpret<uint64>(ci.top.p)) {
        if (o == reinterpret<TValue?>(s2v(base + pos))) {
            return pos
        }
        pos++
    }
    // not found
    return -1
}

// Checks whether value 'o' came from an upvalue. (That can only happen
// with instructions OP_GETTABUP/OP_SETTABUP, which operate directly on
// upvalues.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getupvalname(var ci : CallInfo?; var o : TValue?; var name : uint8 ??) : uint8? {
    var c : LClosure? = ci_func(ci)
    var i : int
    i = 0
    while (i < int(c.nupvalues)) {
        if (addr(c.upvals[0])[i].v.p == reinterpret<TValue?>(o)) {
            *name = upvalname(c.p, i)
            return addr(strupval[0])
        }
        i++
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private formatvarinfo(var L : lua_State?; var kind : uint8?; var name : uint8?) : uint8? {
    if (kind == null) {
        // no information
        return addr(c2das_empty[0])
    } else {
        return luaO_pushfstring`va(L, cstr(" (%s '%s')"), (kind, name))
    }
}

// Build a string with a "description" for the value 'o', such as
// "variable 'x'" or "upvalue 'y'".
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private varinfo(var L : lua_State?; var o : TValue?) : uint8? {
    var ci : CallInfo? = L.ci
    // to avoid warnings
    var name : uint8? = null
    var kind : uint8? = null
    if (isLua(ci)) {
        // check whether 'o' is an upvalue
        kind = getupvalname(ci, o, addr(name))
        // not an upvalue?
        if (kind == null) {
            // try a register
            let reg : int = instack(ci, o)
            // is 'o' a register?
            if (reg >= 0) {
                kind = getobjname(ci_func(ci).p, currentpc(ci), reg, addr(name))
            }
        }
    }
    return formatvarinfo(L, kind, name)
}

// Raise a type error
[unsafe_deref, hint(unsafe_range_check)]
def private typeerror(var L : lua_State?; var o : TValue?; var op : uint8?; var extra : uint8?) {
    var t : uint8? = luaT_objtypename(L, o)
    luaG_runerror`va(L, cstr("attempt to %s a %s value%s"), (op, t, extra))
}

// Raise a type error with "standard" information about the faulty
// object 'o' (using 'varinfo').
[unsafe_deref, hint(unsafe_range_check)]
def luaG_typeerror(var L : lua_State?; var o : TValue?; var op : uint8?) {
    typeerror(L, o, op, varinfo(L, o))
}

// Raise an error for calling a non-callable object. Try to find a name
// for the object based on how it was called ('funcnamefromcall'); if it
// cannot get a name there, try 'varinfo'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_callerror(var L : lua_State?; var o : TValue?) {
    var ci : CallInfo? = L.ci
    // to avoid warnings
    var name : uint8? = null
    var kind : uint8? = funcnamefromcall(L, ci, addr(name))
    var extra : uint8? = kind != null ? formatvarinfo(L, kind, name) : varinfo(L, o)
    typeerror(L, o, cstr("call"), extra)
}

[unsafe_deref, hint(unsafe_range_check)]
def luaG_forerror(var L : lua_State?; var o : TValue?; var what : uint8?) {
    luaG_runerror`va(L, cstr("bad 'for' %s (number expected, got %s)"), (what, luaT_objtypename(L, o)))
}

[unsafe_deref, hint(unsafe_range_check)]
def luaG_concaterror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    if (ttisstring(p1) || cvt2str(p1)) {
        p1 = p2
    }
    luaG_typeerror(L, p1, cstr("concatenate"))
}

[unsafe_deref, hint(unsafe_range_check)]
def luaG_opinterror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?; var msg : uint8?) {
    // first operand is wrong?
    if (!ttisnumber(p1)) {
        // now second is wrong
        p2 = p1
    }
    luaG_typeerror(L, p2, msg)
}

// Error when both values are convertible to numbers, but not to integers
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_tointerror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    var temp : int64
    if (luaV_tointegerns(p1, addr(temp), F2Imod.F2Ieq) == 0) {
        p2 = p1
    }
    luaG_runerror`va(L, cstr("number%s has no integer representation"), (varinfo(L, p2),))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_ordererror(var L : lua_State?; var p1 : TValue?; var p2 : TValue?) {
    var t1 : uint8? = luaT_objtypename(L, p1)
    var t2 : uint8? = luaT_objtypename(L, p2)
    if (crt::strcmp(t1, t2) == 0) {
        luaG_runerror`va(L, cstr("attempt to compare two %s values"), (t1,))
    } else {
        luaG_runerror`va(L, cstr("attempt to compare %s with %s"), (t1, t2))
    }
}

// add src:line information to 'msg'
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_addinfo(var L : lua_State?; var msg : uint8?; var src : TString?; line : int) : uint8? {
    var buff : uint8[60]
    if (src != null) {
        luaO_chunkid(addr(buff[0]), addr(src.contents[0]), tsslen(src))
    } else {
        // no source available; use "?" instead
        buff[0] = uint8('?')
        buff[1] = uint8('\0')
    }
    return luaO_pushfstring`va(L, cstr("%s:%d: %s"), (addr(buff[0]), line, msg))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_errormsg(var L : lua_State?) {
    // is there an error handling function?
    if (L.errfunc != 0l) {
        var errfunc : StackValue? = restorestack(L, L.errfunc)
        {
            // move argument
            var io1 : TValue? = s2v(L.top.p)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        {
            // push function
            var io1 : TValue? = s2v(L.top.p - 1)
            var io2 : TValue? = s2v(errfunc)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        // assume EXTRA_STACK
        L.top.p++
        // call it
        luaD_callnoyield(L, L.top.p - 2, 1)
    }
    luaD_throw(L, LUA_ERRRUN)
}

[c_function, unsafe_deref, hint(unsafe_range_check), variadic]
def luaG_runerror(var L : lua_State?; var fmt : uint8?; va : va_args) {
    var ci : CallInfo? = L.ci
    var msg : uint8?
    var argp : CVaCursor
    luaC_checkGC(L)
    // error message uses memory
    argp = va_begin(va)
    // format message
    msg = luaO_pushvfstring(L, fmt, argp)
    // if Lua function, add source:line information
    if (isLua(ci)) {
        luaG_addinfo(L, msg, ci_func(ci).p.source, getcurrentline(ci))
        {
            // remove 'msg'
            var io1 : TValue? = s2v(L.top.p - 2)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        L.top.p--
    }
    luaG_errormsg(L)
}

// Check whether new instruction 'newpc' is in a different line from
// previous instruction 'oldpc'. More often than not, 'newpc' is only
// one or a few instructions after 'oldpc' (it must be after, see
// caller), so try to avoid calling 'luaG_getfuncline'. If they are
// too far apart, there is a good chance of a ABSLINEINFO in the way,
// so it goes directly to 'luaG_getfuncline'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private changedline(var p : Proto?; oldpc : int; newpc : int) : int {
    // no debug information?
    if (p.lineinfo == null) {
        return 0
    }
    // not too far apart?
    if (newpc - oldpc < MAXIWTHABS / 2) {
        // line difference
        var delta : int = 0
        var pc : int = oldpc
        while (true) {
            pc++
            let lineinfo : int = int(p.lineinfo[pc])
            if (lineinfo == ABSLINEINFO) {
                // cannot compute delta; fall through
                break
            }
            delta += lineinfo
            if (pc == newpc) {
                // delta computed successfully
                return int_of(delta != 0)
            }
        }
    }
    // either instructions are too far apart or there is an absolute line
    // info in the way; compute line difference explicitly
    return int_of(luaG_getfuncline(p, oldpc) != luaG_getfuncline(p, newpc))
}

// Traces Lua calls. If code is running the first instruction of a function,
// and function is not vararg, and it is not coming from an yield,
// calls 'luaD_hookcall'. (Vararg functions will call 'luaD_hookcall'
// after adjusting its variable arguments; otherwise, they could call
// a line/count hook before the call hook. Functions coming from
// an yield already called 'luaD_hookcall' before yielding.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_tracecall(var L : lua_State?) : int {
    var ci : CallInfo? = L.ci
    var p : Proto? = ci_func(ci).p
    // ensure hooks will be checked
    c_volatile_store(ci.u.l.trap, 1)
    // first instruction (not resuming)?
    if (ci.u.l.savedpc == reinterpret<uint?>(p.code)) {
        if (p.is_vararg != 0) {
            // hooks will start at VARARGPREP instruction
            return 0
        } elif ((int(ci.callstatus) & CIST_HOOKYIELD) == 0) {
            // not yieded?
            // check 'call' hook
            luaD_hookcall(L, ci)
        }
    }
    // keep 'trap' on
    return 1
}

// Traces the execution of a Lua function. Called before the execution
// of each opcode, when debug is on. 'L->oldpc' stores the last
// instruction traced, to detect line changes. When entering a new
// function, 'npci' will be zero and will test as a new line whatever
// the value of 'oldpc'. Some exceptional conditions may return to
// a function without setting 'oldpc'. In that case, 'oldpc' may be
// invalid; if so, use zero as a valid value. (A wrong but valid 'oldpc'
// at most causes an extra call to a line hook.)
// This function is not "Protected" when called, so it should correct
// 'L->top.p' before calling anything that can run the GC.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaG_traceexec(var L : lua_State?; var pc : uint?) : int {
    var ci : CallInfo? = L.ci
    let mask : uint8 = uint8(c_volatile_load(L.hookmask))
    var p : Proto? = ci_func(ci).p
    var counthook : int
    // no hooks?
    if ((int(mask) & (LUA_MASKLINE | LUA_MASKCOUNT)) == 0) {
        // don't need to stop again
        c_volatile_store(ci.u.l.trap, 0)
        // turn off 'trap'
        return 0
    }
    // reference is always next instruction
    pc++
    // save 'pc'
    ci.u.l.savedpc = pc
    var _t0 = (int(mask) & LUA_MASKCOUNT) != 0
    if (_t0) {
        L.hookcount--
        _t0 = L.hookcount == 0
    }
    counthook = int_of(_t0)
    if (counthook != 0) {
        // reset count
        resethookcount(L)
    } elif ((int(mask) & LUA_MASKLINE) == 0) {
        // no line hook and count != 0; nothing to be done now
        return 1
    }
    // hook yielded last time?
    if ((int(ci.callstatus) & CIST_HOOKYIELD) != 0) {
        // erase mark
        ci.callstatus = uint16(int(ci.callstatus) & ~CIST_HOOKYIELD)
        // do not call hook again (VM yielded, so it did not move)
        return 1
    }
    // top not being used?
    if (!(testITMode(GET_OPCODE(*(ci.u.l.savedpc - 1))) != 0 && GETARG_B(*(ci.u.l.savedpc - 1)) == 0)) {
        // correct top
        L.top.p = ci.top.p
    }
    if (counthook != 0) {
        // call count hook
        luaD_hook(L, LUA_HOOKCOUNT, -1, 0, 0)
    }
    if ((int(mask) & LUA_MASKLINE) != 0) {
        // 'L->oldpc' may be invalid; use zero in this case
        let oldpc : int = (L.oldpc < p.sizecode) ? L.oldpc : 0
        let npci : int = pcRel(pc, p)
        // call hook when jump back (loop),
        if (npci <= oldpc || changedline(p, oldpc, npci) != 0) {
            // or when enter new line
            let newline : int = luaG_getfuncline(p, npci)
            // call line hook
            luaD_hook(L, LUA_HOOKLINE, newline, 0, 0)
        }
        // 'pc' of last call to line hook
        L.oldpc = npci
    }
    // did hook yield?
    if (int(L.status) == LUA_YIELD) {
        if (counthook != 0) {
            // undo decrement to zero
            L.hookcount = 1
        }
        // mark that it yielded
        ci.callstatus = uint16(int(ci.callstatus) | CIST_HOOKYIELD)
        luaD_throw(L, LUA_YIELD)
    }
    // keep 'trap' on
    return 1
}

