// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_function
require c_runtime/c_macro
require c_runtime/cstr
require c_runtime/int_of
require c_runtime/variadic
require c_types
require crt
require lapi
require lauxlib
require lauxlib_h
require lobject_h_cluster

var private CLIBS : uint8? = cstr("_CLIBS")
var private pk_funcs : luaL_Reg[8] = fixed_array(luaL_Reg(name = cstr("loadlib"), func = @@ll_loadlib),
        luaL_Reg(name = cstr("searchpath"), func = @@ll_searchpath), luaL_Reg(name = cstr("preload"), func = default<function<(var a0 : lua_State?) : int>>),
        luaL_Reg(name = cstr("cpath"), func = default<function<(var a0 : lua_State?) : int>>),
        luaL_Reg(name = cstr("path"), func = default<function<(var a0 : lua_State?) : int>>),
        luaL_Reg(name = cstr("searchers"), func = default<function<(var a0 : lua_State?) : int>>),
        luaL_Reg(name = cstr("loaded"), func = default<function<(var a0 : lua_State?) : int>>),
        luaL_Reg(name = null, func = default<function<(var a0 : lua_State?) : int>>))
var private ll_funcs : luaL_Reg[2] = fixed_array(luaL_Reg(name = cstr("require"), func = @@ll_require),
        luaL_Reg(name = null, func = default<function<(var a0 : lua_State?) : int>>))
var private createsearcherstable_searchers : function<(var a0 : lua_State?) : int>[5] = fixed_array(@@searcher_preload, @@searcher_Lua, @@searcher_C,
        @@searcher_Croot, default<function<(var a0 : lua_State?) : int>>)

let private LUAI_MAXSTACK = 1000000
let private LUA_REGISTRYINDEX = -LUAI_MAXSTACK - 1000
let private ERRLIB = 1
let private ERRFUNC = 2
let private LUA_OK = 0
let private LUA_TNIL = 0
let private LUA_TTABLE = 5
let private LUA_TFUNCTION = 6
let private LUA_VERSION_NUM = 504
let private LUAL_NUMSIZES = uint64(typeinfo sizeof(type<int64>)) * 16ul + uint64(typeinfo sizeof(type<double>))
let private LUA_RIDX_GLOBALS = 2

// lua.h:376: #define lua_pop(L,n) lua_settop(L, -(n)-1)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_pop(var L; n) {
    lua_settop(L, -n - 1)
}

// lua.h:382: #define lua_pushcfunction(L,f) lua_pushcclosure(L, (f), 0)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_pushcfunction(var L; f) {
    lua_pushcclosure(L, f, 0)
}

// lauxlib.h:139: #define luaL_checkstring(L,n) (luaL_checklstring(L, (n), NULL))
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private luaL_checkstring(var L; n) : uint8? => luaL_checklstring(L, n, null)

// lauxlib.h:166: #define luaL_pushfail(L) lua_pushnil(L)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private luaL_pushfail(var L) {
    lua_pushnil(L)
}

// lua.h:401: #define lua_insert(L,idx) lua_rotate(L, (idx), 1)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_insert(var L; idx) {
    lua_rotate(L, idx, 1)
}

// lauxlib.h:207: #define luaL_addchar(B,c) ((void)((B)->n < (B)->size || luaL_prepbuffsize((B), 1)), ((B)->b[(B)->n++] = (c)))
[c_macro, c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaL_addchar(var B; c) {
    let _t0 = B.n < B.size || luaL_prepbuffsize(B, 1ul) != null
    let _t1 = B.n
    B.n++
    B.b[_t1] = uint8(c)
}

// lua.h:398: #define lua_tostring(L,i) lua_tolstring(L, (i), NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_tostring(var L; i) : uint8? => lua_tolstring(L, i, null)

// lauxlib.h:95: #define luaL_loadfile(L,f) luaL_loadfilex(L,f,NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private luaL_loadfile(var L; var f) => luaL_loadfilex(L, f, null)

// lua.h:294: #define lua_call(L,n,r) lua_callk(L, (n), (r), 0, NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_call(var L; n; r) {
    lua_callk(L, n, r, 0l, default<function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>>)
}

// lua.h:384: #define lua_isfunction(L,n) (lua_type(L, (n)) == LUA_TFUNCTION)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_isfunction(var L; n) => lua_type(L, n) == LUA_TFUNCTION

// lua.h:387: #define lua_isnil(L,n) (lua_type(L, (n)) == LUA_TNIL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_isnil(var L; n) => lua_type(L, n) == LUA_TNIL

// lauxlib.h:47: #define luaL_checkversion(L) luaL_checkversion_(L, LUA_VERSION_NUM, LUAL_NUMSIZES)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private luaL_checkversion(var L) {
    luaL_checkversion_(L, double(LUA_VERSION_NUM), LUAL_NUMSIZES)
}

// lua.h:395: #define lua_pushglobaltable(L) ((void)lua_rawgeti(L, LUA_REGISTRYINDEX, LUA_RIDX_GLOBALS))
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_pushglobaltable(var L) {
    lua_rawgeti(L, LUA_REGISTRYINDEX, int64(LUA_RIDX_GLOBALS))
}

[unsafe_deref, hint(unsafe_range_check)]
def private lsys_unloadlib(var lib : void?) {
    // not used
}

[unsafe_deref, hint(unsafe_range_check)]
def private lsys_load(var L : lua_State?; var path : uint8?; seeglb : int) : void? {
    // not used
    lua_pushstring(L, cstr("dynamic libraries not enabled; check your Lua installation"))
    return null
}

[unsafe_deref, hint(unsafe_range_check)]
def private lsys_sym(var L : lua_State?; var lib : void?; var sym : uint8?) : function<(var a0 : lua_State?) : int> {
    // not used
    lua_pushstring(L, cstr("dynamic libraries not enabled; check your Lua installation"))
    return default<function<(var a0 : lua_State?) : int>>
}

// return registry.LUA_NOENV as a boolean
[unsafe_deref, hint(unsafe_range_check)]
def private noenv(var L : lua_State?) : int {
    var b : int
    lua_getfield(L, LUA_REGISTRYINDEX, cstr("LUA_NOENV"))
    b = lua_toboolean(L, -1)
    // remove value
    lua_pop(L, 1)
    return b
}

// Set a path
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private setpath(var L : lua_State?; var fieldname : uint8?; var envname : uint8?; var dft : uint8?) {
    var dftmark : uint8?
    var nver : uint8? = lua_pushfstring`va(L, cstr("%s%s"), (envname, cstr("_5_4")))
    // try versioned name
    var path : uint8? = crt::getenv(nver)
    // no versioned environment variable?
    if (path == null) {
        // try unversioned name
        path = crt::getenv(envname)
    }
    // no environment variable?
    if (path == null || noenv(L) != 0) {
        // use default
        lua_pushstring(L, dft)
    } else {
        dftmark = crt::strstr(path, cstr(";;"))
        if (dftmark == null) {
            // nothing to change
            lua_pushstring(L, path)
        } else {
            // path contains a ";;": insert default path in its place
            let len : uint64 = crt::strlen(path)
            var b : luaL_Buffer
            luaL_buffinit(L, addr(b))
            // is there a prefix before ';;'?
            if (intptr(path) < intptr(dftmark)) {
                // add it
                luaL_addlstring(addr(b), path, uint64(int64(dftmark - path)))
                let _t0 = addr(b).n < addr(b).size || luaL_prepbuffsize(addr(b), 1ul) != null
                let _t1 = addr(b).n
                addr(b).n++
                addr(b).b[_t1] = *cstr(";")
            }
            // add default
            luaL_addstring(addr(b), dft)
            // is there a suffix after ';;'?
            if (intptr(dftmark) < intptr(path + len + -(2))) {
                let _t2 = addr(b).n < addr(b).size || luaL_prepbuffsize(addr(b), 1ul) != null
                let _t3 = addr(b).n
                addr(b).n++
                addr(b).b[_t3] = *cstr(";")
                luaL_addlstring(addr(b), dftmark + 2, uint64(int64((path + len + -(2)) - dftmark)))
            }
            luaL_pushresult(addr(b))
        }
    }
    // package[fieldname] = path value
    lua_setfield(L, -3, fieldname)
    // pop versioned variable name ('nver')
    lua_pop(L, 1)
}

// return registry.CLIBS[path]
[unsafe_deref, hint(unsafe_range_check)]
def private checkclib(var L : lua_State?; var path : uint8?) : void? {
    var plib : void?
    lua_getfield(L, LUA_REGISTRYINDEX, CLIBS)
    lua_getfield(L, -1, path)
    // plib = CLIBS[path]
    plib = lua_touserdata(L, -1)
    // pop CLIBS table and 'plib'
    lua_pop(L, 2)
    return plib
}

// registry.CLIBS[path] = plib -- for queries
// registry.CLIBS[#CLIBS + 1] = plib -- also keep a list of all libraries
[unsafe_deref, hint(unsafe_range_check)]
def private addtoclib(var L : lua_State?; var path : uint8?; var plib : void?) {
    lua_getfield(L, LUA_REGISTRYINDEX, CLIBS)
    lua_pushlightuserdata(L, plib)
    lua_pushvalue(L, -1)
    // CLIBS[path] = plib
    lua_setfield(L, -3, path)
    // CLIBS[#CLIBS + 1] = plib
    lua_rawseti(L, -2, luaL_len(L, -2) + 1l)
    // pop CLIBS table
    lua_pop(L, 1)
}

// __gc tag method for CLIBS table: calls 'lsys_unloadlib' for all lib
// handles in list CLIBS
[unsafe_deref, hint(unsafe_range_check)]
def private gctm(var L : lua_State?) : int {
    var n : int64 = luaL_len(L, 1)
    // for each handle, in reverse order
    while (n >= 1l) {
        // get handle CLIBS[n]
        lua_rawgeti(L, 1, n)
        lsys_unloadlib(lua_touserdata(L, -1))
        // pop handle
        lua_pop(L, 1)
        n--
    }
    return 0
}

// Look for a C function named 'sym' in a dynamically loaded library
// 'path'.
// First, check whether the library is already loaded; if not, try
// to load it.
// Then, if 'sym' is '*', return true (as library has been loaded).
// Otherwise, look for symbol 'sym' in the library and push a
// C function with that symbol.
// Return 0 and 'true' or a function in the stack; in case of
// errors, return an error code and an error message in the stack.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private lookforfunc(var L : lua_State?; var path : uint8?; var sym : uint8?) : int {
    // check loaded C libraries
    var reg : void? = checkclib(L, path)
    // must load library?
    if (reg == null) {
        // global symbols if 'sym'=='*'
        reg = lsys_load(L, path, int_of(*sym == '*'))
        // unable to load library
        if (reg == null) {
            return ERRLIB
        }
        addtoclib(L, path, reg)
    }
    // loading only library (no function)?
    if (*sym == '*') {
        // return 'true'
        lua_pushboolean(L, 1)
        // no errors
        return 0
    } else {
        var f : function<(var a0 : lua_State?) : int> = lsys_sym(L, reg, sym)
        if (f == null) {
            // unable to find function
            return ERRFUNC
        }
        // else create new function
        lua_pushcfunction(L, f)
        // no errors
        return 0
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private ll_loadlib(var L : lua_State?) : int {
    var path : uint8? = luaL_checkstring(L, 1)
    var init : uint8? = luaL_checkstring(L, 2)
    let stat : int = lookforfunc(L, path, init)
    // no errors?
    if (stat == 0) {
        // return the loaded function
        return 1
    } else {
        // error; error message is on stack top
        luaL_pushfail(L)
        lua_insert(L, -2)
        lua_pushstring(L, (stat == ERRLIB) ? cstr("absent") : cstr("init"))
        // return fail, error message, and where
        return 3
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private readable(var filename : uint8?) : int {
    // try to open file
    var f : _IO_FILE? = reinterpret<_IO_FILE?>(crt::fopen(filename, cstr("r")))
    // open failed
    if (f == null) {
        return 0
    }
    crt::fclose(reinterpret<void?>(f))
    return 1
}

// Get the next name in '*path' = 'name1;name2;name3;...', changing
// the ending ';' to '\0' to create a zero-terminated string. Return
// NULL when list ends.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getnextfilename(var path : uint8 ??; var end : uint8?) : uint8? {
    var sep : uint8?
    var name : uint8? = *path
    if (intptr(name) == intptr(end)) {
        // no more names
        return null
    } elif (*name == '\0') {
        // from previous iteration?
        // restore separator
        *name = *cstr(";")
        // skip it
        name++
    }
    // find next separator
    sep = crt::strchr(name, int(*cstr(";")))
    // separator not found?
    if (sep == null) {
        // name goes until the end
        sep = end
    }
    // finish file name
    *sep = uint8('\0')
    // will start next search from here
    *path = sep
    return name
}

// Given a path such as ";blabla.so;blublu.so", pushes the string
// no file 'blabla.so'
// no file 'blublu.so'
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private pusherrornotfound(var L : lua_State?; var path : uint8?) {
    var b : luaL_Buffer
    luaL_buffinit(L, addr(b))
    luaL_addstring(addr(b), cstr("no file '"))
    luaL_addgsub(addr(b), path, cstr(";"), cstr("'\n\tno file '"))
    luaL_addstring(addr(b), cstr("'"))
    luaL_pushresult(addr(b))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private searchpath(var L : lua_State?; var name : uint8?; var path : uint8?; var sep : uint8?; var dirsep : uint8?) : uint8? {
    var buff : luaL_Buffer
    // path with name inserted
    var pathname : uint8?
    // its end
    var endpathname : uint8?
    var filename : uint8?
    // separator is non-empty and appears in 'name'?
    if (*sep != '\0' && crt::strchr(name, int(*sep)) != null) {
        // replace it by 'dirsep'
        name = luaL_gsub(L, name, sep, dirsep)
    }
    luaL_buffinit(L, addr(buff))
    // add path to the buffer, replacing marks ('?') with the file name
    luaL_addgsub(addr(buff), path, cstr("?"), name)
    luaL_addchar(addr(buff), '\0')
    // writable list of file names
    pathname = luaL_buffaddr(addr(buff))
    endpathname = pathname + luaL_bufflen(addr(buff)) + -(1)
    while (true) {
        filename = getnextfilename(addr(pathname), endpathname)
        if (!(filename != null)) {
            break
        }
        // does file exist and is readable?
        if (readable(filename) != 0) {
            // save and return name
            return lua_pushstring(L, filename)
        }
    }
    // push path to create error message
    luaL_pushresult(addr(buff))
    // create error message
    pusherrornotfound(L, lua_tostring(L, -1))
    // not found
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private ll_searchpath(var L : lua_State?) : int {
    var f : uint8? = searchpath(L, luaL_checkstring(L, 1), luaL_checkstring(L, 2), luaL_optlstring(L, 3, cstr("."), null),
            luaL_optlstring(L, 4, cstr("/"), null))
    if (f != null) {
        return 1
    } else {
        // error message is on top of the stack
        luaL_pushfail(L)
        lua_insert(L, -2)
        // return fail + error message
        return 2
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private findfile(var L : lua_State?; var name : uint8?; var pname : uint8?; var dirsep : uint8?) : uint8? {
    var path : uint8?
    lua_getfield(L, lua_upvalueindex(1), pname)
    path = lua_tostring(L, -1)
    if (path == null) {
        luaL_error`va(L, cstr("'package.%s' must be a string"), (pname,))
    }
    return searchpath(L, name, path, cstr("."), dirsep)
}

[unsafe_deref, hint(unsafe_range_check)]
def private checkload(var L : lua_State?; stat : int; var filename : uint8?) : int {
    // module loaded successfully?
    if (stat != 0) {
        // will be 2nd argument to module
        lua_pushstring(L, filename)
        // return open function and file name
        return 2
    } else {
        return luaL_error`va(L, cstr("error loading module '%s' from file '%s':\n\t%s"), (lua_tostring(L, 1), filename, lua_tostring(L, -1)))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private searcher_Lua(var L : lua_State?) : int {
    var filename : uint8?
    var name : uint8? = luaL_checkstring(L, 1)
    filename = findfile(L, name, cstr("path"), cstr("/"))
    // module not found in this path
    if (filename == null) {
        return 1
    }
    return checkload(L, int_of(luaL_loadfile(L, filename) == LUA_OK), filename)
}

// Try to find a load function for module 'modname' at file 'filename'.
// First, change '.' to '_' in 'modname'; then, if 'modname' has
// the form X-Y (that is, it has an "ignore mark"), build a function
// name "luaopen_X" and look for it. (For compatibility, if that
// fails, it also tries "luaopen_Y".) If there is no ignore mark,
// look for a function named "luaopen_modname".
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private loadfunc(var L : lua_State?; var filename : uint8?; var modname : uint8?) : int {
    var openfunc : uint8?
    var mark : uint8?
    modname = luaL_gsub(L, modname, cstr("."), cstr("_"))
    mark = crt::strchr(modname, int(*cstr("-")))
    if (mark != null) {
        var stat : int
        openfunc = lua_pushlstring(L, modname, uint64(int64(mark - modname)))
        openfunc = lua_pushfstring`va(L, cstr("luaopen_%s"), (openfunc,))
        stat = lookforfunc(L, filename, openfunc)
        if (stat != ERRFUNC) {
            return stat
        }
        // else go ahead and try old-style name
        modname = mark + 1
    }
    openfunc = lua_pushfstring`va(L, cstr("luaopen_%s"), (modname,))
    return lookforfunc(L, filename, openfunc)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private searcher_C(var L : lua_State?) : int {
    var name : uint8? = luaL_checkstring(L, 1)
    var filename : uint8? = findfile(L, name, cstr("cpath"), cstr("/"))
    // module not found in this path
    if (filename == null) {
        return 1
    }
    return checkload(L, int_of(loadfunc(L, filename, name) == 0), filename)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private searcher_Croot(var L : lua_State?) : int {
    var filename : uint8?
    var name : uint8? = luaL_checkstring(L, 1)
    var p : uint8? = crt::strchr(name, '.')
    var stat : int
    // is root
    if (p == null) {
        return 0
    }
    lua_pushlstring(L, name, uint64(int64(p - name)))
    filename = findfile(L, lua_tostring(L, -1), cstr("cpath"), cstr("/"))
    // root not found
    if (filename == null) {
        return 1
    }
    stat = loadfunc(L, filename, name)
    if (stat != 0) {
        if (stat != ERRFUNC) {
            // real error
            return checkload(L, 0, filename)
        } else {
            // open function not found
            lua_pushfstring`va(L, cstr("no module '%s' in file '%s'"), (name, filename))
            return 1
        }
    }
    // will be 2nd argument to module
    lua_pushstring(L, filename)
    return 2
}

[unsafe_deref, hint(unsafe_range_check)]
def private searcher_preload(var L : lua_State?) : int {
    var name : uint8? = luaL_checkstring(L, 1)
    lua_getfield(L, LUA_REGISTRYINDEX, cstr("_PRELOAD"))
    // not found?
    if (lua_getfield(L, -1, name) == LUA_TNIL) {
        lua_pushfstring`va(L, cstr("no field package.preload['%s']"), (name,))
        return 1
    } else {
        lua_pushstring(L, cstr(":preload:"))
        return 2
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private findloader(var L : lua_State?; var name : uint8?) {
    var i : int
    // to build error message
    var msg : luaL_Buffer
    // push 'package.searchers' to index 3 in the stack
    if (lua_getfield(L, LUA_REGISTRYINDEX - 1, cstr("searchers")) != LUA_TTABLE) {
        luaL_error`va(L, cstr("'package.searchers' must be a table"), VaNone())
    }
    luaL_buffinit(L, addr(msg))
    // iterate over available searchers to find a loader
    i = 1
    while (true) {
        // error-message prefix
        luaL_addstring(addr(msg), cstr("\n\t"))
        // no more searchers?
        if (lua_rawgeti(L, 3, int64(i)) == LUA_TNIL) {
            // remove nil
            lua_pop(L, 1)
            // remove prefix
            luaL_buffsub(addr(msg), 2)
            // create error message
            luaL_pushresult(addr(msg))
            luaL_error`va(L, cstr("module '%s' not found:%s"), (name, lua_tostring(L, -1)))
        }
        lua_pushstring(L, name)
        // call it
        lua_call(L, 1, 2)
        // did it find a loader?
        if (lua_isfunction(L, -2)) {
            // module loader found
            return
        } elif (lua_isstring(L, -2) != 0) {
            // searcher returned error message?
            // remove extra return
            lua_pop(L, 1)
            // concatenate error message
            luaL_addvalue(addr(msg))
        } else {
            // no error message
            // remove both returns
            lua_pop(L, 2)
            // remove prefix
            luaL_buffsub(addr(msg), 2)
        }
        i++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private ll_require(var L : lua_State?) : int {
    var name : uint8? = luaL_checkstring(L, 1)
    // LOADED table will be at index 2
    lua_settop(L, 1)
    lua_getfield(L, LUA_REGISTRYINDEX, cstr("_LOADED"))
    // LOADED[name]
    lua_getfield(L, 2, name)
    // is it there?
    if (lua_toboolean(L, -1) != 0) {
        // package is already loaded
        return 1
    }
    // else must load package
    // remove 'getfield' result
    lua_pop(L, 1)
    findloader(L, name)
    // function <-> loader data
    lua_rotate(L, -2, 1)
    // name is 1st argument to module loader
    lua_pushvalue(L, 1)
    // loader data is 2nd argument
    lua_pushvalue(L, -3)
    // stack: ...; loader data; loader function; mod. name; loader data
    // run loader to load module
    lua_call(L, 2, 1)
    // stack: ...; loader data; result from loader
    // non-nil return?
    if (!lua_isnil(L, -1)) {
        // LOADED[name] = returned value
        lua_setfield(L, 2, name)
    } else {
        // pop nil
        lua_pop(L, 1)
    }
    // module set no value?
    if (lua_getfield(L, 2, name) == LUA_TNIL) {
        // use true as result
        lua_pushboolean(L, 1)
        // replace loader result
        lua_copy(L, -1, -2)
        // LOADED[name] = true
        lua_setfield(L, 2, name)
    }
    // loader data <-> module result
    lua_rotate(L, -2, 1)
    // return module result and loader data
    return 2
}

[unsafe_deref, hint(unsafe_range_check)]
def private createsearcherstable(var L : lua_State?) {
    var i : int
    // create 'searchers' table
    lua_createtable(L,
            int(uint64(typeinfo sizeof(type<function<(var a0 : lua_State?) : int>[5]>)) / uint64(typeinfo sizeof(type<function<(var a0 : lua_State?) : int>>)) -
                1ul),
            0)
    // fill it with predefined searchers
    i = 0
    while (createsearcherstable_searchers[i] != null) {
        // set 'package' as upvalue for all searchers
        lua_pushvalue(L, -2)
        lua_pushcclosure(L, createsearcherstable_searchers[i], 1)
        lua_rawseti(L, -2, int64(i + 1))
        i++
    }
    // put it in field 'searchers'
    lua_setfield(L, -2, cstr("searchers"))
}

// create table CLIBS to keep track of loaded C libraries,
// setting a finalizer to close all libraries when closing state.
[unsafe_deref, hint(unsafe_range_check)]
def private createclibstable(var L : lua_State?) {
    // create CLIBS table
    luaL_getsubtable(L, LUA_REGISTRYINDEX, CLIBS)
    // create metatable for CLIBS
    lua_createtable(L, 0, 1)
    lua_pushcclosure(L, @@gctm, 0)
    // set finalizer for CLIBS table
    lua_setfield(L, -2, cstr("__gc"))
    lua_setmetatable(L, -2)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaopen_package(var L : lua_State?) : int {
    createclibstable(L)
    // create 'package' table
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[8]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(pk_funcs[0]), 0)
    createsearcherstable(L)
    // set paths
    setpath(L, cstr("path"), cstr("LUA_PATH"),
            cstr("/usr/local/share/lua/5.4/?.lua;/usr/local/share/lua/5.4/?/init.lua;/usr/local/lib/lua/5.4/?.lua;/usr/local/lib/lua/5.4/?/init.lua;./?.lua;./?/init.lua"))
    setpath(L, cstr("cpath"), cstr("LUA_CPATH"), cstr("/usr/local/lib/lua/5.4/?.so;/usr/local/lib/lua/5.4/loadall.so;./?.so"))
    // store config information
    lua_pushstring(L, cstr("/\n;\n?\n!\n-\n"))
    lua_setfield(L, -2, cstr("config"))
    // set field 'loaded'
    luaL_getsubtable(L, LUA_REGISTRYINDEX, cstr("_LOADED"))
    lua_setfield(L, -2, cstr("loaded"))
    // set field 'preload'
    luaL_getsubtable(L, LUA_REGISTRYINDEX, cstr("_PRELOAD"))
    lua_setfield(L, -2, cstr("preload"))
    lua_pushglobaltable(L)
    // set 'package' as upvalue for next lib
    lua_pushvalue(L, -2)
    // open lib into global table
    luaL_setfuncs(L, addr(ll_funcs[0]), 1)
    // pop global table
    lua_pop(L, 1)
    // return 'package' table
    return 1
}

