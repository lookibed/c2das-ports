// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_function
require c_runtime/c_macro
require c_runtime/c_switch
require c_runtime/cstr
require c_runtime/variadic
require lapi
require lauxlib
require lauxlib_h
require lcode_cluster
require lobject_h_cluster

var private statname : uint8? [4] = fixed_array<uint8?>(cstr("running"), cstr("dead"), cstr("suspended"), cstr("normal"))
var private co_funcs : luaL_Reg[9] = fixed_array(luaL_Reg(name = cstr("create"), func = @@luaB_cocreate),
        luaL_Reg(name = cstr("resume"), func = @@luaB_coresume), luaL_Reg(name = cstr("running"), func = @@luaB_corunning),
        luaL_Reg(name = cstr("status"), func = @@luaB_costatus), luaL_Reg(name = cstr("wrap"), func = @@luaB_cowrap),
        luaL_Reg(name = cstr("yield"), func = @@luaB_yield), luaL_Reg(name = cstr("isyieldable"), func = @@luaB_yieldable),
        luaL_Reg(name = cstr("close"), func = @@luaB_close), luaL_Reg(name = null, func = default<function<(var a0 : lua_State?) : int>>))

let private LUA_OK = 0
let private LUA_YIELD = 1
let private LUAI_MAXSTACK = 1000000
let private LUA_REGISTRYINDEX = -LUAI_MAXSTACK - 1000
let private LUA_ERRMEM = 4
let private LUA_TSTRING = 4
let private LUA_TFUNCTION = 6
let private COS_RUN = 0
let private COS_YIELD = 2
let private COS_NORM = 3
let private COS_DEAD = 1
let private LUA_TNONE = -1
let private LUA_VERSION_NUM = 504
let private LUAL_NUMSIZES = uint64(typeinfo sizeof(type<int64>)) * 16ul + uint64(typeinfo sizeof(type<double>))

// lua.h:376: #define lua_pop(L,n) lua_settop(L, -(n)-1)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_pop(var L; n) {
    lua_settop(L, -n - 1)
}

// lua.h:401: #define lua_insert(L,idx) lua_rotate(L, (idx), 1)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_insert(var L; idx) {
    lua_rotate(L, idx, 1)
}

// lua.h:316: #define lua_yield(L,n) lua_yieldk(L, (n), 0, NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_yield(var L; n) => lua_yieldk(L, n, 0l, default<function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>>)

// lua.h:390: #define lua_isnone(L,n) (lua_type(L, (n)) == LUA_TNONE)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_isnone(var L; n) => lua_type(L, n) == LUA_TNONE

// lauxlib.h:47: #define luaL_checkversion(L) luaL_checkversion_(L, LUA_VERSION_NUM, LUAL_NUMSIZES)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private luaL_checkversion(var L) {
    luaL_checkversion_(L, double(LUA_VERSION_NUM), LUAL_NUMSIZES)
}

[unsafe_deref, hint(unsafe_range_check)]
def private getco(var L : lua_State?) : lua_State? {
    var co : lua_State? = lua_tothread(L, 1)
    let _t0 = co != null || luaL_typeerror(L, 1, cstr("thread")) != 0
    return co
}

// Resumes a coroutine. Returns the number of results for non-error
// cases or -1 for errors.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private auxresume(var L : lua_State?; var co : lua_State?; narg : int) : int {
    var status : int
    var nres : int
    if (lua_checkstack(co, narg) == 0) {
        lua_pushstring(L, cstr("too many arguments to resume"))
        // error flag
        return -1
    }
    lua_xmove(L, co, narg)
    status = lua_resume(co, L, narg, addr(nres))
    if (status == LUA_OK || status == LUA_YIELD) {
        if (lua_checkstack(L, nres + 1) == 0) {
            // remove results anyway
            lua_pop(co, nres)
            lua_pushstring(L, cstr("too many results to resume"))
            // error flag
            return -1
        }
        // move yielded values
        lua_xmove(co, L, nres)
        return nres
    } else {
        // move error message
        lua_xmove(co, L, 1)
        // error flag
        return -1
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_coresume(var L : lua_State?) : int {
    var co : lua_State? = getco(L)
    var r : int
    r = auxresume(L, co, lua_gettop(L) - 1)
    if (r < 0) {
        lua_pushboolean(L, 0)
        lua_insert(L, -2)
        // return false + error message
        return 2
    } else {
        lua_pushboolean(L, 1)
        lua_insert(L, -(r + 1))
        // return true + 'resume' returns
        return r + 1
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_auxwrap(var L : lua_State?) : int {
    var co : lua_State? = lua_tothread(L, lua_upvalueindex(1))
    let r : int = auxresume(L, co, lua_gettop(L))
    // error?
    if (r < 0) {
        var stat : int = lua_status(co)
        // error in the coroutine?
        if (stat != LUA_OK && stat != LUA_YIELD) {
            // close its tbc variables
            stat = lua_closethread(co, L)
            // move error message to the caller
            lua_xmove(co, L, 1)
        }
        // not a memory error and ...
        if (stat != LUA_ERRMEM && lua_type(L, -1) == LUA_TSTRING) {
            // ... error object is a string?
            // add extra info, if available
            luaL_where(L, 1)
            lua_insert(L, -2)
            lua_concat(L, 2)
        }
        // propagate error
        return lua_error(L)
    }
    return r
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_cocreate(var L : lua_State?) : int {
    var NL : lua_State?
    luaL_checktype(L, 1, LUA_TFUNCTION)
    NL = lua_newthread(L)
    // move function to top
    lua_pushvalue(L, 1)
    // move function from L to NL
    lua_xmove(L, NL, 1)
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_cowrap(var L : lua_State?) : int {
    luaB_cocreate(L)
    lua_pushcclosure(L, @@luaB_auxwrap, 1)
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_yield(var L : lua_State?) : int {
    return lua_yield(L, lua_gettop(L))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private auxstatus(var L : lua_State?; var co : lua_State?) : int {
    if (intptr(L) == intptr(co)) {
        return COS_RUN
    } else {
        c_switch(lua_status(co)) {
            case(1) {
                return COS_YIELD
            }
            case(0) {
                {
                    var ar : lua_Debug
                    // does it have frames?
                    if (lua_getstack(co, 0, addr(ar)) != 0) {
                        // it is running
                        return COS_NORM
                    } elif (lua_gettop(co) == 0) {
                        return COS_DEAD
                    } else {
                        // initial state
                        return COS_YIELD
                    }
                }
            }
            case(_) {
                // some error occurred
                return COS_DEAD
            }
        }
    }
    return 0
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_costatus(var L : lua_State?) : int {
    var co : lua_State? = getco(L)
    lua_pushstring(L, statname[auxstatus(L, co)])
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_yieldable(var L : lua_State?) : int {
    var co : lua_State? = lua_isnone(L, 1) ? L : getco(L)
    lua_pushboolean(L, lua_isyieldable(co))
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_corunning(var L : lua_State?) : int {
    let ismain : int = lua_pushthread(L)
    lua_pushboolean(L, ismain)
    return 2
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_close(var L : lua_State?) : int {
    var co : lua_State? = getco(L)
    var status : int = auxstatus(L, co)
    c_switch(status) {
        case(1, 2) {
            status = lua_closethread(co, L)
            if (status == LUA_OK) {
                lua_pushboolean(L, 1)
                return 1
            } else {
                lua_pushboolean(L, 0)
                // move error message
                lua_xmove(co, L, 1)
                return 2
            }
        }
        case(_) {
            // normal or running coroutine
            return luaL_error`va(L, cstr("cannot close a %s coroutine"), (statname[status],))
        }
    }
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaopen_coroutine(var L : lua_State?) : int {
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[9]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(co_funcs[0]), 0)
    return 1
}

