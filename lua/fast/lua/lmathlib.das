// Project the random integer 'ran' into the interval [0, n].
// Because 'ran' has 2^B possible values, the projection can only be
// uniform when the size of the interval is a power of 2 (exact
// division). Otherwise, to get a uniform projection into [0, n], we
// first compute 'lim', the smallest Mersenne number not smaller than
// 'n'. We then project 'ran' into the interval [0, lim]. If the result
// is inside [0, n], we are done. Otherwise, we try with another 'ran',
// until we have a result inside the interval.
[c_function]
def private project(var ran : uint64; n : uint64; var state : RanState?) : uint64 {
    // is 'n + 1' a power of 2?
    if ((n & (n + 1ul)) == 0ul) {
        // no bias
        return ran & n
    } else {
        var lim : uint64 = n
        // compute the smallest (2^b - 1) not smaller than 'n'
        lim |= lim >> 1ul
        lim |= lim >> 2ul
        lim |= lim >> 4ul
        lim |= lim >> 8ul
        lim |= lim >> 16ul
        // integer type has more than 32 bits
        lim |= lim >> 32ul
        // 'lim + 1' is a power of 2,
        // not smaller than 'n',
        // and it is the smallest one
        // project 'ran' into [0..lim]
        while (true) {
            ran &= lim
            if (!(ran > n)) {
                break
            }
            // not inside [0..n]? try again
            ran = I2UInt(nextrand(addr(state.s[0])))
        }
        return ran
    }
}

