// generated by c2das - regenerate, never edit
var private previousinstruction_invalidinstruction : uint = ~0u
var private luaK_prefix_ef : expdesc = expdesc(k = expkind.VKINT, t = -1, f = -1)

// semantic error
[unsafe_deref, hint(unsafe_range_check)]
def luaK_semerror(var ls : LexState?; var msg : uint8?) {
    // remove "near <token>" from final message
    ls.t.token = 0
    luaX_syntaxerror(ls, msg)
}

// If expression is a numeric constant, fills 'v' with its value
// and returns 1. Otherwise, returns 0.
[unsafe_deref, hint(unsafe_range_check)]
def private tonumeral(var e : expdesc?; var v : TValue?) : int {
    if (hasjumps(e)) {
        // not a numeral
        return 0
    }
    c_switch(e.k) {
        case(expkind.VKINT) {
            if (v != null) {
                var io : TValue? = v
                io.value_.i = e.u.ival
                settt_(io, LUA_TNUMBER | (0 << 4))
            }
            return 1
        }
        case(expkind.VKFLT) {
            if (v != null) {
                var io : TValue? = v
                io.value_.n = e.u.nval
                settt_(io, LUA_TNUMBER | (1 << 4))
            }
            return 1
        }
        case(_) {
            return 0
        }
    }
}

// Get the constant value from a constant expression
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private const2val(var fs : FuncState?; var e : expdesc?) : TValue? {
    return addr(fs.ls.dyd.actvar.arr[e.u.info].k)
}

// If expression is a constant, fills 'v' with its value
// and returns 1. Otherwise, returns 0.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_exp2const(var fs : FuncState?; var e : expdesc?; var v : TValue?) : int {
    if (hasjumps(e)) {
        // not a constant
        return 0
    }
    c_switch(e.k) {
        case(expkind.VFALSE) {
            setbfvalue(v)
            return 1
        }
        case(expkind.VTRUE) {
            setbtvalue(v)
            return 1
        }
        case(expkind.VNIL) {
            setnilvalue(v)
            return 1
        }
        case(expkind.VKSTR) {
            {
                var io : TValue? = v
                var x_ : TString? = e.u.strval
                io.value_.gc = obj2gco(x_)
                settt_(io, ctb(x_.tt))
                let _t0 = fs.ls.L
            }
            return 1
        }
        case(expkind.VCONST) {
            {
                var io1 : TValue? = v
                var io2 : TValue? = const2val(fs, e)
                io1.value_ = io2.value_
                settt_(io1, io2.tt_)
                let _t1 = fs.ls.L
            }
            return 1
        }
        case(_) {
            return tonumeral(e, v)
        }
    }
}

// Return the previous instruction of the current code. If there
// may be a jump target between the current instruction and the
// previous one, return an invalid instruction (to avoid wrong
// optimizations).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private previousinstruction(var fs : FuncState?) : uint? {
    if (fs.pc > fs.lasttarget) {
        // previous instruction
        return addr(fs.f.code[fs.pc - 1])
    } else {
        return addr(previousinstruction_invalidinstruction)
    }
}

// Create a OP_LOADNIL instruction, but try to optimize: if the previous
// instruction is also OP_LOADNIL and ranges are compatible, adjust
// range of previous instruction instead of emitting a new one. (For
// instance, 'local a; local b' will generate a single opcode.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_nil(var fs : FuncState?; var from : int; n : int) {
    // last register to set nil
    var l : int = from + n - 1
    var previous : uint? = previousinstruction(fs)
    // previous is LOADNIL?
    if (GET_OPCODE(*previous) == OpCode.OP_LOADNIL) {
        // get previous range
        let pfrom : int = GETARG_A(*previous)
        let pl : int = pfrom + GETARG_B(*previous)
        if ((pfrom <= from && from <= pl + 1) || (from <= pfrom && pfrom <= l + 1)) {
            // can connect both?
            // from = min(from, pfrom)
            if (pfrom < from) {
                from = pfrom
            }
            // l = max(l, pl)
            if (pl > l) {
                l = pl
            }
            *previous = (*previous & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(from) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
            *previous = (*previous & ~(~(~0u << uint(SIZE_B)) << uint(POS_B))) | ((uint(l - from) << uint(POS_B)) & (~(~0u << uint(SIZE_B)) << uint(POS_B)))
            return
        }
    }
    // else go through
    // else no optimization
    luaK_codeABCk(fs, OpCode.OP_LOADNIL, from, n - 1, 0, 0)
}

// Gets the destination address of a jump instruction. Used to traverse
// a list of jumps.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getjump(var fs : FuncState?; pc : int) : int {
    let offset : int = GETARG_sJ(fs.f.code[pc])
    // point to itself represents end of list
    if (offset == NO_JUMP) {
        // end of list
        return NO_JUMP
    } else {
        // turn offset into absolute position
        return (pc + 1) + offset
    }
}

// Fix jump instruction at position 'pc' to jump to 'dest'.
// (Jump addresses are relative in Lua)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private fixjump(var fs : FuncState?; pc : int; dest : int) {
    var jmp : uint? = addr(fs.f.code[pc])
    let offset : int = dest - (pc + 1)
    if (!(-OFFSET_sJ <= offset && offset <= MAXARG_sJ - OFFSET_sJ)) {
        luaX_syntaxerror(fs.ls, cstr("control structure too long"))
    }
    *jmp = (*jmp & MASK0(SIZE_sJ, POS_A)) | ((uint(offset + OFFSET_sJ) << uint(POS_A)) & MASK1(SIZE_sJ, POS_A))
}

// Concatenate jump-list 'l2' into jump-list 'l1'
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_concat(var fs : FuncState?; var l1 : int?; l2 : int) {
    // nothing to concatenate?
    if (l2 == NO_JUMP) {
        return
    } elif (*l1 == NO_JUMP) {
        // no original list?
        // 'l1' points to 'l2'
        *l1 = l2
    } else {
        var list : int = *l1
        var next : int
        // find last element
        while (true) {
            next = getjump(fs, list)
            if (!(next != NO_JUMP)) {
                break
            }
            list = next
        }
        // last element links to 'l2'
        fixjump(fs, list, l2)
    }
}

// Create a jump instruction and return its position, so its destination
// can be fixed later (with 'fixjump').
[unsafe_deref, hint(unsafe_range_check)]
def luaK_jump(var fs : FuncState?) : int {
    return codesJ(fs, OpCode.OP_JMP, NO_JUMP, 0)
}

// Code a 'return' instruction
[unsafe_deref, hint(unsafe_range_check)]
def luaK_ret(var fs : FuncState?; first : int; nret : int) {
    var op : OpCode
    c_switch(nret) {
        case(0) {
            op = OpCode.OP_RETURN0
            break
        }
        case(1) {
            op = OpCode.OP_RETURN1
            break
        }
        case(_) {
            op = OpCode.OP_RETURN
            break
        }
    }
    luaK_codeABC(fs, op, first, nret + 1, 0)
}

// Code a "conditional jump", that is, a test or comparison opcode
// followed by a jump. Return jump position.
[unsafe_deref, hint(unsafe_range_check)]
def private condjump(var fs : FuncState?; op : OpCode; A : int; B : int; C : int; k : int) : int {
    luaK_codeABCk(fs, op, A, B, C, k)
    return luaK_jump(fs)
}

// returns current 'pc' and marks it as a jump target (to avoid wrong
// optimizations with consecutive instructions not in the same basic block).
[unsafe_deref, hint(unsafe_range_check)]
def luaK_getlabel(var fs : FuncState?) : int {
    fs.lasttarget = fs.pc
    return fs.pc
}

// Returns the position of the instruction "controlling" a given
// jump (that is, its condition), or the jump itself if it is
// unconditional.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getjumpcontrol(var fs : FuncState?; pc : int) : uint? {
    var pi : uint? = addr(fs.f.code[pc])
    if (pc >= 1 && testTMode(GET_OPCODE(*(pi - 1))) != 0) {
        return pi - 1
    } else {
        return pi
    }
}

// Patch destination register for a TESTSET instruction.
// If instruction in position 'node' is not a TESTSET, return 0 ("fails").
// Otherwise, if 'reg' is not 'NO_REG', set it as the destination
// register. Otherwise, change instruction to a simple 'TEST' (produces
// no register value)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private patchtestreg(var fs : FuncState?; node : int; reg : int) : int {
    var i : uint? = getjumpcontrol(fs, node)
    if (enum_from_int(type<OpCode>, int((*i >> uint(POS_OP)) & (~(~0u << uint(SIZE_OP)) << 0u))) != OpCode.OP_TESTSET) {
        // cannot patch other instructions
        return 0
    }
    if (reg != NO_REG && reg != int((*i >> uint(POS_B)) & (~(~0u << uint(SIZE_B)) << 0u))) {
        *i = (*i & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(reg) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
    } else {
        // no register to put value or register already has the value;
        // change instruction to simple test
        *i = (uint(OpCode.OP_TEST) << uint(POS_OP)) | (uint(int((*i >> uint(POS_B)) & (~(~0u << uint(SIZE_B)) << 0u))) << uint(POS_A)) | (0u <<
                uint(POS_B)) | (0u << uint(POS_C)) | (uint(int((*i >> uint(POS_k)) & (~(~0u << 1u) << 0u))) << uint(POS_k))
    }
    return 1
}

// Traverse a list of tests ensuring no one produces a value
[unsafe_deref, hint(unsafe_range_check)]
def private removevalues(var fs : FuncState?; var list : int) {
    while (list != NO_JUMP) {
        patchtestreg(fs, list, NO_REG)
        list = getjump(fs, list)
    }
}

// Traverse a list of tests, patching their destination address and
// registers: tests producing values jump to 'vtarget' (and put their
// values in 'reg'), other tests jump to 'dtarget'.
[unsafe_deref, hint(unsafe_range_check)]
def private patchlistaux(var fs : FuncState?; var list : int; vtarget : int; reg : int; dtarget : int) {
    while (list != NO_JUMP) {
        let next : int = getjump(fs, list)
        if (patchtestreg(fs, list, reg) != 0) {
            fixjump(fs, list, vtarget)
        } else {
            // jump to default target
            fixjump(fs, list, dtarget)
        }
        list = next
    }
}

// Path all jumps in 'list' to jump to 'target'.
// (The assert means that we cannot fix a jump to a forward address
// because we only know addresses once code is generated.)
[unsafe_deref, hint(unsafe_range_check)]
def luaK_patchlist(var fs : FuncState?; list : int; target : int) {
    patchlistaux(fs, list, target, NO_REG, target)
}

[unsafe_deref, hint(unsafe_range_check)]
def luaK_patchtohere(var fs : FuncState?; list : int) {
    // mark "here" as a jump target
    let hr : int = luaK_getlabel(fs)
    luaK_patchlist(fs, list, hr)
}

// Save line info for a new instruction. If difference from last line
// does not fit in a byte, of after that many instructions, save a new
// absolute line info; (in that case, the special value 'ABSLINEINFO'
// in 'lineinfo' signals the existence of this absolute information.)
// Otherwise, store the difference from last line in 'lineinfo'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private savelineinfo(var fs : FuncState?; var f : Proto?; line : int) {
    var linedif : int = line - fs.previousline
    // last instruction coded
    let pc : int = fs.pc - 1
    var _t1 = crt::abs(linedif) >= LIMLINEDIFF
    if (!_t1) {
        let _t0 = fs.iwthabs
        fs.iwthabs = uint8(uint(fs.iwthabs) + 1)
        _t1 = int(_t0) >= MAXIWTHABS
    }
    if (_t1) {
        f.abslineinfo = reinterpret<AbsLineInfo?>(luaM_growaux_(fs.ls.L, reinterpret<void?>(f.abslineinfo), fs.nabslineinfo, addr(f.sizeabslineinfo),
                typeinfo sizeof(type<AbsLineInfo>),
                int(2147483647ul <= MAX_SIZET / uint64(typeinfo sizeof(type<AbsLineInfo>)) ? 2147483647u :
                    uint(MAX_SIZET / uint64(typeinfo sizeof(type<AbsLineInfo>)))),
                cstr("lines")))
        f.abslineinfo[fs.nabslineinfo].pc = pc
        let _t2 = fs.nabslineinfo
        fs.nabslineinfo++
        f.abslineinfo[_t2].line = line
        // signal that there is absolute information
        linedif = ABSLINEINFO
        // restart counter
        fs.iwthabs = 1u8
    }
    f.lineinfo = reinterpret<int8?>(luaM_growaux_(fs.ls.L, reinterpret<void?>(f.lineinfo), pc, addr(f.sizelineinfo), typeinfo sizeof(type<int8>),
            int(2147483647ul <= MAX_SIZET / uint64(typeinfo sizeof(type<int8>)) ? 2147483647u : uint(MAX_SIZET / uint64(typeinfo sizeof(type<int8>)))),
            cstr("opcodes")))
    f.lineinfo[pc] = int8(linedif)
    // last line saved
    fs.previousline = line
}

// Remove line information from the last instruction.
// If line information for that instruction is absolute, set 'iwthabs'
// above its max to force the new (replacing) instruction to have
// absolute line info, too.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private removelastlineinfo(var fs : FuncState?) {
    var f : Proto? = fs.f
    // last instruction coded
    let pc : int = fs.pc - 1
    // relative line info?
    if (int(f.lineinfo[pc]) != ABSLINEINFO) {
        // correct last line saved
        fs.previousline -= int(f.lineinfo[pc])
        // undo previous increment
        fs.iwthabs = uint8(uint(fs.iwthabs) - 1)
    } else {
        // absolute line information
        // remove it
        fs.nabslineinfo--
        // force next line info to be absolute
        fs.iwthabs = uint8(MAXIWTHABS + 1)
    }
}

// Remove the last instruction created, correcting line information
// accordingly.
[unsafe_deref, hint(unsafe_range_check)]
def private removelastinstruction(var fs : FuncState?) {
    removelastlineinfo(fs)
    fs.pc--
}

// Emit instruction 'i', checking for array sizes and saving also its
// line information. Return 'i' position.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_code(var fs : FuncState?; i : uint) : int {
    var f : Proto? = fs.f
    // put new instruction in code array
    f.code = reinterpret<uint?>(luaM_growaux_(fs.ls.L, reinterpret<void?>(f.code), fs.pc, addr(f.sizecode), typeinfo sizeof(type<uint>),
            int(2147483647ul <= MAX_SIZET / uint64(typeinfo sizeof(type<uint>)) ? 2147483647u : uint(MAX_SIZET / uint64(typeinfo sizeof(type<uint>)))),
            cstr("opcodes")))
    let _t0 = fs.pc
    fs.pc++
    f.code[_t0] = i
    savelineinfo(fs, f, fs.ls.lastline)
    // index of new instruction
    return fs.pc - 1
}

// Format and emit an 'iABC' instruction. (Assertions check consistency
// of parameters versus opcode.)
[unsafe_deref, hint(unsafe_range_check)]
def luaK_codeABCk(var fs : FuncState?; o : OpCode; a : int; b : int; c : int; k : int) : int {
    return luaK_code(fs, CREATE_ABCk(o, a, b, c, k))
}

// Format and emit an 'iABx' instruction.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_codeABx(var fs : FuncState?; o : OpCode; a : int; bc : uint) : int {
    return luaK_code(fs, CREATE_ABx(o, a, bc))
}

// Format and emit an 'iAsBx' instruction.
[unsafe_deref, hint(unsafe_range_check)]
def private codeAsBx(var fs : FuncState?; o : OpCode; a : int; bc : int) : int {
    let b : uint = uint(bc + OFFSET_sBx)
    return luaK_code(fs, CREATE_ABx(o, a, b))
}

// Format and emit an 'isJ' instruction.
[unsafe_deref, hint(unsafe_range_check)]
def private codesJ(var fs : FuncState?; o : OpCode; sj : int; k : int) : int {
    let j : uint = uint(sj + OFFSET_sJ)
    return luaK_code(fs, CREATE_sJ(o, j, k))
}

// Emit an "extra argument" instruction (format 'iAx')
[unsafe_deref, hint(unsafe_range_check)]
def private codeextraarg(var fs : FuncState?; a : int) : int {
    return luaK_code(fs, (uint(OpCode.OP_EXTRAARG) << uint(POS_OP)) | (uint(a) << uint(POS_A)))
}

// Emit a "load constant" instruction, using either 'OP_LOADK'
// (if constant index 'k' fits in 18 bits) or an 'OP_LOADKX'
// instruction with "extra argument".
[unsafe_deref, hint(unsafe_range_check)]
def private luaK_codek(var fs : FuncState?; reg : int; k : int) : int {
    if (k <= MAXARG_Bx) {
        return luaK_codeABx(fs, OpCode.OP_LOADK, reg, uint(k))
    } else {
        let p : int = luaK_codeABx(fs, OpCode.OP_LOADKX, reg, 0u)
        codeextraarg(fs, k)
        return p
    }
}

// Check register-stack level, keeping track of its maximum size
// in field 'maxstacksize'
[unsafe_deref, hint(unsafe_range_check)]
def luaK_checkstack(var fs : FuncState?; n : int) {
    let newstack : int = int(fs.freereg) + n
    if (newstack > int(fs.f.maxstacksize)) {
        if (newstack >= MAXREGS) {
            luaX_syntaxerror(fs.ls, cstr("function or expression needs too many registers"))
        }
        fs.f.maxstacksize = uint8(newstack)
    }
}

// Reserve 'n' registers in register stack
[unsafe_deref, hint(unsafe_range_check)]
def luaK_reserveregs(var fs : FuncState?; n : int) {
    luaK_checkstack(fs, n)
    fs.freereg = uint8(int(fs.freereg) + n)
}

// Free register 'reg', if it is neither a constant index nor
// a local variable.
// )
[unsafe_deref, hint(unsafe_range_check)]
def private freereg(var fs : FuncState?; reg : int) {
    if (reg >= luaY_nvarstack(fs)) {
        fs.freereg = uint8(uint(fs.freereg) - 1)
    }
}

// Free two registers in proper order
[unsafe_deref, hint(unsafe_range_check)]
def private freeregs(var fs : FuncState?; r1 : int; r2 : int) {
    if (r1 > r2) {
        freereg(fs, r1)
        freereg(fs, r2)
    } else {
        freereg(fs, r2)
        freereg(fs, r1)
    }
}

// Free register used by expression 'e' (if any)
[unsafe_deref, hint(unsafe_range_check)]
def private freeexp(var fs : FuncState?; var e : expdesc?) {
    if (e.k == expkind.VNONRELOC) {
        freereg(fs, e.u.info)
    }
}

// Free registers used by expressions 'e1' and 'e2' (if any) in proper
// order.
[unsafe_deref, hint(unsafe_range_check)]
def private freeexps(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?) {
    let r1 : int = (e1.k == expkind.VNONRELOC) ? e1.u.info : -1
    let r2 : int = (e2.k == expkind.VNONRELOC) ? e2.u.info : -1
    freeregs(fs, r1, r2)
}

// Add constant 'v' to prototype's list of constants (field 'k').
// Use scanner's table to cache position of constants in constant list
// and try to reuse constants. Because some values should not be used
// as keys (nil cannot be a key, integer keys can collapse with float
// keys), the caller must provide a useful 'key' for indexing the cache.
// Note that all functions share the same table, so entering or exiting
// a function can make some indices wrong.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private addk(var fs : FuncState?; var key : TValue?; var v : TValue?) : int {
    var val : TValue
    var L : lua_State? = fs.ls.L
    var f : Proto? = fs.f
    // query scanner table
    var idx : TValue? = luaH_get(fs.ls.h, key)
    var k : int
    var oldsize : int
    // is there an index there?
    if (ttisinteger(idx)) {
        k = int(ivalue(idx))
        // correct value? (warning: must distinguish floats from integers!)
        if (k < fs.nk && ttypetag(addr(f.k[k])) == ttypetag(v) && luaV_rawequalobj(addr(f.k[k]), v) != 0) {
            // reuse index
            return k
        }
    }
    // constant not found; create a new entry
    oldsize = f.sizek
    k = fs.nk
    setivalue(addr(val), k)
    // numerical value does not need GC barrier;
    // table has no metatable, so it does not need to invalidate cache
    luaH_finishset(L, fs.ls.h, key, idx, addr(val))
    f.k = reinterpret<TValue?>(luaM_growaux_(L, reinterpret<void?>(f.k), k, addr(f.sizek), typeinfo sizeof(type<TValue>),
            int(uint64(MAXARG_Ax) <= MAX_SIZET / uint64(typeinfo sizeof(type<TValue>)) ? uint(MAXARG_Ax) :
                uint(MAX_SIZET / uint64(typeinfo sizeof(type<TValue>)))),
            cstr("constants")))
    while (oldsize < f.sizek) {
        let _t0 = oldsize
        oldsize++
        addr(f.k[_t0]).tt_ = uint8(LUA_TNIL | (0 << 4))
    }
    {
        var io1 : TValue? = addr(f.k[k])
        var io2 : TValue? = v
        io1.value_ = io2.value_
        settt_(io1, io2.tt_)
    }
    fs.nk++
    luaC_barrier(L, f, v)
    return k
}

// Add a string to list of constants and return its index.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private stringK(var fs : FuncState?; var s : TString?) : int {
    var o : TValue
    {
        var io : TValue? = addr(o)
        var x_ : TString? = s
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(x_.tt))
        let _t0 = fs.ls.L
    }
    // use string itself as key
    return addk(fs, addr(o), addr(o))
}

// Add an integer to list of constants and return its index.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaK_intK(var fs : FuncState?; n : int64) : int {
    var o : TValue
    setivalue(addr(o), n)
    // use integer itself as key
    return addk(fs, addr(o), addr(o))
}

// Add a float to list of constants and return its index. Floats
// with integral values need a different key, to avoid collision
// with actual integers. To that, we add to the number its smaller
// power-of-two fraction that is still significant in its scale.
// For doubles, that would be 1/2^52.
// (This method is not bulletproof: there may be another float
// with that value, and for floats larger than 2^53 the result is
// still an integer. At worst, this only wastes an entry with
// a duplicate.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaK_numberK(var fs : FuncState?; r : double) : int {
    var o : TValue
    var ik : int64
    setfltvalue(addr(o), r)
    // not an integral value?
    if (luaV_flttointeger(r, addr(ik), F2Imod.F2Ieq) == 0) {
        // use number itself as key
        return addk(fs, addr(o), addr(o))
    } else {
        // must build an alternative key
        let nbm : int = 53
        let q : double = crt::ldexp(1.0lf, -nbm + 1)
        // new key
        let k : double = (ik == 0l) ? q : r + r * q
        var kv : TValue
        setfltvalue(addr(kv), k)
        // result is not an integral value, unless value is too large
        return addk(fs, addr(kv), addr(o))
    }
}

// Add a false to list of constants and return its index.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private boolF(var fs : FuncState?) : int {
    var o : TValue
    addr(o).tt_ = uint8(LUA_TBOOLEAN | (0 << 4))
    // use boolean itself as key
    return addk(fs, addr(o), addr(o))
}

// Add a true to list of constants and return its index.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private boolT(var fs : FuncState?) : int {
    var o : TValue
    addr(o).tt_ = uint8(LUA_TBOOLEAN | (1 << 4))
    // use boolean itself as key
    return addk(fs, addr(o), addr(o))
}

// Add nil to list of constants and return its index.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private nilK(var fs : FuncState?) : int {
    var k : TValue
    var v : TValue
    setnilvalue(addr(v))
    {
        // cannot use nil as key; instead use table itself to represent nil
        var io : TValue? = addr(k)
        var x_ : Table? = fs.ls.h
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(LUA_TTABLE | (0 << 4)))
        let _t0 = fs.ls.L
    }
    return addk(fs, addr(k), addr(v))
}

// Check whether 'i' can be stored in an 'sC' operand. Equivalent to
// (0 <= int2sC(i) && int2sC(i) <= MAXARG_C) but without risk of
// overflows in the hidden addition inside 'int2sC'.
[unsafe_deref, hint(unsafe_range_check)]
def private fitsC(i : int64) : int {
    return int_of(uint64(i) + uint64(OFFSET_sC) <= uint64(uint(MAXARG_C)))
}

// Check whether 'i' can be stored in an 'sBx' operand.
[unsafe_deref, hint(unsafe_range_check)]
def private fitsBx(i : int64) : int {
    return int_of(int64(-OFFSET_sBx) <= i && i <= int64(MAXARG_Bx - OFFSET_sBx))
}

[unsafe_deref, hint(unsafe_range_check)]
def luaK_int(var fs : FuncState?; reg : int; i : int64) {
    if (fitsBx(i) != 0) {
        codeAsBx(fs, OpCode.OP_LOADI, reg, int(i))
    } else {
        luaK_codek(fs, reg, luaK_intK(fs, i))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaK_float(var fs : FuncState?; reg : int; f : double) {
    var fi : int64
    if (luaV_flttointeger(f, addr(fi), F2Imod.F2Ieq) != 0 && fitsBx(fi) != 0) {
        codeAsBx(fs, OpCode.OP_LOADF, reg, int(fi))
    } else {
        luaK_codek(fs, reg, luaK_numberK(fs, f))
    }
}

// Convert a constant in 'v' into an expression description 'e'
[unsafe_deref, hint(unsafe_range_check)]
def private const2exp(var v : TValue?; var e : expdesc?) {
    c_switch(ttypetag(v)) {
        case(3) {
            e.k = expkind.VKINT
            e.u.ival = ivalue(v)
            break
        }
        case(19) {
            e.k = expkind.VKFLT
            e.u.nval = fltvalue(v)
            break
        }
        case(1) {
            e.k = expkind.VFALSE
            break
        }
        case(17) {
            e.k = expkind.VTRUE
            break
        }
        case(0) {
            e.k = expkind.VNIL
            break
        }
        case(4, 20) {
            e.k = expkind.VKSTR
            e.u.strval = tsvalue(v)
            break
        }
        case(_) {
        }
    }
}

// Fix an expression to return the number of results 'nresults'.
// 'e' must be a multi-ret expression (function call or vararg).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_setreturns(var fs : FuncState?; var e : expdesc?; nresults : int) {
    var pc : uint? = addr(fs.f.code[e.u.info])
    // expression is an open function call?
    if (e.k == expkind.VCALL) {
        *pc = (*pc & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((uint(nresults + 1) << uint(POS_C)) & (~(~0u << uint(SIZE_C)) << uint(POS_C)))
    } else {
        *pc = (*pc & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((uint(nresults + 1) << uint(POS_C)) & (~(~0u << uint(SIZE_C)) << uint(POS_C)))
        *pc = (*pc & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(fs.freereg) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
        luaK_reserveregs(fs, 1)
    }
}

// Convert a VKSTR to a VK
[unsafe_deref, hint(unsafe_range_check)]
def private str2K(var fs : FuncState?; var e : expdesc?) {
    e.u.info = stringK(fs, e.u.strval)
    e.k = expkind.VK
}

// Fix an expression to return one result.
// If expression is not a multi-ret expression (function call or
// vararg), it already returns one result, so nothing needs to be done.
// Function calls become VNONRELOC expressions (as its result comes
// fixed in the base register of the call), while vararg expressions
// become VRELOC (as OP_VARARG puts its results where it wants).
// (Calls are created returning one result, so that does not need
// to be fixed.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_setoneret(var fs : FuncState?; var e : expdesc?) {
    // expression is an open function call?
    if (e.k == expkind.VCALL) {
        // already returns 1 value
        // result has fixed position
        e.k = expkind.VNONRELOC
        e.u.info = GETARG_A(fs.f.code[e.u.info])
    } elif (e.k == expkind.VVARARG) {
        fs.f.code[e.u.info] = (getinstruction(fs, e) & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((2u << uint(POS_C)) &
                (~(~0u << uint(SIZE_C)) << uint(POS_C)))
        // can relocate its simple result
        e.k = expkind.VRELOC
    }
}

// Ensure that expression 'e' is not a variable (nor a <const>).
// (Expression still may have jump lists.)
[unsafe_deref, hint(unsafe_range_check)]
def luaK_dischargevars(var fs : FuncState?; var e : expdesc?) {
    c_switch(e.k) {
        case(expkind.VCONST) {
            const2exp(const2val(fs, e), e)
            break
        }
        case(expkind.VLOCAL) {
            {
                // already in a register
                let temp : int = int(e.u._c_var.ridx)
                // (can't do a direct assignment; values overlap)
                e.u.info = temp
                // becomes a non-relocatable value
                e.k = expkind.VNONRELOC
                break
            }
        }
        case(expkind.VUPVAL) {
            // move value to some (pending) register
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETUPVAL, 0, e.u.info, 0, 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXUP) {
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETTABUP, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXI) {
            freereg(fs, int(e.u.ind.t))
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETI, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXSTR) {
            freereg(fs, int(e.u.ind.t))
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETFIELD, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VINDEXED) {
            freeregs(fs, int(e.u.ind.t), int(e.u.ind.idx))
            e.u.info = luaK_codeABCk(fs, OpCode.OP_GETTABLE, 0, int(e.u.ind.t), int(e.u.ind.idx), 0)
            e.k = expkind.VRELOC
            break
        }
        case(expkind.VVARARG, expkind.VCALL) {
            luaK_setoneret(fs, e)
            break
        }
        case(_) {
            // there is one value available (somewhere)
            break
        }
    }
}

// Ensure expression value is in register 'reg', making 'e' a
// non-relocatable expression.
// (Expression still may have jump lists.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private discharge2reg(var fs : FuncState?; var e : expdesc?; reg : int) {
    luaK_dischargevars(fs, e)
    c_switch(e.k) {
        case(expkind.VNIL) {
            luaK_nil(fs, reg, 1)
            break
        }
        case(expkind.VFALSE) {
            luaK_codeABCk(fs, OpCode.OP_LOADFALSE, reg, 0, 0, 0)
            break
        }
        case(expkind.VTRUE) {
            luaK_codeABCk(fs, OpCode.OP_LOADTRUE, reg, 0, 0, 0)
            break
        }
        case(expkind.VKSTR) {
            str2K(fs, e)
        }
        case(expkind.VK) {
            // FALLTHROUGH
            luaK_codek(fs, reg, e.u.info)
            break
        }
        case(expkind.VKFLT) {
            luaK_float(fs, reg, e.u.nval)
            break
        }
        case(expkind.VKINT) {
            luaK_int(fs, reg, e.u.ival)
            break
        }
        case(expkind.VRELOC) {
            {
                var pc : uint? = addr(fs.f.code[e.u.info])
                // instruction will put result in 'reg'
                *pc = (*pc & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(reg) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
                break
            }
        }
        case(expkind.VNONRELOC) {
            if (reg != e.u.info) {
                luaK_codeABCk(fs, OpCode.OP_MOVE, reg, e.u.info, 0, 0)
            }
            break
        }
        case(_) {
            // nothing to do...
            return
        }
    }
    e.u.info = reg
    e.k = expkind.VNONRELOC
}

// Ensure expression value is in a register, making 'e' a
// non-relocatable expression.
// (Expression still may have jump lists.)
[unsafe_deref, hint(unsafe_range_check)]
def private discharge2anyreg(var fs : FuncState?; var e : expdesc?) {
    // no fixed register yet?
    if (e.k != expkind.VNONRELOC) {
        // get a register
        luaK_reserveregs(fs, 1)
        // put value there
        discharge2reg(fs, e, int(fs.freereg) - 1)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private code_loadbool(var fs : FuncState?; A : int; op : OpCode) : int {
    // those instructions may be jump targets
    luaK_getlabel(fs)
    return luaK_codeABCk(fs, op, A, 0, 0, 0)
}

// check whether list has any jump that do not produce a value
// or produce an inverted value
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private need_value(var fs : FuncState?; var list : int) : int {
    while (list != NO_JUMP) {
        let i : uint = *getjumpcontrol(fs, list)
        if (GET_OPCODE(i) != OpCode.OP_TESTSET) {
            return 1
        }
        list = getjump(fs, list)
    }
    // not found
    return 0
}

// Ensures final expression result (which includes results from its
// jump lists) is in register 'reg'.
// If expression has jumps, need to patch these jumps either to
// its final position or to "load" instructions (for those tests
// that do not produce values).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private exp2reg(var fs : FuncState?; var e : expdesc?; reg : int) {
    discharge2reg(fs, e, reg)
    // expression itself is a test?
    if (e.k == expkind.VJMP) {
        // put this jump in 't' list
        luaK_concat(fs, addr(e.t), e.u.info)
    }
    if (hasjumps(e)) {
        // position after whole expression
        var final : int
        // position of an eventual LOAD false
        var p_f : int = NO_JUMP
        // position of an eventual LOAD true
        var p_t : int = NO_JUMP
        if (need_value(fs, e.t) != 0 || need_value(fs, e.f) != 0) {
            let fj : int = (e.k == expkind.VJMP) ? NO_JUMP : luaK_jump(fs)
            // skip next inst.
            p_f = code_loadbool(fs, reg, OpCode.OP_LFALSESKIP)
            p_t = code_loadbool(fs, reg, OpCode.OP_LOADTRUE)
            // jump around these booleans if 'e' is not a test
            luaK_patchtohere(fs, fj)
        }
        final = luaK_getlabel(fs)
        patchlistaux(fs, e.f, final, reg, p_f)
        patchlistaux(fs, e.t, final, reg, p_t)
    }
    e.t = NO_JUMP
    e.f = e.t
    e.u.info = reg
    e.k = expkind.VNONRELOC
}

// Ensures final expression result is in next available register.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_exp2nextreg(var fs : FuncState?; var e : expdesc?) {
    luaK_dischargevars(fs, e)
    freeexp(fs, e)
    luaK_reserveregs(fs, 1)
    exp2reg(fs, e, int(fs.freereg) - 1)
}

// Ensures final expression result is in some (any) register
// and return that register.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_exp2anyreg(var fs : FuncState?; var e : expdesc?) : int {
    luaK_dischargevars(fs, e)
    // expression already has a register?
    if (e.k == expkind.VNONRELOC) {
        // no jumps?
        if (!hasjumps(e)) {
            // result is already in a register
            return e.u.info
        }
        // reg. is not a local?
        if (e.u.info >= luaY_nvarstack(fs)) {
            // put final result in it
            exp2reg(fs, e, e.u.info)
            return e.u.info
        }
    }
    // else expression has jumps and cannot change its register
    // to hold the jump values, because it is a local variable.
    // Go through to the default case.
    // default: use next available register
    luaK_exp2nextreg(fs, e)
    return e.u.info
}

// Ensures final expression result is either in a register
// or in an upvalue.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_exp2anyregup(var fs : FuncState?; var e : expdesc?) {
    if (e.k != expkind.VUPVAL || hasjumps(e)) {
        luaK_exp2anyreg(fs, e)
    }
}

// Ensures final expression result is either in a register
// or it is a constant.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_exp2val(var fs : FuncState?; var e : expdesc?) {
    if (e.k == expkind.VJMP || hasjumps(e)) {
        luaK_exp2anyreg(fs, e)
    } else {
        luaK_dischargevars(fs, e)
    }
}

// Try to make 'e' a K expression with an index in the range of R/K
// indices. Return true iff succeeded.
[unsafe_deref, hint(unsafe_range_check)]
def private luaK_exp2K(var fs : FuncState?; var e : expdesc?) : int {
    if (!hasjumps(e)) {
        var info : int
        // move constants to 'k'
        c_switch(e.k) {
            case(expkind.VTRUE) {
                info = boolT(fs)
                break
            }
            case(expkind.VFALSE) {
                info = boolF(fs)
                break
            }
            case(expkind.VNIL) {
                info = nilK(fs)
                break
            }
            case(expkind.VKINT) {
                info = luaK_intK(fs, e.u.ival)
                break
            }
            case(expkind.VKFLT) {
                info = luaK_numberK(fs, e.u.nval)
                break
            }
            case(expkind.VKSTR) {
                info = stringK(fs, e.u.strval)
                break
            }
            case(expkind.VK) {
                info = e.u.info
                break
            }
            case(_) {
                // not a constant
                return 0
            }
        }
        // does constant fit in 'argC'?
        if (info <= MAXINDEXRK) {
            // make expression a 'K' expression
            e.k = expkind.VK
            e.u.info = info
            return 1
        }
    }
    // else, expression doesn't fit; leave it unchanged
    return 0
}

// Ensures final expression result is in a valid R/K index
// (that is, it is either in a register or in 'k' with an index
// in the range of R/K indices).
// Returns 1 iff expression is K.
[unsafe_deref, hint(unsafe_range_check)]
def private exp2RK(var fs : FuncState?; var e : expdesc?) : int {
    if (luaK_exp2K(fs, e) != 0) {
        return 1
    } else {
        // not a constant in the right range: put it in a register
        luaK_exp2anyreg(fs, e)
        return 0
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private codeABRK(var fs : FuncState?; o : OpCode; a : int; b : int; var ec : expdesc?) {
    let k : int = exp2RK(fs, ec)
    luaK_codeABCk(fs, o, a, b, ec.u.info, k)
}

// Generate code to store result of expression 'ex' into variable 'var'.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_storevar(var fs : FuncState?; var _c_var : expdesc?; var ex : expdesc?) {
    c_switch(_c_var.k) {
        case(expkind.VLOCAL) {
            freeexp(fs, ex)
            // compute 'ex' into proper place
            exp2reg(fs, ex, int(_c_var.u._c_var.ridx))
            return
        }
        case(expkind.VUPVAL) {
            {
                let e : int = luaK_exp2anyreg(fs, ex)
                luaK_codeABCk(fs, OpCode.OP_SETUPVAL, e, _c_var.u.info, 0, 0)
                break
            }
        }
        case(expkind.VINDEXUP) {
            codeABRK(fs, OpCode.OP_SETTABUP, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(expkind.VINDEXI) {
            codeABRK(fs, OpCode.OP_SETI, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(expkind.VINDEXSTR) {
            codeABRK(fs, OpCode.OP_SETFIELD, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(expkind.VINDEXED) {
            codeABRK(fs, OpCode.OP_SETTABLE, int(_c_var.u.ind.t), int(_c_var.u.ind.idx), ex)
            break
        }
        case(_) {
            // invalid var kind to store
        }
    }
    freeexp(fs, ex)
}

// Emit SELF instruction (convert expression 'e' into 'e:key(e,').
[unsafe_deref, hint(unsafe_range_check)]
def luaK_self(var fs : FuncState?; var e : expdesc?; var key : expdesc?) {
    var ereg : int
    luaK_exp2anyreg(fs, e)
    // register where 'e' was placed
    ereg = e.u.info
    freeexp(fs, e)
    // base register for op_self
    e.u.info = int(fs.freereg)
    // self expression has a fixed register
    e.k = expkind.VNONRELOC
    // function and 'self' produced by op_self
    luaK_reserveregs(fs, 2)
    codeABRK(fs, OpCode.OP_SELF, e.u.info, ereg, key)
    freeexp(fs, key)
}

// Negate condition 'e' (where 'e' is a comparison).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private negatecondition(var fs : FuncState?; var e : expdesc?) {
    var pc : uint? = getjumpcontrol(fs, e.u.info)
    *pc = (*pc & ~(~(~0u << 1u) << uint(POS_k))) | ((uint(GETARG_k(*pc) ^ 1) << uint(POS_k)) & (~(~0u << 1u) << uint(POS_k)))
}

// Emit instruction to jump if 'e' is 'cond' (that is, if 'cond'
// is true, code will jump if 'e' is true.) Return jump position.
// Optimize when 'e' is 'not' something, inverting the condition
// and removing the 'not'.
[unsafe_deref, hint(unsafe_range_check)]
def private jumponcond(var fs : FuncState?; var e : expdesc?; cond : int) : int {
    if (e.k == expkind.VRELOC) {
        let ie : uint = getinstruction(fs, e)
        if (GET_OPCODE(ie) == OpCode.OP_NOT) {
            // remove previous OP_NOT
            removelastinstruction(fs)
            return condjump(fs, OpCode.OP_TEST, GETARG_B(ie), 0, 0, int_of(cond == 0))
        }
    }
    // else go through
    discharge2anyreg(fs, e)
    freeexp(fs, e)
    return condjump(fs, OpCode.OP_TESTSET, NO_REG, e.u.info, 0, cond)
}

// Emit code to go through if 'e' is true, jump otherwise.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_goiftrue(var fs : FuncState?; var e : expdesc?) {
    // pc of new jump
    var pc : int
    luaK_dischargevars(fs, e)
    c_switch(e.k) {
        case(expkind.VJMP) {
            // condition?
            // jump when it is false
            negatecondition(fs, e)
            // save jump position
            pc = e.u.info
            break
        }
        case(expkind.VK, expkind.VKFLT, expkind.VKINT, expkind.VKSTR, expkind.VTRUE) {
            // always true; do nothing
            pc = NO_JUMP
            break
        }
        case(_) {
            // jump when false
            pc = jumponcond(fs, e, 0)
            break
        }
    }
    // insert new jump in false list
    luaK_concat(fs, addr(e.f), pc)
    // true list jumps to here (to go through)
    luaK_patchtohere(fs, e.t)
    e.t = NO_JUMP
}

// Emit code to go through if 'e' is false, jump otherwise.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_goiffalse(var fs : FuncState?; var e : expdesc?) {
    // pc of new jump
    var pc : int
    luaK_dischargevars(fs, e)
    c_switch(e.k) {
        case(expkind.VJMP) {
            // already jump if true
            pc = e.u.info
            break
        }
        case(expkind.VNIL, expkind.VFALSE) {
            // always false; do nothing
            pc = NO_JUMP
            break
        }
        case(_) {
            // jump if true
            pc = jumponcond(fs, e, 1)
            break
        }
    }
    // insert new jump in 't' list
    luaK_concat(fs, addr(e.t), pc)
    // false list jumps to here (to go through)
    luaK_patchtohere(fs, e.f)
    e.f = NO_JUMP
}

// Code 'not e', doing constant folding.
[unsafe_deref, hint(unsafe_range_check)]
def private codenot(var fs : FuncState?; var e : expdesc?) {
    c_switch(e.k) {
        case(expkind.VNIL, expkind.VFALSE) {
            // true == not nil == not false
            e.k = expkind.VTRUE
            break
        }
        case(expkind.VK, expkind.VKFLT, expkind.VKINT, expkind.VKSTR, expkind.VTRUE) {
            // false == not "x" == not 0.5 == not 1 == not true
            e.k = expkind.VFALSE
            break
        }
        case(expkind.VJMP) {
            negatecondition(fs, e)
            break
        }
        case(expkind.VRELOC, expkind.VNONRELOC) {
            discharge2anyreg(fs, e)
            freeexp(fs, e)
            e.u.info = luaK_codeABCk(fs, OpCode.OP_NOT, 0, e.u.info, 0, 0)
            e.k = expkind.VRELOC
            break
        }
        case(_) {
            // cannot happen
        }
    }
    {
        // interchange true and false lists
        let temp : int = e.f
        e.f = e.t
        e.t = temp
    }
    // values are useless when negated
    removevalues(fs, e.f)
    removevalues(fs, e.t)
}

// Check whether expression 'e' is a short literal string
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private isKstr(var fs : FuncState?; var e : expdesc?) : int {
    return int_of(e.k == expkind.VK && !hasjumps(e) && e.u.info <= MAXARG_B && ttisshrstring(addr(fs.f.k[e.u.info])))
}

// Check whether expression 'e' is a literal integer.
[unsafe_deref, hint(unsafe_range_check)]
def private isKint(var e : expdesc?) : int {
    return int_of(e.k == expkind.VKINT && !hasjumps(e))
}

// Check whether expression 'e' is a literal integer in
// proper range to fit in register C
[unsafe_deref, hint(unsafe_range_check)]
def private isCint(var e : expdesc?) : int {
    return int_of(isKint(e) != 0 && (uint64(e.u.ival) <= uint64(MAXARG_C)))
}

// Check whether expression 'e' is a literal integer in
// proper range to fit in register sC
[unsafe_deref, hint(unsafe_range_check)]
def private isSCint(var e : expdesc?) : int {
    return int_of(isKint(e) != 0 && fitsC(e.u.ival) != 0)
}

// Check whether expression 'e' is a literal integer or float in
// proper range to fit in a register (sB or sC).
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private isSCnumber(var e : expdesc?; var pi : int?; var isfloat : int?) : int {
    var i : int64
    if (e.k == expkind.VKINT) {
        i = e.u.ival
    } elif (e.k == expkind.VKFLT && luaV_flttointeger(e.u.nval, addr(i), F2Imod.F2Ieq) != 0) {
        *isfloat = 1
    } else {
        // not a number
        return 0
    }
    if (!hasjumps(e) && fitsC(i) != 0) {
        *pi = int(i) + OFFSET_sC
        return 1
    } else {
        return 0
    }
}

// Create expression 't[k]'. 't' must have its final result already in a
// register or upvalue. Upvalues can only be indexed by literal strings.
// Keys can be literal strings in the constant table or arbitrary
// values in registers.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_indexed(var fs : FuncState?; var t : expdesc?; var k : expdesc?) {
    if (k.k == expkind.VKSTR) {
        str2K(fs, k)
    }
    // upvalue indexed by non 'Kstr'?
    if (t.k == expkind.VUPVAL && isKstr(fs, k) == 0) {
        // put it in a register
        luaK_exp2anyreg(fs, t)
    }
    if (t.k == expkind.VUPVAL) {
        // upvalue index
        let temp : int = t.u.info
        // (can't do a direct assignment; values overlap)
        t.u.ind.t = uint8(temp)
        // literal short string
        t.u.ind.idx = int16(k.u.info)
        t.k = expkind.VINDEXUP
    } else {
        // register index of the table
        t.u.ind.t = uint8((t.k == expkind.VLOCAL) ? int(t.u._c_var.ridx) : t.u.info)
        if (isKstr(fs, k) != 0) {
            // literal short string
            t.u.ind.idx = int16(k.u.info)
            t.k = expkind.VINDEXSTR
        } elif (isCint(k) != 0) {
            // int. constant in proper range
            t.u.ind.idx = int16(int(k.u.ival))
            t.k = expkind.VINDEXI
        } else {
            // register
            t.u.ind.idx = int16(luaK_exp2anyreg(fs, k))
            t.k = expkind.VINDEXED
        }
    }
}

// Return false if folding can raise an error.
// Bitwise operations need operands convertible to integers; division
// operations cannot have 0 as divisor.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private validop(op : int; var v1 : TValue?; var v2 : TValue?) : int {
    c_switch(op) {
        case(7, 8, 9, 10, 11, 13) {
            {
                // conversion errors
                var i : int64
                return int_of(luaV_tointegerns(v1, addr(i), F2Imod.F2Ieq) != 0 && luaV_tointegerns(v2, addr(i), F2Imod.F2Ieq) != 0)
            }
        }
        case(5, 6, 3) {
            // division by 0
            return int_of(nvalue(v2) != 0.0lf)
        }
        case(_) {
            // everything else is valid
            return 1
        }
    }
}

// Try to "constant-fold" an operation; return 1 iff successful.
// (In this case, 'e1' has the final result.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private constfolding(var fs : FuncState?; op : int; var e1 : expdesc?; var e2 : expdesc?) : int {
    var v1 : TValue
    var v2 : TValue
    var res : TValue
    if (tonumeral(e1, addr(v1)) == 0 || tonumeral(e2, addr(v2)) == 0 || validop(op, addr(v1), addr(v2)) == 0) {
        // non-numeric operands or not safe to fold
        return 0
    }
    // does operation
    luaO_rawarith(fs.ls.L, op, addr(v1), addr(v2), addr(res))
    if (ttisinteger(addr(res))) {
        e1.k = expkind.VKINT
        e1.u.ival = ivalue(addr(res))
    } else {
        // folds neither NaN nor 0.0 (to avoid problems with -0.0)
        let n : double = fltvalue(addr(res))
        if (luai_numisnan(n) || n == 0.0lf) {
            return 0
        }
        e1.k = expkind.VKFLT
        e1.u.nval = n
    }
    return 1
}

// Convert a BinOpr to an OpCode (ORDER OPR - ORDER OP)
[unsafe_deref, hint(unsafe_range_check)]
def private binopr2op(opr : BinOpr; baser : BinOpr; base : OpCode) : OpCode {
    return enum_from_int(type<OpCode>, int(opr) - int(baser) + int(base))
}

// Convert a UnOpr to an OpCode (ORDER OPR - ORDER OP)
[unsafe_deref, hint(unsafe_range_check)]
def private unopr2op(opr : UnOpr) : OpCode {
    return enum_from_int(type<OpCode>, int(opr) - int(UnOpr.OPR_MINUS) + int(OpCode.OP_UNM))
}

// Convert a BinOpr to a tag method (ORDER OPR - ORDER TM)
[unsafe_deref, hint(unsafe_range_check)]
def private binopr2TM(opr : BinOpr) : TMS {
    return enum_from_int(type<TMS>, int(opr) - int(BinOpr.OPR_ADD) + int(TMS.TM_ADD))
}

// Emit code for unary expressions that "produce values"
// (everything but 'not').
// Expression to produce final result will be encoded in 'e'.
[unsafe_deref, hint(unsafe_range_check)]
def private codeunexpval(var fs : FuncState?; op : OpCode; var e : expdesc?; line : int) {
    // opcodes operate only on registers
    let r : int = luaK_exp2anyreg(fs, e)
    freeexp(fs, e)
    // generate opcode
    e.u.info = luaK_codeABCk(fs, op, 0, r, 0, 0)
    // all those operations are relocatable
    e.k = expkind.VRELOC
    luaK_fixline(fs, line)
}

// Emit code for binary expressions that "produce values"
// (everything but logical operators 'and'/'or' and comparison
// operators).
// Expression to produce final result will be encoded in 'e1'.
[unsafe_deref, hint(unsafe_range_check)]
def private finishbinexpval(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?; op : OpCode; v2 : int; flip : int; line : int; mmop : OpCode;
                            event : TMS) {
    let v1 : int = luaK_exp2anyreg(fs, e1)
    let pc : int = luaK_codeABCk(fs, op, 0, v1, v2, 0)
    freeexps(fs, e1, e2)
    e1.u.info = pc
    // all those operations are relocatable
    e1.k = expkind.VRELOC
    luaK_fixline(fs, line)
    // to call metamethod
    luaK_codeABCk(fs, mmop, v1, v2, int(event), flip)
    luaK_fixline(fs, line)
}

// Emit code for binary expressions that "produce values" over
// two registers.
[unsafe_deref, hint(unsafe_range_check)]
def private codebinexpval(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    let op : OpCode = binopr2op(opr, BinOpr.OPR_ADD, OpCode.OP_ADD)
    // make sure 'e2' is in a register
    let v2 : int = luaK_exp2anyreg(fs, e2)
    // 'e1' must be already in a register or it is a constant
    finishbinexpval(fs, e1, e2, op, v2, 0, line, OpCode.OP_MMBIN, binopr2TM(opr))
}

// Code binary operators with immediate operands.
[unsafe_deref, hint(unsafe_range_check)]
def private codebini(var fs : FuncState?; op : OpCode; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int; event : TMS) {
    // immediate operand
    let v2 : int = int2sC(int(e2.u.ival))
    finishbinexpval(fs, e1, e2, op, v2, flip, line, OpCode.OP_MMBINI, event)
}

// Code binary operators with K operand.
[unsafe_deref, hint(unsafe_range_check)]
def private codebinK(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    let event : TMS = binopr2TM(opr)
    // K index
    let v2 : int = e2.u.info
    let op : OpCode = binopr2op(opr, BinOpr.OPR_ADD, OpCode.OP_ADDK)
    finishbinexpval(fs, e1, e2, op, v2, flip, line, OpCode.OP_MMBINK, event)
}

// Try to code a binary operator negating its second operand.
// For the metamethod, 2nd operand must keep its original value.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private finishbinexpneg(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?; op : OpCode; line : int; event : TMS) : int {
    if (isKint(e2) == 0) {
        // not an integer constant
        return 0
    } else {
        let i2 : int64 = e2.u.ival
        if (!(fitsC(i2) != 0 && fitsC(-i2) != 0)) {
            // not in the proper range
            return 0
        } else {
            // operating a small integer constant
            let v2 : int = int(i2)
            finishbinexpval(fs, e1, e2, op, int2sC(-v2), 0, line, OpCode.OP_MMBINI, event)
            // correct metamethod argument
            fs.f.code[fs.pc - 1] = (fs.f.code[fs.pc - 1] & ~(~(~0u << uint(SIZE_B)) << uint(POS_B))) | ((uint(int2sC(v2)) << uint(POS_B)) &
                    (~(~0u << uint(SIZE_B)) << uint(POS_B)))
            // successfully coded
            return 1
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private swapexps(var e1 : expdesc?; var e2 : expdesc?) {
    // swap 'e1' and 'e2'
    var temp : expdesc = *e1
    *e1 = *e2
    *e2 = temp
}

// Code binary operators with no constant operand.
[unsafe_deref, hint(unsafe_range_check)]
def private codebinNoK(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    if (flip != 0) {
        // back to original order
        swapexps(e1, e2)
    }
    // use standard operators
    codebinexpval(fs, opr, e1, e2, line)
}

// Code arithmetic operators ('+', '-', ...). If second operand is a
// constant in the proper range, use variant opcodes with K operands.
[unsafe_deref, hint(unsafe_range_check)]
def private codearith(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; flip : int; line : int) {
    // K operand?
    if (tonumeral(e2, null) != 0 && luaK_exp2K(fs, e2) != 0) {
        codebinK(fs, opr, e1, e2, flip, line)
    } else {
        // 'e2' is neither an immediate nor a K operand
        codebinNoK(fs, opr, e1, e2, flip, line)
    }
}

// Code commutative operators ('+', '*'). If first operand is a
// numeric constant, change order of operands to try to use an
// immediate or K operator.
[unsafe_deref, hint(unsafe_range_check)]
def private codecommutative(var fs : FuncState?; op : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var flip : int = 0
    // is first operand a numeric constant?
    if (tonumeral(e1, null) != 0) {
        // change order
        swapexps(e1, e2)
        flip = 1
    }
    // immediate operand?
    if (op == BinOpr.OPR_ADD && isSCint(e2) != 0) {
        codebini(fs, OpCode.OP_ADDI, e1, e2, flip, line, TMS.TM_ADD)
    } else {
        codearith(fs, op, e1, e2, flip, line)
    }
}

// Code bitwise operations; they are all commutative, so the function
// tries to put an integer constant as the 2nd operand (a K operand).
[unsafe_deref, hint(unsafe_range_check)]
def private codebitwise(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var flip : int = 0
    if (e1.k == expkind.VKINT) {
        // 'e2' will be the constant operand
        swapexps(e1, e2)
        flip = 1
    }
    // K operand?
    if (e2.k == expkind.VKINT && luaK_exp2K(fs, e2) != 0) {
        codebinK(fs, opr, e1, e2, flip, line)
    } else {
        // no constants
        codebinNoK(fs, opr, e1, e2, flip, line)
    }
}

// Emit code for order comparisons. When using an immediate operand,
// 'isfloat' tells whether the original value was a float.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private codeorder(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?) {
    var r1 : int
    var r2 : int
    var im : int
    var isfloat : int = 0
    var op : OpCode
    if (isSCnumber(e2, addr(im), addr(isfloat)) != 0) {
        // use immediate operand
        r1 = luaK_exp2anyreg(fs, e1)
        r2 = im
        op = binopr2op(opr, BinOpr.OPR_LT, OpCode.OP_LTI)
    } elif (isSCnumber(e1, addr(im), addr(isfloat)) != 0) {
        // transform (A < B) to (B > A) and (A <= B) to (B >= A)
        r1 = luaK_exp2anyreg(fs, e2)
        r2 = im
        op = binopr2op(opr, BinOpr.OPR_LT, OpCode.OP_GTI)
    } else {
        // regular case, compare two registers
        r1 = luaK_exp2anyreg(fs, e1)
        r2 = luaK_exp2anyreg(fs, e2)
        op = binopr2op(opr, BinOpr.OPR_LT, OpCode.OP_LT)
    }
    freeexps(fs, e1, e2)
    e1.u.info = condjump(fs, op, r1, r2, isfloat, 1)
    e1.k = expkind.VJMP
}

// Emit code for equality comparisons ('==', '~=').
// 'e1' was already put as RK by 'luaK_infix'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private codeeq(var fs : FuncState?; opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?) {
    var r1 : int
    var r2 : int
    var im : int
    // not needed here, but kept for symmetry
    var isfloat : int = 0
    var op : OpCode
    if (e1.k != expkind.VNONRELOC) {
        swapexps(e1, e2)
    }
    // 1st expression must be in register
    r1 = luaK_exp2anyreg(fs, e1)
    if (isSCnumber(e2, addr(im), addr(isfloat)) != 0) {
        op = OpCode.OP_EQI
        // immediate operand
        r2 = im
    } elif (exp2RK(fs, e2) != 0) {
        // 2nd expression is constant?
        op = OpCode.OP_EQK
        // constant index
        r2 = e2.u.info
    } else {
        // will compare two registers
        op = OpCode.OP_EQ
        r2 = luaK_exp2anyreg(fs, e2)
    }
    freeexps(fs, e1, e2)
    e1.u.info = condjump(fs, op, r1, r2, isfloat, int_of(opr == BinOpr.OPR_EQ))
    e1.k = expkind.VJMP
}

// Apply prefix operation 'op' to expression 'e'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_prefix(var fs : FuncState?; opr : UnOpr; var e : expdesc?; line : int) {
    luaK_dischargevars(fs, e)
    c_switch(opr) {
        case(UnOpr.OPR_MINUS, UnOpr.OPR_BNOT) {
            // use 'ef' as fake 2nd operand
            if (constfolding(fs, int(uint(opr) + uint(LUA_OPUNM)), e, addr(luaK_prefix_ef)) != 0) {
                break
            }
        }
        case(UnOpr.OPR_LEN) {
            // else FALLTHROUGH
            codeunexpval(fs, unopr2op(opr), e, line)
            break
        }
        case(UnOpr.OPR_NOT) {
            codenot(fs, e)
            break
        }
        case(_) {
        }
    }
}

// Process 1st operand 'v' of binary operation 'op' before reading
// 2nd operand.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_infix(var fs : FuncState?; op : BinOpr; var v : expdesc?) {
    luaK_dischargevars(fs, v)
    c_switch(op) {
        case(BinOpr.OPR_AND) {
            // go ahead only if 'v' is true
            luaK_goiftrue(fs, v)
            break
        }
        case(BinOpr.OPR_OR) {
            // go ahead only if 'v' is false
            luaK_goiffalse(fs, v)
            break
        }
        case(BinOpr.OPR_CONCAT) {
            // operand must be on the stack
            luaK_exp2nextreg(fs, v)
            break
        }
        case(BinOpr.OPR_ADD, BinOpr.OPR_SUB, BinOpr.OPR_MUL, BinOpr.OPR_DIV, BinOpr.OPR_IDIV, BinOpr.OPR_MOD, BinOpr.OPR_POW, BinOpr.OPR_BAND, BinOpr.OPR_BOR, BinOpr.OPR_BXOR, BinOpr.OPR_SHL, BinOpr.OPR_SHR) {
            if (tonumeral(v, null) == 0) {
                luaK_exp2anyreg(fs, v)
            }
            // else keep numeral, which may be folded or used as an immediate
            // operand
            break
        }
        case(BinOpr.OPR_EQ, BinOpr.OPR_NE) {
            if (tonumeral(v, null) == 0) {
                exp2RK(fs, v)
            }
            // else keep numeral, which may be an immediate operand
            break
        }
        case(BinOpr.OPR_LT, BinOpr.OPR_LE, BinOpr.OPR_GT, BinOpr.OPR_GE) {
            {
                var dummy : int
                var dummy2 : int
                if (isSCnumber(v, addr(dummy), addr(dummy2)) == 0) {
                    luaK_exp2anyreg(fs, v)
                }
                // else keep numeral, which may be an immediate operand
                break
            }
        }
        case(_) {
        }
    }
}

// Create code for '(e1 .. e2)'.
// For '(e1 .. e2.1 .. e2.2)' (which is '(e1 .. (e2.1 .. e2.2))',
// because concatenation is right associative), merge both CONCATs.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private codeconcat(var fs : FuncState?; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    var ie2 : uint? = previousinstruction(fs)
    // is 'e2' a concatenation?
    if (GET_OPCODE(*ie2) == OpCode.OP_CONCAT) {
        // # of elements concatenated in 'e2'
        let n : int = GETARG_B(*ie2)
        freeexp(fs, e2)
        // correct first element ('e1')
        *ie2 = (*ie2 & ~(~(~0u << uint(SIZE_A)) << uint(POS_A))) | ((uint(e1.u.info) << uint(POS_A)) & (~(~0u << uint(SIZE_A)) << uint(POS_A)))
        // will concatenate one more element
        *ie2 = (*ie2 & ~(~(~0u << uint(SIZE_B)) << uint(POS_B))) | ((uint(n + 1) << uint(POS_B)) & (~(~0u << uint(SIZE_B)) << uint(POS_B)))
    } else {
        // 'e2' is not a concatenation
        // new concat opcode
        luaK_codeABCk(fs, OpCode.OP_CONCAT, e1.u.info, 2, 0, 0)
        freeexp(fs, e2)
        luaK_fixline(fs, line)
    }
}

// Finalize code for binary operation, after reading 2nd operand.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_posfix(var fs : FuncState?; var opr : BinOpr; var e1 : expdesc?; var e2 : expdesc?; line : int) {
    luaK_dischargevars(fs, e2)
    if (foldbinop(opr) && constfolding(fs, int(uint(opr) + uint(LUA_OPADD)), e1, e2) != 0) {
        // done by folding
        return
    }
    c_switch(opr) {
        case(BinOpr.OPR_AND) {
            // list closed by 'luaK_infix'
            luaK_concat(fs, addr(e2.f), e1.f)
            *e1 = *e2
            break
        }
        case(BinOpr.OPR_OR) {
            // list closed by 'luaK_infix'
            luaK_concat(fs, addr(e2.t), e1.t)
            *e1 = *e2
            break
        }
        case(BinOpr.OPR_CONCAT) {
            // e1 .. e2
            luaK_exp2nextreg(fs, e2)
            codeconcat(fs, e1, e2, line)
            break
        }
        case(BinOpr.OPR_ADD, BinOpr.OPR_MUL) {
            codecommutative(fs, opr, e1, e2, line)
            break
        }
        case(BinOpr.OPR_SUB) {
            if (finishbinexpneg(fs, e1, e2, OpCode.OP_ADDI, line, TMS.TM_SUB) != 0) {
                // coded as (r1 + -I)
                break
            }
        }
        case(BinOpr.OPR_DIV, BinOpr.OPR_IDIV, BinOpr.OPR_MOD, BinOpr.OPR_POW) {
            // ELSE
            // FALLTHROUGH
            codearith(fs, opr, e1, e2, 0, line)
            break
        }
        case(BinOpr.OPR_BAND, BinOpr.OPR_BOR, BinOpr.OPR_BXOR) {
            codebitwise(fs, opr, e1, e2, line)
            break
        }
        case(BinOpr.OPR_SHL) {
            if (isSCint(e1) != 0) {
                swapexps(e1, e2)
                // I << r2
                codebini(fs, OpCode.OP_SHLI, e1, e2, 1, line, TMS.TM_SHL)
            } elif (finishbinexpneg(fs, e1, e2, OpCode.OP_SHRI, line, TMS.TM_SHL) != 0) {
                // coded as (r1 >> -I)
            } else {
                // regular case (two registers)
                codebinexpval(fs, opr, e1, e2, line)
            }
            break
        }
        case(BinOpr.OPR_SHR) {
            if (isSCint(e2) != 0) {
                // r1 >> I
                codebini(fs, OpCode.OP_SHRI, e1, e2, 0, line, TMS.TM_SHR)
            } else {
                // regular case (two registers)
                codebinexpval(fs, opr, e1, e2, line)
            }
            break
        }
        case(BinOpr.OPR_EQ, BinOpr.OPR_NE) {
            codeeq(fs, opr, e1, e2)
            break
        }
        case(BinOpr.OPR_GT, BinOpr.OPR_GE) {
            // '(a > b)' <=> '(b < a)'; '(a >= b)' <=> '(b <= a)'
            swapexps(e1, e2)
            opr = enum_from_int(type<BinOpr>, int(uint(opr) - uint(BinOpr.OPR_GT) + uint(BinOpr.OPR_LT)))
        }
        case(BinOpr.OPR_LT, BinOpr.OPR_LE) {
            // FALLTHROUGH
            codeorder(fs, opr, e1, e2)
            break
        }
        case(_) {
        }
    }
}

// Change line information associated with current position, by removing
// previous info and adding it again with new line.
[unsafe_deref, hint(unsafe_range_check)]
def luaK_fixline(var fs : FuncState?; line : int) {
    removelastlineinfo(fs)
    savelineinfo(fs, fs.f, line)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_settablesize(var fs : FuncState?; pc : int; ra : int; asize : int; hsize : int) {
    var inst : uint? = addr(fs.f.code[pc])
    // hash size
    let rb : int = (hsize != 0) ? luaO_ceillog2(uint(hsize)) + 1 : 0
    // higher bits of array size
    let extra : int = asize / (MAXARG_C + 1)
    // lower bits of array size
    let rc : int = asize % (MAXARG_C + 1)
    // true iff needs extra argument
    let k : int = int_of(extra > 0)
    *inst = (uint(OpCode.OP_NEWTABLE) << uint(POS_OP)) | (uint(ra) << uint(POS_A)) | (uint(rb) << uint(POS_B)) | (uint(rc) << uint(POS_C)) | (uint(k) <<
            uint(POS_k))
    inst[1] = (uint(OpCode.OP_EXTRAARG) << uint(POS_OP)) | (uint(extra) << uint(POS_A))
}

// Emit a SETLIST instruction.
// 'base' is register that keeps table;
// 'nelems' is #table plus those to be stored now;
// 'tostore' is number of values (in registers 'base + 1',...) to add to
// table (or LUA_MULTRET to add up to stack top).
[unsafe_deref, hint(unsafe_range_check)]
def luaK_setlist(var fs : FuncState?; base : int; var nelems : int; var tostore : int) {
    if (tostore == LUA_MULTRET) {
        tostore = 0
    }
    if (nelems <= MAXARG_C) {
        luaK_codeABCk(fs, OpCode.OP_SETLIST, base, tostore, nelems, 0)
    } else {
        let extra : int = nelems / (MAXARG_C + 1)
        nelems %= MAXARG_C + 1
        luaK_codeABCk(fs, OpCode.OP_SETLIST, base, tostore, nelems, 1)
        codeextraarg(fs, extra)
    }
    // free registers with list values
    fs.freereg = uint8(base + 1)
}

// return the final target of a jump (skipping jumps to jumps)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private finaltarget(var code : uint?; var i : int) : int {
    // avoid infinite loops
    for (count in range(100)) {
        let pc : uint = code[i]
        if (GET_OPCODE(pc) != OpCode.OP_JMP) {
            break
        } else {
            i += GETARG_sJ(pc) + 1
        }
    }
    return i
}

// Do a final pass over the code of a function, doing small peephole
// optimizations and adjustments.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaK_finish(var fs : FuncState?) {
    var i : int
    var p : Proto? = fs.f
    i = 0
    while (i < fs.pc) {
        var pc : uint? = addr(p.code[i])
        c_switch(GET_OPCODE(*pc)) {
            case(OpCode.OP_RETURN0, OpCode.OP_RETURN1) {
                if (!(fs.needclose != 0 || p.is_vararg != 0)) {
                    // no extra work
                    break
                }
                // else use OP_RETURN to do the extra work
                *pc = (*pc & ~(~(~0u << uint(SIZE_OP)) << uint(POS_OP))) | ((uint(OpCode.OP_RETURN) << uint(POS_OP)) &
                        (~(~0u << uint(SIZE_OP)) << uint(POS_OP)))
            }
            case(OpCode.OP_RETURN, OpCode.OP_TAILCALL) {
                // FALLTHROUGH
                if (fs.needclose != 0) {
                    // signal that it needs to close
                    *pc = (*pc & ~(~(~0u << 1u) << uint(POS_k))) | ((1u << uint(POS_k)) & (~(~0u << 1u) << uint(POS_k)))
                }
                if (p.is_vararg != 0) {
                    // signal that it is vararg
                    *pc = (*pc & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((uint(int(p.numparams) + 1) << uint(POS_C)) &
                            (~(~0u << uint(SIZE_C)) << uint(POS_C)))
                }
                break
            }
            case(OpCode.OP_JMP) {
                {
                    let target : int = finaltarget(p.code, i)
                    fixjump(fs, i, target)
                    break
                }
            }
            case(_) {
                break
            }
        }
        i++
    }
}

