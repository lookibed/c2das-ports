[unsafe_deref, hint(unsafe_range_check)]
def private luaB_assert(var L : lua_State?) : int {
    // condition is true?
    if (lua_toboolean(L, 1) != 0) {
        // return all arguments
        return lua_gettop(L)
    } else {
        // error
        // there must be a condition
        luaL_checkany(L, 1)
        // remove it
        lua_remove(L, 1)
        // default message
        lua_pushstring(L, cstr("assertion failed!"))
        // leave only message (default if no other one)
        lua_settop(L, 1)
        // call 'error'
        return luaB_error(L)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaB_select(var L : lua_State?) : int {
    let n : int = lua_gettop(L)
    if (lua_type(L, 1) == LUA_TSTRING && *lua_tostring(L, 1) == '#') {
        lua_pushinteger(L, int64(n - 1))
        return 1
    } else {
        var i : int64 = luaL_checkinteger(L, 1)
        if (i < 0l) {
            i = int64(n) + i
        } elif (i > int64(n)) {
            i = int64(n)
        }
        let _t0 = 1l <= i || luaL_argerror(L, 1, cstr("index out of range")) != 0
        return n - int(i)
    }
}

// Continuation function for 'pcall' and 'xpcall'. Both functions
// already pushed a 'true' before doing the call, so in case of success
// 'finishpcall' only has to return everything in the stack minus
// 'extra' values (where 'extra' is exactly the number of items to be
// ignored).
[unsafe_deref, hint(unsafe_range_check)]
def private finishpcall(var L : lua_State?; status : int; extra : int64) : int {
    // error?
    if (status != LUA_OK && status != LUA_YIELD) {
        // first result (false)
        lua_pushboolean(L, 0)
        // error message
        lua_pushvalue(L, -2)
        // return false, msg
        return 2
    } else {
        // return all results
        return lua_gettop(L) - int(extra)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_pcall(var L : lua_State?) : int {
    var status : int
    luaL_checkany(L, 1)
    // first result if no errors
    lua_pushboolean(L, 1)
    // put it in place
    lua_insert(L, 1)
    status = lua_pcallk(L, lua_gettop(L) - 2, LUA_MULTRET, 0, 0l, @@finishpcall)
    return finishpcall(L, status, 0l)
}

// Do a protected call with error handling. After 'lua_rotate', the
// stack will have <f, err, true, f, [args...]>; so, the function passes
// 2 to 'finishpcall' to skip the 2 first values when returning results.
[unsafe_deref, hint(unsafe_range_check)]
def private luaB_xpcall(var L : lua_State?) : int {
    var status : int
    let n : int = lua_gettop(L)
    // check error function
    luaL_checktype(L, 2, LUA_TFUNCTION)
    // first result
    lua_pushboolean(L, 1)
    // function
    lua_pushvalue(L, 1)
    // move them below function's arguments
    lua_rotate(L, 3, 2)
    status = lua_pcallk(L, n - 2, LUA_MULTRET, 2, 2l, @@finishpcall)
    return finishpcall(L, status, 2l)
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_tostring(var L : lua_State?) : int {
    luaL_checkany(L, 1)
    luaL_tolstring(L, 1, null)
    return 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaopen_base(var L : lua_State?) : int {
    // open lib into global table
    lua_pushglobaltable(L)
    luaL_setfuncs(L, addr(base_funcs[0]), 0)
    // set global _G
    lua_pushvalue(L, -1)
    lua_setfield(L, -2, cstr("_G"))
    // set global _VERSION
    lua_pushstring(L, cstr("Lua 5.4"))
    lua_setfield(L, -2, cstr("_VERSION"))
    return 1
}

