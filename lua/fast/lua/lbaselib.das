        // already a number?
        if (lua_type(L, 1) == LUA_TNUMBER) {
            // yes; return it
            lua_settop(L, 1)
            return 1
        } else {
            var l : uint64
            var s : uint8? = lua_tolstring(L, 1, addr(l))
            if (s != null && lua_stringtonumber(L, s) == l + 1ul) {
                // successful conversion to number
                return 1
            }
            // else not a number
            // (but there must be some parameter)
            luaL_checkany(L, 1)
        }
    } else {
        var l : uint64
        var s : uint8?
        // to avoid warnings
        var n : int64 = 0l
        let base : int64 = luaL_checkinteger(L, 2)
        // no numbers as strings
        luaL_checktype(L, 1, LUA_TSTRING)
        s = lua_tolstring(L, 1, addr(l))
        let _t0 = 2l <= base && base <= 36l || luaL_argerror(L, 2, cstr("base out of range")) != 0
        if (b_str2int(s, int(base), addr(n)) == s + l) {
            lua_pushinteger(L, n)
            return 1
        }
    }
    // else not a number
    // else not a number
    // not a number
    luaL_pushfail(L)
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_error(var L : lua_State?) : int {
