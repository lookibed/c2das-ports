[c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaB_print(var L : lua_State?) : int {
    // number of arguments
    let n : int = lua_gettop(L)
    var i : int
    // for each argument
    i = 1
    while (i <= n) {
        var l : uint64
        // convert it to string
        var s : uint8? = luaL_tolstring(L, i, addr(l))
        // not the first element?
        if (i > 1) {
            // add a tab before it
            crt::fwrite(reinterpret<void?>(cstr("\t")), uint64(typeinfo sizeof(type<uint8>)), 1ul, crt::c_stdout())
        }
        // print it
        crt::fwrite(reinterpret<void?>(s), uint64(typeinfo sizeof(type<uint8>)), l, crt::c_stdout())
        // pop result
        lua_pop(L, 1)
        i++
    }
    crt::fwrite(reinterpret<void?>(cstr("\n")), uint64(typeinfo sizeof(type<uint8>)), 1ul, crt::c_stdout())
    crt::fflush(crt::c_stdout())
    return 0
}

// Creates a warning with all given arguments.
// Check first for errors; otherwise an error may interrupt
// the composition of a warning, leaving it unfinished.
[unsafe_deref, hint(unsafe_range_check)]
def private luaB_warn(var L : lua_State?) : int {
    // number of arguments
    let n : int = lua_gettop(L)
    var i : int
    // at least one argument
    luaL_checkstring(L, 1)
    i = 2
    while (i <= n) {
        // make sure all arguments are strings
        luaL_checkstring(L, i)
        i++
    }
    // compose warning
    for (i1 in range(1, n)) {
        lua_warning(L, lua_tostring(L, i1), 1)
    }
    // close warning
    lua_warning(L, lua_tostring(L, n), 0)
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private b_str2int(var s : uint8?; base : int; var pn : int64?) : uint8? {
    var n : uint64 = 0ul
    var neg : int = 0
    // skip initial spaces
    s += crt::strspn(s, cstr(" \f\n\r\t\v"))
    // handle sign
    if (*s == '-') {
        s++
        neg = 1
    } elif (*s == '+') {
        s++
    }
    // no digit?
    if (crt::isalnum(int(*s)) == 0) {
        return null
    }
    c_do_while(crt::isalnum(int(*s)) != 0) {
        let digit : int = crt::isdigit(int(*s)) != 0 ? int(*s) - '0' : (crt::toupper(int(*s)) - 'A') + 10
        // invalid numeral
        if (digit >= base) {
            return null
        }
        n = n * uint64(base) + uint64(digit)
        s++
    }
    // skip trailing spaces
    s += crt::strspn(s, cstr(" \f\n\r\t\v"))
    *pn = int64(neg != 0 ? (uint64(0u) - n) : n)
    return s
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaB_tonumber(var L : lua_State?) : int {
    // standard conversion?
