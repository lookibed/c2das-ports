// Traversal function for 'ipairs'
[unsafe_deref, hint(unsafe_range_check)]
def private ipairsaux(var L : lua_State?) : int {
    var i : int64 = luaL_checkinteger(L, 2)
    i += int64(1)
    lua_pushinteger(L, i)
    return (lua_geti(L, 1, i) == LUA_TNIL) ? 1 : 2
}

// 'ipairs' function. Returns 'ipairsaux', given "table", 0.
// (The given "table" may not be a table.)
[unsafe_deref, hint(unsafe_range_check)]
def private luaB_ipairs(var L : lua_State?) : int {
    luaL_checkany(L, 1)
    // iteration function
    lua_pushcclosure(L, @@ipairsaux, 0)
    // state
    lua_pushvalue(L, 1)
    // initial value
    lua_pushinteger(L, 0l)
    return 3
}

[unsafe_deref, hint(unsafe_range_check)]
def private load_aux(var L : lua_State?; status : int; envidx : int) : int {
    if (status == LUA_OK) {
        // 'env' parameter?
        if (envidx != 0) {
            // environment for loaded function
            lua_pushvalue(L, envidx)
            // set it as 1st upvalue
            if (lua_setupvalue(L, -2, 1) == null) {
                // remove 'env' if not used by previous call
                lua_pop(L, 1)
            }
        }
        return 1
    } else {
        // error (message is on top of the stack)
        luaL_pushfail(L)
        // put before error message
        lua_insert(L, -2)
        // return fail plus error message
        return 2
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private luaB_loadfile(var L : lua_State?) : int {
    var fname : uint8? = luaL_optlstring(L, 1, null, null)
    var mode : uint8? = luaL_optlstring(L, 2, null, null)
    // 'env' index or 0 if no 'env'
    let env : int = !lua_isnone(L, 3) ? 3 : 0
    let status : int = luaL_loadfilex(L, fname, mode)
    return load_aux(L, status, env)
}

// Reader for generic 'load' function: 'lua_load' uses the
// stack for internal stuff, so the reader cannot change the
// stack top. Instead, it keeps its resulting string in a
// reserved slot inside the stack.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private generic_reader(var L : lua_State?; var ud : void?; var size : uint64?) : uint8? {
    // not used
    luaL_checkstack(L, 2, cstr("too many nested functions"))
    // get function
    lua_pushvalue(L, 1)
    // call it
    lua_call(L, 0, 1)
    if (lua_isnil(L, -1)) {
        // pop result
        lua_pop(L, 1)
        *size = 0ul
        return null
    } elif (lua_isstring(L, -1) == 0) {
        luaL_error`va(L, cstr("reader function must return a string"), VaNone())
    }
    // save string in reserved slot
    lua_copy(L, -1, RESERVEDSLOT)
    lua_settop(L, -1 - 1)
    return lua_tolstring(L, RESERVEDSLOT, size)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private luaB_load(var L : lua_State?) : int {
    var status : int
    var l : uint64
    var s : uint8? = lua_tolstring(L, 1, addr(l))
    var mode : uint8? = luaL_optlstring(L, 3, cstr("bt"), null)
    // 'env' index or 0 if no 'env'
    let env : int = !lua_isnone(L, 4) ? 4 : 0
    // loading a string?
    if (s != null) {
        var chunkname : uint8? = luaL_optstring(L, 2, s)
        status = luaL_loadbufferx(L, s, l, chunkname, mode)
    } else {
        // loading from a reader function
        var chunkname : uint8? = luaL_optlstring(L, 2, cstr("=(load)"), null)
        luaL_checktype(L, 1, LUA_TFUNCTION)
        // create reserved slot
        lua_settop(L, RESERVEDSLOT)
        status = lua_load(L, @@generic_reader, null, chunkname, mode)
    }
    return load_aux(L, status, env)
}

