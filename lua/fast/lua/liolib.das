// Check whether 'mode' matches '[rwa]%+?[L_MODEEXT]*'
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private l_checkmode(var mode : uint8?) : int {
    var _t1 = *mode != '\0'
    if (_t1) {
        var _t0 = mode
        mode++
        _t1 = crt::strchr(cstr("rwa"), int(*_t0)) != null
    }
    var _t3 = _t1
    if (_t3) {
        var _t2 = *mode != '+'
        if (!_t2) {
            mode++
            _t2 = 1 != 0
        }
        _t3 = _t2
    }
    return int_of(_t3 && (crt::strspn(mode, cstr("b")) == crt::strlen(mode)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private io_type(var L : lua_State?) : int {
    var p : luaL_Stream?
    luaL_checkany(L, 1)
    p = reinterpret<luaL_Stream?>(luaL_testudata(L, 1, cstr("FILE*")))
    if (p == null) {
        // not a file
        luaL_pushfail(L)
    } elif (isclosed(p)) {
        lua_pushstring(L, cstr("closed file"))
    } else {
        lua_pushstring(L, cstr("file"))
    }
    return 1
}

[unsafe_deref, hint(unsafe_range_check)]
