    return (p.f == null) ? luaL_fileresult(L, 0, filename) : 1
}

// function to close 'popen' files
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private io_pclose(var L : lua_State?) : int {
    var p : luaL_Stream? = tolstream(L)
