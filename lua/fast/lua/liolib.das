// Auxiliary function to create the iteration function for 'lines'.
// The iteration function is a closure over 'io_readline', with
// the following upvalues:
// 1) The file being read (first value in the stack)
// 2) the number of arguments to read
// 3) a boolean, true iff file has to be closed when finished ('toclose')
// ) a variable number of format arguments (rest of the stack)
[unsafe_deref, hint(unsafe_range_check)]
def private aux_lines(var L : lua_State?; toclose : int) {
    // number of arguments to read
    let n : int = lua_gettop(L) - 1
    let _t0 = n <= MAXARGLINE || luaL_argerror(L, MAXARGLINE + 2, cstr("too many arguments")) != 0
    // file
    lua_pushvalue(L, 1)
    // number of arguments to read
    lua_pushinteger(L, int64(n))
    // close/not close file when finished
    lua_pushboolean(L, toclose)
    // move the three values to their positions
    lua_rotate(L, 2, 3)
    lua_pushcclosure(L, @@io_readline, 3 + n)
}

[unsafe_deref, hint(unsafe_range_check)]
def private f_lines(var L : lua_State?) : int {
    // check that it's a valid file handle
    tofile(L)
    aux_lines(L, 0)
    return 1
}

// Return an iteration function for 'io.lines'. If file has to be
// closed, also returns the file itself as a second result (to be
// closed as the state at the exit of a generic for).
[unsafe_deref, hint(unsafe_range_check)]
def private io_lines(var L : lua_State?) : int {
    var toclose : int
    // at least one argument
    if (lua_isnone(L, 1)) {
        lua_pushnil(L)
    }
    // no file name?
    if (lua_isnil(L, 1)) {
        // get default input
        lua_getfield(L, LUA_REGISTRYINDEX, cstr("_IO_input"))
        // put it at index 1
        lua_replace(L, 1)
        // check that it's a valid file handle
        tofile(L)
        // do not close it after iteration
        toclose = 0
    } else {
        // open a new file
        var filename : uint8? = luaL_checkstring(L, 1)
        opencheck(L, filename, cstr("r"))
        // put file at index 1
        lua_replace(L, 1)
        // close it after iteration
        toclose = 1
    }
    // push iteration function
    aux_lines(L, toclose)
    if (toclose != 0) {
        // state
        lua_pushnil(L)
        // control
        lua_pushnil(L)
        // file is the to-be-closed variable (4th result)
        lua_pushvalue(L, 1)
        return 4
    } else {
        return 1
    }
}

// Add current char to buffer (if not out of space) and read next one
[unsafe_deref, hint(unsafe_range_check)]
def private nextc(var rn : RN?) : int {
    // buffer overflow?
    if (rn.n >= L_MAXLENNUM) {
        // invalidate result
        rn.buff[0] = uint8('\0')
        // fail
        return 0
    } else {
        // save current char
        let _t0 = rn.n
        rn.n++
        rn.buff[_t0] = uint8(rn.c)
        // read next one
        rn.c = l_getc(rn.f)
        return 1
    }
}

// Accept current char if it is in 'set' (of size 2)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private test2(var rn : RN?; var set : uint8?) : int {
    if (rn.c == int(set[0]) || rn.c == int(set[1])) {
        return nextc(rn)
    } else {
        return 0
    }
}

// Read a sequence of (hex)digits
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private readdigits(var rn : RN?; hex : int) : int {
    var count : int = 0
    while ((hex != 0 ? crt::isxdigit(rn.c) : crt::isdigit(rn.c)) != 0 && nextc(rn) != 0) {
        count++
    }
    return count
}

// Read a number: first reads a valid prefix of a numeral into a buffer.
// Then it calls 'lua_stringtonumber' to check whether the format is
// correct and to convert it to a Lua number.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private read_number(var L : lua_State?; var f : _IO_FILE?) : int {
    var rn : RN
    var count : int = 0
    var hex : int = 0
    var decp : uint8[2]
    rn.f = f
    rn.n = 0
    // get decimal point from locale
    decp[0] = lua_getlocaledecpoint()
    // always accept a dot
    decp[1] = uint8('.')
    // skip spaces
    c_do_while(crt::isspace(rn.c) != 0) {
        rn.c = l_getc(rn.f)
    }
    // optional sign
    test2(addr(rn), cstr("-+"))
    if (test2(addr(rn), cstr("00")) != 0) {
        // numeral is hexadecimal
        if (test2(addr(rn), cstr("xX")) != 0) {
            hex = 1
        } else {
            // count initial '0' as a valid digit
            count = 1
        }
    }
    // integral part
    count += readdigits(addr(rn), hex)
    // decimal point?
    if (test2(addr(rn), addr(decp[0])) != 0) {
        // fractional part
        count += readdigits(addr(rn), hex)
    }
    // exponent mark?
    if (count > 0 && test2(addr(rn), hex != 0 ? cstr("pP") : cstr("eE")) != 0) {
        // exponent sign
        test2(addr(rn), cstr("-+"))
        // exponent digits
        readdigits(addr(rn), 0)
    }
    // unread look-ahead char
    crt::ungetc(rn.c, reinterpret<void?>(rn.f))
    // finish string
    rn.buff[rn.n] = uint8('\0')
    if (lua_stringtonumber(L, addr(rn.buff[0])) != 0ul) {
        // ok, it is a valid number
        return 1
    } else {
        // invalid format
        // "result" to be removed
        lua_pushnil(L)
        // read fails
        return 0
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private test_eof(var L : lua_State?; var f : _IO_FILE?) : int {
    let c : int = crt::getc(reinterpret<void?>(f))
    // no-op when c == EOF
    crt::ungetc(c, reinterpret<void?>(f))
    lua_pushstring(L, addr(c2das_empty[0]))
    return int_of(c != -1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private read_line(var L : lua_State?; var f : _IO_FILE?; chop : int) : int {
    var b : luaL_Buffer
    var c : int
    luaL_buffinit(L, addr(b))
    // may need to read several chunks to get whole line
    c_do_while(c != -1 && c != '\n') {
        // preallocate buffer space
        var buff : uint8? = luaL_prepbuffer(addr(b))
        var i : int = 0
        // no memory errors can happen inside the lock
        while (true) {
            var _t0 = i < LUAL_BUFFERSIZE
            if (_t0) {
                c = l_getc(f)
                _t0 = c != -1
            }
            if (!(_t0 && c != '\n')) {
                break
            }
            // read up to end of line or buffer limit
            let _t1 = i
            i++
            buff[_t1] = uint8(c)
        }
        luaL_addsize(addr(b), i)
    }
    // repeat until end of line
    // want a newline and have one?
    if (chop == 0 && c == '\n') {
        // add ending newline to result
        let _t2 = addr(b).n < addr(b).size || luaL_prepbuffsize(addr(b), 1ul) != null
        let _t3 = addr(b).n
        addr(b).n++
        addr(b).b[_t3] = uint8(c)
    }
    // close buffer
    luaL_pushresult(addr(b))
    // return ok if read something (either a newline or something else)
    return int_of(c == '\n' || lua_rawlen(L, -1) > 0ul)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private read_all(var L : lua_State?; var f : _IO_FILE?) {
    var nr : uint64
    var b : luaL_Buffer
    luaL_buffinit(L, addr(b))
    // read file in chunks of LUAL_BUFFERSIZE bytes
    c_do_while(nr == uint64(LUAL_BUFFERSIZE)) {
        var p : uint8? = luaL_prepbuffer(addr(b))
        nr = crt::fread(reinterpret<void?>(p), uint64(typeinfo sizeof(type<uint8>)), uint64(LUAL_BUFFERSIZE), reinterpret<void?>(f))
        luaL_addsize(addr(b), nr)
    }
    // close buffer
    luaL_pushresult(addr(b))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private read_chars(var L : lua_State?; var f : _IO_FILE?; n : uint64) : int {
    // number of chars actually read
    var nr : uint64
    var p : uint8?
    var b : luaL_Buffer
    luaL_buffinit(L, addr(b))
    // prepare buffer to read whole block
    p = luaL_prepbuffsize(addr(b), n)
    // try to read 'n' chars
    nr = crt::fread(reinterpret<void?>(p), uint64(typeinfo sizeof(type<uint8>)), n, reinterpret<void?>(f))
    luaL_addsize(addr(b), nr)
    // close buffer
    luaL_pushresult(addr(b))
    // true iff read something
    return int_of(nr > 0ul)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private g_read(var L : lua_State?; var f : _IO_FILE?; first : int) : int {
    var nargs : int = lua_gettop(L) - 1
    var n : int
    var success : int
    crt::clearerr(reinterpret<void?>(f))
    *crt::c_errno_location() = 0
    // no arguments?
    if (nargs == 0) {
        success = read_line(L, f, 1)
        // to return 1 result
        n = first + 1
    } else {
        // ensure stack space for all results and for auxlib's buffer
        luaL_checkstack(L, nargs + LUA_MINSTACK, cstr("too many arguments"))
        success = 1
        n = first
        while (true) {
            let _t0 = nargs
            nargs--
            if (!(_t0 != 0 && success != 0)) {
                break
            }
            if (lua_type(L, n) == LUA_TNUMBER) {
                let l : uint64 = uint64(luaL_checkinteger(L, n))
                success = (l == 0ul) ? test_eof(L, f) : read_chars(L, f, l)
            } else {
                var p : uint8? = luaL_checkstring(L, n)
                // skip optional '*' (for compatibility)
                if (*p == '*') {
                    p++
                }
                c_switch(int(*p)) {
                    case('n') {
                        // number
                        success = read_number(L, f)
                        break
                    }
                    case('l') {
                        // line
                        success = read_line(L, f, 1)
                        break
                    }
                    case('L') {
                        // line with end-of-line
                        success = read_line(L, f, 0)
                        break
                    }
                    case('a') {
                        // file
                        // read entire file
                        read_all(L, f)
                        // always success
                        success = 1
                        break
                    }
                    case(_) {
                        return luaL_argerror(L, n, cstr("invalid format"))
                    }
                }
            }
            n++
        }
    }
    if (crt::ferror(reinterpret<void?>(f)) != 0) {
        return luaL_fileresult(L, 0, null)
    }
    if (success == 0) {
        // remove last result
        lua_pop(L, 1)
        // push nil instead
        luaL_pushfail(L)
    }
    return n - first
}

[unsafe_deref, hint(unsafe_range_check)]
def private io_read(var L : lua_State?) : int {
    return g_read(L, getiofile(L, cstr("_IO_input")), 1)
}

[unsafe_deref, hint(unsafe_range_check)]
def private f_read(var L : lua_State?) : int {
    return g_read(L, tofile(L), 2)
}

// Iteration function for 'lines'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private io_readline(var L : lua_State?) : int {
    var p : luaL_Stream? = reinterpret<luaL_Stream?>(lua_touserdata(L, lua_upvalueindex(1)))
    var n : int = int(lua_tointeger(L, lua_upvalueindex(2)))
    // file is already closed?
    if (isclosed(p)) {
        return luaL_error`va(L, cstr("file is already closed"), VaNone())
    }
    lua_settop(L, 1)
    luaL_checkstack(L, n, cstr("too many arguments"))
    // push arguments to 'g_read'
    for (i in range(1, n + 1)) {
        lua_pushvalue(L, LUA_REGISTRYINDEX - (3 + i))
    }
    // 'n' is number of results
    n = g_read(L, p.f, 2)
    // should return at least a nil
    // read at least one value?
    if (lua_toboolean(L, -n) != 0) {
        // return them
        return n
    } else {
        // first result is false: EOF or error
        // is there error information?
        if (n > 1) {
            // 2nd result is error message
            return luaL_error`va(L, cstr("%s"), (lua_tostring(L, -n + 1),))
        }
        // generator created file?
        if (lua_toboolean(L, lua_upvalueindex(3)) != 0) {
            // clear stack
            lua_settop(L, 0)
            // push file at index 1
            lua_pushvalue(L, lua_upvalueindex(1))
            // close it
            aux_close(L)
        }
        return 0
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private g_write(var L : lua_State?; var f : _IO_FILE?; var arg : int) : int {
    var nargs : int = lua_gettop(L) - arg
    var status : int = 1
    *crt::c_errno_location() = 0
    while (true) {
        let _t0 = nargs
        nargs--
        if (_t0 == 0) {
            break
        }
        if (lua_type(L, arg) == LUA_TNUMBER) {
            // optimization: could be done exactly as for strings
            let len : int = lua_isinteger(L, arg) != 0 ? fprintf(reinterpret<void?>(f), cstr("%lld"), lua_tointeger(L, arg)) : fprintf(reinterpret<void?>(f),
                    cstr("%.14g"), lua_tonumber(L, arg))
            status = int_of(status != 0 && (len > 0))
        } else {
            var l : uint64
            var s : uint8? = luaL_checklstring(L, arg, addr(l))
            status = int_of(status != 0 && (crt::fwrite(reinterpret<void?>(s), uint64(typeinfo sizeof(type<uint8>)), l, reinterpret<void?>(f)) == l))
        }
        arg++
    }
    if (status != 0) {
        // file handle already on stack top
        return 1
    } else {
        return luaL_fileresult(L, status, null)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private io_write(var L : lua_State?) : int {
    return g_write(L, getiofile(L, cstr("_IO_output")), 1)
}

[unsafe_deref, hint(unsafe_range_check)]
def private f_write(var L : lua_State?) : int {
    var f : _IO_FILE? = tofile(L)
    // push file at the stack top (to be returned)
    lua_pushvalue(L, 1)
    return g_write(L, f, 2)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private f_seek(var L : lua_State?) : int {
    var f : _IO_FILE? = tofile(L)
    var op : int = luaL_checkoption(L, 2, cstr("cur"), addr(f_seek_modenames[0]))
    let p3 : int64 = luaL_optinteger(L, 3, 0l)
    let offset : int64 = p3
    let _t0 = offset == p3 || luaL_argerror(L, 3, cstr("not an integer in proper range")) != 0
    *crt::c_errno_location() = 0
    op = l_fseek(f, offset, f_seek_mode[op])
    if (op != 0) {
        // error
        return luaL_fileresult(L, 0, null)
    } else {
        lua_pushinteger(L, l_ftell(f))
        return 1
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private f_setvbuf(var L : lua_State?) : int {
    var f : _IO_FILE? = tofile(L)
    let op : int = luaL_checkoption(L, 2, null, addr(f_setvbuf_modenames[0]))
    let sz : int64 = luaL_optinteger(L, 3, int64(LUAL_BUFFERSIZE))
    var res : int
    *crt::c_errno_location() = 0
    res = crt::setvbuf(reinterpret<void?>(f), null, f_setvbuf_mode[op], uint64(sz))
    return luaL_fileresult(L, int_of(res == 0), null)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private io_flush(var L : lua_State?) : int {
    var f : _IO_FILE? = getiofile(L, cstr("_IO_output"))
    *crt::c_errno_location() = 0
    return luaL_fileresult(L, int_of(crt::fflush(reinterpret<void?>(f)) == 0), null)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private f_flush(var L : lua_State?) : int {
    var f : _IO_FILE? = tofile(L)
    *crt::c_errno_location() = 0
    return luaL_fileresult(L, int_of(crt::fflush(reinterpret<void?>(f)) == 0), null)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private createmeta(var L : lua_State?) {
    // metatable for file handles
    luaL_newmetatable(L, cstr("FILE*"))
    // add metamethods to new metatable
    luaL_setfuncs(L, addr(metameth[0]), 0)
    // create method table
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[8]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    // add file methods to method table
    luaL_setfuncs(L, addr(meth[0]), 0)
    // metatable.__index = method table
    lua_setfield(L, -2, cstr("__index"))
    // pop metatable
    lua_pop(L, 1)
}

// function to (not) close the standard files stdin, stdout, and stderr
[unsafe_deref, hint(unsafe_range_check)]
def private io_noclose(var L : lua_State?) : int {
    var p : luaL_Stream? = tolstream(L)
    // keep file opened
    p.closef = @@io_noclose
    luaL_pushfail(L)
    lua_pushstring(L, cstr("cannot close standard file"))
    return 2
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private createstdfile(var L : lua_State?; var f : _IO_FILE?; var k : uint8?; var fname : uint8?) {
    var p : luaL_Stream? = newprefile(L)
    p.f = f
    p.closef = @@io_noclose
    if (k != null) {
        lua_pushvalue(L, -1)
        // add file to registry
        lua_setfield(L, LUA_REGISTRYINDEX, k)
    }
    // add file to module
    lua_setfield(L, -2, fname)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaopen_io(var L : lua_State?) : int {
    // new module
    luaL_checkversion(L)
    lua_createtable(L, 0, int(uint64(typeinfo sizeof(type<luaL_Reg[12]>)) / uint64(typeinfo sizeof(type<luaL_Reg>)) - 1ul))
    luaL_setfuncs(L, addr(iolib[0]), 0)
    createmeta(L)
    // create (and set) default files
    createstdfile(L, reinterpret<_IO_FILE?>(crt::c_stdin()), cstr("_IO_input"), cstr("stdin"))
    createstdfile(L, reinterpret<_IO_FILE?>(crt::c_stdout()), cstr("_IO_output"), cstr("stdout"))
    createstdfile(L, reinterpret<_IO_FILE?>(crt::c_stderr()), null, cstr("stderr"))
    return 1
}

