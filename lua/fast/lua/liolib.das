[c_function, unsafe_deref, hint(unsafe_range_check)]
def private io_open(var L : lua_State?) : int {
    var filename : uint8? = luaL_checkstring(L, 1)
    var mode : uint8? = luaL_optlstring(L, 2, cstr("r"), null)
