[unsafe_deref, hint(unsafe_range_check)]
def private g_iofile(var L : lua_State?; var f : uint8?; var mode : uint8?) : int {
    if (!lua_isnoneornil(L, 1)) {
        var filename : uint8? = lua_tostring(L, 1)
        if (filename != null) {
            opencheck(L, filename, mode)
        } else {
