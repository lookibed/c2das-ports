    luaM_free_(L, reinterpret<void?>(f.p), uint64(f.sizep) * uint64(typeinfo sizeof(type<Proto?>)))
    luaM_free_(L, reinterpret<void?>(f.k), uint64(f.sizek) * uint64(typeinfo sizeof(type<TValue>)))
    luaM_free_(L, reinterpret<void?>(f.lineinfo), uint64(f.sizelineinfo) * uint64(typeinfo sizeof(type<int8>)))
    luaM_free_(L, reinterpret<void?>(f.abslineinfo), uint64(f.sizeabslineinfo) * uint64(typeinfo sizeof(type<AbsLineInfo>)))
    luaM_free_(L, reinterpret<void?>(f.locvars), uint64(f.sizelocvars) * uint64(typeinfo sizeof(type<LocVar>)))
    luaM_free_(L, reinterpret<void?>(f.upvalues), uint64(f.sizeupvalues) * uint64(typeinfo sizeof(type<Upvaldesc>)))
    luaM_free_(L, reinterpret<void?>(f), uint64(typeinfo sizeof(type<Proto>)))
