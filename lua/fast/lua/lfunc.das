    f.sizecode = 0
    f.lineinfo = null
    f.sizelineinfo = 0
    f.abslineinfo = null
    f.sizeabslineinfo = 0
    f.upvalues = null
    f.sizeupvalues = 0
    f.numparams = 0u8
    f.is_vararg = 0u8
    f.maxstacksize = 0u8
    f.locvars = null
    f.sizelocvars = 0
    f.linedefined = 0
    f.lastlinedefined = 0
    f.source = null
    return f
}

