// generated by c2das - regenerate, never edit
// equality for long strings
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_eqlngstr(var a : TString?; var b : TString?) : int {
    let len : uint64 = a.u.lnglen
    // same instance or...
    return int_of((intptr(a) == intptr(b)) ||
            ((len == b.u.lnglen) && (crt::memcmp(reinterpret<void?>(addr(a.contents[0])), reinterpret<void?>(addr(b.contents[0])), len) == 0)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_hash(var str : uint8?; var l : uint64; seed : uint) : uint {
    var h : uint = seed ^ uint(l)
    while (l > 0ul) {
        h ^= (h << 5u) + (h >> 2u) + uint(str[l - 1ul])
        l--
    }
    return h
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_hashlongstr(var ts : TString?) : uint {
    // no hash?
    if (ts.extra == 0) {
        let len : uint64 = ts.u.lnglen
        ts.hash = luaS_hash(addr(ts.contents[0]), len, ts.hash)
        // now it has its hash
        ts.extra = 1u8
    }
    return ts.hash
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private tablerehash(var vect : TString ??; osize : int; nsize : int) {
    // clear new elements
    for (i in range(osize, nsize)) {
        vect[i] = null
    }
    // rehash old part of the array
    for (i in range(osize)) {
        var p : TString? = vect[i]
        vect[i] = null
        // for each string in the list
        while (p != null) {
            // save next
            var hnext : TString? = p.u.hnext
            // new position
            let h : uint = uint(lmod(p.hash, nsize))
            // chain it into array
            p.u.hnext = vect[h]
            vect[h] = p
            p = hnext
        }
    }
}

// Resize the string table. If allocation fails, keep the current size.
// (This can degrade performance, but any non-zero size should work
// correctly.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_resize(var L : lua_State?; nsize : int) {
    var tb : stringtable? = addr(G(L).strt)
    let osize : int = tb.size
    var newvect : TString ??
    // shrinking table?
    if (nsize < osize) {
        // depopulate shrinking part
        tablerehash(tb.hash, osize, nsize)
    }
    newvect = reinterpret<TString ??>(luaM_realloc_(L, reinterpret<void?>(tb.hash), uint64(osize) * uint64(typeinfo sizeof(type<TString?>)),
            uint64(nsize) * uint64(typeinfo sizeof(type<TString?>))))
    // reallocation failed?
    if (newvect == null) {
        // was it shrinking table?
        if (nsize < osize) {
            // restore to original size
            tablerehash(tb.hash, nsize, osize)
        }
    } else {
        // leave table as it was
        // allocation succeeded
        tb.hash = newvect
        tb.size = nsize
        if (nsize > osize) {
            // rehash for new size
            tablerehash(newvect, osize, nsize)
        }
    }
}

// Clear API string cache. (Entries cannot be empty, so fill them with
// a non-collectable string.)
[unsafe_deref, hint(unsafe_range_check)]
def luaS_clearcache(var g : global_State?) {
    for (i in range(STRCACHE_N)) {
        for (j in range(STRCACHE_M)) {
            // will entry be collected?
            if (iswhite(g.strcache[i][j]) != 0) {
                // replace it with something fixed
                g.strcache[i][j] = g.memerrmsg
            }
        }
    }
}

// Initialize the string table and the string cache
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_init(var L : lua_State?) {
    var g : global_State? = G(L)
    var tb : stringtable? = addr(G(L).strt)
    tb.hash = reinterpret<TString ??>(luaM_malloc_(L, uint64(MINSTRTABSIZE) * uint64(typeinfo sizeof(type<TString?>)), 0))
    // clear array
    tablerehash(tb.hash, 0, MINSTRTABSIZE)
    tb.size = MINSTRTABSIZE
    // pre-create memory-error message
    g.memerrmsg = luaS_newlstr(L, cstr("not enough memory"), uint64(typeinfo sizeof(type<uint8[18]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul)
    // it should never be collected
    luaC_fix(L, obj2gco(g.memerrmsg))
    // fill cache with valid strings
    for (i in range(STRCACHE_N)) {
        for (j in range(STRCACHE_M)) {
            g.strcache[i][j] = g.memerrmsg
        }
    }
}

// creates a new string object
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private createstrobj(var L : lua_State?; l : uint64; tag : int; h : uint) : TString? {
    var ts : TString?
    var o : GCObject?
    // total size of TString object
    var totalsize : uint64
    totalsize = uint64(typeinfo offsetof < contents > (type<TString>)) + (l + 1ul) * uint64(typeinfo sizeof(type<uint8>))
    o = luaC_newobj(L, tag, totalsize)
    ts = gco2ts(o)
    ts.hash = h
    ts.extra = 0u8
    // ending 0
    addr(ts.contents[0])[l] = uint8('\0')
    return ts
}

[unsafe_deref, hint(unsafe_range_check)]
def luaS_createlngstrobj(var L : lua_State?; l : uint64) : TString? {
    var ts : TString? = createstrobj(L, l, LUA_VLNGSTR, G(L).seed)
    ts.u.lnglen = l
    // signals that it is a long string
    ts.shrlen = 255u8
    return ts
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_remove(var L : lua_State?; var ts : TString?) {
    var tb : stringtable? = addr(G(L).strt)
    var p : TString ?? = addr(tb.hash[lmod(ts.hash, tb.size)])
    // find previous element
    while (intptr(*p) != intptr(ts)) {
        p = addr((*p).u.hnext)
    }
    // remove element from its list
    *p = (*p).u.hnext
    tb.nuse--
}

[unsafe_deref, hint(unsafe_range_check)]
def private growstrtab(var L : lua_State?; var tb : stringtable?) {
    // too many strings?
    if (tb.nuse == 2147483647) {
        // try to free some...
        luaC_fullgc(L, 1)
        // still too many?
        if (tb.nuse == 2147483647) {
            // cannot even create a message...
            luaM_error(L)
        }
    }
    // can grow string table?
    if (tb.size <=
            int(2147483647ul <= MAX_SIZET / uint64(typeinfo sizeof(type<TString?>)) ? 2147483647u : uint(MAX_SIZET / uint64(typeinfo sizeof(type<TString?>)))) /
            2) {
        luaS_resize(L, tb.size * 2)
    }
}

// Checks whether short string exists and reuses it or creates a new one.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private internshrstr(var L : lua_State?; var str : uint8?; l : uint64) : TString? {
    var ts : TString?
    var g : global_State? = G(L)
    var tb : stringtable? = addr(g.strt)
    let h : uint = luaS_hash(str, l, g.seed)
    var list : TString ?? = addr(tb.hash[lmod(h, tb.size)])
    // otherwise 'memcmp'/'memcpy' are undefined
    ts = *list
    while (ts != null) {
        if (l == uint64(ts.shrlen) &&
                (crt::memcmp(reinterpret<void?>(str), reinterpret<void?>(addr(ts.contents[0])), l * uint64(typeinfo sizeof(type<uint8>))) == 0)) {
            // found!
            // dead (but not collected yet)?
            if (isdead(g, ts) != 0) {
                // resurrect it
                changewhite(ts)
            }
            return ts
        }
        ts = ts.u.hnext
    }
    // else must create a new string
    // need to grow string table?
    if (tb.nuse >= tb.size) {
        growstrtab(L, tb)
        // rehash with new size
        list = addr(tb.hash[lmod(h, tb.size)])
    }
    ts = createstrobj(L, l, LUA_VSHRSTR, h)
    ts.shrlen = uint8(l)
    crt::memcpy(reinterpret<void?>(addr(ts.contents[0])), reinterpret<void?>(str), l * uint64(typeinfo sizeof(type<uint8>)))
    ts.u.hnext = *list
    *list = ts
    tb.nuse++
    return ts
}

// new string (with explicit length)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_newlstr(var L : lua_State?; var str : uint8?; l : uint64) : TString? {
    // short string?
    if (l <= uint64(LUAI_MAXSHORTLEN)) {
        return internshrstr(L, str, l)
    } else {
        var ts : TString?
        if (l * uint64(typeinfo sizeof(type<uint8>)) >=
                (uint64(typeinfo sizeof(type<uint64>)) < uint64(typeinfo sizeof(type<int64>)) ? MAX_SIZET : uint64(9223372036854775807l)) -
                uint64(typeinfo sizeof(type<TString>))) {
            luaM_toobig(L)
        }
        ts = luaS_createlngstrobj(L, l)
        crt::memcpy(reinterpret<void?>(addr(ts.contents[0])), reinterpret<void?>(str), l * uint64(typeinfo sizeof(type<uint8>)))
        return ts
    }
}

// Create or reuse a zero-terminated string, first checking in the
// cache (using the string address as a key). The cache can contain
// only zero-terminated strings, so it is safe to use 'strcmp' to
// check hits.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_new(var L : lua_State?; var str : uint8?) : TString? {
    // hash
    let i : uint = uint(uint64(intptr(str)) & uint64(2147483647u * 2u + 1u)) % uint(STRCACHE_N)
    var j : int
    var p : TString ?? = addr(G(L).strcache[i][0])
    for (j1 in range(STRCACHE_M)) {
        // hit?
        if (crt::strcmp(str, addr(p[j1].contents[0])) == 0) {
            // that is it
            return p[j1]
        }
    }
    // normal route
    j = STRCACHE_M - 1
    while (j > 0) {
        // move out last element
        p[j] = p[j - 1]
        j--
    }
    // new element is first in the list
    p[0] = luaS_newlstr(L, str, crt::strlen(str))
    return p[0]
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaS_newudata(var L : lua_State?; s : uint64; nuvalue : int) : Udata? {
    var u : Udata?
    var o : GCObject?
    if (s > (uint64(typeinfo sizeof(type<uint64>)) < uint64(typeinfo sizeof(type<int64>)) ? MAX_SIZET : uint64(9223372036854775807l)) -
            (nuvalue == 0 ? uint64(typeinfo offsetof < bindata > (type<Udata0>)) :
                uint64(typeinfo offsetof < uv > (type<Udata>)) + uint64(typeinfo sizeof(type<UValue>)) * uint64(nuvalue))) {
        luaM_toobig(L)
    }
    o = luaC_newobj(L, LUA_VUSERDATA,
            (nuvalue == 0 ? uint64(typeinfo offsetof < bindata > (type<Udata0>)) :
                    uint64(typeinfo offsetof < uv > (type<Udata>)) + uint64(typeinfo sizeof(type<UValue>)) * uint64(nuvalue)) +
                s)
    u = gco2u(o)
    u.len = s
    u.nuvalue = uint16(nuvalue)
    u.metatable = null
    for (i in range(nuvalue)) {
        setnilvalue(addr(addr(u.uv[0])[i].uv))
    }
    return u
}

