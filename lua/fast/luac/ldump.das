// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_do_while
require c_runtime/c_function
require c_runtime/c_macro
require c_runtime/c_switch
require c_runtime/cstr
require lobject_h_cluster

struct DumpState {
    L : lua_State?
    writer : function<(var a0 : lua_State?; var a1 : void?; a2 : uint64; var a3 : void?) : int>
    data : void?
    strip, status : int
}

include ldump.layout.das.inc

let private DIBS = (uint64(typeinfo sizeof(type<uint64>)) * 8ul + 6ul) / 7ul
let private LUA_VERSION_NUM = 504
let private LUAC_VERSION = LUA_VERSION_NUM / 100 * 16 + LUA_VERSION_NUM % 100
let private LUAC_FORMAT = 0
let private LUAC_INT = 22136
let private LUAC_NUM = 370.5lf

[unsafe_deref, hint(unsafe_range_check)]
def private dumpBlock(var D : DumpState?; var b : void?; size : uint64) {
    if (D.status == 0 && size > 0ul) {
        D.status = invoke(D.writer, D.L, b, size, D.data)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpByte(var D : DumpState?; y : int) {
    var x : uint8 = uint8(y)
    dumpBlock(D, reinterpret<void?>(addr(x)), 1ul * uint64(typeinfo sizeof(type<uint8>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpSize(var D : DumpState?; var x : uint64) {
    var buff : uint8[10]
    var n : int = 0
    c_do_while(x != 0ul) {
        // fill buffer in reverse order
        n++
        buff[DIBS - uint64(n)] = uint8(x & 127ul)
        x >>= 7ul
    }
    // mark last byte
    buff[DIBS - 1ul] = uint8(int(buff[DIBS - 1ul]) | 128)
    dumpBlock(D, reinterpret<void?>(addr(buff[0]) + DIBS + -(n)), uint64(n) * uint64(typeinfo sizeof(type<uint8>)))
}

[unsafe_deref, hint(unsafe_range_check)]
def private dumpInt(var D : DumpState?; x : int) {
    dumpSize(D, uint64(x))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpNumber(var D : DumpState?; var x : double) {
    dumpBlock(D, reinterpret<void?>(addr(x)), 1ul * uint64(typeinfo sizeof(type<double>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpInteger(var D : DumpState?; var x : int64) {
    dumpBlock(D, reinterpret<void?>(addr(x)), 1ul * uint64(typeinfo sizeof(type<int64>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpString(var D : DumpState?; var s : TString?) {
    if (s == null) {
        dumpSize(D, 0ul)
    } else {
        let size : uint64 = tsslen(s)
        var str : uint8? = addr(s.contents[0])
        dumpSize(D, size + 1ul)
        dumpBlock(D, reinterpret<void?>(str), size * uint64(typeinfo sizeof(type<uint8>)))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpCode(var D : DumpState?; var f : Proto?) {
    dumpInt(D, f.sizecode)
    dumpBlock(D, reinterpret<void?>(f.code), uint64(f.sizecode) * uint64(typeinfo sizeof(type<uint>)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpConstants(var D : DumpState?; var f : Proto?) {
    let n : int = f.sizek
    dumpInt(D, n)
    for (i in range(n)) {
        var o : TValue? = addr(f.k[i])
        let tt : int = withvariant(o.tt_)
        dumpByte(D, tt)
        c_switch(tt) {
            case(19) {
                dumpNumber(D, fltvalue(o))
                break
            }
            case(3) {
                dumpInteger(D, ivalue(o))
                break
            }
            case(4, 20) {
                dumpString(D, addr(reinterpret<GCUnion?>(o.value_.gc).ts))
                break
            }
            case(_) {
            }
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpProtos(var D : DumpState?; var f : Proto?) {
    let n : int = f.sizep
    dumpInt(D, n)
    for (i in range(n)) {
        dumpFunction(D, f.p[i], f.source)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpUpvalues(var D : DumpState?; var f : Proto?) {
    let n : int = f.sizeupvalues
    dumpInt(D, n)
    for (i in range(n)) {
        dumpByte(D, int(f.upvalues[i].instack))
        dumpByte(D, int(f.upvalues[i].idx))
        dumpByte(D, int(f.upvalues[i].kind))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpDebug(var D : DumpState?; var f : Proto?) {
    var n : int
    n = D.strip != 0 ? 0 : f.sizelineinfo
    dumpInt(D, n)
    dumpBlock(D, reinterpret<void?>(f.lineinfo), uint64(n) * uint64(typeinfo sizeof(type<int8>)))
    n = D.strip != 0 ? 0 : f.sizeabslineinfo
    dumpInt(D, n)
    for (i in range(n)) {
        dumpInt(D, f.abslineinfo[i].pc)
        dumpInt(D, f.abslineinfo[i].line)
    }
    n = D.strip != 0 ? 0 : f.sizelocvars
    dumpInt(D, n)
    for (i in range(n)) {
        dumpString(D, f.locvars[i].varname)
        dumpInt(D, f.locvars[i].startpc)
        dumpInt(D, f.locvars[i].endpc)
    }
    n = D.strip != 0 ? 0 : f.sizeupvalues
    dumpInt(D, n)
    for (i in range(n)) {
        dumpString(D, f.upvalues[i].name)
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def private dumpFunction(var D : DumpState?; var f : Proto?; var psource : TString?) {
    if (D.strip != 0 || intptr(f.source) == intptr(psource)) {
        // no debug info or same source as its parent
        dumpString(D, null)
    } else {
        dumpString(D, f.source)
    }
    dumpInt(D, f.linedefined)
    dumpInt(D, f.lastlinedefined)
    dumpByte(D, int(f.numparams))
    dumpByte(D, int(f.is_vararg))
    dumpByte(D, int(f.maxstacksize))
    dumpCode(D, f)
    dumpConstants(D, f)
    dumpUpvalues(D, f)
    dumpProtos(D, f)
    dumpDebug(D, f)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private dumpHeader(var D : DumpState?) {
    dumpBlock(D, reinterpret<void?>(cstr("\x1bLua")), uint64(typeinfo sizeof(type<uint8[5]>)) - uint64(typeinfo sizeof(type<uint8>)))
    dumpByte(D, LUAC_VERSION)
    dumpByte(D, LUAC_FORMAT)
    dumpBlock(D, reinterpret<void?>(cstr("\x19\x93\r\n\x1a\n")), uint64(typeinfo sizeof(type<uint8[7]>)) - uint64(typeinfo sizeof(type<uint8>)))
    dumpByte(D, typeinfo sizeof(type<uint>))
    dumpByte(D, typeinfo sizeof(type<int64>))
    dumpByte(D, typeinfo sizeof(type<double>))
    dumpInteger(D, int64(LUAC_INT))
    dumpNumber(D, LUAC_NUM)
}

// dump Lua function as precompiled chunk
[c_function, unsafe_deref, hint(unsafe_range_check)]
def luaU_dump(var L : lua_State?; var f : Proto?; w : function<(var a0 : lua_State?; var a1 : void?; a2 : uint64; var a3 : void?) : int>; var data : void?;
              strip : int) : int {
    var D : DumpState
    D.L = L
    D.writer = w
    D.data = data
    D.strip = strip
    D.status = 0
    dumpHeader(addr(D))
    dumpByte(addr(D), f.sizeupvalues)
    dumpFunction(addr(D), f, null)
    return D.status
}

