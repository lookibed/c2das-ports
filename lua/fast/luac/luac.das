// generated by c2das - regenerate, never edit
// converted with --checks off: no null or range checks (the AOT host keeps its range checks), a wrong C program reads garbage or dies by SIGSEGV instead of panicking
options gen2
options indenting = 4
options solid_context
options stack = 8388608
options strict_aliasing = false
options jit_split_modules = 0
require c_runtime/c_args
require c_runtime/c_exit
require c_runtime/c_function
require c_runtime/c_jit_build
require c_runtime/c_macro
require c_runtime/c_switch
require c_runtime/cstr
require c_runtime/cstr_array
require c_runtime/enum_from_int
require c_runtime/int_of
require c_runtime/printf
require c_types
require crt
require lapi
require lauxlib
require lcode_cluster
require ldump
require lobject_h_cluster
require lopcodes_h

var private c2das_empty : uint8[1] = fixed_array(uint8(0))

[init]
def private c2das_dialect {
    c_long_bits = 64
}

var private opnames : uint8? [84] = fixed_array<uint8?>(cstr("MOVE"), cstr("LOADI"), cstr("LOADF"), cstr("LOADK"), cstr("LOADKX"), cstr("LOADFALSE"),
        cstr("LFALSESKIP"), cstr("LOADTRUE"), cstr("LOADNIL"), cstr("GETUPVAL"), cstr("SETUPVAL"), cstr("GETTABUP"), cstr("GETTABLE"), cstr("GETI"),
        cstr("GETFIELD"), cstr("SETTABUP"), cstr("SETTABLE"), cstr("SETI"), cstr("SETFIELD"), cstr("NEWTABLE"), cstr("SELF"), cstr("ADDI"), cstr("ADDK"),
        cstr("SUBK"), cstr("MULK"), cstr("MODK"), cstr("POWK"), cstr("DIVK"), cstr("IDIVK"), cstr("BANDK"), cstr("BORK"), cstr("BXORK"), cstr("SHRI"),
        cstr("SHLI"), cstr("ADD"), cstr("SUB"), cstr("MUL"), cstr("MOD"), cstr("POW"), cstr("DIV"), cstr("IDIV"), cstr("BAND"), cstr("BOR"), cstr("BXOR"),
        cstr("SHL"), cstr("SHR"), cstr("MMBIN"), cstr("MMBINI"), cstr("MMBINK"), cstr("UNM"), cstr("BNOT"), cstr("NOT"), cstr("LEN"), cstr("CONCAT"),
        cstr("CLOSE"), cstr("TBC"), cstr("JMP"), cstr("EQ"), cstr("LT"), cstr("LE"), cstr("EQK"), cstr("EQI"), cstr("LTI"), cstr("LEI"), cstr("GTI"),
        cstr("GEI"), cstr("TEST"), cstr("TESTSET"), cstr("CALL"), cstr("TAILCALL"), cstr("RETURN"), cstr("RETURN0"), cstr("RETURN1"), cstr("FORLOOP"),
        cstr("FORPREP"), cstr("TFORPREP"), cstr("TFORCALL"), cstr("TFORLOOP"), cstr("SETLIST"), cstr("CLOSURE"), cstr("VARARG"), cstr("VARARGPREP"),
        cstr("EXTRAARG"), null)
var private listing : int = 0
var private dumping : int = 1
var private stripping : int = 0
var private Output : uint8[9] = cstr_array("luac.out", 9)
var private output : uint8? = unsafe(addr(Output[0]))
var private progname : uint8? = cstr("luac")
var private tmname : TString ??

let private LUA_OK = 0
let private POS_OP = 0
let private SIZE_OP = 7
let private POS_A = POS_OP + SIZE_OP
let private SIZE_A = 8
let private POS_k = POS_A + SIZE_A
let private POS_B = POS_k + 1
let private SIZE_B = 8
let private POS_C = POS_B + SIZE_B
let private SIZE_C = 8
let private SIZE_Bx = SIZE_C + SIZE_B + 1
let private SIZE_Ax = SIZE_Bx + SIZE_A
let private MAXARG_C = (1 << SIZE_C) - 1
let private OFFSET_sC = MAXARG_C >> 1
let private MAXARG_Bx = (1 << SIZE_Bx) - 1
let private OFFSET_sBx = MAXARG_Bx >> 1
let private SIZE_sJ = SIZE_Bx + SIZE_A
let private MAXARG_sJ = (1 << SIZE_sJ) - 1
let private OFFSET_sJ = MAXARG_sJ >> 1

// luac.c:141: #define toproto(L,i) getproto(s2v(L->top.p+(i)))
[c_macro, c_function, unsafe_deref, hint(unsafe_range_check)]
def private toproto(var L; i) : Proto? => gco2lcl(s2v(L.top.p + i).value_.gc).p

// lua.h:398: #define lua_tostring(L,i) lua_tolstring(L, (i), NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_tostring(var L; i) : uint8? => lua_tolstring(L, i, null)

// lua.h:374: #define lua_tointeger(L,i) lua_tointegerx(L,(i),NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_tointeger(var L; i) => lua_tointegerx(L, i, null)

// lauxlib.h:95: #define luaL_loadfile(L,f) luaL_loadfilex(L,f,NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private luaL_loadfile(var L; var f) => luaL_loadfilex(L, f, null)

// lua.h:382: #define lua_pushcfunction(L,f) lua_pushcclosure(L, (f), 0)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_pushcfunction(var L; f) {
    lua_pushcclosure(L, f, 0)
}

// lua.h:298: #define lua_pcall(L,n,r,f) lua_pcallk(L, (n), (r), (f), 0, NULL)
[c_macro, unsafe_deref, hint(unsafe_range_check)]
def private lua_pcall(var L; n; r; f) => lua_pcallk(L, n, r, f, 0l, default<function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>>)

// luac.c:665: #define SS(x) ((x==1)?"":"s")
[c_macro, c_function, unsafe_deref, hint(unsafe_range_check)]
def private SS(x) : uint8? => x == 1 ? addr(c2das_empty[0]) : cstr("s")

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private fatal(var message : uint8?) {
    fprintf(crt::c_stderr(), cstr("%s: %s\n"), progname, message)
    c_exit(1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private cannot(var what : uint8?) {
    fprintf(crt::c_stderr(), cstr("%s: cannot %s %s: %s\n"), progname, what, output, crt::strerror(*crt::c_errno_location()))
    c_exit(1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private usage(var message : uint8?) {
    if (*message == '-') {
        fprintf(crt::c_stderr(), cstr("%s: unrecognized option '%s'\n"), progname, message)
    } else {
        fprintf(crt::c_stderr(), cstr("%s: %s\n"), progname, message)
    }
    fprintf(crt::c_stderr(),
            cstr("usage: %s [options] [filenames]\nAvailable options are:\n  -l       list (use -l -l for full listing)\n  -o name  output to file 'name' (default is \"%s\")\n  -p       parse only\n  -s       strip debug information\n  -v       show version information\n  --       stop handling options\n  -        stop handling options and process stdin\n"),
            progname, addr(Output[0]))
    c_exit(1)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private doargs(argc : int; var argv : uint8 ??) : int {
    var i : int
    var version : int = 0
    if (argv[0] != null && *argv[0] != 0) {
        progname = argv[0]
    }
    i = 1
    while (i < argc) {
        // end of options; keep it
        if (*argv[i] != '-') {
            break
        } elif (crt::strcmp(argv[i], cstr("--")) == 0) {
            // end of options; skip it
            i++
            if (version != 0) {
                version++
            }
            break
        } elif (crt::strcmp(argv[i], cstr("-")) == 0) {
            // end of options; use stdin
            break
        } elif (crt::strcmp(argv[i], cstr("-l")) == 0) {
            // list
            listing++
        } elif (crt::strcmp(argv[i], cstr("-o")) == 0) {
            // output file
            i++
            output = argv[i]
            if (output == null || *output == 0 || (*output == '-' && output[1] != 0)) {
                usage(cstr("'-o' needs argument"))
            }
            if (crt::strcmp(argv[i], cstr("-")) == 0) {
                output = null
            }
        } elif (crt::strcmp(argv[i], cstr("-p")) == 0) {
            // parse only
            dumping = 0
        } elif (crt::strcmp(argv[i], cstr("-s")) == 0) {
            // strip debug information
            stripping = 1
        } elif (crt::strcmp(argv[i], cstr("-v")) == 0) {
            // show version
            version++
        } else {
            // unknown option
            usage(argv[i])
        }
        i++
    }
    if (i == argc && (listing != 0 || dumping == 0)) {
        dumping = 0
        i--
        argv[i] = addr(Output[0])
    }
    if (version != 0) {
        printf(cstr("%s\n"), cstr("Lua 5.4.8  Copyright (C) 1994-2025 Lua.org, PUC-Rio"))
        if (version == argc - 1) {
            c_exit(0)
        }
    }
    return i
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private reader(var L : lua_State?; var ud : void?; var size : uint64?) : uint8? {
    let _t0 = *reinterpret<int?>(ud)
    (*reinterpret<int?>(ud))--
    if (_t0 != 0) {
        *size = uint64(typeinfo sizeof(type<uint8[20]>)) - 1ul
        return cstr("(function()end)();\n")
    } else {
        *size = 0ul
        return null
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private combine(var L : lua_State?; n : int) : Proto? {
    if (n == 1) {
        return toproto(L, -1)
    } else {
        var f : Proto?
        var i : int = n
        if (lua_load(L, @@reader, reinterpret<void?>(addr(i)), cstr("=(luac)"), null) != LUA_OK) {
            fatal(lua_tostring(L, -1))
        }
        f = toproto(L, -1)
        i = 0
        while (i < n) {
            f.p[i] = gco2lcl(s2v(L.top.p + (i - n - 1)).value_.gc).p
            if (f.p[i].sizeupvalues > 0) {
                f.p[i].upvalues[0].instack = 0u8
            }
            i++
        }
        return f
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private writer(var L : lua_State?; var p : void?; size : uint64; var u : void?) : int {
    return int_of((crt::fwrite(p, size, 1ul, reinterpret<void?>(reinterpret<_IO_FILE?>(u))) != 1ul) && (size != 0ul))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private pmain(var L : lua_State?) : int {
    let argc : int = int(lua_tointeger(L, 1))
    var argv : uint8 ?? = reinterpret<uint8 ??>(lua_touserdata(L, 2))
    var f : Proto?
    tmname = addr(G(L).tmname[0])
    if (lua_checkstack(L, argc) == 0) {
        fatal(cstr("too many input files"))
    }
    for (i in range(argc)) {
        var filename : uint8? = crt::strcmp(argv[i], cstr("-")) == 0 ? default<uint8?> : argv[i]
        if (luaL_loadfile(L, filename) != LUA_OK) {
            fatal(lua_tostring(L, -1))
        }
    }
    f = combine(L, argc)
    if (listing != 0) {
        PrintFunction(f, int_of(listing > 1))
    }
    if (dumping != 0) {
        var D : _IO_FILE? = (output == null) ? reinterpret<_IO_FILE?>(crt::c_stdout()) : reinterpret<_IO_FILE?>(crt::fopen(output, cstr("wb")))
        if (D == null) {
            cannot(cstr("open"))
        }
        luaU_dump(L, f, @@writer, reinterpret<void?>(D), stripping)
        if (crt::ferror(reinterpret<void?>(D)) != 0) {
            cannot(cstr("write"))
        }
        if (crt::fclose(reinterpret<void?>(D)) != 0) {
            cannot(cstr("close"))
        }
    }
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def c_main(var argc : int; var argv : uint8 ??) : int {
    var L : lua_State?
    let i : int = doargs(argc, argv)
    argc -= i
    argv += i
    if (argc <= 0) {
        usage(cstr("no input files given"))
    }
    L = luaL_newstate()
    if (L == null) {
        fatal(cstr("cannot create state: not enough memory"))
    }
    lua_pushcfunction(L, @@pmain)
    lua_pushinteger(L, int64(argc))
    lua_pushlightuserdata(L, reinterpret<void?>(argv))
    if (lua_pcall(L, 2, 0, 0) != LUA_OK) {
        fatal(lua_tostring(L, -1))
    }
    lua_close(L)
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private PrintString(var ts : TString?) {
    var s : uint8? = addr(ts.contents[0])
    let n : uint64 = tsslen(ts)
    printf(cstr("\""))
    for (i in urange64(n)) {
        let c : int = int(s[i])
        c_switch(c) {
            case('"') {
                printf(cstr("\\\""))
                break
            }
            case('\\') {
                printf(cstr("\\\\"))
                break
            }
            case('\a') {
                printf(cstr("\\a"))
                break
            }
            case('\b') {
                printf(cstr("\\b"))
                break
            }
            case('\f') {
                printf(cstr("\\f"))
                break
            }
            case('\n') {
                printf(cstr("\\n"))
                break
            }
            case('\r') {
                printf(cstr("\\r"))
                break
            }
            case('\t') {
                printf(cstr("\\t"))
                break
            }
            case('\v') {
                printf(cstr("\\v"))
                break
            }
            case(_) {
                if (crt::isprint(c) != 0) {
                    printf(cstr("%c"), c)
                } else {
                    printf(cstr("\\%03d"), c)
                }
                break
            }
        }
    }
    printf(cstr("\""))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private PrintType(var f : Proto?; i : int) {
    var o : TValue? = addr(f.k[i])
    c_switch(withvariant(o.tt_)) {
        case(0) {
            printf(cstr("N"))
            break
        }
        case(1, 17) {
            printf(cstr("B"))
            break
        }
        case(19) {
            printf(cstr("F"))
            break
        }
        case(3) {
            printf(cstr("I"))
            break
        }
        case(4, 20) {
            printf(cstr("S"))
            break
        }
        case(_) {
            // cannot happen
            printf(cstr("?%d"), withvariant(o.tt_))
            break
        }
    }
    printf(cstr("\t"))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private PrintConstant(var f : Proto?; i : int) {
    var o : TValue? = addr(f.k[i])
    c_switch(withvariant(o.tt_)) {
        case(0) {
            printf(cstr("nil"))
            break
        }
        case(1) {
            printf(cstr("false"))
            break
        }
        case(17) {
            printf(cstr("true"))
            break
        }
        case(19) {
            {
                var buff : uint8[100]
                sprintf(addr(buff[0]), cstr("%.14g"), fltvalue(o))
                printf(cstr("%s"), addr(buff[0]))
                if (buff[crt::strspn(addr(buff[0]), cstr("-0123456789"))] == '\0') {
                    printf(cstr(".0"))
                }
                break
            }
        }
        case(3) {
            printf(cstr("%lld"), ivalue(o))
            break
        }
        case(4, 20) {
            PrintString(addr(reinterpret<GCUnion?>(o.value_.gc).ts))
            break
        }
        case(_) {
            // cannot happen
            printf(cstr("?%d"), withvariant(o.tt_))
            break
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private PrintCode(var f : Proto?) {
    var code : uint? = f.code
    let n : int = f.sizecode
    for (pc in range(n)) {
        let i : uint = code[pc]
        let o : OpCode = GET_OPCODE(i)
        let a : int = GETARG_A(i)
        let b : int = GETARG_B(i)
        let c : int = GETARG_C(i)
        let ax : int = GETARG_Ax(i)
        let bx : int = GETARG_Bx(i)
        let sb : int = GETARG_sB(i)
        let sc : int = GETARG_sC(i)
        let sbx : int = GETARG_sBx(i)
        let isk : int = GETARG_k(i)
        let line : int = luaG_getfuncline(f, pc)
        printf(cstr("\t%d\t"), pc + 1)
        if (line > 0) {
            printf(cstr("[%d]\t"), line)
        } else {
            printf(cstr("[-]\t"))
        }
        printf(cstr("%-9s\t"), opnames[int(o)])
        c_switch(o) {
            case(OpCode.OP_MOVE) {
                printf(cstr("%d %d"), a, b)
                break
            }
            case(OpCode.OP_LOADI) {
                printf(cstr("%d %d"), a, sbx)
                break
            }
            case(OpCode.OP_LOADF) {
                printf(cstr("%d %d"), a, sbx)
                break
            }
            case(OpCode.OP_LOADK) {
                printf(cstr("%d %d"), a, bx)
                printf(cstr("\t; "))
                PrintConstant(f, bx)
                break
            }
            case(OpCode.OP_LOADKX) {
                printf(cstr("%d"), a)
                printf(cstr("\t; "))
                PrintConstant(f, int((code[pc + 1] >> uint(POS_A)) & (~(~0u << uint(SIZE_Ax)) << 0u)))
                break
            }
            case(OpCode.OP_LOADFALSE) {
                printf(cstr("%d"), a)
                break
            }
            case(OpCode.OP_LFALSESKIP) {
                printf(cstr("%d"), a)
                break
            }
            case(OpCode.OP_LOADTRUE) {
                printf(cstr("%d"), a)
                break
            }
            case(OpCode.OP_LOADNIL) {
                printf(cstr("%d %d"), a, b)
                printf(cstr("\t; %d out"), b + 1)
                break
            }
            case(OpCode.OP_GETUPVAL) {
                printf(cstr("%d %d"), a, b)
                printf(cstr("\t; %s"), f.upvalues[b].name != null ? addr(f.upvalues[b].name.contents[0]) : cstr("-"))
                break
            }
            case(OpCode.OP_SETUPVAL) {
                printf(cstr("%d %d"), a, b)
                printf(cstr("\t; %s"), f.upvalues[b].name != null ? addr(f.upvalues[b].name.contents[0]) : cstr("-"))
                break
            }
            case(OpCode.OP_GETTABUP) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; %s"), f.upvalues[b].name != null ? addr(f.upvalues[b].name.contents[0]) : cstr("-"))
                printf(cstr(" "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_GETTABLE) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_GETI) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_GETFIELD) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_SETTABUP) {
                printf(cstr("%d %d %d%s"), a, b, c, isk != 0 ? cstr("k") : addr(c2das_empty[0]))
                printf(cstr("\t; %s"), f.upvalues[a].name != null ? addr(f.upvalues[a].name.contents[0]) : cstr("-"))
                printf(cstr(" "))
                PrintConstant(f, b)
                if (isk != 0) {
                    printf(cstr(" "))
                    PrintConstant(f, c)
                }
                break
            }
            case(OpCode.OP_SETTABLE) {
                printf(cstr("%d %d %d%s"), a, b, c, isk != 0 ? cstr("k") : addr(c2das_empty[0]))
                if (isk != 0) {
                    printf(cstr("\t; "))
                    PrintConstant(f, c)
                }
                break
            }
            case(OpCode.OP_SETI) {
                printf(cstr("%d %d %d%s"), a, b, c, isk != 0 ? cstr("k") : addr(c2das_empty[0]))
                if (isk != 0) {
                    printf(cstr("\t; "))
                    PrintConstant(f, c)
                }
                break
            }
            case(OpCode.OP_SETFIELD) {
                printf(cstr("%d %d %d%s"), a, b, c, isk != 0 ? cstr("k") : addr(c2das_empty[0]))
                printf(cstr("\t; "))
                PrintConstant(f, b)
                if (isk != 0) {
                    printf(cstr(" "))
                    PrintConstant(f, c)
                }
                break
            }
            case(OpCode.OP_NEWTABLE) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; %d"), c + int((code[pc + 1] >> uint(POS_A)) & (~(~0u << uint(SIZE_Ax)) << 0u)) * (MAXARG_C + 1))
                break
            }
            case(OpCode.OP_SELF) {
                printf(cstr("%d %d %d%s"), a, b, c, isk != 0 ? cstr("k") : addr(c2das_empty[0]))
                if (isk != 0) {
                    printf(cstr("\t; "))
                    PrintConstant(f, c)
                }
                break
            }
            case(OpCode.OP_ADDI) {
                printf(cstr("%d %d %d"), a, b, sc)
                break
            }
            case(OpCode.OP_ADDK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_SUBK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_MULK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_MODK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_POWK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_DIVK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_IDIVK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_BANDK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_BORK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_BXORK) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                PrintConstant(f, c)
                break
            }
            case(OpCode.OP_SHRI) {
                printf(cstr("%d %d %d"), a, b, sc)
                break
            }
            case(OpCode.OP_SHLI) {
                printf(cstr("%d %d %d"), a, b, sc)
                break
            }
            case(OpCode.OP_ADD) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_SUB) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_MUL) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_MOD) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_POW) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_DIV) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_IDIV) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_BAND) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_BOR) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_BXOR) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_SHL) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_SHR) {
                printf(cstr("%d %d %d"), a, b, c)
                break
            }
            case(OpCode.OP_MMBIN) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; %s"), addr(tmname[c].contents[0]))
                break
            }
            case(OpCode.OP_MMBINI) {
                printf(cstr("%d %d %d %d"), a, sb, c, isk)
                printf(cstr("\t; %s"), addr(tmname[c].contents[0]))
                if (isk != 0) {
                    printf(cstr(" flip"))
                }
                break
            }
            case(OpCode.OP_MMBINK) {
                printf(cstr("%d %d %d %d"), a, b, c, isk)
                printf(cstr("\t; %s "), addr(tmname[c].contents[0]))
                PrintConstant(f, b)
                if (isk != 0) {
                    printf(cstr(" flip"))
                }
                break
            }
            case(OpCode.OP_UNM) {
                printf(cstr("%d %d"), a, b)
                break
            }
            case(OpCode.OP_BNOT) {
                printf(cstr("%d %d"), a, b)
                break
            }
            case(OpCode.OP_NOT) {
                printf(cstr("%d %d"), a, b)
                break
            }
            case(OpCode.OP_LEN) {
                printf(cstr("%d %d"), a, b)
                break
            }
            case(OpCode.OP_CONCAT) {
                printf(cstr("%d %d"), a, b)
                break
            }
            case(OpCode.OP_CLOSE) {
                printf(cstr("%d"), a)
                break
            }
            case(OpCode.OP_TBC) {
                printf(cstr("%d"), a)
                break
            }
            case(OpCode.OP_JMP) {
                printf(cstr("%d"), GETARG_sJ(i))
                printf(cstr("\t; to %d"), GETARG_sJ(i) + pc + 2)
                break
            }
            case(OpCode.OP_EQ) {
                printf(cstr("%d %d %d"), a, b, isk)
                break
            }
            case(OpCode.OP_LT) {
                printf(cstr("%d %d %d"), a, b, isk)
                break
            }
            case(OpCode.OP_LE) {
                printf(cstr("%d %d %d"), a, b, isk)
                break
            }
            case(OpCode.OP_EQK) {
                printf(cstr("%d %d %d"), a, b, isk)
                printf(cstr("\t; "))
                PrintConstant(f, b)
                break
            }
            case(OpCode.OP_EQI) {
                printf(cstr("%d %d %d"), a, sb, isk)
                break
            }
            case(OpCode.OP_LTI) {
                printf(cstr("%d %d %d"), a, sb, isk)
                break
            }
            case(OpCode.OP_LEI) {
                printf(cstr("%d %d %d"), a, sb, isk)
                break
            }
            case(OpCode.OP_GTI) {
                printf(cstr("%d %d %d"), a, sb, isk)
                break
            }
            case(OpCode.OP_GEI) {
                printf(cstr("%d %d %d"), a, sb, isk)
                break
            }
            case(OpCode.OP_TEST) {
                printf(cstr("%d %d"), a, isk)
                break
            }
            case(OpCode.OP_TESTSET) {
                printf(cstr("%d %d %d"), a, b, isk)
                break
            }
            case(OpCode.OP_CALL) {
                printf(cstr("%d %d %d"), a, b, c)
                printf(cstr("\t; "))
                if (b == 0) {
                    printf(cstr("all in "))
                } else {
                    printf(cstr("%d in "), b - 1)
                }
                if (c == 0) {
                    printf(cstr("all out"))
                } else {
                    printf(cstr("%d out"), c - 1)
                }
                break
            }
            case(OpCode.OP_TAILCALL) {
                printf(cstr("%d %d %d%s"), a, b, c, isk != 0 ? cstr("k") : addr(c2das_empty[0]))
                printf(cstr("\t; %d in"), b - 1)
                break
            }
            case(OpCode.OP_RETURN) {
                printf(cstr("%d %d %d%s"), a, b, c, isk != 0 ? cstr("k") : addr(c2das_empty[0]))
                printf(cstr("\t; "))
                if (b == 0) {
                    printf(cstr("all out"))
                } else {
                    printf(cstr("%d out"), b - 1)
                }
                break
            }
            case(OpCode.OP_RETURN0) {
                break
            }
            case(OpCode.OP_RETURN1) {
                printf(cstr("%d"), a)
                break
            }
            case(OpCode.OP_FORLOOP) {
                printf(cstr("%d %d"), a, bx)
                printf(cstr("\t; to %d"), pc - bx + 2)
                break
            }
            case(OpCode.OP_FORPREP) {
                printf(cstr("%d %d"), a, bx)
                printf(cstr("\t; exit to %d"), pc + bx + 3)
                break
            }
            case(OpCode.OP_TFORPREP) {
                printf(cstr("%d %d"), a, bx)
                printf(cstr("\t; to %d"), pc + bx + 2)
                break
            }
            case(OpCode.OP_TFORCALL) {
                printf(cstr("%d %d"), a, c)
                break
            }
            case(OpCode.OP_TFORLOOP) {
                printf(cstr("%d %d"), a, bx)
                printf(cstr("\t; to %d"), pc - bx + 2)
                break
            }
            case(OpCode.OP_SETLIST) {
                printf(cstr("%d %d %d"), a, b, c)
                if (isk != 0) {
                    printf(cstr("\t; %d"), c + int((code[pc + 1] >> uint(POS_A)) & (~(~0u << uint(SIZE_Ax)) << 0u)) * (MAXARG_C + 1))
                }
                break
            }
            case(OpCode.OP_CLOSURE) {
                printf(cstr("%d %d"), a, bx)
                printf(cstr("\t; %p"), reinterpret<void?>(f.p[bx]))
                break
            }
            case(OpCode.OP_VARARG) {
                printf(cstr("%d %d"), a, c)
                printf(cstr("\t; "))
                if (c == 0) {
                    printf(cstr("all out"))
                } else {
                    printf(cstr("%d out"), c - 1)
                }
                break
            }
            case(OpCode.OP_VARARGPREP) {
                printf(cstr("%d"), a)
                break
            }
            case(OpCode.OP_EXTRAARG) {
                printf(cstr("%d"), ax)
                break
            }
        }
        printf(cstr("\n"))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private PrintHeader(var f : Proto?) {
    var s : uint8? = f.source != null ? addr(f.source.contents[0]) : cstr("=?")
    if (*s == '@' || *s == '=') {
        s++
    } elif (*s == cstr("\x1bLua")[0]) {
        s = cstr("(bstring)")
    } else {
        s = cstr("(string)")
    }
    printf(cstr("\n%s <%s:%d,%d> (%d instruction%s at %p)\n"), (f.linedefined == 0) ? cstr("main") : cstr("function"), s, f.linedefined, f.lastlinedefined,
            f.sizecode, f.sizecode == 1 ? addr(c2das_empty[0]) : cstr("s"), reinterpret<void?>(f))
    printf(cstr("%d%s param%s, %d slot%s, %d upvalue%s, "), int(f.numparams), f.is_vararg != 0 ? cstr("+") : addr(c2das_empty[0]), SS(f.numparams),
            int(f.maxstacksize), f.maxstacksize == 1 ? addr(c2das_empty[0]) : cstr("s"), f.sizeupvalues, f.sizeupvalues == 1 ? addr(c2das_empty[0]) : cstr("s"))
    printf(cstr("%d local%s, %d constant%s, %d function%s\n"), f.sizelocvars, f.sizelocvars == 1 ? addr(c2das_empty[0]) : cstr("s"), f.sizek,
            f.sizek == 1 ? addr(c2das_empty[0]) : cstr("s"), f.sizep, f.sizep == 1 ? addr(c2das_empty[0]) : cstr("s"))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private PrintDebug(var f : Proto?) {
    var n : int
    n = f.sizek
    printf(cstr("constants (%d) for %p:\n"), n, reinterpret<void?>(f))
    for (i in range(n)) {
        printf(cstr("\t%d\t"), i)
        PrintType(f, i)
        PrintConstant(f, i)
        printf(cstr("\n"))
    }
    n = f.sizelocvars
    printf(cstr("locals (%d) for %p:\n"), n, reinterpret<void?>(f))
    for (i in range(n)) {
        printf(cstr("\t%d\t%s\t%d\t%d\n"), i, addr(f.locvars[i].varname.contents[0]), f.locvars[i].startpc + 1, f.locvars[i].endpc + 1)
    }
    n = f.sizeupvalues
    printf(cstr("upvalues (%d) for %p:\n"), n, reinterpret<void?>(f))
    for (i in range(n)) {
        printf(cstr("\t%d\t%s\t%d\t%d\n"), i, f.upvalues[i].name != null ? addr(f.upvalues[i].name.contents[0]) : cstr("-"), int(f.upvalues[i].instack),
                int(f.upvalues[i].idx))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private PrintFunction(var f : Proto?; full : int) {
    let n : int = f.sizep
    PrintHeader(f)
    PrintCode(f)
    if (full != 0) {
        PrintDebug(f)
    }
    for (i in range(n)) {
        PrintFunction(f.p[i], full)
    }
}

[export]
def main : int {
    c_runtime_init("luac")
    return c_main(c_argc(), c_argv())
}
