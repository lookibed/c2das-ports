// generated by c2das - regenerate, never edit
options gen2
options indenting = 4
options solid_context
options stack = 8388608
require c_runtime/c_function
require crt
require lobject_h_cluster
require lzio_h

let private EOZ = -1

[c_function]
def luaZ_fill(var z : Zio?) : int {
    var size : uint64
    var L : lua_State? = z.L
    var buff : uint8?
    buff = invoke(z.reader, L, z.data, addr(size))
    if (buff == null || size == 0ul) {
        return EOZ
    }
    // discount char being returned
    z.n = size - 1ul
    z.p = buff
    var _t0 = z.p
    z.p++
    return int(*_t0)
}

def luaZ_init(var L : lua_State?; var z : Zio?; reader : function<(var a0 : lua_State?; var a1 : void?; var a2 : uint64?) : uint8?>; var data : void?) {
    z.L = L
    z.reader = reader
    z.data = data
    z.n = 0ul
    z.p = null
}

// --------------------------------------------------------------- read ---
[c_function]
def luaZ_read(var z : Zio?; var b : void?; var n : uint64) : uint64 {
    while (n != 0) {
        var m : uint64
        // no bytes in buffer?
        if (z.n == 0ul) {
            // try to read more
            if (luaZ_fill(z) == EOZ) {
                // no more input; return number of missing bytes
                return n
            } else {
                // luaZ_fill consumed first byte; put it back
                z.n++
                z.p--
            }
        }
        // min. between n and z->n
        m = (n <= z.n) ? n : z.n
        crt::memcpy(b, reinterpret<void?>(z.p), m)
        z.n -= m
        z.p += m
        b = reinterpret<void?>(reinterpret<uint8?>(b) + m)
        n -= m
    }
    return 0ul
}

