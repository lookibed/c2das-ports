[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_tolstring(var L : lua_State?; idx : int; var len : uint64?) : uint8? {
    var o : TValue?
    o = index2value(L, idx)
    if (!(novariant(o.tt_) == LUA_TSTRING)) {
