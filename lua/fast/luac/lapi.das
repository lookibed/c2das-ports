// Convert an acceptable index to a pointer to its respective value.
// Non-valid indices return the special nil value 'G(L)->nilvalue'.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private index2value(var L : lua_State?; var idx : int) : TValue? {
    var ci : CallInfo? = L.ci
    if (idx > 0) {
        var o : StackValue? = ci.func.p + idx
        if (reinterpret<uint64>(o) >= reinterpret<uint64>(L.top.p)) {
            return addr(G(L).nilvalue)
        } else {
            return s2v(o)
        }
    } elif (!ispseudo(idx)) {
        // negative index
        return s2v(L.top.p + idx)
    } elif (idx == LUA_REGISTRYINDEX) {
        return addr(G(L).l_registry)
    } else {
        // upvalues
        idx = LUA_REGISTRYINDEX - idx
        // C closure?
        if (ttisCclosure(s2v(ci.func.p))) {
            var func : CClosure? = clCvalue(s2v(ci.func.p))
            return (idx <= int(func.nupvalues)) ? addr(addr(func.upvalue[0])[idx - 1]) : addr(G(L).nilvalue)
        } else {
            // light C function or Lua function (through a hook)?)
            // no upvalues
            return addr(G(L).nilvalue)
        }
    }
}

// Convert a valid actual index (not a pseudo-index) to its address.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private index2stack(var L : lua_State?; idx : int) : StackValue? {
    var ci : CallInfo? = L.ci
    if (idx > 0) {
        var o : StackValue? = ci.func.p + idx
        return o
    } else {
        // non-positive index
        return L.top.p + idx
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_checkstack(var L : lua_State?; n : int) : int {
    var res : int
    var ci : CallInfo?
    ci = L.ci
    // stack large enough?
    if (int64(L.stack_last.p - L.top.p) > int64(n)) {
        // yes; check is OK
        res = 1
    } else {
        // need to grow stack
        res = luaD_growstack(L, n, 0)
    }
    if (res != 0 && reinterpret<uint64>(ci.top.p) < reinterpret<uint64>(L.top.p + n)) {
        // adjust frame top
        ci.top.p = L.top.p + n
    }
    return res
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_xmove(var from : lua_State?; var to : lua_State?; n : int) {
    if (from == to) {
        return
    }
    from.top.p -= n
    for (i in range(n)) {
        {
            var io1 : TValue? = s2v(to.top.p)
            var io2 : TValue? = s2v(from.top.p + i)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        // stack already checked by previous 'api_check'
        to.top.p++
    }
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_atpanic(var L : lua_State?; panicf : function<(var a0 : lua_State?) : int>) : function<(var a0 : lua_State?) : int> {
    var old : function<(var a0 : lua_State?) : int>
    old = G(L)._c_panic
    G(L)._c_panic = panicf
    return old
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_version(var L : lua_State?) : double {
    return double(LUA_VERSION_NUM)
}

// convert an acceptable stack index into an absolute index
[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_absindex(var L : lua_State?; idx : int) : int {
    return (idx > 0 || ispseudo(idx)) ? idx : int(int64(L.top.p - L.ci.func.p)) + idx
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_gettop(var L : lua_State?) : int {
    return int(int64(L.top.p - (L.ci.func.p + 1)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_settop(var L : lua_State?; idx : int) {
    var ci : CallInfo?
    var func : StackValue?
    var newtop : StackValue?
    // difference for new top
    var diff : int64
    ci = L.ci
    func = ci.func.p
    if (idx >= 0) {
        diff = int64(((func + 1) + idx) - L.top.p)
        while (diff > 0l) {
            // clear new slots
            var _t0 = L.top.p
            L.top.p++
            addr(_t0.val).tt_ = uint8(LUA_TNIL | (0 << 4))
            diff--
        }
    } else {
        // will "subtract" index (as it is negative)
        diff = int64(idx + 1)
    }
    newtop = L.top.p + diff
    if (diff < 0l && reinterpret<uint64>(L.tbclist.p) >= reinterpret<uint64>(newtop)) {
        newtop = luaF_close(L, newtop, CLOSEKTOP, 0)
    }
    // correct top only after closing any upvalue
    L.top.p = newtop
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_closeslot(var L : lua_State?; idx : int) {
    var level : StackValue?
    level = index2stack(L, idx)
    level = luaF_close(L, level, CLOSEKTOP, 0)
    setnilvalue(s2v(level))
}

// Reverse the stack segment from 'from' to 'to'
// (auxiliary to 'lua_rotate')
// Note that we move(copy) only the value inside the stack.
// (We do not move additional fields that may exist.)
[c_function, unsafe_deref, hint(unsafe_range_check)]
def private reverse(var L : lua_State?; var from : StackValue?; var to : StackValue?) {
    while (reinterpret<uint64>(from) < reinterpret<uint64>(to)) {
        var temp : TValue
        {
            var io1 : TValue? = addr(temp)
            var io2 : TValue? = s2v(from)
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        {
            var io1 : TValue? = s2v(from)
            var io2 : TValue? = s2v(to)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        {
            var io1 : TValue? = s2v(to)
            var io2 : TValue? = addr(temp)
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        from++
        to--
    }
}

// Let x = AB, where A is a prefix of length 'n'. Then,
// rotate x n == BA. But BA == (A^r . B^r)^r.
[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_rotate(var L : lua_State?; idx : int; n : int) {
    var p : StackValue?
    var t : StackValue?
    var m : StackValue?
    // end of stack segment being rotated
    t = L.top.p - 1
    // start of segment
    p = index2stack(L, idx)
    // end of prefix
    m = n >= 0 ? t - n : p - n + -(1)
    // reverse the prefix with length 'n'
    reverse(L, p, m)
    // reverse the suffix
    reverse(L, m + 1, t)
    // reverse the entire segment
    reverse(L, p, t)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_copy(var L : lua_State?; fromidx : int; toidx : int) {
    var fr : TValue?
    var to : TValue?
    fr = index2value(L, fromidx)
    to = index2value(L, toidx)
    {
        var io1 : TValue? = to
        var io2 : TValue? = fr
        io1.value_ = io2.value_
        settt_(io1, io2.tt_)
    }
    // function upvalue?
    if (isupvalue(toidx)) {
        if ((int(fr.tt_) & BIT_ISCOLLECTABLE) != 0) {
            if ((int(addr(reinterpret<GCUnion?>(addr(L.ci.func.p.val).value_.gc).cl.c).marked) & (1 << BLACKBIT)) != 0 &&
                    (int(fr.value_.gc.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
                luaC_barrier_(L, addr(reinterpret<GCUnion?>(addr(reinterpret<GCUnion?>(addr(L.ci.func.p.val).value_.gc).cl.c)).gc),
                        addr(reinterpret<GCUnion?>(fr.value_.gc).gc))
            }
        }
    }
    // LUA_REGISTRYINDEX does not need gc barrier
    // (collector revisits it before finishing collection)
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_pushvalue(var L : lua_State?; idx : int) {
    {
        var io1 : TValue? = s2v(L.top.p)
        var io2 : TValue? = index2value(L, idx)
        io1.value_ = io2.value_
        settt_(io1, io2.tt_)
    }
    api_incr_top(L)
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_type(var L : lua_State?; idx : int) : int {
    var o : TValue? = index2value(L, idx)
    return isvalid(L, o) ? novariant(o.tt_) : LUA_TNONE
}

