[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_isnumber(var L : lua_State?; idx : int) : int {
    var n : double
    var o : TValue? = index2value(L, idx)
    var _t0 : int
    if (ttisfloat(o)) {
        *addr(n) = fltvalue(o)
        _t0 = 1
    } else {
        _t0 = luaV_tonumber_(o, addr(n))
    }
    return _t0
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_isstring(var L : lua_State?; idx : int) : int {
    var o : TValue? = index2value(L, idx)
    return int_of(novariant(o.tt_) == LUA_TSTRING || cvt2str(o))
}

[unsafe_deref, hint(unsafe_range_check)]
