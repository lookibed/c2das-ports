[c_function, unsafe_deref, hint(unsafe_range_check)]
def private auxsetstr(var L : lua_State?; var t : TValue?; var k : uint8?) {
    var slot : TValue?
    var str : TString? = luaS_new(L, k)
    var _t0 : int
    if (!(int(rawtt(t)) == ctb(LUA_TTABLE | (0 << 4)))) {
        slot = null
