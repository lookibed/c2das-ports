}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_rawequal(var L : lua_State?; index1 : int; index2 : int) : int {
    var o1 : TValue? = index2value(L, index1)
    var o2 : TValue? = index2value(L, index2)
    return ((!ttisnil(o1) || o1 != reinterpret<TValue?>(addr(G(L).nilvalue))) &&
                (!ttisnil(o2) || o2 != reinterpret<TValue?>(addr(G(L).nilvalue)))) ? luaV_rawequalobj(o1,
            o2) : 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_arith(var L : lua_State?; op : int) {
    if (op != LUA_OPUNM && op != LUA_OPBNOT) {
        // all other operations expect two operands
    } else {
        // for unary operations, add fake 2nd operand
        {
            var io1 : TValue? = s2v(L.top.p)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        api_incr_top(L)
    }
    // first operand at top - 2, second at top - 1; result go to top - 2
    luaO_arith(L, op, s2v(L.top.p - 2), s2v(L.top.p - 1), L.top.p - 2)
    // remove second operand
    L.top.p--
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_compare(var L : lua_State?; index1 : int; index2 : int; op : int) : int {
    var o1 : TValue?
    var o2 : TValue?
    var i : int = 0
    // may call tag method
    o1 = index2value(L, index1)
    o2 = index2value(L, index2)
    if ((!ttisnil(o1) || o1 != reinterpret<TValue?>(addr(G(L).nilvalue))) && (!ttisnil(o2) || o2 != reinterpret<TValue?>(addr(G(L).nilvalue)))) {
        c_switch(op) {
            case(0) {
                i = luaV_equalobj(L, o1, o2)
                break
            }
            case(1) {
                i = luaV_lessthan(L, o1, o2)
                break
            }
            case(2) {
                i = luaV_lessequal(L, o1, o2)
                break
            }
            case(_) {
            }
        }
    }
    return i
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_stringtonumber(var L : lua_State?; var s : uint8?) : uint64 {
    let sz : uint64 = luaO_str2num(s, s2v(L.top.p))
    if (sz != 0ul) {
        L.top.p++
    }
    return sz
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_tonumberx(var L : lua_State?; idx : int; var pisnum : int?) : double {
    var n : double = 0.0lf
    var o : TValue? = index2value(L, idx)
    var _t0 : int
    if (ttisfloat(o)) {
        *addr(n) = fltvalue(o)
        _t0 = 1
    } else {
        _t0 = luaV_tonumber_(o, addr(n))
    }
    let isnum : int = _t0
    if (pisnum != null) {
        *pisnum = isnum
    }
    return n
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_tointegerx(var L : lua_State?; idx : int; var pisnum : int?) : int64 {
    var res : int64 = 0l
    var o : TValue? = index2value(L, idx)
    var _t0 : int
    if (ttisinteger(o)) {
        *addr(res) = ivalue(o)
        _t0 = 1
    } else {
        _t0 = luaV_tointeger(o, addr(res), F2Imod.F2Ieq)
    }
    let isnum : int = _t0
    if (pisnum != null) {
        *pisnum = isnum
    }
    return res
}

