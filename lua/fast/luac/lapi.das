    if ((int(addr((L.top.p - 1).val).tt_) & BIT_ISCOLLECTABLE) != 0) {
        if ((int(addr(reinterpret<GCUnion?>(t).gc).marked) & (1 << BLACKBIT)) != 0 &&
                (int(addr((L.top.p - 1).val).value_.gc.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
            luaC_barrierback_(L, addr(reinterpret<GCUnion?>(t).gc))
        }
    }
    L.top.p--
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_setmetatable(var L : lua_State?; objindex : int) : int {
    var obj : TValue?
    var mt : Table?
    obj = index2value(L, objindex)
    if (ttisnil(s2v(L.top.p - 1))) {
        mt = null
    } else {
        mt = gco2t(s2v(L.top.p - 1).value_.gc)
    }
    c_switch(ttype(obj)) {
        case(5) {
            gco2t(obj.value_.gc).metatable = mt
            if (mt != null) {
                if ((int(obj.value_.gc.marked) & (1 << BLACKBIT)) != 0 && (int(mt.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
                    luaC_barrier_(L, addr(reinterpret<GCUnion?>(obj.value_.gc).gc), addr(reinterpret<GCUnion?>(mt).gc))
                }
                luaC_checkfinalizer(L, gcvalue(obj), mt)
            }
            break
        }
        case(7) {
            gco2u(obj.value_.gc).metatable = mt
            if (mt != null) {
                if ((int(addr(reinterpret<GCUnion?>(obj.value_.gc).u).marked) & (1 << BLACKBIT)) != 0 &&
                        (int(mt.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
                    luaC_barrier_(L, addr(reinterpret<GCUnion?>(addr(reinterpret<GCUnion?>(obj.value_.gc).u)).gc), addr(reinterpret<GCUnion?>(mt).gc))
                }
                luaC_checkfinalizer(L, gcvalue(obj), mt)
            }
            break
        }
        case(_) {
            G(L).mt[ttype(obj)] = mt
            break
        }
    }
    L.top.p--
    return 1
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_setiuservalue(var L : lua_State?; idx : int; n : int) : int {
    var o : TValue?
    var res : int
    o = index2value(L, idx)
    if (!(uint(n) - 1u < uint(uvalue(o).nuvalue))) {
        // 'n' not in [1, uvalue(o)->nuvalue]
        res = 0
    } else {
        {
            var io1 : TValue? = addr(addr(uvalue(o).uv[0])[n - 1].uv)
            var io2 : TValue? = s2v(L.top.p - 1)
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        if ((int(addr((L.top.p - 1).val).tt_) & BIT_ISCOLLECTABLE) != 0) {
            if ((int(o.value_.gc.marked) & (1 << BLACKBIT)) != 0 &&
                    (int(addr((L.top.p - 1).val).value_.gc.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
                luaC_barrierback_(L, o.value_.gc)
            }
        }
        res = 1
    }
    L.top.p--
    return res
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_callk(var L : lua_State?; nargs : int; nresults : int; ctx : int64; k : function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>) {
    var func : StackValue?
    func = L.top.p - (nargs + 1)
    // need to prepare continuation?
    if (k != null && yieldable(L)) {
        // save continuation
        L.ci.u.c.k = k
        // save context
        L.ci.u.c.ctx = ctx
        // do the call
        luaD_call(L, func, nresults)
    } else {
        // no continuation or no yieldable
        // just do the call
        luaD_callnoyield(L, func, nresults)
    }
    adjustresults(L, nresults)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private f_call(var L : lua_State?; var ud : void?) {
    var c : CallS? = reinterpret<CallS?>(ud)
    luaD_callnoyield(L, c.func, c.nresults)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_pcallk(var L : lua_State?; nargs : int; nresults : int; errfunc : int; ctx : int64;
               k : function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>) : int {
    var c : CallS
    var status : int
    var func : int64
    if (errfunc == 0) {
        func = 0l
    } else {
        var o : StackValue? = index2stack(L, errfunc)
        func = savestack(L, o)
    }
    // function to be called
    c.func = L.top.p - (nargs + 1)
    // no continuation or no yieldable?
    if (k == null || !yieldable(L)) {
        // do a 'conventional' protected call
        c.nresults = nresults
        status = luaD_pcall(L, @@f_call, reinterpret<void?>(addr(c)), savestack(L, c.func), func)
    } else {
        // prepare continuation (call is already protected by 'resume')
        var ci : CallInfo? = L.ci
        // save continuation
        ci.u.c.k = k
        // save context
        ci.u.c.ctx = ctx
        // save information for error recovery
        ci.u2.funcidx = int(savestack(L, c.func))
        ci.u.c.old_errfunc = L.errfunc
        L.errfunc = func
        // save value of 'allowhook'
        ci.callstatus = uint16((int(ci.callstatus) & ~CIST_OAH) | int(L.allowhook))
        // function can do error recovery
        ci.callstatus = uint16(int(ci.callstatus) | CIST_YPCALL)
        // do the call
        luaD_call(L, c.func, nresults)
        ci.callstatus = uint16(int(ci.callstatus) & ~CIST_YPCALL)
        L.errfunc = ci.u.c.old_errfunc
        // if it is here, there were no errors
        status = LUA_OK
    }
    adjustresults(L, nresults)
    return status
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_load(var L : lua_State?; reader : function<(var a0 : lua_State?; var a1 : void?; var a2 : uint64?) : uint8?>; var data : void?; var chunkname : uint8?;
             var mode : uint8?) : int {
    var z : Zio
    var status : int
    if (chunkname == null) {
        chunkname = cstr("?")
    }
    luaZ_init(L, addr(z), reader, data)
    status = luaD_protectedparser(L, addr(z), chunkname, mode)
    // no errors?
    if (status == LUA_OK) {
        // get new function
        var f : LClosure? = gco2lcl(s2v(L.top.p - 1).value_.gc)
        // does it have an upvalue?
        if (int(f.nupvalues) >= 1) {
            // get global table from registry
            var gt : TValue? = getGtable(L)
            {
                // set global table as 1st upvalue of 'f' (may be LUA_ENV)
                var io1 : TValue? = addr(f.upvals[0])[0].v.p
                var io2 : TValue? = gt
                io1.value_ = io2.value_
                settt_(io1, io2.tt_)
            }
            if (iscollectable(gt) != 0) {
                if ((int(addr(f.upvals[0])[0].marked) & (1 << BLACKBIT)) != 0 && (int(gcvalue(gt).marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
                    luaC_barrier_(L, addr(reinterpret<GCUnion?>(addr(f.upvals[0])[0]).gc), addr(reinterpret<GCUnion?>(gcvalue(gt)).gc))
                }
            }
        }
    }
    return status
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_dump(var L : lua_State?; writer : function<(var a0 : lua_State?; var a1 : void?; a2 : uint64; var a3 : void?) : int>; var data : void?;
             strip : int) : int {
    var status : int
    var o : TValue?
    o = s2v(L.top.p - 1)
    if (isLfunction(o)) {
        status = luaU_dump(L, getproto(o), writer, data, strip)
    } else {
        status = 1
    }
    return status
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_status(var L : lua_State?) : int {
    return int(L.status)
}

// Garbage-collection function
[unsafe_deref, hint(unsafe_range_check), variadic]
def lua_gc(var L : lua_State?; what : int; va : va_args) : int {
    var argp : CVaCursor
    var res : int = 0
    var g : global_State? = G(L)
    // internal stop?
    if ((int(g.gcstp) & GCSTPGC) != 0) {
        // all options are invalid when stopped
        return -1
    }
    argp = va_begin(va)
    c_switch(what) {
        case(0) {
            // stopped by the user
            g.gcstp = uint8(GCSTPUSR)
            break
        }
        case(1) {
            luaE_setdebt(g, 0l)
            // (GCSTPGC must be already zero here)
            g.gcstp = 0u8
            break
        }
        case(2) {
            luaC_fullgc(L, 0)
            break
        }
        case(3) {
            // GC values are expressed in Kbytes: #bytes/2^10
            res = int(gettotalbytes(g) >> 10ul)
            break
        }
        case(4) {
            res = int(gettotalbytes(g) & 1023ul)
            break
        }
        case(5) {
            {
                let data : int = int(va_i(argp))
                // =1 to signal that it did an actual step
                var debt : int64 = 1l
                let oldstp : uint8 = g.gcstp
                // allow GC to run (GCSTPGC must be zero here)
                g.gcstp = 0u8
                if (data == 0) {
                    // do a basic step
                    luaE_setdebt(g, 0l)
                    luaC_step(L)
                } else {
                    // add 'data' to total debt
                    debt = int64(data) * 1024l + g.GCdebt
                    luaE_setdebt(g, debt)
                    luaC_checkGC(L)
                }
                // restore previous state
                g.gcstp = oldstp
                // end of cycle?
                if (debt > 0l && int(g.gcstate) == GCSpause) {
                    // signal it
                    res = 1
                }
                break
            }
        }
        case(6) {
            {
                let data : int = int(va_i(argp))
                res = getgcparam(g.gcpause)
                g.gcpause = uint8(data / 4)
                break
            }
        }
        case(7) {
            {
                let data : int = int(va_i(argp))
                res = getgcparam(g.gcstepmul)
                g.gcstepmul = uint8(data / 4)
                break
            }
        }
        case(9) {
            res = int_of(gcrunning(g))
            break
        }
        case(10) {
            {
                let minormul : int = int(va_i(argp))
                let majormul : int = int(va_i(argp))
                res = isdecGCmodegen(g) ? LUA_GCGEN : LUA_GCINC
                if (minormul != 0) {
                    g.genminormul = uint8(minormul)
                }
                if (majormul != 0) {
                    g.genmajormul = uint8(majormul / 4)
                }
                luaC_changemode(L, KGC_GEN)
                break
            }
        }
        case(11) {
            {
                let pause : int = int(va_i(argp))
                let stepmul : int = int(va_i(argp))
                let stepsize : int = int(va_i(argp))
                res = isdecGCmodegen(g) ? LUA_GCGEN : LUA_GCINC
                if (pause != 0) {
                    g.gcpause = uint8(pause / 4)
                }
                if (stepmul != 0) {
                    g.gcstepmul = uint8(stepmul / 4)
                }
                if (stepsize != 0) {
                    g.gcstepsize = uint8(stepsize)
                }
                luaC_changemode(L, KGC_INC)
                break
            }
        }
        case(_) {
            // invalid option
            res = -1
        }
    }
    return res
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_error(var L : lua_State?) : int {
    var errobj : TValue?
    errobj = s2v(L.top.p - 1)
    // error object is the memory error message?
    if (ttisshrstring(errobj) && eqshrstr(tsvalue(errobj), G(L).memerrmsg)) {
        // raise a memory error
        luaM_error(L)
    } else {
        // raise a regular error
        luaG_errormsg(L)
    }
    // code unreachable; will unlock when control actually leaves the kernel
    // to avoid warnings
    return 0
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_next(var L : lua_State?; idx : int) : int {
    var t : Table?
    var more : int
    t = gettable(L, idx)
    more = luaH_next(L, t, L.top.p - 1)
    if (more != 0) {
        api_incr_top(L)
    } else {
        // no more elements
        // remove key
        L.top.p -= 1
    }
    return more
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_toclose(var L : lua_State?; idx : int) {
    var nresults : int
    var o : StackValue?
    o = index2stack(L, idx)
    nresults = int(L.ci.nresults)
    // create new to-be-closed upvalue
    luaF_newtbcupval(L, o)
    // function not marked yet?
    if (!hastocloseCfunc(nresults)) {
        // mark it
        L.ci.nresults = int16(codeNresults(nresults))
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_concat(var L : lua_State?; n : int) {
    if (n > 0) {
        luaV_concat(L, n)
    } else {
        {
            // nothing to concatenate
            // push empty string
            var io : TValue? = s2v(L.top.p)
            var x_ : TString? = luaS_newlstr(L, addr(c2das_empty[0]), 0ul)
            io.value_.gc = obj2gco(x_)
            settt_(io, ctb(x_.tt))
        }
        api_incr_top(L)
    }
    luaC_checkGC(L)
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_len(var L : lua_State?; idx : int) {
    var t : TValue?
    t = index2value(L, idx)
    luaV_objlen(L, L.top.p, t)
    api_incr_top(L)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_getallocf(var L : lua_State?; var ud : void ??) : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?> {
    var f : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?>
    if (ud != null) {
        *ud = G(L).ud
    }
    f = G(L).frealloc
    return f
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_setallocf(var L : lua_State?; f : function<(var a0 : void?; var a1 : void?; a2 : uint64; a3 : uint64) : void?>; var ud : void?) {
    G(L).ud = ud
    G(L).frealloc = f
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_setwarnf(var L : lua_State?; f : function<(var a0 : void?; var a1 : uint8?; a2 : int) : void>; var ud : void?) {
    G(L).ud_warn = ud
    G(L).warnf = f
}

[unsafe_deref, hint(unsafe_range_check)]
def lua_warning(var L : lua_State?; var msg : uint8?; tocont : int) {
    luaE_warning(L, msg, tocont)
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_newuserdatauv(var L : lua_State?; size : uint64; nuvalue : int) : void? {
    var u : Udata?
    u = luaS_newudata(L, size, nuvalue)
    {
        var io : TValue? = s2v(L.top.p)
        var x_ : Udata? = u
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(LUA_TUSERDATA | (0 << 4)))
    }
    api_incr_top(L)
    luaC_checkGC(L)
    return reinterpret<void?>(reinterpret<uint8?>(u) + (u.nuvalue == 0 ? uint64(typeinfo offsetof < bindata > (type<Udata0>)) :
            uint64(typeinfo offsetof < uv > (type<Udata>)) + uint64(typeinfo sizeof(type<UValue>)) * uint64(u.nuvalue)))
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private aux_upvalue(var fi : TValue?; n : int; var val : TValue ??; var owner : GCObject ??) : uint8? {
    c_switch(ttypetag(fi)) {
        case(38) {
            {
                // C closure
                var f : CClosure? = clCvalue(fi)
                if (!(uint(n) - 1u < uint(f.nupvalues))) {
                    // 'n' not in [1, f->nupvalues]
                    return null
                }
                *val = addr(addr(f.upvalue[0])[n - 1])
                if (owner != null) {
                    *owner = obj2gco(f)
                }
                return addr(c2das_empty[0])
            }
        }
        case(6) {
            {
                // Lua closure
                var f : LClosure? = gco2lcl(fi.value_.gc)
                var name : TString?
                var p : Proto? = f.p
                if (!(uint(n) - 1u < uint(p.sizeupvalues))) {
                    // 'n' not in [1, p->sizeupvalues]
                    return null
                }
                *val = addr(f.upvals[0])[n - 1].v.p
                if (owner != null) {
                    *owner = obj2gco(addr(f.upvals[0])[n - 1])
                }
                name = p.upvalues[n - 1].name
                return (name == null) ? cstr("(no name)") : addr(name.contents[0])
            }
        }
        case(_) {
            // not a closure
            return null
        }
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_getupvalue(var L : lua_State?; funcindex : int; n : int) : uint8? {
    var name : uint8?
    // to avoid warnings
    var val : TValue? = null
    name = aux_upvalue(index2value(L, funcindex), n, addr(val), null)
    if (name != null) {
        {
            var io1 : TValue? = s2v(L.top.p)
            var io2 : TValue? = val
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        api_incr_top(L)
    }
    return name
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_setupvalue(var L : lua_State?; funcindex : int; n : int) : uint8? {
    var name : uint8?
    // to avoid warnings
    var val : TValue? = null
    // to avoid warnings
    var owner : GCObject? = null
    var fi : TValue?
    fi = index2value(L, funcindex)
    name = aux_upvalue(fi, n, addr(val), addr(owner))
    if (name != null) {
        L.top.p--
        {
            var io1 : TValue? = val
            var io2 : TValue? = s2v(L.top.p)
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        luaC_barrier(L, owner, val)
    }
    return name
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def private getupvalref(var L : lua_State?; fidx : int; n : int; var pf : LClosure ??) : UpVal ?? {
    var f : LClosure?
    var fi : TValue? = index2value(L, fidx)
    f = gco2lcl(fi.value_.gc)
    if (pf != null) {
        *pf = f
    }
    if (1 <= n && n <= f.p.sizeupvalues) {
        // get its upvalue pointer
        return addr(addr(f.upvals[0])[n - 1])
    } else {
        return addr(getupvalref_nullup)
    }
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_upvalueid(var L : lua_State?; fidx : int; n : int) : void? {
    var fi : TValue? = index2value(L, fidx)
    c_switch(ttypetag(fi)) {
        case(6) {
            // lua closure
            return reinterpret<void?>(*getupvalref(L, fidx, n, null))
        }
        case(38) {
            {
                // C closure
                var f : CClosure? = clCvalue(fi)
                if (1 <= n && n <= int(f.nupvalues)) {
                    return reinterpret<void?>(addr(addr(f.upvalue[0])[n - 1]))
                }
            }
        }
        case(22) {
            // else
            // FALLTHROUGH
            // light C functions have no upvalues
            return null
        }
        case(_) {
            return null
        }
    }
    return null
}

[c_function, unsafe_deref, hint(unsafe_range_check)]
def lua_upvaluejoin(var L : lua_State?; fidx1 : int; n1 : int; fidx2 : int; n2 : int) {
    var f1 : LClosure?
    var up1 : UpVal ?? = getupvalref(L, fidx1, n1, addr(f1))
    var up2 : UpVal ?? = getupvalref(L, fidx2, n2, null)
    *up1 = *up2
    if (isblack(f1) != 0 && iswhite(*up1) != 0) {
        luaC_barrier_(L, obj2gco(f1), obj2gco(*up1))
    }
}

