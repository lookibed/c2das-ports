        f.locvars[i].startpc = loadInt(S)
        f.locvars[i].endpc = loadInt(S)
    }
    n = loadInt(S)
    // does it have debug information?
    if (n != 0) {
        // must be this many
        n = f.sizeupvalues
    }
    for (i in range(n)) {
