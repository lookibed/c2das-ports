// Load a nullable string into prototype 'p'.
[c_function]
def private loadStringN(var S : LoadState?; var p : Proto?) : TString? {
    var L : lua_State? = S.L
    var ts : TString?
    var size : uint64 = loadSize(S)
    // no string?
    if (size == 0ul) {
        return null
    } else {
        // short string?
        size--
        if (size <= uint64(LUAI_MAXSHORTLEN)) {
            var buff : uint8[40]
            // load string into buffer
            loadBlock(S, reinterpret<void?>(addr(buff[0])), size * uint64(typeinfo sizeof(type<uint8>)))
            // create string
            ts = luaS_newlstr(L, addr(buff[0]), size)
        } else {
            // long string
            // create string
            ts = luaS_createlngstrobj(L, size)
            {
                // anchor it ('loadVector' can GC)
                var io : TValue? = addr(L.top.p.val)
                var x_ : TString? = ts
                io.value_.gc = addr(reinterpret<GCUnion?>(x_).gc)
                io.tt_ = uint8(int(x_.tt) | BIT_ISCOLLECTABLE)
            }
            luaD_inctop(L)
            // load directly in final place
            loadBlock(S, reinterpret<void?>(addr(ts.contents[0])), size * uint64(typeinfo sizeof(type<uint8>)))
            // pop string
            L.top.p = L.top.p - 1
        }
    }
    if ((int(p.marked) & (1 << BLACKBIT)) != 0 && (int(ts.marked) & ((1 << WHITE0BIT) | (1 << WHITE1BIT))) != 0) {
        luaC_barrier_(L, addr(reinterpret<GCUnion?>(p).gc), addr(reinterpret<GCUnion?>(ts).gc))
    }
    return ts
}

// Load a non-nullable string into prototype 'p'.
[c_function]
def private loadString(var S : LoadState?; var p : Proto?) : TString? {
    var st : TString? = loadStringN(S, p)
    if (st == null) {
        error(S, cstr("bad format for constant string"))
    }
    return st
}

[c_function]
def private loadCode(var S : LoadState?; var f : Proto?) {
    var n : int = loadInt(S)
    if (uint64(typeinfo sizeof(type<int>)) >= uint64(typeinfo sizeof(type<uint64>)) && uint64(n) + 1ul > MAX_SIZET / uint64(typeinfo sizeof(type<uint>))) {
        luaM_toobig(S.L)
    }
    f.code = reinterpret<uint?>(luaM_malloc_(S.L, uint64(n) * uint64(typeinfo sizeof(type<uint>)), 0))
    f.sizecode = n
    loadBlock(S, reinterpret<void?>(f.code), uint64(n) * uint64(typeinfo sizeof(type<uint>)))
}

[c_function]
