[c_function]
def private loadProtos(var S : LoadState?; var f : Proto?) {
    var n : int = loadInt(S)
    if (uint64(typeinfo sizeof(type<int>)) >= uint64(typeinfo sizeof(type<uint64>)) && uint64(n) + 1ul > MAX_SIZET / uint64(typeinfo sizeof(type<Proto?>))) {
        luaM_toobig(S.L)
