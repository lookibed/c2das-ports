    // now it is
    set2gray(o)
}

// Clear keys for empty entries in tables. If entry is empty, mark its
// entry as dead. This allows the collection of the key, but keeps its
// entry in the table: its removal could break a chain and could break
// a table traversal. Other places never manipulate dead keys, because
// its associated empty value is enough to signal that the entry is
// logically empty.
def private clearkey(var n : Node?) {
    if (keyiscollectable(n) != 0) {
        // unused key; remove it
        setdeadkey(n)
    }
}

// tells whether a key or value can be cleared from a weak
// table. Non-collectable objects are never removed from weak
// tables. Strings behave as 'values', so are never removed too. for
// other objects: if really collected, cannot keep them; for objects
// being finalized, keep them in keys, but not in values
[c_function]
def private iscleared(var g : global_State?; var o : GCObject?) : int {
    // non-collectable value
    if (o == null) {
        return 0
    } elif (novariant(o.tt) == LUA_TSTRING) {
        markobject(g, o)
        // strings are 'values', so are never weak
        return 0
    } else {
        return iswhite(o)
    }
}

// Barrier that moves collector forward, that is, marks the white object
// 'v' being pointed by the black object 'o'. In the generational
// mode, 'v' must also become old, if 'o' is old; however, it cannot
// be changed directly to OLD, because it may still point to non-old
// objects. So, it is marked as OLD0. In the next cycle it will become
// OLD1, and in the next it will finally become OLD (regular old). By
// then, any object it points to will also be old. If called in the
// incremental sweep phase, it clears the black object to white (sweep
// it) to avoid other barrier calls for this same object. (That cannot
// be done is generational mode, as its sweep does not distinguish
// whites from deads.)
def luaC_barrier_(var L : lua_State?; var o : GCObject?; var v : GCObject?) {
    var g : global_State? = G(L)
    // must keep invariant?
    if (keepinvariant(g)) {
        // restore invariant
        reallymarkobject(g, v)
        if (isold(o)) {
            // white object could not be old
            // restore generational invariant
            v.marked = uint8((int(v.marked) & ~AGEBITS) | G_OLD0)
        }
    } else {
        // sweep phase
        // incremental mode?
        if (int(g.gckind) == KGC_INC) {
            // mark 'o' as white to avoid other barriers
            makewhite(g, o)
        }
    }
}

// barrier that moves collector backward, that is, mark the black object
// pointing to a white object as gray again.
[c_function]
def luaC_barrierback_(var L : lua_State?; var o : GCObject?) {
    var g : global_State? = G(L)
    // already in gray list?
    if (getage(o) == G_TOUCHED2) {
        // make it gray to become touched1
        set2gray(o)
    } else {
        // link it in 'grayagain' and paint it gray
        linkgclist_(obj2gco(o), getgclist(o), addr(g.grayagain))
    }
    // generational mode?
    if (isold(o)) {
        // touched in current cycle
        o.marked = uint8((int(o.marked) & ~AGEBITS) | G_TOUCHED1)
    }
}

def luaC_fix(var L : lua_State?; var o : GCObject?) {
    var g : global_State? = G(L)
    // object must be 1st in 'allgc' list!
    // they will be gray forever
    set2gray(o)
    // and old forever
    o.marked = uint8((int(o.marked) & ~AGEBITS) | G_OLD)
    // remove object from 'allgc' list
    g.allgc = o.next
    // link it to 'fixedgc' list
    o.next = g.fixedgc
    g.fixedgc = o
}

// create a new collectable object (with given type, size, and offset)
// and link it to 'allgc' list.
[c_function]
def luaC_newobjdt(var L : lua_State?; tt : int; sz : uint64; offset : uint64) : GCObject? {
    var g : global_State? = G(L)
    var p : uint8? = reinterpret<uint8?>(luaM_newobject(L, novariant(tt), sz))
    var o : GCObject? = reinterpret<GCObject?>(p + offset)
    o.marked = luaC_white(g)
    o.tt = uint8(tt)
    o.next = g.allgc
    g.allgc = o
    return o
}

def luaC_newobj(var L : lua_State?; tt : int; sz : uint64) : GCObject? {
    return __::luaC_newobjdt(L, tt, sz, 0ul)
}

// Mark an object. Userdata with no user values, strings, and closed
// upvalues are visited and turned black here. Open upvalues are
// already indirectly linked through their respective threads in the
// 'twups' list, so they don't go to the gray list; nevertheless, they
// are kept gray to avoid barriers, as their values will be revisited
// by the thread or by 'remarkupvals'. Other objects are added to the
// gray list to be visited (and turned black) later. Both userdata and
// upvalues can call this function recursively, but this recursion goes
// for at most two levels: An upvalue cannot refer to another upvalue
// (only closures can), and a userdata's metatable must be a table.
[c_function]
def private reallymarkobject(var g : global_State?; var o : GCObject?) {
    c_switch(int(o.tt)) {
        case(4, 20) {
            // nothing to visit
            set2black(o)
            break
        }
        case(9) {
            {
                var uv : UpVal? = gco2upv(o)
                if (upisopen(uv)) {
                    // open upvalues are kept gray
                    set2gray(uv)
                } else {
                    // closed upvalues are visited here
                    set2black(uv)
                }
                {
                    // mark its content
                    let _t0 = g.mainthread
                    if (iscollectable(uv.v.p) != 0 && testbits(gcvalue(uv.v.p).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
                        reallymarkobject(g, gcvalue(uv.v.p))
                    }
                }
                break
            }
        }
        case(7) {
            {
                var u : Udata? = gco2u(o)
                // no user values?
                if (u.nuvalue == 0) {
                    // mark its metatable
                    if (u.metatable != null) {
                        if (iswhite(u.metatable) != 0) {
                            reallymarkobject(g, obj2gco(u.metatable))
                        }
                    }
                    // nothing else to mark
                    set2black(u)
                    break
                }
            }
        }
        case(6, 38, 5, 8, 10) {
            // else...
            // FALLTHROUGH
            // to be visited later
            linkgclist_(obj2gco(o), getgclist(o), addr(g.gray))
            break
        }
        case(_) {
            break
        }
    }
}

// mark metamethods for basic types
def private markmt(var g : global_State?) {
    for (i in range(LUA_NUMTAGS)) {
        if (g.mt[i] != null) {
            if (iswhite(g.mt[i]) != 0) {
                reallymarkobject(g, obj2gco(g.mt[i]))
            }
        }
    }
}

// mark all objects in list of being-finalized
[c_function]
def private markbeingfnz(var g : global_State?) : uint64 {
    var o : GCObject?
    var count : uint64 = 0ul
    o = g.tobefnz
    while (o != null) {
        count++
        markobject(g, o)
        o = o.next
    }
    return count
}

// For each non-marked thread, simulates a barrier between each open
// upvalue and its value. (If the thread is collected, the value will be
// assigned to the upvalue, but then it can be too late for the barrier
// to act. The "barrier" does not need to check colors: A non-marked
// thread must be young; upvalues cannot be older than their threads; so
// any visited upvalue must be young too.) Also removes the thread from
// the list, as it was already visited. Removes also threads with no
// upvalues, as they have nothing to be checked. (If the thread gets an
// upvalue later, it will be linked in the list again.)
[c_function]
def private remarkupvals(var g : global_State?) : int {
    var thread : lua_State?
    var p : lua_State ?? = addr(g.twups)
    // estimate of how much work was done here
    var work : int = 0
    while (true) {
        thread = *p
        if (!(thread != null)) {
            break
        }
        work++
        if (iswhite(thread) == 0 && thread.openupval != null) {
            // keep marked thread with upvalues in the list
            p = addr(thread.twups)
        } else {
            // thread is not marked or without upvalues
            var uv : UpVal?
            // remove thread from the list
            *p = thread.twups
            // mark that it is out of list
            thread.twups = thread
            uv = thread.openupval
            while (uv != null) {
                work++
                // upvalue already visited?
                if (iswhite(uv) == 0) {
                    {
                        // mark its value
                        let _t0 = g.mainthread
                        if (iscollectable(uv.v.p) != 0 && testbits(gcvalue(uv.v.p).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
                            reallymarkobject(g, gcvalue(uv.v.p))
                        }
                    }
                }
                uv = uv.u.open.next
            }
        }
    }
    return work
}

def private cleargraylists(var g : global_State?) {
    g.grayagain = null
    g.gray = g.grayagain
    g.ephemeron = null
    g.allweak = g.ephemeron
    g.weak = g.allweak
}

// mark root set and reset all gray lists, to start a new collection
[c_function]
def private restartcollection(var g : global_State?) {
    cleargraylists(g)
    if (iswhite(g.mainthread) != 0) {
        reallymarkobject(g, obj2gco(g.mainthread))
    }
    {
        let _t0 = g.mainthread
        if (iscollectable(addr(g.l_registry)) != 0 && testbits(gcvalue(addr(g.l_registry)).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            reallymarkobject(g, gcvalue(addr(g.l_registry)))
        }
    }
    markmt(g)
    // mark any finalizing object left from previous cycle
    markbeingfnz(g)
}

// Check whether object 'o' should be kept in the 'grayagain' list for
// post-processing by 'correctgraylist'. (It could put all old objects
// in the list and leave all the work to 'correctgraylist', but it is
// more efficient to avoid adding elements that will be removed.) Only
// TOUCHED1 objects need to be in the list. TOUCHED2 doesn't need to go
// back to a gray list, but then it must become OLD. (That is what
// 'correctgraylist' does when it finds a TOUCHED2 object.)
[c_function]
def private genlink(var g : global_State?; var o : GCObject?) {
    // touched in this cycle?
    if (getage(o) == G_TOUCHED1) {
        // link it back in 'grayagain'
        linkgclist_(obj2gco(o), getgclist(o), addr(g.grayagain))
    } elif (getage(o) == G_TOUCHED2) {
        // everything else do not need to be linked back
        // advance age
        changeage(o, G_TOUCHED2, G_OLD)
    }
}

// Traverse a table with weak values and link it to proper list. During
// propagate phase, keep it in 'grayagain' list, to be revisited in the
// atomic phase. In the atomic phase, if table has any white value,
// put it in 'weak' list, to be cleared.
[c_function]
def private traverseweakvalue(var g : global_State?; var h : Table?) {
    var n : Node?
    var limit : Node? = gnodelast(h)
    // if there is array part, assume it may have white values (it is not
    // worth traversing it now just to check)
    var hasclears : int = int_of(h.alimit > 0u)
    // traverse hash part
    n = gnode(h, 0)
    while (intptr(n) < intptr(limit)) {
        // entry is empty?
        if (ttisnil(gval(n))) {
            // clear its key
            clearkey(n)
        } else {
            markkey(g, n)
            // a white value?
            if (hasclears == 0 && iscleared(g, iscollectable(gval(n)) != 0 ? addr(n.i_val).value_.gc : null) != 0) {
                // table will have to be cleared
                hasclears = 1
            }
        }
        n++
    }
    if (int(g.gcstate) == GCSatomic && hasclears != 0) {
        // has to be cleared later
        linkgclist_(obj2gco(h), addr(h.gclist), addr(g.weak))
    } else {
        // must retraverse it in atomic phase
        linkgclist_(obj2gco(h), addr(h.gclist), addr(g.grayagain))
    }
}

// Traverse an ephemeron table and link it to proper list. Returns true
// iff any object was marked during this traversal (which implies that
// convergence has to continue). During propagation phase, keep table
// in 'grayagain' list, to be visited again in the atomic phase. In
// the atomic phase, if table has any white->white entry, it has to
// be revisited during ephemeron convergence (as that key may turn
// black). Otherwise, if it has any white key, table has to be cleared
// (in the atomic phase). In generational mode, some tables
// must be kept in some gray list for post-processing; this is done
// by 'genlink'.
[c_function]
def private traverseephemeron(var g : global_State?; var h : Table?; inv : int) : int {
    // true if an object is marked in this traversal
    var marked : int = 0
    // true if table has white keys
    var hasclears : int = 0
    // true if table has entry "white-key -> white-value"
    var hasww : int = 0
    let asize : uint = luaH_realasize(h)
    let nsize : uint = uint(sizenode(h))
    // traverse array part
    for (i in urange(asize)) {
        if (iscollectable(addr(h._c_array[i])) != 0 && testbits(gcvalue(addr(h._c_array[i])).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            marked = 1
            reallymarkobject(g, gcvalue(addr(h._c_array[i])))
        }
    }
    // traverse hash part; if 'inv', traverse descending
    // (see 'convergeephemerons')
    for (i in urange(nsize)) {
        var n : Node? = inv != 0 ? addr(h.node[nsize - 1u - i]) : gnode(h, i)
        // entry is empty?
        if (ttisnil(gval(n))) {
            // clear its key
            clearkey(n)
        } elif (iscleared(g, gckeyN(n)) != 0) {
            // key is not marked (yet)?
            // table must be cleared
            hasclears = 1
            // value not marked yet?
            if (iscollectable(gval(n)) != 0 && testbits(gcvalue(gval(n)).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
                // white-white entry
                hasww = 1
            }
        } elif (iscollectable(gval(n)) != 0 && testbits(gcvalue(gval(n)).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            // value not marked yet?
            marked = 1
            // mark it now
            reallymarkobject(g, gcvalue(gval(n)))
        }
    }
    // link table into proper list
    if (int(g.gcstate) == GCSpropagate) {
        // must retraverse it in atomic phase
        linkgclist_(obj2gco(h), addr(h.gclist), addr(g.grayagain))
    } elif (hasww != 0) {
        // table has white->white entries?
        // have to propagate again
        linkgclist_(obj2gco(h), addr(h.gclist), addr(g.ephemeron))
    } elif (hasclears != 0) {
        // table has white keys?
        // may have to clean white keys
        linkgclist_(obj2gco(h), addr(h.gclist), addr(g.allweak))
    } else {
        // check whether collector still needs to see it
        genlink(g, obj2gco(h))
    }
    return marked
}

[c_function]
def private traversestrongtable(var g : global_State?; var h : Table?) {
    var n : Node?
    var limit : Node? = gnodelast(h)
    let asize : uint = luaH_realasize(h)
    // traverse array part
    for (i in urange(asize)) {
        let _t0 = g.mainthread
        if (iscollectable(addr(h._c_array[i])) != 0 && testbits(gcvalue(addr(h._c_array[i])).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            reallymarkobject(g, gcvalue(addr(h._c_array[i])))
        }
    }
    // traverse hash part
    n = gnode(h, 0)
    while (intptr(n) < intptr(limit)) {
        // entry is empty?
        if (ttisnil(gval(n))) {
            // clear its key
            clearkey(n)
        } else {
            markkey(g, n)
            {
                let _t1 = g.mainthread
                if (iscollectable(gval(n)) != 0 && testbits(gcvalue(gval(n)).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
                    reallymarkobject(g, gcvalue(gval(n)))
                }
            }
        }
        n++
    }
    genlink(g, obj2gco(h))
}

[c_function]
def private traversetable(var g : global_State?; var h : Table?) : uint64 {
    var weakkey : uint8?
    var weakvalue : uint8?
    var mode : TValue? = h.metatable == null ? default<TValue?> : ((uint(h.metatable.flags) & (1u << uint(TMS.TM_MODE))) != 0 ? default<TValue?> :
            luaT_gettm(h.metatable, TMS.TM_MODE, g.tmname[int(TMS.TM_MODE)]))
    var smode : TString?
    if (h.metatable != null) {
        if (iswhite(h.metatable) != 0) {
            reallymarkobject(g, obj2gco(h.metatable))
        }
    }
    // is there a weak mode?
    var _t0 = mode != null && ttisshrstring(mode)
    if (_t0) {
        smode = addr(reinterpret<GCUnion?>(mode.value_.gc).ts)
        weakkey = crt::strchr(addr(smode.contents[0]), 'k')
        weakvalue = crt::strchr(addr(smode.contents[0]), 'v')
        _t0 = weakkey != null || weakvalue != null
    }
    if (_t0) {
        // is really weak?
        // strong keys?
        if (weakkey == null) {
            traverseweakvalue(g, h)
        } elif (weakvalue == null) {
            // strong values?
            traverseephemeron(g, h, 0)
        } else {
            // all weak
            // nothing to traverse now
            linkgclist_(obj2gco(h), addr(h.gclist), addr(g.allweak))
        }
    } else {
        // not weak
        traversestrongtable(g, h)
    }
    return uint64(1u + h.alimit + uint(2 * allocsizenode(h)))
}

[c_function]
def private traverseudata(var g : global_State?; var u : Udata?) : int {
    var i : int
    // mark its metatable
    if (u.metatable != null) {
        if (iswhite(u.metatable) != 0) {
            reallymarkobject(g, obj2gco(u.metatable))
        }
    }
    i = 0
    while (i < int(u.nuvalue)) {
        let _t0 = g.mainthread
        if (iscollectable(addr(addr(u.uv[0])[i].uv)) != 0 && testbits(gcvalue(addr(addr(u.uv[0])[i].uv)).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            reallymarkobject(g, gcvalue(addr(addr(u.uv[0])[i].uv)))
        }
        i++
    }
    genlink(g, obj2gco(u))
    return 1 + int(u.nuvalue)
}

// Traverse a prototype. (While a prototype is being build, its
// arrays can be larger than needed; the extra slots are filled with
// NULL, so the use of 'markobjectN')
[c_function]
def private traverseproto(var g : global_State?; var f : Proto?) : int {
    var i : int
    if (f.source != null) {
        if (iswhite(f.source) != 0) {
            reallymarkobject(g, obj2gco(f.source))
        }
    }
    // mark literals
    i = 0
    while (i < f.sizek) {
        let _t0 = g.mainthread
        if (iscollectable(addr(f.k[i])) != 0 && testbits(gcvalue(addr(f.k[i])).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            reallymarkobject(g, gcvalue(addr(f.k[i])))
        }
        i++
    }
    // mark upvalue names
    i = 0
    while (i < f.sizeupvalues) {
        if (f.upvalues[i].name != null) {
            if (iswhite(f.upvalues[i].name) != 0) {
                reallymarkobject(g, obj2gco(f.upvalues[i].name))
            }
        }
        i++
    }
    // mark nested protos
    i = 0
    while (i < f.sizep) {
        if (f.p[i] != null) {
            if (iswhite(f.p[i]) != 0) {
                reallymarkobject(g, obj2gco(f.p[i]))
            }
        }
        i++
    }
    // mark local-variable names
    i = 0
    while (i < f.sizelocvars) {
        if (f.locvars[i].varname != null) {
            if (iswhite(f.locvars[i].varname) != 0) {
                reallymarkobject(g, obj2gco(f.locvars[i].varname))
            }
        }
        i++
    }
    return 1 + f.sizek + f.sizeupvalues + f.sizep + f.sizelocvars
}

[c_function]
def private traverseCclosure(var g : global_State?; var cl : CClosure?) : int {
    var i : int
    // mark its upvalues
    i = 0
    while (i < int(cl.nupvalues)) {
        let _t0 = g.mainthread
        if (iscollectable(addr(addr(cl.upvalue[0])[i])) != 0 &&
                testbits(gcvalue(addr(addr(cl.upvalue[0])[i])).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            reallymarkobject(g, gcvalue(addr(addr(cl.upvalue[0])[i])))
        }
        i++
    }
    return 1 + int(cl.nupvalues)
}

// Traverse a Lua closure, marking its prototype and its upvalues.
// (Both can be NULL while closure is being created.)
[c_function]
def private traverseLclosure(var g : global_State?; var cl : LClosure?) : int {
    var i : int
    // mark its prototype
    if (cl.p != null) {
        if (iswhite(cl.p) != 0) {
            reallymarkobject(g, obj2gco(cl.p))
        }
    }
    // visit its upvalues
    i = 0
    while (i < int(cl.nupvalues)) {
        var uv : UpVal? = addr(cl.upvals[0])[i]
        markobjectN(g, uv)
        // mark upvalue
        i++
    }
    return 1 + int(cl.nupvalues)
}

// Traverse a thread, marking the elements in the stack up to its top
// and cleaning the rest of the stack in the final traversal. That
// ensures that the entire stack have valid (non-dead) objects.
// Threads have no barriers. In gen. mode, old threads must be visited
// at every cycle, because they might point to young objects. In inc.
// mode, the thread can still be modified before the end of the cycle,
// and therefore it must be visited again in the atomic phase. To ensure
// these visits, threads must return to a gray list if they are not new
// (which can only happen in generational mode) or if the traverse is in
// the propagate phase (which can only happen in incremental mode).
[c_function]
def private traversethread(var g : global_State?; var th : lua_State?) : int {
    var uv : UpVal?
    var o : StackValue? = th.stack.p
    if (isold(th) || int(g.gcstate) == GCSpropagate) {
        // insert into 'grayagain' list
        linkgclist_(obj2gco(th), addr(th.gclist), addr(g.grayagain))
    }
    if (o == null) {
        // stack not completely built yet
        return 1
    }
    // mark live elements in the stack
    while (intptr(o) < intptr(th.top.p)) {
        let _t0 = g.mainthread
        if ((int(s2v(o).tt_) & BIT_ISCOLLECTABLE) != 0 && iswhite(s2v(o).value_.gc) != 0) {
            reallymarkobject(g, s2v(o).value_.gc)
        }
        o++
    }
    uv = th.openupval
    while (uv != null) {
        // open upvalues cannot be collected
        if (iswhite(uv) != 0) {
            reallymarkobject(g, obj2gco(uv))
        }
        uv = uv.u.open.next
    }
    // final traversal?
    if (int(g.gcstate) == GCSatomic) {
        if (g.gcemergency == 0) {
            // do not change stack in emergency cycle
            luaD_shrinkstack(th)
        }
        o = th.top.p
        while (intptr(o) < intptr(th.stack_last.p + EXTRA_STACK)) {
            // clear dead stack slice
            s2v(o).tt_ = uint8(LUA_TNIL | (0 << 4))
            o++
        }
        // 'remarkupvals' may have removed thread from 'twups' list
        if (!(intptr(th.twups) != intptr(th)) && th.openupval != null) {
            // link it back to the list
            th.twups = g.twups
            g.twups = th
        }
    }
    return 1 + stacksize(th)
}

// traverse one gray object, turning it to black.
[c_function]
def private propagatemark(var g : global_State?) : uint64 {
    var o : GCObject? = g.gray
    nw2black(o)
    // remove from 'gray' list
    g.gray = *getgclist(o)
    c_switch(int(o.tt)) {
        case(5) {
            return traversetable(g, gco2t(o))
        }
        case(7) {
            return uint64(traverseudata(g, gco2u(o)))
        }
        case(6) {
            return uint64(traverseLclosure(g, gco2lcl(o)))
        }
        case(38) {
            return uint64(traverseCclosure(g, gco2ccl(o)))
        }
        case(10) {
            return uint64(traverseproto(g, gco2p(o)))
        }
        case(8) {
            return uint64(traversethread(g, gco2th(o)))
        }
        case(_) {
            return 0ul
        }
    }
}

def private propagateall(var g : global_State?) : uint64 {
    var tot : uint64 = 0ul
    while (g.gray != null) {
        tot += propagatemark(g)
    }
    return tot
}

// Traverse all ephemeron tables propagating marks from keys to values.
// Repeat until it converges, that is, nothing new is marked. 'dir'
// inverts the direction of the traversals, trying to speed up
// convergence on chains in the same table.
[c_function]
def private convergeephemerons(var g : global_State?) {
    var changed : int
    var dir : int = 0
    c_do_while(changed != 0) {
        var w : GCObject?
        // get ephemeron list
        var next : GCObject? = g.ephemeron
        // tables may return to this list when traversed
        g.ephemeron = null
        changed = 0
        // for each ephemeron table
        while (true) {
            w = next
            if (!(w != null)) {
                break
            }
            var h : Table? = gco2t(w)
            // list is rebuilt during loop
            next = h.gclist
            // out of the list (for now)
            nw2black(h)
            // marked some value?
            if (traverseephemeron(g, h, dir) != 0) {
                // propagate changes
                propagateall(g)
                // will have to revisit all ephemeron tables
                changed = 1
            }
        }
        // invert direction next time
        dir = int_of(dir == 0)
    }
}

// clear entries with unmarked keys from all weaktables in list 'l'
[c_function]
def private clearbykeys(var g : global_State?; var l : GCObject?) {
    while (l != null) {
        var h : Table? = gco2t(l)
        var limit : Node? = gnodelast(h)
        var n : Node?
        n = gnode(h, 0)
        while (intptr(n) < intptr(limit)) {
            // unmarked key?
            if (iscleared(g, gckeyN(n)) != 0) {
                // remove entry
                setempty(gval(n))
            }
            // is entry empty?
            if (ttisnil(gval(n))) {
                // clear its key
                clearkey(n)
            }
            n++
        }
        l = gco2t(l).gclist
    }
}

// clear entries with unmarked values from all weaktables in list 'l' up
// to element 'f'
[c_function]
def private clearbyvalues(var g : global_State?; var l : GCObject?; var f : GCObject?) {
    while (intptr(l) != intptr(f)) {
        var h : Table? = gco2t(l)
        var n : Node?
        var limit : Node? = gnodelast(h)
        let asize : uint = luaH_realasize(h)
        for (i in urange(asize)) {
            var o : TValue? = addr(h._c_array[i])
            // value was collected?
            if (iscleared(g, gcvalueN(o)) != 0) {
                // remove entry
                settt_(o, LUA_TNIL | (1 << 4))
            }
        }
        n = gnode(h, 0)
        while (intptr(n) < intptr(limit)) {
            // unmarked value?
            if (iscleared(g, iscollectable(gval(n)) != 0 ? addr(n.i_val).value_.gc : null) != 0) {
                // remove entry
                setempty(gval(n))
            }
            // is entry empty?
            if (ttisnil(gval(n))) {
                // clear its key
                clearkey(n)
            }
            n++
        }
        l = gco2t(l).gclist
    }
}

[c_function]
def private freeupval(var L : lua_State?; var uv : UpVal?) {
    if (upisopen(uv)) {
        luaF_unlinkupval(uv)
    }
    luaM_free_(L, reinterpret<void?>(uv), uint64(typeinfo sizeof(type<UpVal>)))
}

def private freeobj(var L : lua_State?; var o : GCObject?) {
    c_switch(int(o.tt)) {
        case(10) {
            luaF_freeproto(L, gco2p(o))
            break
        }
        case(9) {
            freeupval(L, gco2upv(o))
            break
        }
        case(6) {
            {
                var cl : LClosure? = gco2lcl(o)
                luaM_freemem(L, cl, int(uint64(typeinfo offsetof < upvals > (type<LClosure>))) + typeinfo sizeof(type<TValue?>) * int(cl.nupvalues))
                break
            }
        }
        case(38) {
            {
                var cl : CClosure? = gco2ccl(o)
                luaM_freemem(L, cl, int(uint64(typeinfo offsetof < upvalue > (type<CClosure>))) + typeinfo sizeof(type<TValue>) * int(cl.nupvalues))
                break
            }
        }
        case(5) {
            luaH_free(L, gco2t(o))
            break
        }
        case(8) {
            luaE_freethread(L, gco2th(o))
            break
        }
        case(7) {
            {
                var u : Udata? = gco2u(o)
                luaM_freemem(L, o,
                        (u.nuvalue == 0 ? uint64(typeinfo offsetof < bindata > (type<Udata0>)) :
                                uint64(typeinfo offsetof < uv > (type<Udata>)) + uint64(typeinfo sizeof(type<UValue>)) * uint64(u.nuvalue)) +
                            u.len)
                break
            }
        }
        case(4) {
            {
                var ts : TString? = gco2ts(o)
                // remove it from hash table
                luaS_remove(L, ts)
                luaM_freemem(L, ts, uint64(typeinfo offsetof < contents > (type<TString>)) + uint64(int(ts.shrlen) + 1) * uint64(typeinfo sizeof(type<uint8>)))
                break
            }
        }
        case(20) {
            {
                var ts : TString? = gco2ts(o)
                luaM_freemem(L, ts, uint64(typeinfo offsetof < contents > (type<TString>)) + (ts.u.lnglen + 1ul) * uint64(typeinfo sizeof(type<uint8>)))
                break
            }
        }
        case(_) {
        }
    }
}

// sweep at most 'countin' elements from a list of GCObjects erasing dead
// objects, where a dead object is one marked with the old (non current)
// white; change all non-dead objects back to white, preparing for next
// collection cycle. Return where to continue the traversal or NULL if
// list is finished. ('*countout' gets the number of elements traversed.)
[c_function]
def private sweeplist(var L : lua_State?; var p : GCObject ??; countin : int; var countout : int?) : GCObject ?? {
    var g : global_State? = G(L)
    let ow : int = otherwhite(g)
    var i : int
    // current white
    let white : int = int(luaC_white(g))
    i = 0
    while (*p != null && i < countin) {
        var curr : GCObject? = *p
        let marked : int = int(curr.marked)
        // is 'curr' dead?
        if (isdeadm(ow, marked) != 0) {
            // remove 'curr' from list
            *p = curr.next
            // erase 'curr'
            freeobj(L, curr)
        } else {
            // change mark to 'white'
            curr.marked = uint8((marked & ~maskgcbits) | white)
            // go to next element
            p = addr(curr.next)
        }
        i++
    }
    if (countout != null) {
        // number of elements traversed
        *countout = i
    }
    return (*p == null) ? default<GCObject ??> : p
}

// sweep a list until a live object (or end of list)
def private sweeptolive(var L : lua_State?; var p : GCObject ??) : GCObject ?? {
    var old : GCObject ?? = p
    c_do_while(intptr(p) == intptr(old)) {
        p = sweeplist(L, p, 1, null)
    }
    return p
}

// If possible, shrink string table.
def private checkSizes(var L : lua_State?; var g : global_State?) {
    if (g.gcemergency == 0) {
        // string table too big?
        if (g.strt.nuse < g.strt.size / 4) {
            let olddebt : int64 = g.GCdebt
            luaS_resize(L, g.strt.size / 2)
            // correct estimate
            g.GCestimate += uint64(g.GCdebt - olddebt)
        }
    }
}

// Get the next udata to be finalized from the 'tobefnz' list, and
// link it back into the 'allgc' list.
def private udata2finalize(var g : global_State?) : GCObject? {
    // get first element
    var o : GCObject? = g.tobefnz
    // remove it from 'tobefnz' list
    g.tobefnz = o.next
    // return it to 'allgc' list
    o.next = g.allgc
    g.allgc = o
    // object is "normal" again
    o.marked = uint8(int(o.marked) & int(uint8(~(1 << FINALIZEDBIT))))
    if (issweepphase(g)) {
        // "sweep" object
        makewhite(g, o)
    } elif (getage(o) == G_OLD1) {
        // it is the first OLD1 object in the list
        g.firstold1 = o
    }
    return o
}

[c_function]
def private dothecall(var L : lua_State?; var ud : void?) {
    luaD_callnoyield(L, L.top.p - 2, 0)
}

[c_function]
def private GCTM(var L : lua_State?) {
    var g : global_State? = G(L)
    var tm : TValue?
    var v : TValue
    {
        var io : TValue? = addr(v)
        var i_g : GCObject? = udata2finalize(g)
        io.value_.gc = i_g
        settt_(io, ctb(i_g.tt))
    }
    tm = luaT_gettmbyobj(L, addr(v), TMS.TM_GC)
    // is there a finalizer?
    if (!notm(tm)) {
        var status : int
        let oldah : uint8 = L.allowhook
        let oldgcstp : int = int(g.gcstp)
        // avoid GC steps
        g.gcstp = uint8(int(g.gcstp) | GCSTPGC)
        // stop debug hooks during GC metamethod
        L.allowhook = 0u8
        {
            // push finalizer...
            var _t0 = L.top.p
            L.top.p++
            var io1 : TValue? = addr(_t0.val)
            var io2 : TValue? = tm
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        {
            // ... and its argument
            var _t1 = L.top.p
            L.top.p++
            var io1 : TValue? = addr(_t1.val)
            var io2 : TValue? = addr(v)
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        // will run a finalizer
        L.ci.callstatus = uint16(int(L.ci.callstatus) | CIST_FIN)
        status = luaD_pcall(L, @@dothecall, null, savestack(L, L.top.p - 2), 0l)
        // not running a finalizer anymore
        L.ci.callstatus = uint16(int(L.ci.callstatus) & ~CIST_FIN)
        // restore hooks
        L.allowhook = oldah
        // restore state
        g.gcstp = uint8(oldgcstp)
        // error while running __gc?
        if (status != LUA_OK) {
            luaE_warnerror(L, cstr("__gc"))
            // pops error object
            L.top.p--
        }
    }
}

// Call a few finalizers
def private runafewfinalizers(var L : lua_State?; n : int) : int {
    var g : global_State? = G(L)
    var i : int
    i = 0
    while (i < n && g.tobefnz != null) {
        // call one finalizer
        GCTM(L)
        i++
    }
    return i
}

// call all pending finalizers
def private callallpendingfinalizers(var L : lua_State?) {
    var g : global_State? = G(L)
    while (g.tobefnz != null) {
        GCTM(L)
    }
}

// find last 'next' field in list 'p' list (to add elements in its end)
[c_function]
def private findlast(var p : GCObject ??) : GCObject ?? {
    while (*p != null) {
        p = addr((*p).next)
    }
    return p
}

// Move all unreachable objects (or 'all' objects) that need
// finalization from list 'finobj' to list 'tobefnz' (to be finalized).
// (Note that objects after 'finobjold1' cannot be white, so they
// don't need to be traversed. In incremental mode, 'finobjold1' is NULL,
// so the whole list is traversed.)
[c_function]
def private separatetobefnz(var g : global_State?; all : int) {
    var curr : GCObject?
    var p : GCObject ?? = addr(g.finobj)
    var lastnext : GCObject ?? = findlast(addr(g.tobefnz))
    // traverse all finalizable objects
    while (true) {
        curr = *p
        if (!(intptr(curr) != intptr(g.finobjold1))) {
            break
        }
        // not being collected?
        if (!(iswhite(curr) != 0 || all != 0)) {
            // don't bother with it
            p = addr(curr.next)
        } else {
            // removing 'finobjsur'?
            if (intptr(curr) == intptr(g.finobjsur)) {
                // correct it
                g.finobjsur = curr.next
            }
            // remove 'curr' from 'finobj' list
            *p = curr.next
            // link at the end of 'tobefnz' list
            curr.next = *lastnext
            *lastnext = curr
            lastnext = addr(curr.next)
        }
    }
}

// If pointer 'p' points to 'o', move it to the next element.
[c_function]
def private checkpointer(var p : GCObject ??; var o : GCObject?) {
    if (intptr(o) == intptr(*p)) {
        *p = o.next
    }
}

// Correct pointers to objects inside 'allgc' list when
// object 'o' is being removed from the list.
[c_function]
def private correctpointers(var g : global_State?; var o : GCObject?) {
    checkpointer(addr(g.survival), o)
    checkpointer(addr(g.old1), o)
    checkpointer(addr(g.reallyold), o)
    checkpointer(addr(g.firstold1), o)
}

// if object 'o' has a finalizer, remove it from 'allgc' list (must
// search the list to find it) and link it in 'finobj' list.
[c_function]
def luaC_checkfinalizer(var L : lua_State?; var o : GCObject?; var mt : Table?) {
    var g : global_State? = G(L)
    // obj. is already marked...
    if (tofinalize(o) != 0 || gfasttm(g, mt, int(TMS.TM_GC)) == null || (int(g.gcstp) & GCSTPCLS) != 0) {
        // or has no finalizer...
        // or closing state?
        // nothing to be done
        return
    } else {
        // move 'o' to 'finobj' list
        var p : GCObject ??
        if (issweepphase(g)) {
            // "sweep" object 'o'
            makewhite(g, o)
            // should not remove 'sweepgc' object
            if (intptr(g.sweepgc) == intptr(addr(o.next))) {
                // change 'sweepgc'
                g.sweepgc = sweeptolive(L, g.sweepgc)
            }
        } else {
            correctpointers(g, o)
        }
        // search for pointer pointing to 'o'
        // empty
        p = addr(g.allgc)
        while (intptr(*p) != intptr(o)) {
            p = addr((*p).next)
        }
        // remove 'o' from 'allgc' list
        *p = o.next
        // link it in 'finobj' list
        o.next = g.finobj
        g.finobj = o
        // mark it as such
        o.marked = uint8(int(o.marked) | bitmask(FINALIZEDBIT))
    }
}

// Set the "time" to wait before starting a new GC cycle; cycle will
// start when memory use hits the threshold of ('estimate' * pause
// PAUSEADJ). (Division by 'estimate' should be OK: it cannot be zero,
// because Lua cannot even start with less than PAUSEADJ bytes).
def private setpause(var g : global_State?) {
    var threshold : int64
    var debt : int64
    let pause : int = getgcparam(g.gcpause)
    // adjust 'estimate'
    let estimate : int64 = int64(g.GCestimate / uint64(PAUSEADJ))
    // overflow?
    threshold = (int64(pause) < MAX_LMEM / estimate) ? estimate * int64(pause) : MAX_LMEM
    // no overflow
    // overflow; truncate to maximum
    debt = g.totalbytes + g.GCdebt - threshold
    if (debt > 0l) {
        debt = 0l
    }
    luaE_setdebt(g, debt)
}

// Sweep a list of objects to enter generational mode. Deletes dead
// objects and turns the non dead to old. All non-dead threads---which
// are now old---must be in a gray list. Everything else is not in a
// gray list. Open upvalues are also kept gray.
[c_function]
def private sweep2old(var L : lua_State?; var p : GCObject ??) {
    var curr : GCObject?
    var g : global_State? = G(L)
    while (true) {
        curr = *p
        if (!(curr != null)) {
            break
        }
        // is 'curr' dead?
        if (iswhite(curr) != 0) {
            // remove 'curr' from list
            *p = curr.next
            // erase 'curr'
            freeobj(L, curr)
        } else {
            // all surviving objects become old
            setage(curr, G_OLD)
            // threads must be watched
            if (int(curr.tt) == LUA_VTHREAD) {
                var th : lua_State? = gco2th(curr)
                // insert into 'grayagain' list
                linkgclist_(obj2gco(th), addr(th.gclist), addr(g.grayagain))
            } elif (int(curr.tt) == LUA_VUPVAL && intptr(gco2upv(curr).v.p) != intptr(addr(gco2upv(curr).u.value))) {
                // open upvalues are always gray
                set2gray(curr)
            } else {
                // everything else is black
                nw2black(curr)
            }
            // go to next element
            p = addr(curr.next)
        }
    }
}

// Sweep for generational mode. Delete dead objects. (Because the
// collection is not incremental, there are no "new white" objects
// during the sweep. So, any white object must be dead.) For
// non-dead objects, advance their ages and clear the color of
// new objects. (Old objects keep their colors.)
// The ages of G_TOUCHED1 and G_TOUCHED2 objects cannot be advanced
// here, because these old-generation objects are usually not swept
// here. They will all be advanced in 'correctgraylist'. That function
// will also remove objects turned white here from any gray list.
[c_function]
def private sweepgen(var L : lua_State?; var g : global_State?; var p : GCObject ??; var limit : GCObject?; var pfirstold1 : GCObject ??) : GCObject ?? {
    // from G_NEW
    // from G_SURVIVAL
    // from G_OLD0
    // from G_OLD1
    // from G_OLD (do not change)
    // from G_TOUCHED1 (do not change)
    // from G_TOUCHED2 (do not change)
    let white : int = int(luaC_white(g))
    var curr : GCObject?
    while (true) {
        curr = *p
        if (!(intptr(curr) != intptr(limit))) {
            break
        }
        // is 'curr' dead?
        if (iswhite(curr) != 0) {
            // remove 'curr' from list
            *p = curr.next
            // erase 'curr'
            freeobj(L, curr)
        } else {
            // correct mark and age
            // new objects go back to white
            if (getage(curr) == G_NEW) {
                // erase GC bits
                let marked : int = int(curr.marked) & ~maskgcbits
                curr.marked = uint8(marked | G_SURVIVAL | white)
            } else {
                // all other objects will be old, and so keep their color
                setage(curr, sweepgen_nextage[getage(curr)])
                if (getage(curr) == G_OLD1 && *pfirstold1 == null) {
                    // first OLD1 object in the list
                    *pfirstold1 = curr
                }
            }
            // go to next element
            p = addr(curr.next)
        }
    }
    return p
}

// Traverse a list making all its elements white and clearing their
// age. In incremental mode, all objects are 'new' all the time,
// except for fixed strings (which are always old).
[c_function]
def private whitelist(var g : global_State?; var p : GCObject?) {
    let white : int = int(luaC_white(g))
    while (p != null) {
        p.marked = uint8((int(p.marked) & ~maskgcbits) | white)
        p = p.next
    }
}

// Correct a list of gray objects. Return pointer to where rest of the
// list should be linked.
// Because this correction is done after sweeping, young objects might
// be turned white and still be in the list. They are only removed.
// 'TOUCHED1' objects are advanced to 'TOUCHED2' and remain on the list;
// Non-white threads also remain on the list; 'TOUCHED2' objects become
// regular old; they and anything else are removed from the list.
[c_function]
def private correctgraylist(var p : GCObject ??) : GCObject ?? {
    var curr : GCObject?
    while (true) {
        curr = *p
        if (!(curr != null)) {
            break
        }
        var next : GCObject ?? = getgclist(curr)
        if (iswhite(curr) != 0) {
            // remove all white objects
            goto label 1
        } elif (getage(curr) == G_TOUCHED1) {
            // touched in this cycle?
            // make it black, for next barrier
            nw2black(curr)
            changeage(curr, G_TOUCHED1, G_TOUCHED2)
            // keep it in the list and go to next element
            goto label 2
        } elif (int(curr.tt) == LUA_VTHREAD) {
            // keep non-white threads on the list
            goto label 2
        } else {
            // everything else is removed
            // young objects should be white here
            // advance from TOUCHED2...
            if (getage(curr) == G_TOUCHED2) {
                // ... to OLD
                changeage(curr, G_TOUCHED2, G_OLD)
            }
            // make object black (to be removed)
            nw2black(curr)
            goto label 1
        }
        label 1:  // remove
        *p = *next
        continue
        label 2:  // remain
        p = next
        continue
    }
    return p
}

// Correct all gray lists, coalescing them into 'grayagain'.
[c_function]
def private correctgraylists(var g : global_State?) {
    var list : GCObject ?? = correctgraylist(addr(g.grayagain))
    *list = g.weak
    g.weak = null
    list = correctgraylist(list)
    *list = g.allweak
    g.allweak = null
    list = correctgraylist(list)
    *list = g.ephemeron
    g.ephemeron = null
    correctgraylist(list)
}

// Mark black 'OLD1' objects when starting a new young collection.
// Gray objects are already in some gray list, and so will be visited
// in the atomic step.
def private markold(var g : global_State?; var from : GCObject?; var to : GCObject?) {
    var p : GCObject?
    p = from
    while (intptr(p) != intptr(to)) {
        if (getage(p) == G_OLD1) {
            // now they are old
            changeage(p, G_OLD1, G_OLD)
            if (isblack(p) != 0) {
                reallymarkobject(g, p)
            }
        }
        p = p.next
    }
}

// Finish a young-generation collection.
def private finishgencycle(var L : lua_State?; var g : global_State?) {
    correctgraylists(g)
    checkSizes(L, g)
    // skip restart
    g.gcstate = uint8(GCSpropagate)
    if (g.gcemergency == 0) {
        callallpendingfinalizers(L)
    }
}

// Does a young collection. First, mark 'OLD1' objects. Then does the
// atomic step. Then, sweep all lists and advance pointers. Finally,
// finish the collection.
[c_function]
def private youngcollection(var L : lua_State?; var g : global_State?) {
    // to point to first non-dead survival object
    var psurvival : GCObject ??
    // dummy out parameter to 'sweepgen'
    var dummy : GCObject?
    // are there regular OLD1 objects?
    if (g.firstold1 != null) {
        // mark them
        markold(g, g.firstold1, g.reallyold)
        // no more OLD1 objects (for now)
        g.firstold1 = null
    }
    markold(g, g.finobj, g.finobjrold)
    markold(g, g.tobefnz, null)
    atomic(L)
    // sweep nursery and get a pointer to its last live element
    g.gcstate = uint8(GCSswpallgc)
    psurvival = sweepgen(L, g, addr(g.allgc), g.survival, addr(g.firstold1))
    // sweep 'survival'
    sweepgen(L, g, psurvival, g.old1, addr(g.firstold1))
    g.reallyold = g.old1
    // 'survival' survivals are old now
    g.old1 = *psurvival
    // all news are survivals
    g.survival = g.allgc
    // repeat for 'finobj' lists
    // no 'firstold1' optimization for 'finobj' lists
    dummy = null
    psurvival = sweepgen(L, g, addr(g.finobj), g.finobjsur, addr(dummy))
    // sweep 'survival'
    sweepgen(L, g, psurvival, g.finobjold1, addr(dummy))
    g.finobjrold = g.finobjold1
    // 'survival' survivals are old now
    g.finobjold1 = *psurvival
    // all news are survivals
    g.finobjsur = g.finobj
    sweepgen(L, g, addr(g.tobefnz), null, addr(dummy))
    finishgencycle(L, g)
}

// Clears all gray lists, sweeps objects, and prepare sublists to enter
// generational mode. The sweeps remove dead objects and turn all
// surviving objects to old. Threads go back to 'grayagain'; everything
// else is turned black (not in any gray list).
[c_function]
def private atomic2gen(var L : lua_State?; var g : global_State?) {
    cleargraylists(g)
    // sweep all elements making them old
    g.gcstate = uint8(GCSswpallgc)
    sweep2old(L, addr(g.allgc))
    // everything alive now is old
    g.survival = g.allgc
    g.old1 = g.survival
    g.reallyold = g.old1
    // there are no OLD1 objects anywhere
    g.firstold1 = null
    // repeat for 'finobj' lists
    sweep2old(L, addr(g.finobj))
    g.finobjsur = g.finobj
    g.finobjold1 = g.finobjsur
    g.finobjrold = g.finobjold1
    sweep2old(L, addr(g.tobefnz))
    g.gckind = uint8(KGC_GEN)
    g.lastatomic = 0ul
    // base for memory control
    g.GCestimate = gettotalbytes(g)
    finishgencycle(L, g)
}

// Set debt for the next minor collection, which will happen when
// memory grows 'genminormul'%.
def private setminordebt(var g : global_State?) {
    luaE_setdebt(g, -(int64(gettotalbytes(g) / 100ul) * int64(g.genminormul)))
}

// Enter generational mode. Must go until the end of an atomic cycle
// to ensure that all objects are correctly marked and weak tables
// are cleared. Then, turn all objects into old and finishes the
// collection.
def private entergen(var L : lua_State?; var g : global_State?) : uint64 {
    var numobjs : uint64
    // prepare to start a new cycle
    luaC_runtilstate(L, 1 << GCSpause)
    // start new cycle
    luaC_runtilstate(L, bitmask(GCSpropagate))
    // propagates all and then do the atomic stuff
    numobjs = atomic(L)
    atomic2gen(L, g)
    // set debt assuming next cycle will be minor
    setminordebt(g)
    return numobjs
}

// Enter incremental mode. Turn all objects white, make all
// intermediate lists point to NULL (to avoid invalid pointers),
// and go to the pause state.
def private enterinc(var g : global_State?) {
    whitelist(g, g.allgc)
    g.survival = null
    g.old1 = g.survival
    g.reallyold = g.old1
    whitelist(g, g.finobj)
    whitelist(g, g.tobefnz)
    g.finobjsur = null
    g.finobjold1 = g.finobjsur
    g.finobjrold = g.finobjold1
    g.gcstate = uint8(GCSpause)
    g.gckind = uint8(KGC_INC)
    g.lastatomic = 0ul
}

// Change collector mode to 'newmode'.
def luaC_changemode(var L : lua_State?; newmode : int) {
    var g : global_State? = G(L)
    if (newmode != int(g.gckind)) {
        // entering generational mode?
        if (newmode == KGC_GEN) {
            entergen(L, g)
        } else {
            // entering incremental mode
            enterinc(g)
        }
    }
    g.lastatomic = 0ul
}

// Does a full collection in generational mode.
def private fullgen(var L : lua_State?; var g : global_State?) : uint64 {
    enterinc(g)
    return entergen(L, g)
}

// Does a major collection after last collection was a "bad collection".
// When the program is building a big structure, it allocates lots of
// memory but generates very little garbage. In those scenarios,
// the generational mode just wastes time doing small collections, and
// major collections are frequently what we call a "bad collection", a
// collection that frees too few objects. To avoid the cost of switching
// between generational mode and the incremental mode needed for full
// (major) collections, the collector tries to stay in incremental mode
// after a bad collection, and to switch back to generational mode only
// after a "good" collection (one that traverses less than 9/8 objects
// of the previous one).
// The collector must choose whether to stay in incremental mode or to
// switch back to generational mode before sweeping. At this point, it
// does not know the real memory in use, so it cannot use memory to
// decide whether to return to generational mode. Instead, it uses the
// number of objects traversed (returned by 'atomic') as a proxy. The
// field 'g->lastatomic' keeps this count from the last collection.
// ('g->lastatomic != 0' also means that the last collection was bad.)
def private stepgenfull(var L : lua_State?; var g : global_State?) {
    // count of traversed objects
    var newatomic : uint64
    // count from last collection
    let lastatomic : uint64 = g.lastatomic
    // still in generational mode?
    if (int(g.gckind) == KGC_GEN) {
        // enter incremental mode
        enterinc(g)
    }
    // start new cycle
    luaC_runtilstate(L, bitmask(GCSpropagate))
    // mark everybody
    newatomic = atomic(L)
    // good collection?
    if (newatomic < lastatomic + (lastatomic >> 3ul)) {
        // return to generational mode
        atomic2gen(L, g)
        setminordebt(g)
    } else {
        // another bad collection; stay in incremental mode
        // first estimate
        g.GCestimate = gettotalbytes(g)
        entersweep(L)
        // finish collection
        luaC_runtilstate(L, bitmask(GCSpause))
        setpause(g)
        g.lastatomic = newatomic
    }
}

// Does a generational "step".
// Usually, this means doing a minor collection and setting the debt to
// make another collection when memory grows 'genminormul'% larger.
// However, there are exceptions. If memory grows 'genmajormul'%
// larger than it was at the end of the last major collection (kept
// in 'g->GCestimate'), the function does a major collection. At the
// end, it checks whether the major collection was able to free a
// decent amount of memory (at least half the growth in memory since
// previous major collection). If so, the collector keeps its state,
// and the next collection will probably be minor again. Otherwise,
// we have what we call a "bad collection". In that case, set the field
// 'g->lastatomic' to signal that fact, so that the next collection will
// go to 'stepgenfull'.
// 'GCdebt <= 0' means an explicit call to GC step with "size" zero;
// in that case, do a minor collection.
def private genstep(var L : lua_State?; var g : global_State?) {
    // last collection was a bad one?
    if (g.lastatomic != 0ul) {
        // do a full step
        stepgenfull(L, g)
    } else {
        // memory after last major collection
        let majorbase : uint64 = g.GCestimate
        let majorinc : uint64 = (majorbase / 100ul) * uint64(getgcparam(g.genmajormul))
        if (g.GCdebt > 0l && gettotalbytes(g) > majorbase + majorinc) {
            // do a major collection
            let numobjs : uint64 = fullgen(L, g)
            if (gettotalbytes(g) < majorbase + (majorinc / 2ul)) {
                // collected at least half of memory growth since last major
                // collection; keep doing minor collections.
            } else {
                // bad collection
                // signal that last collection was bad
                g.lastatomic = numobjs
                // do a long wait for next (major) collection
                setpause(g)
            }
        } else {
            // regular case; do a minor collection
            youngcollection(L, g)
            setminordebt(g)
            // preserve base value
            g.GCestimate = majorbase
        }
    }
}

// Enter first sweep phase.
// The call to 'sweeptolive' makes the pointer point to an object
// inside the list (instead of to the header), so that the real sweep do
// not need to skip objects created between "now" and the start of the
// real sweep.
[c_function]
def private entersweep(var L : lua_State?) {
    var g : global_State? = G(L)
    g.gcstate = uint8(GCSswpallgc)
    g.sweepgc = sweeptolive(L, addr(g.allgc))
}

// Delete all objects in list 'p' until (but not including) object
// 'limit'.
def private deletelist(var L : lua_State?; var p : GCObject?; var limit : GCObject?) {
    while (intptr(p) != intptr(limit)) {
        var next : GCObject? = p.next
        freeobj(L, p)
        p = next
    }
}

// Call all finalizers of the objects in the given Lua state, and
// then free all objects, except for the main thread.
def luaC_freeallobjects(var L : lua_State?) {
    var g : global_State? = G(L)
    // no extra finalizers after here
    g.gcstp = uint8(GCSTPCLS)
    luaC_changemode(L, KGC_INC)
    // separate all objects with finalizers
    separatetobefnz(g, 1)
    callallpendingfinalizers(L)
    deletelist(L, g.allgc, obj2gco(g.mainthread))
    // no new finalizers
    // collect fixed objects
    deletelist(L, g.fixedgc, null)
}

[c_function]
def private atomic(var L : lua_State?) : uint64 {
    var g : global_State? = G(L)
    var work : uint64 = 0ul
    var origweak : GCObject?
    var origall : GCObject?
    // save original list
    var grayagain : GCObject? = g.grayagain
    g.grayagain = null
    g.gcstate = uint8(GCSatomic)
    markobject(g, L)
    // mark running thread
    {
        // registry and global metatables may be changed by API
        let _t0 = g.mainthread
        if (iscollectable(addr(g.l_registry)) != 0 && testbits(gcvalue(addr(g.l_registry)).marked, (1 << WHITE0BIT) | (1 << WHITE1BIT)) != 0) {
            reallymarkobject(g, gcvalue(addr(g.l_registry)))
        }
    }
    // mark global metatables
    markmt(g)
    // empties 'gray' list
    work += propagateall(g)
    // remark occasional upvalues of (maybe) dead threads
    work += uint64(remarkupvals(g))
    // propagate changes
    work += propagateall(g)
    g.gray = grayagain
    // traverse 'grayagain' list
    work += propagateall(g)
    convergeephemerons(g)
    // at this point, all strongly accessible objects are marked.
    // Clear values from weak tables, before checking finalizers
    clearbyvalues(g, g.weak, null)
    clearbyvalues(g, g.allweak, null)
    origweak = g.weak
    origall = g.allweak
    // separate objects to be finalized
    separatetobefnz(g, 0)
    // mark objects that will be finalized
    work += markbeingfnz(g)
    // remark, to propagate 'resurrection'
    work += propagateall(g)
    convergeephemerons(g)
    // at this point, all resurrected objects are marked.
    // remove dead objects from weak tables
    // clear keys from all ephemeron tables
    clearbykeys(g, g.ephemeron)
    // clear keys from all 'allweak' tables
    clearbykeys(g, g.allweak)
    // clear values from resurrected weak tables
    clearbyvalues(g, g.weak, origweak)
    clearbyvalues(g, g.allweak, origall)
    luaS_clearcache(g)
    // flip current white
    g.currentwhite = uint8(otherwhite(g))
    // estimate of slots marked by 'atomic'
    return work
}

[c_function]
def private sweepstep(var L : lua_State?; var g : global_State?; nextstate : int; var nextlist : GCObject ??) : int {
    if (g.sweepgc != null) {
        let olddebt : int64 = g.GCdebt
        var count : int
        g.sweepgc = sweeplist(L, g.sweepgc, GCSWEEPMAX, addr(count))
        // update estimate
        g.GCestimate += uint64(g.GCdebt - olddebt)
        return count
    } else {
        // enter next state
        g.gcstate = uint8(nextstate)
        g.sweepgc = nextlist
        // no work done
        return 0
    }
}

[c_function]
def private singlestep(var L : lua_State?) : uint64 {
    var g : global_State? = G(L)
    var work : uint64
    // collector is not reentrant
    // no emergency collections while collecting
    g.gcstopem = 1u8
    c_switch(int(g.gcstate)) {
        case(8) {
            restartcollection(g)
            g.gcstate = uint8(GCSpropagate)
            work = 1ul
            break
        }
        case(0) {
            // no more gray objects?
            if (g.gray == null) {
                // finish propagate phase
                g.gcstate = uint8(GCSenteratomic)
                work = 0ul
            } else {
                // traverse one gray object
                work = propagatemark(g)
            }
            break
        }
        case(1) {
            // work is what was traversed by 'atomic'
            work = atomic(L)
            entersweep(L)
            // first estimate
            g.GCestimate = gettotalbytes(g)
            break
        }
        case(3) {
            // sweep "regular" objects
            work = uint64(sweepstep(L, g, GCSswpfinobj, addr(g.finobj)))
            break
        }
        case(4) {
            // sweep objects with finalizers
            work = uint64(sweepstep(L, g, GCSswptobefnz, addr(g.tobefnz)))
            break
        }
        case(5) {
            // sweep objects to be finalized
            work = uint64(sweepstep(L, g, GCSswpend, null))
            break
        }
        case(6) {
            // finish sweeps
            checkSizes(L, g)
            g.gcstate = uint8(GCScallfin)
            work = 0ul
            break
        }
        case(7) {
            // call remaining finalizers
            if (g.tobefnz != null && g.gcemergency == 0) {
                // ok collections during finalizers
                g.gcstopem = 0u8
                work = uint64(runafewfinalizers(L, GCFINMAX) * GCFINALIZECOST)
            } else {
                // emergency mode or no more finalizers
                // finish collection
                g.gcstate = uint8(GCSpause)
                work = 0ul
            }
            break
        }
        case(_) {
            return 0ul
        }
    }
    g.gcstopem = 0u8
    return work
}

// advances the garbage collector until it reaches a state allowed
// by 'statemask'
def luaC_runtilstate(var L : lua_State?; statesmask : int) {
    var g : global_State? = G(L)
    while (testbit(statesmask, g.gcstate) == 0) {
        singlestep(L)
    }
}

// Performs a basic incremental step. The debt and step size are
// converted from bytes to "units of work"; then the function loops
// running single steps until adding that many units of work or
// finishing a cycle (pause state). Finally, it sets the debt that
// controls when next step will be performed.
def private incstep(var L : lua_State?; var g : global_State?) {
    // avoid division by 0
    let stepmul : int = getgcparam(g.gcstepmul) | 1
    var debt : int64 = int64((uint64(g.GCdebt) / WORK2MEM) * uint64(stepmul))
    let stepsize : int64 = int64((uint64(g.gcstepsize) <= uint64(typeinfo sizeof(type<int64>)) * 8ul - 2ul) ?
            (uint64(1l << int64(int(g.gcstepsize))) / WORK2MEM) * uint64(stepmul) : uint64(MAX_LMEM))
    // overflow; keep maximum value
    // repeat until pause or enough "credit" (negative debt)
    c_do_while(debt > -stepsize && int(g.gcstate) != GCSpause) {
        // perform one single step
        let work : uint64 = singlestep(L)
        debt = int64(uint64(debt) - work)
    }
    if (int(g.gcstate) == GCSpause) {
        // pause until next cycle
        setpause(g)
    } else {
        // convert 'work units' to bytes
        debt = int64(uint64(debt / int64(stepmul)) * WORK2MEM)
        luaE_setdebt(g, debt)
    }
}

// Performs a basic GC step if collector is running. (If collector is
// not running, set a reasonable debt to avoid it being called at
// every single check.)
def luaC_step(var L : lua_State?) {
    var g : global_State? = G(L)
    // not running?
    if (!gcrunning(g)) {
        luaE_setdebt(g, -2000l)
    } else {
        if (isdecGCmodegen(g)) {
            genstep(L, g)
        } else {
            incstep(L, g)
        }
    }
}

// Perform a full collection in incremental mode.
// Before running the collection, check 'keepinvariant'; if it is true,
// there may be some objects marked as black, so the collector has
// to sweep all objects to turn them back to white (as white has not
// changed, nothing will be collected).
def private fullinc(var L : lua_State?; var g : global_State?) {
    // black objects?
    if (keepinvariant(g)) {
        // sweep everything to turn them back to white
        entersweep(L)
    }
    // finish any pending sweep phase to start a new cycle
    luaC_runtilstate(L, bitmask(GCSpause))
    // start new cycle
    luaC_runtilstate(L, bitmask(GCSpropagate))
    // go straight to atomic phase
    g.gcstate = uint8(GCSenteratomic)
    // run up to finalizers
    luaC_runtilstate(L, bitmask(GCScallfin))
    // estimate must be correct after a full GC cycle
    // finish collection
    luaC_runtilstate(L, bitmask(GCSpause))
    setpause(g)
}

// Performs a full GC cycle; if 'isemergency', set a flag to avoid
// some operations which could change the interpreter state in some
// unexpected ways (running finalizers and shrinking some structures).
def luaC_fullgc(var L : lua_State?; isemergency : int) {
    var g : global_State? = G(L)
    // set flag
    g.gcemergency = uint8(isemergency)
    if (int(g.gckind) == KGC_INC) {
        fullinc(L, g)
    } else {
        fullgen(L, g)
    }
    g.gcemergency = 0u8
}

[init]
def private c2das_late_bind {
    luaC_barrierback__slot = @@__::luaC_barrierback_
    luaC_fix_slot = @@__::luaC_fix
    luaC_freeallobjects_slot = @@__::luaC_freeallobjects
    luaC_fullgc_slot = @@__::luaC_fullgc
    luaC_newobj_slot = @@__::luaC_newobj
    luaC_newobjdt_slot = @@__::luaC_newobjdt
    luaC_step_slot = @@__::luaC_step
}

