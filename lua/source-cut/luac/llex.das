[c_function]
def luaX_next(var ls : LexState?) {
    ls.lastline = ls.linenumber
    // is there a look-ahead token?
    if (ls.lookahead.token != int(RESERVED.TK_EOS)) {
        // use this one
        ls.t = ls.lookahead
        // and discharge it
        ls.lookahead.token = int(RESERVED.TK_EOS)
    } else {
        // read next token
        ls.t.token = llex(ls, addr(ls.t.seminfo))
    }
}

[c_function]
def luaX_lookahead(var ls : LexState?) : int {
    ls.lookahead.token = llex(ls, addr(ls.lookahead.seminfo))
    return ls.lookahead.token
}

[init]
