    ci = prepCallInfo(L, func, nresults, CIST_C, L.top.p + LUA_MINSTACK)
    L.ci = ci
    if ((c_volatile_load(L.hookmask) & LUA_MASKCALL) != 0) {
        var narg : int = int(int64(L.top.p - func)) - 1
        luaD_hook(L, LUA_HOOKCALL, -1, 1, narg)
    }
    // do the actual call
    n = invoke(f, L)
    luaD_poscall(L, ci, n)
    return n
}

// Prepare a function for a tail call, building its call info on top
// of the current call info. 'narg1' is the number of arguments plus 1
// (so that it includes the function itself). Return the number of
// results, if it was a C function, or -1 for a Lua function.
[c_function]
def luaD_pretailcall(var L : lua_State?; var ci : CallInfo?; var func : StackValue?; var narg1 : int; delta : int) : int {
    label 1:  // retry
    c_switch(int(addr(func.val).tt_) & 63) {
        case(38) {
            // C closure
            return precallC(L, func, LUA_MULTRET, addr(reinterpret<GCUnion?>(addr(func.val).value_.gc).cl.c).f)
        }
        case(22) {
            // light C function
            return precallC(L, func, LUA_MULTRET, addr(func.val).value_.f)
        }
        case(6) {
            {
                // Lua function
                var p : Proto? = addr(reinterpret<GCUnion?>(addr(func.val).value_.gc).cl.l).p
                // frame size
                var fsize : int = int(p.maxstacksize)
                var nfixparams : int = int(p.numparams)
                var i : int
                if (int64(L.stack_last.p - L.top.p) <= int64(fsize - delta)) {
                    var t__ : int64 = int64(reinterpret<uint8?>(func) - reinterpret<uint8?>(L.stack.p))
                    if (L.l_G.GCdebt > 0l) {
                        lgc::luaC_step(L)
                    }
                    __::luaD_growstack(L, fsize - delta, 1)
                    func = reinterpret<StackValue?>(reinterpret<uint8?>(L.stack.p) + t__)
                } else {
                }
                // restore 'func' (if vararg)
                ci.func.p -= delta
                // move down function and arguments
                i = 0
                while (i < narg1) {
                    var io1 : TValue? = addr((ci.func.p + i).val)
                    var io2 : TValue? = addr((func + i).val)
                    io1.value_ = io2.value_
                    io1.tt_ = io2.tt_
                    i++
                }
                // moved-down function
                func = ci.func.p
                while (narg1 <= nfixparams) {
                    // complete missing arguments
                    addr((func + narg1).val).tt_ = uint8(LUA_TNIL | (0 << 4))
                    narg1++
                }
                // top for new function
                ci.top.p = func + 1 + fsize
                // starting point
                ci.u.l.savedpc = p.code
                ci.callstatus = uint16(int(ci.callstatus) | CIST_TAIL)
                // set top
                L.top.p = func + narg1
                return -1
            }
        }
        case(_) {
            // not a function
            // try to get '__call' metamethod
            func = tryfuncTM(L, func)
            // return luaD_pretailcall(L, ci, func, narg1 + 1, delta);
            narg1++
            // try again
            goto label 1
        }
    }
    return 0
}

// Prepares the call to a function (C or Lua). For C functions, also do
// the call. The function to be called is at '*func'. The arguments
// are on the stack, right after the function. Returns the CallInfo
// to be executed, if it was a Lua function. Otherwise (a C function)
// returns NULL, with all the results on the stack, starting at the
// original function position.
[c_function]
def luaD_precall(var L : lua_State?; var func : StackValue?; nresults : int) : CallInfo? {
    label 1:  // retry
    c_switch(int(addr(func.val).tt_) & 63) {
        case(38) {
            // C closure
            precallC(L, func, nresults, addr(reinterpret<GCUnion?>(addr(func.val).value_.gc).cl.c).f)
            return null
        }
        case(22) {
            // light C function
            precallC(L, func, nresults, addr(func.val).value_.f)
            return null
        }
        case(6) {
            {
                // Lua function
                var ci : CallInfo?
                var p : Proto? = addr(reinterpret<GCUnion?>(addr(func.val).value_.gc).cl.l).p
                // number of real arguments
                var narg : int = int(int64(L.top.p - func)) - 1
                var nfixparams : int = int(p.numparams)
                // frame size
                var fsize : int = int(p.maxstacksize)
                if (int64(L.stack_last.p - L.top.p) <= int64(fsize)) {
                    var t__ : int64 = int64(reinterpret<uint8?>(func) - reinterpret<uint8?>(L.stack.p))
                    if (L.l_G.GCdebt > 0l) {
                        lgc::luaC_step(L)
                    }
                    __::luaD_growstack(L, fsize, 1)
                    func = reinterpret<StackValue?>(reinterpret<uint8?>(L.stack.p) + t__)
                } else {
                }
                ci = prepCallInfo(L, func, nresults, 0, func + 1 + fsize)
                L.ci = ci
                // starting point
                ci.u.l.savedpc = p.code
                while (narg < nfixparams) {
                    // complete missing arguments
                    var _t0 = L.top.p
                    L.top.p++
                    addr(_t0.val).tt_ = uint8(LUA_TNIL | (0 << 4))
                    narg++
                }
                return ci
            }
        }
        case(_) {
            // not a function
            // try to get '__call' metamethod
            func = tryfuncTM(L, func)
            // return luaD_precall(L, func, nresults);
            // try again with metamethod
            goto label 1
        }
    }
    return null
}

// Call a function (C or Lua) through C. 'inc' can be 1 (increment
// number of recursive invocations in the C stack) or nyci (the same
// plus increment number of non-yieldable calls).
// This function can be called with some use of EXTRA_STACK, so it should
// check the stack before doing anything else. 'luaD_precall' already
// does that.
[c_function]
def private ccall(var L : lua_State?; var func : StackValue?; nResults : int; inc : uint) {
    var ci : CallInfo?
    L.nCcalls += inc
    if ((L.nCcalls & 65535u) >= uint(LUAI_MAXCCALLS)) {
        // free any use of EXTRA_STACK
        if (int64(L.stack_last.p - L.top.p) <= 0l) {
            var t__ : int64 = int64(reinterpret<uint8?>(func) - reinterpret<uint8?>(L.stack.p))
            __::luaD_growstack(L, 0, 1)
            func = reinterpret<StackValue?>(reinterpret<uint8?>(L.stack.p) + t__)
        } else {
        }
        luaE_checkcstack(L)
    }
    // Lua function?
    ci = luaD_precall(L, func, nResults)
    if (ci != null) {
        // mark that it is a "fresh" execute
        ci.callstatus = uint16(CIST_FRESH)
        // call it
        luaV_execute(L, ci)
    }
    L.nCcalls -= inc
}

// External interface for 'ccall'
def luaD_call(var L : lua_State?; var func : StackValue?; nResults : int) {
    ccall(L, func, nResults, 1u)
}

// Similar to 'luaD_call', but does not allow yields during the call.
def luaD_callnoyield(var L : lua_State?; var func : StackValue?; nResults : int) {
    ccall(L, func, nResults, uint(nyci))
}

// Finish the job of 'lua_pcallk' after it was interrupted by an yield.
// (The caller, 'finishCcall', does the final call to 'adjustresults'.)
// The main job is to complete the 'luaD_pcall' called by 'lua_pcallk'.
// If a '__close' method yields here, eventually control will be back
// to 'finishCcall' (when that '__close' method finally returns) and
// 'finishpcallk' will run again and close any still pending '__close'
// methods. Similarly, if a '__close' method errs, 'precover' calls
// 'unroll' which calls ''finishCcall' and we are back here again, to
// close any pending '__close' methods.
// Note that, up to the call to 'luaF_close', the corresponding
// 'CallInfo' is not modified, so that this repeated run works like the
// first one (except that it has at least one less '__close' to do). In
// particular, field CIST_RECST preserves the error status across these
// multiple runs, changing only if there is a new error.
[c_function]
def private finishpcallk(var L : lua_State?; var ci : CallInfo?) : int {
    // get original status
    var status : int = (int(ci.callstatus) >> CIST_RECST) & 7
    // no error?
    if (status == LUA_OK) {
        // was interrupted by an yield
        status = LUA_YIELD
    } else {
        // error
        var func : StackValue? = reinterpret<StackValue?>(reinterpret<uint8?>(L.stack.p) + ci.u2.funcidx)
        // restore 'allowhook'
        L.allowhook = uint8(int(ci.callstatus) & CIST_OAH)
        // can yield or raise an error
        func = luaF_close(L, func, status, 1)
        __::luaD_seterrorobj(L, status, func)
        // restore stack size in case of overflow
        __::luaD_shrinkstack(L)
        // clear original status
        ci.callstatus = uint16((int(ci.callstatus) & ~(7 << CIST_RECST)) | (LUA_OK << CIST_RECST))
    }
    ci.callstatus = uint16(int(ci.callstatus) & ~CIST_YPCALL)
    L.errfunc = ci.u.c.old_errfunc
    // if it is here, there were errors or yields; unlike 'lua_pcallk',
    // do not change status
    return status
}

// Completes the execution of a C function interrupted by an yield.
// The interruption must have happened while the function was either
// closing its tbc variables in 'moveresults' or executing
// 'lua_callk'/'lua_pcallk'. In the first case, it just redoes
// 'luaD_poscall'. In the second case, the call to 'finishpcallk'
// finishes the interrupted execution of 'lua_pcallk'. After that, it
// calls the continuation of the interrupted function and finally it
// completes the job of the 'luaD_call' that called the function. In
// the call to 'adjustresults', we do not know the number of results
// of the function called by 'lua_callk'/'lua_pcallk', so we are
// conservative and use LUA_MULTRET (always adjust).
def private finishCcall(var L : lua_State?; var ci : CallInfo?) {
    // actual number of results from C function
    var n : int
    // was returning?
    if ((int(ci.callstatus) & CIST_CLSRET) != 0) {
        // just redo 'luaD_poscall'
        n = ci.u2.nres
    } else {
        // don't need to reset CIST_CLSRET, as it will be set again anyway
        // default if there were no errors
        var status : int = LUA_YIELD
        // must have a continuation and must be able to call it
        // was inside a 'lua_pcallk'?
        if ((int(ci.callstatus) & CIST_YPCALL) != 0) {
            // finish it
            status = finishpcallk(L, ci)
        }
        // finish 'lua_callk'
        if (LUA_MULTRET <= LUA_MULTRET && intptr(L.ci.top.p) < intptr(L.top.p)) {
            L.ci.top.p = L.top.p
        }
        // call continuation
        n = invoke(ci.u.c.k, L, status, ci.u.c.ctx)
    }
    // finish 'luaD_call'
    luaD_poscall(L, ci, n)
}

// Executes "full continuation" (everything in the stack) of a
// previously interrupted coroutine until the stack is empty (or another
// interruption long-jumps out of the loop).
[c_function]
def private unroll(var L : lua_State?; var ud : void?) {
    var ci : CallInfo?
    // something in the stack
    while (true) {
        ci = L.ci
        if (!(intptr(ci) != intptr(addr(L.base_ci)))) {
            break
        }
        // C function?
        if ((int(ci.callstatus) & CIST_C) != 0) {
            // complete its execution
            finishCcall(L, ci)
        } else {
            // Lua function
            // finish interrupted instruction
            luaV_finishOp(L)
            // execute down to higher C 'boundary'
            luaV_execute(L, ci)
        }
    }
}

// Try to find a suspended protected call (a "recover point") for the
// given thread.
[c_function]
def private findpcall(var L : lua_State?) : CallInfo? {
    var ci : CallInfo?
    // search for a pcall
    ci = L.ci
    while (ci != null) {
        if ((int(ci.callstatus) & CIST_YPCALL) != 0) {
            return ci
        }
        ci = ci.previous
    }
    // no pending pcall
    return null
}

// Signal an error in the call to 'lua_resume', not in the execution
// of the coroutine itself. (Such errors should not be handled by any
// coroutine error handler and should not kill the coroutine.)
[c_function]
def private resume_error(var L : lua_State?; var msg : uint8?; narg : int) : int {
    // remove args from the stack
    L.top.p -= narg
    {
        // push error message
        var io : TValue? = addr(L.top.p.val)
        var x_ : TString? = luaS_new(L, msg)
        io.value_.gc = addr(reinterpret<GCUnion?>(x_).gc)
        io.tt_ = uint8(int(x_.tt) | BIT_ISCOLLECTABLE)
    }
    L.top.p++
    return LUA_ERRRUN
}

// Do the work for 'lua_resume' in protected mode. Most of the work
// depends on the status of the coroutine: initial state, suspended
// inside a hook, or regularly suspended (optionally with a continuation
// function), plus erroneous cases: non-suspended coroutine or dead
// coroutine.
[c_function]
def private resume(var L : lua_State?; var ud : void?) {
    // number of arguments
    var n : int = *reinterpret<int?>(ud)
    // first argument
    var firstArg : StackValue? = L.top.p - n
    var ci : CallInfo? = L.ci
    // starting a coroutine?
    if (int(L.status) == LUA_OK) {
        // just call its body
        ccall(L, firstArg - 1, LUA_MULTRET, 0u)
    } else {
        // resuming from previous yield
        // mark that it is running (again)
        L.status = uint8(LUA_OK)
        // yielded inside a hook?
        if ((int(ci.callstatus) & CIST_C) == 0) {
            // undo increment made by 'luaG_traceexec': instruction was not
            // executed yet
            ci.u.l.savedpc--
            // discard arguments
            L.top.p = firstArg
            // just continue running Lua code
            luaV_execute(L, ci)
        } else {
            // 'common' yield
            // does it have a continuation function?
            if (ci.u.c.k != null) {
                // call continuation
                n = invoke(ci.u.c.k, L, LUA_YIELD, ci.u.c.ctx)
            }
            // finish 'luaD_call'
            luaD_poscall(L, ci, n)
        }
        // run continuation
        unroll(L, null)
    }
}

// Unrolls a coroutine in protected mode while there are recoverable
// errors, that is, errors inside a protected call. (Any error
// interrupts 'unroll', and this loop protects it again so it can
// continue.) Stops with a normal end (status == LUA_OK), an yield
// (status == LUA_YIELD), or an unprotected error ('findpcall' doesn't
// find a recover point).
[c_function]
def private precover(var L : lua_State?; var status : int) : int {
    var ci : CallInfo?
    while (true) {
        var _t0 = status > LUA_YIELD
        if (_t0) {
            ci = findpcall(L)
            _t0 = ci != null
        }
        if (!(_t0)) {
            break
        }
        // go down to recovery functions
        L.ci = ci
        // status to finish 'pcall'
        ci.callstatus = uint16((int(ci.callstatus) & ~(7 << CIST_RECST)) | (status << CIST_RECST))
        status = __::luaD_rawrunprotected(L, @@unroll, null)
    }
    return status
}

[c_function]
def lua_resume(var L : lua_State?; var from : lua_State?; var nargs : int; var nresults : int?) : int {
    var status : int
    // may be starting a coroutine
    if (int(L.status) == LUA_OK) {
        // not in base level?
        if (intptr(L.ci) != intptr(addr(L.base_ci))) {
            return resume_error(L, cstr("cannot resume non-suspended coroutine"), nargs)
        } elif (int64(L.top.p - (L.ci.func.p + 1)) == int64(nargs)) {
            // no function?
            return resume_error(L, cstr("cannot resume dead coroutine"), nargs)
        }
    } elif (int(L.status) != LUA_YIELD) {
        // ended with errors?
        return resume_error(L, cstr("cannot resume dead coroutine"), nargs)
    }
    L.nCcalls = from != null ? (from.nCcalls & 65535u) : 0u
    if ((L.nCcalls & 65535u) >= uint(LUAI_MAXCCALLS)) {
        return resume_error(L, cstr("C stack overflow"), nargs)
    }
    L.nCcalls++
    status = __::luaD_rawrunprotected(L, @@resume, reinterpret<void?>(addr(nargs)))
    // continue running after recoverable errors
    status = precover(L, status)
    if (!(status > LUA_YIELD)) {
        // normal end or yield
    } else {
        // unrecoverable error
        // mark thread as 'dead'
        L.status = uint8(status)
        // push error message
        __::luaD_seterrorobj(L, status, L.top.p)
        L.ci.top.p = L.top.p
    }
    *nresults = (status == LUA_YIELD) ? L.ci.u2.nyield : int(int64(L.top.p - (L.ci.func.p + 1)))
    return status
}

def lua_isyieldable(var L : lua_State?) : int {
    return int_of((L.nCcalls & 4294901760u) == 0u)
}

def lua_yieldk(var L : lua_State?; nresults : int; ctx : int64; k : function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>) : int {
    var ci : CallInfo?
    ci = L.ci
    if (!((L.nCcalls & 4294901760u) == 0u)) {
        if (intptr(L) != intptr(L.l_G.mainthread)) {
            luaG_runerror`va(L, cstr("attempt to yield across a C-call boundary"), VaNone())
        } else {
            luaG_runerror`va(L, cstr("attempt to yield from outside a coroutine"), VaNone())
        }
    }
    L.status = uint8(LUA_YIELD)
    // save number of results
    ci.u2.nyield = nresults
    // inside a hook?
    if ((int(ci.callstatus) & CIST_C) == 0) {
    } else {
        // is there a continuation?
        ci.u.c.k = k
        if (ci.u.c.k != null) {
            // save context
            ci.u.c.ctx = ctx
        }
        __::luaD_throw(L, LUA_YIELD)
    }
    // must be inside a hook
    // return to 'luaD_hook'
    return 0
}

// Auxiliary function to call 'luaF_close' in protected mode.
[c_function]
def private closepaux(var L : lua_State?; var ud : void?) {
    var pcl : CloseP? = reinterpret<CloseP?>(ud)
    luaF_close(L, pcl.level, pcl.status, 0)
}

// Calls 'luaF_close' in protected mode. Return the original status
// or, in case of errors, the new status.
[c_function]
def luaD_closeprotected(var L : lua_State?; level : int64; var status : int) : int {
    var old_ci : CallInfo? = L.ci
    var old_allowhooks : uint8 = L.allowhook
    // keep closing upvalues until no more errors
    while (true) {
        var pcl : CloseP
        pcl.level = reinterpret<StackValue?>(reinterpret<uint8?>(L.stack.p) + level)
        pcl.status = status
        status = __::luaD_rawrunprotected(L, @@closepaux, reinterpret<void?>(addr(pcl)))
        // no more errors?
        if (status == LUA_OK) {
            return pcl.status
        } else {
            // an error occurred; restore saved state and repeat
            L.ci = old_ci
            L.allowhook = old_allowhooks
        }
    }
    return 0
}

// Call the C function 'func' in protected mode, restoring basic
// thread information ('allowhook', etc.) and in particular
// its stack level in case of errors.
[c_function]
def luaD_pcall(var L : lua_State?; func : function<(var a0 : lua_State?; var a1 : void?) : void>; var u : void?; old_top : int64; ef : int64) : int {
    var status : int
    var old_ci : CallInfo? = L.ci
    var old_allowhooks : uint8 = L.allowhook
    var old_errfunc : int64 = L.errfunc
    L.errfunc = ef
    status = __::luaD_rawrunprotected(L, func, u)
    // an error occurred?
    if (status != LUA_OK) {
        L.ci = old_ci
        L.allowhook = old_allowhooks
        status = __::luaD_closeprotected(L, old_top, status)
        __::luaD_seterrorobj(L, status, reinterpret<StackValue?>(reinterpret<uint8?>(L.stack.p) + old_top))
        // restore stack size in case of overflow
        __::luaD_shrinkstack(L)
    }
    L.errfunc = old_errfunc
    return status
}

[c_function]
def private checkmode(var L : lua_State?; var mode : uint8?; var x : uint8?) {
    if (mode != null && crt::strchr(mode, int(x[0])) == null) {
        luaO_pushfstring`va(L, cstr("attempt to load a %s chunk (mode is '%s')"), (x, mode))
        __::luaD_throw(L, LUA_ERRSYNTAX)
    }
}

[c_function]
def private f_parser(var L : lua_State?; var ud : void?) {
    var cl : LClosure?
    var p : SParser? = reinterpret<SParser?>(ud)
    // read first character
    let _t0 = p.z.n
    p.z.n--
    var _t2 : int
    if (_t0 > 0ul) {
        var _t1 = p.z.p
        p.z.p++
        _t2 = int(*_t1)
    } else {
        _t2 = luaZ_fill(p.z)
    }
    var c : int = _t2
    if (c == int(cstr("\x1bLua")[0])) {
        checkmode(L, p.mode, cstr("binary"))
        cl = luaU_undump(L, p.z, p.name)
    } else {
        checkmode(L, p.mode, cstr("text"))
        cl = luaY_parser(L, p.z, addr(p.buff), addr(p.dyd), p.name, c)
    }
    luaF_initupvals(L, cl)
}

[c_function]
def luaD_protectedparser(var L : lua_State?; var z : Zio?; var name : uint8?; var mode : uint8?) : int {
    var p : SParser
    var status : int
    // cannot yield during parsing
    L.nCcalls += 65536u
    p.z = z
    p.name = name
    p.mode = mode
    p.dyd.actvar.arr = null
    p.dyd.actvar.size = 0
    p.dyd.gt.arr = null
    p.dyd.gt.size = 0
    p.dyd._c_label.arr = null
    p.dyd._c_label.size = 0
    addr(p.buff).buffer = null
    addr(p.buff).buffsize = 0ul
    status = __::luaD_pcall(L, @@f_parser, reinterpret<void?>(addr(p)), int64(reinterpret<uint8?>(L.top.p) - reinterpret<uint8?>(L.stack.p)), L.errfunc)
    addr(p.buff).buffer = reinterpret<uint8?>(luaM_saferealloc_(L, reinterpret<void?>(addr(p.buff).buffer),
            addr(p.buff).buffsize * uint64(typeinfo sizeof(type<uint8>)), 0ul * uint64(typeinfo sizeof(type<uint8>))))
    addr(p.buff).buffsize = 0ul
    luaM_free_(L, reinterpret<void?>(p.dyd.actvar.arr), uint64(p.dyd.actvar.size) * uint64(typeinfo sizeof(type<Vardesc>)))
    luaM_free_(L, reinterpret<void?>(p.dyd.gt.arr), uint64(p.dyd.gt.size) * uint64(typeinfo sizeof(type<Labeldesc>)))
    luaM_free_(L, reinterpret<void?>(p.dyd._c_label.arr), uint64(p.dyd._c_label.size) * uint64(typeinfo sizeof(type<Labeldesc>)))
    L.nCcalls -= 65536u
    return status
}

[init]
def private c2das_late_bind {
    luaD_call_slot = @@__::luaD_call
    luaD_callnoyield_slot = @@__::luaD_callnoyield
    luaD_closeprotected_slot = @@__::luaD_closeprotected
    luaD_errerr_slot = @@__::luaD_errerr
    luaD_growstack_slot = @@__::luaD_growstack
    luaD_pcall_slot = @@__::luaD_pcall
    luaD_rawrunprotected_slot = @@__::luaD_rawrunprotected
    luaD_reallocstack_slot = @@__::luaD_reallocstack
    luaD_seterrorobj_slot = @@__::luaD_seterrorobj
    luaD_shrinkstack_slot = @@__::luaD_shrinkstack
    luaD_throw_slot = @@__::luaD_throw
}

