// If expression is a numeric constant, fills 'v' with its value
// and returns 1. Otherwise, returns 0.
def private tonumeral(var e : expdesc?; var v : TValue?) : int {
    if (e.t != e.f) {
        // not a numeral
        return 0
    }
    let _cond = e.k
    if (_cond == expkind.VKINT) {
        if (v != null) {
            var io : TValue? = v
            io.value_.i = e.u.ival
            io.tt_ = uint8(3 | 0 << 4)
        }
        return 1
    } elif (_cond == expkind.VKFLT) {
        if (v != null) {
            var io : TValue? = v
            io.value_.n = e.u.nval
            io.tt_ = uint8(3 | 1 << 4)
        }
        return 1
    } else {
        return 0
    }
    return 0
}

