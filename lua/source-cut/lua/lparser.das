    }
    luaK_patchlist(ls.fs, gt.pc, _c_label.pc)
    // remove goto from pending list
    i = g
    while (i < gl.n - 1) {
        gl.arr[i] = gl.arr[i + 1]
        i++
    }
    gl.n--
}

// Search for an active label with the given name.
[c_function]
def private findlabel(var ls : LexState?; var name : TString?) : Labeldesc? {
    var dyd : Dyndata? = ls.dyd
    // check labels in current function for a match
    for (i in range(ls.fs.firstlabel, dyd._c_label.n)) {
        var lb : Labeldesc? = addr(dyd._c_label.arr[i])
        // correct label?
        if (eqstr(lb.name, name)) {
            return lb
        }
    }
    // label not found
    return null
}

// Adds a new label/goto in the corresponding list.
[c_function]
def private newlabelentry(var ls : LexState?; var l : Labellist?; var name : TString?; line : int; pc : int) : int {
    let n : int = l.n
    l.arr = reinterpret<Labeldesc?>(luaM_growaux_(ls.L, reinterpret<void?>(l.arr), n, addr(l.size), typeinfo sizeof(type<Labeldesc>),
            int(32767ul <= MAX_SIZET / uint64(typeinfo sizeof(type<Labeldesc>)) ? 32767u : uint(MAX_SIZET / uint64(typeinfo sizeof(type<Labeldesc>)))),
            cstr("labels/gotos")))
    l.arr[n].name = name
    l.arr[n].line = line
    l.arr[n].nactvar = ls.fs.nactvar
    l.arr[n].close = 0u8
    l.arr[n].pc = pc
    l.n = n + 1
    return n
}

[c_function]
def private newgotoentry(var ls : LexState?; var name : TString?; line : int; pc : int) : int {
    return newlabelentry(ls, addr(ls.dyd.gt), name, line, pc)
}

// Solves forward jumps. Check whether new label 'lb' matches any
// pending gotos in current block and solves them. Return true
// if any of the gotos need to close upvalues.
[c_function]
def private solvegotos(var ls : LexState?; var lb : Labeldesc?) : int {
    var gl : Labellist? = addr(ls.dyd.gt)
    var i : int = ls.fs.bl.firstgoto
    var needsclose : int = 0
    while (i < gl.n) {
        if (eqstr(gl.arr[i].name, lb.name)) {
            needsclose |= int(gl.arr[i].close)
            // will remove 'i' from the list
            solvegoto(ls, i, lb)
        } else {
            i++
        }
    }
    return needsclose
}

// Create a new label with the given 'name' at the given 'line'.
// 'last' tells whether label is the last non-op statement in its
// block. Solves all pending gotos to this new label and adds
// a close instruction if necessary.
// Returns true iff it added a close instruction.
[c_function]
def private createlabel(var ls : LexState?; var name : TString?; line : int; last : int) : int {
    var fs : FuncState? = ls.fs
    var ll : Labellist? = addr(ls.dyd._c_label)
    let l : int = newlabelentry(ls, ll, name, line, luaK_getlabel(fs))
    // label is last no-op statement in the block?
    if (last != 0) {
        // assume that locals are already out of scope
        ll.arr[l].nactvar = fs.bl.nactvar
    }
    // need close?
    if (solvegotos(ls, addr(ll.arr[l])) != 0) {
        luaK_codeABCk(fs, OpCode.OP_CLOSE, __::luaY_nvarstack(fs), 0, 0, 0)
        return 1
    }
    return 0
}

// Adjust pending gotos to outer level of a block.
[c_function]
def private movegotosout(var fs : FuncState?; var bl : BlockCnt?) {
    var i : int
    var gl : Labellist? = addr(fs.ls.dyd.gt)
    // correct pending gotos to current block
    // for each pending goto
    i = bl.firstgoto
    while (i < gl.n) {
        var gt : Labeldesc? = addr(gl.arr[i])
        // leaving a variable scope?
        if (reglevel(fs, int(gt.nactvar)) > reglevel(fs, int(bl.nactvar))) {
            // jump may need a close
            gt.close = uint8(int(gt.close) | int(bl.upval))
        }
        // update goto level
        gt.nactvar = bl.nactvar
        i++
    }
}

[c_function]
def private enterblock(var fs : FuncState?; var bl : BlockCnt?; isloop : uint8) {
    bl.isloop = isloop
    bl.nactvar = fs.nactvar
    bl.firstlabel = fs.ls.dyd._c_label.n
    bl.firstgoto = fs.ls.dyd.gt.n
    bl.upval = 0u8
    bl.insidetbc = uint8(int_of(fs.bl != null && fs.bl.insidetbc != 0))
    bl.previous = fs.bl
    fs.bl = bl
}

// generates an error for an undefined 'goto'.
[c_function]
def private undefgoto(var ls : LexState?; var gt : Labeldesc?) {
    var msg : uint8?
    if (intptr(gt.name) == intptr(luaS_newlstr(ls.L, cstr("break"), uint64(typeinfo sizeof(type<uint8[6]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))) {
        msg = cstr("break outside loop at line %d")
        msg = luaO_pushfstring`va(ls.L, msg, (gt.line,))
    } else {
        msg = cstr("no visible label '%s' for <goto> at line %d")
        msg = luaO_pushfstring`va(ls.L, msg, (addr(gt.name.contents[0]), gt.line))
    }
    luaK_semerror(ls, msg)
}

[c_function]
def private leaveblock(var fs : FuncState?) {
    var bl : BlockCnt? = fs.bl
    var ls : LexState? = fs.ls
    var hasclose : int = 0
    // level outside the block
    let stklevel : int = reglevel(fs, int(bl.nactvar))
    // remove block locals
    removevars(fs, int(bl.nactvar))
    // back to level on entry
    // has to fix pending breaks?
    if (bl.isloop != 0) {
        hasclose = createlabel(ls, luaS_newlstr(ls.L, cstr("break"), uint64(typeinfo sizeof(type<uint8[6]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul), 0,
                0)
    }
    // still need a 'close'?
    if (hasclose == 0 && bl.previous != null && bl.upval != 0) {
        luaK_codeABCk(fs, OpCode.OP_CLOSE, stklevel, 0, 0, 0)
    }
    // free registers
    fs.freereg = uint8(stklevel)
    // remove local labels
    ls.dyd._c_label.n = bl.firstlabel
    // current block now is previous one
    fs.bl = bl.previous
    // was it a nested block?
    if (bl.previous != null) {
        // update pending gotos to enclosing block
        movegotosout(fs, bl)
    } else {
        // still pending gotos?
        if (bl.firstgoto < ls.dyd.gt.n) {
            // error
            undefgoto(ls, addr(ls.dyd.gt.arr[bl.firstgoto]))
        }
    }
}

// adds a new prototype into list of prototypes
[c_function]
def private addprototype(var ls : LexState?) : Proto? {
    var clp : Proto?
    var L : lua_State? = ls.L
    var fs : FuncState? = ls.fs
    // prototype of current function
    var f : Proto? = fs.f
    if (fs.np >= f.sizep) {
        var oldsize : int = f.sizep
        f.p = reinterpret<Proto ??>(luaM_growaux_(L, reinterpret<void?>(f.p), fs.np, addr(f.sizep), typeinfo sizeof(type<Proto?>),
                int(uint64(MAXARG_Bx) <= MAX_SIZET / uint64(typeinfo sizeof(type<Proto?>)) ? uint(MAXARG_Bx) :
                    uint(MAX_SIZET / uint64(typeinfo sizeof(type<Proto?>)))),
                cstr("functions")))
        while (oldsize < f.sizep) {
            let _t0 = oldsize
            oldsize++
            f.p[_t0] = null
        }
    }
    let _t1 = fs.np
    fs.np++
    clp = luaF_newproto(L)
    f.p[_t1] = clp
    luaC_objbarrier(L, f, clp)
    return clp
}

// codes instruction to create new closure in parent function.
// The OP_CLOSURE instruction uses the last available register,
// so that, if it invokes the GC, the GC knows which registers
// are in use at that time.
def private codeclosure(var ls : LexState?; var v : expdesc?) {
    var fs : FuncState? = ls.fs.prev
    init_exp(v, expkind.VRELOC, luaK_codeABx(fs, OpCode.OP_CLOSURE, 0, uint(fs.np - 1)))
    // fix it at the last register
    luaK_exp2nextreg(fs, v)
}

def private open_func(var ls : LexState?; var fs : FuncState?; var bl : BlockCnt?) {
    var f : Proto? = fs.f
    // linked list of funcstates
    fs.prev = ls.fs
    fs.ls = ls
    ls.fs = fs
    fs.pc = 0
    fs.previousline = f.linedefined
    fs.iwthabs = 0u8
    fs.lasttarget = 0
    fs.freereg = 0u8
    fs.nk = 0
    fs.nabslineinfo = 0
    fs.np = 0
    fs.nups = 0u8
    fs.ndebugvars = int16(0)
    fs.nactvar = 0u8
    fs.needclose = 0u8
    fs.firstlocal = ls.dyd.actvar.n
    fs.firstlabel = ls.dyd._c_label.n
    fs.bl = null
    f.source = ls.source
    if (isblack(f) != 0 && iswhite(f.source) != 0) {
        luaC_barrier_(ls.L, obj2gco(f), obj2gco(f.source))
    }
    // registers 0/1 are always valid
    f.maxstacksize = 2u8
    enterblock(fs, bl, 0u8)
}

[c_function]
def private close_func(var ls : LexState?) {
    var L : lua_State? = ls.L
    var fs : FuncState? = ls.fs
    var f : Proto? = fs.f
    // final return
    luaK_ret(fs, __::luaY_nvarstack(fs), 0)
    leaveblock(fs)
    luaK_finish(fs)
    f.code = reinterpret<uint?>(luaM_shrinkvector_(L, reinterpret<void?>(f.code), addr(f.sizecode), fs.pc, typeinfo sizeof(type<uint>)))
    f.lineinfo = reinterpret<int8?>(luaM_shrinkvector_(L, reinterpret<void?>(f.lineinfo), addr(f.sizelineinfo), fs.pc, typeinfo sizeof(type<int8>)))
    f.abslineinfo = reinterpret<AbsLineInfo?>(luaM_shrinkvector_(L, reinterpret<void?>(f.abslineinfo), addr(f.sizeabslineinfo), fs.nabslineinfo,
            typeinfo sizeof(type<AbsLineInfo>)))
    f.k = reinterpret<TValue?>(luaM_shrinkvector_(L, reinterpret<void?>(f.k), addr(f.sizek), fs.nk, typeinfo sizeof(type<TValue>)))
    f.p = reinterpret<Proto ??>(luaM_shrinkvector_(L, reinterpret<void?>(f.p), addr(f.sizep), fs.np, typeinfo sizeof(type<Proto?>)))
    f.locvars = reinterpret<LocVar?>(luaM_shrinkvector_(L, reinterpret<void?>(f.locvars), addr(f.sizelocvars), int(fs.ndebugvars),
            typeinfo sizeof(type<LocVar>)))
    f.upvalues = reinterpret<Upvaldesc?>(luaM_shrinkvector_(L, reinterpret<void?>(f.upvalues), addr(f.sizeupvalues), int(fs.nups),
            typeinfo sizeof(type<Upvaldesc>)))
    ls.fs = fs.prev
    luaC_checkGC(L)
}

// check whether current token is in the follow set of a block.
// 'until' closes syntactical blocks, but do not close scope,
// so it is handled in separate.
def private block_follow(var ls : LexState?; withuntil : int) : int {
    c_switch(ls.t.token) {
        case(259, 260, 261, 288) {
            return 1
        }
        case(276) {
            return withuntil
        }
        case(_) {
            return 0
        }
    }
}

def private statlist(var ls : LexState?) {
    // statlist -> { stat [';'] }
    while (block_follow(ls, 1) == 0) {
        if (ls.t.token == int(RESERVED.TK_RETURN)) {
            statement(ls)
            // 'return' must be last statement
            return
        }
        statement(ls)
    }
}

[c_function]
def private fieldsel(var ls : LexState?; var v : expdesc?) {
    // fieldsel -> ['.' | ':'] NAME
    var fs : FuncState? = ls.fs
    var key : expdesc
    luaK_exp2anyregup(fs, v)
    // skip the dot or colon
    luaX_next(ls)
    codename(ls, addr(key))
    luaK_indexed(fs, v, addr(key))
}

def private yindex(var ls : LexState?; var v : expdesc?) {
    // index -> '[' expr ']'
    // skip the '['
    luaX_next(ls)
    expr(ls, v)
    luaK_exp2val(ls.fs, v)
    checknext(ls, ']')
}

[c_function]
def private recfield(var ls : LexState?; var cc : ConsControl?) {
    // recfield -> (NAME | '['exp']') = exp
    var fs : FuncState? = ls.fs
    let reg : int = int(ls.fs.freereg)
    var tab : expdesc
    var key : expdesc
    var val : expdesc
    if (ls.t.token == int(RESERVED.TK_NAME)) {
        codename(ls, addr(key))
    } else {
        // ls->t.token == '['
        yindex(ls, addr(key))
    }
    checklimit(fs, cc.nh, 2147483647, cstr("items in a constructor"))
    cc.nh++
    checknext(ls, '=')
    tab = *cc.t
    luaK_indexed(fs, addr(tab), addr(key))
    expr(ls, addr(val))
    luaK_storevar(fs, addr(tab), addr(val))
    // free registers
    fs.freereg = uint8(reg)
}

[c_function]
def private closelistfield(var fs : FuncState?; var cc : ConsControl?) {
    // there is no list item
    if (cc.v.k == expkind.VVOID) {
        return
    }
    luaK_exp2nextreg(fs, addr(cc.v))
    cc.v.k = expkind.VVOID
    if (cc.tostore == LFIELDS_PER_FLUSH) {
        // flush
        luaK_setlist(fs, cc.t.u.info, cc.na, cc.tostore)
        cc.na += cc.tostore
        // no more items pending
        cc.tostore = 0
    }
}

[c_function]
def private lastlistfield(var fs : FuncState?; var cc : ConsControl?) {
    if (cc.tostore == 0) {
        return
    }
    if (cc.v.k == expkind.VCALL || cc.v.k == expkind.VVARARG) {
        luaK_setmultret(fs, addr(cc.v))
        luaK_setlist(fs, cc.t.u.info, cc.na, LUA_MULTRET)
        // do not count last expression (unknown number of elements)
        cc.na--
    } else {
        if (cc.v.k != expkind.VVOID) {
            luaK_exp2nextreg(fs, addr(cc.v))
        }
        luaK_setlist(fs, cc.t.u.info, cc.na, cc.tostore)
    }
    cc.na += cc.tostore
}

[c_function]
def private listfield(var ls : LexState?; var cc : ConsControl?) {
    // listfield -> exp
    expr(ls, addr(cc.v))
    cc.tostore++
}

def private field(var ls : LexState?; var cc : ConsControl?) {
    // field -> listfield | recfield
    c_switch(ls.t.token) {
        case(291) {
            // may be 'listfield' or 'recfield'
            // expression?
            if (luaX_lookahead(ls) != '=') {
                listfield(ls, cc)
            } else {
                recfield(ls, cc)
            }
            break
        }
        case('[') {
            recfield(ls, cc)
            break
        }
        case(_) {
            listfield(ls, cc)
            break
        }
    }
}

[c_function]
def private constructor(var ls : LexState?; var t : expdesc?) {
    // constructor -> '{' [ field { sep field } [sep] ] '}'
    // sep -> ',' | ';'
    var fs : FuncState? = ls.fs
    let line : int = ls.linenumber
    let pc : int = luaK_codeABCk(fs, OpCode.OP_NEWTABLE, 0, 0, 0, 0)
    var cc : ConsControl
    // space for extra arg.
    luaK_code(fs, 0u)
    cc.tostore = 0
    cc.nh = cc.tostore
    cc.na = cc.nh
    cc.t = t
    // table will be at stack top
    init_exp(t, expkind.VNONRELOC, int(fs.freereg))
    luaK_reserveregs(fs, 1)
    // no value (yet)
    init_exp(addr(cc.v), expkind.VVOID, 0)
    checknext(ls, '{')
    c_do_while(testnext(ls, ',') != 0 || testnext(ls, ';') != 0) {
        if (ls.t.token == '}') {
            break
        }
        closelistfield(fs, addr(cc))
        field(ls, addr(cc))
    }
    check_match(ls, '}', '{', line)
    lastlistfield(fs, addr(cc))
    luaK_settablesize(fs, pc, t.u.info, cc.na, cc.nh)
}

def private setvararg(var fs : FuncState?; nparams : int) {
    fs.f.is_vararg = 1u8
    luaK_codeABCk(fs, OpCode.OP_VARARGPREP, nparams, 0, 0, 0)
}

def private parlist(var ls : LexState?) {
    // parlist -> [ {NAME ','} (NAME | '...') ]
    var fs : FuncState? = ls.fs
    var f : Proto? = fs.f
    var nparams : int = 0
    var isvararg : int = 0
    // is 'parlist' not empty?
    if (ls.t.token != ')') {
        c_do_while(isvararg == 0 && testnext(ls, ',') != 0) {
            c_switch(ls.t.token) {
                case(291) {
                    new_localvar(ls, str_checkname(ls))
                    nparams++
                    break
                }
                case(280) {
                    luaX_next(ls)
                    isvararg = 1
                    break
                }
                case(_) {
                    luaX_syntaxerror(ls, cstr("<name> or '...' expected"))
                }
            }
        }
    }
    adjustlocalvars(ls, nparams)
    f.numparams = fs.nactvar
    if (isvararg != 0) {
        // declared vararg
        setvararg(fs, int(f.numparams))
    }
    // reserve registers for parameters
    luaK_reserveregs(fs, int(fs.nactvar))
}

[c_function]
def private body(var ls : LexState?; var e : expdesc?; ismethod : int; line : int) {
    // body -> '(' parlist ')' block END
    var new_fs : FuncState
    var bl : BlockCnt
    new_fs.f = addprototype(ls)
    new_fs.f.linedefined = line
    open_func(ls, addr(new_fs), addr(bl))
    checknext(ls, '(')
    if (ismethod != 0) {
        // create 'self' parameter
        new_localvar(ls, luaX_newstring(ls, cstr("self"), uint64(typeinfo sizeof(type<uint8[5]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
        adjustlocalvars(ls, 1)
    }
    parlist(ls)
    checknext(ls, ')')
    statlist(ls)
    new_fs.f.lastlinedefined = ls.linenumber
    check_match(ls, int(RESERVED.TK_END), int(RESERVED.TK_FUNCTION), line)
    codeclosure(ls, e)
    close_func(ls)
}

def private explist(var ls : LexState?; var v : expdesc?) : int {
    // explist -> expr { ',' expr }
    // at least one expression
    var n : int = 1
    expr(ls, v)
    while (testnext(ls, ',') != 0) {
        luaK_exp2nextreg(ls.fs, v)
        expr(ls, v)
        n++
    }
    return n
}

[c_function]
def private funcargs(var ls : LexState?; var f : expdesc?) {
    var fs : FuncState? = ls.fs
    var args : expdesc
    var base : int
    var nparams : int
    let line : int = ls.linenumber
    c_switch(ls.t.token) {
        case('(') {
            // funcargs -> '(' [ explist ] ')'
            luaX_next(ls)
            // arg list is empty?
            if (ls.t.token == ')') {
                args.k = expkind.VVOID
            } else {
                explist(ls, addr(args))
                if (hasmultret(args.k)) {
                    luaK_setmultret(fs, addr(args))
                }
            }
            check_match(ls, ')', '(', line)
            break
        }
        case('{') {
            // funcargs -> constructor
            constructor(ls, addr(args))
            break
        }
        case(292) {
            // funcargs -> STRING
            codestring(addr(args), ls.t.seminfo.ts)
            // must use 'seminfo' before 'next'
            luaX_next(ls)
            break
        }
        case(_) {
            luaX_syntaxerror(ls, cstr("function arguments expected"))
        }
    }
    // base register for call
    base = f.u.info
    if (hasmultret(args.k)) {
        // open call
        nparams = LUA_MULTRET
    } else {
        if (args.k != expkind.VVOID) {
            // close last argument
            luaK_exp2nextreg(fs, addr(args))
        }
        nparams = int(fs.freereg) - (base + 1)
    }
    init_exp(f, expkind.VCALL, luaK_codeABCk(fs, OpCode.OP_CALL, base, nparams + 1, 2, 0))
    luaK_fixline(fs, line)
    // call removes function and arguments and leaves
    fs.freereg = uint8(base + 1)
}

def private primaryexp(var ls : LexState?; var v : expdesc?) {
    // primaryexp -> NAME | '(' expr ')'
    c_switch(ls.t.token) {
        case('(') {
            {
                let line : int = ls.linenumber
                luaX_next(ls)
                expr(ls, v)
                check_match(ls, ')', '(', line)
                luaK_dischargevars(ls.fs, v)
                return
            }
        }
        case(291) {
            singlevar(ls, v)
            return
        }
        case(_) {
            luaX_syntaxerror(ls, cstr("unexpected symbol"))
        }
    }
}

[c_function]
def private suffixedexp(var ls : LexState?; var v : expdesc?) {
    // suffixedexp ->
    // primaryexp { '.' NAME | '[' exp ']' | ':' NAME funcargs | funcargs }
    var fs : FuncState? = ls.fs
    primaryexp(ls, v)
    while (true) {
        c_switch(ls.t.token) {
            case('.') {
                // fieldsel
                fieldsel(ls, v)
                break
            }
            case('[') {
                {
                    // '[' exp ']'
                    var key : expdesc
                    luaK_exp2anyregup(fs, v)
                    yindex(ls, addr(key))
                    luaK_indexed(fs, v, addr(key))
                    break
                }
            }
            case(':') {
                {
                    // ':' NAME funcargs
                    var key : expdesc
                    luaX_next(ls)
                    codename(ls, addr(key))
                    luaK_self(fs, v, addr(key))
                    funcargs(ls, v)
                    break
                }
            }
            case('(', 292, '{') {
                // funcargs
                luaK_exp2nextreg(fs, v)
                funcargs(ls, v)
                break
            }
            case(_) {
                return
            }
        }
    }
}

def private simpleexp(var ls : LexState?; var v : expdesc?) {
    // simpleexp -> FLT | INT | STRING | NIL | TRUE | FALSE | ... |
    // constructor | FUNCTION body | suffixedexp
    c_switch(ls.t.token) {
        case(289) {
            init_exp(v, expkind.VKFLT, 0)
            v.u.nval = ls.t.seminfo.r
            break
        }
        case(290) {
            init_exp(v, expkind.VKINT, 0)
            v.u.ival = ls.t.seminfo.i
            break
        }
        case(292) {
            codestring(v, ls.t.seminfo.ts)
            break
        }
        case(269) {
            init_exp(v, expkind.VNIL, 0)
            break
        }
        case(275) {
            init_exp(v, expkind.VTRUE, 0)
            break
        }
        case(262) {
            init_exp(v, expkind.VFALSE, 0)
            break
        }
        case(280) {
            {
                // vararg
                var fs : FuncState? = ls.fs
                if (fs.f.is_vararg == 0) {
                    luaX_syntaxerror(ls, cstr("cannot use '...' outside a vararg function"))
                }
                init_exp(v, expkind.VVARARG, luaK_codeABCk(fs, OpCode.OP_VARARG, 0, 0, 1, 0))
                break
            }
        }
        case('{') {
            // constructor
            constructor(ls, v)
            return
        }
        case(264) {
            luaX_next(ls)
            body(ls, v, 0, ls.linenumber)
            return
        }
        case(_) {
            suffixedexp(ls, v)
            return
        }
    }
    luaX_next(ls)
}

def private getunopr(op : int) : UnOpr {
    c_switch(op) {
        case(270) {
            return UnOpr.OPR_NOT
        }
        case('-') {
            return UnOpr.OPR_MINUS
        }
        case('~') {
            return UnOpr.OPR_BNOT
        }
        case('#') {
            return UnOpr.OPR_LEN
        }
        case(_) {
            return UnOpr.OPR_NOUNOPR
        }
    }
}

def private getbinopr(op : int) : BinOpr {
    c_switch(op) {
        case('+') {
            return BinOpr.OPR_ADD
        }
        case('-') {
            return BinOpr.OPR_SUB
        }
        case('*') {
            return BinOpr.OPR_MUL
        }
        case('%') {
            return BinOpr.OPR_MOD
        }
        case('^') {
            return BinOpr.OPR_POW
        }
        case('/') {
            return BinOpr.OPR_DIV
        }
        case(278) {
            return BinOpr.OPR_IDIV
        }
        case('&') {
            return BinOpr.OPR_BAND
        }
        case('|') {
            return BinOpr.OPR_BOR
        }
        case('~') {
            return BinOpr.OPR_BXOR
        }
        case(285) {
            return BinOpr.OPR_SHL
        }
        case(286) {
            return BinOpr.OPR_SHR
        }
        case(279) {
            return BinOpr.OPR_CONCAT
        }
        case(284) {
            return BinOpr.OPR_NE
        }
        case(281) {
            return BinOpr.OPR_EQ
        }
        case('<') {
            return BinOpr.OPR_LT
        }
        case(283) {
            return BinOpr.OPR_LE
        }
        case('>') {
            return BinOpr.OPR_GT
        }
        case(282) {
            return BinOpr.OPR_GE
        }
        case(256) {
            return BinOpr.OPR_AND
        }
        case(271) {
            return BinOpr.OPR_OR
        }
        case(_) {
            return BinOpr.OPR_NOBINOPR
        }
    }
}

// subexpr -> (simpleexp | unop subexpr) { binop subexpr }
// where 'binop' is any binary operator with a priority higher than 'limit'
[c_function]
def private subexpr(var ls : LexState?; var v : expdesc?; limit : int) : BinOpr {
    var op : BinOpr
    var uop : UnOpr
    enterlevel(ls)
    uop = getunopr(ls.t.token)
    // prefix (unary) operator?
    if (uop != UnOpr.OPR_NOUNOPR) {
        let line : int = ls.linenumber
        // skip operator
        luaX_next(ls)
        subexpr(ls, v, UNARY_PRIORITY)
        luaK_prefix(ls.fs, uop, v, line)
    } else {
        simpleexp(ls, v)
    }
    // expand while operators have priorities higher than 'limit'
    op = getbinopr(ls.t.token)
    while (op != BinOpr.OPR_NOBINOPR && int(priority[int(op)].left) > limit) {
        var v2 : expdesc
        var nextop : BinOpr
        let line : int = ls.linenumber
        // skip operator
        luaX_next(ls)
        luaK_infix(ls.fs, op, v)
        // read sub-expression with higher priority
        nextop = subexpr(ls, addr(v2), int(priority[int(op)].right))
        luaK_posfix(ls.fs, op, v, addr(v2), line)
        op = nextop
    }
    leavelevel(ls)
    // return first untreated operator
    return op
}

def private expr(var ls : LexState?; var v : expdesc?) {
    subexpr(ls, v, 0)
}

[c_function]
def private _c_block(var ls : LexState?) {
    // block -> statlist
    var fs : FuncState? = ls.fs
    var bl : BlockCnt
    enterblock(fs, addr(bl), 0u8)
    statlist(ls)
    leaveblock(fs)
}

// check whether, in an assignment to an upvalue/local variable, the
// upvalue/local variable is begin used in a previous assignment to a
// table. If so, save original upvalue/local value in a safe place and
// use this safe copy in the previous assignment.
def private check_conflict(var ls : LexState?; var lh : LHS_assign?; var v : expdesc?) {
    var fs : FuncState? = ls.fs
    // eventual position to save local variable
    let extra : int = int(fs.freereg)
    var conflict : int = 0
    // check all previous assignments
    while (lh != null) {
        // assignment to table field?
        if (uint(expkind.VINDEXED) <= uint(lh.v.k) && uint(lh.v.k) <= uint(expkind.VINDEXSTR)) {
            // is table an upvalue?
            if (lh.v.k == expkind.VINDEXUP) {
                if (v.k == expkind.VUPVAL && int(lh.v.u.ind.t) == v.u.info) {
                    // table is the upvalue being assigned now
                    conflict = 1
                    lh.v.k = expkind.VINDEXSTR
                    // assignment will use safe copy
                    lh.v.u.ind.t = uint8(extra)
                }
            } else {
                // table is a register
                if (v.k == expkind.VLOCAL && lh.v.u.ind.t == v.u._c_var.ridx) {
                    // table is the local being assigned now
                    conflict = 1
                    // assignment will use safe copy
                    lh.v.u.ind.t = uint8(extra)
                }
                // is index the local being assigned?
                if (lh.v.k == expkind.VINDEXED && v.k == expkind.VLOCAL && int(lh.v.u.ind.idx) == int(v.u._c_var.ridx)) {
                    conflict = 1
                    // previous assignment will use safe copy
                    lh.v.u.ind.idx = int16(extra)
                }
            }
        }
        lh = lh.prev
    }
    if (conflict != 0) {
        // copy upvalue/local value to a temporary (in position 'extra')
        if (v.k == expkind.VLOCAL) {
            luaK_codeABCk(fs, OpCode.OP_MOVE, extra, int(v.u._c_var.ridx), 0, 0)
        } else {
            luaK_codeABCk(fs, OpCode.OP_GETUPVAL, extra, v.u.info, 0, 0)
        }
        luaK_reserveregs(fs, 1)
    }
}

// Parse and compile a multiple assignment. The first "variable"
// (a 'suffixedexp') was already read by the caller.
// assignment -> suffixedexp restassign
// restassign -> ',' suffixedexp restassign | '=' explist
[c_function]
def private restassign(var ls : LexState?; var lh : LHS_assign?; nvars : int) {
    var e : expdesc
    if (!(uint(expkind.VLOCAL) <= uint(lh.v.k) && uint(lh.v.k) <= uint(expkind.VINDEXSTR))) {
        luaX_syntaxerror(ls, cstr("syntax error"))
    }
    check_readonly(ls, addr(lh.v))
    // restassign -> ',' suffixedexp restassign
    if (testnext(ls, ',') != 0) {
        var nv : LHS_assign
        nv.prev = lh
        suffixedexp(ls, addr(nv.v))
        if (!vkisindexed(nv.v.k)) {
            check_conflict(ls, lh, addr(nv.v))
        }
        // control recursion depth
        enterlevel(ls)
        restassign(ls, addr(nv), nvars + 1)
        leavelevel(ls)
    } else {
        // restassign -> '=' explist
        var nexps : int
        checknext(ls, '=')
        nexps = explist(ls, addr(e))
        if (nexps != nvars) {
            adjust_assign(ls, nvars, nexps, addr(e))
        } else {
            // close last expression
            luaK_setoneret(ls.fs, addr(e))
            luaK_storevar(ls.fs, addr(lh.v), addr(e))
            // avoid default
            return
        }
    }
    // default assignment
    init_exp(addr(e), expkind.VNONRELOC, int(ls.fs.freereg) - 1)
    luaK_storevar(ls.fs, addr(lh.v), addr(e))
}

[c_function]
def private cond(var ls : LexState?) : int {
    // cond -> exp
    var v : expdesc
    // read condition
    expr(ls, addr(v))
    // 'falses' are all equal here
    if (v.k == expkind.VNIL) {
        v.k = expkind.VFALSE
    }
    luaK_goiftrue(ls.fs, addr(v))
    return v.f
}

[c_function]
def private gotostat(var ls : LexState?) {
    var fs : FuncState? = ls.fs
    let line : int = ls.linenumber
    // label's name
    var name : TString? = str_checkname(ls)
    var lb : Labeldesc? = findlabel(ls, name)
    // no label?
    if (lb == null) {
        // forward jump; will be resolved when the label is declared
        newgotoentry(ls, name, line, luaK_jump(fs))
    } else {
        // found a label
        // backward jump; will be resolved here
        // label level
        let lblevel : int = reglevel(fs, int(lb.nactvar))
        // leaving the scope of a variable?
        if (__::luaY_nvarstack(fs) > lblevel) {
            luaK_codeABCk(fs, OpCode.OP_CLOSE, lblevel, 0, 0, 0)
        }
        // create jump and link it to the label
        luaK_patchlist(fs, luaK_jump(fs), lb.pc)
    }
}

// Break statement. Semantically equivalent to "goto break".
def private breakstat(var ls : LexState?) {
    let line : int = ls.linenumber
    // skip break
    luaX_next(ls)
    newgotoentry(ls, luaS_newlstr(ls.L, cstr("break"), uint64(typeinfo sizeof(type<uint8[6]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul), line,
            luaK_jump(ls.fs))
}

// Check whether there is already a label with the given 'name'.
[c_function]
def private checkrepeated(var ls : LexState?; var name : TString?) {
    var lb : Labeldesc? = findlabel(ls, name)
    // already defined?
    if (lb != null) {
        var msg : uint8? = cstr("label '%s' already defined on line %d")
        msg = luaO_pushfstring`va(ls.L, msg, (addr(name.contents[0]), lb.line))
        // error
        luaK_semerror(ls, msg)
    }
}

def private labelstat(var ls : LexState?; var name : TString?; line : int) {
    // label -> '::' NAME '::'
    // skip double colon
    checknext(ls, int(RESERVED.TK_DBCOLON))
    while (ls.t.token == ';' || ls.t.token == int(RESERVED.TK_DBCOLON)) {
        // skip other no-op statements
        statement(ls)
    }
    // check for repeated labels
    checkrepeated(ls, name)
    createlabel(ls, name, line, block_follow(ls, 0))
}

[c_function]
def private whilestat(var ls : LexState?; line : int) {
    // whilestat -> WHILE cond DO block END
    var fs : FuncState? = ls.fs
    var whileinit : int
    var condexit : int
    var bl : BlockCnt
    // skip WHILE
    luaX_next(ls)
    whileinit = luaK_getlabel(fs)
    condexit = cond(ls)
    enterblock(fs, addr(bl), 1u8)
    checknext(ls, int(RESERVED.TK_DO))
    _c_block(ls)
    luaK_jumpto(fs, whileinit)
    check_match(ls, int(RESERVED.TK_END), int(RESERVED.TK_WHILE), line)
    leaveblock(fs)
    // false conditions finish the loop
    luaK_patchtohere(fs, condexit)
}

[c_function]
def private repeatstat(var ls : LexState?; line : int) {
    // repeatstat -> REPEAT block UNTIL cond
    var condexit : int
    var fs : FuncState? = ls.fs
    let repeat_init : int = luaK_getlabel(fs)
    var bl1 : BlockCnt
    var bl2 : BlockCnt
    // loop block
    enterblock(fs, addr(bl1), 1u8)
    // scope block
    enterblock(fs, addr(bl2), 0u8)
    // skip REPEAT
    luaX_next(ls)
    statlist(ls)
    check_match(ls, int(RESERVED.TK_UNTIL), int(RESERVED.TK_REPEAT), line)
    // read condition (inside scope block)
    condexit = cond(ls)
    // finish scope
    leaveblock(fs)
    // upvalues?
    if (bl2.upval != 0) {
        // normal exit must jump over fix
        let exit : int = luaK_jump(fs)
        // repetition must close upvalues
        luaK_patchtohere(fs, condexit)
        luaK_codeABCk(fs, OpCode.OP_CLOSE, reglevel(fs, int(bl2.nactvar)), 0, 0, 0)
        // repeat after closing upvalues
        condexit = luaK_jump(fs)
        // normal exit comes to here
        luaK_patchtohere(fs, exit)
    }
    // close the loop
    luaK_patchlist(fs, condexit, repeat_init)
    // finish loop
    leaveblock(fs)
}

// Read an expression and generate code to put its results in next
// stack slot.
[c_function]
def private exp1(var ls : LexState?) {
    var e : expdesc
    expr(ls, addr(e))
    luaK_exp2nextreg(ls.fs, addr(e))
}

// Fix for instruction at position 'pc' to jump to 'dest'.
// (Jump addresses are relative in Lua). 'back' true means
// a back jump.
[c_function]
def private fixforjump(var fs : FuncState?; pc : int; dest : int; back : int) {
    var jmp : uint? = addr(fs.f.code[pc])
    var offset : int = dest - (pc + 1)
    if (back != 0) {
        offset = -offset
    }
    if (offset > MAXARG_Bx) {
        luaX_syntaxerror(fs.ls, cstr("control structure too long"))
    }
    *jmp = (*jmp & MASK0(SIZE_Bx, POS_k)) | ((uint(offset) << uint(POS_k)) & MASK1(SIZE_Bx, POS_k))
}

// Generate code for a 'for' loop.
[c_function]
def private forbody(var ls : LexState?; base : int; line : int; nvars : int; isgen : int) {
    // forbody -> DO block
    var bl : BlockCnt
    var fs : FuncState? = ls.fs
    var prep : int
    var endfor : int
    checknext(ls, int(RESERVED.TK_DO))
    prep = luaK_codeABx(fs, forbody_forprep[isgen], base, 0u)
    // scope for declared variables
    enterblock(fs, addr(bl), 0u8)
    adjustlocalvars(ls, nvars)
    luaK_reserveregs(fs, nvars)
    _c_block(ls)
    // end of scope for declared variables
    leaveblock(fs)
    fixforjump(fs, prep, luaK_getlabel(fs), 0)
    // generic for?
    if (isgen != 0) {
        luaK_codeABCk(fs, OpCode.OP_TFORCALL, base, 0, nvars, 0)
        luaK_fixline(fs, line)
    }
    endfor = luaK_codeABx(fs, forbody_forloop[isgen], base, 0u)
    fixforjump(fs, endfor, prep + 1, 1)
    luaK_fixline(fs, line)
}

def private fornum(var ls : LexState?; var varname : TString?; line : int) {
    // fornum -> NAME = exp,exp[,exp] forbody
    var fs : FuncState? = ls.fs
    let base : int = int(fs.freereg)
    new_localvar(ls, luaX_newstring(ls, cstr("(for state)"), uint64(typeinfo sizeof(type<uint8[12]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
    new_localvar(ls, luaX_newstring(ls, cstr("(for state)"), uint64(typeinfo sizeof(type<uint8[12]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
    new_localvar(ls, luaX_newstring(ls, cstr("(for state)"), uint64(typeinfo sizeof(type<uint8[12]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
    new_localvar(ls, varname)
    checknext(ls, '=')
    // initial value
    exp1(ls)
    checknext(ls, ',')
    // limit
    exp1(ls)
    if (testnext(ls, ',') != 0) {
        // optional step
        exp1(ls)
    } else {
        // default step = 1
        luaK_int(fs, int(fs.freereg), 1l)
        luaK_reserveregs(fs, 1)
    }
    // control variables
    adjustlocalvars(ls, 3)
    forbody(ls, base, line, 1, 0)
}

[c_function]
def private forlist(var ls : LexState?; var indexname : TString?) {
    // forlist -> NAME {,NAME} IN explist forbody
    var fs : FuncState? = ls.fs
    var e : expdesc
    // gen, state, control, toclose, 'indexname'
    var nvars : int = 5
    var line : int
    let base : int = int(fs.freereg)
    // create control variables
    new_localvar(ls, luaX_newstring(ls, cstr("(for state)"), uint64(typeinfo sizeof(type<uint8[12]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
    new_localvar(ls, luaX_newstring(ls, cstr("(for state)"), uint64(typeinfo sizeof(type<uint8[12]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
    new_localvar(ls, luaX_newstring(ls, cstr("(for state)"), uint64(typeinfo sizeof(type<uint8[12]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
    new_localvar(ls, luaX_newstring(ls, cstr("(for state)"), uint64(typeinfo sizeof(type<uint8[12]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul))
    // create declared variables
    new_localvar(ls, indexname)
    while (testnext(ls, ',') != 0) {
        new_localvar(ls, str_checkname(ls))
        nvars++
    }
    checknext(ls, int(RESERVED.TK_IN))
    line = ls.linenumber
    adjust_assign(ls, 4, explist(ls, addr(e)), addr(e))
    // control variables
    adjustlocalvars(ls, 4)
    // last control var. must be closed
    marktobeclosed(fs)
    // extra space to call generator
    luaK_checkstack(fs, 3)
    forbody(ls, base, line, nvars - 4, 1)
}

[c_function]
def private forstat(var ls : LexState?; line : int) {
    // forstat -> FOR (fornum | forlist) END
    var fs : FuncState? = ls.fs
    var varname : TString?
    var bl : BlockCnt
    // scope for loop and control variables
    enterblock(fs, addr(bl), 1u8)
    // skip 'for'
    luaX_next(ls)
    // first variable name
    varname = str_checkname(ls)
    c_switch(ls.t.token) {
        case('=') {
            fornum(ls, varname, line)
            break
        }
        case(',', 267) {
            forlist(ls, varname)
            break
        }
        case(_) {
            luaX_syntaxerror(ls, cstr("'=' or 'in' expected"))
        }
    }
    check_match(ls, int(RESERVED.TK_END), int(RESERVED.TK_FOR), line)
    // loop scope ('break' jumps to this point)
    leaveblock(fs)
}

[c_function]
def private test_then_block(var ls : LexState?; var escapelist : int?) {
    // test_then_block -> [IF | ELSEIF] cond THEN block
    var bl : BlockCnt
    var fs : FuncState? = ls.fs
    var v : expdesc
    // instruction to skip 'then' code (if condition is false)
    var jf : int
    // skip IF or ELSEIF
    luaX_next(ls)
    // read condition
    expr(ls, addr(v))
    checknext(ls, int(RESERVED.TK_THEN))
    // 'if x then break' ?
    if (ls.t.token == int(RESERVED.TK_BREAK)) {
        let line : int = ls.linenumber
        // will jump if condition is true
        luaK_goiffalse(ls.fs, addr(v))
        // skip 'break'
        luaX_next(ls)
        // must enter block before 'goto'
        enterblock(fs, addr(bl), 0u8)
        newgotoentry(ls, luaS_newlstr(ls.L, cstr("break"), uint64(typeinfo sizeof(type<uint8[6]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul), line, v.t)
        // skip semicolons
        while (testnext(ls, ';') != 0) {
        }
        // jump is the entire block?
        if (block_follow(ls, 0) != 0) {
            leaveblock(fs)
            // and that is it
            return
        } else {
            // must skip over 'then' part if condition is false
            jf = luaK_jump(fs)
        }
    } else {
        // regular case (not a break)
        // skip over block if condition is false
        luaK_goiftrue(ls.fs, addr(v))
        enterblock(fs, addr(bl), 0u8)
        jf = v.f
    }
    // 'then' part
    statlist(ls)
    leaveblock(fs)
    if (ls.t.token == int(RESERVED.TK_ELSE) || ls.t.token == int(RESERVED.TK_ELSEIF)) {
        // followed by 'else'/'elseif'?
        // must jump over it
        luaK_concat(fs, escapelist, luaK_jump(fs))
    }
    luaK_patchtohere(fs, jf)
}

[c_function]
def private ifstat(var ls : LexState?; line : int) {
    // ifstat -> IF cond THEN block {ELSEIF cond THEN block} [ELSE block] END
    var fs : FuncState? = ls.fs
    // exit list for finished parts
    var escapelist : int = NO_JUMP
    // IF cond THEN block
    test_then_block(ls, addr(escapelist))
    while (ls.t.token == int(RESERVED.TK_ELSEIF)) {
        // ELSEIF cond THEN block
        test_then_block(ls, addr(escapelist))
    }
    if (testnext(ls, int(RESERVED.TK_ELSE)) != 0) {
        // 'else' part
        _c_block(ls)
    }
    check_match(ls, int(RESERVED.TK_END), int(RESERVED.TK_IF), line)
    // patch escape list to 'if' end
    luaK_patchtohere(fs, escapelist)
}

[c_function]
def private localfunc(var ls : LexState?) {
    var b : expdesc
    var fs : FuncState? = ls.fs
    // function's variable index
    let fvar : int = int(fs.nactvar)
    // new local variable
    new_localvar(ls, str_checkname(ls))
    // enter its scope
    adjustlocalvars(ls, 1)
    // function created in next register
    body(ls, addr(b), 0, ls.linenumber)
    // debug information will only see the variable after this point!
    localdebuginfo(fs, fvar).startpc = fs.pc
}

[c_function]
def private getlocalattribute(var ls : LexState?) : int {
    // ATTRIB -> ['<' Name '>']
    if (testnext(ls, '<') != 0) {
        var attr : uint8? = addr(str_checkname(ls).contents[0])
        checknext(ls, '>')
        if (crt::strcmp(attr, cstr("const")) == 0) {
            // read-only variable
            return RDKCONST
        } elif (crt::strcmp(attr, cstr("close")) == 0) {
            // to-be-closed variable
            return RDKTOCLOSE
        } else {
            luaK_semerror(ls, luaO_pushfstring`va(ls.L, cstr("unknown attribute '%s'"), (attr,)))
        }
    }
    // regular variable
    return VDKREG
}

def private checktoclose(var fs : FuncState?; level : int) {
    // is there a to-be-closed variable?
    if (level != -1) {
        marktobeclosed(fs)
        luaK_codeABCk(fs, OpCode.OP_TBC, reglevel(fs, level), 0, 0, 0)
    }
}

[c_function]
def private localstat(var ls : LexState?) {
    // stat -> LOCAL NAME ATTRIB { ',' NAME ATTRIB } ['=' explist]
    var fs : FuncState? = ls.fs
    // index of to-be-closed variable (if any)
    var toclose : int = -1
    // last variable
    var _c_var : Vardesc?
    // index and kind of last variable
    var vidx : int
    var kind : int
    var nvars : int = 0
    var nexps : int
    var e : expdesc
    c_do_while(testnext(ls, ',') != 0) {
        vidx = new_localvar(ls, str_checkname(ls))
        kind = getlocalattribute(ls)
        getlocalvardesc(fs, vidx).vd.kind = uint8(kind)
        // to-be-closed?
        if (kind == RDKTOCLOSE) {
            // one already present?
            if (toclose != -1) {
                luaK_semerror(ls, cstr("multiple to-be-closed variables in local list"))
            }
            toclose = int(fs.nactvar) + nvars
        }
        nvars++
    }
    if (testnext(ls, '=') != 0) {
        nexps = explist(ls, addr(e))
    } else {
        e.k = expkind.VVOID
        nexps = 0
    }
    // get last variable
    _c_var = getlocalvardesc(fs, vidx)
    // no adjustments?
    if (nvars == nexps && int(_c_var.vd.kind) == RDKCONST && luaK_exp2const(fs, addr(e), addr(_c_var.k)) != 0) {
        // last variable is const?
        // compile-time constant?
        // variable is a compile-time constant
        _c_var.vd.kind = uint8(RDKCTC)
        // exclude last variable
        adjustlocalvars(ls, nvars - 1)
        // but count it
        fs.nactvar = uint8(uint(fs.nactvar) + 1)
    } else {
        adjust_assign(ls, nvars, nexps, addr(e))
        adjustlocalvars(ls, nvars)
    }
    checktoclose(fs, toclose)
}

def private funcname(var ls : LexState?; var v : expdesc?) : int {
    // funcname -> NAME {fieldsel} [':' NAME]
    var ismethod : int = 0
    singlevar(ls, v)
    while (ls.t.token == '.') {
        fieldsel(ls, v)
    }
    if (ls.t.token == ':') {
        ismethod = 1
        fieldsel(ls, v)
    }
    return ismethod
}

[c_function]
def private funcstat(var ls : LexState?; line : int) {
    // funcstat -> FUNCTION funcname body
    var ismethod : int
    var v : expdesc
    var b : expdesc
    // skip FUNCTION
    luaX_next(ls)
    ismethod = funcname(ls, addr(v))
    body(ls, addr(b), ismethod, line)
    check_readonly(ls, addr(v))
    luaK_storevar(ls.fs, addr(v), addr(b))
    // definition "happens" in the first line
    luaK_fixline(ls.fs, line)
}

[c_function]
def private exprstat(var ls : LexState?) {
    // stat -> func | assignment
    var fs : FuncState? = ls.fs
    var v : LHS_assign
    suffixedexp(ls, addr(v.v))
    // stat -> assignment ?
    if (ls.t.token == '=' || ls.t.token == ',') {
        v.prev = null
        restassign(ls, addr(v), 1)
    } else {
        // stat -> func
        var inst : uint?
        if (!(v.v.k == expkind.VCALL)) {
            luaX_syntaxerror(ls, cstr("syntax error"))
        }
        inst = addr(fs.f.code[addr(v.v).u.info])
        // call statement uses no results
        *inst = (*inst & ~(~(~0u << uint(SIZE_C)) << uint(POS_C))) | ((1u << uint(POS_C)) & (~(~0u << uint(SIZE_C)) << uint(POS_C)))
    }
}

[c_function]
def private retstat(var ls : LexState?) {
    // stat -> RETURN [explist] [';']
    var fs : FuncState? = ls.fs
    var e : expdesc
    // number of values being returned
    var nret : int
    // first slot to be returned
    var first : int = __::luaY_nvarstack(fs)
    if (block_follow(ls, 1) != 0 || ls.t.token == ';') {
        // return no values
        nret = 0
    } else {
        // optional return values
        nret = explist(ls, addr(e))
        if (hasmultret(e.k)) {
            luaK_setreturns(fs, addr(e), LUA_MULTRET)
            // tail call?
            if (e.k == expkind.VCALL && nret == 1 && fs.bl.insidetbc == 0) {
                fs.f.code[addr(e).u.info] = (fs.f.code[addr(e).u.info] &
                        ~(~(~0u << uint(SIZE_OP)) << uint(POS_OP))) | ((uint(OpCode.OP_TAILCALL) << uint(POS_OP)) & (~(~0u << uint(SIZE_OP)) << uint(POS_OP)))
            }
            // return all values
            nret = LUA_MULTRET
        } else {
            // only one single value?
            if (nret == 1) {
                // can use original slot
                first = luaK_exp2anyreg(fs, addr(e))
            } else {
                // values must go to the top of the stack
                luaK_exp2nextreg(fs, addr(e))
            }
        }
    }
    luaK_ret(fs, first, nret)
    // skip optional semicolon
    testnext(ls, ';')
}

def private statement(var ls : LexState?) {
    // may be needed for error messages
    let line : int = ls.linenumber
    enterlevel(ls)
    c_switch(ls.t.token) {
        case(';') {
            // stat -> ';' (empty statement)
            // skip ';'
            luaX_next(ls)
            break
        }
        case(266) {
            // stat -> ifstat
            ifstat(ls, line)
            break
        }
        case(277) {
            // stat -> whilestat
            whilestat(ls, line)
            break
        }
        case(258) {
            // stat -> DO block END
            // skip DO
            luaX_next(ls)
            _c_block(ls)
            check_match(ls, int(RESERVED.TK_END), int(RESERVED.TK_DO), line)
            break
        }
        case(263) {
            // stat -> forstat
            forstat(ls, line)
            break
        }
        case(272) {
            // stat -> repeatstat
            repeatstat(ls, line)
            break
        }
        case(264) {
            // stat -> funcstat
            funcstat(ls, line)
            break
        }
        case(268) {
            // stat -> localstat
            // skip LOCAL
            luaX_next(ls)
            // local function?
            if (testnext(ls, int(RESERVED.TK_FUNCTION)) != 0) {
                localfunc(ls)
            } else {
                localstat(ls)
            }
            break
        }
        case(287) {
            // stat -> label
            // skip double colon
            luaX_next(ls)
            labelstat(ls, str_checkname(ls), line)
            break
        }
        case(273) {
            // stat -> retstat
            // skip RETURN
            luaX_next(ls)
            retstat(ls)
            break
        }
        case(257) {
            // stat -> breakstat
            breakstat(ls)
            break
        }
        case(265) {
            // stat -> 'goto' NAME
            // skip 'goto'
            luaX_next(ls)
            gotostat(ls)
            break
        }
        case(_) {
            // stat -> func | assignment
            exprstat(ls)
            break
        }
    }
    // free registers
    ls.fs.freereg = uint8(__::luaY_nvarstack(ls.fs))
    leavelevel(ls)
}

// compiles the main function, which is a regular vararg function with an
// upvalue named LUA_ENV
[c_function]
def private mainfunc(var ls : LexState?; var fs : FuncState?) {
    var bl : BlockCnt
    var env : Upvaldesc?
    open_func(ls, fs, addr(bl))
    // main function is always declared vararg
    setvararg(fs, 0)
    // ...set environment upvalue
    env = allocupvalue(fs)
    env.instack = 1u8
    env.idx = 0u8
    env.kind = uint8(VDKREG)
    env.name = ls.envn
    if (isblack(fs.f) != 0 && iswhite(env.name) != 0) {
        luaC_barrier_(ls.L, obj2gco(fs.f), obj2gco(env.name))
    }
    // read first token
    luaX_next(ls)
    // parse main body
    statlist(ls)
    check(ls, int(RESERVED.TK_EOS))
    close_func(ls)
}

[c_function]
def luaY_parser(var L : lua_State?; var z : Zio?; var buff : Mbuffer?; var dyd : Dyndata?; var name : uint8?; firstchar : int) : LClosure? {
    var lexstate : LexState
    var funcstate : FuncState
    // create main closure
    var cl : LClosure? = luaF_newLclosure(L, 1)
    {
        // anchor it (to avoid being collected)
        var io : TValue? = s2v(L.top.p)
        var x_ : LClosure? = cl
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(LUA_TFUNCTION | (0 << 4)))
    }
    luaD_inctop(L)
    // create table for scanner
    lexstate.h = luaH_new(L)
    {
        // anchor it
        var io : TValue? = s2v(L.top.p)
        var x_ : Table? = lexstate.h
        io.value_.gc = obj2gco(x_)
        settt_(io, ctb(LUA_TTABLE | (0 << 4)))
    }
    luaD_inctop(L)
    cl.p = luaF_newproto(L)
    funcstate.f = cl.p
    if (isblack(cl) != 0 && iswhite(cl.p) != 0) {
        luaC_barrier_(L, obj2gco(cl), obj2gco(cl.p))
    }
    // create and anchor TString
    funcstate.f.source = luaS_new(L, name)
    if (isblack(funcstate.f) != 0 && iswhite(funcstate.f.source) != 0) {
        luaC_barrier_(L, obj2gco(funcstate.f), obj2gco(funcstate.f.source))
    }
    lexstate.buff = buff
    lexstate.dyd = dyd
    dyd._c_label.n = 0
    dyd.gt.n = dyd._c_label.n
    dyd.actvar.n = dyd.gt.n
    luaX_setinput(L, addr(lexstate), z, funcstate.f.source, firstchar)
    mainfunc(addr(lexstate), addr(funcstate))
    // all scopes should be correctly finished
    // remove scanner's table
    L.top.p--
    // closure is on the stack, too
    return cl
}

[init]
def private c2das_late_bind {
    luaY_nvarstack_slot = @@__::luaY_nvarstack
    luaY_parser_slot = @@__::luaY_parser
}

