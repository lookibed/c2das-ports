                    label 1:  // read_save
                    next_m(ls)
                    label 2:  // only_save
                    // go through
                    // remove '\\'
                    luaZ_buffremove(ls.buff, 1)
                    save(ls, c)
                    label 3:  // no_save
                    // go through
                    break
