            }
            case(_) {
                save_and_next(ls)
            }
        }
    }
    // skip delimiter
    save_and_next(ls)
    seminfo.ts = luaX_newstring(ls, luaZ_buffer(ls.buff) + 1, luaZ_bufflen(ls.buff) - 2ul)
