[c_function]
def private read_string(var ls : LexState?; del : int; var seminfo : SemInfo?) {
    // keep delimiter (for error messages)
    save_and_next(ls)
    while (ls.current != del) {
        c_switch(ls.current) {
            case(-1) {
                lexerror(ls, cstr("unfinished string"), int(RESERVED.TK_EOS))
                // to avoid warnings
                break
            }
            case('\n', '\r') {
                lexerror(ls, cstr("unfinished string"), int(RESERVED.TK_STRING))
                // to avoid warnings
                break
            }
            case('\\') {
                {
                    // escape sequences
                    // final character to be saved
                    var c : int
                    // keep '\\' for error messages
                    save_and_next(ls)
                    c_switch(ls.current) {
                        case('a') {
                            c = '\a'
                            goto label 1
                        }
                        case('b') {
                            c = '\b'
                            goto label 1
                        }
                        case('f') {
                            c = '\f'
                            goto label 1
                        }
                        case('n') {
                            c = '\n'
                            goto label 1
                        }
                        case('r') {
                            c = '\r'
                            goto label 1
                        }
                        case('t') {
                            c = '\t'
                            goto label 1
                        }
                        case('v') {
                            c = '\v'
                            goto label 1
                        }
                        case('x') {
                            c = readhexaesc(ls)
                            goto label 1
                        }
                        case('u') {
                            utf8esc(ls)
                            goto label 3
                        }
                        case('\n', '\r') {
                            inclinenumber(ls)
                            c = '\n'
                            goto label 2
                        }
                        case('\\', '"', '\'') {
                            c = ls.current
                            goto label 1
                        }
                        case(-1) {
                            // will raise an error next loop
                            goto label 3
                        }
                        case('z') {
