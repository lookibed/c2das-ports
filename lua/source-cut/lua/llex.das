                            // remove '\\'
                            luaZ_buffremove(ls.buff, 1)
                            // skip the 'z'
                            next_m(ls)
                            while (lisspace(ls.current) != 0) {
                                if (currIsNewline(ls)) {
                                    inclinenumber(ls)
                                } else {
                                    next_m(ls)
                                }
                            }
                            goto label 3
