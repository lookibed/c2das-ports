                    // skip 2nd ']'
                    save_and_next(ls)
                    goto label 1
                }
                break
            }
            case('\n', '\r') {
                save(ls, '\n')
                inclinenumber(ls)
                // avoid wasting space
                if (seminfo == null) {
                    luaZ_resetbuffer(ls.buff)
                }
                break
            }
            case(_) {
                if (seminfo != null) {
                    save_and_next(ls)
                } else {
                    next_m(ls)
                }
            }
        }
    }
    label 1:  // endloop
    if (seminfo != null) {
        seminfo.ts = luaX_newstring(ls, luaZ_buffer(ls.buff) + sep, luaZ_bufflen(ls.buff) - 2ul * sep)
