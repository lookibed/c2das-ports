def private readdecesc(var ls : LexState?) : int {
    var i : int
    // result accumulator
    var r : int = 0
    // read up to 3 digits
    i = 0
    while (i < 3 && lisdigit(ls.current) != 0) {
        r = 10 * r + ls.current - '0'
        save_and_next(ls)
        i++
