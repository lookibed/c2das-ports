        // skip it
        inclinenumber(ls)
    }
    while (true) {
        c_switch(ls.current) {
            case(-1) {
                {
                    // error
                    var what : uint8? = seminfo != null ? cstr("string") : cstr("comment")
                    var msg : uint8? = luaO_pushfstring`va(ls.L, cstr("unfinished long %s (starting at line %d)"), (what, line))
                    lexerror(ls, msg, int(RESERVED.TK_EOS))
                    // to avoid warnings
                    break
