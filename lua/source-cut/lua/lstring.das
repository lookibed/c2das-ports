def private growstrtab(var L : lua_State?; var tb : stringtable?) {
    // too many strings?
    if (tb.nuse == 2147483647) {
        // try to free some...
        luaC_fullgc(L, 1)
        // still too many?
        if (tb.nuse == 2147483647) {
            // cannot even create a message...
            luaD_throw(L, 4)
        }
