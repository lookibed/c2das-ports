    // can grow string table?
    if (tb.size <= int(uint64(2147483647) <= ~uint64(0) / uint64(typeinfo sizeof(type<TString?>)) ? uint(2147483647) : uint(~uint64(0) / uint64(typeinfo sizeof(type<TString?>)))) / 2) {
        luaS_resize(L, tb.size * 2)
