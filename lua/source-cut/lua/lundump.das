[c_function]
def private loadProtos(var S : LoadState?; var f : Proto?) {
    var i : int
    var n : int = loadInt(S)
    if (uint64(typeinfo sizeof(type<int>)) >= uint64(typeinfo sizeof(type<uint64>)) && uint64(n) + uint64(1) > ~uint64(0) / uint64(typeinfo sizeof(type<Proto?>))) {
