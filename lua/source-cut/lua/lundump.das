// generated by c2das - regenerate, never edit
options gen2
options indenting = 4
options stack = 8388608
require c_runtime/c_function
require c_runtime/variadic
require crt
require ldo
require lfunc
require lgc
require lmem
require lobject
require lobject_h_cluster
require lstring
require lua_link
require lzio
require lzio_h

struct LoadState {
    L : lua_State?
    Z : Zio?
    name : uint8?
}

[init]
def private c2das_layout_check {
    static_assert(typeinfo sizeof(type<LoadState>) == 24 && typeinfo alignof(type<LoadState>) == 8, "LoadState: clang lays it out as size 24, align 8")
    static_assert(typeinfo offsetof < L > (type<LoadState>) == 0, "LoadState.L: clang puts it at 0")
    static_assert(typeinfo offsetof < Z > (type<LoadState>) == 8, "LoadState.Z: clang puts it at 8")
    static_assert(typeinfo offsetof < name > (type<LoadState>) == 16, "LoadState.name: clang puts it at 16")
}

let private LUA_ERRSYNTAX = 3
let private EOZ = -1
let private MAX_SIZET = ~uint64(0)
let private LUAI_MAXSHORTLEN = 40
let private LUAC_VERSION = 504 / 100 * 16 + 504 % 100
let private LUAC_FORMAT = 0
let private LUAC_INT = 22136

[c_function]
def private error(var S : LoadState?; var why : uint8?) {
    luaO_pushfstring`va(S.L, reinterpret<uint8?>("%s: bad binary format (%s)"), (S.name, why))
    ldo::luaD_throw(S.L, LUA_ERRSYNTAX)
}

[c_function]
def private loadBlock(var S : LoadState?; var b : void?; size : uint64) {
    if (luaZ_read(S.Z, b, size) != uint64(0)) {
        error(S, reinterpret<uint8?>("truncated chunk"))
    }
}

[c_function]
def private loadByte(var S : LoadState?) : uint8 {
    let _t0 = S.Z.n
    S.Z.n--
    var _t2 : int
    if (_t0 > uint64(0)) {
        var _t1 = S.Z.p
        S.Z.p = S.Z.p + 1
        _t2 = int(uint8(deref(_t1)))
    } else {
        _t2 = luaZ_fill(S.Z)
    }
    var b : int = _t2
    if (b == EOZ) {
        error(S, reinterpret<uint8?>("truncated chunk"))
    }
    return uint8(b)
}

[c_function]
def private loadUnsigned(var S : LoadState?; var limit : uint64) : uint64 {
    var x : uint64 = uint64(0)
    var b : int
    limit >>= 7ul
    var _first = true
    while (_first || (b & 128) == 0) {
        _first = false
        b = int(loadByte(S))
        if (x >= limit) {
            error(S, reinterpret<uint8?>("integer overflow"))
        }
        x = x << 7ul | uint64(b & 127)
    }
    return x
}

def private loadSize(var S : LoadState?) : uint64 {
    return loadUnsigned(S, MAX_SIZET)
}

def private loadInt(var S : LoadState?) : int {
    return int(loadUnsigned(S, uint64(2147483647)))
}

[c_function]
def private loadNumber(var S : LoadState?) : double {
    var x : double
    loadBlock(S, reinterpret<void?>(addr(x)), uint64(1) * uint64(typeinfo sizeof(type<double>)))
    return x
