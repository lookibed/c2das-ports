            var io2 : TValue? = func
            io1.value_ = io2.value_
            io1.tt_ = io2.tt_
        }
        {
            L.top.p = L.top.p + 1
        }
    }
    if (crt::strchr(what, 'L') != null) {
        collectvalidlines(L, cl)
    }
