        res = crt::isdigit(c)
    } elif (_cond == 'g') {
        res = crt::isgraph(c)
    } elif (_cond == 'l') {
        res = crt::islower(c)
    } elif (_cond == 'p') {
        res = crt::ispunct(c)
    } elif (_cond == 's') {
        res = crt::isspace(c)
    } elif (_cond == 'u') {
        res = crt::isupper(c)
    } elif (_cond == 'w') {
        res = crt::isalnum(c)
    } elif (_cond == 'x') {
        res = crt::isxdigit(c)
    } elif (_cond == 'z') {
        // deprecated option
        res = c == 0 ? 1 : 0
    } else {
        return cl == c ? 1 : 0
    }
    return crt::islower(cl) != 0 ? res : (!(res != 0) ? 1 : 0)
}

