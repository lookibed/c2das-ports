    } else {
        // decimal
        while ((int(luai_ctype_[int(*s) + 1]) & (1 << DIGITBIT)) != 0) {
            var d : int = int(*s) - '0'
            // overflow?
            if (a >= MAXBY10 && (a > MAXBY10 || d > MAXLASTD + neg)) {
                // do not accept it (as integer)
                return null
