            a = a * 10ul + uint64(d)
            empty = 0
            s++
        }
    }
    // skip trailing spaces
    while ((int(luai_ctype_[int(*s) + 1]) & (1 << SPACEBIT)) != 0) {
        s++
    }
    // something wrong in the numeral
    if (empty != 0 || *s != '\0') {
        return null
    } else {
        *result = int64(neg != 0 ? uint64(0u) - a : a)
        return s
    }
}

