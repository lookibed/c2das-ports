    // nothing recognized?
    if (intptr(endptr) == intptr(reinterpret<uint8?>(s))) {
        return null
    }
    // skip trailing spaces
    while ((int(luai_ctype_[int(*endptr) + 1]) & (1 << SPACEBIT)) != 0) {
        endptr++
    }
    // OK iff no trailing chars
    return (*endptr == '\0') ? endptr : null
}

// Convert string 's' to a Lua number (put in 'result') handling the
// current locale.
// This function accepts both the current locale or a dot as the radix
// mark. If the conversion fails, it may mean number has a dot but
// locale accepts something else. In that case, the code copies 's'
// to a buffer (because 's' is read-only), changes the dot to the
// current locale radix mark, and tries to convert again.
// The variable 'mode' checks for special characters in the string:
// - 'n' means 'inf' or 'nan' (which should be rejected)
// - 'x' means a hexadecimal numeral
// - '.' just optimizes the search for the common case (no special chars)
[c_function]
def private l_str2d(var s : uint8?; var result : double?) : uint8? {
    var endptr : uint8?
    // look for special chars
    var pmode : uint8? = crt::strpbrk(s, cstr(".xXnN"))
    var mode : int = pmode != null ? (int(*pmode) | ('A' ^ 'a')) : 0
    // reject 'inf' and 'nan'
    if (mode == 'n') {
        return null
    }
    // try to convert
    endptr = l_str2dloc(s, result, mode)
    // failed? may be a different locale
    if (endptr == null) {
        var buff : uint8[201]
        var pdot : uint8? = crt::strchr(s, '.')
        if (pdot == null || crt::strlen(s) > uint64(L_MAXLENNUM)) {
            // string too long or no dot; fail
            return null
        }
        // copy string to buffer
        crt::strcpy(addr(buff[0]), s)
        // correct decimal point
        buff[int64(pdot - s)] = reinterpret<lconv?>(crt::localeconv()).decimal_point[0]
        // try again
        endptr = l_str2dloc(addr(buff[0]), result, mode)
        if (endptr != null) {
            // make relative to 's'
            endptr = s + int64(endptr - addr(buff[0]))
        }
    }
    return endptr
}

