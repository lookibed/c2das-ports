// Computes ceil(log2(x))
def luaO_ceillog2(var x : uint) : int {
    // log_2[i] = ceil(log2(i - 1))
    var l : int = 0
    x--
    while (x >= 256u) {
        l += 8
        x >>= 8u
    }
    return l + int(luaO_ceillog2_log_2[x])
}

