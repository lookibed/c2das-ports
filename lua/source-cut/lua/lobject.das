def private l_str2int(var s : uint8?; var result : int64?) : uint8? {
    var a : uint64 = 0ul
    var empty : int = 1
    var neg : int
    // skip initial spaces
    while ((int(luai_ctype_[int(*s) + 1]) & (1 << SPACEBIT)) != 0) {
        s++
    }
    neg = isneg(addr(s))
    if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
        // hex?
        // skip '0x'
        s += 2
        while ((int(luai_ctype_[int(*s) + 1]) & (1 << XDIGITBIT)) != 0) {
            a = a * 16ul + uint64(luaO_hexavalue(int(*s)))
            empty = 0
            s++
