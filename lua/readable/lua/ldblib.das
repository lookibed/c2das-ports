    if (lua_isnoneornil(L, arg + 1)) {
        lua_settop(L, arg + 1)
        // turn off hooks
        func = default<function<(var a0 : lua_State?; var a1 : lua_Debug?) : void>>
        mask = 0
        count = 0
    } else {
        var smask : uint8? = luaL_checkstring(L, arg + 2)
        luaL_checktype(L, arg + 1, LUA_TFUNCTION)
        count = int(luaL_optinteger(L, arg + 3, 0l))
        func = @@hookf
        mask = makemask(smask, count)
    }
    if (luaL_getsubtable(L, LUA_REGISTRYINDEX, HOOKKEY) == 0) {
        // table just created; initialize it
        lua_pushstring(L, cstr("k"))
        // hooktable.__mode = "k"
        lua_setfield(L, -2, cstr("__mode"))
        lua_pushvalue(L, -1)
        // metatable(hooktable) = hooktable
        lua_setmetatable(L, -2)
    }
    checkstack(L, L1, 1)
    // key (thread)
    lua_pushthread(L1)
    lua_xmove(L1, L, 1)
    // value (hook function)
    lua_pushvalue(L, arg + 1)
    // hooktable[L1] = new Lua hook
    lua_rawset(L, -3)
    lua_sethook(L1, func, mask, count)
    return 0
}

[c_function]
def private db_gethook(var L : lua_State?) : int {
    var arg : int
    var L1 : lua_State? = getthread(L, addr(arg))
    var buff : uint8[5]
    let mask : int = lua_gethookmask(L1)
    var hook : function<(var a0 : lua_State?; var a1 : lua_Debug?) : void> = lua_gethook(L1)
    // no hook?
