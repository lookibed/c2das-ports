        luaL_pushfail(L)
        return 1
    } elif (hook != @@hookf) {
        // external hook?
        lua_pushstring(L, cstr("external hook"))
    } else {
        // hook table must exist
        lua_getfield(L, LUA_REGISTRYINDEX, HOOKKEY)
        checkstack(L, L1, 1)
        lua_pushthread(L1)
        lua_xmove(L1, L, 1)
        // 1st result = hooktable[L1]
        lua_rawget(L, -2)
        // remove hook table
        lua_remove(L, -2)
    }
    // 2nd result = mask
    lua_pushstring(L, unmakemask(mask, addr(buff[0])))
    // 3rd result = count
    lua_pushinteger(L, int64(lua_gethookcount(L1)))
    return 3
}

[c_function]
def private db_debug(var L : lua_State?) : int {
    while (true) {
        var buffer : uint8[250]
        fprintf(crt::c_stderr(), cstr("%s"), cstr("lua_debug> "))
        crt::fflush(crt::c_stderr())
        if (crt::fgets(addr(buffer[0]), typeinfo sizeof(type<uint8[250]>), crt::c_stdin()) == null || crt::strcmp(addr(buffer[0]), cstr("cont\n")) == 0) {
            return 0
        }
        if (luaL_loadbufferx(L, addr(buffer[0]), crt::strlen(addr(buffer[0])), cstr("=(debug command)"), null) != 0 || lua_pcall(L, 0, 0, 0) != 0) {
            fprintf(crt::c_stderr(), cstr("%s\n"), luaL_tolstring(L, -1, null))
            crt::fflush(crt::c_stderr())
        }
        // remove eventual returns
        lua_settop(L, 0)
    }
    return 0
}

[c_function]
