// fill a closure with new closed upvalues
[c_function]
def luaF_initupvals(var L : lua_State?; var cl : LClosure?) {
    var i : int
    i = 0
    while (i < int(cl.nupvalues)) {
        var o : GCObject? = luaC_newobj(L, LUA_VUPVAL, uint64(typeinfo sizeof(type<UpVal>)))
        var uv : UpVal? = gco2upv(o)
        // make it closed
        uv.v.p = addr(uv.u.value)
        setnilvalue(uv.v.p)
        addr(cl.upvals[0])[i] = uv
        luaC_objbarrier(L, cl, uv)
        i++
    }
}

// Create a new upvalue at the given level, and link it to the list of
// open upvalues of 'L' after entry 'prev'.
[c_function]
def private newupval(var L : lua_State?; var level : StackValue?; var prev : UpVal ??) : UpVal? {
    var o : GCObject? = luaC_newobj(L, LUA_VUPVAL, uint64(typeinfo sizeof(type<UpVal>)))
    var uv : UpVal? = gco2upv(o)
    var next : UpVal? = *prev
    // current value lives in the stack
    uv.v.p = s2v(level)
    // link it to list of open upvalues
    uv.u.open.next = next
    uv.u.open.previous = prev
    if (next != null) {
        next.u.open.previous = addr(uv.u.open.next)
    }
    *prev = uv
    // thread not in list of threads with upvalues?
    if (!(L.twups != L)) {
        // link it to the list
        L.twups = G(L).twups
        G(L).twups = L
    }
    return uv
}

// Find and reuse, or create if it does not exist, an upvalue
// at the given level.
[c_function]
def luaF_findupval(var L : lua_State?; var level : StackValue?) : UpVal? {
    var pp : UpVal ?? = addr(L.openupval)
    var p : UpVal?
    // search for it
    while (true) {
        p = *pp
        if (!(p != null && reinterpret<uint64>(p.v.p) >= reinterpret<uint64>(level))) {
            break
        }
        // corresponding upvalue?
        if (reinterpret<StackValue?>(p.v.p) == level) {
            // return it
            return p
        }
        pp = addr(p.u.open.next)
    }
    // not found: create a new upvalue after 'pp'
    return newupval(L, level, pp)
}

// Call closing method for object 'obj' with error message 'err'. The
// boolean 'yy' controls whether the call is yieldable.
// (This function assumes EXTRA_STACK.)
[c_function]
def private callclosemethod(var L : lua_State?; var obj : TValue?; var err : TValue?; yy : int) {
    var top : StackValue? = L.top.p
    var tm : TValue? = luaT_gettmbyobj(L, obj, TMS.TM_CLOSE)
    {
        // will call metamethod...
        var io1 : TValue? = s2v(top)
        var io2 : TValue? = tm
        io1.value_ = io2.value_
        settt_(io1, io2.tt_)
    }
    {
        // with 'self' as the 1st argument
        var io1 : TValue? = s2v(top + 1)
        var io2 : TValue? = obj
        io1.value_ = io2.value_
        settt_(io1, io2.tt_)
    }
    {
        // and error msg. as 2nd argument
        var io1 : TValue? = s2v(top + 2)
        var io2 : TValue? = err
        io1.value_ = io2.value_
        settt_(io1, io2.tt_)
    }
    // add function and arguments
    L.top.p = top + 3
    if (yy != 0) {
        luaD_call(L, top, 0)
    } else {
        luaD_callnoyield(L, top, 0)
    }
}

// Check whether object at given level has a close metamethod and raise
// an error if not.
[c_function]
def private checkclosemth(var L : lua_State?; var level : StackValue?) {
    var tm : TValue? = luaT_gettmbyobj(L, s2v(level), TMS.TM_CLOSE)
    // no metamethod?
    if (ttisnil(tm)) {
        // variable index
        let idx : int = int(int64(level - L.ci.func.p))
        var vname : uint8? = luaG_findlocal(L, L.ci, idx, null)
        if (vname == null) {
            vname = cstr("?")
        }
        luaG_runerror`va(L, cstr("variable '%s' got a non-closable value"), (vname,))
    }
}

// Prepare and call a closing method.
// If status is CLOSEKTOP, the call to the closing method will be pushed
// at the top of the stack. Otherwise, values can be pushed right after
// the 'level' of the upvalue being closed, as everything after that
// won't be used again.
[c_function]
def private prepcallclosemth(var L : lua_State?; var level : StackValue?; status : int; yy : int) {
    // value being closed
    var uv : TValue? = s2v(level)
    var errobj : TValue?
    if (status == CLOSEKTOP) {
        // error object is nil
        errobj = addr(G(L).nilvalue)
    } else {
        // 'luaD_seterrorobj' will set top to level + 2
        // error object goes after 'uv'
        errobj = s2v(level + 1)
        // set error object
        luaD_seterrorobj(L, status, level + 1)
    }
    callclosemethod(L, uv, errobj, yy)
}

// Insert a variable in the list of to-be-closed variables.
[c_function]
def luaF_newtbcupval(var L : lua_State?; var level : StackValue?) {
    if (ttisfalse(s2v(level)) || ttisnil(s2v(level))) {
        // false doesn't need to be closed
        return
    }
    // value must have a close method
    checkclosemth(L, level)
    while (uint64(uint(int64(level - L.tbclist.p))) > MAXDELTA) {
        // create a dummy node at maximum delta
        L.tbclist.p += MAXDELTA
        L.tbclist.p.tbclist.delta = uint16(0)
    }
    level.tbclist.delta = uint16(int64(level - L.tbclist.p))
    L.tbclist.p = level
}

[c_function]
def luaF_unlinkupval(var uv : UpVal?) {
    *uv.u.open.previous = uv.u.open.next
    if (uv.u.open.next != null) {
        uv.u.open.next.u.open.previous = uv.u.open.previous
    }
}

// Close all upvalues up to the given stack level.
[c_function]
def luaF_closeupval(var L : lua_State?; var level : StackValue?) {
    var uv : UpVal?
    // stack index pointed by 'uv'
    var upl : StackValue?
    while (true) {
        uv = L.openupval
        var _t0 = uv != null
        if (_t0) {
            upl = uplevel(uv)
            _t0 = reinterpret<uint64>(upl) >= reinterpret<uint64>(level)
        }
        if (!(_t0)) {
            break
        }
        // new position for value
        var slot : TValue? = addr(uv.u.value)
        // remove upvalue from 'openupval' list
        luaF_unlinkupval(uv)
        {
            // move value to upvalue slot
            var io1 : TValue? = slot
            var io2 : TValue? = uv.v.p
            io1.value_ = io2.value_
            settt_(io1, io2.tt_)
        }
        // now current value lives here
        uv.v.p = slot
        // neither white nor dead?
        if (iswhite(uv) == 0) {
            // closed upvalues cannot be gray
            nw2black(uv)
            luaC_barrier(L, uv, slot)
        }
    }
}

// Remove first element from the tbclist plus its dummy nodes.
[c_function]
def private poptbclist(var L : lua_State?) {
    var tbc : StackValue? = L.tbclist.p
    // first element cannot be dummy
    tbc -= int(tbc.tbclist.delta)
    while (reinterpret<uint64>(tbc) > reinterpret<uint64>(L.stack.p) && tbc.tbclist.delta == 0) {
        // remove dummy nodes
        tbc -= MAXDELTA
    }
    L.tbclist.p = tbc
}

// Close all upvalues and to-be-closed variables up to the given stack
// level. Return restored 'level'.
[c_function]
def luaF_close(var L : lua_State?; var level : StackValue?; status : int; yy : int) : StackValue? {
    let levelrel : int64 = savestack(L, level)
    // first, close the upvalues
    luaF_closeupval(L, level)
    // traverse tbc's down to that level
    while (reinterpret<uint64>(L.tbclist.p) >= reinterpret<uint64>(level)) {
        // get variable index
        var tbc : StackValue? = L.tbclist.p
        // remove it from list
        poptbclist(L)
        // close variable
        prepcallclosemth(L, tbc, status, yy)
        level = restorestack(L, levelrel)
    }
    return level
}

def luaF_newproto(var L : lua_State?) : Proto? {
    var o : GCObject? = luaC_newobj(L, LUA_VPROTO, uint64(typeinfo sizeof(type<Proto>)))
    var f : Proto? = gco2p(o)
    f.k = null
    f.sizek = 0
    f.p = null
    f.sizep = 0
    f.code = null
    f.sizecode = 0
    f.lineinfo = null
    f.sizelineinfo = 0
    f.abslineinfo = null
    f.sizeabslineinfo = 0
    f.upvalues = null
    f.sizeupvalues = 0
    f.numparams = 0u8
    f.is_vararg = 0u8
    f.maxstacksize = 0u8
    f.locvars = null
    f.sizelocvars = 0
    f.linedefined = 0
    f.lastlinedefined = 0
    f.source = null
    return f
}

[c_function]
def luaF_freeproto(var L : lua_State?; var f : Proto?) {
    luaM_free_(L, reinterpret<void?>(f.code), uint64(f.sizecode) * uint64(typeinfo sizeof(type<uint>)))
    luaM_free_(L, reinterpret<void?>(f.p), uint64(f.sizep) * uint64(typeinfo sizeof(type<Proto?>)))
    luaM_free_(L, reinterpret<void?>(f.k), uint64(f.sizek) * uint64(typeinfo sizeof(type<TValue>)))
    luaM_free_(L, reinterpret<void?>(f.lineinfo), uint64(f.sizelineinfo) * uint64(typeinfo sizeof(type<int8>)))
    luaM_free_(L, reinterpret<void?>(f.abslineinfo), uint64(f.sizeabslineinfo) * uint64(typeinfo sizeof(type<AbsLineInfo>)))
    luaM_free_(L, reinterpret<void?>(f.locvars), uint64(f.sizelocvars) * uint64(typeinfo sizeof(type<LocVar>)))
    luaM_free_(L, reinterpret<void?>(f.upvalues), uint64(f.sizeupvalues) * uint64(typeinfo sizeof(type<Upvaldesc>)))
    luaM_free_(L, reinterpret<void?>(f), uint64(typeinfo sizeof(type<Proto>)))
}

// Look for n-th local variable at line 'line' in function 'func'.
// Returns NULL if not found.
[c_function]
def luaF_getlocalname(var f : Proto?; var local_number : int; pc : int) : uint8? {
    var i : int
    i = 0
    while (i < f.sizelocvars && f.locvars[i].startpc <= pc) {
        // is variable active?
        if (pc < f.locvars[i].endpc) {
            local_number--
            if (local_number == 0) {
                return addr(f.locvars[i].varname.contents[0])
            }
        }
        i++
    }
    // not found
    return null
}

