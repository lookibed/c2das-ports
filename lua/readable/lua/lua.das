// generated by c2das - regenerate, never edit
options gen2
options indenting = 4
options solid_context
options stack = 8388608
options strict_aliasing = false
options jit_split_modules = 0
require c_runtime/c_args
require c_runtime/c_function
require c_runtime/c_jit_build
require c_runtime/c_macro
require c_runtime/c_signal
require c_runtime/c_switch
require c_runtime/cstr
require c_runtime/int_of
require c_runtime/printf
require c_runtime/variadic
require c_types
require crt
require lapi
require lauxlib
require lcode_cluster
require linit
require lobject_h_cluster

[init]
def private c2das_dialect {
    c_long_bits = 64
}

var private globalL : lua_State? = null
var private progname : uint8? = cstr("lua")

let private LUA_HOOKCALL = 0
let private LUA_MASKCALL = 1 << LUA_HOOKCALL
let private LUA_HOOKRET = 1
let private LUA_MASKRET = 1 << LUA_HOOKRET
let private LUA_HOOKLINE = 2
let private LUA_MASKLINE = 1 << LUA_HOOKLINE
let private LUA_HOOKCOUNT = 3
let private LUA_MASKCOUNT = 1 << LUA_HOOKCOUNT
let private LUA_OK = 0
let private LUA_TSTRING = 4
let private LUA_TTABLE = 5
let private LUA_MULTRET = -1
let private has_error = 1
let private has_E = 16
let private has_i = 2
let private has_v = 4
let private has_e = 8
let private LUA_TNIL = 0
let private LUA_ERRSYNTAX = 3
let private marklen = uint64(typeinfo sizeof(type<uint8[6]>)) / uint64(typeinfo sizeof(type<uint8>)) - 1ul
let private LUA_MAXINPUT = 512
let private LUA_MINSTACK = 20
let private LUA_VERSION_NUM = 504
let private LUAL_NUMSIZES = uint64(typeinfo sizeof(type<int64>)) * 16ul + uint64(typeinfo sizeof(type<double>))
let private LUAI_MAXSTACK = 1000000
let private LUA_REGISTRYINDEX = -LUAI_MAXSTACK - 1000
let private LUA_GCRESTART = 1
let private LUA_GCGEN = 10
let private LUA_GCSTOP = 0

// lua.h:398: #define lua_tostring(L,i) lua_tolstring(L, (i), NULL)
[c_macro]
def private lua_tostring(var L; i) : uint8? => lua_tolstring(L, i, null)

// lua.h:376: #define lua_pop(L,n) lua_settop(L, -(n)-1)
[c_macro]
def private lua_pop(var L; n) {
    lua_settop(L, -n - 1)
}

// lauxlib.h:142: #define luaL_typename(L,i) lua_typename(L, lua_type(L,(i)))
[c_macro]
def private luaL_typename(var L; i) : uint8? => lua_typename(L, lua_type(L, i))

// lua.h:401: #define lua_insert(L,idx) lua_rotate(L, (idx), 1)
[c_macro]
def private lua_insert(var L; idx) {
    lua_rotate(L, idx, 1)
}

// lua.h:298: #define lua_pcall(L,n,r,f) lua_pcallk(L, (n), (r), (f), 0, NULL)
[c_macro]
def private lua_pcall(var L; n; r; f) => lua_pcallk(L, n, r, f, 0l, default<function<(var a0 : lua_State?; a1 : int; a2 : int64) : int>>)

// lua.h:403: #define lua_remove(L,idx) (lua_rotate(L, (idx), -1), lua_pop(L, 1))
[c_macro]
def private lua_remove(var L; idx) {
    lua_rotate(L, idx, -1)
    lua_pop(L, 1)
}

// lauxlib.h:95: #define luaL_loadfile(L,f) luaL_loadfilex(L,f,NULL)
[c_macro]
def private luaL_loadfile(var L; var f) => luaL_loadfilex(L, f, null)

// lauxlib.h:154: #define luaL_loadbuffer(L,s,sz,n) luaL_loadbufferx(L,s,sz,n,NULL)
[c_macro]
def private luaL_loadbuffer(var L; var s; sz; var n) => luaL_loadbufferx(L, s, sz, n, null)

// lua.h:374: #define lua_tointeger(L,i) lua_tointegerx(L,(i),NULL)
[c_macro]
def private lua_tointeger(var L; i) => lua_tointegerx(L, i, null)

// lauxlib.h:47: #define luaL_checkversion(L) luaL_checkversion_(L, LUA_VERSION_NUM, LUAL_NUMSIZES)
[c_macro]
def private luaL_checkversion(var L) {
    luaL_checkversion_(L, double(LUA_VERSION_NUM), LUAL_NUMSIZES)
}

// lua.c:426: #define lua_stdin_is_tty() 1
[c_macro]
def private lua_stdin_is_tty() => 1

// lua.h:382: #define lua_pushcfunction(L,f) lua_pushcclosure(L, (f), 0)
[c_macro]
def private lua_pushcfunction(var L; f) {
    lua_pushcclosure(L, f, 0)
}

// Hook set by signal function to stop the interpreter.
def private lstop(var L : lua_State?; var ar : lua_Debug?) {
    // unused arg.
    // reset hook
    lua_sethook(L, default<function<(var a0 : lua_State?; var a1 : lua_Debug?) : void>>, 0, 0)
    luaL_error`va(L, cstr("interrupted!"), VaNone())
}

// Function to be called at a C signal. Because a C signal cannot
// just change a Lua state (as there is no proper synchronization),
// this function only sets a hook that, when called, will stop the
// interpreter.
def private laction(i : int) {
    let flag : int = LUA_MASKCALL | LUA_MASKRET | LUA_MASKLINE | LUA_MASKCOUNT
    // if another SIGINT happens, terminate process
    c_signal(i, default<function<(a0 : int) : void>>)
    lua_sethook(globalL, @@lstop, flag, 1)
}

[c_function]
def private print_usage(var badoption : uint8?) {
    fprintf(crt::c_stderr(), cstr("%s: "), progname)
    crt::fflush(crt::c_stderr())
    if (badoption[1] == 'e' || badoption[1] == 'l') {
        fprintf(crt::c_stderr(), cstr("'%s' needs argument\n"), badoption)
        crt::fflush(crt::c_stderr())
    } else {
        fprintf(crt::c_stderr(), cstr("unrecognized option '%s'\n"), badoption)
        crt::fflush(crt::c_stderr())
    }
    fprintf(crt::c_stderr(),
            cstr("usage: %s [options] [script [args]]\nAvailable options are:\n  -e stat   execute string 'stat'\n  -i        enter interactive mode after executing 'script'\n  -l mod    require library 'mod' into global 'mod'\n  -l g=mod  require library 'mod' into global 'g'\n  -v        show version information\n  -E        ignore environment variables\n  -W        turn warnings on\n  --        stop handling options\n  -         stop handling options and execute stdin\n"),
            progname)
    crt::fflush(crt::c_stderr())
}

// Prints an error message, adding the program name in front of it
// (if present)
[c_function]
def private l_message(var pname : uint8?; var msg : uint8?) {
    if (pname != null) {
        fprintf(crt::c_stderr(), cstr("%s: "), pname)
        crt::fflush(crt::c_stderr())
    }
    fprintf(crt::c_stderr(), cstr("%s\n"), msg)
    crt::fflush(crt::c_stderr())
}

// Check whether 'status' is not OK and, if so, prints the error
// message on the top of the stack.
[c_function]
def private report(var L : lua_State?; status : int) : int {
    if (status != LUA_OK) {
        var msg : uint8? = lua_tostring(L, -1)
        if (msg == null) {
            msg = cstr("(error message not a string)")
        }
        l_message(progname, msg)
        // remove message
        lua_pop(L, 1)
    }
    return status
}

// Message handler used to run all chunks
[c_function]
def private msghandler(var L : lua_State?) : int {
    var msg : uint8? = lua_tostring(L, 1)
    // is error object not a string?
    if (msg == null) {
        // does it have a metamethod
        if (luaL_callmeta(L, 1, cstr("__tostring")) != 0 && lua_type(L, -1) == LUA_TSTRING) {
            // that produces a string?
            // that is the message
            return 1
        } else {
            msg = lua_pushfstring`va(L, cstr("(error object is a %s value)"), (luaL_typename(L, 1),))
        }
    }
    // append a standard traceback
    luaL_traceback(L, L, msg, 1)
    // return the traceback
    return 1
}

// Interface to 'lua_pcall', which sets appropriate message function
// and C-signal handler. Used to run all chunks.
def private docall(var L : lua_State?; narg : int; nres : int) : int {
    var status : int
    // function index
    let base : int = lua_gettop(L) - narg
    // push message handler
    lua_pushcclosure(L, @@msghandler, 0)
    // put it under function and args
    lua_insert(L, base)
    // to be available to 'laction'
    globalL = L
    // set C-signal handler
    c_signal(2, @@laction)
    status = lua_pcall(L, narg, nres, base)
    // reset C-signal handler
    c_signal(2, default<function<(a0 : int) : void>>)
    // remove message handler from the stack
    lua_remove(L, base)
    return status
}

[c_function]
def private print_version {
    crt::fwrite(reinterpret<void?>(cstr("Lua 5.4.8  Copyright (C) 1994-2025 Lua.org, PUC-Rio")), uint64(typeinfo sizeof(type<uint8>)),
            crt::strlen(cstr("Lua 5.4.8  Copyright (C) 1994-2025 Lua.org, PUC-Rio")), crt::c_stdout())
    crt::fwrite(reinterpret<void?>(cstr("\n")), uint64(typeinfo sizeof(type<uint8>)), 1ul, crt::c_stdout())
    crt::fflush(crt::c_stdout())
}

// Create the 'arg' table, which stores all arguments from the
// command line ('argv'). It should be aligned so that, at index 0,
// it has 'argv[script]', which is the script name. The arguments
// to the script (everything after 'script') go to positive indices;
// other arguments (before the script name) go to negative indices.
// If there is no script name, assume interpreter's name as base.
// (If there is no interpreter's name either, 'script' is -1, so
// table sizes are zero.)
[c_function]
def private createargtable(var L : lua_State?; var argv : uint8 ??; argc : int; script : int) {
    var narg : int
    // number of positive indices
    narg = argc - (script + 1)
    lua_createtable(L, narg, script + 1)
    for (i in range(argc)) {
        lua_pushstring(L, argv[i])
        lua_rawseti(L, -2, int64(i - script))
    }
    lua_setglobal(L, cstr("arg"))
}

def private dochunk(var L : lua_State?; var status : int) : int {
    if (status == LUA_OK) {
        status = docall(L, 0, 0)
    }
    return report(L, status)
}

def private dofile(var L : lua_State?; var name : uint8?) : int {
    return dochunk(L, luaL_loadfile(L, name))
}

[c_function]
def private dostring(var L : lua_State?; var s : uint8?; var name : uint8?) : int {
    return dochunk(L, luaL_loadbuffer(L, s, crt::strlen(s), name))
}

// Receives 'globname[=modname]' and runs 'globname = require(modname)'.
// If there is no explicit modname and globname contains a '-', cut
// the suffix after '-' (the "version") to make the global name.
[c_function]
def private dolibrary(var L : lua_State?; var globname : uint8?) : int {
    var status : int
    var suffix : uint8? = null
    var modname : uint8? = crt::strchr(globname, '=')
    // no explicit name?
    if (modname == null) {
        // module name is equal to global name
        modname = globname
        // look for a suffix mark
        suffix = crt::strchr(modname, int(*cstr("-")))
    } else {
        // global name ends here
        *modname = uint8('\0')
        // module name starts after the '='
        modname++
    }
    lua_getglobal(L, cstr("require"))
    lua_pushstring(L, modname)
    // call 'require(modname)'
    status = docall(L, 1, 1)
    if (status == LUA_OK) {
        // is there a suffix mark?
        if (suffix != null) {
            // remove suffix from global name
            *suffix = uint8('\0')
        }
        // globname = require(modname)
        lua_setglobal(L, globname)
    }
    return report(L, status)
}

// Push on the stack the contents of table 'arg' from 1 to #arg
def private pushargs(var L : lua_State?) : int {
    var i : int
    var n : int
    if (lua_getglobal(L, cstr("arg")) != LUA_TTABLE) {
        luaL_error`va(L, cstr("'arg' is not a table"), VaNone())
    }
    n = int(luaL_len(L, -1))
    luaL_checkstack(L, n + 3, cstr("too many arguments to script"))
    i = 1
    while (i <= n) {
        lua_rawgeti(L, -i, int64(i))
        i++
    }
    // remove table from the stack
    lua_remove(L, -i)
    return n
}

[c_function]
def private handle_script(var L : lua_State?; var argv : uint8 ??) : int {
    var status : int
    var fname : uint8? = argv[0]
    if (crt::strcmp(fname, cstr("-")) == 0 && crt::strcmp(argv[-1], cstr("--")) != 0) {
        // stdin
        fname = null
    }
    status = luaL_loadfile(L, fname)
    if (status == LUA_OK) {
        // push arguments to script
        let n : int = pushargs(L)
        status = docall(L, n, LUA_MULTRET)
    }
    return report(L, status)
}

// Traverses all arguments from 'argv', returning a mask with those
// needed before running any Lua code or an error code if it finds any
// invalid argument. In case of error, 'first' is the index of the bad
// argument. Otherwise, 'first' is -1 if there is no program name,
// 0 if there is no script name, or the index of the script name.
[c_function]
def private collectargs(var argv : uint8 ??; var first : int?) : int {
    var args : int = 0
    var i : int
    // is there a program name?
    if (argv[0] != null) {
        // not empty?
        if (argv[0][0] != 0) {
            // save it
            progname = argv[0]
        }
    } else {
        // no program name
        *first = -1
        return 0
    }
    // handle arguments
    i = 1
    while (argv[i] != null) {
        *first = i
        // not an option?
        if (argv[i][0] != '-') {
            // stop handling options
            return args
        }
        // else check option
        c_switch(int(argv[i][1])) {
            case('-') {
                // '--'
                // extra characters after '--'?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                *first = i + 1
                return args
            }
            case('\0') {
                // '-'
                // script "name" is '-'
                return args
            }
            case('E') {
                // extra characters?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                args |= has_E
                break
            }
            case('W') {
                // extra characters?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                break
            }
            case('i') {
                // (-i implies -v) FALLTHROUGH
                args |= has_i
            }
            case('v') {
                // extra characters?
                if (argv[i][2] != '\0') {
                    // invalid option
                    return has_error
                }
                args |= has_v
                break
            }
            case('e') {
                // FALLTHROUGH
                args |= has_e
            }
            case('l') {
                // both options need an argument
                // no concatenated argument?
                if (argv[i][2] == '\0') {
                    // try next 'argv'
                    i++
                    if (argv[i] == null || argv[i][0] == '-') {
                        // no next argument or it is another option
                        return has_error
                    }
                }
                break
            }
            case(_) {
                // invalid option
                return has_error
            }
        }
        i++
    }
    // no script name
    *first = 0
    return args
}

// Processes options 'e' and 'l', which involve running Lua code, and
// 'W', which also affects the state.
// Returns 0 if some code raises an error.
[c_function]
def private runargs(var L : lua_State?; var argv : uint8 ??; n : int) : int {
    var i : int
    i = 1
    while (i < n) {
        let option : int = int(argv[i][1])
        // already checked
        c_switch(option) {
            case('e', 'l') {
                {
                    var status : int
                    // both options need an argument
                    var extra : uint8? = argv[i] + 2
                    if (*extra == '\0') {
                        i++
                        extra = argv[i]
                    }
                    status = (option == 'e') ? dostring(L, extra, cstr("=(command line)")) : dolibrary(L, extra)
                    if (status != LUA_OK) {
                        return 0
                    }
                    break
                }
            }
            case('W') {
                // warnings on
                lua_warning(L, cstr("@on"), 0)
                break
            }
        }
        i++
    }
    return 1
}

[c_function]
def private handle_luainit(var L : lua_State?) : int {
    var name : uint8? = cstr("=LUA_INIT_5_4")
    var init : uint8? = crt::getenv(name + 1)
    if (init == null) {
        name = cstr("=LUA_INIT")
        // try alternative name
        init = crt::getenv(name + 1)
    }
    if (init == null) {
        return LUA_OK
    } elif (init[0] == '@') {
        return dofile(L, init + 1)
    } else {
        return dostring(L, init, name)
    }
}

// Return the string to be used as a prompt by the interpreter. Leave
// the string (or nil, if using the default value) on the stack, to keep
// it anchored.
def private get_prompt(var L : lua_State?; firstline : int) : uint8? {
    if (lua_getglobal(L, firstline != 0 ? cstr("_PROMPT") : cstr("_PROMPT2")) == LUA_TNIL) {
        // use the default
        return firstline != 0 ? cstr("> ") : cstr(">> ")
    } else {
        // apply 'tostring' over the value
        var p : uint8? = luaL_tolstring(L, -1, null)
        // remove original value
        lua_remove(L, -2)
        return p
    }
}

// Check whether 'status' signals a syntax error and the error
// message at the top of the stack ends with the above mark for
// incomplete statements.
[c_function]
def private incomplete(var L : lua_State?; status : int) : int {
    if (status == LUA_ERRSYNTAX) {
        var lmsg : uint64
        var msg : uint8? = lua_tolstring(L, -1, addr(lmsg))
        if (lmsg >= marklen && crt::strcmp(msg + lmsg + -int64(marklen), cstr("<eof>")) == 0) {
            return 1
        }
    }
    // else...
    return 0
}

// Prompt the user, read a line, and push it into the Lua stack.
[c_function]
def private pushline(var L : lua_State?; firstline : int) : int {
    var buffer : uint8[512]
    var b : uint8? = addr(buffer[0])
    var l : uint64
    var prmt : uint8? = get_prompt(L, firstline)
    crt::fputs(prmt, crt::c_stdout())
    crt::fflush(crt::c_stdout())
    let readstatus : int = int_of(crt::fgets(b, LUA_MAXINPUT, crt::c_stdin()) != null)
    // remove prompt
    lua_pop(L, 1)
    if (readstatus == 0) {
        // no input
        return 0
    }
    l = crt::strlen(b)
    // line ends with newline?
    if (l > 0ul && b[l - 1ul] == '\n') {
        // remove it
        l--
        b[l] = uint8('\0')
    }
    // for compatibility with 5.2, ...
    if (firstline != 0 && b[0] == '=') {
        // change '=' to 'return'
        lua_pushfstring`va(L, cstr("return %s"), (b + 1,))
    } else {
        lua_pushlstring(L, b, l)
    }
    return 1
}

// Try to compile line on the stack as 'return <line>;'; on return, stack
// has either compiled chunk or original line (if compilation failed).
[c_function]
def private addreturn(var L : lua_State?) : int {
    // original line
    var line : uint8? = lua_tostring(L, -1)
    var retline : uint8? = lua_pushfstring`va(L, cstr("return %s;"), (line,))
    let status : int = luaL_loadbufferx(L, retline, crt::strlen(retline), cstr("=stdin"), null)
    if (status == LUA_OK) {
        // remove modified line
        lua_remove(L, -2)
        // non empty?
        if (line[0] != '\0') {
            // keep history
        }
    } else {
        // pop result from 'luaL_loadbuffer' and modified line
        lua_pop(L, 2)
    }
    return status
}

// Read multiple lines until a complete Lua statement
[c_function]
def private multiline(var L : lua_State?) : int {
    // repeat until gets a complete statement
    while (true) {
        var len : uint64
        // get what it has
        var line : uint8? = lua_tolstring(L, 1, addr(len))
        // try it
        let status : int = luaL_loadbufferx(L, line, len, cstr("=stdin"), null)
        if (incomplete(L, status) == 0 || pushline(L, 0) == 0) {
            // keep history
            // should not or cannot try to add continuation line
            return status
        }
        // remove error message (from incomplete line)
        lua_remove(L, -2)
        // add newline...
        lua_pushstring(L, cstr("\n"))
        // ...between the two lines
        lua_insert(L, -2)
        // join them
        lua_concat(L, 3)
    }
    return 0
}

// Read a line and try to load (compile) it first as an expression (by
// adding "return " in front of it) and second as a statement. Return
// the final status of load/call with the resulting function (if any)
// in the top of the stack.
def private loadline(var L : lua_State?) : int {
    var status : int
    lua_settop(L, 0)
    if (pushline(L, 1) == 0) {
        // no input
        return -1
    }
    // 'return ...' did not work?
    status = addreturn(L)
    if (status != LUA_OK) {
        // try as command, maybe with continuation lines
        status = multiline(L)
    }
    // remove line from the stack
    lua_remove(L, 1)
    return status
}

// Prints (calling the Lua 'print' function) any values on the stack
def private l_print(var L : lua_State?) {
    let n : int = lua_gettop(L)
    // any result to be printed?
    if (n > 0) {
        luaL_checkstack(L, LUA_MINSTACK, cstr("too many results to print"))
        lua_getglobal(L, cstr("print"))
        lua_insert(L, 1)
        if (lua_pcall(L, n, 0, 0) != LUA_OK) {
            l_message(progname, lua_pushfstring`va(L, cstr("error calling 'print' (%s)"), (lua_tostring(L, -1),)))
        }
    }
}

// Do the REPL: repeatedly read (load) a line, evaluate (call) it, and
// print any results.
[c_function]
def private doREPL(var L : lua_State?) {
    var status : int
    var oldprogname : uint8? = progname
    // no 'progname' on errors in interactive mode
    progname = null
    while (true) {
        status = loadline(L)
        if (!(status != -1)) {
            break
        }
        if (status == LUA_OK) {
            status = docall(L, 0, LUA_MULTRET)
        }
        if (status == LUA_OK) {
            l_print(L)
        } else {
            report(L, status)
        }
    }
    // clear stack
    lua_settop(L, 0)
    crt::fwrite(reinterpret<void?>(cstr("\n")), uint64(typeinfo sizeof(type<uint8>)), 1ul, crt::c_stdout())
    crt::fflush(crt::c_stdout())
    progname = oldprogname
}

// Main body of stand-alone interpreter (to be called in protected mode).
// Reads the options and handles them all.
[c_function]
def private pmain(var L : lua_State?) : int {
    let argc : int = int(lua_tointeger(L, 1))
    var argv : uint8 ?? = reinterpret<uint8 ??>(lua_touserdata(L, 2))
    var script : int
    let args : int = collectargs(argv, addr(script))
    // first argv not an option
    let optlim : int = (script > 0) ? script : argc
    // check that interpreter has correct version
    luaL_checkversion(L)
    // bad arg?
    if (args == has_error) {
        // 'script' has index of bad arg.
        print_usage(argv[script])
        return 0
    }
    // option '-v'?
    if ((args & has_v) != 0) {
        print_version()
    }
    // option '-E'?
    if ((args & has_E) != 0) {
        // signal for libraries to ignore env. vars.
        lua_pushboolean(L, 1)
        lua_setfield(L, LUA_REGISTRYINDEX, cstr("LUA_NOENV"))
    }
    // open standard libraries
    luaL_openlibs(L)
    // create table 'arg'
    createargtable(L, argv, argc, script)
    // start GC...
    lua_gc`va(L, LUA_GCRESTART, VaNone())
    // ...in generational mode
    lua_gc`va(L, LUA_GCGEN, (0, 0))
    // no option '-E'?
    if ((args & has_E) == 0) {
        // run LUA_INIT
        if (handle_luainit(L) != LUA_OK) {
            // error running LUA_INIT
            return 0
        }
    }
    // execute arguments -e and -l
    if (runargs(L, argv, optlim) == 0) {
        // something failed
        return 0
    }
    // execute main script (if there is one)
    if (script > 0) {
        if (handle_script(L, argv + script) != LUA_OK) {
            // interrupt in case of error
            return 0
        }
    }
    // -i option?
    if ((args & has_i) != 0) {
        // do read-eval-print loop
        doREPL(L)
    } elif (script < 1 && (args & (has_e | has_v)) == 0) {
        // no active option?
        // running in interactive mode?
        if (lua_stdin_is_tty() != 0) {
            print_version()
            // do read-eval-print loop
            doREPL(L)
        } else {
            // executes stdin as a file
            dofile(L, null)
        }
    }
    // signal no errors
    lua_pushboolean(L, 1)
    return 1
}

[c_function]
def c_main(argc : int; var argv : uint8 ??) : int {
    var status : int
    var result : int
    // create state
    var L : lua_State? = luaL_newstate()
    if (L == null) {
        l_message(argv[0], cstr("cannot create state: not enough memory"))
        return 1
    }
    // stop GC while building state
    lua_gc`va(L, LUA_GCSTOP, VaNone())
    // to call 'pmain' in protected mode
    lua_pushcfunction(L, @@pmain)
    // 1st argument
    lua_pushinteger(L, int64(argc))
    // 2nd argument
    lua_pushlightuserdata(L, reinterpret<void?>(argv))
    // do the call
    status = lua_pcall(L, 2, 1, 0)
    // get result
    result = lua_toboolean(L, -1)
    report(L, status)
    lua_close(L)
    return (result != 0 && status == LUA_OK) ? 0 : 1
}

[export]
def main : int {
    c_runtime_init("lua")
    return c_main(c_argc(), c_argv())
}
