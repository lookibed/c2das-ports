            // l < r ?
            return LTintfloat(li, fltvalue(r))
        }
    } else {
        // 'l' must be float
        let lf : double = fltvalue(l)
        if (ttisfloat(r)) {
            // both are float
            return int_of(lf < fltvalue(r))
        } else {
            // 'l' is float and 'r' is int
            return LTfloatint(lf, ivalue(r))
        }
    }
